kg:op_1 prop:content "地域住民や専門家等から情報収集し調査・予測・評価を行うべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "情報収集結果を位置・規模等の決定に反映すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "必要に応じて環境影響を調査・予測すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "評価結果を事業計画の決定に反映すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "方法書で位置・規模等を可能な限り明確にすべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "環境保全配慮の検討経緯を具体的に記載すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "周辺風力発電所の諸元等を把握し複合影響を勘案すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "他事業との複合影響を踏まえて影響回避・低減を図るべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "撤去工事計画を可能な限り明確にすべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "必要に応じて撤去工事に伴う環境影響も調査・予測・評価すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "撤去工事の影響も適切に評価し工事影響の回避・低減を図るべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "大型化を踏まえ位置・規模等を慎重に決定すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "配慮が必要な施設や住居への影響回避・低減を図るべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "施設や住居との距離を適切に確保して影響回避・低減を図るべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "ため池の利水状況を勘案し水の濁りによる影響回避・低減を図るべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "ため池の利用実態を踏まえて水質影響対策を講じるべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "専門家の助言や最新知見を踏まえて影響回避・低減を図るべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "営巣木の存在を踏まえて位置・規模等を検討すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "専門家助言と最新知見を踏まえて動物影響を回避・低減すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "主要眺望点からの景観影響を考慮すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "大型化による景観影響を懸念している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "景観影響の回避・低減を図るべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "地域住民及び専門家等への周知と意見聴取に努めるべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "地域住民等から情報収集し可視領域を踏まえて調査地点を選定すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "事業特性や地域特性を踏まえて地下水影響を検討すべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "地下水影響を事業特性と地域特性に基づいて検討すべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今後の事業計画の検討に当たっては、地域住民や専門家等からの情報収集に努め、影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価した上で、事業の「位置・規模」及び「配置・構造」"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今後の事業計画の検討に当たっては、地域住民や専門家等からの情報収集に努め、影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価した上で、事業の「位置・規模」及び「配置・構造」"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価した上で"@ja.
<< kg:id_3 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "その結果を総合的に評価した上で、事業の「位置・規模」及び「配置・構造」 （以下「位置・規模等」という。）の決定に反映すること"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "方法書においては、事業の位置・規模等を可能な限り明確にするとともに"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "環境の保全の配慮に係る検討経緯を具体的に記載すること"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業実施想定区域周辺には、既設及び建設中の風力発電所が存在することから、これらの諸元等の情報入手に努め、他事業との複合的な環境影響を勘案し"@ja.
<< kg:id_3 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "他事業との複合的な環境影響を勘案し、本事業の実施による影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_3 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "方法書以降の手続きにおいては、既設風力発電機の撤去に係る工事計画を可能な限り明確にするとともに"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "必要に応じて、撤去工事の実施に伴う環境影響についても、適切に調査、予測及び評価を行い"@ja.
<< kg:id_3 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "撤去工事の実施に伴う環境影響についても、適切に調査、予測及び評価を行い、本事業の工事の実施による影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "新設する風力発電機は、既設の風力発電機より大型化する計画となっていることに加え"@ja.
<< kg:id_17 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "事業実施想定区域周辺には、社会福祉施設等の配慮が特に必要な施設や多数の住居が存在することから"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "事業の位置・規模等の決定に当たっては、これらと風力発電機との距離を適切に確保する等、本事業の実施に伴う影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "事業実施想定区域にはため池が存在し、本事業の工事の実施による濁水の流入等による水質への影響が懸念されることから"@ja.
<< kg:id_3 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "当該ため池の利水の状況等を勘案し、水の濁りによる影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "対象事業実施区域及びその周辺ではオオタカの繁殖が確認されている"@ja.
<< kg:id_24 prop:cause kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "ノスリの営巣木が確認されていることから"@ja.
<< kg:id_3 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "事業の位置・規模等の決定に当たっては、専門家等の助言、最新の知見・事例等を踏まえ、本事業の実施に伴う影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
