kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "評価書は主務省令等を踏まえ地域特性に十分配慮して作成すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "評価項目選定に必要な情報を最新文献に基づき追加整理すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "未選定の生態系にも十分配慮すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "未選定のシャドーフリッカーにも十分配慮すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "未選定の大気環境にも十分配慮すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "未選定の水環境にも十分配慮すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地域住民や由利本荘市への積極的な情報公開と説明が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "工事による大気質への影響を調査予測評価すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "工事による騒音への影響を調査予測評価すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "工事による振動への影響を調査予測評価すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "工事による水質への影響を調査予測評価すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "工事による底質への影響を調査予測評価すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "調査予測地点が北側に集中しており選定経緯の説明が必要"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "学校や病院などへの配慮から調査予測地点の追加選定を検討すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "騒音低周波音の保全措置は回避低減の状況まで具体的に示すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "土地又は工作物の存在及び供用による地形地質への影響を調査予測評価すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "土地又は工作物の存在及び供用による風車の影への影響を調査予測評価すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "工事による動物への影響を調査予測評価すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "工事による植物への影響を調査予測評価すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "工事による生態系への影響を調査予測評価すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "土地又は工作物の存在及び供用による生態系への影響を調査予測評価すべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "改変範囲や周辺の生息環境植生の状況を明記し予測結果の根拠を示すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "土地改変で水の濁りが想定される場合は水域で調査予測評価すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "水の濁りが想定される場合は水生動物への影響確認が必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "コウモリ類は適切な時期に現地調査し生息確認時は予測評価すべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "鳥類やコウモリ類の風車衝突の可能性がある場合は保全措置と事後調査が必要"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "風車衝突の可能性がある場合は保全措置と専門家助言に基づく事後調査を行うべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "表土は区別管理し元の場所等に埋め戻して植生の早期回復を図るべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "植生回復の方法を評価書に具体的に記載すべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "鳥類以外でも必要に応じ専門家の助言を受けるべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "景観は可視領域図など客観的根拠に基づき近景中景遠景で評価すべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "工事による産業廃棄物や残土への影響を調査予測評価すべき"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "環境影響評価書（以下「評価書」という。）の作成に当たっては、主務省令及び「風力発電事業に係る環境影響評価実施要綱」を踏まえるとともに、地域特性に十分配慮すること。"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "「対象事業実施区域及びその周囲の概況」については、主務省令を参考にして、環境影響評価項目の選定を行うに必要な情報を最新の文献等に基づき評価書に追加、整理すること。"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "その際、本図書では評価項目として選定されていない生態系、シャドーフリッカー、工事の実施を影響要因とする大気環境や水環境等について十分配慮すること。"@ja.
<< kg:id_7 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "その際、本図書では評価項目として選定されていない生態系、シャドーフリッカー、工事の実施を影響要因とする大気環境や水環境等について十分配慮すること。"@ja.
<< kg:id_8 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "その際、本図書では評価項目として選定されていない生態系、シャドーフリッカー、工事の実施を影響要因とする大気環境や水環境等について十分配慮すること。"@ja.
<< kg:id_9 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "その際、本図書では評価項目として選定されていない生態系、シャドーフリッカー、工事の実施を影響要因とする大気環境や水環境等について十分配慮すること。"@ja.
