kg:op_1 prop:content "検討の経緯及び結果の丁寧な説明を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "専門家等"@ja.
kg:st_2 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_2 prop:content "客観性と妥当性を確保するため複数の専門家から意見聴取すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "地域住民や地元自治体等"@ja.
kg:st_3 rdfs:type cls:st_167.
kg:op_3 prop:content "周知と丁寧な説明を受け、意見の事業反映を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "検討の経緯及び結果の説明と意見反映を求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "調査地点の追加を検討すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "県内の一部地域では風力発電所の設置が原因とみられる電波障害が発生している"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "施設の稼働に伴う騒音、超低周波音及び風車の影による影響"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "本事業の実施による鳥類への影響"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "現在計画している4,200kW程度の風力発電機より大型化する可能性があることから、景観への影響を適切に調査、予測及び評価をし"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:text-txt_contents "実施区域周辺には複数の住居等が存在するほか、現在計画している4,200kW程度の風力発電機より大型化する可能性があることから、景観への影響を適切に調査、予測及び評価をし"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:text-txt_contents "地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:text-txt_contents "対象事業実施区域（以下「実施区域」という。）周辺には複数の住居等が存在するほか、現在計画している4,200kW程度の風力発電機より大型化する可能性があることから、施設の稼働に伴う騒音、超低周波音及び風車の影による影響について、適切に調査、予測及び評価をすること"@ja.
<< kg:id_13 prop:effect kg:id_5 >>
    prop:text-txt_contents "本事業の実施による鳥類への影響を適切に予測及び評価をすること"@ja.
<< kg:id_14 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "風力発電機の規模や配置等の検討に当たっては、地域住民等に検討の経緯及び結果について丁寧な説明を行い、述べられた意見を十分に勘案すること"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、これらについて必要に応じて見直しを行う等、適切に対応すること"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本事業の調査、予測及び評価に当たっては、専門家等の助言や最新の知見・事例等を踏まえ、適切に調査、予測及び評価をすること。なお、意見聴取は環境要素ごとに複数の専門家に対して行うなど、環境影響評価の客観性及び妥当性の確保に努めること"@ja.
<< kg:id_19 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "設置する風力発電機の機種や配置のほか、工事の規模や方法等が確定していないことから、準備書においては事業計画を明確にし、具体的な環境の保全の配慮に係る検討の経緯及びその内容を詳細に記載すること。また、これらについて、地域住民や地元自治体等（以下「地域住民等」という。）に広く周知するとともに丁寧な説明を行い、理解を得るよう努め、述べられた意見を可能な限り事業に反映すること"@ja.
<< kg:id_6 prop:contermeasure kg:id_21 >>
    prop:text-txt_contents "本事業の実施に当たっては、環境影響評価項目としての選定の有無によらず、地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること"@ja.
<< kg:id_3 prop:contermeasure kg:id_22 >>
    prop:text-txt_contents "施設の稼働に伴う騒音、超低周波音及び風車の影による影響について、適切に調査、予測及び評価をすること"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "希少猛禽類の生息状況を広範囲に観測するなどし、本事業の実施による鳥類への影響を適切に予測及び評価をすること"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:text-txt_contents "一般鳥類の調査には、任意観察法の他にも調査手法があることから、ホオジロ科等の小型鳥類の現地調査に当たっては、ラインセンサス法等の任意観察法以外の手法についても、検討すること"@ja.
<< kg:id_7 prop:contermeasure kg:id_27 >>
    prop:text-txt_contents "景観への影響を適切に調査、予測及び評価をし、風力発電機の配置等の検討結果に反映させること"@ja.
<< kg:id_28 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "風力発電機の規模や配置等の検討に当たっては、地域住民等に検討の経緯及び結果について丁寧な説明を行い、述べられた意見を十分に勘案すること"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "地域住民等の意見を確認した上で、調査地点の追加について検討すること"@ja.
}
