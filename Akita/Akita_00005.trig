kg:st_1 rdfs:label "知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "専門家の意見を踏まえ環境影響の回避又は低減を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "複数の専門家への意見聴取で客観性と妥当性の確保を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地域住民等への丁寧な説明と理解形成を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "住民等の情報を収集し調査予測結果を計画決定に反映すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "方法書で計画内容と環境配慮の検討結果の明確化を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "他事業者との情報共有により累積的影響の回避又は低減を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "既設風力発電所との累積的影響に配慮すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "住居と風力発電機との距離を適切に確保し影響回避又は低減を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "住居との距離確保で超低周波音の影響回避又は低減を求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "住居との距離確保で風車の影の影響回避又は低減を求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "生活環境への影響を懸念している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "位置・規模等の決定時に住居との距離確保を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "現地調査結果や専門家の助言を踏まえ影響回避又は低減を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "渡り鳥の飛来地があるため鳥類影響への配慮を求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "鳥類の移動経路への影響を懸念している"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "バードストライク発生の影響回避又は低減を求める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "現地調査と専門家助言を踏まえた対策を求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "日常生活の場からの眺望景観への影響を懸念している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "住民の生活空間から見える景観への影響を懸念している"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "地域住民等の意見を踏まえ配置見直しを求める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "想定区域には森林法（昭和26年法律第249号）に基づき指定された土砂流出防備保安林等が存在するほか、周辺には複数の住居が存在することから、専門家の意見等を踏まえ、本事業の実施による環境影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "専門家の意見等を踏まえ、本事業の実施による環境影響を回避又は低減するよう配慮すること。なお、意見聴取は複数の専門家に対して行うなど、環境影響評価の客観性及び妥当性の確保に努めること。"@ja.
<< kg:id_4 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本事業の実施に当たっては、地域住民や地元自治体等（以下「地域住民等」という。）に丁寧な説明を行い、理解を得るよう努めること。"@ja.
<< kg:id_4 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今後の事業計画の検討に当たっては、地域住民等からの情報収集に努め、影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価して事業の「位置・規模」及び「配置・構造」の決定に反映すること。"@ja.
<< kg:id_4 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "方法書においては、事業の位置・規模等を可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を記載すること。"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "想定区域周辺には、既設の風力発電所が存在することから、他事業者との情報共有に努め、本事業の実施による累積的な影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_8 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "想定区域周辺には、既設の風力発電所が存在することから、他事業者との情報共有に努め、本事業の実施による累積的な影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "想定区域周辺には複数の住居が存在することから、施設の稼働に伴う騒音、超低周波音及び風車の影による生活環境への影響が懸念される。"@ja.
<< kg:id_11 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "想定区域周辺には複数の住居が存在することから、施設の稼働に伴う騒音、超低周波音及び風車の影による生活環境への影響が懸念される。"@ja.
<< kg:id_11 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "想定区域周辺には複数の住居が存在することから、施設の稼働に伴う騒音、超低周波音及び風車の影による生活環境への影響が懸念される。"@ja.
<< kg:id_11 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "想定区域周辺には複数の住居が存在することから、施設の稼働に伴う騒音、超低周波音及び風車の影による生活環境への影響が懸念される。"@ja.
<< kg:id_11 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "このため、事業の位置・規模等の決定に当たっては、住居と風力発電機との距離を適切に確保する等により、本事業の実施に伴う騒音、超低周波音及び風車の影による影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "想定区域及びその周辺では、希少猛禽類が生息する可能性があるほか、渡り鳥の集団飛来地である八郎潟干拓地が存在することから、事業の位置・規模等の決定に当たっては、今後の現地調査の結果や専門家の助言を踏まえ、本事業の実施による鳥類の移動経路の遮断・阻害やバードストライクの発生による影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_17 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "想定区域及びその周辺では、希少猛禽類が生息する可能性があるほか、渡り鳥の集団飛来地である八郎潟干拓地が存在することから、事業の位置・規模等の決定に当たっては、今後の現地調査の結果や専門家の助言を踏まえ、本事業の実施による鳥類の移動経路の遮断・阻害やバードストライクの発生による影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_17 prop:effect kg:id_20 >>
