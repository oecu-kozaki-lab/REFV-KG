kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "意見を踏まえて主要な眺望点や調査地点を追加してほしい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_6.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、これらについて必要に応じて見直しを行う等、適切に対応すること。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "本事業は、沖合約1km～4kmの海域に最大25基（総出力最大36万kW）の風力発電所を設置する国内で先行事例の少ない洋上風力発電事業であることから"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "専門家等の助言や国内外における最新の知見・事例等を踏まえ、適切に調査、予測及び評価すること。"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "意見聴取は複数の専門家に対して行うなど、環境影響評価の客観性及び妥当性の確保に努めること。"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:text-txt_contents "設置する風力発電機の機種や配置のほか、工事の規模や方法等が確定していないことから"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "準備書においては事業計画を可能な限り明確にし、具体的な環境の保全の配慮に係る検討の経緯及びその内容を詳細に記載すること。"@ja.
<< kg:id_8 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "地域住民や地元自治体等（以下「地域住民等」という。）に広く周知するとともに丁寧な説明を行い、理解を得るよう努め、述べられた意見を可能な限り事業に反映すること。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "対象事業実施区域（以下「実施区域」という。）周辺には既設及び計画中の風力発電所が存在することから、これら他事業の諸元等の情報入手に努め、累積的な影響が懸念される項目について、適切に調査、予測及び評価すること。"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "これら他事業の諸元等の情報入手に努め、累積的な影響が懸念される項目について、適切に調査、予測及び評価すること。"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "実施区域周辺に風力発電所の設置を計画している事業者等から、累積的な影響を予測及び評価するために、本事業に係る風力発電機の配置や諸元等の情報を求められた場合は、情報提供に努めること。"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:text-txt_contents "県内の一部地域では風力発電所の設置が原因とみられる電波障害が発生している"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること。"@ja.
<< kg:id_17 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "本事業の実施に当たっては環境影響評価項目としての選定の有無によらず、地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること。"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:text-txt_contents "本事業では、早朝及び日没後にも工事を実施する可能性があり"@ja.
<< kg:id_21 prop:cause kg:id_23 >>
    prop:text-txt_contents "特にモノパイルの打設工事については著しい騒音が発生する可能性がある"@ja.
<< kg:id_21 prop:effect kg:id_24 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "建設機械の稼働に伴う騒音による生活環境への影響が懸念される。"@ja.
<< kg:id_21 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "工事計画の検討に当たっては、地域住民等の意見を踏まえるとともに、準備書においては工事の具体的な工程や作業時間等の詳細を可能な限り明確にし、発生する騒音の特性を踏まえた上で、建設機械の稼働に伴う騒音による生活環境への影響を適切に調査、予測及び評価すること。"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻き上げ等が発生するおそれがある"@ja.
<< kg:id_26 prop:cause kg:id_28 >>
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻き上げ等が発生するおそれがある"@ja.
<< kg:id_26 prop:effect kg:id_29 >>
    prop:text-txt_contents "工事の実施に伴う水の濁りへの影響について"@ja.
<< kg:id_26 prop:countermeasure kg:id_30 >>
    prop:text-txt_contents "必要に応じて調査地点の追加や見直しを検討する等により、実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握し、適切に予測及び評価すること。"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:text-txt_contents "実施区域は、ガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地である小友沼の北西に位置しており、渡りの時期等における主要な移動経路となっている可能性がある"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:text-txt_contents "実施区域及びその周辺では沿岸部を生活域としている魚食性鳥類の生息が確認されている。"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:text-txt_contents "当該区域周辺には既設及び計画中の風力発電所が多数存在することから"@ja.
<< kg:id_35 prop:effect kg:id_31 >>
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される。"@ja.
<< kg:id_35 prop:effect kg:id_37 >>
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される。"@ja.
<< kg:id_33 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本事業の実施による鳥類への影響について、専門家等の助言を踏まえ、必要に応じて調査地点や回数を追加するなど、調査手法の見直しを検討する等により、実施区域及びその周辺の上空を通過する鳥類の飛翔経路や高度等を詳細に把握し、適切に予測及び評価すること。"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:text-txt_contents "実施区域及びその周辺の海域は、県の魚であるハタハタ等の産卵場及び稚魚の生育場並びに溯河性魚類であるサクラマス等の重要な回遊経路となっている可能性があることから、本事業の実施によるこれら海生生物への影響が懸念される。"@ja.
<< kg:id_39 prop:effect kg:id_41 >>
    prop:text-txt_contents "本事業の実施による魚等の遊泳動物やその卵・稚仔等の海生生物への影響について"@ja.
<< kg:id_39 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "専門家等の助言を踏まえ、ハタハタ及びサクラマス等の魚種を予測対象種として選定し、適切な調査手法により予測対象種等の生息状況を可能な限り把握し、予測及び評価すること。"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:text-txt_contents "洋上風力発電事業の実施に伴う水中音が海域に生息する動物に及ぼす影響について"@ja.
<< kg:id_43 prop:effect kg:id_45 >>
    prop:text-txt_contents "水中音が海域に生息する動物に及ぼす影響"@ja.
<< kg:id_43 prop:countermeasure kg:id_46 >>
    prop:text-txt_contents "国内外の最新の知見や事例等の集積に努め、水中音の影響に係る調査、予測及び評価に適切に反映すること。"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:text-txt_contents "本事業は、能代市から八峰町の沖合南北約13kmに渡る範囲に風力発電機を設置する計画であることから"@ja.
<< kg:id_47 prop:cause kg:id_49 >>
    prop:text-txt_contents "日常生活の場からの景観の変化が想定されることから"@ja.
<< kg:id_47 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "主要な眺望点の設定に当たっては、地域住民等の意見を踏まえ、必要に応じて調査地点を追加すること。"@ja.
<< kg:id_47 prop:countermeasure kg:id_51 >>
    prop:text-txt_contents "本事業の実施による景観への影響について、フォトモンタージュや垂直見込角に加え、眺望方向や水平視野、時間帯、季節的変化等も考慮し、適切に調査、予測及び評価すること。"@ja.
}
