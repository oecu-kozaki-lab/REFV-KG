kg:op_5 prop:content "生活環境への十分な配慮を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_5.
kg:op_6 prop:content "影響発生時は適切な対応を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_5.
kg:st_6 rdfs:label "地域住民等"@ja.
kg:st_6 rdf:type cls:st_167.
kg:op_7 prop:content "工事騒音による生活環境への影響を懸念"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_6.
kg:op_8 prop:content "意見を踏まえて工事工程や作業時間を明確化し騒音影響を調査評価してほしい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_6.
kg:op_9 prop:content "助言を踏まえて調査手法を見直し鳥類の飛翔経路や高度等を詳細に把握すべき"@ja.
kg:op_9 rdf:type cls:opinion.
