PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Akita/00009> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電機から発生する騒音"@ja.
kg:id_1 rdf:type cls:c_108.
cls:c_108 rdfs:label "騒音"@ja.
kg:id_2 rdfs:label "周辺住民から苦情が発生"@ja.
kg:id_2 rdf:type cls:c_13549.
cls:c_13549 rdfs:label "住民苦情"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "施設の稼働に伴う騒音"@ja.
kg:id_3 rdf:type cls:c_108.
kg:id_4 rdfs:label "事業者が設定した基準を超過する地点があること"@ja.
kg:id_4 rdf:type cls:c_454.
cls:c_454 rdfs:label "基準超過"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "苦情発生時に原因を速やかに調査し適切な措置を講じる"@ja.
kg:id_5 rdf:type cls:c_13651.
cls:c_13651 rdfs:label "原因調査"@ja.
kg:id_3 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "パワーレベル及び周波数特性と設置する風力発電機との整合性を確認し必要に応じて予測及び評価を再度行い結果を評価書に反映する"@ja.
kg:id_6 rdf:type cls:c_139.
cls:c_139 rdfs:label "再評価"@ja.
kg:id_1 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "事後調査"@ja.
kg:id_7 rdf:type cls:c_17.
cls:c_17 rdfs:label "事後調査"@ja.
kg:id_8 rdfs:label "気象条件による影響を把握できるよう調査回数や地点を適切に設定し調査の継続の要否を検討する"@ja.
kg:id_8 rdf:type cls:c_269.
cls:c_269 rdfs:label "調査実施"@ja.
kg:id_7 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "環境影響"@ja.
kg:id_9 rdf:type cls:c_348.
cls:c_348 rdfs:label "環境影響"@ja.
kg:id_10 rdfs:label "風力発電機の規模及び基数の確定後に予測及び評価を再度行い結果を評価書に反映する"@ja.
kg:id_10 rdf:type cls:c_139.
kg:id_9 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "事業の実施"@ja.
kg:id_11 rdf:type cls:c_468.
cls:c_468 rdfs:label "事業実施"@ja.
kg:id_12 rdfs:label "環境保全措置の確実な履行を確保するため責任の所在を明確にし工事施工業者等への指導に努める"@ja.
kg:id_12 rdf:type cls:c_13547.
cls:c_13547 rdfs:label "履行確保"@ja.
kg:id_11 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "最新の知見や技術等を可能な範囲で導入し一層の環境影響の低減に努める"@ja.
kg:id_13 rdf:type cls:c_429.
cls:c_429 rdfs:label "影響低減"@ja.
kg:id_11 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "工事中及び供用後に生じた現段階で予測し得ない環境保全上の問題"@ja.
kg:id_14 rdf:type cls:c_533.
cls:c_533 rdfs:label "環境問題"@ja.
kg:id_15 rdfs:label "速やかに調査を行い関係機関と協議の上適切な措置を講じる"@ja.
kg:id_15 rdf:type cls:c_13651.
kg:id_14 prop:countermeasure kg:id_15.
kg:st_1 rdfs:label "秋田県生活環境部環境管理課環境審査班"@ja.
kg:st_1 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_1 prop:content "苦情発生時は原因を速やかに調査し適切な措置を講じるべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "基準超過地点があるため騒音影響への対応が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "苦情発生時の迅速な調査と措置を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "騒音特性と設置計画の整合確認と再予測再評価を求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "気象条件の影響把握のため調査設計を適切にし継続要否を検討すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "規模と基数の確定後に環境影響の再予測再評価が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "環境保全措置の履行確保へ責任明確化と施工業者指導を求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "最新知見と技術の導入で環境影響の低減を図るべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "予測不能な環境問題には速やかな調査と関係機関協議の上での措置が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "施設の稼働に伴う騒音の予測結果において、事業者が設定した基準を超過する地点があることから、施設の稼働に伴い周辺住民から苦情が発生した場合は、速やかにその原因を調査し、適切な措置を講じること。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "施設の稼働に伴う騒音の予測結果において、事業者が設定した基準を超過する地点があることから"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "施設の稼働に伴い周辺住民から苦情が発生した場合は、速やかにその原因を調査し、適切な措置を講じること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "準備書に記載されている風力発電機から発生する騒音のパワーレベル及び周波数特性と設置する風力発電機との整合性を確認し、必要に応じて予測及び評価を再度行い、その結果を評価書に反映すること。"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "事後調査を稼働後1年間に1回実施することとしているが、気象条件による影響等を把握できるよう調査の回数や地点を適切に設定するとともに、事後調査の結果等を踏まえ、調査の継続の要否を検討すること。"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "設置する風力発電機の規模及び基数が確定していないことから、確定後、必要に応じて環境影響についての予測及び評価を再度行い、その結果を評価書に反映すること。"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業の実施に当たっては、環境保全措置の確実な履行を確保するため、責任の所在を明確にするとともに、工事施工業者等への指導に努めること。"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "また、最新の知見や技術等を可能な範囲で導入することにより、一層の環境影響の低減に努めること。"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講じること。"@ja.
}
