kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "専門家等の意見を聞いた上で伐採時期を考慮し松枯れ拡大を防止すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "専門家等の意見を聞いた上で分布拡大防止のため適切な措置を検討すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "専門家等の意見を聞いた上で分布拡大防止のため適切な措置を検討すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "他の事業者と情報共有し調整しながら環境要素を整理再検討した上で調査予測評価すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "景観資源が一望できる位置を選定しフォトモンタージュ等で予測評価すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "景観資源が一望できる位置を選定しフォトモンタージュ等で予測評価すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "造成計画を勘案し環境影響評価項目として選定するか再検討すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "新たな事情が生じた場合は必要に応じて評価項目及び手法を見直し適切に対応すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "周辺事業との複合的影響を踏まえ情報共有と調整を行うべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "住民等の意見内容を十分精査し適切に対応し必要に応じて準備書へ反映すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "専門家等の意見を聞いた上で伐採時期を明確にし松枯れ拡大防止を図るべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "専門家等の意見を聞いた上でニセアカシアの分布拡大防止措置を検討すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "陸上と海上の景観変化を適切な視点場で予測評価すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "造成計画と土量バランスを踏まえ残土の扱いを再検討すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "対象事業実施区域の保安林においては、松くい虫防除対策事業等が行われていることから、専門家等の意見を聞いた上で、松枯れの拡大を防止するよう伐採時期等を考慮した事業計画とすること"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "対象事業実施区域の保安林内には外来種であるニセアカシアが侵入しているため、松林を伐採後に直ちに整地した場合、一斉にニセアカシアが発芽する可能性があることから、専門家等の意見を聞いた上で、分布拡大を防止するための適切な措置を検討すること"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "対象事業実施区域の保安林内には外来種であるニセアカシアが侵入しているため、松林を伐採後に直ちに整地した場合、一斉にニセアカシアが発芽する可能性があることから、専門家等の意見を聞いた上で、分布拡大を防止するための適切な措置を検討すること"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "対象事業実施区域の周辺には、既設及び計画中の風力発電事業が存在することから、これら事業との複合的な環境影響について、他の事業者と情報を共有し、調整を図りながら、影響を受けるおそれのある環境要素を整理・再検討した上で調査、予測及び評価を行うこと"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "陸上からの景観の変化に加え、海上からの景観の変化について、風力発電機や男鹿半島等の景観資源が一望できるような位置を選定し、フォトモンタージュ等により予測及び評価を行うこと"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "陸上からの景観の変化に加え、海上からの景観の変化について、風力発電機や男鹿半島等の景観資源が一望できるような位置を選定し、フォトモンタージュ等により予測及び評価を行うこと"@ja.
<< kg:id_7 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業実施に伴い発生する残土について、造成計画を勘案し、環境影響評価項目として選定することの可否について再検討すること"@ja.
<< kg:id_7 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、必要に応じて環境影響評価の項目及び手法の見直しを行う等、適切に対応すること"@ja.
<< kg:id_7 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "対象事業実施区域の周辺には、既設及び計画中の風力発電事業が存在することから、これら事業との複合的な環境影響について、他の事業者と情報を共有し、調整を図りながら、影響を受けるおそれのある環境要素を整理・再検討した上で調査、予測及び評価を行うこと"@ja.
<< kg:id_7 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "方法書について提出された住民等の意見については、その内容を十分に精査した上で適切に対応し、必要に応じて準備書に反映すること"@ja.
<< kg:id_7 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "対象事業実施区域の保安林においては、松くい虫防除対策事業等が行われていることから、専門家等の意見を聞いた上で、松枯れの拡大を防止するよう伐採時期等を考慮した事業計画とするとともに、準備書において樹木を伐採する時期を明確にすること"@ja.
<< kg:id_7 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "対象事業実施区域の保安林内には外来種であるニセアカシアが侵入しているため、松林を伐採後に直ちに整地した場合、一斉にニセアカシアが発芽する可能性があることから、専門家等の意見を聞いた上で、分布拡大を防止するための適切な措置を検討すること"@ja.
<< kg:id_7 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "陸上からの景観の変化に加え、海上からの景観の変化について、風力発電機や男鹿半島等の景観資源が一望できるような位置を選定し、フォトモンタージュ等により予測及び評価を行うこと"@ja.
<< kg:id_7 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "事業実施に伴い発生する残土について、造成計画を勘案し、環境影響評価項目として選定することの可否について再検討すること。なお、評価項目として選定しない場合には、土量バランスを含めた造成計画の詳細を明らかにした上で、その判断に至った経緯を準備書に記載すること"@ja.
