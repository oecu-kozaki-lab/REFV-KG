kg:id_19 rdf:type cls:c_13689.
cls:c_13689 rdfs:label "伐採回避"@ja.
kg:id_1 prop:effect kg:id_19.
kg:id_20 rdfs:label "土地の改変に伴う樹木伐採を極力回避する"@ja.
kg:id_20 rdf:type cls:c_224.
cls:c_224 rdfs:label "景観影響"@ja.
