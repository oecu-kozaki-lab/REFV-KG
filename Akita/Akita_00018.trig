kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "位置が変更された場合は予測と評価を再度行い結果を評価書に反映すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "施工業者への指導を徹底し環境保全措置を確実に履行すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "可能な範囲で最新の知見や技術を導入し環境影響をさらに低減すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "予測できない問題が生じた場合は速やかに調査し関係機関と協議して適切に対応すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "施設稼働により夜間騒音が増える地点があるため苦情発生時に迅速対応すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "苦情が発生した場合は原因を調査し適切な措置を講じるべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "騒音や超低周波音の予測は不確実性が大きいため事後調査を実施すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "搬送と積替えで騒音影響が懸念されるため住民理解を得ながら十分に低減配慮すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "作業時は住民理解を得るよう努め騒音影響を十分低減すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "搬送と積替えで振動影響が懸念されるため住民理解を得ながら十分に低減配慮すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "作業時は住民理解を得るよう努め振動影響を十分低減すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "動物調査では専門家の助言を得て時期設定や回数増加を行うべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "バットストライクとバードストライクの発生状況や渡り経路の変化を適切に把握すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "自然度の高い森林があるため伐採を最小限に抑え環境保全措置を確実に講じるべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "自然度の高い森林への影響を避けるため設置範囲と道路整備に伴う伐採を最小限にすべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "保安林指定区域では樹木伐採を回避すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "保安林区域での伐採は避けるべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "移植事例や知見が乏しいため専門家の助言を得て慎重に移植すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "移植は専門家助言を踏まえ適切な移植先と方法を選び慎重に行うべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "風力発電機の位置が変更となる可能性があることから、確定後、必要に応じて環境影響についての予測及び評価を再度行い、その結果を評価書に反映すること。"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業の実施に当たっては、工事施工業者等への指導に努め、環境保全措置の確実な履行を確保すること。"@ja.
<< kg:id_3 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "また、最新の知見や技術等を可能な範囲で導入することにより、一層の環境影響の低減に努めること。"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講じること。"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "現況値の騒音レベルが比較的小さい住居地域において、施設の稼働により夜間に最大8デシベル増加すると予測される地点がある"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "施設の稼働に伴い周辺住民から苦情が発生した場合は、速やかに原因を調査し、適切な措置を講じること。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "施設の稼働に伴う騒音及び超低周波音の予測については、発生源からの騒音の放射特性や伝搬過程における気象条件、地形の影響等、不確実性が大きい要因があることから、事後調査を実施すること。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "風力発電機のブレード及びタワーは、対象事業実施区域に搬送し、住居地域で積替える計画であることから、積替え作業に伴う騒音の影響が懸念される。"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "このため、作業の実施に当たっては、周辺住民の理解を得るよう努めるとともに、影響を低減するよう十分に配慮すること。"@ja.
<< kg:id_14 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "風力発電機のブレード及びタワーは、対象事業実施区域に搬送し、住居地域で積替える計画であることから、積替え作業に伴う振動の影響が懸念される。"@ja.
<< kg:id_19 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "このため、作業の実施に当たっては、周辺住民の理解を得るよう努めるとともに、影響を低減するよう十分に配慮すること。"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "事後調査の実施に当たっては、専門家等の助言を得ながら適切な調査時期を設定するとともに、必要に応じて調査回数を増やす等して"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "バットストライク、バードストライクの発生状況や、渡り経路の変化の程度を適切に把握すること。"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "対象事業実施区域内にはブナ等の二次林をはじめ植生自然度の高い森林が存在することから、風力発電機の設置範囲や新たな取付道路の樹木伐採は最小限にとどめる等、環境保全措置を確実に講じること。"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "風力発電機の設置範囲や新たな取付道路の樹木伐採は最小限にとどめる等、環境保全措置を確実に講じること。"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "対象事業実施区域の一部が森林法（昭和26年法律第249号）に基づく土砂流出防備保安林に指定されていることから、当該区域は樹木伐採を回避すること。"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "当該区域は樹木伐採を回避すること。"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "移植を行うハコネシケチシダとエゾノスズランは、移植に関する事例や知見がほとんどないことから、専門家等の助言を得ながら適切な移植先や移植方法を選定し、慎重に実施すること。"@ja.
<< kg:id_32 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "専門家等の助言を得ながら適切な移植先や移植方法を選定し、慎重に実施すること。"@ja.
}
