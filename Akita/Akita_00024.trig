kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "生活環境への影響が懸念されるため調査予測評価が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "生活環境への重大な影響が懸念される"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "生活環境への重大な影響が懸念される"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "影響の回避又は低減が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "重大な影響が懸念されるため工事計画見直しも必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "予測される場合は工事計画の見直しが必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "予測される場合は工事計画の見直しが必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "不確実性が大きいため事後調査が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "発生状況を把握し追加的な環境保全措置が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "影響把握と追加的な環境保全措置が必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "重大な影響が確認された場合は適切な環境保全措置が必要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "出された意見等を十分に反映し評価書に記載すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "環境保全措置の確実な履行を確保すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "可能な範囲で導入し一層の環境影響低減に努めるべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "工事中又は供用後に問題が生じた場合は速やかに対応すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "生活環境への影響を回避又は低減すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "客観的根拠に基づく適切な評価が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "予測される場合は工事計画を見直すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "周辺住民に事前説明を行い理解を得るよう努めるべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "影響懸念や苦情発生時は一時中断等を確実に講ずるべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "影響把握に努め必要に応じ追加措置を講ずるべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "発生状況を適切に把握し追加措置を講ずるべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "海生生物への影響を適切に把握し追加措置を講ずるべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "必要に応じて事後調査を行い重大な影響確認時は適切に対応すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業者から海上輸送に加え、陸上輸送を行う方針が新たに示されたことから、騒音及び振動による生活環境への影響が懸念される"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業者から海上で行う組立作業の一部を陸上で行うことや、モノパイル基礎打設工事を夜間にも実施する可能性が新たに示されたことから、当該工事に伴う騒音及び振動による生活環境への重大な影響が懸念される"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "事業者から海上で行う組立作業の一部を陸上で行うことや、モノパイル基礎打設工事を夜間にも実施する可能性が新たに示されたことから、当該工事に伴う騒音及び振動による生活環境への重大な影響が懸念される"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "工事用資材等の搬出入に伴う騒音及び振動について、適切に調査、予測及び評価し、その結果を評価書に記載するとともに、必要に応じて、追加的な環境保全措置を講ずることにより、生活環境への影響を回避又は低減すること"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "当該工事に伴う騒音及び振動による生活環境への重大な影響が懸念される"@ja.
<< kg:id_8 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "騒音又は振動レベルの大幅な増加や環境基準の超過が予測される場合は、工事計画を見直し、生活環境への影響を回避すること"@ja.
<< kg:id_9 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "騒音又は振動レベルの大幅な増加や環境基準の超過が予測される場合は、工事計画を見直し、生活環境への影響を回避すること"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "施設の稼働に伴う騒音及び超低周波音の予測については、発生源からの騒音の放射特性や伝搬過程における気象条件、地形の影響等、不確実性が大きい要因があることから、事後調査を実施し、影響の把握に努める"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "施設の稼働に伴うバードストライクの発生が懸念されることから、最新の知見や専門家等の助言に基づいた事後調査を実施し、バードストライクの発生状況を適切に把握するとともに、その結果を踏まえ、追加的な環境保全措置を講ずること"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "工事の実施及び施設の稼働に伴う水中騒音による海生生物への影響が懸念されることから、最新の知見や専門家等の助言に基づいた事後調査を実施し、海生生物への影響を適切に把握するとともに、その結果を踏まえ、追加的な環境保全措置を講ずること"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "コウモリ類が海域を飛翔している可能性があることから、最新の知見や専門家等の助言を踏まえ、必要に応じてバットストライクに係る事後調査を実施し、コウモリ類に対する重大な影響が確認された場合は、適切な環境保全措置を講ずること"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "今後の工事計画の策定に当たっては、説明会を開催するなど、地域住民や地元自治体等に説明を尽くすとともに、出された意見等を十分に反映し、その内容を評価書に記載すること"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "事業の実施に当たっては、工事施工業者等への指導に努め、環境保全措置の確実な履行を確保すること"@ja.
<< kg:id_20 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "最新の知見や技術等を可能な範囲で導入することにより、一層の環境影響の低減に努めること"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中又は供用後に生じた場合は、最新の知見や専門家等の助言を踏まえた調査を速やかに行い、関係機関と協議の上で、適切な措置を講じること"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "工事用資材等の搬出入に伴う騒音及び振動について、適切に調査、予測及び評価し、その結果を評価書に記載するとともに、必要に応じて、追加的な環境保全措置を講ずることにより、生活環境への影響を回避又は低減すること"@ja.
<< kg:id_27 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "モノパイル基礎打設工事等に伴う騒音及び振動について、国内外における最新の知見・事例を可能な限り収集し、客観的な根拠に基づいた適切な調査、予測及び評価を行い、その結果を評価書に記載すること"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "騒音又は振動レベルの大幅な増加や環境基準の超過が予測される場合は、工事計画を見直し、生活環境への影響を回避すること"@ja.
<< kg:id_31 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "工事の実施に当たっては、周辺住民への事前説明を行い、理解を得るよう努めること"@ja.
<< kg:id_33 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "工事中は周辺住民の生活環境への影響について監視し、影響が懸念される場合又は周辺住民から苦情等が発生した場合は、工事を一時中断する等の環境保全措置を確実に講ずること"@ja.
<< kg:id_10 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "事後調査を実施し、影響の把握に努めるとともに、その結果を踏まえ、必要に応じて、追加的な環境保全措置を講ずること"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "最新の知見や専門家等の助言に基づいた事後調査を実施し、バードストライクの発生状況を適切に把握するとともに、その結果を踏まえ、追加的な環境保全措置を講ずること"@ja.
<< kg:id_38 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "最新の知見や専門家等の助言に基づいた事後調査を実施し、海生生物への影響を適切に把握するとともに、その結果を踏まえ、追加的な環境保全措置を講ずること"@ja.
<< kg:id_16 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "必要に応じてバットストライクに係る事後調査を実施し、コウモリ類に対する重大な影響が確認された場合は、適切な環境保全措置を講ずること"@ja.
}
