kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "新たな事情が生じた場合は評価項目や手法を見直し適切に対応すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "事業計画の絞り込み過程の具体的検討内容を準備書に記載すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "他事業者と情報共有し調整しながら総合的な環境影響を整理再検討すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "影響を受けるおそれのある環境要素を整理再検討した上で調査予測評価すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "低騒音型低振動型機械の使用や稼働台数の平準化など追加保全措置を検討すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "騒音振動の回避低減のため低騒音型低振動型機械を使用すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "騒音振動の回避低減のため稼働台数の平準化を図るべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "専門家意見を踏まえ松枯れ拡大防止に配慮した計画とし伐採時期を明確化すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "松枯れ拡大を防止するよう伐採時期等を考慮すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "松枯れ拡大防止のため専門家意見を踏まえ伐採時期を考慮すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "伐採時期を準備書で明確化すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "分布拡大防止の追加措置を専門家意見を踏まえ検討すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "分布拡大防止のため追加措置を検討すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "ニセアカシアの分布拡大防止措置を専門家意見を踏まえ検討すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "生活環境からの景観にも配慮し必要に応じ調査地点を追加すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "住居地域に近いため生活環境からの景観影響に十分配慮すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "必要に応じて調査地点を追加し適切に調査予測評価すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "利用時期を含むよう調査時期を設定すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "キノコ採りの時期を含む調査時期を設定して評価すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、必要に応じて環境影響評価の項目及び手法の見直しを行う等、適切に対応すること。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "設置する風力発電機の規模や基数が複数案設定されていることから、事業計画の絞り込みの過程における具体的な検討内容を準備書に記載すること。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "対象事業実施区域の周辺には、既設及び計画中の風力発電事業が存在することから、これら事業との複合的な環境影響について、他の事業者と情報を共有し、調整を図りながら、影響を受けるおそれのある環境要素を整理・再検討した上で調査、予測及び評価を行うこと。"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "これら事業との複合的な環境影響について、他の事業者と情報を共有し、調整を図りながら、影響を受けるおそれのある環境要素を整理・再検討した上で調査、予測及び評価を行うこと。"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "建設機械の稼働に伴う騒音及び振動の環境影響を回避・低減するため、工事の実施にあたっては低騒音型・低振動型の機械を使用するとともに、稼働台数の平準化を図る等、追加的な環境保全措置を検討した上で予測及び評価を行うこと。"@ja.
<< kg:id_8 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "建設機械の稼働に伴う騒音及び振動の環境影響を回避・低減するため、工事の実施にあたっては低騒音型・低振動型の機械を使用する"@ja.
<< kg:id_8 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "建設機械の稼働に伴う騒音及び振動の環境影響を回避・低減するため、工事の実施にあたっては、稼働台数の平準化を図る等、追加的な環境保全措置を検討した上で予測及び評価を行うこと。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "対象事業実施区域の保安林においては、松林の保全活動や松くい虫防除対策事業等が行われていることから、専門家等の意見を聞いた上で、松枯れの拡大を防止するよう伐採時期等を考慮した事業計画とするとともに、準備書において樹木を伐採する時期を明確にすること。"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "松枯れの拡大を防止するよう伐採時期等を考慮した事業計画とする"@ja.
<< kg:id_12 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "専門家等の意見を聞いた上で、松枯れの拡大を防止するよう伐採時期等を考慮した事業計画とする"@ja.
<< kg:id_12 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "準備書において樹木を伐採する時期を明確にすること。"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "対象事業実施区域の保安林内には外来種であるニセアカシアが侵入しているため"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "松林を伐採後に重機で整地した場合、一斉にニセアカシアが発芽する可能性がある"@ja.
<< kg:id_17 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "専門家等の意見を聞いた上で、分布拡大を防止するための適切な措置を検討すること。"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "対象事業実施区域に住居地域が隣接していることから、日常的な生活環境からの景観にも十分に配慮し、必要に応じて調査地点を追加する等、適切に調査、予測及び評価を行うこと。"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "日常的な生活環境からの景観にも十分に配慮し"@ja.
<< kg:id_24 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "必要に応じて調査地点を追加する等、適切に調査、予測及び評価を行うこと。"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "主要な人と自然との触れ合いの活動の場として選定している「夕日の松原」においては、キノコ採り等が盛んに行われることから"@ja.
<< kg:id_27 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "その期間を包含するような調査時期を設定した上で、調査、予測及び評価を行うこと。"@ja.
}
