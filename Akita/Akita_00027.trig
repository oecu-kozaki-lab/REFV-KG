kg:id_1 prop:countermeasure kg:id_32.
kg:st_1 rdfs:label "秋田県知事 佐竹敬久"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "工事施工業者への指導を徹底し環境保全措置を確実に履行すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "最新の知見や技術を導入して環境影響をさらに低減すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "保安林の伐開が植生変化を招くおそれがある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "保安林の伐開により林縁部の植生構造が変化するおそれがある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "風の通り道ができることで植生退行のおそれがある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "伐開や風環境の変化で樹木が衰退・減少するおそれがある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "保安林の機能を損なわないよう事業を実施すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "予測できない環境保全上の問題が発生する可能性を踏まえるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "予測外の問題が生じた場合は迅速に調査し関係機関と協議して適切に対応すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "住居等との距離が近く周辺生活環境への配慮が特に必要である"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "住居に近いため工事中や供用後に住民苦情が発生するおそれがある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "住民から苦情が出た場合は適切に対応すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "施設稼働による騒音が生活環境へ影響するおそれがある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "評価基準の妥当性を精査すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "騒音評価基準を精査し必要なら準備書を修正すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "夜間騒音が基準超過となる地点があり対策が必要である"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "騒音と超低周波音を回避低減するため配置や基数を見直すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "騒音予測には不確実性が大きいため事後確認が必要である"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "騒音と超低周波音は事後調査で確認すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "風車の影が住居等へ影響するおそれがある"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "風車の影が指針値を大きく超えて住居等に及ぶおそれがある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "風車の影を回避低減するため配置や基数を見直すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "風車の影の予測には不確実性が大きいため事後調査が必要である"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "風車の影は事後調査で影響を把握すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "周辺は渡り鳥や猛禽類にとって重要な地域であり慎重な配慮が必要である"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "渡り時期に鳥類が事業区域上空を通過するため影響が懸念される"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "隣接する風力発電事業との複合影響も考慮すべきである"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "事業により鳥類の移動経路が遮断されるおそれがある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "鳥類への影響を回避低減するため配置や基数を見直すべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "鳥類がブレードやタワーに接近接触するおそれがある"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "鳥類影響は事後調査で移動経路変化やバードストライクを把握すべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業の実施に当たっては、工事施工業者等への指導に努め、環境保全措置の確実な履行を確保すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "また、最新の知見や技術等を可能な範囲で導入することにより、一層の環境影響の低減に努めること。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "対象事業実施区域の大部分が保安林であり、樹林帯の伐開による林縁部の植生構造の変化や、風の通り道ができることによる植生退行、樹木衰退・減少の可能性が想定される"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "樹林帯の伐開による林縁部の植生構造の変化"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "風の通り道ができることによる植生退行"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "樹木衰退・減少の可能性が想定される"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業の実施に当たっては、保安林の機能が損なわれないよう配慮すること。"@ja.
<< kg:id_1 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "速やかに調査を行い、関係機関と協議の上、適切な措置を講ずること。"@ja.
<< kg:id_1 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "風力発電機と住居等との距離が最近接で500m程度であることから"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "工事中及び供用後に周辺の住民から苦情が発生した場合には"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "適切に対処すること。"@ja.
<< kg:id_1 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "施設の稼働に伴う騒音の予測において"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "一部の地点で「学校環境衛生基準」を評価基準として設定しているが、基準の妥当性を精査し"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "基準の妥当性を精査し、必要に応じて環境影響評価準備書において修正すること。"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "事業者が設定した基準のうち夜間の基準を超過する地点がある。"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "施設の稼働に伴う騒音及び超低周波音による影響を可能な限り回避又は低減するよう、風力発電機の配置・基数の見直しや追加的な環境保全措置を検討すること。"@ja.
<< kg:id_1 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "騒音源の騒音放射特性、伝搬過程における気象条件や地形の影響など不確実性が大きい要因があることから"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "事後調査を実施すること。"@ja.
<< kg:id_1 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "施設の稼働に伴う風車の影の予測において"@ja.
<< kg:id_1 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "風車の影の影響が、事業者が参考とした指針値を大幅に上回る時間に及ぶ住居等が存在する。"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "施設の稼働に伴う風車の影による影響を可能な限り回避又は低減するよう、風力発電機の配置・基数の見直しや追加的な環境保全措置を検討すること。"@ja.
<< kg:id_1 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "地形の影響など不確実性が大きい要因があることから"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "風車の影が及ぶ季節別の時間帯や範囲など、影響の程度を適切に把握するため、事後調査を実施すること。"@ja.
<< kg:id_1 prop:cause kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "対象事業実施区域の北側に位置する八郎潟干拓地は、ガン・カモ類等の渡り鳥の集団飛来地であるほか、周辺はオオタカやミサゴ等の猛禽類の重要な生息・繁殖地であり"@ja.
<< kg:id_1 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "渡りの時期等において対象事業実施区域及びその周辺の上空を通過する際に"@ja.
<< kg:id_1 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "本事業とその北側に計画中の風力発電事業等との複合的な影響により"@ja.
<< kg:id_1 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "移動経路が遮断されるおそれがある。"@ja.
<< kg:id_1 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "施設の稼働に伴う鳥類への影響を可能な限り回避又は低減するよう、風力発電機の配置・基数の見直しや追加的な環境保全措置を検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "移動経路の遮断・阻害及びブレード・タワー等への接近・接触といった予測に大きな不確実性が伴うことから"@ja.
<< kg:id_1 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "事後調査を実施すること。なお、事後調査の実施に当たっては、専門家等の助言を得ながら調査頻度を高めるなどして移動経路の変化の程度やバードストライクの発生状況等を適切に把握するとともに、可能な限り、北側に計画中の風力発電事業者と合同で行うこと。"@ja.
}
