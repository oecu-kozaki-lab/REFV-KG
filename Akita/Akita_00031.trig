kg:st_1 rdfs:label "能代市長"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "秋季だけでなく夏季も含めて調査すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "既設風車や計画中風車との複合影響も考慮して調査すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "最新の知見や事例を活用して適切に予測評価すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "秋田県知事"@ja.
kg:st_2 rdf:type cls:st_2.
kg:op_4 prop:content "海底の底質や流速を把握し工事中の影響を適切に予測評価すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "必要に応じて調査地点の追加や見直しを検討すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "専門家の助言を踏まえ予測対象種を選定し生息状況を把握すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "主要魚種を対象に適切な予測評価を行うべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "現地調査の測線を防波堤方向に延長して海草藻類の生育状況を把握すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "海草藻類の生育状況を適切に把握すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "渡り鳥の移動経路への影響を確認し回避低減を図るべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "既設風車や計画中風車も含めて調査評価すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "最新の知見を活用し魚類生息への影響を確認して回避低減を図るべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "適切な予測評価を行い回避低減を図るべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "漁業関係者に十分説明しながら進めるべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "周辺漁業への影響確認と説明が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "海底地形及び地質を環境影響評価項目として選定検討すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "航路への影響も含めて評価項目に加えるべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "評価項目への選定検討結果を準備書に記載すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "除外区域を反映させて風車設置範囲を明確にすべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "準備書で除外区域を反映した表示にすべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "必要に応じて評価項目や手法を見直し適切に対応すべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "風力発電機の規模や配置の検討経緯を詳細に記載すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "国内外の最新知見や事例を集積し必要に応じて調査予測評価へ反映すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "未解明なため最新知見を継続的に反映すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "他事業の諸元情報を集め複合的又は累積的影響を調査評価すべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "他事業との複合累積影響を適切に評価すべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "窓の開放時間が長い夏季も調査対象に加えるべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "対象事業実施区域及びその周辺は季節によって風況が異なり、秋季の民等における騒音の程度も季節によって異なると考えられる"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "風況による影響を考慮し、また、既設風車・計画中風車との複合影響も考慮し調査、予測及び評価を行うこと"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "超低周波音による健康等への影響は、個人差が大きいという特徴があり、その理由も未解明な部分が多いことから、国内外の事例や、可能な限り最新の知見も活用し、適切な予測及び評価を行うこと"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "風力発電機基礎の設置や海底ケーブルの敷設に伴い海底土砂の巻き上げ等が発生するおそれがある"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "対象事業実施区域及びその周辺における海底の底質の状況や流向、流速を可能な限り把握した上で、工事中の水の濁りの影響について、必要に応じて調査地点の追加や見直しを検討する等、適切に予測及び評価すること"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業の実施に伴う魚類等の遊泳動物やその卵・稚仔等の海域に生息する動物への影響について"@ja.
<< kg:id_9 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "専門家等の助言を踏まえ、ハタハタ、サケ、サクラマス及びアユ等の魚種を予測対象種として選定し、可能な限り生息状況を把握した上で、適切に予測及び評価すること"@ja.
<< kg:id_12 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業の実施に伴う海域に生育する植物への影響について"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "必要に応じて現地調査の測線を防波堤の方向に延長する等、海草藻類の生育状況を適切に把握すること"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "鳥類については、その風車への衝突の可能性のほか、対象事業実施区域周辺にある既設風車・計画中風車との複合的な影響が、大潟村から対象事業実施区域の数ｋｍ東側に位置する小友沼との間のガン・カモ類やハクチョウ等の渡り鳥の移動経路に及ぶおそれがある"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "渡り鳥の経路に対する既設風車・計画中風車との複合影響についても、可能な限り最新の知見により確認し、適切な予測及び評価を行い、鳥類に対する影響について回避又は低減を図ること"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "可能な限り最新の知見を活用し、必要に応じて風車の設置・稼働による周辺の海流・底質・海底地形への影響と、それらが魚類の生息に与える影響について確認し"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "それらが魚類の生息に与える影響について確認し、適切な予測及び評価を行い、魚類に対する影響について回避又は低減を図ること"@ja.
<< kg:id_17 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "周辺漁業への影響がないか確認し、漁業関係者に十分な説明を行いながら進めること"@ja.
<< kg:id_17 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "周辺漁業への影響がないか確認し、漁業関係者に十分な説明を行いながら進めること"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "風力発電施設や海底ケーブルの存在により周辺の水流が変化し、海底に砂の堆積等が生じ、航路に影響が及ぶおそれがある"@ja.
<< kg:id_22 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "風力発電施設や海底ケーブルの存在により周辺の水流が変化し、海底に砂の堆積等が生じ、航路に影響が及ぶおそれがある"@ja.
<< kg:id_22 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "海底地形及び地質を環境影響評価項目として選定することを検討し、その結果を環境影響評価準備書に記述すること"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "第２.２.６５図以降では除外区域も含め『対象事業実施区域』として示されており、誤解が生じるおそれがある"@ja.
<< kg:id_26 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "準備書では、除外区域を反映させた風車設置範囲を明確にすること"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、必要に応じて環境影響評価の項目及び手法の見直しを行う等、適切に対応すること"@ja.
<< kg:id_31 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "設置する風力発電機の規模や配置等が確定していないことから、事業計画を具体化する過程における検討事項及び結果、その判断に至った経緯を詳細に準備書に記載すること"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "洋上風力発電事業の実施に伴う水中音が海域に生息する動物に及ぼす影響等については十分に解明されていない点もあることから"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "国内外の最新の知見や事例等の集積に努め、必要に応じて調査、予測及び評価に反映すること"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "対象事業実施区域周辺には既設及び建設中の風力発電所並びに火力発電所が存在することから"@ja.
<< kg:id_36 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "これら他事業の諸元等の情報入手に努め、複合的又は累積的な環境影響について適切に調査、予測及び評価すること"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "施設の稼働に伴う騒音及び超低周波音の調査時期について、夏季における窓の開放時間が長い地域特性を考慮し、秋季の調査に加え、夏季においても調査の実施を検討すること"@ja.
}
