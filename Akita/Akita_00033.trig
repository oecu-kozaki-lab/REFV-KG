kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "他事業の諸元等の情報入手に努め適切に調査予測評価すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "大型化の可能性を踏まえ地域住民の理解を得るよう努めるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "配慮が必要な施設や住居への環境影響を回避又は低減すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "事業計画の具体化過程で地域住民の理解確保が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "複数案を明確にし検討内容と結果を方法書以降に記載すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "調査や知見収集に努め評価項目選定を検討すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "知見収集を踏まえ評価項目選定の可否を検討すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_2 rdfs:label "能代市長"@ja.
kg:st_2 rdfs:type cls:st_2.
kg:op_8 prop:content "猛禽類の生息を踏まえ専門家意見も聴取して調査予測評価すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "渡り鳥の飛翔状況を踏まえ鳥類への影響回避又は低減を図るべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "他の風力発電施設の影響も含め累積的に調査予測評価すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "専門家意見を踏まえ鳥類影響の回避低減を図るべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "魚類生息を踏まえ造成工事と施設稼働の影響を調査予測評価すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "周辺漁業への影響がないか確認し影響回避又は低減を図るべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "周辺漁業への影響確認を含め魚類影響の回避低減が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "既設施設の騒音も含め位置や機種を選定し影響回避低減すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "風車配置と機種選定で騒音影響を抑えるべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "位置や機種を選定して風車の影の影響回避低減を図るべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "配置と機種選定で風車の影を抑えるべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "海底地形変化を踏まえ方法書以降に調査等を行うか検討すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "船舶入出港への支障が生じないよう関係機関や専門家の意見を踏まえるべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "航路影響の有無を確認するため調査実施を検討すべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "工事期間重複時に大きな影響がないか可能な限り確認すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "他工事との重複影響を確認すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業実施想定区域周辺の既設及び建設中の風力発電所並びに火力発電所との複合的又は累積的な環境影響を勘案し、これら他事業の諸元等の情報入手に努めながら、適切に調査、予測及び評価すること。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "設置される風力発電所における単機出力等が大型化する可能性があることから"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "事業実施想定区域周辺の配慮が必要な学校、社会福祉施設等や住居への環境影響を回避又は低減するとともに"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事業計画の具体化する過程において、地域住民の理解を得られるよう努めること。"@ja.
<< kg:id_6 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "事業計画の具体化に当たっては、施設の規模・基数又は構造における複数案を明確にして、環境配慮事項の検討内容やその結果を方法書以降の図書に記載すること。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "海域の生態系については、科学的な知見が少なく未解明な部分が多いとされているが"@ja.
<< kg:id_9 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "今後の環境影響評価における調査や知見等の収集に可能な限り努め、それらを踏まえて評価項目として選定することの可否を検討すること。"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業実施想定区域の周辺では、ミサゴ等の猛禽類の生息が確認されている。"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "想定区域から数ｋｍ東側の小友沼には、ガン・カモ類やハクチョウ等の渡り鳥が多数飛来しており、想定区域内でも飛翔している可能性がある。"@ja.
<< kg:id_12 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "事業実施想定区域周辺には多数の風力発電施設が稼働しているほか、現在建設中の施設もある。鳥類の飛翔経路がさらに減少する可能性があることから、他の風力発電施設の影響も含めて"@ja.
<< kg:id_12 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "専門家の意見を聴取の上、調査、予測及び評価を行い、鳥類に対する影響について回避又は低減を図ること。"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "事業実施想定区域にはハタハタ、カレイ類などが生息している。"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "周辺漁業への影響がないか、方法書以降では「造成等の工法による一時的な影響」や「施設の稼働」についても調査、予測及び評価を行い、魚類に対する影響について回避又は低減を図ること。"@ja.
<< kg:id_17 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "方法書以降では「造成等の工法による一時的な影響」や「施設の稼働」についても調査、予測及び評価を行い、魚類に対する影響について回避又は低減を図ること。"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "事業実施想定区域の適地Ｎ-2は、最寄りの民家等まで約１ｋｍである。騒音等については、既設の風力発電施設の騒音等も含め、調査、予測及び評価し、風車の位置や機種を選定し、影響の回避又は低減を図ること。"@ja.
<< kg:id_21 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "騒音等については、既設の風力発電施設の騒音等も含め、調査、予測及び評価し、風車の位置や機種を選定し、影響の回避又は低減を図ること。"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "事業実施想定区域の適地Ｎ-2は、最寄りの民家等まで約１ｋｍである。風車の影について、調査、予測及び評価し、風車の位置や機種を選定し、影響の回避又は低減を図ること。"@ja.
<< kg:id_24 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "風車の影について、調査、予測及び評価し、風車の位置や機種を選定し、影響の回避又は低減を図ること。"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "風力発電施設や海底ケーブルの存在により"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "能代港では漂砂に起因する航路の埋没現象が見られ、船舶の入出港に支障が生じないよう浚渫工事が行われることがある。風力発電施設や海底ケーブルの存在により、漂砂等の流れや堆積場所の変化により航路への影響がないか"@ja.
<< kg:id_26 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "関係機関や専門家の意見を聴取の上、方法書以降に調査等を行うか検討すること。"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "事業実施想定区域周辺では、能代火力発電所第２産業廃棄物最終処分場建設工事が行われている。また、能代火力発電所３号機は、平成３２年度の運転開始に向けて建設工事が行われることとなっている。風力発電施設の工事期間が重なる場合は、大きな影響がないか可能な限り確認すること。"@ja.
<< kg:id_30 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "風力発電施設の工事期間が重なる場合は、大きな影響がないか可能な限り確認すること。"@ja.
}
