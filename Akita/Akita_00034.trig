kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "新たな事情が生じた場合は評価項目や手法を見直し適切に対応すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "準備書では規模や配置を可能な限り明確にし検討内容と結果を詳細に記載すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "他事業の諸元等の情報入手に努め複合的な環境影響を適切に調査予測評価すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "撤去工事計画を明確にし撤去工事に伴う環境影響も調査予測評価すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "残留騒音の受当性も精査した上で適切に調査予測評価すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "専門家の助言を踏まえ必要に応じて調査地点や回数を増やし適切に調査予測評価すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "周辺が主要な渡り経路の可能性を踏まえ適切に調査予測評価すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "鳥類への累積的影響も踏まえて調査予測評価すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "専門家の助言を踏まえ調査回数を必要に応じて増やし最新知見を反映すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "樹木の伐採を極力回避するよう規模や配置を検討すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "海岸植生の維持のため分布拡大を防止する適切な措置を検討すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "必要に応じて調査地点を追加し眺望景観への影響を適切に調査予測評価すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "事業特性や地域特性を踏まえて地下水への影響を検討すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "新たな事情に応じて評価項目や手法を見直すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "規模や配置を明確化し環境保全の配慮内容を詳細に示すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "他事業情報を収集し複合的影響を適切に評価すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "撤去工事も新設工事と併せて環境影響評価すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "騒音指針や測定マニュアルを踏まえ残留騒音を精査すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "チュウヒや渡り鳥への影響を踏まえ調査地点や回数を増やすべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "既設機の調査回数を増やし国内外の最新知見や事例を反映すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "自然景観資源である風の松原への配慮から伐採回避を優先すべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "搬出入や建設機械の稼働影響にも十分配慮した計画とすべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "外来種ニセアカシヤの発芽拡大を防止する措置を講じるべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "住居周辺からの景観も含め必要に応じて調査地点を追加すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "地下水影響は事業特性と地域特性を踏まえて検討すべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:st_2 rdfs:label "能代市長"@ja.
kg:st_2 rdfs:type cls:st_2.
kg:op_26 prop:content "ピーク時を的確に把握できる調査時期や回数を検討し根拠を明記すべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "渡り鳥への移動阻害は既設風車や計画中風車との複合影響も検討すべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "騒音や超低周波音の調査地点は複合影響が特に懸念される地点を再検討すべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "既設施設との複合影響が特に懸念される地点を踏査し調査地点を再検討すべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "小友沼の渡りピークやハクチョウ類の夜間行動を踏まえた調査設計を示すべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "移動阻害は既設風車や計画中風車との複合影響として結果を明示すべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "騒音と超低周波音の調査地点は既設大型風車や洋上風力計画との複合影響を踏まえて見直すべき"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、必要に応じて環境影響評価の項目及び手法の見直しを行う等、適切に対応すること。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "設置する風力発電機の規模や配置等が確定していないことから、準備書においては、これらを可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を詳細に記載すること。"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "対象事業実施区域周辺には既設及び計画中の風力発電所が存在することから、これら他事業の諸元等の情報入手に努め、複合的な環境影響について適切に調査、予測及び評価すること。"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "既設風力発電機の撤去工事を風力発電機の新設工事と並行して実施する計画であることから、準備書においては、撤去に係る工事計画を可能な限り明確にするとともに、撤去工事の実施に伴う環境影響についても、適切に調査、予測及び評価すること。"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "新設風力発電機の稼働に伴う騒音の影響について、「風力発電施設から発生する騒音に関する指針」及び「風力発電施設から発生する騒音等測定マニュアル」の残留騒音の算出方法等を踏まえ、既設風力発電機の寄与や残留騒音の妥当性について精査した上で、適切に調査、予測及び評価すること。"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "対象事業実施区域周辺ではチュウヒの営巣や繁殖行動が確認されているほか、同区域周辺に位置する小友沼や八郎潟干拓地は、国際的に重要なガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地であるため、周辺は主要な渡り経路である可能性がある。加えて、周辺には既設及び計画中の風力発電所が多数存在することから、これら鳥類への影響が懸念される。"@ja.
<< kg:id_10 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "同区域周辺に位置する小友沼や八郎潟干拓地は、国際的に重要なガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地であるため、周辺は主要な渡り経路である可能性がある。"@ja.
<< kg:id_10 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "加えて、周辺には既設及び計画中の風力発電所が多数存在することから、これら鳥類への影響が懸念される。"@ja.
<< kg:id_14 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "新設風力発電機の稼働に伴う鳥類及びコウモリ類への影響について、専門家等の助言を踏まえ、既設風力発電機におけるバードストライク及びバットストライクの調査回数を必要に応じて増やす等、適切な状況把握に努めるとともに、国内外の最新の知見や事例等を収集し、可能な限り予測及び評価に反映すること。"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "対象事業実施区域及びその周辺には、自然景観資源である「風の松原」が広く分布していることから、工事の実施に伴う樹木の伐採を極力回避するよう、風力発電機の規模や配置等を検討するとともに、工事用資材等の搬出入や建設機械の稼働に伴う影響についても、専門家等の助言を踏まえ、十分配慮した計画とすること。"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "対象事業実施区域には外来種であるニセアカシヤが侵入しているため、マツ林を伐採後に重機で整地した場合、一斉にニセアカシヤが発芽する可能性があることから、海岸植生の維持のため、専門家等の助言を踏まえ、分布拡大を防止するよう適切な措置を検討すること。"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "対象事業実施区域の周辺には住居等が存在し、また新設風力発電機は既設風力発電機より大型化することから、日常的な生活環境の場からの景観も勘案し、必要に応じて調査地点を追加する等、眺望景観への影響を適切に調査、予測及び評価すること。"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "事業の実施に伴う地下水への影響について、事業特性や地域特性を踏まえて検討すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、必要に応じて環境影響評価の項目及び手法の見直しを行う等、適切に対応すること。"@ja.
<< kg:id_3 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "設置する風力発電機の規模や配置等が確定していないことから、準備書においては、これらを可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を詳細に記載すること。"@ja.
