kg:st_1 rdfs:label "専門家"@ja.
kg:st_1 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_1 prop:content "チュウヒの行動圏内部構造を適切に解析すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "専門家等"@ja.
kg:st_2 rdfs:type cls:st_37.
kg:op_2 prop:content "追加的な環境保全措置を講じるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "追加的な環境保全措置が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "追加的な環境保全措置の実施を検討すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "適切な種を選定すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:text-txt_contents "事業の実施に当たっては、工事施工業者等への指導に努め、環境保全措置の確実な履行を確保すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:text-txt_contents "また、最新の知見や技術等を可能な範囲で導入することにより、一層の環境影響の低減に努めること。"@ja.
<< kg:id_4 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講じること。"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:text-txt_contents "対象事業実施区域の周辺には多数の住居が存在することから、工事中及び供用後に周辺の住民等から苦情が発生した場合は、適切に対応すること。"@ja.
<< kg:id_6 prop:contermeasure kg:id_8 >>
    prop:text-txt_contents "工事中及び供用後に周辺の住民等から苦情が発生した場合は、適切に対応すること。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "県内の一部地域では風力発電機の設置が原因と考えられる電波障害が発生している"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:text-txt_contents "事業の実施に当たっては生活環境への影響に十分配慮するとともに"@ja.
<< kg:id_9 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "事業の実施に当たっては生活環境への影響に十分配慮するとともに"@ja.
<< kg:id_9 prop:contermeasure kg:id_13 >>
    prop:text-txt_contents "影響が生じた場合は、関係法令等に従って適切に対応すること。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "本事業の実施によるこれら希少猛禽類への重大な影響が懸念される。"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:text-txt_contents "一部の風力発電機はチュウヒの営巣中心域内に設置する計画となっていることから、工事の実施による営巣及び繁殖への影響"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:text-txt_contents "施設の稼働によるバードストライクの発生等が懸念される。"@ja.
<< kg:id_14 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "専門家の意見を踏まえた適切なチュウヒの行動圏内部構造の解析を改めて実施し"@ja.
<< kg:id_14 prop:contermeasure kg:id_21 >>
    prop:text-txt_contents "その結果に基づき希少猛禽類への影響を回避又は極力低減するよう風力発電機の配置を再検討すること。"@ja.
<< kg:id_16 prop:contermeasure kg:id_22 >>
    prop:text-txt_contents "チュウヒの営巣期における工事は原則回避するとともに"@ja.
<< kg:id_16 prop:contermeasure kg:id_23 >>
    prop:text-txt_contents "工事の実施による営巣及び繁殖への影響について適切に事後調査を行い"@ja.
<< kg:id_24 prop:contermeasure kg:id_25 >>
    prop:text-txt_contents "重大な影響が確認された場合は、工事を中止する"@ja.
<< kg:id_24 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "専門家等からの助言を踏まえ、追加的な環境保全措置を講じた上で工事を再開すること。"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:text-txt_contents "鳥類等の風力発電機への衝突に係る"@ja.
<< kg:id_27 prop:contermeasure kg:id_29 >>
    prop:text-txt_contents "バードストライクに係る事後調査を適切に実施し"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:text-txt_contents "鳥類等への重大な影響が確認された場合は、原因の解明に努め"@ja.
<< kg:id_30 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "専門家等からの助言を踏まえた追加的な環境保全措置を講ずること。"@ja.
<< kg:id_32 prop:cause kg:id_19 >>
    prop:text-txt_contents "施設の稼働によるこれら渡り鳥の移動経路の阻害"@ja.
<< kg:id_18 prop:cause kg:id_33 >>
    prop:text-txt_contents "施設の稼働によるこれら渡り鳥の移動経路の阻害やバードストライクの発生等の影響が懸念される。"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:text-txt_contents "供用後の渡り鳥の飛翔状況の変化等について、環境監視を行うこと等により適切に把握し"@ja.
<< kg:id_34 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "渡り鳥に対する重大な影響が確認された場合は、専門家等からの助言を踏まえ、追加的な環境保全措置の実施を検討すること。"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:text-txt_contents "用地造成後の法面部分及び現状の風力発電機の用地盛土部分の撤去箇所において種子吹付又は植樹による緑化を行うこととしているが"@ja.
<< kg:id_37 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "緑化工事の実施に当たっては専門家等の意見を踏まえ、適切な種を選定することにより"@ja.
<< kg:id_37 prop:contermeasure kg:id_40 >>
    prop:text-txt_contents "実施区域及びその周辺の植物及び生態系への影響を回避又は低減すること。"@ja.
}
