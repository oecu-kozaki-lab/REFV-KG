kg:st_1 rdfs:label "秋田県"@ja.
kg:st_1 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "既設及び建設中の風力発電所との複合的な環境影響を考慮して調査予測評価すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "農地の農作業者への騒音影響を予測評価すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "農地の農作業者への超低周波音影響を予測評価すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "農地の農作業者への振動影響を予測評価すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "年間状況を正確に把握するため季節ごとの調査期間設定が必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "海岸林改変による間接的影響の可能性を踏まえるべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "工事の一時的影響にとどまらず海岸植生への長期影響を調査予測評価すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "工事の一時的影響にとどまらず地形等への長期影響を調査予測評価すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "海岸植生や地形等への長期影響を調査予測評価すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "対象事業実施区域周辺には、既設の風力発電所及び建設中の風力発電所が存在することから、それらの風力発電所との複合的な環境影響を考慮し、調査、予測及び評価すること。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "対象事業実施区域周辺の農地における農作業者に対する騒音及び超低周波音並びに振動の影響について、予測及び評価すること。"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "対象事業実施区域周辺の農地における農作業者に対する騒音及び超低周波音並びに振動の影響について、予測及び評価すること。"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "対象事業実施区域周辺の農地における農作業者に対する騒音及び超低周波音並びに振動の影響について、予測及び評価すること。"@ja.
<< kg:id_3 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "風力発電設備の稼働に伴う騒音及び超低周波音の調査期間について、年間の状況を正確に把握する必要があることから、季節ごとに1週間程度の調査期間を設定すること。"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "海岸林が改変されることにより、風による地形の浸食などの間接的な影響が生じる可能性があることから、工事による一時的な影響にとどまらず、長期にわたる海岸植生や地形等に対する影響について、調査、予測及び評価すること。"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "海岸林が改変されることにより、風による地形の浸食などの間接的な影響が生じる可能性があることから、工事による一時的な影響にとどまらず、長期にわたる海岸植生や地形等に対する影響について、調査、予測及び評価すること。"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "海岸林が改変されることにより、風による地形の浸食などの間接的な影響が生じる可能性があることから、工事による一時的な影響にとどまらず、長期にわたる海岸植生や地形等に対する影響について、調査、予測及び評価すること。"@ja.
<< kg:id_8 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "海岸林が改変されることにより、風による地形の浸食などの間接的な影響が生じる可能性があることから、工事による一時的な影響にとどまらず、長期にわたる海岸植生や地形等に対する影響について、調査、予測及び評価すること。"@ja.
