kg:id_15 rdf:type cls:c_13851.
kg:id_12 prop:contermeasure kg:id_15.
kg:id_16 rdfs:label "送電設備"@ja.
kg:id_16 rdf:type cls:c_13852.
cls:c_13852 rdfs:label "送電設備"@ja.
kg:id_17 rdfs:label "鳥類への影響"@ja.
kg:id_17 rdf:type cls:c_6.
cls:c_6 rdfs:label "鳥類影響"@ja.
kg:id_16 prop:effect kg:id_17.
kg:id_18 rdfs:label "鳥類への影響を回避低減するよう送電設備の施工方法やルートを再検討"@ja.
kg:id_18 rdf:type cls:c_13391.
cls:c_13391 rdfs:label "影響回避"@ja.
kg:id_16 prop:contermeasure kg:id_18.
kg:st_1 rdfs:label "秋田県"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "環境保全措置を確実に実施し責任体制を明確化すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "最新の知見や技術を導入して環境影響を一層低減すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "予測できない環境保全上の問題が生じた場合は速やかに対応すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "問題発生時は速やかに調査し関係機関と協議して適切な措置を講じるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "騒音と超低周波音の予測条件を再確認し必要に応じて再評価すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "南側の建設中風力発電所との複合影響を予測評価すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "建設中風力発電所の諸元を確認し複合影響を評価書へ反映すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "複合影響の評価結果に応じて追加の環境保全措置を講じるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "周辺の他事業者風力発電所の存在により複合影響が懸念される"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "施設稼働後に周辺住民の苦情が発生するおそれがある"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "住民苦情が出た場合は原因を速やかに調査し適切に対応すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "送電設備が鳥類に影響を及ぼす可能性がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "鳥類への影響を避けるため施工方法やルートを見直すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業の実施に当たっては、環境保全措置の確実な履行を確保するため、責任の所在を明確にするとともに、工事施工業者等への指導に努めること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "また、最新の知見や技術等を可能な範囲で導入することにより、一層の環境影響の低減に努めること。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講じること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講じること。"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "準備書に記載されている風力発電機から発生する騒音のパワーレベル及び周波数特性と設置する風力発電機との整合性を確認し、必要に応じて、予測及び評価を再度行い、その結果を評価書に反映すること。"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業実施区域南側に建設中の風力発電所との複合的な影響については予測及び評価を行っていないことから、建設中の風力発電機の諸元を確認し、複合的な影響について予測及び評価を行い、その結果を評価書に反映すること。"@ja.
<< kg:id_8 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業実施区域南側に建設中の風力発電所との複合的な影響については予測及び評価を行っていないことから、建設中の風力発電機の諸元を確認し、複合的な影響について予測及び評価を行い、その結果を評価書に反映すること。"@ja.
<< kg:id_8 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "また、評価の結果に基づき、必要に応じて追加的な環境保全措置を講じること。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "事業実施区域周辺には、他の事業者による風力発電所が存在することから、これら風力発電所との複合的な影響が懸念されるため、"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "施設の稼働に伴い周辺住民から苦情が発生した場合は、"@ja.
<< kg:id_12 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "速やかにその原因を調査し、必要に応じて適切な措置を講じること。"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "このような遮蔽設備等は鳥類に影響を及ぼす可能性があることから、"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "鳥類への影響を回避、低減するよう送電設備の施工方法やルートを再検討すること。"@ja.
}
