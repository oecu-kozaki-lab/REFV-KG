kg:id_1 rdfs:label "若美風力発電事業"@ja.
kg:id_1 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "環境保全措置の確実な履行と責任の所在の明確化"@ja.
kg:id_2 rdf:type cls:c_9.
cls:c_9 rdfs:label "環境保全措置"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "最新の知見や技術等の導入による環境影響の低減"@ja.
kg:id_3 rdf:type cls:c_13737.
cls:c_13737 rdfs:label "環境影響低減"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "現段階で予測し得ない環境保全上の問題の発生"@ja.
kg:id_4 rdf:type cls:c_533.
cls:c_533 rdfs:label "環境問題"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "予測し得ない環境保全上の問題の速やかな調査と関係機関協議の上での適切な措置"@ja.
kg:id_5 rdf:type cls:c_13851.
cls:c_13851 rdfs:label "問題対応"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "風力発電機から発生する騒音及び超低周波音"@ja.
kg:id_6 rdf:type cls:c_108.
cls:c_108 rdfs:label "騒音"@ja.
kg:id_7 rdfs:label "パワーレベル及び周波数特性と設置する風力発電機との整合性確認と必要に応じた予測及び評価の再実施"@ja.
kg:id_7 rdf:type cls:c_316.
cls:c_316 rdfs:label "予測評価"@ja.
kg:id_6 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "建設中の風力発電所との複合的な影響"@ja.
kg:id_8 rdf:type cls:c_317.
cls:c_317 rdfs:label "複合影響"@ja.
kg:id_9 rdfs:label "事業実施区域南側の建設中風力発電所との複合的影響"@ja.
kg:id_9 rdf:type cls:c_317.
kg:id_8 prop:effect kg:id_9.
kg:id_10 rdfs:label "風力発電機の諸元確認と複合的影響の予測及び評価の実施と評価書への反映"@ja.
kg:id_10 rdf:type cls:c_316.
kg:id_8 prop:contermeasure kg:id_10.
kg:id_11 rdfs:label "評価結果に基づく追加的な環境保全措置"@ja.
kg:id_11 rdf:type cls:c_9.
kg:id_8 prop:contermeasure kg:id_11.
kg:id_12 rdfs:label "他の事業者による風力発電所との複合的な影響"@ja.
kg:id_12 rdf:type cls:c_317.
kg:id_13 rdfs:label "事業実施区域周辺に他の事業者による風力発電所が存在すること"@ja.
kg:id_13 rdf:type cls:c_410.
cls:c_410 rdfs:label "風力発電所"@ja.
kg:id_12 prop:cause kg:id_13.
kg:id_14 rdfs:label "施設の稼働に伴う周辺住民からの苦情の発生"@ja.
kg:id_14 rdf:type cls:c_13549.
