kg:op_1 prop:content "専門家の助言や最新知見を踏まえ環境影響の回避又は低減を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "意見聴取は複数の専門家に対して行い客観性及び妥当性の確保に努めるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地域住民や地元自治体等に丁寧な説明を行い理解を得るよう求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域住民等から情報収集し影響の調査予測結果を位置・規模等の決定に反映すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "方法書では位置・規模等を明確にし環境保全配慮の検討内容と結果を記載すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "他事業者との情報共有により累積的な影響の回避又は低減を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "周辺の風力発電所との累積的影響を避けるため他事業者との情報共有を求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "現地調査結果や専門家の助言を踏まえ鳥類への影響回避又は低減を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "魚食性鳥類の生息を踏まえ鳥類への影響回避又は低減を求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "周辺風力発電所の存在により鳥類への累積的影響を懸念している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "鳥類の移動経路の遮断や阻害を回避又は低減すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "バードストライクの発生回避又は低減を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "事業の位置・規模等の決定では現地調査と専門家助言を踏まえるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "重要な産卵場や回遊経路の可能性があるため海生生物への影響を懸念している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "海生生物への影響の回避又は低減を求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "専門家助言や最新知見を踏まえ生息状況を把握して海生生物への影響を低減すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "主要な眺望点の存在を踏まえ景観影響を懸念している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "眺望景観への影響の回避又は低減を求める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "地域住民等の意見を踏まえて景観影響を回避又は低減すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "主要な眺望点の設定では地域住民等の情報収集を行い生活環境からの景観にも配慮すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本事業の実施による環境影響を可能な限り回避又は低減するよう配慮すること"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "意見聴取は複数の専門家に対して行うなど、環境影響評価の客観性及び妥当性の確保に努めること"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本事業の実施に当たっては、地域住民や地元自治体等（以下「地域住民等」という。）に丁寧な説明を行い、理解を得るよう努めること"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "地域住民等からの情報収集に努め、影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価して事業の「位置・規模」及び「配置・構造」の決定に反映すること"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "方法書においては、事業の位置・規模等を可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を記載すること"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "想定区域周辺には、既設及び計画中の風力発電所が多数存在することから、他事業者との情報共有に努め、本事業の実施による累積的な影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "他事業者との情報共有に努め、本事業の実施による累積的な影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "想定区域は、ガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地である小友沼の北西に位置しており、渡りの時期等における主要な移動経路となっている可能性がある"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "想定区域及びその周辺では沿岸部を生活域としている魚食性鳥類の生息が確認されている"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "当該区域周辺には既設及び計画中の風力発電所が多数存在することから、本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "事業の位置・規模等の決定に当たっては、今後の現地調査の結果や専門家の助言を踏まえ、本事業の実施による鳥類への影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "想定区域及びその周辺の海域は、県の魚であるハタハタ等の産卵場及び稚魚の生育場並びに溯河性魚類であるサクラマス等の重要な回遊経路となっている可能性があることから、本事業の実施によるこれら海生生物への影響が懸念される"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "本事業の実施によるこれら海生生物への影響が懸念される"@ja.
<< kg:id_1 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "専門家の助言や国内外における最新の知見・事例等を踏まえ、可能な限り生息状況を適切に把握した上で、本事業の実施による海生生物への影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "想定区域周辺には主要な眺望点である「能代海水浴場」や「ポンポコ山公園」等が存在することから、本事業の実施によるこれら眺望点からの眺望景観への影響が懸念される"@ja.
<< kg:id_1 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "本事業の実施によるこれら眺望点からの眺望景観への影響が懸念される"@ja.
<< kg:id_1 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "事業の位置・規模等の決定に当たっては、地域住民等からの意見を踏まえ、本事業の実施による景観への影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "主要な眺望点の設定に当たっては、地域住民等からの情報収集に努め、日常的な生活環境の場からの景観についても十分に配慮すること"@ja.
}
