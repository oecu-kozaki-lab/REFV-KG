kg:op_1 prop:content "生活環境への影響の回避又は低減を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "周辺住居があるため生活環境への配慮を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "生活環境への影響を回避又は低減するよう配慮を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域住民等に丁寧な説明を行い理解を得るよう求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "影響調査と予測結果を事業計画に反映すべきとする"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "方法書で位置規模や環境保全配慮の内容を明確化すべきとする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "周辺風力発電所との複合的影響に注意を求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "他事業者と情報共有し複合的影響の回避又は低減を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "撤去工事による環境影響も対象に含めるべきとする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "撤去工事の環境影響について適切な調査予測評価を求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "撤去工事を含め本事業による影響の回避又は低減を求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "大型化した風力発電機による影響に配慮を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "住居が近接するため影響回避が必要とする"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "住居への騒音や風車の影の低減を求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "住居と風車の距離を適切に確保すべきとする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "騒音や超低周波音などの影響回避又は低減を求める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "希少鳥類の生息を踏まえ影響を懸念する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "渡り経路の可能性があるため鳥類影響を懸念する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "本事業による鳥類への影響を懸念する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "調査結果や専門家助言を踏まえて配置を決定すべきとする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "鳥類への影響の回避又は低減を求める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "自然度の高い植生の存在可能性を踏まえ配慮を求める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "保安林の存在を踏まえ影響回避を求める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "既存の造成地や管理用道路の活用を求める"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "植物及び生態系への影響の回避又は低減を求める"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "主要な眺望点があるため景観影響を懸念する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "大型化計画により景観影響が懸念されるとする"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "眺望点からの景観への影響を懸念する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "地域住民等への周知と意見聴取を求める"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "景観への影響の回避又は低減を求める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "活動の場が存在するため影響に配慮を求める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "工事や供用に伴う騒音振動や風車の影を懸念する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "活動の場への騒音振動等の影響を懸念する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "地域住民等への周知と意見聴取を求める"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "現地調査結果を踏まえて対応すべきとする"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "工事の実施及び施設の供用に伴う生活環境への影響"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業実施想定区域の周辺には複数の住居が存在することから、工事の実施及び施設の供用に伴う生活環境への影響"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "工事の実施及び施設の供用に伴う生活環境への影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "地域住民や地元自治体等に丁寧な説明を行い、理解を得るよう努めること"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価して事業の位置・規模及び配置・構造の決定に反映すること"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "方法書においては、事業の位置・規模等を可能な限り明確にするとともに、具体的な環境の保全の配慮に係る検討内容やその結果を記載すること"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "想定区域周辺には、既設及び計画中の風力発電所が存在することから、本事業の実施に伴う複合的な影響"@ja.
<< kg:id_10 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "他事業者との情報共有に努め、本事業の実施に伴う複合的な影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "既設風力発電機の撤去に係る工事計画を可能な限り明確にするとともに、撤去工事の実施に伴う環境影響"@ja.
<< kg:id_13 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "撤去工事の実施に伴う環境影響についても、適切に調査、予測及び評価を行い"@ja.
<< kg:id_13 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本事業の実施による影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "新設する風力発電機は、既設の風力発電機より大型化する計画となっていることに加え"@ja.
<< kg:id_17 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
