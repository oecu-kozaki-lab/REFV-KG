<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "住居等が存在しており、大気質、騒音及び超低周波音、振動、風車の影等の影響が生じるおそれがあることから、調査、予測及び評価すること"@ja.
<< kg:id_5 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "住居等が存在しており、大気質、騒音及び超低周波音、振動、風車の影等の影響が生じるおそれがあることから、調査、予測及び評価すること"@ja.
<< kg:id_5 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "住居等が存在しており、大気質、騒音及び超低周波音、振動、風車の影等の影響が生じるおそれがあることから、調査、予測及び評価すること"@ja.
<< kg:id_5 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "風力発電設備の稼働に伴う騒音及び超低周波音の調査期間について、年間の状況を正確に把握する必要があることから、季節ごとに1週間程度の調査期間を設定すること"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "対象事業実施区域周辺の道路においては、風車の影が走行車両に及ぼす影響について予測及び評価すること"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "造成等の施工による一時的な影響を要因とする動物、植物及び生態系への影響について、環境影響評価項目として選定すること"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "造成等の施工による一時的な影響を要因とする動物、植物及び生態系への影響について、環境影響評価項目として選定すること"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "対象事業実施区域は、渡り鳥のねぐらである八郎潟調整池と餌場として利用されている水田を分断する形で計画されており、多数の鳥類がねぐらと餌場を行き来する際に、高頻度でのバードストライクの発生が懸念されることから"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "対象事業実施区域は、渡り鳥のねぐらである八郎潟調整池と餌場として利用されている水田を分断する形で計画されており、多数の鳥類がねぐらと餌場を行き来する際に、高頻度でのバードストライクの発生が懸念されることから"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "事業計画の具体化に当たっては、風力発電設備の配置等の見直しを含めて、慎重な検討を行うこと"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "対象事業実施区域の位置する中央幹線排水路沿いのヨシ原は本種の重要な営巣環境であり、事業の実施により営巣環境の消失やバードストライクの発生が懸念されることから"@ja.
<< kg:id_20 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "対象事業実施区域の位置する中央幹線排水路沿いのヨシ原は本種の重要な営巣環境であり、事業の実施により営巣環境の消失やバードストライクの発生が懸念されることから"@ja.
<< kg:id_1 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "「猛禽類保護の進め方（改訂版）」（平成24年環境省）を参考に、2営巣期を含む複数年にわたる現地調査を実施すること"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "鳥類の現地調査の回数や頻度については、既存文献等の調査や専門家等へのヒアリングを十分に行い、日によって変化の大きい渡りの時期の生息状況等を不足なく把握できるように設定すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "既存文献等の調査や専門家等へのヒアリングを十分に行い、日によって変化の大きい渡りの時期の生息状況等を不足なく把握できるように設定すること"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "また、建設予定地が大潟村を縦断しており、渡り鳥の飛翔は広範囲に及ぶことが予想されるので"@ja.
<< kg:id_1 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "飛翔個体の見落としのないよう、調査員を適切に配置して全体を把握すること"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "風力発電設備の間を結ぶ送電線設備は、コンクリート柱による架空送電線が計画されており、鳥類の飛翔行動に影響を及ぼす可能性がある"@ja.
<< kg:id_1 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "風力発電設備本体だけでなく送電線設備の存在についても、予測及び評価の対象とすること"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "工事に伴う濁水及び地下水に含まれるリンによる水生植物への影響が懸念されることから"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "工事に伴う濁水及び地下水に含まれるリンによる水生植物への影響が懸念されることから"@ja.
<< kg:id_1 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "調査を行い、現況を把握し、予測及び評価すること"@ja.
<< kg:id_1 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "菜の花ロードや、渡り鳥として飛来するガン類等を観察するバードウォッチング、承水路における魚釣りなど、様々な人と自然とのふれあいの活動の場が存在することから、環境影響評価項目として選定すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "様々な人と自然とのふれあいの活動の場が存在することから、環境影響評価項目として選定すること"@ja.
}
