kg:id_37 rdf:type cls:c_13626.
cls:c_13626 rdfs:label "評価項目"@ja.
kg:id_1 prop:contermeasure kg:id_37.
kg:st_1 rdfs:label "秋田県生活環境部環境管理課環境審査班"@ja.
kg:st_1 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_1 prop:content "鳥類への著しい影響のおそれを踏まえ入念な現地調査と適切な予測評価が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "鳥類への影響を踏まえ現地調査に基づく予測評価を徹底すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "環境保全措置の検討では事業計画の見直しも含めるべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "住居等への大気質の影響を調査予測評価すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "住居等や農作業者への騒音影響を評価すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "住居等や農作業者への超低周波音影響を評価すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "住居等や農作業者への振動影響を評価すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "住居等や走行車両への風車の影の影響を評価すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "年間状況を正確に把握するため季節ごとの調査期間設定が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "周辺道路での走行車両への影響も予測評価すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "施工による一時的影響も環境影響評価項目に選定すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "施工由来の生態系影響を評価対象に含めるべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "渡り鳥のねぐらと餌場を分断する計画はバードストライク懸念が高い"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "計画区域配置によりバードストライク発生が懸念される"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "バードストライク懸念を踏まえ設備配置の見直しを含め慎重に検討すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "チュウヒの重要な営巣環境の消失を避けるため複数年調査が必要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "チュウヒ生息地ではバードストライク発生も懸念される"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "猛禽類保護の観点から複数年の現地調査を行うべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "渡り時期は日による変化が大きく十分な調査回数設定が必要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "文献調査と専門家ヒアリングを踏まえて鳥類調査計画を設定すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "建設予定地が村を縦断するため渡り鳥の飛翔範囲が広い"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "飛翔個体の見落としを避けるため調査員配置を適切にすべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "送電線設備も鳥類飛翔への影響評価対象に含めるべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "風車本体だけでなく送電線設備も評価対象に含めるべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "濁水や地下水中リンによる水生植物影響を懸念し現況把握が必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "水生植物への影響を調査し予測評価すべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "水生植物への影響把握のため調査と予測評価を実施すべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "菜の花ロードやバードウォッチングなど自然とのふれあい活動の場への影響も評価すべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "自然とのふれあい活動の場も評価項目に含めるべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本事業がこの地域を利用する鳥類に著しい影響を与えるおそれがあることを念頭に置いて、入念な現地調査に基づく適切な予測及び評価を実施するとともに"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "入念な現地調査に基づく適切な予測及び評価を実施するとともに"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "環境保全措置の検討に当たっては、必要に応じて対象事業実施区域の位置等事業計画の見直しを行うなど"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "住居等が存在しており、大気質、騒音及び超低周波音、振動、風車の影等の影響が生じるおそれがあることから、調査、予測及び評価すること"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
