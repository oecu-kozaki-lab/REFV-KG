kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "地域住民の生活環境に十分配慮し影響が生じた場合は適切な対応を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "事業実施に当たり地域住民の生活環境への十分な配慮を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "新たな事情に応じて評価項目や手法を見直し適切に対応すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "先行事例が少ないため専門家の助言や最新知見を踏まえた調査評価を求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "区域の不一致で調査不足とならないよう調査範囲や地点の見直しを求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "事業の影響を適切に把握するため調査範囲見直しや地点追加を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "準備書では事業計画を明確化し保全配慮の検討内容を詳細に示すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地域住民等へ広く周知し丁寧に説明して理解を得るよう求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "他事業との累積的影響を考慮した調査評価を求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "他事業の諸元把握に努め累積的影響を適切に評価すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "累積影響評価のため他事業者から求めがあれば情報提供に努めるべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:st_2 rdfs:label "地域住民等"@ja.
kg:st_2 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_12 prop:content "工事計画では騒音による生活環境への影響回避を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "意見を踏まえ騒音影響の回避と適切な調査評価を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "工事計画の検討に当たり地域住民等の意見反映を求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "近接住居等を踏まえ必要に応じて調査地点の追加見直しを求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "施設稼働による騒音の生活環境影響を適切に調査評価すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "底質や流向流速を把握し水の濁りへの影響評価を求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "ケーブル敷設に伴う巻き上げを考慮し水質影響の調査評価を求める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "水の濁りへの影響を適切に調査予測評価すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "底質や流向流速を把握し必要に応じて調査地点追加見直しを行うべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "渡り鳥の飛翔経路や高度を詳細に把握し影響評価を求める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "既設計画中風力との累積影響を含め鳥類への影響評価を求める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "鳥類への累積的影響を適切に調査予測評価すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "専門家助言を踏まえ鳥類の飛翔経路や高度を詳細に把握すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "コウモリ類の移動経路の可能性を踏まえ調査地点の追加見直しを求める"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "専門家助言を踏まえ必要に応じて調査地点追加見直しを行うべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "魚類や卵稚仔を含む海生生物への影響評価を求める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "回遊魚類への影響を考慮した調査評価を求める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "藻場が産卵場である点を踏まえ海生生物影響の評価を求める"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "海生生物への影響が懸念されるため適切な調査評価を求める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "専門家助言を踏まえ対象魚種を選定し生息状況を把握して評価すべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "最新知見や事例を集積し水中音影響の調査評価へ反映すべき"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "水中音の影響は未解明な点があるため最新知見の集積と反映を求める"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "眺望点設定では地域住民等の意見反映を求める"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "主要な眺望点設定で必要に応じた調査地点追加を求める"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "フォトモンタージュ等に加え眺望方向や時間帯も考慮した景観評価を求める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "風力発電機の規模や配置の検討結果について丁寧な説明を求める"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "地域住民等への丁寧な説明と述べられた意見の十分な勘案を求める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "県内の一部地域では風力発電所の設置が原因とみられる電波障害が発生している"@ja.
<< kg:id_2 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "県内の一部地域では風力発電所の設置が原因とみられる電波障害が発生していることから、事業の実施に当たっては地域住民の生活環境に十分配慮する"@ja.
<< kg:id_4 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、これらについて必要に応じて見直しを行う等、適切に対応すること"@ja.
<< kg:id_4 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "専門家の助言や国内外における最新の知見・事例等を踏まえ、適切に調査、予測及び評価すること"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "実施区域と促進区域が一致しない等により、適切な調査が行われない又は行われていないと判断される場合"@ja.
<< kg:id_4 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "調査範囲の見直しや調査地点の追加等を行うことにより、本事業の実施による影響を適切に調査、予測及び評価すること"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "設置する風力発電機の配置のほか、工事の規模や方法等が確定していないことから、準備書においては事業計画を可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を詳細に記載すること"@ja.
<< kg:id_4 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "地域住民や地元自治体等に広く周知するとともに丁寧な説明を行い、理解を得るよう努めること"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "実施区域周辺には既設及び計画中の風力発電所が存在することから、これら他事業の諸元等の情報入手に努め、累積的な影響が懸念される"@ja.
<< kg:id_4 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "これら他事業の諸元等の情報入手に努め、累積的な影響が懸念される項目について、適切に調査、予測及び評価すること"@ja.
<< kg:id_4 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本事業に係る風力発電機の配置や諸元等の情報を求められた場合は、情報提供に努めること"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "建設機械の稼働に伴う騒音による生活環境への影響"@ja.
<< kg:id_4 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "工事計画の検討に当たっては、地域住民等の意見を踏まえ、建設機械の稼働に伴う騒音による生活環境への影響を回避するとともに、当該影響について、適切に調査、予測及び評価すること"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "実施区域により近接した住居等が存在することから、必要に応じて調査地点の追加や見直しを検討する"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "施設の稼働に伴う騒音による生活環境への影響について、適切に調査、予測及び評価すること"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻き上げ等が発生するおそれがある"@ja.
<< kg:id_26 prop:cause kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻き上げ等が発生するおそれがある"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "工事の実施に伴う水の濁りへの影響について、適切に調査、予測及び評価すること"@ja.
<< kg:id_4 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握し、必要に応じて調査地点の追加や見直しを検討する"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "小友沼や八郎潟干拓地は、国際的に重要なガン・カモ・ハクチョウ類等の集団渡来地であることから、実施区域及びその周辺は渡り鳥の主要な渡り経路となっている可能性がある"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "実施区域周辺には既設及び計画中の風力発電所が多数存在することから、累積的な影響によるこれら鳥類への影響が懸念される"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "累積的な影響によるこれら鳥類への影響が懸念される"@ja.
<< kg:id_4 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "専門家等の助言を踏まえ、当該区域及びその周辺の上空を通過する鳥類の飛翔経路や高度等を詳細に把握し、本事業の実施による鳥類への影響について、適切に調査、予測及び評価すること"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "男鹿半島には、県指定の天然記念物である「男鹿のコウモリ生息地」が存在し、実施区域の上空が貴重なコウモリ類の移動経路となっている可能性がある"@ja.
<< kg:id_4 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "専門家等の助言を踏まえ、必要に応じて調査地点の追加や見直しを検討する等により、本事業の実施によるコウモリ類への影響について、適切に調査、予測及び評価すること"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "実施区域及びその周辺の海域は、県の魚であるハタハタ稚仔の生育場となっている"@ja.
<< kg:id_41 prop:cause kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "溯河性魚類であるサクラマス、サケ及びアユ等の回遊経路となっている"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "実施区域周辺の海域の一部には藻場が存在しており、ハタハタの産卵場となっている"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "本事業の実施によるこれら海生生物への影響が懸念される"@ja.
<< kg:id_4 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "専門家等の助言を踏まえ、ハタハタ及びサクラマス等の魚種を予測対象種として選定し、可能な限り生息状況を把握した上で、適切に調査、予測及び評価すること"@ja.
<< kg:id_47 prop:effect kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "洋上風力発電事業の実施に伴う水中音が海域に生息する動物に及ぼす影響"@ja.
<< kg:id_4 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "国内外の最新の知見や事例等の集積に努め、水中音の影響に係る調査、予測及び評価に適切に反映すること"@ja.
<< kg:id_4 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "主要な眺望点の設定に当たっては、地域住民等の意見を踏まえ、必要に応じて調査地点を追加すること"@ja.
<< kg:id_4 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "フォトモンタージュや垂直見込角に加え、眺望方向や水平視野、時間帯も考慮し、眺望景観への影響について、適切に調査、予測及び評価すること"@ja.
<< kg:id_4 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "風力発電機の規模や配置等の検討に当たっては、地域住民等に検討の経緯及び結果について丁寧な説明を行い、述べられた意見を十分に勘案すること"@ja.
}
