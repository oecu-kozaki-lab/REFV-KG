kg:st_3 rdfs:type cls:st_167.
kg:op_7 prop:content "周知と丁寧な説明を行い意見を可能な限り反映すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:st_4 rdfs:label "実施区域周辺に風力発電所の設置を計画している事業者等"@ja.
kg:st_4 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_8 prop:content "累積的影響の予測評価のため配置や諸元等の情報提供を求める場合がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:st_5 rdfs:label "地域住民"@ja.
kg:st_5 rdfs:type cls:st_167.
kg:op_9 prop:content "生活環境への十分な配慮が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_5.
kg:op_10 prop:content "意見を踏まえて工事計画を検討すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "助言を踏まえて調査地点や回数を追加し調査手法を見直すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "助言等を踏まえ適切な調査手法で生息状況を把握すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "主要な眺望点の設定に意見を反映すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "県内の一部地域では風力発電所の設置が原因とみられる電波障害が発生している"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "建設機械の稼働に伴う騒音による生活環境への影響が懸念される"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "特にモノパイルの打設工事については著しい騒音が発生する可能性がある"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:text-txt_contents "工事の実施に伴う騒音の影響の程度を踏まえた上で、秋田港周辺における環境への影響について、必要に応じて調査、予測及び評価すること"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻き上げ等が発生するおそれがある"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:text-txt_contents "工事の実施に伴う水の濁りへの影響について"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される"@ja.
<< kg:id_12 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "本事業の実施によるこれら海生生物への影響が懸念される"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:text-txt_contents "洋上風力発電事業の実施に伴う水中音が海域に生息する動物に及ぼす影響"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "景観への影響については、眺望方向や水平視野、時間帯、季節的変化等も考慮し、適切に調査、予測及び評価すること"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:text-txt_contents "必要に応じて、人と自然との触れ合いの活動の場への影響について、適切に予測及び評価すること"@ja.
<< kg:id_21 prop:contermeasure kg:id_22 >>
    prop:text-txt_contents "環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、これらについて必要に応じて見直しを行う等、適切に対応すること"@ja.
<< kg:id_18 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "専門家等の助言や国内外における最新の知見・事例等を踏まえ、適切に調査、予測及び評価すること。なお、意見聴取は環境要素ごとに複数の専門家に対して行うなど、環境影響評価の客観性及び妥当性の確保に努めること"@ja.
<< kg:id_18 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "準備書においては事業計画を明確にし、具体的な環境の保全の配慮に係る検討の経緯及びその内容を詳細に記載すること。また、これらについて、地域住民や地元自治体等に広く周知するとともに丁寧な説明を行い、理解を得るよう努め、述べられた意見を可能な限り事業に反映すること"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "これら他事業の諸元等の情報入手に努め、累積的な影響が懸念される項目について、適切に調査、予測及び評価すること。また、実施区域周辺に風力発電所の設置を計画している事業者等から、累積的な影響を予測及び評価するために、本事業に係る風力発電機の配置や諸元等の情報を求められた場合は、情報提供に努めること"@ja.
<< kg:id_18 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本事業の実施に当たっては環境影響評価項目としての選定の有無によらず、地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること"@ja.
<< kg:id_28 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "工事計画の検討に当たっては、地域住民等の意見を踏まえるとともに、準備書においては工事の具体的な工程や作業時間等の詳細を明確にし、発生する騒音の特性を踏まえた上で、モノパイル打設等の建設機械の稼働に伴う騒音による生活環境への影響を適切に調査、予測及び評価すること"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:text-txt_contents "実施区域周辺には、計画した調査地点以外にも、住居等が密集し、医療機関が立地する松ヶ崎地区が存在することから、調査地点に追加し、本事業の実施による環境への影響を適切に調査、予測及び評価すること"@ja.
<< kg:id_8 prop:contermeasure kg:id_32 >>
    prop:text-txt_contents "準備書においては工事等の具体的な工程や使用する建設機械等の詳細を明確にし、工事の実施に伴う騒音の影響の程度を踏まえた上で、秋田港周辺における環境への影響について、必要に応じて調査、予測及び評価すること"@ja.
<< kg:id_11 prop:contermeasure kg:id_33 >>
    prop:text-txt_contents "工事の実施に伴う水の濁りへの影響について、必要に応じて調査地点の追加や見直しを検討する等により、実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握し、適切に予測及び評価すること"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本事業の実施による鳥類への影響について、専門家等の助言を踏まえて、調査地点や回数を追加するなど、調査手法の見直しを検討する等により、実施区域及びその周辺の上空を通過する鳥類の飛翔経路や高度等を詳細に把握し、適切に予測及び評価すること"@ja.
<< kg:id_15 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本事業の実施による魚等の遊泳動物やその卵・稚仔等の海生生物への影響について、専門家等の助言等を踏まえ、適切な調査手法により予測対象種等の生息状況を可能な限り把握し、予測及び評価すること"@ja.
<< kg:id_37 prop:contermeasure kg:id_38 >>
    prop:text-txt_contents "国内外の最新の知見や事例等の集積に努め、水中音の影響に係る調査、予測及び評価に適切に反映すること"@ja.
<< kg:id_39 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "主要な眺望点の設定に当たっては、地域住民等の意見を踏まえ、必要に応じて調査地点を追加すること"@ja.
<< kg:id_19 prop:contermeasure kg:id_41 >>
    prop:text-txt_contents "景観への影響については、眺望方向や水平視野、時間帯、季節的変化等も考慮し、適切に調査、予測及び評価すること"@ja.
<< kg:id_20 prop:contermeasure kg:id_42 >>
    prop:text-txt_contents "人と自然との触れ合いの活動の状況を適切に把握した上で、必要に応じて、人と自然との触れ合いの活動の場への影響について、適切に予測及び評価すること"@ja.
}
