kg:op_1 prop:content "工事計画は意見を踏まえて検討すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "専門家等"@ja.
kg:st_2 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_2 prop:content "助言を踏まえて調査地点や回数を追加し調査手法の見直しを検討すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "助言を踏まえて調査地点や回数を追加し調査手法の見直しを検討すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "助言等を踏まえ適切な調査手法で生息状況を把握すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
