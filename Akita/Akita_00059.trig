kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "環境影響を可能な限り回避又は低減するよう求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域住民や地元自治体等への丁寧な説明と理解の確保を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地域住民等から情報収集し調査予測結果を位置・規模等の決定に反映するよう求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "方法書で位置規模等と環境保全の検討内容を明確に示すよう求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "他事業との累積的な影響の回避又は低減を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "他事業者との情報共有により累積的影響の回避又は低減を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "鳥類への影響の回避又は低減を求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "現地調査と専門家助言を踏まえて鳥類影響の回避又は低減を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "海生生物への影響の回避又は低減を求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "生息状況を適切に把握し海生生物への影響を回避又は低減するよう求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "景観への影響の回避又は低減を求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "地域住民等の意見を聴取し景観影響の回避又は低減を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "主要な眺望点の追加検討と生活環境からの景観への十分な配慮を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本事業は、沖合約1km～4km、能代市から男鹿市の沿岸約17kmに及ぶ海域に、最大50基もの風力発電機を設置する洋上風力発電事業であることから、専門家の助言や国内外における最新の知見・事例等を踏まえ、事業の実施による環境影響を可能な限り回避又は低減するよう配慮すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業の実施に当たっては、地域住民や地元自治体等（以下「地域住民等」という。）に丁寧な説明を行い、理解を得るよう努めること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "今後の事業計画の検討に当たっては、地域住民等からの情報収集に努め、影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価して事業の「位置・規模」及び「配置・構造」（以下「位置・規模等」という。）の決定に反映すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "方法書においては、事業の位置・規模等を可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を記載すること。"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:text-txt_contents "事業実施想定区域（以下「想定区域」という。）及びその周辺には、既設及び計画中の風力発電所が多数存在することから、他事業者との情報共有に努め、事業の実施による累積的な影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "事業実施想定区域（以下「想定区域」という。）及びその周辺には、既設及び計画中の風力発電所が多数存在することから、他事業者との情報共有に努め、事業の実施による累積的な影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業実施想定区域（以下「想定区域」という。）及びその周辺には、既設及び計画中の風力発電所が多数存在することから、他事業者との情報共有に努め、事業の実施による累積的な影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "想定区域東方に位置する小友沼や八郎潟干拓地は、ガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地であるため、渡りの時期等における主要な経路である可能性がある"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:text-txt_contents "周辺には既設及び計画中の風力発電所が多数存在することから、渡り鳥が想定区域及びその周辺を通過する際に、これら他事業との累積的な影響により移動経路が遮断・阻害されるおそれがある。"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "渡り鳥が想定区域及びその周辺を通過する際に、これら他事業との累積的な影響により移動経路が遮断・阻害されるおそれがある。"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "このため、事業の位置・規模等の決定に当たっては、今後の現地調査の結果や専門家の助言を踏まえ、事業の実施による鳥類への影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "想定区域及びその周辺の海域の一部は、環境省により「生物多様性の観点から重要度の高い海域」に選定されている"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:text-txt_contents "県の魚であるハタハタ等の産卵場及び稚魚の生育場となっていることから"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本事業の実施に当たっては、専門家の助言や国内外における最新の知見・事例等を踏まえ、可能な限り生息状況を適切に把握した上で、事業の実施による海生生物への影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "本事業の実施に当たっては、専門家の助言や国内外における最新の知見・事例等を踏まえ、可能な限り生息状況を適切に把握した上で、事業の実施による海生生物への影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:text-txt_contents "想定区域周辺には男鹿国定公園が位置し、主要な眺望点である「寒風山展望施設」や「釜谷浜海水浴場」等が存在することから"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本事業の実施によるこれら眺望点からの眺望景観への影響が懸念される。"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "このため、事業の位置・規模等の決定に当たっては、地域住民等からの意見の聴取に努め、事業の実施に伴う景観への影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "また、主要な眺望点の設定に当たっては、地域住民等からの情報収集に努め、必要に応じて追加するとともに、日常的な生活環境の場からの景観についても十分に配慮すること。"@ja.
}
