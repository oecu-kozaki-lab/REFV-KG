kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "学校等や住居への影響を回避又は低減するよう配慮を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "事業計画具体化の過程で地域住民の理解を得るよう求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "方法書で位置や規模等を明確化し検討経緯を具体的に記載するよう求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "他事業との複合的な環境影響を勘案し適切に調査予測評価するよう求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "学校等や住居と適切な距離を確保し影響の回避又は低減を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "能代市長"@ja.
kg:st_2 rdf:type cls:st_2.
kg:op_6 prop:content "施設稼働による騒音や超低周波音が周辺施設や住居等に及ぼす影響の回避低減を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "八峰町長"@ja.
kg:st_3 rdf:type cls:st_2.
kg:op_7 prop:content "騒音及び超低周波音の累積的影響を懸念し低騒音設備の導入を望む"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "重要な鳥類の渡り経路や移動経路に配慮し影響回避低減を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "浅内海岸エリアの移動経路上の特性を踏まえ影響回避低減を求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "周辺風車の存在を踏まえ鳥類への影響を慎重に検討するよう求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "現地調査結果や専門家の知見を踏まえ鳥類影響の回避低減を求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "自然改変を可能な限り小さくし植生等への影響回避を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "事業特性や地域特性を踏まえ地下水影響を検討するよう求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "工事用資材等の運搬や建設機械の稼働による生活環境影響の調査予測評価を求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "方法書以降で工事関連影響の調査予測評価を行うよう求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "供用時に見える人への圧迫感や威圧感を低減する配置等を求める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "JAXA施設との関係を踏まえ相互影響を懸念し協議と措置検討を求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "周辺計画との相互影響を考慮し環境影響の低減を求める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "周辺施設や他事業との相互影響を加味して協議と必要措置を求める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "調査結果や専門家意見を踏まえより低騒音な設備の導入を望む"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "周辺風力発電設備を勘案した適切な予測評価を求める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "周辺風力発電設備の影響を勘案した予測評価を求める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業実施想定区域及びその周辺には、環境の保全について配慮が必要な学校、社会福祉施設等（以下「学校等」という。）や住居が多数存在することから、工事中及び供用後において、学校等や住居への影響を回避又は低減するよう配慮すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業計画を具体化する過程において、地域住民の理解を得られるよう努めること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "方法書においては、事業の位置・規模等を可能な限り明確にするとともに、事業区域の絞り込み過程における環境の保全の配慮に係る検討経緯を具体的に記載すること。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事業実施想定区域周辺の既設及び計画中の風力発電所との複合的な環境影響を勘案し、可能な限りこれら他事業の諸元等の情報入手に努め、適切に調査、予測及び評価すること。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業実施想定区域及びその周辺には、学校等や住居が多数存在することから、これらと風力発電機との距離を適切に確保する等、事業の実施による影響を回避又は低減するよう配慮すること。 計画の実施にあたっては、施設の稼働による騒音、超低周波音が周辺の施設や住居等に及ぼす影響を可能な限り回避、低減させるよう、配置等について十分検討すること。 一方、騒音及び超低周波音についてその累積的な影響が懸念されており、周辺の風力発電設備の環境への影響を勘案し、適切な予測及び評価を行い、環境への影響を可能な限り回避、低減する観点から、調査等の結果及び専門家等からの意見を踏まえて、より低騒音な設備の導入を望むものである。"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業実施想定区域の周辺に位置する小友沼や八郎潟干拓地は、国際的に重要なガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地であるため、事業実施想定区域は主要な渡り経路となっている可能性がある。"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "特に「浅内海岸エリア」は小友沼と八郎潟干拓地の間に位置し、ガン類の移動経路上であることが明らかになっている。"@ja.
<< kg:id_1 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "加えて、事業実施想定区域の周辺には既設及び計画中の風力発電所が多数存在することから、これら鳥類への重大な影響が懸念される。"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "これら鳥類への重大な影響が懸念される。 このため、事業の位置・規模等の決定に当たっては、今後の現地調査の結果や専門家の助言、最新の知見・事例等を踏まえ、事業の実施に伴う影響を回避又は低減する観点から検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "事業実施想定区域には重要な種が生育している可能性があることから、事業の位置・規模等の検討に当たっては、工事用道路を含め、自然改変を可能な限り小さくする等、植生等に影響を及ぼさないよう十分に配慮すること。"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "事業の実施に伴う地下水への影響について、事業特性や地域特性を踏まえて検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "工事用資材等の運搬の方法及び規模について、搬入経路となっている国道7号、国道101号の沿線には住宅地等が存在し、また、配置計画に合わせて設定される搬入経路の周辺にも、集落等が存在する可能性があり、輸送車両の走行により、それら住宅地、集落等の生活環境に影響が及ぶおそれがある。"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "方法書以降において、それら住宅地、集落等の大気環境、水環境に「工事用資機材等の搬出入」、「建設機械の稼動」が及ぼす影響について調査・予測及び評価を行うよう、検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "風車の大きさ、形、色、配置等については、供用時に見る人に対して圧迫感や威圧感を感じさせる等の景観への影響が懸念されることから、当該影響について十分な低減が図られるよう配置等について十分検討し、その結果を方法書に具体的に記載すること。"@ja.
<< kg:id_1 prop:cause kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "浅内海岸エリア付近にはJAXA（宇宙航空研究開発機構）の付属研究施設である「能代ロケット実験場」があり、各種ロケットエンジン、ジェットエンジンの燃焼実験等が行われている。"@ja.
<< kg:id_1 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "また、能代エリア周辺においては小型風力発電等の計画があり、実際に建設途中のものもある。"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "工事中及び施設稼働後における相互の影響、それによる周辺環境への影響について、これらも考慮する必要があるため、必要により当該機関等と協議を行い、必要な措置を講ずることについて検討すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "環境への影響を可能な限り回避、低減する観点から、調査等の結果及び専門家等からの意見を踏まえて、より低騒音な設備の導入を望むものである。"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "一方、騒音及び超低周波音についてその累積的な影響が懸念されており、周辺の風力発電設備の環境への影響を勘案し、適切な予測及び評価を行い、環境への影響を可能な限り回避、低減する観点から、調査等の結果及び専門家等からの意見を踏まえて、より低騒音な設備の導入を望むものである。"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "周辺の風力発電設備の環境への影響を勘案し、適切な予測及び評価を行い、環境への影響を可能な限り回避、低減する観点から、調査等の結果及び専門家等からの意見を踏まえて、より低騒音な設備の導入を望むものである。"@ja.
}
