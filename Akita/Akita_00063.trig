kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "地表面による音波の反射や気象条件を勘案して適切に予測及び評価すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "諸外国を含む最新の知見を整理し評価項目として選定するか再検討すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "土地改変は可能なかぎり回避すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "十分な現地調査等により植生図を作成した上で予測及び評価を行うべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "牧採は可能なかぎり回避すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "主要な眺望点や景観資源との高低差を勘案し垂直見込角の変化も把握できる地点を再検討して適切に予測及び評価すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "植樹活動を考慮して調査予測及び評価を行うべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地下の地質状況や地下水の利用状況を十分把握した上で影響を検討すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "必要に応じて評価項目及び手法を適切に対応すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "風力発電機の規模や基数が未確定のため具体化過程の検討経緯を詳細記載すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "尾根上配置の特性を踏まえて適切に予測及び評価すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "諸外国を含む最新知見を踏まえて再検討すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "鳥獣保護区内の土地改変を回避すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "植生図を作成して評価すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "ケヤキ群落等の機能を踏まえ伐採を回避すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "垂直見込角等の変化も把握できる地点で評価すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "ボランティア団体の植樹活動を考慮すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "花輪鉱山跡地の存在を踏まえ地下地質も把握して配置を検討すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "飲用利用施設の存在を踏まえ地下水影響を検討すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "風力発電機を山の尾根上に配置する計画であることから、騒音及び超低周波音による影響については、地表面による音波の反射の影響や気象条件を勘案し、適切に予測及び評価を行うこと。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "対象事業実施区域周辺の住居等への風車の影による影響について、地形等により影響範囲の設定に不確実性が伴うことから、風車の影に関する諸外国を含む最新の知見を整理した上で、評価項目として選定することの可否を再検討すること。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "東山鳥獣保護区の範囲に含まれる工事用道路については、拡幅等による土地の改変を可能なかぎり回避すること。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "土地の改変による植物の生育環境への影響については、十分な現地調査等により植生図を作成した上で予測及び評価を行うこと。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "対象事業実施区域内の工事用道路のケヤキ群落等は、急傾斜地における土砂災害防止や土壌保全機能等を有すると考えられることから、道路拡幅等の土地の改変に伴う伐採は可能なかぎり回避すること。"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "施設の存在による景観への影響について、風力発電機と主要な眺望点、景観資源及び住居等との高低差を勘案して、水平視角に加えて垂直見込角等の変化の程度を十分に把握できる地点を再検討した上で、適切に予測及び評価を行うこと。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業実施に伴う人と自然との触れ合いの活動の場への影響について、対象事業実施区域内でボランティア団体が行っている植樹活動等を考慮し、調査、予測及び評価を行うこと。"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "対象事業実施区域周辺には花輪鉱山跡地が存在することから、表層の地質のみならず、地下の地質の状況についても十分に把握した上で、風力発電機の配置を検討すること。対象事業実施区域の周辺では、地下水を飲用に供している施設等が存在することから、地下水の利用状況を把握した上で、事業実施による地下水への影響を検討すること。"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、必要に応じて環境影響評価の項目及び手法の見直しを行う等、適切に対応すること。"@ja.
<< kg:id_19 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "設置する風力発電機の規模や基数等が確定していないことから、事業計画を具体化する過程における検討事項及び結果、その判断に至った経緯を詳細に準備書に記載すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "風力発電機を山の尾根上に配置する計画であることから、騒音及び超低周波音による影響については、地表面による音波の反射の影響や気象条件を勘案し、適切に予測及び評価を行うこと。"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "対象事業実施区域周辺の住居等への風車の影による影響について、地形等により影響範囲の設定に不確実性が伴うことから、風車の影に関する諸外国を含む最新の知見を整理した上で、評価項目として選定することの可否を再検討すること。なお、評価項目として選定しない場合には、その判断に至った経緯を詳細に準備書に記載すること。"@ja.
<< kg:id_5 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "東山鳥獣保護区の範囲に含まれる工事用道路については、拡幅等による土地の改変を可能なかぎり回避すること。"@ja.
<< kg:id_7 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "土地の改変による植物の生育環境への影響については、十分な現地調査等により植生図を作成した上で予測及び評価を行うこと。"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "対象事業実施区域内の工事用道路のケヤキ群落等は、急傾斜地における土砂災害防止や土壌保全機能等を有すると考えられることから、道路拡幅等の土地の改変に伴う伐採は可能なかぎり回避すること。"@ja.
<< kg:id_11 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "施設の存在による景観への影響について、風力発電機と主要な眺望点、景観資源及び住居等との高低差を勘案して、水平視角に加えて垂直見込角等の変化の程度を十分に把握できる地点を再検討した上で、適切に予測及び評価を行うこと。"@ja.
<< kg:id_13 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "事業実施に伴う人と自然との触れ合いの活動の場への影響について、対象事業実施区域内でボランティア団体が行っている植樹活動等を考慮し、調査、予測及び評価を行うこと。"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "対象事業実施区域周辺には花輪鉱山跡地が存在することから、表層の地質のみならず、地下の地質の状況についても十分に把握した上で、風力発電機の配置を検討すること。"@ja.
<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "対象事業実施区域の周辺では、地下水を飲用に供している施設等が存在することから、地下水の利用状況を把握した上で、事業実施による地下水への影響を検討すること。"@ja.
