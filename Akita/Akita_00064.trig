kg:id_1 rdfs:label "風力発電事業"@ja.
kg:id_1 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "影響を受けるおそれのある環境要素について調査・予測し結果を評価して事業の位置・規模・配置・構造の決定に反映すること"@ja.
kg:id_2 rdf:type cls:c_103.
cls:c_103 rdfs:label "環境配慮"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "事業計画の具体化の過程における検討内容を方法書以降の図書に記載すること"@ja.
kg:id_3 rdf:type cls:c_13666.
cls:c_13666 rdfs:label "文書記載"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "騒音及び超低周波音による周辺住居や事業所への影響"@ja.
kg:id_4 rdf:type cls:c_5.
cls:c_5 rdfs:label "生活環境影響"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "周辺の住居や事業所等の状況を十分に調査し騒音及び超低周波音の影響を回避・低減すること"@ja.
kg:id_5 rdf:type cls:c_13391.
cls:c_13391 rdfs:label "影響回避"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "植物等への影響"@ja.
kg:id_6 rdf:type cls:c_833.
cls:c_833 rdfs:label "生態影響"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "工事用道路も含め自然改変をできるだけ小さくし植物等に影響を及ぼさないよう配慮すること"@ja.
kg:id_7 rdf:type cls:c_13713.
cls:c_13713 rdfs:label "自然改変抑制"@ja.
kg:id_1 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "事業実施想定区域の周辺に地下水を飲用に供している施設等が存在すること"@ja.
kg:id_8 rdf:type cls:c_13999.
cls:c_13999 rdfs:label "地下水利用施設"@ja.
kg:id_1 prop:cause kg:id_8.
kg:id_9 rdfs:label "地下水への影響"@ja.
kg:id_9 rdf:type cls:c_7961.
cls:c_7961 rdfs:label "地下水影響"@ja.
kg:id_1 prop:effect kg:id_9.
kg:id_10 rdfs:label "地下水への影響を検討すること"@ja.
kg:id_10 rdf:type cls:c_13546.
cls:c_13546 rdfs:label "影響検討"@ja.
kg:id_1 prop:contermeasure kg:id_10.
kg:st_1 rdfs:label "秋田県"@ja.
kg:st_1 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "環境要素の調査・予測結果を事業計画へ反映すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "計画具体化の検討内容を後続図書に記載すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "周辺住居や事業所の状況を十分調査し影響回避・低減に配慮すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "騒音・超低周波音の影響回避と低減に配慮すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "自然改変をできるだけ小さくし植物等への影響を避けるべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "風力発電機配置では自然改変を最小化すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "周辺に飲用地下水利用施設があるため地下水影響を検討すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地下水への影響を事業計画具体化の段階で検討すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "地下水影響の検討を進めるべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今後の事業計画の検討にあたっては、影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査・予測し、その結果を総合的に評価して事業の「位置・規模」及び「配置・構造」の決定に反映すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "また、事業計画の具体化の過程における検討内容を方法書以降の図書に記載すること。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "事業実施想定区域の周辺の住居や事業所等の状況を十分に調査し、事業実施による影響を回避・低減するよう配慮すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事業実施想定区域の周辺の住居や事業所等の状況を十分に調査し、事業実施による影響を回避・低減するよう配慮すること。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "風力発電機の配置の検討にあたっては、工事用道路も含め、自然改変をできるだけ小さくする等、植生等に影響を及ぼさないよう配慮すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "風力発電機の配置の検討にあたっては、工事用道路も含め、自然改変をできるだけ小さくする等、植生等に影響を及ぼさないよう配慮すること。"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業実施想定区域の周辺では、地下水を飲用に供している施設等が存在することから、事業計画の具体化にあたっては、地下水への影響を検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業実施想定区域の周辺では、地下水を飲用に供している施設等が存在することから、事業計画の具体化にあたっては、地下水への影響を検討すること。"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "事業実施想定区域の周辺では、地下水を飲用に供している施設等が存在することから、事業計画の具体化にあたっては、地下水への影響を検討すること。"@ja.
