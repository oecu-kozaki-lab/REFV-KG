    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "本事業の実施による鳥類の移動経路の遮断・阻害"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "バードストライクの発生による影響を回避し、又は低減するよう配慮すること"@ja.
<< kg:id_5 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "事業の「位置・規模」及び「配置・構造」の決定に当たっては、今後の現地調査の結果や専門家の助言、最新の知見・事例等を踏まえ"@ja.
<< kg:id_1 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "想定区域には、植生自然度の高い植生であるオオヨモギ－オオイタドリ群団が存在する可能性があることから"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "本事業の実施による植物及び生態系への影響を回避し、又は低減するよう配慮すること"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "本事業の実施による植物及び生態系への影響を回避し、又は低減するよう配慮すること"@ja.
<< kg:id_5 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "風力発電機や工事用道路等の配置計画の検討に当たっては、既存の造成地や管理用道路を極力活用する等により"@ja.
