kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "地域住民や地元自治体等への丁寧な説明と理解の取得を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "必要に応じて調査及び予測を行い結果を位置・規模と配置・構造の決定に反映するよう求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "必要に応じて調査及び予測を行い総合評価を求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "方法書で具体的な環境保全配慮の検討内容と結果の記載を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "他事業者との情報共有や調整を行い累積的な影響の回避又は低減を求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "他事業者との情報共有や調整を行い累積的な影響の回避又は低減を求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "関係する他事業者との情報共有や調整で回避又は低減を求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "累積的な影響の回避又は低減のため他事業者との連携を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "現地調査結果や専門家の助言、最新の知見・事例等を踏まえ配慮を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "回避又は低減するよう配慮を求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "回避又は低減するよう配慮を求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "希少猛禽類への影響回避又は低減のため科学的知見を踏まえた計画決定を求める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "既存の造成地や管理用道路を極力活用し植物及び生態系への影響回避又は低減を求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "回避又は低減するよう配慮を求める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "回避又は低減するよう配慮を求める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "風力発電機や工事用道路等の配置計画で既存インフラの活用を求める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業実施想定区域（以下「想定区域」という。）及びその周辺には植生自然度の高い植生が存在している"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "想定区域の一部が、平成16年8月に環境省が公表した「日本におけるイヌワシの生息分布」の「生息確認」の2次メッシュと重なっている"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本事業の実施による環境影響を回避し、又は低減するよう十分配慮すること"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "専門家の意見等を踏まえ、本事業の実施による環境影響を回避し、又は低減するよう十分配慮すること。なお、意見聴取は複数の専門家に対して行うなど、環境影響評価の客観性及び妥当性の確保に努めること"@ja.
<< kg:id_5 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "本事業の実施に当たっては、地域住民や地元自治体等に丁寧な説明を行い、理解を得るよう努めること"@ja.
<< kg:id_5 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "今後の事業計画の検討に当たっては、地域住民や地元自治体等からの情報収集に努め、影響を受けるおそれのある環境要素に係る影響の程度について、必要に応じて調査及び予測を行い、その結果を総合的に評価して事業の「位置・規模」及び「配置・構造」の決定に反映すること"@ja.
<< kg:id_5 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "影響を受けるおそれのある環境要素に係る影響の程度について、必要に応じて調査及び予測を行い、その結果を総合的に評価して"@ja.
<< kg:id_5 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "方法書においては、事業の「位置・規模」及び「配置・構造」を可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を記載すること"@ja.
<< kg:id_1 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "想定区域の多くは、他の計画中の風力発電所と重なっており"@ja.
<< kg:id_1 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "その周辺には、既設及び計画中の風力発電所が存在している"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "関係する他事業者との情報共有や調整等を行い、本事業の実施による累積的な影響を回避し、又は低減するよう配慮すること"@ja.
<< kg:id_5 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "関係する他事業者との情報共有や調整等を行い、本事業の実施による累積的な影響を回避し、又は低減するよう配慮すること"@ja.
<< kg:id_1 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "想定区域及びその周辺は、イヌワシ等の希少猛禽類が生息する可能性があることから"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
