  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "環境保全上の問題"@ja.
kg:id_1 rdf:type cls:c_533.
cls:c_533 rdfs:label "環境問題"@ja.
kg:id_2 rdfs:label "速やかに調査を行い関係機関と協議の上適切な措置を講ずる"@ja.
kg:id_2 rdf:type cls:c_13548.
cls:c_13548 rdfs:label "調査対応"@ja.
