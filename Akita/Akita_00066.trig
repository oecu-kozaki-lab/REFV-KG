kg:id_3 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "風力発電機の確定前の評価書作成"@ja.
kg:id_5 rdf:type cls:c_3010.
cls:c_3010 rdfs:label "環境評価"@ja.
kg:id_6 rdfs:label "採用する風力発電機を確定した上で変更が生ずる場合は改めて予測及び評価を行い適切な環境保全措置を講ずる"@ja.
kg:id_6 rdf:type cls:c_14007.
cls:c_14007 rdfs:label "再評価措置"@ja.
kg:id_5 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "事業計画"@ja.
kg:id_7 rdf:type cls:c_402.
cls:c_402 rdfs:label "事業計画"@ja.
kg:id_8 rdfs:label "地域住民や地元自治体等に広く周知し丁寧な説明を行い事業に対する理解を得る"@ja.
kg:id_8 rdf:type cls:c_394.
cls:c_394 rdfs:label "周知説明"@ja.
kg:id_7 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "電波障害"@ja.
kg:id_9 rdf:type cls:c_13557.
cls:c_13557 rdfs:label "電波障害"@ja.
kg:id_10 rdfs:label "風力発電機の設置"@ja.
kg:id_10 rdf:type cls:c_476.
cls:c_476 rdfs:label "風力施設"@ja.
kg:id_9 prop:cause kg:id_10.
kg:id_11 rdfs:label "本事業"@ja.
kg:id_11 rdf:type cls:c_1.
cls:c_1 rdfs:label "事業"@ja.
kg:id_12 rdfs:label "地域住民の生活環境に十分配慮し影響が生じた場合は関係法令等に従って適切に対応する"@ja.
kg:id_12 rdf:type cls:c_13596.
cls:c_13596 rdfs:label "生活環境配慮"@ja.
kg:id_11 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "施設の稼働に伴う騒音"@ja.
kg:id_13 rdf:type cls:c_108.
cls:c_108 rdfs:label "騒音"@ja.
kg:id_14 rdfs:label "地域住民のわずらわしさの程度が上がる可能性"@ja.
kg:id_14 rdf:type cls:c_14008.
cls:c_14008 rdfs:label "生活妨害"@ja.
kg:id_13 prop:effect kg:id_14.
kg:id_15 rdfs:label "事後調査を適切に実施し振幅変調音等の程度を明らかにすること等により生活環境への影響の把握に努める"@ja.
kg:id_15 rdf:type cls:c_17.
cls:c_17 rdfs:label "事後調査"@ja.
kg:id_13 prop:contermeasure kg:id_15.
kg:id_16 rdfs:label "工事の実施"@ja.
kg:id_16 rdf:type cls:c_106.
cls:c_106 rdfs:label "工事"@ja.
kg:id_17 rdfs:label "ミサゴ及びオオタカの生息及び繁殖等への影響"@ja.
kg:id_17 rdf:type cls:c_6.
cls:c_6 rdfs:label "鳥類影響"@ja.
kg:id_16 prop:effect kg:id_17.
kg:id_18 rdfs:label "低騒音型の建設機械の採用等の環境保全措置を徹底し希少猛禽類の繁殖等への影響を回避又は低減する"@ja.
kg:id_18 rdf:type cls:c_370.
cls:c_370 rdfs:label "保全措置"@ja.
kg:id_16 prop:contermeasure kg:id_18.
kg:id_19 rdfs:label "工事の実施による希少猛禽類の繁殖等への影響"@ja.
kg:id_19 rdf:type cls:c_6.
kg:id_20 rdfs:label "適切に事後調査を行い重大な影響が認められた場合は専門家等からの助言を踏まえ追加的な環境保全措置を講ずる"@ja.
kg:id_20 rdf:type cls:c_17.
kg:id_19 prop:contermeasure kg:id_20.
kg:id_21 rdfs:label "本事業の実施"@ja.
kg:id_21 rdf:type cls:c_1.
kg:id_22 rdfs:label "鳥類の移動経路の遮断阻害やバードストライクの発生"@ja.
kg:id_22 rdf:type cls:c_13353.
cls:c_13353 rdfs:label "鳥類被害"@ja.
kg:id_21 prop:effect kg:id_22.
kg:id_23 rdfs:label "施設の稼働後のバードストライク"@ja.
kg:id_23 rdf:type cls:c_13353.
kg:id_24 rdfs:label "事後調査を適切に実施し鳥類への重大な影響が認められた場合は専門家等からの助言を踏まえ追加的な環境保全措置を講ずる"@ja.
kg:id_24 rdf:type cls:c_17.
kg:id_23 prop:contermeasure kg:id_24.
kg:id_25 rdfs:label "景観への影響"@ja.
kg:id_25 rdf:type cls:c_224.
cls:c_224 rdfs:label "景観影響"@ja.
kg:id_21 prop:effect kg:id_25.
kg:id_26 rdfs:label "本事業の実施による景観への影響"@ja.
kg:id_26 rdf:type cls:c_224.
kg:id_27 rdfs:label "地域住民等から問い合わせがあった場合等は丁寧に説明を行い理解を得る"@ja.
kg:id_27 rdf:type cls:c_4068.
cls:c_4068 rdfs:label "説明対応"@ja.
kg:id_26 prop:contermeasure kg:id_27.
kg:st_1 rdfs:label "知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "予測できない問題が生じた場合は迅速に調査し適切に対応すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "工事中及び供用後に苦情が発生した場合は適切に対応すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "採用機種確定後に評価結果が変わるなら再予測再評価と保全措置が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "撤去を含む事業計画は地域住民等へ広く周知し丁寧に説明すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "県内では風力発電機の設置が原因と考えられる電波障害が発生している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "電波障害を含む生活環境への影響に十分配慮し影響発生時は法令に従い対応すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "振幅変調音や純音性成分により住民のアノイアンスが高まるおそれがある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "騒音の事後調査と振幅変調音等の把握を通じて生活環境への影響確認が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "実施区域周辺で飛翔や営巣が確認されており希少猛禽類への影響が懸念される"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "低騒音型建設機械の採用などを徹底して希少猛禽類への影響回避低減を図るべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "希少猛禽類への重大影響が確認された場合は専門家助言を踏まえ追加措置が必要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "渡り鳥の移動経路や魚食性鳥類への影響として経路遮断やバードストライクが懸念される"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "バードストライクの事後調査を行い重大影響時は専門家助言を踏まえ追加措置を取るべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "風車の大型化や配置変更により景観の変化が生じるため影響が懸念される"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "景観影響について問い合わせがあれば丁寧に説明し理解を得るべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講ずること。"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "工事中及び供用後に地域住民から苦情が発生した場合は、適切に対応すること。"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "現段階で採用する風力発電機が決定していないことから、評価書の作成に当たっては、採用する風力発電機を確定した上で、本準備書の環境影響評価結果に変更が生ずる場合には、その諸元等を用いて改めて予測及び評価を行うとともに、適切な環境保全措置を講ずること。"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "既設風力発電機の撤去を含む事業計画について、地域住民や地元自治体等（以下「地域住民等」という。）に広く周知するとともに、丁寧な説明を行い、事業に対する理解を得るよう努めること。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "県内の一部地域では風力発電機の設置が原因と考えられる電波障害が発生している"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "本事業の実施に当たっては環境影響評価項目としての選定の有無によらず、地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること。"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "施設の稼働に伴う騒音に含まれる振幅変調音や純音性成分等により、地域住民のわずらわしさ（アノイアンス）の程度が上がる可能性がある。"@ja.
<< kg:id_13 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "このため、施設の稼働に伴う騒音について、計画している事後調査を適切に実施するほか、施設設置後の振幅変調音等の程度を明らかにすること等により生活環境への影響の把握に努めること。"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "実施区域及びその周辺では、ミサゴ及びオオタカの飛翔及び営巣が確認されていることから、工事の実施による生息及び繁殖等への影響が懸念される。"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "工事の実施に当たっては、低騒音型の建設機械の採用等の環境保全措置の実施を徹底する等により、希少猛禽類の繁殖等への影響を回避又は低減するよう努めること。"@ja.
<< kg:id_19 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "工事の実施による希少猛禽類の繁殖等への影響について、適切に事後調査を行い、重大な影響が認められた場合は、専門家等からの助言を踏まえ、追加的な環境保全措置を講ずること。"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "実施区域は、渡り鳥の集団飛来地である八郎潟干拓地の西方に位置しており、渡りの時期等における主要な移動経路となっている可能性があるほか、ミサゴ等の魚食性鳥類が生息している。また、実施区域周辺には既設及び計画中の風力発電所が多数存在することから、本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生が懸念される。"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "施設の稼働後のバードストライクに係る事後調査を適切に実施し、鳥類への重大な影響が認められた場合は、専門家等からの助言を踏まえ、追加的な環境保全措置を講ずること。"@ja.
<< kg:id_21 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "事業者によれば、既設の八竜風力発電所は地域の景観資源として認識されているとしているが、風車の大型化や配置の変更によって景観の変化が伴うことから、本事業の実施による景観への影響が懸念される。"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "本事業の実施による景観への影響について、地域住民等から問い合わせがあった場合等は、丁寧に説明を行い、理解を得るよう努めること。"@ja.
}
