kg:id_37 rdf:type cls:c_14365.
cls:c_14365 rdfs:label "知見蓄積"@ja.
kg:id_36 prop:effect kg:id_37.
kg:id_38 rdfs:label "再エネ開発とその運営"@ja.
kg:id_38 rdf:type cls:c_4057.
cls:c_4057 rdfs:label "再エネ事業"@ja.
kg:id_39 rdfs:label "地域社会の活性化"@ja.
kg:id_39 rdf:type cls:c_1287.
cls:c_1287 rdfs:label "地域活性化"@ja.
kg:id_38 prop:effect kg:id_39.
kg:id_40 rdfs:label "再エネ事業のブランド戦略"@ja.
kg:id_40 rdf:type cls:c_14366.
cls:c_14366 rdfs:label "ブランド戦略"@ja.
kg:id_41 rdfs:label "思いを社外とともに社内にもいっそう浸透させる"@ja.
kg:id_41 rdf:type cls:c_14367.
cls:c_14367 rdfs:label "意識浸透"@ja.
kg:id_40 prop:effect kg:id_41.
kg:id_42 rdfs:label "再エネ事業"@ja.
kg:id_42 rdf:type cls:c_4057.
kg:id_43 rdfs:label "地域活性化につながる方向を探る"@ja.
kg:id_43 rdf:type cls:c_1287.
kg:id_42 prop:contermeasure kg:id_43.
kg:st_1 rdfs:label "東急不動産 西田恵介・統括部長"@ja.
kg:st_1 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "松前町の人たちに安い電気を提供したい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域や社会を活性化する形で再エネ事業を発展させたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "再エネ開発と運営を通じて地域社会を活性化したい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "東急不動産 インフラ・インダストリー事業本部 西田恵介・統括部長"@ja.
kg:st_2 rdfs:type cls:st_1.
kg:op_4 prop:content "ブランド戦略で再エネ事業への思いを社内外に浸透させたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "再エネ事業でも地域活性化と事業拡大の両立を目指す"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "大型の風力発電設備は、工場から設置場所までの搬送が課題になる"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "地上30m以上の上空には、年平均風速5～6mの風が安定的に吹き、風力発電の適地としても知られ"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:text-txt_contents "変動する風力発電の出力を蓄電池への入出力で補うことで、秒単位の短周期変動を平滑化しつつ、時間単位の長周期変動を平準化することで、北電の系統運用に対する負荷を軽減している"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:text-txt_contents "必要以上に充放電量が多くなると、変換ロスが大きくなって売電量が減ってしまう"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:text-txt_contents "必要な時に充電量や空き容量が十分にないと、技術要件を逸脱してしまい、電力連系から解列されて売電できない"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "北海道初の蓄電池システムを併設した風力発電所でもある"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:text-txt_contents "このクラスの大型風車になると、タワー下からナセルまで、点検・保守の度に階段で上るのは体力的に限界になってくる。そこで、小型のエレベーターが装備されている"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:text-txt_contents "風車と蓄電池の連係は、風車からの交流と蓄電池からの交流を合わせた合成出力を北海道電力の系統に送電する「ACリンク」という方式になる"@ja.
<< kg:id_5 prop:contermeasure kg:id_17 >>
    prop:text-txt_contents "変動する風力発電の出力を蓄電池への入出力で補うことで、秒単位の短周期変動を平滑化しつつ、時間単位の長周期変動を平準化する"@ja.
<< kg:id_5 prop:contermeasure kg:id_18 >>
    prop:text-txt_contents "事前に一定の変動率内に出力変動を抑えた発電計画（送電計画）を策定して北電に提出しておき"@ja.
<< kg:id_5 prop:contermeasure kg:id_19 >>
    prop:text-txt_contents "それに沿うように蓄電池を充放電制御する"@ja.
<< kg:id_5 prop:contermeasure kg:id_20 >>
    prop:text-txt_contents "今回稼働した「リエネ松前風力発電所」では、北海道電力が2016年4月に出した「風力発電設備の出力変動緩和対策に関する技術要件」に対応したものだ"@ja.
<< kg:id_21 prop:contermeasure kg:id_22 >>
    prop:text-txt_contents "短周期変動では、風車と蓄電池の合成出力の変化速度を「発電所定格出力の毎分1％以下」に緩和することを求めている"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "長周期の出力変動の緩和対策では、以下4つの指定時間帯において、合成出力の変動方向を制御することを求めている"@ja.
<< kg:id_23 prop:contermeasure kg:id_25 >>
    prop:text-txt_contents "具体的には、「7～10時に（合成出力を）減少させない」"@ja.
<< kg:id_23 prop:contermeasure kg:id_26 >>
    prop:text-txt_contents "「11時30分～13時30分に増減させない」"@ja.
<< kg:id_23 prop:contermeasure kg:id_27 >>
    prop:text-txt_contents "「16～19時に減少させない」"@ja.
<< kg:id_23 prop:contermeasure kg:id_28 >>
    prop:text-txt_contents "「20～23時に増加させない」"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:text-txt_contents "計画した出力ロードを達成するためには、リアルタイムでの充放電制御に加え"@ja.
<< kg:id_29 prop:contermeasure kg:id_31 >>
    prop:text-txt_contents "その時々に必要になりそうな蓄電池の充電量や空き容量を事前に予想しておき、それに備えた運転も必要になる"@ja.
<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:text-txt_contents "同社では、すでにFIT制度の終了を睨み、FITに依存しない再エネ事業の在り方を本格的に検討しているという"@ja.
<< kg:id_32 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "その選択肢には、地域に独自に配電網を敷設して、住民に安価な再エネ電力を送ったり"@ja.
<< kg:id_32 prop:contermeasure kg:id_35 >>
    prop:text-txt_contents "地域で独立したマイクログリッドのような仕組みも視野に入っているという"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "「リエネ松前風力発電所」の蓄電池システムは、地域グリッドの形成に貴重な知見を蓄積できる"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "同社の狙いは、単に再エネ比率を高めるだけでなく「再エネ開発とその運営を通じて、地域社会を活性化したい」という思いがある"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "西田恵介・統括部長は、「再エネ事業のブランド戦略を通じて、こうした思いを社外とともに、社内にもいっそう浸透させていきたい」と言う"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "再エネ事業でも、うまく地域活性化につながる方向を探りたい、そうした社会ニーズの中に次の事業拡大の可能性もある"@ja.
}
