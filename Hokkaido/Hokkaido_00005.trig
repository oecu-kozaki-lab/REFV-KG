kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "東急不動産株式会社"@ja.
kg:st_2 rdfs:type cls:st_53.
cls:st_53 rdfs:label "企業"@ja.
kg:op_2 prop:content "企業連携による地域振興とまちづくりの発展に寄与する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "人口減少という差し迫った課題に対して高い実現性を持つ解決策が求められるため"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "東急不動産が持つ再生可能エネルギー事業、まちづくりのノウハウを生かした官民連携手法で計画の策定を行います"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "新たに策定する計画については、再来年度から始まる松前町の後期総合計画にも内容が反映され"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "５年後、１０年後のまちの在り方を考える上でも重要なターニングポイントとなります"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今般、再生可能エネルギーを中心とした、松前町の将来を見据えたまちづくり計画の策定支援を行う事で、松前町における企業連携による地域振興とまちづくりの発展に寄与してまいります"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "風力発電事業を活かした地域活性化及び防災基盤の整備"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "更なる風力発電事業の推進に向けた協定書を２０１９年１２月に松前町と締結しております"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "蓄電池システムを利用することで、風による発電の出力変動を吸収し、安定した電力供給を可能としています"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:text-txt_contents "一般家庭約３０，０００世帯分の年間消費電力を供給する"@ja.
<< kg:id_14 prop:effect kg:id_16 >>
    prop:text-txt_contents "一般家庭約３０，０００世帯分（※）の年間消費電力に相当する１０，５９０万 kWh/年の発電量を想定しています"@ja.
<< kg:id_14 prop:effect kg:id_17 >>
    prop:text-txt_contents "２０１９年４月時点で運転している風車としては日本最大となります"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:text-txt_contents "松前町の人口減少と町役場職員数の減少に対応した庁内ＤＸ"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:text-txt_contents "松前町の人口減少と町役場職員数の減少に対応した庁内ＤＸ"@ja.
<< kg:id_18 prop:contermeasure kg:id_21 >>
    prop:text-txt_contents "松前町の人口減少と町役場職員数の減少に対応した庁内ＤＸ"@ja.
<< kg:id_18 prop:contermeasure kg:id_22 >>
    prop:text-txt_contents "関係人口の増加を目的としたＤＸの推進"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "松前町職員と松前町民が取り組める、実現可能性の高い松前町独自のアプローチによるＳＤＧｓ施策"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:text-txt_contents "上記３つの計画を反映した総合計画の策定"@ja.
