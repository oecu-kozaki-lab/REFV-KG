PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00006> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "松前町のまちづくり計画策定"@ja.
kg:id_1 rdf:type cls:c_14376.
cls:c_14376 rdfs:label "まちづくり計画"@ja.
kg:id_2 rdfs:label "松前町と東急不動産の連携に係る協定書の締結"@ja.
kg:id_2 rdf:type cls:c_6651.
cls:c_6651 rdfs:label "連携協定"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "地域活性化及び防災基盤の整備"@ja.
kg:id_3 rdf:type cls:c_1287.
cls:c_1287 rdfs:label "地域活性化"@ja.
kg:id_4 rdfs:label "風力発電事業"@ja.
kg:id_4 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "更なる風力発電事業の推進に向けた協定書の締結"@ja.
kg:id_5 rdf:type cls:c_6651.
kg:id_3 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "松前町における企業連携による地域振興とまちづくりの発展"@ja.
kg:id_6 rdf:type cls:c_3268.
cls:c_3268 rdfs:label "地域振興"@ja.
kg:id_7 rdfs:label "再生可能エネルギーを中心とした松前町の将来を見据えたまちづくり計画の策定支援"@ja.
kg:id_7 rdf:type cls:c_2633.
cls:c_2633 rdfs:label "計画策定支援"@ja.
kg:id_6 prop:contermeasure kg:id_7.
kg:id_7 prop:effect kg:id_6.
kg:st_1 rdfs:label "東急不動産株式会社"@ja.
kg:st_1 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "企業連携による地域振興とまちづくりの発展に寄与する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "企業連携による地域振興とまちづくりの発展に寄与する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:text-txt_contents "松前町（所在地：北海道松前郡松前町、町長：石山英雄）と東急不動産株式会社（所在地：東京都渋谷区 代表取締役社長：岡田正志）は、松前町のまちづくり計画策定に向けた連携に係る協定書を締結したことをお知らせします。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "東急不動産は２０１９年４月に松前町において一般家庭約３０，０００世帯分の年間消費電力を供給する北海道で初の蓄電池併設型風力発電所「リエネ松前風力発電所」の運転を開始しており、風力発電事業を活かした地域活性化及び防災基盤の整備と、更なる風力発電事業の推進に向けた協定書を２０１９年１２月に松前町と締結しております。"@ja.
<< kg:id_3 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "東急不動産は２０１９年４月に松前町において一般家庭約３０，０００世帯分の年間消費電力を供給する北海道で初の蓄電池併設型風力発電所「リエネ松前風力発電所」の運転を開始しており、風力発電事業を活かした地域活性化及び防災基盤の整備と、更なる風力発電事業の推進に向けた協定書を２０１９年１２月に松前町と締結しております。"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今般、再生可能エネルギーを中心とした、松前町の将来を見据えたまちづくり計画の策定支援を行う事で、松前町における企業連携による地域振興とまちづくりの発展に寄与してまいります。"@ja.
<< kg:id_7 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今般、再生可能エネルギーを中心とした、松前町の将来を見据えたまちづくり計画の策定支援を行う事で、松前町における企業連携による地域振興とまちづくりの発展に寄与してまいります。"@ja.
}
