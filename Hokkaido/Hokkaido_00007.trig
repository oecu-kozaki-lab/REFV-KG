PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00007> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "陸上風力発電所開発の検討開始"@ja.
kg:id_1 rdf:type cls:c_14384.
cls:c_14384 rdfs:label "風力発電開発"@ja.
kg:id_2 rdfs:label "計画段階環境配慮書等を経済産業大臣へ提出"@ja.
kg:id_2 rdf:type cls:c_14385.
cls:c_14385 rdfs:label "環境書類提出"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "北海道知事、宮城県知事および山形県知事へ意見を求める"@ja.
kg:id_3 rdf:type cls:c_14386.
cls:c_14386 rdfs:label "知事意見聴取"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "配慮書等を関係行政機関および当社ホームページで公表"@ja.
kg:id_4 rdf:type cls:c_11.
cls:c_11 rdfs:label "情報公開"@ja.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "地域の皆さまや関係行政機関からの意見を賜る"@ja.
kg:id_5 rdf:type cls:c_99.
cls:c_99 rdfs:label "意見聴取"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:st_1 rdfs:label "関西電力株式会社"@ja.
kg:st_1 rdfs:type cls:st_188.
cls:st_188 rdfs:label "電力会社"@ja.
kg:op_1 prop:content "環境影響評価法に基づき開発検討を進める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "知事の意見を求めて開発検討を進める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "配慮書を公表して情報公開する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域住民や関係行政機関の意見を踏まえて検討を進める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "当社は本日、環境影響評価法に基づき、計画段階環境配慮書等※を経済産業大臣へ提出し"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "北海道知事、宮城県知事および山形県知事へ意見を求めました"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "配慮書等は、本年６月１日から６月３０日まで、関係行政機関および当社ホームページで公表します"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "当社は今後、地域の皆さまや関係行政機関からのご意見を賜り、本開発に関する検討を進めてまいります"@ja.
}
