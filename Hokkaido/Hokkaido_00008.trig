<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "計画地の大半を占める自然度９の森林の伐採への懸念"@ja.
<< kg:id_28 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
