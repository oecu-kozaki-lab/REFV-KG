    prop:text-txt_contents "土地の改変および立木の伐採を伴う工事用道路の新設を大規模に行う必要がある"@ja.
<< kg:id_28 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "鳥類のバードストライクへの懸念"@ja.
<< kg:id_28 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "風車が建設されればこのような鳥類がバードストライクの危険に晒されることになる"@ja.
<< kg:id_28 prop:effect kg:id_31 >>
