<< kg:id_28 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である"@ja.
<< kg:id_28 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である"@ja.
<< kg:id_28 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "保安林を解除しての事業は行うべきではない"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
