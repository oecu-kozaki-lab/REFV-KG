kg:st_1 rdfs:label "公益財団法人 日本自然保護協会"@ja.
kg:st_1 rdf:type cls:st_148.
cls:st_148 rdfs:label "自然保護団体"@ja.
kg:op_1 prop:content "計画段階環境配慮書段階で計画を中止すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "イヌワシ保全の取り組みに逆行すると懸念"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "絶滅に繋がることを強く懸念"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "IBAとA3エリアを少なくとも除外すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "野鳥への影響が強く懸念される"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "重要な場所での大規模な開発行為はおこなうべきではない"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "生物多様性保全上重要な場所での開発は不適切"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "自然度が高く重要な森林群落の伐採は行うべきではない"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "広範囲な伐採は自然環境保全上行うべきではない"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "重大な影響を回避又は十分に低減できない可能性が高い"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "利用施設や主要な眺望点への影響を懸念"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "計画段階環境配慮書段階で計画を中止すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "少なくとも除外するべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "事業計画を中止するか抜本的な見直しが必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "個体群の絶滅に繋がることを強く懸念"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "保全の取り組みに逆行する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "IBAとA3エリアを少なくとも除外するべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "野鳥の生息への影響が強く懸念される"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "生存への影響が懸念される"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "重要な場所での大規模な開発行為はおこなうべきではない"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "広範囲に伐採されることは自然環境保全上行うべきではない"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "大規模に行う必要があるため問題"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "下流部の各渓流での土砂災害リスクを高めることが懸念される"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "下流部の土砂災害リスクを高める"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "中止するか抜本的な見直しが必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "中止するか抜本的な見直しが必要"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "少なくとも除外するべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "広範囲の土地改変と伐採が予想される"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "自然環境面で重要な森林を広範囲に開発する行為は行うべきではない"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "同地域の森林が失われることで連続性が失われると懸念"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "自然保護上の問題が大きい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "中止するか抜本的な見直しが必要"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "中止するか抜本的な見直しが必要"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "森林に生息する鳥獣の保護のため除外すべき"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "広範囲な伐採行為は自然環境保全上行うべきではない"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "大規模に行う必要がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "同地域で事業を計画すべきではない"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "鳥類がバードストライクの危険に晒される"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "水源地への影響と氾濫リスク増大の可能性がある"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "市民の水源への影響が懸念される"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "保安林を解除しての事業は行うべきではない"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "水源地への影響と氾濫リスク増大を招く可能性がある"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "中止するか抜本的な見直しが必要"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "中止するか抜本的な見直しが必要"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "保安林を解除しての事業は行うべきではない"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "栗山町景観計画の指針に最大限配慮すべき"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "田園景観に悪影響を及ぼしてはならない"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "景観計画の指針に最大限配慮して事業を実施すべき"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "種の保存法の政令指定種イヌワシとクマタカの個体群に影響を及ぼす懸念がある"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "生息個体を発電施設への衝突事故の可能性にさらすことになり"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "道南地域のイヌワシ個体群の絶滅に繋がることが強く懸念される"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "風車によるバードストライクなどによって、野鳥の生息への影響が強く懸念される"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "風車によるバードストライクなどによって"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "生物多様性の喪失が懸念される"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "このような生物多様性保全上重要な場所での大規模な開発行為はおこなうべきではない"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "重要な植物群落、植物種への影響が懸念される"@ja.
<< kg:id_1 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "土地の改変および立木の伐採を伴う工事用道路の新設を大規模に行う必要がある"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "支笏洞爺国立公園への影響が回避できない"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "眺望する際の重大な影響を回避又は十分に低減できない可能性が極めて高い"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "計画段階環境配慮書段階で計画を中止すべきである"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "本事業実施想定区域からIBAおよび陸域版センシティビティマップのA３のエリアは少なくとも除外するべきである"@ja.
<< kg:id_15 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "種の保存法の政令指定種イヌワシとクマタカの個体群への影響に対する懸念"@ja.
<< kg:id_15 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "生息個体を発電施設への衝突事故の可能性にさらすことになり"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "同地域のイヌワシ個体群の絶滅に繋がることが強く懸念される"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "鳥類のバードストライクへの懸念"@ja.
<< kg:id_15 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "風車によるバードストライクなどによって"@ja.
<< kg:id_15 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "野鳥の生息への影響が強く懸念される"@ja.
<< kg:id_15 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "生物多様性の喪失が懸念される"@ja.
<< kg:id_15 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "重要な植物群落、植物種への影響への懸念"@ja.
<< kg:id_15 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "土地の改変および立木の伐採を伴う工事用道路の新設を大規模に行う必要がある"@ja.
<< kg:id_15 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "土砂災害の危険性増大の危惧"@ja.
<< kg:id_15 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "上流部の立石山の尾根上で大規模な土地改変や伐採行為を行うことは、下流部の各渓流での土砂災害リスクを高めることが懸念される"@ja.
<< kg:id_15 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である"@ja.
<< kg:id_15 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である"@ja.
<< kg:id_15 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "本事業実施想定区域からIBAおよび陸域版センシティビティマップのA３のエリアは少なくとも除外するべきである"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "風力発電機を設置するためには、工事用道路を新設する必要があり"@ja.
<< kg:id_22 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "広範囲の土地の改変および立木の伐採が予想される"@ja.
<< kg:id_22 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "同地域の森林が失われることで、自然林の連続性が失われることが懸念される"@ja.
<< kg:id_22 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "特に特別保護地区を事業想定範囲内に含めたことは、自然保護上の問題が大きい"@ja.
<< kg:id_22 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である"@ja.
<< kg:id_22 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である"@ja.
<< kg:id_22 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
