kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "本地域に建設を計画した事業者の見識が問われる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "余市鳥獣保護区および余市特別保護地区を事業実施想定範囲から除外すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "森林に生息する鳥獣の保護を目的とした区域は除外すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "生物多様性の喪失など自然環境面での多大な影響が予測されるため中止が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "生物多様性の喪失など自然環境面での多大な影響が予測されるため抜本的な見直しが必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本事業は下記のような懸念があり、生物多様性の喪失などの自然環境面での多大な影響が予測されることから、事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本事業は下記のような懸念があり、生物多様性の喪失などの自然環境面での多大な影響が予測されることから、事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である。"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:text-txt_contents "そのため、風力発電機を設置するためには、工事用道路を新設する必要があり、広範囲の土地の改変および立木の伐採が予想される。"@ja.
<< kg:id_6 prop:cause kg:id_5 >>
    prop:text-txt_contents "そのため、風力発電機を設置するためには、工事用道路を新設する必要があり、広範囲の土地の改変および立木の伐採が予想される。"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:text-txt_contents "同地域の森林が失われることで、自然林の連続性が失われることが懸念される。"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "このような自然環境面で重要な森林を広範囲に開発する行為は、自然環境保全上、行うべきではなく、そもそも本地域に建設を計画した事業者の見識が問われる。"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "特に特別保護地区を事業想定範囲内に含めたことは、自然保護上の問題が大きい。"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "森林に生息する鳥獣の保護を目的とした余市鳥獣保護区および余市特別保護地区を事業実施想定範囲からは除外すべきである。"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "本事業は下記のような懸念があり、生物多様性の喪失などの自然環境面での多大な影響が予測されることから、事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である。"@ja.
<< kg:id_15 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本事業は下記のような懸念があり、生物多様性の喪失などの自然環境面での多大な影響が予測されることから、事業計画を中止するか、事業実施想定区域の抜本的な見直しが必要である。"@ja.
