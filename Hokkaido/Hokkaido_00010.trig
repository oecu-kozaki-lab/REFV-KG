kg:st_3 rdfs:label "北海道松前町"@ja.
kg:st_3 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_3 prop:content "再生可能エネルギーを活用した街づくり推進に向け生徒への理解促進に取り組む"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "生徒の再生可能エネルギー理解深耕を目的に見学会を実施してきた"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "生徒の再生可能エネルギー理解深耕を目的に出前授業を実施してきた"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "生徒の再生可能エネルギー理解深耕を目的に現地見学会を実施してきた"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "再生可能エネルギー事業とまちづくりのノウハウを生かした官民連携で計画策定を進める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "官民連携でまちづくり計画策定を進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "年間計画に再生可能エネルギー理解促進活動を組み込む"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:st_4 rdfs:label "東急不動産株式会社 北海道松前町教育委員会"@ja.
kg:st_4 rdfs:type cls:st_191.
cls:st_191 rdfs:label "組織"@ja.
kg:op_10 prop:content "相互協力のもとで継続的に啓蒙と理解促進を実施する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "脱炭素社会の実現を掲げ再生可能エネルギー事業を展開する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "地元の方々に親しみを持ってもらえる発電所建設を目指す"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "地元の方に興味と親しみを持ってもらう仕組みを整備する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "地元の方に興味と親しみを持ってもらう仕組みを整備する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "災害時にも活用できる設備を整備する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "災害時にも活用できる設備を整備する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "周辺環境との調和を目的に設備を設置する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "周辺環境との調和を目的に設備を設置する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "子どもたちが楽しみながら学べるようワークショップを開催した"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "子どもたちが楽しみながら学べるようクイズを実施した"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "子どもたちが楽しみながら学べるよう展示を実施した"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "すぐにでも始められる脱炭素の取り組みを体験できるイベントを開催した"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "蓄電池システムにより安定した電力供給を可能にする"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "当社」と北海道松前町教育委員会は、未来を担う子供たちに再生可能エネルギーに関する教育を行うことについて協定書を締結しました"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "松前町は2020年11月に「松前町再生可能エネルギー活用ビジョン」を策定し、再生可能エネルギーを活用した街づくりの推進に向けて、これからの松前町の未来を担う町内小中学校の児童及び生徒に対し、再生可能エネルギーの理解及び利活用の促進に積極的に取り組んでいます"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "2018年度より町内小中学校の生徒に、再生可能エネルギーに対する理解深耕を目的とした同風力発電所の工事見学会"@ja.
<< kg:id_5 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "2018年度より町内小中学校の生徒に、再生可能エネルギーに対する理解深耕を目的とした同風力発電所の工事見学会、当社社員による出前授業の実施"@ja.
<< kg:id_5 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "2018年度より町内小中学校の生徒に、再生可能エネルギーに対する理解深耕を目的とした同風力発電所の工事見学会、当社社員による出前授業の実施、完成後の同風力発電所の現地見学会等を行ってきました"@ja.
<< kg:id_9 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "2022年3月1日に当社は松前町とまちづくり計画策定に関する協定書を締結し、当社が持つ再生可能エネルギー事業、まちづくりのノウハウを生かした官民連携手法で計画の策定を進めており、再生可能エネルギーと共に歩む街づくりに協力してまいります"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本協定書締結後は、教育委員会が策定する年間計画の中に再生可能エネルギーの理解促進に向けた活動が組み込まれ"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "松前町内小中学生に向けた再エネ事業の啓蒙と理解促進を相互協力のもとで継続的に実施"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "「脱炭素社会の実現」「地域との共生と相互発展」「日本のエネルギー自給率の向上」の3つの社会課題の解決を掲げ、太陽光・風力・バイオマスなどの再生可能エネルギー発電所を、全国で82件（開発中事業含む）、定格容量は1,325MWの事業に携わっています"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "当社は再生可能エネルギーを通じた地域との共生に向けて以下の取り組みを進めております。＜サイトブランディング＞周辺環境との調和を図ると共に、地元の方々に親しみを持って頂ける発電所の建設を目指した発電所の景観配慮の取り組みを進めています"@ja.
<< kg:id_19 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "地元の方に再生可能エネルギーに興味、親しみを持っていただけるような仕組み整備として以下を実施・シンボルツリーとなるウミネコザクラの設置"@ja.
<< kg:id_19 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "地元の方に再生可能エネルギーに興味、親しみを持っていただけるような仕組み整備として以下を実施・シンボルツリーとなるウミネコザクラの設置/サークルベンチの設置"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "災害時等にスマートフォン充電が可能なソーラー照明や、かまどベンチの設置"@ja.
<< kg:id_22 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "災害時等にスマートフォン充電が可能なソーラー照明や、かまどベンチの設置"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "周辺環境との調和を目的とした生垣・門扉の設置"@ja.
<< kg:id_25 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "周辺環境との調和を目的とした生垣・門扉の設置"@ja.
<< kg:id_28 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "子どもたちに地球温暖化や再エネといったテーマについて楽しみながら学んでもらえるよう、エコバックを作るワークショップや、iPadを使ったクイズ、パネル展示を通じ"@ja.
<< kg:id_28 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
