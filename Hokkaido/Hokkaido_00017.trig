kg:id_1 rdfs:label "松前町の活性化"@ja.
kg:id_1 rdf:type cls:c_1287.
cls:c_1287 rdfs:label "地域活性化"@ja.
kg:id_2 rdfs:label "観光面の課題である特産品のブランディング"@ja.
kg:id_2 rdf:type cls:c_1414.
