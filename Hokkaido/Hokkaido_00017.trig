cls:c_14475 rdfs:label "デザイン提案"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "特産品パッケージのデザイン提案"@ja.
kg:id_4 rdf:type cls:c_14475.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "特産品魅力向上"@ja.
kg:id_5 rdf:type cls:c_1931.
cls:c_1931 rdfs:label "魅力向上"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "観光物産協会の協会ロゴに正式採用"@ja.
kg:id_6 rdf:type cls:c_14476.
cls:c_14476 rdfs:label "ロゴ採用"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "地元の方々から学生の提案への高い評価"@ja.
kg:id_7 rdf:type cls:c_1696.
cls:c_1696 rdfs:label "高評価"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "特産品パッケージ"@ja.
kg:id_8 rdf:type cls:c_14477.
cls:c_14477 rdfs:label "商品包装"@ja.
kg:id_9 rdfs:label "各店舗で採用に向けたリニューアル継続検討"@ja.
kg:id_9 rdf:type cls:c_14478.
cls:c_14478 rdfs:label "改良検討"@ja.
kg:id_8 prop:contermeasure kg:id_9.
kg:st_1 rdfs:label "東急不動産株式会社"@ja.
kg:st_1 rdfs:type cls:st_53.
cls:st_53 rdfs:label "企業"@ja.
kg:op_1 prop:content "特産品のブランディングに関する実証的な取組を継続して実施し活性化に貢献する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "東急不動産株式会社 株式会社学生情報センター"@ja.
kg:st_2 rdfs:type cls:st_53.
kg:op_2 prop:content "観光振興を目的に学生によるブランドロゴのデザイン提案を実施した"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "観光振興を目的に学生による特産品パッケージのデザイン提案を実施した"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "主催 東急不動産"@ja.
kg:st_3 rdfs:type cls:st_53.
kg:op_4 prop:content "特産品魅力向上による地域活性化を目的とした"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "一般社団法人北海道まつまえ観光物産協会"@ja.
kg:st_4 rdfs:type cls:st_109.
cls:st_109 rdfs:label "観光団体"@ja.
kg:op_5 prop:content "提案された松前町ブランドロゴを協会ロゴマークとして正式採用した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:st_5 rdfs:label "地元の方々"@ja.
kg:st_5 rdfs:type cls:st_167.
cls:st_167 rdfs:label "地域住民"@ja.
kg:op_6 prop:content "学生の持つ感性を活かした提案を高く評価した"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_5.
kg:st_6 rdfs:label "各店舗"@ja.
kg:st_6 rdfs:type cls:st_195.
cls:st_195 rdfs:label "販売者"@ja.
kg:op_7 prop:content "パッケージ採用に向けてリニューアルを継続検討している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_6.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今後も、松前町の観光面の課題である特産品のブランディングに関する実証的な取組等を継続して実施し、松前町の活性化に貢献してまいります。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "北海道松前町の観光振興を目的とした「松前町スタケーションプロジェクト」を開催し、学生による「松前町ブランドロゴ」及び「特産品パッケージ」のデザイン提案を実施いたしました。"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "北海道松前町の観光振興を目的とした「松前町スタケーションプロジェクト」を開催し、学生による「松前町ブランドロゴ」及び「特産品パッケージ」のデザイン提案を実施いたしました。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "目的 松前町の特産品魅力向上による地域活性化と学生キャリア形成支援"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "この度、本プロジェクトにおいて提案した「松前町ブランドロゴ」が、これまでの松前観光協会と松前物産協会が合併して新たに設立された一般社団法人北海道まつまえ観光物産協会の「協会ロゴマーク」に正式採用されることが4月17日開催の定期総会にて決定いたしました。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "成果発表会では、参加者の皆様から学生の持つ感性を活かした提案に対する高い評価をいただきました。"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "特産品パッケージ：各店舗で、パッケージの採用に向けたリニューアルを継続検討。"@ja.
}
