kg:st_1 rdfs:label "東急不動産"@ja.
kg:st_1 rdfs:type cls:st_53.
cls:st_53 rdfs:label "企業"@ja.
kg:op_1 prop:content "今後も継続実施し活性化に貢献する方針"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "参加者の皆様"@ja.
kg:st_2 rdfs:type cls:st_74.
cls:st_74 rdfs:label "参加者"@ja.
kg:op_2 prop:content "学生の感性を活かした提案を高く評価"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "本プロジェクトにおいて提案した「松前町ブランドロゴ」が、これまでの松前観光協会と松前物産協会が合併して新たに設立された一般社団法人北海道まつまえ観光物産協会の「協会ロゴマーク」に正式採用されることが4月17日開催の定期総会にて決定いたしました"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "北海道松前町の観光振興を目的とした「松前町スタケーションプロジェクト」を開催し"@ja.
<< kg:id_3 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "「松前町スタケーションプロジェクト」を開催し、学生による「松前町ブランドロゴ」及び「特産品パッケージ」のデザイン提案を実施いたしました"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今後も、松前町の観光面の課題である特産品のブランディングに関する実証的な取組等を継続して実施し、松前町の活性化に貢献してまいります"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:text-txt_contents "松前町の観光面の課題である特産品のブランディング"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:text-txt_contents "学生の事前調査及び現地ヒアリングをもとに、「松前町の特産品とわかりやすい」「高級感へのこだわり」等をキーワードとして「松前町ブランドロゴ」のデザイン案を作成しました"@ja.
<< kg:id_10 prop:cause kg:id_12 >>
    prop:text-txt_contents "「松前町の特産品とわかりやすい」「高級感へのこだわり」等をキーワードとして「松前町ブランドロゴ」のデザイン案を作成しました"@ja.
<< kg:id_10 prop:cause kg:id_13 >>
    prop:text-txt_contents "「松前町の特産品とわかりやすい」「高級感へのこだわり」等をキーワードとして「松前町ブランドロゴ」のデザイン案を作成しました"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "「松前町ブランドロゴ」のテーマである「高級感」と、松前町の「桜」や「松前城」をモチーフにしたパッケージデザインを考案しました"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:text-txt_contents "松前町の「桜」や「松前城」をモチーフにしたパッケージデザインを考案しました"@ja.
<< kg:id_14 prop:cause kg:id_17 >>
    prop:text-txt_contents "松前町の「桜」や「松前城」をモチーフにしたパッケージデザインを考案しました"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:text-txt_contents "また、「瓶詰め」「個別包装」等の機能面の提案も実施しました"@ja.
<< kg:id_18 prop:contermeasure kg:id_20 >>
    prop:text-txt_contents "また、「瓶詰め」「個別包装」等の機能面の提案も実施しました"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "成果発表会では、参加者の皆様から学生の持つ感性を活かした提案に対する高い評価をいただきました"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "2023年1月に発足した「観光物産協会」の協会ロゴに「松前町ブランドロゴ」を採用"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:text-txt_contents "各店舗で、パッケージの採用に向けたリニューアルを継続検討"@ja.
}
