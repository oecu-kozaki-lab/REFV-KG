kg:id_1 prop:contermeasure kg:id_24.
kg:st_1 rdfs:label "NPO法人・環境把握推進ネットワーク－PEG理事長 照井滋晴さん"@ja.
kg:st_1 rdfs:type cls:st_158.
cls:st_158 rdfs:label "環境団体"@ja.
kg:op_1 prop:content "太陽光事業は止まりにくく再生可能エネルギー政策が背景にある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "環境団体や専門家"@ja.
kg:st_2 rdfs:type cls:st_158.
kg:op_2 prop:content "このままでは湿原がソーラーパネルだらけになると危惧"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "NPO法人「トラストサルン釧路」副理事長でタンチョウの研究者 松本文雄さん"@ja.
kg:st_3 rdfs:type cls:st_105.
cls:st_105 rdfs:label "研究者"@ja.
kg:op_3 prop:content "発電所付近はタンチョウの営巣確認場所だった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:st_4 rdfs:label "日本野鳥の会・釧路支部長 黒澤信道さん"@ja.
kg:st_4 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_4 prop:content "エサ動物がいなくなり用心深いチュウヒはもう巣を作れない"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_4.
kg:st_5 rdfs:label "釧路市立博物館と照井滋晴さんはじめ京都大学などの研究者"@ja.
kg:st_5 rdfs:type cls:st_105.
kg:op_5 prop:content "生息適地と太陽光発電施設の設置が進むエリアの重なりが判明した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_5.
kg:op_6 prop:content "事業地を利用していたタンチョウは見られなくなった"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:st_6 rdfs:label "釧路湿原自然再生協議会会長 北海道大学農学研究院教授 中村太士さん"@ja.
kg:st_6 rdfs:type cls:st_105.
kg:op_7 prop:content "景観悪化が観光にも悪影響を及ぼす懸念が大きい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_6.
kg:st_7 rdfs:label "釧路自然保護協会をはじめ地元9団体"@ja.
kg:st_7 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_8 prop:content "建設ラッシュを憂い対策を求めた"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_7.
kg:st_8 rdfs:label "釧路湿原自然再生協議会"@ja.
kg:st_8 rdfs:type cls:st_145.
cls:st_145 rdfs:label "協議会"@ja.
kg:op_9 prop:content "建設ラッシュを憂い対策を求めた"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_8.
kg:op_10 prop:content "知見をもとに生息適地を可視化した"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:st_9 rdfs:label "釧路市"@ja.
kg:st_9 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_11 prop:content "地権者や事業者に保全協力を求めている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_9.
kg:op_12 prop:content "生息地を守るため小さな土地の買い取りを進める考え"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "建設するなら環境や生態系への影響が少ない工法を取るべきだ"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:st_10 rdfs:label "釧路市 蝦名大也市長"@ja.
kg:st_10 rdfs:type cls:st_11.
kg:op_14 prop:content "条例化を視野にガイドラインを作る方針を示した"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_10.
kg:st_11 rdfs:label "釧路市環境保全課"@ja.
kg:st_11 rdfs:type cls:st_11.
kg:op_15 prop:content "まずガイドラインで釧路湿原を守る姿勢を明確にする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_11.
kg:op_16 prop:content "重要地域を特定し建設抑制や建設方法の協議を具体化すべきだ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_6.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "釧路湿原は積雪量が比較的少なく、日照時間が長い。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "釧路湿原は積雪量が比較的少なく、日照時間が長い。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "それになんといっても平坦な土地で、市街化調整区域の近くには送配電網があり"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "市街化調整区域の近くには送配電網があり、太陽光パネルにつなぐことができる。"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:text-txt_contents "市街化調整区域として開発が抑制されてきたが、太陽光発電施設は建築基準法上の建物ではないため設置できる。"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:text-txt_contents "釧路市には景観条例があり、高さ8メートルを超える工作物を設ける際には届け出が求められるが、ソーラーパネル設置には必要ない。"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "再生可能エネルギー自体、推進されているわけだし"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "このままでは、湿原がソーラーパネルの海になってしまう"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "この発電所の付近はNGOによる調査でタンチョウの営巣が確認されてきた場所。"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "チュウヒはネズミなど湿原の小動物を食べるが、こうしたエサ動物がいなくなるし、用心深い鳥なので、もう巣を作る状況ではないと思う"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "その結果、生息適地と太陽光発電施設の設置が進むエリアが重なることが判明した。"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:text-txt_contents "道を挟んで反対側と同様の湿原だったが、あっという間に整地されてパネルが並んだ。"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業地を休息やエサ探しに利用していたタンチョウは見られなくなった。"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "景観が損なわれ観光に悪影響を及ぼすという懸念も大きい"@ja.
<< kg:id_1 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "釧路自然保護協会をはじめ地元9団体が3月17日付けで「要望書」を"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "釧路湿原自然再生協議会（市民団体、専門家、国、道、市町村などで構成）が4月18日付けで「提言」を釧路市に提出した。"@ja.
<< kg:id_1 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "これまでの知見をもとに「釧路市内キタサンショウウオ生息適地マップ」を作成した。"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "市は、この生息適地マップを2021年から公表。現在は市のホームページ上で示され「キタサンショウウオの保全に協力して」と呼びかけている。"@ja.
<< kg:id_1 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "キタサンショウウオが生息し、すぐそばまで太陽光発電施設が迫る小さな土地を買い取ったらどうだろうか"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "太陽光発電施設をどうしても建てたいという事業者には、環境や生態系に影響が少ない工法をとってもらうことも一つの手になる"@ja.
<< kg:id_1 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "釧路市の蝦名大也市長は今年3月、市議会で「条例化を視野にガイドラインを作る」と表明した。"@ja.
<< kg:id_1 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "釧路市は6月中旬に始まる市議会定例会でガイドラインを公表し、その後、条例化の検討に入る。"@ja.
<< kg:id_1 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "生物にとって重要な場所を明らかにして、市の条例でこういう場所は建設を抑制する、こういう場所は建設方法について市や関係者と協議する、というように具体的に地図の上で見える化する必要がある。"@ja.
}
