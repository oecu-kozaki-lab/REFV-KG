kg:id_1 prop:contermeasure kg:id_19.
kg:st_1 rdfs:label "東急不動産株式会社"@ja.
kg:st_1 rdfs:type cls:st_53.
cls:st_53 rdfs:label "企業"@ja.
kg:op_1 prop:content "環境教育活動を積極的に行う"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域参加型で企画・開発を進める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "北海道松前町と連携しながら地域振興とまちづくりの発展に取り組む"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "小中学生への再生可能エネルギー理解促進を進める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "環境教育活動を積極的に行う"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "町民が風力発電事業を身近に感じる場を整備する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地域と育むファームとして農業活用を進める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "花と緑を活かした場づくりを進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "松前町民や子供たちと一緒に本園を育てる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "北海道松前町において、「風」という資源を活かした町のシンボルを目指した場所として「リエネウインドファーム松前」（以下、「本園」）を2023年9月17日にオープンしました"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "まちの特性を活かした風力発電事業によって地域活性化を促進する北海道松前町の新名所「リエネウインドファーム松前」が開園"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "町営パークゴルフ場近接地に建つ当社の大型風車の周辺用地を整備することで、町民の方々に風力発電事業をより身近に感じていただき"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "まちの特性を活かした風力発電事業によって地域活性化を促進する北海道松前町の新名所「リエネウインドファーム松前」が開園"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "町民の方々に風力発電事業をより身近に感じていただき"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "北海道松前町の誇る「風」という資源を活かした町のシンボルとなるような場所を目指して"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "2022年7月には松前町教育委員会と町内の小中学生への再生可能エネルギーの理解促進を目的とした協定を締結し、出前授業や風車見学会を実施するなど、環境教育活動を積極的に行っております"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:text-txt_contents "本園は、町内小中学生に向けた風車見学会等の「再生可能エネルギーの学習フィールド」として"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:text-txt_contents "また草花や農作物の種蒔きから収穫等を通じた「農業体験フィールド」であり"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:text-txt_contents "「風と楽しく遊ぶプレイフィールド」として活用することで"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "開園にあたって、地域の子供たちや町内外の協力団体の皆さまと共に、本園の企画・開発を行う「みんなでつくるプロジェクト」等を実施いたしました"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "北海道松前町と2019年12月に「再生可能エネルギー事業の推進と地域活性化」に関する協定を締結して以来、北海道松前町と連携しながら地域振興とまちづくりの発展に取り組んでおります"@ja.
<< kg:id_1 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "2022年7月には松前町教育委員会と町内の小中学生への再生可能エネルギーの理解促進を目的とした協定を締結し"@ja.
<< kg:id_1 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "出前授業や風車見学会を実施するなど、環境教育活動を積極的に行っております"@ja.
<< kg:id_1 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "町営パークゴルフ場近接地に建つ当社の大型風車の周辺用地を整備することで"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "「地域と育むファーム」をコンセプトに、大型風車の足元用地を農業によって有効活用することを目指して、蕎麦とジュニパーベリーを育てる農作物実証栽培エリアを設置し"@ja.
<< kg:id_1 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "大型風車に続くフラワーロードエリアではカモミール、ラベンダー、コスモスの栽培に取組んでおり"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "松前町民の皆さま、子供たちと一緒に育んで参ります"@ja.
}
