cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "町の資源である風を活かしたシンボルづくりを重視"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "町民が風力発電を身近に感じられる場づくりを進める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "松前町と連携して地域振興とまちづくりの発展に取り組む"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "風力発電事業を通じて地域活性化を促進する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "松前町の新名所として開園した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "風力発電を町民に身近なものとして感じてもらう"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "中長期にわたり町民に愛着を持ってもらえる場を目指す"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "小中学生向けの学習フィールドとして活用する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "草花や農作物を通じた農業体験の場として活用する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "風と遊ぶ場として町民や子供たちと育む"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "イベント開催により賑わいを創出した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "観光資源と連携し集客を目指す"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "大型風車とカザグルマを来園者が楽しめる空間にした"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "地域参加型で企画開発を進める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "再生可能エネルギーの理解促進のため環境教育活動を行う"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "風力発電を身近に感じるため周辺用地を整備した"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "農業による足元用地の有効活用を図る"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "花と緑を楽しめる景観づくりに取り組む"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "児童の発案を活かした制作を進めた"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "地元産材を活用し児童と共に設置装飾まで行った"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:st_2 rdfs:label "北海道松前高校の生徒"@ja.
kg:st_2 rdf:type cls:st_23.
cls:st_23 rdfs:label "学生"@ja.
kg:op_21 prop:content "蕎麦づくりを探究学習テーマとして取り組む"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "探究学習の一環として子供向けイベントを企画開催"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:st_3 rdfs:label "一般社団法人北海道まつまえ観光物産協会"@ja.
kg:st_3 rdf:type cls:st_109.
cls:st_109 rdfs:label "観光団体"@ja.
kg:op_23 prop:content "園内管理と観光施設連携を担う"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "町内中心部の観光施設と連携して集客を図る"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:st_4 rdfs:label "東急不動産株式会社 一般社団法人北海道まつまえ観光物産協会"@ja.
kg:st_4 rdf:type cls:st_1.
kg:op_25 prop:content "歴史ある街並みと風を活かした街づくりを象徴する装飾を展開する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:st_5 rdfs:label "大島小学校 小島小学校 松城小学校 松前中学校 松前高校の生徒 町立清部保育所の園児 札幌大谷短期大学付属松前こども園の年長組園児"@ja.
kg:st_5 rdf:type cls:st_196.
cls:st_196 rdfs:label "子ども"@ja.
kg:op_26 prop:content "自由に絵をつけたオリジナルカザグルマを制作した"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "北海道松前町の誇る「風」という資源を活かした町のシンボルとなるような場所を目指して、本園の開発を進めて参りました。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "町営パークゴルフ場近接地に建つ当社の大型風車の周辺用地を整備することで、町民の方々に風力発電事業をより身近に感じていただき"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "北海道松前町と 2019 年 12 月に「再生可能エネルギー事業の推進と地域活性化」に関する協定を締結して以来、北海道松前町と連携しながら地域振興とまちづくりの発展に取り組んでおります。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "まちの特性を活かした風力発電事業によって地域活性化を促進する"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "北海道松前町の新名所「リエネウインドファーム松前」が開園"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "町民の方々に風力発電事業をより身近に感じていただき"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本プロジェクトを通して、本園が中長期にわたり町民の皆さまに愛着を持っていただけるような場となることを目指します。"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "本園は、町内小中学生に向けた風車見学会等の「再生可能エネルギーの学習フィールド」として"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "また草花や農作物の種蒔きから収穫等を通じた「農業体験フィールド」であり"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "「風と楽しく遊ぶプレイフィールド」として活用することで、松前町民の皆さま、子供たちと一緒に育んで参ります。"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "松前高校の生徒が探究学習の一環として町内の子供たちに向けてシャボン玉のチャレンジゲームやオリジナルカザグルマづくり、家族写真を撮影するイベントを企画・開催して賑わいを創出いたしました。"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "今後、松前城や町内１万本の桜等の北海道松前町が誇る観光資源に加え、風力発電をより身近に感じる憩いの場として本園を訪れていただけるような集客を目指してまいります。"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "本園オープン時には、観光物産協会が制作した色鮮やかな約 2,000 個のカザグルマが展示され、大型風車と共にフォトスポットとして来園者の皆さまに楽しんでいただきました。"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "地域の子供たちや町内外の協力団体の皆さまと共に、本園の企画・開発を行う「みんなでつくるプロジェクト」等を実施いたしました。"@ja.
<< kg:id_15 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "松前町教育委員会と町内の小中学生への再生可能エネルギーの理解促進を目的とした協定を締結し、出前授業や風車見学会を実施するなど、環境教育活動を積極的に行っております。"@ja.
<< kg:id_15 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "町営パークゴルフ場近接地に建つ当社の大型風車の周辺用地を整備することで"@ja.
<< kg:id_15 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "大型風車の足元用地を農業によって有効活用することを目指して、蕎麦とジュニパーベリーを育てる農作物実証栽培エリアを設置し"@ja.
<< kg:id_15 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "大型風車に続くフラワーロードエリアではカモミール、ラベンダー、コスモスの栽培に取組んでおり"@ja.
<< kg:id_15 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "北海道松前町立松城小学校 3 年生・5 年生の児童を対象に、本園内に設置するベンチ・東屋・オリジナルキャラクターの制作ワークショップを開催しました。"@ja.
<< kg:id_15 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "松前町産を含む地元産材の「道南材」を用い、VUILD の３次元加工技術による製材を経て、2023 年 9 月 13 日に設置と装飾までを児童と共に完了しております。"@ja.
<< kg:id_15 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "北海道松前高校の生徒が松前町オリジナル蕎麦づくりを探究学習テーマとしており、蕎麦の種蒔きから収穫、蕎麦打ちまでを松前町内愛好家の方々と当社の共同作業で進めております。"@ja.
<< kg:id_15 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "松前高校の生徒が探究学習の一環として町内の子供たちに向けてシャボン玉のチャレンジゲームやオリジナルカザグルマづくり、家族写真を撮影するイベントを企画・開催して"@ja.
<< kg:id_15 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "2023 年 7 月より一般社団法人北海道まつまえ観光物産協会（以下、「観光物産協会」）に植栽や園内の維持管理を委託し"@ja.
<< kg:id_15 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "観光物産協会が管理する町内中心部の「松前藩屋敷」や「松前公園」等、松前町内中心部の観光施設との連携を進めて参りました。"@ja.
<< kg:id_15 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "カザグルマによる装飾を、観光物産協会と共同で本園および観光物産協会の運営施設で展開する予定です。"@ja.
<< kg:id_15 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "大島小学校、小島小学校、松城小学校、松前中学校、松前高校の生徒および町立清部保育所の園児と札幌大谷短期大学付属松前こども園の年長組園児の皆さんにも、事前に自由に絵をつけたオリジナルカザグルマを制作いただいており"@ja.
