kg:st_2 rdf:type cls:st_148.
cls:st_148 rdfs:label "自然保護団体"@ja.
kg:op_2 prop:content "事業の中止または計画の抜本的な見直しを求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "日本自然保護協会の若松伸彦博士"@ja.
kg:st_3 rdf:type cls:st_197.
cls:st_197 rdfs:label "自然保護専門家"@ja.
kg:op_3 prop:content "自然環境上重要な場所は外れていると一定の評価をする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "自然環境上重要な場所は外れていると一定の評価をする"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "事業の中止または計画の抜本的な見直しを求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_4 rdfs:label "関西電力"@ja.
kg:st_4 rdf:type cls:st_188.
cls:st_188 rdfs:label "電力会社"@ja.
kg:op_6 prop:content "仁木町では別事業として実現可能性を引き続き探る"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:st_5 rdfs:label "地元"@ja.
kg:st_5 rdf:type cls:st_167.
kg:op_7 prop:content "同意しないことで計画撤回につながる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_5.
kg:st_6 rdfs:label "双日"@ja.
kg:st_6 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_8 prop:content "後志地方で計画していた事業を中止する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_6.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "自然保護団体や地元などから反対の声が出ていたのを受けて"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業の想定区域に手つかずの自然林や鳥獣保護区が含まれていることなどから、事業の中止あるいは計画の抜本的な見直しを求めていた"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "ハイマツなどの自然林が広がる仁木町などを計画地から外した"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "最大64基の風車をつくる計画を同18基と当初計画の約3分の1に縮小する方針だ"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "当初計画していた発電出力最大26万8800キロワットを同7万5600キロワットに縮小する方針だ"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "古平や余市両町と仁木町、共和町の4町にまたがる計画地も古平、余市に絞り進める計画だ"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "ハイマツなどの自然林が広がる仁木町などを計画地から外した"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "関電によると、余市町内にある鳥獣保護区も外したという"@ja.
<< kg:id_8 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "計画の大幅な縮小を盛り込んだ"@ja.
<< kg:id_8 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "最大64基の風車をつくる計画を同18基と当初計画の約3分の1に縮小する方針だ"@ja.
<< kg:id_8 prop:countermeasure kg:id_13 >>
    prop:text-txt_contents "当初計画していた発電出力最大26万8800キロワットを同7万5600キロワットに縮小する方針だ"@ja.
<< kg:id_8 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "古平や余市両町と仁木町、共和町の4町にまたがる計画地も古平、余市に絞り進める計画だ"@ja.
<< kg:id_8 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "関電は今回の見直しで計画地から外れた仁木町については、今後別の事業として実現の可能性を引き続き探るとしている"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:text-txt_contents "脱炭素社会の実現に向けて再生可能エネルギー熱が高まっているのを背景に全国各地で風力発電所の建設が進む"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:text-txt_contents "脱炭素社会の実現に向けて再生可能エネルギー熱が高まっているのを背景に全国各地で風力発電所の建設が進む"@ja.
<< kg:id_8 prop:effect kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地元の同意を得られず計画を撤回するなど「逆風」も強まる"@ja.
<< kg:id_8 prop:effect kg:id_20 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "北海道内では総合商社の双日（東京都）が今年6月、関電の計画地と同じ後志地方にある小樽市と余市町にまたがる山間地で計画していた事業の中止を発表した"@ja.
