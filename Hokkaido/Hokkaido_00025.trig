kg:st_1 rdfs:label "住民"@ja.
kg:st_1 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "関電側の説明は信用できない"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "環境省"@ja.
kg:st_2 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_2 prop:content "事業区域を絞り込み地元の理解を得るよう求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "関西電力"@ja.
kg:st_3 rdfs:type cls:st_198.
cls:st_198 rdfs:label "電力事業者"@ja.
kg:op_3 prop:content "再生可能エネルギーを増やすため風力発電が必要だと強調する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "風力発電の意義を強調する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "日本自然保護協会など"@ja.
kg:st_4 rdfs:type cls:st_148.
cls:st_148 rdfs:label "自然保護団体"@ja.
kg:op_5 prop:content "事業の中止や抜本的な見直しを求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:st_5 rdfs:label "指摘した関係者"@ja.
kg:st_5 rdfs:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_6 prop:content "国立公園の景観を損ねると指摘する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_5.
kg:st_6 rdfs:label "住民有志でつくる「仁木町の風力発電を考える会」の穂積豊仁代表"@ja.
kg:st_6 rdfs:type cls:st_164.
cls:st_164 rdfs:label "住民代表"@ja.
kg:op_7 prop:content "表面的な回答ばかりで関電は信用できないと批判する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_6.
kg:op_8 prop:content "計画地と風車数を縮小する方針を示す"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "事業区域を絞り込み地元の理解を得るよう求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "当初計画の3分の1ほどに縮小すると発表する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "国内で例が少ない大規模事業として地元の理解を得るよう求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "事業の中止を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "抜本的な見直しを求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "銀山地区での事業可能性をゼロベースで検討すると答える"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "銀山エリアにつくらないでほしい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "2050年に事業活動に伴うCO2排出ゼロをめざす"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "再生可能エネルギー開発目標を掲げる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "地元などに反対の声が根強く、関電は計画を大幅に縮小する方針だ。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "環境省も「国内で例が少ない大規模な事業」（環境相の意見書）として事業区域を絞り込み、地元の理解を得るように求めていた。慎重な対応を求める意見が強まる中、関電は11月21日、4町に広がっていた計画地を古平、余市の2町の約1400ヘクタールに絞り、最大出力約7万5600キロワット、風車の数も最大18基と当初の3分の1ほどに縮小する、と発表した。"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "関電側は計画の概要を説明し、「地球温暖化は異常気象をもたらす。二酸化炭素（CO2）を減らすには再生可能エネルギーを増やす必要がある」と風力発電の意義を強調。"@ja.
<< kg:id_4 prop:cause kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "関電側は計画の概要を説明し、「地球温暖化は異常気象をもたらす。二酸化炭素（CO2）を減らすには再生可能エネルギーを増やす必要がある」と風力発電の意義を強調。"@ja.
<< kg:id_4 prop:effect kg:id_7 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "だが、想定区域内には保安林や手つかずの自然が残る山林が含まれ、日本自然保護協会などが事業の中止や抜本的な見直しを求めていた。"@ja.
<< kg:id_4 prop:effect kg:id_8 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "そのうち伊達市や千歳市などで検討していた事業は、区域内にある国立公園の景観を損ねるとの指摘を受けて最終的には断念に追い込まれている。"@ja.
<< kg:id_4 prop:effect kg:id_9 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "関電側の説明に「信用できない」などと厳しい声が相次いだ。"@ja.
<< kg:id_4 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "地元などに反対の声が根強く、関電は計画を大幅に縮小する方針だ。"@ja.
<< kg:id_4 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "関電は11月21日、4町に広がっていた計画地を古平、余市の2町の約1400ヘクタールに絞り、最大出力約7万5600キロワット、風車の数も最大18基と当初の3分の1ほどに縮小する、と発表した。"@ja.
<< kg:id_4 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "関電は11月21日、4町に広がっていた計画地を古平、余市の2町の約1400ヘクタールに絞り、最大出力約7万5600キロワット、風車の数も最大18基と当初の3分の1ほどに縮小する、と発表した。"@ja.
<< kg:id_4 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "環境省も「国内で例が少ない大規模な事業」（環境相の意見書）として事業区域を絞り込み、地元の理解を得るように求めていた。"@ja.
<< kg:id_4 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "日本自然保護協会などが事業の中止や抜本的な見直しを求めていた。"@ja.
<< kg:id_4 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "日本自然保護協会などが事業の中止や抜本的な見直しを求めていた。"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "「銀山エリアにつくらないでほしい」という声が住民から出たが、関電は「ゼロベースで検討する」と答えるにとどまったという。"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "「銀山エリアにつくらないでほしい」という声が住民から出た"@ja.
<< kg:id_19 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "脱炭素社会に向け、関電は2050年に事業活動に伴うCO2の排出ゼロをめざし、40年までに500万キロワットの再生可能エネルギーを新たに開発する目標を掲げている。"@ja.
<< kg:id_19 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "脱炭素社会に向け、関電は2050年に事業活動に伴うCO2の排出ゼロをめざし、40年までに500万キロワットの再生可能エネルギーを新たに開発する目標を掲げている。"@ja.
