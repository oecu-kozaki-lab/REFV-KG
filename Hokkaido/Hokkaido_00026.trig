PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00026> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "広範囲の停電"@ja.
kg:id_1 rdf:type cls:c_13239.
cls:c_13239 rdfs:label "停電"@ja.
kg:id_2 rdfs:label "地震や台風"@ja.
kg:id_2 rdf:type cls:c_261.
cls:c_261 rdfs:label "自然災害"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "マイクログリッドの仕組みの構築"@ja.
kg:id_3 rdf:type cls:c_14554.
cls:c_14554 rdfs:label "電力網整備"@ja.
kg:id_4 rdfs:label "18年の胆振東部地震後の全域停電（ブラックアウト）"@ja.
kg:id_4 rdf:type cls:c_14555.
cls:c_14555 rdfs:label "大規模停電"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "松前のマイクログリッド運用"@ja.
kg:id_5 rdf:type cls:c_14556.
cls:c_14556 rdfs:label "電力網運用"@ja.
kg:id_6 rdfs:label "停電時に地域の再生可能エネルギーを地域で使う"@ja.
kg:id_6 rdf:type cls:c_14557.
cls:c_14557 rdfs:label "地域内電力利用"@ja.
kg:id_5 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "東急不動産の風力発電設備と北海道電力ネットワークの送配電網を活用"@ja.
kg:id_7 rdf:type cls:c_14558.
cls:c_14558 rdfs:label "発電設備活用"@ja.
kg:id_5 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "町役場や避難場所となる町民総合センター、一般家庭の一部に電力を供給"@ja.
kg:id_8 rdf:type cls:c_12161.
cls:c_12161 rdfs:label "電力供給"@ja.
kg:id_5 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "避難場所などへの電力供給が必要になる"@ja.
kg:id_9 rdf:type cls:c_14559.
cls:c_14559 rdfs:label "電力供給需要"@ja.
kg:id_1 prop:effect kg:id_9.
kg:id_10 rdfs:label "周辺で起きた停電の影響が及ぶ"@ja.
kg:id_10 rdf:type cls:c_14560.
cls:c_14560 rdfs:label "停電影響"@ja.
kg:id_1 prop:effect kg:id_10.
kg:id_11 rdfs:label "独立ネットワークとして約48時間続けて電力供給できる"@ja.
kg:id_11 rdf:type cls:c_14561.
cls:c_14561 rdfs:label "継続的電力供給"@ja.
kg:id_5 prop:effect kg:id_11.
kg:id_12 rdfs:label "非常時を想定した切り替え訓練を行う"@ja.
kg:id_12 rdf:type cls:c_14562.
cls:c_14562 rdfs:label "切替訓練"@ja.
kg:id_5 prop:countermeasure kg:id_12.
kg:st_1 rdfs:label "北海道電力"@ja.
kg:st_1 rdf:type cls:st_198.
cls:st_198 rdfs:label "電力事業者"@ja.
kg:op_1 prop:content "動作試験やシミュレーションで平時と同じ電力品質を維持できることを確認"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "地震や台風などで広範囲に停電した場合"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "18年の胆振東部地震後の全域停電（ブラックアウト）を踏まえ、町や北電ネットなどと共同でマイクログリッドの仕組みを構築した"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "停電時に地域の再生可能エネルギーを地域で使う小規模送電網（マイクログリッド）の運用が始まった"@ja.
<< kg:id_5 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "東急不動産（東京）の風力発電設備と北海道電力ネットワークの送配電網を活用し"@ja.
<< kg:id_5 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "町役場や避難場所となる町民総合センター、一般家庭の一部に電力を供給する"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:text-txt_contents "災害時に避難場所などに電力供給"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:text-txt_contents "周辺で起きた停電の影響を回避"@ja.
<< kg:id_5 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "独立ネットワークとして約48時間続けて電力供給できる。北電によると、動作試験やシミュレーションで周波数など平時と同じ電力品質を維持できることを確認済み"@ja.
<< kg:id_5 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "今後は非常時を想定した切り替え訓練などを行う"@ja.
}
