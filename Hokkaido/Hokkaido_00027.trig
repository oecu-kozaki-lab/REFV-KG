PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00027> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "太陽光発電所の建設が相次いでいる問題"@ja.
kg:id_1 rdf:type cls:c_14563.
cls:c_14563 rdfs:label "開発問題"@ja.
kg:id_2 rdfs:label "希少種生息地などで太陽光発電所の建設が相次いでいること"@ja.
kg:id_2 rdf:type cls:c_14564.
cls:c_14564 rdfs:label "太陽光発電所建設"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "事業者による乱開発"@ja.
kg:id_3 rdf:type cls:c_14565.
cls:c_14565 rdfs:label "乱開発"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "希少種生息地への影響"@ja.
kg:id_4 rdf:type cls:c_13180.
cls:c_13180 rdfs:label "生息地影響"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "開発に歯止めがかかっていない"@ja.
kg:id_5 rdf:type cls:c_14566.
cls:c_14566 rdfs:label "開発継続"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "釧路市"@ja.
kg:id_6 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_7 rdfs:label "太陽光発電所建設を規制する条例の制定"@ja.
kg:id_7 rdf:type cls:c_14567.
cls:c_14567 rdfs:label "規制条例"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "建設を規制するガイドラインの運用"@ja.
kg:id_8 rdf:type cls:c_14568.
cls:c_14568 rdfs:label "規制指針"@ja.
kg:id_6 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "事業者に環境調査や建設計画の提出を要請する指針"@ja.
kg:id_9 rdf:type cls:c_14569.
cls:c_14569 rdfs:label "提出要請"@ja.
kg:id_6 prop:countermeasure kg:id_9.
kg:st_1 rdfs:label "蝦名大也市長"@ja.
kg:st_1 rdf:type cls:st_199.
cls:st_199 rdfs:label "自治体代表"@ja.
kg:op_1 prop:content "市の指針は一定の効果があったが開発は止まっていない"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "年度内にも条例制定する方針を示した"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "市の指針は一定の効果があったと強調"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "環境調査や建設計画の提出を求める指針に一定の効果があった"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "釧路市内の希少種生息地などで太陽光発電所の建設が相次いでいる問題"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "事業者による乱開発が問題視されていた"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "釧路市内の希少種生息地などで太陽光発電所の建設が相次いでいる問題"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "指針運用開始後の今年1月、市新野の民有地で新たに大規模太陽光発電所が着工されるなど、開発に歯止めがかかっていない"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "市は2日、太陽光発電所建設を規制する条例を年度内にも制定する方針を示した"@ja.
<< kg:id_6 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市は建設を規制するガイドライン（指針）を昨年7月から運用している"@ja.
<< kg:id_6 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事業者に環境調査や建設計画の提出を要請する市の指針について「一定の効果があった」と強調した"@ja.
}
