PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00028> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "太陽光事業"@ja.
kg:id_1 rdf:type cls:c_14570.
cls:c_14570 rdfs:label "太陽光発電事業"@ja.
kg:id_2 rdfs:label "市有林伐採計画"@ja.
kg:id_2 rdf:type cls:c_14571.
cls:c_14571 rdfs:label "森林伐採計画"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "市有林の伐採"@ja.
kg:id_3 rdf:type cls:c_13215.
cls:c_13215 rdfs:label "森林伐採"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "釧路市長の回答"@ja.
kg:id_4 rdf:type cls:c_14572.
cls:c_14572 rdfs:label "行政回答"@ja.
kg:id_5 rdfs:label "質問書への回答"@ja.
kg:id_5 rdf:type cls:c_14573.
cls:c_14573 rdfs:label "質問回答"@ja.
kg:id_4 prop:contermeasure kg:id_5.
kg:st_1 rdfs:label "市民団体「ノーモアメガソーラー宣言」"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "市有林伐採を伴う計画の経緯説明を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "森林が失われる影響を懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市民団体「ノーモアメガソーラー宣言」など"@ja.
kg:st_2 rdfs:type cls:st_73.
kg:op_3 prop:content "公開質問書に対する明確な回答を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "市有林伐採を巡り、市民団体「ノーモアメガソーラー宣言」などは"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "太陽光事業で市有林伐採"@ja.
<< kg:id_4 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市民団体　釧路市長へ回答求め　太陽光事業で質問書"@ja.
}
