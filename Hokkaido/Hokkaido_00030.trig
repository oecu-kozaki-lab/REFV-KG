PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00030> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "東急不動産の松前事務所「テノハ松前」の開所"@ja.
kg:id_1 rdf:type cls:c_8407.
cls:c_8407 rdfs:label "施設開設"@ja.
kg:id_2 rdfs:label "町民や観光客も使えるコワーキングスペースなどを備える"@ja.
kg:id_2 rdf:type cls:c_4024.
cls:c_4024 rdfs:label "交流施設"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "町民や観光客の交流の場になる"@ja.
kg:id_3 rdf:type cls:c_14585.
cls:c_14585 rdfs:label "交流の場"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "地域活性化やまちづくりにつながる"@ja.
kg:id_4 rdf:type cls:c_1287.
cls:c_1287 rdfs:label "地域活性化"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "バス待合所を設ける"@ja.
kg:id_5 rdf:type cls:c_14586.
cls:c_14586 rdfs:label "待合施設"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "町民無料のコワーキングスペースを設ける"@ja.
kg:id_6 rdf:type cls:c_4024.
kg:id_1 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "松前産の道南スギを多用する"@ja.
kg:id_7 rdf:type cls:c_4930.
cls:c_4930 rdfs:label "地域材活用"@ja.
kg:id_1 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "城下町にちなみ外観を白壁と黒い屋根にする"@ja.
kg:id_8 rdf:type cls:c_14587.
cls:c_14587 rdfs:label "景観設計"@ja.
kg:id_1 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "松城小の児童の手形によるサクラの絵画を設置する"@ja.
kg:id_9 rdf:type cls:c_10879.
cls:c_10879 rdfs:label "展示設置"@ja.
kg:id_1 prop:contermeasure kg:id_9.
kg:st_1 rdfs:label "東急不動産の星野浩明社長"@ja.
kg:st_1 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "地域活性化やまちづくりに町と連携して取り組みたい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "若佐智弘町長"@ja.
kg:st_2 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_2 prop:content "新たな交流の場として町民に長く親しまれてほしい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "新たな交流の場として期待する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "松前の新しい顔になることを期待する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "町民や観光客も使えるコワーキングスペースなどを備えた新たな松前事務所「テノハ松前」"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "新たな交流の場。町民に長く親しまれる施設になってほしい"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "地域活性化やまちづくりに、町と二人三脚で取り組む。松前の新しい顔になってほしい"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "バス待合所、有料（町民は無料）で利用できるコワーキングスペースなどがある"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "有料（町民は無料）で利用できるコワーキングスペースなどがある"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:text-txt_contents "松前産の道南スギを多用している"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:text-txt_contents "城下町にちなみ、外観は白壁と黒い屋根とした"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "松城小の児童が手のひらにピンクの絵の具を塗り、手形でサクラの花を表現した縦横約2.5メートルの絵画なども設置した"@ja.
}
