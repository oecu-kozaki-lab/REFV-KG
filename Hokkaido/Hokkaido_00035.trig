PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00035> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "デジタルマップ制作"@ja.
kg:id_1 rdf:type cls:c_1423.
cls:c_1423 rdfs:label "観光振興"@ja.
kg:id_2 rdfs:label "サクラ以外の観光スポットに注目してもらいたいこと"@ja.
kg:id_2 rdf:type cls:c_5236.
cls:c_5236 rdfs:label "観光誘導"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "松前の観光スポットや店の情報をスマホなどで見られるデジタルマップを制作すること"@ja.
kg:id_3 rdf:type cls:c_14627.
cls:c_14627 rdfs:label "観光情報"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "紙に印刷した地図3千部を配布し来場者に閲覧や活用を呼びかけること"@ja.
kg:id_4 rdf:type cls:c_176.
cls:c_176 rdfs:label "情報提供"@ja.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "飲食店を取材しお薦めポイントを記すこと"@ja.
kg:id_5 rdf:type cls:c_14628.
cls:c_14628 rdfs:label "店舗情報"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "サクラの開花時期にリアルタイムで開花状況が分かる機能を盛り込むこと"@ja.
kg:id_6 rdf:type cls:c_14629.
cls:c_14629 rdfs:label "開花情報"@ja.
kg:id_1 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "掲載場所を追加すること"@ja.
kg:id_7 rdf:type cls:c_14630.
cls:c_14630 rdfs:label "情報拡充"@ja.
kg:id_1 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "観光客が情報を閲覧できること"@ja.
kg:id_8 rdf:type cls:c_14631.
cls:c_14631 rdfs:label "情報閲覧"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "地元の人にも楽しんで見てもらえること"@ja.
kg:id_9 rdf:type cls:c_12162.
cls:c_12162 rdfs:label "地域利用"@ja.
kg:id_1 prop:effect kg:id_9.
kg:id_10 rdfs:label "今後は北海道まつまえ観光物産協会のホームページなどからも見られる予定であること"@ja.
kg:id_10 rdf:type cls:c_11.
cls:c_11 rdfs:label "情報公開"@ja.
kg:id_1 prop:effect kg:id_10.
kg:st_1 rdfs:label "松前高2年の石戸珀さん"@ja.
kg:st_1 rdfs:type cls:st_23.
cls:st_23 rdfs:label "学生"@ja.
kg:op_1 prop:content "地図に一言でお薦めポイントを入れた点にこだわった"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "札大2年の横田紗々奈さん"@ja.
kg:st_2 rdfs:type cls:st_23.
kg:op_2 prop:content "情報を多く盛り込み観光客だけでなく地元の人にも楽しんで見てもらいたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "地図に一言でお薦めポイントを入れた点にこだわった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "観光客に楽しんで見てもらいたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "地元の人にも楽しんで見てもらいたい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "サクラ以外の観光スポットに注目してもらいたいと、町や、町内で陸上風力発電事業を手がける「東急不動産」（東京）が協力して企画。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "松前高校生と札幌大学の学生が協力して、松前の観光スポットや店の情報をスマホなどで見られる「デジタルマップ」を制作した。"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:text-txt_contents "22日に「松前城下マグロまつり」の会場で、紙に印刷した地図3千部を配布し、来場者に閲覧や活用を呼びかけた。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "生徒らが飲食店を取材し、お薦めポイントを執筆した。"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "サクラの開花時期には、リアルタイムで開花状況が分かる機能も盛り込んでいる。"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:text-txt_contents "掲載場所の追加も予定している。"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "松前の観光スポットや店の情報をスマホなどで見られる「デジタルマップ」を制作した。"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "札大2年の横田紗々奈さん（19）は「情報をたくさん盛り込んだので観光客にはもちろん、地元の人にも楽しんで見てもらえたら」としている。"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:text-txt_contents "デジタルマップはサイトから閲覧できるほか、今後は北海道まつまえ観光物産協会のホームページなどからも見られる予定。"@ja.
}
