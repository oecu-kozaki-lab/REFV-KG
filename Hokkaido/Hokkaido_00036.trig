PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00036> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "松前沖の洋上風力発電事業"@ja.
kg:id_1 rdf:type cls:c_3025.
cls:c_3025 rdfs:label "洋上風力発電事業"@ja.
kg:id_2 rdfs:label "VRで景観を疑似体験できる専用サイトの開設"@ja.
kg:id_2 rdf:type cls:c_14632.
cls:c_14632 rdfs:label "景観確認手段"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "風車が並んだ景観が見える"@ja.
kg:id_3 rdf:type cls:c_380.
cls:c_380 rdfs:label "景観変化"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "風車の影の動きが分かる"@ja.
kg:id_4 rdf:type cls:c_14633.
cls:c_14633 rdfs:label "影の変化"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "館浜と清部、原口3地区の陸上から風車が見える"@ja.
kg:id_5 rdf:type cls:c_380.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "町民の理解が深まる"@ja.
kg:id_6 rdf:type cls:c_4449.
cls:c_4449 rdfs:label "理解促進"@ja.
kg:id_1 prop:effect kg:id_6.
kg:st_1 rdfs:label "町脱炭素推進課"@ja.
kg:st_1 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_1 prop:content "建設前に想定景観を示して町民の理解を深めたい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "建設前に想定景観を示して町民の理解を深めたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "町は20日、風車が沖合に設置された際の景観を仮想現実（VR）で疑似体験できる専用サイトを町公式ホームページ（HP）に開設した"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "海面からの高さが最大250メートルほどと見込まれる風車が並んだ予想図"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "いずれも日の出～日の入りの太陽の動きに合わせた風車の影の動きが分かる"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "海域に面した館浜と清部、原口3地区の陸上から見た風車計21基を描いた"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "風車が建設される前に、想定される姿を見てもらうことで、町民の理解を深めたい"@ja.
}
