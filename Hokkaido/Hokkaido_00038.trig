 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "メガソーラー建設計画"@ja.
kg:id_1 rdf:type cls:c_12240.
cls:c_12240 rdfs:label "開発計画"@ja.
kg:id_2 rdfs:label "オジロワシの営巣地付近での建設が文化財保護法に抵触する可能性"@ja.
kg:id_2 rdf:type cls:c_14642.
cls:c_14642 rdfs:label "法令抵触可能性"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "ひなの生育に影響する可能性が高いこと"@ja.
kg:id_3 rdf:type cls:c_14643.
cls:c_14643 rdfs:label "生育影響可能性"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "営巣地から半径500メートル以内の開発で将来オジロワシが繁殖しなくなるとの指摘"@ja.
kg:id_4 rdf:type cls:c_14644.
cls:c_14644 rdfs:label "繁殖影響指摘"@ja.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "計画の縮小が必要"@ja.
kg:id_5 rdf:type cls:c_14535.
cls:c_14535 rdfs:label "計画縮小"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "昭和地区での建設断念"@ja.
kg:id_6 rdf:type cls:c_14645.
cls:c_14645 rdfs:label "建設断念"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "少なくとも5月下旬まで昭和地区の建設予定地に立ち入り不可"@ja.
kg:id_7 rdf:type cls:c_2438.
cls:c_2438 rdfs:label "立入制限"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "文化庁長官の許可を得られない可能性"@ja.
kg:id_8 rdf:type cls:c_14646.
cls:c_14646 rdfs:label "許可未取得可能性"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "将来にわたりオジロワシが繁殖しなくなる可能性"@ja.
kg:id_9 rdf:type cls:c_14647.
cls:c_14647 rdfs:label "繁殖停止可能性"@ja.
kg:id_1 prop:effect kg:id_9.
kg:id_10 rdfs:label "オジロワシ営巣地付近での建設断念"@ja.
kg:id_10 rdf:type cls:c_14645.
kg:id_1 prop:contermeasure kg:id_10.
kg:id_11 rdfs:label "少なくとも5月下旬まで昭和地区の建設予定地に立ち入らない"@ja.
kg:id_11 rdf:type cls:c_2438.
kg:id_1 prop:contermeasure kg:id_11.
kg:id_12 rdfs:label "文化庁長官の許可を受ける"@ja.
kg:id_12 rdf:type cls:c_7703.
cls:c_7703 rdfs:label "許可取得"@ja.
kg:id_1 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "残りの土地で5～6月に着工する"@ja.
kg:id_13 rdf:type cls:c_14648.
cls:c_14648 rdfs:label "着工"@ja.
kg:id_1 prop:contermeasure kg:id_13.
kg:st_1 rdfs:label "自然保護関係者"@ja.
kg:st_1 rdfs:type cls:st_203.
cls:st_203 rdfs:label "保護関係者"@ja.
kg:op_1 prop:content "営巣地から半径500メートル以内の開発は将来の繁殖に悪影響を及ぼすと指摘"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市教育委員会"@ja.
kg:st_2 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_2 prop:content "ひなの生育への影響を避けるため5月下旬まで立ち入りを控えるよう通告"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "営巣地近くの開発は将来の繁殖停止につながると懸念"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_3 rdfs:label "大阪市の事業者"@ja.
kg:st_3 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_4 prop:content "希少生物保護と法令順守のため営巣地付近の建設を断念"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "文化財保護法に基づき立ち入りを控えるよう求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_4 rdfs:label "事業者"@ja.
kg:st_4 rdfs:type cls:st_1.
kg:op_6 prop:content "希少生物を守りつつ残る土地で着工したい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "オジロワシの巣の近くでの発電所建設が文化財保護法に抵触する可能性が指摘されており、計画の縮小が必要と判断した。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "市教育委員会は3月21日、ひなの生育に影響する可能性が高いとして文化財保護法に基づき、少なくとも5月下旬までは昭和地区の建設予定地に立ち入らないように事業者にメールで通告した。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "自然保護関係者は「営巣地から半径500メートル以内を開発すれば、将来にわたりオジロワシが繁殖しなくなる」と指摘しており、このままでは許可を得られないと判断した。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "オジロワシの巣の近くでの発電所建設が文化財保護法に抵触する可能性が指摘されており、計画の縮小が必要と判断した。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "このうち、5メートルほど離れた地点にオジロワシの巣があるとしていた昭和地区（約2.5ヘクタール）での建設を断念する方向。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "市教育委員会は3月21日、ひなの生育に影響する可能性が高いとして文化財保護法に基づき、少なくとも5月下旬までは昭和地区の建設予定地に立ち入らないように事業者にメールで通告した。"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:text-txt_contents "自然保護関係者は「営巣地から半径500メートル以内を開発すれば、将来にわたりオジロワシが繁殖しなくなる」と指摘しており、このままでは許可を得られないと判断した。"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "自然保護関係者は「営巣地から半径500メートル以内を開発すれば、将来にわたりオジロワシが繁殖しなくなる」と指摘しており、このままでは許可を得られないと判断した。"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "大阪市の事業者は2日、国の天然記念物オジロワシの営巣地付近での建設を断念する方針を釧路市に伝えた。"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "市教育委員会は3月21日、ひなの生育に影響する可能性が高いとして文化財保護法に基づき、少なくとも5月下旬までは昭和地区の建設予定地に立ち入らないように事業者にメールで通告した。"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "同法は、国の天然記念物の保存に影響を及ぼす行為をしようとする際、文化庁長官の許可を受けなければならないと規定。"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業者は取材に対し、「希少生物を守るのは社の方針であり、法律を犯すことはできない。残りの土地は5～6月には着工したい」としている。"@ja.
}
