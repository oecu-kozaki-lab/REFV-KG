PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00039> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "大規模太陽光発電所の建設計画"@ja.
kg:id_1 rdf:type cls:c_8845.
cls:c_8845 rdfs:label "建設計画"@ja.
kg:id_2 rdfs:label "大阪市の事業者が市昭和と北園の2地区の市街化調整区域に発電所の建設を予定"@ja.
kg:id_2 rdf:type cls:c_14649.
cls:c_14649 rdfs:label "発電所建設"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "オジロワシの営巣地への影響"@ja.
kg:id_3 rdf:type cls:c_14650.
cls:c_14650 rdfs:label "生物生息地"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "タンチョウの子育てへの影響"@ja.
kg:id_4 rdf:type cls:c_14651.
cls:c_14651 rdfs:label "生物保護"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "工事規制"@ja.
kg:id_5 rdf:type cls:c_14652.
cls:c_14652 rdfs:label "工事規制"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "事業者に住民説明会を引き続き開催するよう指導"@ja.
kg:id_6 rdf:type cls:c_87.
cls:c_87 rdfs:label "住民説明"@ja.
kg:id_1 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "メガソーラーを規制する立法措置"@ja.
kg:id_7 rdf:type cls:c_14653.
cls:c_14653 rdfs:label "立法措置"@ja.
kg:id_1 prop:countermeasure kg:id_7.
kg:st_1 rdfs:label "釧路市議会の日本共産党議員団"@ja.
kg:st_1 rdf:type cls:st_204.
cls:st_204 rdfs:label "議員団"@ja.
kg:op_1 prop:content "オジロワシの子育てを守る必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "タンチョウの子育てを守る必要がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "工事規制を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "事業者に住民説明会の継続開催を指導するよう求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "メガソーラーを規制する立法措置を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "環境省釧路自然環境事務所の岡野隆宏所長"@ja.
kg:st_2 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_6 prop:content "地域の懸念は承知し思いは共有しているが国の法律でできることとできないことがある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "計画では、大阪市の事業者が市昭和と北園の2地区の市街化調整区域に発電所の建設を予定。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "昭和地区の一部予定地付近には、国の天然記念物のオジロワシの営巣地があることが分かっている。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "オジロワシやタンチョウの子育てを守るための工事規制をはじめ"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "釧路湿原国立公園周辺での大規模太陽光発電所（メガソーラー）の建設計画を巡り、釧路市議会の日本共産党議員団（村上和繁団長）は9日、工事規制などを訴える要望書を環境省釧路自然環境事務所に提出した。"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事業者に住民説明会を引き続き開催するよう指導することや"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "メガソーラーを規制する立法措置を講じるよう訴える要望書を、村上団長が同事務所の岡野隆宏所長に手渡した。岡野所長は「地域の皆さまも非常に懸念をもたれていることを承知している。国の法律でできることとできないことがある。思いは共有している」と述べた。"@ja.
}
