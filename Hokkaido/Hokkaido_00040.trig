PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00040> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "オジロワシへの影響"@ja.
kg:id_1 rdf:type cls:c_14654.
cls:c_14654 rdfs:label "野生動物への影響"@ja.
kg:id_2 rdfs:label "営巣地近くの開発"@ja.
kg:id_2 rdf:type cls:c_13188.
cls:c_13188 rdfs:label "土地開発"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "親鳥が驚いていなくなりヒナがふ化できなくなる"@ja.
kg:id_3 rdf:type cls:c_14503.
cls:c_14503 rdfs:label "繁殖阻害"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "ヒナが太陽光パネルの下に入ればエサを得られず死ぬ可能性がある"@ja.
kg:id_4 rdf:type cls:c_14655.
cls:c_14655 rdfs:label "ひなの死亡"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "オジロワシ保護"@ja.
kg:id_5 rdf:type cls:c_14656.
cls:c_14656 rdfs:label "野生動物保護"@ja.
kg:id_6 rdfs:label "建設予定地への立ち入り禁止"@ja.
kg:id_6 rdf:type cls:c_11303.
cls:c_11303 rdfs:label "立入禁止"@ja.
kg:id_5 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "営巣地付近での建設を断念"@ja.
kg:id_7 rdf:type cls:c_14657.
cls:c_14657 rdfs:label "建設中止"@ja.
kg:id_5 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "メガソーラー建設計画"@ja.
kg:id_8 rdf:type cls:c_12240.
cls:c_12240 rdfs:label "開発計画"@ja.
kg:id_9 rdfs:label "計画を即中止"@ja.
kg:id_9 rdf:type cls:c_13085.
cls:c_13085 rdfs:label "計画中止"@ja.
kg:id_8 prop:contermeasure kg:id_9.
kg:st_1 rdfs:label "猛禽類医学研究所（釧路市）の斉藤慶輔代表"@ja.
kg:st_1 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_1 prop:content "巣の近くの開発は親鳥を驚かせひなの生存に影響すると説明"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "開発で親鳥が離れればひながふ化できなくなると懸念"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "ふ化後も太陽光パネル下ではひなが餌を得られず死亡する可能性を指摘"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "大阪市の事業者"@ja.
kg:st_2 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_4 prop:content "営巣地付近での建設を断念する方針"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "大越拓也市議（創志会）"@ja.
kg:st_3 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_5 prop:content "希少種がいるところは計画を即中止すべきだ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "斉藤代表によると、巣の近くを開発すると親鳥が驚いていなくなりヒナがふ化できなくなる"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "斉藤代表によると、巣の近くを開発すると親鳥が驚いていなくなりヒナがふ化できなくなる"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "ふ化できたとしてもヒナが太陽光パネルの下に入ればエサを得られず死ぬ可能性があるという"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "市教委は文化財保護法に基づき5月下旬まで、建設予定地への立ち入り禁止を大阪市の事業者に通告"@ja.
<< kg:id_5 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事業者は営巣地付近での建設を断念する方針"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "大越拓也市議（創志会）は「身近な場所に巣があって驚いた。希少種がいるところは計画を即中止すべきだ」と述べた"@ja.
}
