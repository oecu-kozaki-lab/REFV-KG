PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00041> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "自然環境全般の保全に関する条例制定"@ja.
kg:id_1 rdf:type cls:c_1684.
cls:c_1684 rdfs:label "条例制定"@ja.
kg:id_2 rdfs:label "太陽光発電所の規制のため制定を進めている条例で対応できないケースに備える必要"@ja.
kg:id_2 rdf:type cls:c_8915.
cls:c_8915 rdfs:label "対応困難"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "太陽光発電所"@ja.
kg:id_3 rdf:type cls:c_567.
cls:c_567 rdfs:label "発電施設"@ja.
kg:id_4 rdfs:label "規制"@ja.
kg:id_4 rdf:type cls:c_14658.
cls:c_14658 rdfs:label "規制"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "自然環境全般"@ja.
kg:id_5 rdf:type cls:c_211.
cls:c_211 rdfs:label "自然環境"@ja.
kg:id_6 rdfs:label "保全に関する条例制定"@ja.
kg:id_6 rdf:type cls:c_1684.
kg:id_5 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "自然環境保全"@ja.
kg:id_7 rdf:type cls:c_211.
kg:id_8 rdfs:label "専門家や地域の保護団体などとの折衝"@ja.
kg:id_8 rdf:type cls:c_6491.
cls:c_6491 rdfs:label "関係者協議"@ja.
kg:id_7 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "自然を守る意識醸成"@ja.
kg:id_9 rdf:type cls:c_4632.
cls:c_4632 rdfs:label "意識醸成"@ja.
kg:id_7 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "放射性物質"@ja.
kg:id_10 rdf:type cls:c_111.
cls:c_111 rdfs:label "有害物質"@ja.
kg:id_11 rdfs:label "建物の汚染"@ja.
kg:id_11 rdf:type cls:c_14659.
cls:c_14659 rdfs:label "建物汚染"@ja.
kg:id_10 prop:effect kg:id_11.
kg:st_1 rdfs:label "釧路市"@ja.
kg:st_1 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "対応できないケースに備え自然環境全般を保全する別条例を制定する方針"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "篠崎さえか主幹"@ja.
kg:st_2 rdf:type cls:st_47.
cls:st_47 rdfs:label "行政職"@ja.
kg:op_2 prop:content "自然と共生できるよう地域とともに自然を守る意識醸成を図りたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "自然と共生できるよう地域とともに自然を守る意識醸成を図りたい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "釧路市は、太陽光発電所の規制のため制定を進めている条例で対応できないケースに備えて、自然環境全般を保全する別の条例も制定する方針で"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "環境省とのパイプを生かし、太陽光発電所の規制のほか自然環境全般の保全に関する条例制定に向けて関係者と連携する"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "環境省とのパイプを生かし、太陽光発電所の規制のほか自然環境全般の保全に関する条例制定に向けて関係者と連携する"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "釧路市では自然環境保全に向けて専門家や地域の保護団体などとの「折衝役」となり"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "「自然と人との距離の近さもほかにない。自然と共生できるよう、地域の方とともに自然を守る意識醸成を図りたい」と話す"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:text-txt_contents "放射性物質で汚染された建物の解体などに関わった"@ja.
}
