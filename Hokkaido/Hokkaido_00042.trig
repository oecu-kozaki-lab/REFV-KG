PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00042> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "メガソーラー建設計画"@ja.
kg:id_1 rdf:type cls:c_12240.
cls:c_12240 rdfs:label "開発計画"@ja.
kg:id_2 rdfs:label "予定地の半径約500メートル圏内で国の天然記念物オジロワシが営巣"@ja.
kg:id_2 rdf:type cls:c_14660.
cls:c_14660 rdfs:label "希少動物の営巣"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "ひなの成育に影響する恐れ"@ja.
kg:id_3 rdf:type cls:c_14661.
cls:c_14661 rdfs:label "生育影響"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "釧路市教育委員会"@ja.
kg:id_4 rdf:type cls:c_891.
cls:c_891 rdfs:label "行政機関"@ja.
kg:id_5 rdfs:label "市昭和地区の建設予定地への立ち入り禁止を新たに通告"@ja.
kg:id_5 rdf:type cls:c_11303.
cls:c_11303 rdfs:label "立入禁止"@ja.
kg:id_4 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "同地区の別の予定地への立ち入り禁止を通告"@ja.
kg:id_6 rdf:type cls:c_11303.
kg:id_4 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "希少動物保護へ対応を強化"@ja.
kg:id_7 rdf:type cls:c_9831.
cls:c_9831 rdfs:label "保護強化"@ja.
kg:id_4 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "9月末まで立ち入り禁止"@ja.
kg:id_8 rdf:type cls:c_11303.
kg:id_4 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "昭和地区の予定地の建設を断念する方針"@ja.
kg:id_9 rdf:type cls:c_14662.
cls:c_14662 rdfs:label "計画断念"@ja.
kg:id_1 prop:effect kg:id_9.
kg:id_10 rdfs:label "別の予定地にも再び通告"@ja.
kg:id_10 rdf:type cls:c_14663.
cls:c_14663 rdfs:label "通告"@ja.
kg:id_4 prop:contermeasure kg:id_10.
kg:id_11 rdfs:label "別の予定地の計画を中止するかは分からない"@ja.
kg:id_11 rdf:type cls:c_14664.
cls:c_14664 rdfs:label "計画中止の未定"@ja.
kg:id_1 prop:effect kg:id_11.
kg:st_1 rdfs:label "事業者"@ja.
kg:st_1 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "今回通告を受けた予定地は巣から500メートル圏外にもあり、計画中止は未定"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "予定地の半径約500メートル圏内で国の天然記念物オジロワシが営巣しており"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "ひなの成育に影響する恐れがあるため"@ja.
<< kg:id_4 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "釧路市教育委員会が文化財保護法に基づき、事業者に市昭和地区の建設予定地への立ち入り禁止を新たに通告した"@ja.
<< kg:id_4 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "3月にも同地区の別の予定地への立ち入り禁止を通告しており"@ja.
<< kg:id_4 prop:contermeasure kg:id_7 >>
    prop:text-txt_contents "希少動物保護へ対応を強化した"@ja.
<< kg:id_4 prop:contermeasure kg:id_8 >>
    prop:text-txt_contents "通告は17日にメールで行い、9月末まで立ち入り禁止とした"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:text-txt_contents "事業者は市教委による立ち入り禁止の通告を受け、建設を断念する方針"@ja.
<< kg:id_4 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "着工する意向を示していたことから再び通告に踏み切った"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業者は取材に「今回通告を受けた予定地は巣から500メートル圏外にもあり、計画を中止するかは分からない」としている"@ja.
}
