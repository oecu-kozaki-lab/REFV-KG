PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00045> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "松前沖で計画中の洋上風力発電事業"@ja.
kg:id_1 rdf:type cls:c_3025.
cls:c_3025 rdfs:label "洋上風力発電事業"@ja.
kg:id_2 rdfs:label "海の景観が変わる"@ja.
kg:id_2 rdf:type cls:c_380.
cls:c_380 rdfs:label "景観変化"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "町"@ja.
kg:id_3 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_4 rdfs:label "町内各所で住民説明会を行う"@ja.
kg:id_4 rdf:type cls:c_14681.
cls:c_14681 rdfs:label "住民説明会"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "風車設置後の景観を見られる仮想現実（VR）の使い方を説明する"@ja.
kg:id_5 rdf:type cls:c_14694.
cls:c_14694 rdfs:label "VR説明"@ja.
kg:id_3 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "地元の雇用が見込まれる可能性"@ja.
kg:id_6 rdf:type cls:c_14695.
cls:c_14695 rdfs:label "地元雇用"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "最大21基の風車が松前沖に立つ"@ja.
kg:id_7 rdf:type cls:c_134.
cls:c_134 rdfs:label "風車設置"@ja.
kg:id_1 prop:effect kg:id_7.
kg:st_1 rdfs:label "町民"@ja.
kg:st_1 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "海の景観が変わることに不安や懸念を持つ"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町民3人ら参加者"@ja.
kg:st_2 rdf:type cls:st_5.
kg:op_2 prop:content "洋上風力発電事業による地元雇用の見込みや風車事業者数について質問する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "町原口地区の説明会参加者"@ja.
kg:st_3 rdf:type cls:st_5.
kg:op_3 prop:content "地元の雇用が見込めるのか確認を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "最大21基の風車をすべて1社が事業するのか確認を求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "松前沖で計画中の洋上風力発電事業について、海の景観が変わるという不安や懸念の声に答えようと"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "町が町内各所で住民説明会を行っている"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:text-txt_contents "町が1月に作成した、風車設置後の景観を見られる仮想現実（VR）の使い方を、江良地区に近い清部地区の映像を確認しながら説明した"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "参加者から「洋上風力発電事業を行うことで、地元の雇用は見込めるのか」などの質問が上がった"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "「松前沖に立つとされる最大21基の風車は、すべて1社が事業を行うのか」などの質問が上がった"@ja.
}
