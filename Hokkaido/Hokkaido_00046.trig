  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "公共施設10カ所の電力の再生可能エネルギーへの切り替え"@ja.
kg:id_1 rdf:type cls:c_14696.
cls:c_14696 rdfs:label "再エネ電力導入"@ja.
kg:id_2 rdfs:label "町と東急不動産が4月に地域電力会社「松前再エネ電力」を設立"@ja.
kg:id_2 rdf:type cls:c_14697.
cls:c_14697 rdfs:label "地域電力会社設立"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "町内の太陽光発電の電力と市場の再エネ100％電力を調達"@ja.
kg:id_3 rdf:type cls:c_14698.
cls:c_14698 rdfs:label "再エネ電力調達"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "電気料金の削減を見込む"@ja.
kg:id_4 rdf:type cls:c_3836.
cls:c_3836 rdfs:label "電気料金削減"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "町の脱炭素推進の構想に大きく貢献できる"@ja.
kg:id_5 rdf:type cls:c_8120.
cls:c_8120 rdfs:label "脱炭素推進"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "風力発電による供給事業を円滑に進めるためのノウハウ習得につながる"@ja.
kg:id_6 rdf:type cls:c_14699.
cls:c_14699 rdfs:label "運営ノウハウ習得"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "町内の風力発電の電力供給構想の試金石となる"@ja.
kg:id_7 rdf:type cls:c_14700.
cls:c_14700 rdfs:label "電力供給構想"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "松前町"@ja.
kg:id_8 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_9 rdfs:label "役場庁舎など公共施設10カ所の電力をすべて再生可能エネルギーによる電力に切り替える"@ja.
kg:id_9 rdf:type cls:c_14696.
kg:id_8 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "年間使用電力量の約1割を町建石の太陽光発電施設から賄う"@ja.
kg:id_10 rdf:type cls:c_14701.
cls:c_14701 rdfs:label "太陽光発電活用"@ja.
kg:id_8 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "地域電力会社「松前再エネ電力」を通じて再エネ電力を購入する"@ja.
kg:id_11 rdf:type cls:c_14702.
cls:c_14702 rdfs:label "再エネ電力購入"@ja.
kg:id_8 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "将来は公共施設や一般家庭に町内の風力発電の電力を供給する構想を描く"@ja.
kg:id_12 rdf:type cls:c_14703.
cls:c_14703 rdfs:label "風力発電構想"@ja.
kg:id_8 prop:countermeasure kg:id_12.
kg:st_1 rdfs:label "松前再エネ電力社長 佐藤隆信"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "公共施設への100％再エネ電力供給は町の脱炭素推進に大きく貢献できる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "風力発電による供給事業を円滑に進めるためのノウハウを身につけたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "風力発電による供給事業を円滑に進めるためのノウハウを身につけたい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "町と東急不動産が4月に設立した地域電力会社「松前再エネ電力」が、取次業務を行い、今回が初事業。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "町内の太陽光発電の電力は東急不動産の子会社から、残りの9割は再エネ100％の電力を市場から、松前再エネ電力を通じて町が購入する。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "町は電気料金の削減を見込んでいる。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "100％再エネ発電の電力を公共施設に供給することで、町が掲げる脱炭素推進の構想に大きく貢献できる。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "風力発電による供給事業を円滑に進めるためのノウハウを身につけたい"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "今回の電力切り替えは、その試金石と位置づけている。"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "町は6月から、役場庁舎など公共施設10カ所の電力をすべて再生可能エネルギーによる電力に切り替える。"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "年間使用電力量のうち、約1割を東急不動産（東京）が町建石で太陽光発電している施設から賄う計画"@ja.
<< kg:id_8 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "松前再エネ電力を通じて町が購入する。"@ja.
<< kg:id_8 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "町は将来、公共施設や一般家庭に町内の風力発電の電力を供給する構想を描いており"@ja.
}
