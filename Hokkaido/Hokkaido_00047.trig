PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00047> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電施設の設置"@ja.
kg:id_1 rdf:type cls:c_535.
cls:c_535 rdfs:label "風力発電施設"@ja.
kg:id_2 rdfs:label "固定資産税収入額が17年間で9億7千万円くらいになる"@ja.
kg:id_2 rdf:type cls:c_3558.
cls:c_3558 rdfs:label "税収増加"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "固定資産税収入額の試算は事業期間17年間・発電機9基の仮定に基づく参考値になる"@ja.
kg:id_3 rdf:type cls:c_14704.
cls:c_14704 rdfs:label "試算値"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "発電機は最大18基として計画されている"@ja.
kg:id_4 rdf:type cls:c_13594.
cls:c_13594 rdfs:label "設備計画"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "物価高騰"@ja.
kg:id_5 rdf:type cls:c_757.
cls:c_757 rdfs:label "物価高騰"@ja.
kg:id_6 rdfs:label "全世帯に2千円分のお米クーポン券を配布する"@ja.
kg:id_6 rdf:type cls:c_1217.
cls:c_1217 rdfs:label "生活支援"@ja.
kg:id_5 prop:contermeasure kg:id_6.
kg:st_1 rdfs:label "余市町長 斉藤啓輔"@ja.
kg:st_1 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "設置された場合の固定資産税収入額は9億7千万円くらいになる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "余市町"@ja.
kg:st_2 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_2 prop:content "試算は事業期間17年間と発電機9基を前提にした参考値である"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "関西電力"@ja.
kg:st_3 rdfs:type cls:st_198.
cls:st_198 rdfs:label "電力事業者"@ja.
kg:op_3 prop:content "発電機は最大18基を想定している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "関西電力が余市、古平の両町にまたがる区域で計画中の風力発電施設について、斉藤啓輔町長は23日、設置された場合の固定資産税収入額の試算は「9億7千万円くらいになる」と述べた。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "町によると「事業期間17年間、発電機9基という仮定に仮定を重ね自分たちで出した参考値」という。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "関西電力は事業計画概要で発電機は「最大18基」としている。"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "町議会はこのほか、物価高騰対策で全世帯に2千円分の「お米クーポン券」を配布する事業費を計上した本年度一般会計補正予算案を原案通り可決した。"@ja.
}
