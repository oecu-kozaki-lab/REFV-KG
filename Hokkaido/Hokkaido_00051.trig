<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "求人情報は定員が埋まるなどして取り下げや内容変更が多く、最新の求人情報をどのように求職者に届けるかが課題だった"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "人材不足に悩む企業と町民のマッチングをスムーズに進めようと"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:text-txt_contents "毎週火、木曜に更新し、最新情報を見られるようになった"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "町は就職相談などを行う「松前町就職サポートセンター」のサテライトオフィスとして、多目的スペース「テノハ松前」の別館に「JOBステーション」を開設し"@ja.
<< kg:id_8 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "7月から求人情報をホームページ（HP）や無料通信アプリLINEで発信している"@ja.
<< kg:id_8 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "町の公式LINEで求人情報や短期・単発アルバイトの情報を配信"@ja.
<< kg:id_8 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "毎週火、木曜に更新し、最新情報を見られるようになった"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "町産業振興課の田中建一参事は「町内に潜在している求職者の掘り起こしにつなげたい。"@ja.
<< kg:id_13 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "ゆくゆくはイベントの手伝いなど高校生の短期アルバイトの情報の場にもなれば"@ja.
