PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00052> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "住宅の浸水"@ja.
kg:id_1 rdf:type cls:c_7054.
cls:c_7054 rdfs:label "住宅浸水"@ja.
kg:id_2 rdfs:label "予定地と住宅街の間にある排水路が工事で埋まること"@ja.
kg:id_2 rdf:type cls:c_14750.
cls:c_14750 rdfs:label "排水路の埋設"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "メガソーラー建設"@ja.
kg:id_3 rdf:type cls:c_14570.
cls:c_14570 rdfs:label "太陽光発電事業"@ja.
kg:id_4 rdfs:label "豪雨の際に住宅の浸水が懸念される"@ja.
kg:id_4 rdf:type cls:c_7054.
kg:id_3 prop:effect kg:id_4.
kg:id_5 rdfs:label "住民生活の安全が確保されない限り事業者に市有地を貸さない"@ja.
kg:id_5 rdf:type cls:c_14751.
cls:c_14751 rdfs:label "市有地貸与停止"@ja.
kg:id_3 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "懸念が解消されない限り工事に関係する市有地を貸さない措置"@ja.
kg:id_6 rdf:type cls:c_14751.
kg:id_3 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "キタサンショウウオやオジロワシの生息調査結果が示されていないことへの疑問"@ja.
kg:id_7 rdf:type cls:c_14752.
cls:c_14752 rdfs:label "調査結果の未提示"@ja.
kg:id_3 prop:effect kg:id_7.
kg:id_8 rdfs:label "キタサンショウウオやオジロワシの生息調査結果について対応を求める"@ja.
kg:id_8 rdf:type cls:c_13079.
cls:c_13079 rdfs:label "対応要求"@ja.
kg:id_3 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "メガソーラー建設予定地の隣接住宅"@ja.
kg:id_9 rdf:type cls:c_14753.
cls:c_14753 rdfs:label "隣接住宅"@ja.
kg:id_10 rdfs:label "住民はどうしようもない"@ja.
kg:id_10 rdf:type cls:c_14754.
cls:c_14754 rdfs:label "対処困難"@ja.
kg:id_9 prop:effect kg:id_10.
kg:id_11 rdfs:label "要望書"@ja.
kg:id_11 rdf:type cls:c_14755.
cls:c_14755 rdfs:label "要望書"@ja.
kg:id_12 rdfs:label "思いをしっかり受け止めたい"@ja.
kg:id_12 rdf:type cls:c_14756.
cls:c_14756 rdfs:label "受け止め"@ja.
kg:id_11 prop:effect kg:id_12.
kg:st_1 rdfs:label "釧路市昭和北1丁目町内会の住民有志"@ja.
kg:st_1 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "豪雨時の住宅浸水を懸念している"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "住民生活の安全が確保されないと危機感を持つ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "安全が確保されない限り市有地を貸さない対応を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "浸水懸念の解消まで市有地を貸さない措置を市に求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "生息調査結果が示されていない点に疑問を呈している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "生息調査結果の未提示について対応を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市昭和北1丁目町内会 針生久会長"@ja.
kg:st_2 rdfs:type cls:st_164.
cls:st_164 rdfs:label "住民代表"@ja.
kg:op_7 prop:content "予定地が住宅の目と鼻の先で住民は対処できないと訴える"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:st_3 rdfs:label "釧路市 鶴間秀典市長"@ja.
kg:st_3 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_8 prop:content "住民の思いをしっかり受け止めたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "予定地と住宅街の間にある排水路が工事で埋まることで、豪雨の際に住宅の浸水が懸念される"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "大阪市の事業者が市昭和地区で予定するメガソーラーに関し、予定地と住宅街の間にある排水路が工事で埋まることで、豪雨の際に住宅の浸水が懸念される"@ja.
<< kg:id_3 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "住民生活の安全が確保されない限り事業者に市有地を貸さないなどの対応を、鶴間秀典市長に要望した"@ja.
<< kg:id_3 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "懸念が解消されない限り、工事に関係する市有地を貸さないなどの措置を市に求めた"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "事業者が行ったキタサンショウウオやオジロワシの生息調査結果が示されていないことにも疑問を呈し、対応を求めた"@ja.
<< kg:id_3 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業者が行ったキタサンショウウオやオジロワシの生息調査結果が示されていないことにも疑問を呈し、対応を求めた"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "針生会長は「住宅の目と鼻の先が予定地だが、住民はどうしようもない」と訴えた"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "要望書を受け取った鶴間市長は「思いをしっかり受け止めたい」と話した"@ja.
}
