PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00054> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原周辺での太陽光発電所建設"@ja.
kg:id_1 rdf:type cls:c_14564.
cls:c_14564 rdfs:label "太陽光発電所建設"@ja.
kg:id_2 rdfs:label "相次いでいること"@ja.
kg:id_2 rdf:type cls:c_14760.
cls:c_14760 rdfs:label "建設増加"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "再エネ"@ja.
kg:id_3 rdf:type cls:c_1977.
cls:c_1977 rdfs:label "再生可能エネルギー"@ja.
kg:id_4 rdfs:label "温室効果ガスやCO2を出さない"@ja.
kg:id_4 rdf:type cls:c_14761.
cls:c_14761 rdfs:label "温室効果ガス非排出"@ja.
kg:id_3 prop:effect kg:id_4.
kg:id_5 rdfs:label "釧路市"@ja.
kg:id_5 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_6 rdfs:label "建物の壁など町の中に太陽光パネルを設置する"@ja.
kg:id_6 rdf:type cls:c_14677.
cls:c_14677 rdfs:label "太陽光パネル設置"@ja.
kg:id_5 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "発電する人と使用する人の距離を近くする"@ja.
kg:id_7 rdf:type cls:c_625.
cls:c_625 rdfs:label "地産地消"@ja.
kg:id_5 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "環境に関する出前講座を行う"@ja.
kg:id_8 rdf:type cls:c_702.
cls:c_702 rdfs:label "環境教育"@ja.
kg:id_5 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "電気の仕組みを知り理解を深めてもらう"@ja.
kg:id_9 rdf:type cls:c_4449.
cls:c_4449 rdfs:label "理解促進"@ja.
kg:id_5 prop:countermeasure kg:id_9.
kg:st_1 rdfs:label "北海道大学工学部 石井一英教授"@ja.
kg:st_1 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_1 prop:content "自然との共生を大きなテーマにすべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市企画課長 阿部豊"@ja.
kg:st_2 rdf:type cls:st_60.
cls:st_60 rdfs:label "自治体職員"@ja.
kg:op_2 prop:content "再エネは温室効果ガスやCO2を出さないメリットがある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "地元の人が利益を受けられるよう設置を進めるべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地元の人が利益を受けられる再エネの形が重要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_3 rdfs:label "釧路市環境保全課長 北陽一"@ja.
kg:st_3 rdf:type cls:st_60.
kg:op_5 prop:content "電気の仕組みを知り理解を深めてほしい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "まずは電気の仕組みの理解を深めてほしい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "石井教授は釧路湿原周辺で太陽光発電所建設が相次いでいることを受け、「釧路市では自然との共生が大きなテーマだ」と説明。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "阿部課長は再エネは温室効果ガスやCO2を出さないメリットがあると強調。"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "「建物の壁など町の中に太陽光パネルを設置し、地元の人が利益を受けられるよう発電する人と使用する人の距離を近くすることが大事」と話した。"@ja.
<< kg:id_5 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "「建物の壁など町の中に太陽光パネルを設置し、地元の人が利益を受けられるよう発電する人と使用する人の距離を近くすることが大事」と話した。"@ja.
<< kg:id_5 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "北課長は「環境に関する出前講座などを行っている。まずは電気の仕組みを知り理解を深めてほしい」と呼びかけた。"@ja.
<< kg:id_5 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "北課長は「環境に関する出前講座などを行っている。まずは電気の仕組みを知り理解を深めてほしい」と呼びかけた。"@ja.
}
