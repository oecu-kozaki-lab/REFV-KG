PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00055> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "太陽光発電所建設"@ja.
kg:id_1 rdf:type cls:c_7706.
cls:c_7706 rdfs:label "発電施設建設"@ja.
kg:id_2 rdfs:label "湿原の埋め立て"@ja.
kg:id_2 rdf:type cls:c_14762.
cls:c_14762 rdfs:label "湿原埋め立て"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "希少野生生物などへの影響"@ja.
kg:id_3 rdf:type cls:c_13088.
cls:c_13088 rdfs:label "生物影響"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "生息環境消失の可能性"@ja.
kg:id_4 rdf:type cls:c_14763.
cls:c_14763 rdfs:label "生息環境消失"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "二酸化炭素排出削減効果"@ja.
kg:id_5 rdf:type cls:c_14764.
cls:c_14764 rdfs:label "排出削減効果"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "環境へ配慮した工事方法への協力"@ja.
kg:id_6 rdf:type cls:c_14765.
cls:c_14765 rdfs:label "配慮工事協力"@ja.
kg:id_1 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "埋め立て・工事の中止"@ja.
kg:id_7 rdf:type cls:c_13838.
cls:c_13838 rdfs:label "工事中止"@ja.
kg:id_1 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "環境への配慮"@ja.
kg:id_8 rdf:type cls:c_103.
cls:c_103 rdfs:label "環境配慮"@ja.
kg:id_1 prop:contermeasure kg:id_8.
kg:st_1 rdfs:label "釧路市議会の議員有志21人"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "希少野生生物への影響が懸念されるため中止を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "湿原の埋め立てで希少野生生物への影響を懸念"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "生息環境が失われる可能性があるとして工事中止を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "大阪市の事業者"@ja.
kg:st_2 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_4 prop:content "太陽光発電は二酸化炭素排出削減効果があり環境破壊ではないと主張"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "事業継続の一方で環境に配慮した工事方法への協力は惜しまない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "生息環境消失の可能性があるため埋め立てと工事の中止を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "環境への配慮を求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "市議有志による要請文は事業について湿原の埋め立てにより希少野生生物などへの影響が懸念され"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "湿原の埋め立てにより希少野生生物などへの影響が懸念され"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "生息環境消失の可能性がある埋め立て・工事の中止など5点を求め"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "太陽光発電による二酸化炭素排出削減効果なども引き合いに「環境破壊ではない」とした"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "環境へ配慮した工事方法への協力は惜しまないとした"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "生息環境消失の可能性がある埋め立て・工事の中止など5点を求め"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "市議会の議員有志21人から送られた環境への配慮などを求める要請文に答えた"@ja.
}
