kg:st_1 rdfs:label "釧路市教育委員会"@ja.
kg:st_1 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_1 prop:content "生息への影響を危惧する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "滅失や毀損の可能性を危惧する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "調査不十分のまま工事が続いていると判断する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "一部の専門家評価だけでは不十分とみる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市"@ja.
kg:st_2 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_5 prop:content "これ以上メガソーラー建設を望まない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "生息への影響を危惧する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "滅失や毀損の可能性を指摘する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_3 rdfs:label "文化庁"@ja.
kg:st_3 rdfs:type cls:st_6.
kg:op_8 prop:content "法抵触や罰則の可能性に留意を求める方針"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "原状回復を求める可能性があると示す"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "希少な野生生物への影響を危惧する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "専門家意見を踏まえた再報告を事業者に求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "工事の影響軽減を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "タンチョウだけでなくオジロワシも含め再調査を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "調査不十分なら原状回復命令の可能性を示す"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:st_4 rdfs:label "事業者"@ja.
kg:st_4 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_15 prop:content "法令を順守し事前調査は適切に行っているとする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "これ以上メガソーラーの建設を望まない"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:st_5 rdfs:label "モデルで俳優の冨永愛さん"@ja.
kg:st_5 rdfs:type cls:st_207.
cls:st_207 rdfs:label "著名人"@ja.
kg:op_17 prop:content "貴重な生態系のある釧路湿原になぜメガソーラー建設が必要なのかと疑問視する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_5.
kg:st_6 rdfs:label "登山家の野口健さん"@ja.
kg:st_6 rdfs:type cls:st_207.
kg:op_18 prop:content "計画反対に向け一緒に行動するよう呼びかける"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_6.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "釧路湿原周辺で大阪市の事業者が進める大規模太陽光発電所（メガソーラー）建設計画を巡り、釧路市教育委員会が、国の特別天然記念物タンチョウなどの生息への影響を危惧している"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "工事中の偶発的な事故により、タンチョウなどの滅失や毀損（きそん）などに及ぶ可能性を危惧している"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "事業者の環境調査が不十分なまま、既に工事が行われていると判断した"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事業者は専門家の意見をもとに「（建設予定地は）タンチョウの営巣地ではない」と主張したが、市教委は一部の専門家の評価だけでは調査は不十分とし"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "釧路湿原周辺では、太陽光パネルの設置が相次ぐ。希少な野生生物への影響が危惧される"@ja.
<< kg:id_11 prop:effect kg:id_1 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "釧路市教育委員会が、国の特別天然記念物タンチョウなどの生息への影響を危惧している"@ja.
<< kg:id_4 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "工事中の偶発的な事故により、タンチョウなどの滅失や毀損（きそん）などに及ぶ可能性を危惧している"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業者が事前に十分な確認をせずに工事を行っている場合、文化財保護法に抵触し罰則が科せられる可能性がある"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "文化庁長官から原状回復を求める可能性があることなどに留意するように求める方向だ"@ja.
<< kg:id_15 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "釧路湿原周辺では、太陽光パネルの設置が相次ぐ。希少な野生生物への影響が危惧される"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:text-txt_contents "釧路市教育委員会が、国の特別天然記念物タンチョウなどの生息への影響を危惧しているとの意見書を、文化財保護法に基づき、天然記念物を所管する文化庁に提出した"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "今後、専門家に意見を聴取した上での再報告を、事業者に求めるとしている"@ja.
<< kg:id_16 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "工事による影響の軽減を事業者に求めるとしている"@ja.
<< kg:id_16 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "オジロワシも合わせた再調査を求めた"@ja.
<< kg:id_21 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "同庁は26日にも、調査が不十分な場合、原状回復を命じる可能性もあるとする見解を市教委に伝達し、事業者に伝える方針"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "文化財保護法は、天然記念物の保存に影響を及ぼす行為をしようとする場合、文化庁長官の許可を得なければならないと定める"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "太陽光発電事業者は、影響を及ぼす可能性のある場所で建設を進める場合、事前調査をする必要がある。事業者は北海道新聞の取材に「法令を順守し、事前調査は適切に行っている」としている"@ja.
<< kg:id_27 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "釧路市は6月、これ以上メガソーラーの建設を望まないとする「ノーモア メガソーラー宣言」を発出"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:text-txt_contents "市教委から文化財保護法に基づく立ち入り禁止通告を受け"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:text-txt_contents "4月に一部エリアでの建設を断念していた"@ja.
<< kg:id_33 prop:cause kg:id_32 >>
    prop:text-txt_contents "近くにオジロワシの営巣地があるため市教委から文化財保護法に基づく立ち入り禁止通告を受け、4月に一部エリアでの建設を断念していた"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "モデルで俳優の冨永愛さんは7月上旬、X（旧ツイッター）に「なんで貴重な生態系のある釧路湿原にメガソーラー建設しなきゃならないのか」などと投稿"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "登山家の野口健さんも今月18日、Xで「釧路湿原のメガソーラー計画（の反対）に一緒にアクションを起こしませんか」と呼びかけた"@ja.
}
