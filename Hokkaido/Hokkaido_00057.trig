PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00057> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原周辺の大規模太陽光発電所建設計画"@ja.
kg:id_1 rdf:type cls:c_12240.
cls:c_12240 rdfs:label "開発計画"@ja.
kg:id_2 rdfs:label "国の特別天然記念物タンチョウなどへの影響"@ja.
kg:id_2 rdf:type cls:c_13088.
cls:c_13088 rdfs:label "生物影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "大阪市の事業者が十分な環境調査をせず着工したこと"@ja.
kg:id_3 rdf:type cls:c_124.
cls:c_124 rdfs:label "調査不足"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "事業者に専門家への意見聴取を通じて天然記念物への影響確認を求めること"@ja.
kg:id_4 rdf:type cls:c_13818.
cls:c_13818 rdfs:label "影響確認"@ja.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "騒音、振動を伴う天然記念物への保存に影響を及ぼす行為"@ja.
kg:id_5 rdf:type cls:c_14784.
cls:c_14784 rdfs:label "保存影響行為"@ja.
kg:id_6 rdfs:label "影響が軽微でない場合は文化庁長官の許可を得ること"@ja.
kg:id_6 rdf:type cls:c_7703.
cls:c_7703 rdfs:label "許可取得"@ja.
kg:id_5 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "天然記念物の滅失や毀損につながること"@ja.
kg:id_7 rdf:type cls:c_14785.
cls:c_14785 rdfs:label "毀損可能性"@ja.
kg:id_1 prop:effect kg:id_7.
kg:st_1 rdfs:label "釧路市教育委員会"@ja.
kg:st_1 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_1 prop:content "タンチョウなどへの影響を危惧"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "十分な環境調査なしの着工と判断"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "専門家意見を踏まえた影響確認を事業者に求めるべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "文化庁"@ja.
kg:st_2 rdfs:type cls:st_6.
kg:op_4 prop:content "市教委による影響確認の要求は適当"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "阿部俊子文部科学相"@ja.
kg:st_3 rdfs:type cls:st_6.
kg:op_5 prop:content "事業者への影響確認を求めることは適当"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "天然記念物の滅失や毀損につながらないよう指導を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "釧路市教育委員会が国の特別天然記念物タンチョウなどへの影響を危惧している"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "市教委は、大阪市の事業者が十分な環境調査をせず着工したと判断"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "事業者に専門家への意見聴取を通じて天然記念物への影響確認を求めること"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "騒音、振動を伴う天然記念物への保存に影響を及ぼす行為をしようとする時は、影響が軽微でない場合は文化庁長官の許可が必要"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "開発が天然記念物の滅失や毀損（きそん）につながることがないよう"@ja.
}
