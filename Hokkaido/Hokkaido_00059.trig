PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00059> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "太陽光発電所の建設"@ja.
kg:id_1 rdf:type cls:c_7706.
cls:c_7706 rdfs:label "発電施設建設"@ja.
kg:id_2 rdfs:label "市の許可制"@ja.
kg:id_2 rdf:type cls:c_14789.
cls:c_14789 rdfs:label "許可制度"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "特定保全種の指定"@ja.
kg:id_3 rdf:type cls:c_14790.
cls:c_14790 rdfs:label "保全種指定"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "特別保全区域の設定"@ja.
kg:id_4 rdf:type cls:c_14791.
cls:c_14791 rdfs:label "保全区域設定"@ja.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "5種の生息調査"@ja.
kg:id_5 rdf:type cls:c_13136.
cls:c_13136 rdfs:label "生息調査"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "保全計画の作成"@ja.
kg:id_6 rdf:type cls:c_14792.
cls:c_14792 rdfs:label "保全計画作成"@ja.
kg:id_1 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "設置中止時の新たな届け出"@ja.
kg:id_7 rdf:type cls:c_14793.
cls:c_14793 rdfs:label "届け出義務"@ja.
kg:id_1 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "パネルの廃棄費用や撤去を事業者側に求める"@ja.
kg:id_8 rdf:type cls:c_813.
cls:c_813 rdfs:label "費用負担"@ja.
kg:id_1 prop:contermeasure kg:id_8.
kg:st_1 rdfs:label "意見公募の参加者"@ja.
kg:st_1 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "特別保全区域を阿寒町や音別町にも広げるべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "新たな届け出が必要ではないかとの意見を出した意見公募の参加者"@ja.
kg:st_2 rdfs:type cls:st_5.
kg:op_2 prop:content "事業者が設置中止した場合も新たな届け出を必要にすべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "寄せられた意見の大半を占めた意見公募の参加者"@ja.
kg:st_3 rdfs:type cls:st_5.
kg:op_3 prop:content "パネルの廃棄費用や撤去を事業者側に求めるべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:text-txt_contents "条例案では出力10キロワット以上の太陽光発電所の建設を市の許可制とし"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:text-txt_contents "タンチョウやオジロワシなど5種を「特定保全種」に指定"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "5種が生息する可能性が高い釧路川以西などを「特別保全区域」とし"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "この区域で発電所を建てる場合は、事業者に5種の生息調査や保全計画の作成を義務づける"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "この区域で発電所を建てる場合は、事業者に5種の生息調査や保全計画の作成を義務づける"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "届け出を出した事業者が設置中止した場合にも新たな届け出が必要ではないかとの意見を市は取り入れ、条例案を修正した"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "寄せられた意見の大半がパネルの廃棄費用や撤去を事業者側に求める内容"@ja.
}
