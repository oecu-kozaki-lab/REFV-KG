kg:id_5 rdf:type cls:c_14794.
cls:c_14794 rdfs:label "広域問題"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "環境省"@ja.
kg:id_6 rdf:type cls:c_891.
cls:c_891 rdfs:label "行政機関"@ja.
kg:id_7 rdfs:label "本省から現地調査のため釧路市などに職員を派遣"@ja.
kg:id_7 rdf:type cls:c_267.
cls:c_267 rdfs:label "現地調査"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "野生生物保護の観点で対応策を検討"@ja.
kg:id_8 rdf:type cls:c_6558.
cls:c_6558 rdfs:label "対応検討"@ja.
kg:id_6 prop:countermeasure kg:id_8.
