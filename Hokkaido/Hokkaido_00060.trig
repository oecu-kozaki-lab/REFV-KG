kg:id_9 rdf:type cls:c_895.
cls:c_895 rdfs:label "実態把握"@ja.
kg:id_6 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "釧路市が検討している建設を規制する条例案について市役所で話を聞く"@ja.
kg:id_10 rdf:type cls:c_14795.
cls:c_14795 rdfs:label "意向確認"@ja.
kg:id_6 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "建設予定地など周辺を調査"@ja.
kg:id_11 rdf:type cls:c_14796.
cls:c_14796 rdfs:label "周辺調査"@ja.
kg:id_6 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "釧路市"@ja.
kg:id_12 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
