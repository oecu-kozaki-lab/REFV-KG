kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "環境保護の観点から累積的影響を考慮する必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "環境省"@ja.
kg:st_2 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_2 prop:content "野生生物保護の観点で対応策を検討する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "累積的影響を考慮すべきだ"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "釧路市だけでなく複数自治体にまたがる広域的問題で対策が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "地元自治体の意向を確認したい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "環境省幹部"@ja.
kg:st_3 rdf:type cls:st_2.
kg:op_6 prop:content "釧路湿原に隣接するエリアにも同様の事象が潜在する可能性があり何ができるか確認したい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "地元自治体の意向を確認したい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "太陽光発電施設の建設が急増し、環境保護の観点では、累積的な影響を考慮する必要がある"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "野生生物保護の観点で対応策を検討し"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "環境保護の観点では、累積的な影響を考慮する必要がある"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "釧路市だけでなく複数の自治体にまたがる広域的な問題と捉え、対策が必要との考えを示した"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "近く本省から現地調査のため釧路市などに職員を派遣すると発表した"@ja.
<< kg:id_6 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "野生生物保護の観点で対応策を検討し"@ja.
<< kg:id_6 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "国立公園周辺で他に開発の問題がないかを把握する狙い"@ja.
<< kg:id_6 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "釧路市が検討している太陽光発電所の建設を規制する条例案について市役所で話を聞く"@ja.
<< kg:id_6 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "建設予定地など周辺を調査する"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "釧路市が検討している太陽光発電所の建設を規制する条例案"@ja.
