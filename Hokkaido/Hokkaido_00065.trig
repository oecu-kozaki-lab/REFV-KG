PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00065> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原周辺メガソーラーの建設計画"@ja.
kg:id_1 rdf:type cls:c_14570.
cls:c_14570 rdfs:label "太陽光発電事業"@ja.
kg:id_2 rdfs:label "タンチョウなど希少生物の生息地の分断"@ja.
kg:id_2 rdf:type cls:c_14835.
cls:c_14835 rdfs:label "生息地分断"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "種の保存法への明文化"@ja.
kg:id_3 rdf:type cls:c_14836.
cls:c_14836 rdfs:label "法制度整備"@ja.
kg:id_1 prop:countermeasure kg:id_3.
kg:id_4 rdfs:label "釧路市"@ja.
kg:id_4 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_5 rdfs:label "10㌗以上の事業用太陽光発電所の建設を規制する条例案の提出"@ja.
kg:id_5 rdf:type cls:c_14797.
cls:c_14797 rdfs:label "建設規制"@ja.
kg:id_4 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "太陽光発電所の設置"@ja.
kg:id_6 rdf:type cls:c_14837.
cls:c_14837 rdfs:label "太陽光発電所"@ja.
kg:id_7 rdfs:label "設置規制の強化"@ja.
kg:id_7 rdf:type cls:c_14800.
cls:c_14800 rdfs:label "規制強化"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "釧路湿原周辺メガソーラー事業"@ja.
kg:id_8 rdf:type cls:c_14570.
kg:id_9 rdfs:label "二酸化炭素の削減"@ja.
kg:id_9 rdf:type cls:c_14838.
cls:c_14838 rdfs:label "二酸化炭素削減"@ja.
kg:id_8 prop:effect kg:id_9.
kg:st_1 rdfs:label "猛禽類医学研究所の斉藤慶輔代表"@ja.
kg:st_1 rdf:type cls:st_105.
cls:st_105 rdfs:label "研究者"@ja.
kg:op_1 prop:content "国立公園外の湿地帯も分断化された釧路湿原として認識し生息地保全を重視すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "希少生物の個体だけでなく生息地も守れるよう法制度に明記すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市の鶴間秀典市長"@ja.
kg:st_2 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_3 prop:content "自然を守りたいという市の考えへの理解が得られたと歓迎"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "自民党の古屋圭司衆院議員"@ja.
kg:st_3 rdf:type cls:st_212.
cls:st_212 rdfs:label "国会議員"@ja.
kg:op_4 prop:content "事業者は社会的責任を果たすべきで設置規制を強化すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "日本エコロジーの松井政憲社長"@ja.
kg:st_4 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_5 prop:content "開発可能エリアであり自然と調和しながら環境事業を進めて二酸化炭素削減に貢献すると主張"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "建設予定地周辺で暮らすタンチョウの親子の動画を見せながら、「国立公園外の湿地帯も『分断化された釧路湿原』であるとの認識を持つべきだ」と強調。希少生物の個体だけでなく生息地もしっかり守ることができるよう"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "希少生物の個体だけでなく生息地もしっかり守ることができるよう「種の保存法」に明文化する必要があると訴えた"@ja.
<< kg:id_4 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "釧路市は、10㌗以上の事業用太陽光発電所の建設を規制する条例案を市議会に提出しており、10月1日の施行を目指している。鶴間秀典市長は議員らとの会談後、「自然を守っていきたいというわれわれの気持ちを理解していただいた」と歓迎した。"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "古屋氏は「太陽光発電事業は環境問題と表裏一体の関係。事業者にも社会的責任をしっかり果たしていただきたい」と述べ、太陽光発電所の設置規制を強化していく考えを示した。"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "日本エコロジーの松井社長は「この地区は開発可能エリア。二酸化炭素の削減に向けて、自然と調和しながら環境事業を行っていく」と反論した。"@ja.
}
