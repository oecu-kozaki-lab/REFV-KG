PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00070> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原国立公園周辺でのメガソーラー建設"@ja.
kg:id_1 rdf:type cls:c_14564.
cls:c_14564 rdfs:label "太陽光発電所建設"@ja.
kg:id_2 rdfs:label "建設が相次いでいること"@ja.
kg:id_2 rdf:type cls:c_14760.
cls:c_14760 rdfs:label "建設増加"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "湿原周辺地域での開発"@ja.
kg:id_3 rdf:type cls:c_8840.
cls:c_8840 rdfs:label "地域開発"@ja.
kg:id_4 rdfs:label "一定程度規制する法律の制定"@ja.
kg:id_4 rdf:type cls:c_14857.
cls:c_14857 rdfs:label "開発規制法"@ja.
kg:id_3 prop:contermeasure kg:id_4.
kg:st_1 rdfs:label "釧路管内標茶町"@ja.
kg:st_1 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "湿原周辺地域での開発を一定程度規制する法律の制定を要請"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤吉彦町長"@ja.
kg:st_2 rdfs:type cls:st_199.
cls:st_199 rdfs:label "自治体代表"@ja.
kg:op_2 prop:content "国立公園に隣接する周辺地域で開発規制が可能になる法律制定を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "環境省の担当者"@ja.
kg:st_3 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_3 prop:content "今後検討したい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "釧路湿原国立公園周辺で大規模太陽光発電所（メガソーラー）建設が相次ぐ中"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "湿原周辺地域での開発を一定程度規制する法律の制定を環境省に要請した。 佐藤吉彦町長が同日、同町を訪れた環境省の担当者と面会し「国立公園に隣接する周辺地域について、一定程度の開発の規制が可能になるような法律の制定をお願いしたい」と伝えた。 佐藤町長によると、環境省の担当者は「これから検討していきたい」と述べたという。"@ja.
}
