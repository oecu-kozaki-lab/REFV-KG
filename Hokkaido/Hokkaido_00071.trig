kg:st_1 rdfs:label "ユーラスエナジーホールディングスの諏訪部哲也社長"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "第三者の意見を聞いて改善したい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "バードストライクを減らす取り組みを続けたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "環境省"@ja.
kg:st_2 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_3 prop:content "希少な猛禽類への重大な影響を懸念"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "風車の配置見直しを要請"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "環境アセスメント学会の傘木宏夫常務理事"@ja.
kg:st_3 rdf:type cls:st_105.
cls:st_105 rdfs:label "研究者"@ja.
kg:op_5 prop:content "規制法ではないため民間の開発を止められない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "民間任せで開発が進んだ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:st_4 rdfs:label "北海道風力発電問題ネットワークの佐々木邦夫代表"@ja.
kg:st_4 rdf:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_7 prop:content "事故は必然だった"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:op_8 prop:content "宗谷の風車の多さは異常だ"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "そろそろ立ち止まって考えるべきだ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:st_5 rdfs:label "早稲田大の風間健太郎准教授"@ja.
kg:st_5 rdf:type cls:st_105.
kg:op_10 prop:content "風車回避で海ワシ類の負担が増える"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "近くのエサ場を利用できなくなる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_5.
kg:op_12 prop:content "繁殖への悪影響がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_5.
kg:op_13 prop:content "長期的に寿命短縮の恐れがある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:op_14 prop:content "陸上風力の大規模開発適地は減る"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "営業力を強化する方針だ"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "洋上風力にも力を入れる方針だ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:st_6 rdfs:label "豊富町で牧場を営んできた久世薫嗣さん"@ja.
kg:st_6 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_17 prop:content "景観の変化や騒音が過疎化を進めると危惧"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_6.
kg:op_18 prop:content "風車に囲まれる暮らしになった"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_6.
kg:op_19 prop:content "農業が衰退すれば都会も困る"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:op_20 prop:content "生態系と景観との共存を考えるべきだ"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "風車との衝突を防ぐためだ"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "2023年5月の稼働以来、今春までに国の天然記念物オジロワシ10羽とオオワシ1羽が衝突"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "うち10羽が死ぬバードストライクが起きた"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "8月4日、内陸側の1基の近くで、また鳥の死骸が見つかった。準絶滅危惧種とされるハイタカだった"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "対策としてユーラス社は3月25日、オジロワシなどの海ワシ類が活動する日の出1時間前から日没まで、日中の運転を全基停止した"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "半径300メートル圏内に鳥が入ると忌避音を出すスピーカーを追加するなど対策を強化"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "7月12日、事故が多発した1基を除いて再開した"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "ハイタカの事故を受けて追加の対策を検討中で、「事前の環境アセスのやり方が適切だったのか、第三者の意見を聞いて改善したい」と語る"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "「バードストライクを減らす取り組みは続けていきたい」"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "環境省は浜里WFが環境アセス中だった17年、大臣意見書として「希少な猛禽類への重大な影響が懸念される」と風車の配置見直しなどを要請"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "大臣意見書として「希少な猛禽類への重大な影響が懸念される」と風車の配置見直しなどを要請"@ja.
<< kg:id_11 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "ユーラス社も鳥の飛行ルートを考えた配置に変えた"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "環境影響評価法は規制する法律ではなく、手続きを定めたものなので、民間のビジネスをやめさせることはできない"@ja.
<< kg:id_15 prop:cause kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "これまで民間任せできたことで、野放図な開発が進んだ"@ja.
<< kg:id_15 prop:effect kg:id_18 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事故は起こるべくして起きた"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:text-txt_contents "宗谷では239基の風車が稼働し"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:text-txt_contents "環境影響評価(アセスメント)中の計画を含めると、やがて最大820基になる見通しだ"@ja.
<< kg:id_19 prop:effect kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "宗谷の風車の多さは植民地といってもいい状況"@ja.
<< kg:id_19 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "そろそろ立ち止まって考えるべきだ"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "風車を避けるため海ワシ類は余分なエネルギーを使い"@ja.
<< kg:id_24 prop:cause kg:id_26 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "近くのエサ場も使えなくなる"@ja.
<< kg:id_24 prop:effect kg:id_27 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "繁殖しにくくなったり"@ja.
<< kg:id_24 prop:effect kg:id_28 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "長期的には寿命が短くなったりする恐れがある"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:text-txt_contents "FIT制度は、再生可能エネルギーの事業者にとって長期間、固定した価格で買い取ってもらえる利点があった"@ja.
<< kg:id_29 prop:cause kg:id_31 >>
    prop:text-txt_contents "風況が良く"@ja.
<< kg:id_29 prop:cause kg:id_32 >>
    prop:text-txt_contents "広大な土地を得やすい北海道や東北に風車は集中してきた"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "陸上風力は大がかりに開発できる場所は少なくなっていく"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "営業力の強化と洋上風力にも力を入れる方針だ"@ja.
<< kg:id_33 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "営業力の強化と洋上風力にも力を入れる方針だ"@ja.
<< kg:id_37 prop:effect kg:id_38 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "景観の変化や騒音が過疎化に拍車をかける、と久世さんは危惧する"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "まさか風車に囲まれて暮らすことになるとは"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "農業が衰退すれば困るのは都会じゃないか"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "風力発電を生態系と景観とどう共存させるのか考えないといけない"@ja.
