kg:st_1 rdfs:label "市内の自営業 辻裕之さん"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "再エネと共生する方法を地域ぐるみで考えたい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "長谷川岳参院議員"@ja.
kg:st_2 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_2 prop:content "再エネは地域と共生する形で推進すべきだ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "太陽光発電は地元への利益還元が乏しい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "道内のある再エネ事業者"@ja.
kg:st_3 rdf:type cls:st_1.
kg:op_4 prop:content "太陽光発電のイメージ悪化が心配"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "釧路国際ウェットランドセンター技術委員長 新庄久志さん"@ja.
kg:st_4 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_5 prop:content "釧路湿原周辺のあり方を含めて改めて論議すべきだ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:op_6 prop:content "再エネは地域と共生する形で推進すべきだ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_5 rdfs:label "猛禽類医学研究所代表 斉藤慶輔代表"@ja.
kg:st_5 rdf:type cls:st_37.
kg:op_7 prop:content "騒音の影響を案じている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_5.
kg:op_8 prop:content "無秩序な設置の現状に憤っている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_6 rdfs:label "鶴居村企画財政課"@ja.
kg:st_6 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_9 prop:content "景観を守る必要がある"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_6.
kg:op_10 prop:content "釧路湿原周辺の問題も注目され、太陽光発電のイメージ悪化が心配"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "市が条例で規制に踏み出せると評価する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "市が条例で規制に踏み出せると評価する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "現行の種の保存法では対応できないため法規制強化を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:op_14 prop:content "景観保全の観点から対応している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_6.
kg:op_15 prop:content "いずれ土地を取得しパネルを建てるだろうと予測している"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:st_7 rdfs:label "環境エネルギー政策研究所 主任研究員 山下紀明氏"@ja.
kg:st_7 rdf:type cls:st_37.
kg:op_16 prop:content "全国一律で規制を強めるのは難しく地域の実情に合わせて条例で対応すべきだ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_7.
kg:st_8 rdfs:label "浅尾慶一郎環境相"@ja.
kg:st_8 rdf:type cls:st_216.
cls:st_216 rdfs:label "大臣"@ja.
kg:op_17 prop:content "国としてどのような対応ができるか検討したい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_8.
kg:st_9 rdfs:label "住民ら"@ja.
kg:st_9 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_18 prop:content "温泉街近くのメガソーラーに反対した"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_9.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "希少生物が生息する釧路湿原周辺での大規模太陽光発電所（メガソーラー）建設を機に、再生可能エネルギー普及と自然保護が共存できるかが全国の注目を集めている。2011年の東京電力福島第1原発事故後、日本は官民挙げて再生可能エネルギー発電の普及に取り組んできた。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "政府が今年2月にまとめたエネルギー基本計画では、40年度の電源構成に占める割合を現在の1割から最大3割に引き上げる方針を掲げた。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "太陽光はパネル設置が容易で、山林や別荘地、ゴルフ場跡地も活用されてきた。"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "今も釧路湿原周辺では市内約30カ所超で太陽光発電所の建設が進む。日照時間が長いことに加え、原野状態なら地価が安く、山間地よりも開発が容易に映る事情もある。"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:text-txt_contents "今も釧路湿原周辺では市内約30カ所超で太陽光発電所の建設が進む。日照時間が長いことに加え、原野状態なら地価が安く、山間地よりも開発が容易に映る事情もある。"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:text-txt_contents "今も釧路湿原周辺では市内約30カ所超で太陽光発電所の建設が進む。日照時間が長いことに加え、原野状態なら地価が安く、山間地よりも開発が容易に映る事情もある。"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:text-txt_contents "道外でメガソーラー適地が限られつつある中、道内で1970、80年代に投資目的で売買され、放置されていた「原野商法」の土地が注目を浴びてもいる。"@ja.
<< kg:id_1 prop:cause kg:id_9 >>
    prop:text-txt_contents "道外でメガソーラー適地が限られつつある中、道内で1970、80年代に投資目的で売買され、放置されていた「原野商法」の土地が注目を浴びてもいる。"@ja.
<< kg:id_1 prop:cause kg:id_10 >>
    prop:text-txt_contents "土地を安価に仕入れられれば、発電に伴う投資を早期に回収しやすくなる。"@ja.
<< kg:id_1 prop:cause kg:id_11 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "同市北斗のメガソーラーは「6キロライン」より内陸にあるのに、計画が進んでいた。太陽光パネルは都市計画法上、建築物とみなされずルールの適用外だからだ。"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "希少生物が生息する釧路湿原周辺での大規模太陽光発電所（メガソーラー）建設を機に、再生可能エネルギー普及と自然保護が共存できるかが全国の注目を集めている。"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "付近には国の特別天然記念物タンチョウなどが生息している。騒音の影響を案じた斉藤代表は、工事前にどんな調査があったのか釧路市教育委員会に問い合わせ"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:text-txt_contents "複数省庁に照会したところ、希少生物に関する環境影響調査が不十分だとして文化財保護法に違反する可能性が浮上した。"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:text-txt_contents "ほどなく、文化庁が原状回復を命じる可能性を盛り込んだ見解を伝える事態に発展。"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:text-txt_contents "釧路管内鶴居村など湿原周辺の自治体でも懸念は渦巻いている。"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "大自然に太陽光パネルが無秩序に設置される現状に憤っていた。"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "近年は景観悪化や防災面で懸念もあり、慎重論も台頭している。景観を守るため日本エコロジーが一時発電所建設に動いた民有地約7.5ヘクタールを購入する方針を決めたばかりだ。"@ja.
<< kg:id_1 prop:effect kg:id_19 >>
    prop:text-txt_contents "近年は景観悪化や防災面で懸念もあり、慎重論も台頭している。"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "道内のある再エネ事業者は「釧路湿原周辺の問題も注目され、太陽光発電のイメージ悪化が心配」と話す。"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "17日に釧路市議会が規制条例案を可決した。"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "釧路市の太陽光発電規制条例案可決 建設、許可制に"@ja.
<< kg:id_22 prop:countermeasure kg:id_24 >>
    prop:text-txt_contents "事業者に市との事前協議を義務づけ"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "湿原周辺でメガソーラー建設が続く現状を訴え、法規制の強化を求めた。現行の種の保存法では対応できないと考えたからだ。"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "景観を守るため日本エコロジーが一時発電所建設に動いた民有地約7.5ヘクタールを購入する方針を決めたばかりだ。"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "村の太陽光規制条例や景観条例は事業者に事前協議を課しているが"@ja.
<< kg:id_31 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "全国一律で規制を強めるのは難しく、地域の実情に合わせて条例で対応すべきだ"@ja.
<< kg:id_33 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "実際、釧路市や同管内標茶町は9月に入り、湿原周辺での開発を規制する法整備を環境省に求めた。浅尾慶一郎環境相は「国としてどのような対応ができるか検討したい」"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:text-txt_contents "市は今年4月に太陽光や風力の発電施設設置を規制する条例を施行し"@ja.
<< kg:id_35 prop:countermeasure kg:id_37 >>
    prop:text-txt_contents "土砂災害の危険性などがある場所を禁止区域とし"@ja.
<< kg:id_35 prop:countermeasure kg:id_38 >>
    prop:text-txt_contents "禁止区域以外も設置を許可制にした。"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "住民らの反対論を踏まえ、市は今年6月に再エネ規制条例を施行した。"@ja.
<< kg:id_39 prop:countermeasure kg:id_41 >>
    prop:text-txt_contents "出力10キロワット以上の発電事業者に市との事前協議を義務づけた。"@ja.
}
