PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00075> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "盛り土工事"@ja.
kg:id_1 rdf:type cls:c_106.
cls:c_106 rdfs:label "工事"@ja.
kg:id_2 rdfs:label "日本エコロジーの盛り土規制法についての認識違い"@ja.
kg:id_2 rdf:type cls:c_14920.
cls:c_14920 rdfs:label "法令認識不足"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "盛り土規制法に定められた届け出の未提出"@ja.
kg:id_3 rdf:type cls:c_14921.
cls:c_14921 rdfs:label "届け出未提出"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "届け出未提出の把握遅れ"@ja.
kg:id_4 rdf:type cls:c_14922.
cls:c_14922 rdfs:label "把握遅れ"@ja.
kg:id_5 rdfs:label "北海道が約4カ月にわたり未提出を把握できなかったこと"@ja.
kg:id_5 rdf:type cls:c_14923.
cls:c_14923 rdfs:label "未提出把握不能"@ja.
kg:id_4 prop:cause kg:id_5.
kg:id_6 rdfs:label "北海道から届け出を行うよう指示を受けた"@ja.
kg:id_6 rdf:type cls:c_14924.
cls:c_14924 rdfs:label "届け出指示"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "釧路総合振興局と釧路市の現地調査で発覚した"@ja.
kg:id_7 rdf:type cls:c_267.
cls:c_267 rdfs:label "現地調査"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "事業者への処分は見送られた"@ja.
kg:id_8 rdf:type cls:c_14925.
cls:c_14925 rdfs:label "処分見送り"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "森林法違反"@ja.
kg:id_9 rdf:type cls:c_979.
cls:c_979 rdfs:label "法令違反"@ja.
kg:id_10 rdfs:label "道から一部工事の中止勧告を受けた"@ja.
kg:id_10 rdf:type cls:c_14818.
cls:c_14818 rdfs:label "工事中止勧告"@ja.
kg:id_9 prop:effect kg:id_10.
kg:id_11 rdfs:label "北海道"@ja.
kg:id_11 rdf:type cls:c_891.
cls:c_891 rdfs:label "行政機関"@ja.
kg:id_12 rdfs:label "日本エコロジーに届け出を行うよう指示"@ja.
kg:id_12 rdf:type cls:c_14924.
kg:id_11 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "道建設部"@ja.
kg:id_13 rdf:type cls:c_891.
kg:id_14 rdfs:label "経過観察を行い法令順守を徹底させる"@ja.
kg:id_14 rdf:type cls:c_14926.
cls:c_14926 rdfs:label "経過観察"@ja.
kg:id_13 prop:contermeasure kg:id_14.
kg:id_15 rdfs:label "一部工事の中止勧告"@ja.
kg:id_15 rdf:type cls:c_14818.
kg:id_11 prop:contermeasure kg:id_15.
kg:st_1 rdfs:label "日本エコロジー"@ja.
kg:st_1 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "盛り土規制法の認識を誤っていたと説明"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "道建設部"@ja.
kg:st_2 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_2 prop:content "現場は人的被害の恐れがない平地のため処分を見送る判断"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "経過観察を行い法令順守を徹底させる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "道の聞き取りに対し、同社は「盛り土規制法について認識が間違っていた」と説明した。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "日本エコロジー（大阪市）が、盛り土規制法に定められた届け出をせずに工事を行っていた"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:text-txt_contents "道も届け出の未提出を約4カ月にわたり把握できていなかった。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "道は今月9日に同社に届け出を行うよう指示し、17日に受理した。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "釧路総合振興局と釧路市が8月29日に実施した現地調査で発覚。"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "現場は人的被害の恐れがない平地であることから、事業者への処分は見送った。"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:text-txt_contents "同社は道の許可を得ず0.5ヘクタールを上回る森林を伐採し、森林法に違反するとして今月2日に道から一部工事の中止勧告を受けた。"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "道は今月9日に同社に届け出を行うよう指示し、17日に受理した。"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "道建設部は「経過観察を行い、法令順守を徹底させる」と話した。"@ja.
<< kg:id_11 prop:contermeasure kg:id_15 >>
    prop:text-txt_contents "今月2日に道から一部工事の中止勧告を受けた。"@ja.
}
