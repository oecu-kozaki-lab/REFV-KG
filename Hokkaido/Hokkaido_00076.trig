PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00076> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "大規模太陽光発電所の建設"@ja.
kg:id_1 rdf:type cls:c_14564.
cls:c_14564 rdfs:label "太陽光発電所建設"@ja.
kg:id_2 rdfs:label "埋め立てられた建設予定地"@ja.
kg:id_2 rdf:type cls:c_13354.
cls:c_13354 rdfs:label "建設予定地"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "釧路湿原周辺の豊かな自然の破壊"@ja.
kg:id_3 rdf:type cls:c_13156.
cls:c_13156 rdfs:label "自然破壊"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "釧路市"@ja.
kg:id_4 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_5 rdfs:label "太陽光発電所の建設を規制する条例の施行"@ja.
kg:id_5 rdf:type cls:c_14797.
cls:c_14797 rdfs:label "建設規制"@ja.
kg:id_4 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "全国"@ja.
kg:id_6 rdf:type cls:c_14927.
cls:c_14927 rdfs:label "全国"@ja.
kg:id_7 rdfs:label "建設禁止区域を明確にして規制がかかる立法の検討"@ja.
kg:id_7 rdf:type cls:c_14928.
cls:c_14928 rdfs:label "立法検討"@ja.
kg:id_6 prop:contermeasure kg:id_7.
kg:st_1 rdfs:label "立憲民主党 山崎誠衆院議員"@ja.
kg:st_1 rdfs:type cls:st_212.
cls:st_212 rdfs:label "国会議員"@ja.
kg:op_1 prop:content "釧路湿原周辺の自然破壊に強い衝撃を受けた"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "立憲民主党 田嶋要衆院議員"@ja.
kg:st_2 rdfs:type cls:st_212.
kg:op_2 prop:content "釧路市の条例を研究し全国でも同様に建設禁止区域を明確化する立法を検討すべきだ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "3氏は埋め立てられた建設予定地を視察後"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "山崎氏は「釧路湿原周辺の豊かな自然が破壊され、非常にショックだった」と驚いた様子"@ja.
<< kg:id_4 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "10月1日から市が施行する太陽光発電所の建設を規制する条例の概要などを説明した"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "田嶋氏は「国の対応が後手後手に回っている。釧路市の条例を研究し、全国も同じように建設禁止区域を明確にして規制がかかる立法を検討すべきだ」と述べた"@ja.
}
