PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00078> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "メガソーラーの乱立"@ja.
kg:id_1 rdf:type cls:c_14564.
cls:c_14564 rdfs:label "太陽光発電所建設"@ja.
kg:id_2 rdfs:label "釧路市の太陽光発電条例の施行"@ja.
kg:id_2 rdf:type cls:c_2690.
cls:c_2690 rdfs:label "条例施行"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "事業用太陽光発電所の建設"@ja.
kg:id_3 rdf:type cls:c_14564.
kg:id_4 rdfs:label "市内全域を対象にした許可制"@ja.
kg:id_4 rdf:type cls:c_14910.
cls:c_14910 rdfs:label "許可制"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "希少な野生生物の生息調査の義務付け"@ja.
kg:id_5 rdf:type cls:c_13136.
cls:c_13136 rdfs:label "生息調査"@ja.
kg:id_3 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "保全計画の作成の義務付け"@ja.
kg:id_6 rdf:type cls:c_447.
cls:c_447 rdfs:label "保全計画"@ja.
kg:id_3 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "太陽光発電所の計画"@ja.
kg:id_7 rdf:type cls:c_14772.
cls:c_14772 rdfs:label "太陽光発電計画"@ja.
kg:id_8 rdfs:label "5種が生息する可能性の高いエリアでの生息調査の実施"@ja.
kg:id_8 rdf:type cls:c_13136.
kg:id_7 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "特定保全種への影響"@ja.
kg:id_9 rdf:type cls:c_13088.
cls:c_13088 rdfs:label "生物影響"@ja.
kg:id_7 prop:effect kg:id_9.
kg:id_10 rdfs:label "太陽光発電所の建設"@ja.
kg:id_10 rdf:type cls:c_14564.
kg:id_11 rdfs:label "保全種に影響がある場合は建設を認めない"@ja.
kg:id_11 rdf:type cls:c_14684.
cls:c_14684 rdfs:label "建設不許可"@ja.
kg:id_10 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "釧路市北斗でのメガソーラー建設計画"@ja.
kg:id_12 rdf:type cls:c_14772.
kg:id_13 rdfs:label "日本エコロジーからの協議の場の要請に対し庁内で協議"@ja.
kg:id_13 rdf:type cls:c_14935.
cls:c_14935 rdfs:label "庁内協議"@ja.
kg:id_12 prop:countermeasure kg:id_13.
kg:st_1 rdfs:label "鶴間秀典市長"@ja.
kg:st_1 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "環境と調和しない太陽光発電所の建設の歯止めになることに期待"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "対応は庁内で協議している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "釧路湿原国立公園周辺での大規模太陽光発電所（メガソーラー）の乱立に歯止めをかける狙い。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "市内全域を対象に許可制とし"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:text-txt_contents "希少な野生生物の生息調査や保全計画の作成を事業者に義務付ける。"@ja.
<< kg:id_3 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "希少な野生生物の生息調査や保全計画の作成を事業者に義務付ける。"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "5種が生息する可能性の高いエリアで太陽光発電所を計画する場合、生息調査などを求め"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:text-txt_contents "専門家による委員会が保全種に影響があると判断すれば建設を認めない。"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "専門家による委員会が保全種に影響があると判断すれば建設を認めない。"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "対応については「庁内で協議している」と述べるにとどめた。"@ja.
}
