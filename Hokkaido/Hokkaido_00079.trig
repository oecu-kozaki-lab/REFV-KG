 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原周辺での大規模太陽光発電所建設計画"@ja.
kg:id_1 rdf:type cls:c_12240.
cls:c_12240 rdfs:label "開発計画"@ja.
kg:id_2 rdfs:label "日本エコロジーが土壌汚染対策法の届け出を期限から半年以上提出していなかったこと"@ja.
kg:id_2 rdf:type cls:c_979.
cls:c_979 rdfs:label "法令違反"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "日本エコロジーが30日前までに必要な土壌汚染対策法の届け出を行わず盛り土工事に着手したこと"@ja.
kg:id_3 rdf:type cls:c_13214.
cls:c_13214 rdfs:label "無届け工事"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "日本エコロジーが2月15日期限の届け出を9月5日に提出したこと"@ja.
kg:id_4 rdf:type cls:c_14936.
cls:c_14936 rdfs:label "無届け"@ja.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "日本エコロジーが道の許可を得ずに0.5ヘクタールを上回る森林を伐採したこと"@ja.
kg:id_5 rdf:type cls:c_14817.
cls:c_14817 rdfs:label "無許可伐採"@ja.
kg:id_1 prop:cause kg:id_5.
kg:id_6 rdfs:label "盛り土規制法に基づく道への届け出が未提出だったこと"@ja.
kg:id_6 rdf:type cls:c_14936.
kg:id_1 prop:cause kg:id_6.
kg:id_7 rdfs:label "日本エコロジーが土壌汚染対策法に違反して工事を行っていたことが明らかになった"@ja.
kg:id_7 rdf:type cls:c_979.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "道から一部工事の中止勧告を受けたこと"@ja.
kg:id_8 rdf:type cls:c_14818.
cls:c_14818 rdfs:label "工事中止勧告"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "工事を中止していること"@ja.
kg:id_9 rdf:type cls:c_13838.
cls:c_13838 rdfs:label "工事中止"@ja.
kg:id_1 prop:effect kg:id_9.
kg:id_10 rdfs:label "北海道"@ja.
kg:id_10 rdf:type cls:c_10935.
cls:c_10935 rdfs:label "行政"@ja.
kg:id_11 rdfs:label "森林法違反として一部工事の中止を勧告"@ja.
kg:id_11 rdf:type cls:c_14818.
kg:id_10 prop:contermeasure kg:id_11.
kg:id_12 rdfs:label "北海道の担当課"@ja.
kg:id_12 rdf:type cls:c_14937.
cls:c_14937 rdfs:label "行政部局"@ja.
kg:id_13 rdfs:label "土壌汚染対策法の届け出の有無や内容、事業者名公表について答えない対応"@ja.
kg:id_13 rdf:type cls:c_14938.
cls:c_14938 rdfs:label "回答拒否"@ja.
kg:id_12 prop:contermeasure kg:id_13.
kg:st_1 rdfs:label "釧路市議の木村隼人氏"@ja.
kg:st_1 rdfs:type cls:st_97.
cls:st_97 rdfs:label "地方議員"@ja.
kg:op_1 prop:content "道の担当課への照会で違反が判明したと説明"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "道循環型社会推進課への電話照会で説明を受けた"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "事業者が土壌汚染対策法に違反して工事していたと明らかにした"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "道循環型社会推進課"@ja.
kg:st_2 rdfs:type cls:st_12.
cls:st_12 rdfs:label "行政部局"@ja.
kg:op_4 prop:content "法に公表規定がないため事実関係を含めて答えられない"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業者の日本エコロジー（大阪市）が土壌汚染対策法に違反して工事を行っていた。北海道への届け出を期限から半年以上提出していなかった"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "土壌汚染対策法は0.3ヘクタール以上の盛り土や掘削などを行う事業者に、工事着手の30日前までに都道府県知事への届け出を求めている。日本エコロジーは3月17日に盛り土工事に着手したとしている"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "同社は30日前の2月15日が期限の届け出を9月5日に提出。木村氏が今月上旬に道循環型社会推進課に電話で照会し、説明を受けた"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "日本エコロジーは、道の許可を得ずに0.5ヘクタールを上回る森林を伐採し、森林法に違反するとして"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:text-txt_contents "9月17日には盛り土規制法に基づく道への届け出が未提出だったことも判明した"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "木村隼人氏は9日、北海道新聞の取材に対し、事業者の日本エコロジー（大阪市）が土壌汚染対策法に違反して工事を行っていたと明らかにした"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:text-txt_contents "森林法に違反するとして9月2日に道から一部工事の中止勧告を受け"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:text-txt_contents "工事を中止している"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "森林法に違反するとして9月2日に道から一部工事の中止勧告を受け"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "同課は取材に事実関係を含めて「答えられない」とし、その理由を「土壌汚染対策法に届け出の有無や内容、事業者名公表などの規定がない」と説明している"@ja.
}
