kg:st_1 rdfs:label "再エネ事業の外資参入に詳しい関係者"@ja.
kg:st_1 rdf:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_1 prop:content "太陽光パネル価格の低下で日本の再エネ市場は安定した投資案件として人気が高い"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "日本の再エネ市場は安定した投資案件として人気が高い"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "資金力で国内企業は勝てず今後も外資の割合は増える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "神戸国際大の中村智彦教授"@ja.
kg:st_2 rdf:type cls:st_105.
cls:st_105 rdfs:label "研究者"@ja.
kg:op_4 prop:content "事前チェック権限を強めトラブル予防に注力すべきだ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "建設と売電で業者が異なると苦情の申し入れ先が分からず住民が泣き寝入りするケースも増えると懸念する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "既に約2割は外資で合弁会社も含めると4割に達する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "住民が泣き寝入りするケースも増えると懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "苦情の申し入れ先が分からなくなると懸念する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "住民が泣き寝入りするケースも増えるだろうと懸念する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:st_3 rdfs:label "専門家"@ja.
kg:st_3 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_10 prop:content "建設可能な区域を分けるゾーニングを提案する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "市町村に開発可能エリアを設定できる権限を与える必要がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "事前チェックの権限を強めトラブル予防に注力する必要がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "国内のメガソーラーは太陽光パネルの価格低下やFITもあり、採算が見込めるため外資の参入も多い一方"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "国内のメガソーラーは太陽光パネルの価格低下やFITもあり、採算が見込めるため外資の参入も多い一方"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "再エネ事業の外資参入に詳しい関係者は「太陽光パネルの価格も下がっており、安定した投資案件として日本の再エネ市場は人気が高い。資金力で国内企業は勝てず、既に約2割は外資、合弁会社も含めると4割に達し、今後も割合は増える」とみる"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "特に道東は、世界銀行の20年のリポートで「豊富なポテンシャルがある」とされ、世界的に注目されている"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "適地減少により、全国で開発競争に伴うトラブルも相次ぐ"@ja.
<< kg:id_6 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "外資も加わった適地確保の競争で、景観や環境上のトラブルになりにくい土地は少ない"@ja.
<< kg:id_6 prop:cause kg:id_9 >>
    prop:text-txt_contents "外資も加わった適地確保の競争で、景観や環境上のトラブルになりにくい土地は少ない"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:text-txt_contents "日本エコロジーは釧路市の計画を巡り、森林法違反を理由に道から一部工事の中止勧告を受けた"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "山口県下関市での太陽光発電施設建設を巡っても24年12月に大阪府から建設業法違反で処分されている"@ja.
<< kg:id_12 prop:cause kg:id_14 >>
    prop:text-txt_contents "府によると、同社は許可を受けずに電気工事業務を請け負った"@ja.
<< kg:id_12 prop:cause kg:id_15 >>
    prop:text-txt_contents "森林造成で適切な措置を取らず"@ja.
<< kg:id_16 prop:cause kg:id_15 >>
    prop:text-txt_contents "森林造成で適切な措置を取らず、大雨の際に土砂を近隣に流出させた"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:text-txt_contents "大雨の際に土砂を近隣に流出させた"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "外資系とみられるのがこのうち少なくとも約2割に上る"@ja.
<< kg:id_6 prop:effect kg:id_19 >>
    prop:text-txt_contents "全国で開発競争に伴うトラブルも相次ぐ"@ja.
<< kg:id_8 prop:effect kg:id_20 >>
    prop:text-txt_contents "外資も加わった適地確保の競争で、景観や環境上のトラブルになりにくい土地は少ない"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "釧路湿原などの国立公園周辺といった地元とのあつれきも予想される土地でも開発が行われている"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "建設と売電で業者が異なると、苦情の申し入れ先が分からず"@ja.
<< kg:id_23 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "住民が泣き寝入りするケースも増えるだろう"@ja.
<< kg:id_12 prop:effect kg:id_26 >>
    prop:text-txt_contents "37日間の営業停止などとなった"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:text-txt_contents "同社は電気工事の無許可請負の発覚後にいったん、廃業し電気工事業者として許可を再取得している"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:text-txt_contents "政府は規制強化の検討を始めており"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "専門家は建設可能な区域を分けるゾーニングを提案している"@ja.
<< kg:id_29 prop:countermeasure kg:id_32 >>
    prop:text-txt_contents "環境省はトラブル防止に向け、複数の法改正を視野に入れており"@ja.
<< kg:id_29 prop:countermeasure kg:id_33 >>
    prop:text-txt_contents "関係省庁連絡会議を立ち上げた"@ja.
<< kg:id_29 prop:countermeasure kg:id_34 >>
    prop:text-txt_contents "種の保存法でも罰則の新設も視野に検討を進める"@ja.
<< kg:id_29 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "市町村に開発可能エリアを設定できる権限を与えるとともに"@ja.
<< kg:id_29 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "事前チェックの権限を強め、トラブルをどう予防するかに注力する必要がある"@ja.
}
