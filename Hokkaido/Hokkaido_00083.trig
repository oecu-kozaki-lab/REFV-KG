PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00083> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "希少猛禽類の生息"@ja.
kg:id_1 rdf:type cls:c_14183.
cls:c_14183 rdfs:label "希少生物"@ja.
kg:id_2 rdfs:label "釧路湿原国立公園周辺で太陽光発電所の建設が相次いでいること"@ja.
kg:id_2 rdf:type cls:c_14564.
cls:c_14564 rdfs:label "太陽光発電所建設"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "太陽光発電所の建設"@ja.
kg:id_3 rdf:type cls:c_14564.
kg:id_4 rdfs:label "市街化調整区域を特別保全区域に指定"@ja.
kg:id_4 rdf:type cls:c_14683.
cls:c_14683 rdfs:label "保全区域指定"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "事業者に生息調査などを求める"@ja.
kg:id_5 rdf:type cls:c_14969.
cls:c_14969 rdfs:label "生息調査要求"@ja.
kg:id_3 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "影響があると判断すれば建設を認めない"@ja.
kg:id_6 rdf:type cls:c_14684.
cls:c_14684 rdfs:label "建設不許可"@ja.
kg:id_3 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "希少猛禽類の生息地に影響が及ぶ可能性"@ja.
kg:id_7 rdf:type cls:c_13180.
cls:c_13180 rdfs:label "生息地影響"@ja.
kg:id_3 prop:effect kg:id_7.
kg:st_1 rdfs:label "猛禽類医学研究所の斉藤慶輔代表"@ja.
kg:st_1 rdf:type cls:st_105.
cls:st_105 rdfs:label "研究者"@ja.
kg:op_1 prop:content "事業者による生息調査の評価時に参考にしてほしい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_2 prop:content "非常に有効なデータで、希少な野生生物を守りたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "釧路湿原国立公園周辺で太陽光発電所の建設が相次いでいることを巡り、猛禽類医学研究所（釧路市）は20日、釧路市内の市街化調整区域のほぼ全域で、絶滅危惧種チュウヒなど希少猛禽類の生息を確認したと明らかにした"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "市の太陽光発電所の建設を規制する条例は、チュウヒなど計5種の希少生物が生息する可能性の高い市街化調整区域を「特別保全区域」に指定"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "ここで発電所を計画する事業者に生息調査などを求め、影響があると判断すれば建設を認めない。斉藤代表は「事業者による生息調査を評価する際に参考にしてほしい」と要望した"@ja.
<< kg:id_3 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "ここで発電所を計画する事業者に生息調査などを求め、影響があると判断すれば建設を認めない"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "市は「非常に有効なデータで、希少な野生生物を守りたい」としている。ここで発電所を計画する事業者に生息調査などを求め、影響があると判断すれば建設を認めない"@ja.
}
