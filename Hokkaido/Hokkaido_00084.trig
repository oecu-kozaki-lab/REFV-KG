PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00084> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原周辺のメガソーラー建設計画"@ja.
kg:id_1 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "道の許可を得ずに0.5ヘクタールを上回る森林を伐採した森林法違反"@ja.
kg:id_2 rdf:type cls:c_979.
cls:c_979 rdfs:label "法令違反"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "盛り土規制法に基づく道への届け出未提出"@ja.
kg:id_3 rdf:type cls:c_979.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "太陽光発電事業者全体が悪いという誤ったイメージの拡大"@ja.
kg:id_4 rdf:type cls:c_14970.
cls:c_14970 rdfs:label "誤解の拡大"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "湿原の破壊後の原状回復が非常に困難"@ja.
kg:id_5 rdf:type cls:c_13226.
cls:c_13226 rdfs:label "環境破壊"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "事業の中止命令"@ja.
kg:id_6 rdf:type cls:c_3956.
cls:c_3956 rdfs:label "事業停止"@ja.
kg:id_1 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "法令違反の事例を厳しく罰すること"@ja.
kg:id_7 rdf:type cls:c_14971.
cls:c_14971 rdfs:label "処罰強化"@ja.
kg:id_1 prop:contermeasure kg:id_7.
kg:st_1 rdfs:label "登山家の野口健さん"@ja.
kg:st_1 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_1 prop:content "法令違反が相次いでいるため事業の中止命令を出すべきだと求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "法令違反が相次いでいるため事業の中止命令を出すべきだと求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "法令違反を厳しく罰さないと業界全体への誤解が広がると指摘する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "猛禽類医学研究所（釧路市）の斉藤慶輔代表"@ja.
kg:st_2 rdfs:type cls:st_37.
kg:op_4 prop:content "湿原を一度破壊すると原状回復は非常に困難だと訴える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "知事は事業の中止命令を出すべきだと強い措置を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "法令違反事例を厳しく罰する必要があると指摘する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "同社は釧路市北斗での発電所の計画を巡り、道の許可を得ずに0.5ヘクタールを上回る森林を伐採し、森林法違反が発覚"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "盛り土規制法に基づく道への届け出も未提出だった"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "野口さんは「法令違反の事例を厳しく罰さないと『太陽光発電事業者全体が悪い』という誤ったイメージを広めてしまう」と指摘した"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "斉藤慶輔代表も講演し、「湿原を一度破壊してしまうと原状回復させるのは非常に困難」と訴えた"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "「法令違反が相次いで発覚しているのに鈴木直道知事はなぜ（事業の）中止命令を出さないのか」と強い措置を求めた"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "野口さんは「法令違反の事例を厳しく罰さないと『太陽光発電事業者全体が悪い』という誤ったイメージを広めてしまう」と指摘した"@ja.
}
