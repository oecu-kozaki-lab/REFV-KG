PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00087> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "太陽光発電所建設"@ja.
kg:id_1 rdf:type cls:c_6284.
cls:c_6284 rdfs:label "開発事業"@ja.
kg:id_2 rdfs:label "盛り土工事の着工時期や森林伐採の完了時期に疑義があること"@ja.
kg:id_2 rdf:type cls:c_14980.
cls:c_14980 rdfs:label "工事時期への疑義"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "無許可開発の疑い"@ja.
kg:id_3 rdf:type cls:c_14981.
cls:c_14981 rdfs:label "無許可開発の疑い"@ja.
kg:id_4 rdfs:label "4月以降に盛り土工事に着工した可能性"@ja.
kg:id_4 rdf:type cls:c_14982.
cls:c_14982 rdfs:label "着工時期の可能性"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "道への届け出が期限の4月22日までになかったこと"@ja.
kg:id_5 rdf:type cls:c_13126.
cls:c_13126 rdfs:label "届出未実施"@ja.
kg:id_3 prop:cause kg:id_5.
kg:id_6 rdfs:label "3月時点で盛り土工事をしている様子が衛星写真で確認できなかったこと"@ja.
kg:id_6 rdf:type cls:c_14983.
cls:c_14983 rdfs:label "工事未確認"@ja.
kg:id_3 prop:cause kg:id_6.
kg:id_7 rdfs:label "森林伐採完了時期への疑義"@ja.
kg:id_7 rdf:type cls:c_14984.
cls:c_14984 rdfs:label "伐採時期への疑義"@ja.
kg:id_8 rdfs:label "4月の衛星写真で伐採の様子が確認できなかったこと"@ja.
kg:id_8 rdf:type cls:c_14985.
cls:c_14985 rdfs:label "伐採未確認"@ja.
kg:id_7 prop:cause kg:id_8.
kg:id_9 rdfs:label "4月以降の盛り土工事着工"@ja.
kg:id_9 rdf:type cls:c_14986.
cls:c_14986 rdfs:label "工事着工"@ja.
kg:id_10 rdfs:label "道の許可が必要になる"@ja.
kg:id_10 rdf:type cls:c_2466.
cls:c_2466 rdfs:label "許可必要"@ja.
kg:id_9 prop:effect kg:id_10.
kg:id_11 rdfs:label "北海道に盛り土工事の着工時期の再調査を求める"@ja.
kg:id_11 rdf:type cls:c_14777.
cls:c_14777 rdfs:label "再調査要求"@ja.
kg:id_1 prop:contermeasure kg:id_11.
kg:id_12 rdfs:label "衛星写真を北海道に提供する"@ja.
kg:id_12 rdf:type cls:c_14987.
cls:c_14987 rdfs:label "資料提供"@ja.
kg:id_3 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "事業者に問い合わせて推移を見守る"@ja.
kg:id_13 rdf:type cls:c_14988.
cls:c_14988 rdfs:label "状況確認"@ja.
kg:id_7 prop:contermeasure kg:id_13.
kg:st_1 rdfs:label "釧路市議の木村隼人氏"@ja.
kg:st_1 rdfs:type cls:st_97.
cls:st_97 rdfs:label "地方議員"@ja.
kg:op_1 prop:content "北海道に再調査を求めるべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "無許可開発だった可能性を主張"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "3月着工の記載に疑義がある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "伐採完了時期の記載に疑義がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "北海道に再調査を要請"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "衛星写真を道に提供すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市の鶴間秀典市長"@ja.
kg:st_2 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_7 prop:content "提出資料や情報を道に提供する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "事業者に問い合わせて推移を見守りたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "同社の盛り土工事の着工時期や森林伐採の完了時期に疑義があるとして、釧路市の鶴間秀典市長に対し、所管する北海道に再調査を求めるよう要請した。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "4月以降に着工したとなると道の許可が必要となるため「無許可開発だったのでは」と主張し"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:text-txt_contents "ただ、道への届け出が期限の4月22日までになく、同社は道の指摘を受け9月5日に届け出をした。"@ja.
<< kg:id_3 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "木村市議が衛星写真を確認したところ、3月時点で盛り土工事をしている様子が確認できず、確認できたのは6月以降だったと指摘。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "同社が市に提出した「伐採に係る森林の状況報告書」では伐採完了が3月末と記載されているが、木村氏は4月の衛星写真で伐採の様子が確認できないとした。"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:text-txt_contents "4月以降に着工したとなると道の許可が必要となるため"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "盛り土工事の着工時期の再調査を北海道に求める要請書を鶴間秀典市長に手渡す"@ja.
<< kg:id_3 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "鶴間市長にこの衛星写真を道に提供するよう求めた。鶴間市長は、木村市議が提出した資料や情報を道に提供するとした。"@ja.
<< kg:id_7 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "鶴間市長は「事業者に問い合わせており、推移を見守りたい」と述べた。"@ja.
}
