kg:id_3 rdf:type cls:c_13088.
cls:c_13088 rdfs:label "生物影響"@ja.
kg:id_4 rdfs:label "日本エコロジーが約6600枚のソーラーパネルを年内にも設置する計画"@ja.
kg:id_4 rdf:type cls:c_14772.
cls:c_14772 rdfs:label "太陽光発電計画"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "希少生物への影響が懸念されている"@ja.
kg:id_5 rdf:type cls:c_13088.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "環境省が同公園の拡張を検討"@ja.
kg:id_6 rdf:type cls:c_14989.
cls:c_14989 rdfs:label "保護区域拡張"@ja.
kg:id_1 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "太陽光発電所の設置を原則禁止する区域や届け出が必要なエリアを広げる"@ja.
kg:id_7 rdf:type cls:c_14990.
cls:c_14990 rdfs:label "設置規制拡大"@ja.
kg:id_1 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "2026年度末をめどに地元自治体と協議の上で拡張エリアを定める"@ja.
kg:id_8 rdf:type cls:c_14991.
cls:c_14991 rdfs:label "区域協議"@ja.
kg:id_1 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "関係省庁会議で対策を検討し年内にもまとめる"@ja.
kg:id_9 rdf:type cls:c_6444.
cls:c_6444 rdfs:label "対策検討"@ja.
kg:id_1 prop:contermeasure kg:id_9.
kg:id_10 rdfs:label "建設済みの発電設備"@ja.
kg:id_10 rdf:type cls:c_7409.
cls:c_7409 rdfs:label "発電設備"@ja.
kg:id_11 rdfs:label "規制が及ばない"@ja.
kg:id_11 rdf:type cls:c_14992.
cls:c_14992 rdfs:label "規制対象外"@ja.
kg:id_10 prop:effect kg:id_11.
kg:id_12 rdfs:label "4市町村とエリア拡張に向けた協議を始めた"@ja.
kg:id_12 rdf:type cls:c_14991.
kg:id_1 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "生息地保護を理由に開発を規制することなどを含む法改正を視野に議論を進めている"@ja.
kg:id_13 rdf:type cls:c_14993.
cls:c_14993 rdfs:label "法改正検討"@ja.
kg:id_1 prop:contermeasure kg:id_13.
kg:st_1 rdfs:label "環境省"@ja.
kg:st_1 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_1 prop:content "地元自治体と協議して拡張エリアを定める方針"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "新たな建設を抑止する狙い"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "自治体の意向を踏まえて具体的なエリアを決める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "経済産業省や国土交通省が参加する関係省庁会議"@ja.
kg:st_2 rdfs:type cls:st_6.
kg:op_4 prop:content "エリア拡張とは別に対策を検討し年内にまとめる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "4市町村とエリア拡張に向けた協議を開始"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "種の保存法の検討会で法改正を視野に議論を進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "釧路湿原国立公園周辺で大規模太陽光発電所（メガソーラー）の建設が相次いでいる問題を受け"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "周辺の釧路市北斗では、日本エコロジー（大阪市）が約6600枚のソーラーパネルを年内にも設置する計画を立てており、希少生物への影響が懸念されている"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "周辺の釧路市北斗では、日本エコロジー（大阪市）が約6600枚のソーラーパネルを年内にも設置する計画を立てており、希少生物への影響が懸念されている"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "環境省が同公園の拡張を検討していることが30日、同省への取材で分かった"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "国立公園の拡張により、太陽光発電所の設置を原則禁止する区域や届け出が必要なエリアを広げ、新たな建設を抑止する狙い"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "2026年度末をめどに地元自治体と協議の上で拡張エリアを定める方針"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "エリア拡張とは別に、経済産業省や国土交通省が参加する関係省庁会議で対策を検討し、年内にもまとめる"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:text-txt_contents "建設済みの発電設備に対しては規制が及ばないため"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "環境省は9月、釧路湿原国立公園周辺でメガソーラー建設が相次いだことを受けて釧路湿原を抱える4市町村とエリア拡張に向けた協議を始めた"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "環境省は国立公園の指定エリアの拡張に加え、種の保存法の検討会で、生息地保護を理由に開発を規制することなどを含む法改正を視野に議論を進めている"@ja.
}
