    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "物価高で市民生活は苦しい"@ja.
<< kg:id_14 prop:effect kg:id_32 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "太陽光発電条例や補正予算案の否決など、良くも悪くも釧路市政への注目度は高まったと思う"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "前市政は議会答弁を1字1句確認するなど市職員に大きな負荷がかかっていた"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "鶴間市長は大型連休の取得など職員の働き方改革を進めているが、市役所内に緩みが生じていると感じる"@ja.
<< kg:id_37 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "9月の市議会で成立した太陽光発電の建設を規制する条例"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "ふるさと納税の倍増に向け「マーケティング戦略室」を立ち上げ、専門人員を置いた手法は正しいが、結果が出ていない"@ja.
<< kg:id_37 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "JR釧路駅周辺の高架化に伴い整備する高架下道路の形状を「直線」と決断した"@ja.
<< kg:id_37 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "公約に掲げた大学のサテライトキャンパスの誘致は任期中に成し遂げてほしい"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "市独自でも対策を実施すべきだろう"@ja.
<< kg:id_43 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "鶴間市長は大型連休の取得など職員の働き方改革を進めている"@ja.
}
