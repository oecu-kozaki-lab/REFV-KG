    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市議会での答弁に熱意がこもっていない。質問しても同じ答弁の繰り返しで議論に深まりがない"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
