    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "釧路短期大の存続問題は、市長の説明不足で管内の首長たちとの意思疎通が図られていないようだ"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
