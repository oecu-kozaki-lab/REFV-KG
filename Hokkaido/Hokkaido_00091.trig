<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "質問しても同じ答弁の繰り返しで議論に深まりがない"@ja.
<< kg:id_8 prop:effect kg:id_28 >>
