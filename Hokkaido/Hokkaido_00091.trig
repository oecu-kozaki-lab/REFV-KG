    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "太陽光発電条例や補正予算案の否決など、良くも悪くも釧路市政への注目度は高まったと思う"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
