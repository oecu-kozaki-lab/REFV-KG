PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00092> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "土壌汚染調査計画が受理されないこと"@ja.
kg:id_1 rdf:type cls:c_15045.
cls:c_15045 rdfs:label "計画の不受理"@ja.
kg:id_2 rdfs:label "内容が不十分"@ja.
kg:id_2 rdf:type cls:c_15046.
cls:c_15046 rdfs:label "内容の不備"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "調査の着手日や調査地点などに不明瞭な点があったこと"@ja.
kg:id_3 rdf:type cls:c_15047.
cls:c_15047 rdfs:label "計画の不明瞭"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "釧路湿原周辺のメガソーラー計画"@ja.
kg:id_4 rdf:type cls:c_12240.
cls:c_12240 rdfs:label "開発計画"@ja.
kg:id_5 rdfs:label "土壌汚染対策法違反など複数の法令違反"@ja.
kg:id_5 rdf:type cls:c_979.
cls:c_979 rdfs:label "法令違反"@ja.
kg:id_4 prop:cause kg:id_5.
kg:id_6 rdfs:label "土壌汚染の有無に関する調査が必要になる"@ja.
kg:id_6 rdf:type cls:c_15048.
cls:c_15048 rdfs:label "汚染調査"@ja.
kg:id_4 prop:effect kg:id_6.
kg:id_7 rdfs:label "事業者に再提出が求められる"@ja.
kg:id_7 rdf:type cls:c_15049.
cls:c_15049 rdfs:label "再提出要求"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "25、26回指導を繰り返しても対応されない状況"@ja.
kg:id_8 rdf:type cls:c_15050.
cls:c_15050 rdfs:label "指導未対応"@ja.
kg:id_4 prop:effect kg:id_8.
kg:id_9 rdfs:label "北海道"@ja.
kg:id_9 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_10 rdfs:label "土壌汚染調査の実施計画の再提出要求"@ja.
kg:id_10 rdf:type cls:c_15049.
kg:id_9 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "20日までに調査の実施計画を出すよう指導"@ja.
kg:id_11 rdf:type cls:c_15051.
cls:c_15051 rdfs:label "提出指導"@ja.
kg:id_9 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "毅然と対応していく"@ja.
kg:id_12 rdf:type cls:c_15052.
cls:c_15052 rdfs:label "毅然対応"@ja.
kg:id_9 prop:countermeasure kg:id_12.
kg:st_1 rdfs:label "道関係者"@ja.
kg:st_1 rdf:type cls:st_209.
cls:st_209 rdfs:label "行政関係者"@ja.
kg:op_1 prop:content "調査計画の着手日や調査地点が不明瞭で不十分とみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "鈴木直道知事"@ja.
kg:st_2 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_2 prop:content "繰り返し指導しても対応されず毅然と対応すると述べる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "繰り返し指導でも対応されないため毅然と対応する考え"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "しかし道は内容が不十分だとして受理せず、再提出を求めた。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "道関係者によると、同社は20日夜に実施計画を提出したものの、調査の着手日や調査地点などに不明瞭な点があったという。"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:text-txt_contents "同社は釧路市北斗の民有地約4.3ヘクタールに約6600枚のソーラーパネルを設置する計画だが、土壌汚染対策法違反など複数の法令違反が判明。"@ja.
<< kg:id_4 prop:effect kg:id_6 >>
    prop:text-txt_contents "釧路湿原周辺で大規模太陽光発電所（メガソーラー）の建設を計画する日本エコロジー（大阪市）は20日、土壌汚染の有無に関する調査の実施計画を北海道に提出した。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "しかし道は内容が不十分だとして受理せず、再提出を求めた。"@ja.
<< kg:id_4 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "鈴木直道知事は14日の記者会見で「25、26回指導を繰り返しても対応されない状況。毅然（きぜん）と対応していく」と述べていた。"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "しかし道は内容が不十分だとして受理せず、再提出を求めた。"@ja.
<< kg:id_9 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "道は13日、道庁で同社の松井政憲社長に調査の実施計画を20日までに出すよう指導していた。"@ja.
<< kg:id_9 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "鈴木直道知事は14日の記者会見で「25、26回指導を繰り返しても対応されない状況。毅然（きぜん）と対応していく」と述べていた。"@ja.
}
