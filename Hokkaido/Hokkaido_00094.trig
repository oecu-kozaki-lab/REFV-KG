PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00094> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原国立公園周辺で予定されている大規模太陽光発電所（メガソーラー）の建設計画"@ja.
kg:id_1 rdf:type cls:c_390.
cls:c_390 rdfs:label "発電計画"@ja.
kg:id_2 rdfs:label "タンチョウなどの動植物への影響"@ja.
kg:id_2 rdf:type cls:c_225.
cls:c_225 rdfs:label "生態系影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "建設中止"@ja.
kg:id_3 rdf:type cls:c_14657.
cls:c_14657 rdfs:label "建設中止"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "事業者に対する法令順守の要請"@ja.
kg:id_4 rdf:type cls:c_15056.
cls:c_15056 rdfs:label "法令順守要請"@ja.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "住民との合意形成がない事業の中止要請"@ja.
kg:id_5 rdf:type cls:c_15057.
cls:c_15057 rdfs:label "事業中止要請"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "今ある法律の中で毅然と事業者にあたる"@ja.
kg:id_6 rdf:type cls:c_7583.
cls:c_7583 rdfs:label "行政対応"@ja.
kg:id_1 prop:contermeasure kg:id_6.
kg:st_1 rdfs:label "釧路自然保護協会など6団体"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "影響評価が不十分なまま工事が進められていると指摘"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "建設中止を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "道が事業者に法令順守を促すよう要望"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "住民との合意形成がない事業は中止を求めるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "北海道 加納孝之副知事"@ja.
kg:st_2 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_5 prop:content "署名を重く受け止め法律の範囲で毅然と対応したい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "署名では建設予定地で国の特別天然記念物のタンチョウなどの動植物が生息している中、影響評価が不十分なまま事業者が工事を進めていると指摘"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "釧路湿原国立公園周辺で予定されている大規模太陽光発電所（メガソーラー）の建設計画を巡り、釧路自然保護協会など6団体が11日、建設中止を求める17万5948人分の署名を道に提出した"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "道が事業者に対して法令順守を促し、住民との合意形成がない事業については中止を求めることを要望している"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "道が事業者に対して法令順守を促し、住民との合意形成がない事業については中止を求めることを要望している"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "同協会の神田房行会長から署名を受け取った加納孝之副知事は「署名を重く受け止めている。今ある法律の中で毅然（きぜん）と事業者にあたっていきたい」と述べた"@ja.
}
