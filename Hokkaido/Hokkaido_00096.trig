kg:op_5 prop:content "周囲からパネルが見えないようにすると説明した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "着工前にもう一度説明会を開いてほしいと要望した"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "住民からは生活や国の特別天然記念物タンチョウへの影響が懸念されるとして建設に反対する声が上がった。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "住民からは生活や国の特別天然記念物タンチョウへの影響が懸念されるとして建設に反対する声が上がった。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "同社の担当者は月内に着工するとの考えを示した上で「フェンスや街路樹を設け、周囲からパネルが見えないようにする」と理解を求めた。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "同社の担当者は月内に着工するとの考えを示した上で「フェンスや街路樹を設け、周囲からパネルが見えないようにする」と理解を求めた。"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "同社の担当者は月内に着工するとの考えを示した上で「フェンスや街路樹を設け、周囲からパネルが見えないようにする」と理解を求めた。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "同社は大楽毛地区の約4.4ヘクタールの民有地に太陽光パネル約5800枚を設置する方針。"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:text-txt_contents "周辺には住宅や幼稚園などがあり、タンチョウの飛来も確認されている。"@ja.
<< kg:id_7 prop:cause kg:id_10 >>
    prop:text-txt_contents "周辺には住宅や幼稚園などがあり、タンチョウの飛来も確認されている。"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "住民からは「建設してほしくないのが住民の総意」、「着工前にもう一度説明会を開いてほしい」との意見や要望が出た。"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:text-txt_contents "市北斗では、森林法違反など複数の法令違反が発覚している。"@ja.
