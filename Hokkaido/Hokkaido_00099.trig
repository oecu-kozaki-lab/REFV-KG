PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00099> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "メガソーラーの乱立"@ja.
kg:id_1 rdf:type cls:c_9200.
cls:c_9200 rdfs:label "太陽光発電施設"@ja.
kg:id_2 rdfs:label "釧路湿原国立公園周辺での設置増加"@ja.
kg:id_2 rdf:type cls:c_15075.
cls:c_15075 rdfs:label "設置増加"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "釧路市"@ja.
kg:id_3 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_4 rdfs:label "太陽光発電施設の建設を許可制"@ja.
kg:id_4 rdf:type cls:c_15076.
cls:c_15076 rdfs:label "建設許可制"@ja.
kg:id_3 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "事前協議を義務付け"@ja.
kg:id_5 rdf:type cls:c_14911.
cls:c_14911 rdfs:label "事前協議義務"@ja.
kg:id_3 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "設置を規制する条例を制定"@ja.
kg:id_6 rdf:type cls:c_15077.
cls:c_15077 rdfs:label "設置規制条例"@ja.
kg:id_3 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "市内全域を対象に許可制"@ja.
kg:id_7 rdf:type cls:c_15076.
kg:id_3 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "希少な野生生物5種を特定保全種に指定"@ja.
kg:id_8 rdf:type cls:c_14790.
cls:c_14790 rdfs:label "保全種指定"@ja.
kg:id_3 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "5種が生息する可能性が高いエリアを特別保全区域とする"@ja.
kg:id_9 rdf:type cls:c_14683.
cls:c_14683 rdfs:label "保全区域指定"@ja.
kg:id_3 prop:contermeasure kg:id_9.
kg:id_10 rdfs:label "事業者に生息調査を求める"@ja.
kg:id_10 rdf:type cls:c_14969.
cls:c_14969 rdfs:label "生息調査要求"@ja.
kg:id_3 prop:contermeasure kg:id_10.
kg:id_11 rdfs:label "事業者に保全計画の作成を求める"@ja.
kg:id_11 rdf:type cls:c_15078.
cls:c_15078 rdfs:label "保全計画要求"@ja.
kg:id_3 prop:contermeasure kg:id_11.
kg:id_12 rdfs:label "メガソーラー建設計画"@ja.
kg:id_12 rdf:type cls:c_8845.
cls:c_8845 rdfs:label "建設計画"@ja.
kg:id_13 rdfs:label "自然環境との調和の必要性"@ja.
kg:id_13 rdf:type cls:c_15079.
cls:c_15079 rdfs:label "環境調和必要"@ja.
kg:id_12 prop:effect kg:id_13.
kg:st_1 rdfs:label "釧路市環境保全課"@ja.
kg:st_1 rdfs:type cls:st_211.
cls:st_211 rdfs:label "行政組織"@ja.
kg:op_1 prop:content "自然環境と調和し法令順守がなされているか協議したい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "市は釧路湿原国立公園周辺でのメガソーラーの乱立を受け、設置を規制する条例を制定し、市内全域を対象に許可制とした。"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:text-txt_contents "昨年10月施行の条例で太陽光発電施設の建設を許可制とし"@ja.
<< kg:id_3 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "事前協議を義務付けた釧路市に、東京の事業者が協議を届け出た"@ja.
<< kg:id_3 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "市は釧路湿原国立公園周辺でのメガソーラーの乱立を受け、設置を規制する条例を制定し"@ja.
<< kg:id_3 prop:contermeasure kg:id_7 >>
    prop:text-txt_contents "市内全域を対象に許可制とした。"@ja.
<< kg:id_3 prop:contermeasure kg:id_8 >>
    prop:text-txt_contents "国の特別天然記念物タンチョウなど希少な野生生物5種を特定保全種に指定。"@ja.
<< kg:id_3 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "市街化調整区域のうち、5種が生息する可能性が高いエリアを特別保全区域とし"@ja.
<< kg:id_3 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "事業者には事前協議の段階で生息調査や保全計画の作成を求める。"@ja.
<< kg:id_3 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "事業者には事前協議の段階で生息調査や保全計画の作成を求める。"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "市環境保全課は「建設計画が自然環境と調和し、法令順守がなされているかしっかりと協議していきたい」としている。"@ja.
}
