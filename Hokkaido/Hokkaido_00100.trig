kg:id_8 rdf:type cls:c_15081.
cls:c_15081 rdfs:label "主体参画"@ja.
kg:id_5 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "事業者に対し開発行為を控えるよう依頼する"@ja.
kg:id_9 rdf:type cls:c_15082.
cls:c_15082 rdfs:label "開発抑制要請"@ja.
kg:id_5 prop:contermeasure kg:id_9.
