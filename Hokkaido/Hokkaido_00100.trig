kg:id_10 rdf:type cls:c_14564.
kg:id_11 rdfs:label "太陽光パネルの設置禁止や届け出が必要となるエリアを広げるため同公園の拡張を検討する"@ja.
kg:id_11 rdf:type cls:c_15083.
cls:c_15083 rdfs:label "公園拡張検討"@ja.
