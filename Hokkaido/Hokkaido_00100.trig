kg:st_1 rdfs:label "釧路市"@ja.
kg:st_1 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "貴重な自然環境の保全と経済活動の両立を目指す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "貴重な生態環境の維持を進める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "人と自然が共生した社会の実現を目指す"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "人と自然が共生した社会の実現を目指す"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "人と自然が共生した社会の実現を目指す"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "共生が損なわれるような開発は抑えるべきだとする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "環境省"@ja.
kg:st_2 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_7 prop:content "設置禁止や届け出が必要な区域を広げる方針"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "公園南側の保全推進地域を拡張区域の意向として示す"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "釧路湿原国立公園周辺で大規模太陽光発電所（メガソーラー）の建設が相次ぎ、希少生物への影響が懸念されている"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "釧路市は20日、貴重な自然環境の保全と経済活動の両立を目指した「市生物多様性地域戦略」の素案を公表した。公園の南側や武佐の森など6地域を保全推進地域とし"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "貴重な生態環境の維持に向けて国や関係機関などと対策を講じる"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "「人と自然が共生した社会」の実現に向け、①健全な生態系の保全"@ja.
<< kg:id_5 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "「人と自然が共生した社会」の実現に向け、②自然資源の保全と持続可能な利活用"@ja.
<< kg:id_5 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "「人と自然が共生した社会」の実現に向け、③多様な主体の参画と貢献"@ja.
<< kg:id_5 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "各エリアで共生が損なわれるような開発計画の情報を収集した場合、事業者に対し開発行為を控えるよう依頼する"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "環境省が太陽光パネルの設置禁止や届け出が必要となるエリアを広げようと同公園の拡張を検討している"@ja.
<< kg:id_10 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "釧路市は素案で保全推進地域とした公園南側のエリアを国に示したという"@ja.
}
