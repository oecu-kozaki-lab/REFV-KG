PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00102> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "事業者が倒産した場合"@ja.
kg:id_1 rdf:type cls:c_15090.
cls:c_15090 rdfs:label "事業者の倒産"@ja.
kg:id_2 rdfs:label "廃棄費用の回収が困難になる"@ja.
kg:id_2 rdf:type cls:c_15091.
cls:c_15091 rdfs:label "費用回収困難"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "条例改正"@ja.
kg:id_3 rdf:type cls:c_3925.
cls:c_3925 rdfs:label "制度改正"@ja.
kg:id_4 rdfs:label "保証金の金融機関への預け入れ義務化"@ja.
kg:id_4 rdf:type cls:c_15092.
cls:c_15092 rdfs:label "保証金預託義務"@ja.
kg:id_3 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "市との質権設定契約の義務化"@ja.
kg:id_5 rdf:type cls:c_15093.
cls:c_15093 rdfs:label "質権設定義務"@ja.
kg:id_3 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "廃棄費用を回収できるようにする必要がある"@ja.
kg:id_6 rdf:type cls:c_15094.
cls:c_15094 rdfs:label "費用回収確保"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "廃棄費用を確実に確保できる"@ja.
kg:id_7 rdf:type cls:c_15095.
cls:c_15095 rdfs:label "費用確保"@ja.
kg:id_3 prop:effect kg:id_7.
kg:st_1 rdfs:label "鶴間秀典市長"@ja.
kg:st_1 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "確実に廃棄費用を確保できる手法"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "確実に廃棄費用を確保できる手法"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "豊かな自然を後世に残したい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "昨年10月に施行した条例は事業者に廃棄費用の積み立てを求めているが、倒産した場合などは廃棄費用の回収が困難になる恐れがあった"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業者に対し、ソーラーパネルの廃棄費用に相当する保証金の金融機関への預け入れと、市との質権設定契約を義務付ける"@ja.
<< kg:id_3 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業者に対し、ソーラーパネルの廃棄費用に相当する保証金の金融機関への預け入れと、市との質権設定契約を義務付ける"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "事業者が倒産した場合などでも廃棄費用を回収できるようにするためで、12月下旬の施行を目指す"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "鶴間市長は「確実に廃棄費用を確保できる手法。釧路市の豊かな自然を後世に残していく」と述べた"@ja.
}
