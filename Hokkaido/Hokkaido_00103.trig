<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00103> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路のメガソーラー予定地の土壌汚染問題"@ja.
kg:id_1 rdf:type cls:c_14323.
cls:c_14323 rdfs:label "土壌汚染"@ja.
kg:id_2 rdfs:label "ヒ素の基準値超過"@ja.
kg:id_2 rdf:type cls:c_15096.
cls:c_15096 rdfs:label "有害物質超過"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "フッ素の基準値超過"@ja.
kg:id_3 rdf:type cls:c_15096.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "ホウ素の基準値超過"@ja.
kg:id_4 rdf:type cls:c_15096.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "北海道が調査命令を出した"@ja.
kg:id_5 rdf:type cls:c_15097.
cls:c_15097 rdfs:label "調査命令"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "7月16日までに詳しい状況調査と結果報告を求められた"@ja.
kg:id_6 rdf:type cls:c_15098.
cls:c_15098 rdfs:label "調査要求"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "再度土壌汚染が確認された場合は要措置区域に指定される可能性がある"@ja.
kg:id_7 rdf:type cls:c_15099.
cls:c_15099 rdfs:label "区域指定可能性"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "工事が中止された"@ja.
kg:id_8 rdf:type cls:c_13838.
cls:c_13838 rdfs:label "工事中止"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "北海道が土壌汚染対策法に基づく調査命令を出す"@ja.
kg:id_9 rdf:type cls:c_15097.
kg:id_1 prop:contermeasure kg:id_9.
kg:id_10 rdfs:label "詳しい状況調査と結果報告を求める"@ja.
kg:id_10 rdf:type cls:c_15098.
kg:id_1 prop:contermeasure kg:id_10.
kg:id_11 rdfs:label "汚染の除去などの措置を行う"@ja.
kg:id_11 rdf:type cls:c_15100.
cls:c_15100 rdfs:label "汚染除去"@ja.
kg:id_1 prop:contermeasure kg:id_11.
kg:id_12 rdfs:label "工事を中止する"@ja.
kg:id_12 rdf:type cls:c_13838.
kg:id_1 prop:contermeasure kg:id_12.
kg:st_1 rdfs:label "鈴木直道知事"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "結果判明まで工事中止を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "結果判明まで工事中止を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "有害物質のうちヒ素、フッ素、ホウ素の3項目が基準値を上回っていたことが判明した。ヒ素は雨などで溶け出すことを想定した溶出量が1リットル当たり0.012ミリグラム（基準値は同0.01ミリグラム）"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "有害物質のうちヒ素、フッ素、ホウ素の3項目が基準値を上回っていたことが判明した。フッ素は1ミリグラム（同0.8ミリグラム）"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "有害物質のうちヒ素、フッ素、ホウ素の3項目が基準値を上回っていたことが判明した。ホウ素は1.3ミリグラム（同1ミリグラム）だった"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "北海道は19日、日本エコロジー（大阪市）が釧路湿原周辺で計画する大規模太陽光発電所（メガソーラー）建設予定地で一部の特定有害物質が基準値を超過していた問題で、土壌汚染対策法に基づく調査命令を同社に出した"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "詳しい状況調査の実施と結果報告を7月16日までに求めている"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "その結果で再度、土壌汚染が確認された場合、汚染の除去などの措置が必要となる「要措置区域」に指定される可能性がある"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "同社は現在、工事を中止。鈴木直道知事は同日の定例記者会見で「結果が判明するまでの間は、工事の中止を求めていく」と述べた"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "北海道は19日、日本エコロジー（大阪市）が釧路湿原周辺で計画する大規模太陽光発電所（メガソーラー）建設予定地で一部の特定有害物質が基準値を超過していた問題で、土壌汚染対策法に基づく調査命令を同社に出した"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "19日に出した調査命令では、汚染の経緯も含むさらに詳しい調査と結果報告を求める"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "その結果で再度、土壌汚染が確認された場合、汚染の除去などの措置が必要となる"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "同社は現在、工事を中止。鈴木直道知事は同日の定例記者会見で「結果が判明するまでの間は、工事の中止を求めていく」と述べた"@ja.
}
