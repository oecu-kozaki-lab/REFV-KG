kg:st_1 rdfs:label "リエネウインドファーム松前"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "風という資源を活かして自然や地域と共存する社会を実現したい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "風を活かしたクリーンエネルギー創出を進めたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "再生可能エネルギー事業の推進と地域活性化を目指している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "風を身近に感じられる町のシンボルとして地域振興とまちづくりを進める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "町民と子供たちと一緒により良い未来を育みたい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "再生エネルギーを身近に感じられる新たなランドマークにしたい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "松城小学校3・5年生"@ja.
kg:st_2 rdf:type cls:st_202.
cls:st_202 rdfs:label "児童"@ja.
kg:op_7 prop:content "子供たちのアイデアを活かした制作に参加した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:st_3 rdfs:label "松前高校生と町内愛好家の方々"@ja.
kg:st_3 rdf:type cls:st_219.
cls:st_219 rdfs:label "学習者"@ja.
kg:op_8 prop:content "町オリジナルそば作りの探究学習を実施した"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:st_4 rdfs:label "松前高校生"@ja.
kg:st_4 rdf:type cls:st_219.
kg:op_9 prop:content "風と遊ぶフィールドとして本園のオープニングイベントを実施した"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:st_5 rdfs:label "観光物産協会と松前城等の歴史観光施設"@ja.
kg:st_5 rdf:type cls:st_220.
cls:st_220 rdfs:label "観光組織"@ja.
kg:op_10 prop:content "カザグルマを使って連携した"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:st_6 rdfs:label "町内の幼稚園・保育園児・小中学生"@ja.
kg:st_6 rdf:type cls:st_221.
cls:st_221 rdfs:label "児童生徒"@ja.
kg:op_11 prop:content "オリジナルカザグルマを制作した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_6.
kg:st_7 rdfs:label "一般のお客様"@ja.
kg:st_7 rdf:type cls:st_22.
cls:st_22 rdfs:label "利用者"@ja.
kg:op_12 prop:content "ラウンジやコワーキング施設やイベント利用が想定されている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_7.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "北海道松前町において「風」は町の象徴です。リエネウインドファーム松前はこの「風」という資源を活かし、自然や地域と共存しながら持続可能な社会を実現するクリーンエネルギーを創出していきたいと考えています。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "自然や地域と共存しながら持続可能な社会を実現するクリーンエネルギーを創出していきたいと考えています。"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "そして再生可能エネルギー事業の推進と地域活性化を目指し、「農業体験フィールド」、「風と楽しく遊ぶプレイフィールド」として松前町民の皆さま、子供たちと一緒に育んで参ります。"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "松前の「風」とその自然の力をより身近に感じられる町のシンボルとして、それらを活かした地域振興とまちづくりの発展に取り組んでおります。"@ja.
<< kg:id_6 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "町民の皆さんと子供たちと、より良い未来に向けて「地域と育むファーム」として繋がりを大事にしています。"@ja.
<< kg:id_6 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "再生エネルギーをもっと身近に感じていただき、町民の皆さんだけでなく、松前を訪れる方たちにとっても、松前を代表するような愛されるランドマークを目指します。"@ja.
<< kg:id_6 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "01 ベンチ・東屋・オリジナルキャラクターの制作ワークショップ 2023年5月~9月 ・松前町に吹く様々な「風」をモチーフにしてキャラクターづくりを実施 ・松城小学校3・5年生とワークショップを開催して制作を行った。・子供たちのアイデアを最大限活かした設計を実施し、地元産材を3D加工技術を用いて設置した"@ja.
<< kg:id_6 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "・松前高校生と町内愛好家の方々と松前町オリジナルそば作りの探求学習を実施"@ja.
<< kg:id_6 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "・松前高校生と風と遊ぶフィールドとして本園のオープニングイベントを実施"@ja.
<< kg:id_6 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "Symbol Project 松前町のみらいをつなげるカザグルマプロジェクト ・観光物産協会と松前城等の歴史観光施設とカザグルマを使って連携"@ja.
<< kg:id_6 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "・町内の幼稚園・保育園児・小中学生が制作したオリジナルカザグルマを展示"@ja.
<< kg:id_6 prop:effect kg:id_15 >>
    prop:text-txt_contents "・大型風車と季節の花、カザグルマ3千個により「松前らしい、松前にしかない景観を創出」"@ja.
<< kg:id_6 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "Regional Symbiosis Project 地域共生型施設「まちの駅 TENOHA松前」2024年5月オープン予定 一般のお客様向け ラウンジ（無料）、コワーキング施設（有料）、各種イベント開催予定"@ja.
}
