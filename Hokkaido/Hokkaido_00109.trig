kg:st_1 rdfs:label "NPO法人ピーク・エイド"@ja.
kg:st_1 rdfs:type cls:st_222.
cls:st_222 rdfs:label "NPO"@ja.
kg:op_1 prop:content "人類の発展が自然環境や野生動物に大きな影響を与えてきたとみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "森林伐採が自然環境や野生動物への影響の要因とみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "都市開発が自然環境や野生動物への影響の要因とみる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "気候変動が自然環境や野生動物への影響の要因とみる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "人間の活動の影響は環境破壊として現れているとみる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "人間の活動の影響は野生動物の傷病として現れているとみる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "人間の活動の影響は生態系の破壊として現れているとみる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "再生可能エネルギーも設置場所や方法によっては生態系に深刻な影響を与えるとみる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "設置場所次第で生態系への影響が深刻化するとみる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "設置方法次第で生態系への影響が深刻化するとみる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "野生動物の保護が自然環境の維持につながると考える"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "自然を守ることは人間の暮らしを支える水や食料や気候を守ることでもあると考える"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "どれか一つを犠牲にせず共に生きる道を探ることが未来を守ると考える"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_2 rdfs:label "齋藤慶輔氏と野口健"@ja.
kg:st_2 rdfs:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_14 prop:content "自然との共存や生態系を守るために私たちができることを考えるべきだとする"@ja.
kg:op_14 rdf:type cls:opinion.
