<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00110> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "北海道全域で長時間の停電「ブラックアウト」"@ja.
kg:id_1 rdf:type cls:c_14555.
cls:c_14555 rdfs:label "大規模停電"@ja.
kg:id_2 rdfs:label "2018年に胆振東部地震の影響"@ja.
kg:id_2 rdf:type cls:c_2043.
cls:c_2043 rdfs:label "地震"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "リエネ松前風力発電所"@ja.
kg:id_3 rdf:type cls:c_410.
cls:c_410 rdfs:label "風力発電所"@ja.
kg:id_4 rdfs:label "蓄電池システムの活用による安定した電力供給"@ja.
kg:id_4 rdf:type cls:c_15150.
cls:c_15150 rdfs:label "蓄電池活用"@ja.
kg:id_3 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "風力発電設備の出力変動"@ja.
kg:id_5 rdf:type cls:c_13238.
cls:c_13238 rdfs:label "出力変動"@ja.
kg:id_6 rdfs:label "蓄電池システムの利用"@ja.
kg:id_6 rdf:type cls:c_15150.
kg:id_5 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "災害時の電力供給課題"@ja.
kg:id_7 rdf:type cls:c_15151.
cls:c_15151 rdfs:label "電力供給課題"@ja.
kg:id_8 rdfs:label "既存の送配電網を活用した地域マイクログリッドの構築"@ja.
kg:id_8 rdf:type cls:c_15152.
cls:c_15152 rdfs:label "地域マイクログリッド"@ja.
kg:id_7 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "北海道全域で長時間の停電「ブラックアウト」が発生"@ja.
kg:id_9 rdf:type cls:c_14555.
kg:id_2 prop:effect kg:id_9.
kg:id_10 rdfs:label "地域マイクログリッドの運用開始"@ja.
kg:id_10 rdf:type cls:c_15153.
cls:c_15153 rdfs:label "運用開始"@ja.
kg:id_11 rdfs:label "対象エリア内の非常時の電力供給が可能"@ja.
kg:id_11 rdf:type cls:c_15154.
cls:c_15154 rdfs:label "非常時電力供給"@ja.
kg:id_10 prop:effect kg:id_11.
kg:id_12 rdfs:label "地域レジリエンス強化に貢献"@ja.
kg:id_12 rdf:type cls:c_15155.
cls:c_15155 rdfs:label "地域強靱化"@ja.
kg:id_10 prop:effect kg:id_12.
kg:st_1 rdfs:label "松前町"@ja.
kg:st_1 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "地域マイクログリッドをともに検討"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "2018年に胆振東部地震の影響を受け、北海道全域で⻑時間の停電「ブラックアウト」が発⽣しました。"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:text-txt_contents "蓄電池システムの活用による安定した電力供給を実現"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "北海道電力ネットワークの「風力発電設備の出力変動緩和対策に関する技術要件」を満たす、初の風力発電所で、蓄電池システムの利用により、安定した電力供給を可能にしています。"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "その経験を踏まえ、リエネ松前⾵⼒発電所運転開始時より、災害時に既存の送配電網を活⽤して⾵⼒発電所の電⼒を届ける「地域マイクログリッド」構築を松前町とともに検討し、2024年2月に非常時の地域マイクログリッドの運用を開始しました。"@ja.
<< kg:id_2 prop:effect kg:id_9 >>
    prop:text-txt_contents "2018年に胆振東部地震の影響を受け、北海道全域で⻑時間の停電「ブラックアウト」が発⽣しました。"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:text-txt_contents "これにより、対象エリア内の非常時の電力供給が可能になり、地域レジリエンス強化に貢献します。"@ja.
<< kg:id_10 prop:effect kg:id_12 >>
    prop:text-txt_contents "これにより、対象エリア内の非常時の電力供給が可能になり、地域レジリエンス強化に貢献します。"@ja.
}
