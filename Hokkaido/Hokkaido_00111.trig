kg:id_94 rdf:type cls:c_15203.
cls:c_15203 rdfs:label "副食提供"@ja.
kg:id_95 rdfs:label "大江保育所と銀山保育所への副食配達"@ja.
kg:id_95 rdf:type cls:c_15204.
cls:c_15204 rdfs:label "副食配達"@ja.
kg:id_94 prop:countermeasure kg:id_95.
kg:id_96 rdfs:label "出産する予定又は出産した国民健康保険被保険者の負担軽減"@ja.
kg:id_96 rdf:type cls:c_890.
kg:id_97 rdfs:label "産前産後期間の国民健康保険税の所得割額及び均等割額の減額"@ja.
kg:id_97 rdf:type cls:c_15205.
cls:c_15205 rdfs:label "保険税減額"@ja.
kg:id_96 prop:countermeasure kg:id_97.
