kg:id_102 rdfs:label "農家戸数の減少"@ja.
kg:id_102 rdf:type cls:c_9428.
cls:c_9428 rdfs:label "農家減少"@ja.
kg:id_103 rdfs:label "将来より少ない農業経営で国内の食料供給を担えるかという課題"@ja.
kg:id_103 rdf:type cls:c_15209.
cls:c_15209 rdfs:label "食料供給課題"@ja.
kg:id_102 prop:effect kg:id_103.
kg:id_104 rdfs:label "地域と産業の将来維持"@ja.
kg:id_104 rdf:type cls:c_15210.
cls:c_15210 rdfs:label "地域産業維持"@ja.
kg:id_105 rdfs:label "出生数が統計開始以来初めて80万人を割り込んだこと"@ja.
kg:id_105 rdf:type cls:c_1157.
cls:c_1157 rdfs:label "出生減少"@ja.
kg:id_104 prop:cause kg:id_105.
kg:id_106 rdfs:label "地域の将来課題への対応"@ja.
kg:id_106 rdf:type cls:c_15211.
cls:c_15211 rdfs:label "将来課題対応"@ja.
kg:id_107 rdfs:label "経済発展と社会課題解決の両立に向けた取組推進"@ja.
kg:id_107 rdf:type cls:c_2738.
cls:c_2738 rdfs:label "両立推進"@ja.
kg:id_106 prop:countermeasure kg:id_107.
kg:st_1 rdfs:label "佐藤聖一郎町長"@ja.
kg:st_1 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_1 prop:content "町民の理解と支援により今後も運動を維持したい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "吉田隆行全国町村会会長"@ja.
kg:st_2 rdf:type cls:st_163.
cls:st_163 rdfs:label "団体代表"@ja.
kg:op_2 prop:content "国と地方が連携してこども・子育て政策を抜本強化すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "各町村が子どもたちの育つ環境づくりに懸命に取り組んでいる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "取組を積極推進できるよう国に格段の対応を求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "地方交付税を含む一般財源総額の確保を引き続き強く求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "岸田文雄内閣総理大臣"@ja.
kg:st_3 rdf:type cls:st_223.
cls:st_223 rdfs:label "政府代表"@ja.
kg:op_6 prop:content "供給力強化を最重要の柱として進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "所得税・住民税減税や賃上げ促進税制強化などを総動員する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "人口減少と人手不足に対応する改革を進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "施策を一刻も早く国民に届けるため速やかな執行に全力を尽くす"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:st_4 rdfs:label "全国町村長大会出席者"@ja.
kg:st_4 rdf:type cls:st_74.
cls:st_74 rdfs:label "参加者"@ja.
kg:op_10 prop:content "町村にとって最重要課題として一般財源総額の確保を求めた"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "地域からの脱炭素化推進を求めた"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "施設の適正な維持管理に努め親しまれる公園を目指す"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "次年度以降の発注に向け施工内容等の見直しを行う"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "本年度内の着工が難しいため再入札を行わなかった"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "昨今の技術者不足等を考慮して見直しを進める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_5 rdfs:label "仁木町建設工事等入札参加者指名停止審査委員会"@ja.
kg:st_5 rdf:type cls:st_7.
cls:st_7 rdfs:label "審査機関"@ja.
kg:op_16 prop:content "北海道の例などを参考に６か月間が妥当と判断"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:st_6 rdfs:label "岩井秋男教育長"@ja.
kg:st_6 rdf:type cls:st_224.
cls:st_224 rdfs:label "教育機関代表"@ja.
kg:op_17 prop:content "取組の強弱はあるものの概ね良好と判断している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_6.
kg:st_7 rdfs:label "児童・生徒"@ja.
kg:st_7 rdf:type cls:st_221.
cls:st_221 rdfs:label "児童生徒"@ja.
kg:op_18 prop:content "とてもおいしい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_7.
kg:op_19 prop:content "地域産業を学び生産者に感謝する心を育むことを期待する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:st_8 rdfs:label "佐藤秀教議員"@ja.
kg:st_8 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_20 prop:content "合葬墓の要望把握のため町民アンケートが必要"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_8.
kg:op_21 prop:content "墓じまいも含めて悩む町民がいる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_8.
kg:op_22 prop:content "無縁墓が墓地環境悪化の原因になっている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_8.
kg:op_23 prop:content "無縁墓の増加が墓地の環境悪化を招いている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_8.
kg:op_24 prop:content "町民の不安やニーズを的確に把握することが重要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "本町に適した合葬墓の設置に向け調査研究に着手したい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "作物選定は生産者自身が５年後を見据えて決めるべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:st_9 rdfs:label "林幸治副町長"@ja.
kg:st_9 rdf:type cls:st_94.
cls:st_94 rdfs:label "副首長"@ja.
kg:op_27 prop:content "地域で対応できるか検討し引き続き国へ要望する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_9.
kg:op_28 prop:content "特段の配慮を要する住民がいるため賛成できない"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "知事への意見書に記載し関西電力へ伝えたい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "丁寧な説明は十分ではなく補足の機会を設けるよう促したい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "カーボンニュートラル達成が重要"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "気候変動が身近に感じられる状況になっている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "国や道と連携し一層の取組を推進する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "GX化とDX化に特化した体制を整備する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "小型児童館の利用拡大に向けた運営形態を検討している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "多様な教室や交流行事で利用者拡大を図る"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "地域福祉を推進する中核組織として有効活用を検討する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:st_10 rdfs:label "嶋田茂議員"@ja.
kg:st_10 rdf:type cls:st_16.
kg:op_38 prop:content "今以上の施設整備が必要"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_10.
kg:op_39 prop:content "酷暑対策と安定的生産体制の確立が必要"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "気象変動に対応できる安定生産体制を確立する必要がある"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "担い手農業者への施設園芸ハウス導入支援を検討する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "設備更新や規模拡大を目指す担い手農業者を支援する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "生産物をそのまま出荷するだけでなく新たな価値創出が重要"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "子育て世帯支援のあり方を調査検討したい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "現状ではへき地保育所への提供はできない"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "現実と向き合い課題解決に向けた対策が必要"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "未来を見据え経済発展と社会課題解決の両立に取り組む"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "来年以降も両立を目指して取り組む"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "私も仁木町共同募金会の会長を仰せつかっておりますが、町民皆さんの温かいお心遣いにより運動が維持されておりますことに感謝申し上げる次第であります。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "歳末助け合い運動の起源は明治39年に遡りますが、日露戦争時の貧困家庭の慰問に端を発し"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "その後、昭和初期には世界的不況により困窮する人々に対して歳末の餅代を支給する運動に広がっていきました。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "戦後再び戦災者、引揚げ者、傷痍軍人などの助けを必要とする多くの人を助けたいという歳末同情運動の動きが各地で起こり、その後民生委員児童委員協議会が主催する歳末助け合い運動へと発展してきました。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "我が国において少子化対策は喫緊に対応すべき最重要課題であり、国と地方が緊密に連携し、こども・子育て政策を抜本的に強化して、少子化傾向を反転させなければならない"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "それぞれの町村では、地域の未来を担う子どもたちが希望に溢れ健やかに育つ環境づくりに懸命に取り組んでいる。"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "こうした取組を積極的に推進できるよう、安定した地方財源と施策を担う人材の確保等について、国に格段の対応を求める特別決議等をお諮りする。"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "町村が地域の課題解決に向けて積極的に取り組むためには､安定的な地方税財政基盤の確保が重要であり、地方交付税を始めとする一般財源の総額が確実に確保されるよう、国に対し、引き続き強く求める。"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "先般、策定したデフレ完全脱却のための総合経済対策は、賃上げの原資となる企業の稼ぐ力を強化する供給力の強化を最も重要な柱とするとともに"@ja.
<< kg:id_17 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "国民の可処分所得を下支えする施策も盛り込み、所得税・住民税の定額減税や賃上げ促進税制の強化、人口減少・人手不足に対応するデジタル技術等を活用した各種の制度・規制改革など、予算措置のみならず、税制や規制・制度改革を総動員する内容となっている。"@ja.
<< kg:id_20 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "人口減少・人手不足に対応するデジタル技術等を活用した各種の制度・規制改革など"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "対策に盛り込まれた各施策を一刻も早く国民の皆さまにお届けすることが何よりも重要であり、速やかな執行に全力を尽くす"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "議事では、大会運営委員会で決定した町村をめぐる諸問題の解決に向け、一．町村にとって最重要課題である地方交付税等の一般財源総額を確保すること。"@ja.
<< kg:id_26 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "一．地域からの脱炭素化を推進すること。"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "施設を所有する自治体では、命名権料を施設の維持管理費に充当することで、経費の負担が軽減されることになり、また、施設の知名度向上につながることが期待できます。"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:text-txt_contents "ふれあい遊トピア公園は、「コンサドーレにきパーク」という愛称が付けられました。"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "指名業者５者から、技術者の配置及びコンクリート積みブロック施工業者の人員不足等の理由により、入札辞退届の提出がされたため、入札執行を中止しております。"@ja.
<< kg:id_33 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "こちらも入札執行日前に指名業者５者から、技術者の配置及びコンクリート積みブロック施工業者の人員不足等の理由により、入札辞退届の提出がされたため、10月26日に入札執行を中止しており、本年度中での残期間内では工事着工が難しいことから、再入札の執行は行っておりません。"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "昨今の技術者不足等の状況を考慮し、次年度以降の発注に向けて、現在、施工内容等の見直しを行っているところであります。"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:text-txt_contents "令和５年11月18日に北悠建設株式会社の代表役員が余市町職員への贈賄容疑で逮捕されたことに伴い"@ja.
<< kg:id_36 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "委員会で北海道の例などを参考に検討し、指名停止期間は６か月間とすることが妥当であるとの報告がありました。"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "評価結果につきましては、それぞれの取組の強弱はあるものの、概ね良好と判断しております。"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "寄贈いただいたシャインマスカット「ラ・ラ・シャイン」は、11月２日に学校給食で提供されており、児童・生徒からは「とてもおいしい」と感想が述べられていました。"@ja.
<< kg:id_41 prop:effect kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "これを機に子どもたちが地域の産業を学び、生産者に感謝する心を育むことを期待しているところであります。"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "その背景には、少子高齢化や高齢者の一人暮らしが増加しているなど、社会構造の変化が影響していると考えられています。"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "子ども世代に承継できないまま高齢化して、「自分が亡くなった後の墓地維持に対する不安」、「子どもに墓地の維持を負担させたくない」との思いから、「墓じまい」も含めて、悩んでいる方が町民の中にいます。"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "これも少子化に加え、変わらぬ都市部への人口集中、お墓の継承を義務とは考えない家族感の変化などが背景にあるとみられており"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "近年、管理する親族がいない無縁墓が増えており、これが原因で墓地の環境悪化を招いています。"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "議員仰せのとおり次年度において、合葬墓に対する町民アンケートを実施することとしております。"@ja.
<< kg:id_52 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "併せて、公営・民営を含め、現行設置されている合葬墓の運営等の調査も実施し、本町に適した合葬墓の設置に向けた調査研究に着手したいと考えております。"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:text-txt_contents "そのうち31.4㌶が令和５年度の畑地化促進事業として申請されており、作目につきましては、ミニトマトなどの高収益作物が16㌶で、蕎麦などの畑作物が15.4㌶となっております。"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "畑地化促進事業の交付を受けた場合、対象作物を販売目的として５年間作付けしなければならないという条件が課せられていることから、作物の選定に当たっては慎重に決定すべきものと考えます。"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "５年間の中でですね、１か月以上湛水処理をする、いわゆる北海道独自のブロックローテーションというそういった仕組みがございますけれども、そういったものに対しても、国として今回の中でですね、要件緩和の中で認めていただいたり"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "地域内には特段の配慮を要する住民の方もいらっしゃることなどを鑑み、銀山地区を含む南部エリアでの風力発電施設の設置は好ましいものとは考えておりません。"@ja.
<< kg:id_63 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "今後、銀山地区において、事業の実施に向けて具体的な検討が行われる場合におきましては、このことを事業者に伝えてまいりたいと考えております。"@ja.
<< kg:id_65 prop:effect kg:id_66 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "十分ではないものと推察されることから、関西電力に対し先般の説明会を補足する機会を設けるよう、今後促してまいりたい"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "地球温暖化による気候変動は、石油や石炭などの化石燃料を燃やすことで排出される二酸化炭素や、森林破壊などが原因とされており"@ja.
<< kg:id_67 prop:effect kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "北海道７地点の2023年夏の平均気温は平年より3.17度も高く、長期的にみても100年当たり1.38度の割合で気温が上昇するなど、地球温暖化による気候変動が身近に感じられるようになっております。"@ja.
<< kg:id_70 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "その上で、森林の整備・保全や、太陽光発電等の再生可能エネルギーの導入を推進すべきものと考えております。"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "次年度の役場の組織機構を見直してですね、ＧＸ化、今仰ったＤＸ化に特化したセクションを設置し"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "小型児童館の利用につきましては、学校から帰宅してからの利用を基本とする「一般利用者」と、学校からの直接来館を可能とする「ランドセル来館利用者」の２通りの利用形態を予定しており"@ja.
<< kg:id_74 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "申込型の教室として囲碁教室や学習教室、高齢者等のボランティア指導者を募集し、おはじきやお手玉等を教える昔遊び教室等を予定しております。"@ja.
<< kg:id_77 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "仁木町社会福祉協議会事務所等としての利用を視野に建物の有効活用について、検討していきたいと考えております。"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "本町の基幹産業であります農業は、近年の天候不順が原因で苦しい経営を余儀なくされております。"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "本町の主力農産物であるミニトマトにおいても、生育の大幅前倒しによる他産地との競合や、着果不良や日焼け果、つやなし果、グリーンバック果などの高温障害により、例年と比較し大幅な減収や品質の低下となりました。"@ja.
<< kg:id_83 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "今後は、酷暑対策の一環として、遮光ネットの導入や暑さに強い品種の検討など、気象変動に対応できる安定的な生産体制の確立が必要であると考えております。"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "近年の燃油価格の高騰や円安の影響により、農業資材は例年の約1.５倍に高騰しており、既存の農業者においても営農リスクが高まっている"@ja.
<< kg:id_83 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "施設園芸ハウス導入に要する経費の支援を検討してまいります。"@ja.
<< kg:id_88 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "今後も、仁木町の豊かな自然により生産された地域資源を様々な角度から検証し、新たな付加価値を生み出すよう努めてまいります。"@ja.
<< kg:id_90 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "本町としましては、これまでの町の施策、国の動向等を踏まえ、抜本的な子育て世帯への支援のあり方、施策について調査検討してまいりたいと考えております。"@ja.
<< kg:id_92 prop:cause kg:id_93 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "外部へ給食を提供することにより、本来の業務である小中学校への給食提供の業務に支障や負担を生じさせること、提供する頻度が本来の業務を上回ること及び提供対象が増えることによる栄養教諭の業務負担増が考えられること、また夏季休暇等の長期休業中は調理場の機器が一定量以下の調理となり、安全装置が働き調理することができないことにより通年での提供ができない"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:text-txt_contents "白米のみを持参し、後志報恩会の就労継続支援Ｂ型事業所シェアリング和光が調理した副食を配達していただいている状況であります。"@ja.
<< kg:id_96 prop:countermeasure kg:id_97 >>
    prop:text-txt_contents "子育て世帯の負担軽減等の観点から、出産する予定、又は出産した国民健康保険被保険者の産前・産後期間における国民健康保険税の所得割額及び均等割額を減額する"@ja.
<< kg:id_98 prop:cause kg:id_99 >>
    prop:text-txt_contents "近年、簡易水道事業については、施設の老朽化、人口減少等による料金収入の減少等で、経営環境が厳しくなっており"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:text-txt_contents "公営企業として継続的に経営を行っていくため、経営成績や財政状況のより的確な把握が可能となる公営企業会計の適用が求められている"@ja.
<< kg:id_102 prop:effect kg:id_103 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "全国で2003年に農家戸数が220万戸あったのに対し、2023年には半分以下の93万戸になってしまいました。将来、現在よりも更に少ない農業経営で国内の食料供給を担うことができるのか、私たちは今１度現実と向き合い、課題解決に向けて対策を講じていく必要があります。"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "昨年、日本の出生数が統計開始以来、初めて80万人を割り込んだ事実を我々はどのように受け止め、今後の地域を守り、産業を振興させていくことができるのか。"@ja.
<< kg:id_106 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "本町も未来を見据え、経済発展と社会課題解決の両立を来年以降も取組を進めてまいる所存であります。"@ja.
}
