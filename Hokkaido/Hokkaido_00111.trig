cls:c_632 rdfs:label "導入支援"@ja.
kg:id_83 prop:countermeasure kg:id_87.
kg:id_88 rdfs:label "農業の６次産業化推進"@ja.
kg:id_88 rdf:type cls:c_5315.
cls:c_5315 rdfs:label "六次産業化"@ja.
kg:id_89 rdfs:label "地域資源を検証し新たな付加価値を生み出す"@ja.
kg:id_89 rdf:type cls:c_15199.
cls:c_15199 rdfs:label "価値創出"@ja.
kg:id_88 prop:countermeasure kg:id_89.
kg:id_90 rdfs:label "学校給食費無料化継続の検討"@ja.
kg:id_90 rdf:type cls:c_15200.
cls:c_15200 rdfs:label "給食費支援検討"@ja.
kg:id_91 rdfs:label "町の施策や国の動向を踏まえた抜本的な子育て世帯支援のあり方の調査検討"@ja.
kg:id_91 rdf:type cls:c_15201.
cls:c_15201 rdfs:label "支援調査"@ja.
kg:id_90 prop:countermeasure kg:id_91.
kg:id_92 rdfs:label "へき地保育所への学校給食提供不可"@ja.
kg:id_92 rdf:type cls:c_15202.
cls:c_15202 rdfs:label "給食提供不可"@ja.
kg:id_93 rdfs:label "小中学校への給食提供業務への支障や負担と通年提供不可"@ja.
kg:id_93 rdf:type cls:c_12480.
cls:c_12480 rdfs:label "業務負担"@ja.
kg:id_92 prop:cause kg:id_93.
