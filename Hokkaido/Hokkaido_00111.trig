kg:id_98 rdf:type cls:c_15206.
cls:c_15206 rdfs:label "会計移行必要"@ja.
kg:id_99 rdfs:label "施設の老朽化や人口減少等による料金収入の減少による経営環境悪化"@ja.
kg:id_99 rdf:type cls:c_754.
cls:c_754 rdfs:label "経営悪化"@ja.
kg:id_98 prop:cause kg:id_99.
kg:id_100 rdfs:label "簡易水道事業への地方公営企業法適用"@ja.
kg:id_100 rdf:type cls:c_15207.
cls:c_15207 rdfs:label "会計制度適用"@ja.
kg:id_101 rdfs:label "経営成績や財政状況をより的確に把握可能な公営企業会計への移行"@ja.
kg:id_101 rdf:type cls:c_15208.
cls:c_15208 rdfs:label "会計移行"@ja.
