kg:st_1 rdfs:label "麿直之議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "肝いりの事業だったのに辞退理由を問題視"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "副町長"@ja.
kg:st_2 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_2 prop:content "制度は町に有効で今後も継承活用したい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "企画課長"@ja.
kg:st_3 rdfs:type cls:st_2.
kg:op_3 prop:content "不適切発言の報道を受け本人から辞退申出があった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:st_4 rdfs:label "野崎議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_4 prop:content "休止後の安全管理体制を確認"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_4.
kg:st_5 rdfs:label "教育次長"@ja.
kg:st_5 rdfs:type cls:st_2.
kg:op_5 prop:content "侵入防止措置と排水を実施した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_5.
kg:st_6 rdfs:label "岩井教育長"@ja.
kg:st_6 rdfs:type cls:st_2.
kg:op_6 prop:content "老朽化が著しく正常開設が困難なため休止判断"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_6.
kg:op_7 prop:content "令和５年度は休止するとした"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_6.
kg:op_8 prop:content "最終的に解体撤去整地になる今後予定を確認"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "次年度以降に条例改正後取り壊しに向けて取り組む"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_5.
kg:op_10 prop:content "安全管理のため侵入防止措置を講じた"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "安全管理のため排水した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_5.
kg:op_12 prop:content "代替利用としてニキバス無料利用を用意"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_6.
kg:op_13 prop:content "授業や児童生徒利用に代替交通を確保"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_6.
kg:st_7 rdfs:label "提出議員上村智恵子"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_14 prop:content "自治体の財政事情では限界があり国の早期実現を求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_7.
kg:op_15 prop:content "学校給食無償化の早期実現を要望"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_7.
kg:st_8 rdfs:label "議会"@ja.
kg:st_8 rdfs:type cls:st_89.
cls:st_89 rdfs:label "議会"@ja.
kg:op_16 prop:content "物価高騰で給食費負担が重くなることを踏まえている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_8.
kg:op_17 prop:content "必要な介護を受けられない実態の改善を求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_7.
kg:op_18 prop:content "介護離職が多く支援強化が緊急に必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_7.
kg:op_19 prop:content "支援強化が急務と訴える"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_7.
kg:op_20 prop:content "利用者負担増につながる見直し中止を求める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_7.
kg:st_9 rdfs:label "町長"@ja.
kg:st_9 rdfs:type cls:st_2.
kg:op_21 prop:content "身分証明書として利用できる点をメリットと捉える"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_9.
kg:op_22 prop:content "健康保険証登録ができる点をメリットと捉える"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_9.
kg:op_23 prop:content "オンライン手続きの利便性向上を評価"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_9.
kg:op_24 prop:content "電子証明書更新が必要な点をデメリットと認識"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_9.
kg:st_10 rdfs:label "上村智恵子議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_25 prop:content "国に保険証廃止の撤回を求めるべきと主張"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_10.
kg:op_26 prop:content "町として国に保険証を残す要望は考えていない"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_9.
kg:op_27 prop:content "子どもへの均等割減免を求める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_10.
kg:op_28 prop:content "減免を検討する考えはない"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_9.
kg:op_29 prop:content "行政は所有者に管理を促す必要がある"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "今後の施策の方向性を質問"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "必要な施策は充実見直ししつつ現行方向で進める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "傷んだ防水層等を撤去し最終的に超速硬化ウレタン塗膜防水を行う"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "工事完成引渡日から10年間保証される"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:st_11 rdfs:label "参考人"@ja.
kg:st_11 rdfs:type cls:st_226.
cls:st_226 rdfs:label "参考人"@ja.
kg:op_34 prop:content "工事が始まれば土砂崩れ不安の中で生活することになると懸念"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_11.
kg:op_35 prop:content "土砂災害を未然に防ぐため建設反対を表明"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_11.
kg:op_36 prop:content "自然破壊が進んでおり原点は自然を壊さないことだと訴える"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_11.
kg:st_12 rdfs:label "総務経済常任委員会"@ja.
kg:st_12 rdfs:type cls:st_50.
cls:st_50 rdfs:label "委員会"@ja.
kg:op_37 prop:content "反対理由の一つとして人体影響を整理"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_12.
kg:st_13 rdfs:label "委員"@ja.
kg:st_13 rdfs:type cls:st_3.
cls:st_3 rdfs:label "委員"@ja.
kg:op_38 prop:content "科学的因果関係が未証明でも前もってリスクを避けるべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_13.
kg:op_39 prop:content "反対理由として自然生態系への影響を重視"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_12.
kg:op_40 prop:content "地滑り地帯や土砂災害区域であり懸念材料だと指摘"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_13.
kg:op_41 prop:content "土砂崩れを未然に防ぐため建設反対を求める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_11.
kg:op_42 prop:content "社会福祉施設への近接を反対理由として挙げた"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_12.
kg:op_43 prop:content "障がい者施設や児童養護施設の利用者への健康影響を懸念"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_11.
kg:op_44 prop:content "地元住民の強い反対や地質条件から計画地から外すべき"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_13.
kg:st_14 rdfs:label "議会広報編集特別委員会"@ja.
kg:st_14 rdfs:type cls:st_50.
kg:op_45 prop:content "議員活動実績として質疑回数掲載を提案"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_14.
kg:st_15 rdfs:label "議会活性化特別委員会"@ja.
kg:st_15 rdfs:type cls:st_50.
kg:op_46 prop:content "委員会意見の放置が形骸化につながると問題視"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_15.
kg:op_47 prop:content "効率的で実効性ある行政運営につなげるため提言書提出"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_15.
kg:op_48 prop:content "導入に向けて実証と調整を進めた"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_15.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "一般会計補正予算は、新型コロナウイルス感染症対策事業等の追加補正、地域力創造アドバイザーの辞退や、銀山プール休止等による減額補正が提案され"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "一般会計補正予算は、新型コロナウイルス感染症対策事業等の追加補正、地域力創造アドバイザーの辞退や、銀山プール休止等による減額補正が提案され"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本年３月にアドバイザーが自治体に対する不適切な発言をしたという問題が報じられたことを受け、本人が来町され、辞退をさせていただきたいという申し出があったためである"@ja.
<< kg:id_6 prop:cause kg:id_4 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "一般会計補正予算は、新型コロナウイルス感染症対策事業等の追加補正、地域力創造アドバイザーの辞退や、銀山プール休止等による減額補正が提案され"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "銀山水泳プールは設置から54年が経過し、主要な機械設備の老朽化が顕著な状態にあることから、正常な状態でプールを開設することが困難であると判断し、令和５年度は休止し"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "正常な状態でプールを開設することが困難であると判断し、令和５年度は休止し"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "今後は施設廃止へ向けて進めていくことといたしました"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "フェンスに侵入防止用のネットを設置した他"@ja.
<< kg:id_11 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "プールの水を抜いたところである"@ja.
<< kg:id_7 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "銀山地区の住民の皆さまが、仁木水泳プールを利用する場合は「ニキバス」を無料で利用できることとしている"@ja.
<< kg:id_7 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "櫻ヶ丘学園の児童生徒や、銀山小学校で水泳授業を行う場合については、マイクロバス等を利用することができることとしております"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:text-txt_contents "この度の改正は、保健センターの各室に冷房が設置されたことに伴い"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:text-txt_contents "令和５年度の夏季使用分から冷房料を徴収することとしたもので"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "財政状況の厳しさから無償化の実施や継続が困難な自治体も少なくないことから"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "学校給食の無償化を早期に実現するよう要望するもので"@ja.
<< kg:id_19 prop:cause kg:id_22 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "物価の高騰は給食費にも影響します"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "必要なサービスを利用できない実態が広がり"@ja.
<< kg:id_23 prop:cause kg:id_25 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "約9.5万人が家族の介護を理由として離職しており、支援強化が緊急に求められている"@ja.
<< kg:id_23 prop:effect kg:id_26 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "支援強化が緊急に求められている"@ja.
<< kg:id_23 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "利用者負担の増加につながる見直しはやめること等を要望するもので"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "身分証明書として使うことができるほか"@ja.
<< kg:id_28 prop:effect kg:id_30 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "登録することで健康保険証として使うことができるほか"@ja.
<< kg:id_28 prop:effect kg:id_31 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "オンラインでの行政手続き等、日常生活における各種手続きが便利になることなどのメリットがあると考える"@ja.
<< kg:id_28 prop:effect kg:id_32 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "マイナンバーカードや公的個人認証サービスによる電子証明書には有効期間があり、更新の必要があることが強いて申し上げればデメリットである"@ja.
<< kg:id_33 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_25;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "国に対して保険証を残してほしいと要望することは考えていない"@ja.
<< kg:id_35 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_27;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "減免を検討する考えがない"@ja.
<< kg:id_37 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "町としては、老朽化したものなどを持ち主に話し管理を促すことは必要になってくると考えている"@ja.
<< kg:id_39 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "今後検証しながら必要な施策についてはより充実させたり、もしくは見直しをしながら進めていきたいと考えているが、基本的には今の方向で進めてまいりたい"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:text-txt_contents "銀山小学校の雨漏り改修のための工事請負費や"@ja.
<< kg:id_41 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "既存の傷んだ防水層とパネルを撤去し、それ以外の既存の屋上部分を高圧洗浄し、プライマーという下塗り塗料とウレタンで仮防水を行い、最終的に超速硬化ウレタン塗膜防水をしている"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "保証期間は工事完成引渡日である令和５年５月25日から10年間となっている"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "風車の建設工事が始まると、地域住民は土砂崩れの不安の中で生活していくことになるでしょう"@ja.
<< kg:id_46 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "そういったことが起こる前から未然に防ぐために、風車の建設に反対します"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "全国的にメガソーラーやメガ風車によって原生林が18％に減ってしまいました"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "提出された陳情に記載の「（仮称）古平・仁木・余市ウィンドファーム事業」に反対する理由である①低周波音などによる人体への影響"@ja.
<< kg:id_51 prop:effect kg:id_53 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "②自然生態系への影響"@ja.
<< kg:id_51 prop:effect kg:id_54 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_40;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "③土砂災害・水質悪化の恐れ"@ja.
<< kg:id_51 prop:effect kg:id_55 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_42;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "④建設計画地が社会福祉施設に近接すること"@ja.
<< kg:id_51 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "事業計画からこの地域を外してほしいと思います"@ja.
<< kg:id_57 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "議会広報編集特別委員会より議員の活動実績として議会や委員会等における質疑の回数を掲載したいとの申し出が提案され"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "決算特別委員会で委員から出された意見等が次の予算に反映されていない場合や、次年度の決算特別委員会で何の進展もないこと等を指摘をするケースが散見されたため"@ja.
<< kg:id_59 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "委員会からの意見を書面で提出することで、委員会が形骸化することを防ぎ、より効率的で実効性のある行政運営の推進につながることを目的として、町側へ提言書を提出することとしました"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "令和３年から導入に向けてタブレット端末のデモンストレーションを実施しました。引き続き導入に向けて数社のデモンストレーションを実施すると共に、導入に関連する補助金の調査や、町側との調整を実施していくこととしました"@ja.
}
