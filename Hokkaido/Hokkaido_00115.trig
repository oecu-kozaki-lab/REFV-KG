kg:st_1 rdfs:label "松前町長石山英雄"@ja.
kg:st_1 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "災害に強いまちづくりを目指し取り組みを進める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "東京大学大学院准教授"@ja.
kg:st_2 rdfs:type cls:st_105.
cls:st_105 rdfs:label "研究者"@ja.
kg:op_2 prop:content "全国的な先進事例として期待し成功させたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "解決できる見込みがあり事業性は高い"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "ぜひ成功させたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "将来は町内で発電した電力で全域を賄うことも可能とみている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "電気の地産地消の実現を期待している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "促進区域の指定を受けなければ事業を進められない"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "誘致により産業活性化やビジネスチャンス拡大を目指す"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "将来の財源確保につながると見込む"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "人口減少に対応するため誘致を進める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "まずは国の促進区域指定に向けた手続を進める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "利害関係者の承認を得て誘致に進む"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "町の風況を活かし日本のエネルギー自給率向上に貢献する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "環境への貢献を図る"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "町の地域振興につなげたい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "産業の持続化を図るため誘致を推進する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:st_3 rdfs:label "梶谷康介議員"@ja.
kg:st_3 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_17 prop:content "全国の自治体が過疎のもとで苦慮している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "少子高齢化が財政運営を厳しくしている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "財源確保が寿都町や神恵内村の判断背景にある"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "財源確保は首長にとって大変重要だ"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "交付金は各自治体の首長にとって大きな魅力がある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "自主財源の確保が重要課題だ"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "交付税の減額は財政の死活問題になる"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "交付税の減少は避けられない見通しだ"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "一定期間は効果的な財源となる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "償却資産なので永久的な財源にはならない"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "償却資産の性質上恒久的な財源ではない"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "誘致が決まればかなりの増収が期待できる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "国の再エネ推進姿勢から長期的財源になり得る"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "町の財源確保のためにも成功させたい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "まずは施設整備がなければ呼び込む材料として難しい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "東急不動産と連携し企業版テレワーク等の可能性を模索する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "平坦な土地が少ないことが難しさを生んでいる"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "所有者が多く集約しづらいことが課題だ"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "歴史的に畑作農業が商業的発達をしてこなかった"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "肉牛の改良センター拡大に合わせ放牧地利用を考える"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "相談があればいろんな角度から支援する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "町の構造を変える起点になれるよう環境づくりを進めたい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:st_4 rdfs:label "福原英夫議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_39 prop:content "蓄電施設の存在が事業を押し進める大きな要因だ"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "一番の課題は技術面だ"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "課題は技術的なもので解決できる見込みだ"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "送電網利用でコスト低減が期待できる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "再生可能エネルギーを使ったマイクログリッドは画期的だ"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "成功すれば平常時送電も可能になる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "町内全域の電力を賄うのに余りある能力がある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "専門性を持つ事務体制が必要だ"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "町全体を見た政策部門の充実を図りたい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "東急不動産の全面的な支援を受けながら進めている"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "町民の理解を深めるため促進協議会を立ち上げたい"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "現在は就職サポートセンター機能の充実で対応する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "家族が面倒を見ることは最善で福祉の観点から有効だ"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "実現すれば一石二鳥の効果が期待できる"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "イチゴや野菜栽培などに取り組みたい人がいれば支援する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "最大30万円の補助事業を活用してほしい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "ニーズがあれば地域おこし協力隊活用を検討する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "人口減少の最大のネックは雇用の場の確保だ"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "正規採用の場が少ないことが町外流出につながっている"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "受け入れ環境を整えるよう努力する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "東急不動産株式会社が所有するリエネ松前風力発電所の大型蓄電施設を活用し、大規模停電時（ブラックアウト）のバックアップと効率的な電力の供給を目指して、今年度に経済産業省のモデル事業として採択を受け、松前町と東急不動産株式会社の共同申請により、松前町地域マイクログリッド構築マスタープランの策定に取り組んでいるところでございます"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "安定した電力の供給や変電所への独立した接続など課題は多くありますが、解決できる見込みであり、事業性は高いとされ"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "全国的にも先進事例として期待されており、ぜひ成功させたいと前向きなお話もいただきました"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "将来、松前町内全域の平常時の電力も、町内で発電した電力で賄うことも可能であり"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "安価で効率的な電気の地産地消の実現も期待できることから"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "洋上風力発電は、海洋再生可能エネルギー発電設備の整備に係る海域の利用の促進に関する法律（平成３０年法律第８９号）に基づいて実施され、国の促進区域の指定を受けなければ事業を進めることができないこととなっております"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "洋上風力発電の誘致による経済効果や漁業をはじめとする産業振興策などの活性化が図られ"@ja.
<< kg:id_10 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "固定資産税の増収も見込まれることなどから"@ja.
<< kg:id_10 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "将来の著しい人口減少に対応する産業全般の活性化やビジネスチャンスの拡大を目指し、洋上風力発電の誘致に向け"@ja.
<< kg:id_10 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "まずは、国の促進区域の指定を受けるための情報提供の手続を進めることとしたところでございます"@ja.
<< kg:id_10 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "利害関係者である松前さくら漁業協同組合の理事会の承認もいただいたことで"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "当町の風況を活かし、日本のエネルギー自給率の向上"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "環境への貢献"@ja.
<< kg:id_10 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "町の地域振興"@ja.
<< kg:id_10 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "産業の持続化を図るため、洋上風力発電の誘致の取り組みを推進するものであります"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "自分達の町を支えていくためには、過疎、あるいは少子高齢化、そうしたもののもとに非常に苦慮してる状態だと思います"@ja.
<< kg:id_21 prop:cause kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "自分達の町を支えていくためには、過疎、あるいは少子高齢化、そうしたもののもとに非常に苦慮してる状態だと思います"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "自分達の町や村がこれから存続していくために、どうしてもそのための財源を確保しなければいけない"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "この文献調査、あるいは概要調査にあたるなどの国からの交付金というのは、大変な魅力を感ずる財源である"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "自主財源比率が２０％と低く、依存財源の比率が８０％"@ja.
<< kg:id_28 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "ほとんど交付税に頼っているのが現実であります。交付税に頼らざるを得ない財源構造が、私どもの松前町の最大の弱点"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "今年は、交付税算定の基礎となる国勢調査の年でもありました。千人規模で減少する見込みであるというふうに捉えているところであります。令和３年度以降の交付税の減少は避けられない見通し"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "現在大型風力発電施設で今年、令和２年に１億１千万ほどの増収があったところであります"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "これは、償却資産でありまして、年々資産価値がなくなるというふうなことの繰り返しになるわけであります。一定期間には、効果な財源とはなりますけども、恒久的にっていうふうなことになると、償却資産の性質上、そういうふうにならざるを得ない"@ja.
<< kg:id_37 prop:effect kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "洋上風力については建設費も膨大で、誘致がもし決まれば固定資産税もかなりの増収が期待できる"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "大規模発電を有する洋上風力につきましては、私どもは、次から次へと更新されていく可能性が高いんではないかというふうに思っておりまして、その観点から見ますと、長期的な財源になり得る見込みもある"@ja.
<< kg:id_37 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "町の財源の確保ということからいきましても、ぜひ成功はさせていきたいなというふうに思っているところであります"@ja.
<< kg:id_41 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "まずは受け皿の整備、いわゆる施設の整備がなければ、呼び込む材料としては難しい"@ja.
<< kg:id_41 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "東急不動産と連携しながら企業版テレワークや企業合宿の誘致の可能性を現在模索していくこととしておりまして"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "平坦な土地が松前には少ないというふうに思っているところでありまして"@ja.
<< kg:id_44 prop:cause kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "農地の所有者が多数いると、所有者がたくさんいる。ですから、集約しづらい部分もある"@ja.
<< kg:id_44 prop:cause kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "松前の農業の歴史を見ますと、やっぱり、畑作農業にしても商業的な発達はしてこなかった"@ja.
<< kg:id_48 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "やっぱり遊休の農地は放牧地にするとか、そういうような方法はあるというふうに考えております"@ja.
<< kg:id_48 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "やる気のある人が私どもの方に相談していただければ、いろんな角度から支援はできる"@ja.
<< kg:id_16 prop:effect kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "再生可能エネルギー事業はまちづくりの原動力になるのかというふうな表題でございます。正しく、なれるような環境づくりに向かって進めてまいりたい"@ja.
<< kg:id_3 prop:cause kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "松前町には東急不動産の蓄電施設があるっていうことが大きい意味合いがある"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "現状の課題につきましては、技術的なものばかりで、解決できる見込みである旨も確認されておりまして"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "北海道電力ネットワークが管理する送電網を利用して、電気を送ることで自営線の配置が不用となり、コストも格段と安くなる"@ja.
<< kg:id_55 prop:effect kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "風力発電、いわゆる再生可能エネルギーを使ったマイクログリッドは、世界的にも画期的である"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "マイクログリッド構築が成功した場合には、現在は災害の、議員ご指摘のようにブラックアウト時のバックアップの想定でありますけども、これは理論的には、最終的には平常時の電気も送電できることとなる"@ja.
<< kg:id_60 prop:effect kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "現に、今現在リエネ松前風力発電所では、一般家庭の約３万世帯をカバーできる能力があります。松前町全域の電力を賄うのに余りある能力"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "町全体を見た中で政策部門の充実を図ってまいりたい"@ja.
<< kg:id_16 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "現在町では洋上風力の指定促進、指定を受けるために、促進区域の指定を受けるために、いろいろ東急不動産には本当に全面的なバックアップをいただきながら進めております"@ja.
<< kg:id_16 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "今後は然るべき時期には、仮称でありますけど、町内に促進協議会のようなものを立ち上げて、情報の共有や建設的な意見をもらいながら進めて行ければな"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "現在のところは、この就職サポートセンターでの対応の一層の充実を図ることによって解消してまいりたい"@ja.
<< kg:id_68 prop:effect kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "Ｕターンで親の面倒を見に帰って来ることは、福祉の観点からは有効なことである"@ja.
<< kg:id_70 prop:effect kg:id_71 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "このような形で実現が可能となれば、一石二鳥の効果は十分期待できる"@ja.
<< kg:id_72 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "イチゴや野菜の栽培、更には漬け物の商品開発を考えてみては、とのご提案でありますけども、私は積極的にやりたい人がいればですね、町としては支援をしていきたい"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "商品開発等につきましては、スマイル応援補助金等、最大３０万の補助事業もありますので、積極的に活用していただければ"@ja.
<< kg:id_76 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "産業団体等で地域おこし隊協力を活用して商品開発をしたいというニーズがあるのであれば、検討できなくはない"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "人口減少の最大のネックとなるのは、やっぱり雇用の場の確保"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "正規職員の、正規採用の場が少ないことが町外への人口流出に繋がっている"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "受け入れ環境が整えるよう、今後も努力して、Ｉターン、Ｕターン者が町に移住できる環境づくりを目指してまいりたい"@ja.
}
