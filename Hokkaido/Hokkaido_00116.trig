kg:st_1 rdfs:label "町長石山英雄"@ja.
kg:st_1 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_1 prop:content "町民の命と経済活動を守る責任は重い"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "感染防止と経済対策を喫緊の重点課題とする"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "町独自の経済支援を進める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "冷え込んだ経済の復旧対策を進める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "まだ予断を許さない状況と認識"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "新しい生活様式の実践を進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "長期戦も視野に支援に取り組む"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "医療サービス向上のため病院改築を進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "病院は町民生活に不可欠"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "医師と医療スタッフ確保に全力を尽くす"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "運営体制の充実を重点課題とする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "子牛供給で安定経営を支援する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "研修生受け入れと賃貸型牛舎で新規就農を支援"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "草地更新を検討する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "関係者と協議し安定経営を図る"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "見守りネットワークを普及推進する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "地域包括ケアシステムを推進する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "介護予防と介護サービスを充実させる"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "高齢者や交通弱者のため運行支援を続ける"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "関係町と連携し持続的運行を検討する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "防災のしおり改訂などで対策を進める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "高台移転改築の検討を進める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "住民サービス低下を招かない組織再編を検討する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "在宅勤務や分散勤務を模索する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "サテライト型テレワークで人口交流増加を目指す"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "重点課題に取り組みつつ規律ある財政運営を行う"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "町民の声を丁寧に聞き信頼関係を築く"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "町民手作りの観光プロモーションビデオは重要で価値がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "地域力を借りながら地域包括ケアシステムを推進する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:st_2 rdfs:label "3番沼山雄平"@ja.
kg:st_2 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_30 prop:content "海抜が低く防災拠点として危険であり可能な限り早く移るべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "町民にわかりやすいPRを進めたい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:st_3 rdfs:label "7番工藤松子"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_32 prop:content "高齢者が新しい生活様式を身につけられるよう工夫が必要"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "いきいき教室や老人クラブなどを通じ周知する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "住環境を整えて医療従事者に従事してもらう"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "交通弱者を守る観点で公共交通を支援する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "合意形成されれば国の認定に向け手を挙げたい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "町の起爆剤になる可能性がある"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "危険箇所について北海道へ要望していく"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "町単独の経済対策も盛り込み提案する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "ICT活用で学びを保障できる環境を早急に実現する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "全町で整備できるよう情報を得ながら進める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "人口を減らすスピードを落とす施策に取り組む"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "町を支える人を育てる環境づくりを進める"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "病院スタッフが赤字圧縮に努力した"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "若い漁業者の意識が変わってきている"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "新たな加工に転換する人がいれば応援する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "町全体として相当大きい打撃になっている"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "町民の声を聞く時間を設けたい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "住民サービス低下にならない機構改革を進める"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "交付税は下がる認識でいる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:st_4 rdfs:label "商工会青年部"@ja.
kg:st_4 rdfs:type cls:st_61.
cls:st_61 rdfs:label "経済団体"@ja.
kg:op_51 prop:content "冷え込んだまちの経済を回す消費喚起策を提案"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:st_5 rdfs:label "6番近江武"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_52 prop:content "町の基幹産業への影響は計り知れない"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_5.
kg:op_53 prop:content "採算が合わずやむなく休業している"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:op_54 prop:content "ウニの価格下落が漁業に大きな影響を与える"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_5.
kg:op_55 prop:content "採算が合わず中止になった"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_5.
kg:op_56 prop:content "ナマコ価格下落も大きい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_5.
kg:op_57 prop:content "漁獲枠と価格下落の継続は大きな打撃"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_5.
kg:op_58 prop:content "今後もかなりの影響が出る"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:op_59 prop:content "基幹産業の漁業への影響は大きい"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "これから本格化する魚種で魚価安が懸念される"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "町独自支援を実施している"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:op_62 prop:content "電子申請できない漁業者を役場で支援している"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "国対象外の減収事業者にも町独自支援を行う"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:op_64 prop:content "漁協負担軽減策を選択肢として検討している"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "経費節減により経営安定を支援する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_1.
kg:op_66 prop:content "賃貸型牛舎や研修環境整備を進める"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_1.
kg:op_67 prop:content "どの業務に使えるか調査し検討している"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "様々な分野で利用可能で自治体も注目している"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_1.
kg:op_69 prop:content "緊急を要する人命救助などに大きな成果が見込めるため導入検討する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_1.
kg:op_70 prop:content "医療現場を全面的にバックアップする"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_1.
kg:op_71 prop:content "必要資材の確保に努める"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
kg:op_72 prop:content "院内で迅速検査できる体制構築が必要"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_1.
kg:op_73 prop:content "町としてできることを模索し対応する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_1.
kg:op_74 prop:content "希望世帯には滞りなく設置し積極的に進める"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_1.
kg:op_75 prop:content "検査可能な体制を少しでも早く構築したい"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_1.
kg:op_76 prop:content "町民一人一人の感染予防対策の効果の表れ"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_1.
kg:op_77 prop:content "町民の感染予防行動の効果が出ている"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_1.
kg:op_78 prop:content "松前町から感染者を発生させないよう万全を尽くす"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "歳入総額５８億４千２１０万１千９７４円、歳出総額５６億８千３０１万４千３９７円で、歳入歳出差引残額が１億５千９０８万７千５７７円となり"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:text-txt_contents "このうち５千万円につきましては翌年度へ繰り越しし、残額につきましては、全額財政調整基金に編入したところでございます"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "歳入総額１１億１千４２万９千９２６円、歳出総額１１億３１９万１千７１９円で、歳入歳出差引残額が７２３万８千２０７円のとなり"@ja.
<< kg:id_4 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "翌年度へ全額繰り越ししております"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:text-txt_contents "歳入歳出差引残額が３千４５７万８千８７１円"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:text-txt_contents "歳入歳出差引残額が４４万１３４円となり"@ja.
<< kg:id_7 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "それぞれ翌年度へ全額繰り越ししております"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:text-txt_contents "歳入歳出差引残額が６５万９千３１円となり"@ja.
<< kg:id_11 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "翌年度へ全額繰り越しております"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:text-txt_contents "水道事業会計につきましては、令和２年３月３１日をもって事業を終了致しました"@ja.
<< kg:id_13 prop:effect kg:id_15 >>
    prop:text-txt_contents "当年度の純利益は、２千７５万２千８６７円となります"@ja.
<< kg:id_13 prop:effect kg:id_16 >>
    prop:text-txt_contents "差し引き８千９３万６千２６６円の不足を生じました"@ja.
<< kg:id_13 prop:contermeasure kg:id_17 >>
    prop:text-txt_contents "この措置につきましては、減債積立金１００万円、過年度分損益勘定留保資金５千２５９万１千３５６円、当年度分損益勘定留保資金１千７７６万７千４６９円、当年度分消費税及び地方消費税資本的収支調整額９５７万７千４４１円で補てんし"@ja.
<< kg:id_18 prop:cause kg:id_14 >>
    prop:text-txt_contents "病院事業会計でございますが、令和２年３月３１日をもって事業を終了致しました"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:text-txt_contents "当年度の純損失は、８００万６千７７４円となります"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:text-txt_contents "差し引き１千７３２万５千７４５円の不足を生じました"@ja.
<< kg:id_18 prop:contermeasure kg:id_21 >>
    prop:text-txt_contents "この措置につきましては、減債積立金１００万円、過年度分損益勘定留保資金１千６３２万５千７４５円で補てんし"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:text-txt_contents "学校給食費は１０件１名、２９万９千５００円、債務者死亡によるものです"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:text-txt_contents "国民健康保険診療報酬等返納金は１件２名、１３１万８千７２３円、時効によるものです"@ja.
<< kg:id_26 prop:cause kg:id_25 >>
    prop:text-txt_contents "国民健康保険診療報酬と返納金加算金は１件２名、１３２万３千８２２円、時効によるものです"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:text-txt_contents "水道料金は１件１名、４千１０４円、破産によるものです"@ja.
<< kg:id_27 prop:cause kg:id_23 >>
    prop:text-txt_contents "同じく水道料金で１件１名、２千７５４円、債務者死亡によるものです"@ja.
<< kg:id_29 prop:cause kg:id_23 >>
    prop:text-txt_contents "休栓料金は２件１名、１万４千５８０円で、債務者死亡によるものです"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:text-txt_contents "病院診療費は８件４名、５１万１千５１８円、生活困窮によるもの"@ja.
<< kg:id_30 prop:cause kg:id_23 >>
    prop:text-txt_contents "２３件１５名、３９万４千４１７円、債務者死亡によるもの"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:text-txt_contents "４３件３０名、５８万９千５３７円、所在不明によるもの"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:text-txt_contents "合計で９０件５７名、４４５万８千９５５円の債権を放棄したところでございます"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:text-txt_contents "８款２項橋りょう維持事業は、令和元年度国の補正予算第１号の社会資本整備総合交付金の採択を受けたことにより、令和元年度繰越事業としての対応となったところです"@ja.
<< kg:id_35 prop:effect kg:id_37 >>
    prop:text-txt_contents "繰越明許費金額は、９１９万８千８００円で、この内、翌年度繰越額は同額の９１９万８千８００円としたところであります"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:text-txt_contents "パンデミックスを引き起こした新型コロナウイルス感染症という大きな危機"@ja.
<< kg:id_38 prop:effect kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "町民の命と財産、更には経済活動を守っていく、その難しさと責任の重さを強く感じているところであります"@ja.
<< kg:id_38 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "次の３点を喫緊の重点課題として取り組んでまいります。１、新型コロナウイルス感染症拡大防止と町経済及び産業への影響に対する対策"@ja.
<< kg:id_38 prop:effect kg:id_42 >>
    prop:text-txt_contents "世界中で猛威を振るう新型コロナウイルスの感染症は、数ヶ月で経済に大きな混乱をもたらし、多くの犠牲者もだしました"@ja.
<< kg:id_38 prop:effect kg:id_43 >>
    prop:text-txt_contents "第７３回松前さくらまつりが中止になるなど、町内における経済的打撃は大きく"@ja.
<< kg:id_38 prop:effect kg:id_44 >>
    prop:text-txt_contents "観光産業はこれまで経験のしたことのない影響を受けております"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "町としては、緊急経済対策として、国と連携しながら町独自の経済支援を実施し"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今後も冷え込んだ経済の復旧対策を進めていく所存です"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "収束の兆しが見えつつあるものの、まだまだ予断を許す状況には至っていないと認識しております"@ja.
<< kg:id_38 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "国や北海道が示している新しい生活様式の実践や"@ja.
<< kg:id_38 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "町としては、国と連携した支援を長期戦も視野に入れて取り組んでまいります"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "老朽化の進む町立松前病院の改築と相応しい病院づくり"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "病院は、町民が健康で安心した生活を送るために欠かすことのできないものと強く認識しております"@ja.
<< kg:id_55 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "医師並びに医療スタッフの確保に全力を尽くすとともに"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "３、肉牛改良センターの運営体制の充実"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "町内畜産農家への子牛の供給により、安定した経営ができるよう支援するとともに"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "研修生の受け入れや、賃貸型牛舎の建設を行い、町内で新規就農を開始できるよう支援してまいります"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:text-txt_contents "牛の飼養頭数が増える見込みがあり"@ja.
<< kg:id_64 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "町営牧場の草地の更新も検討してまいります"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:text-txt_contents "水産加工業については、原料不足が続き"@ja.
<< kg:id_67 prop:cause kg:id_69 >>
    prop:text-txt_contents "従業員不足も解消されず"@ja.
<< kg:id_67 prop:effect kg:id_70 >>
    prop:text-txt_contents "大変厳しい経営状況となっております"@ja.
<< kg:id_67 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "関係者と協議を重ね、安定経営が図られるよう取り組んでまいります"@ja.
<< kg:id_72 prop:cause kg:id_73 >>
    prop:text-txt_contents "高齢化率は、５０％台に突入し、２人に１人が高齢者という現状の中で、ひとり暮らしの高齢者等の割合も高くなっております"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:text-txt_contents "全国的にも高齢者等の孤立死が社会問題となっており"@ja.
<< kg:id_76 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "地域全体での高齢者等見守りネットワークの普及、推進を図ってまいります"@ja.
<< kg:id_76 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地域包括ケアシステムの推進を図り"@ja.
<< kg:id_76 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "介護予防、介護サービスの充実に取り組んでまいります"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:text-txt_contents "地域公共交通の維持確保については、年々利用者が減少しているところではありますが"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "買い物や通院等に利用される高齢者や交通弱者のため、町内を運行する大漁くんバス及びハイヤーの持続的な運行を支援してまいります"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "町外への接続バスの運行につきましても、関係町と連携を図り、持続的な運行に支障がでないよう支援を含めて検討してまいります"@ja.
<< kg:id_86 prop:cause kg:id_87 >>
    prop:text-txt_contents "北海道が行う土砂災害警戒区域の指定が本年度で完了する見込みとなったことから"@ja.
<< kg:id_86 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "各種ハザードマップを含めた総合的な防災情報を網羅した「防災のしおり」の改訂など、防災対策に万全を期してまいります"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:text-txt_contents "防災対策の拠点となる役場庁舎が「津波災害警戒区域」の中に位置することから"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "高台への移転改築の検討も進めてまいります"@ja.
<< kg:id_92 prop:cause kg:id_93 >>
    prop:text-txt_contents "人口減少に伴い職員数も減少する中で"@ja.
<< kg:id_94 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "簡素で効率的な組織機構の見直しや支所のあり方など、住民サービスの低下に繋がらないような組織の再編を検討してまいります"@ja.
<< kg:id_96 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "テレワーク（在宅勤務や役場庁舎以外の施設を活用した分散勤務）の方策を模索し"@ja.
<< kg:id_98 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "あわせて企業によるサテライト型テレワークを推進し、移住定住に係る人口交流の増加を目指します"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:text-txt_contents "我が町の財政基盤は脆弱であり、地方交付税に頼った財源構造にあります"@ja.
<< kg:id_102 prop:effect kg:id_103 >>
    prop:text-txt_contents "人口減少は、地方交付税の算定及び交付額に影響を及ぼします"@ja.
<< kg:id_104 prop:effect kg:id_105 >>
    prop:text-txt_contents "本年１０月１日に国勢調査が実施され、更なる人口減は避けられない状況にあります"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "次年度以降における地方交付税の推計を踏まえ、重点課題に取り組みながらも規律ある財政運営に心がけ"@ja.
<< kg:id_108 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "「町民の声を丁寧に聞き、町民に優しい職場づくり」を基に、町民との信頼関係を築き"@ja.
<< kg:id_110 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "町民が手作りでそういうふうなプロモーションビデオつくっていうのは、大変重要なことであって、価値のあることだなというふうに思っております"@ja.
<< kg:id_112 prop:cause kg:id_113 >>
    prop:text-txt_contents "家族や若い元気な世帯が高齢者を支えるというシステムは、現在通用しなくなってきている"@ja.
<< kg:id_112 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "高齢者が介護状態となっても、可能な限り住み慣れた地域で必要なサービスを受けながら、自分らしい暮らしを続けられるためのシステムが必要だ"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "相当川のすぐ側にある、それも海抜が５．５メートルほどと、非常に危険を感じていると。はたしてそれが防災の拠点となるのか"@ja.
<< kg:id_112 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "町民の皆さんに理解しづらい部分もあるやに聞いておりますので、わかりやすいＰＲを進めていきたい"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "高齢者の方の理解が不十分だというふうにご指摘されれば、なるほどなというふうに思われるケースもある"@ja.
<< kg:id_120 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "いろいろいきいき教室であるとか、それから高齢者の集まる場所など、更には、老人クラブなどを通じまして周知をしていきたい"@ja.
<< kg:id_122 prop:cause kg:id_123 >>
    prop:text-txt_contents "住環境って言うんですか、松前に来て住むところの環境にも大変気をつかわれている"@ja.
<< kg:id_122 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "まず住環境を整えるべく、今事業管理者、更には病院長といろいろ相談をしております"@ja.
<< kg:id_125 prop:effect kg:id_126 >>
    prop:text-txt_contents "今回コロナの関係でバスもタクシーも大変影響を受けている"@ja.
<< kg:id_125 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "地域の足を守る、交通弱者を助けると、守るというふうな観点で、公共交通を守っていくための支援をしてまいりたい"@ja.
<< kg:id_128 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "町と致しましても利害関係のある漁業協同組合と本格的な話し合いを設けながら、お互いに合意形成されるのであれば、国の方の認定に向けて手を挙げていきたい"@ja.
<< kg:id_128 prop:effect kg:id_130 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "固定資産税、償却資産の税収増にもなりますし、例えば洋上で作業するようなことになりますと、船も必要となり、雇用も生まれる。更には、漁場を失うことによる漁業補償等々、漁業振興策も見込める"@ja.
<< kg:id_131 prop:contermeasure kg:id_132 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "危険な箇所、まだまだあるように思っておりますので、要望する、できる箇所があれば、積極的に要望活動していきたい"@ja.
<< kg:id_133 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "６月の末に町独自の対策も含めまして、議会の皆さんにご提案をしてまいりたい"@ja.
<< kg:id_135 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "令和５年度に達成するとされている端末の整備を令和２年度中に前倒ししながら、実現をさせていきたい"@ja.
<< kg:id_137 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "光回線の控除もあるような状況、情報が入ってきておりますので、これに乗れれば乗って行きまして、デジタル難民っていう地域の解消、格差の解消できるような方向を考えられる"@ja.
<< kg:id_102 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "人口を減らすスピードを少しでも伸ばすことによって、何て言いますか、町の力も残る"@ja.
<< kg:id_140 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "本当に町を支えてくれる人の人材確保に向けた施策をこれから取り組んでいきたい"@ja.
<< kg:id_142 prop:cause kg:id_143 >>
    prop:text-txt_contents "病院側とすれば感染症、院内感染を防ぐためにベッドをわざわざ空けて、入院患者をとらないというふうな状況下"@ja.
<< kg:id_142 prop:effect kg:id_144 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "結果として８００万の赤字に抑えていただいた"@ja.
<< kg:id_145 prop:effect kg:id_146 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "コンブの潜水器、新規の着業者２名予定しているようであります。どんどん若い漁業者の方々の意識も変わってきている"@ja.
<< kg:id_147 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "スルメイカの漁業不振等による原料不足に対応した新たな加工業種に転換する人がおるんであれば、きちんと設備投資を含めながら、応援できることも考えていかなければならない"@ja.
<< kg:id_149 prop:effect kg:id_150 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "６億４千２４３万２千円の消費の減に繋がってる"@ja.
<< kg:id_108 prop:contermeasure kg:id_151 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "この３期目は、もう一度町民の声を聞くために、移動町長室には挑戦してみたい"@ja.
<< kg:id_152 prop:cause kg:id_153 >>
    prop:text-txt_contents "人口も減って、職員の数も減っておりまして、人材もなかなか育たないというふうな状況"@ja.
<< kg:id_152 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "来年の４月の１日に機構の改革をして、簡素化をすると。組織のスリム化をしていく"@ja.
<< kg:id_155 prop:effect kg:id_156 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "１億くらいの交付税の減額は予想される"@ja.
<< kg:id_157 prop:effect kg:id_158 >>
    prop:text-txt_contents "大型風車１２基等の風力発電施設の償却資産にかかる固定資産税が確定したことによる計上"@ja.
<< kg:id_159 prop:cause kg:id_160 >>
    prop:text-txt_contents "令和元年度実績で、ハイヤー運賃収入が前年度比１６２万７千円程度減少したことで赤字が拡大し"@ja.
<< kg:id_159 prop:cause kg:id_161 >>
    prop:text-txt_contents "新型コロナウイルス感染症の影響で、外出の自粛やさくらまつりが中止となり、今年度４月も３０％を超える減少と、５月は５０％以上の減少した"@ja.
<< kg:id_159 prop:contermeasure kg:id_162 >>
    prop:text-txt_contents "補助金を増額して、ハイヤー事業の運営の維持を図ろうとするものです"@ja.
<< kg:id_163 prop:contermeasure kg:id_164 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "新型コロナウイルス感染症拡大防止による影響が大きかった飲食店や土産店を対象に"@ja.
<< kg:id_165 prop:effect kg:id_166 >>
    prop:text-txt_contents "新型コロナウイルス感染症拡大防止による影響が大きかった飲食店や土産店"@ja.
<< kg:id_165 prop:contermeasure kg:id_167 >>
    prop:text-txt_contents "本事業費は、国の臨時交付金の対象となるものですが、国の補正を待っていては事業効果に影響があることから、一時一般財源で対応するものです"@ja.
<< kg:id_38 prop:effect kg:id_168 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "特に松前さくらまつりの中止は、松前町の経済に大きな打撃を与えております"@ja.
<< kg:id_169 prop:cause kg:id_170 >>
    prop:text-txt_contents "昨年市況１６０円から１００円の価格で推移されましたが、今年は５８円という価格に下落"@ja.
<< kg:id_169 prop:effect kg:id_171 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "出漁しても採算が合わずにやむなく休業してる状況です"@ja.
<< kg:id_172 prop:effect kg:id_173 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "今年は７００円台となり、今後も更に価格の下落が予想されております"@ja.
<< kg:id_174 prop:cause kg:id_175 >>
    prop:text-txt_contents "今年は価格が安く折り合いがつかないため、採算が合わないために中止"@ja.
<< kg:id_174 prop:effect kg:id_176 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "今年は価格が安く折り合いがつかないため、採算が合わないために中止と聞いております"@ja.
<< kg:id_177 prop:effect kg:id_178 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "昨年の５月はキロ６千円の価格で推移されましたが、今年は４千円と下落しております"@ja.
<< kg:id_179 prop:cause kg:id_180 >>
    prop:text-txt_contents "入荷は半減しており、魚の値段が下がり、客も来ない。ほぼ頓死の状態"@ja.
<< kg:id_181 prop:effect kg:id_182 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "松前町のマグロも漁獲枠と価格の下落が続けば、かなり打撃が被ること必至です"@ja.
<< kg:id_183 prop:effect kg:id_184 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "松前町の畜産においても、対前年度５月対比では、１頭あたり２０万円も下落"@ja.
<< kg:id_185 prop:effect kg:id_186 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "令和元年同期合計に比較しますと、生産量で１８％の減、生産額で１５％の減となっております"@ja.
<< kg:id_185 prop:cause kg:id_187 >>
    prop:text-txt_contents "原因と致しましては、魚価の落ち込みが大きいものでありまして、魚種につきましてはタラ、エビ、ソイ類、タコ等で、２割から４割安となっている"@ja.
<< kg:id_188 prop:effect kg:id_189 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "昨年と比較しましても２から３割程度の安、魚価安という部分では懸念をされている"@ja.
<< kg:id_190 prop:contermeasure kg:id_191 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "町独自の対策として、漁業者を含む町内事業者に対して、一律１０万円を支給しております"@ja.
<< kg:id_190 prop:contermeasure kg:id_192 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "町で申請の支援を行っているところであります"@ja.
<< kg:id_193 prop:contermeasure kg:id_194 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "４０％、５０％未満の減少事業者へ３０万、３０％から４０％未満減少事業者につきましても２０万を支給する経営支援"@ja.
<< kg:id_195 prop:cause kg:id_196 >>
    prop:text-txt_contents "魚価低迷で生産額減少に伴い、漁協の販売手数料の減少による漁協の経営が大きく懸念"@ja.
<< kg:id_195 prop:contermeasure kg:id_197 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "地方創生臨時交付金、今回の補正にも載っておりますが、この中で、これを活用した対策の検討を今現在進めているところであります。現状の松前町の漁業支援総合補助金の町の補助率の上乗せによる漁協負担の軽減"@ja.
<< kg:id_198 prop:contermeasure kg:id_199 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "優良繁殖牛の導入にかかる補助、更には牧草、安い値段で提供するなどの支援を行って、畜産農家の経費節減によりまして、経営の安定をまだまだ支援してまいりたい"@ja.
<< kg:id_200 prop:contermeasure kg:id_201 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "肉牛改良センターに伴う賃貸型の牛舎の建設、更には研修される人の環境づくりにつきましては、議員ご指摘のとおり"@ja.
<< kg:id_202 prop:contermeasure kg:id_203 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "平成３０年度に各課において、ドローンを導入した場合、どのような業務に使用ができるのか、アンケートを調査し、その結果を基に検討会を開催"@ja.
<< kg:id_204 prop:effect kg:id_205 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "ドローンの活用につきましては、議員おっしゃるように自然災害における被災状況の把握、行方不明者の捜索などの防災分野のみならず、ゴミの不法投棄の調査、観光振興分野等々、様々な活用が考えられている"@ja.
<< kg:id_202 prop:contermeasure kg:id_206 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "渡島西部広域事務組合との中でも議論を重ねているところであります。連携しながら、協議を含め、購入に、導入に向けた検討を進めてまいりたい"@ja.
<< kg:id_207 prop:contermeasure kg:id_208 >>
    prop:text-txt_contents "病院入口に警告板設置、玄関と受付、再来機横に手指消毒用アルコールを設置し、入院患者様への原則面会禁止を行ってきた"@ja.
<< kg:id_209 prop:contermeasure kg:id_210 >>
    prop:text-txt_contents "発熱接触者外来として、同日使用していない耳鼻科診察室、もしくは眼科診察室で待機をしていただき、防護服を着用した医師、看護師が対応"@ja.
<< kg:id_211 prop:effect kg:id_212 >>
    prop:text-txt_contents "６月８日現在で、新型コロナウイルス感染症疑いとして実施致しましたＰＣＲ検査は、１６例ございますが、幸いいずれも陰性の結果"@ja.
<< kg:id_211 prop:contermeasure kg:id_213 >>
    prop:text-txt_contents "ＰＣＲ検査のための検体採取から陰性結果判明までの４８時間から７２時間は、新型コロナウイルス感染症疑いの患者様として個室隔離、個人防護服着用での感染対策を徹底"@ja.
<< kg:id_214 prop:contermeasure kg:id_215 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "病院で今何が必要なのか、医療現場の意見にしっかりと対応して、今後の医療体制強化を図るために全面的にサポート、バックアップをしてまいりた"@ja.
<< kg:id_216 prop:cause kg:id_217 >>
    prop:text-txt_contents "病院ではＮ９５マスク、フェイスシールド、サージカルガウンにつきまして、在庫が限られております"@ja.
<< kg:id_216 prop:contermeasure kg:id_218 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "今後予測される第３波や冬期間への対応として準備を要する状況であることから、確保に努めてまいります"@ja.
<< kg:id_219 prop:contermeasure kg:id_220 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "担当医の判断によって、院内で迅速検査を実施できる体制が望ましい"@ja.
<< kg:id_221 prop:contermeasure kg:id_222 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "ガンバルーン体操の参加者には、電話で健康確認や自宅でも簡単にできる体操などをペーパーにして配布"@ja.
<< kg:id_223 prop:contermeasure kg:id_224 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "今後におきましてもＰＲをしながら、積極的に対応をしてまいりたい"@ja.
<< kg:id_225 prop:effect kg:id_226 >>
    prop:text-txt_contents "両者を臨床症状のみで区分することは不可能であります"@ja.
<< kg:id_209 prop:contermeasure kg:id_227 >>
    prop:text-txt_contents "一般外来の患者様と導線が重ならないよう、発熱、接触者外来として別室での対応"@ja.
<< kg:id_228 prop:contermeasure kg:id_229 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "少しでも早く、松前病院において検査可能な体制を構築することができるように取り組んでまいりたい"@ja.
<< kg:id_230 prop:cause kg:id_231 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "新型コロナウイルス感染症が広がり、手洗い、マスクの着用など徹底され、そのことがインフルエンザの患者にも影響した"@ja.
<< kg:id_230 prop:effect kg:id_232 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "今シーズン病院で確認された患者さんの数は、例年と比較すると大幅に減少している状況であります"@ja.
<< kg:id_38 prop:contermeasure kg:id_233 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "町民の皆さんには、感染予防対策と致しました新しい生活様式、新北海道スタイルの取り組みをしっかりとお願いして、松前町から感染者を発生させないように"@ja.
}
