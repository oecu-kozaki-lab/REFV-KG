kg:st_1 rdfs:label "６番近江武君"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "町の活性化の起爆剤として洋上風力発電の誘致推進を早急に行うべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "町の活性化の起爆剤として洋上風力発電の誘致推進を早急に行うべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "財政健全化のため洋上風力発電に取り組むべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "洋上風力発電は町の活性化の起爆剤になりうる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "財政健全化を考えた場合も洋上風力発電の誘致推進が必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長石山英雄君"@ja.
kg:st_2 rdfs:type cls:st_96.
cls:st_96 rdfs:label "町長"@ja.
kg:op_6 prop:content "人口減少や産業活性化に向けて洋上風力発電建設は有意義"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "税収増や建設需要増など大きな効果が見込める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "建設段階から地域経済への波及効果が大きい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "地元企業への仕事が増える点を評価している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "メンテナンス需要により漁業者の仕事も増える"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "促進区域指定がなされるよう国に手を挙げていきたい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "まず漁業関係者の理解を得るため説明を進める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "将来を見込み町の活性化のため積極的に推進したい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "老朽化は避けて通れず早く良い環境で医療提供したい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:st_3 rdfs:label "９番梶谷康介君"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_15 prop:content "患者が快適な環境で治療に専念できる病院が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "働く環境を整えて医師や看護師の確保につなげるべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "改築を機に施設設備や医療機器をきちんと整備すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "今年度中に基本構想を策定し議会に示したい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "来年度から建物の基本計画に入りたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "基本構想案ができ次第院内に準備委員会を立ち上げる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "副町長をトップに関係課を入れた検討委員会で進める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "議会や町民に示しながら松前に相応しい病院を議論したい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "修学資金制度の利用減少には少子化の影響がある"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "都市部志向が強く地方病院の人材確保が難しい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "病院側のPR不足も要因の一つと認識している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "貸付金額や返済免除期間などを見直すべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "関係各課と町全体で制度見直しに取り組む"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:st_4 rdfs:label "４番宮本理恵子君"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_28 prop:content "町内会だけで会館を維持管理するのは無理になっている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "高齢化で役員の負担が重く町内会館運営が厳しい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "会費減収で町内会館の維持管理が難しい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "葬儀利用減少で会館運営収入が減っており危惧している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "収入減少で管理運営が厳しくなると見ている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "各会館の現状を調査したうえで支援方法を判断する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "譲渡か補助か近隣町村も見ながら判断したい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:st_5 rdfs:label "１１番堺繁光君"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_35 prop:content "地方交付税の減少は町財政への大打撃で行政サービスに影響しかねない"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "コロナ禍で今後さらに地方交付税の締め付けが懸念される"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "町民に不安を与えないよう行政サービスを維持すべき"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "地方交付税依存を減らすには自主財源を増やすことが重要"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "現状の行政サービス維持のため余剰支出を抑制するしかない"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "歳入に合わせた歳出という大原則を守るべき"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "単年度でなく数年かけて収支バランスを図る必要がある"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "光回線未整備があり企業向けテレワーク施策に踏み出せなかった"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "地理的条件の難しさもあり二の足を踏んでいた"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "まず情報収集と状況分析を進めるべき"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "東急不動産のサテライトオフィス構想に積極的に協力したい"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "専門家の意見を聞きながら積極的に進めたい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "旅館や休眠施設、空家活用や新築も含め受入体制を整えるべき"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "ホームページやSNSなどあらゆるチャンネルで周知したい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:st_6 rdfs:label "７番工藤松子君"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_49 prop:content "この冬はインフルエンザを抑えることを優先すべき"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:op_50 prop:content "見分けが難しいためインフルエンザ流行を防ぐ必要がある"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_6.
kg:op_51 prop:content "医療現場の負担軽減のためにも予防接種を広げるべき"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:op_52 prop:content "医療現場を守るため町を挙げてインフルエンザを抑えるべき"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_6.
kg:op_53 prop:content "希望する町民全てが接種できるよう病院と協議して体制整備する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "防災無線を使いインフルエンザ予防とコロナ予防を継続して呼びかける"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "コロナによって経済の落ち込み、基幹産業の漁業、水産加工業においては以前と明るい兆しが見えておりません。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "基幹産業の漁業、水産加工業においては以前と明るい兆しが見えておりません。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "今後、国勢調査による人口減少が顕著になり、国の交付金も大幅に減少が予測されております。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "松前町の経済の活性化の起爆剤になりえ"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、松前町の財政健全化を考えた場合、洋上風力発電の誘致推進を早急に行う必要があると思います"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "人口減少や産業の活性化に向けた洋上風力発電の建設は有意義なものであるというふうに、町長として考えているところであります。"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "議員ご指摘のように固定資産税、償却資産税ありますね、増収はもとより"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "建設時のこの建設に関わる人口の交流、更には消費の増加"@ja.
<< kg:id_7 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "更には地元企業への仕事も増えることになります。"@ja.
<< kg:id_7 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "建設後は必ずメンテナンスが発生致しまして、洋上でありますので船も必要となります。漁業者の副業、更には専業としての仕事が確実に増えるというふうに思っているところであります。"@ja.
<< kg:id_7 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "松前町と致しましても、洋上風力にかかる促進区域の指定がなされるように、国に手を挙げていきたいというふうに考えております。"@ja.
<< kg:id_7 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "さくら漁協と早急に協議を進めまして、まずは、促進区域の指定に向けた情報提供に理解が得れるような説明をしてまいりたい"@ja.
<< kg:id_7 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "松前町と致しましては、将来を見込み、日本のエネルギー供給に対応するために、そして町の活性化のためにも松前沖の洋上風力発電を積極的に推進していきたい"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "病院の老朽化は避けて通られない問題だというふうなことは、最初からであります。"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "病院で健康回復のために病気と闘っている人方が快適な環境でなければいけない"@ja.
<< kg:id_16 prop:effect kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "働く環境をね、きちっとして、そういうスタッフを揃えたいっていうこともおっしゃってますよね。"@ja.
<< kg:id_16 prop:effect kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "現在何とか対応している施設設備、更に医療機器、そうしたものも相当老朽化して、何とかやりくりしながら使っている"@ja.
<< kg:id_16 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "今年度につきましては基本構想を策定する業務のみに変更させていただきまして、今年度中に基本構想案を作成する状況になってきております。"@ja.
<< kg:id_16 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "来年度につきましては、いよいよ建物の方に入って行くというふうな流れでは、今作業進めているところであります。４月からは施設の、いよいよ基本計画に着手する"@ja.
<< kg:id_16 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "まず、基本構想案ができ次第に院内に病院改築準備委員会を立ち上げたい"@ja.
<< kg:id_16 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "副町長はじめとする町の関係課等を入れて、財政もあるだろうし、建設もあるだろうし、いろんな関係課を入れた中で、病院改築検討委員会を設置します。"@ja.
<< kg:id_16 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "議員も皆さんに、機会があれば町民の皆様にも知らせるチャンスはあるんだろうなというふうに思っておりますんで、それは示していきたいなと思っておりますし"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "この減少の要員と致しまして、病院の方でもいろいろ分析をしておりまして、まず少子化による看護学生数の減"@ja.
<< kg:id_26 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "更には勤務する病院の希望が都市化傾向にあるというふうなことであります。"@ja.
<< kg:id_26 prop:cause kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "それと、加えて残念ながら町として、病院としてのＰＲ不足もあったのかなというふうなことが考えられているところであります。"@ja.
<< kg:id_26 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "貸付金の金額、更には返済、返還、債務の免除期間等々、いろんな自治体病院でも取り組みをしておりますので"@ja.
<< kg:id_26 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "関係各課と町を挙げての全体を協議していって、この取り組みを進めてまいりたい"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "若い人達が少ない今、町内会員の減少と会員の高齢化により、町内会費の減収もあり"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "町内会員の減少と会員の高齢化により"@ja.
<< kg:id_32 prop:cause kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "町内会費の減収もあり、それぞれの町内会の役員の皆さんは頭を痛めている"@ja.
<< kg:id_32 prop:cause kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "今現状は民間の葬儀場の利用が増加しておりまして、町内会館や町の施設を使用して葬儀を行う方が減少してきている"@ja.
<< kg:id_32 prop:effect kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "収入が減少して、管理運営が厳しいと推測されることから"@ja.
<< kg:id_32 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "今年度中に管理状況などを調査を行ってみたいなというふうに思っております。"@ja.
<< kg:id_32 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "譲渡を受けるのがいいのか、あるいは運営費を補助するような方法がいいのか、いろいろ近隣町村の状況も見極めながら判断をしてまいりたい"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "地方交付税の減少は、町の財政に対し大打撃となり、町民に対するいろんな行政サービスにも直接影響を及ぼしかねない"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "全世界を震撼させております新型コロナウイルスによる経済影響は計り知れないものがございます。"@ja.
<< kg:id_40 prop:effect kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "いろんな行政サービスにも直接影響を及ぼしかねないと心配するところでございます。"@ja.
<< kg:id_40 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "松前町に求められるものは、まず自主財源を増やすことだろうというふうに思っております。"@ja.
<< kg:id_40 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "歳出では行政サービスを、現状の行政サービスを維持していくために、余剰支出を限りなく抑制することで財政の維持を図っていく"@ja.
<< kg:id_40 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "歳入に合わせた歳出を図るという大原則を守っていくためには"@ja.
<< kg:id_40 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "数年かけてバランスを図るなど、中長期的な視点を持った予算編成、財政運営を進めて行かなければならない"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "光回線の未整備地区があることや"@ja.
<< kg:id_48 prop:cause kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "地理的な条件下で難しかったり、二の足を踏んでいたというのが本音のところであります。"@ja.
<< kg:id_51 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "政策財政課内に収集、情報を集め、収集を集めております。松前での状況分析などを進めているところであります。"@ja.
<< kg:id_51 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "東急不動産では、かねてからサテライトオフィス型のテレワークの地域貢献事業を検討しております。"@ja.
<< kg:id_51 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "移住やテレワーク等に精通したコンサル会社の社長他１名が、今年１月下旬に松前町に来ていただきました。"@ja.
<< kg:id_51 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "松前町で進めるとしたならば、旅館もありますので、サテライトオフィス型の施設が有効であると感じており、休眠施設や空家のリノベーションも一つの方法でありますけども、新築住宅が最善である"@ja.
<< kg:id_51 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "ホームページはもとより、ＳＮＳの活用や日本テレワーク協会への投稿、更には東急不動産などの企業連携を活用したＰＲ"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "この冬は新型コロナとインフルエンザが混在して流行するんじゃないか、そういうことが危惧されております。"@ja.
<< kg:id_57 prop:cause kg:id_59 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "同じような症状なので、新型コロナウイルス感染症の患者かインフルエンザかっちゅうのを見分けられない"@ja.
<< kg:id_57 prop:effect kg:id_60 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "医療機関の方でも、それから消防、救急車の方の消防職員の方も発熱患者と聞くと、その対応には、神経すり減らして万全の対策をして望まなければならない"@ja.
<< kg:id_57 prop:effect kg:id_61 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "患者自身も大変なんですけども、医療現場は本当に大変なことになります。"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "私どもと致しましては、希望する町民全てにインフルエンザワクチンが接種できるように、病院と協議しながらその体制整備に努力をしてまいりたい"@ja.
<< kg:id_62 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "防災無線を利用致しまして、町民の皆さんにインフルエンザ予防のために、コロナ予防のために実施していただけるように、ＰＲは続けてまいりたい"@ja.
}
