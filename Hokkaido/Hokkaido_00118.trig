kg:st_1 rdfs:label "４番宮本理恵子君"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "ワクチン接種の実施時期や課題を確認する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長石山英雄君"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_2 prop:content "接種会場や人員配置の改善点を踏まえ体制を整える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "情報提供を丁寧に行うべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_3 rdfs:label "５番福原英夫君"@ja.
kg:st_3 rdf:type cls:st_16.
kg:op_4 prop:content "町内の実情を調べて経済対策を予算化すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "８番西川敏郎君"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_5 prop:content "業態転換も含めた新しい経済支援体制をつくるべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:op_6 prop:content "早めの補正で経済対策と生活支援を行うべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "町民の命と健康を守るため万全を期す"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "漁業の現状は厳しく海を耕す施策への転換が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "魚価低迷と漁業者減少で将来に厳しいシグナルが出ている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:st_5 rdfs:label "２番飯田幸仁君"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_10 prop:content "各種対策をしても事業拡大まで至っていない"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "漁業の将来に厳しいシグナルが強まっている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "港と静穏域を活用した漁業への転換が必要"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "放流規模が小さく生産性向上に結びついていない"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "資源づくりへの投資規模を大きくすべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:st_6 rdfs:label "９番梶谷康介君"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_15 prop:content "漁港活用によるつくり育てる漁業を進めるべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:op_16 prop:content "静穏域活用漁業への転換以外に生き延びる道はない"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "魚種を意識した漁場造成の効果検証が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_6.
kg:op_18 prop:content "繰越欠損金解消と経営健全化の目的達成が厳しい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_6.
kg:op_19 prop:content "支援しても繰越欠損金が残る可能性が高い"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:op_20 prop:content "何としても経営健全化と組合員所得向上を達成すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_6.
kg:st_7 rdfs:label "１１番堺繁光君"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_21 prop:content "町内の人材も参画できるよう情報提供をしてほしい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_7.
kg:op_22 prop:content "研修生が町内外から就農できるように進めてほしい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_7.
kg:op_23 prop:content "草地改良事業の必要性と頭数見通しを明確にすべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_6.
kg:op_24 prop:content "町民や事業者への支援をさらに検討すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "町内の実情調査を踏まえ追加支援を行うべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "実施可否が町経済に大きく影響するため慎重な判断が必要"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "中止が宿泊業や売店組合に深刻な影響を及ぼす"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "感染対策を徹底した松前スタイルで実施できるなら支援する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:st_8 rdfs:label "７番工藤松子君"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_29 prop:content "松前の知名度向上へより細かな情報発信を続けてほしい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_8.
kg:op_30 prop:content "町民が試合観戦できるような企画もあるとよい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:st_9 rdfs:label "１０番斉藤勝君"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_31 prop:content "整備実施計画は時期を明確にして進めるべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_9.
kg:op_32 prop:content "要支援者を地域の声も拾って見落とさないでほしい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_8.
kg:op_33 prop:content "頑固で支援を受けない高齢者も地域で拾い上げる必要がある"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_8.
kg:op_34 prop:content "社会福祉協議会の活動に加え地域の動ける人も巻き込むべき"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_8.
kg:op_35 prop:content "要支援者の見落としがないよう連携を強めてほしい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_8.
kg:op_36 prop:content "元気づくりシステム導入時は既存の生活支援事業との調整が必要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:op_37 prop:content "高齢者の異変を地域で早く拾える体制が必要"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_8.
kg:op_38 prop:content "高齢者が頼り切りにならず能力や経験を生かせる支援が必要"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:op_39 prop:content "既存事業との整理や継続体制を明確にして進めるべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "既存の福祉や社会教育事業と屋上屋にならない調整が必要"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "病院改築以前に医師体制の厳しさを打破しなければならない"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:op_42 prop:content "病院が縮小されるのではと町民の不安が募っている"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_8.
kg:op_43 prop:content "医師減少で診療体制縮小への不安がある"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_8.
kg:op_44 prop:content "医師体制が極めて厳しく町民に不安と心配を与えている"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "管理者と院長の求める医療実現へ連携して医師確保に努める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "地域医療を守るため体制整備を最優先すべき"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:op_47 prop:content "町として医師確保への働きかけをもっと続けてほしい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_8.
kg:op_48 prop:content "医師確保は町長も含め総力戦で取り組むべき"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_6.
kg:op_49 prop:content "改築以前に医療提供体制を維持する手立てが必要"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:op_50 prop:content "人口減少下で長寿命化計画の在り方自体も検討すべき"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "経営戦略を具体化し町民にも状況を示しながら進めるべき"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:op_52 prop:content "オンラインなど横の連携を強めることが重要"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_5.
kg:op_53 prop:content "令和3年度中にほとんどの町民が取得するくらいの意気込みで進めるべき"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:op_54 prop:content "利用実態に合わせ公共交通の見直し時期に来ている"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "高齢者や交通弱者のため手法の再検討が必要"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "第2青函トンネルと一体で熱意を持って進めるべき"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:op_57 prop:content "道南全体で結束して進めるべき"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_4.
kg:st_10 rdfs:label "３番沼山雄平君"@ja.
kg:st_10 rdf:type cls:st_16.
kg:op_58 prop:content "備品の使い方も含めた実践的な避難所運営訓練が必要"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_10.
kg:op_59 prop:content "防災のしおりの発行時期を明確にして進めるべき"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_9.
kg:st_11 rdfs:label "１番疋田清美君"@ja.
kg:st_11 rdf:type cls:st_16.
kg:op_60 prop:content "移住希望者へのPRの仕方や具体施策を明らかにしてほしい"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_11.
kg:op_61 prop:content "テレワーク推進の具体内容を知りたい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_11.
kg:op_62 prop:content "空家活用や寮整備も含めて受け入れ体制を考えるべき"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_11.
kg:op_63 prop:content "空家と危険家屋を分けて危険家屋は優先除却すべき"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_10.
kg:op_64 prop:content "廃材の塊のような危険家屋は町民保護のため対策が必要"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_10.
kg:op_65 prop:content "支所の在り方は高齢者への配慮を十分にしたうえで検討すべき"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_10.
kg:op_66 prop:content "自主財源として町民所得の向上策も必要"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_3.
kg:op_67 prop:content "将来世代の負担を重くしない財政運営が必要"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_8.
kg:op_68 prop:content "所得向上のため漁業再生策を強化すべき"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_3.
kg:op_69 prop:content "松前町の所得水準が低く財政への影響が心配"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_8.
kg:op_70 prop:content "納付している町民との公平性からも厳しい対応が必要"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_3.
kg:op_71 prop:content "人口減少による交付税減を見据え自主財源確保策が必要"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_3.
kg:op_72 prop:content "将来負担を見据えた基金活用と財政運営が必要"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_8.
kg:op_73 prop:content "将来世代に過度の負担をかけないようにしてほしい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_8.
kg:op_74 prop:content "将来的に負担が重くならないよう基準を持って運営すべき"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_8.
kg:st_12 rdfs:label "６番近江武君"@ja.
kg:st_12 rdf:type cls:st_16.
kg:op_75 prop:content "町の起爆剤として洋上風力と併せ気運を高めて進めるべき"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_12.
kg:op_76 prop:content "特定企業だけでなく複数企業との連携も視野に入れるべき"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_3.
kg:op_77 prop:content "町全体の課題として推進協議会を立ち上げ気運を高めるべき"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_12.
kg:op_78 prop:content "地元が一丸となって国にアピールすべき"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_12.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "景気は、新型コロナウイルス感染症の影響により、依然として厳しい状況にあるが、持ち直しの動きがみられる。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "景気は、新型コロナウイルス感染症の影響により、依然として厳しい状況にあるが、持ち直しの動きがみられる。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "景気は、新型コロナウイルス感染症の影響により、依然として厳しい状況にあるが、持ち直しの動きがみられる。"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "内外の感染拡大による下振れリスクの高まりに十分注意する必要がある。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "内外の感染拡大による下振れリスクの高まりに十分注意する必要がある。"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:text-txt_contents "また、金融資本市場の変動等の影響を注視する必要がある。"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:text-txt_contents "また、金融資本市場の変動等の影響を注視する必要がある。"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "松前町においても、刻々と変化する新型コロナウイルス感染症の影響に関し、国等の動向に注視しながら、迅速な対応が図られるよう、全力で取り組む覚悟であります。"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "新型コロナウイルスワクチン接種事業では、円滑かつ速やかに接種できる体制を整備し、高齢者をはじめ順次接種を実施する予定でおり"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "高齢者をはじめ順次接種を実施する予定でおり"@ja.
<< kg:id_11 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "会場等の詳細については、関係機関と連携を図りながら速やかな情報提供に努めてまいります。"@ja.
<< kg:id_11 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "新たに増額された新型コロナウイルス感染症対応地方創生臨時交付金を財源とした感染症拡大防止及び経済対策事業等を早急に検討し、実施してまいります。"@ja.
<< kg:id_11 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "新型コロナウイルス感染症に関連する予算につきましては、早い時期での予算補正で対応し"@ja.
<< kg:id_11 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "町民の命と健康を守るため、万全を期してまいります。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "水産業については、スルメイカ資源の激減による全国的な不漁"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
