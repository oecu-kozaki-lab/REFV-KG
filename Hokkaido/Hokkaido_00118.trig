    prop:relatedOpinion kg:op_15;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "静穏域を利用した増養殖事業の推進を支援してまいります。"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:text-txt_contents "コンブ生産の増加により、天日乾燥加工作業に支障を来さないよう"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:text-txt_contents "海産干場の維持補修も進めてまいります。"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "大型魚礁の設置による漁場造成を松前小島周辺海域と静浦沖海域に"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:text-txt_contents "漁港整備については、各漁港において機能保全対策事業等により計画的に進められており"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "漁業協同組合については、コロナ禍により影響を受け"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "以前にも増して厳しい運営が続いておりますが"@ja.
<< kg:id_36 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "繰越欠損金を早期解消し、経営改善が図られるよう支援してまいります。"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:text-txt_contents "水産加工業については、全国的にスルメイカの不漁が続いておりますが"@ja.
<< kg:id_40 prop:countermeasure kg:id_42 >>
    prop:text-txt_contents "安定した稼働ができるよう、引き続き関係者と連携を図ってまいります。"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "肉牛改良センターの運営により生産される子牛を畜産農家へ供給することにより、安定した畜産経営ができるよう支援をしてまいります。"@ja.
<< kg:id_43 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "賃貸型牛舎等の整備を行い、町内での新規就農が促進されるよう支援してまいります。"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "肉牛の飼養頭数の増加が想定されるため、その飼料となる牧草が必要となることから"@ja.
<< kg:id_46 prop:countermeasure kg:id_48 >>
    prop:text-txt_contents "採草放牧地の更新を行い、牧草の増産を図ってまいります。"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:text-txt_contents "地域の森林整備の促進と、林業及び木材産業の活性化を図ってまいります。"@ja.
<< kg:id_49 prop:countermeasure kg:id_51 >>
    prop:text-txt_contents "地域材については、公共施設の建設に積極的に利用するとともに"@ja.
<< kg:id_49 prop:countermeasure kg:id_52 >>
    prop:text-txt_contents "地域材で建てる住宅支援事業についても、引き続き取り組んでまいります。"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:text-txt_contents "本年度から松前商工会に職員を派遣し、商工会運営の支援をしてまいります。"@ja.
<< kg:id_1 prop:cause kg:id_55 >>
    prop:text-txt_contents "新型コロナウイルス感染症拡大の影響で落ち込んだ景気"@ja.
<< kg:id_1 prop:effect kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "新型コロナウイルス感染症拡大の影響で落ち込んだ景気の下支えに万全を期す構えである"@ja.
<< kg:id_53 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "予算補正などの必要が生じた場合は適切に対応をしてまいります。"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:text-txt_contents "松前町就職サポートセンターによる求人情報の提供と就職相談を継続して実施し"@ja.
<< kg:id_58 prop:countermeasure kg:id_60 >>
    prop:text-txt_contents "通年雇用の促進と雇用先の確保に努めてまいります。"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "本年のさくらまつりは、コロナ禍により、まだ実施の可否を検討している状況であります。"@ja.
<< kg:id_61 prop:effect kg:id_63 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "町の一大イベントであり、経済への影響も大きいことから"@ja.
<< kg:id_61 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "町としては万全な支援体制を図ってまいります。"@ja.
<< kg:id_65 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "松前町公式ＬＩＮＥ等のＳＮＳを活用し、いち早い観光情報や観光需要の喚起、広報宣伝の強化に努めてまいります。"@ja.
<< kg:id_67 prop:countermeasure kg:id_68 >>
    prop:text-txt_contents "松前藩屋敷がオープンして３０周年を迎えることから、昨年、人気を呼んだ浮き紫陽花の見ごろに合わせて、記念イベントを実施し"@ja.
<< kg:id_69 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "北海道日本ハムファイターズ市町村応援大使の関連事業を通じて、町民に元気とパワーを与え、観光ＰＲにもつなげてまいります。"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:text-txt_contents "資源ごみの分別を推進することが、ごみ処理費用の削減に繋がることから"@ja.
<< kg:id_71 prop:countermeasure kg:id_73 >>
    prop:text-txt_contents "各町内会及び町民の皆様のご協力を得ながら、分別の徹底について広報活動を進めてまいります。"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:text-txt_contents "各町内会等と連携しながら、クリーン作戦、不法投棄防止対策に引き続き取り組んでまいります。"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "松前公園の整備方針を示す「松前公園整備実施計画」を、多様な関係者とコンセンサスをとりながら策定に取り組んでまいります。"@ja.
<< kg:id_76 prop:countermeasure kg:id_78 >>
    prop:text-txt_contents "松前観光協会に管理を委託し、桜の保護、保存及び管理はもとより、花木の管理や草刈りなど公園の環境整備に努めてまいります。"@ja.
<< kg:id_79 prop:countermeasure kg:id_80 >>
    prop:text-txt_contents "次世代を担う子どもの出産を奨励、祝福し、松前っ子誕生祝金を支給するとともに"@ja.
<< kg:id_79 prop:countermeasure kg:id_81 >>
    prop:text-txt_contents "高校生までの医療費の無料化を行い、子育て世帯の経済的負担の軽減を図ってまいります。"@ja.
<< kg:id_82 prop:countermeasure kg:id_83 >>
    prop:text-txt_contents "町立清部保育所と民間の松前認定こども園とで、保育、幼児教育の質の向上に努めるほか"@ja.
<< kg:id_82 prop:countermeasure kg:id_84 >>
    prop:text-txt_contents "学童保育や児童デイサービス事業を推進し、子どもが健やかに育ち、安心して保育できる環境整備に努めてまいります。"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "少子高齢化や核家族化の影響により、家族機能や共に支え合う地域機能が低下していることから"@ja.
<< kg:id_85 prop:effect kg:id_87 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "家族機能や共に支え合う地域機能が低下していることから"@ja.
<< kg:id_85 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "社会福祉協議会への支援を行い"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "要支援者につきましては、民生委員児童委員及び関係機関と連携を図りながら対応をしてまいります。"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:text-txt_contents "被保険者数の減少などにより税収が減少する一方"@ja.
<< kg:id_91 prop:cause kg:id_93 >>
    prop:text-txt_contents "医療の高度化や被保険者の高齢化などにより、医療費は増加傾向にあります。"@ja.
<< kg:id_91 prop:cause kg:id_94 >>
    prop:text-txt_contents "医療の高度化や被保険者の高齢化などにより、医療費は増加傾向にあります。"@ja.
<< kg:id_91 prop:effect kg:id_95 >>
    prop:text-txt_contents "医療費は増加傾向にあります。"@ja.
<< kg:id_91 prop:countermeasure kg:id_96 >>
    prop:text-txt_contents "引き続き医療費の適正化と税収等の財源確保に努めるとともに"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:text-txt_contents "松前町らしい地域包括ケアシステムの深化、推進を目指してまいります。"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:text-txt_contents "第８期計画３年間の事業量及び介護給付費の見込に対応するため、新たな介護保険料設定のための条例改正案を提案しております。"@ja.
<< kg:id_99 prop:countermeasure kg:id_101 >>
    prop:text-txt_contents "新たな介護保険料設定のための条例改正案を提案しております。"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:text-txt_contents "住民主体生活支援サービス事業補助金"@ja.
<< kg:id_102 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "生活支援コーディネーター」と協力しながら活動を支援してまいります。"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:text-txt_contents "当町の高齢化率が５０％を超えている状況において、一人暮らしの高齢者の割合も高くなっており"@ja.
<< kg:id_106 prop:effect kg:id_107 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "孤立死が懸念されることから"@ja.
<< kg:id_108 prop:countermeasure kg:id_109 >>
    prop:text-txt_contents "高齢者等見守りネットワークを通して、地域で高齢者を見守る活動を推進してまいります。"@ja.
<< kg:id_110 prop:effect kg:id_111 >>
    prop:text-txt_contents "高齢者に関する相談件数の増加及び内容も多岐にわたっていることから"@ja.
<< kg:id_108 prop:countermeasure kg:id_112 >>
    prop:text-txt_contents "地域包括支援センター並びに介護関連事業者や医療機関等と連携・協力し、その支援に努めてまいります。"@ja.
<< kg:id_108 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "引き続き高齢者事業団や老人クラブの運営を支援してまいります。"@ja.
<< kg:id_114 prop:countermeasure kg:id_115 >>
    prop:text-txt_contents "個々の障がいの程度に応じた障がい福祉サービスの提供や、地域生活支援事業などを行う"@ja.
<< kg:id_114 prop:countermeasure kg:id_116 >>
    prop:text-txt_contents "障がいに対する正しい理解の普及と障がいを理由とする差別の解消に努めてまいります。"@ja.
<< kg:id_114 prop:countermeasure kg:id_117 >>
    prop:text-txt_contents "創作活動や生産活動機会を提供するとともに、地域社会との交流等の便宜を供与し、障がい者の生活等を支援してまいります。"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:text-txt_contents "定期的に健診やがん検診を受けることが疾病の予防や早期発見、早期治療につながります。"@ja.
<< kg:id_120 prop:countermeasure kg:id_121 >>
    prop:text-txt_contents "感染防止対策に万全を期し、実施可能な方法を検討し、町民へ健康管理に必要な機会を提供できるよう取り組んでまいります。"@ja.
<< kg:id_122 prop:countermeasure kg:id_123 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "福島県伊達市で実施する「元気づくりシステム」を導入し、健康づくりを推進してまいります。"@ja.
<< kg:id_124 prop:countermeasure kg:id_125 >>
    prop:text-txt_contents "町民の健康づくり意識の高揚を図るため実施しております「健康ポイント事業」"@ja.
<< kg:id_125 prop:effect kg:id_126 >>
    prop:text-txt_contents "年々参加者が増えており"@ja.
<< kg:id_127 prop:cause kg:id_128 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "当町は、人口減少や高齢化が大きな課題となっているところであり"@ja.
<< kg:id_127 prop:effect kg:id_129 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "病院は、町民が健康で安心した生活を送るために欠かすことのできないものと強く認識しております。"@ja.
<< kg:id_130 prop:effect kg:id_3 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_43;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "病院を取り巻く環境は、依然として厳しい状況にあることから"@ja.
<< kg:id_127 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "山本病院事業管理者並びに八木田病院長と連携を密にし"@ja.
<< kg:id_127 prop:countermeasure kg:id_132 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "総合診療の病院として、地域医療の更なる充実に向けて取り組んでまいります。"@ja.
<< kg:id_127 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_47;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "医師並びに医療スタッフの確保に全力を尽くすとともに"@ja.
<< kg:id_127 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "病院の改築にあっては、医療サービス向上のため、松前町に相応しいより良い病院改築に向け邁進してまいります。"@ja.
<< kg:id_135 prop:countermeasure kg:id_136 >>
    prop:text-txt_contents "町道江良線、町道茂草線、町道唐津線、町道白神山の上線など８路線、橋りょうについては、富元橋、鳥井橋２橋の長寿命化改良工事を予定しております。"@ja.
<< kg:id_135 prop:countermeasure kg:id_137 >>
    prop:text-txt_contents "地域の皆様及び関係機関との連携を密にし、事故のないように万全を期してまいります。"@ja.
<< kg:id_138 prop:countermeasure kg:id_139 >>
    prop:text-txt_contents "町として、残された唐津地区の早期完成を目指し、歴まち商店街組合や各関係機関と連携しながら、北海道への要望活動を継続してまいります。"@ja.
<< kg:id_140 prop:cause kg:id_141 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "松前町公営住宅等長寿命化計画と松前町住生活基本計画が１０年目の最終年となることから、計画の見直しを予定しており"@ja.
<< kg:id_140 prop:countermeasure kg:id_142 >>
    prop:text-txt_contents "令和４年度からの事業推進に向け、それぞれ新しい計画を策定してまいります。"@ja.
<< kg:id_143 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "令和２年度からの松前町水道事業経営戦略を柱に、水道料金の見直しの具体的な検討も含め、水道施設の効率的、効果的な維持管理、更新等に努めてまいります。"@ja.
<< kg:id_145 prop:countermeasure kg:id_146 >>
    prop:text-txt_contents "本年度中にＮＴＴ東日本により地域全域に光ファイバが整備される予定であり"@ja.
<< kg:id_145 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "高速ブロードバンドを活用した「新しい生活様式」の実践を推進し"@ja.
<< kg:id_145 prop:countermeasure kg:id_148 >>
    prop:text-txt_contents "家庭内Ｗｉ－Ｆｉ等の設置拡大を町民へお願いしながら"@ja.
<< kg:id_145 prop:countermeasure kg:id_149 >>
    prop:text-txt_contents "ＧＩＧＡスクール構想などＩＣＴ環境の向上と強化に取り組んでまいります。"@ja.
<< kg:id_150 prop:countermeasure kg:id_151 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "当町においても広報紙等を通じ、普及促進に努めてまいります。"@ja.
<< kg:id_152 prop:cause kg:id_153 >>
    prop:text-txt_contents "近年、経年劣化による同軸ケーブル空中線の断線が頻繁に起こることから"@ja.
<< kg:id_152 prop:countermeasure kg:id_154 >>
    prop:text-txt_contents "令和４年度に光ケーブル化の設備更新を計画し、本年度は実施設計が予定されているため、予算補正により支援してまいります。"@ja.
<< kg:id_155 prop:cause kg:id_156 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "公共交通の維持確保については、年々利用者が減少しているところでありますが"@ja.
<< kg:id_155 prop:countermeasure kg:id_157 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "高齢者や交通弱者のため、町内を運行する大漁くんバス及びハイヤーの持続的な運行を支援してまいります。"@ja.
<< kg:id_158 prop:countermeasure kg:id_159 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "関係機関へ早期着工の要望を継続しており"@ja.
<< kg:id_158 prop:countermeasure kg:id_160 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "関係市町と連携して要望活動の強化を図りながら"@ja.
<< kg:id_161 prop:countermeasure kg:id_162 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "感染症対策に配慮した避難所開設方法など町主催の総合防災訓練を実施するほか"@ja.
<< kg:id_161 prop:countermeasure kg:id_163 >>
    prop:text-txt_contents "各町内会主催の避難訓練に対して支援を行ってまいります。"@ja.
<< kg:id_161 prop:countermeasure kg:id_164 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "各種ハザードマップを含めた総合的な防災情報を網羅した「防災のしおり」の改訂を行い"@ja.
<< kg:id_165 prop:countermeasure kg:id_166 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "オンラインなどを利用して、移住を検討している方へのＰＲを行うほか"@ja.
<< kg:id_165 prop:countermeasure kg:id_167 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "企業によるサテライト型テレワーク等を推進する施策を模索し"@ja.
<< kg:id_165 prop:countermeasure kg:id_168 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "個人や企業などの「関係人口」の増加を目指してまいります。"@ja.
<< kg:id_169 prop:cause kg:id_170 >>
    prop:text-txt_contents "人口減少等による担い手不足により"@ja.
<< kg:id_169 prop:effect kg:id_171 >>
    prop:text-txt_contents "町内会組織の運営と組織の弱体化が懸念されていますが"@ja.
<< kg:id_169 prop:countermeasure kg:id_172 >>
    prop:text-txt_contents "町内会連合会を通じて、地域コミュニティの維持、活性化を支援してまいります。"@ja.
<< kg:id_173 prop:countermeasure kg:id_174 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "４年目を迎える｢空家等除却支援事業｣については"@ja.
<< kg:id_175 prop:effect kg:id_176 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "放置することが不適切な状態の空家等の除却を促進し、町民の安全で安心な住環境の向上に引き続き取り組んでまいります。"@ja.
<< kg:id_177 prop:countermeasure kg:id_178 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "新たな組織機構の検証も含め、支所のあり方も検討してまいります。"@ja.
<< kg:id_179 prop:countermeasure kg:id_180 >>
    prop:text-txt_contents "「スマイル応援補助金」で町民が主体となって取り組む「まちづくり」や「ものづくり」への支援"@ja.
<< kg:id_179 prop:countermeasure kg:id_181 >>
    prop:text-txt_contents "町内で就労するために必要な各種資格取得を支援しながら"@ja.
<< kg:id_179 prop:countermeasure kg:id_182 >>
    prop:text-txt_contents "町民参加型のまちづくりに努めてまいります。"@ja.
<< kg:id_183 prop:cause kg:id_184 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "風力発電施設の建設により固定資産税の増収が見込まれる一方"@ja.
<< kg:id_183 prop:cause kg:id_185 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "人口減や高齢化による就業人口の減少"@ja.
<< kg:id_183 prop:cause kg:id_186 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "更には水産物の水揚げの減少などにより"@ja.
<< kg:id_183 prop:effect kg:id_187 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "総所得金額の増加が見込めず大変厳しい状況にあります。"@ja.
<< kg:id_188 prop:countermeasure kg:id_189 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "渡島・檜山地方税滞納整理機構と連携し、積極的に滞納処分を実施しながら"@ja.
<< kg:id_188 prop:countermeasure kg:id_190 >>
    prop:text-txt_contents "延滞金徴収のために本年度において、滞納管理システムを導入し"@ja.
<< kg:id_191 prop:countermeasure kg:id_192 >>
    prop:text-txt_contents "債権の管理に関する条例や、行政サービス等の制限措置に関する条例の規定を適用し"@ja.
<< kg:id_193 prop:cause kg:id_194 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "令和２年度において国勢調査が実施され、人口については、大きく減少することが予想されており"@ja.
<< kg:id_193 prop:effect kg:id_195 >>
    prop:text-txt_contents "前年度並みの一般財源の確保が大変厳しい状況にあることから"@ja.
<< kg:id_196 prop:countermeasure kg:id_197 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "財政収支の均衡を図るため、財政調整基金を編入し、予算を編成したところであります。"@ja.
<< kg:id_198 prop:countermeasure kg:id_199 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "基本的に地方交付税で元利償還金の多くが措置される、有利な過疎対策事業債等を活用をしてまいります。"@ja.
<< kg:id_198 prop:effect kg:id_200 >>
    prop:text-txt_contents "町債発行の数年後から元金償還が発生し、公債費が増嵩することを十分認識のうえ"@ja.
<< kg:id_198 prop:countermeasure kg:id_201 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "推計を精査しながら将来に過度の負担にかからないよう留意してまいります。"@ja.
<< kg:id_202 prop:cause kg:id_203 >>
    prop:text-txt_contents "コロナ禍による影響も考慮し"@ja.
<< kg:id_202 prop:countermeasure kg:id_204 >>
    prop:text-txt_contents "復領記念事業は、令和４年度において実施してまいります。"@ja.
<< kg:id_205 prop:countermeasure kg:id_206 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "リエネ松前風力発電所を活用する松前町地域マイクログリッド構築マスタープラン"@ja.
<< kg:id_205 prop:countermeasure kg:id_207 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "その実現に向けた調査等を東急不動産株式会社と共同で進める予定でおります。"@ja.
<< kg:id_208 prop:countermeasure kg:id_209 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "洋上風力発電誘致に係る「国の促進区域の指定」を受けるための情報提供を去る２月１８日に北海道へ提出したところであります。"@ja.
<< kg:id_208 prop:countermeasure kg:id_210 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "円滑に国の指定が受けられるよう関係機関と連携して進めてまいります。"@ja.
<< kg:id_211 prop:effect kg:id_212 >>
    prop:text-txt_contents "新型コロナウイルス感染症の収束が見通せない状況の中にあって、様々な行政課題に適切に対応し、着実に歩みを進めて行かなければならない"@ja.
<< kg:id_213 prop:effect kg:id_214 >>
    prop:text-txt_contents "地方財政を取り巻く環境は一段と厳しく、極めて不透明であることから"@ja.
<< kg:id_215 prop:countermeasure kg:id_216 >>
    prop:text-txt_contents "規律ある財政運営に意を尽くしてまいります。"@ja.
}
