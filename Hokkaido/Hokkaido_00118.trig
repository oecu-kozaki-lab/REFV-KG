    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "漁業を取り巻く環境は厳しい状況が続いております。"@ja.
<< kg:id_18 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "新規コンブ養殖漁業参入への施設整備等の支援"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "ナマコ増殖のため人工種苗の継続放流"@ja.
<< kg:id_24 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "各地区簡易採苗の取り組みを水産センターも活用しながら進める"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
