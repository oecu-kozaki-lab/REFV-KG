cls:c_15546 rdfs:label "診療強化"@ja.
kg:id_85 prop:countermeasure kg:id_89.
kg:st_1 rdfs:label "沼山雄平議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "周辺自治体と足並みを揃え早期解消すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "松前町長石山英雄"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_2 prop:content "子育て世帯の負担軽減策として無償化を実現したい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "人口減少対策として子育て環境強化が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "保護者が喜ぶ施策として実施すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "子育て支援の強化につながる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "令和4年度から無償化を実施する方針"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "教育長宮島武司"@ja.
kg:st_3 rdf:type cls:st_57.
cls:st_57 rdfs:label "教育行政"@ja.
kg:op_7 prop:content "必要な手続きを経て実施準備を進める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "地元高校支援策として給食提供を進めるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "以前から要望があるため実態把握を進めた"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "保護者負担軽減に明確につながる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "高校の魅力の一つになる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "高校給食は切れ目のない子育て支援に結び付く"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "魅力づくりの観点から議論し試食会を検討する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "高校給食は十分検討に値する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:st_4 rdfs:label "梶谷康介議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_15 prop:content "人口減少を緩やかにしなければならない"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "減少幅の大きさに強い危機感を持っている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "時代の流れを捉えて地方移住の受け皿をつくるべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "企業版での募集の方が現実的"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "企業誘致と移住定住で人口減少対策につなげるべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "町の可能性を検証し環境整備を進める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "関係機関と連携して早期整備を進めたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "風力発電を引き金に町の姿を変えるべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "協定により具体的成果が出始めている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "町から積極的に企業へ提案したい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "幅広い検討協議を町から提案していく"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "人口減少対策と産業活性化のきっかけにしたい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "関連用地の確保も考える必要がある"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "新たに12基程度の整備を検討している"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "指定がなければ実施できないため国への働きかけが重要"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "国の促進区域指定に向け手続きを進めている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "町から具体的な考え方を発信できる体制が必要"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "今後避けて通れない課題"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "当面は政策財政課を中心に進める"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "出向や人事交流も前向きに進めたい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "災害に強い町づくりに必要"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "地域全体の安心につながる"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "地域電力組織ができれば負担軽減も可能"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "他自治体との差は商品構成と供給力にある"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "松前の返礼品は良いが人気定番品との差がある"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "事業者の意向を尊重しながら対応する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "出品意欲がある事業者には門戸を開いている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:st_5 rdfs:label "疋田清美議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_42 prop:content "今後の事業推進には企業版ふるさと納税が必要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "活用準備を進めている"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "地方創生に有効な事業へ寄附を募りたい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "初めての対応で町民に苦労をかけ申し訳ない"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "供給が潤沢であれば大きな混乱は起きなかった"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:st_6 rdfs:label "福原英夫議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_47 prop:content "高齢者や体の不自由な人への配慮が不足していた"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "高齢者接種を7月中に完了させる見込み"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "64歳以下も順次接種を進める"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "自粛の長期化で心も体も経済も大きな影響を受けた"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_6.
kg:op_51 prop:content "落ち込んだ個人消費と景気回復につなげたい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "可燃ごみの多さが価格差の要因"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "地理的条件で収集運搬費がかかる"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "燃油高騰も見ながら慎重に検討する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "資源ごみ分別で節約と減量化につながる"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "基本的な取り組みが減量に有効"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "既存の回収活動を引き続き周知する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "参考にして実施可能か検討したい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:st_7 rdfs:label "宮本理恵子議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_59 prop:content "長期放置は環境と健康への影響が懸念される"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_7.
kg:op_60 prop:content "悪質事案は警察と連携して対応する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "重大な犯罪との認識を持ってもらう必要がある"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "根絶に向け監視体制を強化する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:st_8 rdfs:label "病院事務局長白川義則"@ja.
kg:st_8 rdf:type cls:st_227.
cls:st_227 rdfs:label "病院行政"@ja.
kg:op_63 prop:content "コロナ禍で病院経営は極めて厳しい"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_8.
kg:op_64 prop:content "費用増が経営を圧迫している"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_8.
kg:op_65 prop:content "99床化で交付税面のメリットがある"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_8.
kg:op_66 prop:content "収益確保のため病床数見直しを行う"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_8.
kg:op_67 prop:content "来年4月からの導入に向け院内協議を進めている"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_8.
kg:op_68 prop:content "透析とリハビリを収益の柱として強化したい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_8.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "周辺自治体、木古内町、知内町、隣の福島町、そして上ノ国町が既に無償化を実施しております。学校給食という教育環境下の下で隣接自治体との格差が生じている。このひずみ、この現状を一刻も早く解消してもらいたい"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "私は小中学校の給食費の無償化を実現したいと訴えてきたところでもございます。正しく、私の選挙公約一つであることは間違いありません"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "昨年の国勢調査の速報値が発表され、人口減少率の高い道内トップ１０に松前町が入る結果となりました。若い世代が子どもを産み育てやすい環境を一層強化していかなければならない"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "保護者の方にも喜んでいただけるように、最優先で取り組む案件として考えておりますので、ご理解賜りたい"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "令和４年度から小中学校の児童生徒の給食費は、全額町が負担し、いわゆる無償化をし、更なる子育て支援として、保護者の負担軽減を図ってまいりたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "令和４年度から小中学校の児童生徒の給食費は、全額町が負担し、いわゆる無償化をし、更なる子育て支援として、保護者の負担軽減を図ってまいりたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "教育委員会と致しましては、今後令和４年度に向けて、学校給食運営委員会への報告や、町長と教育委員会とで構成されております総合教育会議の開催、そして、最終的には教育委員会議での決定を受けて実施する運びとなろう"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "道立足寄高校は、唯一の町内の高校で、平成２７年度から給食無償提供を開始しております。高校まで拡大したのは、生徒数が減り続けて廃校になれば、今後も若者の流出に歯止めがかからなくなるとの危機感からだと言われております"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "松前高校のＰＴＡや教職員から給食提供を望む声が高まっていると聞いていますが、実態はどうなのか。沼山議員言われるように、そのような声があることは、以前から校長の方から聞いているところでございます"@ja.
<< kg:id_9 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "高校への給食提供は、保護者の負担軽減に繋がることは明らかであります"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "松前高校の魅力の一つになればと思うわけでございます"@ja.
<< kg:id_9 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "高校生までの医療費の無料化に加え、その給食を提供する、正に合わせ技。それは、町長の掲げる切れ目のない子育て支援にそのまま結び付くものであって、充実の度は確実に高くなるものと思われます"@ja.
<< kg:id_9 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "その協議会の中でも、松前高校の魅力づくりの観点から大いに議論をしていただき、生徒、保護者をはじめ、学校関係者による給食試食会の実施を検討するなど、今後の状況を見極めていきたい"@ja.
<< kg:id_9 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "高校への給食提供につきましては、切れ目のない子育て支援、そして魅力のある高校づくりとして、十分検討に値するものと思っておりますし、今後とも教育委員会と情報を共有しながら"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "人口がどんどんどんどん減って行くっていうことが、そもそもその消滅都市のその兆候だと、根源だという見方ですよね。だとすれば、この人口の減少を少しでも止めることはできないにしても、ゆるやかな形に抑えていかなければいけない"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "国勢調査の結果が、今議員おっしゃるように数値が発表されたところでありまして、本当に減少幅の大きさに大変なショックを受けたところであります"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地方への流れも真剣に考えていかなければいけないという気運は十分に盛り上がってきて、現実仕事のやり方にしても人の流れにしても、この地方へ、都市から地方へって気運が高まってますよね"@ja.
<< kg:id_19 prop:cause kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "このコロナ禍におきまして、いろんな影響が現在まで続いているところであります。企業版での募集は、施設及び受入体制の充実は必要でありますけども、比較的にコンタクトの取りやすい企業から始めることも容易"@ja.
<< kg:id_19 prop:effect kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "その時に、やっぱり松前町もこの時代に乗った考え方で、テレワークの拠点づくりっていうお話をしましたよね。そういうことから松前は、これからの人の流れをね、いわゆる移住定住って言いますか、そういう活動をしながら、町の人口減少を少しでも食い止めて行くべきだ"@ja.
<< kg:id_19 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "今年の４月にＮＴＴ東日本北海道南支店の協力をいただき、温泉旅館矢野さんを利用致しまして、５日間のワーケーションを実施し、松前町の可能性の検証を行ったところであります"@ja.
<< kg:id_19 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "関係機関などとも協議、連携しながらサテライトオフィスの早期整備や、検証課題の解消、更には企業の思惑とマッチしたテレワーク環境の整備も検討していきたい"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "風力あるいは洋上風力を引き金にしながら、事業者の力を借りて、どんどん松前の姿を変えて行く、あるいは前へ進めて行くっていう考え方"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "ふるさと納税については、東急不動産独自の松前版ふるさと納税サイトを試験的に実施していただきまして、３１７万円の寄附が集まったこと。更には、このコロナ禍にあって実施できたサマーフェストやクリスマス点灯式への協賛も実施したところであります"@ja.
<< kg:id_25 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "現状考えられることにつきましては、まず企業版ふるさと納税につきましては、これは町の方から積極的に企業の方に相談を申し上げたい、提案を申し上げたい"@ja.
<< kg:id_25 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "再生エネルギー活用によります地域振興にかかる検討協議等々、多種にわたると思いますが、いろんな協議を実施していただくために、町の方からの提案もしてまいりたい"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "再生エネルギー事業の推進と企業連携が今期待できる事業であります。漁業をはじめ、産業を活性化するきっかけとなる、正しく事業であると考えております"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "今後陸上及び洋上風力発電が発展していった場合には、新たな蓄電施設などの用地の取得も必要だというふうに聞かされておりまして"@ja.
<< kg:id_30 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "東急不動産では、陸上の第２期の整備も検討を進めております。新たに大型風力発電施設を１２基程度の規模で、今考えているというふうに聞いているところであります"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "この促進区域の指定がなければ、洋上風力は発電は実施できない状況でありますので"@ja.
<< kg:id_34 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "現在、国の促進区域の指定を受けるために、町と致しましては、国の方に情報提供は済ませている状況であります。この情報提供によりまして、専門機関が分析調査、そして有望な区域に選定され、その後法定協議会が設けられ"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "企業の方から、松前町からも発信してほしいんだと"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "テレワークやサテライトオフィスをはじめ、風力発電の他に様々な業種の進出の想定する時に、企業進出しやすい環境づくりも、今後避けて通られない状況が来るんだろう"@ja.
<< kg:id_37 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "４月の１日から人員を増やし、１名増やしまして、政策推進係として、新しい部署付け対応にあたっているところであります。政策財政課を中心と致しまして、当面は進めて行きたい"@ja.
<< kg:id_37 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "東急不動産には、担当社員の町役場への出向などの方向も前向きに話をしておりまして、その可能性は十分あると感じておりますし、うちの職員も東京の東急不動産の本社に人事交流等の部分を含めまして、可能性はある"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "平成３０年の９月の胆振東部地震によるブラックアウトのことであります。マイクログリッドが構築されることによりまして、そういうことがないように、災害に強い町の松前町としてのブランド化に、一歩近づける"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "マイクログリッド構想で構築された電源、電気につきましては、松前町内全域で賄うことも可能になる"@ja.
<< kg:id_42 prop:effect kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "地域電力組織の立ち上げができれば、電気料金の負担軽減も可能になる"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "大きな要因は、目玉産品と製品の生産数と、これに比例した、インターネット取扱サイト数ではないかというふうに考えられるところであります"@ja.
<< kg:id_46 prop:cause kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "我が松前町におきましては、目玉商品は、松前漬け、ウニ、マグロ、商品としては本当に遜色はないというふうに思いますが、ふるさと納税三種の神器と言われている、肉、カニ、米と比べるとどうしても差が生まれている"@ja.
<< kg:id_46 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "ふるさと納税を増大する方策とすれば、売れ筋商品を取り入れたり、新しいヒット商品をつくったり、安定した生産量を増やしたり、取扱サイトを増やすなど考えられます"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "これまでも松前物産協会の物産事業者を中心に、希望する商品を返礼品として提供しております。これからもその門戸は開けておりますので、出品意欲のある町内事業者につきましては、種類を増やすことは、やぶさかではない"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "松前町の今後の事業を進めて行くうえでは、企業版ふるさと納税を活用していくことが、絶対に必要じゃないのかなあ"@ja.
<< kg:id_52 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "今年の５月に国へ地域再生計画を提出したところでございます"@ja.
<< kg:id_52 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "この間に実施可能で、地方創生に有効な事業に対し、企業から寄附をいただけるよう、町外の関連企業に呼びかけをしたい"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "６５歳以上、第１クールの申し込みの時においては、何百回かけても電話が繋がらないとの苦情が多く寄せられたところでありまして、本当に申し訳なく思っている"@ja.
<< kg:id_56 prop:cause kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "町民の皆さんに大変混乱を招いた大きな要因は、やっぱりワクチンの入荷の状況だというふうに思います。いずれに致しましても、ワクチンが潤沢に提供、供給されるような状況であれば、こんな大きな混乱は起きなかった"@ja.
<< kg:id_56 prop:effect kg:id_59 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "一番苦労したのは、８０歳代、９０歳代のお年寄り、高齢者。私は７２ですけども、まだピンピンしてます。ですから、この方々が７０回も１００回もしてても電話が繋がらない"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "６５歳以上の高齢者の集団接種を７月中に完了をする見込みでございます"@ja.
<< kg:id_60 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "６月下旬に１６歳から６４歳までの方に接種券と接種日程等について発送を予定しております。予定では９月末までに２回目を終了する予定"@ja.
<< kg:id_60 prop:countermeasure kg:id_63 >>
    prop:text-txt_contents "新型コロナウイルスワクチン接種者送迎業務委託料で、現在実施している新型コロナワクチンの集団接種において、日常的に車椅子等を利用している方で、接種会場への移動が難しい方へ、車椅子に対応する送迎車両を用意"@ja.
<< kg:id_60 prop:countermeasure kg:id_64 >>
    prop:text-txt_contents "新型コロナウイルスワクチン接種交通費助成金で、これは、車椅子等利用者で、既に介護タクシー等を利用しワクチンの接種を済ませた方に対し、償還払いによる費用の助成"@ja.
<< kg:id_65 prop:effect kg:id_66 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "このコロナによるやはり自粛っていうのは、やはり心も体も、やはり経済も大きい影響与えられた"@ja.
<< kg:id_65 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "今落ち込んだ消費、個人消費と景気回復を目的に、昨日、１４日からですか、地域生活応援の商品券など、更にはこの後予定しております、各種消費喚起事業を予定しております"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "松前町は可燃の排出量の割合が大変他の町より多くて"@ja.
<< kg:id_68 prop:cause kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "ごみを収集、運搬する経費、これは地理的に清掃センター、千軒に運ぶ等々の松前からの距離があるというふうな地理的な状況によって、収集、運搬経費がかかる"@ja.
<< kg:id_68 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "更なるごみの減量化に取り組みながら、価格の設定については慎重に検討してまいりたい"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "ペットボトルやその他プラスチックなどの資源ごみとなるものは、きちんと分別して、単価の安いごみ袋を使用することによって節約になります"@ja.
<< kg:id_72 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "生ごみを燃やせるごみ袋に入れる場合も水切りをしっかりすると、ごみの排出量の減量化に繋がります"@ja.
<< kg:id_72 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "各地域で毎月、隔月で行っている紙資源の集団無料回収があります。更には、年１回秋に行っている鉄リサイクル回収に出すことで、排出量の減量にもなります"@ja.
<< kg:id_72 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "松前町の蚤の市のようなものを開いて、お互いの不用品を出し合って、それを必要とする人が持ち帰るみたいな。参考にしたいなというふうに思います。実施できるかどうか、担当職員と検討してまいりたい"@ja.
<< kg:id_77 prop:effect kg:id_78 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "不法投棄されたものも長い間放置されれば、金属部分などから有害物質が流出することも考えられ、環境や地域住民の健康にも十分に影響を与える"@ja.
<< kg:id_77 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "通報受けた場合は、直ちに現地を確認して警告看板を設置するなどの対応のほかに、悪質な場合は警察に連絡して、捜査やパトロールをしてもらうなど、監視の協力もお願いしている"@ja.
<< kg:id_77 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "５年以下の懲役、また１千万以下の罰金など、厳しい罰則が設けられている重大な犯罪であるという認識を持ってもらうためにも、町広報や防災無線での周知をしている"@ja.
<< kg:id_77 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "町として、根気強く警察と協力しながら、監視体制を強化して、不法投棄の根絶に向けて取り組むことが必要だ"@ja.
<< kg:id_82 prop:cause kg:id_83 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "新型コロナウイルス感染症のまん延が続く中で、患者数が減少したことや、医業費用が増加したことにより、病院経営は極めて厳しい"@ja.
<< kg:id_82 prop:cause kg:id_84 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "患者数が減少したことや、医業費用が増加したことにより、病院経営は極めて厳しい"@ja.
<< kg:id_85 prop:effect kg:id_86 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "特別交付税の基準額の見直しが行われ、算定上における特別交付税措置額が１００床未満にすることで、現行の１００床より増額が図られる"@ja.
<< kg:id_85 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "第４条診療科目及び病床数です。現行の病床数１００床を改正案下線部分のとおり、９９床に致そうとするもの"@ja.
<< kg:id_85 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "実は、現在内部で、院内で協議をしてまして、できれば来年の４月から、令和４年度から地域包括ケア病床を、何床つくるとかってまだ言えないんですけれども、それに向けていろんな準備が必要"@ja.
<< kg:id_85 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "透析については、今１０ベッドで午前午後２０人やっておりますけれども、あと１ベッドくらいは何か増やせそうな話もしておりましたので。リハビリの方も、今のところ理学療法士が２人しかいないんですけれども、この数を増やすことによって、例えば訪問してリハビリをしたり、いろんなことが可能"@ja.
}
