cls:st_29 rdfs:label "首長"@ja.
kg:op_10 prop:content "感染拡大防止と経済対策事業等を早急に検討し実施すると表明"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "国の動向を注視し迅速な対応を図る考えを示した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "早い時期での予算補正で対応すると表明"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "漁業を取り巻く環境は依然厳しいと認識"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "漁業環境の厳しさの要因として挙げた"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "魚価低迷が漁業の厳しさを強めていると説明"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "漁業を取り巻く環境は厳しいと明言"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "つくり育てる漁業の推進のため支援すると表明"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "つくり育てる漁業の推進策として支援すると表明"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "つくり育てる漁業の推進策として支援すると表明"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "流通施設等の整備を支援すると表明"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "増養殖生産の拡大を支援すると表明"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "漁場造成を進める考えを示した"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "水産加工業の厳しさの原因として挙げた"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "従業員高齢化が厳しい状況の要因と説明"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "安定稼働が難しい現状を認識"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "安定した稼働ができるよう連携を図る考えを示した"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "クマ被害の深刻化を踏まえ対策強化を示した"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "シカ被害増加を踏まえ対策強化を示した"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "人身事故が多発していると危機感を示した"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "農作物被害が増えていると認識"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "対策を強化すると表明"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "景気が落ち込んだ要因として感染拡大を挙げた"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "下支えに万全を期す必要があると判断"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "感染症対策関連で必要に応じ予算補正対応すると表明"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "開催可否を検討中で判断は極めて難しいと説明"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "町の一大イベントで経済影響も大きく判断は難しいと説明"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "昨年実績を踏まえ支援体制を整える考えを示した"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "観光需要の落ち込みが地域経済を直撃していると認識"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "感染拡大の反復で影響が長期化していると説明"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "地域経済を支える重要産業が大きな打撃を受けていると認識"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "感染予防と経済活動の両立に取り組む方針を示した"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "残された課題は送電に係る系統確保と説明"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "関係自治体と一体となり国へ早期解決を要望すると表明"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "資源ごみ分別推進が費用削減に重要と認識"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "分別徹底で費用削減を図る必要があると説明"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "各町内会及び町民の協力を得て分別徹底の広報活動を進めると表明"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "各町内会等と連携し引き続き取り組むと表明"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "専門家との意見交換を続けていると説明"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "町内関係者とコンセンサスをとりながら策定すると表明"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "環境省補助事業を活用し将来に向けた施策を地域振興につなげたいと表明"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "次世代を担う子どもの出産を奨励祝福すると表明"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "子育て世帯の経済的負担軽減を図ると表明"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "地域福祉機能低下の背景として少子高齢化を挙げた"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "家族機能や地域機能の低下要因として挙げた"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "住み慣れた地域での安心安全な生活環境づくりが必要と認識"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "地域福祉推進の中核として支援すると表明"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "被保険者減少の一方で医療費増加傾向と説明"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "医療費増加の要因として挙げた"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "医療費増加要因として被保険者の高齢化を説明"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "健全な事業運営が必要と認識"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "北海道と連携し健全運営に努めると表明"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "高齢者支援の必要性が高まっていると認識"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "町全体で高齢者を支援する必要があると判断"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "地域住民や協力事業者関係機関と連携して見守ると表明"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "相談件数増加や内容多様化に対応すると表明"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "感染防止対策を重要課題と位置付けた"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "国の方針や情報を把握し町の状況に応じて実施すると表明"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "必要予算は補正で対応すると表明"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "町民へ健康管理に必要な機会を提供できるよう取り組むと表明"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "安定的な経営基盤の回復が必要と認識"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "病院事業管理者と病院長と連携し地域医療充実に取り組むと表明"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "地域包括ケア病床の円滑運営を図る考えを示した"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "医療体制維持のため人材確保を最優先で進めると表明"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "町議会議員と町民に説明したうえで本年度中に基本計画を決定したいと表明"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "利用者減少の背景としてコロナ禍を挙げた"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "買い物や通院等に公共交通を利用する高齢者交通弱者支援が必要と認識"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "公共交通維持のため支援すると表明"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "法律改正を受け松前町公共交通活性化協議会で２年かけて策定すると表明"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "日頃からの心構えや備えが重要と認識し訓練実施を示した"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "地域訓練を支援すると表明"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "担い手不足が町内会運営を難しくしていると認識"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "地域コミュニティ維持活性化支援が必要と判断"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "町内会連合会を通じて支援すると表明"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "住環境向上のため除却推進を続けると表明"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "町民の安全で安心な住環境向上に引き続き取り組むと表明"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "簡素で効率的な組織機構見直しが必要と認識"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:op_87 prop:content "新たな組織機構体制の検証を進めると表明"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_2.
kg:op_88 prop:content "地域意見を聞きながら住民サービス低下に繋がらない方向を探ると表明"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_2.
kg:op_89 prop:content "地域意見を反映しながら方向性を見出すと表明"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_2.
kg:op_90 prop:content "町税収入は大変厳しい状況が続くと認識"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
kg:op_91 prop:content "本年度から延滞金徴収もあり納期内完納啓発を強めると表明"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_2.
kg:op_92 prop:content "歳入確保と収入未済額圧縮に努めると表明"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "前年度並みの一般財源確保が大変厳しいと認識"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
kg:op_94 prop:content "財政収支均衡のため基金編入が必要と説明"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_2.
kg:op_95 prop:content "財政収支の均衡を図るため基金を編入したと説明"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_2.
kg:op_96 prop:content "様々な行政課題に適切対応し着実に歩を進める必要があると認識"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_2.
kg:op_97 prop:content "予防と経済のバランスを取り機動的に対応すると表明"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_2.
kg:op_98 prop:content "人口減少のスピードを少しでも緩やかにすることが一番大事と認識"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_2.
kg:op_99 prop:content "住んでる人が松前で良かったと実感できる町を目指す考えを示した"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_2.
kg:st_3 rdfs:label "６番近江武"@ja.
kg:st_3 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_100 prop:content "自然災害として早期に資源回復を図るべきと主張"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_3.
kg:op_101 prop:content "漁業被害は大変大きなものになると想定している"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_2.
kg:op_102 prop:content "漁業者の死活問題に及ぶと懸念"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_3.
kg:op_103 prop:content "大きな漁業被害になるだろうと想定"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_2.
kg:op_104 prop:content "資源回復には３年以上を危惧し死活問題だと訴えた"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_3.
kg:op_105 prop:content "凪ぎを見て天然海域の調査を行いたいと説明"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_2.
kg:op_106 prop:content "赤潮対応と同様の対応を北海道や国に要請していると説明"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_2.
kg:op_107 prop:content "関連予算が出てくれば補正で対応する考えを示した"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_2.
kg:st_4 rdfs:label "１番疋田清美"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_108 prop:content "昨年以上に難しい判断になると指摘"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_4.
kg:op_109 prop:content "さくらまつりは外貨を稼ぐ唯一のイベントで経済効果が大きいと主張"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_4.
kg:op_110 prop:content "昨年同様感染防止対策を設けぜひ開催してほしいと要望"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_4.
kg:op_111 prop:content "規模を縮小してもぜひ開催したい考えを示した"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_2.
kg:op_112 prop:content "町民の感染予防努力や昨年実績を踏まえ開催意向を示した"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_2.
kg:op_113 prop:content "経済効果の大きいイベントとして実施意向を示した"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_2.
kg:op_114 prop:content "合併と法人化が町の経済を支える団体強化になると期待"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_4.
kg:op_115 prop:content "法人化には組織力強化や収益事業可能化などのメリットがあると説明"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_2.
kg:op_116 prop:content "令和５年４月の一般社団法人化に向け必要な支援を行うと表明"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_2.
kg:st_5 rdfs:label "３番沼山雄平"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_117 prop:content "社会は脱炭素に向かっており町も準備を進めるべきと評価"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_5.
kg:op_118 prop:content "公共施設への再エネ化や地域電力組織の立ち上げを目指す考えを示した"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_2.
kg:op_119 prop:content "極力早い段階から取り組むべきと要望"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_5.
kg:op_120 prop:content "迎えた４年度の中で策定する準備をしていると説明"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_2.
kg:op_121 prop:content "買い物食事掃除外出孤独など実態把握が適切な支援につながると指摘"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_5.
kg:op_122 prop:content "今の町全体で支えるシステムが良いか点検すると表明"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_2.
kg:op_123 prop:content "元気な高齢者が増える町を目指す考えを示した"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_2.
kg:st_6 rdfs:label "８番西川敏郎"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_124 prop:content "人材不足の中で役場職員や退職者が中心になっている現状を指摘"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_6.
kg:st_7 rdfs:label "４番宮本理恵子"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_125 prop:content "長期間放置空家の劣化で人的物的被害や治安面の心配があると指摘"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_7.
kg:op_126 prop:content "今後さらに空家が増えると予想し対策を問うた"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_7.
kg:op_127 prop:content "４年間で１１５件を対象に６２５５万８千円を交付したと説明"@ja.
kg:op_127 rdf:type cls:opinion.
kg:op_127 prop:speaker kg:st_2.
kg:op_128 prop:content "危険家屋５１件のうち相続人不明が１４件あると説明"@ja.
kg:op_128 rdf:type cls:opinion.
kg:op_128 prop:speaker kg:st_2.
kg:op_129 prop:content "屋根が飛ばないようロープをかけるなど消防署の協力を得て対応していると説明"@ja.
kg:op_129 rdf:type cls:opinion.
kg:op_129 prop:speaker kg:st_2.
kg:op_130 prop:content "町民の安全安心のため行政代執行を考えるべきと主張"@ja.
kg:op_130 rdf:type cls:opinion.
kg:op_130 prop:speaker kg:st_7.
kg:op_131 prop:content "自費で解体する方との不公平感や費用回収困難があり慎重に判断する必要があると説明"@ja.
kg:op_131 rdf:type cls:opinion.
kg:op_131 prop:speaker kg:st_2.
kg:op_132 prop:content "当面は緊急安全措置と所有者への保全解体依頼で対応すると説明"@ja.
kg:op_132 rdf:type cls:opinion.
kg:op_132 prop:speaker kg:st_2.
kg:op_133 prop:content "各町村長の間でも空家問題は話題となっており情報共有し要望すると説明"@ja.
kg:op_133 rdf:type cls:opinion.
kg:op_133 prop:speaker kg:st_2.
kg:op_134 prop:content "行事参加者が固定化しており出てこない人への目配りが必要と指摘"@ja.
kg:op_134 rdf:type cls:opinion.
kg:op_134 prop:speaker kg:st_7.
kg:op_135 prop:content "引きこもりがなく外出できる高齢者が多くなれば良いと説明"@ja.
kg:op_135 rdf:type cls:opinion.
kg:op_135 prop:speaker kg:st_2.
kg:op_136 prop:content "行者ニンニクなどの相談にのれる体制を役場でとっていると説明"@ja.
kg:op_136 rdf:type cls:opinion.
kg:op_136 prop:speaker kg:st_2.
kg:st_8 rdfs:label "５番福原英夫"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_137 prop:content "避難路が使えないようでは避難路でないと指摘"@ja.
kg:op_137 rdf:type cls:opinion.
kg:op_137 prop:speaker kg:st_8.
kg:st_9 rdfs:label "総務課長尾坂一範"@ja.
kg:st_9 rdfs:type cls:st_32.
kg:op_138 prop:content "高齢者事業団だけでは一気に町内全域をかけない状況だったと説明"@ja.
kg:op_138 rdf:type cls:opinion.
kg:op_138 prop:speaker kg:st_9.
kg:op_139 prop:content "住民の最終的な逃げ場が使えないのは問題と指摘"@ja.
kg:op_139 rdf:type cls:opinion.
kg:op_139 prop:speaker kg:st_8.
kg:op_140 prop:content "今後に向けどのような方策があるのか考えたいと説明"@ja.
kg:op_140 rdf:type cls:opinion.
kg:op_140 prop:speaker kg:st_9.
kg:op_141 prop:content "希望に沿ってすぐ配布できるよう町単独配布が必要と説明"@ja.
kg:op_141 rdf:type cls:opinion.
kg:op_141 prop:speaker kg:st_1.
kg:op_142 prop:content "自宅療養や自宅待機者に希望に沿ってすぐ配布できるようにすると説明"@ja.
kg:op_142 rdf:type cls:opinion.
kg:op_142 prop:speaker kg:st_1.
kg:op_143 prop:content "保健所から個人情報提供がないため手挙げ方式で対応していると説明"@ja.
kg:op_143 rdf:type cls:opinion.
kg:op_143 prop:speaker kg:st_9.
kg:op_144 prop:content "役場だろうがどこだろうが提供できないと保健所から言われたと説明"@ja.
kg:op_144 rdf:type cls:opinion.
kg:op_144 prop:speaker kg:st_9.
kg:st_10 rdfs:label "商工観光課長田中建一"@ja.
kg:st_10 rdfs:type cls:st_32.
kg:op_145 prop:content "観光客の属性や消費行動を分析し今後の観光施策に活かす実証事業と説明"@ja.
kg:op_145 rdf:type cls:opinion.
kg:op_145 prop:speaker kg:st_10.
kg:op_146 prop:content "LINEを活用した電子クーポンを付与すると説明"@ja.
kg:op_146 rdf:type cls:opinion.
kg:op_146 prop:speaker kg:st_10.
kg:op_147 prop:content "新しい試みで松前観光を促進すると説明"@ja.
kg:op_147 rdf:type cls:opinion.
kg:op_147 prop:speaker kg:st_1.
kg:op_148 prop:content "昨年同様の内容で実施し町内外向けに利用できると説明"@ja.
kg:op_148 rdf:type cls:opinion.
kg:op_148 prop:speaker kg:st_1.
kg:op_149 prop:content "事業規模実施時期とも令和３年度と同じ内容で実施すると説明"@ja.
kg:op_149 rdf:type cls:opinion.
kg:op_149 prop:speaker kg:st_10.
kg:op_150 prop:content "ここまで冷え込んだため活気を取り戻す動きが必要と訴えた"@ja.
kg:op_150 rdf:type cls:opinion.
kg:op_150 prop:speaker kg:st_8.
kg:op_151 prop:content "緊急経済対策で消費喚起と事業者の下支えを図ると説明"@ja.
kg:op_151 rdf:type cls:opinion.
kg:op_151 prop:speaker kg:st_10.
kg:op_152 prop:content "補助金をきっかけに事業者が自ら事業展開できるよう指導していくと説明"@ja.
kg:op_152 rdf:type cls:opinion.
kg:op_152 prop:speaker kg:st_10.
kg:st_11 rdfs:label "副町長若佐智弘"@ja.
kg:st_11 rdfs:type cls:st_94.
cls:st_94 rdfs:label "副首長"@ja.
kg:op_153 prop:content "ワクチン対策と経済対策の両輪で町民の意欲が沸くような施策に配慮すると説明"@ja.
kg:op_153 rdf:type cls:opinion.
kg:op_153 prop:speaker kg:st_11.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "これは、新型コロナウイルスワクチン接種の３回目の追加接種の接種間隔が短縮されたことにより、町としても接種をなるべく早い時期に実施するため、急遽接種時期を前倒した実施"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "５歳から１１歳以下の小児に対してもワクチン接種もできることとなり、これらの経費の予算措置に緊急を要することから"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "町としても接種をなるべく早い時期に実施するため、急遽接種時期を前倒した実施"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "これらの経費の予算措置に緊急を要することから、令和４年２月１０日付をもって、別紙補正予算書の専決処分をさせていただいたところでございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "集団接種方式により、町民総合センターと江良パートナーシップランドの２箇所で実施し、高齢者と一般の方については３月中に接種を実施したいと考えております"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "パートナーシップランドは、新型コロナウイルスワクチン接種の会場となり、その暖房用燃料代も国の補助金の対象となることから"@ja.
<< kg:id_7 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "その経費の計上です"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "町民総合センターも新型コロナウイルスワクチン接種の会場となり、その暖房用燃料代も国の補助金の対象となることから"@ja.
<< kg:id_10 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "その経費の計上です"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "新型コロナウイルスワクチン接種事業をはじめ、増額された新型コロナウイルス感染症対応地方創生臨時交付金を財源とした感染症拡大防止及び経済対策事業等を早急に検討し実施してまいります"@ja.
<< kg:id_12 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "増額された新型コロナウイルス感染症対応地方創生臨時交付金を財源とした感染症拡大防止及び経済対策事業等を早急に検討し実施してまいります"@ja.
<< kg:id_12 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "令和４年度の臨時交付金に係る臨時経済対策等の予算につきましては、早い時期での予算補正で対応をしてまいります"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "水産業については、スルメイカの全国的な不漁や"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "クロマグロの漁獲規制"@ja.
<< kg:id_16 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "新型コロナウイルス感染症の影響による魚価の低迷など、漁業を取り巻く環境は依然として厳しい状況が続いております"@ja.
<< kg:id_16 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "漁業を取り巻く環境は依然として厳しい状況が続いております"@ja.
<< kg:id_16 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "つくり育てる漁業の推進のため、コンブ養殖施設の老朽化対策"@ja.
<< kg:id_16 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "キタムラサキウニ蓄養管理に伴う深浅移殖"@ja.
<< kg:id_16 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "ナマコの人工種苗放流など支援してまいります"@ja.
<< kg:id_16 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "流通施設等の整備として清部漁港と白神漁港の荷捌施設の取水設備の改修を支援してまいります"@ja.
<< kg:id_16 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "各地区のナマコ簡易採苗の取り組みに対し、受精卵の供給や飼育指導など増養殖生産の拡大を支援してまいります"@ja.
<< kg:id_16 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "松前小島周辺海域に大型魚礁の設置による漁場造成を実施し"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "水産加工業については、全国的なスルメイカの不漁"@ja.
<< kg:id_27 prop:cause kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "従業員の高齢化等により、大変厳しい状況が続いております"@ja.
<< kg:id_27 prop:effect kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "大変厳しい状況が続いております"@ja.
<< kg:id_27 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "安定した稼働ができるよう、引き続き関係者等と連携を図ってまいります"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "鳥獣被害対策については、近年、福島町をはじめ道内各地でクマによる人身事故が多発している状況にあります"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "また、シカによる農作物への被害も増加していることから"@ja.
<< kg:id_32 prop:effect kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "クマによる人身事故が多発している状況にあります"@ja.
<< kg:id_32 prop:effect kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "シカによる農作物への被害も増加している"@ja.
<< kg:id_32 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "駆除頭数の増加など対策を強化してまいります"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "新型コロナウイルス感染症拡大の影響で落ち込んだ景気"@ja.
<< kg:id_38 prop:effect kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "落ち込んだ景気の下支えに万全を期す構えであることから"@ja.
<< kg:id_38 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "新型コロナウイルス感染症対策に関連する国の動向を注視し、予算補正などの必要が生じた場合は適切に対応をしてまいります"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "本年のさくらまつりについては、全国各地でオミクロン株の感染急拡大の只中にあり、まだ開催の可否を検討している状況であります"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "町の一大イベントであり、経済への影響も大きいことから、その判断は極めて難しいものとなります"@ja.
<< kg:id_42 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "昨年の開催実績を踏まえ、町としては万全な支援体制を図ってまいります"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "新型コロナウイルス感染症の発生直後より観光需要が落ち込み"@ja.
<< kg:id_46 prop:cause kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "度重なる感染拡大で地域経済に深刻な影響を及ぼしていることから"@ja.
<< kg:id_46 prop:effect kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "地域経済に深刻な影響を及ぼしていることから"@ja.
<< kg:id_46 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "感染予防と経済活動の両立に、関係団体一丸となって取り組んでまいります"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "松前沖が洋上風力発電に係る「国の促進区域の指定」に向けた「一定の準備段階に進んでいる区域」に整理され、残される課題の送電に係る系統確保が必要であります"@ja.
<< kg:id_51 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "同区域に整理される各自治体と一体となって、国などに対して早期解決を強く要望してまいります"@ja.
<< kg:id_54 prop:cause kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "こうした資源ごみの分別を推進することが、ごみ処理費用の削減に繋がることから"@ja.
<< kg:id_54 prop:effect kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "ごみ処理費用の削減に繋がることから"@ja.
<< kg:id_54 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "古紙等の集団回収を推進するとともに、資源として再利用することが重要であります。こうした資源ごみの分別を推進することが、ごみ処理費用の削減に繋がることから、引き続き各町内会及び町民の皆様のご協力を得ながら、分別の徹底について広報活動を進めてまいります"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "各町内会等と連携しながら、クリーン作戦、不法投棄防止対策に引き続き取り組んでまいります"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "懸案の「松前公園整備実施計画」は、まだ策定に着手していませんが、専門家と意見交換を重ねている状況で"@ja.
<< kg:id_60 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "松前町総合計画の後期計画に位置付け、町内関係者とコンセンサスをとりながら策定に向け取り組んでまいります"@ja.
<< kg:id_63 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "環境省の補助事業も活用し、脱炭素ロードマップの策定経費を早い時期に予算補正で提案する予定であり、将来に向けたカーボンニュートラルに係る施策を地域振興に繋げていきたいと考えております"@ja.
<< kg:id_65 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "引き続き次世代を担う子どもの出産を奨励、祝福し、松前っ子誕生祝金を支給するとともに"@ja.
<< kg:id_65 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "高校までの医療費の無料化を継続し、子育て世帯の経済的負担の軽減を図ってまいります"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "地域福祉については、少子高齢化や生活スタイルの多様化の影響により"@ja.
<< kg:id_68 prop:cause kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "生活スタイルの多様化の影響により、家族機能や共に支え合う地域機能が低下していることから"@ja.
<< kg:id_68 prop:effect kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "家族機能や共に支え合う地域機能が低下していることから"@ja.
<< kg:id_68 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "地域福祉推進の中核としての役割を担う、社会福祉協議会への支援を行い"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "国民健康保険については、被保険者数が減少する一方"@ja.
<< kg:id_73 prop:cause kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "医療の高度化や"@ja.
<< kg:id_73 prop:cause kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "被保険者の高齢化などにより、医療費は増加傾向にあります"@ja.
<< kg:id_73 prop:effect kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "医療費は増加傾向にあります"@ja.
<< kg:id_73 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "引き続き医療費の適正化と税収等の財源確保に努めるとともに、財政運営の責任主体である北海道と連携しながら、健全な事業運営に努めてまいります"@ja.
<< kg:id_79 prop:effect kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "高齢者福祉については、当町の高齢化率が５０％を超える状況となっており"@ja.
<< kg:id_79 prop:effect kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "一人暮らしの高齢者等の割合も高くなってきており、町全体で高齢者の支援をしていく必要性があり"@ja.
<< kg:id_79 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "地域住民及び協力事業者、関係機関等が連携して取り組んでいる高齢者等見守りネットワーク等をはじめ、引き続き高齢者を見守る活動を推進してまいります"@ja.
<< kg:id_79 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "地域包括支援センター並びに介護関連事業者や医療関係機関等と連携、協力し、その支援に努めてまいります"@ja.
<< kg:id_84 prop:cause kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "健康づくりや疾病等のと予防については、まだまだ未知の部分が多い新型コロナウイルスの感染防止対策を重要課題とし"@ja.
<< kg:id_84 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "国の方針や情報を把握しながら、当町の状況に応じた新型コロナワクチン追加接種を安全に実施することをはじめ"@ja.
<< kg:id_84 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "各種情報の周知や対策等を実施する関連予算については、予算補正で対応してまいります"@ja.
<< kg:id_84 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "乳幼児健診、がん検診、特定健診等の健康増進に関する保健事業は、国の指針に沿った感染防止対策に万全を期し、実施可能な方法を検討し、町民へ健康管理に必要な機会を提供できるよう取り組んでまいります"@ja.
<< kg:id_89 prop:effect kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "病院を取り巻く環境は、ますます厳しい状況にあることから"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "安定的な経営基盤の回復に向けて、山本病院事業管理者並びに八木田病院長と連携を密にし"@ja.
<< kg:id_89 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "４月１日導入の地域包括ケア病床については、スムーズな運営に意を配してまいります"@ja.
<< kg:id_89 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "医師並びに医療スタッフの確保に全力を尽くすとともに"@ja.
<< kg:id_89 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "町議会議員の皆様並びに町民の皆様へご説明したうえで基本構想を決定し、同様の手続きを踏まえ、本年度中に基本計画を決定していきたいと考えております"@ja.
<< kg:id_95 prop:cause kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "公共交通の維持確保については、コロナ禍による影響も含み、年々利用者が減少しておりますが"@ja.
<< kg:id_95 prop:effect kg:id_97 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "買い物や通院等に公共交通を利用されている高齢者や交通弱者のため"@ja.
<< kg:id_95 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "町内を運行する大漁くんバス及びハイヤーの持続的な運行を支援してまいります"@ja.
<< kg:id_95 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "公共交通に係る法律の改正があったことから、新たな公共交通計画の策定が必要となり、令和４年度から２年をかけて、松前町公共交通活性化協議会において策定する"@ja.
<< kg:id_100 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "このため、町主催の総合防災訓練を実施するほか"@ja.
<< kg:id_100 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "各町内会主催の避難訓練に対して支援を行ってまいります"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "町内会活動については、人口減少等による担い手不足により、町内会組織の運営と組織の弱体化が懸念されております"@ja.
<< kg:id_103 prop:effect kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "町内会組織の運営と組織の弱体化が懸念されております"@ja.
<< kg:id_103 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "町内会連合会を通じて、地域コミュニティの維持、活性化を支援してまいります"@ja.
<< kg:id_107 prop:effect kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "本年度も放置することが不適切な状態の空家等の除却を推進し"@ja.
<< kg:id_107 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "５年目を迎える「空家等除却支援事業」については、昨年度までの４年間で１１５棟の除却を行ってまいりました。本年度も放置することが不適切な状態の空家等の除却を推進し、町民の安全で安心な住環境の向上に引き続き取り組んでまいります"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "人口減少に伴う職員数も減少する中で、簡素で効率的な組織機構の見直しを行うため"@ja.
<< kg:id_110 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "更なる検証を行ってまいります"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "支所のあり方についても、職員体制や各種事務等の見直しの検討をおこなっておりますが"@ja.
<< kg:id_113 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "地域の方々の意見を伺いながら、住民サービスの低下に繋がらない方向性を見出してまいります"@ja.
<< kg:id_116 prop:cause kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "人口減少や水産物の水揚げの減少などにより、総所得金額の増加が見込めず大変厳しい状況が続いております"@ja.
<< kg:id_116 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "本年度から延滞金を徴収することから、更に納期内完納の啓発に努めながら取り組んでまいります"@ja.
<< kg:id_116 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "渡島・檜山地方税滞納整理機構と連携し、積極的に滞納処分を実施しながら、歳入の確保と収入未済額の圧縮に努めてまいります"@ja.
<< kg:id_120 prop:cause kg:id_121 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "大きく減少した令和２年度国勢調査人口が採用されていることも影響し、前年度並みの一般財源の確保が大変厳しい状況にあることから"@ja.
<< kg:id_120 prop:effect kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "前年度並みの一般財源の確保が大変厳しい状況にあることから"@ja.
<< kg:id_120 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "財政収支の均衡を図るため、財政調整基金を編入し、予算を編成したところであります"@ja.
<< kg:id_124 prop:effect kg:id_125 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "形態を変えて増幅する新型コロナウイルス感染症の収束が見通せず、予防はもとよりウィズコロナのあり方が重視されております"@ja.
<< kg:id_124 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "予防と経済のバランスを計り、国の経済対策等の動向を注視し、機動的に対応してまいります"@ja.
<< kg:id_127 prop:cause kg:id_128 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "いろんな施策撃てども効果が出ない状況があるというふうなことであれば、やっぱり少しでも人口が減少するスピードが緩やかになるっていうことが、一番大事"@ja.
<< kg:id_127 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "スピード感を緩やかにするっていうところに着目していきたいなと思ってますし、住んでる人が最後に松前で良かったなと、松前で住めて良かったなと、生活できて良かったなと実感できる町になってくれればいいな"@ja.
<< kg:id_130 prop:cause kg:id_131 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_100;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "昨年の暮れに館浜地区の海岸に大量のイワシが打ち上げられて、かなり異臭が漂い、その処理をされました。海産資源への影響も懸念されておりましたが、館浜地区の浅海漁場においてはウニ、アワビ、ナマコ、海藻類の育成は、壊滅的な状況にある"@ja.
<< kg:id_130 prop:effect kg:id_132 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_102;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "館浜地区の浅海漁場においてはウニ、アワビ、ナマコ、海藻類の育成は、壊滅的な状況にあるとのことです"@ja.
<< kg:id_130 prop:effect kg:id_133 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "この資源の回復には３年以上というように危惧されております。これは、漁業者の死活問題にも及びます"@ja.
<< kg:id_130 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "天然海域の詳細の調査は時化る状況でありますので、まだ未実施となっているところでありますが、海の状況を見ながら調査をしていきたい"@ja.
<< kg:id_130 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "これは災害だというふうなことを伝えております。太平洋側で確認されている赤潮と同様な対応を北海道としてもとっていただきたいと、国にも要請していただきたい"@ja.
<< kg:id_130 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "いろんな関連予算が出てくるとすれば、町としては予算補正等で対応してまいりたい"@ja.
<< kg:id_42 prop:cause kg:id_137 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "新型コロナの全国的な感染の広がりから、昨年以上に難しい判断になるかと思われます"@ja.
<< kg:id_42 prop:effect kg:id_138 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "この２年間新型コロナの影響で町の経済は相当落ち込んでいます"@ja.
<< kg:id_42 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_110;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "昨年同様感染防止対策を設けまして、ぜひ開催してほしい。これが私の本当の心です"@ja.
<< kg:id_42 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "規模を縮小してもぜひ開催はしていきたいなというふうに考えているところであります"@ja.
<< kg:id_42 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "ぜひ感染予防しながら、まつりは実施したいというふうに考えているところであります"@ja.
<< kg:id_142 prop:cause kg:id_143 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_114;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "また、松前観光協会と松前物産協会が合併による法人化の協議を進めていることから、町としては、組織の基盤強化に向けて支援をしてまいります"@ja.
<< kg:id_142 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "町としては、組織の基盤強化に向けて支援をしてまいります"@ja.
<< kg:id_63 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_117;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "具体的には公共施設への再エネ化、それから公用車のＥＶ導入等、再生エネルギーを利用することで実施することができる脱炭素、更には将来地域電力組織を立ち上げて"@ja.
<< kg:id_63 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_119;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "お尋ねのロードマップにつきましては、迎えました４年度の中で策定する準備を今しているところであります"@ja.
<< kg:id_147 prop:effect kg:id_148 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "一人一人の暮らしぶりの実態を知るということから始める必要あると思います"@ja.
<< kg:id_147 prop:contermeasure kg:id_149 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "担当職員と今の町で全体で支えているシステム、形がいいのかどうか、もう一回点検できるような体制をとってまいりたい"@ja.
<< kg:id_147 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "高齢者の方が外に出ていけるような環境ができて、高齢者の方が長生き、元気よく長生きできるような、その方向に進めれればいいな"@ja.
<< kg:id_103 prop:cause kg:id_151 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "今あれですよね、高齢者事業団だって、町内会だってみんな役場ＯＢが中心です"@ja.
<< kg:id_152 prop:effect kg:id_153 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_125;
    prop:text-txt_contents "長期間放置されている空家が数多く見受けられ、その間劣化が進み自然災害等によって人的、物的被害が懸念されるほか、放火の危険性なども考えられ、治安上心配である"@ja.
<< kg:id_152 prop:cause kg:id_154 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "高齢者人口が５０％以上になっている現在、町の人口減を考えると、今後更に空家が増えることが予想される"@ja.
<< kg:id_152 prop:contermeasure kg:id_155 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_127;
    prop:text-txt_contents "除却支援補助金につきましては、平成３０年４月１日の施行後から、令和３年度までの４年間で、今議員お尋ねのとおり１１５件を対象にしてきている"@ja.
<< kg:id_156 prop:cause kg:id_157 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "危険家屋の件数は５１件のうち所有者が死亡し、相続人も不明な件数は１４件"@ja.
<< kg:id_156 prop:contermeasure kg:id_158 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_129;
    prop:text-txt_contents "危険な状態を回避するために、必要最小限度の措置、これは屋根が飛ばないようにするためにロープをかけるなどを消防署の協力を得ながら、現在実施をしている"@ja.
<< kg:id_156 prop:contermeasure kg:id_159 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_130;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "行政代執行を行う場合には、結果として町費を投入して実施することとなることから、自ら解体する方との自費で負担して解体する方との不公平感も生ずること。また、行政代執行を行うことで自ら解体しなくても、最終的に町が何とかしてくれるとの、その考えが町民の中に浸透することへの懸念もある"@ja.
<< kg:id_156 prop:contermeasure kg:id_160 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_132;
    prop:text-txt_contents "当面は前段で答弁したとおり、必要最小限度の緊急安全措置などで対応しまして、所有者に確認しているものにつきましては、引き続き粘り強く保全解体のお願いをしていく考えであります"@ja.
<< kg:id_161 prop:contermeasure kg:id_162 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "北海道町村会を通しまして、いろんな情報共有しながら国の方への要望をしてまいりたい"@ja.
<< kg:id_163 prop:contermeasure kg:id_164 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_134;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_135;
    prop:text-txt_contents "高齢者が健康で生き生きとした暮らしができるように、余暇活動を始め、ボランティア活動、更には高齢者事業団への登録及び老人クラブでの仲間づくりを充実させて、地域社会で孤立した高齢者をなくしていくことが必要"@ja.
<< kg:id_163 prop:contermeasure kg:id_165 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_136;
    prop:text-txt_contents "やる気のある方は、農業ハウスでもそうなんですが、相談によってくれればいいなあと思うんですね。ですから、相談にのれるような体制づくり、環境づくりは役場の方ではとっております"@ja.
<< kg:id_166 prop:cause kg:id_167 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_137;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_138;
    prop:text-txt_contents "今年はすごい大雪に見舞われまして、避難路の維持管理のほとんどが高齢者事業団に委託しているところなんですが、あれだけ降ったもんですから、やはり、一気に町内全域をかくことができない"@ja.
<< kg:id_166 prop:effect kg:id_168 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_139;
    prop:text-txt_contents "避難路の維持管理のほとんどが高齢者事業団に委託しているところなんですが、あれだけ降ったもんですから、やはり、一気に町内全域をかくことができない"@ja.
<< kg:id_166 prop:contermeasure kg:id_169 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_140;
    prop:text-txt_contents "今後に向けて、どのような方策があるのか、ちょっと考えていきたい"@ja.
<< kg:id_170 prop:cause kg:id_171 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_141;
    prop:text-txt_contents "道から支援物資が届くこととなっておりますが、現状ではすぐには届かないのが実情であることから"@ja.
<< kg:id_170 prop:contermeasure kg:id_172 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_142;
    prop:text-txt_contents "希望に添ってすぐ配布できるよう、町単独で食糧品や日用品等を配布するための経費の計上です"@ja.
<< kg:id_170 prop:contermeasure kg:id_173 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_143;
    prop:text-txt_contents "あくまでも本人からの手挙げ方式と申しますか、我々把握してないので、その辺を防災無線等で周知して、感染者で自宅療養している方、また濃厚接触者で家族などから支援を受けれない方については、日用品だとか食料品をこちらの方で支援する"@ja.
<< kg:id_170 prop:cause kg:id_174 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_144;
    prop:text-txt_contents "あくまでも個人情報があるので、そこは駄目だというふうな形で、そのままであれば私どもも、ちょっと道の方の支援が遅れる"@ja.
<< kg:id_175 prop:contermeasure kg:id_176 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_145;
    prop:text-txt_contents "新たなデジタル観光の推進に向けて、デジタル技術を活用した観光客の周遊促進、再来訪の促進を図るための実証事業を行う"@ja.
<< kg:id_175 prop:contermeasure kg:id_177 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_146;
    prop:text-txt_contents "松前城資料館と松前藩屋敷の入館者及び誘客イベントの参加者に、電子ギフト券を配布し、利用者の属性や消費行動を分析し"@ja.
<< kg:id_175 prop:contermeasure kg:id_178 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_147;
    prop:text-txt_contents "ＬＩＮＥ広告を使って松前町公式ＬＩＮＥの加入の促進と、プレゼント企画を実施し、旅行喚起と特産品の購買意欲を促進する"@ja.
<< kg:id_179 prop:contermeasure kg:id_180 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_148;
    prop:text-txt_contents "コロナ禍で２年間実施したプレミアム物産品事業は、１万円の物産を半額で購入できるなど、大変好評であり、町内、町外に向けて利用できることから、お盆と年末の２回に分けて松前物産協会において実施する"@ja.
<< kg:id_181 prop:contermeasure kg:id_182 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_149;
    prop:text-txt_contents "コロナ禍である一昨年、昨年と実施してきた消費循環型クーポン券ですが、小売店等及び消費者にも大変好評で、経済効果も上がっており、令和４年度も昨年同様に実施する"@ja.
<< kg:id_183 prop:effect kg:id_184 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_150;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_151;
    prop:text-txt_contents "どうせなら、ここまで冷え込んでしまったもんですから"@ja.
<< kg:id_183 prop:contermeasure kg:id_185 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_152;
    prop:text-txt_contents "こういった補助金をすることによって、まずは町内で消費を回しましょう、そのことによって事業者の事業の継続の下支えに繋げていきましょう"@ja.
<< kg:id_183 prop:contermeasure kg:id_186 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_153;
    prop:text-txt_contents "少しでも町民の意欲がわくような、そういう取り組みを進めていきたいと思っております"@ja.
}
