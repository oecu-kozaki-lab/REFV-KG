kg:id_93 prop:cause kg:id_94.
kg:id_95 rdfs:label "国民健康保険特別会計から病院事業会計へ４千１万１千円を繰り出す"@ja.
kg:id_95 rdf:type cls:c_15824.
cls:c_15824 rdfs:label "会計繰出"@ja.
kg:id_93 prop:effect kg:id_95.
kg:st_1 rdfs:label "９番梶谷康介君"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "有望な区域への整理は前進だと受け止めている"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "１年ぐらいで促進区域まで進むと受け止めている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長石山英雄君"@ja.
kg:st_2 rdfs:type cls:st_96.
cls:st_96 rdfs:label "町長"@ja.
kg:op_3 prop:content "一般的に１年くらいはかかるとの見通しを示す"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "町民にも説明するべきと考えている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "コロナ対応で思い描くまちづくりに十分全力投球できなかったのではないかとみている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "町政推進に影響はなかったとはいえないと認識している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "せっかくのチャンスが生かし切れていなかったとみている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "今後は連携を密にし知恵を借りながらまちづくりを進めたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "職員と大手企業社員の知識を融合した画期的な計画だと認識している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "町民にわかりやすく取り組みを知らせたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:st_3 rdfs:label "水産課長渡辺孝行君"@ja.
kg:st_3 rdfs:type cls:st_228.
cls:st_228 rdfs:label "担当課長"@ja.
kg:op_11 prop:content "付着面積を増やせば水揚げ向上が期待できるとみている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "当初期待した広域対応になっていないことを懸念している"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "１基でも一区画でも復活できるよう取り組んでいる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:st_4 rdfs:label "５番福原英夫君"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_14 prop:content "事故対応の責任主体を明確にすべきと考えている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
kg:op_15 prop:content "高齢者の身体状況に合わせた交通体系が必要だと考えている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "買い物や通院への支援が必要だと訴えている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "通院負担が大きく改善が必要だとみている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "足が悪く選挙に行けない人もおり高齢者生活に合った交通体系が必要だと訴えている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "少しでも町民の不安解消になる公共交通にしたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "全国的な傾向で国も対策しているが解決策は見いだされていないと認識している"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "町内の介護施設で人手不足が深刻だとみている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "他自治体のような奨学金制度参加など対策を考えるべきだと提案する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "状況を見ながら検討していかなければならないと考えている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "頭数や生産性や目標額など希望が見えるＰＲが必要だと考えている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "新規就農者をきちんと受け入れる体制ができてきたと説明する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "町民に見てほしいしＰＲしたいと考えている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:st_5 rdfs:label "教育長宮島武司君"@ja.
kg:st_5 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_27 prop:content "保存伝承活動の継続には課題が大きいと認識している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "祇園ばやしが出なかったことを町民が心配している"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "関係者と話し合いながら方向性を探りたい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "地区に限らず全町的な後継者確保が必要だと考えている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "誰でも参加できる雰囲気づくりが必要だと考えている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:op_32 prop:content "子どもたちとのふれあいを通じ将来の担い手を期待している"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "相談窓口の一本化や迅速対応や家庭訪問が必要だと訴えている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "町民が抱える不安解消のためサービス低下を防ぎたい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:st_6 rdfs:label "病院事務局長白川義則君"@ja.
kg:st_6 rdfs:type cls:st_229.
cls:st_229 rdfs:label "事務局長"@ja.
kg:op_35 prop:content "電子カルテ導入で情報共有と業務効率化と待ち時間短縮が期待できる"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "電子カルテ導入を期待していた"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "ドクター不足への対応や高度な医療判断の迅速化につながると理解している"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "病院間の画像共有やリアルタイム確認が可能になり利便性が上がる"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_6.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "要因としては、桜の開花が大幅に早まった影響で"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "函館市が４月の１４日に、札幌市が４月の１５日に開花し、道内各地の桜の見頃と当町のさくらまつりが重なったため、客足が分散したことにより、前年を下回ったと推測しています"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "さくらまつり期間中の入込数については、前年度比４．９％減の７万７千人となり、前年を下回る結果となりました"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "海洋再生可能エネルギー発電設備に係る海域の利用の促進に関する法律に基づく海洋再生可能エネルギー発電設備整備促進区域の指定に向けた、必要な出力規模や系統接続の蓋然性の確認等を行う調査結果を踏まえて、松前沖を含む北海道の５区域が新たに「有望な区域」に整理された"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今回の有望な区域の整理により、促進区域への指定の道が開かれた"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:text-txt_contents "今後は、再エネ海域利用法に基づく法定協議会が設置され、松前町及び利害関係者となる松前さくら漁業協同組合や北海道並びに関係省庁等で、最終的な協議、検討及び調査を行い"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "通常であれば１年程度の期間を要するものと見込まれております"@ja.
<< kg:id_7 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今後の動向等について、町民の皆様にもご説明をするべきと考えており、６月下旬を目途に町内４ヶ所において説明会を開催する予定"@ja.
<< kg:id_7 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "更には町内の産業団体や有識者等による町独自の推進協議会を設立し"@ja.
<< kg:id_7 prop:contermeasure kg:id_13 >>
    prop:text-txt_contents "法定協議会における町の意見調整や課題等の情報共有を図り、円滑に促進区域の指定が受けられるよう意を配しながら、松前沖洋上風力発電の推進に向けて努力してまいります"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "奨学資金貸付金は１件１名１８万円、債務者死亡によるものです。水道料金は、２件１名５千２３８円、債務者死亡によるものです。休栓料金は、２３件２名２万２千３５６円、債務者死亡によるものです。病院診療費は、２５件５名５９万７千７２０円、債務者死亡によるもの"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:text-txt_contents "学校給食費は、１２件２名４１万８千１５０円、生活困窮によるものです。病院診療費は、１７件９名１２万８千８８７円、生活困窮によるもの"@ja.
<< kg:id_14 prop:cause kg:id_17 >>
    prop:text-txt_contents "病院診療費は、４３件１７名６４万９千４４４円、所在不明によるもの"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:text-txt_contents "地方税法施行令等の一部を改正する政令が、令和５年３月３１日に交付され、令和５年４月１日に施行されることから、令和５年度課税分の課税限度額を法定限度額と同額とするため"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:text-txt_contents "令和５年度です。医療給付費分は変わらず６５万円、後期高齢者支援金分を２２万円に、介護納付金分は変わらず１７万円、合計限度額を１０４万円にするものであります"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:text-txt_contents "令和４年度当初課税ベースで、対象世帯が５世帯、１０万円の課税額の増額が見込まれるところでございますが、令和５年度で資産割の廃止と税率改正があることから、２世帯で４万円の増額となるところであります"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:text-txt_contents "同規則での位置付けが２類相当から５類感染症に移行されたことにより、当該特殊勤務手当の支給要件である感染症でなくなったため"@ja.
<< kg:id_22 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "現行の特例措置は、令和５年５月７日までを対象とし、同月８日以降は対象としないこととしたところであります"@ja.
<< kg:id_22 prop:contermeasure kg:id_25 >>
    prop:text-txt_contents "今後新型コロナウイルス感染症の変異株が特定新型インフルエンザ等に該当することとなり、再び特殊勤務手当の支給が必要となった際に適用できるようにするため追加したところであります"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "新型コロナウイルスの感染症が発生して、この１期４年の間のほぼ３年にわたって、この感染症対応を余儀なくされてきたと。おそらく、町長も自分の思い描いてるまちづくりに全力投球が十分にできなかったんでないのかなと。○町長 石山英雄君 町政の推進にあたっても、影響はなかったということにはならない"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "残念ながら新型コロナの関係で、非常に町長も心配していたようですけれども、思うように交流ができない。ですから、残念ながら進んでない"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今年度から、昨年度から松前においでいただきまして、いろんなご相談を申し上げる、更には町の計画づくりにも参画していただけるような状況まで回復しておりますので、今後は、連携をまだまだ密にしまして、知恵を借りながらまちづくりを推進して行きたい"@ja.
<< kg:id_29 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "令和４年度に策定しました松前町スマートシュリンクＳＸビジョンやＤＸ推進計画、更にはＳＤＧｓチャレンジアクションというものを４年度に作成しております"@ja.
<< kg:id_29 prop:contermeasure kg:id_32 >>
    prop:text-txt_contents "令和４年度に作成したスマートシュリンクＳＸビジョン他２件の総合計画を補完する計画を実施していくために、官民が連携して取り組むため、松前ＳＸ推進共創会議をこの６月に設立する予定"@ja.
<< kg:id_29 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "年明け頃に、町民の皆様への報告会という形で今後開催していきたい。また、７月にはＳＤＧｓチャレンジアクションの町民説明会も予定しております。そのような場所でも町の取り組みを情報発信してまいりたい"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "港の中というものは、ナマコの付着する面積が極端に少ないという部分で、それを少し改良することによって水揚げが上がってくるんでなかろうか"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:text-txt_contents "３漁港、大沢、館浜、札前に合計４３基の竜宮礁を入れて、今随時調査をしているところでございます"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:text-txt_contents "４系統のうち３系統に設置されているＳＶＲを通過する際に、一瞬電圧の低下が３７％おきるが、系統連携のガイドラインでは瞬時電圧低下は、常時電圧の１０％以内でなければならないというふうに規定されている"@ja.
<< kg:id_38 prop:cause kg:id_40 >>
    prop:text-txt_contents "これをクリアするために必要な設備の費用が莫大になるようでというふうに聞いております"@ja.
<< kg:id_38 prop:effect kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "唯一ＳＶＲが設置されていない１系統のみマイクログリッドが構築できることになった"@ja.
<< kg:id_38 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "経産省の方には現在働きかけを行っている状況であります。１基でも、一区画でも復活できればなというふうな思いで、今取り組んでいるところであります"@ja.
<< kg:id_43 prop:contermeasure kg:id_44 >>
    prop:text-txt_contents "この夏には通信試験を実施する予定であります"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "この事故対応につきましては、当然ながら風力発電施設の所有者、もしくは占有者が責任を負うこととなります。適切な処理を行うことが義務付けられている"@ja.
<< kg:id_45 prop:contermeasure kg:id_47 >>
    prop:text-txt_contents "令和３年４月１日から小型風力発電設備の所有者等は、事故報告が義務化もされたところであります"@ja.
<< kg:id_45 prop:contermeasure kg:id_48 >>
    prop:text-txt_contents "事故後は産業保安監督部の現地確認や事故原因の究明と、再発防止策の要請がされることとなります"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "６５歳以上の年齢に合わせた、身体的に病弱な方々に合わせた交通体系がつくられなければならない"@ja.
<< kg:id_49 prop:cause kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "車を所有していない、免許返納、買い物等への支援がどうにかしてもらえないかなあ"@ja.
<< kg:id_49 prop:cause kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "特に町内外への通院、これにかかる経費負担が大きいよと"@ja.
<< kg:id_49 prop:effect kg:id_53 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "選挙に行く時に足が悪い、身体が動かない、隣近所でそれを補助して連れて行ってくれる人がいない。したら、どうしたら私の１票が役立つのか"@ja.
<< kg:id_54 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "地域公共交通の活性化及び再生に関する法律に基づきまして、５年間の計画期間の松前町地域公共交通計画を、本年１０月の完成に向けて作成をしているところ"@ja.
<< kg:id_54 prop:contermeasure kg:id_56 >>
    prop:text-txt_contents "夏頃には、パブリックコメントを実施できればな"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "これは全国的にそういう傾向だというふうに認識しております。国の方も解決策などいろいろ手は打ってるようでありますけども、見出されていない現状"@ja.
<< kg:id_57 prop:effect kg:id_59 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "これは松前の現状です。介護福祉士、特に介護福祉士が不足してきていると"@ja.
<< kg:id_57 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "木古内町が東川町が創設した外国人留学生向けの奨学金制度に参加してるんです。○町長 石山英雄君 状況を見ながら検討していかなければならない"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "町民は少し知りたいんだけども、どうなってるんだろう。町民からは、わからないから進路の判断としては厳しいね"@ja.
<< kg:id_63 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "新規就農者をきちんと受け入れる体制も今できてきました"@ja.
<< kg:id_63 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "ぜひ町民の方々には見てほしいし、現場で頑張っている新規就農者もおりますので、その部分は、我々もＰＲして、町民にＰＲします"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "近年会員の方々の体調不良や高齢化に伴いまして"@ja.
<< kg:id_66 prop:cause kg:id_68 >>
    prop:text-txt_contents "近年会員の方々の体調不良や高齢化に伴いまして"@ja.
<< kg:id_66 prop:cause kg:id_69 >>
    prop:text-txt_contents "今回は演奏者の確保、特に三味線と太鼓の奏者の確保に苦慮した"@ja.
<< kg:id_66 prop:effect kg:id_70 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "この度、議員おっしゃるように４月２９日に行いましたさくらまつりでも、郷土芸能大公開では急遽参加が見送られ"@ja.
<< kg:id_66 prop:contermeasure kg:id_71 >>
    prop:text-txt_contents "今後も引き続き保存伝承活動が継続していけるように、引き続き支援してまいりたい"@ja.
<< kg:id_66 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "関係者と相談しながら課題解決に向けて、地域の方々、関係者の方々といろいろと話し合っていかなければならない"@ja.
<< kg:id_66 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "全町的な視点でもって後継者確保の呼びかけを行うことや"@ja.
<< kg:id_66 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "誰でも参加できるんですよというふうな雰囲気づくりが必要でないかな"@ja.
<< kg:id_66 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "松前学園ふるさと学習というものを実施しておりまして、大島、小島、松城の３小学校が合同で江良杵振舞体験を実施している"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "相談のために電話しても思うような答えが返ってこない、相談の窓口を一本化してもらいたい、対応の迅速化、また、家庭訪問や現場検証をしていただきたい"@ja.
<< kg:id_78 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "常日頃から職員とは対町民に対しまして、サービスの低下にならないようにというふうなことを言っておりますので、十分配慮しながら対応していきたい"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:text-txt_contents "現在スクールバスの運行業務委託を函館バス株式会社と契約しておりますが、職員の退職等により、運行が困難となってきている"@ja.
<< kg:id_80 prop:contermeasure kg:id_82 >>
    prop:text-txt_contents "新たに町において令和５年度でスクールバスを購入し、運行を行う"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:text-txt_contents "既存プールが老朽化し、使用には多額の修繕を要する見込み"@ja.
<< kg:id_83 prop:contermeasure kg:id_85 >>
    prop:text-txt_contents "海上自衛隊松前警備所との協定により、各小学校のプール学習で、海上自衛隊のプール使用が可能となった"@ja.
<< kg:id_86 prop:cause kg:id_87 >>
    prop:text-txt_contents "今カルテに書いてるものが、先生が書いてる診療記録になるんですけれども、それがまず電子化することによって様々な関係部署に情報が、まず共有ができる"@ja.
<< kg:id_86 prop:effect kg:id_88 >>
    prop:text-txt_contents "事務局の中にこの紙カルテの保管庫があるんですけれども、もうパンパン状態って言ったらあれですけど、もう入れる場所がない"@ja.
<< kg:id_86 prop:effect kg:id_89 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "電子カルテ入れることによって、直接端末上、パソコン上でこの検査してください、結果が出たらすぐまたパソコンの方にこういう結果が出ましたっていう形で、スムーズに医療情報がリアルタイムでわかるような形になりますので、これ自体は患者さんにとっても待ち時間のある程度短縮にも繋がる"@ja.
<< kg:id_86 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "医療情報システム購入一式"@ja.
<< kg:id_91 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "医用画像システム購入一式。そういう画像システムを入れることによって、当然電子カルテの方にも行くような形で、先生方もすぐリアルタイムで見れたり。当然他の病院に転院する場合も、函館市内の医療機関と地域連携システムっていうものを組んでまして、そういう情報の共有もできる"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:text-txt_contents "今年度から町立松前病院が国民健康保険法に基づく診療施設として位置付けられたことにより、松前病院の医療情報システム導入に係る経費等に対して、国民健康保険特別会計に助成金が交付された"@ja.
<< kg:id_93 prop:effect kg:id_95 >>
    prop:text-txt_contents "町立松前病院の電子カルテの医療情報システム導入等に係る操出金で、歳入の保険給付費等交付金の特別交付金４千１万１千円を全額病院事業会計へ繰り出ししようとする"@ja.
}
