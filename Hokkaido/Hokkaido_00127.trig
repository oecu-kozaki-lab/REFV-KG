kg:st_1 rdfs:label "松前町長若佐智弘"@ja.
kg:st_1 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "次回以降も応募可能性を検討し構想実現へ取り組む"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "８番梶谷康介議員"@ja.
kg:st_2 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_2 prop:content "不採択は実現の道筋や採算性が見えないことが大きいとみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "応募見送りはやむを得ないが次回へ向け検討を続ける"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "構想だけで実現性が見えない点が不採択要因だと受け止める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "厳しい状況でも脱炭素化と再エネ推進は継続する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "先進性だけでなく実現の道筋が必要だと指摘する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "関連企業との連携や新規開拓で構想実現を進める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "環境省採択がなくても独自に進めるなら道筋を示すべきと求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "機会があれば再応募したい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "構想実現に向け創意工夫して進める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "地域エネルギー会社設立を急ぐべきと求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "協議が最も進んでおり早期指定に期待を示す"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:st_3 rdfs:label "税務課長斉藤浩"@ja.
kg:st_3 rdfs:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_13 prop:content "条例に基づき放棄した債権を報告する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "所在不明による債権放棄を報告する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "債務者死亡による債権放棄を報告する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "経営改善を進めたうえで病院のあり方を議論したい"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "病院建設は急ぐべきだが財政と経営改善の見極めが必要と問う"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "建築費高騰を踏まえ規模や時期を見極めたい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:st_4 rdfs:label "６番福原英夫議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_19 prop:content "起債がなければ町財政では重い負担になると懸念する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "２０年後３０年後を見据えた病院規模を見直すべきと考える"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:st_5 rdfs:label "２番勇谷鷹宇議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_21 prop:content "新病院建設の見通しを早く示してほしい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "改善できるものは速やかに対応する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "年度内に方向性を示すよう求める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:st_6 rdfs:label "政策財政課長五十嵐愛之"@ja.
kg:st_6 rdfs:type cls:st_32.
kg:op_24 prop:content "法改正への対応として必要な工事と説明する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_6.
kg:op_25 prop:content "今後の改修計画や方向性を示すよう求める"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:st_7 rdfs:label "病院事務局長鍋島孝明"@ja.
kg:st_7 rdfs:type cls:st_32.
kg:op_26 prop:content "老朽化し不具合防止のため更新する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_7.
kg:st_8 rdfs:label "１番齋木良太議員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_27 prop:content "命に関わるため不具合前の更新は必要と受け止める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_8.
kg:op_28 prop:content "直近の重要課題として町全体で取り組むべきと訴える"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_8.
kg:st_9 rdfs:label "町長若佐智弘"@ja.
kg:st_9 rdfs:type cls:st_33.
kg:op_29 prop:content "注意喚起と対策周知を進めたい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_9.
kg:op_30 prop:content "外来や搬送の実績を踏まえ注意喚起を進める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_9.
kg:op_31 prop:content "予防可能なため件数を減らす対策が必要と指摘する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_8.
kg:op_32 prop:content "暑さ対策と省エネの一石二鳥の事業と捉える"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_9.
kg:op_33 prop:content "町民要望に応じた追加補正を評価する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "購入できない人への対応や公平性も考えるべきと指摘する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_8.
kg:op_35 prop:content "会館へ安心して集まれるよう早く実現したい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_9.
kg:op_36 prop:content "購入できない人のため身近な涼しい場所整備が必要と提案する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_8.
kg:op_37 prop:content "町民の生命を守るため様々な手立てで周知する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_9.
kg:op_38 prop:content "個人登録任せでなく町として発信すべきと求める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:st_10 rdfs:label "教育長宮島武司"@ja.
kg:st_10 rdfs:type cls:st_230.
cls:st_230 rdfs:label "教育行政職員"@ja.
kg:op_39 prop:content "暑さ対策を柔軟に行うため夏休みを３０日に延長した"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_10.
kg:op_40 prop:content "学校は先進的に対応しており継続強化を期待する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_8.
kg:op_41 prop:content "学校の実情に応じて校長が臨時休業や下校時刻変更を判断する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_10.
kg:op_42 prop:content "現場裁量を確保しつつ適切運用を求める"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_8.
kg:st_11 rdfs:label "５番沼山雄平議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_43 prop:content "迅速で正確な情報伝達手段の強化が必要と訴える"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_11.
kg:op_44 prop:content "ＬＩＮＥ等の情報発信を今年度中に実現したい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_9.
kg:op_45 prop:content "メールやＬＩＮＥなど多様な周知手段を早く整えたい"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_9.
kg:op_46 prop:content "同時配信や聞き逃し配信を急ぐべきと求める"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_11.
kg:op_47 prop:content "地域住民との分担協力が不可欠と指摘する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_11.
kg:op_48 prop:content "地域との分担が何より大事と認める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_9.
kg:op_49 prop:content "町内会と情報共有し実効性あるマニュアルにしたい"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_9.
kg:op_50 prop:content "町内会と共有できる実効的なマニュアルを求める"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_11.
kg:op_51 prop:content "いきいき教室など人が集まる会館に冷房整備が必要と提案する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_8.
kg:op_52 prop:content "安心して集まれるよう対応を進めたい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_9.
kg:st_12 rdfs:label "商工観光課長田中建一"@ja.
kg:st_12 rdfs:type cls:st_32.
kg:op_53 prop:content "活動内容や目指す姿を明確にし地域との意識共有を図る必要がある"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_12.
kg:op_54 prop:content "受け入れ体制や身分、将来像まで整える必要があると求める"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_4.
kg:op_55 prop:content "２泊３日で実際の活動や住民交流を体験してもらう"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_12.
kg:op_56 prop:content "人材受け入れの重要性を町民にも理解してもらうべきと訴える"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:op_57 prop:content "待つ募集でなく地域側から攻めて人材確保に努める"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_12.
kg:op_58 prop:content "ミスマッチを減らし必要なデジタル人材確保につながると期待する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_8.
kg:op_59 prop:content "高齢者や交通弱者のため持続的運行を支援する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_9.
kg:op_60 prop:content "維持だけでなく今後のあり方も検討すべきと問う"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_8.
kg:op_61 prop:content "町外接続バスも関係町と連携し支援を含め検討する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_9.
kg:op_62 prop:content "漁業者が減っても海域は減らないため増養殖など新たな方策が必要と考える"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_9.
kg:op_63 prop:content "個々人の生産力を上げる具体策を求める"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_4.
kg:op_64 prop:content "関係者と協議を重ね安定経営が図られるよう取り組む"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_9.
kg:op_65 prop:content "安定経営へ向け関係者と協議する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_9.
kg:op_66 prop:content "つくり育てる漁業や安定収入につながる事業を漁協と探求する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_9.
kg:st_13 rdfs:label "３番三浦昭雄議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_67 prop:content "漁業を抜本的に見直し陸上養殖など新たな方向へ踏み出すべきと主張する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_13.
kg:op_68 prop:content "海面養殖に限界があり陸上養殖に切り替えるべきと提案する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_13.
kg:op_69 prop:content "漁協と協議し慎重に判断したい"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_9.
kg:op_70 prop:content "海の変化に対応するため漁業を抜本的に見直す時期と訴える"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_13.
kg:op_71 prop:content "ブルーカーボン推進のためにもウニ陸上養殖が必要と主張する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_13.
kg:op_72 prop:content "実現化も必要だが漁協と十分協議し慎重に判断したい"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_9.
kg:op_73 prop:content "１０年経ってもあじさいまつり以外に目立つ変化がないと厳しく指摘する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_13.
kg:op_74 prop:content "海の資源を活かす体験型観光の実現可能性を関係機関と協議する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_9.
kg:op_75 prop:content "洋上からの桜観光やマグロウオッチングなど通年観光を提案する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_13.
kg:op_76 prop:content "実現できるものや必要な許認可を整理し取り組みたい"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_9.
kg:op_77 prop:content "法改正対応として今回の時期に提案した"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_6.
kg:op_78 prop:content "今後の改修計画と合わせて病院の方向性を示すべきと求める"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_4.
kg:st_14 rdfs:label "脱炭素推進課長佐々木弘幸"@ja.
kg:st_14 rdfs:type cls:st_32.
kg:op_79 prop:content "町民を待たせないため急遽補正したと説明する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_14.
kg:op_80 prop:content "多くの要望に応えた追加補正を評価する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業の採算性や技術的課題をクリアできず、実現性が非常に困難であるとの判断に至りました。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "提案書提出期限までに事業構築の精度と確実性が募集水準を満たすことは難しいと判断し、第５回脱炭素先行地域計画提案の応募を見送ることとし"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "これまでに７３ヶ所が採択され、残りわずか２７ヶ所程度と狭き門である"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "環境省の提案審査は、全国の自治体に横展開を促し、脱炭素ドミノを起こすため、事業の先進性、モデル性を最重要視する基準強化がなされた"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "この見送りによって、再生可能エネルギーの地産地消を目指す「ＲＥ１００まつまえ構想」が途絶えるわけではなく"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "機会があれば次回以降も応募の可能性について検討をしてまいります。"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "これまでどおり関連企業との連携や新しい連携先の開拓などの創意工夫により、構想の実現に向けて取り組みを進めてまいります。"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "松前沖の法定協議会が２回開催され、道内五つの有望な区域の中で協議が最も進んでいる状況にあり、いち早い指定に向けた明るい兆しも見えてきております。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "水道料金は、５件１名９千３５０円、生活困窮によるもの、１件１名９１８円、所在不明によるもの...病院診療費は、２件２名４万１６０円、生活困窮によるもの"@ja.
<< kg:id_12 prop:cause kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "休栓料金は、２４件３名２万３千４００円、所在不明によるものです。...病院診療費は...４６件３２名１１４万２千８９１円、所在不明によるもの"@ja.
<< kg:id_12 prop:cause kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "病院診療費は、...１４件６名４０万２千５２３円、債務者死亡によるもの"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "病院の赤字幅を大幅に圧縮していかないと、これはやはり道の方でも国に対しての賛成はできないと、進達は難しいというような意見もございました。"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "今建築費が資材の高騰で２割削っても、今の段階で２割くらいは上がってると。ですから、前段で出された構想でいくと５０億ぐらいという話がありましたが、それも多分経費的には６０億にはなるだろう"@ja.
<< kg:id_16 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "将来的な財政負担や人口減少を見据えての建設計画が必要となります。...将来の松前町に相応しい病院のあり方を検討し"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "現在病院では令和６年３月から令和７年、来年２月までの間に経営改善支援コンサルティング業務を委託しまして、経営改善を図っております。"@ja.
<< kg:id_20 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_24;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "消防法が改正され、令和７年６月までに設置が義務化されているところであります。"@ja.
<< kg:id_20 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_26;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "ナースコールの方は老朽化しておりまして、不具合生じないためにも、今回更新したいと考えております。"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_28;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "昨年においては７月の２２日から９月１２日、厳重警戒の日が３０日、危険を表す日が１４日ありました。"@ja.
<< kg:id_24 prop:effect kg:id_26 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_30;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "令和５年で松前町立病院へ緊急搬送され、そして熱中症と診断された件数は１０件...松前町だけを見ますと６人という、６件という件数...外来での熱中症というか、そういうものを含めると令和５年７月８月で、２４件ほど"@ja.
<< kg:id_24 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_32;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "想定を大幅に超える申請があり、予算に不足を生ずる見込みであることから、新たに１５０世帯分１千９５０万円を追加"@ja.
<< kg:id_24 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_35;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "そういう利用状況考えた時に、そして設置者としてやはりそこのところはしっかりと対応していきたいという考えは持ってございます。...これは早く実現できるように取り組んでまいりたいと思います。"@ja.
<< kg:id_24 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "防災行政無線並びに様々な周知方法、町の方のＬＩＮＥの方で登録者数も随分増えておりますんで、１人でも多くの方にそれが伝えれてば"@ja.
<< kg:id_24 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_39;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "当分の間は現行と同様に５０日間として運用し、ただし夏を３０日間、冬を２０日間と致しまして運用する"@ja.
<< kg:id_24 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_41;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "熱中症警戒アラートが発表された時につきましては、暑さ指数、児童生徒や地域の状況、更には学校の環境等を勘案致しまして、臨時休業の実施等を校長がまず検討する"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_43;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "災害時、防災行政無線だけでは情報が行き渡らない場合があるっていうことが課題"@ja.
<< kg:id_32 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_45;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "ＬＩＮＥ等の情報発信は、確かに必要なものでありまして、これは関係部署と協議し、今年度中にこの情報発信ができるように努めてまいりたいと思ってます。"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_47;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "白神から原口までもあるので、素早く避難所開設するとかって無理な話でありますので、やはり地域の人と分担し、協力しあって避難所を開設するということが大事"@ja.
<< kg:id_35 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_49;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "松前町では令和３年に避難所の運営マニュアルを作成しております。...地域の実情に合わせた避難所マニュアルの作成に取り組んでまいりたい"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_51;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "やはりそういう利用状況考えた時に、そして設置者としてやはりそこのところはしっかりと対応していきたいという考えは持ってございます。"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_53;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "平成２３年度から２７年度までの５年間の間に当町においては８名の協力隊員が来てございます。しかしながら、いずれの方も定着しなかった。"@ja.
<< kg:id_40 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "お試し地域おこし協力隊...地域協力活動を体験していただき、受け入れ地域とのマッチングを図る制度"@ja.
<< kg:id_40 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_57;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "我々が直接そのプロフィールを見ながら、松前町に相性のいい人を選んで直接スカウトできるというのが、この度のＳＭＯＵＴというサイトになります。"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_59;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "地域公共交通の維持確保については、年々利用者が減少しているところではありますが"@ja.
<< kg:id_44 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "買い物や通院等に利用される高齢者や交通弱者のため、町内を運行する大漁くんバス及びハイヤーの持続的な運行を支援してまいります。"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_62;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "漁業者が減っても、当町の海域は減少しません。"@ja.
<< kg:id_47 prop:cause kg:id_49 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "水産加工業については、従業員の高齢化、加工原料の高騰など課題が深刻化しております。"@ja.
<< kg:id_47 prop:cause kg:id_50 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "水産加工業については、従業員の高齢化、加工原料の高騰など課題が深刻化しております。"@ja.
<< kg:id_47 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_66;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "当町の基幹産業である漁業の安定経営に向け、老朽化した施設の更新や持続可能な魅力ある漁業の確立に向け、取り組んでまいります。"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_68;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "静穏海域が少ない我が町にとりまして、やはり漁港などの静穏域を利用するということも、一つの方法として"@ja.
<< kg:id_52 prop:cause kg:id_54 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "地球温暖化による気候変動がもたらす海況の変化などにより...海の変化への対応には限界があると考えられます。"@ja.
<< kg:id_52 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_71;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "ブルー・カーボンの推進のためにも、ウニの陸上養殖の実現化も必要かなとは思っております。"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_73;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "この１０年経って観光として松前町変わったのはあじさいまつりだけです"@ja.
<< kg:id_56 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_75;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "遊覧観光、そしてまたヤリイカの定置網による体験型観光、そして道の駅の下の前浜の開放、どれをとりましても松前ならではの海の資源を使った魅力あるものと認識しております。"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_77;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "消防法が改正され、令和７年６月までに設置が義務化されているところであります。"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_79;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "想定を大幅に超える申請があり、予算に不足を来す見込みとなりまして、町民の皆さんにエアコンの設置をお待たせすることのないよう、急遽でございますが、予算の補正をお願いしたところでございます。"@ja.
}
