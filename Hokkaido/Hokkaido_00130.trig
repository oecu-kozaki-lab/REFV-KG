PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00130> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "公聴会の開催中止"@ja.
kg:id_1 rdf:type cls:c_16079.
cls:c_16079 rdfs:label "会合中止"@ja.
kg:id_2 rdfs:label "事業の中止"@ja.
kg:id_2 rdf:type cls:c_2176.
cls:c_2176 rdfs:label "事業中止"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "公聴会を開催しない"@ja.
kg:id_3 rdf:type cls:c_16079.
kg:id_2 prop:effect kg:id_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "公聴会については、事業が中止されたことから、開催しないこととしました。"@ja.
<< kg:id_2 prop:effect kg:id_3 >>
    prop:text-txt_contents "公聴会については、事業が中止されたことから、開催しないこととしました。"@ja.
}
