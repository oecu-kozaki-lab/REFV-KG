kg:st_1 rdfs:label "経済産業省 環境省"@ja.
kg:st_1 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_1 prop:content "地域共生上の懸念に適切に対応する必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域との共生を前提に再エネ導入拡大と脱炭素政策を進めるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "関係法令"@ja.
kg:st_2 rdfs:type cls:st_235.
cls:st_235 rdfs:label "法令"@ja.
kg:op_3 prop:content "それぞれの状況に応じて必要な規制の適用や見直しを行う"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "再生可能エネルギー電気の利用の促進に関する特別措置法"@ja.
kg:st_3 rdfs:type cls:st_235.
kg:op_4 prop:content "支援認定要件として事前説明会の実施を厳格に求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "支援認定要件として関係法令の遵守を厳格に求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "支援を受ける認定要件を通じて事業規律を強化する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:st_4 rdfs:label "各自治体"@ja.
kg:st_4 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_7 prop:content "各地域の実情に応じて地域と共生した形での再エネ導入を求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:op_8 prop:content "再エネ導入拡大と脱炭素政策を進める上で地域共生上の懸念に適切に対応すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "太陽光発電事業における地域との共生をより一層確保する必要がある"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_5 rdfs:label "資源エネルギー庁 環境省 関係省庁"@ja.
kg:st_5 rdfs:type cls:st_6.
kg:op_10 prop:content "地域共生確保のため関係省庁が緊密に連携すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "脱炭素政策に必要な対応を連携して検討する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_5.
kg:op_12 prop:content "地域共生と規律強化のため関係省庁連絡会議を設置する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "依然として、FIT/FIP 制度の支援によらない太陽光発電事業も含め、地域共生上の懸念が生じている事例がみられる"@ja.
<< kg:id_3 prop:effect kg:id_1 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "依然として、FIT/FIP 制度の支援によらない太陽光発電事業も含め、地域共生上の懸念が生じている事例がみられる。再エネの導入拡大・脱炭素政策を進める上でも、地域共生上の懸念に対して適切に対応していくことが求められている"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "再エネの導入拡大・脱炭素政策の推進に当たっては、地域との共生が図られることが大前提である"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:text-txt_contents "太陽光発電事業については、既存の法体系の中で、土地造成及び電気設備の安全性確保、生活環境及び自然環境・景観の保全、適正な土地利用の確保など、様々な公益との調整を行う各種関係法令の適用を受けており"@ja.
<< kg:id_3 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "これまでも、関係法令において、それぞれの状況に応じ必要な規制の適用や見直し等が行われている"@ja.
<< kg:id_3 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "再生可能エネルギー電気の利用の促進に関する特別措置法においても、その支援を受けるに当たっての認定要件として、事前説明会の実施や関係法令の遵守を厳格に求めるなど、必要な事業規律強化を行っている"@ja.
<< kg:id_3 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "再生可能エネルギー電気の利用の促進に関する特別措置法においても、その支援を受けるに当たっての認定要件として、事前説明会の実施や関係法令の遵守を厳格に求めるなど、必要な事業規律強化を行っている"@ja.
<< kg:id_3 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "再生可能エネルギー電気の利用の促進に関する特別措置法においても、その支援を受けるに当たっての認定要件として、事前説明会の実施や関係法令の遵守を厳格に求めるなど、必要な事業規律強化を行っている"@ja.
<< kg:id_3 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "適正な再エネ発電事業の実施に対する地域の懸念に対応するため、各自治体においても、各地域の実情に応じ、地域と共生した形での再エネ導入を求める条例の制定が相次いでいる"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "適正な再エネ発電事業の実施に対する地域の懸念に対応するため"@ja.
<< kg:id_3 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "再エネの導入拡大・脱炭素政策を進める上でも、地域共生上の懸念に対して適切に対応していくことが求められている"@ja.
<< kg:id_3 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "このため、太陽光発電事業における地域との共生をより一層確保するべく"@ja.
<< kg:id_3 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "新エネルギー政策を所管する資源エネルギー庁、環境政策を所管する環境省、そして、太陽光発電事業の実施に当たって様々な公益との調整を行う各種の関係法令を所管する関係省庁との間で、緊密な連携を図り"@ja.
<< kg:id_3 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "脱炭素政策に必要な対応を検討するため"@ja.
<< kg:id_3 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "『太陽光発電事業の更なる地域共生・規律強化に向けた関係省庁連絡会議』を設置する"@ja.
}
