kg:st_1 rdfs:label "国立社会保障・人口問題研究所"@ja.
kg:st_1 rdf:type cls:st_68.
cls:st_68 rdfs:label "研究機関"@ja.
kg:op_1 prop:content "令和27年に人口が2千人を切ると推計する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "松前町"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_2 prop:content "人口減少対応には再生可能エネルギー分野への進出が重要と考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "産業の活性化を図り産業の維持や再生に向けた取り組みを進め人口減少に対応したい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "町民の理解を得るため企業に十分な説明責任を果たすよう働きかける"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "町民の理解を得るため企業に十分な説明責任を果たすよう働きかける"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "早期に課題解決を図るよう国や北海道、電力会社に要請していく"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "準備区域である見解を得たため改めて住民説明会を開催したい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "状況を見極めながら開催日を決定し知らせたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "企業のノウハウも活用しながら地域貢献策や非常時マイクログリッド構築などを進めている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "企業のノウハウも活用しながら非常時マイクログリッド構築を進めている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "第一次産業の衰退に加え、雇用の場が少ないことで生産人口（働く世代）が町外へ流出する事態により、過疎化に歯止めがきかない状況です。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "第一次産業の衰退に加え、雇用の場が少ないことで生産人口（働く世代）が町外へ流出する事態により、過疎化に歯止めがきかない状況です。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "第一次産業の衰退に加え、雇用の場が少ないことで生産人口（働く世代）が町外へ流出する事態により、過疎化に歯止めがきかない状況です。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "第一次産業の衰退に加え、雇用の場が少ないことで生産人口（働く世代）が町外へ流出する事態により、過疎化に歯止めがきかない状況です。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "既に高齢者比率（65歳以上）も50％を超え"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "国立社会保障・人口問題研究所が発表した令和27年の人口推計では2千人を切るとされました。"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "人口減少の流れを止めることは大変難しいことですが、一定の減少で止めることや緩やかな減少に変えていくためには、これから発展が期待される再生可能エネルギー分野への進出が重要であると考えています。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "地球温暖化の原因となる「2050年までに温室効果ガスの排出を実質ゼロにする、脱炭素社会の実現を目指す」"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:text-txt_contents "石油などの化石燃料と違い、発電時に二酸化炭素の発生がほとんどないクリーンエネルギーとして世界各国で推進しています。"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:text-txt_contents "東日本大震災を契機にエネルギー自給率の向上のため「再生可能エネルギーの活用」が注目され"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:text-txt_contents "北海道胆振東部地震で、北海道全体が未曽有のブラックアウトを経験したことで、電力の分散化も課題とされ、その解決策の一つが、地域で発電できる再生可能エネルギーであるとされています。"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "また、再生可能エネルギーを資源とした風力発電などの再生可能エネルギー事業を推進し、企業との連携などにより産業の活性化を図り、国の「脱炭素社会の実現」政策とも連動しながら、産業の維持や再生に向けた取り組みを進め、人口減少に対応していきたいと考えています。"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "再生可能エネルギー事業を推進するにあたっては、町民の生活環境への影響を極力少なくするように配慮し、町民の理解を得るために十分な説明責任を果たすように企業へも働きかけていきます。"@ja.
<< kg:id_18 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "再生可能エネルギー事業を推進するにあたっては、町民の生活環境への影響を極力少なくするように配慮し、町民の理解を得るために十分な説明責任を果たすように企業へも働きかけていきます。"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:text-txt_contents "これは、ほかの北海道の区域も同じであり、風車と送電網をつなぐ「系統の確保」の未解決が課題となっています。"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:text-txt_contents "区域も同じであり、系統の確保が見込まれないうちは、次の段階に進むことができません。"@ja.
<< kg:id_21 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "この問題を解決するには、自治体だけではどうすることもできず、国における指定は年に1度しか実施されないため、早期に課題の解決を図るよう国や北海道、電力会社に要請していかなければなりません。"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:text-txt_contents "松前沖は、日本有数の風況に優れた海域で、洋上風力発電の可能性を探るため、本年3月末に国に対し、海域の「情報提供」を実施しました。"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:text-txt_contents "松前沖は、日本有数の風況に優れた海域で、洋上風力発電の可能性を探るため、本年3月末に国に対し、海域の「情報提供」を実施しました。"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "準備区域であるという一定の見解をいただきましたので、改めて住民説明会を開催したいと考えています。"@ja.
<< kg:id_28 prop:effect kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "早ければ年内のうちに実施したいところではありますが、状況を見極めながら、開催日を決定し、皆さまにお知らせしたいと考えています。"@ja.
<< kg:id_28 prop:cause kg:id_31 >>
    prop:text-txt_contents "しかし、新型コロナウイルス感染症の収束がまだ計りきれていないことから"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "松前町は、令和元年12月に東京都に本社を置く東急不動産株式会社と風力発電の円滑な推進と地域振興及び社会基盤整備を協力して推進する協定を締結しており、現在、地域貢献策や非常時マイクログリッド構築（ブラックアウト対策）など町と協力して企業のノウハウも活用しながら進めています。"@ja.
<< kg:id_14 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "現在、地域貢献策や非常時マイクログリッド構築（ブラックアウト対策）など町と協力して企業のノウハウも活用しながら進めています。"@ja.
}
