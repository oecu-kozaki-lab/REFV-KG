kg:st_1 rdfs:label "松前町長石山英雄"@ja.
kg:st_1 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "人口減少に強い危機感を持つ"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "人口2,000人割れを危惧する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "人口減少下でも生活満足度の高いまちを目指すべきとする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域が積極的に供給効率化を判断する必要がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "小さな自治体ほど影響が大きいと懸念する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "風力発電の強みを生かし官民で推進したい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "松前町"@ja.
kg:st_2 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_7 prop:content "生産年齢人口を確保するよう政策誘導する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "減少する人口の割合を減らす方針を示す"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "現状における国勢調査人口の減少等を考えると、その信ぴょう性は高く、とても危惧しております。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "2045年には人口が2,000人を切ると予測されました。"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "人口は減っていくものの、そこに持続可能なまちづくりへの変革と力をためる「スマート・シュリンク（賢く縮む）」の考えを取り入れ"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "地域が積極的に公共事業や公共サービスの供給を効率化する英断も必要で"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "国が進める脱炭素及びエネルギー政策は乗り遅れるほど、そして小さな自治体ほど影響の波紋は大きく、更なる人口減少が進むことが懸念されます。"@ja.
<< kg:id_6 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "その強みを企業連携による官民パートナーシップを構築することで、大胆かつ確実に推し進め"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "これからの社会環境は、人口減少社会、気候変動影響等、これまでの延長線では解決が困難である状況が想定される。"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:text-txt_contents "これからの社会環境は、人口減少社会、気候変動影響等、これまでの延長線では解決が困難である状況が想定される。"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:text-txt_contents "複雑化する環境・経済・社会の課題を踏まえ、ＳＤＧｓでも謳われているように複数の課題の統合的な解決が求められている。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "再生可能エネルギーやIT等の技術革新により、社会全体が新たなライフスタイルや事業スタイルに転換しており"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:text-txt_contents "都市と地方の関係も変わりつつあることから、松前町にとって新たなチャレンジが可能な環境は、チャンスとしても捉えることが出来る。"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:text-txt_contents "2000年からの松前町の国勢調査人口の推移を見ると、11,108人いた人口が、2020年には6,260人と、44％減少している。"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:text-txt_contents "特に、第一次産業は、56％減となっており、その減少幅が最も大きい。"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:text-txt_contents "財政移転は109億円が流入しており、その規模はGRPの約73％に相当することから、地域の稼ぐ力が小さい状態である。"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:text-txt_contents "投資、移入出で174億円が流出（⑩＋⑪）しており、地域の企業の生産拡大に貢献出来ていない。"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:text-txt_contents "地域経済を好循環に向かわせるためには、買い物・観光等流入する消費額を増やすとともに"@ja.
<< kg:id_25 prop:contermeasure kg:id_27 >>
    prop:text-txt_contents "エネルギー代金等の経済流出を防ぎ、地域の稼ぐ力を高めていく必要がある。"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:text-txt_contents "域外へ流出している産業については、その流出額を抑える取組が必要である。"@ja.
<< kg:id_28 prop:cause kg:id_30 >>
    prop:text-txt_contents "域外へ流出している産業については、その流出額を抑える取組が必要である。"@ja.
<< kg:id_28 prop:cause kg:id_31 >>
    prop:text-txt_contents "域外へ流出している産業については、その流出額を抑える取組が必要である。"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:text-txt_contents "域外から所得を獲得している産業は水産業、公務、林業等である。"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:text-txt_contents "域外から所得を獲得している産業は水産業、公務、林業等である。"@ja.
<< kg:id_32 prop:cause kg:id_35 >>
    prop:text-txt_contents "域外から所得を獲得している産業は水産業、公務、林業等である。"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:text-txt_contents "食品、宿泊・飲食サービスに投資することで、域内の他産業への波及効果が高いことを示している。"@ja.
<< kg:id_36 prop:contermeasure kg:id_38 >>
    prop:text-txt_contents "食品、宿泊・飲食サービスに投資することで、域内の他産業への波及効果が高いことを示している。"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:text-txt_contents "現状の数値がそのまま続くと、2045年の人口は,1,992人になると推定されている"@ja.
<< kg:id_39 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "松前町では2055年で合計特殊出生率を2.10へと徐々に上昇させると仮定し、さらに生産年齢人口を確保するよう政策誘導し"@ja.
<< kg:id_39 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "本ビジョンにより、再エネ事業等の重点プロジェクトを推進し、減少する人口の割合を減らし"@ja.
<< kg:id_43 prop:effect kg:id_44 >>
    prop:text-txt_contents "2020年から2045年までの25年間で、835人のギャップを埋める必要があり"@ja.
<< kg:id_43 prop:effect kg:id_45 >>
    prop:text-txt_contents "そのために確保が必要な収入は約35億円となる。"@ja.
<< kg:id_43 prop:effect kg:id_46 >>
    prop:text-txt_contents "これを年単位で割ると、約1億4千万円の収入が必要となる。"@ja.
<< kg:id_47 prop:effect kg:id_48 >>
    prop:text-txt_contents "現状のままが続くと、2045年には、2,000人を切る人口になってしまう。"@ja.
<< kg:id_47 prop:contermeasure kg:id_49 >>
    prop:text-txt_contents "将来目標を実現していくためには、毎年約1億4千万円の稼ぎを生み出していく"@ja.
<< kg:id_47 prop:contermeasure kg:id_50 >>
    prop:text-txt_contents "外に出ているお金を中にとどめ、地域の事業にしていく必要がある。"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:text-txt_contents "第一次産業の就業人口の減少は顕著であり、喫緊の課題である。"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:text-txt_contents "域外からの所得を稼いでいる水産業及び消費の域内流入を起因している宿泊・飲食業について、力を入れていく必要がある。"@ja.
<< kg:id_53 prop:contermeasure kg:id_55 >>
    prop:text-txt_contents "域外からの所得を稼いでいる水産業及び消費の域内流入を起因している宿泊・飲食業について、力を入れていく必要がある。"@ja.
<< kg:id_53 prop:contermeasure kg:id_56 >>
    prop:text-txt_contents "現在の移住者の受け皿となっている畜産業についても強化していく必要がある。"@ja.
<< kg:id_57 prop:contermeasure kg:id_58 >>
    prop:text-txt_contents "公的な力を生かしながら、地域の稼ぐ力を向上させる"@ja.
<< kg:id_57 prop:contermeasure kg:id_59 >>
    prop:text-txt_contents "地域外の流出を抑える必要がある。"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:text-txt_contents "地域外流出のうちのひとつである地域外へのエネルギー代金流出を止める必要がある。"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:text-txt_contents "再生可能エネルギーを地域資源として、新たな産業を誘発していくことが求められる。"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:text-txt_contents "住み続けるためには、年間通じての稼ぎを創出していく必要がある。"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:text-txt_contents "人口が約5,000人以下となると、酒場、銀行、学習塾、一般病院、通所・短期入所介護事業の立地が困難となる可能性が高まり"@ja.
<< kg:id_66 prop:contermeasure kg:id_68 >>
