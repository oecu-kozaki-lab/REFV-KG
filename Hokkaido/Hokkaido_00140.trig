kg:id_11 rdf:type cls:c_16242.
cls:c_16242 rdfs:label "運用管理"@ja.
kg:id_1 prop:contermeasure kg:id_11.
kg:id_12 rdfs:label "適切な災害対策を講じること"@ja.
kg:id_12 rdf:type cls:c_14096.
cls:c_14096 rdfs:label "災害対策"@ja.
kg:id_1 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "近隣住民との協調を保ち周辺環境との調和を図ること"@ja.
kg:id_13 rdf:type cls:c_16243.
