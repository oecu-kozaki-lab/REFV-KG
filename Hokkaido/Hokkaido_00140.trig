cls:c_16245 rdfs:label "感電危険"@ja.
kg:id_14 prop:effect kg:id_15.
kg:id_15 prop:cause kg:id_14.
kg:id_16 rdfs:label "近隣住民に対する説明会等"@ja.
kg:id_16 rdf:type cls:c_87.
