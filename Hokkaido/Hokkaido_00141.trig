 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "太陽光発電施設の建設"@ja.
kg:id_1 rdf:type cls:c_9200.
cls:c_9200 rdfs:label "太陽光発電施設"@ja.
kg:id_2 rdfs:label "貴重な野生動植物の生育・生息地が脅かされる"@ja.
kg:id_2 rdf:type cls:c_16249.
cls:c_16249 rdfs:label "生息地の喪失"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "生物多様性の低下"@ja.
kg:id_3 rdf:type cls:c_16250.
cls:c_16250 rdfs:label "生物多様性の低下"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "湿原域の減少による防災・減災機能の低下"@ja.
kg:id_4 rdf:type cls:c_16251.
cls:c_16251 rdfs:label "防災機能の低下"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "生息地を追われた野生動物の人里への出没"@ja.
kg:id_5 rdf:type cls:c_16252.
cls:c_16252 rdfs:label "野生動物の出没"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "地域住民への被害"@ja.
kg:id_6 rdf:type cls:c_13309.
cls:c_13309 rdfs:label "住民被害"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "地球温暖化"@ja.
kg:id_7 rdf:type cls:c_697.
cls:c_697 rdfs:label "地球温暖化"@ja.
kg:id_8 rdfs:label "地域と共生する再生可能エネルギー事業を積極的に進める"@ja.
kg:id_8 rdf:type cls:c_15316.
cls:c_15316 rdfs:label "再生可能エネルギー事業"@ja.
kg:id_7 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "省エネルギー・省資源化に取り組む"@ja.
kg:id_9 rdf:type cls:c_8753.
cls:c_8753 rdfs:label "省エネルギー"@ja.
kg:id_7 prop:contermeasure kg:id_9.
kg:id_10 rdfs:label "次世代技術を導入し地域と共生する再生可能エネルギー事業を積極的に進める"@ja.
kg:id_10 rdf:type cls:c_15316.
kg:id_7 prop:contermeasure kg:id_10.
kg:id_11 rdfs:label "太陽光発電施設の設置"@ja.
kg:id_11 rdf:type cls:c_9200.
kg:id_12 rdfs:label "自然環境と調和がなされない設置を望まない意思を宣言で示す"@ja.
kg:id_12 rdf:type cls:c_16253.
cls:c_16253 rdfs:label "設置抑制"@ja.
kg:id_11 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "自然環境と調和が成されない設置を望まないことをここに宣言する"@ja.
kg:id_13 rdf:type cls:c_16253.
kg:id_11 prop:contermeasure kg:id_13.
kg:st_1 rdfs:label "釧路市"@ja.
kg:st_1 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "自然環境と調和しない設置を望まない"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "自然環境への悪影響を懸念している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地域住民の安全への悪影響を懸念している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域住民の安全・安心に対する懸念が高まっている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "市民生活の安全・安心を守る必要がある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "未来を守るため再生可能エネルギー事業を進めるべきだ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "温室効果ガス排出量実質ゼロを目指し取り組む"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "次世代技術を導入しながら再生可能エネルギー事業を進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "豊かな自然環境を守るため設置を望まないことを明示した"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "貴重な財産であり誇りでもある自然環境を守るべきだ"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "近年、釧路市が誇る雄大で豊かな自然環境での太陽光発電施設の建設が進行しており、貴重な野生動植物の生育・生息地が脅かされる事態が懸念されています。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "このような状況は、生態系の崩壊に伴う生物多様性の低下を引き起こし、湿原域の減少が防災・減災機能の低下を招く恐れがあります。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "このような状況は、生態系の崩壊に伴う生物多様性の低下を引き起こし、湿原域の減少が防災・減災機能の低下を招く恐れがあります。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "また、生息地を追われた野生動物が人里に出没し、被害をもたらす可能性もあり、地域住民の安全・安心に対する懸念が高まっています。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、生息地を追われた野生動物が人里に出没し、被害をもたらす可能性もあり、地域住民の安全・安心に対する懸念が高まっています。"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "一方で、地球温暖化の防止は私たちの未来を守る喫緊の課題であることから、地域と共生する再生可能エネルギー事業を積極的に進めていくことと合わせて"@ja.
<< kg:id_7 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "「釧路市ゼロカーボンシティ宣言」に掲げる2050年の温室効果ガス排出量実質ゼロを目指し、徹底した省エネルギー・省資源化に取り組むとともに"@ja.
<< kg:id_7 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "次世代技術も導入しながら、本市の実情に応じ、地域と共生する再生可能エネルギー事業を積極的に進めていくことを合わせて宣言します。"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "自然環境と調和がなされない太陽光発電施設の設置を望まないという本市の意思を、この宣言で示しました。"@ja.
<< kg:id_11 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "釧路市は、貴重な財産であり誇りでもある雄大で豊かな自然環境を守っていくために、自然環境と調和が成されない太陽光発電施設の設置を望まないことをここに宣言します。"@ja.
}
