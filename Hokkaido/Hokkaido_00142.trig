 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "太陽光発電施設の建設"@ja.
kg:id_1 rdf:type cls:c_310.
cls:c_310 rdfs:label "施設建設"@ja.
kg:id_2 rdfs:label "貴重な野生動植物の生育・生息地が脅かされる事態"@ja.
kg:id_2 rdf:type cls:c_16254.
cls:c_16254 rdfs:label "生息地脅威"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "貴重な野生動植物の生育・生息地が脅かされる"@ja.
kg:id_3 rdf:type cls:c_16254.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "生態系の崩壊"@ja.
kg:id_4 rdf:type cls:c_16255.
cls:c_16255 rdfs:label "生態系崩壊"@ja.
kg:id_5 rdfs:label "生物多様性の低下"@ja.
kg:id_5 rdf:type cls:c_16256.
cls:c_16256 rdfs:label "生物多様性低下"@ja.
kg:id_4 prop:effect kg:id_5.
kg:id_6 rdfs:label "湿原域の減少"@ja.
kg:id_6 rdf:type cls:c_16257.
cls:c_16257 rdfs:label "湿原減少"@ja.
kg:id_7 rdfs:label "防災・減災機能の低下"@ja.
kg:id_7 rdf:type cls:c_12934.
cls:c_12934 rdfs:label "防災機能低下"@ja.
kg:id_6 prop:effect kg:id_7.
kg:id_8 rdfs:label "住みかを追われた野生動物"@ja.
kg:id_8 rdf:type cls:c_16258.
cls:c_16258 rdfs:label "野生動物"@ja.
kg:id_9 rdfs:label "人里に出没し被害をもたらす可能性"@ja.
kg:id_9 rdf:type cls:c_13309.
cls:c_13309 rdfs:label "住民被害"@ja.
kg:id_8 prop:effect kg:id_9.
kg:id_10 rdfs:label "地域住民の安全・安心に対する懸念の高まり"@ja.
kg:id_10 rdf:type cls:c_16259.
cls:c_16259 rdfs:label "安全懸念"@ja.
kg:id_1 prop:effect kg:id_10.
kg:id_11 rdfs:label "太陽光発電施設の設置等"@ja.
kg:id_11 rdf:type cls:c_303.
cls:c_303 rdfs:label "施設設置"@ja.
kg:id_12 rdfs:label "一定の要件に該当する設置等に関し必要な事項を定める"@ja.
kg:id_12 rdf:type cls:c_16260.
cls:c_16260 rdfs:label "事項規定"@ja.
kg:id_11 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "釧路市自然と太陽光発電施設の調和に関する条例を制定する"@ja.
kg:id_13 rdf:type cls:c_1684.
cls:c_1684 rdfs:label "条例制定"@ja.
kg:id_11 prop:countermeasure kg:id_13.
kg:st_1 rdfs:label "釧路市"@ja.
kg:st_1 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "自然環境と生活環境の調和が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "太陽光発電事業の適切な推進と自然環境及び生活環境との調和を図る"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "雄大で豊かな自然環境を守るため条例制定を進める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "近年、この雄大で豊かな自然環境での太陽光発電施設の建設が進行しており、貴重な野生動植物の生育・生息地が脅かされる事態が懸念されています。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "近年、この雄大で豊かな自然環境での太陽光発電施設の建設が進行しており、貴重な野生動植物の生育・生息地が脅かされる事態が懸念されています。"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "このような状況は、生態系の崩壊に伴う生物多様性の低下を引き起こすとともに、湿原域の減少が防災・減災機能の低下を招くおそれがあります。"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:text-txt_contents "このような状況は、生態系の崩壊に伴う生物多様性の低下を引き起こすとともに、湿原域の減少が防災・減災機能の低下を招くおそれがあります。"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:text-txt_contents "また、住みかを追われた野生動物が人里に出没し、被害をもたらす可能性もあり、地域住民の安全・安心に対する懸念が高まっています。"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:text-txt_contents "また、住みかを追われた野生動物が人里に出没し、被害をもたらす可能性もあり、地域住民の安全・安心に対する懸念が高まっています。"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "このことから釧路市では、一定の要件に該当する太陽光発電施設の設置等に関し必要な事項を定めることにより、太陽光発電事業の適切な推進と自然環境及び生活環境との調和を図り、本市の貴重な財産であり誇りでもある雄大で豊かな自然環境を守っていくことを目的として「釧路市自然と太陽光発電施設の調和に関する条例」を制定することとし、その検討を進めています。"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "このことから釧路市では、一定の要件に該当する太陽光発電施設の設置等に関し必要な事項を定めることにより、太陽光発電事業の適切な推進と自然環境及び生活環境との調和を図り、本市の貴重な財産であり誇りでもある雄大で豊かな自然環境を守っていくことを目的として「釧路市自然と太陽光発電施設の調和に関する条例」を制定することとし、その検討を進めています。"@ja.
}
