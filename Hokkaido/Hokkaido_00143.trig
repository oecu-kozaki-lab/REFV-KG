PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00143> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路市自然と太陽光発電施設の調和に関する条例（案）"@ja.
kg:id_1 rdf:type cls:c_16087.
cls:c_16087 rdfs:label "条例案"@ja.
kg:id_2 rdfs:label "市民からの意見募集"@ja.
kg:id_2 rdf:type cls:c_2464.
cls:c_2464 rdfs:label "意見募集"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "案の修正"@ja.
kg:id_3 rdf:type cls:c_16261.
cls:c_16261 rdfs:label "案の修正"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "既記載として案に盛り込み済みの整理"@ja.
kg:id_4 rdf:type cls:c_16262.
cls:c_16262 rdfs:label "内容整理"@ja.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "今後の参考としての扱い"@ja.
kg:id_5 rdf:type cls:c_16263.
cls:c_16263 rdfs:label "参考扱い"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "意見として受理"@ja.
kg:id_6 rdf:type cls:c_16264.
cls:c_16264 rdfs:label "意見受理"@ja.
kg:id_1 prop:contermeasure kg:id_6.
kg:st_1 rdfs:label "市民の皆様"@ja.
kg:st_1 rdfs:type cls:st_42.
cls:st_42 rdfs:label "市民"@ja.
kg:op_1 prop:content "条例案に対して意見を提出した"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市"@ja.
kg:st_2 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_2 prop:content "一部意見を受けて案を修正した"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "一部意見は既に案に盛り込んでいると整理した"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "多くの意見を今後の参考とした"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "一部意見は意見として伺った"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "釧路市自然と太陽光発電施設の調和に関する条例（案）に対して、市民の皆様からご意見を募集しました"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "修正（案を修正するもの）：1件"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "既記載（既に案に盛り込んでいるもの）：10件"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "参考（今後の参考とするもの）：303件"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "その他（意見として伺ったもの）：84件"@ja.
}
