kg:st_1 rdfs:label "釧路湿原自然再生協議会"@ja.
kg:st_1 rdfs:type cls:st_148.
cls:st_148 rdfs:label "自然保護団体"@ja.
kg:op_1 prop:content "希少種や生態系や景観や防災への影響を懸念"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "事業計画時に希少種の生息地への配慮を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "湿原辺縁部での建設進行により営巣適地の減少を懸念"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路湿原自然再生協議会生態系評価ワーキンググループ"@ja.
kg:st_2 rdfs:type cls:st_148.
kg:op_4 prop:content "高適応度区域での計画時は事前確認を必須とする"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "生息地に該当する場合は計画中止を含む抜本見直しが必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "計画地の営巣生息地該当性を事前照会するよう求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "環境省レッドリスト2020補遺資料"@ja.
kg:st_3 rdfs:type cls:st_237.
cls:st_237 rdfs:label "公的資料"@ja.
kg:op_7 prop:content "開発行為による生息地の埋め立てや改変が要因"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "太陽光発電施設の建設が要因"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "計画地の生息域該当性を事前照会するよう求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "生息地に該当する場合は計画中止を含む抜本見直しが必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "建設地が生息域と直接重なるため繁殖影響が大きいと考える"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "事業計画時に生息環境保全へ十分配慮すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "掲載種以外の希少種にも配慮を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_4 rdfs:label "NPO法人トラストサルン釧路"@ja.
kg:st_4 rdfs:type cls:st_238.
cls:st_238 rdfs:label "保護団体"@ja.
kg:op_14 prop:content "生息地の買い取りや寄贈による保全に取り組む"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "近年、釧路湿原周辺における太陽光発電施設の建設が、希少な動植物や生態系、景観、防災などに及ぼす影響が懸念されています。"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "太陽光発電事業を計画するにあたっては、各種情報を確認の上、希少種の生息地等に配慮してください。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "近年、湿原辺縁部で太陽光発電施設の建設が進み、営巣適地の減少が懸念されています。"@ja.
<< kg:id_3 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "適応度の高い黄色(0.4-0.6)、オレンジ(0.6-0.8)、赤(0.8-1.0)のメッシュ区域内において太陽光発電事業を計画・予定されている方は、必ず事前にタンチョウの生息情報や必要となる手続きについて関係機関にご確認ください。"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "生息地等に該当する場合は、計画の中止を含めた抜本的な見直しを求められる場合があります。"@ja.
<< kg:id_3 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "太陽光発電事業の計画地がタンチョウの営巣・生息地かどうかは、過去の調査記録をもとに情報提供が可能な場合もございますので、下記までお問い合わせください。"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "その背景としては釧路湿原における開発行為によって生息地の埋め立てや改変が相次いだこと、太陽光発電施設の建設が要因として挙げられることが「環境省レッドリスト2020補遺資料」に明記されています。"@ja.
<< kg:id_10 prop:cause kg:id_1 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "その背景としては釧路湿原における開発行為によって生息地の埋め立てや改変が相次いだこと、太陽光発電施設の建設が要因として挙げられることが「環境省レッドリスト2020補遺資料」に明記されています。"@ja.
<< kg:id_3 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "太陽光発電施設事業の計画地がキタサンショウウオの生息域かどうかは、過去の調査記録をもとに情報提供が可能な場合もございますので、下記までお問い合わせください。"@ja.
<< kg:id_7 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "なお、キタサンショウウオの生息地等に該当する場合は、計画の中止を含めた抜本的な見直しを求められる場合があります。"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "現在進んでいる太陽光発電施設の建設地は本種の生息域と直接重なっているため、繁殖への影響が大きいと考えられます。"@ja.
<< kg:id_3 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "太陽光発電事業を計画する際には、生息環境の保全に十分に配慮してください。"@ja.
<< kg:id_3 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "たとえばオジロワシやチュウヒ、シマクイナをはじめとするクイナ類などにとって、湿原や草原は非常に重要な生息環境です。太陽光発電事業を計画する際には、そうした動植物に対しても十分に配慮してください。"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "釧路湿原の希少種保護のため、生息地の買い取りや寄贈を受けて保全に取り組んでいるNGOがあります。"@ja.
}
