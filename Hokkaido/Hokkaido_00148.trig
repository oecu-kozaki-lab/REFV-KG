PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00148> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "寄付受領証明書の発送遅れ"@ja.
kg:id_1 rdf:type cls:c_16306.
cls:c_16306 rdfs:label "発送遅延"@ja.
kg:id_2 rdfs:label "事務作業に想定以上の時間を要していること"@ja.
kg:id_2 rdf:type cls:c_16307.
cls:c_16307 rdfs:label "事務作業の長期化"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "当初予定していた発送時期よりも遅れが生じている"@ja.
kg:id_3 rdf:type cls:c_16308.
cls:c_16308 rdfs:label "発送時期の遅延"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "ご寄付いただいた皆様への証明書到着が遅くなる"@ja.
kg:id_4 rdf:type cls:c_16309.
cls:c_16309 rdfs:label "証明書到着の遅延"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "令和7年11月中を目途に順次発送する"@ja.
kg:id_5 rdf:type cls:c_16310.
cls:c_16310 rdfs:label "順次発送"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "寄付受領証明書が不要な場合"@ja.
kg:id_6 rdf:type cls:c_16311.
cls:c_16311 rdfs:label "証明書不要"@ja.
kg:id_7 rdfs:label "下記連絡先まで連絡する"@ja.
kg:id_7 rdf:type cls:c_16312.
cls:c_16312 rdfs:label "連絡"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "音羽橋周辺の貴重な自然と景観の保全"@ja.
kg:id_8 rdf:type cls:c_16313.
cls:c_16313 rdfs:label "自然景観の保全"@ja.
kg:id_9 rdfs:label "皆様からの寄付を基に今後も全力で取り組む"@ja.
kg:id_9 rdf:type cls:c_9605.
cls:c_9605 rdfs:label "保全活動"@ja.
kg:id_8 prop:countermeasure kg:id_9.
kg:st_1 rdfs:label "鶴居村役場企画財政課むらづくり推進係"@ja.
kg:st_1 rdf:type cls:st_211.
cls:st_211 rdfs:label "行政組織"@ja.
kg:op_1 prop:content "発送遅延について理解と容赦を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "速やかに届けるべきところ時間を要し謝罪している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "確定申告などで不要なら連絡してほしい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "鶴居村"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_4 prop:content "大切な寄付を基に自然と景観を守るため全力で取り組む"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "しかしながら、事務作業に想定以上の時間を要しており、当初予定しておりました発送時期よりも遅れが生じております。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "しかしながら、事務作業に想定以上の時間を要しており、当初予定しておりました発送時期よりも遅れが生じております。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "ご寄付いただいた皆様には、速やかにお届けすべきところ、お時間を頂戴し大変申し訳ございません。"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:text-txt_contents "【変更後】令和7年11月中を目途に順次発送"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "確定申告などで寄附証明書がご不要とされる場合は、お手数をおかけいたしますが、その旨を改めて下記連絡先までご連絡ください。"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "鶴居村は、皆様からお預かりした大切なご寄付を基に、音羽橋周辺の貴重な自然と景観を守るため、今後も全力で取り組んでまいります。"@ja.
}
