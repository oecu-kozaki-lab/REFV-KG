kg:st_3 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_42 prop:content "周辺関係者の理解を得るよう努めるべきだ"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "安全で良好な状態の維持管理を義務付ける"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "廃止前の届出を義務付ける"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "施設廃止後は自然環境や景観の回復を求める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "条例施行に必要な限度で調査を実施する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "正当な理由なく勧告に従わない場合は公表する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:st_4 rdfs:label "釧路自然再生協議会"@ja.
kg:st_4 rdf:type cls:st_145.
cls:st_145 rdfs:label "協議会"@ja.
kg:op_48 prop:content "事業計画策定時に希少種の生息地への配慮を求める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "村では地域と共生して調和のとれた太陽光発電事業を促進するために鶴居村美しい景観等と太陽光発電事業との共生に関する条例を制定しました。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "太陽光発電施設が及ぼす景観、自然環境及び生活環境等を考慮し"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "太陽光発電施設が及ぼす景観、自然環境及び生活環境等を考慮し"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "住民の生活環境等についての適正な配慮に関する基本的な事項を定め"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "その他太陽光発電事業により、周辺地域に著しい影響を及ぼすおそれがある区域"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "土砂災害その他自然災害が発生するおそれがある区域"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "村長は、次に掲げる区域のうち必要があると認めるものを、太陽光発電事業を抑制する区域として指定し、事業者に対し事業区域に含まないよう求めることができます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "急傾斜地崩壊危険区域"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "地すべり防止区域"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "土砂災害警戒区域"@ja.
<< kg:id_1 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "土砂災害特別警戒区域"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "河川区域"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "河川保全区域"@ja.
<< kg:id_1 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "砂防指定地"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "農業振興地域内の農用地区域"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "保安林"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "国立公園（特別地域及び普通地域）"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "国指定史跡名勝天然記念物所在地"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "鳥獣保護区"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "重点道路沿道区域"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "村長は、太陽光発電施設と地域が共生を図るため、次のとおり施設基準を定めます。（1）太陽光発電施設と事業区域の周辺地域の景観との調和及び事業区域内の環境の保全に関すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "（2）太陽光発電施設の設置に係る防災上の措置に関すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "（3）太陽光発電施設の安全性の確保に関すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "（4）太陽光発電施設の廃止後において行う措置に関すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "切土等により崖（勾配が30度を超える土地をいう。）が生ずる場合は、当該崖の表面が擁壁で覆われていること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "ア 安定計算により、その安定性が確かめられたものであること。イ 当該擁壁の裏面の排水を良くするための水抜穴及び透水層が設けられたものであること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "当該法面の構造が、小段又は排水施設の設置その他の措置が適切に行われているものであること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "事業区域内の法面が雨水、風化等により浸食されないよう植生工等による法面保護が行われていること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "事業区域内の排水施設は、堅固で耐久性を有するとともに、維持管理の容易な構造であること。また、必要がある場合には、土砂の流出を防止するための沈砂池が適切に設置されたものであること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "主要な道路、市街地等から容易に望見できる斜面地においては、太陽光発電施設は、勾配がおおむね30度以下の箇所に設置されていること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "ため池等の水面に設置する太陽光発電施設にあっては、太陽光電池モジュールの水平投影面積の当該水面の面積に対する割合が、おおむね50パーセント以下であること。"@ja.
<< kg:id_1 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "太陽電池モジュールは、その反射光が周辺の環境に重大な影響を及ぼすことがないよう"@ja.
<< kg:id_1 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "ア 低反射性のものであること。イ 位置、傾斜角度等について、十分に配慮して設置されるものであること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "太陽光発電施設に係る太陽電池モジュール、パワーコンディショナー、分電盤及びフェンス等各種付属設備は、周囲の景観に調和した色彩とすること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "太陽電池モジュールを支持する架台等は、経年変化により景観上の支障が生じない材料が使用されたものであること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "太陽電池モジュールを支持する架台の基礎は、上部構造が構造上支障のある沈下、浮き上がり、転倒又は横移動を生じないよう、地盤に定着されたものであること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "太陽電池モジュールは、荷重又は体力によって、脱落又は浮き上がりが生じないよう、構造耐力上安全である架台に取り付けられたものであること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "特に腐食、腐朽又は摩耗のおそれのあるものは、腐食、腐朽若しくは摩損しにくい材料又は有効なさび止め、防腐若しくは摩損防止のための措置をした材料が使用されたものであること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "設置工事に着手しようとする60日前までに村に届け出ることを義務付けます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "この届出に対し、村長は必要な指導、助言及び勧告をすることができます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "事業に先立ち周辺関係者等に対し、あらかじめ事業計画に関する説明等を義務付けます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "事業者は、事業の内容について周辺関係者等の理解が得られるよう努めなければなりません。"@ja.
<< kg:id_1 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "事業区域内を常時安全かつ良好な状態となるよう維持管理することを義務付けます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "太陽光発電施設を廃止しようとするときは、廃止しようとする日の30日前までに村に届け出ることを義務付けます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "施設廃止の届出がされた場合、村長は、自然環境、景観等の回復に努めるよう求めることができます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "この条例の施行に関し必要な限度において、調査等を実施することがあります。"@ja.
<< kg:id_1 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "勧告を受けた事業者が、正当な理由なく勧告に従わない場合、村長はその内容を公表します。"@ja.
<< kg:id_1 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "釧路自然再生協議会では、太陽光発電事業計画策定にあたって配慮すべき希少種の生息地マップを公開しております。村内で太陽光発電事業を計画される方は、同マップを参考にしていただければと思います。"@ja.
}
