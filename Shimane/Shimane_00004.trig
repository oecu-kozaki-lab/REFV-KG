kg:st_1 rdfs:label "ジャパン・リニューアブル・エナジー株式会社"@ja.
kg:st_1 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "事業に起因する災害と判明した場合は被害を補償する考え"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "新設道路の活用で管理が行き届かなかった山林が施業しやすくなったと聞いている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "林業の活性化は新規雇用の創出につながると考える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "林業の活性化は人材育成につながると考える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "発電所の運営により多くの雇用が創出されている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地元業者への発注は地域の雇用機会創出につながる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地元業者への発注は経済振興につながる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "風力発電所の設置は地元業者の新たな業務創出という経済効果がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "破綻時でも金融機関が代替して事業を遂行できるようにすることを目的とする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "条項は事業の継続性を担保・補強するもの"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "賠償責任保険(工事に起因して発生した対人・対物事故にかかる弊社の法律上の賠償責任を補償するもの)"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "弊社および第三者の調査の結果、事業に起因する災害であると判明した場合には、生じた被害に対し補償をさせていただく考えです"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "工事期間中においては、工事保険(人災、火災、水災、落雷、盗難等の不測かつ突発的な事故により、工事の目的物や仮設物等に生じた損害を補償するもの)"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "工事期間中においては、工事保険(人災、火災、水災、落雷、盗難等の不測かつ突発的な事故により、工事の目的物や仮設物等に生じた損害を補償するもの)、および賠償責任保険(工事に起因して発生した対人・対物事故にかかる弊社の法律上の賠償責任を補償するもの)に加入しております。運転期間中においては、火災保険、賠償責任保険等に加入しております"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:text-txt_contents "運転期間中においては、火災保険、賠償責任保険等に加入しております"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:text-txt_contents "発電所の周辺において事業所を設置し、子会社である JRE オペレーションズ株式会社の職員等が常時勤務し"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "日常的な遠隔監視を実施して発電所の運転状況を常時把握しており、異常発生時にも即時対応できる体制を構築しております"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "異常発生時にも即時対応できる体制を構築しております"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "点検に関しては、月次点検と年次点検を電気事業法第 42 条に定められた保安規程に基づき実施しております"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "点検に関しては、月次点検と年次点検を電気事業法第 42 条に定められた保安規程に基づき実施しております"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:text-txt_contents "風車の点検に関しては頻度や方法が経産省の指針で定められているため、それに則り風車メーカーと共同して実施しております"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:text-txt_contents "また、強風や地震などが発生した場合には臨時点検も実施しております"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "風力事業で新設する道路を道として地元の森林組合に活用してもらうことで、これまで管理が行き届いていなかった山林が施業しやすくなったとお聞きしております"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "林業の活性化が新規雇用の創出や人材育成に繋がるものと考えております"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "林業の活性化が新規雇用の創出や人材育成に繋がるものと考えております"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "発電所の運営により多くの雇用が創出されております"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "維持管理業務等を地元業者に発注することにより、地域の雇用機会創出と経済振興にもつながっております"@ja.
<< kg:id_24 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "維持管理業務等を地元業者に発注することにより、地域の雇用機会創出と経済振興にもつながっております"@ja.
