PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00005> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "当日配布する資料の手配不能"@ja.
kg:id_1 rdf:type cls:c_14117.
cls:c_14117 rdfs:label "資料手配不能"@ja.
kg:id_2 rdfs:label "ヤマト運輸の配送の遅れ"@ja.
kg:id_2 rdf:type cls:c_14118.
cls:c_14118 rdfs:label "配送遅延"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "アンケート配布遅延"@ja.
kg:id_3 rdf:type cls:c_14119.
cls:c_14119 rdfs:label "配布遅延"@ja.
kg:id_4 rdfs:label "急ぎ資料を作ったため印刷に時間がかかったこと"@ja.
kg:id_4 rdf:type cls:c_14120.
cls:c_14120 rdfs:label "印刷遅延"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "風力発電事業"@ja.
kg:id_5 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_6 rdfs:label "事故のないように万全の態勢で臨む必要がある"@ja.
kg:id_6 rdf:type cls:c_1225.
cls:c_1225 rdfs:label "安全確保"@ja.
kg:id_5 prop:effect kg:id_6.
kg:id_7 rdfs:label "配布資料の準備不備"@ja.
kg:id_7 rdf:type cls:c_14121.
cls:c_14121 rdfs:label "準備不備"@ja.
kg:id_8 rdfs:label "事業への危うさを感じさせる"@ja.
kg:id_8 rdf:type cls:c_14122.
cls:c_14122 rdfs:label "事業不安"@ja.
kg:id_7 prop:effect kg:id_8.
kg:id_9 rdfs:label "説明会"@ja.
kg:id_9 rdf:type cls:c_3027.
cls:c_3027 rdfs:label "説明会"@ja.
kg:id_10 rdfs:label "怒号が飛び交うシーンがあった"@ja.
kg:id_10 rdf:type cls:c_14123.
cls:c_14123 rdfs:label "対立状態"@ja.
kg:id_9 prop:effect kg:id_10.
kg:id_11 rdfs:label "質問が多すぎて時間を30分延長して終了した"@ja.
kg:id_11 rdf:type cls:c_6176.
cls:c_6176 rdfs:label "時間延長"@ja.
kg:id_9 prop:effect kg:id_11.
kg:id_12 rdfs:label "事業者担当者"@ja.
kg:id_12 rdf:type cls:c_2246.
cls:c_2246 rdfs:label "事業者"@ja.
kg:id_13 rdfs:label "多くの質問や怒号のような意見を受けた"@ja.
kg:id_13 rdf:type cls:c_14124.
cls:c_14124 rdfs:label "意見集中"@ja.
kg:id_12 prop:effect kg:id_13.
kg:id_14 rdfs:label "会場で出た多くの意見"@ja.
kg:id_14 rdf:type cls:c_12717.
cls:c_12717 rdfs:label "意見表明"@ja.
kg:id_15 rdfs:label "計画の進捗には一切影響を与えなかった"@ja.
kg:id_15 rdf:type cls:c_13350.
cls:c_13350 rdfs:label "計画進行"@ja.
kg:id_14 prop:effect kg:id_15.
kg:id_16 rdfs:label "風力発電計画"@ja.
kg:id_16 rdf:type cls:c_390.
cls:c_390 rdfs:label "発電計画"@ja.
kg:id_17 rdfs:label "フェアに情報提供を続けメリットとデメリットを十分に知ってもらった上で判断してもらう"@ja.
kg:id_17 rdf:type cls:c_176.
cls:c_176 rdfs:label "情報提供"@ja.
kg:id_16 prop:contermeasure kg:id_17.
kg:id_18 rdfs:label "方法書段階へ進ませないために情報の拡散と意見の収集につとめる"@ja.
kg:id_18 rdf:type cls:c_13157.
cls:c_13157 rdfs:label "反対運動"@ja.
kg:id_16 prop:contermeasure kg:id_18.
kg:st_1 rdfs:label "安来市・雲南市、日向山・大出日山の風力発電を考える会の木村"@ja.
kg:st_1 rdfs:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "配布資料の準備もできず事業遂行に危うさを感じる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "午前の部参加者にアンケートを配布できなかった"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "事業者（JRE）"@ja.
kg:st_2 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_3 prop:content "事故のないよう万全の態勢で臨むので問題ない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "資料準備すらできず事業の安全性に不安がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "厳しい場面もあったが報道に感謝している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "参加者が聞いてほしい点を十分に質問してくれてありがたかった"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "厳しい意見にも耐えた担当者はタフだった"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "多くの意見が出ても計画は進むと感じている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_3 rdfs:label "事業者担当者と安来市・雲南市、日向山・大出日山の風力発電を考える会の木村"@ja.
kg:st_3 rdfs:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_9 prop:content "推進側と反対側の立場で情報提供を続け判断材料を示すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "計画を次段階へ進ませないため情報拡散と意見収集を続けたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業者さんもヤマト運輸の配送の遅れで当日配布する資料の手配ができなかった"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "急ぎ資料を作ったため、印刷に時間がかかり、10時開始の午前の部・参加者にはアンケートの配布が間に合いませんでした"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "事業内容については事故のないように万全の態勢で臨むので問題ないです、と仰っていました"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "配布資料の準備ですら、ままならなかったのに、大丈夫なのかと危うさを感じてしまいます"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "怒号が飛び交うシーンもありましたが、ちゃんと伝えてくれて感謝です"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "質問が多すぎて時間を30分も延長し終了となりました"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "最後に多くの質問に耐えられた事業者担当者さんたちに挨拶しに行きました。あれほどの怒号のような意見を受けたら心が折れそうなものですが、敵ながらあっぱれというかタフでしたね"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "会場では多くの意見が出たものの、計画の進捗には一切影響を与えることはなかったなと感じています"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これからもフェアに皆さんへ情報提供を続け、メリットとデメリットを十分に知ってもらった上で判断してもらえるように推進側と反対側という立場でお互い頑張って参りましょう"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "方法書段階へ進ませないためにも、引き続き情報の拡散と意見の収集につとめて参りたいと思います"@ja.
}
