PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00006> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "大規模な風力発電"@ja.
kg:id_1 rdf:type cls:c_999.
cls:c_999 rdfs:label "風力発電"@ja.
kg:id_2 rdfs:label "地域にもたらす影響"@ja.
kg:id_2 rdf:type cls:c_2704.
cls:c_2704 rdfs:label "地域影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "風力発電"@ja.
kg:id_3 rdf:type cls:c_999.
kg:id_4 rdfs:label "問題"@ja.
kg:id_4 rdf:type cls:c_14125.
cls:c_14125 rdfs:label "問題"@ja.
kg:id_3 prop:effect kg:id_4.
kg:st_1 rdfs:label "武田恵世先生"@ja.
kg:st_1 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_1 prop:content "大規模な風力発電が地域にもたらす影響について話す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "勉強会主催者"@ja.
kg:st_2 rdf:type cls:st_171.
cls:st_171 rdfs:label "主催者"@ja.
kg:op_2 prop:content "長年取り組まれてきた問題として理解を深めたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "大規模な風力発電がどのような影響を地域にもたらすのか、先生のお話を聞きながら、皆さんと一緒に風力発電の理解を深めたいと思います。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "長年この風力発電の問題に取り組まれてきた第一人者である武田恵世先生をお招きし"@ja.
}
