PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00008> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "大日出山の風力発電計画"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "意見書の提出"@ja.
kg:id_2 rdf:type cls:c_92.
cls:c_92 rdfs:label "意見提出"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "縦覧場所に備え付けの意見書箱に投函"@ja.
kg:id_3 rdf:type cls:c_92.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "下記の宛先に郵送"@ja.
kg:id_4 rdf:type cls:c_92.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "フォームから投稿して当会で取り纏めて提出"@ja.
kg:id_5 rdf:type cls:c_92.
kg:id_1 prop:contermeasure kg:id_5.
kg:st_1 rdfs:label "当会"@ja.
kg:st_1 rdfs:type cls:st_70.
cls:st_70 rdfs:label "団体"@ja.
kg:op_1 prop:content "意見書を取り纏めて提出する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:text-txt_contents "意見書の提出について"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:text-txt_contents "(1)縦覧場所に備え付けの意見書箱に投函"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:text-txt_contents "(2)下記の宛先に郵送"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "(3) 意見書について以下のフォームからご投稿いただければ当会でも取り纏めて提出いたします。"@ja.
}
