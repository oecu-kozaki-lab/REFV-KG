PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00009> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "安来市の希少な自然環境"@ja.
kg:id_1 rdf:type cls:c_211.
cls:c_211 rdfs:label "自然環境"@ja.
kg:id_2 rdfs:label "環境保護団体「やすぎ生物多様性保存会」の立ち上げ"@ja.
kg:id_2 rdf:type cls:c_14136.
cls:c_14136 rdfs:label "環境保護団体"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "安来市における動植物"@ja.
kg:id_3 rdf:type cls:c_461.
cls:c_461 rdfs:label "動植物"@ja.
kg:id_4 rdfs:label "環境保全、生態調査、研究"@ja.
kg:id_4 rdf:type cls:c_14137.
cls:c_14137 rdfs:label "環境保全活動"@ja.
kg:id_3 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "安来市南部に広がる自然豊かなエリア"@ja.
kg:id_5 rdf:type cls:c_211.
kg:id_6 rdfs:label "環境保護団体と連携した保全"@ja.
kg:id_6 rdf:type cls:c_9605.
cls:c_9605 rdfs:label "保全活動"@ja.
kg:id_5 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "その水源地から流れ込む豊かな漁場・中海"@ja.
kg:id_7 rdf:type cls:c_14138.
cls:c_14138 rdfs:label "漁場"@ja.
kg:id_7 prop:contermeasure kg:id_6.
kg:st_1 rdfs:label "やすぎ生物多様性保存会"@ja.
kg:st_1 rdfs:type cls:st_173.
cls:st_173 rdfs:label "環境保護団体"@ja.
kg:op_1 prop:content "動植物の環境保全、生態調査、研究を主な活動とする"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:text-txt_contents "安来市の希少な自然環境の保全に貢献する環境保護団体「やすぎ生物多様性保存会」さんが立ち上がりました。"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "「安来市における動植物の環境保全、生態調査、研究などを主な活動とします。」"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "今後、こちらの環境保護団体さんと連携して安来市南部に広がる自然豊かなエリアの保全とその水源地から流れ込む豊かな漁場・中海の保全に一緒に協力してまいりたいと思います。"@ja.
<< kg:id_7 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "今後、こちらの環境保護団体さんと連携して安来市南部に広がる自然豊かなエリアの保全とその水源地から流れ込む豊かな漁場・中海の保全に一緒に協力してまいりたいと思います。"@ja.
}
