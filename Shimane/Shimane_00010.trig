PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00010> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "日向山風力発電計画"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "環境影響評価方法書の縦覧開始"@ja.
kg:id_2 rdf:type cls:c_14139.
cls:c_14139 rdfs:label "縦覧開始"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "意見書の提出"@ja.
kg:id_3 rdf:type cls:c_1671.
cls:c_1671 rdfs:label "意見書提出"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "縦覧場所に備え付けの意見書箱への投函"@ja.
kg:id_4 rdf:type cls:c_1671.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "郵送による意見書提出"@ja.
kg:id_5 rdf:type cls:c_1671.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "フォームによる意見書投稿"@ja.
kg:id_6 rdf:type cls:c_1671.
kg:id_1 prop:contermeasure kg:id_6.
kg:st_1 rdfs:label "当会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "意見書を取り纏めて提出する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "意見書を取り纏めて提出する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:text-txt_contents "日向山の風力発電計画に関する方法書の縦覧が開始されました。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "意見書の提出について"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:text-txt_contents "(1)縦覧場所に備え付けの意見書箱に投函（令和 5 年 5 月 18 日（木）まで）"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "(2)下記の宛先に郵送（令和 5 年 5 月 18 日（木）当日消印有効）"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "(3) 意見書について以下のフォームからご投稿いただければ当会でも取り纏めて提出いたします。"@ja.
}
