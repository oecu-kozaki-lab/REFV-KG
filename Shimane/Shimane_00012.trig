PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00012> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電"@ja.
kg:id_1 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "地域にお金が落ちる仕組みが出来上がり次の世代にも良い思いをさせてあげられる"@ja.
kg:id_2 rdf:type cls:c_14159.
cls:c_14159 rdfs:label "地域経済への好影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "自分たちの大切なものを売り渡さないと地域は守れないという諦めた感情が次の世代にも伝搬する"@ja.
kg:id_3 rdf:type cls:c_14160.
cls:c_14160 rdfs:label "諦めの感情の伝搬"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "守るべきものがなければ若者は地域を出て行き二度と戻ってこない"@ja.
kg:id_4 rdf:type cls:c_14161.
cls:c_14161 rdfs:label "若者の流出"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "勉強会を通じて地域に本当に必要なものかよく考える"@ja.
kg:id_5 rdf:type cls:c_14162.
cls:c_14162 rdfs:label "必要性の検討"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "自分たちの手で地域の自然や歴史を守る"@ja.
kg:id_6 rdf:type cls:c_14163.
cls:c_14163 rdfs:label "地域資源の保全"@ja.
kg:id_1 prop:contermeasure kg:id_6.
kg:st_1 rdfs:label "風力発電に賛成される方"@ja.
kg:st_1 rdfs:type cls:st_177.
cls:st_177 rdfs:label "賛成者"@ja.
kg:op_1 prop:content "事業者が来れば地域経済や次世代に良い影響があると見る"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "筆者"@ja.
kg:st_2 rdfs:type cls:st_178.
cls:st_178 rdfs:label "筆者"@ja.
kg:op_2 prop:content "地域を守るために大切なものを売り渡す発想は諦めと妥協であり次世代に悪影響を及ぼすと考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "地域の大切なものが失われれば若者は戻らなくなると懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "勉強会を通じて住民が風力発電の必要性を見極めるべきだと考える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "国や事業者に頼るのではなく地域の自然や歴史を自分たちで守るべきだと主張する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "よく風力発電などを賛成される方が口にするのは、大きな事業者が地域にきてくれれば、お金が落ちる仕組みが出来上がり、次の世代にも良い思いをさせてあげられるんじゃないかという言葉です。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "自分たちの大切なものを売り渡さないと地域は守れない。国や事業者など、誰かに頼り、与えられなければ自分たちではどうすることもできないんだ。その諦めた感情は次の世代にも伝搬します。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "守るべきものがなければ、無理にこの地にとどまる必要はない。一度この地域を出て行ったら若者は二度とここへは戻ってくることはないでしょう。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "勉強会を通じて、風力発電が私たちの大切なこの地域に本当に必要なものかよく考えていただければと思います。"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "私たちがこの地域の自然や歴史はとても大切なものなんだ。先人が造り上げ、守ってきたかけがえのないものだ。だから、自分たちの手で守るんだと、そういう強い想いをもって恐れずに行動することが本当は多くの次の世代も望んでいることではないでしょうか？"@ja.
}
