PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00013> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "事業者説明会・勉強会"@ja.
kg:id_1 rdf:type cls:c_3027.
cls:c_3027 rdfs:label "説明会"@ja.
kg:id_2 rdfs:label "各地で開催"@ja.
kg:id_2 rdf:type cls:c_14164.
cls:c_14164 rdfs:label "開催"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "予定表を公開"@ja.
kg:id_3 rdf:type cls:c_14165.
cls:c_14165 rdfs:label "予定表"@ja.
kg:id_1 prop:countermeasure kg:id_3.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "今月は事業者説明会・勉強会が各地で開催されますので、以下にカレンダーを共有します。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:text-txt_contents "事業者説明会・勉強会の予定表を公開します。"@ja.
}
