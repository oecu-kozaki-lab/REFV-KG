PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00016> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "安来市"@ja.
kg:id_1 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_2 rdfs:label "風力発電施設の設置に関するガイドラインを独自に策定、施行"@ja.
kg:id_2 rdf:type cls:c_14167.
cls:c_14167 rdfs:label "設置指針"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:st_1 rdfs:label "記事投稿者"@ja.
kg:st_1 rdfs:type cls:st_179.
cls:st_179 rdfs:label "情報発信者"@ja.
kg:op_1 prop:content "風力発電をごみ扱いしているのではないかと疑問視する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "「安来市が風力発電施設の設置に関するガイドラインを独自に策定、施行」"@ja.
}
