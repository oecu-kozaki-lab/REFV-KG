PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00017> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "鳥取西部風力発電事業計画"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "住民への周知不足"@ja.
kg:id_2 rdf:type cls:c_1098.
cls:c_1098 rdfs:label "周知不足"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "住宅街に近い場所への32基設置計画"@ja.
kg:id_3 rdf:type cls:c_14168.
cls:c_14168 rdfs:label "住宅地近接"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "学校が2km圏内に複数存在"@ja.
kg:id_4 rdf:type cls:c_14169.
cls:c_14169 rdfs:label "公共施設近接"@ja.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "野上川の水源地の尾根を崩して風車を32基建設"@ja.
kg:id_5 rdf:type cls:c_14170.
cls:c_14170 rdfs:label "水源地開発"@ja.
kg:id_1 prop:cause kg:id_5.
kg:id_6 rdfs:label "騒音被害"@ja.
kg:id_6 rdf:type cls:c_13352.
cls:c_13352 rdfs:label "騒音被害"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "健康被害"@ja.
kg:id_7 rdf:type cls:c_1322.
cls:c_1322 rdfs:label "健康被害"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "豪雨時の日野川氾濫"@ja.
kg:id_8 rdf:type cls:c_14171.
cls:c_14171 rdfs:label "河川氾濫"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "住民への周知"@ja.
kg:id_9 rdf:type cls:c_5191.
cls:c_5191 rdfs:label "住民周知"@ja.
kg:id_1 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "住民の意見聴取"@ja.
kg:id_10 rdf:type cls:c_99.
cls:c_99 rdfs:label "意見聴取"@ja.
kg:id_1 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "勉強会の開催"@ja.
kg:id_11 rdf:type cls:c_94.
cls:c_94 rdfs:label "説明会開催"@ja.
kg:id_1 prop:countermeasure kg:id_11.
kg:st_1 rdfs:label "地域住民の方たち"@ja.
kg:st_1 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "計画をほとんど知らされていない"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "筆者"@ja.
kg:st_2 rdf:type cls:st_178.
cls:st_178 rdfs:label "筆者"@ja.
kg:op_2 prop:content "人家の近くへの建設は無理がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "学校近接地への建設は問題が大きい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "水源地の尾根を崩す計画は危険すぎる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "騒音被害が出るおそれが高い"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "健康被害が出るおそれが高い"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "豪雨時に日野川が氾濫するおそれがある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "住民への十分な周知が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "住民の意見を聞くべきだ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:st_3 rdfs:label "米子、安来から駆けつけた参加者"@ja.
kg:st_3 rdf:type cls:st_74.
cls:st_74 rdfs:label "参加者"@ja.
kg:op_10 prop:content "勉強会に参加し計画への認知を広げている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "鳥取西部の計画は地域住民の方たちはほとんど知らないのが実情ですが"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "鳥取西部の風力発電は4500kW（高さ150m）と陸上では最大クラスでそれが32基設置される計画ですが、住宅街に近づぎます。何を考えてこんな人家の近くに建設を立てようと思ったのか？"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "学校が２ｋｍ圏内に複数存在しています。何を考えてこんな人家の近くに建設を立てようと思ったのか？"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "加えて野上川の水源地（日野川の支流）の尾根を崩して、風車を32基も建てるなんて、危険すぎると素人でもわかると思いますが"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "騒音被害、健康被害が出ないと考える方が無理があります"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "騒音被害、健康被害が出ないと考える方が無理があります"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "豪雨が来たら、伯耆町や米子市の海抜は低いんですから、日野川が氾濫してもおかしくないですよ"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "きちんと住民への周知と意見を聞くという環境アセスにきちんと違反してます"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "きちんと住民への周知と意見を聞くという環境アセスにきちんと違反してます"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "伯耆町二部公民館にて鳥取西部風力発電事業計画についての勉強会が行われました。勉強会では、米子、安来からも駆けつけてくれて平日昼間の開催にもかかわらず15人くらい集まってくれました"@ja.
}
