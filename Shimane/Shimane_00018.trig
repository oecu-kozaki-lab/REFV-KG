PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00018> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "土砂崩れ"@ja.
kg:id_1 rdf:type cls:c_2615.
cls:c_2615 rdfs:label "災害"@ja.
kg:id_2 rdfs:label "島根半島に建設された風車"@ja.
kg:id_2 rdf:type cls:c_13741.
cls:c_13741 rdfs:label "風力発電設備"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_2 prop:effect kg:id_1.
kg:id_3 rdfs:label "風車がいくつか壊れてすでに動いていない"@ja.
kg:id_3 rdf:type cls:c_681.
cls:c_681 rdfs:label "設備故障"@ja.
kg:id_2 prop:effect kg:id_3.
kg:id_4 rdfs:label "風力発電"@ja.
kg:id_4 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_5 rdfs:label "直接的な影響を受けると考えている人は少ない"@ja.
kg:id_5 rdf:type cls:c_14172.
cls:c_14172 rdfs:label "影響の小ささ"@ja.
kg:id_4 prop:effect kg:id_5.
kg:st_1 rdfs:label "勉強会参加者"@ja.
kg:st_1 rdfs:type cls:st_74.
cls:st_74 rdfs:label "参加者"@ja.
kg:op_1 prop:content "風車が土砂崩れや故障を起こしており持続可能なエネルギーとは言えないと疑問視する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "風車が土砂崩れや故障を起こしており持続可能なエネルギーとは言えないと疑問視する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "風車が土砂崩れや故障を起こしており持続可能なエネルギーとは言えないと疑問視する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "比田地区の人"@ja.
kg:st_2 rdfs:type cls:st_167.
cls:st_167 rdfs:label "地域住民"@ja.
kg:op_4 prop:content "風力発電から少し離れているため直接的な影響は少ないと考える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "勉強会では、島根半島に建設された風車のお話も出ました。土砂崩れを起こしている箇所がいくつかあるようで"@ja.
<< kg:id_2 prop:effect kg:id_1 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "勉強会では、島根半島に建設された風車のお話も出ました。土砂崩れを起こしている箇所がいくつかあるようで"@ja.
<< kg:id_2 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "風車もいくつか壊れてすでに動いていないとか。どこが持続可能なエネルギーなんでしょう？"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "東比田地区は、風力発電から近いですが、比田地区は少し離れているため、そこまで直接的な影響を受けると考えている人は少ない"@ja.
}
