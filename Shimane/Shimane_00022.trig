kg:id_40 rdf:type cls:c_14192.
cls:c_14192 rdfs:label "謝意表明"@ja.
kg:id_37 prop:contermeasure kg:id_40.
kg:id_41 rdfs:label "あらためて公開質問状を作成して届ける"@ja.
kg:id_41 rdf:type cls:c_14193.
cls:c_14193 rdfs:label "質問提出"@ja.
kg:id_37 prop:contermeasure kg:id_41.
kg:st_1 rdfs:label "ジャパン・リニューアブル・エナジー株式会社"@ja.
kg:st_1 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "総合計画の記載を踏まえて事業検討エリアとして計画した"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "現地調査を行い水質汚染が発生しないよう計画するとしている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "審査基準に基づく設計で土砂災害を発生させないようにするとしている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "事業に責任がある災害被害には補償する考えを示している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "比婆山を始めとした歴史的空間に配慮した計画にするとしている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "観光産業化や地元イベント実施を通じて寄与したいとしている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "文化財への直接改変を避け文化財保全にも貢献する計画を検討するとしている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "希少な動植物への影響を予測評価し回避低減策を検討するとしている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "林道整備や教育の場の提供や雇用創出でUIターン者を引き付ける効果があるとしている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "雇用創出などを通じて地元から離れない施策にも寄与できるとしている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "現時点では不動産価値への影響は示せないとしている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "風力発電所を通して観光や雇用創出など経済面での効果に寄与するとしている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "防衛省に照会済みで影響が予想される場合は移設を想定している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "近隣住居への影響が回避低減されるよう風車配置や機種選定を検討するとしている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "自然環境保全と森林活用について今後安来市と協議するとしている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "雨水流出や森林崩壊土砂流出を防ぐ代替施設を設置するとしている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "水源や景観や生態系や生活環境の把握のため現地調査が必要としている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "調査設計の進捗に応じて継続的に報告したいとしている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "基準に基づく設計で土砂災害防止を図るとしている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "不測の事態に備えて保険加入の上で事業化を進めるとしている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "観光事業への寄与策として観光産業化や地元イベントを挙げている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "景観や生態系や住環境への影響について外部専門家審査を受け回避低減を図るとしている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "教育委員会文化財課や県部署と協議の上で計画を検討するとしている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "希少種への影響予測評価を行い保全措置を検討するとしている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "地域創生と発展に向け安来市と継続的に意見交換するとしている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "説明責任を果たすため全戸配布と説明会を広く実施しているとしている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "地域の意見を受けながら地域特性を踏まえた計画にするとしている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "調査結果は準備書で住民へ説明するとしている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "防空レーダーへの影響有無を確認するため防衛省に照会している"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "防空レーダーへの影響が予想される場合は風車移設を想定している"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "近隣住居への影響回避低減のため配置や機種を検討するとしている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "現地調査や予測評価や風況観測を踏まえて生活環境配慮型の計画を検討するとしている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "地上権設定契約は双方の弁護士確認を経て締結したとしている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "債務不履行時も債権者により事業継続可能な仕組みとしている"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "ガイドラインに則り風車撤去費用の積立を計画に盛り込んでいる"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:st_2 rdfs:label "日向山・大出日山の風力発電を考える会"@ja.
kg:st_2 rdfs:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_36 prop:content "回答は今後の調査や検討が多く具体性に欠けると受け止めている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "説明会でも納得できず不安が解消されなかったとしている"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "返事をしてくれたことには礼を伝える予定としている"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "新たな疑問が増えたため再度公開質問状を提出する考えを示している"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "第2次安来市総合計画には「積極的な再生可能エネルギーの利用を推進する」との記載もあることから、本事業の検討エリアとして計画いたしました"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "水源への影響については、現地調査を実施のうえ、水質汚染が発生しないように事業を計画してまいります"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "保安林の指定解除事務等マニュアル(風力編)及び島根県林地開発行為審査基準に基づいた設計を行うことにより土砂災害を発生させないよう本事業の設計を進めて参ります"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "不測の事態において事業に起因する災害で弊社に責任がある場合は、生じた被害に対し補償をさせていただく考えです"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "比婆山を始めとした歴史的な空間及び観光事業に対しても配慮をした計画としてまいります"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "特に観光事業に対しては、発電所の観光産業化や地元地域とのイベントの実施などを通し、寄与していきたいと考えております"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "文化財への直接改変は避けるととも文化財保全にも貢献していくような計画を検討して参ります"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "希少な動植物に対して本事業の実施によりどのような影響を与える可能性があるか予測・評価を行い、環境影響評価法に則り外部専門家の審査を受け、影響を回避・低減するための保全措置を検討してまいります"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本事業にて整備する林道を通じて、現在管理が行き届いていない山林の管理や人材育成を可能にする効果や、再生可能エネルギーを通じての教育の場の提供や若手技術者の養成および長期の雇用創出など、UIターン者を引き付ける効果"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "UIターン者を引き付ける効果及び地元から離れない施策についても寄与できるものと考えております"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本事業による不動産価値への影響については、現時点ではお示しできるものがありません"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "風力発電所を通して観光や雇用創出などの経済面での効果にも寄与する計画"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "本事業による防空レーダーへの影響については、防衛省の所管部門へ照会を依頼済みです。また、防空レーダーへの影響が予想される場合は、影響のない位置へ風車を移設することを想定しております"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "近隣住居にお住いの方におかれましては、環境影響評価法に則り外部専門家の審査を受け、その影響が回避・低減されるよう必要に応じて風車配置や機種選定を検討してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "自然環境の保全と森林の多面的機能の有効活用については安来市と今後協議してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "調整池や排水施設等の森林の転用により増加する雨水の流出を安全に下流に流すための施設や、森林の崩壊や土砂の流出を防ぐ施設等、解除に伴って損なわれる保安林の機能を代替する施設の設置をいたします"@ja.
<< kg:id_1 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "現地調査を実施のうえ、水質汚染が発生しないように事業を計画してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "継続的に皆様にご報告できればと考えております"@ja.
<< kg:id_1 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "保安林の指定解除事務等マニュアル(風力編)及び島根県林地開発行為審査基準に基づいた設計を行うことにより土砂災害を発生させないよう本事業の設計を進めて参ります"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "万が一の不測の事態に備え各種保険に加入し事業化を進めてまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "発電所の観光産業化や地元地域とのイベントの実施などを通し、寄与していきたいと考えております"@ja.
<< kg:id_1 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "環境影響評価法に則り外部専門家の審査を受け、影響を回避・低減する計画となるよう検討してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "今後は文化財の所管である教育委員会文化財課や県部署とも協議を行った上で"@ja.
<< kg:id_1 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "影響を回避・低減するための保全措置を検討してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "地域創生、発展に向けては安来市と継続的に意見交換を行い、地域の特性に応じた貢献策の検討を行ってまいりたいと存じます"@ja.
<< kg:id_1 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "弊社としましては説明責任を果たすべく、お知らせの全戸配布や説明会を広く開催している所でございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "地域の特性を踏まえた事業計画となるよう、環境影響評価法に則り地域の皆さまのご意見を賜りながら計画検討し"@ja.
<< kg:id_1 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "調査結果につきましては準備書において住民の皆さまへご説明をさせていただきます"@ja.
<< kg:id_1 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "本事業による防空レーダーへの影響については、防衛省の所管部門へ照会を依頼済みです"@ja.
<< kg:id_1 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "防空レーダーへの影響が予想される場合は、影響のない位置へ風車を移設することを想定しております"@ja.
<< kg:id_1 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "その影響が回避・低減されるよう必要に応じて風車配置や機種選定を検討してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "今後、環境影響評価に基づく現地調査及び予測評価、風況観測に基づく事業性評価を踏まえて生活環境に配慮した計画を検討してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "地上権設定契約の締結に際しては、契約者双方の弁護士チェックを経て契約締結に至った経緯がございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "万が一本合同会社が債務不履行に陥った場合も債権者によって事業継続が可能な仕組みとなっております"@ja.
<< kg:id_1 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "風車撤去費については、資源エネルギー庁の「事業計画策定ガイドライン(風力発電)」に則り撤去費用の積立を計画に盛り込んでおります"@ja.
<< kg:id_37 prop:effect kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "内容的には、説明会での回答のように今後の調査や検討といった内容が多く具体的な補償事例や数字が示されたわけではありません"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "説明会でも納得のいかない、不安を払拭できるような回答を得られなかった"@ja.
<< kg:id_37 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "返事をしてくれたことに対してはお礼の返事をする予定です"@ja.
<< kg:id_37 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "あらたな質問が増え、説明会でも納得のいかない、不安を払拭できるような回答を得られなかったことから、あらためて公開質問状を作成して届けようと思います"@ja.
}
