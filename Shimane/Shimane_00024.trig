PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00024> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電建設予定地"@ja.
kg:id_1 rdf:type cls:c_13354.
cls:c_13354 rdfs:label "建設予定地"@ja.
kg:id_2 rdfs:label "土砂災害"@ja.
kg:id_2 rdf:type cls:c_832.
cls:c_832 rdfs:label "土砂災害"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "土砂災害マップの公開"@ja.
kg:id_3 rdf:type cls:c_14204.
cls:c_14204 rdfs:label "災害地図"@ja.
kg:id_2 prop:contermeasure kg:id_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "鳥取西部、島根県東部（日向山、大出日山、鳥取西部）に計画されている風力発電建設予定地の土砂災害マップについて公開いたしました。"@ja.
<< kg:id_2 prop:contermeasure kg:id_3 >>
    prop:text-txt_contents "向山、大出日山、鳥取西部、風力発電建設予定地の土砂災害マップを公開しました"@ja.
}
