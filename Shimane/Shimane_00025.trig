PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00025> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "説明会の質疑"@ja.
kg:id_1 rdf:type cls:c_14205.
cls:c_14205 rdfs:label "質疑応答"@ja.
kg:id_2 rdfs:label "45分近く時間をオーバー"@ja.
kg:id_2 rdf:type cls:c_14198.
cls:c_14198 rdfs:label "時間超過"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "事業者が正確な事を言えない状況"@ja.
kg:id_3 rdf:type cls:c_14206.
cls:c_14206 rdfs:label "説明不能状態"@ja.
kg:id_4 rdfs:label "環境調査を行わない"@ja.
kg:id_4 rdf:type cls:c_192.
cls:c_192 rdfs:label "環境調査"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "環境調査"@ja.
kg:id_5 rdf:type cls:c_192.
kg:id_6 rdfs:label "納得のいく説明責任を果たす"@ja.
kg:id_6 rdf:type cls:c_6354.
cls:c_6354 rdfs:label "説明責任"@ja.
kg:id_5 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "事業者と住民の対話"@ja.
kg:id_7 rdf:type cls:c_5588.
cls:c_5588 rdfs:label "対話"@ja.
kg:id_8 rdfs:label "平行線のまま"@ja.
kg:id_8 rdf:type cls:c_14207.
cls:c_14207 rdfs:label "膠着状態"@ja.
kg:id_7 prop:effect kg:id_8.
kg:id_9 rdfs:label "住民が安心できない状況"@ja.
kg:id_9 rdf:type cls:c_14208.
cls:c_14208 rdfs:label "不安心"@ja.
kg:id_10 rdfs:label "東京からやってきた得体のしれない企業の自主的な環境調査"@ja.
kg:id_10 rdf:type cls:c_14209.
cls:c_14209 rdfs:label "自主調査"@ja.
kg:id_9 prop:cause kg:id_10.
kg:id_11 rdfs:label "計画"@ja.
kg:id_11 rdf:type cls:c_7140.
cls:c_7140 rdfs:label "計画"@ja.
kg:id_12 rdfs:label "地域の人または地域の人が選んだ第三者の調査機関と共に調査し納得の行くまで進めない"@ja.
kg:id_12 rdf:type cls:c_14201.
cls:c_14201 rdfs:label "共同調査"@ja.
kg:id_11 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "環境アセス"@ja.
kg:id_13 rdf:type cls:c_12642.
cls:c_12642 rdfs:label "環境アセス"@ja.
kg:id_14 rdfs:label "抜け穴だらけ"@ja.
kg:id_14 rdf:type cls:c_14210.
cls:c_14210 rdfs:label "不備"@ja.
kg:id_13 prop:cause kg:id_14.
kg:id_15 rdfs:label "今回の説明会"@ja.
kg:id_15 rdf:type cls:c_3027.
cls:c_3027 rdfs:label "説明会"@ja.
kg:id_16 rdfs:label "多くの質問や不安が当会に寄せられている"@ja.
kg:id_16 rdf:type cls:c_14211.
cls:c_14211 rdfs:label "質問と不安"@ja.
kg:id_15 prop:effect kg:id_16.
kg:id_17 rdfs:label "事業者への対応"@ja.
kg:id_17 rdf:type cls:c_14212.
cls:c_14212 rdfs:label "対応"@ja.
kg:id_18 rdfs:label "公開質問状を送り届ける"@ja.
kg:id_18 rdf:type cls:c_14213.
cls:c_14213 rdfs:label "質問状送付"@ja.
kg:id_17 prop:contermeasure kg:id_18.
kg:st_1 rdfs:label "事業者"@ja.
kg:st_1 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "環境調査なしでは正確な事は言えない"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "住民"@ja.
kg:st_2 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_2 prop:content "環境調査の前に説明責任を果たすべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "投稿者"@ja.
kg:st_3 rdfs:type cls:st_180.
cls:st_180 rdfs:label "投稿者"@ja.
kg:op_3 prop:content "事業者の自主的な環境調査だけでは安心できない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "地域側が関与する調査を行い納得するまで計画を進めるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "環境アセスは不十分で問題がある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:st_4 rdfs:label "当会"@ja.
kg:st_4 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_6 prop:content "あらためて公開質問状を事業者へ送る"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "結局、出席者からの質問が終わらず、45分近く時間をオーバーしていました。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "「環境調査を行わないと正確な事は言えないので控えさせていただく」という事業者"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "「環境調査に入る前に納得のいく説明責任を果たすべき」と求める住民。"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:text-txt_contents "平行線のままです。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "東京からやってきた得体のしれない企業が、自主的な環境調査をやって安心させますと言われても、それは無理ってものです。"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "せめて、地域の人、もしくは地域の人が選んだ第三者の調査機関と共に一緒に調査させていただき納得の行くまで計画はすすめない、くらい言ってほしいものです。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "環境アセスが抜け穴だらけでダメなんでしょう。"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:text-txt_contents "今回の説明会を経て、また多くの質問や不安が当会には寄せられてきています。"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "あらためて公開質問状を事業者へ送り届けようと思います。"@ja.
}
