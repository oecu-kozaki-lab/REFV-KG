PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00026> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "大出日山のモンタージュ"@ja.
kg:id_1 rdf:type cls:c_14214.
cls:c_14214 rdfs:label "景観資料"@ja.
kg:id_2 rdfs:label "地面レベルビューでは対象物が小さく表示される"@ja.
kg:id_2 rdf:type cls:c_14215.
cls:c_14215 rdfs:label "表示差異"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "実際はもう少し大きい可能性がある"@ja.
kg:id_3 rdf:type cls:c_14216.
cls:c_14216 rdfs:label "対象物の過小表示可能性"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "要望があればこの辺りからのモンタージュを作成して連絡を受け付ける"@ja.
kg:id_4 rdf:type cls:c_14217.
cls:c_14217 rdfs:label "資料作成要請"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:st_1 rdfs:label "作成者"@ja.
kg:st_1 rdf:type cls:st_181.
cls:st_181 rdfs:label "作成者"@ja.
kg:op_1 prop:content "実際はもう少し大きいのではないかと思う"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "要望者"@ja.
kg:st_2 rdf:type cls:st_182.
cls:st_182 rdfs:label "要望者"@ja.
kg:op_2 prop:content "この辺りからのモンタージュがほしい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "GoogleEarth の地面レベルビューから作成しましたが、通常ビューよりも地面レベルビューは対象物が小さく表示される"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "実際はもう少し大きいのではないかと思います。"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "「この辺りからのモンタージュがほしい」という要望がありましたら、お時間は少しいただきますが、ご連絡下さい。"@ja.
}
