PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00027> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "日向山風力発電事業"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "説明会を重ね納得のいく説明を行い理解を得る"@ja.
kg:id_2 rdf:type cls:c_4068.
cls:c_4068 rdfs:label "説明対応"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "大出日山風力発電事業"@ja.
kg:id_3 rdf:type cls:c_170.
kg:id_3 prop:countermeasure kg:id_2.
kg:st_1 rdfs:label "事業者側"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "これからも必要に応じて説明会を重ね納得のいく説明を行い理解を得たい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "会"@ja.
kg:st_2 rdf:type cls:st_183.
cls:st_183 rdfs:label "会議体"@ja.
kg:op_2 prop:content "反対を伝えた"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "これからも必要に応じて説明会を重ね納得のいく説明を行い理解を得たい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "反対を伝えた"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業者側としては、「これからも必要に応じて説明会を重ね、納得のいく説明を行い、理解を得ていきたい」ということで、スタンスは変わりありませんでした。少しお話させていただいてあらためて、反対を伝えた"@ja.
<< kg:id_3 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事業者側としては、「これからも必要に応じて説明会を重ね、納得のいく説明を行い、理解を得ていきたい」ということで、スタンスは変わりありませんでした。少しお話させていただいてあらためて、反対を伝えた"@ja.
}
