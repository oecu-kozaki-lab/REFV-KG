kg:id_6 rdfs:label "地域の住民や関係者から当会に多くの意見や質問が寄せられた"@ja.
kg:id_6 rdf:type cls:c_92.
cls:c_92 rdfs:label "意見提出"@ja.
kg:id_5 prop:effect kg:id_6.
kg:id_7 rdfs:label "比婆山の母神御陵地を利用状況と表現したこと"@ja.
kg:id_7 rdf:type cls:c_14220.
cls:c_14220 rdfs:label "不適切な表現"@ja.
kg:id_8 rdfs:label "信仰する地域住民に対して配慮を欠き不適切と受け止められた"@ja.
kg:id_8 rdf:type cls:c_5217.
cls:c_5217 rdfs:label "配慮不足"@ja.
kg:id_7 prop:effect kg:id_8.
kg:id_9 rdfs:label "事業者の説明や回答内容"@ja.
kg:id_9 rdf:type cls:c_14221.
cls:c_14221 rdfs:label "説明内容"@ja.
kg:id_10 rdfs:label "多くの事実と相違点が見受けられたこと"@ja.
kg:id_10 rdf:type cls:c_14222.
cls:c_14222 rdfs:label "事実相違"@ja.
kg:id_9 prop:cause kg:id_10.
kg:id_11 rdfs:label "風力発電施設の整備"@ja.
kg:id_11 rdf:type cls:c_1935.
cls:c_1935 rdfs:label "施設整備"@ja.
kg:id_12 rdfs:label "地形が改変する"@ja.
kg:id_12 rdf:type cls:c_127.
cls:c_127 rdfs:label "地形改変"@ja.
kg:id_11 prop:effect kg:id_12.
kg:id_13 rdfs:label "開発行為による負荷流量"@ja.
kg:id_13 rdf:type cls:c_14223.
cls:c_14223 rdfs:label "開発負荷"@ja.
kg:id_14 rdfs:label "既存の市管理河川の流下能力を越える懸念"@ja.
kg:id_14 rdf:type cls:c_14088.
cls:c_14088 rdfs:label "治水懸念"@ja.
kg:id_13 prop:effect kg:id_14.
kg:id_15 rdfs:label "下流の治水ダムの既存の放流量に上乗せとなる"@ja.
kg:id_15 rdf:type cls:c_14089.
cls:c_14089 rdfs:label "放流増加"@ja.
kg:id_13 prop:effect kg:id_15.
kg:id_16 rdfs:label "濁水"@ja.
kg:id_16 rdf:type cls:c_470.
cls:c_470 rdfs:label "濁水"@ja.
kg:id_17 rdfs:label "濾過膜閉塞により緩速濾過池が機能不能となり水道水を供給できなくなる"@ja.
kg:id_17 rdf:type cls:c_14224.
cls:c_14224 rdfs:label "断水懸念"@ja.
kg:id_16 prop:effect kg:id_17.
kg:id_18 rdfs:label "降雨により地中の含水比が上昇すること"@ja.
kg:id_18 rdf:type cls:c_14225.
cls:c_14225 rdfs:label "含水比上昇"@ja.
kg:id_19 rdfs:label "固結状態が解放され浅層崩壊が発生する"@ja.
kg:id_19 rdf:type cls:c_14091.
cls:c_14091 rdfs:label "浅層崩壊"@ja.
kg:id_18 prop:cause kg:id_19.
kg:id_20 rdfs:label "開発区域でしゃき土が露呈すること"@ja.
kg:id_20 rdf:type cls:c_14092.
cls:c_14092 rdfs:label "土壌露出"@ja.
kg:id_21 rdfs:label "建設中の土砂災害や山腹崩壊による土石流のおそれ"@ja.
kg:id_21 rdf:type cls:c_832.
cls:c_832 rdfs:label "土砂災害"@ja.
kg:id_20 prop:effect kg:id_21.
kg:id_22 rdfs:label "下流域の治水対策を計画する"@ja.
kg:id_22 rdf:type cls:c_9748.
cls:c_9748 rdfs:label "治水対策"@ja.
kg:id_13 prop:contermeasure kg:id_22.
kg:id_23 rdfs:label "下流の治水ダムへの上乗せに対する対策を取る"@ja.
kg:id_23 rdf:type cls:c_14094.
cls:c_14094 rdfs:label "放流対策"@ja.
kg:id_13 prop:contermeasure kg:id_23.
kg:id_24 rdfs:label "具体的な対策をする"@ja.
kg:id_24 rdf:type cls:c_2544.
cls:c_2544 rdfs:label "防災対策"@ja.
kg:id_21 prop:contermeasure kg:id_24.
kg:id_25 rdfs:label "線状降水帯を考慮した豪雨リスク"@ja.
kg:id_25 rdf:type cls:c_14226.
cls:c_14226 rdfs:label "豪雨リスク"@ja.
kg:id_26 rdfs:label "降雨強度を考慮して設計する"@ja.
kg:id_26 rdf:type cls:c_14227.
cls:c_14227 rdfs:label "耐雨設計"@ja.
kg:id_25 prop:contermeasure kg:id_26.
kg:st_1 rdfs:label "出雲・伯伎 神話の里と豊かな自然を守る会"@ja.
kg:st_1 rdfs:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "質問に対する回答に事実との相違や不明瞭さが多いとみて再度問い合わせを行う"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "説明会では質問と回答がかみ合わず住民の懸念が解消されなかったとみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "地域の住民や関係者"@ja.
kg:st_2 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_3 prop:content "説明会の回答では納得できず追加の意見や質問を寄せる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "母神御陵地を利用状況と表現するのは信仰する住民への配慮を欠き不適切だと指摘する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "回答内容に事実との相違が多いため再度の公開質問状を提出する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "下流域で河川の流下能力を超えるおそれを懸念している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "負荷流量が治水ダム放流量に上乗せされることを問題視している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "下流の上水道水源地で濁水により水道供給に支障が出るおそれを懸念している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "脆弱な砂質土では豪雨時に浅層崩壊が起こるとみている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "しゃき土の露呈により建設中の土砂災害や土石流への具体的対策が必要だと求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "シミュレーション結果を含めた下流域の治水対策の提示を求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "治水ダム放流量への上乗せにどう対策するか説明を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "土砂災害や土石流への具体策を明らかにするよう求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "近年の豪雨を踏まえ線状降水帯を考慮した設計が必要だと求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "住民からの環境影響調査方法に関する質問に対して、実際には貴社の既存施設の運用実績や確立された一般的な予測計算から回答できると思われる質問についても、「方法書段階のため、調査してみないとわからない」とする合点のいかない不明瞭な答えが多かったことがその原因にございました。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "安来市文化ホール・アルテピア大ホールにて行われた最後の説明会では、予定時間を大幅に過ぎても、住民との話し合いは質問と回答が上手くかみ合わず、平行線のままで終わりました。"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "方法書説明会では、即答が難しい質問内容も多くあったことは理解しておりますが、その結果、地域の住民や関係者より当会にも多くの意見や質問が寄せられました。"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "比婆山は観光地でも商業施設でもございません。母神御陵地を「利用状況」と表現されるのは信仰する地域住民に対して配慮を欠いており、不適切と存じますので、その点につきましては申し入れさせていただきます。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "この回答に対する内容には、多くの事実と相違点が見受けられたため、再度の問い合わせを行うことにしました。"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:text-txt_contents "問 20） 風力発電施設の整備により「地形」が改変する面積はどの程度か？"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "開発行為による負荷流量により、既存の市管理河川の流下能力を越えるのではないか懸念がございます。"@ja.
<< kg:id_13 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "また開発行為による負荷流量は下流の治水ダムの既存の放流量に上乗せとなりますが、どのような対策を取られるのかをお教えください。"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "上水道の水源地が下流にございますが、濁水により濾過膜閉塞により、緩速濾過池が機能不能となり、水道水を供給できなくなると考えられます。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これは脆弱な砂質土のため、降雨により地中の含水比が上昇すると固結状態が解放され浅層崩壊が発可するというものです。"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "開発区域には、この「しゃき土」が露呈することは確実であり、建設中の土砂災害や山腹崩壊による土石流の対策をすることが必要と考えますが、その点について具体的な対策とご意見を伺いますので、お答えいただきますようお願いいたします。"@ja.
<< kg:id_13 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "下流域の治水対策をどのように計画されるかお伺いいたます。開発行為による負荷流量により、既存の市管理河川の流下能力を越えるのではないか懸念がございます。シミュレーションとその結果についてご共有をお願いいたします。"@ja.
<< kg:id_13 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "また開発行為による負荷流量は下流の治水ダムの既存の放流量に上乗せとなりますが、どのような対策を取られるのかをお教えください。"@ja.
<< kg:id_21 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "建設中の土砂災害や山腹崩壊による土石流の対策をすることが必要と考えますが、その点について具体的な対策とご意見を伺いますので、お答えいただきますようお願いいたします。"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "昨今の状況からして、線上降水帯を考慮した降雨強度で設計すべきですが、貴社の考えを伺いますので、お教え下さい。"@ja.
}
