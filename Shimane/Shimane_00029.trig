PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00029> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電建設"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "建設中止を市として反対表明を出す"@ja.
kg:id_2 rdf:type cls:c_14228.
cls:c_14228 rdfs:label "反対表明"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "風力発電の建設に賛成している人"@ja.
kg:id_3 rdf:type cls:c_14229.
cls:c_14229 rdfs:label "建設賛成者"@ja.
kg:id_4 rdfs:label "とても少数派"@ja.
kg:id_4 rdf:type cls:c_14230.
cls:c_14230 rdfs:label "少数派"@ja.
kg:id_3 prop:effect kg:id_4.
kg:id_5 rdfs:label "風力発電"@ja.
kg:id_5 rdf:type cls:c_88.
kg:id_6 rdfs:label "問題について懸念される"@ja.
kg:id_6 rdf:type cls:c_14231.
cls:c_14231 rdfs:label "懸念"@ja.
kg:id_5 prop:effect kg:id_6.
kg:id_7 rdfs:label "今回の風力発電建設地"@ja.
kg:id_7 rdf:type cls:c_13354.
cls:c_13354 rdfs:label "建設予定地"@ja.
kg:id_8 rdfs:label "伯太川・飯梨川の水源地の山の尾根に建設されること"@ja.
kg:id_8 rdf:type cls:c_14232.
cls:c_14232 rdfs:label "水源地"@ja.
kg:id_7 prop:cause kg:id_8.
kg:id_9 rdfs:label "私たち市民の大切な生活水を支える伯太川・飯梨川の水源地に影響を及ぼす"@ja.
kg:id_9 rdf:type cls:c_14233.
cls:c_14233 rdfs:label "水源地影響"@ja.
kg:id_7 prop:effect kg:id_9.
kg:st_1 rdfs:label "陳情書を提出した会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "安来市議会に建設中止への反対表明を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "会の活動をしている人"@ja.
kg:st_2 rdfs:type cls:st_184.
cls:st_184 rdfs:label "活動関係者"@ja.
kg:op_2 prop:content "建設賛成者は少数派だと感じている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "何名かの議員さんたち"@ja.
kg:st_3 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_3 prop:content "風力発電の問題に懸念を示す"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:st_4 rdfs:label "安来市の市長"@ja.
kg:st_4 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "生活水を支える水源地への影響を大変心配している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_4.
kg:op_5 prop:content "水源地への影響と危険性を強く懸念している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "6月6日、安来市議会に風力発電の建設中止を市として反対表明を出していただくように求める陳情書を提出して参りました。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "会の活動をしている中で感じていることは、風力発電の建設に賛成している人はとても少数派だという事です。"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "6月から始まった市議会でも何名かの議員さんたちが、風力発電についての問題について懸念される発言をされていました。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "中でも市長が、今回の風力発電建設地が私たち市民の大切な生活水を支える伯太川・飯梨川の水源地の山の尾根に建設されることに、どれほどの影響を及ぼすか大変心配されていた"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "今回の風力発電建設地が私たち市民の大切な生活水を支える伯太川・飯梨川の水源地の山の尾根に建設されることに、どれほどの影響を及ぼすか大変心配されていたこと、危険性についてよく理解されていることに感銘いたしました。"@ja.
}
