kg:st_1 rdfs:label "安来市長"@ja.
kg:st_1 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "大規模な山林開発は阻止すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "取水域の水源涵養林を無理に開発する行為は避けるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "大規模な山林開発は阻止しなければならない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "無理な水源涵養林開発は避けるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "当会"@ja.
kg:st_2 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_5 prop:content "議会の反対だけでは建設計画は止まらない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "地域を守るため活動を加速させるべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "住民が一丸となって地域を守る必要がある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "地域防衛のため連携強化を進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "先日、島根県に線状降水帯が発生し、松江や出雲市で道路冠水などが発生しました。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:text-txt_contents "被災された方々には心からお見舞い申し上げるとともに一日も早く元通りの生活が送れるように願っています。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "安来市長からは、「大規模な山林開発は阻止しなければならない」"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "無理に取水域の水源涵養林を開発するような行為は避けるべきと明言していただきました。"@ja.
<< kg:id_6 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "安来市長からは、「大規模な山林開発は阻止しなければならない」"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "無理に取水域の水源涵養林を開発するような行為は避けるべきと明言していただきました。"@ja.
<< kg:id_5 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "安来市議会が反対したからと言って建設計画が止まったわけではありません。"@ja.
<< kg:id_5 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "さらに活動を加速させ、地域の未来のために住民が一丸となって地域を守っていけるように連携を強めていく所存です。"@ja.
<< kg:id_5 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地域の未来のために住民が一丸となって地域を守っていけるように連携を強めていく所存です。"@ja.
<< kg:id_5 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "地域の未来のために住民が一丸となって地域を守っていけるように連携を強めていく所存です。"@ja.
