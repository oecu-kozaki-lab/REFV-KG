kg:id_10 prop:effect kg:id_11.
kg:id_12 rdfs:label "風力発電導入"@ja.
kg:id_12 rdf:type cls:c_8173.
cls:c_8173 rdfs:label "発電導入"@ja.
kg:id_13 rdfs:label "国土風土に合わせてよく検証を重ねて取り入れる"@ja.
kg:id_13 rdf:type cls:c_14269.
cls:c_14269 rdfs:label "導入検証"@ja.
kg:id_12 prop:contermeasure kg:id_13.
