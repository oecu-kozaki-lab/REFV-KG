kg:id_1 rdfs:label "日向山、大出日山風力発電事業計画の中止"@ja.
kg:id_1 rdf:type cls:c_2176.
cls:c_2176 rdfs:label "事業中止"@ja.
kg:id_2 rdfs:label "市議会へ風力発電計画の中止を求める陳情書の提出"@ja.
kg:id_2 rdf:type cls:c_14265.
cls:c_14265 rdfs:label "陳情提出"@ja.
