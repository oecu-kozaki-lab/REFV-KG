cls:c_648 rdfs:label "意見交換"@ja.
kg:id_14 prop:contermeasure kg:id_18.
kg:id_19 rdfs:label "体制を作り上げて維持していくこと"@ja.
kg:id_19 rdf:type cls:c_4663.
cls:c_4663 rdfs:label "体制整備"@ja.
kg:id_14 prop:contermeasure kg:id_19.
kg:st_1 rdfs:label "本文筆者"@ja.
kg:st_1 rdfs:type cls:st_178.
cls:st_178 rdfs:label "筆者"@ja.
kg:op_1 prop:content "生活水を支える水源域への建設は重大なリスクがある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "何十ヘクタールもの森林喪失は脱炭素と持続可能な社会の観点から疑問がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地震大国の山頂への建設は危険性が高い"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "脱炭素をなし崩し的に受け入れず地域特性に応じて導入すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "地域を守るため今まで以上に情報収集が必要だ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地域を守るため分析と見極めが必要だ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地域の人たちと連携し情報共有する体制が必要だ"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地域の人たちと意見交換を行うことが必要だ"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "地域を守るため継続的な体制整備が必要不可欠だ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "昨年、市議会へ風力発電計画の中止を求める陳情書を提出した後"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "多くの方々にご理解とご協力をいただくことができ"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "各団体からも風力発電への計画反対の意思を事業者へ示していただきました"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "私たちの生活水を支える水源域に風力発電を建設することは将来に取り返しのつかない事態を招きかねないリスクがあります"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "自然豊かな森林環境を何十ヘクタールも喪失することは、脱炭素と持続可能な社会の構築という観点からは疑問を感じざるえません"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "地震大国の山々の山頂に風力発電の建設をすることはリスクが大きく"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:text-txt_contents "能登半島の風力発電施設も多大な被害を受けました"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "脱炭素はグローバル政策であるから良いもの、長いものには巻かれれば良いと、なし崩し的に受け入れるのではなく、国土風土に合わせてよく検証を重ねて取り入れて行くべきです"@ja.
<< kg:id_14 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "今まで以上に情報を収集し"@ja.
<< kg:id_14 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "分析と見極を行い"@ja.
<< kg:id_14 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地域の人たちと連携、共有し"@ja.
<< kg:id_14 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "意見交換を行う"@ja.
<< kg:id_14 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "こういった体制を作り上げて維持していくことがこれからの地域社会には必要不可欠なことなのかもしれません"@ja.
}
