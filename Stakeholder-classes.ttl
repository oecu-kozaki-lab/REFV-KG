@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prop: <https://kozaki-lab.jp/REFV-KG/prop/> .
@prefix cls:  <https://kozaki-lab.jp/REFV-KG/class/> .
@prefix kg:   <https://kozaki-lab.jp/REFV-KG/data/> .

cls:Stakeholder
    rdf:type rdfs:Class ;
    rdfs:label "ステークホルダー"@ja .

cls:StakeholderCategory
    rdf:type rdfs:Class ;
    rdfs:label "ステークホルダーのカテゴリ"@ja .

prop:opinionCount
    rdf:type rdf:Property ;
    rdfs:label "意見数"@ja ;
    rdfs:domain rdfs:Class ;
    rdfs:range xsd:nonNegativeInteger .

prop:stakeholderCategory
    rdf:type rdf:Property ;
    rdfs:label "ステークホルダーのカテゴリ"@ja ;
    rdfs:domain rdfs:Class ;
    rdfs:range cls:StakeholderCategory .

cls:stakeholderType_Administration
    rdf:type rdfs:Class ;
    rdfs:label "行政"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderType_Legislature
    rdf:type rdfs:Class ;
    rdfs:label "議会"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderType_ExpertProfessional
    rdf:type rdfs:Class ;
    rdfs:label "専門家・専門職"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderType_Citizen
    rdf:type rdfs:Class ;
    rdfs:label "市民・地域社会"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderType_Business
    rdf:type rdfs:Class ;
    rdfs:label "事業者・業界団体"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderType_DeliberativeBody
    rdf:type rdfs:Class ;
    rdfs:label "審議・協議機関"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderType_SpecializedInstitution
    rdf:type rdfs:Class ;
    rdfs:label "専門機関"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderType_Media
    rdf:type rdfs:Class ;
    rdfs:label "報道・情報発信"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderType_CommitteeMember
    rdf:type rdfs:Class ;
    rdfs:label "委員"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderType_Other
    rdf:type rdfs:Class ;
    rdfs:label "その他"@ja ;
    rdfs:subClassOf cls:Stakeholder .

cls:stakeholderCategory_Administration
    rdf:type cls:StakeholderCategory ;
    rdfs:label "行政"@ja .

cls:stakeholderCategory_Legislature
    rdf:type cls:StakeholderCategory ;
    rdfs:label "議会"@ja .

cls:stakeholderCategory_Expert
    rdf:type cls:StakeholderCategory ;
    rdfs:label "専門家"@ja .

cls:stakeholderCategory_Citizen
    rdf:type cls:StakeholderCategory ;
    rdfs:label "市民"@ja .

cls:stakeholderCategory_Business
    rdf:type cls:StakeholderCategory ;
    rdfs:label "事業者"@ja .

