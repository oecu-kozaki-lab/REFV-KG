kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:text-txt_contents "既設の風力発電設備による周辺環境への影響を踏まえ、改変面積を最小化しつつ"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:text-txt_contents "対象事業実施区域に近接して存在する住居から離隔をとった配置の検討を行う"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本事業者は、既設事業において、再生可能エネルギーの普及啓発の観点から見学イベントの開催等により地域貢献の役割を果たしてきており、本事業においても引き続き同様の取組を推進するとしている"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "対象事業実施区域の周辺には、複数の住居及び学校その他の環境の保全についての配慮が特に必要な施設が存在しており、一部の住居は風力発電設備の設置予定位置に近接している"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "対象事業実施区域及びその周辺はガン類、カモ類及びハクチョウ類の渡りの経路となっている"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "対象事業実施区域の北側のエリアには植生自然度の高いハマニガナ－ハマヒルガオ群落、カワラヨモギ群落等の海岸砂丘植生が分布しており、本事業の実施に伴い、その一部を改変する計画となっている"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "事後調査及び環境監視を適切に実施すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "その結果を踏まえ、必要に応じて、追加的な環境保全措置を講ずること"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "これまでの調査結果及び専門家等からの助言を踏まえて、客観的かつ科学的に検討すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "検討の過程やその対応方針等を公開し、透明性を確保すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "事後調査により本事業による環境影響を分析し、判明した環境の状況に応じて講ずる環境保全措置について、検討の過程、内容、効果及び不確実性の程度を報告書として取りまとめ、公表すること"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "対象事業実施区域の周辺では、他の事業者による複数の風力発電所が環境影響評価手続終了又は手続中であることから"@ja.
<< kg:id_1 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "可能な限り事業者間で調整し、必要な情報を共有することで、累積的な影響を考慮した事業計画とすること"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "風力発電設備の稼働に伴う騒音及び風車の影による生活環境への影響を極力低減する観点から"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "風力発電設備の稼働に伴う騒音及び風車の影による生活環境への影響を極力低減する観点から"@ja.
<< kg:id_1 prop:cause kg:id_17 >>
    prop:text-txt_contents "風力発電設備の稼働に伴う騒音及び風車の影"@ja.
<< kg:id_1 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "騒音及び風車の影による生活環境への影響が生じるおそれのある住居に対して、環境保全措置及びその効果を含む十分な事前説明を実施すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "騒音に係る環境監視及び風車の影に係る事後調査を実施すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "騒音に係る環境監視及び風車の影に係る事後調査を実施すること"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "鳥類の風力発電設備への衝突や移動経路の阻害等に係る環境影響評価"@ja.
<< kg:id_1 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "鳥類の風力発電設備への衝突や移動経路の阻害等に係る環境影響評価"@ja.
<< kg:id_1 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "稼働後のバードストライクの有無に係る事後調査を適切に実施すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "渡り鳥の移動経路等に係る調査"@ja.
<< kg:id_1 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "ブレード塗装やシール貼付等の鳥類からの視認性を高める措置"@ja.
<< kg:id_1 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "渡り鳥の衝突のおそれが高い季節及び時間帯の稼働調整等の追加的な環境保全措置を講ずること"@ja.
<< kg:id_1 prop:cause kg:id_27 >>
    prop:text-txt_contents "稼働後においてバードストライクが発生した場合"@ja.
<< kg:id_1 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "稼働後においてバードストライクが発生した場合の措置の内容を事前に定め"@ja.
<< kg:id_1 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "重要な鳥類の衝突等による死亡・傷病個体が確認された場合は、確認位置や損傷状況等を記録する"@ja.
<< kg:id_1 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "関係機関との連絡・調整"@ja.
<< kg:id_1 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "死亡・傷病個体の搬送"@ja.
<< kg:id_1 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "関係機関による原因分析及び傷病個体の救命への協力を行うこと"@ja.
<< kg:id_1 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "重要な植物に係る環境保全措置として、改変により消失する割合が高い植生については、可能な限り移植を行うこととしている"@ja.
<< kg:id_1 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "風車敷の設置場所、設計及び工法に関して更なる検討を行い"@ja.
<< kg:id_1 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "海岸砂丘植生の改変を回避又は可能な限り最小限に抑えること"@ja.
<< kg:id_1 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "移植後の植物の定着状況に係る事後調査を適切に実施すること"@ja.
