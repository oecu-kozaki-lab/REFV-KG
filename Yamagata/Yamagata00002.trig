kg:st_1 rdfs:label "東委員"@ja.
kg:st_1 rdfs:type cls:st_3.
cls:st_3 rdfs:label "委員"@ja.
kg:op_1 prop:content "土砂の持ち込みは植生と関わるため外来種混入に十分配慮すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "内田委員"@ja.
kg:st_2 rdfs:type cls:st_3.
kg:op_2 prop:content "事前説明や相談窓口の明確化など丁寧な住民対応が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "住民に直接影響があることを事後対応にすると不信感が広がる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "関係自治体と事前協議し住民説明と相談体制を整えるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "事業者"@ja.
kg:st_3 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_5 prop:content "酒田市と遊佐町と協議し説明会や書面周知など開催方法も含め連携したい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "住宅ごとに対応が異なるため自治体との密接な協議が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "住宅への個別対策としてケースにより実施しうる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "個別対応となるため自治体との協議が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "住宅への個別対策として実施可能性を検討する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "住宅ごとの事情に応じた対応が必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "住宅への個別対策としてケースによっては植栽もある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:st_4 rdfs:label "小杉委員"@ja.
kg:st_4 rdfs:type cls:st_3.
kg:op_12 prop:content "学校等には一般住宅以上に積極的で丁寧な対応が望ましい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "訪問や事後調査の必要性を検討したい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:st_5 rdfs:label "江成委員"@ja.
kg:st_5 rdfs:type cls:st_3.
kg:op_14 prop:content "科学的に検証されたものを使用すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:st_6 rdfs:label "横山会長"@ja.
kg:st_6 rdfs:type cls:st_4.
cls:st_4 rdfs:label "会長"@ja.
kg:op_15 prop:content "利用可能な科学的データを集積し正しい判断をすべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:st_7 rdfs:label "工藤委員"@ja.
kg:st_7 rdfs:type cls:st_3.
kg:op_16 prop:content "回避能力は不明であり調査を密に行うべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_7.
kg:op_17 prop:content "小型個体は死骸が確認されにくい可能性があり調査頻度を上げるべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_7.
kg:op_18 prop:content "事後調査では死骸調査の頻度を上げ見落とし防止に努める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "見落とし防止のため調査を密にしてほしい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_7.
kg:op_20 prop:content "週一回程度としている死骸調査の頻度をあげる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "6月から11月の20時から23時はカットイン風速を上げられる機種を希望する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_7.
kg:op_22 prop:content "余裕度のある風車を選定できるようメーカーに伝えている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "回避行動の実態を丁寧に確認すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_7.
kg:op_24 prop:content "全国規模で累積的な衝突影響を把握する仕組みが必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_7.
kg:op_25 prop:content "国レベルで情報を取りまとめる必要がある"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "理論値だけでなく実測値からモデルを作るべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_7.
kg:op_27 prop:content "データ収集を進め現在のモデルより適したモデルの構築を検討する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:st_8 rdfs:label "中島委員"@ja.
kg:st_8 rdfs:type cls:st_3.
kg:op_28 prop:content "倒壊や液状化を踏まえた基礎工法の理由を明確にすべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_8.
kg:op_29 prop:content "砂の移動への影響を考えるべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_8.
kg:op_30 prop:content "安全面だけでなく環境面も踏まえて検討する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "長大な杭が地中に残ることは将来的な環境上気になるため記録と報告が必要"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_8.
kg:op_32 prop:content "残置か全撤去か協議し記録を残す"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "既設より高い新設風車でも死骸調査を行い予測の妥当性を確認すべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:op_34 prop:content "新設後は今以上に密に調査を行う"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "モデルの説明量が低ければ意味がないため示すべき"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "どのように数値を入れたか示すよう努める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "実施後に実測値をモニタリングすべき"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "白いブレードに黒い色を塗ることで鳥が認識できるようにしたい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:st_9 rdfs:label "池田委員"@ja.
kg:st_9 rdfs:type cls:st_3.
kg:op_39 prop:content "希少植物がある場所は避けて位置変更を検討すべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_9.
kg:op_40 prop:content "希少植物のある場所を極力避けるべき"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_9.
kg:op_41 prop:content "詳細設計段階で改変がないよう回避し避けられない場合も最小限化する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "移植や播種の詳細計画を示すべき"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_9.
kg:op_43 prop:content "評価書で検討したい"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "北側ヤード整備がある場合は希少植物やクロマツ林への影響に注意すべき"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_9.
kg:op_45 prop:content "重要な植物やクロマツなどへの影響が最小限となるヤード計画にする"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "移植後に外来種に負けないよう継続的に確認すべき"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_5.
kg:op_47 prop:content "移植しただけで終わらせず在来植生化を確認すべき"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "不確実性があるためモニタリングしながら進める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "垂直見込角9.8度と9.9度は圧迫感を受けると考える"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_9.
kg:op_50 prop:content "数値だけで切らず実際の感じ方に沿って評価すべき"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_6.
kg:op_51 prop:content "実際の角度や遮蔽を踏まえた説明を加えるべき"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_9.
kg:op_52 prop:content "植栽によって隠れる部分を評価書段階で検討する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "累積的影響は上のレベルで配慮が必要"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:op_54 prop:content "イヌワシやクマタカは行動圏が広いため山形県側も評価対象にすべき"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_5.
kg:op_55 prop:content "山形県側の状況に精通した専門家の意見を聞くべき"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "風車周辺だけでなく連続した生息地全体で評価すべき"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_5.
kg:op_57 prop:content "専門家ヒアリングも含め必要な調査を検討する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_3.
kg:op_58 prop:content "人の景観だけでなく動物への配慮を踏まえた塗装を選ぶべき"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:op_59 prop:content "鳥類調査結果を基に色付けなどの保全対策を検討する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_3.
kg:op_60 prop:content "県境を跨ぐ緑の回廊を分断しないよう配慮すべき"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_9.
kg:op_61 prop:content "改変面積をできるだけ最小にする視点で検討する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:op_62 prop:content "東北自然歩道を拡幅する場合は人との触れ合いの場への配慮が必要"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "搬入路として使う場合の配慮を検討すべき"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_9.
kg:op_64 prop:content "道路拡幅や風車建設では地盤災害に十分注意すべき"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_8.
kg:op_65 prop:content "沢の下流のダムや水源に配慮しながら計画を進めるべき"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_8.
kg:op_66 prop:content "誤解防止のため事業者が早めにフォトモンタージュを示すべき"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_5.
kg:op_67 prop:content "見えない眺望点が独り歩きすると誤解を生む"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "ネット記事だけで実態を知らず印象が変わることが怖い"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_9.
kg:op_69 prop:content "出所を明確にしたフォトモンタージュで誤解を防ぐべき"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_5.
kg:op_70 prop:content "住民説明会で可能な範囲で丁寧に説明し地点の準備を進める"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_3.
kg:op_71 prop:content "神社や信仰対象を含む住民が気にする地点を加えるべき"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_5.
kg:op_72 prop:content "説明会等で意見を集約し住民の意見を踏まえて地点を選ぶ"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_3.
kg:op_73 prop:content "事業者は住民との対話の重要性をもっと認識すべき"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_9.
kg:op_74 prop:content "説明が不十分である部分は否めない"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_6.
kg:op_75 prop:content "温泉街の住民なら突然の計画提示に賛成しないはず"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_9.
kg:op_76 prop:content "寝耳に水で計画を聞くことが多く進め方に問題がある"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_6.
kg:op_77 prop:content "地元の蔵王への思いが深いため丁寧な説明が必要"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_6.
kg:op_78 prop:content "住民説明会で可能な範囲で丁寧に説明したい"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "土砂をどこから持ってくるかは植生とも絡みますが、不要な外来種の種などの混入リスクもあるので、十分な配慮が必要と思われます。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今回大型の発電機に変えたことによって、参照値を超える状況が発生する住宅が相当数あると予測されており"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "今回のように住民に直接影響があることを事後対応の形で行うと、再エネ関係の施設に対する不信感が国内のいろいろなところで、どんどん広がっていくと考えられます。"@ja.
<< kg:id_3 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "説明会の実施や相談窓口を明確にしておくなど、丁寧な住民対応について関係自治体である酒田市や遊佐町と事前に協議を行うことが必要と考えます。"@ja.
<< kg:id_3 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "対応措置として準備書には、遮光カーテンの設置、ブラインド設置、植栽等の適切な対応を検討するとあり"@ja.
<< kg:id_3 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "対応措置として準備書には、遮光カーテンの設置、ブラインド設置、植栽等の適切な対応を検討するとあり"@ja.
<< kg:id_3 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "対応措置として準備書には、遮光カーテンの設置、ブラインド設置、植栽等の適切な対応を検討するとあり"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "学校等は特に配慮が必要な施設として挙げているので、影がかかることなどについて事前に丁寧な説明や事後調査を進んで行うなど、積極的かつ丁寧な対応をとることが望ましいと思います。"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "ブレードの彩色について、科学的に検証されたものを使用してくださいという意見です。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "風車のように高速度で回転する物体を超音波で避けて飛翔できるかについては、研究でも実証されておらず、未解明な部分であります。"@ja.
<< kg:id_14 prop:effect kg:id_16 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_17;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "コウモリ類は、実際に死骸等が確認されていますので、幾らかは衝突する確率があります。"@ja.
<< kg:id_14 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_19;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "事後調査においては、週一回程度としている死骸調査の頻度をあげることで、見落としを防止するよう努めて参ります。"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_21;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "時期と時間帯によってカットイン風速を変えることは可能かとの質問に対して、機種により異なります"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "風車列に対して平行に飛翔しており、また、比較的風車を避けやすい配置になっていることも関連して、今回こうした渡り鳥のオナガガモ、マガモ、マヒワといった鳥の死骸が確認されなかった"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_24;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "全国規模での積算値はそれなりに大きくなると思われませんか。"@ja.
<< kg:id_12 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_26;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "理論値だけではなく、実測値からモデルを作っていただけると、より正しい値が出てくると思いますので、よろしくお願いいたします。"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "この地域は地震が非常に多いので地震や津波、場所が海岸なので液状化"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_29;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "4号機5号機は砂地なので、大きな基礎を広く浅いところに埋めたときに、砂の移動の方向が変わるかと思います。"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_31;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "杭の大きさが横幅数十センチや1メーターのもので、長さが何十メートルというものが、何本も地中に残ったままなのは、将来的な環境が気になります"@ja.
<< kg:id_31 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "新設の風車は既設の風車よりも高度が高いので、新設の風車でも死骸調査をして、実測値でも少ない結果になるのかを検証していただきたい。"@ja.
<< kg:id_33 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "実際にモデルを使って予測した時に、そのモデルの説明量がどのくらいなのかを資料に記載していただきたい。"@ja.
<< kg:id_35 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "白いブレードに黒い色を塗ることでコントラストが生じますので、そうしたコントラストを加えながら、鳥が風車を認識できるように環境保全対策をしたい"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "今回新設される風車、特に№4の地点がイソスミレの群生地になっております。"@ja.
<< kg:id_37 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_40;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "今後詳細設計をしていく段階で、当然そうした改変がないように、改変の回避または、どうしても避けられない場合については、可能な限り最小限にするよう努めて参りたい"@ja.
<< kg:id_37 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_42;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "保全計画から移植と播種を行うとありますが、計画について見えてきません。"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_44;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "近くにはイソスミレもそうですが、クロマツ林などがあって、そちらの方の影響も懸念されます。"@ja.
<< kg:id_43 prop:effect kg:id_44 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "庄内海岸はアメリカンビーチグラスが広範囲に繁茂しているようなので、その場で根を根絶しても外からまた入る可能性がとても高いと思います。移植した後、外来種に負けて在来種が定着できなかったとならないように気をつけていただきたい。"@ja.
<< kg:id_43 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "その後どうなるのか不確実性を伴いますので、モニタリングしながら随時状況を確認し進めて参りたい"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_49;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "比子地区と宮海地区の垂直見込角ですが、1053頁には9.8及び9.9度となり、圧迫感を与えるには至らないと予測すると書いてあります。"@ja.
<< kg:id_46 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_51;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "実際に見えるか見えないかという、植栽によって隠れる部分に関しては、評価書の段階で検討させていただければと思っております。"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "累積的な影響について、先程も議題に上がっていましたが、スケール感がそれぞれ違うのが一番問題"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_54;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "イヌワシやクマタカの行動圏は広いので、山形県にも影響してくるはずです。"@ja.
<< kg:id_51 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_56;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "イヌワシやクマタカの生息地は風車の周辺のみならず、そこからしばらく連続していると思いますので、連続した生息地一体で予測評価をしていただきたい。"@ja.
<< kg:id_54 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "バードストライクやバットストライクのことを考慮したデザインの塗装を選んでいただきたいと思います。"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_60;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "西側には緑の回廊があり県境を跨いでいるので、分断をしないよう考慮していただきたい。"@ja.
<< kg:id_56 prop:effect kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "東北自然歩道が七ヶ宿の街道沿いにあります。現在、自然歩道は山道ではなく一般道になっていますので、それを拡幅すると人との触れ合いの場などの配慮が必要になるかと思います"@ja.
<< kg:id_59 prop:effect kg:id_60 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "こういうところに道路を作ったり拡幅したり、風車を建てる現地の工事もそうですが、尾根に何か作ると必ず地盤災害等が起きますので十分注意していただきたい。"@ja.
<< kg:id_59 prop:effect kg:id_61 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "沢を下った先にダムがあり重要な水源になっていると思いますので、地元にも配慮しながら十分注意してください"@ja.
<< kg:id_62 prop:effect kg:id_63 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_66;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "大きく見えるなどの誤解を防ぐためにも、事業者がフォトモンタージュを作った方がよい"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_69;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "フォトモンタージュに事業者のコピーライトをつけて早めに流した方が、誤解を防ぐためにもよいと思います。"@ja.
<< kg:id_64 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_71;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "一般の方は気にしていない神社や信仰の対象になっている部分も、住民が気にしていればフォトモンタージュ地点に加えた方が、あつれきは少なくて済むかと思います。"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_73;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "問題なのは、事業者が丁寧な説明を住民にしないで突然話を持ってきたのが良くなかったと思います。"@ja.
<< kg:id_67 prop:effect kg:id_69 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_75;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "自分が蔵王の温泉街に住んでいて、突然話を持ってこられたら賛成はしないはずですね。"@ja.
<< kg:id_67 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_77;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "ぜひ丁寧に住民の方への説明をしていただきたいと思います。"@ja.
}
