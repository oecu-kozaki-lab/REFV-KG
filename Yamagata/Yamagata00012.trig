kg:id_21 rdf:type cls:c_193.
cls:c_193 rdfs:label "累積悪化"@ja.
kg:id_1 prop:effect kg:id_21.
kg:id_22 rdfs:label "もともと何もなかった状態の環境を最大限維持する観点で評価する"@ja.
kg:id_22 rdf:type cls:c_194.
cls:c_194 rdfs:label "環境維持"@ja.
kg:id_1 prop:contermeasure kg:id_22.
