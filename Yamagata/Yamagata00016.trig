PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Yamagata/00016> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "JRE酒田風力発電所更新計画"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "事業実施想定区域周辺の状況写真の撮影"@ja.
kg:id_2 rdf:type cls:c_204.
cls:c_204 rdfs:label "状況写真撮影"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "写真位置図の作成"@ja.
kg:id_3 rdf:type cls:c_205.
cls:c_205 rdfs:label "位置図作成"@ja.
kg:id_1 prop:countermeasure kg:id_3.
kg:st_1 rdfs:label "山形県環境ｴﾈﾙｷﾞｰ部みどり自然課"@ja.
kg:st_1 rdf:type cls:st_12.
cls:st_12 rdfs:label "行政部局"@ja.
kg:op_1 prop:content "計画段階環境配慮書をもとに写真位置図を作成"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "ＪＲＥ酒田風力発電所更新計画 事業実施想定区域周辺の状況写真 山形県環境ｴﾈﾙｷﾞｰ部みどり自然課撮影"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "写真位置図 「JRE 酒田風力発電所更新計画 計画段階環境配慮書」をもとに山形県環境ｴﾈﾙｷﾞｰ部みどり自然課作成"@ja.
}
