kg:id_28 rdf:type cls:c_270.
cls:c_270 rdfs:label "生物調査"@ja.
kg:id_24 prop:contermeasure kg:id_28.
kg:id_29 rdfs:label "鳥類相把握のため音声データ取得の併用を検討すること"@ja.
kg:id_29 rdf:type cls:c_228.
cls:c_228 rdfs:label "影響評価"@ja.
kg:id_24 prop:contermeasure kg:id_29.
