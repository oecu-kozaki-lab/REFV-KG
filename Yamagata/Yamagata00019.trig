cls:c_1 rdfs:label "事業"@ja.
kg:id_25 rdfs:label "影や騒音や景観の現地調査を行うこと"@ja.
kg:id_25 rdf:type cls:c_267.
cls:c_267 rdfs:label "現地調査"@ja.
kg:id_24 prop:contermeasure kg:id_25.
kg:id_26 rdfs:label "累積的影響を他事業者の情報をもとに予測すること"@ja.
kg:id_26 rdf:type cls:c_268.
