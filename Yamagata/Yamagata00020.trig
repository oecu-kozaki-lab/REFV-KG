PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Yamagata/00020> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "ＪＲＥ酒田風力発電所更新計画環境影響評価方法書"@ja.
kg:id_1 rdf:type cls:c_161.
cls:c_161 rdfs:label "環境影響評価"@ja.
kg:id_2 rdfs:label "山形県環境影響評価審査会で審議"@ja.
kg:id_2 rdf:type cls:c_178.
cls:c_178 rdfs:label "審議"@ja.
kg:id_1 prop:contermeasure kg:id_2.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:text-txt_contents "議題 ＪＲＥ酒田風力発電所更新計画環境影響評価方法書について"@ja.
}
