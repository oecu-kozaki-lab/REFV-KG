kg:st_1 rdfs:label "横山委員"@ja.
kg:st_1 rdfs:type cls:st_3.
cls:st_3 rdfs:label "委員"@ja.
kg:op_1 prop:content "生物の生育可能性や影響把握には既往調査情報が不十分である"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "事務局"@ja.
kg:st_2 rdfs:type cls:st_10.
cls:st_10 rdfs:label "事務局"@ja.
kg:op_2 prop:content "指摘内容について事業者に指導する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "引用文献が少なく動植物の把握が不十分である"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_3 rdfs:label "大山委員"@ja.
kg:st_3 rdfs:type cls:st_3.
kg:op_4 prop:content "使っている文献が少なく文献不備が大きな問題である"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "動植物の生育可能性が把握できず評価できない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_4 rdfs:label "後藤委員"@ja.
kg:st_4 rdfs:type cls:st_3.
kg:op_6 prop:content "自然エネルギー開発でも慎重な取り組みが必要である"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:op_7 prop:content "過去の改変のように動植物消失を繰り返すべきでない"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:op_8 prop:content "以前の経験を生かし慎重に進めるべきである"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "リスト内容が誤っており信頼性に問題がある"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "重要種の抽出が少なく実態を過小評価している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "同じ文献でも記載が異なるため再確認が必要である"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "沿岸部の渡りルートを前提に広域的な把握が必要である"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "渡りの実態が不明では影響評価できない"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "渡り鳥のルートや時期をきちんと調査すべきである"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:st_5 rdfs:label "柳澤委員"@ja.
kg:st_5 rdfs:type cls:st_3.
kg:op_15 prop:content "基盤情報がなく自立構造の妥当性を確認できない"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_5.
kg:op_16 prop:content "液状化による支持力喪失が懸念される"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:op_17 prop:content "断面図と地質強度の資料を示すべきである"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_5.
kg:op_18 prop:content "貴重な繁殖地への施設設置は強い懸念がある"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "コアジサシへの影響は避けなければならない"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "事業により長年の繁殖地が失われてはならない"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "影響回避のため継続調査を事業者に要請する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:st_6 rdfs:label "早野委員"@ja.
kg:st_6 rdfs:type cls:st_3.
kg:op_22 prop:content "景観調査の方法をより具体的に示す必要がある"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:op_23 prop:content "主観に左右されない客観的判断が必要である"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_6.
kg:op_24 prop:content "詳細なモンタージュや定量的調査を行うべきである"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_6.
kg:st_7 rdfs:label "東委員"@ja.
kg:st_7 rdfs:type cls:st_3.
kg:op_25 prop:content "砂丘上への建設は長期的な地形変化を伴う懸念がある"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_7.
kg:op_26 prop:content "長いスパンで地形後退が進むおそれがある"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_7.
kg:op_27 prop:content "長期的な地形変化を調査すべきである"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_7.
kg:st_8 rdfs:label "小杉委員"@ja.
kg:st_8 rdfs:type cls:st_3.
kg:op_28 prop:content "短期間調査では気象変動を反映できない"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_8.
kg:op_29 prop:content "冬の強風や低温などの条件を踏まえた評価が必要である"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_8.
kg:op_30 prop:content "住民が納得できるよう新ガイドラインで評価すべきである"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_8.
kg:st_9 rdfs:label "小田原委員"@ja.
kg:st_9 rdfs:type cls:st_3.
kg:op_31 prop:content "同じルート利用なら施工時も複合影響を評価すべきである"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_9.
kg:op_32 prop:content "重なる場合は騒音だけでなく動植物も含めて複合影響を見る必要がある"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:st_10 rdfs:label "企業局"@ja.
kg:st_10 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_33 prop:content "重なることは避けたいと考えている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_10.
kg:op_34 prop:content "施設の影が植物群落に与える影響を見落とすべきでない"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "日陰の範囲と時間を把握し影響を明確にすべきである"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:st_11 rdfs:label "玉野総合コンサルタント"@ja.
kg:st_11 rdfs:type cls:st_1.
kg:op_36 prop:content "時刻ごとの影の状況を調査し準備書に記載する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_11.
kg:op_37 prop:content "砂浜上の仮設道路の強度や安定性に疑問がある"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_6.
kg:op_38 prop:content "工事中の流出による海域や水質への影響が懸念される"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_6.
kg:op_39 prop:content "保全対策を検討し工事仕様書に明記して遵守させる"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_11.
kg:op_40 prop:content "大型台風時の海浜や水質への影響も懸念される"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "最新資料だけでは不十分で多様な文献に基づくべきである"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "実施区域周辺の状況把握には多くの文献収集が基本である"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "手法が不明では調査地点の妥当性を判断できない"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "位置が少しずれただけで改変環境が大きく変わる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "手法を明示し追加調査を行うべきである"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:st_12 rdfs:label "八千代エンジニヤリング"@ja.
kg:st_12 rdfs:type cls:st_1.
kg:op_46 prop:content "コドラート調査を行い地点数も明確に記載する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_12.
kg:op_47 prop:content "図表を対応させ生態系の説明を丁寧に記載すべきである"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "区分が粗く何を示したいのか分からない"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "表現を修正し選定理由と出典を記載する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_12.
kg:op_50 prop:content "集団繁殖種の全体像を把握できる範囲設定が必要である"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "コアジサシの広い範囲での繁殖活動を捉える必要がある"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:op_52 prop:content "繁殖範囲をきちんと把握できる調査を求める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:op_53 prop:content "把握できるよう調べる"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_12.
kg:op_54 prop:content "鳥類の餌場である海域との関係を無視すべきでない"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_4.
kg:op_55 prop:content "風車による砂浜影響を介して海の魚や生物に影響する懸念がある"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_4.
kg:op_56 prop:content "生態系の中でその考え方を含めて検討する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_12.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "既往調査による情報の収集が不十分で、周辺でどういう生物が生育している可能性があり、それに対してどういう影響がありそうなのか十分把握できない内容となっています。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "方法書の39ページから51 ページの、たとえば生物種のリスト作成にあたり引用されている文献が少なく、ほかに生育している可能性のある動植物が十分リストアップされていない状況です。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "ほかに生育している可能性のある動植物が十分リストアップされていない状況です。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "やはり、風力をはじめとする自然エネルギーなど新たな改変を進めていくときには慎重な取り組み、あるいは以前の経験を生かすなど、同じ苦い思いをしないような対応が必要です。"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "以前、農薬により多くの動物がいなくなったり、また、いろいろな改変が行われて動植物がいなくなったということがあり"@ja.
<< kg:id_5 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "風力をはじめとする自然エネルギーなど新たな改変を進めていくときには慎重な取り組み、あるいは以前の経験を生かすなど、同じ苦い思いをしないような対応が必要です。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "RDBの欄に記載されているものが、④のレッドデータブックやまがたの欄に入っていないのはおかしいと思います。それから、オオヨシキリの科名が間違って「ヒタキ」と記載されております。"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "鳥類ですと、ここでは重要な種として17種類いるとされていますが、一方で、以前に示された同じ庄内地域での事業の方法書では、同じRDBから80種類が選定されていて、この方法書では、かなりかいつまんで記載されている状況です。"@ja.
<< kg:id_9 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "どちらかが間違っていると思うのですが、もう一度チェックしていただきたいと思います。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "風力発電ということで、どうしても沿岸部の渡り鳥のルートになっているわけですが、日本海側は風力発電施設が数多く設置されていて、秋田県でも砂丘地帯に多くの風力発電施設が連なっています。"@ja.
<< kg:id_13 prop:effect kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "渡りのルートがどのようになっていて、どのような種類の鳥がいつごろどのように渡ってくるのかという調査をきちんと行う必要があると思います。"@ja.
<< kg:id_13 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "こういう機会に、渡りのルートがどのようになっていて、どのような種類の鳥がいつごろどのように渡ってくるのかという調査をきちんと行う必要があると思います。"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "ところが、方法書には表層地質しか書いていない。ボーリング調査はあったはずですが、基盤がどうなっているのかの情報がありません。"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "地震があったときに液状化して砂が全部動いてしまうことも考えられます。"@ja.
<< kg:id_17 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "断面図や地下の地質の強度がわかるものを示していただき、そこに杭を打って自立したものとなるということがわかる資料を示していただきたいと思います。"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "この周辺では、非常に貴重なコアジサシが広い範囲で集団繁殖していて、その全体像がどうなっているのかを見る必要があります。...風力発電施設の設置による影響が非常に心配です。"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "ですから、この事業によりこのような場所がなくなってしまうことはあってはならないわけです。"@ja.
<< kg:id_21 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "そのための調査は継続して行う必要があり、これについては事業者に要請していく必要があります。"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "方法書の135ページでは、景観についての調査の内容等について記載がありますが、もう少し具体的に記載していただきたいと思います。"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "フォトモンタージュを作成したときの良し悪しの判断にいついては、人によって異なります。"@ja.
<< kg:id_25 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "詳細なモンタージュの作成あるいは定量的な調査については、事業者にお願いしたい項目の一つです。"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "庄内砂丘というのは、先人たちが飛砂を防ぐために約50年かけて作った砂丘で、今、その上に風力発電施設を建てようとしているわけです。"@ja.
<< kg:id_29 prop:effect kg:id_31 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "場所によっては１年間に３メートル以上砂浜が後退しているというデータもあります。そうなると、風車を建てて稼動期間に少しずつ足元がすくわれるということも起こり得ると思う"@ja.
<< kg:id_29 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "長いスパンでの地形の改変についてもどこかで調査していただく必要があると思います。"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "１日24時間調査すると記載されていて、これでは不十分ではないか...２日間でも十分なのかと感じています。"@ja.
<< kg:id_33 prop:effect kg:id_35 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "庄内地方は冬の強風、低温など気象条件が変わるわけで、そうすると、音の伝わり方などが変わってきます。そのような条件の中で１日や２日で十分調べられるのかと思います。"@ja.
<< kg:id_33 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "環境省が風力発電機から発生する騒音等に関するガイドラインを作成中とのことなので、新しいガイドラインに基づく予測、評価を行い、住民が納得できるようにすべきです。"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "工事用資材の搬入ルートが同じルートであることから、工事がほぼ同じ時期であるとすれば、施工時についても双方合わせた複合影響を見る必要があると思います。"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "重なる場合は、稼動時の騒音だけでなく、動植物等も含めて複合影響を見る必要があります。...最も影響が大きくなる場合を想定し予測、評価することが必要"@ja.
<< kg:id_37 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "どちらが先行するかということは別として、重なることは避けたいと考えております。"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "風力発電施設の影により、通常十分な光が当たっているところがそうでなくなる可能性があり、その影響がどの程度なのかということです。"@ja.
<< kg:id_41 prop:effect kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "通常十分な光が当たっているところがそうでなくなる可能性があります。"@ja.
<< kg:id_41 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "１日に何時間くらい影ができるのか、太陽高度によって影の大きさも違ってきますし、それらを時刻ごとに調査しその結果は準備書で記載したいと思います。"@ja.
<< kg:id_45 prop:cause kg:id_46 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "仮設道路は砂浜の上に鉄板を敷いて設置すると説明を受けたのですが、砂浜に鉄板を敷いただけで重量のあるトラックの走行に耐えられるのか"@ja.
<< kg:id_45 prop:effect kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "工事中についてはトラック等に付着している油、あるいは、現地で打設するコンクリートなどが流れ出る可能性があると思います。"@ja.
<< kg:id_45 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "砂浜に油脂類が散らばらないよう保全対策を検討します。また、施工業者が決定した段階で、工事の仕様書にそのような対策を明記し遵守してもらうよう指導していくこととなります。"@ja.
<< kg:id_45 prop:effect kg:id_49 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "先月のような大型の台風が日本海側に来た時は相当波をかぶって、その際に砂が持っていかれたときに仮設道路が水質等へ影響を与えるのではないか"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "「既存文献の中で最新の資料を用いて整理を行いました」とありますが、...最新の調査結果だけでなく、十分な文献をもとに調査をしていただきたいです。"@ja.
<< kg:id_50 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "第３章につきましては、実施区域及びその周辺の状況を把握するため、できる限り多くの文献からデータを収集することが基本となります。"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "方法書124ページの植物に関する調査の基本的な手法として「植物相調査」、「植生調査」、「群落組成調査」と記載されていますが、具体的に何をするのかが記載されていません。"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "少し位置がずれただけで改変される環境が大きく変わる可能性がありますので、こういったことが把握できるような調査を追加して行う必要がある"@ja.
<< kg:id_53 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "先ず調査手法を明確にしていただき、手法との関連で調査地点を示していただきたいと思います。...コドラートによる調査を考えています。また、調査地点数としては、周辺で確認されている群落を考慮し12箇所程度で実施することを考えています。"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "方法書58ページの生態系の状況ですが、58ページに表が、59ページに図があります。表では「自然環境累計区分」という表現を使っていて、図では「環境累計区分」と少し名称が違っています。...ただ漠然と代表的な動植物種が載っていて、生態系がどうなっているのかがよくわかりません。"@ja.
<< kg:id_57 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "まず、表現については修正して統一した記述とします。...そのような選定理由も記載します。また、出典についてもしっかり記載いたします。"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "集団繁殖を行う種類については、例えば赤川よりもっと南であるとか、全体を把握できるような調査をしていただきたい。"@ja.
<< kg:id_60 prop:effect kg:id_62 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "コアジサシなどは集団繁殖しているので、１箇所に固まっているわけではなくて、かなり離れた広い範囲で繁殖活動をすると思う"@ja.
<< kg:id_60 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "繁殖範囲をきちんと把握できる調査を行うと理解してよろしいですか。...はい、把握できるよう調べてまいります。"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "海域については調査しないとのことですが、コアジサシ等の鳥類と海とは魚をとる餌場として切っても切れない関係である"@ja.
<< kg:id_64 prop:effect kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "風車が魚に直接影響は与えないかも知れませんが間接的な影響はあると思います。風車による砂浜への影響を介して海の魚にどのような影響を与えるかという調査も重要だと思います。"@ja.
<< kg:id_64 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "生態系という位置づけの中で重要な考えであることは認識しております。...生態系のなかでそういった考え方を含めて検討してまいりたいと思います。"@ja.
}
