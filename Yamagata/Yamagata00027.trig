kg:op_38 prop:content "活動の場への影響を適切に評価し必要な環境保全措置を検討すべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "設置者管理者利用者地域住民関係自治体の意見を踏まえ必要な環境保全措置を検討すべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業実施想定区域の周辺においては、他事業者による風力発電事業が供用中又は環境影響評価手続中であることから、これらの風力発電設備等による累積的な影響が懸念される"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本事業の実施による重大な影響等を回避又は十分に低減できない場合は、風力発電設備等の配置等の再検討"@ja.
<< kg:id_3 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本事業の実施による重大な影響等を回避又は十分に低減できない場合は、対象事業実施区域の見直し"@ja.
<< kg:id_3 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "本事業の実施による重大な影響等を回避又は十分に低減できない場合は、基数の削減を含む事業計画の見直しを行うこと"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "事業実施想定区域の近傍には、複数の住居等が存在しており、工事中及び供用時における騒音による生活環境への重大な影響が懸念される"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "工事中及び供用時における騒音による生活環境への重大な影響が懸念される"@ja.
<< kg:id_9 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "配置位置の変更、単基出力の増加、工事用資材の搬出入等による騒音等に係る生活環境への影響について適切に調査、予測及び評価を行うこと"@ja.
<< kg:id_9 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "その結果を踏まえ、風力発電設備等を住居等から離隔すること等により、騒音等による生活環境への影響を回避又は極力低減すること"@ja.
<< kg:id_13 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "事業実施想定区域の近傍には、複数の住居等が存在しており、本事業で設置が予定されている風力発電設備については"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "既設風力発電設備に比べ、ハブの高さ及びブレードの長さが増加する計画であることから、供用時における風車の影による生活環境への重大な影響が懸念される"@ja.
<< kg:id_13 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "供用時における風車の影による生活環境への重大な影響が懸念される"@ja.
<< kg:id_13 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "代表地点における既設風力発電設備の風車の影について調査を実施するとともに"@ja.
<< kg:id_13 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "その結果を踏まえ、風力発電設備を住居等から離隔すること等により、風車の影による生活環境への影響を回避又は極力低減すること"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "事業実施想定区域及びその周辺は、希少猛禽類であるチュウヒ、オジロワシの生息が確認されている"@ja.
<< kg:id_17 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "同区域の南側には、ハクチョウ類等の集団繁殖地として国指定鳥獣保護区に指定されている最上川河口鳥獣保護区が存在し"@ja.
<< kg:id_17 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "渡り鳥の主要な渡り経路となっている可能性がある"@ja.
<< kg:id_17 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "本事業で設置を予定している風力発電設備については、既設風力発電設備に比べ、ハブの高さやブレードの長さが増加する計画であることから"@ja.
<< kg:id_17 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "本事業の実施により、風力発電設備への衝突事故や移動経路の阻害等による鳥類の生息等及び渡りへの重大な影響が懸念される"@ja.
<< kg:id_17 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "本事業の実施により、風力発電設備への衝突事故や移動経路の阻害等による鳥類の生息等及び渡りへの重大な影響が懸念される"@ja.
<< kg:id_17 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "鳥類の生息等及び渡りへの重大な影響が懸念される"@ja.
<< kg:id_17 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "専門家等からの助言を踏まえ、鳥類に関する調査及び予測を行い、影響を評価すること"@ja.
<< kg:id_17 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "高度も含めた飛翔の経路を客観的に把握できるよう時期・時間帯、回数、区域等を含む適切な調査方法により調査を実施し"@ja.
<< kg:id_17 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "重大な影響が懸念される場合は、主な渡りの経路及び餌場への移動経路を避けるとともに可能な限り距離を確保した上で"@ja.
<< kg:id_17 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "必要に応じ追加的な環境保全措置を講ずることにより、鳥類への影響を回避又は極力低減すること"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "事業実施想定区域には、自然環境保全基礎調査の第２回調査において特定植物群落に選定されている「庄内砂丘クロマツ林」"@ja.
<< kg:id_29 prop:cause kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "同調査の第６回・第７回調査において植生自然度が高いとされた砂丘植生等が存在することから"@ja.
<< kg:id_29 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "本事業の実施により、植物及び生態系への影響が懸念される"@ja.
<< kg:id_29 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "専門家等からの助言を踏まえ、現地調査により自然度の高い植生等が存在する区域及び保全の必要性が高い植物群落を明らかにした上で"@ja.
<< kg:id_29 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "既存道路及び風力発電設備等の撤去された用地等を活用することにより、これらの重要な自然環境の改変を回避又は極力低減すること"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "事業実施想定区域及びその周辺には、主要な眺望点である「酒田北港」及び「酒田北港緑地展望台」等が存在しており"@ja.
<< kg:id_34 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本事業の実施により、これら眺望点からの重要な眺望景観に対する影響が懸念される"@ja.
<< kg:id_34 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "主要な眺望点の設置者又は管理者、利用者、地域住民及び関係自治体等の意見を踏まえ、適切に調査、予測及び評価を行うこと"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "事業実施想定区域には、「宮海海水浴場」が存在しており"@ja.
<< kg:id_38 prop:cause kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "直接改変による影響のほか"@ja.
<< kg:id_38 prop:cause kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "工事中及び供用時の騒音"@ja.
<< kg:id_38 prop:cause kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "供用時の風車の影"@ja.
<< kg:id_38 prop:cause kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "景観変化等によるこれらの人と自然との触れ合いの活動の場への影響が懸念される"@ja.
<< kg:id_38 prop:effect kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "これらの人と自然との触れ合いの活動の場への影響が懸念される"@ja.
<< kg:id_38 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "当該人と自然との触れ合いの活動の場の設置者又は管理者、利用者、地域住民及び関係自治体等の意見を踏まえ、適切に調査、予測及び評価を行い、必要な環境保全措置を検討すること"@ja.
}
