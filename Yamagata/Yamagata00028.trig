PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Yamagata/00028> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "植生自然度の高い区域での改変"@ja.
kg:id_1 rdf:type cls:c_382.
cls:c_382 rdfs:label "自然植生"@ja.
kg:id_2 rdfs:label "出来る限り回避するよう配置を検討する"@ja.
kg:id_2 rdf:type cls:c_383.
cls:c_383 rdfs:label "配置検討"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "環境影響の予測"@ja.
kg:id_3 rdf:type cls:c_348.
cls:c_348 rdfs:label "環境影響"@ja.
kg:id_4 rdfs:label "適切な調査回数やデータ数の取得などできる限り定量的な評価が可能となる手法を用いる"@ja.
kg:id_4 rdf:type cls:c_384.
cls:c_384 rdfs:label "定量評価"@ja.
kg:id_3 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "酒田北港内の底質"@ja.
kg:id_5 rdf:type cls:c_385.
cls:c_385 rdfs:label "底質"@ja.
kg:id_6 rdfs:label "全リン、全窒素の濃度が高い"@ja.
kg:id_6 rdf:type cls:c_386.
cls:c_386 rdfs:label "高濃度"@ja.
kg:id_5 prop:cause kg:id_6.
kg:id_7 rdfs:label "水路部の風車設置予定地南側"@ja.
kg:id_7 rdf:type cls:c_387.
cls:c_387 rdfs:label "調査地点"@ja.
kg:id_8 rdfs:label "調査地点を追加してその状況を把握する"@ja.
kg:id_8 rdf:type cls:c_388.
cls:c_388 rdfs:label "追加調査"@ja.
kg:id_7 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "水路部の流況"@ja.
kg:id_9 rdf:type cls:c_389.
cls:c_389 rdfs:label "流況"@ja.
kg:id_10 rdfs:label "適切に調査を行う"@ja.
kg:id_10 rdf:type cls:c_192.
cls:c_192 rdfs:label "環境調査"@ja.
kg:id_9 prop:contermeasure kg:id_10.
kg:st_1 rdfs:label "経済産業省"@ja.
kg:st_1 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_1 prop:content "植生自然度の高い区域での改変を避ける配置検討を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "環境影響予測では定量評価可能な手法の採用を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "山形県知事"@ja.
kg:st_2 rdfs:type cls:st_15.
cls:st_15 rdfs:label "地方自治体"@ja.
kg:op_3 prop:content "底質の全リンと全窒素の高濃度を踏まえ追加調査が必要とみる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "風車設置予定地南側への調査地点追加を求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "水路部の流況について適切な調査を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業計画の検討に当たっては、植生自然度の高い区域での改変は、出来る限り回避するよう配置を検討すること。"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "環境影響の予測にあたっては、適切な調査回数やデータ数の取得など、できる限り定量的な評価が可能となる手法を用いること。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "酒田北港内の底質の既存の調査結果から、全リン、全窒素の濃度が高いと考えられることから"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "水路部の風車設置予定地の南側に調査地点を追加して、その状況を把握すること。"@ja.
<< kg:id_9 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、水路部の流況についても適切に調査を行うこと。"@ja.
}
