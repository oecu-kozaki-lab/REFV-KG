kg:id_8 rdf:type cls:c_13.
cls:c_13 rdfs:label "累積影響"@ja.
kg:id_9 rdfs:label "予測に必要な情報の項目を具体的に記載すること"@ja.
kg:id_9 rdf:type cls:c_397.
cls:c_397 rdfs:label "予測情報"@ja.
kg:id_8 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "底質"@ja.
kg:id_10 rdf:type cls:c_385.
cls:c_385 rdfs:label "底質"@ja.
kg:id_11 rdfs:label "全リン全窒素の濃度が高いこと"@ja.
kg:id_11 rdf:type cls:c_398.
cls:c_398 rdfs:label "高濃度栄養塩"@ja.
kg:id_10 prop:cause kg:id_11.
kg:id_12 rdfs:label "水路部の風車設置予定地の南側に調査地点を追加してその状況を把握すること"@ja.
kg:id_12 rdf:type cls:c_388.
cls:c_388 rdfs:label "追加調査"@ja.
kg:id_10 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "対象事業実施区域周辺の鳥類"@ja.
kg:id_13 rdf:type cls:c_47.
cls:c_47 rdfs:label "鳥類"@ja.
kg:id_14 rdfs:label "長期間の調査が可能なレコーダー等により鳥類の音声を記録して行う調査の併用を検討すること"@ja.
kg:id_14 rdf:type cls:c_399.
cls:c_399 rdfs:label "録音調査"@ja.
kg:id_13 prop:countermeasure kg:id_14.
kg:id_15 rdfs:label "風車の稼働"@ja.
kg:id_15 rdf:type cls:c_400.
cls:c_400 rdfs:label "風車稼働"@ja.
kg:id_16 rdfs:label "コウモリへの影響"@ja.
kg:id_16 rdf:type cls:c_401.
cls:c_401 rdfs:label "動物影響"@ja.
kg:id_15 prop:effect kg:id_16.
kg:id_17 rdfs:label "最新の知見を踏まえて衝突確率を推定し影響を予測すること"@ja.
kg:id_17 rdf:type cls:c_268.
cls:c_268 rdfs:label "影響予測"@ja.
kg:id_15 prop:countermeasure kg:id_17.
kg:id_18 rdfs:label "事業計画"@ja.
kg:id_18 rdf:type cls:c_402.
cls:c_402 rdfs:label "事業計画"@ja.
kg:id_19 rdfs:label "風車の設置場所高さ及び色の統一性など眺望景観に配慮すること"@ja.
kg:id_19 rdf:type cls:c_233.
cls:c_233 rdfs:label "景観配慮"@ja.
kg:id_18 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "酒田北港付近からの眺望に配慮すること"@ja.
kg:id_20 rdf:type cls:c_233.
kg:id_18 prop:countermeasure kg:id_20.
kg:st_1 rdfs:label "山形県知事"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "住民が不安にならないよう影響が大きくなる項目と程度を示すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "住民の理解が得られるよう事業計画を具体的に分かりやすく示すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "関係自治体や地元住民に丁寧な周知と説明を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "環境影響予測は可能な限り定量的手法を用いるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "累積的影響を評価するため予測に必要な情報項目を具体的に記載すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "底質の状況把握のため調査地点追加を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "底質把握のため南側に調査地点を追加すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "鳥類把握のため録音調査の併用を検討すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "最新の知見を踏まえてコウモリへの影響を予測すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "コウモリへの影響は衝突確率を推定して予測すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "風車の配置や高さや色の統一性に配慮し景観へ配慮すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "酒田市の主要景観を一望できる酒田北港付近からの眺望に特に配慮すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "国内において稼働実績のない、最大級の風力発電機に更新する計画であることから、住民の方が不安にならないように、既存の風車と比べて、影響が大きくなると想定される項目やその程度を示すこと。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業計画について、住民の理解が得られるように、他の類似事例の引用などにより具体的に分かりやすく示すなど配慮すること。"@ja.
<< kg:id_4 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "これらも踏まえて作成する環境影響評価準備書について、関係自治体や地元住民等に対し、丁寧に周知、説明を行うこと。"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "環境影響の予測にあたっては、できる限り定量的な手法を用いること。"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "対象事業実施区域周辺の風力発電事業との累積的影響の評価を行うため、予測に必要な情報の項目を具体的に記載すること。"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "酒田北港内の底質の既存の調査結果から、全リン、全窒素の濃度が高いと考えられることから"@ja.
<< kg:id_10 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "水路部の風車設置予定地の南側に調査地点を追加して、その状況を把握すること。"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "対象事業実施区域周辺の鳥類を把握するため、現在計画している調査に加え、長期間の調査が可能なレコーダー等により、鳥類の音声を記録して行う調査の併用を検討すること。"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "風車の稼働によるコウモリへの影響について、最新の知見を踏まえて衝突確率を推定し、影響を予測すること。"@ja.
<< kg:id_15 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "風車の稼働によるコウモリへの影響について、最新の知見を踏まえて衝突確率を推定し、影響を予測すること。"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "事業計画の検討にあたっては、風車の設置場所、高さ及び色の統一性など、眺望景観に配慮すること。"@ja.
<< kg:id_18 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "特に酒田市の主要な景観である「海、砂丘、クロマツ林、鳥海山」を一望できる、酒田北港付近からの眺望に配慮すること。"@ja.
}
