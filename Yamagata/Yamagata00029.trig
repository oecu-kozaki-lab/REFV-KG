 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "JRE酒田風力発電所更新計画"@ja.
kg:id_1 rdf:type cls:c_390.
cls:c_390 rdfs:label "発電計画"@ja.
kg:id_2 rdfs:label "既存の風車と比べて影響が大きくなる項目やその程度"@ja.
kg:id_2 rdf:type cls:c_391.
cls:c_391 rdfs:label "影響項目"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "他の類似事例の引用などにより具体的に分かりやすく示すこと"@ja.
kg:id_3 rdf:type cls:c_392.
cls:c_392 rdfs:label "計画説明"@ja.
kg:id_1 prop:countermeasure kg:id_3.
kg:id_4 rdfs:label "環境影響評価準備書"@ja.
kg:id_4 rdf:type cls:c_393.
cls:c_393 rdfs:label "評価書"@ja.
kg:id_5 rdfs:label "関係自治体や地元住民等に対し丁寧に周知説明を行うこと"@ja.
kg:id_5 rdf:type cls:c_394.
cls:c_394 rdfs:label "周知説明"@ja.
kg:id_4 prop:countermeasure kg:id_5.
