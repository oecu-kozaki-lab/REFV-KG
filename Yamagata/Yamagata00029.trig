kg:id_6 rdf:type cls:c_395.
cls:c_395 rdfs:label "環境影響予測"@ja.
kg:id_7 rdfs:label "できる限り定量的な手法を用いること"@ja.
kg:id_7 rdf:type cls:c_396.
cls:c_396 rdfs:label "定量手法"@ja.
