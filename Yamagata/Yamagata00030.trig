kg:st_1 rdfs:label "山形県知事"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "周辺環境への影響を回避低減できるよう慎重な検討を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "影響をできる限り回避低減するよう求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "それぞれの区域で個別に調査予測評価すべきとする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "自然環境と地域生活環境への影響をそれぞれ評価するよう求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "景観や環境に十分配慮すべきとする"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "調整を要する区域であるため十分な配慮を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "既存データを適切に検証総括し積極活用すべきとする"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "大規模化に伴う影響の調査予測評価を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "周辺住宅地を対象に影響を評価すべきとする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "住宅地への影響把握のため調査予測評価を求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "累積的影響の予測評価が必要とする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "影響拡大を懸念して累積評価を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "他事業者との情報交換に努めるべきとする"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "研究を進める専門家への聞き取りを求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "累積的な影響を予測評価すべきとする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "小型鳥類を含めて調査すべきとする"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "既設風車で死骸調査を行うよう求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "過小評価を避けるため最新知見の活用を求める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "飛翔高度を踏まえて予測評価すべきとする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "渡来地として適切な調査が必要とする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "渡り経路の把握を含む適切な調査予測評価を求める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "植生改変と復元状況を把握した上で評価すべきとする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "丁寧な予測評価を求める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "視認範囲拡大を踏まえ調査手法の工夫を求める"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "景観影響の広域化を考慮すべきとする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "自治体の意見も踏まえ調査地点追加など効果的手法を求める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "景観計画を踏まえ主要眺望点からの影響回避低減を求める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本事業では、風力発電所の出力規模や発電機諸元が、更新前よりも大規模なものとなる計画となっている"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "周辺環境への影響をできる限り回避、低減できるよう慎重に検討するとともに"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "事業実施想定区域である酒田北港地区と宮海地区海岸部では、周辺の状況が大きく異なることから"@ja.
<< kg:id_4 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "周辺環境（自然環境、地域生活環境）に及ぼす影響について、それぞれ調査、予測及び評価を実施すること"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "宮海地区海岸部は、「酒田市風力発電施設建設ガイドライン」に定める調整を要する区域となっているため"@ja.
<< kg:id_6 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "景観や環境等に十分に配慮すること"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "既存設備の建設時に行ったモニタリングデータなど、これまでの発電所の運営にあたって得られた知見や資料を適切に検証、総括するとともに、これらを積極的に活用すること"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "施設の大規模化に伴い、風車の影による影響が懸念されることから"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "特に周辺住宅地を対象として、風車の影の影響について調査、予測及び評価を行うこと"@ja.
<< kg:id_11 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "特に周辺住宅地を対象として、風車の影の影響について調査、予測及び評価を行うこと"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "事業実施想定区域周辺には、本発電所のほかにも多数の風力発電所が存在することから、バードストライクによる鳥類への影響が大きくなることが懸念される"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "バードストライクによる鳥類への影響が大きくなることが懸念される"@ja.
<< kg:id_15 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "他の風力発電事業者との情報交換に努めるとともに"@ja.
<< kg:id_15 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "バードストライクの研究を進めている専門家へのヒアリングを実施し"@ja.
<< kg:id_15 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "累積的な影響を予測、評価すること"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "バードストライクの調査、予測及び評価にあたっては、小型鳥類も対象として実施すること"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "既設風車について、鳥類の死骸調査を実施することとし"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "調査に基づく衝突数の推定にあたっては、死骸の消失率などについて最新の知見を活用し、過小な評価にならないよう、適切に実施すること"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "渡り鳥の調査にあたっては、鳥の飛翔高度にも配慮して予測及び評価を行うこと"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "ハクチョウについては、経由地としてだけでなく、越冬している現在の状況により渡来地として捉えられるため"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "渡りの経路を把握するなど適切な調査、予測及び評価を実施すること"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "植物の調査にあたっては、宮海地区海岸部における既存設備の工事による植生の改変の有無、及びその復元状況を把握した上で"@ja.
<< kg:id_32 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "丁寧な予測及び評価を行うこと"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "施設の大規模化に伴い、より広い範囲から風車が視認できる可能性が高まることから"@ja.
<< kg:id_35 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "より広い範囲から風車が視認できる可能性が高まることから"@ja.
<< kg:id_35 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "関係自治体の意見も聞きながら、既知の眺望点以外にも調査地点を追加選定するなど、より効果的な調査手法を検討すること"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "「酒田市景観計画」を踏まえ、主要な眺望点からの景観への影響をできる限り回避、低減することができるよう、事業計画を検討すること"@ja.
}
