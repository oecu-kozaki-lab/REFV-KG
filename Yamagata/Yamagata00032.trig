    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "渡り鳥の移動経路等に係る調査"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "ブレード塗装やシール貼付等の鳥類からの視認性を高める措置"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "渡り鳥の衝突のおそれが高い季節及び時間帯の稼働調整等"@ja.
<< kg:id_1 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "稼働後においてバードストライクが発生した場合の措置の内容を事前に定め"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "確認位置や損傷状況等を記録するとともに"@ja.
<< kg:id_28 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "関係機関との連絡・調整"@ja.
<< kg:id_28 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "死亡・傷病個体の搬送"@ja.
<< kg:id_28 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "関係機関による原因分析及び傷病個体の救命への協力を行うこと。"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:text-txt_contents "対象事業実施区域の北側のエリアには植生自然度の高いハマニガナ－ハマヒルガオ群落、カワラヨモギ群落等の海岸砂丘植生が分布しており"@ja.
<< kg:id_33 prop:cause kg:id_35 >>
    prop:text-txt_contents "本事業の実施に伴い、その一部を改変する計画となっている。"@ja.
<< kg:id_33 prop:effect kg:id_36 >>
    prop:text-txt_contents "改変により消失する割合が高い植生については"@ja.
<< kg:id_1 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "改変により消失する割合が高い植生については、可能な限り移植を行うこととしている。"@ja.
<< kg:id_1 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "風車敷の設置場所、設計及び工法に関して更なる検討を行い"@ja.
<< kg:id_1 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "海岸砂丘植生の改変を回避又は可能な限り最小限に抑えること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "また、移植後の植物の定着状況に係る事後調査を適切に実施すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "以上の措置を適切に講ずるとともに、その旨を評価書に記載すること。"@ja.
}
