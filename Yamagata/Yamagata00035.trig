PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Yamagata/00035> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "（仮称）栗子山風力発電事業"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "配慮書の公表"@ja.
kg:id_2 rdf:type cls:c_198.
cls:c_198 rdfs:label "配慮書公表"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "配慮書の縦覧"@ja.
kg:id_3 rdf:type cls:c_199.
cls:c_199 rdfs:label "配慮書縦覧"@ja.
kg:id_1 prop:countermeasure kg:id_3.
kg:id_4 rdfs:label "配慮書に対する一般意見の受付"@ja.
kg:id_4 rdf:type cls:c_163.
cls:c_163 rdfs:label "意見受付"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "環境影響評価審査会の開催"@ja.
kg:id_5 rdf:type cls:c_165.
cls:c_165 rdfs:label "審査会開催"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "県知事意見の事業者への通知"@ja.
kg:id_6 rdf:type cls:c_200.
cls:c_200 rdfs:label "意見通知"@ja.
kg:id_1 prop:countermeasure kg:id_6.
kg:st_1 rdfs:label "一般"@ja.
kg:st_1 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "配慮書に対する意見を提出できる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "県知事"@ja.
kg:st_2 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_2 prop:content "事業者へ意見を通知する予定"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "○配慮書の公表：令和元年7月3日"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:text-txt_contents "○配慮書の縦覧：令和元年7月3日～8月2日"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "○配慮書に対する一般意見の受付期限：令和元年8月2日まで"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:text-txt_contents "○環境影響評価審査会の開催：令和元年8月20日"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "○県知事意見の事業者への通知：令和元年8月下旬（予定）"@ja.
}
