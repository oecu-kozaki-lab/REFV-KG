kg:id_2 rdf:type cls:c_556.
cls:c_556 rdfs:label "環境影響評価手続"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "配慮書の公表"@ja.
kg:id_3 rdf:type cls:c_198.
cls:c_198 rdfs:label "配慮書公表"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "配慮書の縦覧"@ja.
kg:id_4 rdf:type cls:c_199.
cls:c_199 rdfs:label "配慮書縦覧"@ja.
kg:id_1 prop:contermeasure kg:id_4.
