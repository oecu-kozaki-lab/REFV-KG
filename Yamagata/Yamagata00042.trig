    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "こうした物価の高騰が連続することで、市民の消費行動がより慎重になり、市内経済の停滞を招くのではないかと危惧するところです"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "消費マインドを好転させるためにも、年末年始に向けた需要喚起策を実施すべきではないかと思います"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "課題といたしましては、協議会活動として行っております街路樹桝美化推進事業につきましては、植栽後に雑草が繁茂してしまう状況があるため、その後の管理について大きな課題となっているところではございます"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "課題といたしましては、コロナ禍の影響もあり、活動団体数の登録が頭打ちの状況であるため"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "気象条件によっては追加の除草も必要であるものと捉えております"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "落葉によって雨が降った場合、排水管が詰まるなども心配されます"@ja.
<< kg:id_23 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "また、歩行者や車のスリップ事故にもつながる可能性があります"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "導入から３年間の累計で約１万時間の業務削減効果があったと見込んでおり、職員の負担軽減と業務効率化に大きく寄与しております"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "開庁時間帯においても数多く利用されており、市役所窓口の混雑緩和につながっております"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "ユーザー目線で利用度が高いと考えられる申請手続を増やしていくとともに"@ja.
<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "十分な活用が図られるよう市民周知を行っていきたいと考えております"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "今年度は除雪車運行管理システムの導入でこの交付金を活用しており、これにより冬季の除雪作業の見える化と、効率的かつ迅速な除雪対応が可能となります"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "各コミュニティセンターなどがスマホ教室を行う際に、市では携帯電話事業者から講師を派遣してもらうなどの開催支援を行っております"@ja.
<< kg:id_36 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "市役所窓口においては、マイナンバーカードの利用方法が分からない方には、分かりやすい資料を作成して丁寧な説明を行い、デジタルサービスを利用できるよう案内しているほか、来庁者のスマートフォンを操作補助しながら利用案内することもございます"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "化学工業及び電子部品・デバイス工業などの業種は低下している状況です"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "化学工業及び電子部品・デバイス工業などの業種は低下している状況です"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "今後の動向については、秋の食料品の値上げと最低賃金の引上げなどの影響により厳しくなると予想されています"@ja.
<< kg:id_42 prop:cause kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "今後の動向については、秋の食料品の値上げと最低賃金の引上げなどの影響により厳しくなると予想されています"@ja.
<< kg:id_45 prop:cause kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "特に金属製品製造業においては、半導体の在庫調整などによる関連装置や設備などの生産低迷の影響により業績が芳しくない状況にあります"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "資材高騰や人件費増による建築単価上昇の影響で、新設住宅の着工戸数は減少傾向にあります"@ja.
<< kg:id_47 prop:cause kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "資材高騰や人件費増による建築単価上昇の影響で、新設住宅の着工戸数は減少傾向にあります"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "近隣の観光地との競争激化や運転士不足による観光バスの減少などの要因により、本市の観光需要は完全に戻っていない状況であります"@ja.
<< kg:id_50 prop:cause kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "近隣の観光地との競争激化や運転士不足による観光バスの減少などの要因により、本市の観光需要は完全に戻っていない状況であります"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "これらの主な要因としましては、中国経済の減速、急激な円安や原材料・エネルギー価格などの高騰、コロナ禍の半導体不足に対応するため在庫を積み増しした反動による生産調整、さらにはコスト増加分を思うように価格転嫁ができていないことなどが挙げられます"@ja.
<< kg:id_53 prop:cause kg:id_55 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "これらの主な要因としましては、中国経済の減速、急激な円安や原材料・エネルギー価格などの高騰、コロナ禍の半導体不足に対応するため在庫を積み増しした反動による生産調整、さらにはコスト増加分を思うように価格転嫁ができていないことなどが挙げられます"@ja.
<< kg:id_53 prop:cause kg:id_56 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "これらの主な要因としましては、中国経済の減速、急激な円安や原材料・エネルギー価格などの高騰、コロナ禍の半導体不足に対応するため在庫を積み増しした反動による生産調整、さらにはコスト増加分を思うように価格転嫁ができていないことなどが挙げられます"@ja.
<< kg:id_53 prop:cause kg:id_57 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "これらの主な要因としましては、中国経済の減速、急激な円安や原材料・エネルギー価格などの高騰、コロナ禍の半導体不足に対応するため在庫を積み増しした反動による生産調整、さらにはコスト増加分を思うように価格転嫁ができていないことなどが挙げられます"@ja.
<< kg:id_53 prop:cause kg:id_58 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "これらの主な要因としましては、中国経済の減速、急激な円安や原材料・エネルギー価格などの高騰、コロナ禍の半導体不足に対応するため在庫を積み増しした反動による生産調整、さらにはコスト増加分を思うように価格転嫁ができていないことなどが挙げられます"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "資金面での手当てだけでなく、新技術導入や新商品・製品開発及びデジタル化促進など、ビジネス変革に向けた取組がより重要であります"@ja.
<< kg:id_61 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "市内の事業者の新たな商品開発を促進する支援事業として、商工業地域活性化支援事業費補助金を設けております"@ja.
<< kg:id_63 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "本市では産学官連携により、市内事業者の新製品開発、大学からの技術移転を目的として、産学連携コーディネート事業を展開しております"@ja.
<< kg:id_65 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "本市と米沢商工会議所との連携による米沢市人材確保定着促進事業"@ja.
<< kg:id_65 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "市内産業界や経済団体と、米沢工業高校及び米沢商業高校との連携による米沢鶴城高校開校に向けた地域コンソーシアム"@ja.
<< kg:id_65 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "やまがた就職促進奨学金返還支援事業では、県と市が協調して、大学生の地域定着に向けて奨学金の返還を支援する取組を行っております"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "年末年始に向けての需要喚起策は消費者マインドの改善にも非常に効果的だと捉えております"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "事業規模も大きく、事業実施に当たり多額の費用を要することから、市の一般財源だけで実施することは大変難しい状況"@ja.
<< kg:id_71 prop:cause kg:id_73 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "国の交付金などの有利な財源の活用が不可欠であります"@ja.
<< kg:id_74 prop:cause kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "昨今増えている豪雨災害や鳥獣被害について、元をたどれば、山が本来あるべき姿に整備されていないことが一つの原因であります"@ja.
<< kg:id_76 prop:cause kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "昨今増えている豪雨災害や鳥獣被害について、元をたどれば、山が本来あるべき姿に整備されていないことが一つの原因であります"@ja.
<< kg:id_77 prop:cause kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "昨今増えている豪雨災害や鳥獣被害について、元をたどれば、山が本来あるべき姿に整備されていないことが一つの原因であります"@ja.
<< kg:id_78 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "令和３年度から５か年事業として、航空レーザ測量等森林経営管理制度促進業務を実施し、航空レーザー測量により取得いたしました三次元情報から、地形、森林資源、施業などの状況を正確に把握し"@ja.
<< kg:id_78 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "令和４年度に行いました、本市に山林を所有する全ての方を対象といたしました森林経営管理意識調査の結果を基に、森林評価や優先順位への反映作業も進めながら"@ja.
<< kg:id_81 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "森林クラウドシステムに航空レーザー測量や境界明確化などの成果などを反映させることで精緻化され、より高精度な伐採計画の策定が可能になるものと考えています"@ja.
<< kg:id_83 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "より長期的な視野を持って米沢の山をどうしていくか考えていかなければなりません"@ja.
<< kg:id_85 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "ワークショップなどを通じて適切な森づくりに向けた意識の共有化を図ることが重要であると考えております"@ja.
<< kg:id_87 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "本市の木材産業に関わる川上から川下までのあらゆる事業者に参加していただき、設立するものです"@ja.
<< kg:id_89 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "米沢市長として前向きに置賜地域の林業振興に向けた広域連携の可能性を検討し、実行していきたいと考えております"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "本市の森林整備促進や林業振興のためには、人材の育成・確保が何よりも重要です"@ja.
<< kg:id_93 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "今後、遊具を更新する際には、木製遊具を選択肢の一つに加え"@ja.
<< kg:id_95 prop:effect kg:id_96 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "谷筋の大規模盛土の土砂崩壊による土石流の発生や対象事業実施区域内に地滑り地形が存在することから、本工事に伴う地滑りの発生など土砂災害の懸念"@ja.
<< kg:id_95 prop:effect kg:id_97 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "本工事に伴う地滑りの発生など土砂災害の懸念"@ja.
<< kg:id_95 prop:effect kg:id_98 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "対象事業実施区域内は絶滅が危惧されるニホンイヌワシの飛翔が多数確認され、重要な採食地、餌場になっており"@ja.
<< kg:id_95 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "事業の取りやめも含め抜本的な事業の見直しを求められています"@ja.
<< kg:id_95 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "当該事業の全面白紙撤回を求めました"@ja.
<< kg:id_101 prop:cause kg:id_102 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "住民からの事業計画に対する様々な意見や事業への懸念に対し、誠実かつ丁寧に説明してきたとは言えず、住民の理解が得られたとは言い難いと認識しております"@ja.
<< kg:id_95 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "早期に追加説明会を開催すること"@ja.
<< kg:id_95 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "準備書、会議録の公開を文書で"@ja.
<< kg:id_95 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "本市への地域貢献の内容を具体的に提案するよう口頭で求めてまいりました"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "市民や専門家からの懸念や指摘、リスクが完全に解決されない場合に、起きてからでは後戻りできない状況に陥るおそれがある不可逆性、本市の自然や環境、景観、安全性、さらには本市への地域裨益など総合的に熟慮、検討した結果、本市としては本事業をこのまま進めるべきではないと判断いたしました"@ja.
<< kg:id_108 prop:effect kg:id_109 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "風力発電事業につきましては、その立地によって、周囲の景観に大きな影響を与える可能性があり"@ja.
<< kg:id_108 prop:effect kg:id_110 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "特に山間部など自然環境が豊かな地域では、その美しい景観が損なわれる懸念があるため"@ja.
<< kg:id_111 prop:effect kg:id_112 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "質問や意見に対する回答は誠意が感じられず、住民の理解を得られたものではなかったとの印象を持ったところでございます"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "近年、里山が放置されて、つる等が生い茂った密集した森林が広がり"@ja.
<< kg:id_115 prop:cause kg:id_113 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "近年、里山が放置されて、つる等が生い茂った密集した森林が広がり、動物たちが容易に人里に近づけるようになりました"@ja.
<< kg:id_116 prop:cause kg:id_117 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "近年は山と里の境界が曖昧になり、里に来やすい状況ができてしまいました"@ja.
<< kg:id_116 prop:cause kg:id_118 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "猿は、一度農作物を食べると、おいしいものと認識します"@ja.
<< kg:id_116 prop:cause kg:id_119 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "山で取る餌よりも量も多く栄養があり、猿にとっては魅力的です。その結果、怖がりながらも里へ来て農作物を食い荒らすのです"@ja.
<< kg:id_120 prop:effect kg:id_121 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "猿の行動が急激にエスカレートし、人を威嚇する個体も現れています。人的被害への心配が一層大きくなってきています"@ja.
<< kg:id_122 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "加害個体を特定し、捕獲圧を高め、徹底した個体管理が必要ではないでしょうか"@ja.
<< kg:id_122 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "対策の徹底と、家の汚れ等の清掃等に対する被害の支援策が必要と考えます"@ja.
<< kg:id_122 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "今年度からは新たに加害群を対象に群れの個体数を減少させるため、猟友会の協力を得て捕獲活動の強化を開始しているところです"@ja.
<< kg:id_126 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "継続した捕獲活動を行うことで、群れの頭数をより少ない個体数にして、追い払いなどの人的コントロールの効果を高めていくことになります"@ja.
<< kg:id_128 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "米沢猟友会への後継者育成支援事業につきましては、猟友会における次世代の有害鳥獣対策の担い手の育成支援となっています"@ja.
<< kg:id_130 prop:cause kg:id_131 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "置賜管内における捕獲数は目標数値に届いておらず、微増状態にあると見られることが、目撃件数の増加や市街地への出没につながる一因と考えております"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "必要に応じＬＩＮＥ及びＸで通知を行っているところでございます"@ja.
<< kg:id_132 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "庁内では、関係課及び学校、コミセンなどと情報を共有し、必要な対応を取っているところでございます"@ja.
<< kg:id_135 prop:effect kg:id_136 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "スポーツ施設が老朽化することにより、けがなどの事故が発生するリスクは高まるものと考えます"@ja.
<< kg:id_135 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "来年度、米沢市公共施設等総合管理計画・個別施設計画の改定を予定しております。この改定に当たりましては、スポーツ施設のストック適正化ガイドラインの考え方を可能な限り取り入れ"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "重大な危険を回避する修繕を優先して行いながら、市民の皆様に安全に利用していただける施設の管理運営と事故防止に努めてまいります"@ja.
<< kg:id_140 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "安全に配慮した施設管理と米沢市公共施設等総合管理計画・個別施設計画に基づいた、利用者の皆様に安心してスポーツ活動を行っていただける施設の計画的な改修を進めてまいりたい"@ja.
<< kg:id_142 prop:contermeasure kg:id_143 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "施設管理者との意見交換を定期的に行う中で、様々な利用者の御意見を参考として、今後の施設整備の計画に反映できるように努めております"@ja.
<< kg:id_144 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "市民の皆様への情報提供と対話を重視しながら、柔軟かつ適切に対応していかなければならないと考えております"@ja.
<< kg:id_146 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "障がい者の虐待防止や権利擁護、養護者支援に関する周知啓発を図るため、平成25年から年１回、シンポジウムや、障がい福祉に造詣の深い方を招いての講演会を行っております"@ja.
<< kg:id_148 prop:contermeasure kg:id_149 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "意思疎通支援者を配置して手話通訳を実施し、聴覚障がいの方も一緒に講演をお聞きいただけるよう体制を整えました"@ja.
<< kg:id_150 prop:contermeasure kg:id_151 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "広く市民の方々に、障がいのある方と障がいのある方を支援する方々の常日頃の活動を知っていただくための取組として、令和元年から年に１回、市民ギャラリーを会場に、障がい者芸術作品展を開催しています"@ja.
<< kg:id_152 prop:contermeasure kg:id_153 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "障がいのある方とない方との交流の取組として、障がい者スポーツ教室を実施しています"@ja.
<< kg:id_154 prop:contermeasure kg:id_155 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "手話言語条例、情報・コミュニケーション条例の制定については、当協議会の委員の方々の御意見をいただくとともに、既に制定された県内自治体の状況などもお聞きしながら調査・研究してまいりたい"@ja.
<< kg:id_156 prop:contermeasure kg:id_157 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "地域活動の拠点である地域公民館等の整備を推進し、活動の充実を図ることを目的に、施設の修繕や備品の購入に対して、事業費の２分の１を補助する制度であります"@ja.
<< kg:id_156 prop:contermeasure kg:id_158 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "一般コミュニティ助成事業は、コミュニティ活動に直接必要な設備や備品の整備事業が対象であり"@ja.
<< kg:id_156 prop:contermeasure kg:id_159 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "コミュニティセンター助成事業は、集会施設の建設や大規模修繕などが対象であり"@ja.
<< kg:id_160 prop:cause kg:id_161 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "地域における人口減少や高齢化が進展する中で、老朽化が進んでいる地域集会所の維持管理、さらには解体が課題となりつつあります"@ja.
<< kg:id_162 prop:contermeasure kg:id_163 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "今後、地域集会施設の規模や老朽度のほか、自治会等の会員数や施設維持費等に対する積立て状況など、制度構築に向けた調査に着手したいと考えております"@ja.
<< kg:id_162 prop:contermeasure kg:id_164 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "まずは会員の皆様で将来に向けた集会所の在り方を話し合っていただき、必要であれば解体に向けた積立てを始めるなどの対策を御検討いただくことについて、市でも呼びかけたい"@ja.
}
