kg:st_8 rdfs:type cls:st_16.
kg:op_59 prop:content "山形県知事意見で土砂災害の懸念が示されたと指摘"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_8.
kg:op_60 prop:content "山形県知事意見で土砂災害の懸念が示されたと指摘"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_8.
kg:op_61 prop:content "イヌワシ保全上の重大な懸念があると指摘"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_8.
kg:st_9 rdfs:label "山形県知事"@ja.
kg:st_9 rdfs:type cls:st_20.
cls:st_20 rdfs:label "知事"@ja.
kg:op_62 prop:content "イヌワシ保全などから事業見直しを求める"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_9.
kg:op_63 prop:content "自然環境や安全性、地域裨益を総合考慮し全面撤回を申し入れた"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_6.
kg:op_64 prop:content "事業者は住民理解を得られていないと認識"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_6.
kg:st_10 rdfs:label "米沢市"@ja.
kg:st_10 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_65 prop:content "住民理解のため追加説明会を求めた"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_10.
kg:op_66 prop:content "情報公開のため準備書と会議録の公開を求めた"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_10.
kg:op_67 prop:content "地域裨益を具体的に示すよう求めた"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_10.
kg:op_68 prop:content "不可逆性や地域裨益を踏まえ事業撤回を決断"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_6.
kg:op_69 prop:content "自然豊かな地域では景観を損なう懸念があると説明"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "山間部の美しい景観が損なわれる懸念を説明"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:st_11 rdfs:label "佐藤市民環境部長"@ja.
kg:st_11 rdfs:type cls:st_18.
kg:op_71 prop:content "説明会は質問への回答も不十分で住民理解に至らなかったと評価"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_11.
kg:st_12 rdfs:label "18番我妻德雄議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_72 prop:content "里山放置で動物が人里に近づきやすくなったと指摘"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_12.
kg:op_73 prop:content "里山放置が人里への侵入を招いていると指摘"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_12.
kg:op_74 prop:content "山里の境界が曖昧になり猿が里へ来やすくなったと説明"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_12.
kg:op_75 prop:content "農作物を覚えた猿が繰り返し里へ来ると説明"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_12.
kg:op_76 prop:content "農作物の栄養価と量が猿を引き寄せていると説明"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_12.
kg:op_77 prop:content "威嚇個体の出現で人的被害への不安が高まっていると指摘"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_12.
kg:op_78 prop:content "加害個体や攻撃性の高い個体を狙った捕獲が必要と提案"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_12.
kg:op_79 prop:content "人家侵入被害への清掃等支援策が必要と提案"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_12.
kg:op_80 prop:content "今年度から猟友会協力で捕獲活動強化を開始したと説明"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_4.
kg:op_81 prop:content "継続捕獲で群れ規模を抑え人的コントロールを高める必要があると説明"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_4.
kg:op_82 prop:content "次世代の有害鳥獣対策の担い手育成支援を行うと説明"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_4.
kg:op_83 prop:content "捕獲不足による微増が出没増加の一因と説明"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_11.
kg:op_84 prop:content "必要に応じSNSで住民へ情報提供していると説明"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_11.
kg:op_85 prop:content "庁内や学校、コミセンと情報共有して対応していると説明"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_11.
kg:op_86 prop:content "老朽化により事故発生リスクが高まると認識"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_7.
kg:op_87 prop:content "来年度の個別施設計画改定でガイドラインの考え方を可能な限り取り入れる方針を示す"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_7.
kg:op_88 prop:content "重大危険回避を優先して修繕し安全な利用を図ると説明"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_7.
kg:op_89 prop:content "個別施設計画に基づき安心して利用できる施設整備を進めると説明"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_7.
kg:op_90 prop:content "意見箱や施設管理者との意見交換、競技団体との連携で合意形成を進めると説明"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_7.
kg:op_91 prop:content "利用者理解を得ながら料金見直しを進める考えを示す"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_7.
kg:st_13 rdfs:label "山口健康福祉部長"@ja.
kg:st_13 rdfs:type cls:st_18.
kg:op_92 prop:content "虐待防止や権利擁護の周知啓発のため講演会等を継続実施していると説明"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_13.
kg:op_93 prop:content "講演会やセミナーで手話通訳を実施し聴覚障がい者も参加できる体制を整えたと説明"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_13.
kg:op_94 prop:content "作品展を通して市民の障がい理解を深める取組を行っていると説明"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_13.
kg:op_95 prop:content "交流を通じ障がい者理解を深める取組を行っていると説明"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_13.
kg:op_96 prop:content "地域自立支援協議会の意見や県内自治体の状況を踏まえ調査研究したいと説明"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_13.
kg:op_97 prop:content "施設修繕や備品購入に対し市独自補助制度を設けていると説明"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_3.
kg:op_98 prop:content "コミュニティ活動に必要な設備や備品整備に活用できると説明"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_3.
kg:op_99 prop:content "集会施設の建設や大規模修繕に活用できると説明"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_3.
kg:op_100 prop:content "人口減少と高齢化で老朽化集会所の維持管理や解体が課題になっていると説明"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_3.
kg:op_101 prop:content "集会施設の規模や老朽度などを調査し制度構築を検討すると説明"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_3.
kg:op_102 prop:content "自治会等にも将来の在り方協議や積立て開始を呼びかけたいと説明"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "デジタル化の進展により、御高齢者や障がいがある方など、いわゆるデジタル弱者へのフォローが必要だと思います"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "パソコンで行っている事務作業を自動化できるソフトウエアロボット技術、ＲＰＡの市役所への導入や、マイナンバーカードによる各種証明書のコンビニ交付が令和２年３月１日から始まるなど、業務効率が改善されてきたと認識しているところです"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "デジタル社会形成基本法の改正及び地方公共団体情報システムの標準化に関する法律など、デジタル改革関連法が施行されました。これにより、本市の取組がさらに加速することが期待されるところです"@ja.
