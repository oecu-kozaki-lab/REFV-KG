kg:op_30 prop:speaker kg:st_10.
kg:op_31 prop:content "白紙撤回要求に感謝している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_9.
kg:op_32 prop:content "米沢の自然に合った再生可能エネルギーの活用がよい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_9.
kg:op_33 prop:content "気候変動対策と生物多様性保全の両立が大事"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_9.
kg:st_11 rdfs:label "山村明議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_34 prop:content "風力発電は米沢市民にとって必要な施設"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_11.
kg:st_12 rdfs:label "髙橋千夏議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_35 prop:content "現段階で本事業を賛成する要素は見当たらない"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_12.
kg:op_36 prop:content "生物多様性保全を犠牲にするのは本末転倒"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_12.
kg:op_37 prop:content "豊かな自然環境や生態系への配慮を看過している"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_12.
kg:op_38 prop:content "市や市民への対応に対する不適切さや不誠実さが存在する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_12.
kg:st_13 rdfs:label "成澤和音議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_39 prop:content "子育て支援や義務教育無償化の観点から国に財政支援を求める"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_13.
kg:st_14 rdfs:label "齋藤千惠子議員"@ja.
kg:st_14 rdfs:type cls:st_16.
kg:op_40 prop:content "陳情の取扱い変更に伴い所要の改正を行う"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_14.
kg:st_15 rdfs:label "近藤洋介市長"@ja.
kg:st_15 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_41 prop:content "不認定を重く受け止め法令遵守と適切な運用となるよう指導を徹底する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_15.
kg:op_42 prop:content "法令遵守と適切な運用となるよう指導を徹底する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_15.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "通報機能の導入によって、電話での問合せが減った"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "道路パトロールでは気づけない小さな損傷を発見することができ"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "きめ細やかな対応が可能となり"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "道路維持に貢献している"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "投票所を閉じる時刻を１時間繰り上げたが、混乱や苦情もなく"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "投票率は63.12％となり、その前の市長選挙の60.57％より2.55％高くなった"@ja.
<< kg:id_6 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "投票管理者や立会人の方からは、１時間早くなり負担が軽減されたという声もあった"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "今後は、国政選挙も含め、投票所を閉じる時刻を１時間繰り上げることについて、選挙管理委員会に諮った上で進めていきたい"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "制度の周知を図りながらニーズの掘り起こしを進めてきたことで、少しずつ地域の方々に認知されてきており、相談件数は昨年度より大分増加している"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:text-txt_contents "少しずつ地域の方々に認知されてきており"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:text-txt_contents "他の置賜２市５町での実態や状況等を把握し、検討することになる"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "利用の動機として、短期入所型は産後の休養"@ja.
<< kg:id_17 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "自宅での育児への不安"@ja.
<< kg:id_17 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "協力者不足などがあり"@ja.
<< kg:id_17 prop:effect kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "利用者へのアンケートの結果では、利用の動機が改善されたという回答がほとんどだった"@ja.
<< kg:id_17 prop:effect kg:id_22 >>
    prop:text-txt_contents "成果があったと考えている"@ja.
<< kg:id_17 prop:contermeasure kg:id_23 >>
    prop:text-txt_contents "今後もアンケートの結果を見ながらニーズを把握し、サービスの提供につなげていきたい"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:text-txt_contents "移行後の12月がインフルエンザの流行時期と重なったこともあり"@ja.
<< kg:id_24 prop:effect kg:id_26 >>
    prop:text-txt_contents "小児科・内科を中心に大変混雑し"@ja.
<< kg:id_24 prop:effect kg:id_27 >>
    prop:text-txt_contents "御迷惑をおかけしたこともあった"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "その詳細の分析については学校ごとに取組の内容が異なっており、定点での数値化は難しい"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "最近では、高校や大学の先生と地元企業との交流会を開催し、先生や生徒に企業をよく知っていただく取組も行っている"@ja.
<< kg:id_30 prop:contermeasure kg:id_32 >>
    prop:text-txt_contents "米沢市に愛着を持ち、米沢市に貢献していただける人材を増やし"@ja.
<< kg:id_30 prop:contermeasure kg:id_33 >>
    prop:text-txt_contents "県外に出た方にも将来的に戻ってもらえるようにしたい"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:text-txt_contents "航空レーザー測量結果は、主に森林の解析や森林境界素図の作成において活用している"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:text-txt_contents "航空レーザー測量結果が生かせる場合は、幅広く提供し、活用いただきたい"@ja.
<< kg:id_36 prop:contermeasure kg:id_38 >>
    prop:text-txt_contents "オープンデータ化については今後検討したい"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "バス・トイレが部屋にあることが一つの条件となっており、市内では、その条件を満たす施設があまり整っていない状況にあるため、宿泊する外国人観光客が少ない状況にある"@ja.
<< kg:id_30 prop:contermeasure kg:id_41 >>
    prop:text-txt_contents "できるだけ本市で宿泊していただける施設となるよう、民間事業者とも協力しながら進めていきたい"@ja.
<< kg:id_30 prop:contermeasure kg:id_42 >>
    prop:text-txt_contents "今後、そういった点も含めて目標を設定したい"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:text-txt_contents "約4,800万円の経費がかかることから、費用対効果の面から令和６年度に予算化することが難しく"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:text-txt_contents "引き続き研究していくことになった"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:text-txt_contents "マチスタヂオの１階にフリーＷｉ－Ｆｉを取り付け、利用者を増やす取組を行った"@ja.
<< kg:id_47 prop:contermeasure kg:id_49 >>
    prop:text-txt_contents "マチスタヂオの１階にこたつを設置し、ｅスポーツができる環境を整え"@ja.
<< kg:id_47 prop:effect kg:id_50 >>
    prop:text-txt_contents "約１か月間で、子供143名、大人51名、計194名に利用していただいた"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:text-txt_contents "にぎわいを創出するには経費がかかる"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:text-txt_contents "まずは、この東町エリアでの取組の効果を検証し、将来的には水平展開していくことも考えていきたい"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:text-txt_contents "今後の暮らし相談会では、電力会社の賠償手続やお子様の進学に関する相談が多かった"@ja.
<< kg:id_57 prop:contermeasure kg:id_58 >>
    prop:text-txt_contents "ワクチン接種や小児健診など避難者の健康に関する手続への支援が主になっている"@ja.
<< kg:id_57 prop:contermeasure kg:id_59 >>
    prop:text-txt_contents "定期的に福島県と山形県の情報を提供しているほか、交流の場を設けている"@ja.
<< kg:id_60 prop:effect kg:id_61 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "今年度の暑さ対策として活用している"@ja.
<< kg:id_60 prop:effect kg:id_62 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "スポット的に体を冷やせることから非常に効果がある"@ja.
<< kg:id_60 prop:effect kg:id_63 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "学校や子供たちから好評を得ている"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:text-txt_contents "今後、要望を伺いながら、利用できるような方向で準備を進めたい"@ja.
<< kg:id_64 prop:contermeasure kg:id_66 >>
    prop:text-txt_contents "あわせて、使用料の設定を検討していきたい"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:text-txt_contents "雪の重みによる石積みの崩落"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:text-txt_contents "倒木の危険性のある樹木は伐採するなどの対応を行っており、引き続き、しっかりとした維持管理に努めていきたい"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:text-txt_contents "人数は目標値を超えていたが、滞在時間が短いこともあり、目標額100万円には達しなかった"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:text-txt_contents "今後は、利用者の増加に努めながら、経費を使用料で賄えるようにしたい"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "少子化対策の一環として、子育て世帯の経済的な負担を軽減するために実施している"@ja.
<< kg:id_30 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "引き続き、他市町村と連携を図りながら、対象年齢の拡大及び軽減割合の拡充等について要望していきたい"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "一部の方は１割負担から２割負担になり"@ja.
<< kg:id_78 prop:effect kg:id_80 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "薬代が高くてとても大変だという声が多く聞かれる"@ja.
<< kg:id_30 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "本市の後期高齢者医療制度の加入者の声をまとめ上げ、それを広域連合に伝えるなど、本市独自の対応を検討していただきたい"@ja.
<< kg:id_82 prop:cause kg:id_83 >>
    prop:text-txt_contents "認知症ということもあり、自宅への介入が困難なケースが多く、支援人数は１人となっている"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:text-txt_contents "今後も地域包括支援センターと連携し、事業を継続していきたい"@ja.
<< kg:id_86 prop:effect kg:id_87 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "介護サービスを受けている方やその御家族から施設を利用するにも利用料の負担が重いという声を多く聞いており"@ja.
<< kg:id_30 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "本市としても、それに応えるような手だてを講じる必要がある"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:text-txt_contents "令和４年度に落雷によって電気系統に支障を来したことがあったため"@ja.
<< kg:id_91 prop:contermeasure kg:id_92 >>
    prop:text-txt_contents "電気回路を保護する回路を新たに設ける工事を行った"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:text-txt_contents "青果市場における農産物の取扱量は、人口減少等もあり年々少なくなっている"@ja.
<< kg:id_93 prop:cause kg:id_95 >>
    prop:text-txt_contents "年によっては自然災害等で農産物が少なくなることもある"@ja.
<< kg:id_96 prop:contermeasure kg:id_97 >>
    prop:text-txt_contents "取扱量をどのように増やしていくかについては、毎月の市場運営協議会において検討している"@ja.
<< kg:id_98 prop:cause kg:id_99 >>
    prop:text-txt_contents "板谷の簡易水道については、上水道料金よりかなり低い設定となっている"@ja.
<< kg:id_98 prop:cause kg:id_100 >>
    prop:text-txt_contents "住民の方が年々減少していることなどを踏まえる必要があり"@ja.
<< kg:id_98 prop:cause kg:id_101 >>
    prop:text-txt_contents "白布高湯の簡易水道については、浄水場の更新などがあり、それを見据える必要がある"@ja.
<< kg:id_102 prop:contermeasure kg:id_103 >>
    prop:text-txt_contents "今後、料金の統一を検討していきたい"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:text-txt_contents "数年先の収支を見ると厳しい状況となっており"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:text-txt_contents "下水道料金については、今年度見直しの検討作業を進めている"@ja.
<< kg:id_108 prop:cause kg:id_109 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "その起債の元金償還が令和５年度末から開始するものがあり、その部分の予算が確保できておらず"@ja.
<< kg:id_108 prop:cause kg:id_110 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "当時、予算に定めのない項間の流用はできないことを失念しており、不適正な事務処理となる流用を行ってしまった"@ja.
<< kg:id_108 prop:effect kg:id_111 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "地方公営企業法施行令第18条第２項の規定に違反する事務処理が行われていた"@ja.
<< kg:id_108 prop:effect kg:id_112 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "予算の透明性や信頼性を損なうものであり、重大な問題と考える"@ja.
<< kg:id_113 prop:contermeasure kg:id_114 >>
    prop:text-txt_contents "予算の不足する部分は早めに認識しておくこと、それが予算に定めのない項間流用にならないかを早めに確認しておくべきだ"@ja.
<< kg:id_113 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "複数人によるチェック体制の整備、年度途中における予算執行管理の強化、公営企業会計の研修会への参加"@ja.
<< kg:id_116 prop:contermeasure kg:id_117 >>
    prop:text-txt_contents "初めに、本市事業等による利活用、その後に地域団体等による公益目的での利活用といったように段階を踏んで検討していく"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:text-txt_contents "第五中学校についてサウンディング型市場調査を実施するかどうかは現時点で決まっておらず、今後必要性を検討していきたい"@ja.
<< kg:id_120 prop:cause kg:id_121 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "利用率は、登録者のうち、マイナ保険証を利用して医療機関等を受診した割合であることから、数値に乖離がある"@ja.
<< kg:id_122 prop:contermeasure kg:id_123 >>
    prop:text-txt_contents "認知症や障がいのある方などでマイナ保険証の登録が難しい場合、現行の保険証に代わる資格確認書を交付する"@ja.
<< kg:id_124 prop:cause kg:id_125 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "（仮称）栗子山風力発電事業が事業の推進方法に多くの問題点を抱えていることから、事業を白紙撤回すべきである"@ja.
<< kg:id_124 prop:cause kg:id_126 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "環境影響評価準備書や住民説明会の議事録の公開などに関する事業者の対応が不十分であったため、米沢市長から事業者に対し事業の白紙撤回を求めていただいた"@ja.
<< kg:id_124 prop:cause kg:id_127 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "事業者が景観法上必要な手続をせずに風況観測用の作業道を整備した"@ja.
<< kg:id_128 prop:effect kg:id_129 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "住民から獣害の増加を懸念する意見が寄せられている"@ja.
<< kg:id_130 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "米沢市長が事業者に対し事業の白紙撤回を要求し"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "米沢牛のふんを使ったバイオマス発電のように米沢の自然に合った再生可能エネルギーの活用ができればよい"@ja.
<< kg:id_134 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "生態系・生物多様性に配慮し、地質などの環境を含め、場所や規模を設定することが重要"@ja.
<< kg:id_136 prop:cause kg:id_137 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "地球温暖化を止めるために風力発電を推進し再生可能エネルギーを供給してもらいたい"@ja.
<< kg:id_124 prop:cause kg:id_138 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "谷筋の大規模盛土の土砂崩壊による土石流の発生や対象事業実施区域内に地滑り地形が存在することから、本工事に伴う地滑りの発生など、土砂災害の懸念"@ja.
<< kg:id_124 prop:cause kg:id_139 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "絶滅が危惧されるイヌワシの飛翔が多数確認され、重要な採食地・狩り場になっており"@ja.
<< kg:id_124 prop:cause kg:id_140 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "大規模な土地の改変による水環境、水生生物の生息・生育環境、生態系等への影響の懸念"@ja.
<< kg:id_141 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "関係地方公共団体、関係機関等と調整を十分に行い、地域住民等に対し、丁寧かつ十分な説明を行う"@ja.
<< kg:id_143 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "全ての市町村で学校給食の無償化を実施できるよう、国に財政支援等を求め"@ja.
<< kg:id_145 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "陳情は、その写しを議員に配付する取扱いとすることに伴い、所要の改正を行う"@ja.
<< kg:id_147 prop:cause kg:id_148 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "令和５年度米沢市立病院事業会計決算について不認定という御判断がなされましたことを大変重く受け止め"@ja.
<< kg:id_30 prop:contermeasure kg:id_149 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "今後、法令を遵守し適切な運用となるよう指導を徹底してまいります"@ja.
}
