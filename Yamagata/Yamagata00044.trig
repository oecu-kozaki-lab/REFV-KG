kg:st_1 rdfs:label "五十嵐英治議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "国同士の大きな国際交流事業に進展した縁ときずなを大事にすべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "酒田市を国内外に発信する絶好のチャンスとして今後の躍進につながることを期待"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_3 prop:content "国内外に黒森歌舞伎と黒森地域と酒田をアピールできた大成功の公演"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "座長の倒病で大きなトラブルが生じた"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "座長の病状により関係者の不安が大きくなった"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_3 rdfs:label "五十嵐良弥新座長"@ja.
kg:st_3 rdf:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_6 prop:content "市関係者の力添えが公演実現の大きな心の支えになった"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "当局の配慮と尽力に感謝する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_4 rdfs:label "村上幸太郎教育長"@ja.
kg:st_4 rdf:type cls:st_31.
cls:st_31 rdfs:label "教育委員会"@ja.
kg:op_8 prop:content "両公演とも高い評価を得たと感じている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "公演後の反応は非常に盛況だった"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "継承の決意が新たになったことが大きな成果"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "黒森歌舞伎は地域の誇りであり地域の宝だと再認識した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "多様なワークショップが交流成果につながった"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "子どもたちが相手国に興味を持つ成果につながった"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "文化紹介のための取り組みを行った"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
kg:op_15 prop:content "参加者が多く予定時間を超えるほど盛況だった"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "ワークショップが酒田への関心喚起につながった"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "子どもたちがポーランドに行ってみたいと答えた"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "相手国文化への関心が交流事業の成果だった"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "国や県への積極的な支援要請で助成金獲得につながった"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "次なるステージとして国指定文化財を目指したい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "法改正を受けて導入に向けた研究を進めている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "地域とともにある学校をより進化させる体制"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "導入には教育振興基本計画への位置づけが必要"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "導入には組織づくりと委員任命の準備が必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "導入には報酬準備も必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "導入には市長部局との連携が必要"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "関係者への周知と研修が必要"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "制度内容をしっかり説明する必要がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "小中一貫教育との相乗効果を見きわめながら導入を前向きに検討したい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "早急に実施に向けた検討をすべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:st_5 rdfs:label "佐藤喜紀議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_31 prop:content "限られた旅行需要の中で酒田ファンを増やす必要がある"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:op_32 prop:content "地域間競争が激化する中で情報発信強化が必要"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:st_6 rdfs:label "佐々木好信交流推進調整監"@ja.
kg:st_6 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_33 prop:content "酒田の観光情報発信の中心として機能している"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "インバウンド対応として整備している"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "必要な観光情報に1回で届くよう改善を進めている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "県外イベントや観光施設などに広く配布している"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:op_37 prop:content "観光施設紹介のため設置した"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_6.
kg:op_38 prop:content "情報発信を市全体で一体的に取り組めていないことが課題"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_6.
kg:st_7 rdfs:label "竹越攻征農林水産部長"@ja.
kg:st_7 rdf:type cls:st_32.
kg:op_39 prop:content "個々のイベントは良いが面的な広がりが足りない"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_7.
kg:op_40 prop:content "冬のうちに総点検して来年度事業に生かしたい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_7.
kg:op_41 prop:content "産地間競争に勝つにはプロの技術を取り入れるのが有効"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_7.
kg:op_42 prop:content "情報発信ツールは一部市民の利活用にとどまっている"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:st_8 rdfs:label "梅木和広危機管理監"@ja.
kg:st_8 rdf:type cls:st_32.
kg:op_43 prop:content "各媒体に長所短所があり対象年齢層も異なる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_8.
kg:op_44 prop:content "できる限り多様な方法で情報発信を行っている"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_8.
kg:op_45 prop:content "クルーズ船寄港時のおもてなしは高い評価を受けた"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "知名度向上と酒田ファンづくりと経済発展につなげたい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "現時点では考えていないが今後のあり方は検討したい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "ワンプッシュで情報が得られる利便性から検討してほしい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_5.
kg:st_9 rdfs:label "菊池裕基健康福祉部長"@ja.
kg:st_9 rdf:type cls:st_32.
kg:op_49 prop:content "今後一層制度を活用する方が増える可能性が高い"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_9.
kg:op_50 prop:content "市民への周知を現在行っている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_9.
kg:op_51 prop:content "市民後見人が選任された事例がない背景に認知度の低さがある"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_9.
kg:op_52 prop:content "市民後見人養成を支える中核機関として必要"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_9.
kg:st_10 rdfs:label "冨樫覚議員"@ja.
kg:st_10 rdf:type cls:st_16.
kg:op_53 prop:content "社会福祉協議会の体制を強化して支援センター役割を担わせるべき"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_10.
kg:op_54 prop:content "情報交換会を発展させてネットワーク構築につなげたい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_9.
kg:op_55 prop:content "令和3年度末までの設置目標に向け協議を開始した"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_9.
kg:op_56 prop:content "市は家庭裁判所につなぐ対応をしている"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_9.
kg:op_57 prop:content "後見人業務のチェック機能を持つ家庭裁判所につなぐ対応をとっている"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_9.
kg:op_58 prop:content "流域型洪水の怖さを改めて認識した"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_8.
kg:op_59 prop:content "天気予報や水位変化に応じた防災行動をあらかじめ決めている"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_8.
kg:op_60 prop:content "関係機関との密接な情報連携で早めの防災対応をとる"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_8.
kg:op_61 prop:content "住民主体の防災対策への転換が必要"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_8.
kg:op_62 prop:content "市民一人一人の防災意識が命を守る上で重要"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_10.
kg:op_63 prop:content "住民が主体的に行う活動を支援して防災力を高めたい"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_8.
kg:op_64 prop:content "緊急避難場所としての指定は今後も拡大していく"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_8.
kg:op_65 prop:content "近くの学校もいつでも入れる避難場所として増やしてほしい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_10.
kg:op_66 prop:content "保管場所や費用面の課題から企業支援も検討する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_8.
kg:op_67 prop:content "避難所での生活環境向上につなげたい"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_8.
kg:st_11 rdfs:label "武田恵子議員"@ja.
kg:st_11 rdf:type cls:st_16.
kg:op_68 prop:content "相談したくても窓口がすぐわからないという苦情がある"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_11.
kg:op_69 prop:content "もっとわかりやすい内容に改善しなければならない"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "ワンクリックで空き家のページにたどり着くよう改善したい"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "総合相談窓口がわかるよう掲載したい"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "広報紙でも相談窓口の周知に努めたい"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "現状や対策や体制を市民に知らせるため策定したい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "不安な市民が相談しやすくするため早期に策定すべき"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_11.
kg:op_75 prop:content "既存組織を活用して速やかに計画策定につなげたい"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "速やかに全庁共有し所管施設への周知を行った"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_9.
kg:op_77 prop:content "市民への注意喚起をホームページで行った"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_9.
kg:op_78 prop:content "県の公表が確実な情報源のため前段階での公表は難しい"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_9.
kg:op_79 prop:content "広がりを防ぐためにはもっと早い情報共有が必要"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_11.
kg:op_80 prop:content "今後の検討課題である"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_9.
kg:op_81 prop:content "張り紙ぐらいは全部のトイレにしてほしかった"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_11.
kg:op_82 prop:content "今後も保健所などと連携し迅速かつ適切に対応したい"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_9.
kg:op_83 prop:content "初動対応を見直し拡大を最小限にとどめるべき"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_11.
kg:op_84 prop:content "今回のことを教訓に見直し等も検討していきたい"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_9.
kg:st_12 rdfs:label "阿部勉企画部長"@ja.
kg:st_12 rdf:type cls:st_32.
kg:op_85 prop:content "国や県の方針に向けた取り組みが重要"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_12.
kg:op_86 prop:content "企業の理解を深め社会環境整備につなげたい"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_12.
kg:op_87 prop:content "先進地視察などを通じ取り組みを支援したい"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_12.
kg:op_88 prop:content "水素技術の開発研究と先進モデル確立に向け要望を継続する"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_12.
kg:op_89 prop:content "中長期的なエネルギー政策を進める上で重要"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_12.
kg:op_90 prop:content "地方への研究機関の誘致は難しい"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_12.
kg:op_91 prop:content "実証実験の進展を注視し情報収集に努める"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_12.
kg:op_92 prop:content "洋上風力発電の導入拡大への期待は大きい"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_12.
kg:op_93 prop:content "来年度に国の法定協議会設置を目指している"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_12.
kg:op_94 prop:content "地域経済への波及効果が期待できる"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_12.
kg:op_95 prop:content "港湾整備にもつながる事業と考える"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_12.
kg:st_13 rdfs:label "進藤晃議員"@ja.
kg:st_13 rdf:type cls:st_16.
kg:op_96 prop:content "背後地や道路整備も含め県と国への働きかけが必要"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_13.
kg:op_97 prop:content "漁業者第一で良好な関係が最重要"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_12.
kg:op_98 prop:content "漁業従事者に配慮した形で進めるべき"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_13.
kg:op_99 prop:content "港湾や送電網や道路などの整備を要望していく"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_12.
kg:st_14 rdfs:label "矢口明子副市長"@ja.
kg:st_14 rdf:type cls:st_32.
kg:op_100 prop:content "常時混雑しており今年度は3回満車を確認した"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_14.
kg:op_101 prop:content "今年度は大学前で3回確認している"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_14.
kg:op_102 prop:content "来年度以降タクシー代行で対応したい"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_14.
kg:st_15 rdfs:label "齋藤直議員"@ja.
kg:st_15 rdf:type cls:st_16.
kg:op_103 prop:content "どのような運用になるか詳しく知りたい"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_15.
kg:op_104 prop:content "小型車両でも住宅街の中までなかなか入れない事情がある"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_14.
kg:op_105 prop:content "バス路線再編の検討の中で取り組みたい"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_14.
kg:op_106 prop:content "市民の意見を聞きながら検討してほしい"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_15.
kg:op_107 prop:content "自治会長と近隣住民と調整済みで速やかに移設する"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_14.
kg:op_108 prop:content "近年は応募が少なく収入も減少傾向にあった"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_14.
kg:op_109 prop:content "来年以降の車体広告予約を3件受けている"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_14.
kg:op_110 prop:content "経費削減にも取り組んでいる"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_14.
kg:op_111 prop:content "今まで以上に広告募集を考えていきたい"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_14.
kg:op_112 prop:content "商工会議所などとの連携も検討してほしい"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_15.
kg:op_113 prop:content "委託先バス会社が具体的に取り組んでいる"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_14.
kg:op_114 prop:content "万が一の場合に備え緊急体制を整備している"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_14.
kg:op_115 prop:content "交通事業者を救うため国と企業が主体で取り組んでいる"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_14.
kg:op_116 prop:content "実用化されれば高齢化が進む地域の希望になる"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_14.
kg:op_117 prop:content "コストや採算性や法整備など課題を見ながら注視したい"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_14.
kg:op_118 prop:content "今後の可能性について注視してほしい"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_15.
kg:op_119 prop:content "今年は架空請求詐欺による高額被害が発生した"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_14.
kg:op_120 prop:content "昨年より被害額が増えた要因"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_14.
kg:op_121 prop:content "見守りや訪問活動の中で啓発活動への協力をお願いしている"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_14.
kg:op_122 prop:content "留守番電話設定をした世帯での被害はない"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_14.
kg:op_123 prop:content "行政と警察機関と一緒になって被害ゼロを目指すべき"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_15.
kg:op_124 prop:content "複層的な啓発強化に取り組みたい"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_14.
kg:op_125 prop:content "早期実現に向け公共交通担当部門と連携したい"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_14.
kg:op_126 prop:content "高齢者利用が多いバスでのアナウンスや掲示は予防啓発につながる"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_15.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "これは日本とポーランドとの国交樹立100周年を記念した歴史的な公演となりました"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "酒田黒森歌舞伎ポーランド公演が一躍大きな話題となったことは、まさに酒田市を内外に情報発信することができた大きな成果であります"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "公演が近づいた９月下旬に、それまでポーランド公演実現に向けさまざまな推進活動の中心となって行動してきた冨樫久一座長が脳疾患で倒れ"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "厳しい病状のため、座員や関係者の間には大きな不安が広がりました"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "派遣団に加わりました丸山市長初め市関係者の方々より、物心両面にわたるお力添えや御指をいただきましたことが座員や関係者にとっては非常に大きな心の支えとなり、今回のポーランド公演を無事に実現することができた"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "両公演とも、観客数やレセプションでの観客の皆さんからの感想をいただきましたけれども、高い評価をいただいたのではないかと感じているところでございます"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "公演終了後には観客からのスタンディングオベーションが鳴りやまなかったと伺っております"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "黒森歌舞伎妻堂連中の皆さんが、今回のポーランド公演を通して、これまで受け継がれてきた黒森歌舞伎をこれからもしっかり継承していこうという決意を新たにされた"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "１つは勘亭流の書家によるワークショップ"@ja.
<< kg:id_10 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "２つ目には黒森小学校とポーランドの小学校との両方で行います夢傘福アートプロジェクト"@ja.
<< kg:id_10 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "３つ目は押絵倶楽部によりますワークショップ"@ja.
<< kg:id_10 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "４つ目は歌舞伎体験というワークショップ"@ja.
<< kg:id_10 prop:effect kg:id_15 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "参加者からはぜひ酒田に行ってみたいというような声も出た"@ja.
<< kg:id_10 prop:effect kg:id_16 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "これを見た黒森小学校の子供たちはポーランドに興味をもちまして、ポーランドに行ってみたいと答えていた"@ja.
<< kg:id_10 prop:effect kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "日本・ポーランド両国の参加者がそれぞれ相手国の文化に興味を示していただいたことは、今回の交流事業の成果だった"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "山形県からは100万円"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:text-txt_contents "武蔵野市から100万円"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "酒田市のほうからは500万円の支援を行っております"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "国や県に積極的に支援を要請した結果"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:text-txt_contents "例えば国際交流基金"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:text-txt_contents "日本万国博覧会記念基金"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:text-txt_contents "三井住友海上文化財団"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:text-txt_contents "丸高歴史文化財団より助成金をいただいている"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "この地域の宝を妻堂連中の皆さんと一緒に、そして教育委員会の力もかりながら、国指定の文化財にまで持っていきたい"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "平成29年３月の法律改正で、コミュニティ・スクールの設置については教育委員会の努力義務に課せられている"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "学校運営協議会という組織を中核として、学校と地域住民が力を合わせて学校の運営に取り組む地域とともにある学校をより進化させることができる体制"@ja.
<< kg:id_30 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "コミュニティ・スクールをスタートさせるためには、教育振興基本計画にきちんと計画を位置づける必要がございます"@ja.
<< kg:id_30 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "具体的には組織づくりや委員の任命"@ja.
<< kg:id_30 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "報酬の準備"@ja.
<< kg:id_30 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "市長部局との連携"@ja.
<< kg:id_30 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "学校の管理職や教職員、学校協議会委員への周知と研修"@ja.
<< kg:id_30 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "保護者の方、地域住民の方、関係団体に向けてどのような制度なのかということをしっかりと説明する必要がある"@ja.
<< kg:id_28 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "コミュニティ・スクールの導入についても小中一貫を進めながら、前向きに検討していきたい"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "人口減少に伴う国内旅行者の減少"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "限られた旅行需要で地域間競争が激化しております"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "本市の観光情報サイトであります「酒田さんぽ」につきましては、月平均４万4,000件のアクセスがあるという状況でございます。酒田の観光における情報発信の中心"@ja.
<< kg:id_42 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "英語版の観光情報サイト「Ｓａｋａｔａ　Ｔｏｕｒｉｓｍ」というのをつくっております"@ja.
<< kg:id_42 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "五カ国語に対応している「ルートガイドｆｏｒ庄内・酒田」"@ja.
<< kg:id_42 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "紙ベースの観光パンフレット「さかたさんぽ」につきましては、県外のイベントなどでまず年間１万部、それから市外の観光施設とか宿泊施設に２万部、それから酒田市内の観光施設、宿泊施設などにも２万部を配布"@ja.
<< kg:id_42 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "ことしの３月、23基の観光施設を紹介する「まちなかサイン」を設置しております"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "その方々への情報発信を市全体で一体的に取り組むというようなことが確立できていないというようなことが課題"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "一つ一つがいいというので、点と点で、線で結ばっていないと言ったらいいんでしょうか、面的広がりがもう少しあるとより効果的な発信になる"@ja.
<< kg:id_50 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "しっかりとみんなでカレンダーをいま一度ばーっと並べて、どこにどういう行事があって...分析して、戦略を練りながらしっかり取り組んでみたい"@ja.
<< kg:id_50 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "プロの技術というのを少し予算をつけながら得てみるのもいいのではないかな"@ja.
<< kg:id_54 prop:cause kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "年齢や職業、行政への関心度の違いにより、利用頻度については偏りが大きく、一部の市民の利活用にとどまっているように感じられます"@ja.
<< kg:id_54 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "広報紙、市ホームページ、ＳＮＳ、コミュニティＦＭ、メールマガジン、各報道機関へのプレスリリースや記者会見など、できる限り多様な方法での情報発信を行っております"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "市民との触れ合いそのものが情報発信の機会となっている"@ja.
<< kg:id_57 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "このシティプロモーションの一環として意図的に内外に発信していくことによりまして、本市の知名度の向上、そして酒田ファンづくり、そしてひいては本市の経済発展、本市の振興に結びつけていきたい"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "改めて市の情報を一括して掲載するような自治体アプリの導入、これにつきましては現時点では考えていませんけれども、今後環境の変化等も踏まえながら、少し勉強してまいりたい"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "高齢者や認知症の方が増加している状況から、今後一層成年後見制度を活用する方がふえる可能性は高い"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "現在市ホームページ、それから福祉課窓口でのリーフレットの配布、また個別の相談による後見人制度の周知を図っておりまして、ほかにも出前講座で自治会やコミュニティ振興会などに出向いて制度の説明を行っている"@ja.
<< kg:id_64 prop:cause kg:id_66 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "成年後見人に対する市民認知度が低い状況にあることから、市民後見人が選任された事例はない"@ja.
<< kg:id_64 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_52;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "まずはそれらを支援するための中核機関となります成年後見支援センターの設置検討を進めていきたい"@ja.
<< kg:id_64 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "ことしの９月25日に...地域連携ネットワークの構築に向けた協議を行う情報交換会を実施しております"@ja.
<< kg:id_64 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "本市ではその実現に向けて、法人後見事業の実施団体である酒田市社会福祉協議会と協議を始めたところでございます"@ja.
<< kg:id_64 prop:effect kg:id_70 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "申立人が後見人を変更してほしいと訴えているとの相談を受けた事例はございます"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "後見人業務のチェック機能を持つ家庭裁判所につなぐ対応をとっております"@ja.
<< kg:id_73 prop:effect kg:id_74 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "支流での氾濫とともに最上川の洪水が発生し、大規模な災害に至る危険性があり、改めて流域型洪水の怖さを認識した"@ja.
<< kg:id_73 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "今年度は関係機関とともに洪水タイムラインを策定しており、災害対応に当たっては当該タイムラインに沿った防災行動をとる"@ja.
<< kg:id_73 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "国土交通省酒田河川国道事務所や山形地方気象台から収集し、最大６時間先の水位予測について情報を共有"@ja.
<< kg:id_77 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_61;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "市民一人一人が防災意識を持ち、自分の命は自分で守るという意識の啓発に努めていく必要があります"@ja.
<< kg:id_77 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "自主防災組織による地区防災計画の策定や避難地図の作成など、住民が主体的に行う活動をしっかりと支援していく"@ja.
<< kg:id_80 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_64;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "津波浸水区域以外でも、洪水の避難対応を含め、緊急避難場所としての指定については今後も拡大してまいります"@ja.
<< kg:id_82 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "生活に必要な資機材等の整備については、市が直接導入するには保管場所や費用面などの課題もあるために、応援協定などによって企業から支援していただく部分も検討していきたい"@ja.
<< kg:id_82 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "山形三菱と電気自動車からの電気の供給に関して協定を締結いたしました"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_68;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "ホームページを見てもわかりにくいという議員の御意見、これは、やはりもっとわかりやすい内容に改善をしていかなければならない"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "トップページにあります「住宅・都市環境」というボタンみたいなものがあります。このカテゴリーの中に「空き家」としっかり明記をして"@ja.
<< kg:id_87 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "このサイトの相談先一覧に市の空き家の総合相談窓口がわかるようにはっきりと掲載をしてまいりたい"@ja.
<< kg:id_87 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "改めて広報にも特集として掲載をし、空き家の現状、相談窓口の周知等にしっかりと、広報紙の面でも努めてまいりたい"@ja.
<< kg:id_87 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "この空家等対策計画につきましては、今後速やかに酒田市としても策定してまいりたい"@ja.
<< kg:id_87 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "この組織を母体に法定協議会としても機能するように何とか活用をしていきたい"@ja.
<< kg:id_93 prop:countermeasure kg:id_94 >>
    prop:text-txt_contents "12月４日中に庄内保健所で保育所に入り状況を確認し、消毒方法などを指導する"@ja.
<< kg:id_93 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "健康課からは速やかに全庁に情報提供をするとともに、施設の所管課等に対しては、所管施設等への注意喚起や感染予防に関する周知の依頼"@ja.
<< kg:id_93 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "市民に対しては、ホームページで同様の周知を図っているところでございます"@ja.
<< kg:id_93 prop:countermeasure kg:id_97 >>
    prop:text-txt_contents "教育委員会では、小中学校長宛てに注意喚起及び消毒方法について通知を出しております"@ja.
<< kg:id_93 prop:countermeasure kg:id_98 >>
    prop:text-txt_contents "保育園、認定こども園、それから児童センター、子育て支援センターやファミリーサポートセンター、それから学童保育所、また、介護保険課のほうでも、市内の入所施設や通所施設等に情報提供と注意喚起"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_78;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "県からの公表後でなければ、市から市民や関係機関に対し周知することはできない状況"@ja.
<< kg:id_101 prop:effect kg:id_102 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_80;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "庁内各課から全ての施設まで注意喚起が行き届かない面があった"@ja.
<< kg:id_101 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_82;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "今後も保健所などと連携し、迅速かつ適切な対応に努めてまいりたい"@ja.
<< kg:id_101 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "今回のことにつきましては、いい教訓になろうと考えております。こういったことも含めて見直し等も検討していきたい"@ja.
<< kg:id_105 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "本市においては、豊富な自然エネルギーや再生可能エネルギーがあることから、これらを活用し、安全安心で維持可能なエネルギーミックスを推進してまいります"@ja.
<< kg:id_107 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "水素エネルギーに関するセミナーの開催"@ja.
<< kg:id_107 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "先進地の視察などを通じまして、水素を活用する社会環境の整備及びサプライチェーンの構築につながる取り組みを支援していきたい"@ja.
<< kg:id_107 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "国や県に対しまして要望を継続してまいります"@ja.
<< kg:id_111 prop:effect kg:id_112 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "メタンハイドレートの開発は...重要であり、また、新たな産業の創出にもつながるものと考えております"@ja.
<< kg:id_111 prop:cause kg:id_113 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "実用化の見通しはいまだ立っておらず、地方への研究機関の誘致は難しい"@ja.
<< kg:id_111 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "今後も連合の取り組みを通じ、情報収集に努めてまいります"@ja.
<< kg:id_115 prop:cause kg:id_116 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "庄内沿岸海域の風速が年平均で７ｍ以上となっており、洋上風力発電の事業化の目安とされる風速を超えていることから、庄内の沿岸域は、洋上風力の適地"@ja.
<< kg:id_115 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "遊佐沖の促進区域指定に向けた検討が進められており、来年度に国の法定協議会設置を目指しております"@ja.
<< kg:id_115 prop:effect kg:id_118 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "洋上風力発電事業が進むことで、関連します企業集積も図られ、新たな雇用も生まれることが期待されます"@ja.
<< kg:id_115 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_95;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "酒田港中長期構想に風力発電設備の物流基地の形成を目指すことが盛り込まれていることから、港湾整備にもつながる事業と考えている"@ja.
<< kg:id_115 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_97;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "直接的な影響を受けます漁業者の理解を何よりも重要と位置づけまして、県とより一層の連携を図ってまいりたい"@ja.
<< kg:id_115 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "関連するインフラの整備についてもしっかりと国・県に対して要望をしてまいりたい"@ja.
<< kg:id_122 prop:cause kg:id_123 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "酒田駅大学線のかんぽの宿発７便、夕方の５時５分発ですけれども、この便が工業団地や大学からの帰宅者で常時混雑"@ja.
<< kg:id_122 prop:effect kg:id_124 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "今年度は、大学前で３回満車で乗れなくなった人がいることを確認しております"@ja.
<< kg:id_125 prop:countermeasure kg:id_126 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_102;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "来年度以降は、この酒田駅大学線の７便について、タクシーによる代行輸送を検討しております"@ja.
<< kg:id_127 prop:cause kg:id_128 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "道路幅員や交通事情を勘案し、住宅街の中までなかなか入れないという事情もございます"@ja.
<< kg:id_127 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_105;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "2022年３月をめどに進めておりますバス路線再編の検討の中で、路線の新設や経路の変更、またバス停の配置も含めて取り組んでいきたい"@ja.
<< kg:id_130 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "駅東公園の前の北進側でございますけれども、このバス停の移設について、自治会長、近隣住民とは調整済みでありまして、適切に周知期間を設けた上で速やかに移設"@ja.
<< kg:id_132 prop:cause kg:id_133 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "近年は応募が少なく収入も減少傾向にありました"@ja.
<< kg:id_132 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "来年以降は、るんるんバスへの車体広告の予約を３件いただいております"@ja.
<< kg:id_132 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "今年度からは、広告で得られた収入を原資としたバスの時刻表も作成"@ja.
<< kg:id_132 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_111;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "さらに、バス停への広告の募集も検討しておりまして、今まで以上に広告募集、何ができるか考えていきたい"@ja.
<< kg:id_137 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "健康診断の義務づけ、それから健康状態の把握、運行管理者による毎回の点呼を実施しております"@ja.
<< kg:id_137 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "運行中の運転手の体調変化等による万が一の場合には、運行中止等の判断・指示を適切に実施するための緊急の体制も整備しております"@ja.
<< kg:id_140 prop:cause kg:id_141 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "自動運転は、慢性的な運転手不足、人手不足に苦しむ交通事業者を救うため"@ja.
<< kg:id_140 prop:effect kg:id_142 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "自動運転の実用化が実現されれば、高齢化が進み、公共交通が脆弱な全国の過疎地域の大きな希望となる"@ja.
<< kg:id_140 prop:countermeasure kg:id_143 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_117;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "本市としても、自動運転システムの動向については注視していきたい"@ja.
<< kg:id_144 prop:effect kg:id_145 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "令和元年11月末現在の酒田警察署管内における特殊詐欺被害認知件数は３件、被害額は約2,500万円"@ja.
<< kg:id_144 prop:cause kg:id_146 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "昨年に比べ被害額がふえたのは、架空請求詐欺による高額被害が発生したためです"@ja.
<< kg:id_147 prop:countermeasure kg:id_148 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "民生委員を対象とした研修会や出前講座を通じて、特殊詐欺の手口などの情報共有"@ja.
<< kg:id_147 prop:countermeasure kg:id_149 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_122;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "常時留守番設定にするよう促すなど、特に力を入れております。この留守番電話設定をした世帯での被害はない"@ja.
<< kg:id_147 prop:countermeasure kg:id_150 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "民生委員の皆様からも訪問の折に注意喚起していただきますよう、改めてお願いをしてまいります。また、あわせて、地域包括センターなどにも同様の協力をお願いする"@ja.
<< kg:id_147 prop:countermeasure kg:id_151 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_125;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "車内広告につきましては、早期の実現に向けて、市の公共交通担当部門と連携していきたい"@ja.
}
