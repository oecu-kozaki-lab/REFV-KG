kg:id_181 rdf:type cls:c_1286.
cls:c_1286 rdfs:label "能力向上"@ja.
kg:id_175 prop:contermeasure kg:id_181.
kg:st_1 rdfs:label "佐藤喜紀議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "管理運営に様々な問題があると懸念する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "齋藤直議員"@ja.
kg:st_2 rdfs:type cls:st_16.
kg:op_2 prop:content "次世代につなぐ責任を持ち課題に取り組むべきと考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "環境省"@ja.
kg:st_3 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_3 prop:content "今後高齢化でごみ出し困難な住民が増えると見ている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "ごみステーションまで行くのが大変だとの声がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "高齢者のけがのリスクが高まると感じる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_4 rdfs:label "安藤浩夫議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_6 prop:content "少子化の原因は未婚化であるとみる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:st_5 rdfs:label "佐藤猛議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_7 prop:content "観光関連産業への影響は非常に大きいとみる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_5.
kg:st_6 rdfs:label "丸山市長"@ja.
kg:st_6 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_8 prop:content "観光業と飲食業への影響が非常に大きいと受け止めている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_6.
kg:op_9 prop:content "中国の企業活動の減速で国内製造業にも大きな打撃が出ているとみる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_5.
kg:op_10 prop:content "突然の休校で子供も保護者も大慌てになったとみる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "共働き世帯と独り親世帯にとって深刻な問題だとみる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_5.
kg:st_7 rdfs:label "池田博夫議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_12 prop:content "社員の解雇や倒産につながることを危惧する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_7.
kg:op_13 prop:content "企業で雇い止めが多く発生していると聞いている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_7.
kg:op_14 prop:content "県内外への新しい海水浴場の在り方として情報発信につながると期待する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "広告スペースを確保して積極的に事業を行うべきと考える"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "広告事業を専門的に扱う窓口や部署が必要と考える"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:st_8 rdfs:label "琢成学区コミ振会長"@ja.
kg:st_8 rdfs:type cls:st_14.
cls:st_14 rdfs:label "地域団体"@ja.
kg:op_17 prop:content "地域住民は自分たちで守る活動を続けている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_8.
kg:st_9 rdfs:label "村上幸太郎教育長"@ja.
kg:st_9 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_18 prop:content "子供も大人も一緒にやる避難訓練の段階に行くべきだと考える"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_9.
kg:st_10 rdfs:label "松本国博議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_19 prop:content "酒田港からの米輸出はこれから目指すべき方向の一つと期待する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_10.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "要因として、天候不順、日焼け防止などが考えられます"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "要因として、天候不順、日焼け防止などが考えられます"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "海水浴場運営に協力をいただいている海水浴場実行委員会の方々については、一定の人数を確保できているものの曜日により人手不足が生じるなど、様々な問題を抱えているようであります"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:text-txt_contents "利用者の減少に伴って実行委員会の収支も悪くなっているという状況でございます"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:text-txt_contents "さらに少子高齢化に伴いまして、人員確保が難しいという状況にある"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:text-txt_contents "ホームページのバナー広告につきましては、以前、年に１社から２社の応募がありましたけれども、残念ながら今年度は応募がなくて、現在も募集をしている状況になります"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "市が行っております広告募集が企業、団体の皆様からあんまり知られていないことも考えられるために"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本市の総人口の推移では、人口減少傾向が今後さらに加速され"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:text-txt_contents "若者世代でいいますと、例えば移住であるとかＵターンの若者のみを対象とする支援、例として若者のみの住宅、若者のみのＵターン者への支援あるいは孫ターンのみの施策、こういった項目がございまして、本市では移住、Ｕターンのあまり世代を問わない支援策を中心としておりますので、この辺で上位との差がついた"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:text-txt_contents "子育てについては、やはり若者と同じように子育てのみの施策という項目がございました"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:text-txt_contents "酒田にはかつてはいっぱいあったんですけれども、今は全て認定こども園ということで、正確には幼稚園がない"@ja.
<< kg:id_18 prop:cause kg:id_21 >>
    prop:text-txt_contents "義務教育の給食、保育園の給食を無償化しているか"@ja.
<< kg:id_18 prop:cause kg:id_22 >>
    prop:text-txt_contents "高校生の医療を無償化しているかと、こういったお金をかければできるというようなものもやっていないものもありまして"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "環境省の調査によると、「今後、高齢化によるごみ出し困難な住民が増える」とした自治体が87.1％に上がる"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "私の住むまちは坂道が多く、平坦な土地が少ないところであります"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "冬道の凍った道路での大きなごみを持って歩くことで、転倒によるけがのリスクは高まってくるのではないか"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "初婚同士の夫婦の数が出生数と同率で減少している結果であり、少子化の原因は未婚化であることがよく分かります"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:text-txt_contents "本市においては20代から40代の女性が男性より約800人ほど少ない状況の中、婚活イベントを行っても女性の申込者が少なくなってきている"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:text-txt_contents "20代から50代の男性の半数以上は、平日に育児・家事等に費やす時間は１時間未満という結果になっており、まだまだ家事・育児等の分担が進んでいない"@ja.
<< kg:id_29 prop:cause kg:id_35 >>
    prop:text-txt_contents "本市における出生数の減少の背景には、付加価値の高い産業、魅力ある職種、女性が働きやすい環境が十分に確保されていないという現状があり"@ja.
<< kg:id_29 prop:cause kg:id_36 >>
    prop:text-txt_contents "本市における出生数の減少の背景には、付加価値の高い産業、魅力ある職種、女性が働きやすい環境が十分に確保されていないという現状があり"@ja.
<< kg:id_29 prop:cause kg:id_37 >>
    prop:text-txt_contents "本市における出生数の減少の背景には、付加価値の高い産業、魅力ある職種、女性が働きやすい環境が十分に確保されていないという現状があり"@ja.
<< kg:id_38 prop:cause kg:id_35 >>
    prop:text-txt_contents "このような本市における出生数の減少の背景には、付加価値の高い産業、魅力ある職種、女性が働きやすい環境が十分に確保されていないという現状があり、このことが若い世代、特に女性の転出超過"@ja.
<< kg:id_38 prop:cause kg:id_36 >>
    prop:text-txt_contents "このような本市における出生数の減少の背景には、付加価値の高い産業、魅力ある職種、女性が働きやすい環境が十分に確保されていないという現状があり、このことが若い世代、特に女性の転出超過"@ja.
<< kg:id_38 prop:cause kg:id_37 >>
    prop:text-txt_contents "このような本市における出生数の減少の背景には、付加価値の高い産業、魅力ある職種、女性が働きやすい環境が十分に確保されていないという現状があり、このことが若い世代、特に女性の転出超過"@ja.
<< kg:id_39 prop:cause kg:id_38 >>
    prop:text-txt_contents "このことが若い世代、特に女性の転出超過、それに伴う婚姻件数の減少につながっていく"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "発生当初、インバウンドの急速な落ち込みから、観光業界への影響ばかり取り上げられておりました"@ja.
<< kg:id_40 prop:effect kg:id_42 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "現在のところ、観光業、それから、飲食業に対する影響が非常に大きい"@ja.
<< kg:id_40 prop:effect kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "世界の工場と言われる中国の企業活動の大きな減速から、資材が調達できずに国内製造業にも大きな打撃を与えております"@ja.
<< kg:id_40 prop:effect kg:id_44 >>
    prop:text-txt_contents "地元飲食店におきましても、会合等のキャンセルが相次いでいる"@ja.
<< kg:id_40 prop:effect kg:id_45 >>
    prop:text-txt_contents "３月２日の安倍総理のコメントの発表後は、個人の宿泊客のキャンセルも増加をしている"@ja.
<< kg:id_40 prop:effect kg:id_46 >>
    prop:text-txt_contents "観光バスの立ち寄り数及び売上げは約４割減少をしている"@ja.
<< kg:id_40 prop:effect kg:id_47 >>
    prop:text-txt_contents "入り込み数では約２割"@ja.
<< kg:id_40 prop:effect kg:id_48 >>
    prop:text-txt_contents "観光イベントにつきましても自粛要請をしている。それから、酒田市自体も取りやめをしているものもございますので、この影響も大変大きなものがある"@ja.
<< kg:id_40 prop:effect kg:id_49 >>
    prop:text-txt_contents "酒田雛街道につきましては、主要展示は予定どおり開催をしておりますけれども、各施設で企画・実施するほとんど関連イベントの中止が決定しておりまして、大きな影響を及ぼしている"@ja.
<< kg:id_40 prop:effect kg:id_50 >>
    prop:text-txt_contents "現時点において大きな影響は出ていませんが、受注量が徐々に減少しているため、このままの状況が続くようであれば４月以降影響が出てくる"@ja.
<< kg:id_40 prop:effect kg:id_51 >>
    prop:text-txt_contents "取引先であります中国の工場の閉鎖の影響で、中国製の部品の供給のめどが立たないとの相談もあった"@ja.
<< kg:id_40 prop:effect kg:id_52 >>
    prop:text-txt_contents "全ての小中学校が臨時休校になったことに伴いまして、実はスクールバスを運行する業者の皆さん"@ja.
<< kg:id_40 prop:effect kg:id_53 >>
    prop:text-txt_contents "学校給食の納入業者の皆さんも少なからず影響が出ている"@ja.
<< kg:id_40 prop:effect kg:id_54 >>
    prop:text-txt_contents "生産者からの声として、取引価格が下がってきている"@ja.
<< kg:id_40 prop:effect kg:id_55 >>
    prop:text-txt_contents "イベント用のフラワー需要が軒並み下がっている"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "突然の発表に学校現場はもちろん、子供も保護者も大慌てとなりました"@ja.
<< kg:id_56 prop:effect kg:id_58 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "共働き世帯や独り親世帯にとっては、深刻な問題であります"@ja.
<< kg:id_40 prop:effect kg:id_59 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "企業経営が厳しくなり、それが社員の解雇、最悪の場合、倒産につながるのではないかと危惧している"@ja.
<< kg:id_40 prop:effect kg:id_60 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "現在、企業では非正規職員や臨時職員の雇い止めが多く発生していると聞いております"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:text-txt_contents "簡単にこの色をそろえると申し上げれば、実態は農地の入替えが生じてまいります"@ja.
<< kg:id_61 prop:effect kg:id_63 >>
    prop:text-txt_contents "おらいの土となしてあそこの家の土が一緒なんだと、対等なんだと、こういう納得感といいますか、感情論がどうしても出てまいります"@ja.
<< kg:id_64 prop:effect kg:id_65 >>
    prop:text-txt_contents "60歳以上は72％で2,249人とこういった形で、御指摘のとおり、ちょっとバランスが非常に厳しいという状況"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:text-txt_contents "県では、現在の指定病床18床を超える患者が発生した場合を想定し、感染症指定医療機関における感染者が入院できる病床を150床とする受入体制を整備している"@ja.
<< kg:id_68 prop:contermeasure kg:id_69 >>
    prop:text-txt_contents "まず、県内５か所の保健所に設置されております帰国者・接触者相談センターへ電話で相談いただくことになります"@ja.
<< kg:id_68 prop:contermeasure kg:id_70 >>
    prop:text-txt_contents "相談者の感染が疑われる場合は、県内に13か所設置されている帰国者・接触者外来の受診につなげる"@ja.
<< kg:id_68 prop:contermeasure kg:id_71 >>
    prop:text-txt_contents "帰国者・接触者外来の医師と保健所がＰＣＲ検査を実施する必要があると判断した場合は検体が採取され"@ja.
<< kg:id_68 prop:contermeasure kg:id_72 >>
    prop:text-txt_contents "陽性とされた場合は、感染症対策の設備が整っている感染症指定医療機関へ入院となります"@ja.
<< kg:id_68 prop:contermeasure kg:id_73 >>
    prop:text-txt_contents "県では、医療関係者等による新型コロナウイルス感染症医療連絡会議を開催し、患者の受入体制の確認や情報共有を図っております"@ja.
<< kg:id_68 prop:contermeasure kg:id_74 >>
    prop:text-txt_contents "庄内保健所が中心となり、地区医師会、医療機関、市・町、消防等の関係者による庄内地域感染症対策連絡会議を開催し、今後の対応などの課題等を共有するとともに、連携体制の構築を図っております"@ja.
<< kg:id_68 prop:contermeasure kg:id_75 >>
    prop:text-txt_contents "本市独自に地区医師会、歯科医師会、薬剤師会、日本海総合病院といった医療機関との意見交換会を開催し、情報共有や今後の対応等について協議を行っております"@ja.
<< kg:id_68 prop:contermeasure kg:id_76 >>
    prop:text-txt_contents "県からの注意喚起のプレスリリースが出される前から市ホームページによりいち早く情報提供及び注意喚起を実施しております"@ja.
<< kg:id_68 prop:contermeasure kg:id_77 >>
    prop:text-txt_contents "２月14日には新型コロナウイルス感染症に関する相談先や感染予防に関するお知らせを4,000枚作成し、自治会回覧を実施いたしました"@ja.
<< kg:id_68 prop:contermeasure kg:id_78 >>
    prop:text-txt_contents "３月16日には、各種相談先とＱ＆Ａを掲載したチラシ４万2,000枚を市内全世帯へ配布する予定であります"@ja.
<< kg:id_68 prop:contermeasure kg:id_79 >>
    prop:text-txt_contents "ハーバーラジオも活用し、朝と昼に放送されているインフォメーションさかたにおいて、毎日繰り返し注意喚起を実施しております"@ja.
<< kg:id_68 prop:contermeasure kg:id_80 >>
    prop:text-txt_contents "コミュニティセンターにおいては、例年、インフルエンザの流行期には手洗いの励行、せきエチケットの徹底などについてチラシを掲示するなど感染症予防について周知するようにしております"@ja.
<< kg:id_68 prop:contermeasure kg:id_81 >>
    prop:text-txt_contents "各コミュニティ振興会のほか、各自治会連合会に対し市の方針を周知し、改めて手洗いの励行、せきエチケットの徹底に加え、アルコール消毒液の設置を呼びかける"@ja.
<< kg:id_68 prop:contermeasure kg:id_82 >>
    prop:text-txt_contents "山形県教育委員会作成の手引「学校における危機管理の手引き　学校保健編」を各校に配布し"@ja.
<< kg:id_68 prop:contermeasure kg:id_83 >>
    prop:text-txt_contents "児童・生徒が主体となり、うがい・手洗い・換気の励行を呼びかけるなど、日常の予防活動にも取り組んでおります"@ja.
<< kg:id_68 prop:contermeasure kg:id_84 >>
    prop:text-txt_contents "さらに、アルコールによる手指消毒や給食時の座席配置の工夫などに取り組んでおります"@ja.
<< kg:id_68 prop:contermeasure kg:id_85 >>
    prop:text-txt_contents "給食時の座席配置の工夫などに取り組んでおります"@ja.
<< kg:id_68 prop:contermeasure kg:id_86 >>
    prop:text-txt_contents "休校中は不要不急の外出は控え、マスクの着用・手洗い・うがいを励行し、感染症の予防・拡散防止に努めるよう指導しております"@ja.
<< kg:id_87 prop:contermeasure kg:id_88 >>
    prop:text-txt_contents "３月11日に市役所内に事業主を対象とした新型コロナウイルス関連経済対策窓口を設置をさせていただいた"@ja.
<< kg:id_89 prop:contermeasure kg:id_90 >>
    prop:text-txt_contents "信用保証協会に対して支払う保証料を県と市と信用保証協会でそれぞれ補給をして、中小企業者が保証料を負担することなく保証制度を利用できるように対応していく"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:text-txt_contents "売上げが15％以上減少した中小企業に対して、地域や業種を問わずに２億8,000万円を上限に借入金を100％保証する制度"@ja.
<< kg:id_89 prop:contermeasure kg:id_92 >>
    prop:text-txt_contents "売上げが５％以上減少した事業主については、金利を一律0.9％引き下げたり、低金利で融資が受けられるようにしております"@ja.
<< kg:id_89 prop:contermeasure kg:id_93 >>
    prop:text-txt_contents "売上げが15％から20％以上減少するなどの厳しい経営状況の事業主に対しては、国が３年間の利子を補給をし、実質的に無利子・無担保で融資が受けられる"@ja.
<< kg:id_94 prop:contermeasure kg:id_95 >>
    prop:text-txt_contents "年次有給休暇とは別途有給休暇を与えた企業への助成金、これ上限8,330円です"@ja.
<< kg:id_96 prop:contermeasure kg:id_97 >>
    prop:text-txt_contents "フリーランスと言われる個人就業者では、保護者が就業できなかった日数に応じて4,100円、これは定額で支給する制度"@ja.
<< kg:id_98 prop:contermeasure kg:id_99 >>
    prop:text-txt_contents "収入減があった世帯に一時的な緊急小口資金の貸付け、これは10万円以内となっております"@ja.
<< kg:id_98 prop:contermeasure kg:id_100 >>
    prop:text-txt_contents "学校の休業の影響を受けた世帯等には20万円以内の貸付けをするという制度"@ja.
<< kg:id_98 prop:contermeasure kg:id_101 >>
    prop:text-txt_contents "償還時になお所得の減少が続く住民税非課税世帯の皆さんに対しては、償還免除をすることができる"@ja.
<< kg:id_102 prop:contermeasure kg:id_103 >>
    prop:text-txt_contents "今までも酒田の海水浴場として内陸などに向けても、チラシ、ポスター、ホームページなどで情報発信を行ってまいりました"@ja.
<< kg:id_102 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "観光バリアフリーの取組としまして、「バリアフリービーチ体験Ｄａｙｓ」ということを試行していきたい"@ja.
<< kg:id_102 prop:contermeasure kg:id_105 >>
    prop:text-txt_contents "宮海のバリアフリービーチやイベント、飛島の海の魅力をしっかりと情報発信をして"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:text-txt_contents "地元の自治会を中心とした実行委員会などにお願いをして運営をしていただいてございます"@ja.
<< kg:id_108 prop:contermeasure kg:id_109 >>
    prop:text-txt_contents "ライフセーバーや看護師の配置に係る経費につきましては、海水浴場安全対策補助金として交付をさせていただいて"@ja.
<< kg:id_106 prop:contermeasure kg:id_110 >>
    prop:text-txt_contents "運営実績のある実行委員会に引き続き管理運営をお願いしていきたい"@ja.
<< kg:id_111 prop:contermeasure kg:id_112 >>
    prop:text-txt_contents "波打ち際まで車椅子の方とか、ベビーカーを利用される方、こういった方々がスムーズに行けるようにアクセスマットという砂場でも通りやすいようにというようなものを整備する予定"@ja.
<< kg:id_111 prop:contermeasure kg:id_113 >>
    prop:text-txt_contents "身体障がい者の皆さんが使うための今のところはトイレ"@ja.
<< kg:id_111 prop:contermeasure kg:id_114 >>
    prop:text-txt_contents "水陸両用の車椅子、こういったものを準備する予定"@ja.
<< kg:id_111 prop:contermeasure kg:id_115 >>
    prop:text-txt_contents "これがガバメントクラウドファンディングを用いまして準備ができないかというようなことで"@ja.
<< kg:id_116 prop:contermeasure kg:id_117 >>
    prop:text-txt_contents "来年度から新たに検討している広告掲載事業といたしましては、るんるんバスのバス停への広告掲載の実施に向けまして"@ja.
<< kg:id_116 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "公共施設の空きスペースの活用につきましては、先進事例を踏まえまして検討していきたい"@ja.
<< kg:id_116 prop:contermeasure kg:id_119 >>
    prop:text-txt_contents "広告事業により得られた収入を財源として市民サービスの向上が図られることや、広告掲載を通して企業の知名度やイメージアップにつながることを周知していくことも必要"@ja.
<< kg:id_120 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "受付する窓口というんでしょうか、そういったものは若干検討できるのかなと思っております"@ja.
<< kg:id_122 prop:contermeasure kg:id_123 >>
    prop:text-txt_contents "山形県と連携して、本市のＰＲや相談対応を行ってまいりたい"@ja.
<< kg:id_122 prop:contermeasure kg:id_124 >>
    prop:text-txt_contents "首都圏在住者向けに本市の観光情報等の発信や移住相談の拠点として"@ja.
<< kg:id_122 prop:contermeasure kg:id_125 >>
    prop:text-txt_contents "平成29年９月から運用を開始しております移住お試し住宅"@ja.
<< kg:id_122 prop:contermeasure kg:id_126 >>
    prop:text-txt_contents "小学生以下のお子さんがおられる子育て世帯が移住お試し住宅を利用する際の交通費の補助であります、移住お試し住宅利用促進補助金"@ja.
<< kg:id_122 prop:contermeasure kg:id_127 >>
    prop:text-txt_contents "移住定住担当課、それから空き家担当課及び空き家等ネットワーク協議会がより連携を深めながら、移住定住希望者に丁寧に対応できるようなそういった体制をつくってまいりたい"@ja.
<< kg:id_122 prop:contermeasure kg:id_128 >>
    prop:text-txt_contents "移住者などを対象とした住まいと交流の拠点づくりを公民連携で進めていく"@ja.
<< kg:id_129 prop:contermeasure kg:id_130 >>
    prop:text-txt_contents "軽度生活援助事業はおおむね65歳以上の在宅で生活する独り暮らし高齢者等を対象に、自立した生活の継続と要介護状態への進行を防止することを目的として実施"@ja.
<< kg:id_129 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "よろずや琢成という地域支え合い活動を県内でも先駆けて導入しており、買物代行、薬の受け取り代行、草むしり、ごみ出し支援など計20のサービスメニューを提供しており、自分たちの地域住民は自分たちで守る活動を続け"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:text-txt_contents "酒田市結婚サポートセンターを中心として様々な取組を行っております"@ja.
<< kg:id_132 prop:contermeasure kg:id_134 >>
    prop:text-txt_contents "結婚サポーターによるお見合い形式での出会いの場を提供しております"@ja.
<< kg:id_132 prop:contermeasure kg:id_135 >>
    prop:text-txt_contents "婚活イベントを年４回程度行っており、気軽に参加できる出会いの場を提供しております"@ja.
<< kg:id_132 prop:contermeasure kg:id_136 >>
    prop:text-txt_contents "社員の結婚を支援したい協力企業に向けた異業種交流会等を開催し、出会いの場の創出に努めております"@ja.
<< kg:id_132 prop:contermeasure kg:id_137 >>
    prop:text-txt_contents "昨年度から新たなサポーターの募集に努め、その結果、今年度に入り、登録者と年代の近い30代のサポーターの登録が相次ぎました"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:text-txt_contents "男女共同参画センターウィズにおいて、男性向けの家事分担を促すような講座を開催したり"@ja.
<< kg:id_138 prop:contermeasure kg:id_140 >>
    prop:text-txt_contents "昨年度から始めました出前講座では、主に地域の高齢者に対して、性別による役割分担意識への気づきを促しており"@ja.
<< kg:id_132 prop:contermeasure kg:id_141 >>
    prop:text-txt_contents "日本一女性が働きやすいまちを実現することによる人口減少の抑制を重点施策の一つとしており"@ja.
<< kg:id_142 prop:contermeasure kg:id_143 >>
    prop:text-txt_contents "ビジネスマナーや再就職準備など求職者向けのセミナー"@ja.
<< kg:id_142 prop:contermeasure kg:id_144 >>
    prop:text-txt_contents "事業者向けの労働生産性向上セミナーなど１年を通じて実施"@ja.
<< kg:id_142 prop:contermeasure kg:id_145 >>
    prop:text-txt_contents "やまがた子育て・介護応援いきいき企業制度を広く周知し、認定取得への支援をしております"@ja.
<< kg:id_146 prop:contermeasure kg:id_147 >>
    prop:text-txt_contents "地域の皆様から協力をいただきながら、多様な体験活動や職業観を学ぶことを通して、地元の良さを再認識し、これからの生き方を学んでいくキャリア教育推進事業"@ja.
<< kg:id_146 prop:contermeasure kg:id_148 >>
    prop:text-txt_contents "社会科や総合的な学習の時間に自分の生まれ育った地域を愛する心を育むこと、すなわち郷土愛の醸成を図ることを目的として、ふるさと教育にも取り組んでおります"@ja.
<< kg:id_149 prop:contermeasure kg:id_150 >>
    prop:text-txt_contents "重点事業といたしまして、子供の命を守る安全教育推進事業というのを進めておりまして"@ja.
<< kg:id_149 prop:contermeasure kg:id_151 >>
    prop:text-txt_contents "現在は津波、風水害等も含めた多様な災害に備える訓練も行われるようになってきております"@ja.
<< kg:id_149 prop:contermeasure kg:id_152 >>
    prop:text-txt_contents "学校に防災教育アドバイザーという専門家を派遣しまして、防災教育を充実させてきております"@ja.
<< kg:id_149 prop:contermeasure kg:id_153 >>
    prop:text-txt_contents "防災マニュアルについてですけれども、それぞれの地域に合った形になるようにその都度見直しを図っている"@ja.
<< kg:id_149 prop:contermeasure kg:id_154 >>
    prop:text-txt_contents "そのときに使用する社会科の副読本「わたしたちのまち　さかた」の改訂をしておりまして、家庭や学校、地域での災害の備えについて学習できるようになっている"@ja.
<< kg:id_149 prop:contermeasure kg:id_155 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "地域で子供も大人も一緒にやる避難訓練というのは、もうそういう段階に今いくべきだと思います"@ja.
<< kg:id_149 prop:contermeasure kg:id_156 >>
    prop:text-txt_contents "学校に防災教育担当者という分掌を位置づけることはできないかというようなことも併せて検討してまいりたい"@ja.
<< kg:id_157 prop:contermeasure kg:id_158 >>
    prop:text-txt_contents "令和２年度中の更新作業ということで、５年から10年先を見据えて、今、改定作業に当たっております"@ja.
<< kg:id_157 prop:contermeasure kg:id_159 >>
    prop:text-txt_contents "農家お一人お一人にアンケートを実施しております"@ja.
<< kg:id_157 prop:contermeasure kg:id_160 >>
    prop:text-txt_contents "農家の方はもちろんですけれども、農業委員会、それから土地改良区、農協、こういった方々の皆さんのお知恵を拝借しながら、国では徹底的に話し合え"@ja.
<< kg:id_161 prop:contermeasure kg:id_162 >>
    prop:text-txt_contents "中小家族経営など多様な経営体による地域の下支えという項目が立って明記されております"@ja.
<< kg:id_163 prop:contermeasure kg:id_164 >>
    prop:text-txt_contents "１筆を単位とした別段の面積の設定基準を定めております"@ja.
<< kg:id_163 prop:contermeasure kg:id_165 >>
    prop:text-txt_contents "まちづくり推進課、宅建業者等と農業委員会とが連携して取り組める体制はできている"@ja.
<< kg:id_166 prop:contermeasure kg:id_167 >>
    prop:text-txt_contents "１本目は農業を持続可能な産業にしよう"@ja.
<< kg:id_166 prop:contermeasure kg:id_168 >>
    prop:text-txt_contents "２本目が次世代への円滑な継承、そして、担い手の確保・育成"@ja.
<< kg:id_166 prop:contermeasure kg:id_169 >>
    prop:text-txt_contents "３本目が商いのまち酒田らしく、農家にしっかり稼いでいただく"@ja.
<< kg:id_166 prop:contermeasure kg:id_170 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "中国とか、他の国に輸出すること"@ja.
<< kg:id_166 prop:contermeasure kg:id_171 >>
    prop:text-txt_contents "昨今の異常気象でありますと、そういったものにも耐え得る農作物を作っていく"@ja.
<< kg:id_166 prop:contermeasure kg:id_172 >>
    prop:text-txt_contents "酒田農業の基本の土づくり、人づくり、稲づくり、これをしっかりやって"@ja.
<< kg:id_166 prop:contermeasure kg:id_173 >>
    prop:text-txt_contents "省力化をしていくと。楽をすることが悪いことではございませんので、機械化をしていったり"@ja.
<< kg:id_166 prop:contermeasure kg:id_174 >>
    prop:text-txt_contents "市ではモデル地区で取り組んだり、お試しや実証ということをしながら、農家の皆様方のリスク軽減を図りながら"@ja.
<< kg:id_175 prop:contermeasure kg:id_176 >>
    prop:text-txt_contents "強制徴収公債権の高額滞納事案を中心に納税課の滞納整理室において対応し"@ja.
<< kg:id_175 prop:contermeasure kg:id_177 >>
    prop:text-txt_contents "酒田市の滞納整理審査会というのを開催いたしておりまして"@ja.
<< kg:id_175 prop:contermeasure kg:id_178 >>
    prop:text-txt_contents "分かりやすい債権管理マニュアルの整備"@ja.
<< kg:id_175 prop:contermeasure kg:id_179 >>
    prop:text-txt_contents "専任講師による債権管理研修会"@ja.
<< kg:id_175 prop:contermeasure kg:id_180 >>
    prop:text-txt_contents "事案検討によるアドバイス"@ja.
<< kg:id_175 prop:contermeasure kg:id_181 >>
    prop:text-txt_contents "何より実務に当たる徴収担当職員のスキル向上に力点を置く"@ja.
}
