kg:st_1 rdfs:label "五十嵐英治議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "市関係者の物心両面の支えが公演実現の支えになったと評価する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "公演直前の大きなトラブルだったと受け止める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "市の支援が座員や関係者の大きな心の支えになったと述べる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "村上幸太郎教育長"@ja.
kg:st_2 rdf:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_4 prop:content "国内外に酒田をＰＲできたと評価する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "両公演とも高い評価を得たと感じている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "継承の決意が公演の大きな成果だと捉える"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "相互理解が交流事業の成果だったと評価する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "各種助成金の獲得につながったと説明する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "今後も交流の要望があれば市として対応したい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "現状の協力体制をさらに進化させる必要があると認識する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "法改正で導入検討を進める必要が高まったと説明する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "導入にはまず計画への位置づけが必要と説明する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "導入前に関係者への説明や体制整備が必要と述べる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "小中一貫教育との相乗効果を見極めながら導入を進めたい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "学校課題の打開のためコミュニティ・スクール導入が必要と述べる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "家庭の課題も社会総がかりの教育を必要とする要因だと述べる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "地域課題の解決のためにもコミュニティ・スクールが必要と述べる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:st_3 rdfs:label "佐藤喜紀議員"@ja.
kg:st_3 rdf:type cls:st_16.
kg:op_18 prop:content "人口減少で観光需要が減る中で情報発信強化が必要とみる"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "地域間競争が激しい中で酒田の魅力発信が重要と述べる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:st_4 rdfs:label "佐々木好信交流推進調整監"@ja.
kg:st_4 rdf:type cls:st_38.
cls:st_38 rdfs:label "職員"@ja.
kg:op_20 prop:content "観光情報発信の中心として活用している"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "インバウンド対応として多言語情報発信を進めている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "観光施設案内のため多言語対応のサイン整備を進めている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "外国人観光客増加に対応して多言語化を進めている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "市全体で一体的な情報発信が課題だと認識する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "担い手確保と育成が喫緊の課題だと指摘する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "水産業でも後継者不足が深刻な問題だと指摘する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:st_5 rdfs:label "竹越攻征農林水産部長"@ja.
kg:st_5 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_27 prop:content "個々のイベントは質が高いが面的広がりが不足していると認識する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "冬のうちに行事全体を分析して来年度戦略につなげたい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "産地間競争に勝つためプロの技術導入も必要と考える"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "情報発信ツールの利用が一部市民に偏っていると感じる"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:st_6 rdfs:label "梅木和広危機管理監"@ja.
kg:st_6 rdf:type cls:st_39.
cls:st_39 rdfs:label "管理職"@ja.
kg:op_31 prop:content "多様な年代に届くよう多様な方法で情報発信している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_6.
kg:st_7 rdfs:label "丸山至市長"@ja.
kg:st_7 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_32 prop:content "交流の場は酒田ファンを増やす最大のチャンスと捉える"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_7.
kg:op_33 prop:content "知名度向上と酒田ファンづくりを経済発展につなげたい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_7.
kg:op_34 prop:content "市情報を一括掲載するアプリ導入は現時点で考えていないが勉強したい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_7.
kg:st_8 rdfs:label "菊池裕基健康福祉部長"@ja.
kg:st_8 rdf:type cls:st_18.
kg:op_35 prop:content "今後さらに制度活用者が増える可能性が高いと認識する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_8.
kg:op_36 prop:content "認知度の低さから市民後見人が選任された事例はないと説明する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_8.
kg:op_37 prop:content "市民への周知を継続して図っている"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_8.
kg:op_38 prop:content "情報交換会を発展させ地域連携ネットワークにつなげたい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:op_39 prop:content "令和３年度末までの設置目標を踏まえ協議を始めた"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_8.
kg:op_40 prop:content "トラブル相談には家庭裁判所につなぐ対応をとる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_8.
kg:op_41 prop:content "流域型洪水の怖さを改めて認識した"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:op_42 prop:content "超大型台風時は最上川でも大規模災害の危険があると認識する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_6.
kg:op_43 prop:content "数時間先の危険を予測し早めの防災対応をとる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_6.
kg:op_44 prop:content "関係機関と策定したタイムラインで対応する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "住民主体の防災対策への転換が必要と認識する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "住民主体の活動を支援して防災力を高めたい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:op_47 prop:content "緊急避難場所の指定拡大を今後も進める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "資機材整備は企業支援も活用して進めたい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_6.
kg:op_49 prop:content "避難所での生活環境向上につなげたい"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:st_9 rdfs:label "武田恵子議員"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_50 prop:content "市民は移住施策より先に安全安心の確保を求めている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_9.
kg:op_51 prop:content "周辺住民は日常的に不安を抱いていると指摘する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_9.
kg:op_52 prop:content "ホームページのわかりにくさを改善したい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_7.
kg:op_53 prop:content "改めて広報紙でも相談窓口の周知に努めたい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "ネットワーク協議会は継続的に実績を上げている"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "会員の協力で利活用が進んでいると評価する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "解体等の適正管理にも協力を得ている"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_7.
kg:op_57 prop:content "本市の空き家の現状や対策を市民に知らせるため計画を策定したい"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_7.
kg:op_58 prop:content "既存組織を活用して法定協議会機能を持たせたい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_7.
kg:op_59 prop:content "発生そのものより広がりを防ぐことが課題だと述べる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_9.
kg:op_60 prop:content "感染症情報は県の公表要領に基づき公表される"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_8.
kg:op_61 prop:content "庁内共有と施設への周知を行った"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_8.
kg:op_62 prop:content "関係施設には情報提供と注意喚起を行った"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_8.
kg:op_63 prop:content "今後の検討課題だと認識する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_8.
kg:op_64 prop:content "市民への注意喚起と予防情報の周知を図っている"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_8.
kg:st_10 rdfs:label "阿部勉企画部長"@ja.
kg:st_10 rdf:type cls:st_18.
kg:op_65 prop:content "安全安心で持続可能なエネルギーミックスを推進したい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_10.
kg:op_66 prop:content "企業の理解を深め水素活用を支援したい"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_10.
kg:op_67 prop:content "技術開発研究や実証実験の促進を継続要望する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_10.
kg:op_68 prop:content "現時点では研究機関誘致は難しいとみている"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_10.
kg:op_69 prop:content "連合を通じて実証実験等の進展を注視したい"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_10.
kg:op_70 prop:content "庄内沿岸域は洋上風力の適地と認識する"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_10.
kg:op_71 prop:content "洋上風力発電事業は企業集積と雇用創出につながるとみる"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_10.
kg:op_72 prop:content "酒田沖の促進区域指定へ向け県と連携を図りたい"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_10.
kg:op_73 prop:content "港湾や送電網や道路など関連インフラ整備を要望したい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_10.
kg:st_11 rdfs:label "矢口明子副市長"@ja.
kg:st_11 rdf:type cls:st_40.
cls:st_40 rdfs:label "副市長"@ja.
kg:op_74 prop:content "常時混雑しており対応が必要な課題と認識する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_11.
kg:op_75 prop:content "来年度以降は大学線７便でタクシー代行を検討する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_11.
kg:op_76 prop:content "住宅街の中まで入れない事情があると説明する"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_11.
kg:op_77 prop:content "2022年3月をめどに再編検討の中で取り組みたい"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_11.
kg:op_78 prop:content "駅東公園前北進側のバス停を移設する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_11.
kg:op_79 prop:content "自治会長や近隣住民と調整済みで速やかに移設する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_11.
kg:op_80 prop:content "今まで以上に広告募集を工夫していきたい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_11.
kg:op_81 prop:content "被害額は前年より大きく増え手口も巧妙化していると認識する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_11.
kg:op_82 prop:content "前年より被害額が増えた要因と説明する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_11.
kg:op_83 prop:content "民生委員や地域包括センターにも協力をお願いしたい"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_11.
kg:op_84 prop:content "複層的な啓発強化に取り組みたい"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_11.
kg:op_85 prop:content "車内広告は早期実現に向け公共交通担当と連携したい"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_11.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "公演が近づいた９月下旬に、それまでポーランド公演実現に向けさまざまな推進活動の中心となって行動してきた冨樫久一座長が脳疾患で倒れ、厳しい病状のため、座員や関係者の間には大きな不安が広がりました"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "冨樫久一座長が脳疾患で倒れ、厳しい病状のため、座員や関係者の間には大きな不安が広がりました"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "派遣団に加わりました丸山市長初め市関係者の方々より、物心両面にわたるお力添えや御指をいただきましたことが座員や関係者にとっては非常に大きな心の支えとなり、今回のポーランド公演を無事に実現することができた"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "マスコミ報道でも大きく取り上げられ、酒田黒森歌舞伎ポーランド公演が一躍大きな話題となったことは、まさに酒田市を内外に情報発信することができた大きな成果であります"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "公演終了後には観客からのスタンディングオベーションが鳴りやまなかったと伺っております。両公演とも、観客数やレセプションでの観客の皆さんからの感想をいただきましたけれども、高い評価をいただいたのではないかと感じているところでございます"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "黒森歌舞伎妻堂連中の皆さんが、今回のポーランド公演を通して、これまで受け継がれてきた黒森歌舞伎をこれからもしっかり継承していこうという決意を新たにされたということが、今回の公演の大きな成果ではないかと考えているところでございます"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "今回のさまざまなワークショップを通しまして、日本・ポーランド両国の参加者がそれぞれ相手国の文化に興味を示していただいたことは、今回の交流事業の成果だったと考えているところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "国や県に積極的に支援を要請した結果、例えば国際交流基金、日本万国博覧会記念基金、三井住友海上文化財団あるいは丸高歴史文化財団より助成金をいただいていると伺っております"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "そういったような交流に対する要望が出てきた場合には、市としても相談に乗ってまいりたいなと考えているところでございます"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "より一層それを進化させるという意味では、学校運営協議会の持つ権限と言いましょうか、非常に大きなものがございまして"@ja.
<< kg:id_12 prop:cause kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "平成29年３月の法律改正で、コミュニティ・スクールの設置については教育委員会の努力義務に課せられているという状況でございます"@ja.
<< kg:id_12 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "コミュニティ・スクールをスタートさせるためには、教育振興基本計画にきちんと計画を位置づける必要がございます"@ja.
<< kg:id_12 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "具体的には組織づくりや委員の任命、報酬の準備、市長部局との連携、学校の管理職や教職員、学校協議会委員への周知と研修、さらには保護者の方、地域住民の方、関係団体に向けてどのような制度なのかということをしっかりと説明する必要がある"@ja.
<< kg:id_12 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "コミュニティ・スクールの導入についても小中一貫を進めながら、前向きに検討していきたいと考えているところでございます"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "学校ではいじめ、不登校問題、教員の多忙化等がある"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "家庭ではどうか。無関心、過干渉、核家族化があった"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地域ではどうか。規範意識の低下、性犯罪の多発など、問題山積の状況を打開するためにどうしようかと考えたとき、それは社会総がかりで教育を実現すると"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "人口減少に伴う国内旅行者の減少や限られた旅行需要で地域間競争が激化しております"@ja.
<< kg:id_24 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "限られた旅行需要で地域間競争が激化しております"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "本市の観光情報サイトであります「酒田さんぽ」につきましては、月平均４万4,000件のアクセスがあるという状況でございます。酒田の観光における情報発信の中心となっています"@ja.
<< kg:id_27 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "英語版の観光情報サイト「Ｓａｋａｔａ　Ｔｏｕｒｉｓｍ」というのをつくっております"@ja.
<< kg:id_27 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "ことしの３月、23基の観光施設を紹介する「まちなかサイン」を設置しております"@ja.
<< kg:id_27 prop:effect kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "外航クルーズ船の寄港、それからチャーター便の増加、こういったことで外国人の観光客の増加に伴いまして、市のホームページ、パンフレットなどにつきましても段階的に多言語化をしている状況でございます"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "その方々への情報発信を市全体で一体的に取り組むというようなことが確立できていないというようなことが課題として上げることができるかと思っております"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "農業就業人口は減少傾向にあり、就業者の高齢化率も50％を超えるなど、担い手となる新規就農者等の確保、育成を図るとともに、持続可能な農業経営体の育成が喫緊の課題となっております"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "漁業後継者不足が深刻な問題となっており、漁獲量においても減少傾向にあります"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "一つ一つがいいというので、点と点で、線で結ばっていないと言ったらいいんでしょうか、面的広がりがもう少しあるとより効果的な発信になるのではないかなと考えております"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "しっかりとみんなでカレンダーをいま一度ばーっと並べて、どこにどういう行事があって、もしくは先ほど前に答弁ありました佐々木調整監の交流推進課とはうちは大分親和性高いですから、こういったところの行事がどうなっていってというのをちょっと分析して、戦略を練りながらしっかり取り組んでみたい"@ja.
<< kg:id_40 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "プロの技術というのを少し予算をつけながら得てみるのもいいのではないかなと考えております"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "年齢や職業、行政への関心度の違いにより、利用頻度については偏りが大きく、一部の市民の利活用にとどまっているように感じられます"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本市ではさまざまな年代の方に情報が届くよう、広報紙、市ホームページ、ＳＮＳ、コミュニティＦＭ、メールマガジン、各報道機関へのプレスリリースや記者会見など、できる限り多様な方法での情報発信を行っております"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "人々が直接触れ合い、そして往来ができるさまざまな交流機会、こういったものは、酒田を紹介して、酒田ファンになってもらって、酒田を訪れてみたいと思ってもらえる最大のチャンスと捉えております"@ja.
<< kg:id_47 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "こういった活動については、シティプロモーションという言葉が今はやりのようにございますけれども、酒田市といたしましてもこのシティプロモーションの一環として意図的に内外に発信していくことによりまして、本市の知名度の向上、そして酒田ファンづくり、そしてひいては本市の経済発展、本市の振興に結びつけていきたい"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "改めて市の情報を一括して掲載するような自治体アプリの導入、これにつきましては現時点では考えていませんけれども、今後環境の変化等も踏まえながら、少し勉強してまいりたいなと思っております"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "高齢者や認知症の方が増加している状況から、今後一層成年後見制度を活用する方がふえる可能性は高いものと認識をしております"@ja.
<< kg:id_54 prop:cause kg:id_55 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "成年後見人に対する市民認知度が低い状況にあることから、市民後見人が選任された事例はない状況でございます"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "現在市ホームページ、それから福祉課窓口でのリーフレットの配布、また個別の相談による後見人制度の周知を図っておりまして、ほかにも出前講座で自治会やコミュニティ振興会などに出向いて制度の説明を行っているところでございます"@ja.
<< kg:id_56 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "ことしの９月25日に本市における成年後見制度の利用の現状と課題、それから中核機関となる成年後見支援センターの設置、また地域連携ネットワークの構築に向けた協議を行う情報交換会を実施しております。今後はこの情報交換会を発展させ、地域連携ネットワークの構築に結びつけていきたい"@ja.
<< kg:id_56 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "今年度、国ではこの成年後見制度利用促進基本計画期間の最終年度となります令和３年度末までに成年後見支援センターを全市町村に設置するという目標を掲げております。本市ではその実現に向けて、法人後見事業の実施団体である酒田市社会福祉協議会と協議を始めたところでございます"@ja.
<< kg:id_56 prop:effect kg:id_60 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "被後見人が受診等しております医療機関を介しまして、申立人が後見人を変更してほしいと訴えているとの相談を受けた事例はございます"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "河川の流域に降った雨が集まり、下流で大水害を起こす流域型洪水は、今回の台風19号で改めてクローズアップされました"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "広範囲で雨が降ることによって、支流での氾濫とともに最上川の洪水が発生し、大規模な災害に至る危険性があり"@ja.
<< kg:id_65 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "最上川上流部の降雨量や今後の雨雲の動き、各水位観測所での水位変化などの情報を国土交通省酒田河川国道事務所や山形地方気象台から収集し、最大６時間先の水位予測について情報を共有して、市民の避難誘導準備に備えたところであります"@ja.
<< kg:id_65 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "今年度は関係機関とともに洪水タイムラインを策定しており、災害対応に当たっては当該タイムラインに沿った防災行動をとることとしています"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "地球温暖化の影響や行政の人員に限りがあること等から、突発的に発生する激甚な災害への行政主導のハード対策・ソフト対策に限界が生じており、住民主体の防災対策に転換していく"@ja.
<< kg:id_68 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "自主防災組織による地区防災計画の策定や避難地図の作成など、住民が主体的に行う活動をしっかりと支援していくことにより、防災力を高めていきたい"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "津波浸水区域以外でも、洪水の避難対応を含め、緊急避難場所としての指定については今後も拡大してまいります"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "生活に必要な資機材等の整備については、市が直接導入するには保管場所や費用面などの課題もあるために、応援協定などによって企業から支援していただく部分も検討していきたい"@ja.
<< kg:id_73 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "直近では、避難所での使用を前提に、山形三菱と電気自動車からの電気の供給に関して協定を締結いたしました"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "暴風や積雪時に不安を感じた市民は、改善と不安解消を求めているのです"@ja.
<< kg:id_76 prop:effect kg:id_78 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "不審者が入ってくるのではないか、小動物のすみかになってしまうのではないか、事件や事故など起きなければいいが、という不安を抱いている市民がその空き家周辺に住んでいるのです"@ja.
<< kg:id_79 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "市のホームページのトップページにあります「住宅・都市環境」というボタンみたいなものがあります。このカテゴリーの中に「空き家」としっかり明記をして、空き家という文字を併記し、一目でわかるようにすることで、ワンクリックで空き家のページにたどり着くような改善を、早急にしたい"@ja.
<< kg:id_79 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "改めて広報にも特集として掲載をし、空き家の現状、相談窓口の周知等にしっかりと、広報紙の面でも努めてまいりたい"@ja.
<< kg:id_79 prop:effect kg:id_82 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "ネットワーク協議会設立の平成25年度から今年度までに延べ338組の相談が寄せられているところでございます"@ja.
<< kg:id_79 prop:effect kg:id_83 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "不動産業者による空き家の売買等の契約件数でございますが、これは、平成30年度が13件、平成25年度からこれまでの通算では89件に及んでおります"@ja.
<< kg:id_79 prop:effect kg:id_84 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "建設業協会による空き家の解体の契約件数、これは平成30年度が７件、平成25年度からの通算では48件となっております"@ja.
<< kg:id_79 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "本市の空き家の現状、対策、体制について、まとまった形で市民にお知らせすることも必要だと考えますので、この空家等対策計画につきましては、今後速やかに酒田市としても策定してまいりたい"@ja.
<< kg:id_79 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "関係機関、関係者によります空き家等ネットワーク協議会がございますので、速やかに計画策定をしていくことを考えますと、この組織を母体に法定協議会としても機能するように何とか活用をしていきたい"@ja.
<< kg:id_87 prop:cause kg:id_88 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "発生が問題なのではなく、広がるのを防ぐことが課題だと思います"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "届け出を受けた保健所は、感染症法に基づき調査を行い、感染症の発生が確認された場合は、山形県感染症に関する公表要領、これに基づきまして公表をしております"@ja.
<< kg:id_89 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "庄内保健所から情報提供の後、健康課からは速やかに全庁に情報提供をするとともに、施設の所管課等に対しては、所管施設等への注意喚起や感染予防に関する周知の依頼をお願いしております"@ja.
<< kg:id_89 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "子育て支援課では、保育園、認定こども園、それから児童センター、子育て支援センターやファミリーサポートセンター、それから学童保育所、また、介護保険課のほうでも、市内の入所施設や通所施設等に情報提供と注意喚起をしております"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "庁内各課から全ての施設まで注意喚起が行き届かない面があったことから、このことにつきましては、今後の検討課題とさせていただきたい"@ja.
<< kg:id_89 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "今回のホームページによる市民への注意喚起や庁内各課等への情報提供に当たっては、赤痢の発生状況に加え、感染を拡大させないための消毒方法や予防などの情報についての周知も図っているところでございます"@ja.
<< kg:id_96 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "本市においては、豊富な自然エネルギーや再生可能エネルギーがあることから、これらを活用し、安全安心で維持可能なエネルギーミックスを推進してまいります"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "水素エネルギーに関するセミナーの開催や先進地の視察などを通じまして、水素を活用する社会環境の整備及びサプライチェーンの構築につながる取り組みを支援していきたい"@ja.
<< kg:id_98 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "水素技術の開発研究及び先進的モデルの確立に向けた実証実験の促進について、国や県に対しまして要望を継続してまいります"@ja.
<< kg:id_101 prop:effect kg:id_102 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "実用化の見通しはいまだ立っておらず、地方への研究機関の誘致は難しいと考えているところでございます"@ja.
<< kg:id_101 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "本市としましては、実証実験等進展を注視するなど、今後も連合の取り組みを通じ、情報収集に努めてまいります"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "ＮＥＤＯの風況調査では、庄内沿岸海域の風速が年平均で７ｍ以上となっており、洋上風力発電の事業化の目安とされる風速を超えていることから、庄内の沿岸域は、洋上風力の適地とされております"@ja.
<< kg:id_104 prop:effect kg:id_106 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "洋上風力発電事業が進むことで、関連します企業集積も図られ、新たな雇用も生まれることが期待されます"@ja.
<< kg:id_104 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "酒田沖の一般海域における洋上風力発電の促進区域指定に向けましては、直接的な影響を受けます漁業者の理解を何よりも重要と位置づけまして、県とより一層の連携を図ってまいりたい"@ja.
<< kg:id_104 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "新たに港湾の整備が進むですとか、かなりの電気を送電するための送電網が整備をされるですとか、また、重機を運ぶための道路なども必要と思ってございますので、洋上風力発電事業にあわせまして、関連するインフラの整備についてもしっかりと国・県に対して要望をしてまいりたい"@ja.
<< kg:id_109 prop:effect kg:id_110 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "酒田駅大学線のかんぽの宿発７便、夕方の５時５分発ですけれども、この便が工業団地や大学からの帰宅者で常時混雑しておりまして、今年度は、大学前で３回満車で乗れなくなった人がいることを確認しております"@ja.
<< kg:id_109 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "来年度以降は、この酒田駅大学線の７便について、タクシーによる代行輸送を検討しております"@ja.
<< kg:id_112 prop:cause kg:id_113 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "るんるんバスの経路は、民間路線バスとの競合をなるべく避けるように、また、デマンドタクシーの利用可能なエリアともすみ分けを行っております。道路幅員や交通事情を勘案し、住宅街の中までなかなか入れないという事情もございます。加えて、運転手の労務・安全管理の観点から、１路線おおむね１時間"@ja.
<< kg:id_114 prop:countermeasure kg:id_115 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "2022年３月をめどに進めておりますバス路線再編の検討の中で、路線の新設や経路の変更、またバス停の配置も含めて取り組んでいきたい"@ja.
<< kg:id_116 prop:effect kg:id_117 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "本市の乗合バスのバス停においては、この条件に該当するバス停が１カ所ございました。駅東公園の前の北進側でございます"@ja.
<< kg:id_116 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "このバス停の移設について、自治会長、近隣住民とは調整済みでありまして、適切に周知期間を設けた上で速やかに移設をいたします"@ja.
<< kg:id_119 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "来年以降は、るんるんバスへの車体広告の予約を３件いただいております。また、今年度からは、広告で得られた収入を原資としたバスの時刻表も作成させていただきまして、バス路線を維持するための経費削減にも取り組んでおります。さらに、バス停への広告の募集も検討しております"@ja.
<< kg:id_121 prop:effect kg:id_122 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "令和元年11月末現在の酒田警察署管内における特殊詐欺被害認知件数は３件、被害額は約2,500万円となっております"@ja.
<< kg:id_121 prop:cause kg:id_123 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "昨年に比べ被害額がふえたのは、架空請求詐欺による高額被害が発生したためです"@ja.
<< kg:id_124 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "この固定電話の常時留守番電話設定による被害防止の呼びかけを、警察官の巡回だけではなく、高齢者、障がい者の状況を把握している民生委員の皆様からも訪問の折に注意喚起していただきますよう、改めてお願いをしてまいります"@ja.
<< kg:id_124 prop:countermeasure kg:id_126 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "あわせて、地域包括センターなどにも同様の協力をお願いするなど、複層的な啓発強化に取り組んでいきたい"@ja.
<< kg:id_124 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "車内広告につきましては、早期の実現に向けて、市の公共交通担当部門と連携していきたいと思っております"@ja.
}
