kg:st_1 rdfs:label "佐藤伸二議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "旧中心部のにぎわい回復が必要と考える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "旧中心部のにぎわい回復が必要と考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "旧中心部のにぎわい回復が必要と考える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "生活に支障が起きていると感じている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "地域維持の上で将来不安につながると懸念する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "一段と人口減少が加速していくことを心配する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "空き家活用は地域活力回復に必要と考える"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "防犯面からも空き家対策が必要と考える"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "野生動物の繁殖問題にもつながると懸念する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "旧中心部の空き家活用が必要と考える"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "所有者の理解を前提に再利用が必要と考える"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "若い世代の活躍機会の造成が活性化の原動力になると考える"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "県内大学との連携による新産業づくりが必要と考える"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "多様な観光ニーズに対応するため泊食分離型施設が必要と考える"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "食と酒の満足がリピーター獲得と新規誘客につながると考える"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_2 rdfs:label "阿部勉企画部長"@ja.
kg:st_2 rdfs:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_16 prop:content "旧3町の中心部は活力が失われつつあると捉えている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "空き店舗は減少したが目標達成には至っていない"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "マッチング支援で空き店舗の減少を図る"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:st_3 rdfs:label "桐澤聡市民部長"@ja.
kg:st_3 rdfs:type cls:st_18.
kg:op_19 prop:content "さまざまな原因により地域のにぎわいが低下している"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "地域のにぎわいが低下してきている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "市内全域でにぎわいづくりの一助となるよう努めている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "構造上の事情から再利用に結びついていない"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "賃貸されないケースが多く再利用に結びついていない"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "創業希望者への再利用支援とアフターケアを継続する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "管理不全な空き家は生活環境に悪影響を及ぼす"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "所有者への助言指導で改善につなげている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "関係団体と連携し空き家の活用に努めている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "年2回から年3回に増やし相談しやすい環境を整える"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "解体や利活用に効果のある施策を検討したい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:st_4 rdfs:label "佐々木好信交流推進調整監"@ja.
kg:st_4 rdfs:type cls:st_41.
cls:st_41 rdfs:label "調整監"@ja.
kg:op_30 prop:content "旅館を中心に廃業が多く宿泊可能室数が減少している"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "宿泊してもらうことで経済効果が大きい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "泊食分離は本市で推進している形態である"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "宿泊を増やすため宿泊機能の充実が必要と考える"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "民宿や民泊などを土台に宿泊機能を広げたい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "認知度が上がり集客力のあるイベントになってきている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "食のコンテンツを広く紹介し知名度を上げたい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "人口減少と高齢化で経済や流通が弱くなると懸念する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "酒田町家を観光宿泊施設として活用する可能性をつないでいる"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "食を持たないことで雇用や手間の負担が軽くなる"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "外に出て食事をすることで町なかのにぎわいにつながる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "泊食分離は酒田に合っていると考え進めたい"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:st_5 rdfs:label "丸山至市長"@ja.
kg:st_5 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_42 prop:content "市を挙げて酒田を売り込む活動に取り組みたい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:st_6 rdfs:label "竹越攻征農林水産部長"@ja.
kg:st_6 rdfs:type cls:st_18.
kg:op_43 prop:content "農業の発展にはスマート農業が重要と考える"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_6.
kg:op_44 prop:content "労働力不足への対応が必要と考える"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "生産技術伝承への不安がある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "地力への不安があり収量にも影響が出るとみている"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:op_47 prop:content "技術で土壌改良の負担を補いたい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "若手農業者と一緒に実践研修を進めている"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_6.
kg:op_49 prop:content "理論の正しさを実証し横展開したい"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:op_50 prop:content "将来的に人の判断をコンピューター化したい"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_6.
kg:op_51 prop:content "条件が合う圃場で自動化を試したい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:op_52 prop:content "楽しく農業できる技術も試していきたい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_6.
kg:op_53 prop:content "酒田港の地の利を生かして輸出を進めたい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_6.
kg:op_54 prop:content "ワイン特区や醸造用ブドウの広がりを注目していきたい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_6.
kg:op_55 prop:content "まずは国や県からの情報収集に当たりたい"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "任期終了後の過渡的なつなぎとして有効な就労先になり得る"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:st_7 rdfs:label "大沼康浩地域創生部長"@ja.
kg:st_7 rdfs:type cls:st_18.
kg:op_57 prop:content "操業継続を期待し情報交換を密にしたい"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_7.
kg:op_58 prop:content "将来的にも操業の継続を期待している"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_7.
kg:st_8 rdfs:label "荘司忠和上下水道部長兼管理課長"@ja.
kg:st_8 rdfs:type cls:st_18.
kg:op_59 prop:content "工業用水として基準は満たしたが生産活動に支障が出た企業があった"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_8.
kg:op_60 prop:content "水道水の安定供給上の大きな課題と捉えている"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_8.
kg:op_61 prop:content "新たな水質監視設備を設置し対応している"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_8.
kg:op_62 prop:content "山形県企業局と共同で仮設取水設備を設置した"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_8.
kg:op_63 prop:content "可能な限り水を融通し安定供給に努めたい"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_8.
kg:op_64 prop:content "広域化が給水制限リスク回避の最も有効な手段と考える"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_8.
kg:st_9 rdfs:label "梅木和広危機管理監"@ja.
kg:st_9 rdfs:type cls:st_35.
cls:st_35 rdfs:label "危機管理職"@ja.
kg:op_65 prop:content "冠水危険地域では注意点と冠水場所の周知が重要と考える"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_9.
kg:op_66 prop:content "ホームページや出前講座で危険性を周知したい"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_9.
kg:op_67 prop:content "自治会や自主防災会で避難経路を話し合う必要がある"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_9.
kg:op_68 prop:content "命を守る最低限必要な行動として垂直避難も周知している"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_9.
kg:op_69 prop:content "状況によっては全人口を受け入れられない可能性を否定できない"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_9.
kg:op_70 prop:content "早めの避難を呼びかける必要がある"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_9.
kg:op_71 prop:content "建物以外も活用し総合的に適切な避難誘導を図る必要がある"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_9.
kg:op_72 prop:content "東北地方ではイノシシ被害が農産物被害の1位となっている"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_6.
kg:op_73 prop:content "豚コレラ感染拡大の要因の一つとされ脅威と認識している"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_6.
kg:op_74 prop:content "市内業者でも取り組み希望があり支援を進める"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_6.
kg:op_75 prop:content "防護柵整備の負担軽減のため実質無利子化を図る"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_6.
kg:op_76 prop:content "予防対策のポイントとして消毒徹底が重要"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_6.
kg:op_77 prop:content "イノシシ対策を含め防護対策をしっかり進める"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_6.
kg:op_78 prop:content "有効なワクチンがないため水際対策をしっかりする必要がある"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_6.
kg:op_79 prop:content "国がさまざまな水際防疫を実施していると認識している"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_7.
kg:op_80 prop:content "農林水産省が違法持ち込みへの対応を厳格化している"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_7.
kg:op_81 prop:content "全国市長会と連携して要望していきたい"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_7.
kg:st_10 rdfs:label "菊池裕基健康福祉部長"@ja.
kg:st_10 rdfs:type cls:st_18.
kg:op_82 prop:content "2事業所が市役所の開庁日に合わせて1日交代で運営している"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_10.
kg:op_83 prop:content "新メニュー追加やコーヒーの一本化など改善している"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_10.
kg:op_84 prop:content "来客者数は月ごとの変動はあるが一定で推移している"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_10.
kg:op_85 prop:content "売り上げは一定の状況で推移している"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_10.
kg:op_86 prop:content "スタッフとしての障がい者就労人数は1.5人である"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_10.
kg:st_11 rdfs:label "市民"@ja.
kg:st_11 rdfs:type cls:st_42.
cls:st_42 rdfs:label "市民"@ja.
kg:op_87 prop:content "笑顔で丁寧な接客がすばらしくまた来店したい"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_11.
kg:op_88 prop:content "長く頑張ってほしいと応援している"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_11.
kg:op_89 prop:content "市民の声や課題を意見交換し事業展開に反映している"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_10.
kg:op_90 prop:content "工賃向上の観点から新メニュー提供を行っている"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_10.
kg:op_91 prop:content "より多くの事業者の参加を望み引き続き呼びかける"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_10.
kg:op_92 prop:content "人口減少のスピードは加速していると認識している"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "出生数の減少により自然減が大きくなっている"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
kg:op_94 prop:content "若年層の市外流出が主な要因と認識している"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_2.
kg:op_95 prop:content "県内8ハローワークのうち最下位で課題と認識している"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_2.
kg:op_96 prop:content "20代前半女性の社会減が大きな要因である"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_2.
kg:op_97 prop:content "地域資源を生かした付加価値の高い成長産業の集積を重点施策にする"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_2.
kg:op_98 prop:content "若い世代の女性が暮らして活躍したいと思う町を目指す"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_2.
kg:op_99 prop:content "大学の魅力向上と人材輩出で若者定住につなげる"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_2.
kg:op_100 prop:content "まず森林境界の明確化を図る調査を行っている"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_6.
kg:op_101 prop:content "戦略的に様子を見ながら積み立てる状況である"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_6.
kg:op_102 prop:content "来年度は意向調査に向け準備を進める"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_6.
kg:op_103 prop:content "酒田産木材の利用促進にも活用したい"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_6.
kg:op_104 prop:content "関係者と情報共有し来年に向けた使い道を議論している"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_6.
kg:st_12 rdfs:label "後藤泉議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_105 prop:content "大雨時に下流域への影響がないか心配する市民の声がある"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_12.
kg:op_106 prop:content "再造林がどうなるか注視し森林管理署と話をしていきたい"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_6.
kg:op_107 prop:content "親子で森林について学ぶ大切な機会として支援を続けたい"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_6.
kg:st_13 rdfs:label "伊藤優建設部長"@ja.
kg:st_13 rdfs:type cls:st_18.
kg:op_108 prop:content "観光案内板は管理台帳を整備している"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_13.
kg:op_109 prop:content "設置付近に業務で訪れた際に状態確認に努めている"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_13.
kg:op_110 prop:content "長寿命化計画に基づき施設の劣化状況をランクづけしている"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_13.
kg:op_111 prop:content "遊具や水飲みフェンストイレなどを毎月点検している"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_13.
kg:op_112 prop:content "専門業者点検が義務づけられている"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_13.
kg:op_113 prop:content "各施設の維持管理状況は所管部署でばらばらである"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_13.
kg:op_114 prop:content "施設点検マニュアルに準じて点検を徹底したい"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_13.
kg:op_115 prop:content "同じ視点で点検できるよう統一マニュアルを検討する"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_13.
kg:op_116 prop:content "破損や事故を未然に防ぐ予防型の維持管理を見据えたい"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_13.
kg:op_117 prop:content "環境省支援事業で専門家の助言を受けてきた"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_3.
kg:op_118 prop:content "一般市民も交えながら検討してきた"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_3.
kg:op_119 prop:content "令和2年度の環境基本計画見直しとあわせて策定を検討している"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "役場がなくなった影響で公務員の減少、商店の廃業、事業所閉鎖などが起き、地域が衰退したのが主な要因としています"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "役場がなくなった影響で公務員の減少、商店の廃業、事業所閉鎖などが起き、地域が衰退したのが主な要因としています"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "役場がなくなった影響で公務員の減少、商店の廃業、事業所閉鎖などが起き、地域が衰退したのが主な要因としています"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "旧３町の中心部は公務員の減少や商店の廃業、また事業所閉鎖が起こっており、地域の人々の生活に支障が起きていると感じています"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "このような状況は、今後地域を維持していく上で地元住民の将来不安につながり"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "また一段と人口減少が加速していくことが心配されます"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "空き家は地域の活力低下のみならず"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "空き家は地域の活力低下のみならず、また防犯問題"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "空き家は地域の活力低下のみならず、また防犯問題、野生動物の繁殖問題にもつながる"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "そのためにも旧中心部の空き家の活用が必要と考えます"@ja.
<< kg:id_9 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "活用、再利用することが必要であると考えます"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "若い世代の人材が活躍していただける機会、あるいは仕組みを造成することが必要と考えます"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "その学生や卒業生の力をかり、新たな産業づくりも必要ではと考えます"@ja.
<< kg:id_19 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "そのようなスタイルに応えるために泊食分離型の宿泊施設の整備がこれからの時代、必要ではないかと考えます"@ja.
<< kg:id_21 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "これら酒田特産物の魅力を大いに発信して楽しんでもらう仕組みが必要と考えます"@ja.
<< kg:id_5 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "旧３町の中心部は活力が失われつつある状況であると捉えております。国の統計によれば、平成19年と平成28年を比較をしますと八幡地域の中心部の小売業の商店の数は60店舗から45店舗に、松山地域の中心部の小売業の商店数は13店舗から８店舗に、平田地域の中心部の小売業の商店数は45店舗から34店舗に減少しております"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "中心市街地活性化基本計画に掲げる令和元年度の空き店舗数の目標が83店舗であるところ、目標の達成には至っていない状況にございます"@ja.
<< kg:id_24 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "引き続き産業振興まちづくりセンター、サンロクを中心とした貸し手と借り手のマッチング支援により空き店舗の減少を図ってまいります"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "総合支所管内を含めた中心部の空き店舗などの状況につきましては、事業主の高齢化などによる廃業など、さまざまな原因により地域のにぎわいが低下をしてきております"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "事業主の高齢化などによる廃業など、さまざまな原因により地域のにぎわいが低下をしてきております"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "本市では、新規創業、開業に対して「酒田市開業支援補助金」制度により店舗等の改装、設備工事などの初期投資に対して助成を行っております"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "空き店舗などの再利用につきましては、住居併設といった店舗の構造上のこともあり"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "倉庫として利用するなど、店舗を廃業してからも賃貸していないといったケースが多く、再利用には結びついていないという状況にあります"@ja.
<< kg:id_30 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "引き続き、酒田市産業振興まちづくりセンターを中心に民間活力を引き出し、新規に創業・開業を希望される方がいた場合には空き店舗等の再利用のほか、創業に関するアフターケアも含め、継続的に支援していきたいと考えております"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "管理不全な空き家は地域住民の生活環境などに悪影響を及ぼすことから"@ja.
<< kg:id_9 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "所有者などと連絡をとって助言、指導などにより改善につなげております"@ja.
<< kg:id_9 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "不動産業者、建設業協会、司法書士会、金融協会などで構成する空き家等ネットワーク協議会と連携し、空き家等情報サイトも活用しながら空き家の活用に努めております"@ja.
<< kg:id_9 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "今後ですけれども、空き家等ネットワーク協議会の無料相談会を年２回から年３回にふやし、より相談しやすい環境を整えていく予定でございます"@ja.
<< kg:id_9 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "さらに、空き家の解体、利活用に効果のある施策についても検討していきたいと考えております"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "本市の宿泊可能室数、旅館を中心に廃業が多く、年々減少しているという状況でございます。特に祭り、イベントの際には宿泊予約がとりにくいという声も聞き及んでいるところでございます"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "日帰りの場合は消費単価が5,467円、宿泊の場合はこの金額が１万8,514円と、おおむね３倍以上になると、観光客の皆様から宿泊をしてもらうことで、日帰りの３倍以上の経済効果がある"@ja.
<< kg:id_19 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "比較的低料金で宿泊し、外食でおいしい酒田の食を楽しんでもらうという泊食分離の形態、こちらは推進をしているという状況でございます"@ja.
<< kg:id_19 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "このようなことから、当然宿泊をふやしたいというようなことでございますけれども、宿泊機能の量、質ともに充実をさせるということが必要"@ja.
<< kg:id_19 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "その土台として民宿とか民泊、農泊、これに関するようなセミナーなども実施をしながら"@ja.
<< kg:id_21 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "酒の酒田の酒まつり、こちらのほうも定着してきておりまして、昨年度から年３回事業を行うようになって、認知度も上がって集客力のあるイベントになってきているかなと思っております"@ja.
<< kg:id_21 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "今後とも友好都市、交流都市のイベント、こういったところでも広く御紹介しながら、プロモーションしながら知名度を上げて、酒田を訪れるきっかけになるように育てていきたいと思っております"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "人口減少社会の中で、経済が少し弱くなっていくのかなと思っております。人口減少、高齢化の中で、購買、購入、経済を動く流通の部分がどうしても弱くなっていく"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "そういったものを民間の方が取得をいたしました。それを観光、宿泊施設としてどういう活用ができるのかなというところ、国内で古民家再生などを手がけている事業者などと、そこと結びつけながら"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "宿泊施設に食を持たないということは、その食を提供する方を雇用する必要がございません、あるいは手間が省けるということになります"@ja.
<< kg:id_55 prop:effect kg:id_57 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "さらには外に出ることによって町なかがにぎわうという効果がございます"@ja.
<< kg:id_55 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "そういう意味では、これからも泊食分離、そういうメリットを生かせるような、多分酒田には合っているんだと思いますので、そういったメリットを生かせるような動きを進めていければと思っております"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "我々としてもこれから全ての分野において、いわゆる酒田を売り込むシティプロモーション、これをしっかりやっていかないと"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "農業者の減少、労働力不足、あるいはベテラン農家のリタイア"@ja.
<< kg:id_61 prop:cause kg:id_63 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "農業者の減少、労働力不足、あるいはベテラン農家のリタイア"@ja.
<< kg:id_61 prop:cause kg:id_64 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "農業者の減少、労働力不足、あるいはベテラン農家のリタイアということでございまして、生産技術の伝承が非常にうまくいくのかというのが不安"@ja.
<< kg:id_65 prop:cause kg:id_66 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "土づくりが思うようにできない、そうするとボディブローのようにじわじわとこう効いてきて、恐らく収量にも影響が出てくる"@ja.
<< kg:id_61 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "我々できることというのは、このドローンを飛ばすとかセンシングして政策参与であります藤井先生から協力をいただいて分析をするという事業をやっていくのが一番いいのではないかな"@ja.
<< kg:id_61 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "スマート農業研修センターで「農業実践研修」を始めております。24名の若手の農業者の方に御参加いただきまして"@ja.
<< kg:id_61 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "来年度に関しましては、モデル地区を選定しまして、私がさっき申したような理論が本当に正しいのかどうかというのをしっかり実証して、そこで正しいとなれば横展開を図っていきたい"@ja.
<< kg:id_61 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "将来的には、人の目をカメラの目に置きかえて、それから人の判断をコンピューター化して人の手による施肥調整というのは無人ヘリとかで自動でやっていく"@ja.
<< kg:id_61 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "そういった意味では自動田植え機、自動化というのも少しできるのかなと"@ja.
<< kg:id_61 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "水田のいわゆるアイガモロボですね、ルンバですね、水田の30ａ圃場に落とすと、もう太陽光発電で草の除草を勝手に走ってやってくれる"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "やはり我々は酒田港持っておりますので、北前船という観点からも中国側、あちらのアジア側への地の利というのは非常にいいですから、できるだけ酒田港を大事に輸出というのを進めていきたい"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "「庄内産ワイン振興プロジェクト会議」というのが県の庄内総合支庁が事務局となりまして平成30年３月からやられております。酒田市もメンバーとなっております"@ja.
<< kg:id_77 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "まずは国や県からの情報収集に当たっていきたいと考えております"@ja.
<< kg:id_79 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "例えば、その地域おこし協力隊の任期終了後の就業先、起業するまでの過渡的なつなぎというような面でも期待されるところであります"@ja.
<< kg:id_81 prop:effect kg:id_82 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "逆を返せば、仮に操業がストップした場合は大きな痛手を負うということでございます"@ja.
<< kg:id_83 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "酒田市としては将来的にも操業の継続を期待しておりまして、その思いをもって今後とも情報交換を密にしてまいりたい"@ja.
<< kg:id_85 prop:effect kg:id_86 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "工業用水としての基準はクリアしたものの、塩分の入り混じった工業用水が供給され、生産活動に支障が出た企業もいらっしゃる"@ja.
<< kg:id_85 prop:effect kg:id_87 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "本市水道事業では初めて給水区域全域で10％から20％の給水制限に至る事態となりました"@ja.
<< kg:id_85 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "７月26日には水質の変化に迅速に対応できるよう新たに設置した水質監視設備の運用を開始し、水質監視の強化に努めてまいりました"@ja.
<< kg:id_85 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "庄内中央大橋付近へ仮設取水設備を山形県企業局と共同して設置するなどの対策を講じてまいりました"@ja.
<< kg:id_85 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "田沢川ダムを水源とする平田浄水場と小牧浄水場での浄水した水道水を可能な限り融通する、このことにより安定した水道水の供給に努めていきたい"@ja.
<< kg:id_85 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "やはり施設の統廃合・整理も見据えた水道事業の広域化による水運用の再編というところが給水制限等のリスクを回避する最も有効な手段と考えております"@ja.
<< kg:id_92 prop:cause kg:id_93 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "雨の降り方が局地化・集中化・激甚化する中、内水氾濫などによる冠水の危険のある地域の方々に対しては、避難する場合の注意点や具体的な冠水場所を周知し、避難における注意を促すことが重要"@ja.
<< kg:id_94 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "過去に大雨が降った際の道路冠水箇所及び浸水箇所などを地図にまとめた内水氾濫マップを作成いたしましたので、これをホームページまたは出前講座などで公表し、危険性を周知していきたい"@ja.
<< kg:id_94 prop:contermeasure kg:id_96 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "市といたしましては、各種情報を積極的に提供するとともに、地区防災計画の策定や避難マップの作成に支援を行ってまいります"@ja.
<< kg:id_94 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "避難が危険な場合は、自宅や近隣の２階以上へ緊急的に避難、これが垂直避難になりますけれども、そうすることも検討と明記しており"@ja.
<< kg:id_98 prop:effect kg:id_99 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "本市にとって最悪の事態である最上川の氾濫が最大浸水想定区域での浸水になった場合は、状況によっては対象の全人口を市内の緊急指定避難場所、避難所である建物で受け入れることができなくなる場合も否定はできない"@ja.
<< kg:id_98 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "最大浸水が想定されるような事態では、浸水しない区域への早目の避難を呼びかけていく"@ja.
<< kg:id_98 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "建物以外の活用、あるいは垂直避難など総合的に対応し、状況を踏まえながら適切な避難誘導を図っていかなければならない"@ja.
<< kg:id_102 prop:effect kg:id_103 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "東北地方の野生鳥獣による農産物被害報告というのが東北農政局でまとめておりまして、１位がイノシシとなっております"@ja.
<< kg:id_102 prop:effect kg:id_104 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "イノシシ、農作物被害だけではなく、やはり豚コレラ、ＣＳＦの感染拡大の要因の一つではないかと言われております"@ja.
<< kg:id_105 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "アフリカ豚コレラ侵入防止緊急支援事業というのが示されておりまして、防護柵、２分１の補助ということでございます"@ja.
<< kg:id_105 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "２分の１の補助残に関しましては、融資という形で利子補給いたしまして、実質無利子化するような形で"@ja.
<< kg:id_105 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "予防対策のポイントというので国のほうから示されておりますが、まずは消毒を徹底すると"@ja.
<< kg:id_105 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "それから野生動物対策をしっかりしていく"@ja.
<< kg:id_110 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "ＡＳＦのほうに関しましては、現在、国内ございませんけれども、伝染力と致死率が高く、しかもＣＳＦと違って有効なワクチンがございませんので、そういった意味では、まずは水際対策をしっかりしていく"@ja.
<< kg:id_112 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "港や空港において靴底の消毒、車両の消毒、海外での家畜との接触歴などに関する質問、手荷物の中から動植物検疫の対象となるものをかぎ分ける検疫探知犬による抜き打ち検査などの検疫が実施されております"@ja.
<< kg:id_112 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "国外からの肉製品の違法な持ち込みに対する対応を厳格化しております。任意の放棄の有無にかかわらず、違法な持ち込みに対しては厳正な対処をする"@ja.
<< kg:id_112 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "この件については、全国市長会と連携をとりながら要望してまいりたいと思います"@ja.
<< kg:id_116 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "障がい者サポートセンターあらたと、それから障がい福祉サービス事業所たぶの木の２つが、市役所の開庁日に合わせて１日交代で運営しております"@ja.
<< kg:id_116 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "利用される市民のニーズに合わせ、一部メニューをかえて提供しております"@ja.
<< kg:id_116 prop:effect kg:id_119 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "ことし４月から11月まで、１日当たりの平均については、来客者数が13人"@ja.
<< kg:id_116 prop:effect kg:id_120 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "売り上げは約7,000円ほど"@ja.
<< kg:id_116 prop:effect kg:id_121 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "スタッフとしての障がい者の就労人数は1.5人となっております"@ja.
<< kg:id_116 prop:effect kg:id_122 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "「笑顔で丁寧な接客がすばらしく、また来店したいと思う」といった声"@ja.
<< kg:id_116 prop:effect kg:id_123 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "「長く頑張ってください、応援しています」"@ja.
<< kg:id_116 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "福祉課では２つの事業所との話し合いの場を定期的に設けております。利用している市民からの声や今後の課題などにつきまして意見交換を行い"@ja.
<< kg:id_116 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "就労しております障がい者の工賃向上といった点からも、新しいメニューの提供など、事業展開に反映している"@ja.
<< kg:id_116 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "障がい者地域自立支援協議会の就労部会、こちらでも引き続き参加を呼びかけ"@ja.
<< kg:id_51 prop:effect kg:id_127 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "人口減少のスピードは加速してきており、このまま人口減少が進みますと、令和２年度中には人口10万人を切ることが見込まれております"@ja.
<< kg:id_51 prop:cause kg:id_128 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "平成30年に500人台に減少したことから、自然減が年間1,000人を超える状況となっております"@ja.
<< kg:id_129 prop:cause kg:id_130 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "本市の人口減少、特に社会減、転出超過している社会減につきましては、高校卒業時から20代前半にかけての年齢層の就職や進学に伴う市外への流出が主な要因と認識しております"@ja.
<< kg:id_129 prop:cause kg:id_131 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "就職を希望する新規高等学校卒業者の県内定着率が他地域と比べまして低いことが挙げられます"@ja.
<< kg:id_129 prop:cause kg:id_132 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "問題なのは、20代前半の女性が社会減になっていること、これが本市において社会減の大きな要因であると認識しております"@ja.
<< kg:id_133 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "地域資源を生かした付加価値の高い成長産業の集積、産業振興の視点から環境や漁業に配慮した再生可能エネルギー等の導入を促進し、関連する企業集積や港湾整備による地域経済の活性化"@ja.
<< kg:id_133 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "若い世代の女性が本市で暮らして活躍したいと思うような魅力ある町を目指し、また、１億総活躍社会に向けて、行政・企業・地域・家庭が連携・協力して、日本一女性が働きやすいまちを実現する"@ja.
<< kg:id_133 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "東北公益文科大学との大学まちづくりによる定住促進事業がございます"@ja.
<< kg:id_137 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "横代地区の皆様に御協力いただけるということで、ここをモデル地区に、まずは森林境界の明確化を図る調査というものを行っております"@ja.
<< kg:id_137 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "ほとんどは積み立てをしている市町村が多いと。ただ、やはりこういうのは我々にとって初めての経験なもんですから、何もなく積み立てるというよりは、戦略的に、様子を見ながら積み立てるという状況"@ja.
<< kg:id_137 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "来年度につきましては、ことしの横代での調査を踏まえながら、最終的には森林管理権の集積計画をつくっていかなければいけませんので、意向調査に向けて準備をしていきたい"@ja.
<< kg:id_137 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "来年は、浜田・若竹統合保育園（仮称）の構造材に充てることとなっておりますので、こうしたところで酒田産木材の利用促進にも活用させていただきたい"@ja.
<< kg:id_142 prop:contermeasure kg:id_143 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "市内の森林組合ですとか素材生産者、あるいは製材所の方々に集まっていただいて、勉強会という形で12月10日に県の方を講師に迎えまして開催いたしました"@ja.
<< kg:id_144 prop:effect kg:id_145 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "その伐採は間伐ではなく、一山全てを伐採する皆伐というやり方のため、大雨などの場合、下流域にその影響がないかと心配される市民の声があった"@ja.
<< kg:id_144 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "今後しっかり再造林されることというのがどうなるのかというのは注視させていただくとともに、もう少し庄内森林管理署と話をしてまいりたい"@ja.
<< kg:id_147 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "光ケ丘のボランティア活動ですとか、砂防林を育てようとか、万里の松原の活動とか、こうしたところで保育園、小中学校等の森林整備の活動というのを支援しております"@ja.
<< kg:id_149 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "観光案内板につきましては、管理台帳の整備はしております"@ja.
<< kg:id_149 prop:effect kg:id_151 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "ただ、職員による定期的な点検までは行っていない状況でございます"@ja.
<< kg:id_152 prop:contermeasure kg:id_153 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "公園施設につきましては、都市公園を対象とした健全度調査を実施しております"@ja.
<< kg:id_152 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "公園内の遊具や水飲み、フェンス、トイレなどにつきましては、職員が毎月１回点検を行っております"@ja.
<< kg:id_155 prop:contermeasure kg:id_156 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "特に遊具につきましては、平成30年４月１日から年１回の専門業者による点検が義務づけられてございます"@ja.
<< kg:id_149 prop:effect kg:id_157 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "各施設の維持管理の状況につきましては施設の所管部署でばらばらであって、その対応には実際、差がある現状"@ja.
<< kg:id_149 prop:contermeasure kg:id_158 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "看板やフェンスなどの工作物の点検をまずは徹底してまいりたい"@ja.
<< kg:id_149 prop:contermeasure kg:id_159 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "同じ視点で点検が行えるよう、統一マニュアルの作成も含めて検討してまいりたい"@ja.
<< kg:id_149 prop:contermeasure kg:id_160 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "破損、それから事故などを未然に防ぐ予防型の維持管理体制への転換をこれからは見据えていきたい"@ja.
<< kg:id_161 prop:contermeasure kg:id_162 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "環境省による生物多様性地域戦略に関する支援事業を受けまして、専門家の派遣により支援・助言を受け"@ja.
<< kg:id_161 prop:contermeasure kg:id_163 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "生物多様性について、そして地域戦略について、研修やワークショップを市担当者のほか一般市民も交えながら行ってきた"@ja.
<< kg:id_161 prop:contermeasure kg:id_164 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "令和２年度には酒田市環境基本計画の中間見直しが予定されております。これとあわせて生物多様性地域戦略の策定ができないか検討している"@ja.
}
