kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "人口減少を抑えるには若者の働く場が必要とみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "人口減少対策には住民の地域への愛着が必要とみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "農林水産業は担い手減少への対応が必要とみる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "農林水産業は高齢化の進行への対応が必要とみる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "農林水産業は産地間競争への対応が必要とみる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "新技術活用で農業の見える化と高度化を進める考え"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "農業者所得向上へ売れる米づくりと販路開拓を重視する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "林業は経営集約で安定施業を進める考え"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "林業の収益性向上へ流通改善と地域材活用拡大を進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "森林環境保全のため病害虫対策と市民活動支援を行う考え"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "水産業の所得向上へブランド化と販路拡大を進める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "水産資源管理で持続可能な漁業を目指す"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "雇用確保と地域発展には産業基盤強化が不可欠とみる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "産業支援拠点を活用して創業と企業連携を進める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "人手不足対策として自動化とデータ活用を進める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "未接続区間が酒田港との連携効果を妨げているとみる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "地域一丸で全線開通を求める考え"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "広域物流を支える重要道路と位置づける"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "救急医療確保にも重要とみる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "国県へ早期整備を強く求める方針"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "酒田港は寄港増加と新航路で活性化しているとみる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "港湾機能強化へ国内航路開設を進める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "産業集積を踏まえエネルギー拠点化を進める考え"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "北港地区をエネルギー拠点として育てる方針"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "文化は都市の品格と魅力向上に寄与するとみる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "地域資源を生かした文化施策を重点的に進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "条例と計画に基づき文化人材育成を進める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "交流人口拡大へ公共的ホール整備を検討する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "人口減少抑制には切れ目ない子育て支援が重要とみる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "子育てと教育の安心環境整備を重視する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "無償化対象外の低年齢児にも負担軽減を広げる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "多子世帯の保育負担軽減を継続する方針"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "兄姉年齢要件を外し保育料軽減を拡充する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:st_2 rdfs:label "子育て世代の皆様"@ja.
kg:st_2 rdfs:type cls:st_43.
cls:st_43 rdfs:label "子育て世代"@ja.
kg:op_34 prop:content "本市にも屋内型大型児童遊戯施設を求める"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "天候に左右されない遊び場整備を検討する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "小中一貫で系統的な教育を進める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "小中一貫教育は学力向上につながるとみる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "小中一貫教育は生徒指導の充実にもつながるとみる"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "地域や企業と連携したキャリア教育を進める"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "グローバル化で語学力や異文化理解力を持つ人材需要が高まるとみる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "教育委員会や高等教育機関と連携し国際対応教育を強化する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "にぎわい創出には市民参画と力を発揮できる風土が必要とみる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "人口減少下では住民地域行政の協働が不可欠とみる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "地域共創力強化へ運営指針を策定する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "大学の知見を地域づくりに活用する考え"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "学生の活動の見える化を進める"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "若年人口減少を踏まえ大学の安定運営策が必要とみる"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "大学の公立化を関係自治体と協議する方針"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "持続可能な公共交通ネットワークづくりを進める"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "災害関連死の半数は避難所環境の悪さが要因と認識する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "被災者の尊厳を守る避難所運営を重視する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "避難所のプライバシー確保と環境改善を進める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "人口減少で水道事業の収入減が進むとみる"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "施設更新が急務と認識する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "安定供給には資金と人員確保が課題とみる"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "広域化で持続可能な上水道体制を築く方針"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "財政力指数の改善で持続的な財政基盤を築く考え"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "評価結果を計画や予算に反映する仕組みを導入する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "スマート化で地域課題の解決を進める"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "スマート化で担い手不足とサービス維持の課題解決を目指す"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "産学官の専門知見を政策検討に生かす"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:st_3 rdfs:label "熊谷智会計管理者兼出納課長"@ja.
kg:st_3 rdfs:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_62 prop:content "令和3年初頭の運転開始に向け整備を進めたと説明する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_3.
kg:op_63 prop:content "定期航路の利用は前年度より増加したと説明する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_3.
kg:st_4 rdfs:label "加藤裕監査委員"@ja.
kg:st_4 rdfs:type cls:st_44.
cls:st_44 rdfs:label "監査機関"@ja.
kg:op_64 prop:content "決算書類は法令準拠で計数もおおむね正確と認める"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_4.
kg:op_65 prop:content "予算執行はおおむね適正と認める"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_4.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "人口減少を抑制し、人々が生き生きと暮らせるにぎわいのあるまちであるためには、若い人たちがやりがいを持って働ける場が必要であり"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "人口減少を抑制し、人々が生き生きと暮らせるにぎわいのあるまちであるためには、若い人たちがやりがいを持って働ける場が必要であり、住民が地域に愛着を持つことが必要です"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "農林水産業をめぐる状況は、農林漁業者の減少、高齢化の進行、他産地との競争など目まぐるしく変化しています"@ja.
<< kg:id_4 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "農林水産業をめぐる状況は、農林漁業者の減少、高齢化の進行、他産地との競争など目まぐるしく変化しています"@ja.
<< kg:id_4 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "農林水産業をめぐる状況は、農林漁業者の減少、高齢化の進行、他産地との競争など目まぐるしく変化しています"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "農業については、先人が大切にしてきた土づくり、人づくり、稲づくりを基本に、ＩＣＴ（情報通信技術）やドローンなど新たな技術を活用して、土壌分析や稲の育ちぐあいを見える化するスマート農業を実践します"@ja.
<< kg:id_8 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "農業者の所得向上のために、消費者のニーズを捉えた売れる米づくりと酒田産農産物の積極的なトップセールスに取り組みます"@ja.
<< kg:id_8 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "林業については、森林所有者の経営管理権を意欲と能力のある林業経営者に集約し、安定的な林業施行を確保します"@ja.
<< kg:id_8 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "林業経営者、森林組合、製材・建築関係者等の連携強化による流通コストの削減、地域材の利用拡大を図り、持続可能で収益性の高い森林経営を促進します"@ja.
<< kg:id_8 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "森林病害虫の駆除や防除、森林ボランティアへの支援を通して、森林環境の保全を図ります"@ja.
<< kg:id_8 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "飛島応援店の取り組みなどにより、水産関係者が一体となったブランド化や販路拡大により漁業所得の向上を図ります"@ja.
<< kg:id_8 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "水産資源を管理することにより、酒田の漁業、ひいては水産業が持続可能で収益性の高い産業となるよう取り組みます"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "力強い産業を構築することは、安定した雇用の確保と地域の発展に必要不可欠です"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "そのため、酒田市産業振興まちづくりセンター（サンロク）を拠点とした創業支援や企業のマッチング支援などに取り組みます"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "ビッグデータ等を活用した市場の拡大、業務の自動化システム、ＲＰＡ（ロボティック・プロセス・オートメーション）の導入による生産性の向上や人手不足への対応を積極的に進めます"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "日本海沿岸東北自動車道は、いまだ新潟・秋田両県境区間が接続されていないことから、重要港湾酒田港とつながることによる効果を十分に発揮できない状況にあります"@ja.
<< kg:id_22 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "官民一体、地域一丸となって粘り強く要望活動を行い、一日も早い全線開通を目指します"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "国道47号新庄酒田道路及び国道７号は、日本海沿岸部と県内陸地方や隣県を結ぶ重要な物流ルートとして"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "また広域的な救急医療の確保にも重要な役割を果たすものと期待されています"@ja.
<< kg:id_25 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "戸沢立川道路などの早期事業化及び国道７号広野・興野地区４車線化の早期整備が図られるよう国や県に強力に働きかけていきます"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "山形県唯一の重要港湾酒田港は、近年、外国クルーズ船の寄港増加や、友好都市、中華人民共和国唐山市の京唐港との新たな航路開設など活況を呈しています"@ja.
<< kg:id_29 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "外国との貿易だけでなく、国内のＲＯＲＯ船やコンテナ船等の航路開設について、県や関係機関と連携しながら進めていきます"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "現在、北港地区は、エネルギー関連産業の集積が進んでいることから"@ja.
<< kg:id_32 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "エネルギー基地としての拠点化を目指します"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "文化は、まちの品格をつくり、その魅力を高めてくれるものです"@ja.
<< kg:id_37 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "本市の文化力形成のため、地域資源を生かしたまちづくり事業を選択的、集中的に取り込むとともに"@ja.
<< kg:id_37 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "社会包摂の視点に立ち、地域社会の基盤となる人財の育成事業を酒田市文化芸術基本条例と酒田市文化芸術推進計画に基づき戦略的に推進します"@ja.
<< kg:id_40 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "都市機能の充実と交流人口の増加に向け、大規模なスポーツや文化の大会、展示会、学術会議など多様なイベント開催機能を有する公共的ホールの整備について検討を進めます"@ja.
<< kg:id_1 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "人口減少を抑制するためには、妊娠から出産、子育てまで切れ目のない支援と、安心して子供を産み育て、教育することができる環境を整えることが大切だと考えます"@ja.
<< kg:id_1 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "安心して子供を産み育て、教育することができる環境を整えることが大切だと考えます"@ja.
<< kg:id_44 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "制度の対象外であるゼロから２歳児の保育料についてさらなる軽減措置を実施し、県内トップレベルの負担軽減策に取り組みます"@ja.
<< kg:id_44 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "多子世帯において、第２子の保育料を３分の２軽減し、第３子以降の保育料を無料としている措置を継続するとともに"@ja.
<< kg:id_44 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "これまで第１子を小学６年生までとしていた年齢制限を撤廃し、第１子の年齢に関係なく第２子以降の保育料を軽減します"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "子育て世代の皆様から、本市にも屋内型の大型児童遊戯施設が欲しいとの声が多く寄せられています"@ja.
<< kg:id_48 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "冬季間や雨天時でも体を動かし遊ぶことができる屋内型大型児童遊戯施設の整備について検討を進めます"@ja.
<< kg:id_51 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "義務教育９年間の指導に系統性と一貫性を持たせることで、学力の向上、生徒指導の充実を図っていきます"@ja.
<< kg:id_51 prop:effect kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "義務教育９年間の指導に系統性と一貫性を持たせることで、学力の向上、生徒指導の充実を図っていきます"@ja.
<< kg:id_51 prop:effect kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "義務教育９年間の指導に系統性と一貫性を持たせることで、学力の向上、生徒指導の充実を図っていきます"@ja.
<< kg:id_51 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "同時に、地域コミュニティや企業の力を生かしたキャリア教育を進め、酒田方式の特色ある小中一貫教育体制を構築します"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "社会のグローバル化が加速する中で、語学力やコミュニケーション能力、異文化理解力を身につけて世界で活躍できる人材が求められています"@ja.
<< kg:id_51 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "教育委員会、高等教育機関等と連携して英語教育や異文化交流などグローバル化に対応した各種教育プログラムの実践を後押しします"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "まちににぎわいを創出するためには、市民が地域づくりに参画し、市民一人一人がそれぞれの力を発揮できる風土をつくっていく必要があります"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "今後も人口減少、少子高齢化が進むことが想定される中、住みよい地域社会の形成には、住民、地域、行政の協働が重要です"@ja.
<< kg:id_63 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "各コミュニティ組織の運営指針となるまちづくり協働指針を策定します"@ja.
<< kg:id_65 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "大学の知見や新たな発想を本市のまちづくりに生かすとともに"@ja.
<< kg:id_65 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "学生の活動が市民の皆様から見えるようにしていきます"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "今後、若年層の人口減少がより一層顕著となる中、安定して学生を確保し"@ja.
<< kg:id_68 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "公立化に向けた検討が必要と考え、大学の設置者である県及び庄内２市３町の枠組みで協議を進めます"@ja.
<< kg:id_71 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "るんるんバス等やデマンドタクシーと、路線バス、鉄道、航空機、タクシー等の民間交通サービスが連携することで、持続可能な公共交通ネットワークの整備を図ります"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "災害関連死は約200人となっており、その半数は避難所の劣悪な環境がもたらしたものと言われています"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "スフィア基準を重視した避難所運営ができるように努め"@ja.
<< kg:id_75 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "プライバシーに配慮するための間仕切りや簡易ベッドなどの配備により、災害時の避難所環境の充実を図ります"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "人口減少に伴い、使用水量や料金収入は減少傾向にあります"@ja.
<< kg:id_78 prop:cause kg:id_80 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "過去に建設した上水道施設が耐用年数に達してきているため、今後それらの施設の更新が急務となっており"@ja.
<< kg:id_78 prop:effect kg:id_81 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "水道水の安定供給に必要な資金、人員の確保が課題となっています"@ja.
<< kg:id_78 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "庄内広域水道用水供給事業と、本市、鶴岡市及び庄内町の給水事業を統合して、新たな広域的な上水道事業として再編成することで、持続可能な上水道事業の体制を構築していきます"@ja.
<< kg:id_83 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "市の財政力指数の改善を進めて財政の健全化に努め、将来へつながる財政基盤の安定化を図ります"@ja.
<< kg:id_85 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "一定の基準により評価を行い、その評価を次の計画や事務事業の見直し、予算編成などに反映させる仕組みを導入し、市民生活の向上という最終的な目標の達成につなげていきます"@ja.
<< kg:id_87 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "本市においても、ソサエティ5.0を見据え、ＩＣＴ（情報通信技術）の導入や、まちの仕組みのスマート化に積極的に取り組むことで"@ja.
<< kg:id_87 prop:effect kg:id_89 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "担い手不足や生活サービスの維持といった課題解決を図ります"@ja.
<< kg:id_90 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "本市におけるスマート社会の推進を図るため、産学官によるアドバイザーからそれぞれの専門的知見に基づく提言をいただき"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "令和３年初頭の運転開始に向けて、発電所建設工事を発注するとともに、維持管理の拠点となる風力発電管理施設を建設しました"@ja.
<< kg:id_94 prop:effect kg:id_95 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "年間の乗客数は２万4,378人と、前年度より1,595人、７％増加しております"@ja.
<< kg:id_96 prop:effect kg:id_97 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "審査に付された平成30年度一般会計・特別会計歳入歳出決算及びその他政令で定める書類は、関係法令に準拠して作成されており、計数も会計帳簿、証書類等と照合した結果、おおむね正確でありました"@ja.
<< kg:id_98 prop:effect kg:id_99 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "なお、予算執行については、おおむね適正であると認めたところです"@ja.
}
