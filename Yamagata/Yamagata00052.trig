kg:st_1 rdfs:label "予算特別委員会委員長佐藤伸二議員"@ja.
kg:st_1 rdfs:type cls:st_45.
cls:st_45 rdfs:label "議会関係者"@ja.
kg:op_1 prop:content "専決を妥当と認め承認すべきと判断"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山市長"@ja.
kg:st_2 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_2 prop:content "地方の人口減少に歯止めがかからないと認識"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "少子高齢化が進む現状を厳しい社会環境と認識"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "総合計画と総合戦略を着実に実行し持続可能な酒田市を実現する考え"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "多様化する課題に対応するには市民団体との協働が必要と認識"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "市民団体と行政の協働で課題解決を進める考え"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "市民団体と行政の協働で効果的効率的な解決を目指す"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "大学存続のため公立化検討が必要と判断"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "広域行政の枠組みで公立化議論を進める考え"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "地域で活躍するIT人材の育成に努める考え"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "利用者同士のつながりを強化しビジネス形成を促進する考え"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "担い手の確保育成が重要と認識"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "高収益作物と複合経営で農業所得の増大を図る考え"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "気候変動による農業生産への影響を懸念"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "不安定な気象に負けない農作物のため土づくりが大切と考える"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "スマート農業研修センターを中心にデータに基づく農業を推進する考え"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "林業の成長産業化には木材需要拡大が重要と認識"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "不漁の影響は極めて大きいと認識"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "漁業者が安心して経営と操業に向かえるよう働きかけを強める考え"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "感染予防に取り組みつつ酒田らしいおもてなしを続ける考え"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "地域住民主体の取組を引き続き支援する考え"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "多様性を認め合い共に生きる社会を目指す考え"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "社会参加を支える体制を強化する考え"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "救急医療体制の維持を図る考え"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "加入者の負担軽減のため税率を引き下げる考え"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "全ての市民が多重的に防災情報を取得できる環境整備を進める考え"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:st_3 rdfs:label "五十嵐英治総務常任委員会委員長"@ja.
kg:st_3 rdfs:type cls:st_45.
kg:op_27 prop:content "運行内容変更と新路線新設の改正を妥当と認めた"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "生活面や経済面で関わりの深い地域間の移動手段を確保する考え"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "財政が極めて厳しい状況にあると認識"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "事業のスクラップアンドビルドと部長裁量を生かす予算編成を実施"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "公平性公正性を図るため使用料を改定する考え"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "納税者の利便性向上を図る考え"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "効果測定と課題検証を行い窓口サービス向上につなげる考え"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "ふるさと納税寄附金が想定を大きく上回り、返礼品等の事務手続に支障を来すおそれが生じたことから"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:text-txt_contents "返礼品等の事務手続に支障を来すおそれが生じた"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "返礼品等事務経費を増額することについて専決処分したものであり、専決を妥当と認め承認すべきものと決定いたしました"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "依然として人口の東京一極集中が進み、地方においては人口減少に歯止めがかからず"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "地方においては人口減少に歯止めがかからず、少子高齢化が進む現状にあり"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:text-txt_contents "2040年は７万5,000人程度"@ja.
<< kg:id_7 prop:effect kg:id_11 >>
    prop:text-txt_contents "2060年には５万人を切るまで減少することが見込まれており"@ja.
<< kg:id_7 prop:effect kg:id_12 >>
    prop:text-txt_contents "2040年には、65歳以上の高齢者人口と15歳から64歳までの生産年齢人口が同程度になると推計されています"@ja.
<< kg:id_7 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "将来にわたり持続可能な酒田市を実現するため、総合計画を指針として、総合戦略をはじめとする各分野における個別計画を着実に実行することにより、一歩一歩前に進める施策を展開してまいります"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "多様化する市民生活の課題やニーズに対応するため、市民団体との協働による公共的サービスの提供が必要です"@ja.
<< kg:id_14 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "市民団体との協働による公共的サービスの提供が必要です"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "市民団体と行政の協働による地域課題の効果的・効率的な解決を目指し、「相互提案型協働事業」の試行と検証を行います"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今後も大学が存続するためには、公立化に向けた検討が必要です"@ja.
<< kg:id_19 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "庄内２市３町の広域行政の枠組みで公立化に向けた議論を進めます"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:text-txt_contents "学校給食施設の整備について、調理用機器の更新及び新規導入を行い"@ja.
<< kg:id_22 prop:effect kg:id_24 >>
    prop:text-txt_contents "調理員の労働環境の改善"@ja.
<< kg:id_22 prop:effect kg:id_25 >>
    prop:text-txt_contents "食中毒の予防"@ja.
<< kg:id_22 prop:effect kg:id_26 >>
    prop:text-txt_contents "調理業務の効率化により、安全安心な給食を提供します"@ja.
<< kg:id_27 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "東北公益文科大学が民間企業と連携して、ビッグデータ活用やデータサイエンスなどに関するプログラムを実施することにより、地域で活躍するＩＴ人材の育成に努めます"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "新たにサンロク内に「コミュニティマネージャー」を配置することで、利用者同士のつながりを強化し、ビジネスプロジェクトの形成を一層促進するとともに"@ja.
<< kg:id_31 prop:contermeasure kg:id_32 >>
    prop:text-txt_contents "ビッグデータの活用、ＲＰＡの導入による地元企業の生産性向上を図ります"@ja.
<< kg:id_31 prop:contermeasure kg:id_33 >>
    prop:text-txt_contents "ビッグデータの活用、ＲＰＡの導入による地元企業の生産性向上を図ります"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "農業を持続可能な産業とし、次世代へ継承するためには、担い手の確保・育成が重要です"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "戦略作物であるアスパラガス、シャインマスカット、ストックなど高収益作物にも取り組み、複合経営を目指すことで農業所得の増大を図ります"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "近年の気候変動により農業生産への影響が懸念されます"@ja.
<< kg:id_38 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "不安定な気象にも負けない丈夫な農作物を作るため、代々受け継がれてきた土づくりをすることが大切です"@ja.
<< kg:id_38 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "土壌分析やドローンなどを活用し、データに基づく農業を推進します"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "林業の成長産業化と森林資源の適切な管理を図るためには、酒田産木材の利用促進による需要の拡大が重要です"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:text-txt_contents "先人から受け継いだ松林を松くい虫の被害から守るため"@ja.
<< kg:id_44 prop:contermeasure kg:id_46 >>
    prop:text-txt_contents "松くい虫の被害から守るための駆除対策"@ja.
<< kg:id_47 prop:effect kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "スルメイカは昨年、深刻な不漁となり、漁業者の経営に及ぼす影響は計り知れません"@ja.
<< kg:id_47 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "漁業者が安心して経営と操業に向かえるよう関係機関に対し働きかけを強めます"@ja.
<< kg:id_50 prop:contermeasure kg:id_51 >>
    prop:text-txt_contents "移住相談総合窓口できめ細かに対応するとともに"@ja.
<< kg:id_50 prop:contermeasure kg:id_52 >>
    prop:text-txt_contents "各種支援施策を拡充します"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "今、問題となっている新型コロナウイルスによる感染予防については、関係機関と連携して取り組みつつ"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:text-txt_contents "クルーズ船の寄港が予定されていることから、今、問題となっている新型コロナウイルスによる感染予防については"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:text-txt_contents "高齢化の進行や単身高齢者等の増加に伴い、地域における生活支援や介護予防のニーズが高まっている"@ja.
<< kg:id_56 prop:cause kg:id_58 >>
    prop:text-txt_contents "高齢化の進行や単身高齢者等の増加に伴い"@ja.
<< kg:id_56 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "自治会やコミュニティ振興会など、地域住民が主体となって取り組む身近な居場所づくりや介護予防、健康づくりへの支援を引き続き行います"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "「酒田市障がいのある人もない人も共に生きるまちづくり条例」を制定し、全ての市民が障がいの有無によって分け隔てられることがなく、多様性を認め合いながら共に生きる社会の実現を目指します"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:text-txt_contents "障がい者の積極的な社会参加のためには、障がいの特性に応じた配慮が必要であることから"@ja.
<< kg:id_62 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "手話奉仕員の育成など、その体制を強化していきます"@ja.
<< kg:id_65 prop:contermeasure kg:id_66 >>
    prop:text-txt_contents "子育て世代包括支援センター「ぎゅっと」では、産前産後サポートや産後ケア、相談体制の充実を図り、安心して子供を産み育てられる環境を整備します"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:text-txt_contents "保護者の多様な働き方に伴う保育ニーズの変化"@ja.
<< kg:id_67 prop:contermeasure kg:id_69 >>
    prop:text-txt_contents "一時預かりや休日保育などの特別保育についても対応します"@ja.
<< kg:id_70 prop:contermeasure kg:id_71 >>
    prop:text-txt_contents "運動と食事による健康づくりプログラムを引き続き実施していく"@ja.
<< kg:id_70 prop:contermeasure kg:id_72 >>
    prop:text-txt_contents "腸内環境と疾患の関連性について研究するプロジェクト事業など、市民の健康づくりのための実証事業に協力をします"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "本間病院の救急搬送患者の受入れに対する助成制度を創設し、安心して生活できる医療提供体制の維持を図ります"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "加入者の負担軽減を図るため、令和２年度に税率の引下げを行います"@ja.
<< kg:id_77 prop:contermeasure kg:id_78 >>
    prop:text-txt_contents "ごみ出し情報の発行や出前講座により普及啓発を進める"@ja.
<< kg:id_77 prop:contermeasure kg:id_79 >>
    prop:text-txt_contents "使用済み小型家電・古着などの無料回収を増やして実施します"@ja.
<< kg:id_77 prop:contermeasure kg:id_80 >>
    prop:text-txt_contents "４月から水銀使用廃製品の分別収集を始めます"@ja.
<< kg:id_81 prop:contermeasure kg:id_82 >>
    prop:text-txt_contents "大規模災害の発生に対応するため、防災減災対策として、避難所に備蓄している食料や飲料水の更新"@ja.
<< kg:id_81 prop:contermeasure kg:id_83 >>
    prop:text-txt_contents "学校などへの避難所用発電機の計画的配備を行う"@ja.
<< kg:id_81 prop:contermeasure kg:id_84 >>
    prop:text-txt_contents "新たに津波避難ビルへの備蓄を行います"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:text-txt_contents "八幡、松山及び平田地域に配備されている戸別受信機が、令和４年度から使用できなくなることを踏まえ"@ja.
<< kg:id_85 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "防災ラジオの普及を全市的に進めるためＦＭラジオ中継局の整備を行い、全ての市民が多重的に防災情報を取得できる環境整備を進めます"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:text-txt_contents "地震による住宅倒壊などの被害"@ja.
<< kg:id_88 prop:contermeasure kg:id_90 >>
    prop:text-txt_contents "山形県建築士会酒田支部と連携し、耐震診断を実施します"@ja.
<< kg:id_88 prop:contermeasure kg:id_91 >>
    prop:text-txt_contents "耐震改修、建替えに対して支援するとともに"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "福祉乗合バスの運行内容の変更及び福祉乗合タクシー松山庄内町線の新設のため"@ja.
<< kg:id_94 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "松山地域から庄内町への移動手段を確保するため、デマンドタクシー路線を新設します"@ja.
<< kg:id_96 prop:contermeasure kg:id_97 >>
    prop:text-txt_contents "地域公共交通を将来にわたり、持続可能で利便性の高いものとするよう、地域の実情に合った地域公共交通の在り方について、交通事業者及び利用者などと協議し、令和４年３月の乗合バス及びデマンドタクシー路線の再編を目指します"@ja.
<< kg:id_98 prop:contermeasure kg:id_99 >>
    prop:text-txt_contents "利用拡大のため子供無料キャンペーンを継続します"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "社会保障制度の充実に伴う費用の増加などにより財政が極めて厳しい状況にある"@ja.
<< kg:id_100 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "投資事業などを除いた予算要求枠についてマイナスシーリングと枠配分方式を併用するとともに、事業のスクラップ・アンド・ビルドを促し、かつ各部長の裁量を生かす予算編成を実施しました"@ja.
<< kg:id_103 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "利用者負担と公費負担の公平性、公正性を図るため、見直しを行い、４月より使用料を改定します"@ja.
<< kg:id_105 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "納税者の利便性向上を図るため、コンビニエンスストアでの市税や保育料、保険料などの納付に加えて、スマートフォンアプリによるキャッシュレス決済の導入を進めます"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "市役所内の事務について、ＲＰＡを一部試験導入し、効果測定や長期運用を見据えた課題検証を行い、事務作業の短縮化による窓口サービスの向上に取り組みます"@ja.
<< kg:id_107 prop:effect kg:id_109 >>
    prop:text-txt_contents "事務作業の短縮化による窓口サービスの向上"@ja.
}
