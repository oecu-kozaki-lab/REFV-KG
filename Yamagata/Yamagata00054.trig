<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "このたびの新型コロナウイルス感染拡大に伴い、３月定例会で申し述べました令和２年度市長施政方針に関して一定の見直しが必要であると判断"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "2020東京オリンピック・パラリンピックも、世界的な感染拡大を受け、１年の延期を余儀なくされました"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "４月７日には東京都など７都道府県を対象に国が緊急事態を宣言し、４月16日には対象が全国に拡大される事態となりました"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "学校の臨時休業、公共施設の休館に加え"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "学校の臨時休業、公共施設の休館に加え"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "不要不急の外出自粛や休業の要請"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:text-txt_contents "酒田まつりをはじめとする行事や催物等の開催制限や中止"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:text-txt_contents "スポーツ大会や外国クルーズ船の酒田港寄港も相次いで中止となる"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:text-txt_contents "スポーツ大会や外国クルーズ船の酒田港寄港も相次いで中止となる"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "私たちの社会生活や経済活動は大きな影響を受けております"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "新たな感染者数は着実に減少していますが、このウイルスとの闘いは長期にわたると言われています"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今回の新型コロナウイルス感染拡大の影響により大きくさま変わりし、酒田市総合計画を推進するための令和２年度当初予算の前提条件も大きく変わった"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "生命を守るため、身体的距離の確保"@ja.
<< kg:id_1 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "手洗いと咳エチケットの励行"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "３つの密（密集、密接、密閉）の回避"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "引き続き感染拡大を予防する新しい生活様式の実践を私たち一人一人が徹底することが求められています"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "まずは、感染拡大の防止、地域経済や市民生活を支援する施策について最優先に取り組むことが急務"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "今年度当初に予定していた事業のうち一部の事業については次年度以降に延期するなど、今年度の事業や予算の執行、次年度以降の事業計画の見直しを行います"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "駅周辺整備事業における駅前広場の整備計画...については、後年度に延期します"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
