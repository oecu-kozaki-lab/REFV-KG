kg:st_1 rdfs:label "松本国博議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "1年遅れ開催や無観客開催は残念だが無事開催できたと受け止める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "中止は非常に残念だがスポーツを通した交流事業として認識する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "鈴木和仁教育長"@ja.
kg:st_2 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_3 prop:content "スポーツには様々な効果があると認識する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "スポーツには様々な効果があると認識する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "スポーツには様々な効果があると認識する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "心身の健康維持と増進に効果がある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "トップアスリート観戦は心身の健康維持と増進に効果がある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "子供の人間形成に重要な役割を果たす"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "子供の人間形成に重要な役割を果たす"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "誰もがスポーツを楽しむことで長寿社会の実現につながる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "観光としての側面を理解し活用して経済活動増加につなげるべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "ハーフマラソン大会は交流人口拡大につながる最も大きなスポーツイベント"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "県内唯一の屋内リンクとして観光や交流のきっかけになる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "市内外を問わず毎シーズン多くの利用がある"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "野球場として瀕死の状態で早急な整備が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "メイン球場にもう少し手をかけるべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "最低限の設備措置をしてほしい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:st_3 rdfs:label "丸山至市長"@ja.
kg:st_3 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_18 prop:content "どの改修を急ぐべきか懇談会で意見を聞き方向性を見いだしたい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "観戦や応援ができず野球場としての機能が損なわれている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "もはや野球場で観戦する形ではない状況"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "地区大会はもちろん練習試合もままならない"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "施設内雨漏りやフィールド状態が良好でないと認識する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "市民や競技関係団体の意見を聞き整備方針を固めたい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "経済活動や交流人口拡大につなげるため連携して取り組む"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:st_4 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_4 rdfs:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_25 prop:content "大会で出店や情報発信がなかったのは連携不足を反省している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "非常に大事な活動でありこれから取り組みたい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "オンライン化を今後さらに推進したい"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "時間や場所にとらわれず手続できる利点がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "データ入力や分析の省力化に寄与する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "買物や配送などの仕組み構築に取り組んでいる"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "医師がより的確な診断を行える実証を進めている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "市民が必要な情報を必要なときに入手できるようにしたい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "一度入力したデータを何度も入力しなくてよい仕組みを目指す"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "子供一人一人に応じた学び方や主体的学習につなげたい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "国が安全性や信頼性を丁寧に十分説明すべき"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "全国市長会を通じて国に説明を求めている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "来年度試験的な実施を考えたい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:st_5 rdfs:label "斎藤周議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_38 prop:content "第6波に備えた対策を今のうちに強めるべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "検査を引き続き重視すべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "いつでも誰でも何度でも無料での検査が基本だ"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "検査抑制の結果として医療崩壊が起きた"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "日常的な集団活動の場で思い切って実施すべき"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "子供の感染や家庭内感染対策として必要"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:st_6 rdfs:label "松田俊一健康福祉部地域医療調整監"@ja.
kg:st_6 rdfs:type cls:st_41.
cls:st_41 rdfs:label "調整監"@ja.
kg:op_44 prop:content "感染予防対策としての実施には課題がある"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "技術的な採取や結果判断、その後の医療対応に課題が多い"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "ワクチン接種者を含め継続実践が重要"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:op_47 prop:content "継続実践が重要"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "継続実践が重要"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_6.
kg:op_49 prop:content "継続実践が重要"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:op_50 prop:content "庄内地域で168室を確保しており第5波時より大きく増加した"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_6.
kg:op_51 prop:content "県内の保健医療提供体制確保計画に基づき病床を拡充した"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:op_52 prop:content "事業規模を反映すると考え上下水道料金を根拠に支援してきた"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:op_53 prop:content "限られた財源の中では慎重に判断する必要がある"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:st_7 rdfs:label "菅原正成農林水産部長"@ja.
kg:st_7 rdfs:type cls:st_18.
kg:op_54 prop:content "過剰な民間在庫になったことが要因と認識する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "人口減少や1人当たり消費量減少の影響もある"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "前年産比2300円の大きな下げ幅で厳しい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_7.
kg:op_57 prop:content "県内でいち早く次期作支援を講じた"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_7.
kg:op_58 prop:content "子宮頸がん検診と合わせ非常に有効だと認識し積極的にPRしたい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_3.
kg:op_59 prop:content "積極的勧奨再開後は有効性と安全性を積極的に周知したい"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_3.
kg:st_8 rdfs:label "白畑真由美健康福祉部長"@ja.
kg:st_8 rdfs:type cls:st_18.
kg:op_60 prop:content "個別通知や医師会との連携で周知徹底し安心して接種できるようにする"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_8.
kg:st_9 rdfs:label "遠田敏子議員"@ja.
kg:st_9 rdfs:type cls:st_16.
kg:op_61 prop:content "急な対応にもかかわらず丁寧な個別対応に感謝する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_9.
kg:op_62 prop:content "子供の将来や健康に大きな影響を与える実態がある"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_9.
kg:op_63 prop:content "家族構成の変化を背景に年々増加している"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_9.
kg:st_10 rdfs:label "齋藤一志教育次長"@ja.
kg:st_10 rdfs:type cls:st_48.
cls:st_48 rdfs:label "教育次長"@ja.
kg:op_64 prop:content "認知度向上や支援のため来年度以降も引き続き実施したい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_10.
kg:op_65 prop:content "学校や保育所だけでなく障がい福祉や介護保険関係事務所等にも周知したい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_10.
kg:op_66 prop:content "学校と福祉や医療の連絡調整役として機能している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_10.
kg:st_11 rdfs:label "大谷謙治市民部長"@ja.
kg:st_11 rdfs:type cls:st_18.
kg:op_67 prop:content "高齢者にとっても大変便利なカードである"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_11.
kg:op_68 prop:content "コミュニティセンターや施設等で状況に応じて対応したい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_11.
kg:st_12 rdfs:label "佐藤喜紀議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_69 prop:content "選ばれる観光地となる取組を進める必要がある"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_12.
kg:op_70 prop:content "生活様式の変化に対応した観光戦略が必要"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_12.
kg:op_71 prop:content "今後DMO登録の土台になっていく"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_3.
kg:op_72 prop:content "自然食文化を多角的に楽しむ長期滞在型の新しい旅を提供したい"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_3.
kg:op_73 prop:content "予約購入決済顧客分析まで一括で行い受入側の業務軽減やマーケティングに活用したい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_3.
kg:op_74 prop:content "コロナ禍でも実施可能な取組として対応したい"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_3.
kg:op_75 prop:content "コロナ後の観光の戻りが早い台湾からの誘客を図りたい"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_3.
kg:op_76 prop:content "コロナ禍では船社に応じた個別のおもてなしが求められる"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_3.
kg:op_77 prop:content "学校や保護者へ丁寧に説明し承認を得て実施する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_3.
kg:st_13 rdfs:label "池田里枝教育次長"@ja.
kg:st_13 rdfs:type cls:st_48.
kg:op_78 prop:content "飲酒喫煙年齢や受験就職時期、市民アンケート結果を踏まえた"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_13.
kg:op_79 prop:content "出前講座や188周知、相談窓口対応で注意喚起したい"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_11.
kg:op_80 prop:content "若年層が被害に遭わないよう積極的に開催したい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_11.
kg:op_81 prop:content "生涯学習や地域福祉の増進を目的とすれば屋外活動後の宿泊も可能"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_13.
kg:op_82 prop:content "要望があれば今後協議していきたい"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_13.
kg:st_14 rdfs:label "後藤仁議員"@ja.
kg:st_14 rdfs:type cls:st_16.
kg:op_83 prop:content "高齢化の中で住民の負担が限界で整備が待たれている"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_14.
kg:op_84 prop:content "高齢化によってもう限界だという声が多い"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_14.
kg:st_15 rdfs:label "矢口明子副市長"@ja.
kg:st_15 rdfs:type cls:st_40.
cls:st_40 rdfs:label "副市長"@ja.
kg:op_85 prop:content "ほかの地区より多くの防火貯水槽を設置している"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_15.
kg:op_86 prop:content "3日間までを支給対象とし一定割合以上の協力者が除雪した場合は超過後も支給する"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_15.
kg:op_87 prop:content "一定程度認識しており改善を検討したい"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_15.
kg:op_88 prop:content "除雪可能な人や事業者と除雪してほしい人を結びつける制度設計を検討したい"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_8.
kg:op_89 prop:content "建設業者以外のNPOや高齢者支援事業者の活用も検討したい"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_15.
kg:op_90 prop:content "令和5年1月文化庁提出を目指し計画を進める"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_13.
kg:op_91 prop:content "保存活用計画の中で具体的取扱基準を示す"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_13.
kg:op_92 prop:content "今年度から策定に向けた準備を進めたい"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_13.
kg:op_93 prop:content "県の協議の推移を見守り本市でどう関わってもらうか検討したい"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_13.
kg:op_94 prop:content "過去の酒田の出来事や文化を未来に伝える総合施設として整備したい"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_13.
kg:op_95 prop:content "地域経済を牽引する中核企業であり現状では宣言は考えていない"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_15.
kg:op_96 prop:content "総合計画後期計画の中で市の方向性を示し宣言につなげたい"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_15.
kg:op_97 prop:content "来年以降市全体を包含する区域施策編の策定を検討したい"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_11.
kg:op_98 prop:content "制度の趣旨に賛同できるため広報やホームページで周知したい"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_15.
kg:op_99 prop:content "黄色信号から赤信号点滅にかかっている印象である"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_3.
kg:op_100 prop:content "活動が限定的で広がらずより大きな組織で活動すべきと判断した"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_3.
kg:op_101 prop:content "県も会員のより大きく広範な組織で利便性向上や利用促進に取り組むべきと判断した"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_3.
kg:op_102 prop:content "県土の一体的な発展につながると認識している"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_3.
kg:op_103 prop:content "陸羽西線の廃線を防ぐ唯一の手だてであると認識する"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_3.
kg:op_104 prop:content "来年度から会長としてイニシアチブを取り県に強く要望していきたい"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_3.
kg:op_105 prop:content "手を下ろしたわけではなく働きかけを弱めるつもりはない"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "新型コロナウイルス感染症の影響により、１年遅れの延期開催でありました。基本的には無観客開催となりながらも、無事にスポーツの祭典を開催できたものと感じております"@ja.
<< kg:id_3 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本市においては、ニュージーランドのホストタウンでありました。しかし、トライアスロン競技のニュージーランド代表チームの事前キャンプが中止になるなど、非常に残念なこともありました"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "脳の発達、集中力のアップやストレス発散、身体健康増進の観点からもスポーツは重要かと思われます"@ja.
<< kg:id_4 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "脳の発達、集中力のアップやストレス発散、身体健康増進の観点からもスポーツは重要かと思われます"@ja.
<< kg:id_4 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "脳の発達、集中力のアップやストレス発散、身体健康増進の観点からもスポーツは重要かと思われます"@ja.
<< kg:id_4 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "脳の発達、集中力のアップやストレス発散、身体健康増進の観点からもスポーツは重要かと思われます"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "特にトップアスリート等の競技スポーツを観戦することで興奮や感動をすることは、心身の健康維持と増進に効果があるものと考えております"@ja.
<< kg:id_4 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "子供にとってスポーツは、生涯にわたってたくましく生きるための健康や体力の基礎を培うとともに、公正さと規律を尊ぶ態度や克己心を育むなど人間形成に重要な役割を果たすものと捉えているところでございます"@ja.
<< kg:id_4 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "子供にとってスポーツは、生涯にわたってたくましく生きるための健康や体力の基礎を培うとともに、公正さと規律を尊ぶ態度や克己心を育むなど人間形成に重要な役割を果たすものと捉えているところでございます"@ja.
<< kg:id_4 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "誰もが気軽にスポーツを「する」、「みる」、「ささえる」、この活動を通し楽しむことで、心身の健康の保持増進と健康で活力に満ちた長寿社会の実現ができるものと考えております"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "スポーツを観光に結びつけ、経済活動・交流人口拡大にまでつなげようとするものだと認識しております"@ja.
<< kg:id_14 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "スポーツを観光に結びつけ、経済活動・交流人口拡大にまでつなげようとするものだと認識しております"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "平成29年度のデータによると、中学生以下の43％は市外からの利用となり、さらに付添いの保護者を含める人数が本市を訪れていることになります"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "この事例のように、スポーツが経済活動・交流人口増加に貢献しており"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "光ケ丘野球場においては、フィールド内の不備"@ja.
<< kg:id_20 prop:cause kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "運営施設内の雨漏りの常態化"@ja.
<< kg:id_20 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "医務室にはエアコンも整備されておらず"@ja.
<< kg:id_20 prop:cause kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "照明設備の老朽化により、照明器具の落下の危険性があるため"@ja.
<< kg:id_20 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "ついには観戦スタンドのおよそ８割が立入り禁止となり"@ja.
<< kg:id_20 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "観戦や敵味方に分かれての応援ができないなど状況が悪化しており"@ja.
<< kg:id_20 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "地区大会の開催はもちろん、練習試合もままならない施設となっております"@ja.
<< kg:id_20 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "地区大会の開催はもちろん、練習試合もままならない施設となっております"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "意見を伺う場として、競技団体関係者をはじめ外部関係者を含めた懇談会を立ち上げ、検討してまいりたいと思っております"@ja.
<< kg:id_29 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "本市の観光パンフレットなどでＰＲするとともに、経済活動・交流人口の拡大につなげていくために、今後も、交流観光課等と連携して取り組んでまいりたい"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "今回、アランマーレの大会の中で出ていなかったということは、恐らくちょっと連携が悪かったのかなということで少し反省をするところでございます"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "例えばＱＲコードで酒田の観光情報を流すとか、そういったことができるようなチラシ１枚、ポスター１枚、それでも効果があるのかなと思いますので、そういったところをこれから取り組んでまいりたい"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "令和３年４月時点で18様式だったものが12月１日現在では105様式まで増加し、全体に占める割合は約12％となっているところでございます"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "時間や場所にとらわれずに手続等ができるという市民の利便性の向上"@ja.
<< kg:id_38 prop:effect kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "オンライン申請ではその必要がなくなったり、それから、データの分析が省力化されるなど、業務の効率化にも寄与している"@ja.
<< kg:id_41 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "離島が抱える課題解決のため、ＩＣＴ技術の実装を図るための事業でございまして"@ja.
<< kg:id_41 prop:contermeasure kg:id_43 >>
    prop:text-txt_contents "観光客向けのスマート・オーダーシステム"@ja.
<< kg:id_41 prop:contermeasure kg:id_44 >>
    prop:text-txt_contents "ｅモビリティを活用した食事の配送システムの構築などに取り組んでいるところでございます"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "有機ＥＬを活用した遠隔診療実証実験につきましては、日本海総合病院と飛島診療所などをつないで、有機ＥＬの特性を生かして自然に近い色合いで顔色ですとか、傷の状態などを観察をして、医師がより的確な診断を行うことができるというものでございます"@ja.
<< kg:id_36 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "市民一人一人の属性や希望に合わせた情報発信を行うなどによりまして、市民が必要な情報を必要なときに入手することが可能となる市民マイページというものの構築を現在考えているところでございます"@ja.
<< kg:id_36 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "氏名や住所など一度入力したデータを何度も入力する必要がないワンスオンリーによるオンライン申請が実現するようになるのではないかなと考えております"@ja.
<< kg:id_49 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "教育のデジタル変革を今年度調査を実施している電子学習ドリルの実証を皮切りに、デジタル技術を活用して子供一人一人に応じた学び方や指導の在り方を考察して、生徒たちが主体的な学習や探究的学習につなげていければ"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "マイナンバーカードと各種情報との連携については、国民の皆さんから非常に不安視をする声があることは認識はしております"@ja.
<< kg:id_51 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "マイナンバー制度の安全性や信頼性について、丁寧かつ十分に説明するなど、国として行うことが盛り込まれております"@ja.
<< kg:id_54 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "市民の皆さんが視聴しやすい形態としてどういうものがいいのかということを念頭に、記者会見の会場でのネット環境の確保などの課題も整理をしながら、私としては来年度試験的な実施を考えていきたい"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "オミクロンがなくても、この冬、第６波が襲ってくると言われております"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "ワクチンを接種していることは、感染しないことを意味しません"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "検査を怠ると思わぬ感染をもたらすことがあるので、検査は引き続き重要と述べております"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "厚生労働省はＰＣＲ検査を広げると医療崩壊が起こるという内部文書を出して検査を抑えてきました。その結果、第５波では医療崩壊が起きたのであります"@ja.
<< kg:id_56 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "企業、学校、飲食店等、比較的日常的に集団で日常活動を行っているところでのＰＣＲ検査あるいは抗原定量検査を第６波対策として、この際思い切って実施するという大胆に行っていくことが必要"@ja.
<< kg:id_56 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "学校や保育園、幼稚園、会社などを通して検査キットを配布して、体調の変化を感じたらすぐに自主的な検査を行うことができるようにすることが必要"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "これは適切な判断に結びつかない危険性などもあるかと考えております"@ja.
<< kg:id_68 prop:effect kg:id_69 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "技術的に正しく検体を採取して検査を実施することや、検査結果の判断とその後の医療への対応など課題も多く、混乱を招く可能性がある"@ja.
<< kg:id_70 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "不織布マスクの着用、小まめな手洗いや手指消毒、３密の回避、換気の励行などを継続して実践いただくことが重要"@ja.
<< kg:id_70 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "不織布マスクの着用、小まめな手洗いや手指消毒、３密の回避、換気の励行などを継続して実践いただくことが重要"@ja.
<< kg:id_70 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "不織布マスクの着用、小まめな手洗いや手指消毒、３密の回避、換気の励行などを継続して実践いただくことが重要"@ja.
<< kg:id_70 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "不織布マスクの着用、小まめな手洗いや手指消毒、３密の回避、換気の励行などを継続して実践いただくことが重要"@ja.
<< kg:id_56 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "県では、庄内地域に新たに部屋数168室の宿泊療養施設を確保していることから、第５波のときと比べますと、確保されている部屋数は大きく増加しております"@ja.
<< kg:id_76 prop:contermeasure kg:id_77 >>
    prop:text-txt_contents "宿泊療養施設の医療体制は、午前８時から午後４時45分までの日中は看護師が常駐しており、検温等の健康観察を行っております"@ja.
<< kg:id_56 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "県では、県内の自治体病院と協議の上、コロナ病床をこれまでの237床から42床増加し、279床を確保した"@ja.
<< kg:id_56 prop:contermeasure kg:id_79 >>
    prop:text-txt_contents "地区医師会に所属している医師が電話診療などを実施するなどの体制も構築されております"@ja.
<< kg:id_56 prop:contermeasure kg:id_80 >>
    prop:text-txt_contents "地区薬剤師会に所属している薬剤師が患者の御自宅まで薬を届けているところです"@ja.
<< kg:id_81 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "上下水道料金の規模が事業規模を反映しているということを考えまして、上下水道料金を算定根拠とした支援をしてきた"@ja.
<< kg:id_83 prop:effect kg:id_84 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "商品券の印刷費用や商品券を販売する際の手数料、商品券から現金に換金する際の換金手数料など、キャッシュレス事業と比較をいたしますと、多くの事務経費が発生いたします"@ja.
<< kg:id_85 prop:effect kg:id_86 >>
    prop:text-txt_contents "ＰａｙＰａｙキャンペーンのほうが良かったと回答している方は、消費者の91.5％"@ja.
<< kg:id_85 prop:effect kg:id_87 >>
    prop:text-txt_contents "ＰａｙＰａｙキャンペーンのほうが良かったと回答している方は、事業者の89.7％"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "新型コロナウイルス感染症の影響等により、中食・外食事業者向けの販売数量が減少し、販売数量が伸びている小売事業者向けを合わせても減少となり、過剰な民間在庫になったことによるもの"@ja.
<< kg:id_88 prop:cause kg:id_90 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "国が主食用米の需要が１人当たりの消費量や人口減少等の影響により毎年約10万トン程度減少すると見込んでいる中"@ja.
<< kg:id_91 prop:effect kg:id_92 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "米農家は大変厳しい状況に直面しているものと認識しております"@ja.
<< kg:id_93 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "つや姫と酒米を除く主食用米の作付面積に対し、10アール当たり1,000円を補助するものでございます"@ja.
<< kg:id_95 prop:effect kg:id_96 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "子宮頸がんの原因の50から70％を占める２つのタイプのウイルス感染を防いで、子宮頸がんの発症を予防するとされているのが、このヒトパピローマウイルスワクチン"@ja.
<< kg:id_95 prop:effect kg:id_97 >>
    prop:text-txt_contents "ＨＰＶワクチン接種により、ヒトパピローマウイルス感染や子宮頸部の高度異形成、その予防効果が示され"@ja.
<< kg:id_95 prop:effect kg:id_98 >>
    prop:text-txt_contents "ＨＰＶワクチン接種により、ヒトパピローマウイルス感染や子宮頸部の高度異形成、その予防効果が示され"@ja.
<< kg:id_95 prop:effect kg:id_99 >>
    prop:text-txt_contents "ワクチンの有効性は10年以上の長期間持続することを示唆する結果が示されております"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:text-txt_contents "全国的にワクチン接種後の持続的な痛み"@ja.
<< kg:id_100 prop:cause kg:id_102 >>
    prop:text-txt_contents "しびれ"@ja.
<< kg:id_100 prop:cause kg:id_103 >>
    prop:text-txt_contents "脱力感"@ja.
<< kg:id_100 prop:cause kg:id_104 >>
    prop:text-txt_contents "不随意運動"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "積極的な勧奨はしていないものの、リーフレットを送付することで接種率は上昇をしている"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "本市としても、空白期間の対象者に対しては、今後示される国の方針等を踏まえて、適切に対応していきたい"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "この33名の方へのワクチン接種費用を本市独自で助成をしているところでございます"@ja.
<< kg:id_111 prop:effect kg:id_112 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "心身の発達、人間関係、勉強、進路にまで影響を及ぼしております"@ja.
<< kg:id_111 prop:effect kg:id_113 >>
    prop:text-txt_contents "心身の発達、人間関係、勉強、進路にまで影響を及ぼしております"@ja.
<< kg:id_111 prop:effect kg:id_114 >>
    prop:text-txt_contents "心身の発達、人間関係、勉強、進路にまで影響を及ぼしております"@ja.
<< kg:id_111 prop:effect kg:id_115 >>
    prop:text-txt_contents "心身の発達、人間関係、勉強、進路にまで影響を及ぼしております"@ja.
<< kg:id_111 prop:cause kg:id_116 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "近年、核家族化や高齢化、共働き、ひとり親世帯の増加といった家族構成の変化が背景にあるとされ"@ja.
<< kg:id_111 prop:cause kg:id_117 >>
    prop:text-txt_contents "核家族化や高齢化、共働き、ひとり親世帯の増加といった家族構成の変化が背景にある"@ja.
<< kg:id_111 prop:cause kg:id_118 >>
    prop:text-txt_contents "核家族化や高齢化、共働き、ひとり親世帯の増加といった家族構成の変化が背景にある"@ja.
<< kg:id_111 prop:cause kg:id_119 >>
    prop:text-txt_contents "核家族化や高齢化、共働き、ひとり親世帯の増加といった家族構成の変化が背景にある"@ja.
<< kg:id_111 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "本市では来年度以降も引き続き実態調査を実施していきたいと考えているところでございます"@ja.
<< kg:id_111 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "ポスター、リーフレットが令和４年１月に送付される予定となっておりますので、届き次第、学校・保育所をはじめとする教育・保育関係機関等はもちろんでございますけれども、障がい福祉や介護保険関係事務所等にも幅広く周知をしていきたい"@ja.
<< kg:id_122 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "子育て支援課内に子ども・家庭総合支援室が設置されていますが、こちらのほうの役割の１つが連絡調整になっております"@ja.
<< kg:id_124 prop:effect kg:id_125 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "コンビニエンスストアで、住民票や印鑑登録証明書等の取得ができる"@ja.
<< kg:id_124 prop:effect kg:id_126 >>
    prop:text-txt_contents "高齢者にとっては介護保険の申請"@ja.
<< kg:id_124 prop:effect kg:id_127 >>
    prop:text-txt_contents "ｅ－Ｔａｘなどの確定申告のときにも役立つ"@ja.
<< kg:id_124 prop:effect kg:id_128 >>
    prop:text-txt_contents "健康保険証としてマイナンバーカードを利用すれば"@ja.
<< kg:id_124 prop:effect kg:id_129 >>
    prop:text-txt_contents "正確なデータに基づきます診療や薬の処方が受けられる"@ja.
<< kg:id_124 prop:effect kg:id_130 >>
    prop:text-txt_contents "窓口での限度額以上の医療費の一定支払いが不要になる"@ja.
<< kg:id_131 prop:contermeasure kg:id_132 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "本市ではマイナンバーカードの出張窓口サービスを実施しております"@ja.
<< kg:id_133 prop:effect kg:id_134 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "長引くコロナ禍は本市観光産業にも大きな影響を与えているものと考えられます"@ja.
<< kg:id_135 prop:effect kg:id_136 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "生活様式の変化に対応して、３密を回避しやすい屋外、個人や家族など少人数でマイカーを利用した旅行が好まれるなど、観光スタイルにも変化が見られます"@ja.
<< kg:id_137 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "イーコマース電子商取引のサイトを稼働させることで、地域産品の販路の拡大やマーケティングなどを進めているところでございます"@ja.
<< kg:id_139 prop:contermeasure kg:id_140 >>
    prop:text-txt_contents "観光プロデューサーと市が連携して、教育旅行の誘致"@ja.
<< kg:id_139 prop:contermeasure kg:id_141 >>
    prop:text-txt_contents "新しいコンテンツの掘り起こし"@ja.
<< kg:id_139 prop:contermeasure kg:id_142 >>
    prop:text-txt_contents "ウィズコロナのツアー造成などを地域の観光関連事業者の皆様などと一緒に行っている"@ja.
<< kg:id_139 prop:contermeasure kg:id_143 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "体験型ツアーのニーズの高まりに応える、いわゆるアドベンチャーツーリズムといった新しいスタイルもぜひ提供していきたい"@ja.
<< kg:id_139 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "旅を丸ごと購入できる予約決済システムの地域内での活用について、今、勉強会などを進めている"@ja.
<< kg:id_145 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "コロナ禍でも実施可能なウェブによる情報発信"@ja.
<< kg:id_145 prop:contermeasure kg:id_147 >>
    prop:text-txt_contents "クルーズ再開を見据えた地域通訳案内士や英語ガイドの研修会の実施"@ja.
<< kg:id_145 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "台湾に対しては、年明け１月に県が実施するオンライン商談会に参加をして誘客を図る"@ja.
<< kg:id_145 prop:contermeasure kg:id_149 >>
    prop:text-txt_contents "台湾からの修学旅行の誘致にも努めていきたい"@ja.
<< kg:id_150 prop:cause kg:id_151 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "船会社により、埠頭内への高校生を含めた市民の立入りを禁止してほしいとの意向があったために、従来実施していた市民と触れ合うようなおもてなしを大幅に縮小した受入れを計画した"@ja.
<< kg:id_152 prop:contermeasure kg:id_153 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "フェースシールドやマスクの着用、消毒の徹底など、感染症予防対策を講じながら可能な範囲で参加できる機会を設けていきたい"@ja.
<< kg:id_154 prop:contermeasure kg:id_155 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "従来同様二十歳の方を対象として実施する予定でございます"@ja.
<< kg:id_154 prop:contermeasure kg:id_156 >>
    prop:text-txt_contents "酒田市成人式から、現段階では仮称でございますが、酒田市二十歳を祝う成人の集いと名称を変更しまして"@ja.
<< kg:id_157 prop:effect kg:id_158 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "親の同意がなくても契約することができるため、契約行為に十分な知識もない状態で契約をしてしまうおそれがございます。また、簡単に契約解除ができなくなる"@ja.
<< kg:id_159 prop:contermeasure kg:id_160 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "これまで同様に学校や各団体等からの要請があれば、積極的に出前講座を開催し、若年層が消費者被害に遭わないようにしっかりと注意喚起に努めてまいりたい"@ja.
<< kg:id_159 prop:contermeasure kg:id_161 >>
    prop:text-txt_contents "テレホン相談の「消費者ホットライン188（いやや）」の周知"@ja.
<< kg:id_162 prop:contermeasure kg:id_163 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "議員お尋ねのケースにつきましても利用は可能となっております"@ja.
<< kg:id_162 prop:contermeasure kg:id_164 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "御利用内容に対し御要望があれば、今後協議をしてまいりたい"@ja.
<< kg:id_165 prop:effect kg:id_166 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "市道の整備が進んでおらず、急カーブ・逆バンク道路、また、崖のほうに向かって傾斜している道路"@ja.
<< kg:id_165 prop:effect kg:id_167 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "高齢化によってもう限界だと"@ja.
<< kg:id_168 prop:cause kg:id_169 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "集落が飛び地となっており、ほかの地区と比べて配水池から末端までの距離が長いことから"@ja.
<< kg:id_168 prop:cause kg:id_170 >>
    prop:text-txt_contents "その給水能力は１時間当たり10立方メートルであり、１時間当たり60立方メートル以上が必要とされる消火栓の基準を満たしていない状況"@ja.
<< kg:id_168 prop:contermeasure kg:id_171 >>
    prop:text-txt_contents "市では、ほかの地区よりも平田小林地区に多くの防火貯水槽を設置し、有事の際に備えております"@ja.
<< kg:id_168 prop:contermeasure kg:id_172 >>
    prop:text-txt_contents "消防団の小型ポンプよりも軽量で１人でも持ち運びが可能な軽便ポンプを地元集会所に配備することにいたしました"@ja.
<< kg:id_173 prop:contermeasure kg:id_174 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "おおむね10センチ程度を超える降雪があった日を含めて３日間までを支給の対象としております"@ja.
<< kg:id_173 prop:effect kg:id_175 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "観測地点から離れた地域においては、作業実績と奨励金の支給に差があることにつきましては、私どもも一定程度認識"@ja.
<< kg:id_173 prop:cause kg:id_176 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "ここ数年、除雪協力者となる担い手が不足している状況にあり"@ja.
<< kg:id_173 prop:contermeasure kg:id_177 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "そういった民間事業者に活動していただけるような何か仕組みづくりができないか、これも検討していきたい"@ja.
<< kg:id_178 prop:contermeasure kg:id_179 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "酒田市史跡山居倉庫保存活用計画策定委員会は、今年の10月26日に立ち上げたものでございます"@ja.
<< kg:id_178 prop:contermeasure kg:id_180 >>
    prop:text-txt_contents "保存活用計画策定後の令和５年度に、山居倉庫の公有化と保存活用に係る具体的な整備計画の策定を進めまして"@ja.
<< kg:id_178 prop:contermeasure kg:id_181 >>
    prop:text-txt_contents "市民の皆様から御意見をお寄せいただくため、パブリックコメントの実施を予定しております"@ja.
<< kg:id_182 prop:effect kg:id_183 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "土地の形質の改変、建造物・工作物の新増改築、木や竹の伐採等の現状変更または保存に影響を及ぼす行為を行う場合には、文化庁長官の許可を受ける必要がございます"@ja.
<< kg:id_184 prop:contermeasure kg:id_185 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "本市でも、県の大綱を踏まえて、今年度から文化財保存活用地域計画の策定に向けての準備作業を進めてまいりたい"@ja.
<< kg:id_184 prop:contermeasure kg:id_186 >>
    prop:text-txt_contents "今年度から令和４年度までの２か年で、本市の国・県・市指定文化財の現況調査を行いまして、指定文化財の現況を確定させたい"@ja.
<< kg:id_184 prop:contermeasure kg:id_187 >>
    prop:text-txt_contents "その後、未指定文化財の調査等を行いまして、文化財保存活用地域計画の策定を進めてまいりたい"@ja.
<< kg:id_188 prop:contermeasure kg:id_189 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "本市としても、県の協議の推移を見守りながら、今後、本市の文化財保護活動にどのように関わっていただくか検討してまいりたい"@ja.
<< kg:id_190 prop:contermeasure kg:id_191 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "過去にあった酒田の出来事や文化を未来に伝える総合施設として、現在の資料館と光丘文庫に加えて、特定歴史公文書を公開する公文書館としての機能のほか、将来的には市史編さん事業を担う、仮称でございますが、文化資料館の整備を現在検討している"@ja.
<< kg:id_192 prop:contermeasure kg:id_193 >>
    prop:text-txt_contents "令和６年度に開館をしたいと予定を組んでおります"@ja.
<< kg:id_192 prop:contermeasure kg:id_194 >>
    prop:text-txt_contents "常設展示では、酒田の歴史が時系列で分かるようなものにしていきたい"@ja.
<< kg:id_195 prop:cause kg:id_196 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "当該発電所が稼働している現状においては、ゼロカーボンシティ宣言は考えていないところでございます"@ja.
<< kg:id_197 prop:contermeasure kg:id_198 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "再生可能エネルギーを地産地消する本市独自の宣言であります再エネ循環都市宣言、そういった宣言につなげていきたい"@ja.
<< kg:id_199 prop:contermeasure kg:id_200 >>
    prop:text-txt_contents "市直営の風力発電事業に取り組み、今年４月から運転を開始しております"@ja.
<< kg:id_199 prop:contermeasure kg:id_201 >>
    prop:text-txt_contents "山形県をはじめとする関係機関と洋上風力発電の導入に向けた要望や協議を重ね、今年度から酒田市沖での洋上風力発電に向けた検討が進められている"@ja.
<< kg:id_202 prop:contermeasure kg:id_203 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "来年以降、この区域施策編の策定を市として検討してまいりたい"@ja.
<< kg:id_204 prop:contermeasure kg:id_205 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "まずはＪ－クレジット制度について広報やホームページなど各種媒体により市民や市内企業への周知を進めたい"@ja.
<< kg:id_204 prop:contermeasure kg:id_206 >>
    prop:text-txt_contents "市が所有する施設の設備更新のとき、あるいは森林についてクレジット化が可能かどうかを検討してみたい"@ja.
<< kg:id_207 prop:effect kg:id_208 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "ＪＲ陸羽西線の存続が危うい状況にあると認識をしております"@ja.
<< kg:id_207 prop:cause kg:id_209 >>
    prop:text-txt_contents "令和２年度の利用状況が１日当たり163人となっております。ＪＲ東日本が発足した昭和62年度の2,185人に比較しますと、93％も減少している"@ja.
<< kg:id_207 prop:effect kg:id_210 >>
    prop:text-txt_contents "来年３月のダイヤ改正では、利用状況に合わせて一部の列車で酒田新庄間の直通運転を取りやめる"@ja.
<< kg:id_211 prop:cause kg:id_212 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "山形県はフル規格の奥羽・羽越新幹線整備を優先する方針を全面的に打ち出しているわけでございます。したがいまして、山形新幹線庄内延伸に向けたその活動はなかなか広がらずに限定的なものになっていた"@ja.
<< kg:id_211 prop:contermeasure kg:id_213 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "山形県も会員になっている、そしてより大きくかつ広範な組織であります山形県鉄道利用・整備強化促進期成同盟会、あるいは陸羽東西線利用推進協議会、この中でＪＲ陸羽西線の利便性向上や利用促進について積極的に活動すべきと判断"@ja.
<< kg:id_214 prop:effect kg:id_215 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "山形新幹線庄内延伸、これは庄内、最上、村山、置賜を貫く県土の一体的な発展につなげて"@ja.
<< kg:id_214 prop:effect kg:id_216 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "陸羽西線の廃線を防ぐ唯一の手だてであると、私は認識をしております"@ja.
<< kg:id_214 prop:contermeasure kg:id_217 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "庄内開発協議会の重要事業要望の中にもちゃんと盛り込んでありますので、これまでと全く変わらずに庄内地域を挙げて運動していきたい"@ja.
<< kg:id_214 prop:contermeasure kg:id_218 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "本市としては、ただ、この山形新幹線庄内延伸については手を下ろしたということは一切ありませんで、市の重要事業要望にも位置づけは変えておりません"@ja.
}
