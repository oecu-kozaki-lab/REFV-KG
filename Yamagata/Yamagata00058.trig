kg:id_152 rdfs:label "コロナ禍で厨房設計業者との調整やスタッフ訓練が未着手"@ja.
kg:id_152 rdf:type cls:c_1487.
cls:c_1487 rdfs:label "感染症影響"@ja.
kg:id_150 prop:cause kg:id_152.
kg:st_1 rdfs:label "進藤晃議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "感染対策を優先しつつ医療体制確立と地域経済の早期回復が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "ワクチン接種に収束への大きな期待が寄せられている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "油断できないため継続した感染対策が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "新しい生活様式への対応が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "デジタル技術が必要不可欠"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_6 prop:content "厳しい財源不足を想定して全事業を一件査定した"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "幅広い業種に長期間影響が及んでおり追加支援の検討が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "飲食業や宿泊業への追加支援が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "酒田フェアなどで食材の魅力発信と消費拡大を図るべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "感染防止を講じた観光行事の開催方法を検討すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "元のにぎわいを取り戻すのは難しいが工夫した開催を検討すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "受入れ体制整備と県や協議会との連携が必要"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "収束への大きな期待が寄せられている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "医療体制確立と地域経済回復を両立すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "地域経済の早期回復と併せて進めるべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "市民が安心して円滑に接種できる体制を目指す"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:st_3 rdfs:label "菊池裕基健康福祉部長"@ja.
kg:st_3 rdfs:type cls:st_34.
cls:st_34 rdfs:label "部局長"@ja.
kg:op_17 prop:content "市と県が連携して相談対応を行う"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "迅速で正確な情報周知を行う"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "適切な対応ができる体制を構築する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "消防本部と連携し万全を期す"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "交付金を活用し優先順位をつけて実施する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "コロナ禍での感染症対策は大変重要"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "ベッドやテントやパーテーションを整備し感染防止を図る"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "災害への備えと防災意識向上が必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "災害への備えと防災意識向上が必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "防災意識向上と国土強靭化による対策が必要"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "災害に備えることの重要性を改めて認識すべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "本市として取り組む必要がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "防災意識向上とあわせて必要"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "本市の連携した取組を進めるべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "流域治水プロジェクトと連携した本市の取組が必要"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "中長期的な計画の下で段階的な対策が必要"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "市街地浸水対策を進めるべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "可能なところから優先順位を見極めて対策を講じる"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "国の事業を活用して更新する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "まず浸水解消が急務な地域から進める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:st_4 rdfs:label "本多茂議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_37 prop:content "今まで経験したことのない被害として重く受け止めるべき"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "営農意欲を失わず次期作に向かえるよう支援する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "春作業への影響が懸念される"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "国が早期に具体策を示したことを評価する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "農協と協力しながら作業を進める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "全国から寄附を募り農家支援につなげる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "出荷できなくなった農産物の支援を行う"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "家事育児等のアンペイドワークへの家族や地域の理解協力が欠かせない"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "家庭地域職場の両面で見直しを促す必要がある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "女性が働きやすい職場環境づくりに一定の成果があった"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "会員増を図り職場環境づくりを進める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "若い世代を中心に家庭における意識啓発を図る"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "男性の働き方や家事育児参加の見直しを促す"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "制度内容とサンロクを活用した支援体制を明らかにすべき"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "事業者にも男性の働き方の見直しを啓発する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "市役所に来ることなくサービスを受けられるようにする必要がある"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "市民一人一人がデジタルによりつながることで幸せを感じていただけるようにしたい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "新たな価値が創造される"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "市民に優しいデジタル変革の推進内容を明確にすべき"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "市民全体のデジタル活用力を向上させたい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "誰一人取り残さない人に優しいデジタル変革を目指す"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "理解度に応じた個別学習と質の高い授業づくりを進める"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "サンロクを通じて企業支援を進める"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "データと科学的分析により土づくりを進める"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "利便性向上を図る"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "令和６年度以降に本市が進むべき姿を描く道しるべにする"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "山形県と庄内２市３町と大学が一緒に検討を進める必要がある"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "県と市が対等な立場で議論し早期公立化に努めるべき"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "２市３町と県と大学が一緒に進める必要がある"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "県との食い違いがないようしっかり向き合って話し合うべき"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_4.
kg:op_67 prop:content "高等教育機関におけるリカレント教育の重要性が増している"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:st_5 rdfs:label "江口暢子議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_68 prop:content "大学の意義を広めるためにも大人の学び直しを進めるべき"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_5.
kg:op_69 prop:content "地域ごとの取組の違いを踏まえた推進が必要"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_4.
kg:st_6 rdfs:label "村上幸太郎教育長"@ja.
kg:st_6 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_70 prop:content "本市の小中一貫教育の目的の一つである"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_6.
kg:op_71 prop:content "本市の小中一貫教育の目的の一つである"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_6.
kg:op_72 prop:content "小中学校間で情報交換を密にし注意深く見守る"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_6.
kg:op_73 prop:content "中１ギャップを含めた対応を進める"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_6.
kg:op_74 prop:content "子供たちを取り巻く環境変化が一因と捉える"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_6.
kg:op_75 prop:content "家庭で過ごす時間増加も影響している"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_6.
kg:op_76 prop:content "様々な要因が絡むため注意深く見守る必要がある"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_6.
kg:op_77 prop:content "小中学校間での情報共有を進める"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_6.
kg:op_78 prop:content "児童生徒に寄り添った対応を行う"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_6.
kg:op_79 prop:content "地域と学校が目標やビジョンを共有し総がかりで子供を育てる"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_6.
kg:op_80 prop:content "幅広い地域住民や団体が参画する体制をつくる"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_6.
kg:op_81 prop:content "コミュニティ振興会との関わりを明確にすべき"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_4.
kg:op_82 prop:content "３月中旬には全台数の納品完了見込み"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_6.
kg:op_83 prop:content "端末使用法や遠隔学習や学習支援ソフトの研修を進める"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_6.
kg:op_84 prop:content "日常でできそうなところから無理なく進める"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_6.
kg:op_85 prop:content "学校の実情に応じた弾力性ある対応が必要"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_5.
kg:op_86 prop:content "総合的かつ計画的な空き家対策を進めるべき"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_4.
kg:op_87 prop:content "第三者に危害を与える老朽空き家への対応が必要"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_4.
kg:op_88 prop:content "発生予防や適正管理や利活用や管理不全空き家対策を総合的に進める"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_2.
kg:op_89 prop:content "所有者や地域や関係団体と連携して進める"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_2.
kg:op_90 prop:content "危害が切迫した場合は市が必要最小限の応急措置を実施する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
kg:op_91 prop:content "官民一体となった取組を行う"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_2.
kg:op_92 prop:content "今後は感染対策を万全にして受入れ再開を成功させたい"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "これまでと異なる方法で受入れを行う必要がある"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
kg:op_94 prop:content "酒田港への寄港を積極的にアピールしている"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_2.
kg:op_95 prop:content "状況を勘案しながらポートセールスに工夫して取り組む"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_2.
kg:op_96 prop:content "酒田港の利用拡大につなげたい"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_2.
kg:op_97 prop:content "山形県と一体となって導入と基地港湾指定に向けた取組を進める"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_2.
kg:st_7 rdfs:label "関井美喜男議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_98 prop:content "県との連携を含め条件整備の詳細調査が必要"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_7.
kg:op_99 prop:content "成果を重視した見直しと財源確保が必要"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_2.
kg:op_100 prop:content "歳入が伸び悩む中で歳出が上回る構造にある"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_2.
kg:op_101 prop:content "極めて厳しい状況にある"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_2.
kg:op_102 prop:content "目的達成のため真に必要な経費を絞り込む"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_2.
kg:op_103 prop:content "成果の低い事業の廃止縮小や類似事業整理を進める"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_2.
kg:op_104 prop:content "公債費や維持管理費の縮減を図る"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_2.
kg:op_105 prop:content "攻めのふるさと納税で自主財源確保と事業者収益確保を図る"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_2.
kg:op_106 prop:content "地域未来創造基金などの造成は持続可能な財政基盤確立に向けた取組の一つ"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_2.
kg:op_107 prop:content "事業者募集の方法と更地管理を明確にすべき"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_4.
kg:op_108 prop:content "転売や乱開発を防止する"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_2.
kg:op_109 prop:content "地域住民に寄り添った対応が必要"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_4.
kg:op_110 prop:content "地方移住の機運の高まりを逃さないよう進める"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_2.
kg:op_111 prop:content "グランドオープンは10月上旬予定"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "昨年１月、日本で初めて新型コロナウイルスへの感染者が確認されて以来、爆発的な感染力により日本全国に広がりを見せていた"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "爆発的な感染力により日本全国に広がりを見せていた感染者数"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "感染者数もようやく減少傾向にあります"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "油断するとリバウンドの可能性が高くなる"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "新型コロナウイルスの影響により私たちの生活は一変し"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "感染リスクを低減するため人との距離を一定程度保つことやマスクの着用、手指消毒、部屋の換気など、新しい生活様式が求められています"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "コロナ禍による市税の減収"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "回答がありました615社のうち73.5％に当たる452社が経営に影響が生じていると回答しており、新型コロナウイルス感染症の拡大は、多くの幅広い業種に長期間にわたり影響が及んでいる"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "庄内地域で新型コロナウイルスの感染者が増加した年末以降、お酒の席の自粛や忘新年会のキャンセルにより、飲食業と宿泊業では依然として経営が厳しい状況"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "コロナ禍の影響により会合や外食の自粛の影響から消費が伸び悩んだ"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "新型コロナウイルスの影響を受け、全国の観光地はにぎわいを失っています"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本市においても、昨年、酒田まつりや甚句流し、花火ショーなど全てのイベントが中止となっています"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "クルーズ船の寄港は、昨年全てキャンセルとなっています"@ja.
<< kg:id_1 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "本市においてもまもなく始まるワクチン接種に収束への大きな期待が寄せられています"@ja.
<< kg:id_1 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "今後も感染対策を優先しつつ、医療体制の確立と地域経済の早期回復を目指し"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "医療体制の確立と地域経済の早期回復を目指し"@ja.
<< kg:id_1 prop:contermeasure kg:id_18 >>
    prop:text-txt_contents "マスクの着用、手指消毒、部屋の換気など"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:text-txt_contents "マスクの着用、手指消毒、部屋の換気など"@ja.
<< kg:id_1 prop:contermeasure kg:id_20 >>
    prop:text-txt_contents "マスクの着用、手指消毒、部屋の換気など"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "市が設ける施設で土曜日や日曜日、祝日に実施する集団接種とそれからかかりつけ医の診療所での個別接種を組み合わせる"@ja.
<< kg:id_1 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "昨日３月１日には、市民の皆様からの一般的な相談に対応するためのコールセンターも設置をした"@ja.
<< kg:id_1 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "ホームページや酒田市のＬＩＮＥの公式アカウント、それからツイッター、市の広報など、その時点で最も有効な方法を活用してできるだけ迅速に正確な情報を周知してまいりたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "必要な医療器材や医薬品を配置して、適切な対応ができる体制をしっかり構築していきたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "酒田地区広域行政組合消防本部とも救急搬送体制の連携を進めている"@ja.
<< kg:id_1 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "公共施設の感染防止対策ですとか、行政サービスのデジタル化といったもの"@ja.
<< kg:id_1 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "避難所においての新型コロナウイルス感染症への感染を防止するための運用マニュアルとして、酒田市避難所等開設にかかる新型コロナウイルス感染症対策を設けております"@ja.
<< kg:id_1 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "段ボールや折りたたみ等の利用者のニーズに応じたベッド、それから多機能型のテント、間仕切りパーテーション等の避難所資機材の充実も図っている"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "本市においても豪雨や暴風雪による被害が発生している"@ja.
<< kg:id_31 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "本市においても豪雨や暴風雪による被害が発生している"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "去る２月13日には宮城・福島県沖を震源とする地震が発生し、本市でも震度４の強い揺れを観測しています"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "改めて、日頃から災害に備えることの重要性を認識するとともに"@ja.
<< kg:id_34 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "防災意識の向上と国土強靭化よる本市の対策にも取り組む必要がある"@ja.
<< kg:id_34 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "国土強靭化よる本市の対策にも取り組む必要がある"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:text-txt_contents "昨年７月の豪雨により最上川で甚大な被害が発生した"@ja.
<< kg:id_38 prop:effect kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "最上川で甚大な被害が発生した"@ja.
<< kg:id_38 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "最上川流域治水協議会を設置し、流域治水プロジェクトを計画的に推進するとしています"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "昨年の９月４日の朝に記録的な大雨から道路の冠水や家屋の浸水など、内水氾濫が発生しています"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "道路の冠水や家屋の浸水など、内水氾濫が発生しています"@ja.
<< kg:id_42 prop:cause kg:id_45 >>
    prop:text-txt_contents "排水能力が追いつかないほどの雨が短時間に集中して降ったものと思われます"@ja.
<< kg:id_46 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "錦町地区や豊里地区においては、浸水解消に向けたポンプ能力の増強等を予定をしている"@ja.
<< kg:id_46 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "富士見町地区や京田一丁目ポンプ場において老朽化したポンプ施設の更新"@ja.
<< kg:id_46 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "平成28年度から高砂地区において、幹線となる雨水排水施設の整備をはじめ"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "こうした例年にない暴風雪によりまして、浜中や袖浦地区を中心に、800棟を超えるパイプハウスの損壊"@ja.
<< kg:id_50 prop:effect kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "800棟を超えるパイプハウスの損壊"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "出荷予定の農作物の被害など、甚大かつ深刻な被害を受けた"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "農業用ハウスの導入支援などが具体的に示された"@ja.
<< kg:id_55 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "国や県の対策を最大限活用できるよう農協と協力しながら作業を進めている"@ja.
<< kg:id_55 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "被害のあった農家支援のため、本市では、ふるさと納税を活用したガバメントクラウドファンディングに取り組んでおり"@ja.
<< kg:id_55 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "出荷できなくなった農産物を市職員有志で購入するなどの取組も行っている"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "依然として家事育児においては女性の負担が大きくなっており"@ja.
<< kg:id_60 prop:cause kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "性別による固定的役割分担意識などをテーマにした出前講座を実施"@ja.
<< kg:id_63 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "女性活躍推進法の一般事業主行動計画策定企業への支援などに取り組んでおり"@ja.
<< kg:id_63 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "日本一女性が働きやすいまち宣言に賛同するリーダーの会の立ち上げ"@ja.
<< kg:id_63 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "時短家事セミナーを開催し"@ja.
<< kg:id_63 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "男性向けの意識啓発セミナー等に加えて"@ja.
<< kg:id_63 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "えるぼし認定を支援する奨励金制度を創設するとしており"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "男性社員が子供の出生時に連続して30日以上育児休業等を取得した場合、その事業所に対して奨励金を交付する制度"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "その大きなきっかけとなったのは、実はコロナ禍で国が行った特別定額給付金のオンライン手続でございました"@ja.
<< kg:id_71 prop:effect kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "手続をオンライン化することで、時間や場所の問題を解決をし"@ja.
<< kg:id_71 prop:effect kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "幅広い分野においてデジタル技術の活用が進んで多くの利用者の利便性が向上する"@ja.
<< kg:id_71 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "昨年10月１日にデジタル変革戦略室を設置をいたしました"@ja.
<< kg:id_71 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "市民向けスマートフォン活用セミナーの開催など、市民全体のデジタル活用力を向上させる施策"@ja.
<< kg:id_71 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "音声で操作できるですとか、キーボードとかマウスを操作する必要がない使いやすい機器ですとか、方法によるサービスの提供"@ja.
<< kg:id_71 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "ＧＩＧＡスクールで整備するタブレット端末等を活用して、理解度に応じた個別学習や酒田市教育研修センターでの質の高い授業づくりを行う"@ja.
<< kg:id_71 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "産業振興まちづくりセンター、サンロクが行う地元企業のデジタル化を図る事業"@ja.
<< kg:id_71 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "データと科学的分析により土づくりを行うデジタル農業の事業"@ja.
<< kg:id_71 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "定期船とびしまの乗船予約システムとキャッシュレス決済の導入"@ja.
<< kg:id_71 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "三本柱としている住民サービス、地域、行政、それぞれのデジタル変革に取り組むことにより、令和６年度以降に本市が進むべき姿を描く道しるべ"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "東北公益文科大学を将来にわたり存続させるために"@ja.
<< kg:id_83 prop:effect kg:id_85 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "県より検討組織の設立準備について一旦停止するとの連絡があった"@ja.
<< kg:id_83 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "庄内広域行政組合の枠組みで公立化に向けた議論・検討を進めていく"@ja.
<< kg:id_83 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "大学の設置団体であります山形県と庄内の２市３町で東北公益文科大学の将来像に関して協議を開始した"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "人生100年時代を見据えて、様々な年齢や経験を持つ学生が相互に刺激を与えながら切磋琢磨するキャンパスを実現するためには、多様な年齢層の多様なニーズを持った学生に教育できる体制が必要"@ja.
<< kg:id_88 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "履修証明プログラムや山形県立産業技術短期大学校庄内校で実施する社会人向け公開講座の受講料などの一部に対して１人当たり3,000円を下限として、対象費用の２分の１を補助する"@ja.
<< kg:id_91 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "令和４年度からの完全実施に向けて"@ja.
<< kg:id_91 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "本市の小中一貫教育の目的、これは生徒指導の充実と学力の向上、この２つを掲げている"@ja.
<< kg:id_91 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "本市の小中一貫教育の目的、これは生徒指導の充実と学力の向上"@ja.
<< kg:id_95 prop:effect kg:id_96 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "今年度はちょっと異例なデータになっておりまして、小学校のほうで微増"@ja.
<< kg:id_95 prop:effect kg:id_97 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "中学校では減少している"@ja.
<< kg:id_95 prop:cause kg:id_98 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "新型コロナウイルス感染症拡大による一斉休業に伴いまして、子供たちを取り巻く環境が変化した"@ja.
<< kg:id_95 prop:cause kg:id_99 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "ゲーム、インターネットに熱中するとか、そういう意味で生活リズムが乱れがちになった"@ja.
<< kg:id_95 prop:cause kg:id_100 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "コロナ禍の中での集団生活、学校生活への不安も一因"@ja.
<< kg:id_95 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "中学校の教員やスクールカウンセラーが小学校６年生の不登校の子供さんの情報を得たりするために、積極的に小学校を訪問"@ja.
<< kg:id_95 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "スクールカウンセラーが家庭訪問相談員と一緒に児童の家庭訪問を実施"@ja.
<< kg:id_103 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "学校運営協議会というのが設置される学校"@ja.
<< kg:id_105 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "この地域学校協働活動を推進していくためには、今後は、地域学校協働本部を立ち上げる必要があります"@ja.
<< kg:id_105 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "コミュニティ振興会の関わりなくしては進めることはできない"@ja.
<< kg:id_108 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "ＧＩＧＡスクール用端末7,153台の全校への納品状況は順調に進んでおりまして"@ja.
<< kg:id_108 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "端末の使用法や遠隔学習の実施の方法、学習支援ソフトの使い方などについて研修をしている"@ja.
<< kg:id_108 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "まず日常でできそうなところ、そこから使っていくと、まず使っていくということが私は大事"@ja.
<< kg:id_108 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "学校が主体的にここまではやれそうだ、ここまでは難しいから、ちょっと先生方集まって話し合おうとか"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "人口減少、少子高齢化、核家族化や都市部への人口流出などにより空き家が増加し"@ja.
<< kg:id_113 prop:cause kg:id_115 >>
    prop:text-txt_contents "人口減少、少子高齢化、核家族化や都市部への人口流出などにより空き家が増加し"@ja.
<< kg:id_113 prop:cause kg:id_116 >>
    prop:text-txt_contents "人口減少、少子高齢化、核家族化や都市部への人口流出などにより空き家が増加し"@ja.
<< kg:id_113 prop:cause kg:id_117 >>
    prop:text-txt_contents "人口減少、少子高齢化、核家族化や都市部への人口流出などにより空き家が増加し"@ja.
<< kg:id_113 prop:effect kg:id_118 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "適正に管理されず、周辺へ悪影響を及ぼす事案が生じており"@ja.
<< kg:id_113 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "４月１日からの計画実施に向けて、今年度、酒田市空き家等対策計画を策定"@ja.
<< kg:id_113 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "具体的には、相談体制の整備、適切な管理の促進"@ja.
<< kg:id_113 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "管理不全空き家及び特定空家等への対応"@ja.
<< kg:id_113 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "空き家の利活用などの対策を実施する"@ja.
<< kg:id_123 prop:cause kg:id_124 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "昨年は11回の寄港が予定されておりましたけれども、新型コロナウイルスの影響によりまして全て中止"@ja.
<< kg:id_125 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "庄内保健所を含めた関係機関で受入れについて協議を行っております"@ja.
<< kg:id_125 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "オンラインで行われた国際的なクルーズ商談会に参加をし、酒田港への寄港を積極的にアピール"@ja.
<< kg:id_128 prop:cause kg:id_129 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "ポートセールスや航路誘致などの活動については、昨年は新型コロナウイルスの影響により大幅に活動が制限"@ja.
<< kg:id_128 prop:effect kg:id_130 >>
    prop:text-txt_contents "前年同期と比較しますと2,250ＴＥＵ、10.8％減っている"@ja.
<< kg:id_131 prop:contermeasure kg:id_132 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "中国との貿易に意欲のある企業を募って商談会を開催し、酒田港の利用拡大につなげていきたい"@ja.
<< kg:id_133 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "新たに酒田沿岸地域検討部会を設置することが決まった"@ja.
<< kg:id_133 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "基地港湾の早期指定に向けた取組を進めていきたい"@ja.
<< kg:id_136 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "市税の減収"@ja.
<< kg:id_136 prop:cause kg:id_137 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "普通交付税の合併算定替えの終了等"@ja.
<< kg:id_136 prop:cause kg:id_138 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "社会保障制度の充実に伴う費用の増加などにより歳出が歳入水準を上回る構造"@ja.
<< kg:id_136 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "全ての事業について一件査定を行った"@ja.
<< kg:id_136 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "事務事業の見直しがあり、これは行政評価を活用して所期の目的を達成した事業や成果の低い事業の廃止・縮小、類似する事業の整理"@ja.
<< kg:id_136 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "投資事業の規模を抑制するなどして、後年度の経常経費に含まれることになる公債費や維持管理費の縮減を図る"@ja.
<< kg:id_136 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "これまで以上の取組を行う姿勢を示すため、攻めのふるさと納税と表現"@ja.
<< kg:id_136 prop:contermeasure kg:id_143 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "風力発電事業の収益による地域未来創造基金などの造成は持続可能な財政基盤の確立に向けた取組"@ja.
<< kg:id_144 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "全国を対象に事業者募集をしていきたい"@ja.
<< kg:id_144 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "転売や乱開発を防止するために売却をしないで、事業用の定期借地権を設定し、設定した期間において市が事業者に土地を有償で貸し付ける"@ja.
<< kg:id_144 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "事業着手するまでの飛砂対策等、砂利を敷いたり、飛砂防止ネットを敷いたりということになりますが、この飛砂対策等を行う予定"@ja.
<< kg:id_148 prop:contermeasure kg:id_149 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "移住者向け住宅と地域交流拠点を整備・運営する事業者を募集している"@ja.
<< kg:id_150 prop:effect kg:id_151 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "プレオープンを見送ることとなっております"@ja.
<< kg:id_150 prop:cause kg:id_152 >>
    prop:text-txt_contents "コロナ禍のために首都圏の厨房設計業者との調整を進めることができず、スタッフトレーニングの実施と厨房のオペレーティングの習熟が未着手"@ja.
}
