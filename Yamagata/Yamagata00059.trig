    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "日本一女性が働きやすいまちの実現といたしまして、女性活躍推進事業、結婚推進支援事業が拡充され"@ja.
<< kg:id_50 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "男女共同参画推進事業、病児・病後児保育事業の継続や"@ja.
<< kg:id_50 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "男女共同参画推進事業、病児・病後児保育事業の継続や"@ja.
<< kg:id_50 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "えるぼし認定企業を増やすための奨励金制度の創設"@ja.
<< kg:id_56 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "防災対策強化事業として、女性の視点に立った防災体制強化のための予算計上も行っております。"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "本年度より開園するみなと保育園の運営は、働く保護者の支援にもつながるものと思われます。"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "市民にやさしいデジタル変革の推進といたしまして、令和２年に設置したデジタル変革戦略室の事業を実行するため、デジタル変革事業の予算計上がされております。"@ja.
<< kg:id_62 prop:effect kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "酒田市と研究教育機関として東北公益文科大学とＮＴＴデータ、ＮＴＴ東日本との産官学の連携は、加速度的にデジタル変革が推し進められると期待するものであります。"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "民間企業が欲するＩＴ人材のマッチングや育成する事業、市内企業のデジタル変革を支援する事業予算も組み込まれております。"@ja.
<< kg:id_64 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "市内企業のデジタル変革を支援する事業予算も組み込まれております。"@ja.
<< kg:id_67 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "加えて、デジタルが苦手な市民の方にも丁寧に対応していくとの答弁をいただいたところであります。"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "令和３年度の予算は、コロナ禍による歳入の減少と感染拡大予防対策費や経済支援対策、景気刺激策を講じるための財源確保のため、より一層厳しい財政運営が求められると思われます。"@ja.
<< kg:id_69 prop:cause kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "コロナ禍による歳入の減少と感染拡大予防対策費や経済支援対策、景気刺激策を講じるための財源確保のため"@ja.
<< kg:id_72 prop:effect kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "より一層厳しい財政運営が求められると思われます。"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "社会的手助けが必要な市民の皆様への支援や災害対応予算、子育てにも配慮した予算措置を行っていると感ずるところです。"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "ふるさと納税が好調であり"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "令和３年度より本格的に風力発電事業による売電収入が入ってまいりますが"@ja.
<< kg:id_80 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "各種補助制度の活用"@ja.
<< kg:id_80 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "未利用財産の売却や利活用を積極的に行っていただきたいと思います。"@ja.
<< kg:id_80 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "未利用財産の売却や利活用を積極的に行っていただきたいと思います。"@ja.
<< kg:id_69 prop:effect kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "コロナ禍により将来が見通せない状況ではありますが"@ja.
<< kg:id_85 prop:effect kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "多くの分野にデジタル変革の要素が加わることで、より効果的・効率的に行政サービスを行えること"@ja.
<< kg:id_85 prop:effect kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "民間企業のデジタル対応化の促進につながるものと考えます。"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "感染症に対応するためのデジタル変革ですが、新しい形態を進めるに当たり、初期投資はかかるものです。"@ja.
<< kg:id_90 prop:effect kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "将来、酒田市は、デジタルを取り入れた先駆的な自治体の一つとなる可能性を秘めております。ぜひともデジタル活用のトップを目指していただきたいとエールを送ります。"@ja.
<< kg:id_38 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "本市では、山形県・酒田市病院機構、酒田地区医師会十全堂などの皆様の連携により、ワクチン接種が始まります。"@ja.
<< kg:id_38 prop:effect kg:id_93 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "いまだ流行の収束が見えず、私たちの社会生活や経済活動に大きな影響を及ぼしていることを、改めて全国民が認識せざるを得ない事態であります。"@ja.
<< kg:id_94 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "県内でも新型コロナウイルスのワクチン接種が医療従事者を対象に始まりました。"@ja.
<< kg:id_94 prop:effect kg:id_96 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "順次対象者が拡大される予定とはなっておりますが、明確なスケジュールはまだ示されておらず、収束までの道のりはまだまだ遠く感じられます。"@ja.
<< kg:id_97 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "予算案は、まさにウィズコロナ、アフターコロナ時代を見据え、地域再生に向けて、新型コロナウイルス感染症への対応と地域経済活性化の両立を図りながら、持続可能な地域社会の構築を目指すものとなっております。"@ja.
<< kg:id_99 prop:effect kg:id_100 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "市長が施政方針に掲げた取り組む施策や事業の進め方、成果が、その独創性や先駆性において酒田モデルと評価されることを目指すとした意気込みが十分に感じ取られます。"@ja.
<< kg:id_69 prop:effect kg:id_101 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "歳入面では、コロナ禍の影響で市税の減額や"@ja.
<< kg:id_102 prop:effect kg:id_103 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "合併算定替えによる普通交付税の減額が見込まれる厳しい財政状況"@ja.
<< kg:id_104 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "財源不足は好調に推移しているふるさと納税寄附金を大幅に伸ばし"@ja.
<< kg:id_104 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "各種基金も令和２年度以上に取り崩す内容とはいえ"@ja.
<< kg:id_104 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "国・県の補助制度等を存分に活用し"@ja.
<< kg:id_108 prop:effect kg:id_109 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "厳しい財政状況の中で新たな投資事業に取り組むとはいえ、健全財政の維持をしっかりと意識した予算編成と評価するものであります。"@ja.
<< kg:id_110 prop:effect kg:id_111 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "ただし、基金の残高も減っております。基金活用も限界に来ていると感じられます。"@ja.
<< kg:id_112 prop:cause kg:id_113 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "国・県の補助制度を活用するためには、国・県との良好な連携関係が何より重要でありますので"@ja.
<< kg:id_38 prop:effect kg:id_114 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "本来なら、世界の人々が日本に集い、大きなにぎわいを期待する年度でありますが、いまだ新型コロナウイルス感染症収束のめどが立たず、先の見えない不安定な情勢となっております。市政運営に今後とも少なからず影響を及ぼすものと危惧されます。"@ja.
<< kg:id_115 prop:cause kg:id_116 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "一昨年の消費税増税以降、日本経済は低迷している。"@ja.
<< kg:id_115 prop:cause kg:id_117 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "新型コロナウイルス感染症拡大が追い打ちをかけ、多くの国民に影響が出ており"@ja.
<< kg:id_115 prop:effect kg:id_118 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "フリーランスや中小企業は事業継続が困難になっている。"@ja.
<< kg:id_115 prop:effect kg:id_119 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "今、対策を打たなければさらなる廃業・倒産を招き、地域の雇用が失われてしまう。"@ja.
<< kg:id_115 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "ついては、経済情勢が好転するまでの間、消費税を５％以下に引き下げるよう国に意見書を提出されたい"@ja.
<< kg:id_121 prop:cause kg:id_122 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "コロナ禍の中、感染防止対策で学校でも身体的距離の確保が重要だが"@ja.
<< kg:id_121 prop:effect kg:id_123 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "40人学級の教室では密集状態となっており"@ja.
<< kg:id_121 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "これを避けるには30人学級を早急に実現し、20人学級を展望する必要がある。"@ja.
<< kg:id_121 prop:cause kg:id_125 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "もともと学校は、一人一人の子供とじっくり向き合い、悩みに耳を傾け、個別の指導をすることが大切であり"@ja.
<< kg:id_121 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "ついては、文教関係予算を増額し、30人学級実現に向けて踏み出すよう国に意見書を提出されたい"@ja.
<< kg:id_127 prop:cause kg:id_128 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "2020年の新型コロナウイルスによるパンデミックは、日本国内でも経済活動や国民生活に深刻な影響を及ぼし"@ja.
<< kg:id_127 prop:effect kg:id_129 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "医療介護提供体制には過重な負荷がかかり、国民のいのちと健康が脅かされる事態が現実のものとなっている。"@ja.
<< kg:id_127 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "医療、介護、福祉、ウイルス研究等に十分な財源確保を行うこと"@ja.
<< kg:id_127 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "地域の実情や住民の声を踏まえた医療提供体制の充実を図ること"@ja.
<< kg:id_127 prop:contermeasure kg:id_132 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "良質で安全・安心の医療・介護提供体制を確保するため、医師・看護師・医療技術職・介護職等を大幅に増員すること"@ja.
<< kg:id_127 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "保健所の増設、保健師等の増員など公衆衛生行政の拡充を図ること"@ja.
<< kg:id_127 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "併せて検査・検疫体制などを強化・拡充すること"@ja.
<< kg:id_127 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "社会保障に関わる国民負担は必要最小限とすることについて国に意見書を提出されたい"@ja.
<< kg:id_136 prop:cause kg:id_137 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "新型コロナウイルスによる感染拡大は、経済活動や国民生活に深刻な影響を与えています。"@ja.
<< kg:id_136 prop:effect kg:id_138 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "医療・福祉等の提供体制にも過重な負荷がかかり、国民のいのちと健康が脅かされる事態となっています。"@ja.
<< kg:id_136 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "１、感染症対策に対応できるよう、医療、介護、福祉、ウイルス研究等に十分な財源確保を行うこと。"@ja.
<< kg:id_136 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "２、地域の実情や住民の声を踏まえた医療提供体制の充実を図ること。"@ja.
<< kg:id_136 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "３、安全・安心の医療・福祉等の提供体制を確保するため、医師、看護師、医療技術職、介護・福祉職等を増員すること。"@ja.
<< kg:id_136 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "４、保健所の増設・保健師等の増員など公衆衛生行政の拡充を図るとともに、検査・検疫体制などを強化・拡充すること。"@ja.
}
