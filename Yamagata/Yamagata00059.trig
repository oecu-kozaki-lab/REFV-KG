kg:st_1 rdfs:type cls:st_49.
cls:st_49 rdfs:label "議長"@ja.
kg:op_1 prop:content "犠牲者への哀悼と被災者への見舞いを表した"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "遺族や関係者の心情に哀惜の意を示した"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "松本国博議員"@ja.
kg:st_2 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_3 prop:content "国や県と連携し財政支援を活用して市政を進めるべきだと述べた"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "コロナ禍の影響を抑える手当てとして評価した"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "五十嵐英治議員"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_5 prop:content "ワクチン接種開始は収束へ向けた重要な動きだと述べた"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "コロナ禍の影響を抑える手当てとして評価した"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "コロナ禍の影響を抑える手当てとして評価した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "産業振興まちづくりセンターへの予算措置を評価した"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "回復に向けた事業として評価した"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "にぎわい創出への効果を期待した"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "周辺事業とあわせて地域の将来に寄与すると期待した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "地域のにぎわい創出につながると期待した"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "女性が働きやすいまちの実現に資すると評価した"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "企業と連携した女性活躍推進事業を前向きに評価した"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "働きやすいまちづくりの一環として評価した"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "継続的な取組として評価した"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "働く保護者支援につながると評価した"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "女性活躍推進の具体策として評価した"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "女性の視点を反映した防災体制強化を評価した"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "保護者支援に役立つと評価した"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "新しい流れを推進する攻めの予算だと評価した"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "官民学連携のデジタル変革事業を高く評価した"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "産官学連携によりデジタル変革の加速を期待した"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "民間企業のデジタル対応化促進につながると評価した"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "企業のデジタル対応化促進につながると評価した"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "デジタルが苦手な市民にも配慮する姿勢を評価した"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "厳しい財政運営が求められると指摘した"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "厳しい財政運営が求められる要因だと指摘した"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "厳しい状況下でも必要な支援予算を講じていると評価した"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "必要な市民に配慮した予算措置を評価した"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "今後も各種補助制度活用や未利用財産の売却利活用を進めるべきだと述べた"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "財源不足を補う重要な財源だと評価した"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "収支均衡への対応策をさらに進める必要があると述べた"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "積極的に行うべきだと述べた"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "国県との良好な連携が重要だと指摘した"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "積極的に行うべきだと述べた"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "積極的に行うべきだと述べた"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "その中でもデジタル変革を推進する予算だと評価した"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "多分野で効果的効率的な行政サービスにつながると述べた"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "民間企業のデジタル対応促進につながると述べた"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "将来の先駆的自治体化につながる可能性があると述べた"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "デジタル活用のトップを目指してほしいと求めた"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "収束を願い市民と協働し市民生活と経済活動を平時に戻すことを期待した"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "全国民が認識せざるを得ない事態だと述べた"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "対象拡大予定だが収束までの道のりは遠いと述べた"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "明確なスケジュールが示されていない点を懸念した"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "予算案はウィズコロナアフターコロナを見据えたものだと評価した"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "独創性や先駆性を高く評価した"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "厳しい財政状況でも積極姿勢を評価した"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "厳しい財政状況の一因だと指摘した"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "積極姿勢の表れとして評価した"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "攻めの姿勢として評価しつつ基金残高減少を懸念した"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "独創性と先駆性を発揮する前提として評価した"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "市債残高見込みの減少を含め健全財政を評価した"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "今後の市政運営で課題に対処すべきだと述べた"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "今後の市政運営でしっかり対処すべき課題だと指摘した"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:op_57 prop:content "先の見えない不安定な情勢が市政運営に影響すると危惧した"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_3.
kg:st_4 rdfs:label "総務常任委員会"@ja.
kg:st_4 rdfs:type cls:st_50.
cls:st_50 rdfs:label "委員会"@ja.
kg:op_58 prop:content "地方消費税は安定財源であり税率変更は妥当でないとして不採択とした"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_4.
kg:op_59 prop:content "地元企業負担増や社会保障維持の観点から不採択とした"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_4.
kg:op_60 prop:content "請願理由として示されたが委員会は不採択とした"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_4.
kg:op_61 prop:content "請願理由として示されたが税率変更は妥当でないと判断した"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_4.
kg:op_62 prop:content "地方自治体の安定財源や社会保障維持の面から妥当でないとした"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:op_63 prop:content "政府が35人学級導入に踏み切った中で30人学級は時期尚早として不採択とした"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_4.
kg:op_64 prop:content "請願理由として示されたが財源面から時期尚早と判断した"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_4.
kg:op_65 prop:content "30人学級への即時移行は時期尚早とした"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_4.
kg:op_66 prop:content "少人数学級の必要性は認めつつも30人学級は時期尚早とした"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_4.
kg:op_67 prop:content "財源を考慮すると時期尚早として不採択とした"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_4.
kg:st_5 rdfs:label "民生常任委員会"@ja.
kg:st_5 rdfs:type cls:st_50.
kg:op_68 prop:content "必要性を認め採択すべきものと決定した"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_5.
kg:op_69 prop:content "公衆衛生施策のさらなる拡充は重要な課題だとして採択した"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_5.
kg:op_70 prop:content "国に意見書を提出すべき内容として採択した"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_5.
kg:op_71 prop:content "国に意見書を提出すべき内容として採択した"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_5.
kg:op_72 prop:content "良質で安全安心の医療介護提供体制確保のため必要だとして採択した"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_5.
kg:op_73 prop:content "検査検疫体制強化とあわせ必要だとして採択した"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_5.
kg:op_74 prop:content "感染症対応のため必要だとして採択した"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_5.
kg:op_75 prop:content "国に意見書を提出すべき内容として採択した"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_5.
kg:st_6 rdfs:label "佐藤猛民生常任委員会委員長"@ja.
kg:st_6 rdfs:type cls:st_36.
kg:op_76 prop:content "医療介護福祉等の拡充が極めて重要だとして意見書を提案した"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_6.
kg:op_77 prop:content "提供体制の負荷軽減と体制強化が必要だとして提案した"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_6.
kg:op_78 prop:content "国民が安心して暮らせる社会実現のため反映を要望した"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_6.
kg:op_79 prop:content "意見書に反映すべき事項として要望した"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_6.
kg:op_80 prop:content "安全安心の提供体制確保のため必要だとして要望した"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_6.
kg:op_81 prop:content "公衆衛生施策強化のため必要だとして要望した"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_6.
