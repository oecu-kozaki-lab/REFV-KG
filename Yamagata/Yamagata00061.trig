kg:st_1 rdfs:label "冨樫覚議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "高い数値目標や思い切った政策が必要と考える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "酒田市地域創生部長"@ja.
kg:st_2 rdfs:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_2 prop:content "多様な視点の企業経営に必要な効果があるとみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "女性視点の商品開発は購買につながりやすいとみる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "花王酒田工場社長"@ja.
kg:st_3 rdfs:type cls:st_52.
cls:st_52 rdfs:label "企業管理者"@ja.
kg:op_4 prop:content "女性登用で職場改善が進み全員にとって働きやすくなった"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "東北エプソン株式会社"@ja.
kg:st_4 rdfs:type cls:st_53.
cls:st_53 rdfs:label "企業"@ja.
kg:op_5 prop:content "女性リーダーの職場は風通しがよい傾向にある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:op_6 prop:content "女性管理職登用の意義を含め意識啓発を図る"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "数値目標を盛り込む計画策定を促したい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "取組を進める企業を積極的に支援する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:st_5 rdfs:label "酒田市総務部長"@ja.
kg:st_5 rdfs:type cls:st_32.
kg:op_9 prop:content "管理職候補として必要な能力を身につける支援を継続する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_5.
kg:op_10 prop:content "意欲と能力を把握し人事配置を継続することが重要と考える"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:st_6 rdfs:label "酒田市健康福祉部長"@ja.
kg:st_6 rdfs:type cls:st_32.
kg:op_11 prop:content "現時点では本格接種の開始はまだできないとみる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_6.
kg:op_12 prop:content "本格接種開始時期を見通せない状況と説明する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_6.
kg:op_13 prop:content "想定期限までの全員接種は難しいと考える"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_6.
kg:op_14 prop:content "接種記録システム活用で接種状況を速やかに把握できる"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_6.
kg:op_15 prop:content "市民対応の迅速化につながると期待する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:op_16 prop:content "転出入者の接種状況把握にも有効と期待する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_6.
kg:op_17 prop:content "かかりつけ医への相談を促して対応する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_6.
kg:op_18 prop:content "国の指針に基づき適切に対応したい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_6.
kg:op_19 prop:content "不公平な取扱いとなるため導入は考えていない"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:st_7 rdfs:label "酒田市健康福祉部子ども・家庭支援調整監"@ja.
kg:st_7 rdfs:type cls:st_32.
kg:op_20 prop:content "接種していないことによる差別的扱いはあってはならない"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_7.
kg:op_21 prop:content "差別や誹謗中傷がないよう情報発信を行う"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_7.
kg:st_8 rdfs:label "松本国博議員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_22 prop:content "安全策の可視化を行政が手伝うべきと考える"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_8.
kg:op_23 prop:content "ステッカー表示の継続依頼を今後も行いたい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_7.
kg:op_24 prop:content "一律中止ではなく県方針に沿って安全に実施判断する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_7.
kg:op_25 prop:content "管理できる状態をつくることが重要と考える"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_7.
kg:st_9 rdfs:label "酒田市建設部長"@ja.
kg:st_9 rdfs:type cls:st_32.
kg:op_26 prop:content "公園の価値が再認識され重要性は高まっている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_9.
kg:op_27 prop:content "旅行宿泊飲食は特に厳しい状況にあると認識する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "12月以降の酒席自粛や忘新年会キャンセルで厳しい状況が続く"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:st_10 rdfs:label "支援を受けた事業者"@ja.
kg:st_10 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_29 prop:content "市の補助金は入金が早く助かった"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_10.
kg:op_30 prop:content "キャッシュレス導入で売上げが上向いた"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_10.
kg:st_11 rdfs:label "消費者"@ja.
kg:st_11 rdfs:type cls:st_54.
cls:st_54 rdfs:label "消費者"@ja.
kg:op_31 prop:content "再度のキャンペーン実施を要望する声が多い"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_11.
kg:op_32 prop:content "酒類小売業への支援を考えている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:st_12 rdfs:label "酒田市農林水産部長"@ja.
kg:st_12 rdfs:type cls:st_32.
kg:op_33 prop:content "主食用米需要減少の一番の起因は人口減少とみる"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_12.
kg:op_34 prop:content "中国向け輸出実現に向けて基準に合う米袋を検討している"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_12.
kg:op_35 prop:content "友好都市唐山市などへの輸出も考えたい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_12.
kg:st_13 rdfs:label "丸山市長"@ja.
kg:st_13 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_36 prop:content "ようやく前に進んだ段階であり引き続き県の動向注視が必要と考える"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_13.
kg:op_37 prop:content "年次的に実施し早期完全解体を引き続き要望する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_13.
kg:op_38 prop:content "地元の思い実現に向け県へ粘り強く要望する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_13.
kg:st_14 rdfs:label "酒田市企画部長"@ja.
kg:st_14 rdfs:type cls:st_32.
kg:op_39 prop:content "行政デジタル変革の余力を窓口対応に生かしたい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_14.
kg:op_40 prop:content "誰一人取り残さないデジタル変革を目指す"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_14.
kg:op_41 prop:content "デジタルに興味を持つ方を増やしたい"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_14.
kg:op_42 prop:content "民間事業者との連携も含め検討する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_14.
kg:op_43 prop:content "生活の中にデジタルを浸透させ便利さや楽しさを実感してもらいたい"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_14.
kg:op_44 prop:content "民間の力も借りながら支援を検討する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_14.
kg:op_45 prop:content "一義的目的は必要な方へのきめ細かな情報発信にある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_14.
kg:op_46 prop:content "発信に加えて手続窓口と広聴に活用したい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_14.
kg:op_47 prop:content "ワンクリックで予約可能にしたい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_14.
kg:st_15 rdfs:label "酒田市総務部危機管理監"@ja.
kg:st_15 rdfs:type cls:st_32.
kg:op_48 prop:content "常に高い防災意識を持ち続けられるようにする必要がある"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_15.
kg:op_49 prop:content "若者の防災意識の底上げが必要と考える"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_15.
kg:op_50 prop:content "令和３年度に女性防災リーダー育成に取り組む"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_15.
kg:op_51 prop:content "災害を自分のことと意識してもらえる取組を進める"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_15.
kg:op_52 prop:content "震度４を確認後に手動起動した"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_15.
kg:op_53 prop:content "要支援者避難支援と民生委員自身の命を守るためのツールにする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_15.
kg:op_54 prop:content "民生委員の命を守るツールとしても機能すると考える"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_15.
kg:op_55 prop:content "家庭で津波避難を話し合う契機にしてほしい"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_15.
kg:op_56 prop:content "簡易水洗の仮設トイレ配備体制を整えた"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_15.
kg:op_57 prop:content "東北初の災害応援協定で避難所や宿泊施設として活用できる"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_15.
kg:op_58 prop:content "防災意識を高める費用対効果の高い取組と考える"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_15.
kg:st_16 rdfs:label "江口暢子議員"@ja.
kg:st_16 rdfs:type cls:st_16.
kg:op_59 prop:content "中山間地の実情に応じたきめ細かな対応が必要と考える"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_16.
kg:op_60 prop:content "避難にためらいがある状況を踏まえた対応が必要"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_16.
kg:st_17 rdfs:label "酒田市教育長"@ja.
kg:st_17 rdfs:type cls:st_55.
cls:st_55 rdfs:label "教育職員"@ja.
kg:op_61 prop:content "地域の危険要素を知り自分の行動力を高めることを目指す"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_17.
kg:op_62 prop:content "端末持ち帰り時に家族の会議資料になることを期待する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_17.
kg:op_63 prop:content "避難所ごとに任せると混乱や対立が生じるおそれがある"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_15.
kg:op_64 prop:content "環境省や先進自治体を参考に明確なガイドラインを作成したい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_15.
kg:op_65 prop:content "規制や誘導措置など多角的議論があり見通しは不透明と認識する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_13.
kg:op_66 prop:content "地域で起こる構造変革をどう捉えるか議論を深めたい"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_13.
kg:op_67 prop:content "2050年を見据えた戦略方針をまとめたい"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_13.
kg:op_68 prop:content "地域の合意形成には丁寧な環境影響評価が重要と考える"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_13.
kg:op_69 prop:content "地域活性化に大きく寄与すると考える"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_13.
kg:op_70 prop:content "5,000キロワット風車１基当たり200万円程度の収入増を見込む"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_13.
kg:op_71 prop:content "国民負担軽減の一方で事業者意欲減退が懸念される"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_13.
kg:op_72 prop:content "県にまずこの初動を進めてもらう必要がある"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_13.
kg:op_73 prop:content "促進区域と基地港湾指定に向け県の手挙げが重要と考える"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_13.
kg:op_74 prop:content "地域の熱意をまとめ国に対する手続進展を早める活動を先導するのが市の役割"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_13.
kg:op_75 prop:content "全く影響が出ないとはならないと考える"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_13.
kg:op_76 prop:content "冷静な判断ができるよう支援したい"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_13.
kg:op_77 prop:content "風力に飲み込まれる漁業者ではなく漁業者主体の振興策が大事と考える"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_12.
kg:op_78 prop:content "漁業者が望むのであれば養殖も検討したい"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_12.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "女性管理職が増加しない要因として、大きくは４つの要因があると考えております。１つ目は、企業内での固定的役割分担意識による業務割当てが挙げられます。女性は男性の補助的な業務を行っていることが多く、キャリアアップにつながる研修機会等が男性に比べて少ない傾向にあること。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "２つ目は、女性は非正規雇用の割合が男性より高く、組織内での責任のある業務を行う経験が乏しいこと。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "３つ目は、管理職の長時間労働や転勤を前提とする働き方に女性がちゅうちょをすること。"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "４つ目として、３つ目とも関連しますが、家庭での家事育児などのアンペイドワークの多くは女性に偏っており、仕事と家庭の両立が困難となるため、女性が管理職への打診を断るということが言われている"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "管理職など意思決定の場に女性の視点が入ることで、これまでにない柔軟な発想がもたらされることが挙げられます。"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "消費者の半分を占めるのは女性であり、女性の欲しい商品やサービスの提供は、現在、日本企業の管理職の多くを占める男性よりも女性の視点で開発するほうが購買につながりやすい"@ja.
<< kg:id_6 prop:effect kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "花王酒田工場では、ラインリーダーに初めて女性を登用したことにより、これまで当たり前とされてきた環境に新しい視点が入り、使われる道具の並べ方など改善が進んだり、重い資材を運ぶサポート器具を使うようになるなど、高齢で体力が落ちたり、腰痛で悩んでいた男性社員も含めて全員にとって働きやすい職場になった"@ja.
<< kg:id_6 prop:effect kg:id_10 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "東北エプソン株式会社では、自由闊達で風通しのよい環境づくりに取り組んでいるが、女性リーダーの職場は優れてその傾向にあると、こういった調査結果も出されております。"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "本市としては、女性管理職の登用の意義も含め、まずは企業のトップの意識啓発を図るため、日本一女性が働きやすいまち宣言に賛同するリーダーの会を今年１月に立ち上げました。"@ja.
<< kg:id_11 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "さらに例えば女性管理職の登用率などを数値目標に盛り込む女性活躍推進法の一般事業主行動計画の策定を促していきたいと考えております。"@ja.
<< kg:id_11 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "そのような取組を進める企業には新設しました奨励金等により、市として積極的に支援を行ってまいります。"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "女性職員が幅広い職務を経験できるように、職場管理、人事組織管理であるマネジメント研修への積極的参加を促すなど、管理職の候補として必要な能力を身につけるための支援"@ja.
<< kg:id_15 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "今後も今まで同様、職員の意欲と能力の把握に努め、女性職員が幅広い職務を経験できるように、適材適所の人事配置を継続していくことが重要だと考えております。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "４月12日の週に１箱、約1,000回分、人数換算で500人分となります。それから４月26日の週に１箱で計２箱、約2,000回分、人数では1,000人分のワクチンが配分される予定となっております。しかし、これにつきましては、本市の想定しております高齢者の約3.8％の量であり、本格的な接種を開始することはまだできないものと捉えているところでございます。"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "現時点で５月以降のワクチンの配分時期や量が示されていないことから、本格的な接種が開始できる時期を見通すことができない状況でございます。"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "現時点では想定の７月20日までに接種を希望する全ての高齢者から接種いただくことは難しいものと考えているところでございます。"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "このシステムを活用することによりまして、各自治体が個人の接種状況等を速やかに把握することができることになります。"@ja.
<< kg:id_22 prop:effect kg:id_24 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "市民一人一人の接種状況等を把握することにより、市民からの問合せに迅速に対応できる"@ja.
<< kg:id_22 prop:effect kg:id_25 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "転出入者の接種状況の速やかな把握にもつながるものと期待をしているところでございます。"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:text-txt_contents "市町村では基礎疾患のある方を把握できないことから、該当すると思われる方は、事前に自らが接種前に申し出ていただき"@ja.
<< kg:id_26 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "該当すると思われる方は、事前に自らが接種前に申し出ていただき、予診を担当する医師が該当する基礎疾患であることを確認の上、接種するとされております。"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:text-txt_contents "接種するため希釈、この場合は生理食塩水で薄めることになりますけれども、この希釈した場合、６時間以内にそのバイアル分は接種しなければならないとなっております。"@ja.
<< kg:id_29 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "今後、国から示される指針に基づき、適切に対応してまいりたいと考えております。"@ja.
<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "健康上の理由などで接種を受けられない方には接種券が出ないとなりますと、不公平な取扱いとなること、また、国からも優遇策の導入には慎重な考え方が示されていることから、現時点では本市が接種した方への優遇策を導入することは考えていないところでございます。"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "新型コロナウイルスワクチンを接種していない者に対する、差別、いじめ、職場や学校等における不利益扱いなどは、決して許されないことを周知徹底することなどが附帯決議されております。"@ja.
<< kg:id_34 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "接種されない方が誹謗中傷など受けることないように、市ホームページや酒田市ＬＩＮＥ公式アカウント、ツイッター、市広報など、その時々で最も有効な方法を活用し、分かりやすい広報により市民に呼びかけてまいりたい"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "店舗それぞれの感染予防対策を行っている場合も表記はされておらず、情報の表示も「ある・なし」と様々であると感ずるところであります。"@ja.
<< kg:id_37 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "店舗が実施している感染対策の方法を表示するということは、このステッカーを表示するよう依頼を今後も継続してまいりたいと考えております。"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:text-txt_contents "一定の秩序を設けることができなかったり、不特定多数の方々の密集は当然避けるべきであり、明確な感染症対策ルールが必要と考えております。"@ja.
<< kg:id_40 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "山形県のイベント等の開催に関する基本方針があることから、これに沿った形で対応しながら進めてまいります。"@ja.
<< kg:id_40 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "主催者側が入場制限や指定席の設定といった対応をすることにより、事業全体をしっかりと管理できる状態をつくること"@ja.
<< kg:id_40 prop:contermeasure kg:id_44 >>
    prop:text-txt_contents "大人数での飲食・飲酒を行わないことが重要と考えているところでございます。"@ja.
<< kg:id_45 prop:cause kg:id_46 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "コロナ禍においても、心と体の健康を保つため、体を動かすなど屋外でリフレッシュすることも大切なことであり、そうした意味において、公園の価値が再認識され、その重要性は高まっている"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:text-txt_contents "新型コロナウイルスによる本市経済への影響について、本市と酒田商工会議所、酒田ふれあい商工会と連携しまして、新型コロナウイルスの影響に関するアンケート調査を４月、６月、12月と今まで３回実施しております。"@ja.
<< kg:id_47 prop:effect kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "業種別で弱いところでは、旅行、宿泊業、飲食業が、４月、６月、12月のいずれのアンケートでも、９割以上の事業者が経営に影響が生じていると回答をしております。"@ja.
<< kg:id_47 prop:effect kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "12月以降の酒席の自粛や忘新年会のキャンセルにより飲食業、宿泊業、タクシー業、運転代行業では依然として経営が厳しい状況となっていると理解をしております。"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "支援をした事業者からは、国や県の支援と比較すると、市の補助金は申請から入金までの期間が早いので助かった"@ja.
<< kg:id_51 prop:effect kg:id_53 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "あるいはキャッシュレス決済の導入により売上げが上向いてきているなどの声があった"@ja.
<< kg:id_51 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "消費者側のアンケートからは、ＰａｙＰａｙと連携したキャンペーンの再度の実施に対する要望が多く寄せられたところでございます。"@ja.
<< kg:id_55 prop:cause kg:id_56 >>
    prop:text-txt_contents "忘新年会や歓送迎会などの酒席の自粛により、ホテル、飲食業等に対して酒類を納入している一般酒類小売業の事業者への影響が大変大きく、かつ落ち込みが継続している"@ja.
<< kg:id_55 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "売上げが減少した主たる売上げが酒類である酒類小売業に対する支援を考えております。"@ja.
<< kg:id_58 prop:cause kg:id_59 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "主食用米の全国ベースでのこの数量というのはやはり一貫して減少しておりまして、毎年10万トン規模で減っているというこういう実情でございます。それから、このことは日本の人口減少が一番起因しておりますけれども"@ja.
<< kg:id_58 prop:cause kg:id_60 >>
    prop:text-txt_contents "日本人１人当たり米を１年間食べるのが、いわゆる昔は、昭和30年代の頃は２俵食べていたものが、今は１俵にも満たっておりません、54キログラムぐらいになっております。"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:text-txt_contents "令和２年度１月末の実績でございます。納入価格ベースで返礼品全体額が約7.5億円、これに対しまして米は約５億円ということで、全体額の７割弱"@ja.
<< kg:id_61 prop:effect kg:id_63 >>
    prop:text-txt_contents "農産物全体の額が約６億円、これに対して米は５億円ということで８割強"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:text-txt_contents "酒田産米を輸出するためには、中国当局から、米袋という米の袋なんですけれども、これを準備しなければいけないというのがあります"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "今まさに栄養成分分析とか、中国当局が求めている基準にのっとった形で米の袋を作れないかというのを検討しておるところでございます。"@ja.
<< kg:id_66 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "例えば本市と友好都市であります唐山市とか、ちょうど市長からも唐山の30周年の友好を祝う年だと聞いておりますので、それを目がけて、例えばそういったところに出せないかとか"@ja.
<< kg:id_66 prop:effect kg:id_69 >>
    prop:text-txt_contents "酒田港統計年報によりますと、令和元年度の米の輸出というのは330トンというので、５年前と比較しても６倍ぐらいになっている"@ja.
<< kg:id_70 prop:cause kg:id_71 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "旧酒田工業高等学校の全ての施設を解体するには４年以上かかるのではないかというのが県の見解でございました。"@ja.
<< kg:id_72 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "旧酒田工業高等学校の解体については、年次的に実施をしていただいて、可能な限り早期の完全解体を実現していただくように、引き続き県のほうには要望していきたい"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "解体後の跡地利用について、引き続き、旧酒田北高等学校も含めた跡地利用として、スポーツ及びコンベンション機能を有する公共的ホールの整備を県に粘り強く要望してまいりたい"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "本市のデジタル変革戦略における三本柱の一つでございます行政のデジタル変革、これで効率化されたことによる余力、こういったものを振り向けるなどして、窓口でのきめ細かな対応を心がけてまいりたい"@ja.
<< kg:id_76 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "例えば音声で操作できるなど、こういった使いやすい機器や方法によるサービスの提供なども検討してまいりたい"@ja.
<< kg:id_79 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "市民向けスマートフォン活用セミナーの開催など、あるいは民間事業者でも最近はスマホ教室ですとか携帯の安全教室ですとか、個別の出張講座などもやられているようです。"@ja.
<< kg:id_79 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "そういった民間事業者との連携も含めまして検討を行って、市民のデジタル力の向上に努めてまいりたい"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "デジタル技術を意識することなく利用できる、例えば今、洗面所の鏡ですとか部屋の電気、こういったものにＡＩ技術を搭載して、生活の中で見守りなどに活用する"@ja.
<< kg:id_82 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "何らかの諸事情で取り組めない方、そういった方につきましては、そういった理由を聞かせていただくような機会を設けまして、民間の力もお借りしながら、市としてどのような支援ができるのか検討してまいりたい"@ja.
<< kg:id_85 prop:effect kg:id_86 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "本市がＬＩＮＥを活用する一義的な目的というのは、やはり必要な方に必要な情報をお届けするというきめ細やかな情報発信でございます"@ja.
<< kg:id_85 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "次の段階といたしましては、発信に加えて、オンライン手続の窓口としての機能ですとか、広く市民の声を聴く広聴として、そういったツールとして活用していきたい"@ja.
<< kg:id_85 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "準備が整い次第、新型コロナウイルスワクチンの接種予約もこういったメインメニューのほうに追加をして、ワンクリックで予約が可能となるようにしてまいりたい"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "大きな災害が起これば一時的に防災への意識は高まるものの、やはり時間とともに薄れてしまうのが現状であります。"@ja.
<< kg:id_89 prop:cause kg:id_91 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "高齢者に比べますと若者の防災意識が低い傾向があり、自主防災活動アンケートでも、自主防災活動の参加者が固定化、高齢化している、自主防災活動に若者があまり参加していないという声が多数寄せられております。"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "令和３年度には女性防災リーダーの育成に取り組むこととしております。"@ja.
<< kg:id_92 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "防災に関する出前講座、逃げ地図づくり、マイ・タイムライン講習会、ＨＵＧの開催など、市として災害を自分のことと意識してもらえるような取組を積極的に進めていきたい"@ja.
<< kg:id_95 prop:cause kg:id_96 >>
    prop:text-txt_contents "酒田市で最終的に観測した震度は４ではありましたが、緊急地震速報では震度３として発信されたため、Ｊアラートは起動しなかった"@ja.
<< kg:id_95 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "今回の地震は市役所の勤務時間外であったため、消防本部の通信指令課職員が震度４を確認した上で、手動で防災行政無線を起動させた"@ja.
<< kg:id_98 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "各地域の避難行動要支援者を最も知る存在である民生委員の方々に防災ラジオを貸与し、災害情報をいち早く伝達することにより、可能な限りで地域の避難行動要支援者の避難支援を行っていただきたいという狙いがございます。"@ja.
<< kg:id_98 prop:effect kg:id_100 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "自身がすぐに逃げなければならないのか、または避難行動を支援する余裕があるのか、これを判断し、民生委員の命を守るためのツールとしても機能するものと考えております。"@ja.
<< kg:id_101 prop:contermeasure kg:id_102 >>
    prop:text-txt_contents "新しいハザードマップでは、津波が建物に衝突したときにせり上がる高さを考慮した水位、これ基準水位を採用いたしております。"@ja.
<< kg:id_101 prop:contermeasure kg:id_103 >>
    prop:text-txt_contents "津波予測の非確実性や東日本大震災での想定を超えた浸水を踏まえ、バッファゾーン、これについては酒田市が独自に設定した要避難区域でございますが、これをマグニチュード8.5の地震を想定した旧津波浸水想定区域をベースとして見直しております。"@ja.
<< kg:id_101 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "ハザードマップの裏側に津波の情報などを学べる防災学習情報面を新設いたしました。津波から命を守るために最低限必要なものを網羅しているので、市民の皆様にはぜひとも一読していただくとともに、家庭で津波からの避難について話し合う契機としていただきたい"@ja.
<< kg:id_101 prop:contermeasure kg:id_105 >>
    prop:text-txt_contents "新しいハザードマップでは、水害ハザードマップの手引きに定められているところの全国統一の基準の色合いを採用いたしております。これについては色弱の方にも見えやすい配色"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "令和２年度、市内の４業者と災害時における仮設トイレの設置協力に関する協定を締結しまして、災害時の簡易水洗の仮設トイレの配備の体制を整えております。"@ja.
<< kg:id_106 prop:contermeasure kg:id_108 >>
    prop:text-txt_contents "小中学校の避難所にベッドを、これは段ボールベッドや折り畳みベッド、いろいろでございますが、準備するとともに、更衣室用のポップアップテントの導入を進めているところでございます。"@ja.
<< kg:id_106 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "レスキューホテルと称するコンテナホテルを災害時に搬入、設置して、宿泊施設などとして活用する災害応援協定を来週23日火曜日に締結する予定でございます。"@ja.
<< kg:id_110 prop:effect kg:id_111 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "本訓練は密集することなく、地震発生直後に自らの身を守るための行動を短時間かつ手軽に確認、徹底できるものと考えております。"@ja.
<< kg:id_112 prop:cause kg:id_113 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "指定避難所まで一番遠い方では車でも10分以上かかることや、高齢の方が多く徒歩での避難は無理であるというお話もお聞きしました。"@ja.
<< kg:id_112 prop:cause kg:id_114 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "避難所自体が河川の合流点のそばにあり、近年の河川の災害状況を見れば、増水、越水等の安全性について不安が伴い、避難にためらいがある"@ja.
<< kg:id_115 prop:contermeasure kg:id_116 >>
    prop:text-txt_contents "全市的な防災ラジオによる防災個別受信体制を可能とし、中山間地を含め全市的な防災ラジオ普及を進めていきます。併せてエリアメッセージやホームページ、ＳＮＳなど緊急情報を多重化する"@ja.
<< kg:id_115 prop:contermeasure kg:id_117 >>
    prop:text-txt_contents "緊急避難場所については、市指定以外でも最寄りの自治会館や集会所等、災害の種類に応じて、安全であれば各地区において徒歩で避難できる範囲で設定していただくように指導をしております。"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "令和３年度は、電子版の防災ハンドブックの作成に取り組んでいく予定です。防災アドバイザーの専門知識、それからこれまで酒田に起きた災害についての資料、各教科の教科書等に掲載されている防災に関する学習内容を１つにまとめまして、子供たちが自分の地域の危険要素を知り、自分の行動力を高めていくことを目指しております。"@ja.
<< kg:id_118 prop:effect kg:id_120 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "その端末を家庭に持ち帰ったとき、子供だけでなくて家族でそのページを一緒に見ることができる、どこに避難しようとかという、家族の会議の資料になることも私は期待できるのかなと思っております。"@ja.
<< kg:id_121 prop:cause kg:id_122 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "避難所におけるペットの受入れについては、ペット飼育者と非飼育者との間に大きな温度差があると考えられ、対応をそれぞれの避難所に任せると混乱や対立が生じるおそれがあります。"@ja.
<< kg:id_123 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "明確なガイドラインを市で作成すべきであると考えております。今後、環境省や先進自治体のガイドラインを参考にしながら、本市の実情に沿ったガイドラインを作成していきたい"@ja.
<< kg:id_125 prop:cause kg:id_126 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "非効率石炭火力のフェードアウトに向けた具体的なロードマップが示されるものと考えるものの、規制あるいは誘導措置、地域の雇用等への影響を含めた配慮すべき事項など多角的に議論されておりまして、正直なところ、今後の見通し、これ実に、本当に不透明な状況"@ja.
<< kg:id_127 prop:contermeasure kg:id_128 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "新年度以降、産業界と行政が協力しながら、カーボンニュートラルの実現に向けた産業構造や社会構造の変革が今まさにこの地域で起ころうとしているということと、これを受けて、酒田市や庄内地域ではこの流れをどのように捉えて考えていくべきか、そのきっかけ、議論を深めるようなそういった取組をまずは進めていきたい"@ja.
<< kg:id_127 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "2050年を見据えた酒田市の取組方針等についてはしっかり議論をし、戦略、方針をまとめていきたい"@ja.
<< kg:id_130 prop:effect kg:id_131 >>
    prop:text-txt_contents "遊佐町沖への洋上風力発電導入について関係者間で一定の合意形成が図られたことを受けまして、令和２年２月に、山形県は国へ遊佐町沖に係る法定協議会の設置を要請したところでございます。山形県の要請を受けて、令和２年７月３日、経済産業省、国土交通省の両省は、遊佐町沖を一定の準備段階に進んでいる区域として整理をした"@ja.
<< kg:id_132 prop:cause kg:id_133 >>
    prop:text-txt_contents "送電網については、既に東北電力ネットワーク株式会社は民間事業者に対し、電力系統接続に関する回答を行い、現在、民間事業者において事業検討が進められている状況"@ja.
<< kg:id_134 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "地域の合意形成を図るためには、景観や環境への懸念事項について、民間事業者が丁寧に環境影響評価を実施し環境負荷の低減に努めることが重要である"@ja.
<< kg:id_136 prop:effect kg:id_137 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "酒田市沖への洋上風力発電事業の導入、そして、基地港湾への指定によって、実は港湾の整備あるいは発電設備などの施工、施工後の運転、保守による直接的な経済効果"@ja.
<< kg:id_136 prop:effect kg:id_138 >>
    prop:text-txt_contents "建設資材や原材料の取引の増加、さらには関連産業の立地による第１次的な経済波及効果"@ja.
<< kg:id_136 prop:effect kg:id_139 >>
    prop:text-txt_contents "それらの雇用者所得の増加ですとか消費需要喚起による第２次的な経済波及効果"@ja.
<< kg:id_136 prop:effect kg:id_140 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "固定資産税額の約25％程度がその自治体における収入の増、財政的なプラス面ということになりますが、収入の増となりまして、5,000キロワット風車の場合、１基当たりの収入増分としては200万円程度"@ja.
<< kg:id_141 prop:effect kg:id_142 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "この大幅に減額したことによりまして、再生可能エネルギー発電促進賦課金による国民負担の軽減が見込まれております。一方で、この洋上風力発電に参加をするというか、その事業に加わる民間事業者における洋上風力発電事業への参入意欲の低下や、それに伴って地域振興策に向けられる資金不足、こういったものが逆に懸念事項として考えられる"@ja.
<< kg:id_143 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "前提条件として、県が定める酒田港の港湾計画に海洋再生可能エネルギー発電設備等の基地機能を導入する区域という形で位置づける必要があります。"@ja.
<< kg:id_143 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "山形県による洋上風力発電整備に係る海洋利用の有望区域としての国への手挙げがまず１つ必要"@ja.
<< kg:id_143 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "酒田市としての次なる役割としては、関係者間の調整作業が必要になってくるでしょうし、それから、地域の総意として地域の熱意をまとめながら、国に対する手続の進展を早める活動を先導すること、これが私どもの役割"@ja.
<< kg:id_147 prop:effect kg:id_148 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "建設工事期間中や稼働開始以降、漁業に全く、全然影響が出ないとはならないと考えております。何らかの影響は必ずあるんだ"@ja.
<< kg:id_147 prop:effect kg:id_149 >>
    prop:text-txt_contents "風車の、海の下部分、台座の部分に魚や貝がついていわゆる魚礁としての役割を果たすことで、漁業資源の増大効果の可能性も示唆されております。"@ja.
<< kg:id_147 prop:effect kg:id_150 >>
    prop:text-txt_contents "工事に伴って、いろんな場面で漁業者の皆さんの船が活用されるとそのような例もある"@ja.
<< kg:id_147 prop:contermeasure kg:id_151 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "漁業者をはじめ地域住民の方には、こうした会議を通じて十分なデータと正しい情報が明確に示されることが重要"@ja.
<< kg:id_147 prop:contermeasure kg:id_152 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "我々あくまで漁業者を主体にして、その上で酒田の漁業をしっかりと子々孫々まで発展させていけるような振興策、これが大事なんだと思っております。"@ja.
<< kg:id_147 prop:contermeasure kg:id_153 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "養殖の話につきましても、酒田の漁師がそれを望むのであれば、我々も検討をしていきたい"@ja.
}
