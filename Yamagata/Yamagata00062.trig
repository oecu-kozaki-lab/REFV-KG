kg:st_1 rdfs:label "後藤泉議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "メリットを前面に出し過ぎず市民合意形成を丁寧に進めるべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "メリットだけでなく景観や漁業などの懸念も踏まえるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "市民の合意形成を急がず慎重に進めるべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_4 prop:content "地域経済の活性化につながると認識している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "地域経済の活性化につながると認識している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "市民県民との合意形成をじっくり進めるべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "鳥類魚類など環境面を含め慎重に進めるべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "景観上の問題を含めて慎重に合意形成を進めるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "地域と協調した事業化へ向け課題抽出と対応策の議論を進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "関係者間の理解促進に努めるべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "市民への周知と機運醸成を図る"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "市民理解を広げる必要がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "地域の機運醸成を進めたい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "山形県とともに国へ地道に要望していく"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "環境や景観への影響は環境アセスメントで検討される"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "対象外案件でも自主的な環境影響評価を求める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "事業者が行う環境影響評価手続の中で検討される"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_3 rdfs:label "大沼康浩地域創生部長"@ja.
kg:st_3 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_18 prop:content "設問変更が順位変動の大きな要因と分析している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "新設項目への対応が順位を下げた要因とみている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "紹介できる空き家情報が少なく苦慮している"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "新規案件登録の少なさが課題である"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "立地条件が悪い物件が多く掲載増につながりにくい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "権利関係未整理が新規掲載の妨げになっている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "所有者が賃貸に出したがらない傾向がある"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "移住後のサポートとして交流会を行っている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "サイトだけでなく相談窓口中心に移住実現を支える"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "移住者の声を反映してサイトを改善していく"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "移住希望者が見やすいよう古い情報を削除する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "掲載件数を増やすよう構成団体に働きかける"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "相談者への周知を進め良質な物件情報提供につなげる"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:st_4 rdfs:label "那須欣男総務部危機管理監"@ja.
kg:st_4 rdf:type cls:st_56.
kg:op_31 prop:content "団員数減少が消防団の大きな課題である"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "サラリーマン化に伴い平日日中の対応が課題となっている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "市街地では団員の偏在化が課題である"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "人口減少が団員減少の要因である"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "若年層の新入団員減少が要因である"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "新入団員不足が高齢化につながっている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "ＯＢ団員の活用で平日日中対応を補う"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "不在地域への声かけで偏在化解消に努める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "ポスター掲示などで団員募集を行っている"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "ホームページで団員募集を周知している"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "募集広報で団員確保に努めている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:op_42 prop:content "事業所へ入団をお願いし団員確保を進める"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:op_43 prop:content "防災行政無線は万能ではなく屋内では伝わりにくい"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:op_44 prop:content "気象条件による聞き取りづらさが課題である"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:op_45 prop:content "建物の反響で屋外でも聞き取りにくい場合がある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_4.
kg:op_46 prop:content "周辺音源によって聞こえない場合がある"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "防災ラジオが有効な手段であり頒布拡大を進める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "プッシュ型情報伝達の多重化が必要である"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:op_49 prop:content "電話で放送内容を確認できる仕組みを設けている"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "様々なツールで正確な情報を早く伝える"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "未撤去案件へ補助制度を案内して撤去を促す"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:op_52 prop:content "周知啓発を続け相談件数と補助利用増加につなげる"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:st_5 rdfs:label "佐藤猛議員"@ja.
kg:st_5 rdf:type cls:st_18.
kg:op_53 prop:content "どこまで届いていないか把握し次の手を打つべき"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:st_6 rdfs:label "藤井昌道建設部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_54 prop:content "劣化度合いによっては安全安心に大きな影響を及ぼす"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_6.
kg:op_55 prop:content "５年に一度の法定点検を行いながら管理している"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_6.
kg:op_56 prop:content "設備の延命化と事業費の平準化縮減化に取り組む"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_6.
kg:op_57 prop:content "緊急・早期措置橋梁を優先して対処している"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_6.
kg:op_58 prop:content "地域学校市の役割分担を明確化した"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_4.
kg:op_59 prop:content "役割分担の明確化で連携体制を整えた"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_4.
kg:op_60 prop:content "連絡員事前配置で体制を整えた"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_4.
kg:op_61 prop:content "女性防災リーダー育成を進める"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_4.
kg:op_62 prop:content "不断の見直しでより機能的な避難所運営を目指す"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:op_63 prop:content "大きな災害時も迅速的確に対応できるよう訓練を積む"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_4.
kg:op_64 prop:content "現状ではその他機関との情報共有が限定的である"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_4.
kg:op_65 prop:content "市として必要スペックを示し一日でも早い具現化を目指す"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_4.
kg:op_66 prop:content "ドローンによる観測情報収集を重要機能と認識している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_4.
kg:op_67 prop:content "被害情報や避難所情報の集約が重要である"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_4.
kg:op_68 prop:content "防災パッケージシステムとの一元化も含め研究する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_4.
kg:st_7 rdfs:label "菊池裕基健康福祉部長"@ja.
kg:st_7 rdf:type cls:st_18.
kg:op_69 prop:content "接種は本人の意思で決めるものであり強制はあってはならない"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_7.
kg:op_70 prop:content "御理解をいただくよう十分配慮する"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_7.
kg:op_71 prop:content "最も有効な方法を活用し分かりやすく広報する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_7.
kg:op_72 prop:content "副反応疑いは因果関係を問わず報告義務がある"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_7.
kg:op_73 prop:content "地区医師会や保健所と連携し改めて周知する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_7.
kg:op_74 prop:content "医療費や医療手当障害年金等の給付対象となる"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_7.
kg:op_75 prop:content "書類準備などがスムーズに行えるよう丁寧に対応する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_7.
kg:op_76 prop:content "より経済効果が大きい事業として実施したい"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_3.
kg:op_77 prop:content "消費者は引換えの手間が少ない点を評価している"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_3.
kg:op_78 prop:content "事業者は換金の手間が少ない点を評価している"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_3.
kg:op_79 prop:content "アプリ導入から使い方まで個別相談で支援する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_3.
kg:op_80 prop:content "土日祝日も相談できる体制を整える"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_3.
kg:op_81 prop:content "県の制度変更により世帯要件分が減額となった"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_6.
kg:op_82 prop:content "県制度で加算措置が廃止された"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_6.
kg:op_83 prop:content "林業振興の面から市独自加算を行いたい"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_6.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "遊佐町沖及び酒田市沖への洋上風力発電事業の導入及びそれに伴う基地港湾の指定については、港湾整備、発電設備の施工、それから、施工後の運転・保守による直接的な経済効果"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "建設資材や原材料の取引の増加ですとか、関連産業の立地による第１次的な経済波及効果"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "雇用者所得の増加あるいは消費需要喚起による第２次的な経済波及効果"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "この地域における新しい産業基盤の創出、それから、地域経済の活性化につながるものと考えているところでございます"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "この地域における新しい産業基盤の創出、それから、地域経済の活性化につながるものと考えているところでございます"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "ただ、洋上風力発電事業の導入に当たっては、海域利用者の合意形成を図るとともに"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "ただ、洋上風力発電事業の導入に当たっては、海域利用者の合意形成を図るとともに、環境、景観に配慮すること"@ja.
<< kg:id_7 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "ただ、洋上風力発電事業の導入に当たっては、海域利用者の合意形成を図るとともに、環境、景観に配慮すること"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "酒田市沖への洋上風力発電の導入検討を進めるために、令和３年度に酒田沿岸域検討部会を設置することが決定されました"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "地域と協調した事業化に向けて課題の抽出や対応策等の議論を行って、関係者間の理解促進に努めていく"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本市といたしましても、山形県と連携して説明会を開催するなど、市民に対して洋上風力発電事業の周知に努めまして"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "市民に対して洋上風力発電事業の周知に努めまして"@ja.
<< kg:id_14 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "地域の機運醸成を図るとともに"@ja.
<< kg:id_14 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "国が早期に基地港湾の整備に着手するよう山形県とともに国に対して地道に要望してまいりたい"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "宮海の風力発電施設の更新工事による環境や景観への影響については、環境アセスメントの手続の中で十分に検討されていくものと考えております"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "環境影響評価法による手続の対象外の案件については、自主的な環境アセスメントの実施について市のほうで依頼をしております"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "この洋上風力発電事業による環境や景観への影響については、本事業で想定される発電出力が環境影響評価法上の第１種事業となる１万キロワットを超えることから、事業者が行う環境影響評価法の手続の中で検討されることになります"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "今年１月発売の第９回では、雑誌社の設定した質問項目が大きく変わり、その結果、大きな市シニア部門では第３位となり、総合部門も順位を下げた"@ja.
<< kg:id_25 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "新たに設定された質問項目は、コロナ禍でのイベント開催の状況やオンラインの取組のほか、個別の給付事業の有無などが多く、本市としてはその辺りが順位を下げた要因と分析をしております"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "実際のところ紹介できる空き家情報がほとんどなく、苦慮している状況でございます"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "課題としては、新規案件の登録が少なく、サイトの掲載件数が増えないことが挙げられます"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "立地が悪いものや相続などの権利関係が整理されていないケースも多く、なかなか新規掲載の増加に結びつかない"@ja.
<< kg:id_30 prop:cause kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "相続などの権利関係が整理されていないケースも多く、なかなか新規掲載の増加に結びつかない"@ja.
<< kg:id_30 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "酒田の人は、程度が良くても他人に貸したがらない、賃貸物件に出さないという傾向もございます"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "移住相談窓口では、年３回の移住者交流会にお誘いするなど、移住後のサポートも行っているところでございます"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "今後とも移住相談窓口での丁寧なワンストップ相談などを中心に取組みながら"@ja.
<< kg:id_37 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "サイトにも移住された方の声などを反映しながら充実を図ってまいりたい"@ja.
<< kg:id_30 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "古い情報については速やかに削除するなど、移住希望者が見やすいように運営をしてまいります"@ja.
<< kg:id_30 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "今後も空き家等情報サイトの掲載件数を増やしていくよう引き続き協議会の構成団体に働きかける"@ja.
<< kg:id_30 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "空き家の相談者に対しても周知を図り、移住希望者に良い空き家物件を情報提供できるようにしてまいります"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "現在、消防団の抱える課題としては、団員数の減少による活動の低下"@ja.
<< kg:id_45 prop:cause kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "団員のサラリーマン化に伴う平日日中の災害対応ができない"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "市街地においては団員の地域偏在化が見られることなどが挙げられます"@ja.
<< kg:id_44 prop:cause kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "原因としまして、人口減少により"@ja.
<< kg:id_44 prop:cause kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "特に20代から30代の新入団員が減少していること"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "新入団員がいないことにより高齢になっても退団できないなどが団員数の減少、高齢化につながっている"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "消防団を退団したＯＢ団員が機能別消防団として災害に対応していく"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "不在地域にも幅広く声かけ等を行いまして、偏在化の解消に努めたい"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "市としては各コミセンへのポスター掲示やホームページでの掲載、消防フェスティバルなどの募集広報などを行っております"@ja.
<< kg:id_57 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "ホームページでの掲載"@ja.
<< kg:id_57 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "消防フェスティバルなどの募集広報などを行っております"@ja.
<< kg:id_57 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "消防団協力事業所の拡大を進め、事業所へ団員入団をお願いしながら、団員の確保に努めていきたい"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "これは万能でなく、屋内にいる人にはなかなか伝わりにくい"@ja.
<< kg:id_62 prop:cause kg:id_64 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "気象条件に影響を受けるなどの課題がある"@ja.
<< kg:id_62 prop:cause kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "屋外でも場所によりましては建物への音の反響で聞き取りにくくなる場合"@ja.
<< kg:id_62 prop:cause kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "他の音源が近くにあることで聞こえない場合もあり"@ja.
<< kg:id_62 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "防災ラジオが有効な手段と考えており、その頒布の拡大を図っているところでございます"@ja.
<< kg:id_62 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "緊急速報メールなどに加え、災害発生時に災害情報を自動起動し、お知らせする機能を持つ防災ラジオが有効な手段"@ja.
<< kg:id_62 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "本市の防災行政無線システムは、電話をかけて放送内容を確認できます防災無線テレホンサービスを設けております"@ja.
<< kg:id_62 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "市ホームページや酒田市公式ＬＩＮＥ、フェイスブック、ツイッターなどの市公式ＳＮＳやヤフー防災アプリなど、様々なツールを駆使していき"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "撤去未実施の50件に関して個別に補助制度、これにつきまして令和元年度までは補助上限８万円だったものを、令和２年度以降は補助上限15万円まで制度拡充しております。利用案内を行う"@ja.
<< kg:id_71 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "引き続きホームページや広報への掲載、固定資産税への納入通告書への資料の同封等を通じまして、さらなる周知・啓発を図っていき"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:text-txt_contents "2020年には約90.9％と、９年間で約17.6％向上しているところでございます"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:text-txt_contents "特定天井につきましては、基本的に耐震改修工事と併せて改修を行ってきております"@ja.
<< kg:id_76 prop:countermeasure kg:id_78 >>
    prop:text-txt_contents "照明器具につきましては、施設のＬＥＤ化の改修工事の際に落下防止対策を行ってきているところでございます"@ja.
<< kg:id_79 prop:effect kg:id_80 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "しかしながら、目標値といたします令和２年度末まで95％には達しない状況でございます"@ja.
<< kg:id_81 prop:effect kg:id_82 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "橋梁は、その劣化度合いによっては、市民の安全・安心に大きな影響を及ぼし"@ja.
<< kg:id_81 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "平成26年度からは、５年に一度の義務化された法定点検を行いながら"@ja.
<< kg:id_81 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "予防保全型管理も取り入れ、設備の延命化と事業費の平準化、縮減化に取り組んでいるところでございます"@ja.
<< kg:id_85 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "34橋のうち、令和３年度末で32橋の修繕等が完了する見込みとなっております"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "平成30年に避難所運営マニュアル、これは共通編、個別編がございますが、これを策定しております"@ja.
<< kg:id_87 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "地域が中心となり、学校、市が連携した避難所運営体制が構築されました"@ja.
<< kg:id_87 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "各避難所に職員２名を連絡員として事前に配置することにより体制を整えました"@ja.
<< kg:id_91 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "女性防災リーダー育成のための女性防災講座やワークショップを行っていく所存でございます"@ja.
<< kg:id_91 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "女性の視点に立った避難所運営マニュアルの見直しを含め不断の見直しを図りながら、より機能的な避難所運営をしていく"@ja.
<< kg:id_87 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "協定締結企業や関係団体と連携し、避難所運営を基幹訓練とした実践型訓練を実施し、実際に大きな災害が起こっても迅速かつ的確に対応できるように訓練を積み上げていきたい"@ja.
<< kg:id_95 prop:cause kg:id_96 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "このシステムはＳＩＰ４Ｄとは連携していないため、山形県と県内各市町村や消防、警察とは情報共有ができますが、その他の機関との情報共有は限定的である"@ja.
<< kg:id_95 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "市として本システムに期待するスペックとしましては、まず災害発生状況をリアルタイムに確認でき、状況認識の統一と迅速な意思決定を図り、住民の方々へ迅速な災害情報伝達が可能となるような総合的な防災パッケージシステム"@ja.
<< kg:id_95 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "水位や雨量センサー、災害用ドローンによる観測情報の収集"@ja.
<< kg:id_95 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "被害情報や避難所情報の集約が重要であると認識しており"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "この情報共有システムを入れることによって、防災パッケージシステムと併せて、一元化すればいいのか、それを別個で立てればいいのか、これについてはまた引き続き研究は必要ですが、研究を進めて具現化を図っていきたい"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "ワクチンの接種は自らが希望し、接種による効果と副反応等のリスクを御理解いただいた上で、自らの意思により決めるものでございます"@ja.
<< kg:id_104 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "このことについては受診券送付の際にチラシを同封するなどして、御理解をいただくよう十分に配慮してまいりたい"@ja.
<< kg:id_104 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "市ホームページや酒田市のＬＩＮＥ公式アカウント、またツイッター、市広報など、その時点で最も有効な方法を活用し、分かりやすい広報により市民皆様に呼びかけてまいりたい"@ja.
<< kg:id_107 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "ワクチン接種後に副反応を疑う症状がある場合は、接種との因果関係の有無を問わず、予防接種法の規定により、医師は厚生労働大臣に報告しなければならない"@ja.
<< kg:id_107 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "地区医師会、あるいは保健所とも十分連携しながら、新型コロナウイルスワクチンの個別接種に協力いただく医療機関に対し、改めて周知を図ってまいりたい"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "一般的にワクチン接種により治療が必要になったり、障がいが残ったりした場合、予防接種法に基づく救済制度が設けられております"@ja.
<< kg:id_110 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "申請の相談があった場合、書類の準備などがスムーズに行えるよう、また御本人や家族の不安が少なくなるよう丁寧に対応してまいりたい"@ja.
<< kg:id_113 prop:effect kg:id_114 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "キャッシュレス還元キャンペーンによる消費喚起を行うことで、新型コロナウイルス感染症の拡大により経済的な影響を受けている事業者を支援をしたい"@ja.
<< kg:id_113 prop:cause kg:id_115 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "消費者側の90.1％、事業者側の82.6％がキャッシュレス決済のほうがよかったと回答しております"@ja.
<< kg:id_113 prop:cause kg:id_116 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "事業者側の82.6％がキャッシュレス決済のほうがよかったと回答しております"@ja.
<< kg:id_117 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "個別相談によりアプリの入れ方からチャージの方法、実際の使い方までを細かくレクチャーする使い方相談会を市役所１階フリースペースで実施する予定でございます"@ja.
<< kg:id_117 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "市内の携帯電話販売店においても、契約している通信会社にかかわらず、土日祝日もキャッシュレス決済の使い方を相談できる体制を整えてまいります"@ja.
<< kg:id_120 prop:cause kg:id_121 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "県による人口減少対策としての世帯要件分は最大50万円、内訳は県30万円、市20万円です。これから最大30万円、内訳は県15万円、市15万円に補助金が減額となり"@ja.
<< kg:id_120 prop:cause kg:id_122 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "地域産木材利用や空き家活用における加算措置については廃止となりました"@ja.
<< kg:id_120 prop:countermeasure kg:id_123 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "酒田産の地域木材利用につきましては、林業の振興の面から必要であると考えているため、これにつきましては、市独自に最大10万円の加算を行いたい"@ja.
}
