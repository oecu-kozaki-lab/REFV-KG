kg:st_1 rdfs:label "佐藤弘議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "大幅減員で学校現場が非常に厳しい状況にあると懸念"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "減員しても業務は減らず現場の教職員負担が増えていると指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "コロナ対応が続き学校現場の負担をさらに重くしていると指摘"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "齋藤一志教育次長"@ja.
kg:st_2 rdfs:type cls:st_57.
cls:st_57 rdfs:label "教育行政"@ja.
kg:op_4 prop:content "学校が非常に大変だとは認識しているが校長の工夫で対応していると説明"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "消毒対象を絞ることで学校の業務量は昨年度より抑えられていると説明"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "学校訪問や調査を通じて現場把握に努めていると説明"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "オンライン化で教員の移動負担軽減を進めていると説明"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "紙ベースから電子化へ移行し業務軽減を進めていると説明"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "教育支援員を待つ子どもが多く増員が必要だと訴える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "市予算で教育支援員を60人に戻すよう求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "県の通知が大規模校での混乱や困難を招いていると指摘"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "大規模校では水泳指導の運営が非常に困難だと訴える"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "水泳指導の困難に対し人員増などの対応を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "教員が希望時に研修できない点を問題視"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "教員より他団体予約が優先される運用を問題視"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "特定の得意な教員に負担が偏っていると懸念"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "初期設定で情報担当教員に負担をかけていると認識"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "発達段階に応じた目安づくりは必要で現在作成中と説明"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "自宅待機時の学習保障の必要から前倒ししたと説明"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "感染による自宅待機再発の可能性に備えて前倒ししたと説明"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "保護者理解や通信環境など未整理の課題が多いと懸念"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "家庭持ち帰りは強制せず学校判断で進めると説明"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "家庭環境が整わない場合は紙対応も検討すると説明"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "ソフトバンク不可はルーター仕様によるものと説明"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "低所得世帯には通信費補助で対応すると説明"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "直接説明機会が持てないことは認識していると説明"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "直接説明できないためプリント配付で理解を求めていると説明"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "ICT支援員不在で授業準備やトラブル対応が現場負担になっていると指摘"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "補助制度がなく採用しづらい事情があると説明"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "ICT支援員の代わりに指導主事増員と研修拠点整備で対応すると説明"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "実証校の情報収集を進めつつ導入の動向を見極める考え"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:st_3 rdfs:label "丸山至市長"@ja.
kg:st_3 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_32 prop:content "感染拡大を踏まえ専門家判断で延期したと説明"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "感染対策として会場管理を強化すると説明"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "マスクを外した会話を避けるため飲酒禁止とする"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "今年度の寄港は感染症の影響で全てキャンセルとなったと説明"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "安全安心な受入れ体制整備を第一に誘致を進める考え"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "コロナ禍で積極的な観光PRが難しい状況と説明"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "観光施策は団体中心から個人向けへ転換が必要と認識"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "新しい旅のスタイルに合わせた観光商品づくりを進める考え"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "脱炭素の動きを注視し再エネ導入を強めたいと説明"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "売電実績は順調な立ち上がりと評価"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "季節要因で夏季は発電量低下を見込むと説明"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "公共施設では再生可能エネルギー導入を優先検討する方針"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "収益性や収穫量などの検証段階で判断は難しいと説明"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "制度緩和など国の動きを見ながら市方針を定める考え"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:st_4 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_4 rdfs:type cls:st_34.
cls:st_34 rdfs:label "部局長"@ja.
kg:op_46 prop:content "感染拡大防止のため地元実行委員会が開設しない判断をしたと説明"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "閉鎖や離岸流の危険を看板等で周知して事故防止を図ると説明"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "不要なトラブル防止のためトイレ閉鎖と清掃委託中止とする"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:op_49 prop:content "海水浴場利用者減少の背景にレジャーの多様化があると認識"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "運営実行委員会は人手不足と収支面で厳しい状況にあると説明"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "自治会単独運営が厳しいため市が側面支援を続けてきたと説明"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:st_5 rdfs:label "佐藤喜紀議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_52 prop:content "支援制度が多岐にわたり市民や事業者が把握しづらいと指摘"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_5.
kg:st_6 rdfs:label "安川智之地域創生部産業振興調整監"@ja.
kg:st_6 rdfs:type cls:st_34.
kg:op_53 prop:content "複数媒体で支援制度の周知を行っていると説明"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_6.
kg:op_54 prop:content "対象が特定できる制度は個別郵送で周知していると説明"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_6.
kg:op_55 prop:content "国県市が一斉に支援策を打ち出し大きな混乱が生じたと説明"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_6.
kg:op_56 prop:content "混乱対応のため市役所内にワンストップ窓口を開設したと説明"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_6.
kg:op_57 prop:content "パソコンやスマートフォンがなく申請困難な事業者の声が多いと説明"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_6.
kg:op_58 prop:content "サンロクが対面で制度検索や申請先案内を支援していると説明"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_6.
kg:st_7 rdfs:label "矢口明子副市長"@ja.
kg:st_7 rdfs:type cls:st_40.
cls:st_40 rdfs:label "副市長"@ja.
kg:op_59 prop:content "会員減少と役員の成り手不足で解散につながるクラブがあると説明"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_7.
kg:op_60 prop:content "コロナで老人クラブ活動が大きく制約されたと説明"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_7.
kg:op_61 prop:content "感染対策を徹底しつつ活動再開を進めていると説明"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_7.
kg:op_62 prop:content "青年活動団体の課題は会員確保とリーダー不足と説明"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_7.
kg:op_63 prop:content "婦人会は高齢化や就労事情で参加者確保に苦労していると説明"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_7.
kg:op_64 prop:content "女性部の課題は若い世代の加入不足と説明"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_7.
kg:op_65 prop:content "消費者団体は高齢化と会員減少で運営困難になっていると説明"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_7.
kg:op_66 prop:content "消費者側の声を届ける役割の低下を残念に思うと説明"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_7.
kg:op_67 prop:content "新たな消費者団体が生まれれば支援したい考え"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_7.
kg:op_68 prop:content "会員減少対策として推進員養成講習会を毎年実施していると説明"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_7.
kg:op_69 prop:content "老人クラブには複数の補助制度で支援していると説明"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_7.
kg:op_70 prop:content "婦人会連絡協議会へ活動費補助を行うと説明"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_7.
kg:st_8 rdfs:label "田中斉議員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_71 prop:content "高齢者予約は混乱があり改善が必要だったと指摘"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_8.
kg:op_72 prop:content "ワクチン供給の不確実さが自治体運営を難しくしていたと指摘"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_8.
kg:op_73 prop:content "かかりつけ医の有無に応じて個別接種と集団接種を組み合わせて実施していると説明"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_3.
kg:op_74 prop:content "予約困難者向けに代行窓口を開設して支援していると説明"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_3.
kg:op_75 prop:content "民生委員の協力で予約困難高齢者を支援していると説明"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_3.
kg:op_76 prop:content "現時点の供給見込みでは全対象者分に足りないと説明"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_3.
kg:op_77 prop:content "供給量に応じて年齢区分で予約を進める方針を示した"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_3.
kg:op_78 prop:content "感染状況を踏まえ重症化リスクを優先した順番にする考え"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_3.
kg:op_79 prop:content "医師会から介護系従事者優先の意見が出ており調整中と説明"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_3.
kg:op_80 prop:content "学校接種は差別や副反応対応の課題から現時点で行わない方針と説明"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_3.
kg:op_81 prop:content "接種の有無による差別防止を市民に啓発していく考え"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_3.
kg:op_82 prop:content "職域接種希望企業はあるが規模要件と医療従事者確保が課題と説明"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_3.
kg:op_83 prop:content "市の接種体制を優先しつつ条件が整う企業は職域接種を調整中と説明"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_3.
kg:op_84 prop:content "平田農村環境改善センターを中心に大規模接種を進める方針"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_3.
kg:op_85 prop:content "継続利用の難しさなどから会場活用は困難と判断したと説明"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_3.
kg:st_9 rdfs:label "白畑真由美健康福祉部長"@ja.
kg:st_9 rdfs:type cls:st_34.
kg:op_86 prop:content "モデルナ活用は検討しているが同一会場での併用不可が制約と説明"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_9.
kg:st_10 rdfs:label "大谷謙治市民部長"@ja.
kg:st_10 rdfs:type cls:st_34.
kg:op_87 prop:content "空き家件数自体は今後も増える見込みと説明"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_10.
kg:op_88 prop:content "所有者への助言指導と連携で危険空き家は抑制してきたと説明"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_10.
kg:op_89 prop:content "国補助は要件が厳しく民間活用に至っていないと説明"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_10.
kg:op_90 prop:content "市単独の解体補助制度の活用を呼びかける"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_10.
kg:op_91 prop:content "掲載物件が増えない背景に立地や権利関係の問題があると説明"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_10.
kg:op_92 prop:content "移住相談時に補助制度紹介を行い空き家リフォーム利用につながったと説明"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_10.
kg:op_93 prop:content "高齢を理由に賃貸入居が難しい相談が寄せられていると説明"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_10.
kg:op_94 prop:content "高齢者住居確保策として制度活用が実情に合うか調査する考え"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_10.
kg:st_11 rdfs:label "那須欣男総務部危機管理監"@ja.
kg:st_11 rdfs:type cls:st_58.
cls:st_58 rdfs:label "危機管理"@ja.
kg:op_95 prop:content "避難情報が分かりにくく逃げ遅れを招いていたと説明"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_11.
kg:op_96 prop:content "住民の速やかな避難行動徹底のため一本化したと説明"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_11.
kg:op_97 prop:content "避難情報変更を多様な媒体で周知していると説明"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_11.
kg:op_98 prop:content "要支援者の安全で迅速な避難につなげるため計画作成が必要と説明"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_11.
kg:op_99 prop:content "台帳はあるが支援行動まで活用できていない地域もあると説明"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_11.
kg:op_100 prop:content "避難支援方法や経路情報の不足を整備し計画化を進める考え"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_11.
kg:op_101 prop:content "既存会議の活用も含め本市に適した地域調整会議を検討すると説明"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_11.
kg:op_102 prop:content "地区防災計画なしに個別避難計画の実効性向上はないと認識"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_11.
kg:op_103 prop:content "防災計画や避難所運営マニュアルはあるが地区防災計画素案作成までは進んでいないと説明"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_11.
kg:op_104 prop:content "モデル地区を選び関係部局連携で整備を進める考え"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_11.
kg:op_105 prop:content "計画は訓練で検証し繰り返して体得することが必要と説明"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_11.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "教育支援員、学習指導員、スクールサポートスタッフの大幅な減員が、学校現場に大変な影響を与えているという声が多数寄せられています"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "人員が減っても業務が減るわけではありません。前年度、教育支援員、学習指導員、スクールサポートスタッフが担っていた業務を誰かがやっているはずです"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "また、コロナ禍が収束しない中、コロナ対応にも時間を割いています"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "学習指導員やスクールサポートスタッフが減ったことで、学校としては非常に大変だというようなことは聞いておりますが、校長先生のマネジメントにより、人員の配置や効果的な指導体制について工夫して取り組んでもらっているところでございます"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "予防対策の内容や方法について、業務量は昨年度よりもかなり抑えられているのかなと考えているところでございました"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "教育委員会としては、学校訪問や在校等時間調査などを通して実態把握に努めているところでございます"@ja.
<< kg:id_10 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "６月10日に実施した教育相談研修講座では、情報教育推進室から発信するオンライン研修といたしましたが、このように、研修を各学校で視聴できるようにすることで、先生方が移動に費やす時間や学校を離れる機会の削減につながっております"@ja.
<< kg:id_10 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "これまでは紙ベースで実施していたものを電子化して学校へ依頼、データで送っていただくというようなこともやっております"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "その子だけではなくて、多くの児童生徒が教育支援員を待っているんじゃないかと私は思っています"@ja.
<< kg:id_14 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "ぜひここは、酒田市の予算で何とかできる部分なので、何とか60人に戻していただくとかしていただけないか"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "県の教育委員会は20人まで入れていいよというような通知を出しています"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "規模の大きい学校で20人しか入れないということは、これはかなりの困難や混乱があると聞いています"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "何とか教育委員会で手だてを講じていただけないかと。これも意見になりますけれども、ぜひ、本当に大変な状況なので、人を増やすとかいろいろやっていただきたい"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "必ずしも先生たちの希望の日時に使えないということなんですね。必ず使えるわけではなくて、使えないことも出てくるということでよろしいですね"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "他団体が優先で、使いたい先生は優先ではないという認識なんですね"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "担当者に過剰な負担がかかっているんじゃないかということなんですが"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "特に今、情報担当の先生で、最初にいろいろ御苦労なされているのが、やはり初期の設定であるとかいろいろあるのです"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "児童生徒の情報活用能力については、成長段階に応じた目安となるもの、こちらのほうは必要かと感じておりました。こちらのほうについては、現在作成しているところでございます"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "その学校から、ウェブ会議システムを利用して、教室と自宅をつなぐことで、自宅待機している子供たちに授業を受けさせたいという要望があり、急遽、該当の家庭に端末を配付して授業を実施した経過がございます"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "同じような事態が発生する可能性は否定できないという理由から、当初の予定より開始時期を早めたというようなことでございます"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "保護者の理解、例えば家庭でのタブレット端末利用とかＷｉ－Ｆｉが関わる問題、保護者から拒否されたときの対応、オフラインでの利活用、端末破損の費用負担、苦情の窓口、セキュリティポリシーに関すること等、とても進んでいるとは思えません"@ja.
<< kg:id_37 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "持ち帰りを強制するものではございません。実際に持ち帰って各家庭で利活用を開始する時期や頻度については、学年や習熟等に応じて各学校で判断していく"@ja.
<< kg:id_37 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "保護者がどうしても、端末について持ち帰ったり、もしくはＷｉ－Ｆｉの接続ができないということであれば、場合によっては紙で対応していくというようなことも考えられなくはないかと思います"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "やはりルーターの機種で、ソフトバンクの回線のほうが使えないという仕様による制限ということのようでございます"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "要保護世帯、準要保護世帯については、国もしくは市の事業で通信費の補助がございますので、そちらのほうについては手だてをするという形になるかと思います"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "例えばＰＴＡ総会であるとか、様々、直接御説明できる機会がなかなかないというのは御指摘のとおりかと思います"@ja.
<< kg:id_46 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "こういったプリント等を配付して御理解をいただけるように手だてをしているということでございます"@ja.
<< kg:id_48 prop:effect kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "準備が大変で接続がうまくいかないことがあってＩＣＴ支援員が欲しいとか、使用上のトラブルが続出して授業どころではないと"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "ＩＣＴ支援員については、ＩＣＴ機器を利用した授業のサポートが主な業務になりますが、地方財政措置がされておりますけれども、国の補助金事業とはなっておらず"@ja.
<< kg:id_50 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "今年度、教育研修センターに指導主事を１名増員しております。その指導主事を中心に情報教育推進室を利用した研修を行うなど、環境と人員を整備し、教育委員会の機能強化を図ることで対応したい"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "市としてもデジタル教科書のよさと課題について実証校からの情報収集に努めるとともに、国や県の動きに注視してまいりたいと思います"@ja.
<< kg:id_55 prop:cause kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "当初、８月７日開催としておりましたけれども、コロナの感染拡大を受けまして、そして専門家の判断も仰ぎながら、10月への延期を決定したところでございます"@ja.
<< kg:id_57 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "今年度から自由観覧エリアを廃止し、会場内を全席指定とすること"@ja.
<< kg:id_57 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "感染リスクが高いと言われるマスクを外しての会話を避けるために、会場内では飲酒は禁止といたします"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "本年度の寄港は新型コロナウイルス感染症の影響で全てキャンセルとなったところでございます"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "まずは安全・安心なクルーズ船受入れ体制を整えることを第一としつつ、アフターコロナ期におけるクルーズ船誘致を進めていきたい"@ja.
<< kg:id_4 prop:effect kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "このコロナ禍にあって、表立った観光プロモーションやイベントはまだまだ実施しづらい状況にございます"@ja.
<< kg:id_65 prop:cause kg:id_66 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "新型コロナウイルス感染症の拡大によりまして、こちらのアプローチも個人向け国内旅行へ移行する必要を迫られているところでございます"@ja.
<< kg:id_67 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "個人に向けた情報発信の在り方、観光動向調査を活用したターゲットの見直し、それから体験コンテンツ等、売れる観光資源の掘り起こし、それからコンテンツをストーリーでつないだ魅力的なパッケージ販売などに取り組んでいく"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "地方自治体、事業者、民間団体の連携に対する動きが今後加速するものと考えておりますので、そうした動きを注視しながら、酒田市としても再生可能エネルギー導入への取組を強めていきたい"@ja.
<< kg:id_71 prop:effect kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "４月と５月の２か月間の実績は、売電量で約334万キロワットアワー、収入でいいますと約8,130万円となったところでございます。予算との対比では、予算額の約３億3,000万円に対して24.8％となっておりまして、順調なスタートを切ることができた"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "６月から９月までは、季節柄、風況が悪いので、この期間は発電量が大幅に低下するものと見込んでおります"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "公共施設整備においては、太陽光、風力等のクリーンエネルギーの採用を優先的に検討することとしております"@ja.
<< kg:id_77 prop:effect kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "農業者の収入増加につながるかどうか、これは一概にはまだ判断するのは難しいかなと考えております"@ja.
<< kg:id_77 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "そういった国の動きなども注視しながら、今後、営農型太陽光発電につきましては、市の方針等についても定めていきたい"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "県内外からの来場者による新型コロナウイルスの感染拡大を憂慮して、昨年に引き続き開設しないという報告をいただきました"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "宮海・浜中・十里塚においては海水浴場の閉鎖や中止、遊泳の危険性、特に離岸流が存在するというような注意、こういったことを周知する看板を設置し、周知を図っている"@ja.
<< kg:id_82 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "今年度は、海水浴場を開設しないということを受けまして、不要なトラブルが生じないよう、トイレは開放せず、清掃も委託はしないという予定でございます"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "海水浴場やスキー場といったリゾート型の観光施設の利用者、こちらのほうは、レクリエーションの多様化に伴いまして減少を続けている"@ja.
<< kg:id_87 prop:effect kg:id_88 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "高齢化による人手不足や天候に左右される収支の課題につきましては、これまでもお伺いをしておりました"@ja.
<< kg:id_87 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "安全対策等の補助金のほか、整地、砂の除去などは市が実施するなど、側面的な支援を実施してきました"@ja.
<< kg:id_90 prop:effect kg:id_91 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "その支援制度は多岐にわたり、コロナウイルス感染症の影響を受けている事業所や市民が把握し切れないほど膨大な数であり、申請方法も複雑化しているように感じられます"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "酒田市のホームページで新型コロナウイルス感染拡大に関連する支援情報一覧を掲載し更新をしているほか、酒田市産業振興まちづくりセンターサンロクのホームページまたはメールマガジン、あとＬＩＮＥでの配信により情報提供を随時事業者の方々に行っている"@ja.
<< kg:id_92 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "把握可能な範囲で、事業者様に対して個別に郵送による周知を行っております"@ja.
<< kg:id_95 prop:effect kg:id_96 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "昨年３月以降の新型コロナウイルス感染拡大に伴い、国、県、市が共に新型コロナウイルス感染症対策支援を一斉に打ち出したこともありました。その結果、大変大きな混乱というか、そういうものが生じた"@ja.
<< kg:id_97 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "昨年５月11日から22日まで飲食店等応援補助金や税金等の減免・猶予制度、または国の雇用調整助成金、持続化給付金、または県の支援制度等について、ワンストップで相談できる緊急相談窓口を市役所内に開設いたしました"@ja.
<< kg:id_99 prop:effect kg:id_100 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "パソコンやスマートフォンを持っておらず情報入手が困難であるとか、申請自体ができないといった声が数多く寄せられている"@ja.
<< kg:id_101 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "必要に応じて職員のパソコンを使って制度を検索するなどして、該当する可能性が高い支援策を案内させていただいておりますし、一時支援金や月次支援金等については、申請に必要な登録確認機関...ホームページを一緒に見ながら御案内をして、パソコン操作が困難な方へのサポートを行っている"@ja.
<< kg:id_103 prop:effect kg:id_104 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "新規に加入する会員数が減少し、クラブ全体の高齢化が進行し、役員の成り手がいないなどによりまして解散につながっているクラブがある"@ja.
<< kg:id_61 prop:effect kg:id_105 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "昨年は、新型コロナウイルス感染症の影響により、予定していた活動が中止となったクラブが多数ありました"@ja.
<< kg:id_103 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "今年度につきましては、新型コロナウイルス感染症対策を徹底し、ワクチンの接種状況を考慮しながら活動を再開し始めている"@ja.
<< kg:id_107 prop:effect kg:id_108 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "現在活動している団体の課題は、やはり新たな会員の確保が難しいことや、リーダーや役員の成り手がいないことなどが挙げられます"@ja.
<< kg:id_109 prop:effect kg:id_110 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "全体として高齢者の方が多いこと、それから、就労している方が多い地区と少ない地区とがあることから、行事の日程調整等が難しいことがあります。第２に、構成員がサークル活動などほかの団体へも所属していることから、行事があった場合の参加者集めに苦労している"@ja.
<< kg:id_111 prop:effect kg:id_112 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "コミュニティ振興会女性部の課題としましては、女性部に限ったことではございませんが、若い世代の会員が入ってこないこと"@ja.
<< kg:id_113 prop:effect kg:id_114 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "平田消費者の会は、会員の高齢化及び会員の減少により解散した...酒田消費者の会は、同じく会員の高齢化と会員の減少が続く中、会を牽引してきた中心人物が亡くなられたことをきっかけに運営困難と判断し、解散した"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "相次いで団体が解散し、連絡協議会から脱退したことは、市としても大変残念に思っております。市政を運営する上で、サービス提供者の側の声、つまり業界団体の声だけではなくて、消費者の側の声を聴くことは大変大切である"@ja.
<< kg:id_117 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "今後もし新たに消費者の声を代弁するような団体が設立されるようであれば、市としてもそういった活動はしっかり支援していきたい"@ja.
<< kg:id_119 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "食生活改善推進員を養成するための講習会を毎年開催し、例年15人から20人の方が新規に加入、入会していただいております"@ja.
<< kg:id_103 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "老人クラブへは老人クラブ連合会補助金、そして老人クラブ活動指導員設置事業費補助金、そして老人クラブ活動費補助金、この３種類の補助金を交付しております"@ja.
<< kg:id_109 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "酒田市婦人会連絡協議会に対して、活動費の一部として今年度は16万1,000円の補助金を交付する予定です"@ja.
<< kg:id_123 prop:effect kg:id_124 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "予約段階では若干混乱はございました"@ja.
<< kg:id_125 prop:effect kg:id_126 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "ワクチン自体がいつ来るか分からないという状況の中で、大変御苦労されておりますでしょうし、広報するにしてもワクチンがなければできないという状況"@ja.
<< kg:id_127 prop:contermeasure kg:id_128 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "かかりつけ医がいる方は各医療機関での個別接種で、かかりつけ医がいない方やかかりつけ医から集団接種を案内された方は、市が設置をいたします集団接種会場...で接種を行っている"@ja.
<< kg:id_129 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "御自身で予約が困難な方のために市役所と各総合支所に予約代行窓口を開設して、現在まで587件の予約代行を行った"@ja.
<< kg:id_131 prop:contermeasure kg:id_132 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "民生委員の皆様から、５月14日と28日の２度にわたり、御自身で予約することが困難な高齢者への支援をお願いしております"@ja.
<< kg:id_133 prop:effect kg:id_134 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "必要な量の半分程度の供給量になることが見込まれております"@ja.
<< kg:id_135 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "供給されるワクチン量に基づいて、年齢を区切って受け付けるなどの予約方法を工夫する"@ja.
<< kg:id_137 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "感染により重症化する可能性が高く、地域医療体制への影響が大きいと考えられる年齢の高い方や基礎疾患のある方から接種を進めてまいりたい"@ja.
<< kg:id_139 prop:cause kg:id_140 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "クラスターの発生リスクが高い通所系及び訪問系の介護事業所の従事者など一定の職種の方を優先して接種するべきであると、こういった意見をいただいております"@ja.
<< kg:id_141 prop:cause kg:id_142 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "生徒間、学生間での差別等につながることが懸念されることや、ワクチン接種に伴う副反応等の発生時の緊急対応など様々な課題があると考えられますことから...現時点では、これは取り組まない方針"@ja.
<< kg:id_143 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "ワクチンを接種する人、接種しない人との差別が起きないように...広報やホームページ等を通じて、そういう差別をしないことについてはしっかりと情報発信してまいりたい"@ja.
<< kg:id_145 prop:effect kg:id_146 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "５社が...職域接種でのワクチン接種を希望しておりまして、職域接種の検討において、1,000人以上の規模での実施体制とワクチン接種を行う医師及び看護師の確保が課題である"@ja.
<< kg:id_147 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "そのスケジュールに影響を与えないと思われる企業、現時点で２社ほどございますが、その企業２社については...職域接種が実施できるかどうか、現在最終的な詰めを行っている"@ja.
<< kg:id_149 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "８月から平田農村環境改善センターを長期間占有させていただいて、大規模な接種体制を整えていく予定でございます"@ja.
<< kg:id_151 prop:cause kg:id_152 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "接種に伴う物品や大規模な会場設営が必要...一定期間継続して施設を確保する必要がございます。そのため、公益ホールや国体記念体育館は、定期的に大学の授業やあるいは大きなイベント等の予約が入っておりますことから、接種会場としての活用は難しい"@ja.
<< kg:id_153 prop:cause kg:id_154 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "現時点で、国は、同一の会場で２種類のワクチンを使用することを今現在認めておらない状況"@ja.
<< kg:id_155 prop:effect kg:id_156 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "空き家の件数自体については、今後も増加することが見込まれる"@ja.
<< kg:id_157 prop:contermeasure kg:id_158 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "空き家見守り隊の活動、それから酒田市空き家等ネットワーク協議会との連携によりまして、空き家所有者等に対する助言、指導等により抑制されてきております"@ja.
<< kg:id_159 prop:cause kg:id_160 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "補助対象となる物件...不良住宅...さらに、この空き家を除去する場合は、解体後地域活性化に資する取組...にしなければならないという要件がございまして、民間主体でのこの国の補助金活用には残念ながら至っていない"@ja.
<< kg:id_161 prop:contermeasure kg:id_162 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "市単独の補助事業といたしまして、今年度、空き家の解体に補助率２分の１、最大20万円を上限とする補助支援事業を建設部のほうで行っております"@ja.
<< kg:id_163 prop:cause kg:id_164 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "立地が悪いものや、相続などの権利関係が整理されていないものなどがやはり多く、なかなか新規掲載の増加に結びつかない"@ja.
<< kg:id_165 prop:contermeasure kg:id_166 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "移住者の方が自らネットワーク等で探してきた空き家物件について、移住相談の過程の中で補助金制度を担当課が紹介し、これが利用に結びついた"@ja.
<< kg:id_167 prop:effect kg:id_168 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "高齢のため保証人がいないなどの理由で賃貸住宅の入居が困難になっているというような相談につきましては、消費生活相談として年二、三件程度寄せられている"@ja.
<< kg:id_169 prop:contermeasure kg:id_170 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "高齢者の住居確保と空き家の利活用について住宅セーフティネット制度を活用していくことが本市の実情に合っているのか、他市の状況を調査するとともに、建築担当部局や福祉担当部局とも連携しながら、本制度の情報共有を図ってまいりたい"@ja.
<< kg:id_171 prop:cause kg:id_172 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "本来避難すべきである避難勧告のタイミングで避難せず、逃げ遅れにより被災する方が多数発生していること、また、避難勧告と避難指示の違いも十分に理解されなかった"@ja.
<< kg:id_171 prop:contermeasure kg:id_173 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "この２つを避難指示へ一本化し、住民の速やかな避難行動を徹底していく"@ja.
<< kg:id_174 prop:contermeasure kg:id_175 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "小中学校やコミュニティセンターへのチラシ配布、市施設への掲示、広報への掲載、ホームページ、フェイスブックやＬＩＮＥ等で周知し、避難の意識づけを改めるよう広く訴えている"@ja.
<< kg:id_176 prop:contermeasure kg:id_177 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "要支援者の方々に対して避難先や避難経路、避難支援する人などを事前に定めるところにより、安全で速やかな避難につなげる"@ja.
<< kg:id_178 prop:effect kg:id_179 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "自治会等に配布は行っても、安否確認までの対応で終わっているところや、支援行動につなげられていない自治会もございます"@ja.
<< kg:id_180 prop:contermeasure kg:id_181 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "不足事項等の整備について検討を続けていきたいと考えているところでございます"@ja.
<< kg:id_182 prop:contermeasure kg:id_183 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "既存の会議の活用も視野に入れながら、本市に適した地域調整会議の在り方について検討していきたい"@ja.
<< kg:id_184 prop:contermeasure kg:id_185 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "地区防災計画と個別避難計画は密接不可分なものと考えております"@ja.
<< kg:id_186 prop:cause kg:id_187 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "各自主防災組織が定めている自主防災会の防災計画や避難所ごとに設けてある避難所運営マニュアルなどはあるものの、地区防災計画の素案の作成などには具体的にはまだ至っていない"@ja.
<< kg:id_188 prop:contermeasure kg:id_189 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "モデル地区を選定するなど、危機管理課及び福祉課など市の担当部局が連携して地区防災計画の速やかな整備及びそれと十分な整合のとれた個別避難計画の策定を進めたい"@ja.
<< kg:id_190 prop:contermeasure kg:id_191 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "防災訓練等において策定した個別避難計画の実効性を検証し、かつ、何度も繰り返してそれを体得していく"@ja.
}
