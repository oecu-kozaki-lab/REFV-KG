kg:st_1 rdfs:label "齋藤美昭議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "地方の独自財源の確保策として重要な事業と考える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地場産業の活性化に大きく寄与していると考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "株式会社トラストバンク調査"@ja.
kg:st_2 rdf:type cls:st_59.
cls:st_59 rdfs:label "調査機関"@ja.
kg:op_3 prop:content "今後の自治体運営にとって積極的に取り組む貴重な検討材料と評価する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "全国836自治体調査回答自治体"@ja.
kg:st_3 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_4 prop:content "多くの自治体が地域活性化につながる制度だと認識している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "返礼品が事業者支援につながっているとみている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "政策の財源として機能していると認識している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "地域のPRにつながると認識している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "幅広い人とのつながりが活性化に結びついていると感じている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "応援消費が寄附額増加に影響したと考えている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "応援消費は地域にかなりの支援効果があったとみている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:st_4 rdfs:label "各自治体"@ja.
kg:st_4 rdf:type cls:st_11.
kg:op_11 prop:content "地場産業の売上げ落ち込みが生じたと報告している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "受注増加が少しでも経済活性化につながったとみている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "売上げだけでなく事業者の意欲向上にもつながっている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:st_5 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_5 rdf:type cls:st_60.
cls:st_60 rdfs:label "自治体職員"@ja.
kg:op_14 prop:content "ポータルサイト利用開始後に寄附が大きく伸びたと総括する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "ポータルサイト増加と返礼品開発が寄附増加に寄与したとみている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_5.
kg:op_16 prop:content "自主財源の増加が市財政に好影響を与えていると総括する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:op_17 prop:content "寄附件数の増加によりシティープロモーション効果も大きくなったとみている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_5.
kg:op_18 prop:content "地場産品取扱い増加が地域経済に直接効果をもたらしたと捉えている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_5.
kg:op_19 prop:content "エンドユーザーを意識した物づくりが事業者成長を促したとみている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_5.
kg:op_20 prop:content "巣籠もり生活によりお取り寄せ需要が増えたと認識している"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:st_6 rdfs:label "返礼品提供事業者"@ja.
kg:st_6 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_21 prop:content "飲食店取引の停滞で収益減少が生じたと報告している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:op_22 prop:content "返礼品需要が収益減少の緩和につながり助かったとしている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:op_23 prop:content "応援メッセージが大きな励みになったと受け止めている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_6.
kg:op_24 prop:content "寄附金額の伸びにはお取り寄せ需要の効果が影響したと考えている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "寄附者利便性を高める定期便充実が効果を生んだと認識している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:op_26 prop:content "主力のお米以外の返礼品開発にも力を入れたと説明している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "三者による直接訪問やウェブ面談の支援効果が大きいと捉えている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "寄附者に寄り添う姿勢が高く評価されたと考えている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "市の特徴的な取組のPRになるため積極的に活用したい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "市の施策応援とPRに有効で積極活用したい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "寄附者の思いをより明確に反映できる点を評価している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:op_32 prop:content "自治体にとって新たな財源調達手段の一つと捉えている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:st_7 rdfs:label "内閣府アンケート回答企業"@ja.
kg:st_7 rdf:type cls:st_53.
cls:st_53 rdfs:label "企業"@ja.
kg:op_33 prop:content "自治体からの依頼が寄附のきっかけになった企業が多い"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_7.
kg:op_34 prop:content "まずは企業に様々な方法でアプローチして推進を図りたい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_5.
kg:op_35 prop:content "酒田をより身近に感じてもらう取組を進めたい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "各課の事業なども配信し内容充実に努めている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "今後の見直しに対しても当然対応していきたい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "将来的な制度廃止も見据え継続支援したい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "寄附時に意見を得られる仕組みやコメント充実を進めたい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "随時こうした取組を実施していきたい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "庁内全体でもう一度取り組める体制を考えたい"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "機会を捉えて情報発信していきたい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "生まれた町を局所的に応援する仕組みとして注視したい"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:op_44 prop:content "制度改正に後手後手にならないよう課題検討を求める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "地方の独自財源の確保策として重要な事業であり"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "返礼品については、地域経済、地場産業の活性化に大きく寄与していると考えています"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "ふるさと納税の活用法は、今後の自治体運営にとって積極的に取り組む貴重な検討材料になっていくものと考えられると評されておりました"@ja.
<< kg:id_7 prop:effect kg:id_2 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "ふるさと納税制度が自治体にとって地域の活性化につながる制度だと思うかという問合せに、そう思う58.9％、ややそう思う35.9％、合わせて94.7％に上るという結果でした"@ja.
<< kg:id_3 prop:effect kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "地域活性化につながっていると感じる理由としては、「お礼の品、俗に言う返礼品が、事業者の助け、支援につながっている」という回答が29.8％と最も多く"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "次いで、「政策の財源になっている」が23.6％"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "「地域のＰＲにつながる」が23.5％と続いており"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "寄附者が、地元企業、住民や他の自治体との連携など幅広い人とのつながりが活性化に結びついていると感じている"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "寄附額が増加した要因については、６割以上の自治体が、コロナ禍にあって、寄附者が生産者の応援を意識したことが影響したと考えており"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "このコロナ禍の応援消費は、地域にとってはかなりの力強い支援効果があったようです"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "地場産業の売上げは落ち込んだが"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "ふるさと納税の受注数が増加したことにより少しでも経済活性化につながった"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "ふるさと納税によって、売上げだけでなく地域事業者のモチベーション向上につながっている"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "平成26年、2014年に、初めてふるさと納税のポータルサイト、ふるさとチョイスの利用を開始してからは、億単位の寄附を頂くようになった"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "その後も、ポータルサイト数を増やしたり、寄附者から選ばれる返礼品の開発などに返礼品提供事業者とともに取り組んできました"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "本市の貴重な自主財源となっているふるさと納税による寄附金が大きく伸びたことは、市の財政に好影響を与えている"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "昨年度は約18万件の御寄附を頂くようになったことから、ふるさと納税のポータルサイトを通じたシティープロモーションの効果も大きくなった"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "寄附の伸びに応じて地場産品の取扱いが増えたことによる地域経済への直接的な効果があった"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "返礼品として事業者が直接寄附者に商品を届けることから、事業者自身が日頃から、いわゆるエンドユーザーを意識した物づくり、これを行うようになるなど、地域事業者の成長を促す効果もあり"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "コロナ禍においては、飲食店の営業自粛、それから人流の制限などによって巣籠もりの生活が続く中、いわゆるお取り寄せでの商品購入が増えまして"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "コロナの影響によって飲食店との取引が停滞する中"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "ふるさと納税での返礼品需要があったことで収益の減少が緩和されて助かった"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "寄附者から、事業者を応援するメッセージも多くいただいておりまして、コロナで苦しむ事業者にとりまして大きな励みになった"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "昨年度の寄附金額の伸びは、このお取り寄せ需要による効果が影響したものとは考えております"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "寄附者の利便性を高めるように、御自宅まで毎月定期的に届けられるようにというようなことの定期便、これを充実をさせていただいたり"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "主力の返礼品であるお米以外の返礼品開発にも力を入れてラインナップを充実してきた"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "昨年度あたりからは、ふるさと納税に参画したいということで自ら申し出てくださる事業者も増えてきたところでございます。この要因としては、サンロクのコンシェルジュ、担当職員、それからふるさと納税業務の委託事業者、この３者が、返礼品提供事業者を直接訪問したり、ウェブでのミーティングを開催させていただいたりしながら事業者支援をしてきた効果が大きい"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "このアドバイスを受けた事業者の中には、返礼品のお米を発送日当日に精米することにこだわったり、その情報をサイト上で上手に伝えることで、多くの方々に選んでいただける機会が増大した"@ja.
<< kg:id_5 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "ガバメントクラウドファンディングは、寄附の使い道をより具体的にプロジェクト化し、プロジェクトに共感をいただいた方から御寄附を募る仕組みでございます"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "市の施策を応援していただくガバメントクラウドファンディング型のふるさと納税は、市の特徴的な取組のＰＲになる"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "寄附された方の思いをより明確に反映できる"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "企業版ふるさと納税が財源調達の新たな選択肢の一つとなったことを表している"@ja.
<< kg:id_58 prop:cause kg:id_59 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "67.7％の企業が、自治体からの寄附の依頼があったことが寄附のきっかけになったと回答"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "多数の寄附を集めている自治体は、出身者が経営している企業、ほかの取組で既に連携している企業、あるいは立地企業、こういった企業に対して寄附を呼びかけている例が多いと。まずは、企業に様々な方法でアプローチすることで、企業版ふるさと納税の推進を図りたい"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "ふるさと納税を通じて酒田ファンを増やすため、寄附者の希望に応じて観光情報や地域情報などの提供を行うことで、酒田をより身近に感じてもらえるように取り組んでいきたい"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "楽天ふるさと納税を通じた寄附者には、このサイトの機能で定期的にメルマガの配信を行っております。総務省の指導もございまして、その配信の内容の半分以上は、返礼品以外の情報にしております"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "市としては、総務省からの通達に基づいて、その都度示された基準に適合するよう対応してきており、今後の見直しに対しても当然対応していきたい"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "もし将来的に制度が廃止された場合であっても、事業者が収益を確保できるよう、返礼品提供事業者のｅコマースへの取組を引き続き支援していきたい"@ja.
<< kg:id_70 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "御寄附をいただく際に御意見などをいただけるような、そんな仕組み、コメントなり、そういったものもちょっと充実させていければなと思った"@ja.
<< kg:id_72 prop:effect kg:id_73 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "昨年度の豪雪被害農家支援、こういったところを急遽させていただいて、目標の100万円の２倍以上の額が集まった"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "庁内全体でもう一度取り組めるような体制を少し考えていければと思います"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "武蔵野市でイベントがあるときなどは、イカのガバメントクラウドファンディングのチラシなども配布をさせていただいたことなどもございます。そういった機会を捉えて情報発信をしていければと思っております"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "地域外の方が、局所的に自分の生まれた町と、議員のお話を伺うと、それは非常にふるさと納税の本旨に合った取組なのかな"@ja.
<< kg:id_80 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "ガバメントクラウドファンディングの活用だとか、あと、ふるさと納税制度、課題が結構ありますけれども、仮に、制度改正になって返礼品が撤廃された、税金の控除が引き下げられた場合、しかし、財源、地域活性化のためには必要な事業と思いますので、後手後手にならないような形での課題検討をお願いし"@ja.
}
