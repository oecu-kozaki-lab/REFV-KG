kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "感染拡大が進み社会生活や地域経済に大きな影響を与えていると認識する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "社会生活や地域経済が大きな影響を受け続けていると述べる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "基本的な感染防止対策の徹底を市民に求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "追加接種と子どもへの接種準備を進める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "将来の公共施設の維持に向けた財源確保のため新たな基金を設ける"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "児童生徒が安心して学べる環境整備を進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "農林水産業を取り巻く環境が厳しいと認識する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "農林水産業を取り巻く環境が厳しいと認識する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "財政運営が一層厳しさを増していると述べる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "人口減少の中で新たな挑戦が必要とみる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "市民一人一人の属性に合わせた情報のやり取りができる仕組みを整える"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "デジタル技術を活用し産官学民の協働で地域課題解決を進める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "行政課題として協働事業で取り組む"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "行政課題として協働事業で取り組む"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "行政課題として協働事業で取り組む"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "児童生徒指導上の課題がますます複雑化しているとみる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "迅速かつ適切に対応するため相談体制を整える"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "相談支援体制の充実を図る"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "端末を効果的に活用し個別最適化された学習を進める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "令和6年度完成を目指し新たな給食室を整備する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "人口減少で大学の学生確保が厳しくなるとみる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "大学存続のため早期公立化に取り組む"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "資金繰り支援を継続する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "小規模事業者支援を継続する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "再生可能エネルギー導入で地域経済の好循環を目指す"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "国県地元企業と連携して進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "若者と市内企業をつなぎ地元定着を促進する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "米価下落で作付転換が必要とみる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "米価下落の背景にコロナ禍の影響があると述べる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "地域資源を循環させる持続可能な農業を推進する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "農地管理体制が弱体化していると認識する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "農地管理体制が弱体化していると認識する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "管理費増大への対応が必要とみる"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "施設老朽化が著しいため事業推進を強める"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "促進協議会の活動を展開し土地改良事業を進める"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "相談者の状況に応じた移住支援を行う"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "稼ぐ観光地域づくりに向け戦略的に取り組む"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "受入れ再開に向け準備を進める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "県と連携し受入れ態勢を整える"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "航空需要が落ち込んだ厳しい状況が続いていると述べる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "担い手不足が大きな課題と認識する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "若年人口減少で高齢化率が上昇していると述べる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "経済的負担軽減のため3年連続で税率を引き下げる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "結婚希望者への支援を強化する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "安心して不妊治療を受けられるよう助成を継続する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "引き続き保育料負担を軽減する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "増加するニーズに対応できる体制を整える"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "希望する全ての方が安心して接種できる体制を整える"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "接種希望者が安心して接種できる体制を整える"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "地域と行政で基本理念を共有する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "令和5年度中の移転を目指す"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "循環型社会実現のため減量施策を進める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "引き続き情報伝達手段の普及を進める"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "防災情報の迅速な提供と早期避難行動を促す"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "資機材整備と研修で地域防災力向上を図る"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "危険老朽空き家の解消と適正管理を進める"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "空き家等対策計画に基づき総合的かつ計画的に対策を進める"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "公共交通の充実を図る"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "公共交通の充実を図る"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "利便性向上と感染防止を図る"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "高速通信基盤を生かし情報環境を向上させる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:op_62 prop:content "新技術で課題解決に取り組む"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "新技術で生活課題解決に取り組む"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:op_64 prop:content "民間主導の再生方向性検討を支援する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "鉄道事業者の経営環境は非常に厳しいと認識する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_1.
kg:op_66 prop:content "浸水被害解消に向け道路施設を改修する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_1.
kg:op_67 prop:content "計画的に更新を進める"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "計画的な更新を行う"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_1.
kg:op_69 prop:content "山形県に粘り強く要望する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_1.
kg:op_70 prop:content "経営効率化に努める"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_1.
kg:op_71 prop:content "ウェブで完結する手続を目標に進める"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
kg:op_72 prop:content "普及と利用拡大を図る"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_1.
kg:op_73 prop:content "労働生産性向上と市民サービス向上を図る"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_1.
kg:op_74 prop:content "業務効率化と庁舎内スペース有効活用を図る"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_1.
kg:op_75 prop:content "予算編成は毎年度極めて厳しい状況にあると述べる"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_1.
kg:op_76 prop:content "将来的な行政サービス維持に向け取捨選択を行う"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_1.
kg:op_77 prop:content "限られた財源の中で歳出抑制を行う"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_1.
kg:op_78 prop:content "繰越金の状況を踏まえて負担金を見直す"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_1.
kg:op_79 prop:content "寄附金獲得など積極的な取組を強化する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_1.
kg:op_80 prop:content "歳入確保に精力的に取り組む"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_1.
kg:op_81 prop:content "歳入確保を強化する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_1.
kg:op_82 prop:content "将来の財政運営に資する財政基盤を確立する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_1.
kg:op_83 prop:content "被保険者の負担軽減を図るため税額を改定する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_1.
kg:op_84 prop:content "子育て世帯の負担軽減につながる改正を行う"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_1.
kg:op_85 prop:content "入居しやすい制度に改める"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_1.
kg:op_86 prop:content "入居要件等を緩和する"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "世界的に猛威を振るう新型コロナウイルス感染症は、本年に入り本市においても感染拡大が進み"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "私たちの社会生活や地域経済はいまだ大きな影響を受け続けています"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市民の皆様には、手洗いや手指消毒、不織布マスクの着用、密閉・密集・密接の３密を避けるなど基本的な感染防止対策の徹底を引き続きお願いいたします"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "ワクチン接種に関しては、３回目の接種に加え、５歳から11歳までの子供たちへのワクチン接種に向けた準備も着々と進めています"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:text-txt_contents "石綿含有追加調査による除去作業の増加"@ja.
<< kg:id_6 prop:cause kg:id_8 >>
    prop:text-txt_contents "解体発生材の精査による数量の増加"@ja.
<< kg:id_6 prop:effect kg:id_9 >>
    prop:text-txt_contents "請負金額及び工期を変更するため"@ja.
<< kg:id_6 prop:effect kg:id_10 >>
    prop:text-txt_contents "請負金額及び工期を変更するため"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:text-txt_contents "酒田市大浜コミュニティ防災センターの所期の目的を達成したため"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:text-txt_contents "条例を廃止するものであり"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:text-txt_contents "押印等を求める手続を見直し、押印等を不要とするため、関係条例の整備を行うものであり"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "公共施設等整備基金を創設するため"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:text-txt_contents "飛島辺地及び日向辺地に係る公共的施設の総合整備計画を変更するため"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:text-txt_contents "県道路事業及び市道路改良事業に伴う周辺路線の再編を行うため"@ja.
<< kg:id_20 prop:cause kg:id_22 >>
    prop:text-txt_contents "県道路事業及び市道路改良事業に伴う周辺路線の再編を行うため"@ja.
<< kg:id_20 prop:countermeasure kg:id_23 >>
    prop:text-txt_contents "市道路線を廃止"@ja.
<< kg:id_20 prop:countermeasure kg:id_24 >>
    prop:text-txt_contents "市道路線を廃止及び認定することについて"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:text-txt_contents "債務者の生活困窮により徴収が困難となった債権"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:text-txt_contents "徴収が困難となった債権"@ja.
<< kg:id_25 prop:countermeasure kg:id_28 >>
    prop:text-txt_contents "債権を放棄するため"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:text-txt_contents "県営坂野辺地区土地改良事業の施行に伴い"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:text-txt_contents "当該地区の字の区域及び名称を変更することについて"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:text-txt_contents "国の補正予算による経済対策への対応"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:text-txt_contents "長引く新型コロナウイルス感染症の影響に係る支援"@ja.
<< kg:id_32 prop:cause kg:id_35 >>
    prop:text-txt_contents "昨年末からの降雪・寒波による除雪費不足への対応について専決処分した"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:text-txt_contents "年明けからの降雪・寒波による除雪費不足への対応"@ja.
<< kg:id_36 prop:cause kg:id_38 >>
    prop:text-txt_contents "ふるさと納税寄附金の増額による返礼品関連経費不足への対応"@ja.
<< kg:id_1 prop:effect kg:id_39 >>
    prop:text-txt_contents "新型コロナウイルス感染症の影響を受けた市指定管理施設"@ja.
<< kg:id_1 prop:countermeasure kg:id_40 >>
    prop:text-txt_contents "減収に対する補填を行うものであります"@ja.
<< kg:id_41 prop:countermeasure kg:id_17 >>
    prop:text-txt_contents "令和３年度普通交付税の追加交付分を財源に将来の公共施設等の改修などに活用するため、公共施設等整備基金の創設"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:text-txt_contents "除雪回数の増加見込みによるやさしいまちづくり除雪援助事業費の増額"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:text-txt_contents "令和２年度の国庫負担金の額の確定に伴う障がい福祉サービス給付事業費などの償還金の増額"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:text-txt_contents "燃料価格の高騰に伴う斎場管理運営事業費の増額"@ja.
<< kg:id_46 prop:effect kg:id_48 >>
    prop:text-txt_contents "燃料価格の高騰による市指定管理施設への委託料の増額"@ja.
<< kg:id_1 prop:effect kg:id_49 >>
    prop:text-txt_contents "新型コロナウイルス感染症の影響でイベント等が中止・縮小された"@ja.
<< kg:id_1 prop:effect kg:id_50 >>
    prop:text-txt_contents "イベント等が中止・縮小されたことによる観光戦略・インバウンド推進事業費の減額"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:text-txt_contents "降雪・寒波により除雪費が不足したこと"@ja.
<< kg:id_51 prop:effect kg:id_53 >>
    prop:text-txt_contents "降雪・寒波により除雪費が不足したことによる除雪事業費の増額"@ja.
<< kg:id_51 prop:effect kg:id_54 >>
    prop:text-txt_contents "降雪・寒波により除雪費が不足したことによる除雪事業費及び克雪支援事業費の増額"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:text-txt_contents "国の補正予算に伴う交付金対象事業となる舗装改良事業費の増額"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "児童・生徒がコロナ禍にあっても安心して学ぶことができる環境を整備するため、学校等における感染症対策等支援事業費の新たな計上"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:text-txt_contents "後年度負担の軽減を目的に市債の繰上償還を実施するため"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "米価下落や水揚げ量の減少といった農林水産業を取り巻く厳しい環境"@ja.
<< kg:id_63 prop:effect kg:id_62 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "米価下落や水揚げ量の減少といった農林水産業を取り巻く厳しい環境"@ja.
<< kg:id_64 prop:effect kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "公共施設の維持管理費用の増嵩など、本市の財政運営は一層厳しさを増しています"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "人口減少が進む中、コロナ禍からの脱却を目指して果敢なチャレンジが求められる令和４年度となります"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "市民との市政情報の共有が不可欠です。分かりやすく正確な情報を迅速に発信するツールとして、酒田市デジタル変革戦略に基づき、ウェブ上で市民一人一人の属性に合わせた情報のやり取りを可能とする市民マイページの開発を行う"@ja.
<< kg:id_70 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "多様化する地域課題を解決するため、市民のワークショップで抽出した地域課題を、デジタル技術を活用して産官学民の協働により解決につなげる酒田リビングラボの取組を進めます"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "フードロス削減、障がい者アート普及、子育ての不安を持つ人に寄り添う支援の３つの行政課題については、新たな市民協働・公益活動推進制度の協働事業として取り組みます"@ja.
<< kg:id_74 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "フードロス削減、障がい者アート普及、子育ての不安を持つ人に寄り添う支援の３つの行政課題については、新たな市民協働・公益活動推進制度の協働事業として取り組みます"@ja.
<< kg:id_75 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "フードロス削減、障がい者アート普及、子育ての不安を持つ人に寄り添う支援の３つの行政課題については、新たな市民協働・公益活動推進制度の協働事業として取り組みます"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "いじめや不登校などをはじめとする児童生徒指導上の課題は、ますます複雑化しています"@ja.
<< kg:id_76 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "専門家への相談体制を整えるなど、課題に迅速かつ適切に対応していきます"@ja.
<< kg:id_76 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "教育相談専門員を、小中学校にスクールカウンセラー及び教育相談員を配置することにより、体制の充実を図ります"@ja.
<< kg:id_80 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "児童生徒一人一人に整備したＧＩＧＡスクール端末を効果的に活用するため、より個別最適化された学習を行うことができる学習ソフトや協働学習支援ツールを導入します"@ja.
<< kg:id_82 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "老朽化が著しい酒田市学校給食共同調理場については廃止を見据え、令和６年度の完成を目指して南平田小学校へ新たに給食室を整備します"@ja.
<< kg:id_84 prop:cause kg:id_85 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "今後、18歳以下の人口が減少していく中で、学生の確保が一段と厳しくなることが予想されています"@ja.
<< kg:id_86 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "大学が存続していくためにも、設置者である山形県と庄内２市３町が連携して早期の公立化に向けて取り組みます"@ja.
<< kg:id_88 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "コロナ禍の影響を受けた中小企業者及び小規模事業者の資金繰りを支援します"@ja.
<< kg:id_88 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "本市独自の元気な小規模事業者持続化特別助成金の支給など、引き続き小規模事業者の支援に努めます"@ja.
<< kg:id_91 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "2050年カーボンニュートラルの実現に貢献するため、再生可能エネルギーの導入により地域経済の好循環を実現する再生可能エネルギー循環都市の形成を目指します"@ja.
<< kg:id_93 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "洋上風力発電事業の拠点となる基地港湾の指定と、次世代エネルギーの導入を見据えた酒田港カーボンニュートラルポートの形成に向けて、国・山形県、地元企業と連携して進めます"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "若者の早期離職防止及び地元定着促進のため、市内企業見学ツアーを実施し、酒田で働きたい若者と人材を確保したい市内企業をつなぎます"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "コロナ禍の影響により米価は下落基調にあるため、主食用米から一層の作付転換が求められています"@ja.
<< kg:id_97 prop:cause kg:id_99 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "コロナ禍の影響により米価は下落基調にあるため"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "耕種農家が、今年新たに稼働する大規模畜産農家へ飼料作物を供給するとともに、畜産農家の堆肥や液肥を活用する耕畜連携の仕組みを新たに構築し"@ja.
<< kg:id_102 prop:effect kg:id_103 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "農村の高齢化や混住化によって地域の農地管理体制が弱体化し"@ja.
<< kg:id_104 prop:effect kg:id_103 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "農村の高齢化や混住化によって地域の農地管理体制が弱体化し"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "近年の気象変動による豪雨災害の多発化で土地改良施設管理費も増大傾向にあります"@ja.
<< kg:id_107 prop:cause kg:id_108 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "最上川下流右岸地区の農業水利施設の老朽化が著しい"@ja.
<< kg:id_109 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "最上川下流右岸地区土地改良事業促進協議会の活動を展開するほか、土地改良事業の推進に力を入れていきます"@ja.
<< kg:id_111 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "近年の地方移住ニーズの高まりを契機として、子育て世代などをターゲットに、暮らし体験、移住相談、移住費用への補助、移住後のフォローアップ"@ja.
<< kg:id_113 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "観光振興については、（仮称）酒田ＤＭＯを設立し、コロナ禍後の交流人口の拡大と稼ぐ観光地域づくりに向けた戦略的な取組を進めます"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "令和２年度、令和３年度と酒田港へのクルーズ船の寄港はありませんでした。令和４年度は、受入れ再開に向けて"@ja.
<< kg:id_117 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "国の感染症予防対策ガイドラインに沿った受入れ態勢の構築と、山形県と連携しておもてなしの準備を進めます"@ja.
<< kg:id_57 prop:effect kg:id_119 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "コロナ禍により航空需要が落ち込んだ状態が続く厳しい状況となっています"@ja.
<< kg:id_120 prop:cause kg:id_121 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "地域福祉活動を支える担い手不足が大きな課題となっています"@ja.
<< kg:id_122 prop:cause kg:id_123 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "65歳未満の人口は年間で1,000人以上も減少していることから、高齢化率は令和３年12月末時点で36.5％に上昇しており"@ja.
<< kg:id_124 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "コロナ禍における市民の経済的負担を軽減するため、国民健康保険財政調整基金を活用し、３年連続で国民健康保険税の税率を引き下げます"@ja.
<< kg:id_126 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "結婚の希望をかなえるため、酒田市結婚サポートセンターによる相談対応、仲介及び婚活イベントの実施に加えて、結婚に伴う新生活に係る費用を助成します"@ja.
<< kg:id_128 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "子供を希望する夫婦が安心して不妊治療を受けることができるよう、医療保険の適用範囲を見定め、継続して助成を行います"@ja.
<< kg:id_130 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "国の幼児教育・保育の無償化の対象とならない２歳児以下の保育料の負担軽減を図ります"@ja.
<< kg:id_132 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "増加するニーズへ対応できる体制を整えるため、引き続き保育人材の確保に努めます"@ja.
<< kg:id_134 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "新型コロナウイルスワクチンの接種については、３回目の接種を実施するとともに、これから１回目、２回目の接種を受ける方も並行して対応します"@ja.
<< kg:id_134 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "ワクチン接種を希望する全ての方が安心して接種できるよう、予約から接種まで円滑に実施できる体制を整えます"@ja.
<< kg:id_137 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "市民部まちづくり推進課の地域づくり支援体制を強化し、（仮称）地域コミュニティまちづくり協働指針の策定に取り組み"@ja.
<< kg:id_139 prop:countermeasure kg:id_140 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "老朽化した内郷コミュニティセンターについては、旧内郷小学校への移転に向けて施設の改修を進め"@ja.
<< kg:id_141 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "依然、山形県内13市の中で最も多い状況にあります。循環型社会の実現のため、紙類資源の適正な分別や事業系ごみの減量について"@ja.
<< kg:id_143 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "災害時の情報伝達については、引き続き防災ラジオを低価格な有償貸与方式で頒布を進めます"@ja.
<< kg:id_143 prop:countermeasure kg:id_145 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "防災行政無線操作卓を更新し、ホームページやＳＮＳとの情報連携を図り、防災情報の迅速な提供と災害時の要配慮者などの早期避難行動を促します"@ja.
<< kg:id_146 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "消防本部・消防署敷地内への防災倉庫の建設や移動式エアコンなど各種防災資機材の導入を進めるとともに、これらを活用した避難所運営に関する研修を開催するなど、地域防災力の向上を図ります"@ja.
<< kg:id_148 prop:effect kg:id_149 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "そのまま放置すれば危険となるおそれのある管理不全な空き家や空き地"@ja.
<< kg:id_148 prop:countermeasure kg:id_150 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "空き家の利活用の促進、危険老朽空き家などの解消・適正管理など、総合的かつ計画的に空き家対策を進めます"@ja.
<< kg:id_151 prop:countermeasure kg:id_152 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "令和４年８月１日の酒田駅前交流拠点施設ミライニのグランドオープンに合わせて、るんるんバスなどの路線を全面的に改編します"@ja.
<< kg:id_153 prop:countermeasure kg:id_154 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "浜中、黒森、十坂、八幡、平田の５つの地域等をデマンドタクシーの運行エリアに追加することにより、公共交通の充実を図ります"@ja.
<< kg:id_1 prop:countermeasure kg:id_155 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "キャッシュレス決済を拡充し、利便性向上と新型コロナウイルス感染症の感染防止を図ります"@ja.
<< kg:id_156 prop:countermeasure kg:id_157 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "島内に公衆無線ＬＡＮのアクセスポイントを設置し、観光客の利便性や災害時などの情報収集力の向上を図ります"@ja.
<< kg:id_158 prop:countermeasure kg:id_159 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "情報通信技術やｅモビリティなどの新技術を導入し、労働力不足や買物弱者対策などの課題解決に取り組みます"@ja.
<< kg:id_160 prop:countermeasure kg:id_159 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "情報通信技術やｅモビリティなどの新技術を導入し、労働力不足や買物弱者対策などの課題解決に取り組みます"@ja.
<< kg:id_161 prop:countermeasure kg:id_162 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "民間主導で再生の方向性が検討されていることから、再生事業が進むよう支援をします"@ja.
<< kg:id_163 prop:cause kg:id_164 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "新型コロナウイルス感染症拡大の影響により、鉄道事業者を取り巻く経営環境は非常に厳しい状況となっています"@ja.
<< kg:id_165 prop:countermeasure kg:id_166 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "市街地で頻発する浸水被害の解消を図るため、道路施設の改修を行います"@ja.
<< kg:id_167 prop:countermeasure kg:id_168 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "老朽化した京田ポンプ場の受電設備を更新します"@ja.
<< kg:id_169 prop:countermeasure kg:id_170 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "家際雨水ポンプ場の電気設備の大規模改修に着手するなど、計画的な更新を行います"@ja.
<< kg:id_171 prop:countermeasure kg:id_172 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "庄内地方でのライフラインの安定した経営を確保するため、山形県庄内広域水道用水供給事業と、本市、鶴岡市及び庄内町が運営する末端給水事業との垂直・水平統合の実現を山形県に粘り強く要望します"@ja.
<< kg:id_173 prop:countermeasure kg:id_174 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "水洗化率のさらなる向上や経費節減など経営の効率化に努めます"@ja.
<< kg:id_175 prop:countermeasure kg:id_176 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "行政のデジタル変革を進め、「ウェブで完結、酒田市の手続」を目標に行政手続のオンライン化を進めます"@ja.
<< kg:id_177 prop:countermeasure kg:id_178 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "休日申請窓口の開設や、企業・団体への出張による申請受付を行い、その普及に努める"@ja.
<< kg:id_179 prop:countermeasure kg:id_180 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "市職員の労働生産性の向上を図るため、スマートワークの導入を推進します"@ja.
<< kg:id_181 prop:countermeasure kg:id_182 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "文書管理システムの導入によりペーパーレス化を推進するとともに、業務効率化及び庁舎内スペースの有効活用を図ります"@ja.
<< kg:id_183 prop:effect kg:id_184 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "本市の財政は、恒常的に歳出の水準が歳入の水準を上回る構造となっており、予算編成は毎年度極めて厳しい状況にあります"@ja.
<< kg:id_185 prop:countermeasure kg:id_186 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "実施すべき行政サービスの将来的な維持に向け、事業や経費の取捨選択を行いました"@ja.
<< kg:id_185 prop:countermeasure kg:id_187 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "本市が実施するイベントについては必要最低限の予算とし"@ja.
<< kg:id_185 prop:countermeasure kg:id_188 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "各団体への負担金についても繰越金の状況を踏まえて一部削減を実施しています"@ja.
<< kg:id_189 prop:countermeasure kg:id_190 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "新たにふるさと納税係を設置し、ふるさと納税による寄附金獲得などの積極的な取組を強化します"@ja.
<< kg:id_189 prop:countermeasure kg:id_191 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "未利用財産の売払いや風力発電事業の売電収益など、歳入確保にも精力的に取り組みます"@ja.
<< kg:id_189 prop:countermeasure kg:id_192 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "未利用財産の売払いや風力発電事業の売電収益など、歳入確保にも精力的に取り組みます"@ja.
<< kg:id_193 prop:countermeasure kg:id_194 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "将来の公共施設の維持に向けた財源確保のための新たな基金を設けるなど、今後の財政運営に資する財政基盤の確立に努めます"@ja.
<< kg:id_195 prop:countermeasure kg:id_196 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "国民健康保険税について被保険者の負担軽減を図るため、基礎課税額及び後期高齢者支援金等課税額の各割額を改定する"@ja.
<< kg:id_195 prop:countermeasure kg:id_197 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "未就学児に係る均等割額の減額措置を追加する"@ja.
<< kg:id_198 prop:countermeasure kg:id_199 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "市営住宅の入居要件と連帯保証人の要件を緩和するため"@ja.
<< kg:id_200 prop:countermeasure kg:id_199 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "公共賃貸住宅の入居要件と連帯保証人の要件を緩和するため"@ja.
}
