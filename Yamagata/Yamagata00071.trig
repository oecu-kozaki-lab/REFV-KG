kg:id_91 rdfs:label "健診結果と質問票によるフレイルチェック"@ja.
kg:id_91 rdf:type cls:c_3673.
cls:c_3673 rdfs:label "状態確認"@ja.
kg:id_84 prop:countermeasure kg:id_91.
kg:id_92 rdfs:label "地域包括支援センターの定期訪問と情報共有"@ja.
kg:id_92 rdf:type cls:c_2535.
cls:c_2535 rdfs:label "訪問支援"@ja.
kg:id_84 prop:countermeasure kg:id_92.
kg:id_93 rdfs:label "サルコペニア"@ja.
kg:id_93 rdf:type cls:c_3674.
cls:c_3674 rdfs:label "筋力低下"@ja.
kg:id_94 rdfs:label "加齢や疾患による筋肉量や食事摂取量の減少"@ja.
kg:id_94 rdf:type cls:c_3675.
cls:c_3675 rdfs:label "加齢疾患"@ja.
kg:id_93 prop:cause kg:id_94.
kg:id_95 rdfs:label "寝たきりや転倒・骨折のリスク増加"@ja.
kg:id_95 rdf:type cls:c_3676.
cls:c_3676 rdfs:label "転倒骨折"@ja.
kg:id_93 prop:effect kg:id_95.
kg:id_96 rdfs:label "通いの場での専門職による予防講座"@ja.
kg:id_96 rdf:type cls:c_3677.
cls:c_3677 rdfs:label "予防講座"@ja.
kg:id_93 prop:countermeasure kg:id_96.
kg:st_1 rdfs:label "齋藤直議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "コロナ禍の生活不安が結婚や妊娠を控える傾向につながったとみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "出生数の低下が年々進んでいることを懸念している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "次世代につなぐ課題として子育てしやすい環境づくりが必要だと考える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_4 prop:content "計画の一部は感染拡大や予防対策の影響を受けたと説明する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "多くの事業は継続したが一部は未実施や縮小になったと説明する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "会議での協議を踏まえ計画推進を続ける考えを示す"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "第4波や第5波と比べて急激に増えたと認識している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "保育施設と同様に学童保育所でも急増したと述べる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "学校現場でも休業措置が相次いだと説明する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "マニュアルに基づき各施設が実情に応じた対策を講じていると説明する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "学校と対策内容を再確認して感染防止を徹底している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "換気を基本対策として重視している"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "昼食時の感染対策を徹底している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "発声を伴う近距離活動を制限している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "判定が出る頃には園再開に至ることが多く実際の稼働に至っていないと説明する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "限定的な制度で働く保護者に十分活用されていないことを課題視している"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "国通知を参考に要綱を制定して対応している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "新たな養育者に給付が届かないケースへ速やかな対応が必要だと考える"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "離婚等で新たに養育者となった方への支援制度を案内していく"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "収束の兆しが見えない中でひとり親世帯への支援強化が必要だと考える"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "財政支援や何らかの支援を行うべきだと考える"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "児童扶養手当受給者等に対し継続して給付を行っている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "保育施設閉所や学校休校による家庭環境の変化に注意している"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "子供の命と人権を守るため迅速で的確な対応が必要だとする"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "関係機関と密接に連携して相談支援を実施している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "通告があった場合は速やかに安全確認を行っている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "切れ目や段差のない支援を目指している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:st_3 rdfs:label "藤井昌道建設部長"@ja.
kg:st_3 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_28 prop:content "本市の気象条件が劣化を早める特色だと認識している"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "塩害も劣化を早める要因だと説明する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "20年後には約82％が建設後50年超となり大きな課題になるとする"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "老朽化の集中で維持管理費の増大が課題になると認識している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "事後保全だけでなく予防保全型管理が必要だと考えている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "ドローンや画像診断など新技術活用でコスト縮減を図る"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "手間のかからない橋梁への転換を進める考えを示す"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "集約や撤去も含めて維持管理を進める必要があるとする"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:st_4 rdfs:label "齋藤一志教育次長"@ja.
kg:st_4 rdf:type cls:st_48.
cls:st_48 rdfs:label "教育次長"@ja.
kg:op_36 prop:content "私立高や高専への進学が大きな要因の一つだと分析する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "私立高への金銭的負担が県立と同程度になり進学者増加につながったとみる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "学校の魅力向上が進学先としての選択につながったと考える"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "酒田市内での志願動向の変化も公立高の倍率低下要因だと分析する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "庄内中高一貫校の開校で超過数がさらに拡大し地域に影響すると考える"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "地域課題解決型学習などを後押しして高校魅力化を図る考えを示す"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:op_42 prop:content "地元を離れても酒田への誇りや愛着を持てることが重要だと考える"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:op_43 prop:content "地元に戻った時に安心して生活できるよう雇用創出が必要だとする"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:st_5 rdfs:label "那須欣男総務部危機管理監"@ja.
kg:st_5 rdf:type cls:st_56.
cls:st_56 rdfs:label "危機管理監"@ja.
kg:op_44 prop:content "公共施設休館や営業時間短縮で社会経済活動に影響があったと認識している"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
kg:op_45 prop:content "感染力が強く高齢者や児童への感染が心配されたため休館したと説明する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_5.
kg:op_46 prop:content "庄内2市3町で歩調を合わせ一体的な対策を講じたと説明する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_5.
kg:op_47 prop:content "1月末段階で感染拡大防止の観点から停止が必要と判断した"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "保健所長の指導と県通知を受け活動停止とした"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:op_49 prop:content "小学生年代の接種状況が活動再開判断に影響している"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "異学年交流によるリスクの高さから停止継続としている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "保健所指導と県の意向を踏まえ学校単位閉鎖を実施した"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:op_52 prop:content "学校単位閉鎖がクラスター発生抑制の大きな理由と考えている"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:op_53 prop:content "要望の中には降雪状況から対応困難なものも多いと説明する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "作業の性質上どうしても避けられない要望もあると認識している"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "窓口や電話や現場で対応に苦慮していると述べる"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "よくある質問や特集などで理解を深めたい考えを示す"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:op_57 prop:content "自治会長向け説明会で作業内容や支援制度を説明している"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_3.
kg:op_58 prop:content "広報折り込みやホームページで協力を呼びかけている"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_3.
kg:op_59 prop:content "他の会社へ協力依頼するなどしながら対応した"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_3.
kg:op_60 prop:content "建設部以外も動員し雪玉潰しや横断歩道閉塞解消に当たった"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_3.
kg:op_61 prop:content "課題はあるがマンパワー確保の選択肢として検討していきたい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:st_6 rdfs:label "白畑真由美健康福祉部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_62 prop:content "コロナ禍の過度な行動自粛で体力と気力の低下が危惧されたと説明する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_6.
kg:st_7 rdfs:label "佐藤喜紀議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_63 prop:content "要介護状態に至る前段階として早期発見と予防が重要だと捉えている"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_7.
kg:op_64 prop:content "閉じこもり長期化で認知症進展が懸念されると問題視している"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_7.
kg:op_65 prop:content "家庭でできる運動や口腔ケアを各種媒体で紹介している"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_6.
kg:op_66 prop:content "自宅でも実践できるようDVD配布やYouTube公開を行っている"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_6.
kg:op_67 prop:content "通いの場は介護予防と地域づくりの重要な拠点と認識している"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_6.
kg:op_68 prop:content "データ分析を通じ地域の健康課題把握と早期発見につなげていく"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_6.
kg:op_69 prop:content "健診データや訪問を通じ要介護化を防ぐ取組を進める"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_6.
kg:op_70 prop:content "寝たきりや転倒骨折のリスク増大につながるため予防が必要だと考える"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_7.
kg:op_71 prop:content "身体能力低下による生活機能悪化を懸念している"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_7.
kg:op_72 prop:content "運動・口腔・栄養の専門職を派遣し予防講座を実施している"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_6.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "新型コロナウイルスの感染拡大が広がり、コロナ禍による生活不安などで結婚や妊娠を控える傾向があったのではないかと分析をしております"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "先月、国の速報値として発表した2021年の出生数は84万人と過去最低となり、年々数字は低くなっております"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本市においては人口減少、少子高齢化が今後予測され、様々な課題がある中で、安心して子供を産み育てやすい環境づくりをする施策は、次世代につなぐ課題と思っております"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "新型コロナウイルス感染症の感染拡大や予防対策のため、実施ができなかった、あるいは縮小して実施したなど、新型コロナウイルス感染症の影響を受けた取組内容が全体の約15％に上がっていることが特徴でございます"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "実施ができなかった、あるいは縮小して実施したなど、新型コロナウイルス感染症の影響を受けた取組内容が全体の約15％に上がっている"@ja.
<< kg:id_6 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "今後も、子ども・子育て会議における協議等を踏まえながら、計画を実効的に推進してまいりたいと考えております"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "１月からの新型コロナウイルス感染症第６波の影響としては、保育関係が34施設、学童保育所が35施設といった具合に第４波や第５波に比較して急激に増えている現状でございます"@ja.
<< kg:id_10 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "１月からの新型コロナウイルス感染症第６波の影響としては、保育関係が34施設、学童保育所が35施設といった具合に第４波や第５波に比較して急激に増えている現状でございます"@ja.
<< kg:id_10 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "１月からの新型コロナウイルス感染症第６波の影響によりまして、本市の小中学校でも、これまで延べ43校の臨時休業、それから２校の学年閉鎖の措置が取られたところでございます"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "保育所等・学童保育所向けの新型コロナウイルス感染症対策マニュアル、このマニュアルに沿って、手指衛生や換気の徹底、飲食の際の注意事項の遵守などの対応をしているところでございます"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "クラス内感染防止対策チェックリストによりまして、実施すべき対策内容を学校と再確認をしているところでございます"@ja.
<< kg:id_16 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "具体的には、１時間に１ないし２回程度の換気の実施"@ja.
<< kg:id_16 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "昼食時の同一方向を向いての黙食"@ja.
<< kg:id_16 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "近距離で一斉に大きな声で話す活動の停止"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "保健所での濃厚接触者やＰＣＲ検査対象者の判定が出るまでは、代替保育を利用することは難しいと考えておりまして、濃厚接触者等の判定ができ、感染拡大の危険性がないとなった段階で、園を再開している現状からしますと、実際のところ代替保育の稼働までには至っていない"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "実際のところ代替保育の稼働までには至っていないというのが現状でございます"@ja.
<< kg:id_23 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "酒田市新型コロナウイルス感染症による保育所等の臨時休園に伴う代替保育事業実施要綱という長い名称の要綱ですが、この要綱を令和３年１月15日に制定をしたところでございます"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "９月以降に離婚をし、子供を養育している人の中に給付金が元の養育者に振り込まれ、育てている養育者が受け取れない"@ja.
<< kg:id_26 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "２月には、一括給付金の基準日より後に、離婚等によって新たに対象児童の養育者となっている方への支援として、支援給付金という制度が設けられました"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "いまだに収束の兆しが見えない長引くコロナ禍の中で、困窮するひとり親世帯"@ja.
<< kg:id_29 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "困窮するひとり親世帯に対して、財政支援、または何らかの形で支援をするべきと考えます"@ja.
<< kg:id_29 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "今年度は、令和２年度に続き、国庫補助事業による子育て世帯生活支援特別給付金の支給を行っております"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "保育関係施設の閉所や学校の休校により、家庭環境の変化から不適切な養育に至らないように"@ja.
<< kg:id_33 prop:effect kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "子供の命と人権を守るために、迅速で的確な対応を目指して、相談・支援を実施しているところでございます"@ja.
<< kg:id_33 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "子ども・家庭総合支援室が調整機関となって酒田市要保護児童対策地域協議会を運営をし、この協議会を構成する各関係機関と密接な連携によりまして"@ja.
<< kg:id_33 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "虐待の疑いの通告があった場合は、必要に応じて庄内児童相談所と連携をし、子ども・家庭総合支援室の職員が複数で48時間以内に目視で子供の安全確認を行い"@ja.
<< kg:id_33 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "子育て世代包括支援センターぎゅっととも連携を図り、妊娠期から予防的な視点での関わりを重視して、切れ目や段差のないきめ細やかな支援を目指して"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "本市は積雪寒冷地である上、海岸に近くて塩害、いわゆる塩の害ですけれども、この影響も受けるため、構造物の劣化が早い"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "海岸に近くて塩害、いわゆる塩の害ですけれども、この影響も受けるため、構造物の劣化が早い"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "建設後50年を経過する高齢化橋梁は現時点で161橋、約33％ありますが、20年後には402橋となって、約82％を占める"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "老朽化が顕在化するタイミングが集中するということから、係る経費の増大も大きな課題になってまいります"@ja.
<< kg:id_42 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "従来型の維持管理、いわゆる事後保全型管理だけではなくて、アセットマネジメントの概念に基づき、予防保全型管理も取り入れながら"@ja.
<< kg:id_42 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "コストの縮減対策としては、新技術を活用した補修を進めること、具体的にはドローン、それから画像診断を活用した点検"@ja.
<< kg:id_42 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "できるだけ手間のかからない橋梁へ架け替えを進めること、カルバート橋への架け替えです"@ja.
<< kg:id_42 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "橋梁の集約・撤去についても進めていく"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "この要因についてですが、一つは鶴岡市の私立高等学校、高等専門学校への進学者が多いことが挙げられます"@ja.
<< kg:id_49 prop:cause kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "近年の国の高等学校等就学支援金制度の充実により、私立高等学校に係る金銭的な負担が県立高等学校とほぼ同程度になりました。このことから、私立高等学校への進学者が増加傾向にある"@ja.
<< kg:id_49 prop:cause kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "鶴岡南高等学校がスーパーサイエンスハイスクールというものに指定されて、恐らく県で今の形の探求型学習、一番最初にやったのが鶴岡南高等学校なんですけれども、探求型学習で先行したことなどにより、学校の魅力が増した"@ja.
<< kg:id_49 prop:cause kg:id_53 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "酒田南高校の生徒数は、令和２年から令和３年度にかけて入学生徒数が約40名増加しました。飽海地区の中学校３年生が年々減少する中で、この影響も公立高等学校が受けている"@ja.
<< kg:id_49 prop:effect kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "庄内中高一貫校、これは仮称になるわけですが、の開校により、この超過数はさらに拡大するものと考えており、本市のまちづくりに影響を与えるものとなると考えております"@ja.
<< kg:id_49 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "本市は市内全日制高等学校４校のうち３校と連携協定を結んでおり、この高等学校との連携協定を通じて地域課題の解決等の探求的な学びを後押しすることで、高校魅力化を図っていきたい"@ja.
<< kg:id_49 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "重要なことは自分たちのまち酒田に対する誇りや愛着を高める取組を行っていくことかなと考えております"@ja.
<< kg:id_49 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "地元に戻ったときに安心して生活できるように、良質な雇用の創出を図ることも必要でございます"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "本市でも公共施設の臨時休館や利用制限のほか、まん延防止等重点措置の期間中は飲食店等に営業時間の短縮を要請するなど、社会活動、経済活動に大きな影響があった"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "オミクロン株という感染力の強い株のため、基礎疾患を有する高齢者やワクチン未接種の児童・幼児等への感染が心配されたことから、コミュニティセンターや子育て支援センター等の公共施設を臨時休館した"@ja.
<< kg:id_60 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "コミュニティセンターや子育て支援センター等の公共施設を臨時休館したものであります。また、庄内２市３町が連携し、施設休館等について歩調を合わせ、一体となった対策を講じた"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "本市においては、小中学校で児童生徒の感染が広がってきた１月末の段階で、感染の拡大防止対策の観点から、中学校における部活動や小学校のスポーツ少年団の活動は停止してほしいという保健所長からの指導を受けました"@ja.
<< kg:id_63 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "保健所長からの指導を受けました。これを受けて早急に対応したものでございます。その後、県のまん延防止等重点措置の適用に伴う要請からも、本市は重点措置区域に該当し、部活動やスポ少において活動停止との通知を受け"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "ワクチン接種が他の年代と比べ進んでいないことや"@ja.
<< kg:id_66 prop:cause kg:id_68 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "異学年交流活動だということから感染リスクが高い"@ja.
<< kg:id_69 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "本市としては、保健所からの指導や周辺市町との状況を鑑み、一律学校単位での臨時休業措置を取ってきたところでございます"@ja.
<< kg:id_69 prop:effect kg:id_71 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "酒田市では学校におけるクラスターがほとんど発生しておりません。この大きな理由は学校単位の閉鎖にあると思います"@ja.
<< kg:id_72 prop:cause kg:id_73 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "こうした内容は、降雪の状況によっては早期かつ適期の作業が困難なものであったり"@ja.
<< kg:id_72 prop:cause kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "除雪の作業の性質上、どうしても避けられない事柄に対するものであったり"@ja.
<< kg:id_72 prop:effect kg:id_75 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "除雪協力会社や職員がその応対、窓口だったり電話だったり現場だったりしますけれども、そういったところで苦慮している状況"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "広報とかホームページ、またはＳＮＳの中で、例えば、よくある質問Ｑ＆Ａコーナー、こういったものを設けたり、あるいは特集を組んだりということも一案"@ja.
<< kg:id_76 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "毎年、地区自治会長を対象とした除雪説明会を開催し、作業内容や各種除雪支援制度"@ja.
<< kg:id_76 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "除雪への協力依頼を記載したチラシを毎年12月の広報に折り込むとともに、ホームページにも掲載した上で協力をお願いしている"@ja.
<< kg:id_80 prop:effect kg:id_81 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "作業手配の関係で手が回らない会社もありましたので、他の会社へ協力依頼するなど、そういったこともしながら対応してきた"@ja.
<< kg:id_80 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "建設部だけではなくて、全庁に動員依頼をかけさせていただいて、横断歩道の閉塞解消、いわゆるその雪で塞がったところの解消、それから大きな雪玉を潰す雪玉潰しの作業にも当たってもらう"@ja.
<< kg:id_80 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "雇用募集につきましても、さらなるマンパワー獲得という意味では大切な選択肢になってくると思います"@ja.
<< kg:id_84 prop:cause kg:id_85 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "外出や運動の機会が減少し、さらに過度の行動自粛により、体力と気力の低下が危惧されたため、高齢者のフレイル予防として各種媒体を活用した周知活動を行った"@ja.
<< kg:id_84 prop:effect kg:id_86 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "フレイルとは、高齢者の虚弱を意味し、要介護状態に至る前段階として位置づけられ"@ja.
<< kg:id_84 prop:effect kg:id_87 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "精神面や認知機能にも影響を及ぼすとされております。認知機能については、高齢者の閉じ籠りが長期化することで、軽度認知症へ進行し、認知症へ進展していくことが懸念されております"@ja.
<< kg:id_84 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "家庭でできるかんたん運動の紹介記事を市広報に掲載したり、ハーバーラジオでは、自宅で気軽にできる口腔ケアを介護保険課の歯科衛生士が紹介しております"@ja.
<< kg:id_84 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "下半身の運動と上半身の運動のＤＶＤを200枚作成をしていただき、希望する市民に無料で配布いたしました。これについては、現在も市のホームページから元気王国のユーチューブへリンクができるようにしておりまして"@ja.
<< kg:id_84 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "通いの場は、地域住民が主体となって参加し、生きがいや介護予防につながる活動を継続することで、地域住民の互助による支え合い活動の拠点となることを目指している"@ja.
<< kg:id_84 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "令和２年度から後期高齢者の健康診査では、質問票を用いたフレイル状態のチェックを行っております"@ja.
<< kg:id_84 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "地域包括支援センターの定期訪問など、健診データの個人分析等を共有し、できるだけ高齢者が要介護状態にならないように引き続き取り組んでまいります"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "加齢や疾患により筋肉量や食事の摂取量が減少することが要因とされており"@ja.
<< kg:id_93 prop:effect kg:id_95 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "寝たきりや転倒、骨折のリスクが増える状態のことであります"@ja.
<< kg:id_93 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "運動、口腔、栄養の専門職を通いの場に派遣し、予防講座を行っており、令和３年度は１月まで74回の講座を行った"@ja.
}
