kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "地域経済や市民生活を支援する施策を最優先に進める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "影響を受けた事業者に迅速な補助金交付を行う"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "市内消費喚起のためキャッシュレス決済導入を促進する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "次期作への営農意欲維持のため種子購入代金を支援する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "円滑な接種のため多様な予約方法を整える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "集団接種と個別接種を組み合わせて希望者への接種を進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "子育て世帯の生活支援のため児童1人当たり5万円を支給する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "子育て世帯への臨時特別給付として児童1人当たり10万円を支給する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "住民税非課税世帯等へ1世帯当たり10万円を支給する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "困難な状況にある人へ生理用品を無償配布する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "浸水対策として排水ポンプを更新する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "感染拡大対策として体表温測定機能ターミナルを設置する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "物価高騰による運営負担軽減のため各事業所等を支援する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "子供を望む方々の負担軽減のため助成制度を創設する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "国の方針に基づきオミクロン株対応ワクチン接種を進める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "クラスター発生時に感染拡大防止のための施設を借り上げ提供する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "感染防止のため施設に機器を設置する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "世界的に猛威を振るう新型コロナウイルス感染症拡大の防止に細心の注意を払い、社会経済活動との両立に向け"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "社会経済活動との両立に向け、地域経済や市民生活を支援する施策について最優先に取り組んでまいりました"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "コロナ禍が地域経済に与える影響を最小限に抑えるため"@ja.
<< kg:id_4 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "経済的な影響を受けた事業者に対して各種の応援補助金を迅速に交付した"@ja.
<< kg:id_4 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本市内での消費を喚起するキャッシュレス決済導入促進キャンペーンを実施しました"@ja.
<< kg:id_4 prop:cause kg:id_8 >>
    prop:text-txt_contents "コロナ禍により生じた米の需要減少"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "コロナ禍により生じた米の需要減少による大幅な米価下落"@ja.
<< kg:id_9 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "大幅な米価下落への緊急対策として、次期作に向けた営農意欲の維持向上を図るため、種子購入代金を支援しました"@ja.
<< kg:id_4 prop:effect kg:id_12 >>
    prop:text-txt_contents "庄内空港においては、コロナ禍の影響を受けて、令和３年の定期便搭乗者数は約10万人まで落ち込みました"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "新型コロナウイルスワクチンの円滑な接種を実施するため、インターネット、コールセンター、予約代行など、多様な予約方法を構築しました"@ja.
<< kg:id_13 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "市による集団接種と医療機関での個別接種を組み合わせ、希望者に対して、12歳以上は３回の接種を、５歳以上11歳以下は初回接種を行いました"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:text-txt_contents "新型コロナウイルス感染症の影響が長期化する中、子育て世帯の生活を支援し"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "子育て世帯生活支援特別給付金として児童１人につき５万円を"@ja.
<< kg:id_16 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "子育て世帯への臨時特別給付金として児童１人につき10万円をそれぞれ支給しました"@ja.
<< kg:id_16 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "住民税非課税世帯等を対象とする臨時特別給付金として、１世帯当たり10万円を支給しました"@ja.
<< kg:id_21 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "生理用品を準備することが困難な状況にある方を対象に、無償で生理用品を配布しました"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:text-txt_contents "近年多発している局地的な大雨の浸水対策として"@ja.
<< kg:id_24 prop:cause kg:id_23 >>
    prop:text-txt_contents "近年多発している局地的な大雨の浸水対策として"@ja.
<< kg:id_24 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "近年多発している局地的な大雨の浸水対策として、排水ポンプの更新を行うとともに"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "新型コロナウイルス感染症の感染拡大対策のため、飛島連絡所待合室内に体表温測定機能ターミナルを設置する経費を計上するものであります"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:text-txt_contents "物価高騰等による運営経費の負担を軽減し"@ja.
<< kg:id_28 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "障がい福祉サービスを提供する法人や介護保険事業所、法人立保育所等に対し、物価高騰等による運営経費の負担を軽減し、安定したサービスの提供が行えるよう支援する経費を計上しております"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:text-txt_contents "不妊治療の公的医療保険適用後の自己負担に対する助成制度を創設して、子供を望む方々のさらなる負担軽減を図る"@ja.
<< kg:id_31 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "県内では初めて、不妊治療の公的医療保険適用後の自己負担に対する助成制度を創設して、子供を望む方々のさらなる負担軽減を図る予算を計上しております"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "国の方針に基づき、オミクロン株対応のワクチン接種に係る経費等を計上しております"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:text-txt_contents "医療・介護施設において新型コロナウイルス感染症のクラスターが発生した場合に、感染拡大防止のための施設を借り上げの上、提供する"@ja.
<< kg:id_36 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
