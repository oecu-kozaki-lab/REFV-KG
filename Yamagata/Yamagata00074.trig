kg:op_1 prop:content "被災地の一日も早い復旧を願う"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "被災者への見舞いと早期復旧を願う"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "自然の恐ろしさを改めて認識した"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山市長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "デジタル変革を地域課題解決の有効な手段として重視する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "キャッシュレス決済導入促進事業は消費喚起に効果があった"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "即効薬はなく地道な活動が必要だ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_3 rdfs:label "鈴木和仁教育長"@ja.
kg:st_3 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_7 prop:content "酒田市の教育目標の実現を最上位に据えて進める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "地域と学校の連携協働を充実させるためのアプローチを見直した"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "今ある小学校区の結びつきを生かし中学校区の視点で活動する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "事業者アンケートや業況調査を踏まえ市独自支援を実施した"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "申請手続の簡素化とスピーディーな支援を心がけた"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "消費喚起の観点で大変好評だった"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "県外船の入港支援を行い成果が表れ始めている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "船凍スルメイカの流通に結びつけた"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "新たなブランド化を見据えて進めている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "飲食店の需要調査を行った上で実証実験を進めている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "県外船の入港支援を強めている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "地元船もなくなり大きな要因となっている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:st_4 rdfs:label "久保賢太郎農林水産部長"@ja.
kg:st_4 rdfs:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_19 prop:content "市民にＰＲする取組が必要だ"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "歳入確保策と歳出抑制が必須だ"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "未利用財産の処分を積極的に進めたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:st_5 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_5 rdfs:type cls:st_18.
kg:op_22 prop:content "返礼品の充実などで前年度超えを目指す"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "ウイズコロナ・ポストコロナを前提に事業内容を転換する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "オンライン申請導入で寄附者の利便性向上と作業効率化を図る"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "スマホやパソコンで自宅から申請できるようになる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:op_26 prop:content "寄附や申請件数の大幅増に備える"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "これが酒田の現実であり社会の変化を理解できるようなアピールが必要だ"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "社会減を抑制する施策の展開が重要だ"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "自然減の主な要因と考えている"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "毎年１億円を積み立てていく予定だ"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "令和10年度の歳入歳出均衡と令和15年度の公債費縮減を見込む"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "そのまま放置するのは望ましくない"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "一定程度市街地にあり土地の価値もあるため放置は望ましくない"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "ホームページ周知や先着順売払いで積極的に処分する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:st_6 rdfs:label "須田聡上下水道事業管理者"@ja.
kg:st_6 rdfs:type cls:st_63.
cls:st_63 rdfs:label "事業管理者"@ja.
kg:op_35 prop:content "県の広域化推進プランに工程が明確に示されるよう協議する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:st_7 rdfs:label "齋藤直議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_36 prop:content "ウイズコロナ時代に向けて総括と展開が必要だ"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_7.
kg:op_37 prop:content "主体的で対話的で深い学びの一助になっている"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:st_8 rdfs:label "佐藤元教育次長"@ja.
kg:st_8 rdfs:type cls:st_48.
cls:st_48 rdfs:label "教育次長"@ja.
kg:op_38 prop:content "学びの保障と社会的自立に向け活用を進める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:op_39 prop:content "ウェブ媒体やＳＮＳを活用して移住先としてＰＲを強める"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "令和３年度移住者数111人は過去最多である"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:st_9 rdfs:label "本間義紀企画部デジタル変革調整監"@ja.
kg:st_9 rdfs:type cls:st_41.
cls:st_41 rdfs:label "調整監"@ja.
kg:op_41 prop:content "携帯電話会社や事業連携先と協力しスマホ教室を展開している"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "ワクチン接種による重症化防止の効果が表れていると捉える"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "正確で分かりやすい情報発信で接種を推進したい"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "若い世代の感染増を踏まえ接種を推進したい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "将来不安を含めた懸念に対し丁寧な情報提供が必要だ"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "注意喚起を行い再発防止に取り組んだ"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "旅行・宿泊業での悪化が顕著だった"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "ワクチン接種進展で回復傾向が見られたが重点措置で大きな影響が出た"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "新たな重点支援地方交付金を活用し補正予算対応を検討する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "ここ数年、毎年のように観測史上最大、想定外の降水量による災害が多くの貴い命や財産などを奪い"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今年の夏も、８月の豪雨で、北海道から福岡県までの135以上の河川で氾濫が発生し、広域的に甚大な被害をもたらしました"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "山形県においても、８月５日からの大雨による被害は甚大なものでした"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "想定外の降水量による災害が多くの貴い命や財産などを奪い、自然の恐ろしさをまざまざと見せつけられてきました"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:text-txt_contents "令和３年度の一般会計予算は、新型コロナウイルス感染症の影響で、地方税の減収が見込まれ、厳しい状況下での予算編成"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "新型コロナウイルス感染症の拡大は、行政のデジタル化、キャッシュレス化など、デジタル技術を活用して新しい価値、便益をつくり出すデジタル変革の加速化につながる"@ja.
<< kg:id_10 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "新型コロナウイルス感染症の拡大は、行政のデジタル化、キャッシュレス化など、デジタル技術を活用して新しい価値、便益をつくり出すデジタル変革の加速化につながる"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "女性就業者が多い医療・介護・保育などは厳しい処遇や環境下でありますが、このような状況下においても、本市が目指す日本一女性が働きやすいまちの視点を持つことが重要"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "社会の変化に対応できる確かな学力の向上と生徒指導の充実のため、本市の特色を生かした酒田市小中一貫教育ビジョンを策定し"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "小中一貫教育の開始に伴い、これまでの小学校区単位から中学校区単位で地域と協働、連携していくための方策を検討し"@ja.
<< kg:id_17 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これまでの小学校区単位から中学校区単位で地域と協働、連携していくための方策を検討し、本市の実情に合わせ、子供を縁とする地域づくり、スクール・コミュニティを推進していくことにしました"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "コロナ禍が地域経済に与える影響を最小限に抑えるため、経済的な影響を受けた事業者に対し、各種の応援補助金を迅速に交付した"@ja.
<< kg:id_20 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "コロナ禍が地域経済に与える影響を最小限に抑えるため、経済的な影響を受けた事業者に対し、各種の応援補助金を迅速に交付した"@ja.
<< kg:id_20 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本市内での消費を喚起するキャッシュレス決済導入促進キャンペーンを実施しました"@ja.
<< kg:id_24 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "いかのまち酒田として県外船を誘致するため、引き続きイカ釣り漁船への支援を行い"@ja.
<< kg:id_24 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "販路を拡大するため、首都圏からバイヤーを招聘し、産地見学会を開催するとともに"@ja.
<< kg:id_24 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "新たなブランド化を見据えた活イカの流通実証実験や需要調査を実施しました"@ja.
<< kg:id_24 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "新たなブランド化を見据えた活イカの流通実証実験や需要調査を実施しました"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "このいかのまち酒田に向けた課題といたしましては、実は大きく２つございまして、１つは中型イカ釣り船の減少でございます"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "地元船もなくなりまして、酒田港の水揚げ量減少の大きな要因となっているところでございます"@ja.
<< kg:id_29 prop:cause kg:id_32 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "２つ目の課題としては、やはりいかのまちということについて、市民の皆さんの認知度をもっともっと高める必要がある"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "コロナの影響で景気回復が厳しい中での財政運営は、未利用財産の売却やふるさと納税等の活用などの歳入確保策のほか、事務事業や投資的経費の見直しによる歳出抑制が必須"@ja.
<< kg:id_33 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "未利用財産の売却やふるさと納税等の活用などの歳入確保策"@ja.
<< kg:id_33 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "未利用財産の売却やふるさと納税等の活用などの歳入確保策"@ja.
<< kg:id_33 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "事務事業や投資的経費の見直しによる歳出抑制が必須"@ja.
<< kg:id_38 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "ワンストップ特例申請受付業務の効率化を図るための経費について増額等するもの"@ja.
<< kg:id_38 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "これにオンライン申請の受付機能が追加されました。この機能を利用するための経費を増額要求"@ja.
<< kg:id_38 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "年末年始の繁忙期に向けた会計年度任用職員の増員に要する人件費"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "職場における男女の不平等を感じる割合という項目がございまして、それが59.3％という数値"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "若い女性、特に15歳から24歳までの若い女性の転出超過は依然として続いていることが大きな課題"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "人口の自然減についてでございますが、ここ数年、婚姻件数及び出生数が減少傾向にあることが主な要因"@ja.
<< kg:id_48 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "昨年度は公共施設等整備基金を新設をして、将来の公共施設の整備資金として、これもしっかり保有をする必要がある"@ja.
<< kg:id_50 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "地方債の発行額に一定程度制限を設けて地方債残高を意図的に減少するような対策を取っていきたい。具体的には、年間の発行額を30億円以下"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "利活用の見通しもないまま保有し続けるということは、草刈りも含めて、それから近隣への安全な配慮というものもございますし、様々な維持管理費がかかる"@ja.
<< kg:id_52 prop:effect kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "地域活性化の面からも決して望ましいものではない"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "酒田市未利用財産利活用基本方針に基づきまして、売却や貸付けといった有効活用を進めている"@ja.
<< kg:id_57 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "庄内広域水道用水供給事業と受水団体２市１町との垂直・水平統合の早期実現について知事に直接要望"@ja.
<< kg:id_59 prop:effect kg:id_60 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "コロナ禍により、酒田まつりの縮小や花火ショーの中止などでイベントの中止または事業の見直しなど余儀なくされた"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "これまで以上に、全体的には意欲的に授業に向かう生徒が増えており、クラスメイトと関わりながら学ぶ姿も多く見られるようになってきた"@ja.
<< kg:id_61 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "不登校の児童生徒に、例えば授業の様子をリアルタイムで配信することで共有したり、教員がオンラインによって１対１で学習支援を行ったりというようなことを行っている"@ja.
<< kg:id_59 prop:effect kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "コロナ禍によりまして、働き方や暮らし方が変容している"@ja.
<< kg:id_59 prop:effect kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "令和３年度移住者数は111人でありまして、これまでで最も多い数字となった"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "携帯電話会社と協力をして、１回スマホ教室をさせていただいた。現在で約20回ほどのスマートフォン教室を展開をさせていただいている"@ja.
<< kg:id_68 prop:effect kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "ワクチン接種回数が増えると重症化する割合が低下しており、これについては全ての年代でも同様の傾向"@ja.
<< kg:id_70 prop:cause kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "原因としては、副反応が怖い"@ja.
<< kg:id_70 prop:cause kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "若い人は重症化しないのではないかということ"@ja.
<< kg:id_70 prop:cause kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "将来的なリスクが心配ですと、将来、どういう症状として何かが出てくるかもしれないということでのそういう心配がある"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "令和３年度に廃棄したワクチンは、全て取扱い上問題が生じたもので"@ja.
<< kg:id_59 prop:effect kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "旅行や宿泊業での悪化が顕著であった"@ja.
<< kg:id_59 prop:effect kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "飲食店を筆頭に回復傾向が見られるなど二極化がうかがえる状況であった。まん延防止等重点措置が適用になったことから、回復傾向にあった飲食店においても営業時間短縮や酒類の提供制限などが実施され"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "エネルギー・食料品価格等の物価高騰の影響を受けた生活者や事業者を支援するため"@ja.
}
