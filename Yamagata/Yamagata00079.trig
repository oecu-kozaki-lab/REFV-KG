kg:id_179 rdf:type cls:c_4353.
cls:c_4353 rdfs:label "代替供給確保"@ja.
kg:id_178 prop:contermeasure kg:id_179.
kg:st_1 rdfs:label "佐藤猛議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "危機の時代の不安要素が市民生活に大きな影響を与えていると認識"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "ウクライナ侵攻に伴う物価高騰が危機を深めていると指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "物価高騰が市民生活を圧迫していると認識"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "危機の時代の影響が財政運営の厳しさも増していると認識"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "コロナ禍などの不安要素が財政運営を厳しくしていると認識"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "国際情勢の悪化が財政運営の厳しさを増していると認識"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "物価高騰が財政運営の厳しさを増していると認識"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "公立化実現には地域と経済界が一体となり県に早期の道筋提示を求めるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_9 prop:content "18歳人口減少で地方私立文系大学の学生確保は一段と厳しくなると危機感を示す"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "大学を存続させる手段として公立化を急ぐべきと考える"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:st_3 rdfs:label "鈴木和仁教育長"@ja.
kg:st_3 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_11 prop:content "自己効力感と学習習慣の形成を狙いとして導入した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "自分にはできるという感覚を育てる教材として選定"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "毎日こつこつ学ぶ習慣形成を重視して導入"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "誰にも知られず悩みを発信できるチャンネルを増やすべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "端末活用で児童生徒が悩みをより簡単に発信できるようになる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "基地港湾指定には複数海域が必要で現状は遊佐町沖のみが課題"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "酒田市沖の案件化に向け地元代表者との協議を進める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "風車建設や運用に加えエネルギー関連産業集積の波及効果を期待"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "経済効果が期待される一方で漁業や景観など未知の影響も懸念"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "県中心の形成計画策定を進め企業誘致や工業用地確保と連携すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "スマート技術と有機農業志向を組み合わせて環境に優しい農業を進める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "コストを下げつつ収量を確保しながら環境負荷を減らす農業を実現したい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "米消費減少が農業経営の厳しさにつながっていると指摘"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "米価低迷が農業者の高齢化を招いていると指摘"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "米価低迷が後継者不足につながっていると指摘"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "従来の担い手育成・複合経営・販路拡大に加え循環型農業を新たな柱に据える"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "相手国に精通したキーパーソン活用が課題"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "相手方ニーズに応じた生産のための知見が不足している"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "輸送ロスの多発が課題"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "抜港で輸出実証ができない事例があり課題"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "輸出前実験から販路拡大まで段階に応じた施策を打つべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "県内水揚げ量が過去最低で漁業者は厳しい状況"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "燃油高が漁業経営を厳しくしている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "漁業効率向上や新たな漁法への挑戦に必要な機器導入を支援"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "新たに漁業を始める人への研修初期費用支援で担い手を確保"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "活イカ試験流通やイカマップ作成で所得向上を図る"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "酒田の資源を生かし酒田ファン獲得につなげる活動を継続進化させる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "増便を生かすため一般利用向け助成で需要を喚起"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "旅行商品の造成販売を後押しして誘客促進を図る"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "市民と高校生によるおもてなしを継続し酒田港の魅力を高める"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "副食費に物価高騰分が転嫁されないよう支援する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "給食費増額分を交付金で補い保護者負担を据え置く"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "母子保健と児童福祉の機能を統合して一体的に運用する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "訪問支援員が家庭訪問し育児や家事を支援する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "妊婦と子育て世帯への給付で費用負担を軽減する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "健診未受診高齢者にも家庭訪問し状況把握と指導を行う"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "学生確保のため修学支援新制度を活用する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "市内医療機関への就職学生に支援金を支給し定着を促す"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "同じ目線で地域課題を共有し速やかに事業に取り組むため加入した"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "医療介護福祉政策や計画策定に助言を得て医療政策を前進させる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "自助共助公助の役割を訓練で高める必要がある"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "高齢者や体の不自由な人を避難させる要領確立を重視"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "不感エリア解消のため新たに3中継局を整備する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "人口減少や少子高齢化などで空き家は増加している"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "少子高齢化が空き家増加の要因"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "核家族化も空き家増加の要因"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "所有者意向を確認し相談会につなげ丁寧に対応する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "法改正の情報収集を行い管理不全空き家対策を講じる"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "生産年齢人口の低下とともに人口減少が進んでいると指摘"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "主要産業の漁業が大きく落ち込んでいると指摘"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "本土と変わらない通信環境を生かし関係人口増加を目指す"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "民間提案を積極的に受け入れ飛島の課題解決につなげる"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "運賃負担軽減や輸送コスト低廉化などのため追加指定を求める"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "住宅に困窮する若年単身者にも入居機会を広げるべき"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "安全性信頼性確保のため計画的に補修と点検を進める"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "来庁困難者も含めた申請機会拡大で普及に努める"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "企業団設立と垂直統合でさらなる経営基盤強化を目指す"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "令和8年度事業開始に向け準備協議会を設置する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "デジタル社会対応や少子化対策などで歳出は増加傾向"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "歳入が歳出増に追いつかず基金取崩しに頼る構造"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "必要性有効性緊急性を検証し厳しく選択した"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "全体的に厳しい予算編成の中で多くを一旦休止した"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "廃止ではなく再開に向けた見直しのための休止"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "児童参加機会の均等化が課題"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "総合交付金も圧縮が必要と判断した"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "補助金が削られると受け止められ反発が出た"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "地域の思いを踏まえ考え方を改めた"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "市民や事業者を含めた区域全体で削減を進める必要がある"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "民間でできることは民間の力で行う方向が望ましい"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "中小企業小規模事業者約550件への支援を計上"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "活用できる財源を見ながらできる限り支援制度を講じたい"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "基地港湾整備や洋上風力建設で地元企業への波及効果を期待"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "建設や調査で交流人口が増え宿泊施設等へ波及すると期待"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "次世代エネルギー普及で関連産業雇用と定住増加を期待"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "周辺エリア全体として幅広い世代が活躍できるまちを目指す"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "山居倉庫と旧鐙屋など文化財資源と都市資源を連携させたい"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:op_87 prop:content "文化芸術推進審議会を基本に市民と一体で進める体制が必要"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_2.
kg:op_88 prop:content "効率効果的な業務執行体制構築で縮減を進める"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_2.
kg:op_89 prop:content "デジタル化になじまない人への丁寧な対応強化に人員を活用する"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_2.
kg:op_90 prop:content "国方針を踏まえ必要な接種体制を維持する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
kg:op_91 prop:content "全年齢対象接種には個別と集団の両体制が必要"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_2.
kg:op_92 prop:content "少子化対策を最重要課題の一つとして継続している"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "行政企業地域家庭が連携して女性が働きやすいまちを目指す"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
kg:op_94 prop:content "構成企業が講師となる寄附講座でIT人材育成と定着を図る"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_2.
kg:op_95 prop:content "多様な働き方実現と収入増加を目指して支援拠点を開設"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_2.
kg:op_96 prop:content "都市計画法や農地法などの規制が新規工業団地造成の制約"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_2.
kg:op_97 prop:content "行政による造成は費用負担と売却確実性の課題がある"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_2.
kg:op_98 prop:content "スピード感のある企業には利用可能地の情報提供で対応する"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_2.
kg:op_99 prop:content "まず四中でモデル実施し他地域には啓発的活動を行う"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_2.
kg:op_100 prop:content "ラグジュアリーとプレミアムで異なるニーズに合わせた対応が重要"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_2.
kg:op_101 prop:content "米粉用米を作付した上で土づくり資材散布を支援する"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_2.
kg:op_102 prop:content "専用品種不足で国支援の対象外となっている"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_2.
kg:op_103 prop:content "地域資源循環で化学肥料使用量低減とコスト削減を図る"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_2.
kg:op_104 prop:content "圃場ごとに適切な施肥量を見極め使用量低減に役立てる"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_2.
kg:st_4 rdfs:label "須田聡上下水道事業管理者"@ja.
kg:st_4 rdfs:type cls:st_66.
cls:st_66 rdfs:label "管理者"@ja.
kg:op_105 prop:content "組織統合や施設統廃合で大きな削減効果が見込まれる"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_4.
kg:op_106 prop:content "水源と施設の有効活用で安定供給体制が向上する"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_4.
kg:op_107 prop:content "廃止まで当面は点検整備と修繕で施設機能を維持する"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_4.
kg:op_108 prop:content "広域化は工業用水の塩水遡上リスク軽減に極めて有効"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_4.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "産業革命以来、急速に進んだ地球温暖化による気候変動、加えて、我が国では2019年より広がった新型コロナウイルス感染症、さらには21世紀のこの時代、あり得ないと思っていた大国ロシアによるウクライナ侵攻、それに伴う世界的物価高騰、核兵器使用への現実的な恐怖、現代を総称して危機の時代と呼ぶ学者も現れております。...これらの不安要素は市民生活に大きな影響を与え"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "あり得ないと思っていた大国ロシアによるウクライナ侵攻、それに伴う世界的物価高騰"@ja.
<< kg:id_3 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "それに伴う世界的物価高騰...これらの不安要素は市民生活に大きな影響を与え"@ja.
<< kg:id_5 prop:cause kg:id_1 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "産業革命以来、急速に進んだ地球温暖化による気候変動...これらの不安要素は市民生活に大きな影響を与え、さらに本市の財政運営もまた厳しさが増しているものと認識しております"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "我が国では2019年より広がった新型コロナウイルス感染症...これらの不安要素は市民生活に大きな影響を与え、さらに本市の財政運営もまた厳しさが増しているものと認識しております"@ja.
<< kg:id_5 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "大国ロシアによるウクライナ侵攻...これらの不安要素は市民生活に大きな影響を与え、さらに本市の財政運営もまた厳しさが増しているものと認識しております"@ja.
<< kg:id_5 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "それに伴う世界的物価高騰...これらの不安要素は市民生活に大きな影響を与え、さらに本市の財政運営もまた厳しさが増しているものと認識しております"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "ここで重要なことは、東北公益文科大学の公立化の実現であります。２市３町と地域の経済界が１つになって少しでも早く公立化への道筋を県から示してもらうことが欠かせません"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "18歳の人口は今後急速に減少していく中で、地方の私立文系大学における学生確保は一段と厳しくなることが予想されておりまして、本市はそういった状況を考えると、この大学の存続そのものが危なくなるのではないかというそういった危機感を持っております"@ja.
<< kg:id_9 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "大学を存続させていくための手段として、まずは公立化を急ぐべきであると考えているところでございまして"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "新年度よりＣＢＴ　ｆｏｒ　ｓｃｈｏｏｌを導入することによって、子供一人一人に合った個別最適な学びを推進する"@ja.
<< kg:id_14 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "特に大切なものとして２つ御指摘をいただいておりました。１つは、自分にはできる、そういう自己効力感を醸成すること...この２つの力を培うことを狙いとして、最も最適であろうと思われる学習教材としてこのＣＢＴ　ｆｏｒ　ｓｃｈｏｏｌを導入した"@ja.
<< kg:id_15 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "毎日こつこつと学びを積み重ねる学習習慣の形成...この２つの力を培うことを狙いとして、最も最適であろうと思われる学習教材としてこのＣＢＴ　ｆｏｒ　ｓｃｈｏｏｌを導入した"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "いじめや不登校の対応については、ＧＩＧＡスクール端末を活用して、児童生徒自らが容易にＳＯＳのサインを発信できる仕組みづくりを現在進めているところでございます"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "このＧＩＧＡスクール端末を使用することによって、これまでよりも簡単に、さらに誰にも知られることなく児童生徒が悩み等を発信できるようになるということで、児童生徒にとりましてはその不安や悩みを発信できるチャンネルが増えていく"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "酒田港の基地港湾の指定に当たりましては、港湾法によりまして２つ以上の洋上風力の海域が指定されることが必要であります。しかしながら、現時点での山形県沖の案件としては、令和３年９月に有望な区域に指定をされた遊佐町沖のみ"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "酒田市沖につきましては、基地港湾の指定に必要な２つ目の案件として国への情報提供を行うために、山形県が主催をいたします酒田沿岸域検討部会において地元の各分野の代表者との協議を進めているところでございます"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "この洋上風力発電事業での地元経済の波及効果といたしましては、風車建設やその建設された風車の運用のみならず、カーボンニュートラルポートとしてのエネルギー関連産業の集積等も見込まれます"@ja.
<< kg:id_24 prop:effect kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "一方では、海を生業とする漁業者への影響ですとか、景観等による周辺住民への影響などでは、未知の影響も懸念されている"@ja.
<< kg:id_27 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "山形県が中心となって酒田港のカーボンニュートラルポート形成計画の議論が今進められております。令和５年度中の策定を目指しております"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "本市農業にあっても、持続可能な循環型農業を目指す上からスマートオーガニックシティ、仮称ですけれども、の形成を進める"@ja.
<< kg:id_31 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "スマート農業技術等を駆使して、除草、病害虫管理等を効率的に実施することで環境に優しい農業を実現しようというものでございます"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "一方で、米消費の減少やそれに伴う価格の低迷は農業者の高齢化や後継者不足につながっています"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "米消費の減少やそれに伴う価格の低迷は農業者の高齢化や後継者不足につながっています"@ja.
<< kg:id_37 prop:cause kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "米消費の減少やそれに伴う価格の低迷は農業者の高齢化や後継者不足につながっています"@ja.
<< kg:id_38 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "今回新たに柱立てするものとしては、それに加えて持続可能な循環型農業の促進というものを４番目の取り組むべき施策の柱に掲げた"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "今後の課題といたしましては、輸出相手国に精通したキーパーソンとの関係性をいかに活用するかということ"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "現地のニーズ、気候や風土などの知見が不十分な状態で輸出に取り組んでおりますので、相手方のニーズ等に対応した生産をどのように実施していったらいいのか"@ja.
<< kg:id_40 prop:cause kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "従来の栽培・流通方法が長期間輸送を想定しておらず、メロンや柿の輸送ロスの多発"@ja.
<< kg:id_40 prop:cause kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "コロナ禍によって発生した酒田港の抜港...庄内柿は抜港で輸出実証ができなかった"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "今後の戦略としては、作物ごとに輸出前の実験の段階、それから輸出実証の段階、そして輸出先での販路拡大の段階とそれぞれ取組のステージ分けをして、ステージに応じた施策を打つ"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "令和４年の県内の水揚げ量は速報値で3,766トンとなりまして、前年に比較して239トン減少し過去最低を更新しております。漁業者にとりましては、漁獲量の減少のほか"@ja.
<< kg:id_47 prop:cause kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "漁業者にとりましては、漁獲量の減少のほか、燃油高などもあり大変厳しい状況"@ja.
<< kg:id_50 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "水産業成長産業化支援事業を県と連携して実施しております。この事業は、漁業効率の向上や新たな漁法への挑戦などに必要な機器や機材の導入・整備を支援する事業"@ja.
<< kg:id_50 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "新規就業者確保・育成総合対策支援事業を当初予算に計上したところでございます。この事業は、本市で新たに漁業を始めようとする者に対して研修開始の初期費用に対する支援"@ja.
<< kg:id_50 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "漁業所得の向上につながる活イカのブランド化などに取り組んでいきたい...活イカの試験流通や市内飲食店などでイカを提供するイカマップの製作"@ja.
<< kg:id_54 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "一般財団法人酒田ＤＭＯは、酒田の資源や強みを生かして、酒田ファンの獲得のために...アドベンチャーツーリズムのコンテンツの企画開発...観光プロモーション"@ja.
<< kg:id_56 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "一般利用向けには、庄内空港利用振興協議会として予算額480万円を計上して、宿泊つきの往復航空券を対象とする割引クーポンを発行し助成をする"@ja.
<< kg:id_56 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "旅行会社向けには予算額1,660万円を計上しておりまして、こちらは旅行会社が増便された指定便に関する旅行商品を企画、販売及び事業実施する際には１席当たり5,000円を助成"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "酒田北港古湊ふ頭と中町モールなど中心市街地の主に２か所のステージに分けて行う予定...市民と高校生によるおもてなしということでございました。これが本酒田港での寄港に際しての最大の魅力"@ja.
<< kg:id_61 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "保育所における給食費の支援は、保護者から徴収する副食費に食材費の物価高騰分が転嫁されないよう、法人立保育所、認定こども園、認定外保育所に対し支援をする"@ja.
<< kg:id_63 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "25円の増額改定分に新型コロナウイルス感染症対応地方創生臨時交付金を充てて、保護者負担が増えないように据置きという形で対応していきたい"@ja.
<< kg:id_65 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "令和５年度に開設をしますこども家庭センターでは、これまでの母子保健分野の子育て世代包括支援センターと児童福祉分野の子ども家庭総合支援拠点のそれぞれの機能を統合して"@ja.
<< kg:id_67 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "子育て世帯訪問支援事業を新たに実施いたします。この事業は、家事、育児に不安や負担を抱えている妊産婦、子育て家庭、ヤングケアラー等がいる各家庭へ訪問支援員が訪問し、育児や家事の支援を行い"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "妊娠届を提出した妊婦に対し５万円を、子育て応援給付金として出生児１人につき５万円を養育者に給付し、出産育児関連用品購入等の費用負担の軽減を図る"@ja.
<< kg:id_71 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "健康課に新たに看護師を配置し事業を実施する...高齢者健康診査を受診していないために健康状態が不明な高齢者等に対しては、家庭訪問し状況を把握した上で相談や指導を行う"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "学生確保対策として令和５年度から国の修学支援新制度を活用した入学金や授業料の減免を行う"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "令和５年度卒業生から市内の医療機関に就職した学生に対し、地元就職支援金を支給いたします"@ja.
<< kg:id_77 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "昨年９月に酒田市としてこの日本海ヘルスケアネットに加入をしたところでございました。日本海ヘルスケアネットに加入をしたのは、日本海ヘルスケアネットの取組を推進するためには、そこに参加している法人と同じ目線で地域課題を共有し、速やかに各種事業に取り組むことが重要だと考えたから"@ja.
<< kg:id_77 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "令和５年４月から特別職の非常勤職員として地域医療政策顧問を酒田市としては置くことにしております...医療・介護・福祉に関する様々な政策ですとか計画の策定などにこの政策顧問からは助言をいただきながら"@ja.
<< kg:id_80 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "地域住民、防災関係機関、それから酒田市、そのそれぞれが連携して、災害時に協力して対応する体制づくりが大変重要でございます"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "今回の訓練の主な目的は、地域と消防団が連携することで、高齢者や体の不自由な方を避難させるための要領を確立することでございます"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "平田地域へ３つの中継局を新たに整備をすることで...防災ラジオの不感エリアが解消される"@ja.
<< kg:id_86 prop:cause kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "空き家等の件数は人口減少、少子高齢化、核家族化により増加しております"@ja.
<< kg:id_86 prop:cause kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "空き家等の件数は人口減少、少子高齢化、核家族化により増加しております"@ja.
<< kg:id_86 prop:cause kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "空き家等の件数は人口減少、少子高齢化、核家族化により増加しております"@ja.
<< kg:id_90 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "空き家所有者等の意向を確認した上で空き家等ネットワーク協議会が主催をしております空き家等無料相談会につなげて問題解決に努めている"@ja.
<< kg:id_90 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "引き続き情報収集に努め、管理不全空き家の認定と解消に向けた対策を講じていきたい"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "飛島は、生産年齢の低下とともに人口減少が進み"@ja.
<< kg:id_95 prop:effect kg:id_96 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "主要産業である漁業についても2016年度は対2008年度比で約半分まで落ち込んでいます"@ja.
<< kg:id_97 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "高速通信が可能な光ファイバーの活用がございます...テレワークやワーケーションといった働き方を県内外に発信・提案し飛島への関係人口の増加を目指していきたい"@ja.
<< kg:id_97 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "令和５年度以降も民間事業者からの提案等を積極的に受け入れまして、引き続き飛島の課題解決につなげていきたい"@ja.
<< kg:id_97 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "特定有人国境離島地域にこの飛島を追加指定するよう、引き続き県と連携をして関係各所に要望活動を続けてまいりたい"@ja.
<< kg:id_101 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "若年単身者の募集については人気の低い高層階、上のほうの階の空き室を対象としたい...市内に居住する若年単身者が応募できるほか、ＵＩＪターン就職をする市外の若年単身者についても応募を可能とする"@ja.
<< kg:id_103 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "酒田市橋梁長寿命化修繕計画に基づいて、点検、診断、補修のマネジメントサイクルを実施...令和５年度は東泉跨線橋の補修工事や...100橋の点検・診断を予定"@ja.
<< kg:id_105 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "マイナンバーカードの休日窓口の開催ですとか、企業・団体に加え来庁困難者への出張申請受付の実施によりまして、マイナンバーカードの普及には努めてまいりたい"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "２市１町で企業団を設立の上、水平統合を実現し、最終的には庄内広域水道用水供給事業との垂直統合を図ることでさらなる経営基盤強化を目指す"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "３月28日に２市１町における庄内広域水道事業統合準備協議会を設置いたします。その後、令和７年度中に企業団を設立し、令和８年度からの水平統合による事業開始を目指します"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "デジタル社会への積極的な取組や少子化対策などの新しい財政需要によりまして、歳出予算はコロナ禍前と比べても増加傾向にあります"@ja.
<< kg:id_111 prop:cause kg:id_113 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "その財源となる市税等の歳入予算はその増加分を見込めず、基金の取崩しに頼った予算編成となっております"@ja.
<< kg:id_111 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "全ての事業について行政評価等を考慮し、事業の必要性や有効性、緊急性を検証する一件査定により取捨選択を行った"@ja.
<< kg:id_115 prop:cause kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "特に交流事業、イベント関係は実施を見送ったものも多くなっております。これらは事業の廃止ではなく一旦停止としたものでございます"@ja.
<< kg:id_117 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "令和５年度の青少年交流推進事業については、コロナ収束後の事業再開に向けた課題を整理するため、事業の廃止ではなく、事業の見直しのための休止"@ja.
<< kg:id_119 prop:cause kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "相手都市との児童数の不均衡が生じている地区もありまして...対象を全市に広げるなど児童参加の機会を均等にしていく必要"@ja.
<< kg:id_121 prop:cause kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "市の財政状況が大変厳しくなる中で、ひとづくり・まちづくり総合交付金についても少し圧縮する必要があり"@ja.
<< kg:id_121 prop:effect kg:id_123 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "あたかも補助金が削られるという受け止めをされてしまったものですから、大変皆さんからは反発が出た"@ja.
<< kg:id_124 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "令和６年度以降は、令和５年度と同様の額で積算としたいということで、お話はさせていただいている"@ja.
<< kg:id_126 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "市民や事業者を含めた本市全体で温室効果ガスを削減していくために、新たに本市の区域全体を対象とする地球温暖化対策実行計画・区域施策編を策定する"@ja.
<< kg:id_128 prop:cause kg:id_129 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "民間の力で十分実施可能であると考えられる事業も多々ございます。民間でできることは民間の力で行っていただくということも、ある意味今後は望ましい方向ではないか"@ja.
<< kg:id_130 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "中小企業・小規模事業者約550件に対する利子補給と保証料補給、合計で約１億7,000万円ほどの予算を計上"@ja.
<< kg:id_130 prop:contermeasure kg:id_132 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "本市の新年度の経済対策については、こういった国や県の制度ですとか、活用できる財源を注視しながら、できる限り支援制度を適切に講じられるよう検討していきたい"@ja.
<< kg:id_133 prop:effect kg:id_134 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "短期的には基地港湾の整備や洋上風力の建設に関する地元企業への経済波及効果を期待しております"@ja.
<< kg:id_133 prop:effect kg:id_135 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "建設や現地調査等で多くの交流人口が増加することで、市内宿泊施設等への波及効果も期待"@ja.
<< kg:id_133 prop:effect kg:id_136 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "次世代エネルギーが普及することで、関連産業による雇用が創出され、本市への定住人口の増加が期待される"@ja.
<< kg:id_137 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "山居倉庫周辺エリアについては、国指定史跡山居倉庫の保存活用、酒田商業高校跡地における民間開発事業、移住者の増加を目指す消防署跡地におけるＴＯＣＨｉＴＯプロジェクトを進めることによりまして、幅広い世代が活躍できるまちの実現を目指している"@ja.
<< kg:id_139 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "文化財の保護に関する事務については、国指定史跡山居倉庫の保存と整備を一体的に進めるとともに、国指定史跡山居倉庫と国指定史跡旧鐙屋などの文化財資源と他の都市資源との連携を推進し、地域の新たな魅力の創造につなげていきたい"@ja.
<< kg:id_141 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "文化芸術に関わる市民と一体となって進める体制、それから、全庁で意識を共有できるような体制、そういったものを推し進めるために、市長部局に移して"@ja.
<< kg:id_143 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "事業の見直し、多様な任用形態、業務のデジタル化などによって職員数及び総人件費の縮減に取り組んでいく"@ja.
<< kg:id_143 prop:effect kg:id_145 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "デジタル化の促進に伴って、そこで浮いた人員については、デジタル化になじまない人たちの人的なマンパワーサービスの充実を図る"@ja.
<< kg:id_146 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "春から夏、５月から８月に65歳以上の高齢者、基礎疾患を有する者その他重症化リスクの高いと医師が認める者及び医療従事者等を対象に接種を行い、さらに秋から冬...高齢者などを含めた全ての年齢の方を対象に接種を実施する方向"@ja.
<< kg:id_146 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "少なくとも全ての年齢の方が対象となる秋から冬の接種は、これまでと同様に個別接種と集団接種の両方の体制が必要"@ja.
<< kg:id_149 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "本市におきましては、少子化対策を最重要課題の一つと位置づけて、これまでも、結婚・妊娠・出産・子育てまで切れ目のない支援を行ってまいりました"@ja.
<< kg:id_151 prop:contermeasure kg:id_152 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "行政・企業・地域・家庭が連携・協力して日本一女性が働きやすいまちを実現することによる人口減少の抑制を重点施策の一つとして"@ja.
<< kg:id_153 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "構成企業が講師となり、東北公益文科大学において寄附講座を実施することを、現在、大学側と調整しております。このような取組を通じて、本市のＩＴ人材を育成し、市内企業に輩出・定着する素地を整えようとしている"@ja.
<< kg:id_155 prop:contermeasure kg:id_156 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "ＮＴＴ東日本酒田本町ビル１階に新たな拠点として、リボンステーションという名称の拠点を開設した...民間企業と連携して、ＯＪＴを通じた教育研修、伴走支援を行っていく"@ja.
<< kg:id_157 prop:cause kg:id_158 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "都市計画法、農地法などの土地利用規制や開発手法など、市の考えだけでは前に進まない状況、環境がございます"@ja.
<< kg:id_157 prop:cause kg:id_159 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "行政で造成する際の多額の費用ですとか、それから売れ残りなどを生じさせるわけにはいきませんので、売却の確実性というものが求められる"@ja.
<< kg:id_160 prop:contermeasure kg:id_161 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "まずは酒田臨海工業団地などの未分譲地などの情報提供をしていく所存でございます。また、本市の工業地域にあります未利用地、それから民間工場跡の居抜き物件の活用が促されるよう情報収集とその情報の提供に努めてまいりたい"@ja.
<< kg:id_162 prop:contermeasure kg:id_163 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "第四中学校区をモデル地区として、まずは市長部局に地域プロデューサーを配置して、学校と地域コミュニティ組織、企業、行政など各種団体の連携・協働を図りながら、このスクール・コミュニティ構想の推進に向けて行動をしていく"@ja.
<< kg:id_164 prop:contermeasure kg:id_165 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "クルーズ業界に長く携わる有識者より、クラスに応じた対応の重要性が指摘された...本市としても、各クラスの乗船客のニーズに合った対応が重要だと考えております"@ja.
<< kg:id_166 prop:contermeasure kg:id_167 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "米粉用米の生産促進に向け、米粉用米を作付した上で、作付圃場にケイ酸質肥料等を散布する場合に、10アール当たり5,900円を交付する"@ja.
<< kg:id_168 prop:cause kg:id_169 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "現時点では東北地方に適したパン・麺用の専用品種がないために、支援対象外となっている"@ja.
<< kg:id_170 prop:contermeasure kg:id_171 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "牛のふん尿から生産する液肥を活用し、水田へ施用する実証実験や、２つ目としては、堆肥散布組織の活動への支援"@ja.
<< kg:id_170 prop:contermeasure kg:id_172 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "ドローンで圃場を空撮して、その画像から生育状況を解析するセンシングや土壌分析に対しても令和４年度より支援を実施...結果として肥料の使用量低減に貢献"@ja.
<< kg:id_173 prop:effect kg:id_174 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "令和37年度までの期間で272億7,000万円の削減効果が見込まれている"@ja.
<< kg:id_173 prop:effect kg:id_175 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "水源及び水道施設の有効かつ効率的活用による安定供給体制の向上"@ja.
<< kg:id_176 prop:contermeasure kg:id_177 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "朝日浄水場からの受水に切り替えることによりまして、小牧浄水場の廃止を予定しておりますが、それまでは使用を継続する必要があります。当面は、計画的な点検整備や修繕を施すことによって、施設機能の維持を図ってまいりたい"@ja.
<< kg:id_178 prop:contermeasure kg:id_179 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "広域化によりまして、水道事業が塩水の影響を受けない水源のみで供給が可能になれば、工業用水事業にとっても、緊急避難的な水道利用が可能となり、塩水遡上リスクの軽減に極めて有効"@ja.
}
