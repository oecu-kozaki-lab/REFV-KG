kg:st_1 rdfs:label "冨樫覚議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "若年層を含む幅広い世代への自治会加入促進が担い手不足解消や活動継承につながる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "村上祐美市民部長"@ja.
kg:st_2 rdfs:type cls:st_47.
cls:st_47 rdfs:label "行政職"@ja.
kg:op_2 prop:content "人口減少や少子高齢化が進んでも地域と行政の協働で組織機能を維持したい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "自治会のニーズに沿った様々な支援が必要である"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "組織規模の縮小や担い手不足への対応が課題だと認識している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "活動継続が困難になっていることを課題と認識している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "若年層を含む幅広い世代への加入促進が必要である"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地域の幅広い人材を見つけるため行政もできる限り力を果たしたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "地域と行政の協働により組織機能を維持していきたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "自治会は地域づくりの大切なパートナーであり活動継承支援が必要である"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "自治会の事業継承への支援が必要である"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "財政面では各自治会で自主的に使える財源の支援を行っている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "住民活動の拠点となる集会施設への支援を行っている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "自治会のニーズに沿った支援を今後も行う必要がある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "自治会の重要性を説明したチラシで加入の必要性を呼びかけている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "宅地建物取引業協会などから集合住宅側へ加入周知を図っている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "マニュアル作成予定はないが加入の必要性の周知拡大に努めたい"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "住民や役員の負担軽減と円滑な自治会運営に役立つ"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "デジタル化は安否確認を速やかに行えるため前向きに捉えている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "取り組みたい自治会には研修会開催や必要サービス紹介を行いたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "導入を希望する自治会への支援情報を積極的に知らせたい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "スマートフォンを活用できる住民には大変有効である"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "回覧文書の作成や配布等の負担軽減につながる"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "情報共有を迅速にし住民の利便性向上につながる"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "急な事業中止の周知や災害時の安否共有に利点がある"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "回覧板を回さなくなることで人と会う機会が減る可能性がある"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "使い方のサポートが必要になる"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "紙媒体しか受け取れない方がいる場合は手間がさらに増える可能性がある"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "情報をアプリに取り込み編集発信する操作が必要になる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:st_3 rdfs:label "伊藤欣哉議員"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_29 prop:content "今夏の猛暑を貴重な経験則として今後へ生かすべきである"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "猛暑は繰り返し発生することが予想される"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:st_4 rdfs:label "佐藤元教育次長"@ja.
kg:st_4 rdfs:type cls:st_47.
kg:op_31 prop:content "児童生徒の命を守ることを最優先に様々な対応を行った"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "安全を第一に教育活動を展開した"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "部活動や屋外運動ができないなど厳しい実態があった"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "文部科学省や県の通知を整理して各校へ周知した"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "炎天下での屋外活動を回避する工夫をしている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "定期的なクールダウンが可能となるよう導入を計画している"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:st_5 rdfs:label "久保賢太郎農林水産部長"@ja.
kg:st_5 rdfs:type cls:st_47.
kg:op_37 prop:content "課題克服のため土づくりを浸透させる必要がある"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "堆肥を使いやすくする検討が必要である"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "段階的に環境に優しい農業を進めていく必要がある"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "コストを下げつつ収量を確保する土づくりを広げたい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "散布しやすくして堆肥活用を進めたい"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "市内で堆肥がどこにどの程度あるか把握できるようにしたい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "農薬や化学肥料を低減しても収量を確保できる情報を集めたい"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:op_44 prop:content "農業者が厳しい経営を強いられていることは承知している"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
kg:op_45 prop:content "双方のコストを廉価に供給し合う体制づくりが必要である"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "資源循環の仕組みを構築するため支援を続けてきた"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_5.
kg:op_47 prop:content "モデル事例として他地域へ周知したい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "散布が容易にできるようにしたい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_5.
kg:st_6 rdfs:label "市村浩一議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_49 prop:content "中心市街地の再生には居住誘導が重要である"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:op_50 prop:content "住む人を増やしコンパクトでにぎわいのある酒田の顔づくりが必要である"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_6.
kg:st_7 rdfs:label "矢口明子市長"@ja.
kg:st_7 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_51 prop:content "中町エリアを車がなくても暮らせるまちにしていきたい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "中心市街地の衰退が加速している"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_6.
kg:op_53 prop:content "中町エリアは今車がなくては暮らせないまちになりつつある"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "中心市街地の活性化は単なる商店街活性化ではなく居住誘導が必要である"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_6.
kg:op_55 prop:content "まず昼間人口の増加を目指しその後商業施設出店と居住人口増加の循環をつくりたい"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "特に旧マリーン5清水屋を中心とした中町エリアを重視する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_7.
kg:op_57 prop:content "昼間人口増加をきっかけに商業施設出店と居住人口増加のサイクルをつくりたい"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_7.
kg:op_58 prop:content "市民の利便性向上と集客力の高い施設を中町エリアに移転誘致したい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_7.
kg:op_59 prop:content "相談が増加傾向にあり新たな地域課題になりつつある"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "繁殖の抑制に取り組むことが一番重要である"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "猫と住民の共生を目指すため不妊去勢手術への支援が必要である"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_6.
kg:op_62 prop:content "野良猫トラブル増加の一因となっている"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "新たな地域課題になりつつある"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "相談や苦情に応じて職員が現地確認し周辺住民や関係者へ聞き取りを行っている"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "原因者が特定される場合には直接対応している"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "相談者に対して野良猫を忌避する方法を示している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "餌やりや糞尿に関する注意や対応方法を回覧で周知している"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "地域猫活動として保護不妊去勢手術実施返還が行われている"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "支援の必要性を認識しており方策を検討したい"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "被害木の約4割が残る状況となった"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_5.
kg:st_8 rdfs:label "田中斉議員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_71 prop:content "予算が来なくてできなかったでは遅く根絶に向けてギアを上げるべきだ"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_8.
kg:op_72 prop:content "国や県へ予算確保を要求し関係機関で抑制策を議論したい"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_5.
kg:op_73 prop:content "予算確保も含めて準備を進めている"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_5.
kg:op_74 prop:content "地域の実情をしっかり伝えて強く要望したい"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_5.
kg:op_75 prop:content "庄内地区の被害量をどう抑制するか議論していきたい"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_5.
kg:op_76 prop:content "切るだけでなく抵抗性松も使いながら対応することが重要である"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_5.
kg:op_77 prop:content "再編に果敢に取り組んだ職員と交通事業者に感謝したい"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_7.
kg:op_78 prop:content "運行地区拡大や運行日の増加などが要因と考える"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_7.
kg:op_79 prop:content "利用者増加の要因の一つである"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_7.
kg:op_80 prop:content "利用者増加の要因と考えられる"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_7.
kg:op_81 prop:content "利用者増加の大きな要因である"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_7.
kg:op_82 prop:content "今後も公共交通を維持していくには大きな課題である"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_7.
kg:op_83 prop:content "市内交通事業者へ県制度の情報提供を行っている"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_7.
kg:st_9 rdfs:label "安川智之副市長"@ja.
kg:st_9 rdfs:type cls:st_47.
kg:op_84 prop:content "導入を契機に関連産業や企業進出が期待できる"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_9.
kg:op_85 prop:content "多様な再生可能エネルギー関連産業があることによる企業進出が考えられる"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_9.
kg:op_86 prop:content "地域の雇用創出が期待される"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_9.
kg:op_87 prop:content "選定事業者の地域貢献策による効果も期待している"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_9.
kg:op_88 prop:content "不安の声は法定協議会でしっかり伝えたい"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_9.
kg:st_10 rdfs:label "酒田沿岸域検討部会の出席者"@ja.
kg:st_10 rdfs:type cls:st_67.
cls:st_67 rdfs:label "会議参加者"@ja.
kg:op_89 prop:content "景観への懸念が示されている"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_10.
kg:st_11 rdfs:label "漁業者"@ja.
kg:st_11 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_90 prop:content "漁法の変更を迫られるのは大変である"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_11.
kg:op_91 prop:content "メリットとデメリットをバランス良く議論していくことが大切である"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_9.
kg:op_92 prop:content "11月1日の市広報で進捗状況や制度を知らせたい"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_9.
kg:op_93 prop:content "最新の科学的知見や先行地域の状況を共有し理解醸成を図りたい"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_9.
kg:op_94 prop:content "大規模公共事業への地元参入が期待される"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_9.
kg:op_95 prop:content "多くの来訪者による地域経済効果を期待している"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_9.
kg:op_96 prop:content "洋上風力の運営やメンテナンス産業形成が期待される"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_9.
kg:op_97 prop:content "新たな産業に伴う雇用を期待している"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_9.
kg:op_98 prop:content "山形県が基地港湾誘致のため着実に手続を進めている"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_9.
kg:op_99 prop:content "指定の加速化へ働きかけを行っている"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_9.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "全国的に少子化、高齢化、人口減少が加速的に進み、自治会の運営に大きな影響をもたらしてきております"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "全国的に少子化、高齢化、人口減少が加速的に進み、自治会の運営に大きな影響をもたらしてきております"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "全国的に少子化、高齢化、人口減少が加速的に進み、自治会の運営に大きな影響をもたらしてきております"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "過疎化や高齢化、人口減少や個人の価値観の多様化などにより、自治会における組織規模の縮小、また担い手不足など活動の継続が困難になっている"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "自治会における組織規模の縮小、また担い手不足など活動の継続が困難になっている"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "自治会における組織規模の縮小、また担い手不足など活動の継続が困難になっている"@ja.
<< kg:id_5 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "自治会における組織規模の縮小、また担い手不足など活動の継続が困難になっている"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "令和２年から令和４年まで丸３年間、コロナ禍のため、長期間にわたり、自治会活動が停滞を余儀なくされました"@ja.
<< kg:id_10 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "長期間にわたり、自治会活動が停滞を余儀なくされました"@ja.
<< kg:id_5 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本市の財政面の支援としては、各自治会で自主的に使える財源である自治会運営交付金の支出や"@ja.
<< kg:id_5 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "住民活動の拠点となる集会施設の修繕"@ja.
<< kg:id_5 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "福祉機器などの設置に対する支援等を行っております"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "転入した方に対して、自治会への加入促進のために、市民課に届出をした際に、自治会の重要性を説明したチラシを配布しております"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "集合住宅の管理者や所有者の方々へ自治会加入の周知を図っていただいているところであります"@ja.
<< kg:id_16 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "自治会への加入の必要性については、市ホームページやその他の媒体を活用し、引き続き、周知の機会の拡大に努めていきたい"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "電子回覧板の導入によるメリットといたしましては、情報を迅速に伝達、また収集することができ"@ja.
<< kg:id_20 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "災害時には自分の安否を知らせることができるなど、住民同士で迅速な情報を共有するメリット"@ja.
<< kg:id_20 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "研修会の開催ですとか、必要なサービスを紹介したり、導入のための考え方を整理したり"@ja.
<< kg:id_20 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "必要なサービスを紹介したり、導入のための考え方を整理したり"@ja.
<< kg:id_20 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "電子回覧板の導入によるメリットといたしましては、情報を迅速に伝達、また収集することができ"@ja.
<< kg:id_20 prop:effect kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "回覧文書の作成、配布等に係る自治会役員の労力や回覧板を渡す住民側の負担も軽減できます"@ja.
<< kg:id_20 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "回覧板を渡す住民側の負担も軽減できます"@ja.
<< kg:id_20 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "緊急時の連絡、例えば、急な事業中止の周知を速やかに行ったり"@ja.
<< kg:id_20 prop:effect kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "回覧板を回さなくなることで人と会う機会がますます減り、近所付き合いの希薄化がより一層進む可能性"@ja.
<< kg:id_20 prop:effect kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "スマートフォンを使えない方に対しては、使い方のサポートなどが必要となります"@ja.
<< kg:id_20 prop:effect kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "これまでどおり紙でも回覧するか、役員が直接その方に持っていくなど手間がさらに増えてしまう可能性"@ja.
<< kg:id_20 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "回覧する情報をアプリに取り込み、編集し、発信するなどの操作をする必要があるため、自治会役員の負担が増加する"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "地球温暖化の原因となっている二酸化炭素をはじめとする温室効果ガスは確実に増加しており"@ja.
<< kg:id_33 prop:cause kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "３年から７年周期で引き起こされるとするエルニーニョ現象の影響を受け、日本の夏は猛暑と冷夏を繰り返す"@ja.
<< kg:id_33 prop:effect kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "部活動の中止や運動会等の学校行事の延期など様々な対応を行ってきた"@ja.
<< kg:id_33 prop:effect kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "運動会等の学校行事の延期など様々な対応を行ってきた"@ja.
<< kg:id_33 prop:effect kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "部活動や屋外での運動ができないなど教育課程の変更に迫られ、厳しい実態があった"@ja.
<< kg:id_33 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "教育委員会では、例年、文部科学省や県からの通知によりまして、熱中症防止に関する注意喚起を行っております"@ja.
<< kg:id_33 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "小学校では、プールの授業を７月中に終えるようにし、それ以降の炎天下での屋外での活動を回避する"@ja.
<< kg:id_41 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "県の補助金を活用しまして、運動中の定期的なクールダウンが可能となるよう可搬式の冷風装置を１校当たり２台、計14台の導入を計画"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "地力が高く、土づくりに前向きに取り組む農業者が少ないこと"@ja.
<< kg:id_43 prop:cause kg:id_45 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "化学肥料を減らすために必要となる堆肥が市内であまり活用されていないこと"@ja.
<< kg:id_43 prop:cause kg:id_46 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "有機農業の取組面積が減少傾向であるという課題がございます"@ja.
<< kg:id_43 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "コストを下げつつ、収量を確保する土づくりに係る農業者向けの研修会を開催すること"@ja.
<< kg:id_43 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "堆肥をペレット化することで、より使いやすくするための検討を行うこと"@ja.
<< kg:id_43 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "市内で堆肥がどこにどの程度あるのかを見える化する取組"@ja.
<< kg:id_43 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "農薬、化学肥料を低減しても、収量を確保できる除草や病害虫防除などの農業技術・資材の情報収集"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "近年、資材価格が高騰しておりまして、農業者が厳しい経営を強いられている"@ja.
<< kg:id_51 prop:effect kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "農業者が厳しい経営を強いられているということは承知しております"@ja.
<< kg:id_51 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "農業者が堆肥を購入して土づくりを行い、そこで生産される飼料を畜産業者へ販売するという資源循環の仕組みを構築するための支援"@ja.
<< kg:id_51 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "農業者と畜産業者が飼料生産組合をつくりまして、堆肥・飼料の供給体制を構築している事例"@ja.
<< kg:id_51 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "散布が容易にできるような堆肥のペレット化についても検討していきたい"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "大型小売店の郊外への立地、人口減少、車社会の進展など、様々な都市機能が郊外に移転する状況に歯止めがかからない"@ja.
<< kg:id_56 prop:cause kg:id_4 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "大型小売店の郊外への立地、人口減少、車社会の進展など"@ja.
<< kg:id_56 prop:cause kg:id_58 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "大型小売店の郊外への立地、人口減少、車社会の進展など、様々な都市機能が郊外に移転する"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "清水屋の撤退、ト一屋の撤退、そして老舗店舗の撤退などが加わり、中心市街地の衰退は加速を増すばかり"@ja.
<< kg:id_59 prop:cause kg:id_61 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "旧マリーン５清水屋や旧ト一屋中町店など、これまで中町エリアで営業していた商業施設が...閉店し"@ja.
<< kg:id_59 prop:effect kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "中心市街地の衰退は加速を増すばかりであります"@ja.
<< kg:id_59 prop:effect kg:id_63 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "中町エリアは、今、車がなくては暮らせないまちになりつつあると認識しております"@ja.
<< kg:id_56 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "旧マリーン５清水屋を中心とした中町エリアを、今後は車がなくても暮らせるまちにしていきたい"@ja.
<< kg:id_56 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "まずは居住人口ではなく、昼間人口、昼間の人口の増加を目指し"@ja.
<< kg:id_56 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "まずは公共的な機関など、市民の利便性の向上に役立ち、かつ集客力も高いような施設を中町エリアに移転、誘致することができないか"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "苦情相談の内容としましては、不適切な餌やりや民家敷地内・砂場でのふん尿"@ja.
<< kg:id_67 prop:cause kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "野良猫については、管理する方がいないために繁殖を抑制する手段がなく"@ja.
<< kg:id_67 prop:effect kg:id_70 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "民家敷地内・砂場でのふん尿"@ja.
<< kg:id_67 prop:effect kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "自然繁殖で頭数が増加することによる近隣トラブル"@ja.
<< kg:id_67 prop:effect kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "自然繁殖で頭数が増加することによる近隣トラブルなど多岐にわたり、新たな地域課題になりつつある"@ja.
<< kg:id_67 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "職員が現地に確認に出向き、周辺住民や関係者の方々への聞き取りを行い"@ja.
<< kg:id_67 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "原因者が特定されるという場合には、直接注意や指導を行っております"@ja.
<< kg:id_67 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "野良猫を忌避する方法を示したり"@ja.
<< kg:id_67 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "自治会と協力して、餌やりや糞尿に関する注意や対応方法についての回覧を作成し、周知"@ja.
<< kg:id_67 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "保護、不妊去勢手術の実施、そして、保護した場所へ返すといった、いわゆるＴＮＲ活動"@ja.
<< kg:id_67 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "野良猫等の不妊去勢手術に対する支援の必要性については認識してございます。現状につきまして再度確認し、野良猫等の不妊去勢手術に対する支援の方策等について検討"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "補助金額が要望額よりも少ない額しか配分されないという形になりまして、被害木として調査した松の約４割が残ってしまう"@ja.
<< kg:id_79 prop:effect kg:id_81 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "被害木として調査した松の約４割が残ってしまうという状況"@ja.
<< kg:id_79 prop:effect kg:id_82 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "推定被害量は、現在、山形県で集計中ではございますが、前年度比として約２倍の被害量を見込んでございます"@ja.
<< kg:id_79 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "年明けからまた伐倒作業に入れるように、予算の確保も含めて準備を進めている"@ja.
<< kg:id_79 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "今回の被害量の増大について、国や県に対し、補助金の予算確保を要求していく"@ja.
<< kg:id_79 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "庄内海岸林松くい虫被害対策強化プロジェクト会議というものがございまして、こちらでどういった形でできるかなという部分について議論"@ja.
<< kg:id_79 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "抵抗性松の苗木については、北庄内森林組合のほうで苗木の生産行っております"@ja.
<< kg:id_87 prop:effect kg:id_88 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "るんるんバス全路線の利用者数ですが、令和４年８月から令和５年７月までの12か月で13万9,769人、対前年同期比で２万2,245人増加"@ja.
<< kg:id_87 prop:effect kg:id_89 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "デマンドタクシーの利用者数は...１万3,511人、対前年同期比で8,402人増加し、2.64倍"@ja.
<< kg:id_87 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "ＪＲ酒田駅前や日本海総合病院へアクセスしやすくした"@ja.
<< kg:id_87 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "高校への通学利用を想定した経路の変更"@ja.
<< kg:id_87 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "運行地区の拡大によって利用者が増えた"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "交通事業者から運転手不足と言われている中で"@ja.
<< kg:id_93 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "山形県は、今年度、第二種免許取得支援事業費補助金の制度を実施しており"@ja.
<< kg:id_96 prop:effect kg:id_97 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "洋上風力発電の導入を契機とした関連産業の創出"@ja.
<< kg:id_96 prop:effect kg:id_98 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "そういった多様な関連産業があることによる企業進出"@ja.
<< kg:id_96 prop:effect kg:id_99 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "そして、その雇用の創出などが考えられる"@ja.
<< kg:id_96 prop:effect kg:id_100 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "選定事業者が行う地域貢献策も義務づけられておりますので、それによる経済波及効果も期待"@ja.
<< kg:id_96 prop:effect kg:id_101 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "洋上に風車が建設、そして、運転開始されることによる環境や景観、漁場等への影響が想定"@ja.
<< kg:id_96 prop:effect kg:id_102 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "また、懸念を示される御意見といたしまして...景観への懸念"@ja.
<< kg:id_96 prop:effect kg:id_103 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "漁業者の方から、やはり漁法の変更を迫られてしまうので、それは大変である"@ja.
<< kg:id_96 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "関係者で構成する法定協議会の中で、どのようなメリット、どのようなデメリットが想定されるか"@ja.
<< kg:id_96 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "この11月１日の市広報にて、酒田市沖で今、どのような洋上風力に係る事業がどういう進捗状況"@ja.
<< kg:id_96 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "市民へ向けて、洋上風力発電に対する理解醸成について、今後、山形県とともに説明会など開催していきたい"@ja.
<< kg:id_107 prop:effect kg:id_108 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "基地港湾の整備という大規模な公共事業への地元建設企業の参入"@ja.
<< kg:id_107 prop:effect kg:id_109 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "本地域へ多くの方がいらっしゃることによる経済波及効果"@ja.
<< kg:id_107 prop:effect kg:id_110 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "洋上風力の運営、そして、メンテナンスを行う新たな産業の形成が図られます"@ja.
<< kg:id_107 prop:effect kg:id_99 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "それに伴った雇用を我々としては期待をしている"@ja.
<< kg:id_107 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "山形県が港湾計画の変更手続を進めております"@ja.
<< kg:id_107 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "適時適切に国会議員への要望活動を展開するなど、働きかけはさせていただいております。先週も国土交通大臣への要望活動実施"@ja.
}
