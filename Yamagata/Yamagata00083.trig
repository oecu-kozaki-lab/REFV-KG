kg:st_1 rdfs:label "多くの専門家"@ja.
kg:st_1 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_1 prop:content "若い人、特に女性の流出が地方の婚姻数減少と出生数減少を招いている"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "国立社会保障・人口問題研究所"@ja.
kg:st_2 rdf:type cls:st_68.
cls:st_68 rdfs:label "研究機関"@ja.
kg:op_2 prop:content "2050年の生産年齢人口割合は44.2パーセントと推計する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "2050年の高齢者人口割合は48.8パーセントと推計する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "働く世代一人が高齢者一人以上を支える時代が来ると推計する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "若い人、特に女性の流出が地域の婚姻数減少につながる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_3 rdfs:label "矢口明子市長"@ja.
kg:st_3 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_6 prop:content "人口減少を緩やかにするため市民所得の向上を重点化する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "若い人が就きたいと思う仕事を創出する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "観光や移輸出で外貨を獲得する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "ローカルSDGsに資する取組を進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "産業の基盤となるインフラを整備する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "生産年齢人口の減少を補うため全ての市民が働ける環境を整備する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "女性、高齢者、障がいのある方、外国籍の方も活躍できるよう支援する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "仕事と家庭の両立を可能にする保育・介護制度を充実させる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "ジェンダー平等意識を啓発する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "機械にできる仕事は機械に任せるためデジタル変革を進める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "移住者、定住者や関係人口を増やす"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "人口が減少しても安心して地域コミュニティで暮らせる仕組みを整える"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "若者、女性、障がい者などの意見を施策に反映する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "庄内全域で考える発想に立った施策に取り組む"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "被害拡大防止のため伐倒駆除を行う"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "被害拡大防止のため薬剤防除を行う"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "ひきこもり状態の方や家族からの相談を支援する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "居場所づくりに取り組む団体を支援する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "複雑化、複合化した相談に対応するため福祉総合相談窓口を設置する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "障がい者への総合的、専門的相談支援や権利擁護のため基幹相談支援センターを設置する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "介護給付費準備基金を活用し2期連続で基準月額を引き下げる"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "家事シェアと家事省力化でケア労働負担を軽減する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "共生社会課を新設し多様性と人権を尊重する共生社会づくりを進める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "結婚を望む独身男女に出会いの機会を提供するためメタバース婚活を実施する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "不安や負担を抱えた家庭に訪問支援事業の利用を勧め支援を強化する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "物価高騰対応交付金を活用し給食費の保護者負担額を据え置く"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "ひとり親家庭や低所得世帯などの料金負担を軽減する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "低所得世帯などを対象に大学等の受験費用を支援する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "新たに中学3年生と高校3年生の模擬試験費用を支援する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "自殺対策施策をより効果的に進めるため有識者会議を設置する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "限られた医療資源を効率的に活用するため医療介護連携DXを支援する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "地域医療を支える看護人材育成のため学生支援を継続する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "宅配などの民間サービスを整理し分かりやすく情報発信する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "団体への助成で猫の繁殖抑制と生活環境改善を図る"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "避難者対応を検証し避難所連絡員配置や備蓄品整備を見直す"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "迅速な情報伝達と効率化のため防災情報一斉配信システムを導入する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "待遇改善で適正な消防団員数を確保し防災体制を維持する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "女性防災リーダーを育成し地域に派遣して女性の視点を防災に反映する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "財産管理人制度などを活用し老朽危険空き家の解消に努める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "古い空き家の解体と新築支援で住宅の耐震化を促進する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "空き家解体を促進するため支援を拡充する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "犯罪被害者等支援条例を制定する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "まちづくり推進課に窓口を設置し相談支援を行う"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "負担軽減のため箱わなセンサーを拡充する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "免許保持者を増やすため狩猟免許取得などに助成する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "地域公共交通の維持拡充のため高校生などにアンケート調査を行う"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "公共交通について識見を有する交通政策顧問を配置する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "利用者ニーズを踏まえ船舶更新に向けた調査を開始する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "道路や遊歩道、避難路の安全確保のため倒木を除去する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "利用する市民と職員双方に優しい市役所窓口を実現する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "市民の利便性向上のため住民票など5種類の証明書手数料を100円引き下げる"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:op_57 prop:content "職員の能力発揮とワークエンゲージメント向上のため人事制度改革室を新設する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_3.
kg:op_58 prop:content "ふるさと納税などにより歳入確保に努める"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_3.
kg:op_59 prop:content "新たな広告収入を確保する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_3.
kg:op_60 prop:content "未利用財産の売払いで歳入確保を図る"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_3.
kg:op_61 prop:content "定額減税により市税は前年度比3.0パーセント減となる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:op_62 prop:content "事業完了により国庫支出金は12.9パーセント減となる"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_3.
kg:op_63 prop:content "ふるさと納税の増額見込みで寄附金は33.1パーセント増となる"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_3.
kg:op_64 prop:content "八幡体育館改築事業などの進捗により市債は7.4パーセント増となる"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_3.
kg:op_65 prop:content "事業完了により投資的経費は13.3パーセント減となる"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_3.
kg:op_66 prop:content "定年引上げに伴う退職手当増額などにより人件費は11.6パーセント増となる"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_3.
kg:op_67 prop:content "子育て支援関連費の増により扶助費は0.6パーセント増となる"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_3.
kg:op_68 prop:content "市債償還終了などにより公債費は10.1パーセント減となる"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_3.
kg:op_69 prop:content "手数料や委託料の増により物件費は10.5パーセント増となる"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_3.
kg:op_70 prop:content "借上料や修繕料の増額により維持補修費は24.6パーセント増となる"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_3.
kg:op_71 prop:content "報償費や分賦金の増額により補助費等は5.1パーセント増となる"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "このような急激な人口減少の原因は、若い人、特に男性よりも女性のほうが多く都会に出て行くことにより、地方都市、つまりその地域における婚姻数が減り、生まれる子どもの数が減っていることであると多くの専門家から指摘されています。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "出生数は、令和５年の１年間で431人と、20年前の約半数となりました。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "住民基本台帳人口は、令和５年の１年間で約1,600人減少し、過去20年間で最大の減少数となりました。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "令和５年12月に公表された国立社会保障・人口問題研究所の推計では、2050年の生産年齢人口の割合は44.2％、高齢者人口の割合は48.8％と、働く世代の人一人が高齢者一人以上を支える時代が来ることが推計されています。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "令和５年12月に公表された国立社会保障・人口問題研究所の推計では、2050年の生産年齢人口の割合は44.2％、高齢者人口の割合は48.8％と、働く世代の人一人が高齢者一人以上を支える時代が来ることが推計されています。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "令和５年12月に公表された国立社会保障・人口問題研究所の推計では、2050年の生産年齢人口の割合は44.2％、高齢者人口の割合は48.8％と、働く世代の人一人が高齢者一人以上を支える時代が来ることが推計されています。"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "若い人、特に男性よりも女性のほうが多く都会に出て行くことにより、地方都市、つまりその地域における婚姻数が減り、生まれる子どもの数が減っていることであると多くの専門家から指摘されています。"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "第一に、人口減少を緩やかにするために、市民所得の向上を図ることです。"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "具体的には、産業を振興し、若い人が就きたいと思うような仕事を創出すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "観光や移輸出など外貨を獲得すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "ローカルＳＤＧｓに資すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "産業の基盤となるインフラを整備することなどに取り組みます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "第二に、生産年齢人口の減少を補うために、働きたいと考える全ての市民が働くことのできる環境を整備することです。"@ja.
<< kg:id_1 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "男性だけでなく女性も、高齢者も、障がいのある方も、外国籍の方も、社会で活躍できるよう支援すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "仕事と家庭の両立を可能にする保育・介護などの制度を充実させ"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "ジェンダー平等意識を啓発すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "機械にできる仕事は機械に任せ、人間は人間にしかできない仕事に専念するためのデジタル変革を進めること"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "移住者・定住者や関係人口を増やすことなどに取り組みます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "第三に、人口が減少したとしても、豊かに安心して暮らせるまちを創ることです。具体的には、子育て・教育・医療・福祉・介護・環境・防災・上下水道・生活道路・住宅などあらゆる面から、人口が減少したとしても安心して地域コミュニティで暮らせる仕組みを整えることに取り組みます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "第四に、人口減少下においても、市民の幸せ（ウェルビーイング）を実現する酒田市にすることです。具体的には、これまで以上に、若者・女性・障がい者などの意見を施策に反映すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "あるものを活かす、庄内全域で考えるという発想に立った施策に取り組みます。"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:text-txt_contents "夏季の高温や少雨の影響により松くい虫被害が増大し"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:text-txt_contents "ビニールハウスなど農業施設への倒木被害が頻発していることから"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "伐倒駆除及び薬剤防除により被害の拡大を防止します。"@ja.
<< kg:id_25 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "伐倒駆除及び薬剤防除により被害の拡大を防止します。"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:text-txt_contents "様々な要因によって引き起こされる社会的な孤独や孤立に寄り添う体制を充実させるため"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "ひきこもりの状態にある方やその家族からの相談や居場所づくりに取り組む団体の活動を支援します。"@ja.
<< kg:id_29 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "ひきこもりの状態にある方やその家族からの相談や居場所づくりに取り組む団体の活動を支援します。"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:text-txt_contents "福祉総合相談窓口は、相談内容の複雑化や複合化に対応するため、包括的な支援体制の充実を図るものです。"@ja.
<< kg:id_33 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "新たに市役所１階の地域福祉課に福祉総合相談窓口と基幹相談支援センターを設置します。福祉総合相談窓口は、相談内容の複雑化や複合化に対応するため、包括的な支援体制の充実を図るものです。"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "基幹相談支援センターは、障がい者への総合的・専門的な相談支援の実施や障がい者の権利擁護・虐待の防止、相談機関との連携強化などを担います。"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "令和６年度から令和８年度までの第９期介護保険料については、介護給付費準備基金を活用して、第８期に続き、２期連続で基準月額を引き下げます。"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "家事シェア及び家事の省力化につながる取組を行い、家庭における家事・育児などのケア労働の負担軽減を図ります。"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "在日外国人に関する事務、海外との都市間交流などの事務及び男女共同参画に関する事務を、市民部に新たに設置する共生社会課で一体的に担うことにより、国籍や性別などの属性にとらわれず相互理解の増進を図り、多様性と人権を尊重する共生社会づくりを推進します。"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "結婚を望む独身男女に出会いの機会を提供するため、婚活スタイルの一つとして注目されているインターネット上の仮想空間であるメタバース内で、自分の分身であるアバターを使って話しながら婚活するメタバース婚活を、山形県、庄内２市３町が連携して実施します。"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "家事や子育てに対して不安や負担を抱えた家庭、また、妊産婦やヤングケアラー等がいる家庭を訪問し、家事や育児の支援を行う子育て世帯訪問支援事業の利用を勧めるなど支援を強化します。"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "子育て世帯の負担を軽減するため、物価高騰対応重点支援地方創生臨時交付金を活用し、小中学校の給食費に係る保護者負担額を据え置きます。"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "子育てと仕事の両立を支援するファミリー・サポート・センターでは、ひとり親家庭や低所得世帯などの料金負担を軽減します。"@ja.
<< kg:id_51 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "家庭の経済状況により大学等への進学を諦めることなく、子どもが将来の目標に向かって進めるよう、低所得世帯などを対象とした大学等の受験費用の支援"@ja.
<< kg:id_51 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "新たに中学３年生と高校３年生の模擬試験費用の支援を行います。"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "特に自殺対策に関する施策をより効果的に推進するため、有識者会議を新たに設置し、その意見を施策に反映します。"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "限られた医療資源を効率的に活用し、将来にわたり市民が必要な医療・介護サービスを受けられる体制を構築するため、日本海総合病院が行う医療・介護連携ＤＸ事業を支援します。"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "地域医療を支える看護人材を育成するため、酒田看護専門学校の学生への支援を引き続き実施し、市内での就業を促進します。"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "買物弱者に対する支援については、宅配などの民間事業者のサービスを整理して、分かりやすい形で情報発信します。"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "飼い主のいない猫に不妊去勢手術を施し、元の場所に戻す活動を行う団体に対して助成を行い、猫の繁殖を抑制しながら、生活環境の改善を図ります。"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "令和６年能登半島地震の際の本市の一連の避難者対応について検証し、避難所連絡員等の配置や防災備蓄品の整備等について見直します。"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "緊急災害情報を複数メディアへ一斉配信できる防災情報一斉配信システムを導入し、迅速な情報伝達と効率化を図り、災害時の体制を強化します。"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "防災体制の要となる消防団員の待遇を改善することにより、適正な消防団員数を確保し、防災体制の維持に努めます。"@ja.
<< kg:id_70 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "女性防災リーダー育成講座を継続して行い、講座受講者を地域に派遣し、女性の視点を防災に反映していきます。"@ja.
<< kg:id_72 prop:effect kg:id_73 >>
    prop:text-txt_contents "地域住民の生活環境・財産に悪影響を及ぼす管理不全な空き家"@ja.
<< kg:id_72 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "財産管理人制度などの活用により、相続人が存在しない老朽危険空き家等の解消に努めます。"@ja.
<< kg:id_75 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "昭和56年以前に建てられた空き家の解体と住宅の新築を支援することにより、住宅の耐震化を促進します。"@ja.
<< kg:id_77 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "特に、住宅が密集している防火・準防化地域において、空き家の解体を促進するための支援を拡充します。"@ja.
<< kg:id_79 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "犯罪被害者等支援条例を制定し"@ja.
<< kg:id_79 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "窓口をまちづくり推進課に設置し、犯罪被害に遭われた方の相談等の支援を行います。"@ja.
<< kg:id_82 prop:cause kg:id_83 >>
    prop:text-txt_contents "熊などの大型獣類捕獲業務の従事者については、高齢化により減少傾向にあるため"@ja.
<< kg:id_82 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "箱わなセンサーの拡充による負担軽減に加え"@ja.
<< kg:id_82 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "狩猟免許取得などへの助成を行い、免許保持者を増やすことにより、有害鳥獣の捕獲体制を強化します。"@ja.
<< kg:id_86 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "バス、タクシー、鉄道など、通学・通勤の足である地域公共交通の維持、拡充を図るため、高校生などを対象にアンケート調査を実施します。"@ja.
<< kg:id_86 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "公共交通について識見を有する交通政策顧問を配置します。"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "定期船とびしまについては、利用者のニーズを踏まえ、船舶の更新に向けた調査を開始します。"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:text-txt_contents "令和５年12月の大雪により発生した飛島地区の倒木"@ja.
<< kg:id_92 prop:effect kg:id_93 >>
    prop:text-txt_contents "道路や遊歩道、避難路などの安全を確保します。"@ja.
<< kg:id_92 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "令和５年12月の大雪により発生した飛島地区の倒木を除去し、道路や遊歩道、避難路などの安全を確保します。"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "総務省のモデル事業として窓口業務の改革に取り組み、利用する市民、事務を行う職員、双方にとって優しい市役所の窓口を実現します。"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "コンビニ交付サービスを利用し、住民票など５種類の証明書を取得する場合の手数料を100円引き下げます。"@ja.
<< kg:id_99 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "人事課に新設する人事制度改革室は、職員の能力を最大限発揮させるとともに、ワークエンゲージメントの高い職場環境を構築するため"@ja.
<< kg:id_101 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "個人版及び企業版のふるさと納税、ネーミングライツを含む新たな広告収入、未利用財産の売払いなどにより、歳入確保に努めます。"@ja.
<< kg:id_101 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "ネーミングライツを含む新たな広告収入"@ja.
<< kg:id_101 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "未利用財産の売払いなどにより、歳入確保に努めます。"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "市税は、定額減税により前年度比3.0％の減としております。"@ja.
<< kg:id_107 prop:effect kg:id_108 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "国庫支出金は、山居倉庫公有化事業や国体記念体育館改修事業の完了などにより、12.9％の減としております。"@ja.
<< kg:id_109 prop:effect kg:id_110 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "寄附金は、ふるさと納税の増額などを見込み、33.1％の増としております。"@ja.
<< kg:id_111 prop:effect kg:id_112 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "市債は、八幡体育館改築事業などの進捗により、7.4％の増としております。"@ja.
<< kg:id_107 prop:effect kg:id_113 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "投資的経費は、前年度比13.3％の減となっております。これは、山居倉庫公有化事業、国体記念体育館改修事業の完了などによるものであります。"@ja.
<< kg:id_114 prop:effect kg:id_115 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "定年引上げに伴う退職手当の増額などにより、人件費が11.6％の増"@ja.
<< kg:id_116 prop:effect kg:id_117 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "子育て支援医療扶助費やさかた子育て応援臨時給付金などの扶助費が0.6％の増"@ja.
<< kg:id_118 prop:effect kg:id_119 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "公債費については、過年度に借入れした市債の償還終了などにより、10.1％の減となっております。"@ja.
<< kg:id_120 prop:effect kg:id_121 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "物件費がふるさと納税推進事業における手数料やデジタル地形図更新委託料などの増により10.5％の増"@ja.
<< kg:id_122 prop:effect kg:id_123 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "維持補修費が道路除雪事業における借上料や物価高騰による修繕料等の増額などにより24.6％の増"@ja.
<< kg:id_124 prop:effect kg:id_125 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "補助費等がふるさと納税推進事業における報償費や酒田地区広域行政組合分賦金の増額などにより前年度比5.1％の増"@ja.
}
