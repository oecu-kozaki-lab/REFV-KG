kg:st_1 rdfs:label "市原栄子議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "国から全額補填されるのか確認を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤弘議員"@ja.
kg:st_2 rdfs:type cls:st_16.
kg:op_2 prop:content "少子化は止まらず加速しているとの認識を示す"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "人口減少の背景に少子化の加速があるとみている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "矢口明子市長"@ja.
kg:st_3 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_4 prop:content "人口減少を前提に事業を考えるべきとする"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "人口減少時代を見据えた医療提供体制の再構築が必要とみる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "介護分野でも人口減少を前提に体制整備を進める必要があるとする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "光熱費高騰や委託料増を見込んだ予算編成か確認を求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "委託費をどのように積み上げたか説明を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "新しい人材育成基本方針の作成と活用方法の説明を求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "人口減少を前提に安心して暮らせるまちづくりを進める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "将来必要な事業への影響を懸念し見直しも必要と指摘する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "総合支所の振興費や市民活動費が拡充された経緯の説明を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "市内企業の人材確保支援が必要と認識する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "多様な人材活躍を支える方向へ政策を転換すべきとする"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "障がい者や高齢者の採用を後押しするセミナーを行う考えを示す"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "買物難民問題が顕著化していると指摘する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "地域の実情把握を踏まえて対策を進める考えを示す"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "若者の声を市政に反映する機会が不足していたと認める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "若い当事者と直接意見交換して市政に反映したいとする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "民間委託との関係も含め市長の行政改革の方向を確認する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:st_4 rdfs:label "田中廣議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_21 prop:content "過去2番目の規模となった要因と特徴の説明を求める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "基金依存が依然残ることへの所見を求める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "基金依存体質は改善されたとは言い難いと認める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "施工期間や観光動線への影響を確認する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "新たな補助金制度の内容と対象団体と狙いの説明を求める"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "市民への説明や周知が足りていないと指摘する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "理解醸成と機運向上を段階的に進める考えを示す"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "子育て世代向け移住体験ツアーの内容と目標確認を求める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "働き方や再就職への不安解消が必要と考える"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "事業内容と酒田DMOとのすみ分けを確認する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "酒田DMOとの相乗効果を期待する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "地域猫活動支援事業の目的と地域理解の進め方を確認する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "頭数減少に伴い時間をかけてトラブル減少を目指す"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "地域の理解と協力が重要とする"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "中心市街地だけ補助拡充する理由に不公平感がないか疑問を示す"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "防火力向上の観点から重点支援が必要とする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "交通政策顧問の役割と運転手確保策を確認する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "運転手不足も含め根本から検討が必要とする"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "神田直弥氏の助言を受け公共交通の在り方を再検討する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "農村RMOの目的やコミュニティ形成の内容を確認する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "地域主体で協議会を設立し伴走支援する考えを示す"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "公共機関集約によるまちづくりの方向性を確認する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:op_43 prop:content "官民連携で中心市街地をトータルにデザインしたいとする"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "使える施設の活用と解体方針を確認する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:op_45 prop:content "使えるものは使う考えで積極的に呼びかけるとする"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "補助金がないため解体が進まない現状への考えを問う"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "利用中施設の修繕を優先するため解体が遅れると説明する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:st_5 rdfs:label "市村浩一議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_48 prop:content "新たな補助金制度の具体内容を確認する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_5.
kg:op_49 prop:content "本市への設置や独自設置の可能性を強く求める"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_5.
kg:op_50 prop:content "庄内地域に整備されるなら本市に誘致したい考えを示す"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "完成まで時間を要するため暫定対応を検討するとする"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "観光行政とDMOの役割分担と課題明確化を求める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_5.
kg:op_53 prop:content "鉄道を活用したインバウンド誘客の具体像を求める"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:st_6 rdfs:label "進藤晃議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_54 prop:content "若者カフェミーティングの具体的進め方を確認する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_6.
kg:op_55 prop:content "具体的行政課題をテーマに当事者の若者と意見交換する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "広報戦略としての目的と戦略を確認する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_6.
kg:op_57 prop:content "市民がまちを知り関わり発信する好循環をつくりたいとする"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_3.
kg:op_58 prop:content "民間の発想を行政に注入し全職員の意識改革につなげたいとする"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_3.
kg:op_59 prop:content "新ソフト導入でどのような学習指導になるか確認する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_6.
kg:op_60 prop:content "コミュニティファンドの規模や運用方法の説明を求める"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_6.
kg:op_61 prop:content "若い世代主体の地域課題解決や地域活性化を後押ししたいとする"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:op_62 prop:content "渋谷キューズの活動目的と効果を確認する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_6.
kg:op_63 prop:content "賃借型立地企業支援の内容と人材育成の取組を確認する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_6.
kg:op_64 prop:content "持続可能な農漁業の令和6年度施策の説明を求める"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_6.
kg:op_65 prop:content "安定した品質と収量確保のため土づくりと事前備えを進める"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_3.
kg:op_66 prop:content "現状を踏まえた水産業施策の展開を求める"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_6.
kg:op_67 prop:content "魚価単価向上と付加価値創出で持続可能な水産業を目指す"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_3.
kg:op_68 prop:content "福祉総合相談窓口による情報共有と支援接続の仕組みを確認する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_6.
kg:op_69 prop:content "令和6年度から試行し適切な支援につなげたいとする"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_3.
kg:op_70 prop:content "設置目的と支援体制の説明を求める"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_6.
kg:op_71 prop:content "家事シェア推進月間の設定時期や内容を確認する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_6.
kg:op_72 prop:content "各家庭が自分事として家事分担を見直す契機にしたいとする"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_3.
kg:op_73 prop:content "メタバース婚活実施の経緯と方法を確認する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_6.
kg:op_74 prop:content "若い世代のニーズに即した新しい婚活スタイルとして導入する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_3.
kg:st_7 rdfs:label "庄内町"@ja.
kg:st_7 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_75 prop:content "メタバース婚活は対面型より申込者が多くマッチング率も高かったと情報提供する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_7.
kg:op_76 prop:content "具体的に想定する活動の説明を求める"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_6.
kg:st_8 rdfs:label "後藤泉議員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_77 prop:content "伝統的な性別役割分担意識をなくす施策をさらに打ち出すべきと求める"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_8.
kg:op_78 prop:content "寄附金頼みの予算にはリスクもあり財源確保戦略が必要と指摘する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_8.
kg:op_79 prop:content "ふるさと納税以外の財源確保にも取り組む考えを示す"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_3.
kg:op_80 prop:content "空き家対策や住宅総合支援事業が拡充された要因を確認する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_8.
kg:op_81 prop:content "継続的に維持していくための施策展開を確認する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_8.
kg:op_82 prop:content "各支援機関がチームで連携できる体制を完成させたいとする"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "減収額は、令和５年度分課税実績を基に、調定ベースで約３億9,000万円と積算をしております。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "この減収分につきましては、地方特例交付金によって国庫より補填されます。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "減収分は全額補填されるため、市の財政への影響はないものと想定しております。"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "2023年度の出生数の速報値においても、12年ぐらい先の結果が出ており"@ja.
<< kg:id_7 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "少子化が止まりません。もうむしろ加速しているという、そんな感じがしています。"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "人口減少ということが様々な地域課題の根底にあると位置づけまして"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "訪問診療の先生が減る、それでも高齢者は増えていく"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "介護の分野でも人口が減る中で安心・安全の介護提供体制を取るための話合いも進められております。"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "令和６年度予算は令和５年度当初予算と比較し、燃料費及び光熱水費で約1,500万円"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "施設管理委託料で約6,390万円の増額となっております。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "リスキリングによる計画的な人材育成、それから、職員のエンゲージメントの把握、そして、デジタル人材の育成・確保などの項目が示されておりますが、本市の基本方針には記載されておりません。"@ja.
<< kg:id_14 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "令和６年度に設置する人事制度改革室において、人事制度全般の改革や見直しに取り組む中で、国の指針に合わせた酒田市人材育成基本方針の改定についても検討してまいりたいと思います。"@ja.
<< kg:id_7 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "人口の減少を抑制しながら、たとえ人口が減少したとしても豊かに安心して暮らせるまちをつくるとしています。"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "令和５年度から令和９年度までの５年間の発行総額は150億円以内に抑えられる見込みとなっております。"@ja.
<< kg:id_18 prop:contermeasure kg:id_20 >>
    prop:text-txt_contents "財政調整基金についても、引き続き30億円を維持できる見込みとなっております。"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:text-txt_contents "特に市からの財政負担が大半を占めるような事業や、主に市職員が運営を行う事業など、公平性や事業効果、事業の継続性に課題のある事業については"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "持続可能な事業として令和６年度予算に計上した、そういう経緯でございます。"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "企業等の多くから人手不足だという声が聞こえております。"@ja.
<< kg:id_25 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "障がい者や高齢者、外国人など多様な人材が活躍できるよう支援することが必要だと考えております。"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:text-txt_contents "これまで障がい者や高齢者の雇用をちゅうちょしていた企業が"@ja.
<< kg:id_28 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "採用を考慮できるよう後押しするようなセミナーを実施したいと考えております。"@ja.
<< kg:id_31 prop:contermeasure kg:id_32 >>
    prop:text-txt_contents "これらの取組により、10名の障がい者を雇用することができました。"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "地元商店やスーパーなどの撤退、廃業による買物難民の問題が顕著化しています。"@ja.
<< kg:id_33 prop:contermeasure kg:id_35 >>
    prop:text-txt_contents "買物支援サービスに関する情報を市ホームページに掲載することを予定しております。"@ja.
<< kg:id_33 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "ヒアリングを行い、地域の実情を把握した上で地域と相談しながら施策の展開を行ってまいります。"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "これまでの広聴では、若者の声を聴き、市政に反映していく機会が少ないという課題があったことから"@ja.
<< kg:id_37 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "若者カフェミーティングを実施することといたしました。"@ja.
<< kg:id_40 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "行政改革は、コストカットではなくて、市民生活の向上、地域課題の解決という究極の目的を達成するために、行政が適切に機能するように日々の行政の仕組みを変えていくことだと考えております。"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "ふるさと納税寄附金歳入見込みを令和５年度当初予算の30億円から、令和６年度当初予算40億円に増加したことに伴い、歳出面でも返礼品の費用、基金の積立金が増えたこと。"@ja.
<< kg:id_42 prop:cause kg:id_44 >>
    prop:text-txt_contents "定年延長に伴う退職手当などの人件費の増"@ja.
<< kg:id_42 prop:cause kg:id_45 >>
    prop:text-txt_contents "光熱水費や物価高騰の影響を受けた委託料、維持補修費、修繕費などの増が原因だと捉えております。"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "人件費、それから物件費、これは委託料、光熱水費などですけれども、その増額分の財源を確保するには至らなかった"@ja.
<< kg:id_46 prop:effect kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "基金依存の体質が改善されたとは言い難く、引き続き公共施設の在り方や事業の見直しは必須になると考えております。"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "そこが特に樹勢の衰退しているケヤキがありますので"@ja.
<< kg:id_49 prop:contermeasure kg:id_51 >>
    prop:text-txt_contents "そこに対して剪定や土壌改良などを行う予定であります。"@ja.
<< kg:id_49 prop:effect kg:id_52 >>
    prop:text-txt_contents "約２年の養生期間、経過観察を経て、十分な効果が得られていることを確認した上で、同様の方法で順次実施していく予定です。養生期間の約２年の間は、木製のバリケードの設置による立入禁止区域を設けます。"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:text-txt_contents "市内には様々なアイデアや行動力を持って文化芸術活動を行っている方がたくさんいらっしゃいます。"@ja.
<< kg:id_53 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "アートプロジェクト活動支援補助金制度を創設いたしたいと思います。"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "メリット、デメリットをしっかり把握し、整理した上で行うほうが良いのではないか、また、本地域の理解醸成や機運の高まりの進捗を確認しながら"@ja.
<< kg:id_56 prop:contermeasure kg:id_58 >>
    prop:text-txt_contents "開催を令和６年度に見送ることといたしました。"@ja.
<< kg:id_56 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "再生可能エネルギーへの期待を啓発するセミナー、２つ目として、主力電源化の切り札として期待される洋上風力発電についての勉強会を複数回開催し"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "本市出身でない配偶者と子どもと一緒に本市で暮らすイメージを持てるような機会にしたい"@ja.
<< kg:id_60 prop:contermeasure kg:id_62 >>
    prop:text-txt_contents "親子移住体験ツアー"@ja.
<< kg:id_60 prop:contermeasure kg:id_63 >>
    prop:text-txt_contents "ツアーの行程には企業や企業人との出会いを盛り込んでおりまして、市内企業の魅力を伝えるとともに、先輩移住者との交流を通じて"@ja.
<< kg:id_60 prop:effect kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "本市で働く、再就職するといった不安を解消したいと考えております。"@ja.
<< kg:id_65 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "専門家（地域力創造アドバイザー）を招聘する"@ja.
<< kg:id_65 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "招聘するアドバイザーと酒田ＤＭＯが相互のノウハウを共有し、本市の観光施設等の課題解決に知恵を出し合うことで"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "野良猫の繁殖抑制を進めることを主目的としております。"@ja.
<< kg:id_68 prop:contermeasure kg:id_70 >>
    prop:text-txt_contents "市内全域において、ＴＮＲ活動を行う団体に補助を行うものであり"@ja.
<< kg:id_68 prop:effect kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "必ずしも野良猫によるふんのトラブルなどがすぐに減るものではない"@ja.
<< kg:id_68 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "地域が主体となって、野良猫の餌やりやトイレの管理を行う地域猫活動の取組は、今後ますます重要"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "住宅が密集しておりまして、郊外と比較して老朽化した家屋が多く存在しております。"@ja.
<< kg:id_73 prop:contermeasure kg:id_75 >>
    prop:text-txt_contents "空き家の解体を進めることで、地域の防火力の向上を図ることを目的に補助金を割増しして支援する"@ja.
<< kg:id_73 prop:effect kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "延焼しやすく大火につながるおそれがあります"@ja.
<< kg:id_77 prop:cause kg:id_78 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "高校生、それから、観光客などの利便性向上は十分に達成できなかったと感じております。"@ja.
<< kg:id_77 prop:cause kg:id_79 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "運転手不足という大変な問題がございます。"@ja.
<< kg:id_77 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "交通政策顧問に就任していただくことを考えております。"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "中山間地は、平野部と比べて人口減少や高齢化が著しく、買物や子育て、生活の足や祭りといった、日々暮らし続けていくための課題が大きくなっております。"@ja.
<< kg:id_81 prop:cause kg:id_83 >>
    prop:text-txt_contents "農地周辺の除草や農業用水路の管理などにおける人手不足、それから、山際等にある小さくて不整形な農地の荒廃"@ja.
<< kg:id_81 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "農村ＲＭＯとは、これらの問題に対応するため、中山間地域で集落営農や農業法人等の農業者の組織と自治会等の多様な関係者が連携して協議会を設立しまして、集落機能の補完をしつつ、農用地の保全、地域資源の活用といった経済活動と併せて、生活支援等の地域コミュニティの維持を行うものであります。"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "事業所の統廃合や郊外への居住移転などにより、中心市街地の人口は市全体の平均よりも人口減少が進んでいる状況にあります。"@ja.
<< kg:id_85 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "公共機関の集約をはじめ、デジタル関連企業等民間事業者の誘致なども進めまして、官民連携したまちづくりの検討を進め"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "買手がつかない施設については、借りたい方へ貸付けするなどしております。"@ja.
<< kg:id_88 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "市ホームページに売却可能な施設として掲載しております。そして、積極的に入札を行うなどしてＰＲをしております。"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "施設を単に解体する場合、一般財源、もしくは交付税措置のない起債、つまり単なる借金でしか解体費に充てることができません。"@ja.
<< kg:id_91 prop:effect kg:id_93 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "既に廃止した施設の解体よりも、現在市民の皆様が利用している施設の修繕費に優先的に充てたい"@ja.
<< kg:id_94 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "アートプロジェクト活動支援補助金を創設いたしたいと思います。"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "スワンスケートリンクは、県内唯一の屋内スケートリンクとして"@ja.
<< kg:id_96 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "屋内スケート施設の整備については、引き続き山形県に要望していきたいと思います。"@ja.
<< kg:id_96 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "既存の公共施設あるいは民間施設を利用した低コストの仮設スケートリンクの整備が可能かどうかを検討している"@ja.
<< kg:id_100 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "以上のように、行政と酒田ＤＭＯの役割は分けられていると考えております。"@ja.
<< kg:id_102 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "海外のインフルエンサーの招聘を行って、豊かな自然の景観を楽しみながら、鉄道を使って本市に来ることの魅力のＰＲ"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "市民協働を推進するため、まちづくりを「自分事」とする市民を増やすことを目標としましたが、未達成という成果になりまして"@ja.
<< kg:id_104 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "３か月に１回程度の開催を考えております。"@ja.
<< kg:id_107 prop:cause kg:id_108 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "まちづくりを「自分事」とする市民を増やすことを目標としましたが、未達成という成果になりまして"@ja.
<< kg:id_107 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "シビックプライド（郷土愛）を高めるプロモーション、市民をターゲットとする意味でインナープロモーションとも言いますけれども、それを中心に取り組みたい"@ja.
<< kg:id_107 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "民間の副業人材の活用に新たに取り組みたいと思います。"@ja.
<< kg:id_111 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "プログラミング学習ソフトＱＵＲＥＯは、体系的な学習カリキュラムが組まれており、動画や解説を基に、基礎・基本から高校卒業レベルまでのプログラミングについて学習することができる"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "これまで声が届きづらかった若い世代などとの対話と協働を促し、伴走支援を伴う資金提供を通じて新たな挑戦を生むきっかけを与える"@ja.
<< kg:id_113 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "コミュニティファンドについては、若い世代が主体性を持ち、地域課題解決や地域活性化の取組、市民自らやりたいことができる社会を実現することを目的としております。"@ja.
<< kg:id_116 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "渋谷キューズを拠点に職員を配置し、酒田市として首都圏において外貨を稼ぐための市外需要の掘り起こしを目的とする活動"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "本市の大きな課題である生産年齢人口の減少、特に若年層の流出を抑える有効な施策として位置づけている"@ja.
<< kg:id_118 prop:contermeasure kg:id_120 >>
    prop:text-txt_contents "現行の３年から５か年に拡充するものであります。"@ja.
<< kg:id_121 prop:cause kg:id_122 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "肥料価格の高騰をはじめとする生産コストの上昇や、昨年の猛暑等の異常気象への対応といった課題を抱えております。"@ja.
<< kg:id_121 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "スマートオーガニック推進事業等の中で関連する施策を実施し、異常気象下でも安定した品質と収量を確保できる土づくりを推進"@ja.
<< kg:id_124 prop:cause kg:id_125 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "スルメイカの漁獲量は１月末で約335トン、水揚金額は約４億4,000万円で、昨年度比で漁獲量は42％"@ja.
<< kg:id_124 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "県外のイカ釣り船の誘致に向け、乗組員の生活支援として酒田産つや姫の提供やイカを入れる箱の購入等への支援"@ja.
<< kg:id_127 prop:cause kg:id_128 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "対応すべき福祉行政は複雑化・複合化しており、従来のように高齢者や障がいを持つ人など、分野ごとに縦割りの枠組みでは対応が難しい状況"@ja.
<< kg:id_127 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "庁内連携シート、それから...多機関連携シートを使い、情報連携するよう"@ja.
<< kg:id_130 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "専門の相談支援員を配置するセンターを開設することで、より一層の充実を図る"@ja.
<< kg:id_132 prop:cause kg:id_133 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "家事育児等の家庭内ケア労働に費やす時間は女性のほうが長くなっております。"@ja.
<< kg:id_132 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "夏休みの時期を家事シェア推進月間と設定をいたしまして、市民参加型の家事シェアチェック宣言を実施し"@ja.
<< kg:id_135 prop:cause kg:id_136 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "従来の婚活イベントでは、特に女性の参加者が少ないという課題もあり"@ja.
<< kg:id_135 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "庄内地域全体での婚活イベントの実施に向けて調整を行ってきた"@ja.
<< kg:id_135 prop:effect kg:id_138 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "従来の対面型イベントよりも参加申込者が多く、マッチング率も高かったと情報提供がございました。"@ja.
<< kg:id_139 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "ローカルＳＤＧｓ推進室の目的は、地方自治体が担える気候変動への適応、循環型経済社会の構築、地域経済の活性化の３つの重なり合うプロジェクトの実施に向けた具体的な検討"@ja.
<< kg:id_141 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "家事の分担を女性だけではなく男性も共に担う風土をこの地域に根づかせていくことですとか"@ja.
<< kg:id_143 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "返礼品等開発支援補助金の取組を通じて、これまでにない魅力的な返礼品の開発をさらに強化し"@ja.
<< kg:id_143 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "ネーミングライツ...新たな広告収入、それから未利用財産の売払いにも力を入れてまいります。"@ja.
<< kg:id_146 prop:cause kg:id_147 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "所有者不明または管理不全な空き家等の改善を図るため"@ja.
<< kg:id_146 prop:contermeasure kg:id_148 >>
    prop:text-txt_contents "財産管理制度...その制度に係る裁判所への申立て費用の増額あるいは書類作成代行費用についての拡充を行いました。"@ja.
<< kg:id_149 prop:cause kg:id_150 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "重層的支援体制整備事業を構成する一部の事業について未実施である"@ja.
<< kg:id_149 prop:contermeasure kg:id_151 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "令和７年度からの本格実施に向け、令和５年度から移行準備事業に着手している"@ja.
}
