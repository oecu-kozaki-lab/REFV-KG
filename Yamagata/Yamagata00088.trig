kg:id_143 prop:countermeasure kg:id_144.
kg:st_1 rdfs:label "千葉衛議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "市独自の軽減措置を検討すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "負担増家庭への軽減措置が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "全国の自治体の動きも調査し市独自対策を打ち出すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "阿部寿一市長"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "他市の例も検討し必要なら市独自支援も真剣に検討する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "利用手控えの実態把握と配慮した対策が必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "丁寧な見直しを継続すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_3 rdfs:label "30歳を超える障害者の子供さんを持つ親御さん"@ja.
kg:st_3 rdf:type cls:st_69.
cls:st_69 rdfs:label "保護者"@ja.
kg:op_7 prop:content "負担増よりも親亡き後の子供の将来が心配"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:st_4 rdfs:label "障害者の子供を持つ保護者会全体"@ja.
kg:st_4 rdf:type cls:st_69.
kg:op_8 prop:content "将来不安が強い"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "社会的支援を具体化していくしかない"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "障害福祉計画見直しの中で切実な要望にこたえるよう努力する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "PR不足があってはならず周知を進める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "今後増えることも予想されるため活用を進めたい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "PRと相談対応で有効活用を進める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "制度切り換え時の説明不足が不満の一因"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "制度変更の丁重な説明を継続すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_5 rdfs:label "佐藤幸一健康福祉部長"@ja.
kg:st_5 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_16 prop:content "説明はまだ不十分で今後も丁寧に説明する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:op_17 prop:content "利用サービス低下への配慮が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "やむを得ない事例は市独自判断で使用を認めるべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "対象外利用者へ継続して説明する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_5.
kg:op_20 prop:content "現在の委託料で今後も順調に経営できるのか疑問"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "実態に見合った委託料設定を検討する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "各事業所と協議し委託料設定を検討する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "酒田市方式で支援体制を継続し充実させる"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "成年後見制度等にも対応できるよう体制整備に努める"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "制度背景に環境意識の高まりがある"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "担い手不足も制度の背景"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "高齢化も制度の背景"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "可能な限り多くの集落で取り組めるよう努力する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "必要額を確保し可能な限り予算化する方針"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "環境により配慮した農業推進が必要"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "生き物に配慮した農業を進めるべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "環境に優しい農業への支援策として期待する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "自然回復力を生かす魚道整備が有効"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:st_6 rdfs:label "和田邦雄農林水産部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_34 prop:content "制度の中で取り組めるよう検討したい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "環境配慮型農業の実現へ展望がある"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "環境配慮型農業の一環として重要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "利用機会を増やし米消費拡大に結びつけるべき"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "まだ完全普及には至っていない"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_6.
kg:st_7 rdfs:label "JA女性部の皆さん"@ja.
kg:st_7 rdf:type cls:st_70.
cls:st_70 rdfs:label "団体"@ja.
kg:op_39 prop:content "やりたいことは多いが十分に手が回っていない"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_7.
kg:op_40 prop:content "農林水産まつりなどで市民に訴える"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "農業関係者と行政だけでなく食品業者とも協力する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:st_8 rdfs:label "石堂栄一商工観光部長"@ja.
kg:st_8 rdf:type cls:st_18.
kg:op_42 prop:content "観光資源を生かした取り組みとして大変注目している"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_8.
kg:op_43 prop:content "市も全面的に協力した"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_8.
kg:op_44 prop:content "映画村への職員派遣を含め関わり方を検討する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_8.
kg:op_45 prop:content "街中にシネサロンのような映画館を再現できないか"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "まちなか観光振興活性化の面から一考の余地がある"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "街の活性化の面から手法を勉強したい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_8.
kg:op_48 prop:content "補装具の交付は1割負担をお願いする形になる"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_5.
kg:op_49 prop:content "学童については市で1割負担を負担する姿勢を検討してほしい"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "児童の補装具更新と負担実態を見ながら検討する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_5.
kg:op_51 prop:content "魚道やたまりをつくれば回復が期待できる"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "水生生物のモデルとなるような水辺が欲しい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "できるところから取り組めるよう検討する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_6.
kg:st_9 rdfs:label "菅原良明議員"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_54 prop:content "燃やすごみ処理ではなく活用を考えるべき"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_9.
kg:st_10 rdfs:label "松本恭博企画調整部長"@ja.
kg:st_10 rdf:type cls:st_18.
kg:op_55 prop:content "県内事例を含め研究していく"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_10.
kg:op_56 prop:content "現在はまだ設置しておらず今後手法を模索する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_10.
kg:op_57 prop:content "関係課と連携し各種施策が展開できる手法を模索する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_10.
kg:op_58 prop:content "直ちに制度化や実証プラントには課題がある"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_10.
kg:op_59 prop:content "採算に合うかが事業化の大きなポイント"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_6.
kg:op_60 prop:content "県内事例を参考に酒田市でも意義ある取り組みを"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_9.
kg:op_61 prop:content "可能性は十分あり今後研究を進める"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_6.
kg:op_62 prop:content "認定変更後も続く問題として市が受けとめ検証すべき"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_9.
kg:op_63 prop:content "理解を得るため訪問や説明を継続する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_5.
kg:op_64 prop:content "理解を得るため訪問説明を継続する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_5.
kg:op_65 prop:content "利用者ニーズとサービスのミスマッチを調査すべき"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_9.
kg:op_66 prop:content "自立支援の観点から制度のあるべき姿に沿った再編と考える"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_5.
kg:op_67 prop:content "広がらないことは問題であり広がるよう努める"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_5.
kg:op_68 prop:content "認知症対応も含め重要サービスとして広がるよう努める"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_5.
kg:op_69 prop:content "報酬差が連携に影を落とさないか懸念"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_9.
kg:op_70 prop:content "平成18年7月末現在100件を委託し単価は1件月額3600円"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_5.
kg:op_71 prop:content "老老介護や多就労家族が中重度者を受け入れられるか心配"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_9.
kg:op_72 prop:content "県と連携し情報収集し退院後ニーズを確認しながら相談に応じる"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_5.
kg:op_73 prop:content "地域ケア整備方針や整備構想を踏まえ相談対応する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_5.
kg:op_74 prop:content "再編統合の話を整理してから改築に向かうべきと考えた"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "地域医療のレベルアップを第一に据えて議論する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "重要な視点として独立行政法人も十分視野に入れている"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:st_11 rdfs:label "栗谷義樹病院長"@ja.
kg:st_11 rdf:type cls:st_71.
cls:st_71 rdfs:label "病院長"@ja.
kg:op_77 prop:content "県立病院に市立病院が吸収されるのではないかという動揺がある"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_11.
kg:op_78 prop:content "過重労働解決には再編統合しかない"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_11.
kg:op_79 prop:content "拙速は避けつつ精力的に議論し早期に安定させるべき"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "早期に結論を出し協議会で具体像を明らかにしてほしい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_11.
kg:op_81 prop:content "頑張っている医療関係職員の雇用は基本的に守るべき"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "改築も再編も決断しないなら病院の将来は厳しい"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_11.
kg:op_83 prop:content "指定管理者制度の目的理念はこれに尽きる"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "任せっきりではなく定期的チェックと市民意見のフィードバックが大事"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "管理に必要不可欠なものは原則公表するルール化が必要"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "行政だけでなく民間提案を受ける仕組みも試したい"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:op_87 prop:content "毎年の調査で未設置地域のニーズを把握している"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_5.
kg:op_88 prop:content "小規模であるため地域協力を得た方式を検討する"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_5.
kg:st_12 rdfs:label "石黒覚議員"@ja.
kg:st_12 rdf:type cls:st_16.
kg:op_89 prop:content "事故が起きる前に最低のガイドラインを見直してつくるべき"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_12.
kg:op_90 prop:content "リスクマネジメントも含めガイドラインをひとつまとめたい"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_5.
kg:st_13 rdfs:label "五十嵐龍一教育部長"@ja.
kg:st_13 rdf:type cls:st_18.
kg:op_91 prop:content "オール酒田で考えつつ地域意向に柔軟対応する"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_13.
kg:op_92 prop:content "子供たちの良好な教育環境確保のため新たな議論が必要"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_12.
kg:op_93 prop:content "対応が急がれる学校から話し合いを進める"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_13.
kg:op_94 prop:content "中途半端な発想転換では現状打開は難しい"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_12.
kg:st_14 rdfs:label "阿蘇弘夫建設部長"@ja.
kg:st_14 rdf:type cls:st_18.
kg:op_95 prop:content "街は単体では成り立たず複合的な組み合わせが必要"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_14.
kg:st_15 rdfs:label "佐藤忠智議員"@ja.
kg:st_15 rdf:type cls:st_16.
kg:op_96 prop:content "産業構造の転換が必要"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_15.
kg:op_97 prop:content "大消費地との交流なくして経済的豊かさはあり得ない"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_15.
kg:op_98 prop:content "このままでは地域雇用に大きな悪影響が出る"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_15.
kg:op_99 prop:content "農業と雇用の構造転換が必要"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_15.
kg:op_100 prop:content "環境時代を見据えリサイクルポート事業を進めている"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_2.
kg:op_101 prop:content "周辺産業も含めた誘致を進めてきた"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_2.
kg:op_102 prop:content "技術と経営基盤のしっかりした企業を育てることが重要"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_2.
kg:op_103 prop:content "医療福祉分野は将来的な発展が見込める"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_2.
kg:op_104 prop:content "常に効率的で最大限の効果を上げる組織機構をつくる必要がある"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_2.
kg:op_105 prop:content "地域住民の理解が不可欠"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_15.
kg:op_106 prop:content "住民は障害の状態がよくわからず不安を感じることがある"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_5.
kg:op_107 prop:content "市は施設必要性と地域生活を考慮し住民意向も踏まえる"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_5.
kg:op_108 prop:content "行政は計画実現のため住民説明の場にもかかわる責務がある"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_5.
kg:op_109 prop:content "事業者が住民との間でかかわりを持ちトラブルなく来ている"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_5.
kg:op_110 prop:content "社会的自立の基盤として非常に大事であり各企業にお願いしている"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_8.
kg:op_111 prop:content "就業者367名求職者200名超を把握している"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_8.
kg:st_16 rdfs:label "渡会豊明総務部長"@ja.
kg:st_16 rdf:type cls:st_18.
kg:op_112 prop:content "法の趣旨を尊重し雇用拡大に努める"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_16.
kg:op_113 prop:content "小規模企業でも受け入れ可能な場合がある"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_15.
kg:op_114 prop:content "各種奨励金を紹介し小規模企業にもお願いしていく"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_8.
kg:st_17 rdfs:label "高橋千代夫議員"@ja.
kg:st_17 rdf:type cls:st_16.
kg:op_115 prop:content "酒田測候所の存続が必要"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_17.
kg:op_116 prop:content "地域経済振興住民の安全安心災害時危機管理のため存続が必要"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_17.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "問題は区分によって大幅に負担がふえる家庭が出ることだろうというふうに思います"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "一例として、食費、光熱費を含め実際の負担増が月に２万7,800円になった家庭がありました"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "山形市独自の軽減措置などを参考に、全国の自治体での動きも調査し、市独自の対策を打ち出していただきたいと思っていますが、いかがでしょうか。 他市の例なども検討し、どんな課題があって、どういう制度が必要なのかということは十分検討して、市としても適切な対応、例えば関係各方面に御意見を申し上げるとか、もしくはやはり市独自の支援が必要なのではないかというところにもなるかもしれません。そういうような形での検討を真剣に重ねていきたい"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "利用度に応じた負担になったことで施設の利用を手控えている人もいると聞きました"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "支援法も実際に運用してみると、さまざまな課題が生じているように私は思います"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "私は負担します。それより心配なのは、私たちが死んだ後の障害を持つ子供の将来のことです この心配は障害者の子供を持つ保護者会全体としても強い"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "今後ともホームヘルプ、訪問介護、グループホーム、成年後見制度などの社会的支援を効果的に組み合わせた施策の具体化を図っていくしかない 市では本年度、障害福祉計画の見直しを予定してございます"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "ＰＲ不足ということがあってはいけませんので、そのＰＲも欠かすことはしないようにいたします"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "成年後見制度については平成17年度に制度化されてから１件しか実績がない"@ja.
<< kg:id_12 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "そのＰＲも欠かすことはしないようにいたします。この活用についても十分相談に応じながら有効に活用していきたい"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "認定が変わった人の中にはこの認定変更によって認定が切り下げられたと受けとめて不満に思っている"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "私は１つの要因として、制度切り換え時の説明不足があったように思います 利用者に対する詳細な説明がまだまだ不十分だということがありますので、今後とも訪問などを通してこの要介護認定にかかわる大きな制度改正については丁寧に説明をしてまいりたい"@ja.
<< kg:id_16 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "認定が変わって、今まで利用できたサービスが受けられないケースもあると聞きます"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "要支援１、２と要介護１の人は10月から車いす、電動ベッドなどの福祉用具の使用が認められなくなる やむを得ない事例に対しては市独自に判断して、使用を認めることなどは考えられないものか 今後ともこの制度対象外となる利用者につきましては継続して説明をしていかなければいけない"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "この地域包括支援センターが現在の委託料で今後も順調に経営を進めていくことができるのか、私は疑問に思いました 実態に見合った委託料の設定について検討をしていかなければいけない"@ja.
<< kg:id_22 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "事業の実施状況や各事業所の収支状況などを踏まえながら、各事業所とも協議を行い、実態に見合った委託料の設定について検討をしていかなければいけない"@ja.
<< kg:id_22 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "酒田市は酒田市の方式で高齢福祉課に保健師を４名配置し、定期訪問や個別の高齢者への相談、支援に対応しております"@ja.
<< kg:id_22 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "成年後見制度等に対応するためにも、これまでの相談実績を踏まえながら十分対応ができるように研修を受けるなど支援体制を充実させるように、今後とも体制整備に努めていきたい"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "この制度の背景になったものは、議員から御指摘がありましたように農業と環境の問題に対する国民的な意識の高まり"@ja.
<< kg:id_27 prop:cause kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "農村部における担い手の不足、高齢化、こういうことが背景になっている"@ja.
<< kg:id_27 prop:cause kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "農村部における担い手の不足、高齢化、こういうことが背景になっている"@ja.
<< kg:id_27 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "ＪＡ、それから土地改良区、市役所ということで連携をとって、この制度のＰＲでありますとか制度への取り組みを進めていこうというような状況になってございます"@ja.
<< kg:id_27 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "予算については全力を挙げてその必要額を確保していきたい 可能な限り要望のあるところについては全力を挙げて予算化をしていく"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "圃場整備が完了したこの十数年で庄内平野での生物相ががらっと変わったという印象を持っています"@ja.
<< kg:id_33 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "かつては水田周辺で230種の生物がいたと言われていますが、私が見る限りでは用水路、排水路、ほんの数種しか今残っていない"@ja.
<< kg:id_27 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "環境に優しい農業への支援策として、生き物調査の実施"@ja.
<< kg:id_27 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "水田畦畔での魚道の設置 今の施策のように魚道をつくったり、たまりをつくったりすれば、私はかなり回復するのではないか 今、議員がおっしゃるような制度も組み込まれておりますので、できるところからということになりますが、今のような考えも検討していただいて取り組めるように検討はさせていただきたい"@ja.
<< kg:id_27 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "化学肥料と化学合成農薬使用の制限"@ja.
<< kg:id_27 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "ため池などの草刈り"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "実績表を見て、私は利用度が低いと思いました なかなかまだ完全普及とまではいっていない"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "新しい食べ方の開発や宣伝、ＰＲ方法や米粉を利用した料理教室など、やりたいことはたくさんあるけれども、まだ十分には手が回っていない"@ja.
<< kg:id_40 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "市でもＪＡと連携をしながら、市独自でも２回の料理教室をしながら、いろいろなレシピを設けて普及に努めてまいりました 10月22日に農林水産まつりがありますので、これまでのいろいろなレシピですとかパンのつくり方ですとか、そのようなものも紹介をしながら、市民の皆さんに訴えていきたい"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "農業関係者、行政だけではなく市内の食品業者の方々も多くいらっしゃいますので、その方々にも呼びかけをし、いろいろな御協力もいただきながら普及拡大に努めていきたい"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "庄内全体としての、観光面も含めてでありますが、その効果というものは大いに期待をしている"@ja.
<< kg:id_48 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "そのときの窓口は、まずは観光物産協会で、もちろんこの後ろには市も全面的に協力をさせていただいたというものがありますが、協会を一つの窓口にして協力体制を構築した"@ja.
<< kg:id_48 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "これは一自治体というよりは庄内全体としての自治体としてどうかかわっていけるのか、ここについては勉強してまいりたい"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "シネコンが上映しないいろいろな映画を見たいという声もあります"@ja.
<< kg:id_51 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "こうした取り組みは、私はまちなかの観光振興、活性化の面からも一考の余地があると思っている やはり街の活性化という面から、この旧山王くらぶに限らず、空き店舗の活用、こういったことも含めてどのような手法で可能なのか、これから少し勉強していきたい"@ja.
<< kg:id_54 prop:effect kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "補装具の交付につきましては、おっしゃるように１割の負担をお願いする"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "私はそうした点で学童については負担していく、そういう姿勢を今後検討していただきたい 児童の、いわゆる補装具の新規更新などの回数だとか、あるいはそのたびの負担がどうなるかということなどについても実態を見ながら、今、千葉議員さんから指摘がありました点については検討させていただきたい"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "用排水路完全分離で、しかもコンクリートですから、産卵するところがなくて、魚は田んぼにも入れない"@ja.
<< kg:id_58 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "今の施策のように魚道をつくったり、たまりをつくったりすれば、私はかなり回復するのではないか できるところからということになりますが、今のような考えも検討していただいて取り組めるように検討はさせていただきたい"@ja.
<< kg:id_61 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_54;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "廃食油について、地域住民の収集への協力によりバイオディーゼル燃料として公用車に使用している自治体や事業化に取り組んでいる地域がある これらの事例を含めて研究してまいりたい"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "現在はまだ設置をしてございません"@ja.
<< kg:id_63 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "今後、関係課と連携をしながら、市民、事業者、それから市が一体となって各種施策が展開できる手法を模索してまいりたい"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_58;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "これらのバイオエネルギーにつきましては、まだまだコスト上の問題で課題がある 採算に合うかどうかというのが事業化の一番大きいポイント"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_60;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "菜の花プロジェクトという取り組みもあり 地域一体となって農業振興、転作田等で菜の花を植え、それを燃料として活用し、また廃食油をリサイクルをしていくというような事業 可能性は十分にあると存じていますので、今後とも研究については進めてまいりたい"@ja.
<< kg:id_70 prop:effect kg:id_71 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_62;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "本人や家族に戸惑いや混乱があり、そのためサービスが受けられなくなり、これからの生活をどうすればよいのか悩んでいる方も私自身も目にしております 制度の説明が足りず、戸惑いを持つ方もおられる"@ja.
<< kg:id_70 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "私どもとしてはこのような方々に対して理解を得るために地域包括支援センターや居宅介護支援事業所の担当者と一緒になって訪問したり説明したりしておりますので、今後も継続してまいりたい"@ja.
<< kg:id_73 prop:effect kg:id_74 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_65;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "通所サービスではこれまでの複数の事業所を選択できたことが、見直しによりこのようなことはできなくなった 利用者のサービスの選択の柔軟性がなくなっている 制度のあるべき姿に沿ったサービスに再編された"@ja.
<< kg:id_75 prop:effect kg:id_76 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "小規模多機能施設への移管というか移行というか、これが必ずしも、今議員がおっしゃるように、そう順調には進んでいません"@ja.
<< kg:id_75 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "地域の中で受けとめていただけるように、我々としても、介護報酬の問題はありますけれども、広がるように努めていかなければいけない"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "介護予防支援では400単位となり、居宅介護支援では、基本としては1,000から1,300単位ほどになっております。このような介護報酬の違いがセンターと居宅介護支援事業者の連携に影を落としていくことにならないのか"@ja.
<< kg:id_80 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "地域包括支援センターからの委託件数ですけれども、平成18年７月末現在、100件を数えております。委託単価は介護報酬の９割とし、１件当たり月額3,600円"@ja.
<< kg:id_82 prop:effect kg:id_83 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_71;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "早くも介護難民が生ずるのではないかという話も聞こえてきます 退院後のニーズを確認しながら個別の相談に応じていきたい"@ja.
<< kg:id_82 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "私どもとしてもこういった中で県と連携を図りながら、療養病床等医療分野からの情報を収集し、退院後のニーズを確認しながら個別の相談に応じていきたい"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "より高度な地域医療の実現を図るためには県立病院との関係整理、特に前知事時代にも申し入れておりましたが、再編統合の話を整理してから改築に向かうべきというふうに考えてございました"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "県と市の協議会が今後開設されることになっているわけでありますが、地域医療のレベルアップということを第一に据え"@ja.
<< kg:id_87 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "独立行政法人化というのは、私は一つの大きな選択肢だというふうに思っております 重要な視点としては独立行政法人も十分視野に入れてございます"@ja.
<< kg:id_87 prop:effect kg:id_90 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "現場の動揺ということでございますけれども、これははっきり言いましてございます 県立病院に市立病院が吸収されるのではないかという動揺がほとんどの人たちの考えです"@ja.
<< kg:id_87 prop:effect kg:id_91 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "勤務医の過重労働が深刻な病院から、どんどん医師がやめるのは、ほとんどはそれが原因です。この問題を解決するには再編統合しかありません"@ja.
<< kg:id_87 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "早期に医療体制を固めていくというか、確立、安定させることが大事だろう 早期に結論を出して、早期に、再編統合をするのであればそれが決まってほしい"@ja.
<< kg:id_87 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "私はやはり今の優秀な医療関係の職員の雇用というのは基本的に守るべき"@ja.
<< kg:id_87 prop:cause kg:id_94 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "市立病院の改築という決断に関しては、タイムオーバーに近いのではないか"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "民間の能力、ノウハウを活用して市民サービスの向上を図るとともに行政経費の節減が図れれば"@ja.
<< kg:id_95 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "管理責任は市が負う 定期的にチェックをするというような体制でありますとか、市民の皆さんの御意見が的確にその指定管理者にフィードバックされるようなシステムをつくっておくとかということが私は大事"@ja.
<< kg:id_95 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "選定基準、結果、そして市民からこういう意見をいただきました、市役所としてはこういう評価をしていますというようなことをすべて、公表できるものは公表するというか、原則公表する"@ja.
<< kg:id_99 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "民間から提案を受けて、私たちならばこんなにもっとうまくやれますよなんていうようなことを受け付けていくということも二、三試行してもおもしろい"@ja.
<< kg:id_101 prop:effect kg:id_102 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "公民館地区や旧３町の学童保育未設置地域での潜在的なニーズを把握しております。１学区当たりゼロから17人"@ja.
<< kg:id_101 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "地域の協力が不可欠であり、地域の協力を得ながら、そして市が、行政が一定の支援をするなどしてやれないか検討をしておるところ"@ja.
<< kg:id_104 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_89;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "どんな分厚い法律があっても突拍子もない事件、事故が多発する現状の社会の中でどうしたらいいのかという最低のガイドラインをもう一度見直してつくっていくべきではないか 最近はとにかくリスクマネジメントといいますか、そうしたことなど大きいところ、細かいところも含めて安心していただけるガイドラインというのは、ないわけでありませんけれども、ひとつまとめてみたい"@ja.
<< kg:id_106 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "地区としてまとまって御意向があるといった場合には、柔軟に対応していきたい"@ja.
<< kg:id_106 prop:effect kg:id_108 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_92;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "平田地域、松山地域においても複式学級が存在している 八幡地区、松山地区、平田地区、複式学級の小学校４校ある"@ja.
<< kg:id_109 prop:cause kg:id_110 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "車社会の急激な進展によって、多くの地方都市がそうであったように、国道、バイパスにその役割が移っていく時代の中で駅前のにぎわいが衰退していかざるを得ない"@ja.
<< kg:id_109 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "医療だとか子育て支援の部分だとか交流の部分だとか住宅、それから商業と、いろいろなものを複合しながら、いろいろなものを組み合わせながら取り組んできました"@ja.
<< kg:id_112 prop:cause kg:id_113 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "建設業と米を中心とした産業構造は、基本的には官頼みであり、陳情型であり、お願い型である"@ja.
<< kg:id_112 prop:cause kg:id_114 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "国内、国外の大消費地との文化や物資の活発な交流がなくして経済的な豊かさはあり得るはずもなく"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "今後も公共工事の抑制は続くことから、他の県の倍以上もあると言われておる酒田市内の今ある100社の大半の建設業者は廃業するか、職種転換しなければなりません"@ja.
<< kg:id_117 prop:effect kg:id_118 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "このままでは働き場を求める若者のさらなる流出が続き、高齢化率を押し上げるなどの悪循環となる心配があります"@ja.
<< kg:id_119 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "リサイクル産業の集積を図ってリサイクルポート事業を進めてございます"@ja.
<< kg:id_119 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "コールセンターの誘致というようなことで情報関連産業といってもいいんだと思いますが、周辺産業といいますか、そういうものの誘致"@ja.
<< kg:id_119 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "やはりこれからはものづくりに力を入れていくこと ものづくりについての技術、そしてまた経営基盤もしっかりしているという企業をもっともっと育てていく"@ja.
<< kg:id_119 prop:countermeasure kg:id_123 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "医療・福祉の分野、医療・福祉というか、例えば医薬品とか、そういうところが発展を見込めると思いますし、それらの研究関係の機関"@ja.
<< kg:id_124 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "組織・機構の見直しなどについてはこれからも取り組んでいきたいと思います"@ja.
<< kg:id_126 prop:countermeasure kg:id_127 >>
    prop:text-txt_contents "共同生活援助施設は地域において共同生活を営むのに支障のない知的障害者、精神障害者に対して、主に夜間の日常生活上の支援、例えば食事、掃除、相談等を行う"@ja.
<< kg:id_126 prop:effect kg:id_128 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_105;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "どんな人が利用するのかが地域住民にとっては一番不安な要素であります 住民から見ますと障害者の状態がよくわからないだとか、あるいは世話人がいなくてもいいだとか、そういったことに対する不安なども考えられます"@ja.
<< kg:id_126 prop:countermeasure kg:id_129 >>
    prop:text-txt_contents "グループホームはサービス管理責任者 利用者30人に対して１人配置 世話人、利用者10人に１人が配置"@ja.
<< kg:id_126 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "市の役割としては、その施設の必要性、利用者が地域で生活することを考慮し、地域住民の意向なども意見書にまとめて県知事に提出する"@ja.
<< kg:id_126 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "やはり行政はそういう場にもかかわりながら、計画実現には当たっていかなければならない、そういう責務は負っている"@ja.
<< kg:id_126 prop:effect kg:id_132 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "どちらかといえば事業者がほとんど住民との間ではかかわりを持っていただいて、トラブルなしで現在まで来ている"@ja.
<< kg:id_133 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "このことについては福祉部門とも連携をしながら、やはり機会を通して各企業の皆さんにお願いをしている、ＰＲもしている"@ja.
<< kg:id_135 prop:effect kg:id_136 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "平成17年度末現在、これはハローワークのデータでありますが、希望者が650名 就業されている方が367名ほど、それから求職をしている方が200名ちょっと"@ja.
<< kg:id_137 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "障害を持つことを理由にしまして受験資格を狭めるというようなことは行っておりません。それは全くフリーに受験していただく"@ja.
<< kg:id_133 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_113;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "例えば８人の会社に１人、30人規模の会社に２人でも受け入れが可能かもしれない 特定求職者雇用開発助成金であるとか、トライアル雇用奨励金であるとか、さまざまな奨励金がございます。こういったことを紹介しながら、そういった企業の方々にもお願いをこれからはやっていく"@ja.
<< kg:id_140 prop:effect kg:id_141 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "酒田測候所が廃止された場合、風水害防止のための対応に大きな不安を感じております"@ja.
<< kg:id_140 prop:cause kg:id_142 >>
    prop:text-txt_contents "気象庁は、22都道府県に46ある測候所を、2006年度以降の５年間ですべて原則廃止する方針を打ち出し、酒田測候所も2010年度までに廃止の見通し"@ja.
<< kg:id_143 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "酒田測候所の存続について、特段のご高配をいただきますよう要望いたします 以上、地方自治法第99条の規定により意見書を提出いたします"@ja.
}
