kg:st_1 rdfs:label "阿部寿一市長"@ja.
kg:st_1 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "地方部の道路整備が一層おくれることを懸念し地方への配慮を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地方部の道路整備の遅れを懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "公共事業減少による地域経済への影響が出ないよう望む"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "政府原案で可決され予算確保されることを望む"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "減額の影響を相当受けているとみる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "減額はあるが橋りょう工事を順調に進めてほしい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "竣工がおくれる話は聞いておらず予定どおり開通を望む"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "県財政は逼迫しており引き続き粘り強い働きかけが必要と考える"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "議会と市民の理解のもと地道な整備が功を奏したとみる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "時代の流れをとらえた整備が好調につながったとみる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "好調な産業で地域経済を牽引していくことが大事と考える"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "観光基本計画の目標値をぜひ達成したい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "観光従事者だけでなく市民全体で支える必要がある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "農家レストランや土産品開発など農商工連携を進めるべきと考える"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "リピーター増加へ情報の効果的活用に踏み出すべきと考える"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_2 rdfs:label "小野直樹商工観光部長"@ja.
kg:st_2 rdfs:type cls:st_34.
cls:st_34 rdfs:label "部局長"@ja.
kg:op_16 prop:content "施設拡充により観光客が大きく増えたと分析する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "夢の倶楽の売り上げは大きく関係者に好影響を与えたとみる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "農業関係との連携にも好影響があると分析する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "市民活動の活発化にも非常に効果があったとみる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:st_3 rdfs:label "相蘇清太郎農林水産部長"@ja.
kg:st_3 rdfs:type cls:st_34.
kg:op_20 prop:content "市民や事業者への周知を進めている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "認知度は高まっているが周知努力の余地がある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "事業者連携を強め酒田産材が使われる事業を進める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "川下だけでなく中流上流を含め流通全体を支援する考え"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:st_4 rdfs:label "伊藤一幸建設部長"@ja.
kg:st_4 rdfs:type cls:st_34.
kg:op_24 prop:content "木造化や内装活用を進めている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "杉材はほぼ全面的に酒田産材利用となっている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:st_5 rdfs:label "後藤孝也議員"@ja.
kg:st_5 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_26 prop:content "地域事情に合った除雪体制を新年度に向け検討すべきと求める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "今後も業者と協議し改善できるものは改善する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "効率的でよりよい体制や制度の改善を進めたい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "大々的に売り込むには庄内でまとまった発信が大事と賛成する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "庄内の広域連携による観光宣伝は大事と考える"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:st_6 rdfs:label "平向與志雄企画調整部長"@ja.
kg:st_6 rdfs:type cls:st_34.
kg:op_31 prop:content "中学生までの医療費無料化など子育てしやすい環境整備を進めたい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_6.
kg:op_32 prop:content "定住のための制度構築を十分検討したい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:op_33 prop:content "住民活動の活性化が住民自治の原点と認識する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "日ごろ寄せられる市民の声を予算編成に反映している"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "今後は振興会が自分たちで考えながら予算編成していくことを支援したい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "各企業の対応状況を踏まえ見学会への取り組みを検討したい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "酒田の観光地は自転車で回れる距離で平坦なため有効とみる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:st_7 rdfs:label "タクシー会社の社長"@ja.
kg:st_7 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_38 prop:content "無料観光自転車の影響で商売上がったりだと訴える"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_7.
kg:op_39 prop:content "観光客向けではなく市民の足として運行している"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "観光物産協会のレベルアップのため専門員配置を考えている"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "広域でまとまって魅力発信することに賛成する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "地方分権を進めつつ必要な財源確保も大事と考える"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "不況により利用が減少したと考える"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "観光利用よりビジネス利用が多いため景気の影響を受けやすいとみる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "観光商品の開発や旅行会社への働きかけを強化したい"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:st_8 rdfs:label "石川翼久教育長"@ja.
kg:st_8 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_46 prop:content "経済力で教育機会に格差が生じるのは好ましくないと考える"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_8.
kg:op_47 prop:content "家庭環境に左右されず等しく教育を受ける機会が必要と考える"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_8.
kg:op_48 prop:content "困っている方がもっと利用できるようＰＲしたい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_8.
kg:op_49 prop:content "今後も申請者数は増加すると見込む"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_8.
kg:op_50 prop:content "就職氷河期など社会情勢が厳しい中で適用期間を検討したい"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_8.
kg:op_51 prop:content "現時点では確定しておらず建設や開校への影響はまだわからない"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_8.
kg:st_9 rdfs:label "斉藤喜浩建設部技監"@ja.
kg:st_9 rdfs:type cls:st_34.
kg:op_52 prop:content "新高校開校に向け生徒の安全な通学路確保を進める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_9.
kg:st_10 rdfs:label "阿部雅治総務部行政調整監兼総務課長"@ja.
kg:st_10 rdfs:type cls:st_34.
kg:op_53 prop:content "施設目的や業務内容に応じ直営か指定管理かを検討している"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_10.
kg:st_11 rdfs:label "石堂栄一総務部長"@ja.
kg:st_11 rdfs:type cls:st_34.
kg:op_54 prop:content "選定のあり方や料金の考え方は今後研究したい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_11.
kg:op_55 prop:content "年間使用料の規模を示す"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_11.
kg:st_12 rdfs:label "阿部直善健康福祉部長"@ja.
kg:st_12 rdfs:type cls:st_34.
kg:op_56 prop:content "対象者把握はしやすいが確実な支給体制が必要とみる"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_12.
kg:op_57 prop:content "定額給付金や子育て応援特別手当の経験を踏まえ庁内協力体制を整える"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_12.
kg:op_58 prop:content "国の定期接種化を求めつつ市としても検討課題と考える"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "国の定期接種化を求めつつ市としても検討課題と考える"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "個別受診勧奨とあわせて効果があったとみる"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_12.
kg:op_61 prop:content "今後も多面的に検診受診を促したい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_12.
kg:op_62 prop:content "在宅介護の困難さを認識している"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_12.
kg:op_63 prop:content "地域の力を借りながら在宅介護を支えている"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_12.
kg:op_64 prop:content "利用者評価も高く状況に合ったサービスが提供されている"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_12.
kg:op_65 prop:content "在宅で住み続けられるよう需要増加を見込み整備を進める"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_12.
kg:op_66 prop:content "学区社会福祉協議会による見守り活動を進めている"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_12.
kg:op_67 prop:content "網の目から漏れる人の掘り起こしも含めて見守りを強化する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_12.
kg:op_68 prop:content "地域の中で温かく見守る応援者を増やしたい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_12.
kg:op_69 prop:content "地域に不足する医療機能整備への支援を県に要望した"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_12.
kg:op_70 prop:content "来年度立ち上がる看護専門学校への支援を要望した"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_12.
kg:st_13 rdfs:label "加藤裕教育部長兼学区改編推進室長"@ja.
kg:st_13 rdfs:type cls:st_34.
kg:op_71 prop:content "どの事業が削減対象か不透明だがリニューアル部分への影響を見込む"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_13.
kg:st_14 rdfs:label "丸山至健康福祉部地域医療調整監兼健康課長"@ja.
kg:st_14 rdfs:type cls:st_34.
kg:op_72 prop:content "リアルタイム情報提供のためホームページ掲載を行う"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_14.
kg:op_73 prop:content "必要量は確保でき県に発注した"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_14.
kg:op_74 prop:content "高校への聞き取りで一定数いることを把握した"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_13.
kg:op_75 prop:content "一定の就学支援につながると考える"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_13.
kg:op_76 prop:content "現状より少しでも増員できるよう努めたい"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_8.
kg:op_77 prop:content "早急に設計や工事に着手したい"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_8.
kg:op_78 prop:content "安全性に最善の注意を払いチェックしている"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_8.
kg:op_79 prop:content "地産地消と食育の観点から地元産活用を工夫したい"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_8.
kg:op_80 prop:content "雇用確保に一定の成果があったと理解する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "事業主への助成や制度周知で雇用確保に努めている"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "1人でも多くの高校卒業生が酒田に残れるよう努力している"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "新政権の方針を受けて、公共事業費全体で対前年度比約14％の減額というふうになっていると承知しております。このまま公共事業が削減をされますと、特に地方部において整備がおくれている高速道路でありますとか、地域高規格道路、この道路整備が一層おくれるというふうになります"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "このまま公共事業が削減をされますと、特に地方部において整備がおくれている高速道路でありますとか、地域高規格道路、この道路整備が一層おくれるというふうになります"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "公共事業というのは経済の刺激効果もあるわけでございますので、道路整備のおくれとあわせて、公共事業の減少によって地域経済への影響が出てこなければいいなというふうに考えているところでございます"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "日沿道の酒田みなとから遊佐間、今年度は補正予算で１億円が配分されたというような状況でありましたが、来年度については、調査、設計を中心に２億円から４億円程度の予算を概算要求には盛り込んでいるということでございまして、このまま政府原案としてぜひ御可決をいただいて、これらの予算確保がなされればありがたい"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "新庄酒田道路であります。これは、やはり先ほど冒頭申し上げました対前年度比14％減額というような影響を相当受けている部分だと思います"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "今年度当初の65億円に対して、26億円から31億円程度に減額をされているわけであります"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "主要地方道の酒田松山線の飛鳥バイパスについては着実に事業を進めていただいておりまして、竣工がおくれるという話は私たちは聞いていないところでありますので、ぜひ予定どおり開通をさせていただきたい"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "３年目の調査を終え、これから具体的な設計にかかっていただくよう、これはもう県のほうに一生懸命お願いをしているという段階だということで御理解をいただきたいと思います。県も必要性は理解をしていただいていると思いますけれども、財政的にも、やはり県財政も逼迫していると思われますので、引き続き粘り強い働きかけが必要"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "議会、市民の皆さんの理解をいただきながら、着実に観光拠点の整備などを進めてきたり、こういう地道な取り組みが功を奏してこのような状況になっている"@ja.
<< kg:id_15 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "時代の流れ、例えば「おくりびと」のアカデミー賞受賞をとらえて、旧割烹小幡の所有者に働きかけをし、必要な整備をさせていただいたとか、こういう地道な取り組みが功を奏してこのような状況になっている"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "私は、所信の中でも申し上げさせていただきましたけれども、この好調な産業で地域経済を牽引していくということが大事"@ja.
<< kg:id_18 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "平成20年３月に策定をいたしました酒田市の観光基本計画においても、平成20年度における観光入れ込み客数約300万人、これを25年度には350万、29年度には400万というような形でふやしていくという目標数値を掲げておりますので、これはぜひ達成していきたい"@ja.
<< kg:id_18 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "市民の皆さんのおもてなしの心とかをもっともっと醸成していくとか"@ja.
<< kg:id_18 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "農家レストランなんていうようなこと１例挙げさせていただきましたけれども、農商工の連携というようなことも取り組んでいかなければならない"@ja.
<< kg:id_18 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "顧客情報をいかに活用するか、顧客情報といいますか、どういう方々、どういうニーズがあってここに来られるかというようなことなども含めて、集まった情報をいかに効果的に活用するかというような部分に一歩踏み出していかなければならない"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "その結果としまして、大分観光客もふえまして、平成12年ごろは大体140万ほどの入り込み数だったんでございますが、平成15、16年でぐっとふえまして、平成15年で156万人、平成16年では319万人まで観光客、入り込み数がふえてきて"@ja.
<< kg:id_24 prop:effect kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "夢の倶楽では、協力会等、頑張っておるわけでございますが、物産関係で大変関係者が元気になってございます。売り上げも４億円近くの売り上げがございます"@ja.
<< kg:id_24 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "農産物の加工と土産物の開発部門、これにつきましても、農業関係とも連携がとれて、いい影響を与えているのではないか"@ja.
<< kg:id_24 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "ロケーションボックスとか映画関係で、そういうロケーションボックス等の民間の市民活動、これらも大変盛んになったというようなことで、非常に効果があった"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "県と市の各種支援制度をまとめて紹介をさせていただいているパンフレットを作成いたしまして、多くの市民の方々に行き渡るようにＰＲに努めている"@ja.
<< kg:id_29 prop:effect kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "認知度が高まってきていると認識はしておりますけれども、まだまだ周知の努力の余地あり"@ja.
<< kg:id_29 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "家づくりネットワーク、木づかい夢ネットの事業者の皆様と連携強化を図りながら、酒田産材が使われるような事業の連携を進めている"@ja.
<< kg:id_33 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "木材の伐採から加工、流通までに至るさまざまな事業に対する助成をしているところでございます。これはまた、来年度以降も続けていくという考え方でいるところでございます。このように、川下のユーザーの皆様方への支援並びにそれにさかのぼった中流、上流に当たる流通の全体に対して支援をする"@ja.
<< kg:id_35 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "酒田産材の利用につきましては、工事発注の際に、仕様書に酒田産材の使用を明記してございます"@ja.
<< kg:id_35 prop:effect kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "その結果でございますけれども、杉材に関しましては、おおむね100％酒田産材の利用という状況でございます"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "特に旧３町においては、除雪費を含む全体のあり方が変わり、要員の確保も難しくなったとのことであります"@ja.
<< kg:id_38 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "昨年ですけれども、除雪の稼働費用の見直しを行ってございます。少しでも待機料等について、実情に近づく努力をしているところでございます"@ja.
<< kg:id_38 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "今後も効率的でよりよい体制や制度の改善に向けまして、業者の皆様と協議を行いながら御意見を伺い、内容等改善できるものは改善する方向で検討してまいりたい"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "酒田とかそういう一つの市、町の名前ではなくて、庄内をブランドとして売り込むことが適当なのではないかというお話がございました。私も賛成でございます"@ja.
<< kg:id_44 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "庄内の観光コンベンション協会というものを、庄内の市町村や関係経済団体でありますとか、それから、山形県の協力もいただきながら組織をしているわけでありまして、毎年毎年、この団体に対しては市も負担金を出し、そして、市も役員としてここに入って、いろいろな観光宣伝、戦略というか、広域的な観光戦略を練り、そして観光ＰＲもやっている"@ja.
<< kg:id_46 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "子育て支援策の充実につきましては、やはり若者世代の定住を図るための大変重要な施策であるというふうに認識してございます。今年度は中学生までの医療費の無料化ということもございました。引き続き、子供を産み育てやすい環境整備に取り組んでいきたい"@ja.
<< kg:id_46 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "現在、空き家対策という部分については特にとっていないわけですけれども、照会はやはり結構ございます。議員の御指摘のような制度の、やはり構築を含めまして、十分検討してまいりたい"@ja.
<< kg:id_49 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "現在、その住民自治の原点である住民活動の活性化ということで、最も身近な単位である自治会やコミュニティ振興会の活動に対する活性化に対して、十分な支援をもって頑張ってまいりたい"@ja.
<< kg:id_51 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "本市としましては、移動市役所の開催、それからふれあいの手紙、各種相談、そんなことを通じまして、日ごろから寄せられている市民の声を各担当部署から吸い上げていただきまして、予算要求という形でこの編成作業に反映させている"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "今年度からこの振興会に対する支援につきましては、補助金という形で各地区の特色や課題に的確に対応できるように、すべての地区でまず同じ内容である均等割の支援と、それから、各振興会におけるそういった独自の事業に対する支援ということで区分をして、それは自分たちでいろいろ考えていただいてというふうなことで制度をスタートしたところでございます。現在、コミュニティ振興会の皆さんとあり方検討会ということを持ちまして、定期的にどのような支援の方向があるべきか"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "本市としましても、各企業の対応状況を踏まえながら、リサイクル関連施設への市民向けの見学会などへの取り組みについては検討してまいりたい"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "観光用自転車、２次交通システムの一つとして大変観光客からも喜ばれておるところでございます。酒田市の観光地がちょうど自転車で回れる距離にあると申しましょうか、酒田市は平らな都市でございますので、自転車が大変有効である"@ja.
<< kg:id_57 prop:cause kg:id_59 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "９月の５連休、シルバーウイークの際にあるタクシー会社の社長さんからお聞きをいたしました。全く商売上がったりですという話でした。皆さん無料の観光自転車に飛びつくものですから、タクシーを使っての観光が全く成り立たない"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "るんるんバスは交通手段を持たない高齢者等の交通手段の確保と交通空白域の解消、これが主な目的でございます"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "観光物産協会もやはりもう少しレベルアップをしたいと、こういうこともございまして、今、言われた観光の専門員的なもの、そういうものを協会のほうで配置をしたらどうかというようなことを少し考えておる"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "１市町村でやるよりも、やはり地域がまとまっていろいろな魅力を発信していく、予算を効率的に使っていく、いろいろなチャンネルを利用するということは大変大事"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "地方自治というか自立をするということの一番大きな眼目は、やはり国からの不必要な関与といいますか、そういうものは、不要不急の関与は限りなく省く"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "やはり昨年９月のリーマンショック以降の世界的な景気の落ち込み、不況により利用が減少したというふうに考えております"@ja.
<< kg:id_68 prop:cause kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "庄内空港の利用者は圧倒的にビジネス客が多いのでありまして、９割がビジネス利用であります。したがって、経済低迷の影響を直接的に受けた"@ja.
<< kg:id_71 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "よりビジネス客、ビジネス利用がしやすいような運航体系というようなものをお願いしていくということももちろん大事であります。加えて、やはり観光利用もふやしていくというような取り組みも必要なんではないか"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "家庭の収入が低い学生ほど４年制大学への進学予定率が低い、一方、就職する割合が高いという結果が出てきております"@ja.
<< kg:id_73 prop:effect kg:id_75 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "経済力の高い家庭の子供が高学歴、また高い学力を獲得するという、そういう格差が生じることは決して好ましい状況とは言えない"@ja.
<< kg:id_76 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "酒田市では、進学の機会を確保できるようにと大学等修学資金利子補給事業を実施しております"@ja.
<< kg:id_76 prop:effect kg:id_78 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "平成18年は42名ですが、年を追って19年には53名、20年には76名、21年には82名と利用者が、そしてまた、当然、交付額もふえております"@ja.
<< kg:id_76 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "就職氷河期と言われるように社会情勢が厳しい中、その適用期間については今後検討していきたい"@ja.
<< kg:id_80 prop:effect kg:id_81 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "もし、そうなれば耐震化以外の事業については支障があるのかなという懸念を持っております。しかしながら、まだこのことが現時点では確定しているものでありませんので、新高校の建設、開校年度への影響もまだわかりません"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "県道の吹浦酒田線につきましては、中央高校から旧酒田営林署の交差点までの区間につきまして、北側の歩道の拡幅をするという計画にしてございます。平成22年度から工事に着手する"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "施設の管理運営に関して民間のノウハウといいますか、民間の技術、あるいは知識を活用しまして、市民サービスの向上と業務の効率化、あるいは経費の節減を図る"@ja.
<< kg:id_86 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "通常の用途に、目的に沿って活用し、そして、その目的を妨げない範囲で空きスペースがあれば、利用者のサービス向上という意味で自販機の設置の許可をしている"@ja.
<< kg:id_86 prop:effect kg:id_88 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "平成20年度の決算でありますが、約140万円でございます"@ja.
<< kg:id_89 prop:effect kg:id_90 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "子ども手当につきましては、これまでの児童手当と違って、中学生までということで想定されておりますので、そういうことも含めまして、対象人員は多くなるという課題はあるというふうに認識をしております。したがいまして、その分事務量もふえる"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "広報を初め対象世帯への直接の連絡、あるいは幼稚園、保育園、小学校、中学校等を通じましての通知、そういったことで確実な支給体制を整えてまいりたい"@ja.
<< kg:id_92 prop:effect kg:id_93 >>
    prop:text-txt_contents "このワクチンはそのうちの23種類の型に対して免疫をつけることができます。これで肺炎球菌による感染症の８割を予防することができるとの報告もございます"@ja.
<< kg:id_92 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "公費助成についてもどうするかということについて、引き続き国への働きかけは行っていきますけれども、市としても別途検討すべき課題だというふうに思っている"@ja.
<< kg:id_95 prop:effect kg:id_96 >>
    prop:text-txt_contents "接種率が60％以上になると、ヒブ感染症が激減することが世界で認められ、アメリカでは100分の１に減少しています"@ja.
<< kg:id_95 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "ヒブワクチンや肺炎球菌ワクチンの有効性については、議員御指摘のとおりだというふうに思っております。効果は大きいものがあるというふうに思います。したがいまして、公費助成についてもどうするかということについて、市としても別途検討すべき課題"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "無料クーポン券の配布というものが検診率を高めた大きな要因になったのではないかなと。また、さらには個別の受診勧奨ということも効果があった"@ja.
<< kg:id_99 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "今後につきましても節目年齢検診、あるいはその職域への働きかけ、それから個別あるいは地域での受診勧奨、それから検診に対する理解を深めてもらうための広報活動、そういったものをあわせて今後も取り組んでまいりたい"@ja.
<< kg:id_101 prop:effect kg:id_102 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "やはりそれぞれ老老介護という言葉もございますし、また特にひとり暮らしの方というような場合は、例えば経済的なことも含めていろいろ問題も抱えているということについては、私たちとしても認識をしているところでございます。やはり、中には議員からもございましたように、虐待という問題も一部発生している状況"@ja.
<< kg:id_101 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "在宅介護につきましては地域包括支援センターを中心にいたしまして、民生委員さんなり、あるいは地域の自治会長さんなり、そういった地域の方々のお力もおかりしながら、情報なんかもいただきながら必要な支援を行ってきている"@ja.
<< kg:id_104 prop:effect kg:id_105 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "現在の設置状況は９つの事業所で合計定員が225人でございます。実際の利用者につきましては、210人ということで、かなり利用も順調に推移している"@ja.
<< kg:id_104 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "第４期の今の介護保険事業計画におきましても、最終年度であります平成23年度までは合わせて15カ所の設置を見込んでいる"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "社会福祉協議会の学区社会福祉協議会によります新・草の根見守りネットワーク支援事業ということを展開しておりますが、そういった形で見守り活動を中心的に行っていただいております"@ja.
<< kg:id_107 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "サポートの網の目から漏れている人の掘り起こしも含めた見守りを強化するという観点から、安心生活創造事業"@ja.
<< kg:id_110 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "現在、認知症サポーター養成講座というものを、いろいろ企業さんも含めて出前講座での要請があったところ等についてお願いをしているところでございます。現在、680人ほど養成をしております"@ja.
<< kg:id_112 prop:effect kg:id_113 >>
    prop:text-txt_contents "このたび無駄な予算を削るということで、全事業一律25億円に削減することになりました"@ja.
<< kg:id_112 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "地域に不足しております療養病床、それから回復期リハビリテーション機能を整備するということで酒田医療センターの計画があるわけでございますが、そちらに対する支援"@ja.
<< kg:id_112 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "来年度立ち上がろうとしております市立酒田看護専門学校に対する支援、こういったことについて要望した"@ja.
<< kg:id_116 prop:effect kg:id_117 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "例えば耐震補強工事と同時に行っておりますリニューアル部分、具体的に申し上げると給排水設備、それからトイレの改修、それから増改築工事、あるいはグラウンドの整備工事等々、こういったものへの影響が考えられるのではないか"@ja.
<< kg:id_118 prop:effect kg:id_119 >>
    prop:text-txt_contents "小学生は42.6％の罹患率でございます。それから、中学生でございますが、36.0％の罹患率となっております。高等学校につきましては、16.6％の罹患率"@ja.
<< kg:id_118 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "市のホームページ、これは日々刻々と変わる情報を掲示することができますので、酒田市では10月23日以降、休業状況を毎日お知らせをしております"@ja.
<< kg:id_121 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "４年生、５年生、６年生、3,164名おりますけれども、そのうち620名の方から接種希望があったということで、この皆さんには医師会との連携をとりながら、年内には１回目の接種を終えるようにということで、今、準備を進めております。この場合のワクチンの必要量でございますが、すべて確保できるというふうな見通しが立ちましたので、本日、県のほうに発注をした"@ja.
<< kg:id_123 prop:effect kg:id_124 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "昨年度卒業された生徒さんでは８名、それから今年度、これから来春卒業予定の生徒さんにつきましては６名程度"@ja.
<< kg:id_125 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "来年度から経済的に厳しい家庭の大学進学のための給付型奨学金として活用していこうというふうに考えている"@ja.
<< kg:id_127 prop:effect kg:id_128 >>
    prop:text-txt_contents "その結果、小学校では4.07％、中学校では1.65％"@ja.
<< kg:id_127 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "今年度、学習支援員は現在小中学校で43名を配置しております"@ja.
<< kg:id_130 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "教育委員会としては平成27年度を目標に完了したい"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "調味料や加工品については、食材発注前に担当栄養士がその添加物の有無や生産地についても精査しながら、配合内容を確認して発注している"@ja.
<< kg:id_132 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "特に中国産の食材についてということで話がありましたが、可能な限り使用しないように努めています"@ja.
<< kg:id_135 prop:effect kg:id_136 >>
    prop:text-txt_contents "11月末までに緊急雇用の創出事業、これで177名"@ja.
<< kg:id_137 prop:effect kg:id_138 >>
    prop:text-txt_contents "ふるさと雇用再生特別基金事業で21名"@ja.
<< kg:id_139 prop:effect kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "平成21年４月における雇用保険受給者数が1,626人でございます。そのときの有効求人倍率は0.3倍です。これが10月末で受給者数は1,083名、有効求人倍率は0.4倍となってございます"@ja.
<< kg:id_141 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "失業者を１年間継続雇用した場合に、事業主に対して助成をする雇用創出特別助成制度というのがございます。また、雇用後の12週間分の雇用経費に対しまして、これを事業主に対して助成する離職者就業支援制度、これも実施をしておる"@ja.
<< kg:id_143 prop:effect kg:id_144 >>
    prop:text-txt_contents "平成22年３月卒業予定の高校生の就職内定率でございますが、これは本年10月末の状況でございます。就職内定率、これは70％でございます"@ja.
<< kg:id_143 prop:effect kg:id_145 >>
    prop:text-txt_contents "県内に就職を希望する生徒は217名、その内定率は60.4％"@ja.
<< kg:id_146 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "酒田地区の各高校、それからハローワーク、商工会議所等とともに対策について会議を重ねてございます。その会議の中で、この協議会の中から市内の企業に対する求人のお願いをしたり、求人の掘り起こしのための会社訪問など、１人でも多くの高校卒業生から酒田に残っていただけるよう努力をしておる"@ja.
}
