cls:c_5184 rdfs:label "改築計画"@ja.
kg:id_93 prop:contermeasure kg:id_97.
kg:st_1 rdfs:label "酒田市長阿部寿一"@ja.
kg:st_1 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_1 prop:content "既存投資を生かすため施設の有効活用を進めるべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市原栄子議員"@ja.
kg:st_2 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_2 prop:content "利活用不足を理由に山を崩すべきではない"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "駐車場不足を解消して使いやすくすべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "面積不足の改善も含め機能強化が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "施設を変貌させれば八幡地域全体の活性化につながる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "周辺施設も含め相乗効果が期待できる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "パークゴルフやグラウンドゴルフの整備で集客が期待できる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "採掘はギフチョウの生息環境を損なうおそれがある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "身近な里山として残すほうが時代に合う"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "機能強化施設の整備で公園活用を高めたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "傾斜地をパークゴルフ場として活用する案を持っている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "大々的ではなく必要最小限で進めるべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:st_3 rdfs:label "伊藤一幸建設部長"@ja.
kg:st_3 rdfs:type cls:st_47.
cls:st_47 rdfs:label "行政職"@ja.
kg:op_13 prop:content "地域の意見を聞きつつ実施を目指す"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "山を崩さず里山としての保全を進めるべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "八森の魅力を市民と全国に発信すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "買い物弱者対策は早急に必要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "商店街衰退による買い物困難への対応が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_4 rdfs:label "阿部直善健康福祉部長"@ja.
kg:st_4 rdfs:type cls:st_47.
kg:op_18 prop:content "高齢化の進行で日常的に買い物に困る人が増えると見込む"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "不況進行も買い物困難の増加要因になる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "高齢者や障がい者も含め支援が必要"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "高齢者のみならず障がいのある方のことも考える必要がある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "まず市民の買い物事情を調査する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "地域福祉計画で対応策を位置づけたい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "事業者や市民活動と連携した対策を検討する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "原油高騰で市民生活が苦しいため早い判断が必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "低所得者への灯油補助は恒久的に取り組むべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "現状では市民生活への影響はそれほど大きくないとみる"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "今年度も福祉灯油を実施する早い決断を求める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "現状では交付を検討していない"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "急激な価格上昇時には機動的に対応する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "入浴料助成で健康増進や外出機会の増加が期待できる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "高齢者に月1回程度の息抜きの機会をつくるべき"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "高齢者向けの温泉補助券を実施してほしい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "財源負担が大きく直ちに公的補助が必要とは考えない"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "各学校でのバリアフリー化がますます重要になっている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:st_5 rdfs:label "兵藤芳勝教育部長"@ja.
kg:st_5 rdfs:type cls:st_47.
kg:op_36 prop:content "新改築校では法令や条例に基づき設計に盛り込んでいる"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "既存校も児童生徒の状況や改修工事時に整備している"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:st_6 rdfs:label "武田恵子議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_38 prop:content "登校時刻は保護者負担に配慮して柔軟にすべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_6.
kg:op_39 prop:content "寄宿舎の弾力運用などで送迎困難を軽減すべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_6.
kg:op_40 prop:content "自校調理や職員配置の工夫を県に求めるべき"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "寄宿舎利用や話し合いの要請を県教委に伝える"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:st_7 rdfs:label "阿部寿一市長"@ja.
kg:st_7 rdfs:type cls:st_29.
kg:op_42 prop:content "放置できず改築か耐震補強を検討すべき"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_7.
kg:op_43 prop:content "老朽化と機能劣化を踏まえ庁舎のあり方を検討すべき"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_7.
kg:op_44 prop:content "災害本部となる庁舎の早急な対応が必要"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "有識者と市民代表による検討委員会で方向性を定めたい"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_7.
kg:st_8 rdfs:label "佐藤丈晴議員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_46 prop:content "開校とあわせて雇用機会拡大の取り組みが必要"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_8.
kg:op_47 prop:content "卒業後の就労等の社会参加を地域として支援する必要がある"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_7.
kg:op_48 prop:content "関係機関と連携し具体的支援を検討実践する場をつくる"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_7.
kg:op_49 prop:content "市立小中学校の校務員職で雇い入れる仕組みづくりに着手すべき"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_8.
kg:op_50 prop:content "これまでも校務員を含め日々雇用職員として雇用してきた"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_5.
kg:op_51 prop:content "新エネルギー導入は今後も進むべき課題"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "新エネルギーと既存火力とのバランスを考えるべき"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_8.
kg:op_53 prop:content "現段階では補完的エネルギーだが導入促進を優先すべき"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "実証実験も含め先進事例を勉強したい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "酒田港をリサイクルとエネルギーのモデル港として国にアピールしたい"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "現行体制のままでは限界があり運営のあり方見直しが必要"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_8.
kg:op_57 prop:content "市民主体の運営組織をつくり行政が支える関係にすべき"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_8.
kg:st_9 rdfs:label "加藤裕市民部長"@ja.
kg:st_9 rdfs:type cls:st_47.
kg:op_58 prop:content "NPO組織や財団法人化等のあり方を検討課題とする"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_9.
kg:st_10 rdfs:label "高橋正和議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_59 prop:content "地域の実情に沿った計画で結果を出すべき"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_10.
kg:op_60 prop:content "地域要望を十分踏まえた計画策定が必要"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_10.
kg:op_61 prop:content "農林業の低迷を踏まえた地域振興が必要"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_10.
kg:op_62 prop:content "ソフトだけでなく必要なハード事業も盛り込む"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_7.
kg:op_63 prop:content "地域の納得のいくよう意見を聞きながら特性を踏まえたビジョンを策定したい"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_7.
kg:op_64 prop:content "雇用の受け皿づくりが十分向上につながっていない"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_10.
kg:op_65 prop:content "建設業減少を補う新たな雇用の場が必要"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_10.
kg:op_66 prop:content "幅広い産業の低迷で雇用環境が厳しい"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_10.
kg:op_67 prop:content "森林保全を雇用創出につなげる仕組みが必要"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_10.
kg:op_68 prop:content "中山間地域の所得保証と雇用創出を図るべき"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_10.
kg:op_69 prop:content "市有林整備で一定の雇用を生みつつ木材供給体制も強化したい"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_7.
kg:op_70 prop:content "地場産材の活用促進と安定供給体制づくりが必要"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_7.
kg:op_71 prop:content "快適で安全な道路整備が必要"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_10.
kg:op_72 prop:content "関係市町村と連携し早期改良整備を引き続き要望する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_3.
kg:op_73 prop:content "できるものから整備してもらうよう協議する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_3.
kg:st_11 rdfs:label "梶原宗明議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_74 prop:content "危機管理と防疫体制を強化すべき"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_11.
kg:op_75 prop:content "埋却地選定や人員確保を事前に進めるべき"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_11.
kg:op_76 prop:content "正しい情報発信で風評被害を防ぐべき"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_11.
kg:op_77 prop:content "安全性をPRし消費が落ちることのないよう取り組むべき"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_7.
kg:st_12 rdfs:label "前田茂実農林水産部長"@ja.
kg:st_12 rdfs:type cls:st_47.
kg:op_78 prop:content "庁内体制を強化しマニュアルを作成した"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_12.
kg:op_79 prop:content "机上訓練でマニュアルを補強し実践的なものにする"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_12.
kg:op_80 prop:content "オール庄内で同一成分を使った一斉防除の意識を高めたい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_12.
kg:op_81 prop:content "口蹄疫対応資機材の導入に機動的な支援を行いたい"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_7.
kg:op_82 prop:content "新造船就航を機に利用拡大策を積極的に打つべき"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_11.
kg:st_13 rdfs:label "小野直樹商工観光部長"@ja.
kg:st_13 rdfs:type cls:st_47.
kg:op_83 prop:content "ニューとびしまさよならクルーズとお披露目クルーズを計11回実施する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_13.
kg:op_84 prop:content "船内貸切イベントなど新しい企画を試験的に行いたい"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_13.
kg:op_85 prop:content "市内外に新船と飛島観光を積極的にPRする"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_13.
kg:op_86 prop:content "将来を見据えた整備計画が必要"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_11.
kg:op_87 prop:content "機能的に時代に合わなくなっており見直し時期に来ている"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_7.
kg:op_88 prop:content "仕切りなどで目に触れない工夫をすべき"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_11.
kg:op_89 prop:content "備品配置などで工夫できるなら対応したい"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_7.
kg:op_90 prop:content "大柄な人に対応できる設備が必要"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_11.
kg:op_91 prop:content "大型炉の問題も含め見直しが必要な時期"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_7.
kg:op_92 prop:content "総合計画に基づき老朽度を見極め改築計画を検討したい"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_7.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "町民の税金を投入しつくったサッカー場の利用状況はどうなのか。...全体としての利活用が本当にあの状況の中で十分なのか。...だからもっともっと使われてほしいのでありまして、有効利用していかなければなりません。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "サッカー場についても、駐車場の不足でありますとか、それから面積が十分確保できていないなどというようなお話もあるので、使いにくいんだというんであれば、それも使われるようにしなければならないのであります。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "サッカー場についても、駐車場の不足でありますとか、それから面積が十分確保できていないなどというようなお話もあるので、使いにくいんだというんであれば、それも使われるようにしなければならないのであります。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "八幡地域全体の活性を考えたときに、人を呼べる施設としてここを大きく変貌させることが可能なんです。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "その変貌させることによって、「たわわ」であったり「ゆりんこ」であったり鳥海山荘であったり、そういうものが生きてくるとより生きてくる、玉簾もそうでありますが、より生きてくると私は考えているわけであります。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "高齢者の健康増進の施設として、例えばパークゴルフなりグラウンドゴルフなりの一つのメッカにしていったらどうだ、そうすれば県の内外から人が呼べるではないか"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "チョウの生活エリアが土砂の採掘地域にある、このことのあらわれではないでしょうか。"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "より身近な里山として残すことで、ギフチョウが舞う姿をお年寄りも子供たちも楽しみ、観察できる公園にしていくことが時代にあった整備ではないか"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "今までも、多目的広場などを含めて、八森公園の機能強化をするような施設などを整備していきたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "近時いろんな方が取り組むようになっているパークゴルフのゴルフ場として整備したらどうかということで、多くの人を呼び、また施設の有効活用をしようと思っております"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "だから大々的にやるというんじゃなくて、必要最小限のことをやっていこうということであります。"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "今後も地域の皆様の御意見も伺いながら、実施できるよう努力してまいりたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "身近な里山としての今の姿を保全すること、このことが公園の整備ではないかと考えます。"@ja.
<< kg:id_1 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "このすばらしい里山の魅力を市民に、そして全国に発信していく必要があるのではないでしょうか。"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "スーパーの閉店や商店街の衰退などで高齢者らが日々の買い物に困る買い物難民の問題"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "スーパーの閉店や商店街の衰退などで高齢者らが日々の買い物に困る買い物難民の問題"@ja.
<< kg:id_16 prop:cause kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "これから高齢化がさらに進み、...中山間地はもとより、市街地においても、やはり日常的に買い物に困る方が出てくるということも見込まなければならない"@ja.
<< kg:id_16 prop:cause kg:id_20 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "これから高齢化がさらに進み、あるいは不況も同時に進行するという状況でございますので"@ja.
<< kg:id_16 prop:effect kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "高齢者らが日々の買い物に困る買い物難民の問題"@ja.
<< kg:id_16 prop:effect kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "高齢者のみならず、保護者が亡くなられた障がいのある方のことも考えていかなければなりません。"@ja.
<< kg:id_16 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "市全域でアンケート調査を行う予定でございますので、その中で市民の皆さんの買い物事情についても調査し、状況把握に努めていきたい"@ja.
<< kg:id_16 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "第２期地域福祉計画の中で新たな課題として対応について位置づけてまいりたい"@ja.
<< kg:id_16 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "事業者や市民活動と協力したような、例えば本市にあった買い物弱者対策について、関係部署と連携し検討してまいりたい"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "原油の高騰によりガソリンや灯油が高騰した"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "まだまだ市民の暮らしは大変な状況であると言っても過言ありません。"@ja.
<< kg:id_26 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "私は、市民の生活を守るためにも、福祉灯油の今年度の実行という早い決断をしていただきたいと考えます。"@ja.
<< kg:id_26 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "もし急激にまた価格が上昇するようであれば、市としても機動的な対応をしていくことができるように、十分価格の推移等を注視してまいりたい"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "高齢者の健康増進、生活の質の向上、レクリエーション機会の創設"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "外出する機会の増加や気分転換、相互の親交を深めるという目的での入浴料の助成"@ja.
<< kg:id_31 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "本市でも取り組むことによって、高齢者に月１回程度の息抜き、ありがとうという補助券を発行する、こういったことを実施できないか"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "特別支援学級も拠点校型から各地域の学校がその役割を担うという方向に変わり、ますます学校現場でのノーマライゼーションの構築に向けたバリアフリー化が重要になっています。"@ja.
<< kg:id_35 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "エレベーター、多目的トイレの整備、校舎内外のバリアフリーなど、設計に盛り込んで整備しております。"@ja.
<< kg:id_35 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "既存の学校の段差解消ですとか、身障者用トイレのスペースの改善についても...児童・生徒の状況ですとか、改修工事が入る際に整備を行っている"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "ひとり親で出勤前に子供を学校に送り届けなければならない方もいるそうです。"@ja.
<< kg:id_39 prop:effect kg:id_41 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "送迎の困難さを考えると鶴岡養護学校に在学するしかないのかという、あきらめの気持ちを抱いて発言なさった方もいらっしゃいました。"@ja.
<< kg:id_39 prop:effect kg:id_42 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "外部でつくられた食事を一人一人にあわせて担任の教諭が刻んでから食べさせる状況が続いています。"@ja.
<< kg:id_39 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "今、御指摘のありました要望につきましては、市としても受けとめさせていただいて、県教委のほうに伝えさせていただく予定にしております。"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "倒壊または崩壊する危険性が高い建物になってございます。"@ja.
<< kg:id_44 prop:cause kg:id_46 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "昭和39年建築で建築後45年を経過しております。"@ja.
<< kg:id_44 prop:effect kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "災害本部になる建物が崩壊してしまっては、市民の安全を守ることができるはずがない"@ja.
<< kg:id_44 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "建築関係の有識者でありますとか、市民代表からなる検討委員会のようなものを立ち上げ、...改築なのか補強なのか、改築するとすればどこなのかというようなことなどについて、慎重に検討していただきたい"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_46;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "新たに設立される特別支援学校について、卒業後の就労等の社会参加を地域としても支援していく必要がある"@ja.
<< kg:id_49 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "今年度、関係各機関によって、地域自立支援協議会を立ち上げたいと思っております。特別支援学校、ハローワーク、商工会議所、「かでる」、福祉サービス事業所、県などと連携し、具体的な支援、どのようなことができるかを検討し、また実践していく場"@ja.
<< kg:id_49 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_49;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "校務員に限らず、その他の分野においても日々雇用職員として障がいのある方を雇用してきております。"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "ＣＯ２の削減ということが、これは、地球規模での大きな課題になっている以上、新エネルギーの導入というのは、どんどんこれからも進んでいくべき課題"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_52;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "この太陽光についても風力についてもそうでありますが、やはりエネルギー供給の不安定性ということを抱えていることは間違いない"@ja.
<< kg:id_53 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "まずこの実証実験なども含めて、しっかりと勉強、先進事例を勉強してみたい"@ja.
<< kg:id_53 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "私は、エネルギー、環境のモデル港というような感じで酒田港を位置づけていただいて、そこに国のほうでもいろんな事業を導入してもらうというようなことなども、アピールすべきいい材料をこの地域は持っている"@ja.
<< kg:id_58 prop:cause kg:id_59 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "人気のない事業に関してはチケットがなかなか売れないというお話もお聞きします。"@ja.
<< kg:id_58 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_57;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "市民の皆さんが自主的に運営する組織をつくっていただきながら、そこに行政がサポートしていくというような関係性をつくって"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "３地域は若年層を中心とする人口の流出、急速な高齢化進行、基幹産業である農林業の低迷、地域や産業を支えるマンパワーの低下など、過疎地域として多くの課題を抱えている"@ja.
<< kg:id_61 prop:effect kg:id_63 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "３地域は若年層を中心とする人口の流出、急速な高齢化進行"@ja.
<< kg:id_61 prop:effect kg:id_64 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "基幹産業である農林業の低迷、地域や産業を支えるマンパワーの低下"@ja.
<< kg:id_61 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "ハード事業についても、必要なものは当然、地域の皆さんの声を十分聞きながら計画に盛り込んでいく考え"@ja.
<< kg:id_61 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "地域のビジョン、そこにお住まいの皆さんの納得のいくような計画でなければならないと思っておりますので、しっかり意見をお聞きしながら、その地域の特性を踏まえたビジョンを策定してまいりたい"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "一方で、非製造業での減少も大きい"@ja.
<< kg:id_67 prop:cause kg:id_69 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "建設業は前年同月比23.2％減"@ja.
<< kg:id_67 prop:cause kg:id_70 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "宿泊・飲食業は12カ月連続ダウン"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "森の番人として森林を守ってきた林業労働者の高齢化も進み"@ja.
<< kg:id_71 prop:cause kg:id_73 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "それにかわる担い手も存在しない状況にある"@ja.
<< kg:id_71 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "市有林について、森林整備加速化・林業再生事業によって、その環境整備を図るための雇用をさせていただいておりまして、ここで一定の雇用が出ている"@ja.
<< kg:id_71 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "川上から川下まで一貫した体制をつくりながら、木材供給、山の木が動くような対応もしていくことが、本来の意味での森林に携わる人材の拡充にもつながる"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "その県道も危険の予測される路線の一つではないかと思います。また、ダムの上流部分でも１カ所危険なところがあります。"@ja.
<< kg:id_76 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "毎年秋に県・国、関係機関に要望活動を行っているところでございます。一日も早く整備していただきたいというふうな形で要望しておる"@ja.
<< kg:id_76 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "現地を確認した上で、県のほうとも打ち合わせしながら、できるものからしていただくように協議してまいりたい"@ja.
<< kg:id_80 prop:effect kg:id_81 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "牛、豚、ヤギ、羊など、偶蹄類約25万頭が殺処分、または殺処分を待っている状況"@ja.
<< kg:id_80 prop:effect kg:id_82 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "埋却地の確保や人員の確保がおくれ、処分が追いつかず、結果的に感染を増幅させてしまった"@ja.
<< kg:id_80 prop:effect kg:id_83 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_76;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "今回の口蹄疫問題でさらに消費が減少することがないよう、正しい正確な情報伝達、広報活動も重要"@ja.
<< kg:id_80 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "山形県のマニュアルと連動する酒田市口蹄疫対応マニュアルを作成したところでございます。"@ja.
<< kg:id_80 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "机上訓練を重ねながらマニュアルを補強し、よりよい実践的なものにしていく"@ja.
<< kg:id_80 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "毎週月曜日を一斉薬剤点検デーということで一斉に防除しましょう、そしてふだんの防疫意識を高めましょう"@ja.
<< kg:id_80 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "畜舎の環境整備を図るという畜産環境整備事業というような事業がございます。この事業の中で、この口蹄疫対応の資機材の導入についても機動的な支援が行えるよう"@ja.
<< kg:id_88 prop:effect kg:id_89 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "定期航路事業は、島民以外の皆さんの利用が年々少しずつ減少している"@ja.
<< kg:id_88 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "ニューとびしまさよならクルーズということで、６月26日から３回計画しております。...新しい定期船につきましては、お披露目クルーズというようなことで、７月21日から８回計画しております。計11回ことしは実施しよう"@ja.
<< kg:id_88 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "船内を貸切をしてイベントを行っていただいてクルーズを行おうと、こういうことも試験的にやっていきたい"@ja.
<< kg:id_88 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "７月１日号広報に飛島観光の魅力、それからよさ、そういうものと定期船の変遷について、６ページにわたって宣伝したい。...ミヤギテレビに職員が出演しまして、新しい定期船と花火大会、花火ショーのＰＲを行う予定"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_86;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "酒田斎場は建設後35年が経過し、老朽化が進んでいるとも伺っております。"@ja.
<< kg:id_93 prop:effect kg:id_95 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_88;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "入出棺と拾骨の場面で少し寂しい思いをするというか、何となく落ち着いてお別れができないというような場面がある"@ja.
<< kg:id_93 prop:effect kg:id_96 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_90;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "体の大きい人の入る炉が少ないとか、そんな話もありました。"@ja.
<< kg:id_93 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "総合計画においても改築の検討ということを盛り込んでおりますので、老朽度をしっかり見きわめながら、改築に向けた具体的な計画の検討にも着手していきたい"@ja.
}
