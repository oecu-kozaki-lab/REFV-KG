kg:st_1 rdfs:label "斎藤周議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "異常豪雨を踏まえ早急な災害対策が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "危険箇所は梅雨入り前に点検すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "危険箇所は梅雨入り前に点検すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "豪雨被害の教訓から人命を守る対策が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "豪雨被害の教訓から人命を守る対策が必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "浸水対策の立ちおくれを改善すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "土砂災害対策の立ちおくれを改善すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "被災者対策の立ちおくれを改善すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "毎年梅雨入り前に点検すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_2 rdfs:label "阿部寿一市長"@ja.
kg:st_2 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_10 prop:content "点検は適切な時期に実施すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "補強や補修は梅雨入り前に行うべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "危険な状況が確認できれば適切な対応を行うべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "説明会だけでなく一軒一軒知らせるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_3 rdfs:label "阿部雅治総務部行政調整監兼総務課長"@ja.
kg:st_3 rdfs:type cls:st_47.
cls:st_47 rdfs:label "行政職"@ja.
kg:op_14 prop:content "一軒一軒周知の意見も踏まえ進めたい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "早目の避難を呼びかける周知が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "避難の方法について理解を深めている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "河川点検結果を住民へ周知すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "注意を要する情報を住民に周知すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "過去の災害履歴を踏まえた周知が必要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "過去の被害を教訓に備えるべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "市街地も含め実態に合わせたマップをつくるべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "一目で分かるよう改善したい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "だれが見てもわかりやすい町丁目ごとのマップが必要"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "町ごとの表示など工夫したい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "危険区域は一軒一軒訪問して早目の避難を呼びかけるべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "使えるテレビの大量廃棄は環境問題を招く"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "完全移行が近づくほど不法投棄がふえるおそれがある"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:st_4 rdfs:label "加藤裕市民部長"@ja.
kg:st_4 rdfs:type cls:st_47.
kg:op_28 prop:content "不法投棄がふえないよう監視と啓発を強化したい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "国として大量廃棄への対策がないのは問題"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "新たな販路開拓やリサイクル技術が課題"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "市民の中にテレビ難民になる世帯が予想される"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:st_5 rdfs:label "石堂栄一総務部長"@ja.
kg:st_5 rdfs:type cls:st_47.
kg:op_32 prop:content "テレビを見られなくなる人が出ることを懸念している"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:st_6 rdfs:label "高齢者"@ja.
kg:st_6 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_33 prop:content "お金がなくてとても地デジは買えない"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:st_7 rdfs:label "商店主"@ja.
kg:st_7 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_34 prop:content "商売も厳しく地デジどころではない"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_7.
kg:st_8 rdfs:label "生活保護世帯の方"@ja.
kg:st_8 rdfs:type cls:st_5.
kg:op_35 prop:content "テレビが壊れたらとても買えない"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_8.
kg:op_36 prop:content "民間アパートやマンションの難視聴解消状況を把握すべき"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "市で直接調査したものはない"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "完全移行は二、三年延期すべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "国の動向を注視したい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "酒田市でも早急に健康調査を実施すべき"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "現時点で本市には苦情や健康被害情報はない"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:op_42 prop:content "苦情が来た地域と同じ環境にあり調査が必要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "国が詳細調査を進めている"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:st_9 rdfs:label "風車問題伊豆ネットワーク"@ja.
kg:st_9 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_44 prop:content "風車による低周波騒音健康被害が特徴的に大量発生している"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_9.
kg:op_45 prop:content "居住地との距離が近く早急に健康調査を実施すべき"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "現時点で直ちに健康調査は必要と考えていない"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:st_10 rdfs:label "石黒覚議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_47 prop:content "教育委員会が市民を二分したことは重大"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_10.
kg:op_48 prop:content "民主主義を疑わざるを得ない結論が混迷を招いた"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_10.
kg:st_11 rdfs:label "兵藤芳勝教育部長"@ja.
kg:st_11 rdfs:type cls:st_47.
kg:op_49 prop:content "手続面で方針のおくれがあったことを謝罪した"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_11.
kg:op_50 prop:content "地域への配慮不足で不信感や心配を与えた"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_11.
kg:op_51 prop:content "校名決定方針を当初から示せるよう準備したい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_11.
kg:op_52 prop:content "自然減は少子化の影響が大きい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "若い人の地元定着が難しいことが大きな課題"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "若い人たちの地元企業への雇用が難しいことが大きな課題"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "考えられることを着実にやっていくしかない"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "合併後の厳しい財政に備え一層改革を進める必要がある"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "総合的に包括した計画が必要との認識で策定を検討している"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:st_12 rdfs:label "荒生令悦議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_58 prop:content "退職者数に左右されない安定対策が必要"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_12.
kg:st_13 rdfs:label "齋藤勉健康福祉部地域医療調整監兼健康課長"@ja.
kg:st_13 rdfs:type cls:st_47.
kg:op_59 prop:content "退職給与引当金の計上を検討したい"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_13.
kg:op_60 prop:content "平成20年度から受験年齢を34歳まで広げた"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_5.
kg:op_61 prop:content "全国的には軽くなるとの指摘があった"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "更新時に本人が選択できる経過措置を設けていた"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "電話や窓口や訪問で丁寧に説明しているが不十分なら反省する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "戸別所得補償が入ったことで米価が急激に下がり米余りが進んだ"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:st_14 rdfs:label "後藤孝也議員"@ja.
kg:st_14 rdfs:type cls:st_16.
kg:op_65 prop:content "制度発表が米価の下げ要因として作用した"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_14.
kg:op_66 prop:content "農業を継続する人さえいなくなる懸念がある"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "主力産業の米の低迷は地域経済に大きな影響を与える"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "将来的な米生産と農業生産の基盤を揺るがす大きな脅威"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "ならし対策などをしっかり見直すよう政府に要請すべき"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "米だけに頼り過ぎない農業をさらに押し進める必要がある"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "集落営農なども含めさらに低コスト化に踏み込む必要がある"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "観光客の満足度を正しく把握し土台づくりに生かすべき"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_14.
kg:st_15 rdfs:label "小野直樹商工観光部長"@ja.
kg:st_15 rdfs:type cls:st_47.
kg:op_73 prop:content "今後も民間と連携しデータ集約と分析を進めたい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_15.
kg:op_74 prop:content "エージェント訪問は大切で商品化につながっている"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_15.
kg:op_75 prop:content "通過型観光改善のため官民一体で取り組みたい"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_15.
kg:op_76 prop:content "満足度の低いところを上げる努力が必要"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_15.
kg:op_77 prop:content "観光客ニーズを把握し対応していく"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_15.
kg:op_78 prop:content "満足度の低い項目の改善に努めたい"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_15.
kg:st_16 rdfs:label "丸山至財務部長"@ja.
kg:st_16 rdfs:type cls:st_47.
kg:op_79 prop:content "利用可能なものは他の公共施設として活用できないか検討したい"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_16.
kg:op_80 prop:content "利用計画が立たないものは売却して歳入活用したい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_16.
kg:op_81 prop:content "高齢化も踏まえ雨水対策を急ぐべき"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_14.
kg:op_82 prop:content "整備が進んだ結果の新たな課題に対応すべき"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_14.
kg:st_17 rdfs:label "伊藤一幸建設部長"@ja.
kg:st_17 rdfs:type cls:st_47.
kg:op_83 prop:content "安全確保のため必要な対応を水路管理者と協議したい"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_17.
kg:op_84 prop:content "過疎債を有効活用するため早く策定したい"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "旧３町の地域のありようを考える契機としてつくりたい"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "旧３町や東平田の共通課題を一体的に取り組みたい"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:op_87 prop:content "過疎債が使えない地域は合併特例債などで対応を考えたい"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_2.
kg:op_88 prop:content "おみこし追い越し調整でスムーズな進行を図った"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_15.
kg:st_18 rdfs:label "参加者"@ja.
kg:st_18 rdfs:type cls:st_74.
cls:st_74 rdfs:label "参加者"@ja.
kg:op_89 prop:content "配置や間隔の見直しを求める"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_18.
kg:op_90 prop:content "コースのあり方を早期に検討したい"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_15.
kg:op_91 prop:content "中町モールで七夕飾りを実施しにぎわいづくりに効果があった"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_15.
kg:op_92 prop:content "婚活にも使えるので活用してほしい"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_15.
kg:st_19 rdfs:label "梶原宗明議員"@ja.
kg:st_19 rdfs:type cls:st_16.
kg:op_93 prop:content "職業の多様化や人間関係の希薄化で出会いの機会が少なくなっている"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_19.
kg:op_94 prop:content "若者のコミュニケーションの苦手さも影響している"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_19.
kg:op_95 prop:content "結婚支援推進員による出会いのきっかけづくりを進めている"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_4.
kg:op_96 prop:content "今年６月に協議会を立ち上げ７月に婚活パーティーを開催した"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_4.
kg:op_97 prop:content "港町酒田ならではの婚活として期待できる"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_19.
kg:op_98 prop:content "特色を持った婚活事業として検討したい"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_4.
kg:op_99 prop:content "皆さんから喜ばれる制度になるよう検討したい"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_4.
kg:op_100 prop:content "市内の緑化にもつながるので検討したい"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_4.
kg:st_20 rdfs:label "石川翼久教育長"@ja.
kg:st_20 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_101 prop:content "慎重かつ丁寧に地域と相談し理解を得たい"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_20.
kg:op_102 prop:content "地域運営学校のあり方として教育委員会で研究を重ねたい"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_20.
kg:op_103 prop:content "年内完成予定で進んでいる"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_20.
kg:op_104 prop:content "９月に完成し開校まで中央高校が使用予定"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_20.
kg:op_105 prop:content "県議会議決後に契約し平成24年2月完成予定"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_20.
kg:op_106 prop:content "県が今年度と来年度の２カ年で拡幅する"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_17.
kg:op_107 prop:content "県に強く要望していきたい"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_20.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "ことしの梅雨は、停滞する梅雨前線に南からの湿った風が次々吹き込んだ影響で、九州や中国地方など各地で記録的な豪雨となり、異常とまで言われました"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "酒田市地域防災計画、土砂災害は地震だけではなく降水、融雪などによって発生する極めて危険な災害と位置づけ"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "酒田市地域防災計画、土砂災害は地震だけではなく降水、融雪などによって発生する極めて危険な災害と位置づけ"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "豪雨に襲われた九州や西日本などでは、土石流や斜面崩壊等が繰り返し発生しました"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "豪雨に襲われた九州や西日本などでは、土石流や斜面崩壊等が繰り返し発生しました"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "そして局地的な浸水、土砂災害対策、被災者対策の立ちおくれが改めて浮き彫りになりました"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "そして局地的な浸水、土砂災害対策、被災者対策の立ちおくれが改めて浮き彫りになりました"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "そして局地的な浸水、土砂災害対策、被災者対策の立ちおくれが改めて浮き彫りになりました"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "毎年梅雨入り前に点検し、その結果を住民に知らせ、場合によっては補強や補修が必要なところは梅雨入り前に行うべきと思います"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "場合によっては補強や補修が必要なところは梅雨入り前に行うべきと思います"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "新たに対象になった地域住民一軒一軒に知らせて、住民からもきちんと認識をしていただくことが求められている"@ja.
<< kg:id_1 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "いざとなった場合に早期に避難していただけ、結果として人命を守るということになる"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "例えば荒瀬川と日向川は増水による流路が変化し、堤防が破壊される危険が高い"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "中野俣川は溢水の恐れがあり注意を要する"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "最上川は昭和19年に左岸の堤防が決壊し、川南地区の一部が大洪水に見舞われ"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "住宅７棟が流出するという災害が起きております"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "私はホームページで市街地も含めて実態に合わせたマップをつくるべきと思います"@ja.
<< kg:id_22 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "市街地については、場合によっては町丁目ごとにだれが見てもわかりやすいようなマップが必要"@ja.
<< kg:id_22 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "例えばこうした浸水深１ｍ以上の地域については、コミ振や自治会の協力を得ながら、やはり一軒一軒訪問して危険区域になることをお知らせして、いざとなったら早目の避難を呼びかけることの周知が求められている"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "もったいないの言葉が見直される時代に、アナログ低波で数千万台の使えるテレビがごみと化します"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "私は地デジの完全移行が近づくごとに、さらに不法投棄がふえるのではないかという危惧をするものであります"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "さらなる販路の開拓などリサイクル先の確保が必要、また環境への影響、鉛の溶出を適切に把握する必要がある"@ja.
<< kg:id_26 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "現行計画ではテレビを見られない家庭や事業所が数百万規模で発生するというというもので"@ja.
<< kg:id_26 prop:effect kg:id_32 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_34;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "高齢者からは、お金がなくてとても地デジは買えない、困ったものだという声、あるいは商店主からは、最近商売も厳しくて地デジどころではない、ぎりぎりまで待つつもりという声、生活保護世帯の方にはチューナーが支給されるようですが、今見ているテレビが壊れたらテレビを自前で買わなければならず、テレビが壊れたらとても買えないという声もあります"@ja.
<< kg:id_26 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "ただ問題は民間のアパートやマンションでの難視聴がどこまで解消されているかであります"@ja.
<< kg:id_26 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "地デジ移行に関して、先日、有識者４氏がデジタル完全移行を二、三年延期するよう提言を発表しました"@ja.
<< kg:id_26 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "先日、総務省が地デジ簡易チューナーの無償の対象を、これまでの生活保護世帯に加え市町村民税非課税世帯も対象にするとしました"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "環境省は風力発電施設に関して低周波音の苦情が寄せられていることから"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "環境省は風力発電施設に関して低周波音の苦情が寄せられていることから"@ja.
<< kg:id_36 prop:effect kg:id_39 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "こうした被害の大量発生が、風車による20ヘルツ以下の低周波音を含む低周波騒音健康被害の特徴である"@ja.
<< kg:id_36 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "こうしたことから早急に風力発電施設から発生する騒音、低周波音による健康調査を実施すべきと思います"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "次の世代の子供たちを育てる中枢である教育委員会が市民を二分してしまう事態を招いたことは周知の事実でございます"@ja.
<< kg:id_41 prop:effect kg:id_43 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "結果として民主主義を疑わざるを得ない結論から、混迷を招く事態となりました"@ja.
<< kg:id_41 prop:cause kg:id_44 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "教育委員会の方針のおくれ、地域の皆様への配慮が欠けたところがあった"@ja.
<< kg:id_41 prop:cause kg:id_45 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "地域の皆様への配慮が欠けたところがあったということで、結果として不信感や御心配をおかけした"@ja.
<< kg:id_41 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "校名の決定に関する方針を、やはり教育委員会でもう一度議論をする必要があるのかなと思っております"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "自然減については少子化の影響であります"@ja.
<< kg:id_47 prop:cause kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "社会減については、これは一つは進学、それから生産年齢人口の若い人たちの転出が多くなっていることは、これは事実であります"@ja.
<< kg:id_47 prop:cause kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "景気の低迷から若い人たちの地元定着、地元企業への雇用が難しい状況にあるというようなことが一番大きな課題"@ja.
<< kg:id_47 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "若い人たちの定着できるような地域づくりのために考えられることをしっかり着実にやっていくしかない"@ja.
<< kg:id_52 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "やはり一層行財政改革を進めていかなければならない"@ja.
<< kg:id_54 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "医療のみならず福祉や介護との連携、こういうことも欠かせないというふうに思っておりますので、市としてはこれを総合的に包括した計画が必要との認識で、その策定の検討を始めているところでございます"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "退職者が多い場合は赤字になってしまうという不安定な経営になっております"@ja.
<< kg:id_56 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "監査委員の意見書にもありましたが、退職給与引当金の計上なども検討していきたい"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "年齢をこれまで30歳までといったような制限を設けておりましたけれども、平成20年度からは34歳までといったような幅を設けて採用試験を実施しております"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "昨年の４月でありますが、介護認定に係る調査項目が変更になりました。このときに全国的に介護度が軽度になるのではないかというような指摘が、全国でですけれどもあった"@ja.
<< kg:id_61 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "これまでのこの更新のときに、これまでの介護度を継続するのか新しい介護度にするのかということ、本人が選択できる経過措置が、４月から９月までの申請分については設けられておりました"@ja.
<< kg:id_61 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "介護度に疑問があるという申し出があった場合には電話や窓口、それからまた自宅へ訪問するなどとして、介護度が変わった理由を丁寧に説明をしているところであります"@ja.
<< kg:id_65 prop:cause kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "私が考える限りは、戸別所得補償が入ったから当然米価が急激に下がり、そしてまた米余りが急速に進んだ"@ja.
<< kg:id_65 prop:effect kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "少なくとも農業を継続する人さえもいなくなるんじゃないかという懸念を持っております"@ja.
<< kg:id_65 prop:effect kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "地域経済に与える影響だけではなくて、農業者がいなくなるんじゃないかということさえも懸念されるという大変深刻な私は状況にある"@ja.
<< kg:id_69 prop:effect kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "この事業のおくれどころか機能の低下、施設の老朽化などは将来的な米生産、農業生産の基盤を揺るがす大きな脅威だと思っています"@ja.
<< kg:id_65 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "このあたりをしっかりしていただかないと、政府に要請していかないと"@ja.
<< kg:id_65 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "米だけに頼り過ぎない、米プラスアルファということをさらに押し進める"@ja.
<< kg:id_65 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "集落営農なども含めて低コスト化ということにさらに踏み込まなければいけない"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_72;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "観光客の満足度、それから意識を正しくとらえるということは、観光行政として大切なことでございます"@ja.
<< kg:id_74 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "観光物産協会、それから市職員と一緒にエージェント訪問も行ってございます。そして観光客の誘導を行っておるところです"@ja.
<< kg:id_74 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "酒田市は通過型観光と先ほど課題が出たわけでございますが、この改善のために滞在・体験型観光施策を図る必要がございまして"@ja.
<< kg:id_74 prop:effect kg:id_78 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "逆に満足度の低い項目としますと、温泉がないということです"@ja.
<< kg:id_74 prop:effect kg:id_79 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "それからお土産が２番に来ております"@ja.
<< kg:id_74 prop:effect kg:id_80 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "また３番が交通手段、それから道路の状況"@ja.
<< kg:id_81 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "利用可能なもの、例えば八幡地域の旧大蕨保育園用地ですとか旧大沢コミュニティセンター、それから松山地域の旧セミナーハウス用地、こういったものについては他の公共施設として活用ができないのかどうか、そういったことで検討を進めてまいりたい"@ja.
<< kg:id_81 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "どうしても利用計画が立たないというふうなものにつきましては、やはり売却をして歳入として活用をしてまいりたい"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "それが一気にあふれ、一時的に一部地域の床下を流れるという事態が発生しております"@ja.
<< kg:id_84 prop:cause kg:id_86 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "傾斜地に住宅地があり流速が早くなったためであります"@ja.
<< kg:id_84 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "どのような対応が必要か、またあふれている原因という部分で通水を阻害する施設も現状見られます。そのようなことを水路管理者のほうと協議を進めてまいりたい"@ja.
<< kg:id_88 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "なるべく早くこの策定をし、そしてその計画に基づいて過疎債などを活用して事業をどんどん進めていきたい"@ja.
<< kg:id_88 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "旧３町の皆さんに自分たちの地域のありようについて、もう一回考えていただく契機にもしたいということで、この地域ビジョンも新市の建設計画を受けるような形でつくっていきたい"@ja.
<< kg:id_88 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "共通課題を浮かび上がらせて、一体的に取り組むような事業も浮かび上がってくればですけれども、やってみたい"@ja.
<< kg:id_88 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "過疎債が使えないわけですけれども、事業によりますけれども合併特例債なども活用して、共通の事業を推進するというようなことは考えていきたい"@ja.
<< kg:id_93 prop:effect kg:id_94 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "以前、山車行列の進行が滞るという意見が寄せてございました"@ja.
<< kg:id_95 prop:effect kg:id_96 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_89;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "甚句流しでは、参加者の意見としては時折やはり足踏み状態が続いたので、配置や間隔の見直しを求める声がございます"@ja.
<< kg:id_97 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "今年度からなんですけれども、中町のモールにおきまして甚句流しの前日からお盆の時期まで、市内の幼稚園、それから保育園によります七夕飾りを実施いたしました"@ja.
<< kg:id_97 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "８月21日にサンセットクルーズということで、船は我々が運転しますけれども、中でのイベントを民間の方にお願いをして試験的にやってみたわけです。大分好評でございました"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:stateBy kg:st_19;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "現在では、職業の多様化、地域内でも人間関係の希薄化などで出会いの機会が少なくなっている"@ja.
<< kg:id_100 prop:cause kg:id_102 >>
    prop:stateBy kg:st_19;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "自己表現やコミュニケーションをとることの苦手な若者がふえていることも事実"@ja.
<< kg:id_100 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "平成21年度から結婚支援推進員による男女の出会いのきっかけづくりをサポートするという目的で始めたもの"@ja.
<< kg:id_100 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "ことし６月でございますけれども、結婚支援推進員協議会という組織を立ち上げさせていただいたところです。これ以降、７月には縁結びのサポートとして婚活のパーティーも50人規模で開催"@ja.
<< kg:id_100 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_19;
    prop:relatedOpinion kg:op_97;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "定期船とびしまを活用した婚活パーティークルーズ"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "例えば市長の祝福メッセージなども添えたような記念品というものが考えられないのか"@ja.
<< kg:id_106 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "これは市内の緑化ということにもつながるわけですから、この点でも気持ちよく住んでいただけるというふうな趣旨にもかなうことでございますので、ぜひ検討させていただきたい"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "学校の統合というのは地域から学校がなくなるということもありますので、この統合の意義についても十分御理解いただく、そのためにも慎重かつ丁寧に地域の皆さんと相談をするべき"@ja.
<< kg:id_109 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "教育委員会でもこれから研究を重ねていきたい"@ja.
<< kg:id_112 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "ことし３月からグラウンドの造成が始まっております"@ja.
<< kg:id_112 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "弓道場の建設が行われ、これは９月に完成"@ja.
<< kg:id_112 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "校舎の新築工事は落札業者が決まりました。これから始まる９月県議会の議決後に契約をして"@ja.
<< kg:id_112 prop:contermeasure kg:id_116 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "県のほうからことしと来年度の２カ年で拡幅をしていただく"@ja.
<< kg:id_117 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "校地内の必要な照明については、県管轄ということではあってもこれから県に強く要望してまいりたい"@ja.
}
