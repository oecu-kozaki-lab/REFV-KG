kg:id_151 prop:cause kg:id_154.
kg:st_1 rdfs:label "斎藤周議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "若者定着には働ける職場確保が切実に必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "企業誘致とあわせて地元企業支援で雇用を増やすべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地場産業支援策として妥当だと評価する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "具体的な地場産業支援策として必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "具体的な雇用維持策として必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "巨額投資に対し効果が小さいと懸念"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "庄内でも空港利用減少を懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "飛行機から新幹線への乗り換えで空港利用減少の恐れがある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "現実的な対応ではないかと考える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "実現のため努力してほしい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "無料化の方向に進むなら実現してほしい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "反発するのは当然だと考える"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "建設ありきで進めるべきでない"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "クリアすべき問題が多い"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "多様な立場の人が納得する範囲で進めるべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "この議論の場が欠けていると指摘する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "公の責任まで安易に放棄することが広がると懸念"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "この立場に立つべきだと主張する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "公の責任を前提に民間活用すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "法定外繰り入れを行ってでも引き上げるべきではなかった"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "低所得者に高負担を課していると指摘する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "高負担が貧困を生むのではないかと問題提起する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:st_2 rdfs:label "国民健康保険税を滞納した経験がある方"@ja.
kg:st_2 rdfs:type cls:st_75.
cls:st_75 rdfs:label "当事者"@ja.
kg:op_23 prop:content "分納して納付できることを知らず悩み続けた"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "分納を知っていれば悩まずに済んだ"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "初期段階で事情把握すべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "窓口に来れば教えるのでなく行政側から知らせるべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "学校関連負担が家計を圧迫している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "自治体として貧困解消対策の一環で実施すべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "新3項目も対象にすべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "新3項目も対象にすべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "新3項目も対象にすべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:st_3 rdfs:label "本間正巳市長"@ja.
kg:st_3 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_32 prop:content "助成制度で雇用増加の環境を整える"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "助成制度で雇用増加の環境を整える"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "助成制度で雇用増加の環境を整える"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "助成制度で雇用増加の環境を整える"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "国の制度活用で早期就職と雇用機会創出を図る"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "県の事業活用で基礎研修と就労研修を行う"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "今後は雇用増をテーマに聞き取りして施策反映したい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "ビジネスチャンス拡大で雇用増につなげる"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "受注量拡大を通じ雇用増につなげたい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "庄内延伸は地域活性化につながる重要課題"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "今後も整備促進に取り組む"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "乗りかえ解消には時間換算できない効果がある"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "段階的に助成を拡大してきた"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "財政状況を見て段階的に進める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "現在の計画に至った背景の一つ"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "現在の計画に至った背景の一つ"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "現在の計画に至った背景の一つ"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "現在の計画に至った背景の一つ"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "調査を丁寧に行い判断する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "広報やホームページで知らせ市民意見を得る"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "懸念事項を含めて調査する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "行政責任を持った上で民間活用を進める"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "実情や費用対効果を検証しながら進める"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:st_4 rdfs:label "久松勝郎健康福祉部長"@ja.
kg:st_4 rdfs:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_55 prop:content "保険税負担が重い背景にある"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_4.
kg:op_56 prop:content "負担が大きくなる構造がある"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:op_57 prop:content "低所得者への軽減措置を講じている"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_4.
kg:op_58 prop:content "一定程度軽減している"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_4.
kg:op_59 prop:content "一定程度軽減している"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_4.
kg:op_60 prop:content "一定程度軽減している"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_4.
kg:op_61 prop:content "急な収入減や災害時に対応する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_4.
kg:op_62 prop:content "パンフや通知書や広報やホームページで知らせている"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:st_5 rdfs:label "兵藤芳勝教育部長"@ja.
kg:st_5 rdfs:type cls:st_18.
kg:op_63 prop:content "準要保護の割合は増加傾向にある"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_5.
kg:op_64 prop:content "県内主要市と比較して最も高い割合で支援している"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_5.
kg:op_65 prop:content "現状基準を維持したい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_5.
kg:op_66 prop:content "県内では一部実施のため当面は動向を見る"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_5.
kg:st_6 rdfs:label "後藤泉議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_67 prop:content "行政とのパートナーシップが壊れると危惧する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_6.
kg:op_68 prop:content "威圧感圧迫感があり歴史的景観を残すべき"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_6.
kg:op_69 prop:content "具体計画がない地域では説明会は行っていない"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_3.
kg:op_70 prop:content "タイムスケジュール的に別提言を検討する余地はなかった"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_3.
kg:op_71 prop:content "根本的な改革と支援が必要"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_6.
kg:op_72 prop:content "事故が起きても不思議でない状況と懸念する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_6.
kg:op_73 prop:content "市の積極支援と誘客企画との連携が必要"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_6.
kg:st_7 rdfs:label "大石薫商工観光部長"@ja.
kg:st_7 rdfs:type cls:st_18.
kg:op_74 prop:content "定番化されるよう支援を検討したい"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_7.
kg:op_75 prop:content "地元協力を得ながら誘客に努める"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_7.
kg:op_76 prop:content "県と話し合いを行う"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_7.
kg:op_77 prop:content "魅力が高く誘客は可能と考える"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_7.
kg:op_78 prop:content "正社員比率は低く非正規社員割合が高い"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_3.
kg:op_79 prop:content "地域雇用拡大に大変期待できる"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_3.
kg:op_80 prop:content "働きやすい環境づくりとして充実させている"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_3.
kg:op_81 prop:content "働きやすい環境づくりとして充実させている"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_3.
kg:op_82 prop:content "働きやすい環境づくりとして充実させている"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_3.
kg:op_83 prop:content "働きやすい環境づくりとして充実させている"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_3.
kg:op_84 prop:content "企業訪問の際に活用を促している"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_3.
kg:op_85 prop:content "ハローワークや庄内総合支庁と連携し相談体制を充実させる"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_7.
kg:op_86 prop:content "県内でも特徴的な取り組み"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_4.
kg:op_87 prop:content "県内でも特徴的な取り組み"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_4.
kg:op_88 prop:content "残念であり今後PRや意識啓発を図る"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_4.
kg:op_89 prop:content "さまざまな機会をとらえて進める"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_4.
kg:op_90 prop:content "他市の取り組み状況を勉強したい"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_4.
kg:st_8 rdfs:label "丸山至総務部長"@ja.
kg:st_8 rdfs:type cls:st_18.
kg:op_91 prop:content "震災の教訓を踏まえた対応が必要"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_8.
kg:op_92 prop:content "避難所運営で必要な配慮として考えている"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_8.
kg:op_93 prop:content "仕切りのある授乳スペース確保が必要"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_8.
kg:op_94 prop:content "育児対応できる仕組みを考える"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_8.
kg:op_95 prop:content "流通備蓄に加え必要物資を検討する"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_8.
kg:op_96 prop:content "流通備蓄に加え必要物資を検討する"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_8.
kg:op_97 prop:content "備蓄や対応策を今後検討する"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_8.
kg:op_98 prop:content "新しい防災ガイドブックに反映する"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_8.
kg:op_99 prop:content "意見をいただく機会を設けたい"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_8.
kg:op_100 prop:content "地域防災に子育て世代の参画を広げたい"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_8.
kg:op_101 prop:content "参画できない人の意見も防災減災に生かしたい"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_8.
kg:st_9 rdfs:label "関井美喜男議員"@ja.
kg:st_9 rdfs:type cls:st_16.
kg:op_102 prop:content "議員定数の適正化を推進するため定数を減じる"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_9.
kg:st_10 rdfs:label "市原栄子議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_103 prop:content "削減理由が不明で拙速な提案だと反対する"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_10.
kg:op_104 prop:content "市民の意見反映が弱まるため反対する"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_10.
kg:op_105 prop:content "市民意見に反して削減するべきでない"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_10.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "市民の中では、若者が酒田に定着するために若者が働ける職場を確保することが切実に求められております"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "企業誘致を示しつつ地元企業への支援をすることで雇用をふやしてもらう取り組みを市民が求めている"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "雇用を守るには既存企業が１人でも２人でも多く雇えるような環境をつくる"@ja.
<< kg:id_5 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "業界から話を聞いたり"@ja.
<< kg:id_5 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "仕事を紹介する相談会を開いたりして雇用を守ることが必要"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "何百億円も投資しても、現在でも大体20分ぐらい早く東京に着く程度"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "山形市は共存できない距離であり、新幹線が開通した途端に空港は極端に便が減りました"@ja.
<< kg:id_9 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "新幹線が来れば飛行機から新幹線に乗りかえる方が相当いると言われており、空港の利用が減るという指摘もあります"@ja.
<< kg:id_14 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "今進められている新幹線と在来線同一ホーム乗りかえ、平成30年から平成31年度ごろに完成するのではと言われておりますが、これが現実的な対応ではないかと思います"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "子供の医療費の無料化について、中学生まで外来診療費の自己負担の無料化を掲げ"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "小中学生の医療費助成について、段階的に通院も無料化することを検討するとしており"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "以前同じ場所に民間企業が計画して了解が得られなかったのが、震災後、エネルギーに対する見方が変わったにせよ、同じ場所に建てることが決まったことに反発するのは当然のことだと思います"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "風力発電については景観や環境問題"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "低周波や騒音問題などクリアしなければならない問題が多くあります"@ja.
<< kg:id_21 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "さまざまな立場の人が納得した範囲で計画が進むようオープンに話し合うこと"@ja.
<< kg:id_21 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "市民の多様な声をすくい上げていく議論の場を設けることが必要"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "最初から行革の基本が民間でできることは民間でとなると、公の責任を持たなければならないことまで安易に放棄することが広がるのではと思う"@ja.
<< kg:id_28 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "公が責任を持たなければならない部分は公で最大限責任を持ちます"@ja.
<< kg:id_28 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "民間の方々に御協力をお願いしなければならないことがあれば民間の方々にお願いします"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "国民健康保険に加入している世帯は低所得者が多く、それだけに多くの公費を投入しないと制度そのものが維持できない"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "国民健康保険の加入者は低所得者が多く、収入も低いにもかかわらず"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "私は国民健康保険が結果的に貧困の原因となっているのではないかと思う"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "滞納していることから市役所に行くには敷居が高くて行けなかった"@ja.
<< kg:id_37 prop:cause kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "この方は国民健康保険税を分納して納付できることを知らなかったそうで、分納して納付できるのなら悩まずに済んだ"@ja.
<< kg:id_40 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "まず滞納が発生した段階で、うっかり払い忘れなのか、新たな経済的な事情が発生したのか親身にお聞きし"@ja.
<< kg:id_40 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "窓口に相談に来れば教えるのではなく、市役所の側からお知らせして、一番いい方法を一緒に考える"@ja.
<< kg:id_43 prop:effect kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "これらの負担はボディーブローのようにじわじわ家計に響いてくる"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "この対象世帯をもう少し広げることはできないのかと思います"@ja.
<< kg:id_45 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "クラブ活動費、生徒会費、ＰＴＡ会費のいわゆる新３項目も対象にするべき"@ja.
<< kg:id_45 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "クラブ活動費、生徒会費、ＰＴＡ会費のいわゆる新３項目も対象にするべき"@ja.
<< kg:id_45 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "クラブ活動費、生徒会費、ＰＴＡ会費のいわゆる新３項目も対象にするべき"@ja.
<< kg:id_50 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "魅力ある個店誘致を支援する補助金"@ja.
<< kg:id_50 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "用地取得への助成金"@ja.
<< kg:id_50 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "工場等設置への助成金"@ja.
<< kg:id_50 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "賃借型立地企業定着促進への助成金などの助成制度を設けて、雇用を増加させるというふうな環境を整えております"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "一定期間試し雇用することによって求職者及び求人者の相互の理解を深めて、そして早期就職の実現とか雇用機会の創出を図るトライアル雇用に取り組んでおります"@ja.
<< kg:id_57 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "県のほうでも人材派遣会社において６カ月雇用して、ビジネスマナー等の基礎研修と県内事業所における就労研修をする安定雇用促進事業に取り組んでいただいております"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "今後はそうした機会に雇用増をテーマとして聞いていって、そしてその聞いたことについて施策に反映をさせていきたい"@ja.
<< kg:id_59 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "今後もこうした広域商談会の開催や、地元企業間での商談会の開催も含め、そのビジネスチャンスを拡大して雇用増につなげる"@ja.
<< kg:id_59 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "地元企業間での商談会の開催も含め、そのビジネスチャンスを拡大して雇用増につなげる"@ja.
<< kg:id_9 prop:effect kg:id_63 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "羽越本線の高速化と県土の一体化、交流人口の拡大などの地域活性化につながるという山形新幹線の庄内延伸"@ja.
<< kg:id_9 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "それぞれ整備が促進されるよう取り組んでまいりたい"@ja.
<< kg:id_65 prop:effect kg:id_66 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "一般の方々にとっても心理的、身体的な負担軽減という時間に換算できない効果がある"@ja.
<< kg:id_16 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "平成24年度には通院費の一部負担金を廃止して就学前児童について通院費、入院費とも無料化する"@ja.
<< kg:id_16 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "財政状況を見て段階的に、中学校修了まで通院費の無料化に向けて取り組んでまいります"@ja.
<< kg:id_21 prop:cause kg:id_69 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "大震災や原発事故による再生可能エネルギーへの期待"@ja.
<< kg:id_21 prop:cause kg:id_70 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "県エネルギー戦略の推進"@ja.
<< kg:id_21 prop:cause kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "県立自然公園内での風力発電の取り扱いの見直し"@ja.
<< kg:id_21 prop:cause kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "風力発電適地としての役割などを考慮し現在の計画に至っております"@ja.
<< kg:id_21 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "事業化に当たりましては環境や景観への影響調査を丁寧に行って"@ja.
<< kg:id_21 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "広報やホームページなどで広くお知らせをし、市民意見をいただくことになります"@ja.
<< kg:id_21 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "その中で騒音や低周波音についても調査をいたします"@ja.
<< kg:id_28 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "民間でできないものは行政で責任を持っていく"@ja.
<< kg:id_28 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "民間への業務の委託に関してはより一層のサービス水準の向上と業務の効率化が図られるものは推進をしてまいります"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "国民健康保険は年齢構成が高く、医療費水準も高い状況にある"@ja.
<< kg:id_78 prop:cause kg:id_80 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "高齢者や非正規労働者など比較的所得の低い被保険者が多い状況にあります"@ja.
<< kg:id_78 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "所得が低い方々に対しましては７割、５割、２割軽減"@ja.
<< kg:id_78 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "非自発的失業者軽減"@ja.
<< kg:id_78 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "単身軽減"@ja.
<< kg:id_78 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "旧被扶養者軽減等によりまして、一定程度軽減をしております"@ja.
<< kg:id_85 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "病気ですとか失業、倒産などで急に収入が減ってしまった場合ですとか、災害で家屋に大きな損害を受けた場合などの理由から納付困難になったときには分割納付にも応じております"@ja.
<< kg:id_85 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "制度の案内パンフですとか、国民健康保険税納税通知書、広報、ホームページ等に掲載をしているほか、窓口、資料コーナーに減免制度のお知らせを置く"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "本市の全児童・生徒数に対する準要保護児童・生徒数の割合は、合併後の平成18年度では6.86％でしたけれども、今年度は8.58％と増加の傾向にあります"@ja.
<< kg:id_45 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "酒田市では1.5倍程度の収入上限額となっております"@ja.
<< kg:id_45 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "現在の状況、基準を今後も維持していきたい"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "私どもといたしましては他の市町村の動向を見守っていきたい"@ja.
<< kg:id_94 prop:cause kg:id_95 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "計画段階から全く一言の情報も提供されることがなかったというのはいかにもお粗末で、せっかく築いてきた行政とのパートナーシップが壊れてしまうのではないかと大変危惧される"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "庄内海岸すべてに巨大風車が建ってしまうのは、威圧感、圧迫感で何か息が詰まりそうであります"@ja.
<< kg:id_98 prop:cause kg:id_99 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "ほかの適地とされている地域については、具体的な計画はまだありませんので、説明会は行っておりません"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "東北電力の発電事業計画の公募が７月から開始され、先着順であったことから、酒田港戦略・振興合同会議の提言については、タイムスケジュール的に検討する余地はなかった"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "毎年の経営状況は芳しくないのが現状であります"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "リフト設備の老朽化は進み、昨年はワイヤー破損などもあり、いつ壊れるかという心配をしながらの点検で維持しているような状況"@ja.
<< kg:id_106 prop:cause kg:id_107 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "雪深い地であるとともに若者の流出なんかもあり、地元の役員がやっとの思いで継続してきたことも既に限界に近く、マンパワー不足は否めず存続が危ぶまれている"@ja.
<< kg:id_108 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "地元旅行会社が新酒と蔵めぐりと寒鱈まつり、そして玉簾の滝を絡めた旅行商品をつくり、現在募集をしております"@ja.
<< kg:id_108 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "地元の皆さんの取り組みに協力しながら誘客に努めてまいります"@ja.
<< kg:id_111 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "本市としてはこれまでどおり６月最終日曜日に行われます湯ノ台口山開きに合わせて開通はしていただきたいと考えておりまして、道路管理者である県とも話し合いを行ってまいります"@ja.
<< kg:id_111 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "ガイドつきの新緑トレッキングなどは魅力が高く、誘客は可能と思われます"@ja.
<< kg:id_114 prop:cause kg:id_115 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "業務内容によっては非正規職員で対応している状況もありまして、新規求人数に係る正社員の構成比は37.6％と非正規社員の割合が高くなってきております"@ja.
<< kg:id_116 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "地元から500名を超す社員を採用する予定で、酒田のＢＰＯキャンパスには将来地元の社員のみで成長させていくという会社の方針があり、本市及び地域の雇用拡大にとって大変期待できる"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "本市では延長保育"@ja.
<< kg:id_118 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "病児・病後児保育"@ja.
<< kg:id_118 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "一時保育"@ja.
<< kg:id_118 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "学童保育などを充実させ、女性が働きやすい職場環境づくりを目指しております"@ja.
<< kg:id_123 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "企業訪問の際など、企業内託児所等に対する各種支援制度の周知と活用も促しております"@ja.
<< kg:id_125 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "労働者からの相談につきましては、ハローワークとの連携のもと対応しております。また、庄内総合支庁の雇用相談窓口についても、広報で周知するなど相談体制の連携、充実を図っております"@ja.
<< kg:id_127 prop:contermeasure kg:id_128 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "地域の子育て家庭を地域の人で支援する地域子育て応援団づくり"@ja.
<< kg:id_129 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "子育てしやすい就労環境整備のための事業所への出前講座による働きかけなどは県内でも特徴的な取り組み"@ja.
<< kg:id_131 prop:cause kg:id_132 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "こうした取り組みが市民の皆さん方に浸透していないとすれば残念なことであります"@ja.
<< kg:id_131 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "今後もさまざまな機会をとらえながら、ＰＲや意識啓発を図ってまいりたい"@ja.
<< kg:id_131 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "標語やキャラクターを活用していくことにつきましても、他市の取り組み状況について勉強してまいりたい"@ja.
<< kg:id_135 prop:cause kg:id_136 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "乳幼児や妊婦、それから高齢者の皆様といったそういった方々の避難者に、避難所運営ですとかあるいは食料の備蓄ですとか、一定の配慮が必要だということが明らかになってきた"@ja.
<< kg:id_137 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "避難所についてはやはり乳幼児がいる家庭の皆様と一般の皆様、これをやはり別スペースにすべきではないか"@ja.
<< kg:id_137 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "段ボールなどを使いまして仕切りのある授乳スペースを確保する"@ja.
<< kg:id_137 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "育児の関係ではそれに対応できるような保健師等の女性スタッフもきちんと配置できるような、そういう仕組みを考えていく必要がある"@ja.
<< kg:id_137 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "粉ミルクですとか紙おむつですとか"@ja.
<< kg:id_137 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "粉ミルクですとか紙おむつですとか"@ja.
<< kg:id_137 prop:contermeasure kg:id_143 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "アレルギー体質のお子様をお持ちの方に対する対応ですとか、そういったものについても今後、検討をしていく必要がある"@ja.
<< kg:id_137 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "この中にも子育て世代の皆さんが見て有用だと思えるようなものをきちんと盛り込む"@ja.
<< kg:id_145 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "防災会議という組織がございますが、そういった会議の構成メンバーとして新たに子育て世代からも加わっていただきまして意見をいただく機会をぜひ設けてまいりたい"@ja.
<< kg:id_145 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "地域の自主防災会、こういった組織の中に子育てサークルなどの皆さんからも参画をしてもらったり"@ja.
<< kg:id_145 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "参画できない方々からは手紙ですとかメール等で意見をいただいて、それを防災、減災対策に生かしていくようなそういう仕組みづくり"@ja.
<< kg:id_149 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "議員定数の適正化を推進するため、酒田市議会の定数を減じようとする"@ja.
<< kg:id_151 prop:cause kg:id_152 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "残念ながら議員定数を削減すべき具体的な理由について報告されておらず"@ja.
<< kg:id_151 prop:cause kg:id_153 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "議員の定数を削減することは、酒田市民と行政とのパイプを細くすることであります"@ja.
<< kg:id_151 prop:cause kg:id_154 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "パブリックコメントでも市民から寄せられた声の多くは市民の声を行政に届けてほしい、そのためにも定数はこのままでというものであった"@ja.
}
