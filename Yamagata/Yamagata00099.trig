kg:st_1 rdfs:label "菅原良明議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "事故を受けて学校給食の放射性物質検査が必要と考える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "安全基準が定まらず食品への不安が消えないため検査が必要とする"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "子供の健康と保護者不安の解消のため酒田市でも実施すべきとする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "子供は大人より健康被害を受けやすく検査が必要とする"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "保護者不安の解消のため検査実施が必要とする"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "兵藤芳勝教育部長"@ja.
kg:st_2 rdfs:type cls:st_47.
cls:st_47 rdfs:label "行政職"@ja.
kg:op_6 prop:content "県の検査対象市として要望している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "一部食材の事前検査の対象となるよう要望している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "公開方法を工夫しながら可能な限り公開したい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "震災の教訓を踏まえ見直しが必要とする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_3 rdfs:label "阿部寿一市長"@ja.
kg:st_3 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_10 prop:content "新たな予測図に基づき見直しと防災対策強化が必要とする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "市民に危険性を十分説明できる体制が必要と求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "危険箇所は避難経路から極力外すべきとする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "必要情報を充実させたハザードマップに見直す考えを示す"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "広く知ってもらう必要のある危険箇所は盛り込むべきとする"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "必要箇所は土地所有者の理解を得ながら調整したい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:st_4 rdfs:label "加藤裕総務部長"@ja.
kg:st_4 rdfs:type cls:st_47.
kg:op_16 prop:content "原発事故を受け国や県の見直しを踏まえ市も見直すとする"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "国や県の動きを見据えて平成24年度に見直す考えを示す"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "固定買取価格制度により普及が進むと見込む"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "風力やバイオマスなど地域資源の活用は地域活性化につながるとする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "市として平成24年度にビジョン見直しを行う考えを示す"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "先導的取り組みとして公共施設導入を検討するとする"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "自治体風力建設も検討する考えを示す"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "市民普及のため補助を継続する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:st_5 rdfs:label "後藤孝也議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_24 prop:content "国を越えた交流人口拡大に取り組むべきとする"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:st_6 rdfs:label "小野直樹商工観光部長"@ja.
kg:st_6 rdfs:type cls:st_47.
kg:op_25 prop:content "人と人との触れ合いは再訪のきっかけになるとする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "市民一人一人のおもてなしが重要とする"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "心のこもった対応が観光客から高い評価を得ているとする"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "人と人との触れ合う機会の多いメニューを増やすべきとする"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:st_7 rdfs:label "大石薫健康福祉部長"@ja.
kg:st_7 rdfs:type cls:st_47.
kg:op_29 prop:content "地域全体で要援護者を支え合うことが必要とする"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_7.
kg:op_30 prop:content "地域の助け合いを助長する制度が必要とする"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "自治会からの登録もあり地域の支え合いとして期待している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_7.
kg:op_32 prop:content "市としてできるだけ柔軟に対応するとする"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_7.
kg:op_33 prop:content "感謝ややりがいとして表彰も検討するとする"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_7.
kg:st_8 rdfs:label "後藤泉議員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_34 prop:content "再生可能エネルギーの必要性が高まったとする"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_8.
kg:op_35 prop:content "市のポリシーを見極め早急に県戦略とすり合わせるべきとする"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_8.
kg:op_36 prop:content "やみくもではなく景観と環境に調和した進め方が必要とする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "森林率60.7％の自治体として森林政策を強めるべきとする"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_8.
kg:op_38 prop:content "森林利活用を進めなければ山が荒廃し地域衰退が進むと懸念する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:op_39 prop:content "公共施設や民間住宅で地元産材活用を積極的に進める考えを示す"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "川上から川下へつなぐ流れを完結するため必要とする"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:st_9 rdfs:label "阿部ひとみ議員"@ja.
kg:st_9 rdfs:type cls:st_16.
kg:op_41 prop:content "変化する環境の中で中心市街地活性化が必要とする"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "中心市街地の魅力づくりが必要とする"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_9.
kg:op_43 prop:content "企業情報発信や企業間交流の常設の場として活用したいとする"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "公益文科大学と連携し町なか観光や居住や商店街魅力向上に取り組むとする"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "清水屋は中心市街地に欠くことのできない核店舗と認識する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "市役所が市民や観光客を結ぶ機能を果たすべきとする"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "女性視点と農商工連携で子供も訪れる場にしたいとする"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:st_10 rdfs:label "前田茂実会計管理者兼会計課長"@ja.
kg:st_10 rdfs:type cls:st_47.
kg:op_48 prop:content "金融機関破綻時でも全額保護されるよう管理している"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_10.
kg:op_49 prop:content "最も安全で確実有利な方法で運用している"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_10.
kg:op_50 prop:content "年末払い拡大で一定の経済波及効果があったとする"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_10.
kg:op_51 prop:content "平成23年度決算と一体的に公表できるよう研究する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_10.
kg:st_11 rdfs:label "田中斉議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_52 prop:content "医師常駐がなくなることで島民不安が大きいとする"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_11.
kg:op_53 prop:content "来月から無医島となり島民が不安を抱かざるを得ないとする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_11.
kg:op_54 prop:content "高齢化率の高い島で医療不安の軽減策が必要とする"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_11.
kg:op_55 prop:content "飛島診療所と日本海総合病院にモニター等を設置して対応する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "医療情報共有により飛島診療所で対応できる場合が増えるとする"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_7.
kg:op_57 prop:content "特に緊急性が高い場合はヘリや巡視船を要請して対応する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_7.
kg:op_58 prop:content "県内全域を30分以内でカバーできるため期待している"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_7.
kg:op_59 prop:content "収益確保のため６次産業化システム構築が必要とする"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_11.
kg:op_60 prop:content "個々の生産者では難しいため支援システムが必要とする"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_11.
kg:op_61 prop:content "新制度を活用すれば生産者の手取りを増やすチャンスとする"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_11.
kg:op_62 prop:content "市とＪＡが役割分担して６次産業化を一層促進したいとする"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_3.
kg:op_63 prop:content "成功事例の共有と検証が重要とする"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_3.
kg:op_64 prop:content "施設や機関利用の経費課題に対し市も一定支援したいとする"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_3.
kg:op_65 prop:content "これまでうまくいきにくかった要因は交流不足と情報不足とする"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_3.
kg:op_66 prop:content "製造業商業サービス業と農業者の連携や商品開発を促すとする"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_3.
kg:st_12 rdfs:label "白崎好行農林水産部長"@ja.
kg:st_12 rdfs:type cls:st_47.
kg:op_67 prop:content "交流会で課題整理を進め次につなげたいとする"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_12.
kg:op_68 prop:content "震災の影響で貨物取扱量が大幅に増えたとする"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_6.
kg:op_69 prop:content "加工食品開発も含めた取り組みが必要とする"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_11.
kg:op_70 prop:content "現在も堅調な推移を見せているとする"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_6.
kg:op_71 prop:content "少ない荷物でも容易に貿易できることが一番のメリットとする"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_6.
kg:op_72 prop:content "便数増が最も効果的な短縮策とする"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_6.
kg:op_73 prop:content "指定精米工場登録が進めば酒田港活用の米輸出拡大が期待できるとする"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_6.
kg:st_13 rdfs:label "佐藤猛議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_74 prop:content "障がい者雇用は一般雇用以上に厳しいとする"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_13.
kg:op_75 prop:content "酒田管内の障がい者雇用率は1.58％で未達成とする"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_7.
kg:op_76 prop:content "平均月額賃金は目標額２万円を大きく下回ると認識する"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_7.
kg:op_77 prop:content "需要拡大のため関係機関と連携して支援している"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_7.
kg:op_78 prop:content "社会的コスト低減と多様な雇用機会提供の点で有意義な制度とする"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_3.
kg:op_79 prop:content "モデル事業実施時は本市として前向きに検討したい"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_3.
kg:op_80 prop:content "読み書きに困難のある子供への有効な教材として導入を求める"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_13.
kg:op_81 prop:content "音読が飛躍的に上達し自信につながる効果を紹介し導入を求める"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_13.
kg:st_14 rdfs:label "石川翼久教育長"@ja.
kg:st_14 rdfs:type cls:st_64.
cls:st_64 rdfs:label "教育職"@ja.
kg:op_82 prop:content "文科省の研究成果や情報提供を受けながら活用可能性を研究するとする"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_14.
kg:op_83 prop:content "現時点では市立図書館所蔵はなく県立点字図書館を紹介するとする"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_14.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "福島第一原子力発電所の事故の問題でありますが"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "安全基準そのものが定まらないような国の状態に、食品への不安というものはなかなか消えないということであろうと思います"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "山形市では、県内で初めて放射性物質に感応しやすいとされる子供の健康や保護者の不安払拭の要望にこたえ、小中学校の学校給食の献立の放射性物質の検査を実施し"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "細胞分裂を繰り返し成長していく子供たちは大人の何倍も健康被害を受けやすいということを考えれば"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "子供の健康や保護者の不安払拭の要望にこたえ"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "現在、県では、給食に使用した食材１週間分をミキサーにかけまして検査をする、いわゆる事後検査を県内５つの市町を対象にして実施しております。酒田市でも平成24年度の検査対象市として要望しているところでございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "平成24年度から県のほうで一部の食材について事前検査を実施するというふうな計画があるというふうにも伺っております。これについても対象としていただけるように要望しているところでございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "酒田市の給食の食材の購入先は多岐にわたっておりますけれども、公開方法を工夫しながら可能な限り公開していきたい"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "東日本大震災を受けて、国の防災会議でもハード面の整備だけでは限界があるとして、減災の考え方を打ち出しております"@ja.
<< kg:id_10 prop:cause kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "このたび、その成果が公表されたわけでありまして、改めてこの浸水域予測図に基づいて津波ハザードマップの見直しなど防災対策の充実強化が必要だ"@ja.
<< kg:id_10 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "新聞などを見て自分たちの住む酒田市も津波の高さや浸水が広範囲に及ぶようだと驚かれた市民の方々も多くいらっしゃると思います"@ja.
<< kg:id_10 prop:effect kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "実際に現地を見てみますと、大規模地震の場合はがけ崩れやブロック塀の倒壊などが想定される場所があった"@ja.
<< kg:id_10 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "もちろん浸水区域とか避難場所、避難経路、それからその場所の標高などの従来掲載した内容に加えて、津波避難ビル、それから浸水深、浸水時間、こういうことなどは掲載していかなければならない"@ja.
<< kg:id_10 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "危険箇所というようなことについても広く知っていただく必要があるような場所については、当然のことながらそういう情報を盛り込むことも地域的には考えていい"@ja.
<< kg:id_10 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "高台への避難路として高齢者の皆さんなどにも御利用いただくためには、手すりの設置などが必要ではないかというような御要望をいただいた場所もあった"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "大震災に伴います原発事故の影響から、国あるいは県で大幅なエネルギー政策の見直しというものを現在行っている最中でございます"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "こういった動きを見据えて、平成24年度に本市といたしましては新エネルギービジョンの見直しを行うという考えでおります"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "固定買取価格となるということで、再生可能エネルギーの普及がより一層進むだろう"@ja.
<< kg:id_18 prop:effect kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "地域資源をこういった形で活用するということは、大いに地域活性化あるいは地域産業の振興にもつながっていくだろう"@ja.
<< kg:id_18 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "平成24年度に本市といたしましては新エネルギービジョンの見直しを行うという考えでおります"@ja.
<< kg:id_18 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "本市といたしましては先導的な取り組みをするために、例えば公共施設への導入"@ja.
<< kg:id_18 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "あるいは自治体風力の建設というものも検討する考えでおります"@ja.
<< kg:id_18 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "これまで続けてまいりました太陽光パネルあるいはペレットストーブ設置に対する補助というものも継続してまいります"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "大震災後、日本の観光は大きく北日本を中心に落ち込んでいるわけであります"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "人と人との触れ合いは再びこの地を訪れるきっかけになっております"@ja.
<< kg:id_27 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "市民一人一人がおもてなしの心を持って交流することが非常に大事である"@ja.
<< kg:id_27 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "酒田市の観光ガイド協会がございます。また、タクシーで観光案内をしているガイドライバーという制度もございまして、これらの方々からは心のこもった対応をしていただいております。そして観光客からも高い評価をいただいている"@ja.
<< kg:id_27 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "グリーンツーリズムなど本市の自然や産業等の特性を生かした新たな体験型観光、こういうものの開発によりまして、人と人との触れ合う機会の多いメニューをふやしながら交流人口の拡大を推進していきたい"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "高齢化が進み、協力員の確保も困難になってきている地域もあります。地域全体として要援護者を支え合うことが必要"@ja.
<< kg:id_33 prop:effect kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "高齢者世帯や障がい者世帯に対する除雪制度"@ja.
<< kg:id_33 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "今年度より団体による除雪ボランティアを募集いたしましたところ、３団体から登録がありました。このうち２団体は自治会からの申し出でございまして、地域の支え合いを具現化する動きとして期待をしている"@ja.
<< kg:id_33 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "今後も地域の実情に応じた除雪体制に対しまして、市としてもできるだけ柔軟に対応してまいります"@ja.
<< kg:id_33 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "協力者への感謝、また、やりがいとして表彰することも一つの方法と考えられます"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "東日本大震災での原発事故以来、再生可能エネルギーの必要性が非常に高まっている"@ja.
<< kg:id_39 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "本市としてのポリシーはどこにあるのかを冷静に議論し見きわめ、県のエネルギー戦略とのすり合わせは早急に行う必要がある"@ja.
<< kg:id_39 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "大事なことは、やはり景観といいますか環境と調和のとれたような、そういう進め方をしなければいけない"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "森林率60.7％という森林都市としての一面を持つ自治体となったことをこれまで以上に自覚した政策を展開していかなければ"@ja.
<< kg:id_43 prop:effect kg:id_45 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "川下を潤す川上の山は荒廃していく一方となり、過疎地域の衰退がますます進んでいくのではないか"@ja.
<< kg:id_43 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "公共施設それから民間住宅で地元産材を使うときの支援"@ja.
<< kg:id_43 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "地元の製材業者さんを中心とした木材人工乾燥施設の建設への支援をやることが、川上から川下へつなげる木の流れを完結するために、ボトルネックを解消するために必ず必要だ"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "郊外への大型商業施設の進出や、最近ではネット販売などによる消費者の行動の変化など、取り巻く環境が目まぐるしく変わってきている"@ja.
<< kg:id_48 prop:cause kg:id_50 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "最近ではネット販売などによる消費者の行動の変化など"@ja.
<< kg:id_48 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "市民の皆さんへ本市の企業の皆さんの取り組みなどについての情報提供、そして企業間での情報提供、情報交換などができる場面を常設として持つことは本市産業全体の活性化にもつながる"@ja.
<< kg:id_48 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "今、具体的にいろいろ取り組んでいるものは、例を申し上げますと、町なか観光の推進、町なか居住の推進、そして、商店街の魅力アップ"@ja.
<< kg:id_48 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "清水屋がやはり中心市街地に欠くことのできない核店舗であるという認識が広く商店街の皆さん、市民の皆さんに行き渡った"@ja.
<< kg:id_48 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "市役所自体が、市民が利用しやすい施設になるとともに、観光地や中心市街地、商店街とを結ぶという機能を大事にしていく"@ja.
<< kg:id_48 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "中町マルシェへの期待についても述べていただきました。確かにここについては、女性の視点ということと農商工の連携ということを大きなポイントにしております"@ja.
<< kg:id_56 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "この口座は決済用預金としております。仮に金融機関が破綻した場合でも全額保護されることになってございます"@ja.
<< kg:id_56 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "最も安全でかつ確実、有利な方法として定期預金や通知預金などによりその安全性と効率性を確保している"@ja.
<< kg:id_56 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "地元企業の資金繰りを応援するということから年末の支払いを拡大しております"@ja.
<< kg:id_56 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "本市におきましては、より信頼される公会計制度を目指すために、この情報開示を前向きに検討したい"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "2000年４月に飛島診療所に赴任された杉山先生が75歳という御高齢を理由に３月いっぱいで御退任することになりました"@ja.
<< kg:id_61 prop:effect kg:id_63 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "来月から飛島は医師が常駐しない無医島の状態となります"@ja.
<< kg:id_61 prop:effect kg:id_64 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "高齢化率が既に60％に達している島民の今後の医療に向けては不安を抱かざるを得ません"@ja.
<< kg:id_61 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "遠隔診療システムの構成といたしましては、飛島診療所と日本海総合病院にモニターを設置し、飛島診療所側には生体モニター、簡易稼働カメラも備える予定"@ja.
<< kg:id_61 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "飛島診療所におきましても平成24年４月からちょうかいネットに参加する方向で、現在その手続中でございます"@ja.
<< kg:id_61 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "特に緊急性が高い場合は、ヘリコプターまたは巡視船を要請しているところです"@ja.
<< kg:id_61 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "平成24年12月からは、山形県立中央病院にドクターヘリが配備される予定でございます。30分以内で県内全域カバーとなるようですので、緊急時の医療対応策としては期待している"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "昨今のデフレ基調で、収益に合う単価がなかなかとれない現在の状況がさらに長引けば何らかの対応を考えていかねばなりません"@ja.
<< kg:id_69 prop:cause kg:id_71 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "加工、それから流通、マーケティング、経営管理等のノウハウまで必要になりますが、農林水産業者個人は事業規模や資本力、資金等の制約からそのような人材を育成したり確保することはなかなか簡単なことではございません"@ja.
<< kg:id_69 prop:effect kg:id_72 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "酒田市独自の６次産業化のシステムを早急に構築して、生産者の手取りをふやすチャンスではないか"@ja.
<< kg:id_69 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "市が一定の財政支援をし、農業者の皆さんが属するＪＡがノウハウなどの提供をするというようなことで、ぜひ６次産業化を一層促進していきたい"@ja.
<< kg:id_69 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "成功事例というものをいろいろ御紹介し検証していく、また、そういう仲間同士の情報交換というのも大事"@ja.
<< kg:id_69 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "新製品開発に係ることについてであれば、ぜひ市のほうでも一定の支援をしていきたい"@ja.
<< kg:id_76 prop:cause kg:id_77 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "今までなぜそういうことがうまくいきにくかったかというと、やはり交流の場が少なくて、交流のための情報の量も双方で不足していた"@ja.
<< kg:id_76 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "アグリビジネス推進ネットワークの組織化をし、製造業、商業、サービス業の皆さんと農業者の皆さんとの連携、そして商品開発を促していきたい"@ja.
<< kg:id_76 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "３月21日に６次産業化、農商工連携のマッチング交流会も開催する予定"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "昨年は震災の影響によって、代替港ということで貨物の取り扱い量が大幅にふえてございます"@ja.
<< kg:id_80 prop:cause kg:id_82 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "現在のコンテナ便では、輸送日数や検疫時間が長いため、日もちのする農産加工品、料理の加工品を地元で大量につくれないか"@ja.
<< kg:id_80 prop:effect kg:id_83 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "コンテナ貨物につきましては、20フィート換算では合計で１万346ＴＥＵ、これは過去最高の取り扱い量でございまして、現在も堅調な推移を見せている"@ja.
<< kg:id_80 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "小口混載貨物、いわゆる小口混載のコンテナ制度でございますが、そのメリットということですが、これは当然少ない荷物でも容易に貿易ができるという状況が一番のメリット"@ja.
<< kg:id_80 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "輸出時間を短縮するにはということですが、これはやはり今ある船便、釜山まで週２便行っていますけれども、便数をふやすことが一番効果的"@ja.
<< kg:id_80 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "現在、指定精米工場の登録に向けた調査が進められてございます。こういうものが登録されれば酒田港を活用した米の輸出拡大がますます図られるものと期待"@ja.
<< kg:id_87 prop:cause kg:id_88 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "雇用状況は大変厳しいものがございます。いわんや障がい者の方の雇用となると、さらに厳しい"@ja.
<< kg:id_87 prop:effect kg:id_89 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "法定雇用率1.8％に対し、平成24年１月末現在で1.58％と、達成はされていない状況"@ja.
<< kg:id_87 prop:effect kg:id_90 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "平均月額賃金は平成22年度で9,911円と、目標額の２万円を大きく下回っている"@ja.
<< kg:id_87 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "市役所ロビーにおける障がい者バザーの開催、あるいはイベント時の販売の呼びかけなど、関係機関と連携し需要の拡大のために支援を行っております"@ja.
<< kg:id_92 prop:effect kg:id_93 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "社会全体でのコストの低減でありますとか、それから障がい者の皆さんに対する多様な雇用機会の提供ということで大変有意義な制度"@ja.
<< kg:id_92 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "国がモデル事業ということで実施するということであれば、その取り組みについて本市としても前向きに検討していきたい"@ja.
<< kg:id_95 prop:cause kg:id_96 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "教科書や黒板に書かれた文字を認識すること自体に困難がある"@ja.
<< kg:id_95 prop:effect kg:id_97 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "今では一定時間に音読できる分量が５倍以上にふえて、飛躍的に音読が上達しました。そのことが自信にもつながった"@ja.
<< kg:id_95 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "文部科学省の研究成果等の情報提供を受けながら、特別支援教育におけるデイジー教科書の学習教材としての活用の可能性について研究をしていきたい"@ja.
<< kg:id_95 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "本市においてデイジー図書のお問い合わせがあった場合は、県立の図書館を紹介したい"@ja.
}
