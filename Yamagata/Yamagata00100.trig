kg:st_1 rdfs:label "高橋正和議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "即時影響だけでなく長期的な汚染リスクを重視する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "阿部寿一市長"@ja.
kg:st_2 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_2 prop:content "放射能は正しい理解のもとで冷静に対応すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "長期にわたり汚染が残る危険を強く懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "原発災害に備えて心配や避難を強いられる状況は許せない"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "福島第一原発事故を踏まえ原発依存を見直すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "福島第一原発事故は国のエネルギー政策見直しを迫る重大事故"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "高濃度汚染水漏水時の広域汚染を強く懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "国土の繁栄には自然エネルギー重視が必要と考える"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "自然エネルギー活用を積極的に進めるべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "太陽光発電は経済成長につながる市場として期待できる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "輸入化石燃料の節約効果があると評価する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "短期的にも地域経済政策として有効とみる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "原発事故は国民に大きな衝撃を与えた重大事故と認識する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "事故を受けエネルギー政策見直しは不可避とみる"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "補助制度と啓発で太陽光発電の導入を促進したい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "小水力は土地改良区でのモデル実施から普及を目指す"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "庄内海岸の適地を生かし風力発電整備を進めるべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_3 rdfs:label "加藤裕総務部長"@ja.
kg:st_3 rdfs:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_18 prop:content "宮海地区と宮野浦十里塚地区沿岸部を有望地として県と勉強を続ける"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "国や県の見直しに呼応して市のエネルギー政策も見直す"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "木質バイオマス燃料生産に前向きに取り組む考え"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:st_4 rdfs:label "白崎好行農林水産部長"@ja.
kg:st_4 rdfs:type cls:st_18.
kg:op_21 prop:content "新エネルギービジョンの中でバイオエネルギー活用に積極的に関わりたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "木質バイオマスは温暖化防止に役立つと評価する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "木質バイオマス活用は森林環境整備にもつながる"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:st_5 rdfs:label "石川翼久教育長"@ja.
kg:st_5 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_24 prop:content "学校設置の太陽光発電では日照時間と発電量の相関が確認された"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "気温よりも日照などの条件が発電量に影響するとみられる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:op_26 prop:content "安全指導を徹底しても事故が起きており改めて難しさを感じる"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "事故防止のため安全対策と指導研修の徹底が必要"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "必修化に伴い安全対策と指導研修を万全にすべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "手引きとチェックリストを用いて安全管理を徹底する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "文科省の事務連絡とチェックリストに沿い指導体制を確認する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "地域の柔道連盟と連携して安全で実践的な指導を補う"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:st_6 rdfs:label "佐藤丈晴議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_32 prop:content "瓦れき撤去が進まないと復興とまちづくりが進まない"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:st_7 rdfs:label "亀山石巻市長"@ja.
kg:st_7 rdfs:type cls:st_17.
kg:op_33 prop:content "再生のため全国の自治体と市民の協力が必要"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_7.
kg:op_34 prop:content "再生のため全国の協力を求める"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_7.
kg:st_8 rdfs:label "村井宮城県知事"@ja.
kg:st_8 rdfs:type cls:st_20.
cls:st_20 rdfs:label "知事"@ja.
kg:op_35 prop:content "県外搬出を前提にあと2年で処理したい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_8.
kg:st_9 rdfs:label "酒田市議会議会運営委員会委員長関井美喜男議員"@ja.
kg:st_9 rdfs:type cls:st_16.
kg:op_36 prop:content "放射能汚染の不安がない災害廃棄物は受入処理に協力すべき"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_9.
kg:op_37 prop:content "受入時は測定体制を整え住民不安の解消を図るべき"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_9.
kg:op_38 prop:content "受入は安全確保と県基準充足が前提"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "周辺住民の理解が受入の必須条件と考える"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "酒田広域構成市町の理解も必要と考える"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "最終処分場に余裕がないため埋め立て処分は困難で焼却可能物が中心になる"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "橋が落ちれば集落孤立につながるため情報公開が必要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_6.
kg:st_10 rdfs:label "伊藤一幸建設部長"@ja.
kg:st_10 rdfs:type cls:st_18.
kg:op_43 prop:content "沿線建物の倒壊は交通機能維持の大きな課題"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_10.
kg:op_44 prop:content "震災対応や調査依頼増加を踏まえ危機管理室の体制強化が必要"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "被災地で得た知見を庁内横断で共有できる体制が必要"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "スマートフォン普及を踏まえ無線LAN環境を充実させたい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "公共施設全般で無線LAN環境整備を進めるべき"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "情報整理だけでなく分析まで踏み込む体制を検討したい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "データ統合と分析を行う分析業務部門が必要"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:st_11 rdfs:label "大石薫健康福祉部長"@ja.
kg:st_11 rdfs:type cls:st_18.
kg:op_50 prop:content "庄内地域ではDMAT配置と複数化を進める方向"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_11.
kg:op_51 prop:content "庄内DMAT体制強化は必要な課題"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:op_52 prop:content "メディカルラリーを市民周知し救急救命への関心を高めたい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_11.
kg:op_53 prop:content "メディカルラリーは庄内の救命救急体制理解の好機"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_6.
kg:st_12 rdfs:label "齋藤勉市民部長"@ja.
kg:st_12 rdfs:type cls:st_18.
kg:op_54 prop:content "公益活動団体は人員や資金が不足しており支援が必要"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_12.
kg:op_55 prop:content "公益活動支援センターの相談機能と支援体制を充実させたい"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_12.
kg:op_56 prop:content "津波シミュレーション映像を活用して意識啓発を進めたい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:st_13 rdfs:label "斎藤周議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_57 prop:content "全市民対象に津波の怖さと避難意識を高める教育が必要"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_13.
kg:op_58 prop:content "地域住民参加のワークショップで実効性あるハザードマップを作りたい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "出前講座を充実し津波理解を深めたい"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "行政から主体的に市民へ働きかける津波教育が必要"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_13.
kg:op_61 prop:content "タクシー無線の活用は有意義で前向きに検討したい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "災害時はタクシー無線を情報伝達手段として連携すべき"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_13.
kg:st_14 rdfs:label "丸山至財務部長"@ja.
kg:st_14 rdfs:type cls:st_18.
kg:op_63 prop:content "契約方法の多様化を踏まえ第三者機関設置を検討中"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_14.
kg:op_64 prop:content "入札契約を第三者の客観的視点で監視する必要がある"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_13.
kg:op_65 prop:content "費用対効果を踏まえ現時点では電子入札導入を見送る"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_14.
kg:op_66 prop:content "電子入札は談合防止や事務効率化の効果が期待できる"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_13.
kg:op_67 prop:content "生活保護受給者には高齢で自立困難な人が多いと認識する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_13.
kg:op_68 prop:content "高齢者世帯は自立が困難な方が多いと認識する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_11.
kg:op_69 prop:content "疾病が自立を阻む大きな要因だとみる"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_13.
kg:op_70 prop:content "傷病世帯が多く自立困難な事情がある"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_11.
kg:op_71 prop:content "雇用情勢悪化で再就職が極めて困難になっている"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_13.
kg:op_72 prop:content "50歳代以上の求職者には厳しい状況が続いている"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_11.
kg:op_73 prop:content "預貯金の減少で生活保護に至る人が多いとみる"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_13.
kg:op_74 prop:content "就労支援員配置とハローワーク連携で自立支援を進める"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_11.
kg:op_75 prop:content "高齢層には就労支援だけでの自立は厳しい"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_13.
kg:op_76 prop:content "高齢者世帯や障害者世帯が多く医療扶助費割合が高い"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_11.
kg:op_77 prop:content "医療費適正化のためレセプト点検と嘱託医審査を行っている"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_11.
kg:op_78 prop:content "過剰診療や過剰投薬はないが重複受診等は見られる"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_11.
kg:op_79 prop:content "医療費無料だから受診が乱用されているわけではない"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_13.
kg:op_80 prop:content "重複受診等は受給者の理解不足によるところが大きい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_11.
kg:op_81 prop:content "発見次第適正受診を指導している"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_11.
kg:op_82 prop:content "担い手の高齢化と減少が農業の大きな課題"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:st_15 rdfs:label "本多茂議員"@ja.
kg:st_15 rdfs:type cls:st_16.
kg:op_83 prop:content "担い手確保を農政の柱に据えるべき"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_15.
kg:op_84 prop:content "米主体経営から脱皮できないことが所得向上を阻む"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "米価低迷と資材高騰で所得補償なしでは経営が成り立たない"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_15.
kg:op_86 prop:content "中心経営体の育成と農地集積は従来の市の方向性と一致する"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:st_16 rdfs:label "五十嵐直太郎農業委員会会長"@ja.
kg:st_16 rdfs:type cls:st_4.
cls:st_4 rdfs:label "会長"@ja.
kg:op_87 prop:content "地域の話し合いと合意形成を通じて中心経営体への農地集積を進めるべき"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_16.
kg:op_88 prop:content "地域の理解を得るため丁寧な説明と話し合いを重ねたい"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_2.
kg:op_89 prop:content "農業委員会は地域の実情を踏まえ合意形成に積極的に関わる"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_16.
kg:op_90 prop:content "検討会メンバーに女性参画を確保する必要がある"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_16.
kg:op_91 prop:content "新制度では地域環境保全の高度な活動が追加される"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_4.
kg:op_92 prop:content "活動項目整理で報告書類を軽減し事務簡素化を図る"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_4.
kg:op_93 prop:content "事務だけでなく要件緩和も必要"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_15.
kg:op_94 prop:content "雪の多い酒田では冬期湛水60日要件が実施しにくい"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_4.
kg:op_95 prop:content "積雪地帯の実情に合わず国県へ強く要望すべき"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_15.
kg:op_96 prop:content "地域特認取組の新設と国承認を県に早く進めてもらいたい"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_4.
kg:op_97 prop:content "作付時期に間に合うよう早急な制度化が必要"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_15.
kg:op_98 prop:content "メリットとデメリットの徹底した話し合い不足が法人化停滞の一因"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_2.
kg:op_99 prop:content "経営指導と組織運営の助言不足も要因"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_15.
kg:op_100 prop:content "リーダー研修や話し合いで可能な限り多くの組織を法人化したい"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_2.
kg:op_101 prop:content "今後5年間で営農指導と経営指導を充実させたい"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_4.
kg:op_102 prop:content "組織の継続には張りついたアドバイザー支援が必要"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_15.
kg:op_103 prop:content "農商工連携の場をつくり製品化に結びつけたい"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_2.
kg:op_104 prop:content "地域資源を活用し加工販売で所得増大を図るべき"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_15.
kg:op_105 prop:content "中町マルシェを6次産業化の販売拠点として生かしたい"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_2.
kg:op_106 prop:content "成功事例のPRで取り組み意欲を広げたい"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_2.
kg:op_107 prop:content "多様な媒体で男女共同参画を周知している"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_2.
kg:st_17 rdfs:label "武田恵子議員"@ja.
kg:st_17 rdfs:type cls:st_16.
kg:op_108 prop:content "講演会だけでは関心の薄い層に届きにくい"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_17.
kg:op_109 prop:content "個別分野の実践を通して男女共同参画の必要性を伝えるべき"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_2.
kg:op_110 prop:content "推薦依頼時に女性委員推薦への配慮を求めている"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_3.
kg:op_111 prop:content "数値目標30％達成へより具体的な対応が必要"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_17.
kg:op_112 prop:content "公募でも女性参画率向上を意識して取り組む"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_3.
kg:op_113 prop:content "若い年代で女性比率が高く今後管理職登用は増える見通し"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_3.
kg:op_114 prop:content "見通しではなく意識的に育成し比率を上げるべき"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_17.
kg:op_115 prop:content "保育料は低所得世帯の負担軽減を意図して細分化している"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_11.
kg:op_116 prop:content "近隣自治体より高く見える保育料設定は住居選択にも影響する"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_17.
kg:op_117 prop:content "担任を日々雇用に頼ることは保護者に納得されにくい"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_17.
kg:op_118 prop:content "早期退職や産休育休で日々雇用配置が必要な場合がある"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_11.
kg:op_119 prop:content "引き継ぎ会議と園全体の連携で保育の一貫性を確保している"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_11.
kg:op_120 prop:content "正規職員が担任できる体制を確保することが保育の質向上に重要"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_17.
kg:op_121 prop:content "孤独死の再発防止のため見守り体制強化が必要"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_17.
kg:op_122 prop:content "孤独死が起きないよう努力したい"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_2.
kg:op_123 prop:content "情報不足で民生委員が踏み込んだ支援をしにくい"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_17.
kg:op_124 prop:content "必要な情報がないと民生委員の役割を十分果たせない"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_2.
kg:op_125 prop:content "民生委員が地域把握できるよう住民票閲覧を可能にしている"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_2.
kg:op_126 prop:content "必要世帯情報を個別に提供し民生委員の見守りに生かしている"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_2.
kg:op_127 prop:content "本人同意を得た上で台帳整備と情報共有を進めたい"@ja.
kg:op_127 rdf:type cls:opinion.
kg:op_127 prop:speaker kg:st_2.
kg:op_128 prop:content "本人了解のもとで情報共有を検討すべき"@ja.
kg:op_128 rdf:type cls:opinion.
kg:op_128 prop:speaker kg:st_17.
kg:st_18 rdfs:label "小野直樹商工観光部長"@ja.
kg:st_18 rdfs:type cls:st_18.
kg:op_129 prop:content "有効求人倍率は改善しているが依然厳しい状況"@ja.
kg:op_129 rdf:type cls:opinion.
kg:op_129 prop:speaker kg:st_18.
kg:op_130 prop:content "倍率改善でも自分の仕事がなければ安心できない"@ja.
kg:op_130 rdf:type cls:opinion.
kg:op_130 prop:speaker kg:st_17.
kg:op_131 prop:content "求人回復傾向でも全体の経済情勢は厳しい"@ja.
kg:op_131 rdf:type cls:opinion.
kg:op_131 prop:speaker kg:st_18.
kg:op_132 prop:content "各種支援制度と関係機関連携で雇用改善を図る"@ja.
kg:op_132 rdf:type cls:opinion.
kg:op_132 prop:speaker kg:st_18.
kg:op_133 prop:content "若者の職場確保と地元企業支援を強めるべき"@ja.
kg:op_133 rdf:type cls:opinion.
kg:op_133 prop:speaker kg:st_17.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "わずかのその放射線が入っても、体には即座には影響ないということを言われております"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "後年度何十年もかかっても汚染されたものは直らない"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "54基の原発の中で、いろいろ災害が起きたときに心配したり、または避難したりしなければならない"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "福島の第一原発の水蒸気爆発というのが起こりました"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "あれ一つ漏水して漏れ出したときに、東日本の国土、または内陸のほうの北海道のほうはやはり汚染される"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これからの糧にして自然エネルギーを大切にするということでないと、これからの国土の繁栄、日本国の繁栄にはつながらない"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "数兆円規模の市場が期待できると言われています"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "ＧＤＰの５％も輸入費用に達する化石燃料を節約できるとも言われています"@ja.
<< kg:id_14 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "短期的には経済産業政策や地域経済政策として期待できると言われています"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "福島第一原発の事故というのは国民にとって大きなショックを与え"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "政府全体で国全体でのエネルギー政策の見直しを迫るというような重大な事故"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "補助制度などをしっかり導入し、啓発活動をすることによってその導入促進を図っていきたい"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "小水力については、きめ細かく水路を持っている土地改良区での対応ということが一番現実的なことだと思いますので、モデル的に取り組みながら普及を目指していきたい"@ja.
<< kg:id_24 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "庄内海岸が最も立地の適地だということでありますので、具体的な条件整備なども含めて、さらに整備できるところについては整備をしていく"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "市としてのエネルギー政策の見直し作業も新年度やっていきたい"@ja.
<< kg:id_28 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "木質バイオマス燃料の生産についても、ぜひ前向きに取り組んでいきたい課題だ"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "地球温暖化の防止にももちろん役立つ"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "森林の環境整備にも役立つ可能性がある"@ja.
<< kg:id_12 prop:effect kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "各季節の日照時間と発電量というのは、ほぼ比例している"@ja.
<< kg:id_12 prop:effect kg:id_34 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "発電量と気温の高さということは必ずしも合致しておりませんでした"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "今年度２月末現在でこの柔道にかかわる負傷事故はありました。足の捻挫２件、頚椎捻挫１件、足の骨折２件、鎖骨骨折１件"@ja.
<< kg:id_35 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "安全指導の徹底と、こういうことの中でもやはり事故が発生してしまった"@ja.
<< kg:id_35 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "「柔道の安全指導の手引」というのを配付しておるわけですが、それをもとに、改めてまた安全については徹底をさせていこうと思っておりますし、さらに３月９日に文部科学省が出しました武道必修化に伴う柔道の安全管理の徹底についてという事務連絡が入ってきております。その中でチェックリストもありますので、そのチェックリストに沿いながら、なお一層各学校の指導体制をチェックしていきたい"@ja.
<< kg:id_35 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "地区の柔道連盟の方に御協力もお願いして、学校のほうでいろいろ実践的な指導をしていただいたり、また保健体育の先生のほうにいろいろ教えていただいたり"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "瓦れき撤去が進まないとまちづくりが制限される"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_34;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "再生を図っていくためにも全国の自治体、市民の皆様に協力していただきたい"@ja.
<< kg:id_42 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "放射能汚染の不安のないことが確認されたものについては、受入処理に協力すること"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "受入にあたっては、放射能汚染濃度の測定体制を速やかに構築し、住民の不安解消に努めること"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "安全性が十分確保できること、それは県の受け入れ基準を満たしていただかなければならない"@ja.
<< kg:id_47 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "焼却場とか最終処分場がある周辺住民の理解を特に得ていく必要があろう"@ja.
<< kg:id_47 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "庄内町と遊佐町の理解を得ることももちろん必要"@ja.
<< kg:id_47 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "埋め立て処分というようなものを受け入れることは、基本的には今この時点では困難ではないか、だとすれば焼却可能なもの"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "この橋が落ちてしまったらこの集落は孤立する"@ja.
<< kg:id_54 prop:effect kg:id_55 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "沿線にある建物の倒壊等、間違いなくもし倒壊すれば道路閉塞という形は確実になる"@ja.
<< kg:id_56 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "今年度の状況を見てみますと一定の強化が必要なんだろう"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "庁舎改築等のタイミングをとらえて、これは充実を図ってまいりたい"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "統計係で単にその情報を整理するだけでなくて、どういった分析まで踏み込んで対応できるかというところは、一つ組織上の検討課題"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_50;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "災害拠点病院へＤＭＡＴの配置やＤＭＡＴチームの複数化の方向が出されております"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_52;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "市も広報などを使いながら市民に周知をしてまいります"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "公益活動団体の多くは、少人数で資金が十分ではなく活動拠点や人員が不足している"@ja.
<< kg:id_68 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "センターの相談機能、支援体制を充実させ、公益活動の支援に努めていきたい"@ja.
<< kg:id_70 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "津波シミュレーションのコンピューターグラフィックなどの映像資料も作成をしていただけるという話を聞いております。ぜひこういうものについては各種研修会などでしっかり活用したい"@ja.
<< kg:id_70 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "津波ハザードマップを、ワークショップ形式で、つまり地域住民参加のもとに、しっかりといいものをつくっていきたい"@ja.
<< kg:id_70 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "映像資料を活用した出前講座などについても充実していく"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "タクシー関係の団体の皆さんと協議をして、どんなことができるかということを検討していきたい"@ja.
<< kg:id_76 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_63;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "第三者機関をどのような形で設置していけるのか、具体的には設置の形態、要綱とか条例とかどのような形にするのか、あるいはその機能はどうするのかというところを現在検討している"@ja.
<< kg:id_78 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_65;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "本市の工事等の入札の件数、それから費用をかける導入効果、そういったものを総合的に勘案しますと、現時点ではまだ導入については考えていない"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_67;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "酒田市民で生活保護を受給している方々は、高齢、疾病、失業、預貯金の減など、自立したくとも自立が極めて困難"@ja.
<< kg:id_80 prop:cause kg:id_82 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_69;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "高齢、疾病、失業、預貯金の減など、自立したくとも自立が極めて困難"@ja.
<< kg:id_80 prop:cause kg:id_83 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_71;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "雇用情勢の悪化から再就職は極めて困難"@ja.
<< kg:id_80 prop:cause kg:id_84 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "高齢、疾病、失業、預貯金の減など"@ja.
<< kg:id_85 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_74;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "就労支援員とハローワークが連携し、職業訓練受講のほかに就労支援セミナーへの参加を進めたり、求人情報の提供、各種資格取得を助言するなどの支援活動"@ja.
<< kg:id_87 prop:cause kg:id_88 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "医療扶助受給世帯の割合は、高齢者世帯、障害者世帯を中心に全体の87.1％"@ja.
<< kg:id_89 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "医療費適正化対策としてレセプト点検及び嘱託医による審査を行っております"@ja.
<< kg:id_91 prop:effect kg:id_92 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_78;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "過剰診療、過剰投薬などの事例は見られませんが、重複受診、頻回受診の事例が年間約10件程度はあります"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "重複受診等の理由は受給者の理解不足によるところが大きい"@ja.
<< kg:id_93 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "発見次第、適正な受診を指導しております"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "担い手の高齢化、減少"@ja.
<< kg:id_98 prop:cause kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "米主体の経営からなかなか脱皮できないというような人が多く、これが農業所得の向上に結びつかない"@ja.
<< kg:id_100 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "中心となる経営体の育成とその経営体への農地集積"@ja.
<< kg:id_100 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "地域に出かけてきめ細かな説明会を行い、丁寧に話し合いをしながら"@ja.
<< kg:id_100 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "地域での検討会、話し合いなどの場に積極的に参画し"@ja.
<< kg:id_100 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "検討会などのメンバーのおおむね３割以上は女性で構成する必要があることから、女性農業委員については積極的に参画する"@ja.
<< kg:id_105 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "新しく平成24年度からは、新たに水質土壌生物多様性の地域環境の保全を行うもので、専門家の指導など高度な技術が求められる活動が追加される"@ja.
<< kg:id_105 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_92;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "報告書類の軽減、事務の簡素化が図られる"@ja.
<< kg:id_108 prop:effect kg:id_109 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_94;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "なかなか本市の積雪、昨年、ことしというふうにとても雪が多かったわけで、そういう面でこの期間は除かれるということで、実施しにくい面があった"@ja.
<< kg:id_108 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_96;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "地域特認取組の早期新設及び承認に向けて、県に早くしていただきたいというふうな働きをかけながら"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_98;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "法人化によるメリット、デメリットというものを徹底的にやはり話し合う必要がある"@ja.
<< kg:id_113 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "その集落営農組織のリーダーの研修会、話し合いの場などを積極的に開催することによって、この５年間のうちに可能な限り多くの組織を法人化"@ja.
<< kg:id_113 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_101;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "今後の５年間の中では営農指導、経営指導についても、もっと充実していければ"@ja.
<< kg:id_116 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_103;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "新年度、酒田アグリビジネス推進ネットワークということを立ち上げて、農商工連携をさらに進め、製品化に一つでも結びつけていきたい"@ja.
<< kg:id_116 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "その拠点としては中町マルシェということで、販売的なものの一つ拠点としても位置づけられる"@ja.
<< kg:id_116 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "６次産業化で成功したというような例をもっともっと積極的にＰＲをする"@ja.
<< kg:id_120 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_107;
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "フォーラムなどさまざまなイベントを開催すること、市報、パネル展示、ホームページ、ＦＭ、それから「ウィズレター」という専門の広報紙、こういうことでＰＲ"@ja.
<< kg:id_120 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "防災の観点からも福祉の観点からも健康づくりの観点からも、それぞれの分野で女性の果たす役割、もしくは男女ともどもそれぞれの役割を果たしながら頑張るということが大変大事"@ja.
<< kg:id_123 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_110;
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "できるだけ女性委員の推薦に配慮をといったようなお願いをしている"@ja.
<< kg:id_123 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "公募する際におきましても、女性の参画率の向上に向けて取り組んでまいる"@ja.
<< kg:id_126 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_113;
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "今後は女性管理職の登用というものが一定程度ふえるのではないか"@ja.
<< kg:id_128 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_115;
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "特に課税額の低い世帯の部分をさらに細分化し、低所得世帯の負担が軽減となるようにしている"@ja.
<< kg:id_130 prop:cause kg:id_131 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_117;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "やはり早期退職などもあり日々雇用職員だけのクラスも出てきております"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_119;
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "園長、主任保育士がクラスの対応に当たるなど、園としての保育の一貫性を確保しております"@ja.
<< kg:id_134 prop:effect kg:id_135 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_121;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "ひとりで息絶えていたというようなことになりかねない不安があります"@ja.
<< kg:id_136 prop:cause kg:id_137 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_123;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "民生委員さんからみずからの管轄するといいますか、担当する地域の例えば指導、見守りなどが必要な皆さんの情報が十分ない"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_125;
    prop:text-txt_contents "民生委員は守秘義務がございますので、担当される地域の住民票の閲覧ということもできるような形にする"@ja.
<< kg:id_138 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "生活保護世帯などの情報についても個別に提供をさせていただき、見守り方法もお願いしている"@ja.
<< kg:id_138 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_127;
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "災害時要援護者台帳の整備、そしてまた重度の障害をお持ちの方については、障害福祉サービス提供事業所との連携などによって、これらの台帳登録への呼びかけということをさらに強化をし、その情報を民生委員さんと共有をする"@ja.
<< kg:id_142 prop:effect kg:id_143 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_129;
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_130;
    prop:text-txt_contents "平成24年１月の有効求人倍率でございます。これは0.75となっております。対前年比で0.23ポイントの増加"@ja.
<< kg:id_144 prop:effect kg:id_145 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "経済情勢は依然として厳しい状況が続いている"@ja.
<< kg:id_146 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_132;
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "各種支援制度を活用しながら、引き続き関係機関と連携を強化し、一層の雇用情勢の改善について努めてまいりたい"@ja.
}
