kg:id_92 rdf:type cls:c_1434.
cls:c_1434 rdfs:label "結婚支援"@ja.
kg:id_91 prop:contermeasure kg:id_92.
kg:id_93 rdfs:label "不妊治療費助成に係る事業費を増額する"@ja.
kg:id_93 rdf:type cls:c_6128.
cls:c_6128 rdfs:label "治療費助成"@ja.
kg:id_91 prop:contermeasure kg:id_93.
kg:st_1 rdfs:label "斎藤周議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "基金への即時積み増しより市民の苦難軽減に税金を使うべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "補正で生じた財源の大半を基金に積み増しするやり方に反対"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "本間正巳市長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_3 prop:content "最重要課題は人口減少と少子高齢化対策"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "若者の定住促進と地域活性化に大きな意味がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "雇用の場の確保は地域存続の生命線である"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "雇用の場の確保はまちのにぎわい創出と地域存続の生命線"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "雇用確保は地域が存続していく上で生命線"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "雇用の場の確保は地域存続の生命線"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "地元企業が継続して雇用できる環境整備も進めるべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "息の長い働きかけが重要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "米だけに頼らず足腰の強い酒田農業に変える必要がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "農業に元気がなければまちににぎわいが生まれない"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "生産したものをただ売るだけでなく付加価値をつける必要がある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "付加価値をつける取り組みが必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "観光と結びつけた取り組みを積極的に進める必要がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "この状況を確実に解消していく必要がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "市民と一丸となって関係機関に強く働きかける必要がある"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "高速交通網整備は大きなポイント"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "総人口目標達成の根幹は雇用の場の確保と産業振興"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "東日本大震災の教訓を防災減災体制に生かす"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "避難場所へ円滑な避難ができるようにする"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "避難所として重要な役割を果たす学校施設の機能を強化する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "防災拠点にぎわい拠点市民活動の拠点となる新庁舎を整備する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "市民にできる限り不便をかけないよう対応する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "売電利益の市民還元を目指す"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "再生可能エネルギーの活用を積極的に進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "利活用再生等を含めた総合対策を実施する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "利活用再生等を含めた総合対策を進める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "安心して子供を産み育てる環境を充実させる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "子育て世代の負担軽減を進める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "独身男女に出会いの機会を提供する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "不妊治療希望者の増加に対応して事業拡充を図る"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "昨年末から１月下旬までの降雪の状況を受け、今後の除雪経費に不足が生じるおそれがあるため当該経費を増額することについて専決処分した"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:text-txt_contents "今後の除雪経費に不足が生じるおそれがあるため当該経費を増額することについて専決処分した"@ja.
<< kg:id_4 prop:contermeasure kg:id_5 >>
    prop:text-txt_contents "企業誘致の促進と既存企業の育成を図るため、用地取得助成金の適用期限を延長することについて所要の改正を行う"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:text-txt_contents "工場立地法に基づく特定工場の緑地・環境施設の面積の敷地面積に対する割合について、国の基準の範囲内において地域準則を定める条例を新たに制定する"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:text-txt_contents "京田西工業団地への企業立地に伴う市道路線の再編を行うため"@ja.
<< kg:id_8 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "京田西工業団地への企業立地に伴う市道路線の再編を行うため市道路線を廃止及び認定するとともに、民間開発により整備された道路等を新たに市道として認定する"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:text-txt_contents "設計内容の変更等により協定金額を減額するため"@ja.
<< kg:id_11 prop:contermeasure kg:id_13 >>
    prop:text-txt_contents "設計内容の変更等により協定金額を減額するため議会の議決を求める"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "災害弔慰金の支給等に関する法律の一部改正に伴い"@ja.
<< kg:id_14 prop:contermeasure kg:id_16 >>
    prop:text-txt_contents "支給対象となる遺族の範囲を整理するため所要の改正を行う"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:text-txt_contents "財務部を総務部に統合し企画振興部を新設するなど、市の行政組織の変更に伴い所要の改正を行う"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:text-txt_contents "地方自治法の一部改正に伴い"@ja.
<< kg:id_19 prop:contermeasure kg:id_21 >>
    prop:text-txt_contents "本会議において、公聴会に参加した者及び出頭した参考人についても本条例の適用対象とするなど、所要の改正を行う"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:text-txt_contents "企業立地の促進等による地域における産業集積の形成及び活性化に関する法律に基づく基本計画の更新に伴い"@ja.
<< kg:id_22 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "固定資産税の課税免除の適用期限を延長するため所要の改正を行う"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:text-txt_contents "甲子園出場基金を廃止するため所要の改正を行う"@ja.
<< kg:id_27 prop:contermeasure kg:id_28 >>
    prop:text-txt_contents "飛島辺地に係る公共的施設の総合整備計画に新規事業を追加するため"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本案は10億841万9,000円増額し、予算総額を502億6,669万8,000円とするものである"@ja.
<< kg:id_29 prop:cause kg:id_31 >>
    prop:text-txt_contents "今回の補正は、国の経済危機対応・地域活性化予備費等の活用に伴う事業の前倒し"@ja.
<< kg:id_29 prop:cause kg:id_32 >>
    prop:text-txt_contents "決算見込みによる事業費の減額や歳入の増額等で生じた財源"@ja.
<< kg:id_29 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "生じた財源を財政調整基金、市債管理基金にそれぞれ積み立て、後年度の財源不足に備えようとする基金積立金の増額"@ja.
<< kg:id_29 prop:contermeasure kg:id_34 >>
    prop:text-txt_contents "市債の繰上償還を実施するための公債費元金の増額"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:text-txt_contents "医療扶助費の増による生活保護扶助事業費の増額"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:text-txt_contents "保安林解除手続に時間を要していることから酒田斎場改築事業費の減額"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:text-txt_contents "路線バスの運行を維持するため生活交通バス路線維持費補助事業費の増額"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:text-txt_contents "国の経済危機対応・地域活性化予備費などの活用による富士見小学校改修事業費等の増額"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:text-txt_contents "収入において、入院、外来収益の減などにより総額を７億2,014万円"@ja.
<< kg:id_43 prop:cause kg:id_45 >>
    prop:text-txt_contents "支出において、給与費、材料費などの決算見込みにより総額を６億7,886万4,000円と補正する"@ja.
<< kg:id_43 prop:cause kg:id_46 >>
    prop:text-txt_contents "資本的収入及び支出の収入において、企業債、補助金の減額により総額を9,819万9,000円"@ja.
<< kg:id_43 prop:cause kg:id_47 >>
    prop:text-txt_contents "支出において、建設改良費の減額により総額を9,901万4,000円と補正する"@ja.
<< kg:id_48 prop:effect kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本市の最重要課題は、人口減少、少子高齢化対策です。平成29年度の総人口目標を11万人としています"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "世界14カ国に拠点を持つグローバル企業が京田西工業団地へ立地することになり、500人規模の雇用が生み出される"@ja.
<< kg:id_50 prop:effect kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "若者の定住促進にとどまらず、今後の地域活性化に大きな意味を持つところであります"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "企業が立地すれば雇用の場が生まれます"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "雇用の場の確保は、まちのにぎわいを創出するだけでなく"@ja.
<< kg:id_55 prop:effect kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "地域が一定の民力を持ちつつ存続していく上で生命線とも言えます"@ja.
<< kg:id_53 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "他県の企業にさまざまな地元の技術を紹介する商談会の開催"@ja.
<< kg:id_53 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "トップセールスを行う"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "米だけに頼らず、園芸作物である野菜、果物、花卉などや畜産を組み合わせた複合経営"@ja.
<< kg:id_60 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "さらには耕畜連携などにより農業所得の向上につなげ、足腰の強い酒田農業に変えていかなければなりません"@ja.
<< kg:id_63 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "付加価値をつけるために６次産業化や農商工連携、観光と結びつけたグリーンツーリズム等を積極的に推進していく必要があります"@ja.
<< kg:id_63 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "６次産業化や農商工連携"@ja.
<< kg:id_63 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "観光と結びつけたグリーンツーリズム等を積極的に推進していく必要があります"@ja.
<< kg:id_67 prop:effect kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "残念ながら高速交通網は未整備区間があり、特に高速鉄道網は大きく取り残された状況になっています"@ja.
<< kg:id_67 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "山形新幹線の庄内延伸、日本海沿岸東北自動車道と新庄酒田道路の着実な進捗を市民と一丸となって関係機関に対し強く働きかけていく必要があります"@ja.
<< kg:id_67 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "日本海沿岸東北自動車道と新庄酒田道路の着実な進捗を市民と一丸となって関係機関に対し強く働きかけていく必要があります"@ja.
<< kg:id_48 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "この目標を達成するための根幹となるのが雇用の場の確保と産業振興であります"@ja.
<< kg:id_72 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "津波対策強化として、津波避難ビル表示、標高表示の設置範囲を拡大する"@ja.
<< kg:id_72 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "避難場所へ円滑な避難ができるよう避難誘導看板を新たに設置してまいります"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "学校施設について、食料、水、ミルクのほか生活必需品を備蓄することとし、避難所機能を強化してまいります"@ja.
<< kg:id_77 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "防災拠点、にぎわい拠点、市民活動の拠点となる新庁舎建設については、平成26年12月の１期工事完了、平成28年７月の完成に向け、工事に着手してまいります"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:text-txt_contents "工事期間中の駐車場不足で市民の皆様にできる限り不便をかけないよう"@ja.
<< kg:id_79 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "工事着工前に東側駐車場の整備を完了します"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "風力発電については、固定価格買取制度による売電利益の市民還元を目指して、山形県と協調しながら自治体直営で取り組むこととし、環境影響評価調査等に着手してまいります"@ja.
<< kg:id_82 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "太陽光発電については、住宅用太陽光発電システム設置への支援を継続する"@ja.
<< kg:id_85 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "新たに見守り組織モデル事業の実施や"@ja.
<< kg:id_85 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
