kg:st_1 rdfs:label "富樫幸宏議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "人口減少の大きな要因は働く場の不足だとみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "若者が地元就職できないことが人口減少につながっているとみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "不景気による社会減が人口減少の大きな要因だと指摘"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "人口目標に対して既に後がない深刻な状況だと懸念"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "対策がなければ人口減少は一層進むとみる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "人口減少対策には雇用確保が必要とする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "本間正巳市長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_7 prop:content "人口減少対策の根幹は雇用の場の確保と産業振興だとする"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "人口減少対策には産業振興が必要とする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "人口減少と少子高齢化対策のために産業振興が必要とする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "雇用確保と産業振興を加速するには社会資本整備が急務と主張"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "高速道路整備の遅れは地域競争力を弱めるとみる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "日東道の早期整備が酒田に必要と主張"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "行政と民間が一体となって要望活動を進める考え"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "新庄酒田道路の早期整備が必要と主張"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "横軸の道路網についても早くできるよう要望活動に努める考え"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "早期完成には官民挙げた継続的要望活動が必要と主張"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "要望活動について先頭に立って頑張る考え"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "被災港の復旧により酒田港の取り扱い貨物量が減少傾向にあると指摘"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "震災で酒田港は代替港として活用されたと評価"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "震災後の代替港需要で酒田港の貨物量が最大化したと指摘"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "一時的な需要で終わらせず恒常的な貨物量拡大が必要と主張"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "県と協力して酒田港振興に取り組むべきと主張"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "港湾振興には関連企業の育成が必要と主張"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "リサイクル産業の工場誘致に頑張る考え"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "港湾関連企業の誘致が必要と主張"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "リサイクル関連企業の立地促進に取り組む考え"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "港湾関連企業の育成誘致で男性型雇用の拡大が図れるとみる"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "港湾関連企業の育成誘致は港湾振興につながるとみる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "港湾関連企業の育成誘致は人口減少対策にもつながるとみる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "庄内に多数の風車建設を見込む県戦略は現実味に乏しいと懸念"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "酒田市は風力発電の適地としてできる範囲で県戦略の実現に協力する考え"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "固定価格買取制度が有利なうちに事業化を進めたい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "風車大量建設より共同火力のリニューアルのほうが現実的と主張"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "老朽化した共同火力と増設について今後も要望していく考え"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "酒田でも国策としてのガス供給を検討してはどうかと提起"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "新エネルギーとしてのガス供給事業の今後の動向を注目したい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "地域全体で取り組むため推進母体の再構築が必要とする"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "庄内延伸は課題整理と推進策検討を進めながら段階的に取り組む考え"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "市民の機運を高めながら段階的に進める考え"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "酒田で子どもを産みたいが産む場所が少ない現状を問題視"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "出産環境の不足により市外出産が生じていると指摘"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "次は一気に中学3年まで無料にすべきと主張"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "中学3年までの無料化の早期実現に向けて一歩踏み出したと説明"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "現状の祭りには満足感や刺激が不足していると感じる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "参加者が楽しめない祭りは見る側も面白くないと指摘"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "酒田の祭りを一度見ないと損だと思える祭りを創造すべきと提案"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "関係者と話しながら変革できるものは変革したい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "祭りやイベントは絞り込みや統合も必要と提起"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "開催方法について勉強したいとする"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "TPPは農業に限らず幅広い分野に影響するため慎重判断が必要と指摘"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "参加前に打撃を受ける産業の将来像と政策を示すべきと主張"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "これまでと同様に反対のスタンスで慎重対応を求める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "農業振興はいかに農業所得を上げるかであり6次産業化が必要とする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "6次産業化と農商工連携で高付加価値化と所得向上を目指す"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "農業所得向上のため規模拡大が必要とする"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "認定農業者を支援し規模拡大を進める考え"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "農業所得向上のため複合経営が必要とする"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "米プラスアルファとして園芸作物を含めた複合経営を推進する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "原発事故を受けて再生可能エネルギーへの転換が進められていると理解"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "酒田市は風力発電の適地として県戦略に貢献できるとする"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "市直営の風力発電で市民への利益還元を最大化したい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "大型事業と合併特例債活用で後年度負担が増すことを危惧"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "将来の公債費負担増で市政運営の自由度が下がると危惧"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:op_64 prop:content "経費削減のため新行財政集中改革プランを着実に実施する考え"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "施設維持管理費の削減で財政負担を抑える考え"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "遊休資産処分で歳入確保を図る考え"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "合併特例債は全額使い切らず市民が切望する事業を見極めるべきと主張"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "真に必要な社会資本であれば合併特例債を使うべきとする"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "地方経済は中央の景気好転がすぐには波及しないとみる"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_1.
kg:op_70 prop:content "地方経済は中央の景気回復より遅れて反応すると指摘"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_1.
kg:op_71 prop:content "景気回復期待を現実化する努力が必要と主張"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "働く場がなく、酒田に就職したくてもできないでいる若者や、不景気で家族ぐるみで都会に出るという社会減の要因が大きいと思っております。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "働く場がなく、酒田に就職したくてもできないでいる若者や、不景気で家族ぐるみで都会に出るという社会減の要因が大きいと思っております。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "働く場がなく、酒田に就職したくてもできないでいる若者や、不景気で家族ぐるみで都会に出るという社会減の要因が大きいと思っております。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "酒田市総合計画の後期計画の最終年度の平成29年度の人口目標が11万人であるとすれば既に後がなく、せっぱ詰まった状況にあると言わざるを得ません。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "何も対策を講じなければさらに人口減が進むことは明白であり"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "そのための雇用の場の確保と産業振興に取り組む姿勢は考えを同じくするところであります。"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "そのための雇用の場の確保と産業振興に取り組む姿勢は考えを同じくするところであります。"@ja.
<< kg:id_9 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "この雇用確保と産業振興を加速するために、最も酒田に必要なことは、まず社会資本をしっかりと整備して、他地域との競争に打ち勝つための土俵をしっかりとつくり上げることが急務だというふうに思っております。"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "他地域との競争に打ち勝つための土俵をしっかりとつくり上げることが急務"@ja.
<< kg:id_11 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "その１つは、高速道路の早期整備だと思いますけれども、日本海沿岸東北自動車道と新庄酒田道路の早期整備が望まれるところであります。"@ja.
<< kg:id_11 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "その１つは、高速道路の早期整備だと思いますけれども、日本海沿岸東北自動車道と新庄酒田道路の早期整備が望まれるところであります。"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "さらなる早期完成のために官民挙げて、今後も波状的な要望活動が今こそ必要なときと思います"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "平成24年は被災港の復旧に合わせて取り扱い貨物量も減少傾向であります"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "平成23年３月に発生した東日本大震災によって被災した太平洋側の港湾の代替港としては一定の活用が図られ"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "取り扱い貨物量も過去最大を記録いたしました"@ja.
<< kg:id_17 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "この機をチャンスと捉えて恒常的な貨物量拡大を図らなければなりません。"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "酒田市として県と協力しながら取り扱い貨物量の拡大を含む酒田港振興にどのように取り組んでいくのか"@ja.
<< kg:id_23 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "港湾振興の観点から港湾関連の企業育成、企業誘致に積極的に取り組むべきではないか"@ja.
<< kg:id_23 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "港湾振興の観点から港湾関連の企業育成、企業誘致に積極的に取り組むべきではないか"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "港湾関連企業の積極的な育成、誘致によって、男性型企業の雇用拡大も同時に図っていく発想が必要ではないか"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "それが港湾振興にもつながり"@ja.
<< kg:id_27 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "人口減に歯どめをかける施策にもつながるのではないか"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "庄内地域では120から160基の風車が主に海岸沿いの風の強い地域に建設できるのではないかという戦略になっております。"@ja.
<< kg:id_31 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "市としては、この風力発電の適地として、できる範囲で県のエネルギー戦略の実現に力を貸していきたい"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "この固定価格買取制度が有利に働くうちに、事業化が図られるように進めていきたい"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "その発電所の拡張を含めたリニューアルを県とともにお願いすることこそ、酒田市にとって最も必要な行動ではないか"@ja.
<< kg:id_38 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "本市としても新エネルギーとしてのガス供給事業について今後どうなるのか、動向を注目していきたい"@ja.
<< kg:id_40 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "地域全体の取り組みを行っていくためには、まず推進母体の再構築を図って"@ja.
<< kg:id_40 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "関係者による課題の整理推進策の検討を行って"@ja.
<< kg:id_40 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "市民の機運の醸成など、段階的に取り組んでいかなければいけない"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "酒田には日本海病院と民間の診療所１軒しかないとのことで"@ja.
<< kg:id_44 prop:effect kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "酒田市在住の妊婦の３割は鶴岡で出産するという現実があるそうであります。"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "次は一気に中学３年まで無料にしてはいかがかと思いますけれども"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "どうもいま一つすとんと落ちないといいますか、満足感、達成感、刺激感というものが足りないと感じております。"@ja.
<< kg:id_49 prop:effect kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "祭りというものは参加している者がおもしろくなければ見ているものもおもしろくないものであると思います。"@ja.
<< kg:id_49 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "酒田の祭りを一度見ないと損だというようなわくわくする祭りを創造してみてはいかがか"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "農林水産まつりとの同時開催にするなど、祭りイベントの絞り込みも必要ではないか"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "ＴＰＰは、農業だけの問題ではなく、自動車、医療、介護、保険など幅広い分野に影響するもので"@ja.
<< kg:id_55 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "ＴＰＰへの参加の前提は、参加することによって打撃を受けるであろう産業分野の将来への道筋を示し、しっかりと政策展開してからではないか"@ja.
<< kg:id_55 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "広く国民的な議論を重ね、我が国農業への十分な配慮の上で慎重な対応を行うこと"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "そのための６次産業化であり"@ja.
<< kg:id_59 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "そのための６次産業化であり、規模拡大であり"@ja.
<< kg:id_59 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "そのための６次産業化であり、規模拡大であり、複合経営であります。"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "東日本大震災による福島第一原発の事故を受けて、再生可能エネルギーへの転換を図って"@ja.
<< kg:id_34 prop:cause kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "市としては、この風力発電の適地として"@ja.
<< kg:id_34 prop:effect kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "私どもは直営で風力発電を行うということで、市民への利益還元も最大となるよう"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "大型事業や合併特例債を活用した事業を導入したことにより、歳入で市債が対前年度比で22.8％、歳出で投資的経費が対前年度比で75.7％の大幅な増加"@ja.
<< kg:id_67 prop:effect kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "後年度において公債費の負担が大きくなり、自由に身動きができなくなるのではないかという危惧"@ja.
<< kg:id_67 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "新行財政集中改革プランの着実な実施によって経費を削減し"@ja.
<< kg:id_67 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "アセットマネジメントを導入して施設の維持管理費のスリム化"@ja.
<< kg:id_67 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "遊休資産をお金にかえることができないか、そうしたものによって歳入を確保していく"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "本当に市民が切望する事業なのかを見きわめながら事業選択すべきではないか"@ja.
<< kg:id_75 prop:effect kg:id_76 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "地方経済に目を移せば、数字の好転とは裏腹に、すぐによくなる要素は少ないように思います。"@ja.
<< kg:id_75 prop:cause kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "中央での景気好転からはやや時間を置いて波及するものだと思っております。"@ja.
<< kg:id_75 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "株高、円安を含め、数字の好転を励みに、期待を現実のものにするために踏んばらなければならない"@ja.
}
