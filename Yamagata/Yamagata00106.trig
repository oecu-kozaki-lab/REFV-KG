cls:c_6270 rdfs:label "緊急避難"@ja.
kg:id_81 prop:contermeasure kg:id_87.
kg:id_88 rdfs:label "スクールカウンセラーや教育相談員と連携し加害児童生徒のケアを行うこと"@ja.
kg:id_88 rdf:type cls:c_6271.
cls:c_6271 rdfs:label "加害者支援"@ja.
kg:id_81 prop:contermeasure kg:id_88.
kg:id_89 rdfs:label "TPP交渉参加"@ja.
kg:id_89 rdf:type cls:c_6272.
cls:c_6272 rdfs:label "通商協定"@ja.
kg:id_90 rdfs:label "農林水産業や投資や医療や労働や政府調達など幅広い分野に大きな影響を及ぼす懸念"@ja.
kg:id_90 rdf:type cls:c_6160.
cls:c_6160 rdfs:label "広範影響"@ja.
kg:id_89 prop:effect kg:id_90.
kg:id_91 rdfs:label "十分な情報提供がなされず国民的議論もなされていないこと"@ja.
kg:id_91 rdf:type cls:c_155.
cls:c_155 rdfs:label "情報不足"@ja.
kg:id_89 prop:cause kg:id_91.
kg:id_92 rdfs:label "国等へ慎重な対応を要望すること"@ja.
kg:id_92 rdf:type cls:c_6273.
cls:c_6273 rdfs:label "慎重要望"@ja.
kg:id_89 prop:contermeasure kg:id_92.
kg:id_93 rdfs:label "学校施設の安全性"@ja.
kg:id_93 rdf:type cls:c_6274.
cls:c_6274 rdfs:label "学校安全"@ja.
kg:id_94 rdfs:label "国の補正予算を活用して耐震や老朽改修等を可能な限り前倒しすること"@ja.
kg:id_94 rdf:type cls:c_865.
cls:c_865 rdfs:label "施設改修"@ja.
kg:id_93 prop:contermeasure kg:id_94.
kg:id_95 rdfs:label "強化ガラス採用サッシ改修や壁のクラック改修や照明器具改修やテレビラック撤去を行うこと"@ja.
kg:id_95 rdf:type cls:c_6275.
cls:c_6275 rdfs:label "非構造部材対策"@ja.
kg:id_93 prop:contermeasure kg:id_95.
kg:id_96 rdfs:label "図書館書架の転倒防止や書棚の飛び出し防止やピアノ固定化を行うこと"@ja.
kg:id_96 rdf:type cls:c_6276.
cls:c_6276 rdfs:label "転倒防止"@ja.
kg:id_93 prop:contermeasure kg:id_96.
kg:id_97 rdfs:label "学校施設の老朽化"@ja.
kg:id_97 rdf:type cls:c_6277.
cls:c_6277 rdfs:label "学校老朽化"@ja.
kg:id_98 rdfs:label "建設から25年以上経過した学校が多いこと"@ja.
kg:id_98 rdf:type cls:c_860.
cls:c_860 rdfs:label "施設老朽化"@ja.
kg:id_97 prop:cause kg:id_98.
kg:id_99 rdfs:label "長寿命化改良事業の内容を検討し活用していくこと"@ja.
kg:id_99 rdf:type cls:c_6278.
cls:c_6278 rdfs:label "長寿命化"@ja.
kg:id_97 prop:contermeasure kg:id_99.
kg:id_100 rdfs:label "公文書管理上の課題"@ja.
kg:id_100 rdf:type cls:c_6279.
cls:c_6279 rdfs:label "文書管理課題"@ja.
kg:id_101 rdfs:label "保存年限が違う文書や参考資料が一つの簿冊に混在していること"@ja.
kg:id_101 rdf:type cls:c_6280.
cls:c_6280 rdfs:label "文書混在"@ja.
kg:id_100 prop:cause kg:id_101.
kg:id_102 rdfs:label "公文書管理"@ja.
kg:id_102 rdf:type cls:c_2590.
cls:c_2590 rdfs:label "文書管理"@ja.
kg:id_103 rdfs:label "ファイリングシステム導入検討の中で文書管理規定見直しを考えること"@ja.
kg:id_103 rdf:type cls:c_6281.
cls:c_6281 rdfs:label "管理見直し"@ja.
kg:id_102 prop:contermeasure kg:id_103.
kg:id_104 rdfs:label "電子媒体での保存を今後の課題として検討すること"@ja.
kg:id_104 rdf:type cls:c_6282.
cls:c_6282 rdfs:label "電子保存"@ja.
kg:id_102 prop:contermeasure kg:id_104.
kg:id_105 rdfs:label "公文書管理条例制定は十分な検証を行いながら判断すること"@ja.
kg:id_105 rdf:type cls:c_6283.
cls:c_6283 rdfs:label "条例制定検討"@ja.
kg:id_102 prop:contermeasure kg:id_105.
kg:st_1 rdfs:label "市原栄子議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "市民が望む協働とのギャップがあった"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "市民が施策に関心を持てず行政参加が進んでいない"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "広報やホームページなどがあっても市民には伝わり切っていない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "本間正巳市長"@ja.
kg:st_2 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_4 prop:content "旧3町では町長段階で判断していたため合併後は物理的に遠くなった"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "行政への理解が深まらなければ一体感が弱まる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "市民との情報共有を進めるため導入する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "地域の課題を気軽に話し合える場にしたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "より多くの市民から意見を得る工夫が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "必要に応じて計画段階から市民参加を進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "中国由来の大気汚染への不安が広がっている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "春先は飛来が増える可能性がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "子供を外で遊ばせてよいか不安が広がっている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "暫定指針は超えていなくても基準超過だけで不安が強い"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_3 rdfs:label "杉原久市民部長"@ja.
kg:st_3 rdfs:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_14 prop:content "市のホームページからも測定結果を確認できるようにしている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "注意喚起情報は市から関係機関へ伝達する予定"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "利用料が重く継続利用をためらう声がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "二重の費用負担が利用の足かせになっている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "何日も利用すると家計負担が重くなる"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "利用料が理由で利用に踏み切れない"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:st_4 rdfs:label "久松勝郎健康福祉部長"@ja.
kg:st_4 rdfs:type cls:st_18.
kg:op_20 prop:content "利用方法や対象をわかりやすく周知していく"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "利用条件を明確にして不安を減らしたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:st_5 rdfs:label "若い女性"@ja.
kg:st_5 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_22 prop:content "小さい子供がいるため健診に行けない"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "託児サービスが十分知られていない"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "付き添いの家族自身が健診を受けられない"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "受診機会を逃してしまう人がいる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "小さな子どもがいても安心して健診を受けられるようにしている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "付き添いが必要な人にも対応できるようにしている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "託児サービス同様に周知したい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "冬季の転倒骨折が高齢者の生活を急に困難にする"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "急病で日常生活に支障が生じる高齢者が出ている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "それまで自立していた高齢者が急に生活困難になる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "早急な支援が必要な場合は迅速対応したい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "急病やけがへの対応は家族支援を基本に必要時は有償サービスを使う"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:st_6 rdfs:label "介護者"@ja.
kg:st_6 rdfs:type cls:st_78.
cls:st_78 rdfs:label "介護者"@ja.
kg:op_34 prop:content "以前のように介護保険サービスにも使えるよう戻してほしい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:st_7 rdfs:label "介護する家族"@ja.
kg:st_7 rdfs:type cls:st_79.
cls:st_79 rdfs:label "家族介護者"@ja.
kg:op_35 prop:content "おむつ関連以外の必要物品にも使えるよう求めている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_7.
kg:op_36 prop:content "寝具の汚れが重なると介護者の精神的負担が大きい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "市民要望を受けて対象品目を一部拡大する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:st_8 rdfs:label "地元自治会"@ja.
kg:st_8 rdfs:type cls:st_14.
cls:st_14 rdfs:label "地域団体"@ja.
kg:op_38 prop:content "騒音や低周波の調査をしっかり行ってほしい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:op_39 prop:content "地元から鳥類など動物への影響を懸念する声がある"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:st_9 rdfs:label "地元の意見"@ja.
kg:st_9 rdfs:type cls:st_5.
kg:op_40 prop:content "津波浸水域で下がった土地評価がさらに下がることを懸念"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_9.
kg:op_41 prop:content "健康被害が本当にないのか不安がある"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "方法書公表後に広く意見を聞き1年間調査する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "県審議会や地元意見を踏まえて調査項目と回数を増やした"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "不安や懸念を解消するため継続的に説明する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:st_10 rdfs:label "太田豊総務部長兼総務課長"@ja.
kg:st_10 rdfs:type cls:st_18.
kg:op_45 prop:content "計画どおり進めば一定の利益還元が可能"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_10.
kg:op_46 prop:content "地元技術が組み入れられる可能性を高めたい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_10.
kg:op_47 prop:content "災害時に有効であり可能な取り組みを勉強したい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "国の中長期方針が見えず短期5年計画とせざるを得なかった"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_10.
kg:op_49 prop:content "最終的な策定は新年度にならざるを得ない"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "より多くの意見を得ながら新年度に策定したい"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "短期計画に加えて中長期計画の見直しが必要"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_10.
kg:st_11 rdfs:label "斎藤周議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_52 prop:content "いじめは命に関わる重大問題である"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_11.
kg:op_53 prop:content "いじめの傷はその後の人生を変えてしまう"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_11.
kg:st_12 rdfs:label "石川翼久教育長"@ja.
kg:st_12 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_54 prop:content "いじめへの予見も含め安全配慮義務を一層深める必要がある"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_12.
kg:op_55 prop:content "教職員間で情報共有し早期把握に努めている"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_12.
kg:op_56 prop:content "被害者保護を第一義とし保護者とも連携している"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_12.
kg:op_57 prop:content "無記名アンケートは早期発見と抑止に一定の有効性がある"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_12.
kg:op_58 prop:content "友情や信頼関係づくりに大きく寄与する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_12.
kg:op_59 prop:content "被害児童生徒を全力で守る方法の一つとして必要"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_12.
kg:op_60 prop:content "相手の痛みに気づかせ自分を見つめ直させる支援が必要"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_12.
kg:op_61 prop:content "基幹産業だけでなく国民生活全般への影響が懸念される"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "基本方針なしに参加決定することは受け入れられない"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "我が国農業への十分な配慮の上で慎重対応を求めてきた"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:st_13 rdfs:label "兵藤芳勝教育部長"@ja.
kg:st_13 rdfs:type cls:st_18.
kg:op_64 prop:content "平成25年度以降の事業を前倒しして進めたい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_13.
kg:op_65 prop:content "非構造部材の危険箇所改善を進めている"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_13.
kg:op_66 prop:content "全校で安全対策を進めている"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_13.
kg:op_67 prop:content "37校中24校が建設後25年以上経過している"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_13.
kg:op_68 prop:content "制度詳細が示され次第活用を検討する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_13.
kg:op_69 prop:content "現在の簿冊管理には見直しが必要な課題がある"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_10.
kg:op_70 prop:content "現行管理の課題を見直し必要に応じて規定改正したい"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_10.
kg:op_71 prop:content "災害対応や保存スペース縮小や検索性向上のため必要"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_10.
kg:op_72 prop:content "ファイリングシステムや歴史的公文書の扱いを検証して判断したい"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_10.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "前市長も対話行政に努める、市民の意見に耳を傾けるとされてきましたが、市民からは、対話というよりも事後報告ではないかといった声があったことも事実であり、市民が望む協働とのギャップがあったと感じております"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "反面、市の施策などに関心を持たない、持てないために、市民からの積極的な行政参加をしていただけない状況もあるのではないでしょうか"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "現在、市の情報や市政運営などについては、広報紙やホームページ、出前講座、出張市役所などの取り組みがなされています。しかし、それでも市民からはよくわからないという声が聞かれます"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "そういう意味では、新しく１市３町になったわけでありますから、そういうことでは、物理的に、間違いなく、今の総合支所から判断をする場所が今の本庁舎に移ったということがあります"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "私は、市民が行政に対し理解を深めていただくという考えがなければ、市民との一体感やつながりが希薄になっていくのではないかと考えます"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "ことしの４月から、新年度からパブリックコメント制度を導入し、市民との情報の共有化を進めていくという考えであります"@ja.
<< kg:id_8 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "今後は移動市役所の名称あるいは進め方をやや変更して、地域の課題に重点を置いて、気軽に話し合える場としていきたいというふうに思っております"@ja.
<< kg:id_8 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "より多くの市民の皆様から意見を出してもらうためには、公表資料を担当の窓口、あるいは行政情報閲覧コーナーに備えるだけでなくて、ホームページあるいは市広報へパブリックコメント情報を掲載し、また総合支所、文化センター、コミュニティセンターなどへも公表資料の備えつけを考えているところであります"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "計画段階からの市民参加、これも総合計画の策定あるいは庁舎改築などで、その内容に応じて市民の皆様から意見を聞く機会を設けておりまして、これからも適切にそうした必要に応じて対応していかなければいけないというふうに思っております"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "マスコミ等で中国のＰＭ2.5による深刻な大気汚染が報じられ"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "これからも春先の季節風による飛来が増える可能性があるとされています"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:text-txt_contents "ＰＭ2.5は粒形が小さいことから肺の奥まで入りやすく、呼吸疾患、循環器疾患及び肺がんの疾患に影響を与えることが懸念されています"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:text-txt_contents "ＰＭ2.5は粒形が小さいことから肺の奥まで入りやすく、呼吸疾患、循環器疾患及び肺がんの疾患に影響を与えることが懸念されています"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:text-txt_contents "ＰＭ2.5は粒形が小さいことから肺の奥まで入りやすく、呼吸疾患、循環器疾患及び肺がんの疾患に影響を与えることが懸念されています"@ja.
<< kg:id_18 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "酒田は大丈夫だろうか、注意喚起はどのように広報されるんだろうか、こういった不安が広がっています"@ja.
<< kg:id_18 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "注意喚起の暫定的な指針である70マイクログラムを超えた日はないとしながらも、短期基準を超える日が出たことは、市民にとっては不安であります"@ja.
<< kg:id_18 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "このＰＭ2.5については県で測定を行っており、その速報値は県のホームページに掲載されております"@ja.
<< kg:id_18 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "市のホームページにリンクさせておりますので、市のホームページからもその情報を得ることができるようになっているところでございます"@ja.
<< kg:id_18 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "市でこういった注意喚起の連絡が参りました場合には、学校ですとか保育所、それから幼稚園、コミュニティ振興会などにも連絡するという予定になっているところでございます"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "病児保育所を利用したいと思っていても、利用料の負担の問題があります"@ja.
<< kg:id_27 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "保育園を休んだとしても月々の保育料は同じ金額を支払わなければなりません。これにもし病児保育を利用した場合、その分の利用料がかかるということで二の足を踏んでいる"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "１日や２日の利用なら何とかできますが、何日ともなれば経済的負担が重くなってしまいます"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "その分の利用料がかかるということで二の足を踏んでいる、こういった声もあります"@ja.
<< kg:id_30 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "事業の周知につきましては、広報やホームページへの掲載、保育所や医療機関等へのチラシの配布、出産された方や転入された方へは子育てハンドブックを配布して周知しております"@ja.
<< kg:id_30 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "周知に際しましては、利用できる病名や病状も例示するなど、わかりやすい内容にしてまいりたいと考えております"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "若い女性からは小さい子供がいるために健診に行けないといった声が多く寄せられています"@ja.
<< kg:id_35 prop:cause kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "しかし、残念ながらそれを理解している方が少なく"@ja.
<< kg:id_35 prop:cause kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "親のつき添いが忙しくて自身の健康診断をすることができず、かと言って後日もう一度出かけるということも難しく、健診を結局しないで済んでしまった"@ja.
<< kg:id_35 prop:effect kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "健診を結局しないで済んでしまった、こういった方もおられます"@ja.
<< kg:id_40 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "小さなお子さんがいても安心して健診が受けられるようにしております"@ja.
<< kg:id_40 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "健診会場におきましてスタッフに申し出ていただければ介助を行って健診を受けていただけることになっております"@ja.
<< kg:id_40 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "こちらのほうにつきましては周知を行ってきておりませんでしたので、託児サービス同様に周知をしてまいりたいと考えております"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "凍った雪道で転んで骨折したり"@ja.
<< kg:id_44 prop:cause kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "またインフルエンザなど急な体調不良で日常生活に支障を来たすといった高齢者が出ています"@ja.
<< kg:id_44 prop:effect kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "それまで元気で自立した生活を送っていたのが一転、きょうの食事の支度もできないといったことになります"@ja.
<< kg:id_48 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "対象となる方で早急な支援が必要な場合につきましては、個別に相談を受けながら、時間短縮できるように対応してまいりたいと考えております"@ja.
<< kg:id_48 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "家族の支援が困難な場合につきましては、有償ヘルパーサービスなどの利用をお願いしたいと考えております"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "介護者の願いは、以前のように介護保険のサービスにも使えるように戻してというものです"@ja.
<< kg:id_51 prop:cause kg:id_53 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "こういったものにも利用拡大をしてほしいといった要望が寄せられています"@ja.
<< kg:id_54 prop:effect kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "それが数度重なってくると、本当にもうどうしていいのか、介護する側はパニックになるというか、本当に大変つらいんだそうです"@ja.
<< kg:id_51 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "平成25年度からは、市民の方々の要望も受けまして、特に認知症の方、重度であっても行動的でありますので、紙おむつ専用券でリハビリパンツですとか使い捨て介護シーツ等も認めていく予定でございます"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "地元自治会からも騒音などに対する調査をしっかりやってもらいたいというふうな意見がありました"@ja.
<< kg:id_57 prop:cause kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "また、騒音、低周波音に対する懸念、あるいは鳥類など動物への影響"@ja.
<< kg:id_60 prop:effect kg:id_61 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "地元の意見としては、津波浸水域で土地評価が下がった上に、低周波の風評でさらに価値が下がるのではないか"@ja.
<< kg:id_60 prop:effect kg:id_62 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "健康被害は本当にないのかあるのか"@ja.
<< kg:id_60 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "今後、環境影響評価方法書を作成し、公表し、それについて広く意見を聞いていきます"@ja.
<< kg:id_60 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "その主な増加の要因としては、大気質あるいは工事中の振動調査、風車の影の調査の追加、あるいは動物調査の時期、回数の増加、植物調査の時期の回数の増加、そして景観調査の回数の増加"@ja.
<< kg:id_60 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "今後も市として責任を持って事業を進めるとともに、不安、懸念を解消するため、節目ごとに説明会を行って、疑問や要望をお聞きしながら対応していきたい"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "この事業の収益については、計画どおり進んだ場合、20年間で最大20億円程度の収益が見込まれるというふうに見ているところでございます"@ja.
<< kg:id_68 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "県でも現在、技術研修も開催しているというふうにお聞きしておりますので、今後、県と連携した取り組みについて検討してまいりたい"@ja.
<< kg:id_70 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "本市の太陽光発電設備のある小学校に蓄電池を併設して避難所機能を高めてはとの御提案でございましたけれども、災害時の機能としては有効であると考えますので、防災拠点再生可能エネルギー導入促進事業を初め、どのような取り組みが可能であるか勉強してまいりたい"@ja.
<< kg:id_72 prop:cause kg:id_73 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "国のエネルギー総合的な政策となるべき基本計画がまだ見えない中で、じゃ、酒田市として現実的にどう取り組むのかというふうに考えた場合に、まず５年間の計画という、短期的な計画を策定せざるを得なかった"@ja.
<< kg:id_72 prop:effect kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "今年度中というふうなお話をしてきたことについては、そのとおりにならないということについてはおわび申し上げたいというふうに思います。すなわち、最終的な策定は新年度にならざるを得ないという状況であります"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "今月中に環境審議会の委員の皆様から意見をいただくという、その機会を設けたいというふうに思っております。その後にパブリックコメントの手続を経て、より多くの意見をいただいていく予定でございます"@ja.
<< kg:id_75 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "国の基本計画が定まった段階においては、その計画も見据えながら、また県のエネルギー戦略との整合性も図りながら、やはりより中長期的な計画といったことについても、今後検討していく必要があるだろう"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "ときに子供を死ぬまで追い詰めている事件に発展し"@ja.
<< kg:id_78 prop:effect kg:id_80 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "大人になっても恐怖で社会に出られないなどの後遺症に苦しんでいます"@ja.
<< kg:id_81 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "学校及び教職員に安全配慮義務が課されているというふうに捉えております"@ja.
<< kg:id_81 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "定期的なアンケート調査や生活記録ノートなどによる本人からの訴え、児童・生徒や保護者からの情報収集、また教師間の情報交換などによって実態把握に努め、この情報は教職員間で共有するようにしております"@ja.
<< kg:id_81 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "特に被害を受けた児童・生徒を全力で守るんだということを第一義に、加害の児童・生徒には反省と謝罪を促す指導をしております"@ja.
<< kg:id_81 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "アンケートをとることによりいじめが起きにくくなる歯どめの効果、また早期発見の方策の一つとして一定の有効性があると捉えております"@ja.
<< kg:id_81 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "運動会や文化発表会、遠足、修学旅行、児童会や生徒会の活動などにその狙いや意義を明確にさせて、一人一人が活躍できる場を保証しながら取り組むよう指導に当たっており、その中で友情のとうとさや信頼関係に私は大きく寄与している"@ja.
<< kg:id_81 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "学区外通学を弾力的に扱ったり、緊急避難として一時的に学校を休んだりという措置を講ずることも判断の一つであります"@ja.
<< kg:id_81 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "担任だけでなくて、スクールカウンセラーや教育相談員と連携しながら、自分を見つめ直す機会を与え、相手の心の痛みに気づく、そして命の大切さを育てる、それを根気強く進めていくことが大切である"@ja.
<< kg:id_89 prop:effect kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "本市の基幹産業である農林水産業のみならず、投資、医療、労働、政府調達など、国民生活や経済活動の幅広い分野に大きな影響を及ぼすことが懸念されております"@ja.
<< kg:id_89 prop:cause kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "依然として十分な情報提供がなされておらず、国民的な議論もなされていないわけであります。こうした状況にありまして、基本的な方針なしにＴＰＰ協定への参加を決定することは受け入れることができない"@ja.
<< kg:id_89 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "酒田市ではこれまでも機会あるごとに広く国民的議論を重ね、我が国農業への十分な配慮の上で慎重な対応を行うことを国等へ要望してきた"@ja.
<< kg:id_93 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "平成25年度以降に耐震ですとか老朽改修等が見込まれている事業につきましては、今年度の国の予算、先ごろの国の予算を活用して、可能な限り事業の前倒しに取り組んでいきたいと考えているところでございます"@ja.
<< kg:id_93 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "強化ガラスを採用したサッシの改修、それから内壁、外壁のクラック、それから剥離などの危険があるようなところの改修、それから照明器具の転落のおそれのある機器の改修、それから普通教室などにありますつり下げられたテレビラックなどの撤去などを行っているところでございます"@ja.
<< kg:id_93 prop:contermeasure kg:id_96 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "現在、全校で図書館の書架の転倒防止ですとか、それから書棚から本が飛び出さないような対策、それからピアノの固定化というようなことなども現在取り組んでいるところでございます"@ja.
<< kg:id_97 prop:cause kg:id_98 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "建設から25年以上経過しているものが24校でございます"@ja.
<< kg:id_97 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "文部科学省の長寿命化改良事業の詳細がまだ私どもには示されておりませんので、それらが示された段階で内容を検討させていただいて、活用していきたい"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "保存年限が違う文書や公文書に該当しない参考資料などが混在して一つの簿冊につづられているといったような現状にありまして、少し文書管理においては検討を要するもの"@ja.
<< kg:id_102 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "平成25年度に予定されておりますファイリングシステム導入についての検討の中で、こういった課題についても検討を加えながら、必要に応じて文書管理規定の見直しについても考えていきたい"@ja.
<< kg:id_102 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "災害から公文書を守るということ、あるいは保存スペースの縮小、さらには検索性が向上するといった観点からも、電子媒体での保存も今後の課題として検討していきたい"@ja.
<< kg:id_102 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "公文書管理条例の制定につきましては、今申し上げましたファイリングシステム導入に向けた現行の文書管理規定の見直しの状況、それから公文書管理法で取り扱っております歴史的公文書としての取り扱いの考え方などについて、今後十分な検証を行いながら判断をしていきたい"@ja.
}
