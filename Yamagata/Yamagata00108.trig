<< kg:id_101 prop:contermeasure kg:id_109 >>
    prop:text-txt_contents "例えば、結婚推進支援員の配置、保育所・学童保育所の整備、子育て世代の医療費無料化の拡大、雇用対策としてのプレステージ・インターナショナルの誘致など"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:text-txt_contents "こうした非正規雇用の増加の背景には、高齢化、それから労働法制の改正がある"@ja.
<< kg:id_110 prop:cause kg:id_112 >>
    prop:text-txt_contents "こうした非正規雇用の増加の背景には、高齢化、それから労働法制の改正がある"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:text-txt_contents "景気の急速な悪化の中で非正規雇用者が雇用調整の対象になっている"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "これは先行きの不透明な雇用条件であり、求職意欲も弱まることであり"@ja.
<< kg:id_115 prop:effect kg:id_117 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "仮に入社しても愛社精神や仕事を身につけたいという気持ちも希薄になっている"@ja.
<< kg:id_115 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "企業に対して引き続き正社員として雇用していただくよう要請を行う"@ja.
<< kg:id_115 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "一人でも多くの方を雇用していただくために、地元企業への支援の施策を展開してまいりたい"@ja.
<< kg:id_120 prop:contermeasure kg:id_121 >>
    prop:text-txt_contents "今年度の固定資産税納税通知書に、空き家等に関する意向調査アンケートを同封したところでございます"@ja.
<< kg:id_120 prop:contermeasure kg:id_122 >>
    prop:text-txt_contents "売却や賃貸等を希望される方には、市から所有者等に連絡を取りまして、了解を得た上で宅地建物取引業協会につなぐこととしております"@ja.
<< kg:id_120 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "宅地建物取引業協会、司法書士会、建設業協会、金融協会などと市によるネットワーク協議会を立ち上げまして、官民一体となって空き家等総合対策を検討していく"@ja.
<< kg:id_124 prop:cause kg:id_125 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "真空方式では新規接続者の負担により真空運転システムの調整が必要になるなど、自然流下方式に比較しまして接続費用が高額になっております"@ja.
<< kg:id_124 prop:cause kg:id_126 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "接続工事のため真空装置が停止している間にはバキュームカーの手配も必要になったりしております"@ja.
<< kg:id_124 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "費用負担の軽減が図られますよう、公共汚水ます設置基準の見直しについて検討してまいりたい"@ja.
<< kg:id_128 prop:cause kg:id_129 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "建設費高騰のため工事発注ができない状況が続いていて、建設業者初め、関係者との調整を続けている"@ja.
<< kg:id_128 prop:effect kg:id_130 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "建設費高騰などにより事業が立ち行かない状況になってしまった"@ja.
<< kg:id_128 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "今後の対策をなるべく早くまとめたいというふうに思っていますけれども、いま少し時間が必要"@ja.
<< kg:id_132 prop:cause kg:id_133 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_45;
