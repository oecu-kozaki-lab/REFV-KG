    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "市民団体からは、大型の風力のために低周波や騒音問題、あるいは景観や野鳥に対する影響"@ja.
<< kg:id_132 prop:cause kg:id_136 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "庄内海岸は生物多様性の宝庫ということもあり、３年から４年はかかりますが、法律に基づく評価を求めている"@ja.
<< kg:id_137 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "環境影響評価の項目については、法に定める評価項目と同等の内容で、しっかりと調査を実施し、丁寧な説明を行いながら取り組んでいきたい"@ja.
<< kg:id_137 prop:contermeasure kg:id_139 >>
    prop:text-txt_contents "現在、環境影響評価の具体的手法を定める方法書の概要について、地元に事前に説明会を開催しております"@ja.
<< kg:id_137 prop:contermeasure kg:id_140 >>
    prop:text-txt_contents "今後、方法書を広く公表するとともに"@ja.
<< kg:id_137 prop:contermeasure kg:id_141 >>
    prop:text-txt_contents "市民説明会を開催し、評価項目や手法について意見をいただきながら"@ja.
<< kg:id_137 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "事業について変更が必要であれば、柔軟に検討してまいる考えであります"@ja.
<< kg:id_143 prop:cause kg:id_144 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "その理由として、男性が７勤務日以上の育休を取得した場合、１カ月未満５万円、１カ月以上10万円支給するが、企業側の理解や、とりにくい職場の雰囲気"@ja.
<< kg:id_143 prop:cause kg:id_145 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "その理由として、男性が７勤務日以上の育休を取得した場合、１カ月未満５万円、１カ月以上10万円支給するが、企業側の理解や、とりにくい職場の雰囲気"@ja.
<< kg:id_143 prop:cause kg:id_146 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "休業中の生活保障という観点から見れば、５万円、10万円の１回限りの支給では利用しにくいとの指摘があります"@ja.
<< kg:id_143 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "酒田市としましては、男性の育児休業取得を進めるために、まずは、この事業の周知が重要であろうと考えております"@ja.
<< kg:id_148 prop:effect kg:id_149 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "子育てにはお金がかかる、これは子育てに携わった方であれば誰しもが実感していることであります"@ja.
<< kg:id_148 prop:effect kg:id_150 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "保育園に２人、３人と通わせると、保育園料を払うために給与をもらっているという感覚になるのではないでしょうか"@ja.
<< kg:id_148 prop:contermeasure kg:id_151 >>
    prop:text-txt_contents "同時入所の場合の第２子の保育料は、本市は、通常の保育料の３分の１に軽減しております"@ja.
<< kg:id_148 prop:contermeasure kg:id_152 >>
    prop:text-txt_contents "第３子の保育料軽減につきましては、同時入所の場合、保育料無料としております"@ja.
<< kg:id_153 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "本人の同意を得て、児童手当を現金で支給し、その場で納付相談を行い、支給した児童手当から保育料を納入していただいております"@ja.
<< kg:id_155 prop:contermeasure kg:id_156 >>
    prop:text-txt_contents "保育料の納付につきましては、家庭の経済状況等を聞き取りしながら丁寧に納付相談を行い、可能な額を納めてもらっております"@ja.
<< kg:id_157 prop:cause kg:id_158 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "この制度を利用しまして仮に10年間分の保険料を納付する場合、約180万円となります"@ja.
<< kg:id_157 prop:contermeasure kg:id_159 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "山形県社会福祉協議会が実施しております貸付制度がありますので、まずはそちらを利用していただきたい"@ja.
<< kg:id_157 prop:contermeasure kg:id_160 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "まずは、後納制度の周知とあわせまして、貸付制度についてもＰＲしてまいりたい"@ja.
}
