kg:st_1 rdfs:label "門田克己議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "交付税減少を見据え今から対応策の指針を示すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "本間正巳市長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_2 prop:content "特例期間延長や実態に即した交付税算定を国に要請している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "市税減少に歯どめがかかっていないことが大きな理由"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "有利な財源活用と基金繰入で対応しつつ財政運営を進める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "不足額対応として基金繰入を見込む"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "コストのスリム化と経費節減を進めるべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "固定資産税の影響が市税全体の減収要因として大きい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "新たな滞納者をつくらないことが最も重要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "納税相談と納付機会を拡充し納めやすい環境を整備する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "滞納整理を積極的に進め債権回収を図る"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "納期内納付や初期滞納防止に効果が期待できる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:st_3 rdfs:label "太田豊総務部長"@ja.
kg:st_3 rdfs:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_12 prop:content "生活困窮が継続しているケースが大きい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "滞納整理に力を入れるほど手続をとらざるを得ないケースが増える"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "人口減少は自治体を支える根幹を弱める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "若者減少は地域経済全体への影響が大きい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "進学者の地元志向の薄さが要因"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "非正規雇用の多さが若者定住を妨げている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:st_4 rdfs:label "大石薫商工観光部長"@ja.
kg:st_4 rdfs:type cls:st_18.
kg:op_18 prop:content "正職員雇用を高める努力を続ける"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "高校生大学生の求人確保と正職員雇用を引き続き要請する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "国県制度を企業に周知し正規雇用転換を促す"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "市独自施策として就労環境整備を進める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:st_5 rdfs:label "久松勝郎健康福祉部長"@ja.
kg:st_5 rdfs:type cls:st_18.
kg:op_22 prop:content "年度途中採用が必要で確保が年々大変になっている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "法人市立を問わず確保に悩みを抱えている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "新卒保育士が都市部に集中し地方不足が生じる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "賃金改善が確保につながると期待している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:op_26 prop:content "来年度も継続し新制度へ引き継がれると期待する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "長い臨時雇用はやる気をそぎ保育の質を落とす"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "クラス担任は基本的に正職員が望ましく採用を進める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "当面の不足対応として任期つき職員採用を検討する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "日常的に参政権行使の意識を高める活動が必要"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:st_6 rdfs:label "船越重幸選挙管理委員会委員長"@ja.
kg:st_6 rdfs:type cls:st_36.
cls:st_36 rdfs:label "委員長"@ja.
kg:op_31 prop:content "政治や行政への関心を持つことが投票率向上につながる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_6.
kg:op_32 prop:content "若い段階から政治や行政や選挙に関心を持ってもらう"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:op_33 prop:content "若い人の多い職場で働きかけを進めている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:st_7 rdfs:label "梶原宗明議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_34 prop:content "道の駅は分散した施設を補完する役割が期待される"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_7.
kg:op_35 prop:content "買い物や食事を望む観光客を逃している恐れがある"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_7.
kg:op_36 prop:content "地域振興に大いに役立つ道の駅が必要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "真に求められる道の駅のあり方を関係者と検討する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:st_8 rdfs:label "佐藤文彦建設部長"@ja.
kg:st_8 rdfs:type cls:st_18.
kg:op_38 prop:content "市民や観光客の意見もパブリックコメントや調査で把握する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:op_39 prop:content "市民からおおむね好評であり引き続き活用する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "自由に使えイメージを損なわないよう商標登録を進める"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:st_9 rdfs:label "杉原久市民部長"@ja.
kg:st_9 rdfs:type cls:st_18.
kg:op_41 prop:content "水分を減らすことは本当に重要"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "ごみ減量実現の重要な手段として新たな細分化を計画で検討する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_9.
kg:op_43 prop:content "コストがネックであり事業化には量的確保が課題"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_9.
kg:op_44 prop:content "県や市町村と一緒に何とかよい方法を検討していく"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_9.
kg:op_45 prop:content "基金を取り崩して厳しい運営をしている"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "このままでは特定財源も枯渇する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "体協と数度会議を持ち総合的に検討している"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "他市事例も参考に補助金増額や指定管理導入を検討する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:st_10 rdfs:label "佐藤勝議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_49 prop:content "主要施設にはテレビを配置すべき"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_10.
kg:op_50 prop:content "避難所になり得る施設への設置を検討したい"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_9.
kg:op_51 prop:content "跡地全体の公共用途での購入意向はない"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:st_11 rdfs:label "西澤義和企画振興部長"@ja.
kg:st_11 rdfs:type cls:st_18.
kg:op_52 prop:content "地域の理解が得られれば太陽光発電設備も有効"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_11.
kg:st_12 rdfs:label "市原栄子議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_53 prop:content "事故回避と発生時対応をしっかり立てておくべき"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_12.
kg:st_13 rdfs:label "村上秀一教育部長"@ja.
kg:st_13 rdfs:type cls:st_18.
kg:op_54 prop:content "一人一人の状態に合わせた対応をとっている"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_13.
kg:op_55 prop:content "調理洗浄消毒も別に行い担任が直接渡す"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_13.
kg:op_56 prop:content "今年度中の作成を予定している"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_13.
kg:op_57 prop:content "複雑なケースは学校保護者教育委員会で相談する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_13.
kg:op_58 prop:content "園長保育士調理員保護者で情報共有を徹底する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:op_59 prop:content "アレルギー物質を除いた代替給食で対応している"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_5.
kg:op_60 prop:content "誤配や混入を防ぐため個人専用対応を行う"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_5.
kg:op_61 prop:content "教職員全員が使用法等を共有している学校もある"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_13.
kg:op_62 prop:content "軽度者の介護保険外しは市民の生きる権利を奪いかねない"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_12.
kg:op_63 prop:content "介護保険制度から外れるものではなく利点もある"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "多様なニーズに応じるには多様な事業主体が望ましい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "平成24年度は140件で主な理由は心身状況改善や病気安定"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_5.
kg:op_66 prop:content "認知症の有無によって実情に合わない判定が起き得る"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_12.
kg:op_67 prop:content "明らかに判定が違うケースは再調査できる"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_5.
kg:op_68 prop:content "非課税のはずの市民に不利益が出ないよう対策が必要"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_12.
kg:op_69 prop:content "確定申告不要でも市民税申告が必要なことを周知している"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_3.
kg:op_70 prop:content "来年度に向けても周知を続ける"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_3.
kg:op_71 prop:content "自然減対策として結婚出産子育て支援の充実を検討する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "若者定着に向けた取り組みを支援する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "ライフステージごとの支援策を検討している"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "若者が地元企業に就職し地域リーダーとなる取り組みを支援する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "健全財政を維持しながら施設の最適化を図る"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "具体的な数値目標を掲げ着実に推進する"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "市民の立場に立った業務改善を進める"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "全職員が市の将来像を考える姿勢を持つべき"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:st_14 rdfs:label "白崎好行農林水産部長"@ja.
kg:st_14 rdfs:type cls:st_18.
kg:op_79 prop:content "未利用材を含め地域材利用促進の循環型振興が必要"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_14.
kg:op_80 prop:content "庁内プロジェクトで基礎資料収集と調査検討を進めている"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_14.
kg:op_81 prop:content "近隣会場と協力しながら全国大会を開催している"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_9.
kg:op_82 prop:content "限界になってからでなく早めに整備したい"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_9.
kg:op_83 prop:content "全国から誘客できる大会やイベントを検討する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_9.
kg:op_84 prop:content "他市事例を参考に酒田ファンを増やしたい"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_3.
kg:st_15 rdfs:label "高橋一泰議員"@ja.
kg:st_15 rdfs:type cls:st_16.
kg:op_85 prop:content "投票所削減で高齢者の足が遠のいた可能性を検証すべき"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_15.
kg:op_86 prop:content "公正性公平性も踏まえ他自治体状況を含め検討が必要"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_6.
kg:op_87 prop:content "家族や地域の助け合いと併せて活用してほしい"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_6.
kg:op_88 prop:content "自助共助への理解と協力を得ながら進めたい"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_8.
kg:op_89 prop:content "市民の理解協力を得て自助共助を進める"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_8.
kg:op_90 prop:content "市内循環線など維持可能な地域では現時点で全市導入は考えていない"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_4.
kg:st_16 rdfs:label "武田恵子議員"@ja.
kg:st_16 rdfs:type cls:st_16.
kg:op_91 prop:content "受診費用が高く買い物もできず受診を我慢させる例もある"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_16.
kg:op_92 prop:content "財源確保が必要だが中学3年生までの拡大に向け引き続き検討する"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_5.
kg:op_93 prop:content "少なくとも小学校6年生までは早く実現してほしい"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_16.
kg:op_94 prop:content "まずは接種率を高める取り組みを行いたい"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_5.
kg:op_95 prop:content "周知を強め対象年齢引下げも検討すべき"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_16.
kg:op_96 prop:content "理解形成と機運醸成が課題であり普及啓発を進める"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_2.
kg:op_97 prop:content "関係者への要望や意見交換を重ねている"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_2.
kg:op_98 prop:content "市民理解を得られるよう普及啓発に力を入れる"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_2.
kg:op_99 prop:content "平成30年度暫定供用平成33年ころ全面開業見通し"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_2.
kg:op_100 prop:content "快適性向上も図られる"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_2.
kg:op_101 prop:content "事業者が資金不足に陥り事業継続困難となった"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_8.
kg:op_102 prop:content "駅前をあのままにしておいていいのかという声が多い"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_16.
kg:op_103 prop:content "市としても現状の更地でよいとは考えていない"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_8.
kg:op_104 prop:content "今後の対応策を引き続き国や県と相談している"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_8.
kg:op_105 prop:content "基本的な考え方は現在も変わらず今すぐ取り組める所から着手している"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_8.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "将来減少しながらも、最後には皆無となる地方交付税がどのような姿で酒田市の財政展望に影響するのか／これは普通交付税の合併算定替え等の特例期間終了後、財政運営の影響が大きい"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市税の減少傾向に歯どめがかかっていないということが、低下している大きな理由であります"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "一般会計においては不足額が平成26年度から生じるというふうになっているわけであります"@ja.
<< kg:id_5 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "財政中期展望で見込んだ不足額への対応としては、財政調整基金あるいは市債管理基金からの繰入を見込んでおります"@ja.
<< kg:id_5 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "アセットマネジメント導入によってコストのスリム化あるいは新行財政集中改革プランの着実な取り組みによって、経費の節減に努めていく"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "市税全体の45％を占める固定資産税については、土地価格の下落傾向、そして３年ごとの評価がえによる影響が大きく作用する"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "具体策の１つ目には、電話催告など納め忘れをなくす、防ぐということによって、初期対応の予防を図ります"@ja.
<< kg:id_11 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "夜間・休日相談窓口の開設、あるいは講座振替の促進、コンビニ、郵便局での納付など、納税相談、納付機会を拡充して納めやすい環境の整備を図る"@ja.
<< kg:id_11 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "滞納者の実態把握、財産調査、差し押さえ、インターネットによる公売など滞納整理を積極的に進めていく"@ja.
<< kg:id_11 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "納期内の納付あるいは初期滞納防止に効果が期待できるクレジット収納についても検討を加えていきたい"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "一番大きい理由が、執行停止をしてから３年間継続して、生活困窮等の状態が３年間継続しているケースが、大きい部分を実は占めております"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "市のほうで滞納整理について力を入れれば入れるほど、執行停止だとか、財産、担税力、こういったものの調査が進みますので、こうした手続をとらざるを得ないというケースがむしろふえていく"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "人口減少は税収減と地域コミュニティを弱体化させます"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "若者が減少するということは、言うまでもなく、税収減、少子化への加速、一般消費や住宅関連産業への影響が大きい"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "進学者の地元志向が薄いこと、非正規雇用の体質が改善されていないところにその要因がある"@ja.
<< kg:id_23 prop:cause kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "非正規雇用の体質が改善されていないところにその要因がある／新規求人に係る正職員の構成比は37％と、依然として非正規社員の割合が多い状況"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "ハローワークや酒田地区雇用対策協議会等の関係機関と連携し、市内企業へ高校生、大学生の求人確保、あるいは正職員雇用に関する要請"@ja.
<< kg:id_28 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "無期雇用、または正規雇用へ転換した場合に助成金が交付される／山形県においても…正職員化の促進奨励金制度も実施しております"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "女性の就労環境の整備につきましては、企業の皆様へセミナーの実施など、市独自の施策も行いながら"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "新生児の産後休暇明けや育児休業明けの入所ですとか、就職が決まったことによる年度途中の入所、また近年、発達に課題を抱える児童がふえている現状の中で、年度途中での保育士採用を行っております"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "年度途中での応募は少なく、法人、市立を問わず保育士確保については悩みを抱えている"@ja.
<< kg:id_32 prop:cause kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "都市部との待遇格差、雇用条件格差、規制緩和などが重なり、新卒保育士が都市部に集中し、そのために地方の保育士不足が生じる"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "この事業を実施することで保育士と職員の賃金の改善が図られ、保育士等の確保にもつながるものと期待をしております"@ja.
<< kg:id_38 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "本事業は来年度も継続して行われるものと考えており、そして、平成27年度からの子ども・子育て支援新制度に引き継がれまして、保育士等の処遇改善が図られていくものと期待"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "そういう形で長い間雇用して、それでやる気をそぐようなことであっては、私はこの地域の子育てはうまくいくはずはない／そういう気持ちになってしまいますと保育の質が落ちます"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "平成26年度より、計画的に保育士の採用を行ってまいりたい"@ja.
<< kg:id_44 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "当面、クラスを担任する保育士に不足が生じてきますので、その対応としましては、任期つき職員の採用という形で、少し考えていきたい"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "これは若者に市政や選挙に対する認識や関心度が不足していることは間違いない事実であります／有権者が政治や行政に関心を持つことが…投票率向上につながる"@ja.
<< kg:id_48 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "将来の有権者である児童・生徒に、学校で生きた教材を使って学んでもらいたいということで、ホームページに学校向けの資料コーナーを設けて"@ja.
<< kg:id_48 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "若い人の比較的多い職場での若者向け出前講座や、選挙啓発サポート企業への登録呼びかけなども行っております"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "観光、食事、買い物の場所が一体的でないというようなこと、また小規模の施設が多く、場所も分散しているという課題もある"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "大型観光バスが入りやすい施設は本市には少なく、一方で、一度に大人数の観光客をさばけず、近隣市町に通過してしまう"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "食事あるいは休憩施設の提供、道路や観光の情報発信、そして地場産品、農産物販売、それから災害発生時の防災拠点機能というふうな…道の駅"@ja.
<< kg:id_55 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "議会の皆様、それから農業、商業、観光等の関係機関の皆様から御意見をいただきながら、真に求められる、いい道の駅についてのあり方について検討／市民の皆様からもパブリックコメントなどの手法により、いろいろ御意見を伺いたい"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "市民の皆さんからもおおむね好評をいただいている／引き続き、庁内各課で活用していきたい"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "庁内で今後も自由に使えるように、また、キャラクターのイメージが損なわれることのないように、商標登録の手続は進めていきたい"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "可燃ごみとして出されたものの48％、半分が水分だということで、これを減らすというのは、本当に重要なこと"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "分別の細分化につきましては、ごみ減量実現のための手段として、非常に重要な役割を果たす／新たな細分化も含めまして、ごみ処理基本計画の中で検討を進めていきたい"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "回収処理経費と金属類の売却益に非常に大きな乖離がございました。回収処理に要する単価…203円…売却益…43円"@ja.
<< kg:id_68 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "山形県市町村等小型家電リサイクルシステム研究会を立ち上げまして、導入の方法、効果などの研究を行っている"@ja.
<< kg:id_70 prop:cause kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "平成21年度から光ケ丘プールの指定管理者から外れましたので、そういった意味で、今、基金を取り崩して厳しい運営をしている"@ja.
<< kg:id_70 prop:effect kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "このままでは、特定財源も枯渇することになります"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "ことしに入ってから体育協会と数度の会議を持って、新たな収入確保のあり方や体育協会としての事業の進め方などについて意見交換"@ja.
<< kg:id_73 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "補助金の増額も含めて、現在、総合的な検討をさせていただいている／補助金の増額あるいは指定管理者の導入などについては、他市の事例も参考にしながら検討"@ja.
<< kg:id_76 prop:cause kg:id_77 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_49;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "主要６施設については不設置、６施設については配置すべき／テレビのない６施設へのテレビの設置でございますけれども…今後の課題とさせていただきたい"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "全ての土地を取得して利活用する具体的な活用策がないことや、１万㎡を超える未活用の市有地が複数あり、新たに土地を購入する必要性がない"@ja.
<< kg:id_80 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "地域の理解が得られれば、太陽光発電施設の設備も有効な選択肢であると考えております"@ja.
<< kg:id_82 prop:effect kg:id_83 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "給食後に子供たちの生命を危うくすることは決してあってはならない事故"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "年度当初にアレルギー調査を行い、医師の診断書、食材の品目や症状の程度を確認しながら、保護者、学校、教育委員会で情報を共有して、一人一人の状態に合わせた対応"@ja.
<< kg:id_84 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "アレルギー物質を含まない別の献立とする代替食や、同じ献立でアレルギー物質を除いた除去食を給食として提供／調理器具や食器も専用のものとして、担任からその児童・生徒に給食を直接渡す"@ja.
<< kg:id_84 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "現在、作成準備中でございます／今年度中の作成を予定してございます"@ja.
<< kg:id_84 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "年に１回、各年度が始まる前に…保護者への聞き取りを行い／対応が複雑な児童については、学校、保護者、教育委員会の三者で相談"@ja.
<< kg:id_89 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "医師からの診断書や意見書をもとに、保護者の方から十分な聞き取りを行って対応方針を決定しております。そして、個々のアレルギー情報は、園長、保育士、調理員、保護者間で共有"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "対応方法としましては、アレルギー物質を除いた代替給食の提供をしております"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "調理器具や食器、洗浄、消毒も個人専用に行っております。給食は、お盆に名札をつけまして、どの職員でも確実にその子供に渡す"@ja.
<< kg:id_94 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "学校医を招いての研修会を開催して、教職員全員がエピペンの使用法等の情報を共有している学校もあります"@ja.
<< kg:id_96 prop:effect kg:id_97 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "利用者が必要とするサービスを十分にできなくなる可能性を心配する声があり／要支援の介護外しは、そうした人たちの生きる権利を奪いかねず"@ja.
<< kg:id_98 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "要支援者の予防給付を新しい地域支援事業へ移行することは、介護保険制度内でのサービス内容の移動でありまして…介護保険制度から外れるものではない"@ja.
<< kg:id_98 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "その担い手としては、介護保険サービス事業者以外にもＮＰＯや民間企業、ボランティアなどの多種多様な事業主体の提供であることが望ましい"@ja.
<< kg:id_101 prop:effect kg:id_102 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_65;
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "平成24年度の介護認定で、前回の要介護から要支援と認定された人数は140件であります／認知の調査結果が、これほど介護サービスの判定に影響する"@ja.
<< kg:id_103 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "明らかに判定が違うというようなケースがあれば、再調査ということもできます"@ja.
<< kg:id_105 prop:cause kg:id_106 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "申告は不要というお知らせをそのままうのみにして、市・県民税の申告をしないでいたら、今まで市・県民税も非課税だったのに、突然課税されてびっくりした"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "市民税申告書を送付し、申告を促すとともに…年金所得者向けの確定申告不要のケースであっても、市民税申告が必要ですよといったようなお知らせを同封"@ja.
<< kg:id_107 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "市のホームページあるいは広報、それから税のしおりなどを通してお知らせをしてきた／来年度の申告に向けても続けてまいりたい"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "未婚化、出産数の減少に加えて晩婚化、晩産化が進展している"@ja.
<< kg:id_112 prop:cause kg:id_113 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "高卒就職者の県内定着率が県平均が78％でありますけれども、これを大きく下回る54％"@ja.
<< kg:id_114 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "自然減に対しては結婚、出産、子育てのライフステージごとに、結婚支援策あるいは保育支援策の充実について検討"@ja.
<< kg:id_114 prop:contermeasure kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "産業技術短期大学庄内校では、卒業後も地元の企業に就職をして、地元のリーダーとなって地域を元気にしていく学生を育成する取り組み"@ja.
<< kg:id_117 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "この基本方針において「施設の長寿命化」、それから「維持管理コストの平準化・削減」、そして「社会状況に対応した施設のあり方の検討」"@ja.
<< kg:id_119 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "新行財政集中改革プランの各項目に、具体的な数値目標を掲げて、着実に推進するよう進捗管理を行う"@ja.
<< kg:id_119 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "新庁舎建設後を視野に入れて、窓口のワンストップサービスの検討を深める"@ja.
<< kg:id_119 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "全職員が他人ごとではなくて、危機意識を持って、市の将来像を考える姿勢を持つ"@ja.
<< kg:id_123 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "川上森林所有者から川中製材業者、そして川下の工務店、消費者にわたる循環型の林業振興が必要"@ja.
<< kg:id_123 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "庁内におきましてプロジェクトを立ち上げ、木質バイオマスの活用に向けた基礎資料の収集や、ペレット製造に係るコスト面、そして燃油との比較を含めた費用対効果等を調査検討"@ja.
<< kg:id_126 prop:cause kg:id_127 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "全国レベルの大会が開催できます単独の施設ということになりますと、国体記念体育館だけとなります"@ja.
<< kg:id_128 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "限界になってから行うのではなくて、早目に行うことにより、経費を小さく、寿命を長くするアセットマネジメントの考え方や、また少子化や人口減少を見据えての整備が重要"@ja.
<< kg:id_130 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "全国規模の大会開催の促進を、施策展開の方向性として掲げている／全国から誘客できるような参加型のスポーツイベント"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "お礼の品物のセット数の拡充や、あるいはお礼の品を送る場合の納税金額の見直しなど、他市の事例なども参考にしながら検討"@ja.
<< kg:id_134 prop:cause kg:id_135 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_85;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "投票所の数を市内全域、大幅に減らしたことにより高齢者の足が遠のいた／山間部などの交通手段の不便な高齢者や、市街地であっても高齢者だけの世帯について、投票所に足を運んでいただく対策"@ja.
<< kg:id_136 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "期日前投票制度を積極的に利用するなどして、大切な１票を投じていただきたい"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "除雪作業や除雪機械購入に対しまして補助金を交付する支援制度があります／36団体ございますが、皆様からこの支援制度のもと、地域の除雪を自主的に実施"@ja.
<< kg:id_140 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "除雪ボランティア団体といたしまして、平成24年度の冬期間におきましては、23団体の皆様から通学路や交差点の除雪について御協力"@ja.
<< kg:id_142 prop:contermeasure kg:id_143 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "バス路線の維持が困難な郊外地区において、市民の足を確保するための公共交通機関としてバス運行から切りかえてきている／現時点でデマンドタクシーを運行することは考えていない"@ja.
<< kg:id_144 prop:effect kg:id_145 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "医療機関での支払いが予想以上に高額で、１万円札を出して、おつりが小銭だけだった／それ以来、症状が軽いと我慢させて"@ja.
<< kg:id_146 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_92;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "中学３年生までの対象拡大に向けて、引き続き、検討してまいりたい／せめて小学校６年生までは早くしていただきたい"@ja.
<< kg:id_148 prop:effect kg:id_149 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_94;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "接種率が7.5％程度でございました。まだ接種率が低いため、まずは接種率を高める取り組みを行っていきたい"@ja.
<< kg:id_150 prop:cause kg:id_151 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "課題としては、事業の主体となります県、それからＪＲ東日本等の理解、あるいは市民の皆さん、県民の皆さんが、そうした気持ちになるということも非常に大事"@ja.
<< kg:id_152 prop:contermeasure kg:id_153 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "本年５月以降、県知事あるいは庄内総合支庁長への要望あるいは県の交通政策課、それからＪＲ東日本などの関係者との意見交換"@ja.
<< kg:id_152 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "のぼり旗あるいは啓発グッズをつくって機運醸成に努めております"@ja.
<< kg:id_155 prop:contermeasure kg:id_156 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "新潟駅同一ホーム乗りかえ事業が、平成24年度から着手／平成30年度に暫定供用、平成33年ころに全面開業される見通し"@ja.
<< kg:id_155 prop:contermeasure kg:id_157 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "ことしの９月28日から、新しい形式の車両が導入されて、快適性の向上も図られる"@ja.
<< kg:id_158 prop:cause kg:id_159 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "当初の計画の精度が低かったことから、たびたび計画が変更されてきており、結果的に工事の入札ができなかった、その後、さらに建設費の高騰も加わりまして、事業者が資金不足に陥り"@ja.
<< kg:id_160 prop:effect kg:id_161 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_102;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "駅前に建物が建つ見込みがなくなって、ずっとあのままの状態が続く／市といたしましても、現状の更地の状況でよいとは、考えてはおらない"@ja.
<< kg:id_162 prop:contermeasure kg:id_163 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "今後の対応策につきましては、引き続き、国や県と相談をしているところでございます"@ja.
<< kg:id_162 prop:contermeasure kg:id_164 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "平成12年度に酒田駅前整備計画策定業務…その中で将来的な駅周辺のゾーニング等の基本的な考え方を整理／旧ジャスコ跡地や駅舎を含めた駅前広場の整備など、今すぐ取り組めるところから現在着手"@ja.
}
