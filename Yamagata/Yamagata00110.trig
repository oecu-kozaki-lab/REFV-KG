    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今回の補正は、国の経済対策に伴う事業の前倒し"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今回の補正は、国の経済対策に伴う事業の前倒し、決算見込みによる事業費の調整"@ja.
