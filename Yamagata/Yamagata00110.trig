    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "４月には社会保障の充実・安定化を進めるために、消費税が５％から８％に引き上がります"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本市におきましても、国の動きに呼応し、公共事業の前倒しや「低所得者・子育て世代への影響緩和」に係る給付金について、万全を期してまいります"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "2040年の本市の人口が７万1,000人程度まで減ってしまうという人口推計は、市民に大きな衝撃を与えました"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "2040年の本市の人口が７万1,000人程度まで減ってしまうという人口推計は、市民に大きな衝撃を与えました"@ja.
<< kg:id_42 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "子供の医療費無料化の対象年齢拡大を、引き続き実施し、小学校６年生までを対象とすることにより、子育て世代が安心して子供を産み育てる環境の整備に努めてまいります"@ja.
<< kg:id_42 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "結婚支援を初めとする人口減少・少子化対策を、市民・民間を巻き込んでのオール酒田で積極的に連携して取り組み、総合的に展開してまいります"@ja.
<< kg:id_47 prop:effect kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本市では毎年約400人の方が、がんで亡くなっており、中でも胃がん、大腸がんで亡くなる方が多く、対策が必要となっております"@ja.
<< kg:id_47 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "酒田地区医師会の協力のもと、県内他市町村に先駆けてピロリ菌検査を実施し、積極的ながん予防に取り組む"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "就職を希望する新規高校卒業者の４割を超える皆さんが県外に働きに出てしまうというデータがあり"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "大学進学者等も３割しか酒田に戻っていない状況にあります"@ja.
<< kg:id_50 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "学校、保護者、地元企業の皆様と課題を共有し、転出抑制、ＵＩＪターンの促進など、地元定着を促進する取り組みを展開してまいります"@ja.
<< kg:id_55 prop:cause kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "酒田駅前の再開発事業については、民間事業者から事業中止の申請を受けました"@ja.
<< kg:id_55 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "改めてスタートラインに立って展開していくため、推進体制を見直し、中心市街地の活性化、旧商業高校を初めとする学校跡地の利活用、消防本署の改築、道の駅の整備など、都市としてのトータルデザインを描きながら推進してまいります"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "平成28年度から普通交付税の段階的な縮小が始まることから、合併特例事業債などの有利な財源を活用しながら、社会基盤の整備などの重要な課題に対応していかなければなりません"@ja.
<< kg:id_58 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "合併特例事業債などの有利な財源を活用しながら、社会基盤の整備などの重要な課題に対応していかなければなりません"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "高度成長期に整備した公共施設については、その多くが耐用年数を迎えており"@ja.
<< kg:id_61 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "アセットマネジメントによる公共施設の再配置について検討を深めてまいります"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "婚活に取り組んでいる民間団体と市が情報を共有し、連携イベントの企画を行うなど、酒田市一丸となった取り組みを実施してまいります"@ja.
<< kg:id_64 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "結婚支援推進員の名称を親しみやすい結婚サポーターと変更し、多くの皆様から御協力をいただいて拡充するとともに、サポートセンターを設置し、活動を一層充実することにより、出会いの機会をふやしてまいります"@ja.
<< kg:id_67 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "子育て世帯の不安解消のため、多様な保育サービスの提供、地域における子育て支援などを推進してまいります"@ja.
<< kg:id_67 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "子育て世帯の不安解消のため、多様な保育サービスの提供、地域における子育て支援などを推進してまいります"@ja.
<< kg:id_67 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "新たに新婚カップルを対象とした生涯設計の啓発や、出産適齢期についての知識普及のための講演会開催、啓発リーフレットの配布など、妊娠、出産などに関する情報提供の充実を図ってまいります"@ja.
<< kg:id_67 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "子供の通院分の医療費無料化を、所得制限なしで小学校６年生まで拡充いたします"@ja.
<< kg:id_67 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "民間保育所の施設改築に対する支援や学童保育所を整備するなど、保育環境の向上を図るとともに、民間の保育所運営や保育士の処遇改善を支援し、安心して子供を預け、就労できる環境を整備してまいります"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "地元企業の見学会や若手職員との懇談などを通して、就職を希望する高校生と企業とをつなぎ、酒田の企業への就職を後押しいたします"@ja.
<< kg:id_75 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "県外で開催される合同就職ガイダンスへの地元企業参加を支援し、就業機会の拡大を図ってまいります"@ja.
<< kg:id_77 prop:effect kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "飛島は、高齢化や人口減少が著しい地区であることから、島の機能を、今後も維持していくために"@ja.
<< kg:id_77 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "島民、大学、ＮＰＯ、県、市が一体となった、とびしま未来協議会の運営を推進するとともに"@ja.
<< kg:id_77 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "緑のふるさと協力隊などの外部人材のマンパワーを借りながら、島の活性化に取り組んでまいります"@ja.
<< kg:id_81 prop:effect kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "高齢者の単身化が進み、通院・買い物・除雪などの日常生活に支障が生じ"@ja.
<< kg:id_81 prop:effect kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "地域での生活に不安を持つ方の増加が懸念されます"@ja.
<< kg:id_81 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "生活援助や除雪援助を引き続き実施していくとともに"@ja.
<< kg:id_81 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "デマンドタクシー運行の拡充を図るなど、障がいのある方々も含めて、住み慣れた地域の中で、安心して生活できるまちづくりを目指してまいります"@ja.
<< kg:id_86 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "胃がん発生リスクを判定する検査を新たに実施することにより、がん検診の受診率向上を図るとともに、予防による医療費の抑制を図ってまいります"@ja.
<< kg:id_86 prop:effect kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "がん検診の受診率向上を図るとともに、予防による医療費の抑制を図ってまいります"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "飛島地区の電話回線を利用したシステムのサービスが終了することから"@ja.
<< kg:id_89 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "新たに、無線による防災通信システムを整備いたします"@ja.
<< kg:id_92 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "よりよい診療体制の構築のためバリアフリー対応の改修と緊急検査機器の整備に取り組んでまいります"@ja.
<< kg:id_92 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "よりよい診療体制の構築のためバリアフリー対応の改修と緊急検査機器の整備に取り組んでまいります"@ja.
<< kg:id_95 prop:effect kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "空き家の解体が進むなど、一定の成果があらわれてきております"@ja.
<< kg:id_95 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "自治会等の関係者間で連携し合い、適正管理するための仕組みを構築するとともに、空き家等ネットワーク協議会を活用しながら、総合対策を実施していまいります"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "飛島地区の危険な状態となっている老朽化した空き家については、除却することにより、安全な避難経路の確保などを図ってまいります"@ja.
<< kg:id_100 prop:effect kg:id_101 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "年々複雑化、高度化している消費生活相談については、相談窓口の体制強化を図るとともに"@ja.
<< kg:id_100 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "相談窓口の体制強化を図るとともに、講座の開催やハーバーラジオによる啓発など、消費者行政の一層の充実に取り組み"@ja.
<< kg:id_103 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "本市が直営で取り組む十里塚地区の風力発電については、環境への影響に十分配慮した整備を行い、着実に計画を進めてまいります"@ja.
<< kg:id_103 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "太陽光発電については、住宅用太陽光発電システム設置への支援を継続するとともに"@ja.
<< kg:id_103 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "国の補助金を活用して、防災拠点となるタウンセンターなどに蓄電池を組み合わせたシステムを設置いたします"@ja.
<< kg:id_107 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "公金の未収債権確保と収納率向上を図るため、新たに専門部署を設置いたします"@ja.
<< kg:id_109 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "公園照明の省エネルギー化を計画的に進め、経費削減に努める"@ja.
<< kg:id_111 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "老朽化による更新の課題を抱える公共施設のあり方について、施設再編の実施計画及び長寿命化計画などのアセットマネジメントを推進し、健全財政の維持に努めてまいります"@ja.
}
