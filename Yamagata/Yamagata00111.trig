kg:st_1 rdfs:label "杉原久市民部長"@ja.
kg:st_1 rdfs:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_1 prop:content "結婚を望む男女の早期の結婚支援に力を入れることが有効だとする"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "関井美喜男議員"@ja.
kg:st_2 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_2 prop:content "一般的な婚活支援だけでは不十分であり、結婚しない理由の分析がさらに必要とする"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "田中廣議員"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_3 prop:content "若者の県外志向が人口減少・少子化の一因であり、地元定着率の底上げが急務とする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "市政発展の基礎となる極めて重要な課題だとする"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "重要な子育て支援策として実施に異論はないが拡大のスピードは遅いとする"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_4 rdfs:label "本間正巳市長"@ja.
kg:st_4 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_6 prop:content "財政状況を勘案しながら段階的に拡大していくとする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:op_7 prop:content "財政状況を勘案しながら中学3年生まで段階的に進めたいとする"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:st_5 rdfs:label "久松勝郎健康福祉部長"@ja.
kg:st_5 rdfs:type cls:st_32.
kg:op_8 prop:content "中学3年生までの対象拡大に向け財政も勘案しながら段階的に進めるとする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_5.
kg:op_9 prop:content "結婚を望む男女の早期の結婚支援に有効な対策とする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "結婚支援を積極的に進めるため配置するとする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "情報交換の機会を増やし結婚推進につなげるとする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "出会いの場を増やし結婚を推進するとする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:st_6 rdfs:label "高橋千代夫議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_13 prop:content "男女を集めるだけでなく自分磨きやアピール力向上も必要とする"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_6.
kg:op_14 prop:content "団体や企業と連携し情報の一元化と発信で結婚を推進するとする"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "行政単体でなく民間や各種団体を巻き込んだオール酒田の取り組みが必要とする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:st_7 rdfs:label "西澤義和企画振興部長"@ja.
kg:st_7 rdfs:type cls:st_32.
kg:op_16 prop:content "平成26年度の少子化対策のキーワードの一つとして進めるとする"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_7.
kg:op_17 prop:content "結婚から子育てまで切れ目のない支援として進めるとする"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_7.
kg:op_18 prop:content "よりきめ細かく総合的な支援にするため仕組みを築くとする"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_7.
kg:op_19 prop:content "必要性は認めつつも本質的な調査分析が不足しているとする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:st_8 rdfs:label "大石薫商工観光部長"@ja.
kg:st_8 rdfs:type cls:st_32.
kg:op_20 prop:content "若手社員との意見交換も行い地元企業への理解を深め地元定着を促進するとする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_8.
kg:op_21 prop:content "若手社員との意見交換も行い地元定着を促進するとする"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_8.
kg:op_22 prop:content "県外進学者や県内就労者の地元企業への就業機会拡大を図るとする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_8.
kg:op_23 prop:content "大いに期待されるとする"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "酒田市と酒田港にとって産業・経済・文化・観光の発展に寄与する重要路線とする"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "酒田市と酒田港にとって大変重要な幹線道路とする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "大震災で防災面の重要性が認識されたとする"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "計画路線の早期昇格に向け官民一体で強力な運動を行うとする"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "沿線地域との連携強化の一環とする"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "計画路線の早期昇格に向け連携をより強化するとする"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "日沿道に一定のめどがついた中でウエストラインに本気で取り組むべきとする"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "港の貨物量が増えても陸送時に道路が曲がれないのは本末転倒だとする"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:st_9 rdfs:label "佐藤文彦建設部長"@ja.
kg:st_9 rdfs:type cls:st_32.
kg:op_32 prop:content "支障箇所の解消に向け要請していくとする"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_9.
kg:op_33 prop:content "大型トレーラーが円滑に運行できるよう情報交換を行うとする"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_9.
kg:op_34 prop:content "市として解消に向けた要請を行うとする"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_9.
kg:op_35 prop:content "県の問題意識が薄いなら酒田市がもっと強く要請すべきとする"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "個別の箇所ごとではない総合的なまちづくりの推進に期待するとする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "本市に必要な都市機能と駅周辺に求められる機能を整理するとする"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_7.
kg:op_38 prop:content "玄関口となる駅周辺に必要な機能整理を深めるとする"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_7.
kg:op_39 prop:content "交流という都市機能が必要ならそれにふさわしい玄関口機能を整理するとする"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_7.
kg:op_40 prop:content "酒田のまちの顔として整理していくイメージを持つとする"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_7.
kg:op_41 prop:content "持続的な財政運営のため税源確保と改革推進が必要とする"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:op_42 prop:content "基金の積み増しと取り崩しでの運営が本当に健全財政か疑問とする"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "地域経済の活性化に向けた適切な施策を実施し税源を確保するとする"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:op_44 prop:content "自主財源確保の一つとして進めるとする"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:op_45 prop:content "効率的な財政運営のため着実に推進するとする"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_4.
kg:op_46 prop:content "自主財源確保のため収納対策を強化するとする"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "健全な財政運営のために必要な手法とする"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "活用方針に変更はないとする"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:op_49 prop:content "有利な財源でも借金であり償還を意識した対応を求める"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "有利な財源を組み合わせて活用計画を見直すとする"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "駆け込み需要の反動で税金を払えない事業者が出ないか懸念するとする"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "収納率への影響をできるだけ与えないよう滞納防止に努めるとする"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:op_53 prop:content "収納率への影響を抑えるため現年度課税の滞納防止に努めるとする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:op_54 prop:content "駆け込み需要の反動による影響緩和を図るとする"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_4.
kg:op_55 prop:content "低所得者への影響緩和を図るとする"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_4.
kg:st_10 rdfs:label "市原栄子議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_56 prop:content "給付金だけでは生活に足りないとする"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_10.
kg:op_57 prop:content "子育て世帯への影響緩和を図るとする"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_4.
kg:op_58 prop:content "節目の大事な事業であり26年度に企画立案を進めるとする"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_4.
kg:op_59 prop:content "関係各課と関係各団体の意見を聞きながら進めるとする"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_4.
kg:st_11 rdfs:label "菅原司芝総務課長"@ja.
kg:st_11 rdfs:type cls:st_32.
kg:op_60 prop:content "まず庁内でふさわしい事業の抽出から始めるとする"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_11.
kg:st_12 rdfs:label "白崎好行農林水産部長"@ja.
kg:st_12 rdfs:type cls:st_32.
kg:op_61 prop:content "40年ぶりの大転換であり本市としてきっちり対応するとする"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_12.
kg:op_62 prop:content "具体的運用が非常に懸念されるとする"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "米を主体とする本市の農業にとって重大な問題と受けとめる"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_12.
kg:op_64 prop:content "新規需要米の増産や複合経営推進などを盛り込んだ対応策とする"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_12.
kg:op_65 prop:content "県の農地中間管理機構開始を見据え本市独自に支援するとする"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_12.
kg:op_66 prop:content "売れる米づくりのため新たに取り組むとする"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_12.
kg:op_67 prop:content "酒田産米などの販路拡大とブランド化を図るとする"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_12.
kg:st_13 rdfs:label "梶原宗明議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_68 prop:content "農水産物全体で垣根を超えて取り組むことにも成果が期待できるとする"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_13.
kg:op_69 prop:content "集落営農法人化を促進するため支援するとする"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_12.
kg:op_70 prop:content "農家の身になった形で利用していきたいとする"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_12.
kg:op_71 prop:content "可能な限り上昇率を抑えるよう再度申し入れを行ったとする"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_5.
kg:op_72 prop:content "保険料上昇抑制策の一つとする"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_5.
kg:op_73 prop:content "保険料上昇抑制策の一つとする"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_5.
kg:op_74 prop:content "保険料上昇抑制策の一つとする"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_5.
kg:op_75 prop:content "市民の負担増を最小限に抑えることができたとする"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_5.
kg:op_76 prop:content "市民に喜ばれ市外からの誘客も期待できる施設とする"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_1.
kg:op_77 prop:content "継続を前提に今後の施設整備方針を検討するとする"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_1.
kg:op_78 prop:content "利用者が多く市外からの誘客も期待できるため整備方針を検討するとする"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_1.
kg:op_79 prop:content "定住自立圏構想など大きな枠組みを使った整備も考えられないかとする"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_13.
kg:op_80 prop:content "忙しい中引き受けていただいており感謝しているとする"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_5.
kg:op_81 prop:content "まずはこの活動を大切にしていきたいとする"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_5.
kg:op_82 prop:content "施設の広域利用や相互利用、連携した行政サービス提供が大きなメリットとする"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_7.
kg:op_83 prop:content "圏域連携による住みやすい地域社会形成を進めるとする"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_4.
kg:op_84 prop:content "関係市町と協議する事業例として考えられるとする"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_4.
kg:op_85 prop:content "関係市町と協議する事業例として考えられるとする"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_4.
kg:op_86 prop:content "地元の思いを真摯に受けとめ環境影響評価を丁寧に行うとする"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_7.
kg:op_87 prop:content "地元理解を得るため結果を全て示すとする"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_7.
kg:op_88 prop:content "事業に対して理解を得られるよう努めるとする"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_7.
kg:st_14 rdfs:label "高橋準一企画振興部付消防調整監"@ja.
kg:st_14 rdfs:type cls:st_32.
kg:op_89 prop:content "改築について検討を進めているとする"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_14.
kg:op_90 prop:content "市民の安全安心を守る重要施設として機能できるよう計画を立てるとする"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_14.
kg:op_91 prop:content "改築の際に分署配置も含めて計画する"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_14.
kg:op_92 prop:content "採算ベースに乗らない公共性の高い部門を支えるため支援を継続するとする"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_5.
kg:op_93 prop:content "北庄内における役割分担や連携のあり方を検討する必要があるとする"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "特に結婚に関しましては、婚姻数の減少が課題となっておりまして"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "例えば、晩婚化の進行。これは昭和57年以降、約30年間で、女性の平均初婚年齢が約3.3歳上昇しております"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "あるいは、晩産化の傾向。これも同じく約30年間で、平均出産年齢が約2.8歳上昇しているということでございます"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "あるいは女性の就業率向上に伴う育児と就労の両立問題の顕在化"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:text-txt_contents "若者の結婚観の変化など、数多く幅広い課題が挙げられた"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "若者の県外志向が人口減少・少子化の一因となっている現在、若者の地元定着率の底上げが急務だと考えます"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "さまざまな人口推計のデータや、ありとあらゆるところに大きな影響を及ぼすということはもちろん、市政発展の基礎となる極めて重要な課題である"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "平成26年度は小学校６年生まで、さらに対象を拡大してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今後の方向性としては、中学３年生までということで対象拡大に向けて、財政状況を勘案しながら、段階的に一歩一歩進めてまいりたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "結婚推進支援事業として、交流ひろば内に「結婚サポートセンター」を設置し"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "結婚推進員を配置しまして"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "結婚サポーターの増員を図ってまいります。情報交換の機会をふやしていきたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "出会いの場となる婚活イベントも企画運営しながら結婚を推進してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "オール酒田の「結婚推進連絡協議会」を立ち上げ、それぞれが実施する事業の情報の一元化を図り、トータル的に情報発信していく"@ja.
<< kg:id_1 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "平成26年度はこうしたことを踏まえまして、出会いの機会の拡充"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:text-txt_contents "出産適齢期に関する知識の普及"@ja.
<< kg:id_1 prop:contermeasure kg:id_18 >>
    prop:text-txt_contents "家族観の醸成などを対策のキーワードにして"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "妊娠・出産などライフイベントの情報提供の充実"@ja.
<< kg:id_1 prop:contermeasure kg:id_20 >>
    prop:text-txt_contents "酒田で楽しい結婚・出産・子育て応援事業など、切れ目のない支援事業を展開してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "平成26年度におきまして、結婚や子育てなどの支援活動をしている実践者を交え、全体の実施状況を確認していく仕組みを築いて"@ja.
<< kg:id_1 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "高校生による地元企業見学会なども必要だとは思います"@ja.
<< kg:id_1 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "市は就職を希望する高校２年生と担任、進路指導教諭を対象に、市内企業の見学会を実施し、若手社員との意見交換も行い、地元企業への理解を深め、地元定着を促進する事業に取り組みます"@ja.
<< kg:id_1 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "市内の企業が仙台や首都圏で開催する合同就職ガイダンスに参加する場合に、費用の一部を助成することで、地元企業からの積極的参加を促して"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "日本海沿岸東北自動車道の両県境、ミッシングリンク区間については一定のめどが立ち、物流や交流人口の増大など、大いに期待されるところであります"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "みちのくウエストラインの石巻・酒田道路は、国土の東西横断軸を形成する物流、そして交流の大動脈であります"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "酒田市、それから酒田港にとっては、産業・経済・文化・観光の発展に大きく寄与する、大変重要な幹線道路であります"@ja.
<< kg:id_27 prop:effect kg:id_30 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "防災面においても日本海側と太平洋側とを結ぶ、非常に大事な道路であるということが認識されました"@ja.
<< kg:id_27 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "「石巻・酒田間地域連携サミット」というのがあります"@ja.
<< kg:id_27 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "「みちのくウエストライン少年サッカー大会」などを開催しております"@ja.
<< kg:id_27 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "沿線の地域住民の皆さん、そして市町村・商工会議所などの関係団体と協力して、連携をより強化して、計画路線の早期昇格に向け、官民一体となって強力な運動を行っていかなければいけない"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "40フィートコンテナを搭載したトレーラーは、現状の道路幅では運行が困難である"@ja.
<< kg:id_34 prop:effect kg:id_36 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "酒田港周辺道路をトレーラーなどの車両で運行する際、各路線の交差点などで通行に細心の注意が必要となる箇所もある"@ja.
<< kg:id_34 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "運送業界、道路管理者並びに公安委員会との情報交換などを行い"@ja.
<< kg:id_34 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_34;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "支障のある箇所につきましては、市として解消に向けた要請を行ってまいりたい"@ja.
<< kg:id_39 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "新年度、企画振興部に設置される都市デザイン課におきましては、本市が必要とする都市機能というのはどういうものかという点を整理し"@ja.
<< kg:id_39 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "さらに、玄関口となる駅周辺に求められる機能というのはどういうものかという整理を深め"@ja.
<< kg:id_39 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "交流という都市機能が酒田市に必要だということであれば、交流都市にふさわしいエントランス機能というのはどういうものか、整理をさせていただく"@ja.
<< kg:id_39 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "駅周辺、旧商業高校跡地周辺－－これは山居倉庫も多分含まれますが、その周辺を鉄道の玄関口、あるいは空港から旧市街地に入る玄関口と位置づける形で、エントランスの部分を酒田のまちの顔として整理していく"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "普通交付税がだんだん減らされていく"@ja.
<< kg:id_44 prop:effect kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "平成27年度からは、毎年十数億円の財源不足が予想され"@ja.
<< kg:id_44 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "人口減少対策、それから少子化対策をやって、そして地域経済の活性化に向けた適切な施策を実施することによって、税源の確保を図っていかなければいけない"@ja.
<< kg:id_44 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "遊休資産を売却する"@ja.
<< kg:id_44 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "アセットマネジメントなどによって、新行財政集中改革プランの着実な推進を図っていく"@ja.
<< kg:id_44 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "市税等の収納対策を強化していく"@ja.
<< kg:id_44 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "繰越金を基金に積み立てをして、年度間の財源調整の手だてとしている"@ja.
<< kg:id_52 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "有利な財源として、市民の皆さんのニーズを見きわめながら最大限に活用させていただいて、真に必要な社会資本の整備を進めていかなければならない"@ja.
<< kg:id_52 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "地域の元気臨時交付金の活用、あるいは緊急防災・減災事業債など、ほかの有利な起債への変更ということもあり得る"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "消費税が上がることによって、市税の納税状況がどうなるのかと、そうしたことに対する影響も懸念される"@ja.
<< kg:id_55 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "訪問、文書催告、電話催告など、現年度の課税について、特に滞納防止に努めていきたい"@ja.
<< kg:id_55 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "平成26年度当初予算においても、公共事業の前倒し"@ja.
<< kg:id_55 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "所得の低い人に対して臨時福祉給付金"@ja.
<< kg:id_55 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "子育て世帯臨時特例給付金を計上している"@ja.
<< kg:id_61 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "その企画立案については、26年度に庁内で検討し準備を進めたい"@ja.
<< kg:id_61 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "関係各団体から、いろいろな意見をお聞きしながらやっていきたい"@ja.
<< kg:id_61 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "各課より、合併10周年にふさわしい事業を抽出するという、まずそういうことから始めたい"@ja.
<< kg:id_65 prop:cause kg:id_66 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "今回は40年ぶりの大転換と言われている米政策の見直しがあります"@ja.
<< kg:id_65 prop:cause kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "農地中間管理機構"@ja.
<< kg:id_65 prop:effect kg:id_68 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "米を主体とする本市の農業にとって農政の改革は、農業経営において重大な問題と受けとめております"@ja.
<< kg:id_65 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "「酒田市地域水田フル活用ビジョン」を作成しております"@ja.
<< kg:id_65 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "本市独自の農地集積センター活動支援などを行ってまいります"@ja.
<< kg:id_65 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "新たに酒田の土づくり支援事業を行います"@ja.
<< kg:id_65 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_67;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "酒田産米などの販路拡大・ブランド化を図るためにも、トップセールスを強化してまいります"@ja.
<< kg:id_65 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "集落営農法人化推進員の配置に対する支援"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "農業委員会、農協、市、それから関係機関・団体の方々も入れて、農家の身になった形で今回の農地中間管理機構を利用していきたい"@ja.
<< kg:id_76 prop:cause kg:id_77 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "8.72％という大幅な上昇率が示された"@ja.
<< kg:id_76 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "広域連合決算剰余金の全額活用"@ja.
<< kg:id_76 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "県の後期高齢者医療財政安定化基金の交付"@ja.
<< kg:id_76 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "均等割保険料の２割及び５割軽減の対象拡大"@ja.
<< kg:id_76 prop:effect kg:id_81 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "最終的な案としまして、0.78％の引き上げとすることが示されました"@ja.
<< kg:id_82 prop:effect kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "今では庄内一円だけではなく、最上地方や秋田県、それから福島県などの県外からもおいでいただいている"@ja.
<< kg:id_82 prop:cause kg:id_84 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "市営体育館は昭和47年の竣工以来、築後42年が経過しまして、老朽化が進んでいる"@ja.
<< kg:id_82 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_78;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "継続を前提に、今後の施設整備方針を検討していきたい"@ja.
<< kg:id_86 prop:effect kg:id_87 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "本市の民生委員の定員は273名でありますけれども、現在、16名が空席となっております"@ja.
<< kg:id_86 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "学区・地区社会福祉協議会ごとに福祉隣組、及び福祉協力員を配置をしまして、民生委員と連携をして、要援護者の見守り活動などを行っております"@ja.
<< kg:id_89 prop:effect kg:id_90 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "施設の広域利用であったり、相互利用、あるいは連携した行政サービスの提供を受けるということで、圏域住民の利便性が向上する"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "平成26年３月に中心市宣言をさせていただいて"@ja.
<< kg:id_89 prop:contermeasure kg:id_92 >>
    prop:text-txt_contents "平成26年９月には定住自立圏形成協定"@ja.
<< kg:id_89 prop:contermeasure kg:id_93 >>
    prop:text-txt_contents "平成27年３月には定住自立圏共生ビジョンの策定と公表を予定しております"@ja.
<< kg:id_89 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "例えば、休日及び夜間診療所や子育て支援センターなどの施設の総合利用"@ja.
<< kg:id_89 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "婚活事業での連携などが考えられる"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "騒音、動植物への影響、落雷等事故に対する不安"@ja.
<< kg:id_96 prop:cause kg:id_98 >>
    prop:text-txt_contents "動植物への影響"@ja.
<< kg:id_96 prop:cause kg:id_99 >>
    prop:text-txt_contents "落雷等事故に対する不安"@ja.
<< kg:id_96 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "騒音、動植物につきましては、環境影響評価を丁寧に行い、その結果も全てお示ししていく"@ja.
<< kg:id_96 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "現地調査の状況を中間的に御報告をさせていただきながら、地元の御意見、御要望をお聞きし、事業に対して御理解を得られるように努めてまいりたい"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "昭和49年に建築され、老朽化が進み"@ja.
<< kg:id_102 prop:cause kg:id_104 >>
    prop:text-txt_contents "耐震診断の結果で耐震性が低かったこと"@ja.
<< kg:id_102 prop:cause kg:id_105 >>
    prop:text-txt_contents "敷地が狭く訓練スペースも確保できないこと"@ja.
<< kg:id_102 prop:cause kg:id_106 >>
    prop:text-txt_contents "日本海沖で大規模な地震が発生したときには、津波の浸水が想定されること"@ja.
<< kg:id_102 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "本署の改築については検討を進めているところでございます"@ja.
<< kg:id_102 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "分署の配置につきましても、酒田市街地がしっかりとカバーできるように計画を立てている"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "住民の健康・福祉の増進ですとか、公共性の観点から採算ベースに乗らない部門も運営いただいておりまして、そういった部分等につきましては、県と市が財政支援をしております"@ja.
<< kg:id_111 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "市立八幡病院につきましては、特に日本海総合病院との連携のあり方が大きいと考えておりまして、速やかに検討を進めてまいりたい"@ja.
}
