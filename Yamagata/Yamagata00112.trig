<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:text-txt_contents "本案は、鳥海高原牧場の指定管理者を指定するため、議会の議決を求めるものであり"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "景気回復の実感は、中小企業、地域経済にはいまだ十分浸透しておらず、財政状況についても、少子高齢化などの要因により、極めて厳しい状況にあります。"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "円安による燃料、原材料、生活必需品の値上がりが家計と中小企業を苦しめています。"@ja.
<< kg:id_36 prop:cause kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "円安による燃料、原材料、生活必需品の値上がりが家計と中小企業を苦しめています。"@ja.
<< kg:id_36 prop:cause kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "円安による燃料、原材料、生活必需品の値上がりが家計と中小企業を苦しめています。"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "ＧＤＰの伸びを辛うじて支えているのは、消費税増税を前にした駆け込み需要と、公共事業の積み増しという一時的なものに過ぎません。"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "ＧＤＰの伸びを辛うじて支えているのは、消費税増税を前にした駆け込み需要と、公共事業の積み増しという一時的なものに過ぎません。"@ja.
<< kg:id_43 prop:effect kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "いわゆるアベノミクスにより株価が上がりましたが、庶民への恩恵はなく、何よりも働く人たちの賃金は減少しています。"@ja.
<< kg:id_45 prop:effect kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "４月から５％から８％への消費税の大増税が行われます。全国で８兆円、さらに社会保障の負担増・給付減を合わせれば10兆円という史上空前の負担増が強行されれば、市民の暮らしに大打撃を与え"@ja.
<< kg:id_45 prop:effect kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "市民の暮らしに大打撃を与え、日本経済を壊し、財政も共倒れという悪循環の引き金を引くことになることは、明らかです。"@ja.
<< kg:id_45 prop:effect kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "市民の暮らしに大打撃を与え、日本経済を壊し、財政も共倒れという悪循環の引き金を引くことになることは、明らかです。"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "既に行われている生活保護の基準の引き下げや年金の引き下げなど、社会保障が後退している中"@ja.
<< kg:id_49 prop:cause kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "既に行われている生活保護の基準の引き下げや年金の引き下げなど、社会保障が後退している中"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "今回の予算では、課税義務のない手数料や使用料に対し、消費税増税分の３％が転嫁され、市民負担をさらに求めております。"@ja.
<< kg:id_54 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "市は、ほっとふくし券を、前のように介護保険に使えるようにすることや"@ja.
<< kg:id_54 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "福祉灯油券の発行を行う、以前より私たちは求めておりますが"@ja.
<< kg:id_54 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "国保や介護などに市独自での保険料軽減策を講じる"@ja.
<< kg:id_54 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "給食材料費へ補助をして給食費値上げの抑制をするなど、市民生活、福祉充実への市独自の市民負担軽減の工夫や充実が十分に見られなかった"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "酒田市の経済状況が、まだ大変であるとしながら、労働費において予算を大幅に減額している"@ja.
<< kg:id_61 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "雇用創出特別助成事業では、自己都合離職者も対象にする"@ja.
<< kg:id_63 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "教育訓練については対象となる訓練をふやしていく"@ja.
<< kg:id_65 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "未就職学卒者雇用促進助成事業では、１年の雇用だけではなく、半年でも対象にしていく"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "県からのメニューが厳しくなったとして、そのまま減額予算を組んだことも問題です。"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "雇用に結びつく事業であるなら、市独自の取り組みの御努力をすべきであります。"@ja.
<< kg:id_71 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "新年度から新たに国からの交付金があります。これを財源として市独自の横出し事業に取り組むよう求めました"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "住民にきちんと説明もせずに、交通弱者の足である、るんるんバスの八幡日本海総合病院線の路線廃止を行っている"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "福祉乗り合いバスというるんるんバス、これは住民の利便性を進めることで利用促進を図っていくべきものであり"@ja.
<< kg:id_77 prop:cause kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "新年度から窓口業務に対し、委託を行うとしています。きめの細かい市民へのサービス、滞納の相談や個人情報の保護、また孤立死から市民を守るネットワークのかなめとしての機能も水道の窓口業務は担っています。"@ja.
<< kg:id_79 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "公の責任においてきちんと管理すべきものであり、民間委託はすべきではないと考え"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "現在の医療・介護現場では、長時間過密労働に加え、医療技術の進歩や安全への期待の高まり、要介護高齢者の増加などにより、労働環境は悪化し"@ja.
<< kg:id_81 prop:cause kg:id_83 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "現在の医療・介護現場では、長時間過密労働に加え、医療技術の進歩や安全への期待の高まり、要介護高齢者の増加などにより、労働環境は悪化し"@ja.
<< kg:id_81 prop:cause kg:id_84 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "現在の医療・介護現場では、長時間過密労働に加え、医療技術の進歩や安全への期待の高まり、要介護高齢者の増加などにより、労働環境は悪化し"@ja.
<< kg:id_81 prop:cause kg:id_85 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "現在の医療・介護現場では、長時間過密労働に加え、医療技術の進歩や安全への期待の高まり、要介護高齢者の増加などにより、労働環境は悪化し"@ja.
<< kg:id_81 prop:effect kg:id_86 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "労働環境は悪化し、離職者も後を絶たず、深刻な人手不足になっている。"@ja.
<< kg:id_81 prop:effect kg:id_87 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "労働環境は悪化し、離職者も後を絶たず、深刻な人手不足になっている。"@ja.
<< kg:id_81 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "ついては、看護師、介護従事者などの夜勤交代制労働者の労働環境改善を図ること。"@ja.
<< kg:id_81 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "医療・介護職員の十分な確保・定着策を講じること。"@ja.
<< kg:id_81 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "患者・利用者の自己負担を減らし、安全・安心の医療・介護を実現すること。"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "今、人手不足による過密労働と過酷な長時間夜勤で、医療の安全と働く労働者の健康が脅かされ"@ja.
<< kg:id_91 prop:cause kg:id_93 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "今、人手不足による過密労働と過酷な長時間夜勤で、医療の安全と働く労働者の健康が脅かされ"@ja.
<< kg:id_81 prop:effect kg:id_94 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "７割以上の看護職員が慢性疲労を抱え"@ja.
<< kg:id_81 prop:effect kg:id_95 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "年間12万5,000人がやめていく、この実態を改善してほしい。"@ja.
<< kg:id_96 prop:effect kg:id_97 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "山形県医労連の夜勤実態調査票では、月９回以上の夜勤が約47％"@ja.
<< kg:id_96 prop:effect kg:id_98 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "月11回の夜勤も６％あるとしています。"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "庄内地方で最近、看護師の需要バランスが崩れた際、病棟閉鎖に追い込まれた医療機関も実際出ております。"@ja.
<< kg:id_101 prop:cause kg:id_102 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "労働基準法は、労働者に週40時間、１日８時間を超えて労働させてはならないと定め、過重な長時間労働を禁止し、労働者の生命と健康の保護を目指しているが、十分に機能しているとは言えない。"@ja.
<< kg:id_101 prop:effect kg:id_103 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "過労死が労災と認定される件数はふえ続けており"@ja.
<< kg:id_101 prop:effect kg:id_104 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "過労自殺も含めて広がり続けている。"@ja.
<< kg:id_101 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "国が法律を定め、総合的な対策を積極的に行っていく必要があることから、過労死防止基本法の制定を求める"@ja.
<< kg:id_101 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "つきましては、過労死撲滅に向け、下記の事項を踏まえ、過労死防止基本法を早期に制定するよう強く要望いたします。　１　国は、過労死撲滅に向け総合的な対策を講じること。"@ja.
<< kg:id_107 prop:effect kg:id_108 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "労働者を保護するルールの後退の議論がされていることは、働く者の犠牲の上に成長戦略を描くことであり、決して許されない。"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "よって、「解雇の金銭解決制度」・・・などは行わないこと。"@ja.
<< kg:id_109 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "よって、「ホワイトカラーイグゼンプション」の導入・・・などは行わないこと。"@ja.
<< kg:id_109 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "よって、「限定正社員制度の普及」などは行わないこと。"@ja.
<< kg:id_109 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "派遣労働者のより安定した直接雇用への誘導と処遇改善に向けた法改正を行うこと。"@ja.
<< kg:id_109 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "雇用・労働政策にかかわる議論はＩＬＯの三者構成主義にのっとって、労働政策審議会で行うこと"@ja.
}
