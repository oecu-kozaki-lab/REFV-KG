kg:st_3 rdfs:type cls:st_36.
cls:st_36 rdfs:label "委員長"@ja.
kg:op_31 prop:content "請願は労働環境悪化と人手不足を訴えていると報告する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "請願は労働環境悪化と人手不足を訴えていると報告する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "請願は労働環境悪化と人手不足を訴えていると報告する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "請願は労働環境悪化と人手不足を訴えていると報告する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "請願は離職と人手不足の深刻化を訴えていると報告する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "請願は離職と人手不足の深刻化を訴えていると報告する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:st_4 rdfs:label "斎藤周議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_37 prop:content "看護師等の確保や労働条件改善は官民挙げて取り組むべきと主張する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "人手不足解消のため十分な確保と定着策が必要と主張する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "自己負担軽減と人手増で安全安心の医療介護は両立すると主張する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "人手不足と過密労働が医療安全と労働者の健康を脅かしていると訴える"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "人手不足と過密労働が医療安全と労働者の健康を脅かしていると訴える"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:op_42 prop:content "看護職員の慢性疲労は深刻で改善が必要と訴える"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:op_43 prop:content "大量離職の実態改善を求める"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:op_44 prop:content "国の方針とかけ離れた夜勤実態の改善が必要と主張する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:op_45 prop:content "国の方針とかけ離れた夜勤実態の改善が必要と主張する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_4.
kg:op_46 prop:content "一病院の自助努力だけでは限界があると指摘する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:st_5 rdfs:label "建設経済常任委員会委員長"@ja.
kg:st_5 rdfs:type cls:st_36.
kg:op_47 prop:content "個別企業任せでは改善が難しく国の法整備が必要と報告する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "過労死認定件数が増え続けており対策が必要と報告する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_5.
kg:op_49 prop:content "過労自殺も広がっており深刻な社会問題と報告する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_5.
kg:op_50 prop:content "国が法律を定め総合的対策を積極的に行う必要があると主張する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_5.
kg:st_6 rdfs:label "門田克己建設経済常任委員会委員長"@ja.
kg:st_6 rdfs:type cls:st_36.
kg:op_51 prop:content "過労死撲滅のため国の総合対策を早期に求める"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:op_52 prop:content "労働者保護ルールの後退は許されないという請願内容を報告する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_5.
kg:op_53 prop:content "請願は解雇の金銭解決制度の導入中止を求めていると報告する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:op_54 prop:content "請願はホワイトカラーイグゼンプション導入中止を求めていると報告する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_5.
kg:op_55 prop:content "請願は限定正社員制度の普及中止を求めていると報告する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_5.
kg:op_56 prop:content "請願は派遣労働者の直接雇用誘導と処遇改善を求めていると報告する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_5.
kg:op_57 prop:content "請願は労働政策審議会での議論を求めていると報告する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_5.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "東北地方を中心に未曾有の被害をもたらした東日本大震災の発生から本日で３年となりました。この災害で命を奪われた多くの方々の無念の思いと、御遺族の皆様の深い悲しみに思いをいたしますと、哀惜の念にたえません。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "東北地方を中心に未曾有の被害をもたらした東日本大震災の発生から本日で３年となりました。"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
