    prop:text-txt_contents "６月８日には大宮駅での本市独自プロモーション活動"@ja.
<< kg:id_40 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "５月15日・16日にはＪＲびゅうプラザ営業担当者向けの現地研修会に参加するなど、積極的に誘客活動を展開してきたところでございます。"@ja.
<< kg:id_40 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "市民一人一人が観光キャンペーンの主人公となって、県外の親戚や知人に招待はがきを発送し、全国からお客様を誘客するはがき発送キャンペーン"@ja.
<< kg:id_40 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "子供たちのコミュニケーション能力の向上と他人への思いやり、おもてなしの心をはぐくんでもらうための観光学習の教材「カモンくん観光おもてなしガイド」の発行"@ja.
<< kg:id_40 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "ＪＲ酒田駅前から酒田の名所・旧跡など主要７カ所を巡るジャンボタクシー、ＤＣライナーと呼んでおりますが、これを運行しております"@ja.
<< kg:id_40 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "観光用自転車の増設ですとか"@ja.
<< kg:id_40 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "観光ガイドブックなどのリニューアルを行っているところでございます。"@ja.
<< kg:id_40 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "酒田花火ショーなど既存の事業を充実させる"@ja.
<< kg:id_40 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "７月の毎日曜日に、山居倉庫に酒田舞娘が登場し、観光客の皆さんに御挨拶の口上、あるいは酒田の観光案内をしたりする"@ja.
<< kg:id_40 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "土門拳記念館では、ふだん公開していない収蔵庫を見学するバックヤードツアー"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "今年度から、結婚、妊娠・出産、子育てに至るまで切れ目のない支援事業を展開する"@ja.
<< kg:id_56 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "酒田で働くという選択を後押しするための転出抑制ですとか"@ja.
<< kg:id_56 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "若者のＵＩＪターンに向けた取り組みを関係機関と一緒になって進める"@ja.
<< kg:id_56 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "結婚サポーターの増員を図ったり"@ja.
<< kg:id_56 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "交流広場に結婚サポートセンターを新設し"@ja.
<< kg:id_56 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "その事務局機能を担う結婚推進員を配置し、活動を充実させた"@ja.
<< kg:id_63 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "人口減少問題に係る対策本部、私が本部長になるということで内部で詰めておりますけれども、その対策本部をすぐに立ち上げまして"@ja.
<< kg:id_63 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "庁内各部共通認識のもとで、現状、課題及び施策の方向性並びに実施状況や成果等を確認しながら、きめ細かな対策を打ち出していきたい"@ja.
}
