kg:st_1 rdfs:label "高橋正和議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "デジタル化のデメリットを踏まえ通信体制整備が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "消防団活動上のデメリットを解消する体制づくりを求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "桐山久夫建設部技監兼企画振興部危機管理監"@ja.
kg:st_2 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_3 prop:content "継続的な団員確保を進める必要がある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "若い団員の入団促進を継続すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "白崎好行農林水産部長"@ja.
kg:st_3 rdf:type cls:st_32.
kg:op_5 prop:content "サクランボは県を代表し波及効果が大きいため選定された"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "観光型産地づくりにつながる品目として適している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "新規参入には経営上の課題が多い"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "収益化まで時間がかかる点が課題"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "専門性が求められ本市では容易でない"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "専門的な管理が必要で課題が多い"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "専門性の高さが導入の障壁になっている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "農業経営として課題が多い"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "森林資源の整備は欠かせない"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "防災林の整備や計画の見直しが必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "防災林の現状を踏まえた見直しが必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_4 rdfs:label "進藤晃議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_16 prop:content "企業誘致に加え地元中小企業支援が重要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "就職後のフォローアップが必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "本人だけでなく雇用側の対応も考えるべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "離職理由の把握と分析が必要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "雇い入れ側の対応や対策も必要"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "高速鉄道は地域発展に不可欠で早期実現を望む"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "地域経済や県民生活への影響から強く望まれる"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:st_5 rdfs:label "門田克己議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_23 prop:content "危機感を持って全庁的に取り組むべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "若者に夢を与えるまちづくりが困難になると懸念する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "地域社会の維持に重大な支障を来たす"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:op_26 prop:content "地域社会の維持に影響が及ぶ"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "地域防災機能にも重大な支障が出る"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "地域社会の支え手不足につながる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "将来のまちづくりに大きな懸念がある"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:st_6 rdfs:label "大壁洋平議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_30 prop:content "おもてなし次第で交流人口拡大につながる"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_6.
kg:op_31 prop:content "口コミも含めリピーター増加に影響する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_6.
kg:op_32 prop:content "現在の進捗状況を確認したい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:op_33 prop:content "誘客の進捗確認が必要"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:st_7 rdfs:label "丸山至市長職務代理者副市長"@ja.
kg:st_7 rdf:type cls:st_32.
kg:op_34 prop:content "積極的に誘客活動を展開している"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_7.
kg:op_35 prop:content "本市独自の誘客活動を実施している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_7.
kg:op_36 prop:content "営業担当者への現地訴求を行っている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_7.
kg:op_37 prop:content "市民が主人公となる機運醸成策として重要"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_7.
kg:op_38 prop:content "子供たちのおもてなしの心を育む"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_7.
kg:op_39 prop:content "主要観光地を巡る受け入れ体制整備として有効"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_7.
kg:op_40 prop:content "受け入れ体制整備の一環として進めている"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_7.
kg:op_41 prop:content "観光客受け入れ環境の改善を進めている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_7.
kg:op_42 prop:content "魅力あるイベントとして既存事業を強化している"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_7.
kg:op_43 prop:content "観光客への挨拶と案内でおもてなしを図る"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_7.
kg:op_44 prop:content "普段見られない魅力を提供する企画"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_7.
kg:op_45 prop:content "主要施策の柱として一体的に進める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_7.
kg:op_46 prop:content "若者の定着促進に取り組む"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_7.
kg:op_47 prop:content "関係機関と連携して進める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_7.
kg:op_48 prop:content "結婚支援の充実を進める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_7.
kg:op_49 prop:content "結婚支援機能を強化している"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_7.
kg:op_50 prop:content "活動を充実させ成果につなげている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_7.
kg:op_51 prop:content "総合的かつ戦略的に推進するため早急に設置する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "きめ細かな対策を打ち出したい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_7.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "アナログ簡易業務用無線の使用期限は、2022年11月30日となっておるようです。それ以降は使用ができなくなるため、その後継がデジタル簡易無線免許局使用にかわるようです。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "アナログ簡易無線機の使用が、平成28年５月31日をもって使用停止になると言われております。"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "新入団員の確保も容易ではないため、高齢化に伴い、団員も年々少しずつ減少しているのが現状であります。"@ja.
<< kg:id_4 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "新入団員の確保も容易ではないため、高齢化に伴い、団員も年々少しずつ減少しているのが現状であります。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "山形県の農業産出額2,155億円のうち、サクランボの産出額が275億円ということで、山形県を代表する果物となっており"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "観光産業など他産業に対する波及効果が大きいため、今回サクランボが選定されたものであり"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "初期投資が非常にかかり、収入が得られるようになるまで約５年から10年かかる"@ja.
<< kg:id_10 prop:cause kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "収入が得られるようになるまで約５年から10年かかる"@ja.
<< kg:id_10 prop:cause kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "庄内での取り組みは、受粉樹の管理や、受粉のためのミツバチの飼育、または毛ばたきによる受粉作業などの専門性が求められ"@ja.
<< kg:id_10 prop:cause kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "受粉樹の管理や、受粉のためのミツバチの飼育"@ja.
<< kg:id_10 prop:cause kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "毛ばたきによる受粉作業などの専門性が求められ"@ja.
<< kg:id_10 prop:cause kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "１樹園地、サクランボを１団地として行う必要があるため、農業経営としては課題が多く"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "温暖化対策の一翼を担っている森林資源の整備は欠かせないことだと思います"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "東日本大震災の発生後、平成23年５月には海岸沿いの森林、海岸防災林について、改めてその機能の検証と再生に向けた課題を検討する指示が出たようです。"@ja.
<< kg:id_19 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "一方では、根こそぎやられてしまった防災林もあったようです。"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "しかしながら個人消費や地元中小企業の業況判断は依然厳しいものがあります。このことから、企業誘致活動を推進することは重要であるものの、喫緊の状況からすると地元中小企業を支援することが重要であると考えます。"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "若者の早期離職理由には、仕事が合わない、おもしろくない、あるいは、ほかにやりたいことがある、職場の人間関係のトラブルなどが挙げられます"@ja.
<< kg:id_24 prop:cause kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "若者の早期離職理由には、仕事が合わない、おもしろくない"@ja.
<< kg:id_24 prop:cause kg:id_27 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "若者の早期離職理由には、仕事が合わない、おもしろくない、あるいは、ほかにやりたいことがある"@ja.
<< kg:id_24 prop:cause kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "若者の早期離職理由には、仕事が合わない、おもしろくない、あるいは、ほかにやりたいことがある、職場の人間関係のトラブルなどが挙げられます"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "庄内地域における高速鉄道は必要不可欠であり、早期の実現を望むことからすれば、特に、山形新幹線の庄内延伸に期待するところであります。"@ja.
<< kg:id_29 prop:cause kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "こうした高速交通網の整備は、首都圏とのビジネス業務や地域産業の発展のほか、庄内と内陸、あるいは仙台といった地域と地域の結びつきを促すなど、その役割はますます大きくなってきており、地域経済活動への結びつき、県民生活へのかかわり合いなどから、山形新幹線の庄内延伸について、強く望まれます。"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "これは、地方から都市部への人口移動が今後も続くと想定されることと"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "出産の中心となる20歳から39歳年代に着目しており、この層の人口が現在の半分以下になる自治体では、出生率を幾ら上げても人口増は望めないとして"@ja.
<< kg:id_32 prop:effect kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "懸念されるのは、税収減、地域コミュニティ機能のみならず"@ja.
<< kg:id_32 prop:effect kg:id_36 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "懸念されるのは、税収減、地域コミュニティ機能のみならず"@ja.
<< kg:id_32 prop:effect kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "消防団員の確保、各種ボランティア活動などといった、さまざまな地域社会の維持に重大な支障を来たす"@ja.
<< kg:id_32 prop:effect kg:id_38 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "消防団員の確保、各種ボランティア活動などといった、さまざまな地域社会の維持に重大な支障を来たす"@ja.
<< kg:id_32 prop:effect kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "この状況では、若者に夢を与えるまちづくりは困難になることを懸念するものであります。"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "来ていただいた観光客に対して、どのようにイベント企画、おもてなしをするかで、今後の交流人口の拡大、リピーターの増加にかかわってきます。"@ja.
<< kg:id_40 prop:effect kg:id_42 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "来ていただいた観光客に対して、どのようにイベント企画、おもてなしをするかで、今後の交流人口の拡大、リピーターの増加にかかわってきます。口コミの力も侮れません。"@ja.
<< kg:id_40 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "庄内地域や本市への誘客のため、旅行エージェント85社への訪問や、本市観光素材・受け入れ企画約200件の提案を行っていく"@ja.
<< kg:id_40 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "本市観光素材・受け入れ企画約200件の提案を行っていく"@ja.
<< kg:id_40 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "６月３日でございますが、東京駅での山形フェアへの参加"@ja.
<< kg:id_40 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_7;
