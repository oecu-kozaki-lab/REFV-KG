kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_3.
kg:op_88 prop:content "日本海総合病院と酒田医療センターの診療体制の充実を図る"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_3.
kg:op_89 prop:content "県が策定する地域医療ビジョンと整合をとりながら進める"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_3.
kg:op_90 prop:content "市民生活に直結する基盤を維持する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_3.
kg:op_91 prop:content "機能向上を検討する"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_3.
kg:op_92 prop:content "住宅改修支援を継続する"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_3.
kg:op_93 prop:content "公園環境を整える"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_3.
kg:op_94 prop:content "公園の魅力向上を図る"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_3.
kg:op_95 prop:content "生活排水対策を計画的に進める"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_3.
kg:op_96 prop:content "浸水対策を進める"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_3.
kg:op_97 prop:content "浸水対策を進める"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_3.
kg:op_98 prop:content "改築に向けて準備を進める"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_3.
kg:op_99 prop:content "酒田地区広域行政組合への分賦金を負担する"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_3.
kg:op_100 prop:content "地域特性を生かし地域活性化にもつなげる"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_3.
kg:op_101 prop:content "災害等による大規模停電に備える"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_3.
kg:op_102 prop:content "市民サービスの向上と行政の効率化を進める"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_3.
kg:op_103 prop:content "文書量の削減などを推進する"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_3.
kg:op_104 prop:content "アセットマネジメントによる効率的な施設運営に努める"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_3.
kg:op_105 prop:content "着実に準備を進める"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_3.
kg:op_106 prop:content "財政基盤の強化を図る"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_3.
kg:op_107 prop:content "財務情報の説明責任の充実と行財政運営の効率化適正化を強化する"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_3.
kg:op_108 prop:content "魅力ある地方都市として存在感を示す必要がある"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_4.
kg:op_109 prop:content "公約の一丁目一番地として最重視する"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_4.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "2040年度までに若年女性が半数以下に減り、公共サービスの維持ができなくなる自治体になってしまう"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:text-txt_contents "改めて地方の人口問題の深刻さが認識されました"@ja.
<< kg:id_3 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "このため、国においては地方創生を最重要課題と位置づけ、地域経済の活性化と人口減少対策に数値目標を掲げて取り組み"@ja.
<< kg:id_3 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "自治体は2060年度までの地方人口ビジョンと2019年までの地方版総合戦略を策定していくことが求められています"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本市では、総合計画で、人口減少・少子化対策を大きな施策の柱として掲げ、若者の地元定着や子育て支援などに先駆的に取り組んでまいりました"@ja.
<< kg:id_9 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "中でも山形新幹線庄内延伸は、消滅可能性都市から脱却し、持続的に発展していくために必要不可欠な取り組みであります"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:text-txt_contents "山形新幹線の庄内延伸は、県都とのアクセスを飛躍的に改善し"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:text-txt_contents "域内交流を推進するとともに"@ja.
<< kg:id_11 prop:effect kg:id_14 >>
    prop:text-txt_contents "県土の一体的発展に極めて大きな役割を果たします"@ja.
<< kg:id_11 prop:effect kg:id_15 >>
    prop:text-txt_contents "酒田市だけではなく庄内全体の魅力を存分に情報発信することが可能になります"@ja.
<< kg:id_11 prop:effect kg:id_16 >>
    prop:text-txt_contents "総合効果として人口減少抑制効果をもたらします"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "深刻な人口減少問題に直面する今こそ、山形新幹線の庄内延伸実現に向けての取り組みを進め、新たな活力を生み出し、持続可能な地域社会の構築を目指してまいります"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:text-txt_contents "婚姻数の減少や晩婚化が進行しています"@ja.
<< kg:id_21 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "出会いの場を創出するための結婚サポーター活動に取り組む"@ja.
<< kg:id_21 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "農業委員会や各総合支所においても、それぞれの特性を生かしたイベント開催などによる結婚支援に取り組んでまいります"@ja.
<< kg:id_21 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "婚活に取り組む民間団体と協力して、情報の共有と一元的な情報発信を行ってまいります"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "子供の医療費無料化を中学３年生まで拡大するとともに"@ja.
<< kg:id_25 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "不妊治療を受けた御夫婦に対する助成経費の増額"@ja.
<< kg:id_25 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "男性の育児参加を促す手帳の作成、配布"@ja.
<< kg:id_25 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "子育て支援センター相談員及び児童センター児童厚生員の増員"@ja.
<< kg:id_25 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "学童保育所の開所時間の延長"@ja.
<< kg:id_25 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "亀ケ崎学区学童保育所の建設"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "今春の高卒者の就職内定状況は、10年ぶりに地元定着率が６割を超えました"@ja.
<< kg:id_32 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "地元企業の見学会や若手社員との交流を充実させるなど、地元就職の機運醸成を図ってまいります"@ja.
<< kg:id_35 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "県外で開催される合同就職ガイダンスへの地元企業参加を支援するとともに"@ja.
<< kg:id_35 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "ＵＩＪターン希望者を対象に、市内企業の紹介や意見交換を行う見学ツアーを開催いたします"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "東京在住者の約４割が地方に移住を予定、検討したいと考えているという内閣府の調査結果があることから"@ja.
<< kg:id_38 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "市役所における移住相談窓口の一元化を図る"@ja.
<< kg:id_38 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "移住、定住に関する情報発信の充実"@ja.
<< kg:id_38 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "移住を後押しする支援策の創設などに取り組んでまいります"@ja.
<< kg:id_43 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "山形新幹線の庄内延伸は、冒頭申し上げましたとおり、この地域が持続的に発展していくために必要不可欠な交通インフラです"@ja.
<< kg:id_11 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "関係機関の理解促進や市民・県民の機運醸成を図るため、沿線市町村と連携し、積極的に事業を展開してまいります"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "酒田駅周辺については、具体的な整備に向けた一連の手続を前進させ、基本計画の策定に取り組んでまいります"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "地域活性化を図るため、日本海沿岸東北自動車道、新庄酒田道路、国道７号広野興屋地区４車線化、国道344号安田バイパス、国道112号浜中バイパス、一般県道余目松山線・庄内橋の架け替えなどの整備促進を国・県に積極的に働きかけてまいります"@ja.
<< kg:id_47 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "新庄酒田道路"@ja.
<< kg:id_47 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "国道７号広野興屋地区４車線化"@ja.
<< kg:id_47 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "国道344号安田バイパス"@ja.
<< kg:id_47 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "国道112号浜中バイパス"@ja.
<< kg:id_47 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "一般県道余目松山線・庄内橋の架け替え"@ja.
<< kg:id_54 prop:effect kg:id_55 >>
    prop:text-txt_contents "昨年、国際定期コンテナ航路の３便目が就航するとともに"@ja.
<< kg:id_54 prop:effect kg:id_56 >>
    prop:text-txt_contents "コンテナ貨物取扱量も過去最高を更新し"@ja.
<< kg:id_54 prop:effect kg:id_57 >>
    prop:text-txt_contents "移動式荷役機械も２台目が導入されるなどの機能向上が図られました"@ja.
<< kg:id_54 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "さらなる機能強化を図るため、耐震強化岸壁の整備着手や防波堤整備の促進など、国・県に働きかけてまいります"@ja.
<< kg:id_54 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "防波堤整備の促進など、国・県に働きかけてまいります"@ja.
<< kg:id_54 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "観光振興と連携したクルーズ客船誘致による地域経済への波及と酒田港のイメージアップを図ってまいります"@ja.
<< kg:id_61 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "市、金融機関、商工団体等で組織する協議会を開催し、中小企業等への支援施策の情報共有を図る"@ja.
<< kg:id_61 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "意欲のある中小企業の販路拡大や競争力強化の取り組みを支援してまいります"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "企業立地のための用地取得と立地促進のための助成を行う"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "雇用創造協議会において人材育成に取り組む"@ja.
<< kg:id_64 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "工場立地の際の規制要件を緩和するなど、雇用の場の拡大、企業誘致促進のための環境整備を図ってまいります"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "本市の観光における現状把握や課題を抽出し、観光における方向性や目標を定め、関係機関が一体となって取り組むための体制整備を構築してまいります"@ja.
<< kg:id_69 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "旧商業高校跡地等については、本市最大の観光拠点である山居倉庫との連携や調和を図りながら、にぎわいの創出につながるように、一体的な活用について検討を行う"@ja.
<< kg:id_69 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "観光資源の創出のため、中心市街地などでの夜間景観の形成に取り組みます"@ja.
<< kg:id_69 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "遊佐町、由利本荘市、にかほ市と連携し、平成28年度中の鳥海山・飛島ジオパークの認定に向けた取り組みを進めてまいります"@ja.
<< kg:id_74 prop:cause kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "昨今の地域農業を取り巻く環境は、米価の大幅な下落など大変厳しいものになっており"@ja.
<< kg:id_74 prop:effect kg:id_76 >>
    prop:text-txt_contents "地域農業を取り巻く環境は、米価の大幅な下落など大変厳しいものになっており"@ja.
<< kg:id_77 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "米価の下落などの対策については、県と協調して緊急資金に対する利子補給支援を行う"@ja.
<< kg:id_79 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "おいしい米の生産を促進するため、耕畜連携の堆肥散布による土づくり等を支援いたします"@ja.
<< kg:id_81 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "食育を通した米消費拡大として、学校給食においてつや姫給食の回数をふやす"@ja.
<< kg:id_81 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "酒田産米粉を100％使用した米粉パン給食を市内の全小中学校に拡大いたします"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "本市独自の農地集積センターを核とした利用集積を促進するとともに"@ja.
<< kg:id_86 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "若手女性農業者の交流・学習の機会を創出いたします"@ja.
<< kg:id_88 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "新規開発品種、酒田まめほの香とあねちゃまめの栽培促進を図る"@ja.
<< kg:id_90 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "本市特産の平田赤ねぎを、「全国ねぎサミット」の開催を契機に、全国に売り込んでまいります"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "山林の荒廃を防ぐため、森林所有者の意欲を喚起し間伐材の搬出を促進いたします"@ja.
<< kg:id_94 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "中型イカ釣り船や種苗放流に対する支援を継続するとともに"@ja.
<< kg:id_96 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "「全国豊かな海づくり大会」の成功に向けて、市民の機運醸成を図るためのプレイベントを開催いたします"@ja.
<< kg:id_98 prop:cause kg:id_99 >>
    prop:text-txt_contents "依然として高齢化や人口減少が著しい地区であることから"@ja.
<< kg:id_98 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "島の機能維持と活性化に取り組んでいる島民、大学、ＮＰＯ、県、市が一体となったとびしま未来協議会の運営を支援するとともに"@ja.
<< kg:id_98 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "緑のふるさと協力隊などの外部人材のマンパワーを生かしてまいります"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "本市は、平成25年度に高齢化率が30％を超え、全国と比較して高くなっています"@ja.
<< kg:id_102 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "疾病予防や生活習慣改善対策を初め"@ja.
<< kg:id_102 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "生涯学習や生涯スポーツなどの充実による生きがいづくりや社会参加の推進を図ってまいります"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "在宅医療と介護サービスを一体的に提供するための在宅医療介護連携支援センターを開設します"@ja.
<< kg:id_106 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "住まい・医療・介護・予防・生活支援が一体的に提供される地域包括ケアシステムの構築に努めてまいります"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "総合教育会議を設置し、教育の条件整備など重点的に講ずべき施策等について、教育委員会と協議、調整を行う"@ja.
<< kg:id_109 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "教育の振興に関する大綱を策定し、本市における教育施策の総合的な推進を図ってまいります"@ja.
<< kg:id_112 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "現在の松山小学校を改修し、松山地区の統合小学校として活用するための設計、地盤調査などを行います"@ja.
<< kg:id_112 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "鳥海八幡中学校の武道場新築"@ja.
<< kg:id_112 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "地見興屋小学校屋内運動場天井改修に取り組んでまいります"@ja.
<< kg:id_116 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "新たに北前船寄港地の交流として、秋田市の竿灯と本市の大獅子を活用した相互交流等を実施し、交流人口の拡大を図ってまいります"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:text-txt_contents "他者とのつながりがなく社会から孤立する方や"@ja.
<< kg:id_118 prop:cause kg:id_120 >>
    prop:text-txt_contents "通院・買い物・除雪が困難で支援が必要な方の増加が課題として浮かび上がってきています"@ja.
<< kg:id_118 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "地域住民の支え合い活動や社会福祉協議会、ＮＰＯ法人、ボランティアなどの地域における連携、協働による福祉活動を支援し"@ja.
<< kg:id_122 prop:cause kg:id_123 >>
    prop:text-txt_contents "加齢による運動器の障害などにより、要介護になるリスクの高い状態であるロコモティブシンドローム"@ja.
<< kg:id_124 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "ロコモティブシンドロームを防ぐ取り組みとして、新しい地域支援事業の拡充にも力を入れてまいります"@ja.
<< kg:id_126 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "「中町にぎわいプラザ（仮称）」を整備し、健康づくりと街のにぎわいづくりを融合させた市街地の活性化にも取り組みます"@ja.
<< kg:id_128 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "酒田市体育協会への支援を拡充し、市民スポーツの普及拡大、競技スポーツの強化を図ってまいります"@ja.
<< kg:id_130 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "国体記念体育館の照明を低電力・長寿命のＬＥＤ照明に更新するなど、安全で快適なスポーツ環境の整備に努めてまいります"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "没後25年を迎える土門拳氏の企画展示及び写真フィルム劣化対策、写真を生かしたまちづくりなどにも取り組んでまいります"@ja.
<< kg:id_134 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "建物の老朽化が著しく耐震性に乏しい消防本署の移転改築"@ja.
<< kg:id_134 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "市街地分署の再配置整備について着手いたします"@ja.
<< kg:id_134 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "本市の防災拠点としての機能を持つ「総合防災センター（仮称）」について、消防本署と一体的に検討してまいります"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "全国瞬時警報システムからの防災情報を、コミュニティＦＭ放送を通じて緊急に市民に伝達するシステムを整備し、市民への迅速な防災情報の提供を行う"@ja.
<< kg:id_140 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "現場での緊急対応能力の向上を図るため、消防団員へトランシーバーを配備するなど装備の充実を図ってまいります"@ja.
<< kg:id_142 prop:cause kg:id_143 >>
    prop:text-txt_contents "政府が昨年公表した津波の高さ推計により、島民の不安が増していることから"@ja.
<< kg:id_142 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "最終避難場所となる飛島小中学校グラウンドに一時避難施設を兼ねた防災資機材庫を整備してまいります"@ja.
<< kg:id_145 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "飛島地区の避難路に面し危険な状態となっている物件について、安全を確保した上で跡地をポケットパークとして活用してまいります"@ja.
<< kg:id_147 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "移住促進活動を行う民間団体と協力しながら、空き家による移住体験の機会を提供するなど、空き家の利活用にも取り組んでまいります"@ja.
<< kg:id_149 prop:cause kg:id_150 >>
    prop:text-txt_contents "年々複雑化、多様化、高度化している消費生活相談"@ja.
<< kg:id_149 prop:contermeasure kg:id_151 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "相談員の研修参加など、消費生活センターを中心とした相談窓口体制の強化を図る"@ja.
<< kg:id_152 prop:contermeasure kg:id_153 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "消費者講座の開催やＦＭ放送による啓発など、消費者行政の一層の充実に取り組み、安全・安心な住みよい環境づくりに努めてまいります"@ja.
<< kg:id_154 prop:effect kg:id_155 >>
    prop:text-txt_contents "新市庁舎については、多少のおくれはあるものの"@ja.
<< kg:id_154 prop:contermeasure kg:id_156 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "第１期開庁に向けて鋭意建設工事を進めております"@ja.
<< kg:id_157 prop:contermeasure kg:id_158 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "市民の皆様が効率的に手続を行えるよう、総合窓口の開設によるワンストップ化を図る"@ja.
<< kg:id_157 prop:contermeasure kg:id_159 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "より一層の利便性向上のため、住民票等のコンビニ交付システムを導入してまいります"@ja.
<< kg:id_160 prop:contermeasure kg:id_161 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "地方独立行政法人山形県・酒田市病院機構に対し、運営及び医療機器の整備、施設改修に係る費用を県とともに負担することにより、日本海総合病院と酒田医療センターの診療体制の充実を図ってまいります"@ja.
<< kg:id_160 prop:contermeasure kg:id_162 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "県が策定する地域医療ビジョンと整合をとりながら、持続可能な地域医療体制の確保に向けた検討を進めてまいります"@ja.
<< kg:id_163 prop:contermeasure kg:id_164 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "市民生活に直結する市道や橋梁については、計画的に維持管理を行う"@ja.
<< kg:id_163 prop:contermeasure kg:id_165 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "中町モールの機能向上の検討を行ってまいります"@ja.
<< kg:id_166 prop:contermeasure kg:id_167 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "住宅については、耐震化、省エネ化、バリアフリー化に係るリフォームに、県と協調して支援を継続してまいります"@ja.
<< kg:id_168 prop:contermeasure kg:id_169 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "公園については、老朽化した設備、遊具の整備、更新を行う"@ja.
<< kg:id_170 prop:contermeasure kg:id_171 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "日和山公園を潤いのある市民の憩いの場として魅力を高めるための検討を行ってまいります"@ja.
<< kg:id_172 prop:contermeasure kg:id_173 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "生活排水対策については、長期的な視点で計画的に処理施設、管渠等の維持管理を進め"@ja.
<< kg:id_174 prop:contermeasure kg:id_175 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "集中豪雨による浸水対策については、浜田地区での貯留槽整備を進める"@ja.
<< kg:id_174 prop:contermeasure kg:id_176 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "高砂地区では実施設計を行ってまいります"@ja.
<< kg:id_177 prop:cause kg:id_178 >>
    prop:text-txt_contents "現施設の老朽化が進む酒田市斎場については"@ja.
<< kg:id_177 prop:contermeasure kg:id_179 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "改築に向けた地盤調査、設計、用地取得及び造成を行ってまいります"@ja.
<< kg:id_180 prop:contermeasure kg:id_181 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "ごみ処理施設については、循環型社会形成推進地域計画を形成し、施設の安定稼働に努めるため、酒田地区広域行政組合への分賦金を負担してまいります"@ja.
<< kg:id_182 prop:contermeasure kg:id_183 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "再生可能エネルギーの活用については、本市の地域特性を生かし、地域の活性化にもつなげていくため、風力発電事業を継続して取り組んでまいります"@ja.
<< kg:id_184 prop:contermeasure kg:id_185 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "災害等による大規模停電時の市民生活の安全・安心確保のため、ひらたタウンセンター等に太陽光発電設備と蓄電池、太陽光を活用した街路灯を設置いたします"@ja.
<< kg:id_186 prop:contermeasure kg:id_187 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "マイナンバー制度の実施による市民サービスの向上と行政の効率化に向けた体制づくりを進める"@ja.
<< kg:id_188 prop:contermeasure kg:id_189 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "公文書ファイリングシステムを導入し、文書管理の適正化、文書量の削減などを推進いたします"@ja.
<< kg:id_190 prop:contermeasure kg:id_191 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "公共施設のあり方、再編の方向性を定めた適正化実施計画を策定し、アセットマネジメントによる効率的な施設運営に努めてまいります"@ja.
<< kg:id_192 prop:contermeasure kg:id_193 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "公共下水道事業については、水道事業との組織統合、公営企業法の適用に向け、着実に準備を進めてまいります"@ja.
<< kg:id_194 prop:contermeasure kg:id_195 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "健全財政の維持については、利用見込みのない市有財産を積極的に処分するとともに"@ja.
<< kg:id_194 prop:contermeasure kg:id_196 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "市民や議会に対する財務情報の説明責任の充実と行財政運営の効率化、適正化の強化を目的とした統一的な基準による財務書類等を作成できるよう、その環境整備を行ってまいります"@ja.
<< kg:id_197 prop:contermeasure kg:id_198 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "人口減少社会にあっても、魅力ある地方都市としてその存在感を示す必要があります。この地域の将来の発展をしっかりと見据えて、地方版総合戦略を組み立て、一歩一歩着実に市民の幸福につながる施策に取り組んでまいります"@ja.
<< kg:id_199 prop:contermeasure kg:id_200 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "とりわけ公約の一丁目一番地ともいえる山形新幹線庄内延伸の実現については、オール酒田の力強い支えをいただきながら全力を傾注してまいります"@ja.
}
