kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "人口減少抑制へ優先的に施策を展開すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "将来にわたり活力に満ちたまちの維持には人口減少抑制が不可欠"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "4つの基本目標を実現し減少を抑えたい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "活力あるまち維持のため最優先で進める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "若者が住む活力ある地域にする必要がある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "4つの基本目標で人口減少を抑えたい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "4つの基本目標で人口減少を抑えたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "4つの基本目標で人口減少を抑えたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "4つの基本目標で人口減少を抑えたい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "施策効果を早く出すためアクセルを踏み込む"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "環境変化に対応できる強い農業を実現する必要がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "農業者の不安に対応する対策に取り組む"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "大口需要先の開拓と販路拡大を進める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "森林所有者の意欲を喚起する必要がある"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "市が率先して森林整備に取り組む"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "森林整備支援を拡大する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "支援体制を拡充し島の機能維持と活性化に取り組む"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "島民や大学やNPOや県市が一体となる取り組みを支援する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "保育料負担を軽減し子育て支援を進める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "第2子第3子以降の保育料負担を軽減する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "飛島での高齢者の生活支援を強化する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "さらなる発達支援体制の強化を図る"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "関係機関と連携し円滑な支援を進める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "地震津波火災の複合災害から市民の命を守る必要がある"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "総合的に備えを進める"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "地震への備えを総合的に進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "津波への備えを進める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "火災への備えも含め災害に強いまちづくりを推進する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "防災減災体制を充実強化する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "消防体制を整備する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "地震対策を進める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "防災情報体制を強化する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "地域への情報伝達を強化する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "避難所機能を確保する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "速やかにAED設置を行う"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "防犯対策の観点から市管理へ移す"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "ごみ処理施設の安定稼働を確保する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "環境共生社会の実現へ進める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "有料化も含め検討を進める"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "行財政改革を着実に推進する必要がある"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "持続的発展のため効率的な行政運営が必要"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "課題解決に向けて行財政改革を着実に進める"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "財政負担軽減と計画的保全体制を進める"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "公共施設等の管理と保有のあり方を整理する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "職員育成と公務能率向上を図る"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "資産債務の適切な管理効果による健全財政維持を図る"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "このまま何も手を打たなければ、平成22年と比較した30年後の人口減少率が36％に達し"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "平成22年と比較した30年後の人口減少率が36％に達し、県内平均の28.5％を大きく上回るという深刻な状況になっています"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本市の総人口は、前述の推計に準拠しますと、2060年には４万8,000人程度まで減少することが見込まれます"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "将来にわたって活力に満ちたまちを維持するためには、少子高齢化への対応と人口減少の抑制が不可欠であり、何よりも優先してそのための施策を展開する必要があります"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "若者が住み、活力ある地域となるためには、働く場を創出し、他地域への人口の流出を抑え、流入をふやす、訪れて楽しい魅力あるまちにしていかなければなりません"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "これを、働きたいがかなう酒田をつくる、酒田への新しい人の流れをつくる、結婚・出産・子育ての希望がかなう酒田をつくる、つながりと安心にあふれた住み続けたい酒田をつくるの４つの基本目標を実現することで"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "これを、働きたいがかなう酒田をつくる、酒田への新しい人の流れをつくる、結婚・出産・子育ての希望がかなう酒田をつくる、つながりと安心にあふれた住み続けたい酒田をつくるの４つの基本目標を実現することで"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "これを、働きたいがかなう酒田をつくる、酒田への新しい人の流れをつくる、結婚・出産・子育ての希望がかなう酒田をつくる、つながりと安心にあふれた住み続けたい酒田をつくるの４つの基本目標を実現することで"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これを、働きたいがかなう酒田をつくる、酒田への新しい人の流れをつくる、結婚・出産・子育ての希望がかなう酒田をつくる、つながりと安心にあふれた住み続けたい酒田をつくるの４つの基本目標を実現することで"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "施策の効果が少しでも早くあらわれるように、平成28年度は、車に例えればアクセルを思いっきり踏み込んで、酒田のまち・ひと・しごとの創生に向け全力を傾注してまいります"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "平成30年以降は国による米の生産数量目標の配分が廃止される予定となっています。米価の下落が懸念される"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "米価の下落が懸念されるなど、農業者の間では不安が広がっている中"@ja.
<< kg:id_12 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "米政策については、大口需要先の開拓、販路拡大が期待される業務用良食味米品種の新たな作付に取り組む団体に対して、現行主力品種であるはえぬきに比べ余計にかかる生産経費を支援します"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "林業については、山林の荒廃を防ぎ、森林所有者の意欲を喚起するため"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "市が率先して市有林の間伐、作業道の整備に取り組む"@ja.
<< kg:id_16 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "北庄内森林組合等が行う計画的かつ適切な森林整備に対する支援を拡大します"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "飛島は、近年移住者が見られるものの、依然として高齢化や人口減少が著しいことから、とびしま総合センター職員の増員など支援体制を拡充し、島の機能維持と活性化に取り組んでいる"@ja.
<< kg:id_20 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "依然として高齢化や人口減少が著しいことから、とびしま総合センター職員の増員など支援体制を拡充し、島民、大学、ＮＰＯ、県、市が一体となって島の機能維持と活性化に取り組んでいるとびしま未来協議会の運営を引き続き支援してまいります"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "子育ての経済的負担を減らすために、保育園、幼稚園などの入園２人目の保育料軽減と３人目以降の無料化の拡充策として"@ja.
<< kg:id_23 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "小学６年生までの兄、姉から第１子として数える内容に要件を緩和し、これにより第２子、第３子以降の保育料負担を軽減します"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "飛島での高齢者の生活支援として、65歳以上の在島者を対象とした飛島定期航路運賃の補助回数を拡充します"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "義務教育前の発達障がい児の相談者数が近年上昇傾向にあることから、さらなる発達支援体制の強化を図ってまいります"@ja.
<< kg:id_28 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "関係機関と連携し、円滑な発達障がい児への支援を進めているところですが、義務教育前の発達障がい児の相談者数が近年上昇傾向にあることから、さらなる発達支援体制の強化を図ってまいります"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "本市の被害想定では、津波による浸水被害だけでなく"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "地震の揺れがもたらす被害も大きいことが想定されました"@ja.
<< kg:id_31 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "家屋の耐震化促進等の地震への備えや"@ja.
<< kg:id_31 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "避難場所、避難路等の津波への備え"@ja.
<< kg:id_31 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "消防体制の整備等の火災への備えに総合的に取り組み、安全で安心して生活できる災害に強いまちづくりを推進してまいります"@ja.
<< kg:id_31 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "総合防災センター（仮称）の整備に向けた用地取得等や"@ja.
<< kg:id_31 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "消防署中央分署の整備を進める"@ja.
<< kg:id_31 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "防災ベッド等の設置工事に対する補助"@ja.
<< kg:id_31 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "八幡地域における防災行政無線のデジタル化"@ja.
<< kg:id_31 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "防災ラジオの自治会長等への貸与"@ja.
<< kg:id_31 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "避難所への食料・飲料水の備蓄等を行ってまいります"@ja.
<< kg:id_43 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "現在ＡＥＤ（自動体外式除細動器）が設置されていないコミュニティセンターの全てに、速やかにＡＥＤの設置を行ってまいります"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "これまで自治会の管理となっていた防犯灯を市の管理とし、省電力長寿命のＬＥＤ照明への切りかえを進めてまいります"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "ごみ処理施設の安定稼働のため、酒田地区広域行政組合への分賦金を負担してまいります"@ja.
<< kg:id_47 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "並行して、ごみの減量化や資源回収を推進し"@ja.
<< kg:id_47 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "家庭から排出されるごみの有料化に向けた検討も進めてまいります"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "平成28年度から合併算定替の措置が漸減し、本市の財政を取り巻く環境が厳しくなります"@ja.
<< kg:id_51 prop:effect kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "本市の財政を取り巻く環境が厳しくなります"@ja.
<< kg:id_51 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "新たな行財政改革推進計画をスタートさせるとともに、課題の解決に向けた検討を行うことにより、行財政改革を着実に推進してまいります"@ja.
<< kg:id_51 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "公共施設における財政負担の軽減と計画的な保全体制のあり方についてまとめた公共施設長寿命化計画を策定するとともに"@ja.
<< kg:id_51 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "インフラを含めた本市が保有する公共施設等の管理の考え方や保有のあり方をまとめた公共施設等総合管理計画を策定するとともに"@ja.
<< kg:id_51 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "より高い能力を持った職員の育成と、組織全体の公務能率の向上を目的とした人事評価制度を導入し"@ja.
<< kg:id_51 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "資産、債務の適切な管理効果による健全財政の維持を図るために、新公会計制度の導入を着実に進めてまいります"@ja.
}
