kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "安定的な上下水道の提供と効率的で健全な経営に努める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "返礼品の充実とインターネット活用で寄附者増加を図る"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "クラウドファンディング活用や新たな返礼品設定で自主財源を確保する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "荒生令悦予算特別委員会委員長"@ja.
kg:st_2 rdfs:type cls:st_89.
cls:st_89 rdfs:label "議会"@ja.
kg:op_4 prop:content "後年度の財源不足に備える基金積立金の増額が主な内容"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "インバウンド拡大活動への支援に取り組む"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "市民一丸となって外国クルーズ船受け入れを成功させたい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "松山小学校と田沢小学校の改修工事を進める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "飛島の魅力発信に取り組む"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_3 rdfs:label "門田克己議会運営委員会委員長"@ja.
kg:st_3 rdfs:type cls:st_89.
kg:op_9 prop:content "市の行政組織の変更に伴う改正が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "市の行政組織の変更に対応する改正"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "地方創生に向け知恵と工夫を出す必要がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "市民総ぐるみのしっかりとした交流促進体制を構築する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "認定されれば北前船ブランド発信と観光交流を柱に地域活性化を進める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "駅前のにぎわい創出に向け整備を進める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "地域と県全体の発展につながる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "本地域だけでなく県全体の発展につながる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "未着手区間の早期整備を国に強力に働きかける"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "安全対策を行い今後のあり方を定める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "早急に安全対策を行い今後のあり方を定める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "意欲的な担い手によるもうかる農業実現の対策に取り組む"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "農地集積や法人化支援、販路拡大支援を進める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "イカのまち酒田を全国的に発信する"@ja.
