    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "本地域の発展だけでなく山形県全体の飛躍的発展につながるものと考えます"@ja.
<< kg:id_110 prop:effect kg:id_111 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "高速道路網に未接続部分があることは、本市の産業力の強化や交流促進に大きなマイナスとなっています"@ja.
<< kg:id_112 prop:cause kg:id_113 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "旧割烹小幡については、老朽化が進んでいることから、早急に安全対策を行うとともに、今後のあり方を定めてまいります"@ja.
<< kg:id_114 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "早急に安全対策を行うとともに、今後のあり方を定めてまいります"@ja.
<< kg:id_116 prop:cause kg:id_117 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "平成30年産の主食用米から生産数量目標の配分を行わないことが決定されております。今後は生産者や集荷団体がみずからの経営判断や販売戦略に基づき、消費者ニーズ等を踏まえた需要に応じた米づくりを行うことが求められます"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "意欲的な担い手による効率的で持続可能なもうかる農業を実現するための対策に取り組んでまいります"@ja.
<< kg:id_120 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "酒田港における船凍イカの水揚げ量の大幅な増加を目指し、県内外のイカ釣り船の入港水揚げ回数をふやすための支援を拡充し、イカのまち酒田を全国的に発信してまいります"@ja.
<< kg:id_122 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "首都圏を初めとする都市部の元気な高齢者が希望に応じて地方に移り住む、生涯活躍のまち構想の実現に向け、首都圏ニーズを踏まえながら事業化の検討を深めてまいります"@ja.
<< kg:id_124 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "妊娠期以前から子育てまでを包括的にサポートする子育て世代包括支援センターぎゅっと（仮称）でありますが、これを開設いたします。切れ目のない子育て支援を行うため"@ja.
<< kg:id_126 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "次期学習指導要領の改訂による英語教育拡大に向けて、現在３名の外国人英語講師（ＡＬＴ）を８名に増員し、各中学校に１名ずつ配置します"@ja.
<< kg:id_128 prop:cause kg:id_129 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "少子高齢者化を伴う人口減少社会の中で、地域の持続的な成長と活力を維持し地方創生を進めていくためには、市民一人一人が個性に応じた多様な能力を発揮できる環境整備が必要です。特に女性の能力を十分生かすことが地域の発展に不可欠と言えます"@ja.
<< kg:id_130 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "新たに女性が働きやすい職場環境づくりを行う企業支援に取り組んでいきます"@ja.
<< kg:id_132 prop:cause kg:id_133 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "全国的な課題となっている保育士不足を解消するため"@ja.
<< kg:id_132 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "山形県福祉人材センターと連携し、市内保育所等の求人状況や潜在保育士の状況を情報交換しながら、再就職支援に向けた取り組みにより保育士確保を図ります"@ja.
<< kg:id_135 prop:effect kg:id_136 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "本市の歴史・文化・偉人などを学び、郷土を愛する心を育むことは、本市に生まれ育ち住まうことを誇りに思い、ひいては若者の流出を抑えるという意味でも重要と考えます"@ja.
<< kg:id_137 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "北前船で繁栄した往時の様子を伝える国指定史跡旧鐙屋の耐震化と長寿命化を図るため、詳細調査と耐震補強案の策定等を行います"@ja.
<< kg:id_139 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "医療体制の充実を図るため、地方独立行政法人山形県・酒田市病院機構に対し運営費を負担するとともに、先端医療機器等の整備、施設改修等に係る支援を継続してまいります"@ja.
<< kg:id_141 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "災害発生時に迅速に対応し、市民の生命や財産を守るよう、事前の備えや訓練等の充実に努めてまいります"@ja.
<< kg:id_143 prop:cause kg:id_144 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "近年増加傾向にあるゲリラ豪雨等による冠水対策のため、大型排水ポンプ車を導入いたします"@ja.
<< kg:id_143 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "近年増加傾向にあるゲリラ豪雨等による冠水対策のため、大型排水ポンプ車を導入いたします"@ja.
<< kg:id_146 prop:cause kg:id_147 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "少子高齢化を伴う人口減少が進む中、都市のコンパクト化による市民の生活利便性の維持向上やサービス産業の生産性向上による地域経済の活性化を図るため"@ja.
<< kg:id_146 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "平成29年度から２カ年で酒田市都市計画マスタープランの改定及び酒田市立地適正化計画の策定を進めてまいります"@ja.
<< kg:id_149 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "新市庁舎の整備については、現在２期工事完成に向けて、鋭意建設工事を進めており、８月からフルオープンでの業務を開始する予定です"@ja.
<< kg:id_151 prop:effect kg:id_152 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "再生可能エネルギーの活用については、直営風力発電事業の実施により、原子力発電に頼らない社会の構築への貢献、事業利益の市民還元を図っていくため"@ja.
<< kg:id_151 prop:contermeasure kg:id_153 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "引き続き環境影響評価等の手続に取り組んでまいります"@ja.
<< kg:id_154 prop:contermeasure kg:id_155 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "引き続き家庭から排出されるごみの有料化について、市民を巻き込んだ検討を進めてまいります"@ja.
<< kg:id_156 prop:contermeasure kg:id_157 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "同大学に酒田市産業振興寄附講座を開設します。高度な情報教育によるＩＴ人材の育成"@ja.
<< kg:id_158 prop:effect kg:id_159 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "施策の重点化や今後とも見込まれる厳しい財政状況を踏まえ、地方交付税が段階的に減少する中にあっても"@ja.
<< kg:id_159 prop:contermeasure kg:id_160 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "財政調整基金残高の確保及び市債残高の抑制を図ったところです"@ja.
<< kg:id_161 prop:cause kg:id_162 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "これは昨年４月に策定した酒田市地域産業支援基本方針を踏まえ、地元産の品物を積極的に活用し返礼品を充実するとともに、楽天やＡＮＡ等のインターネットサイトを活用した結果であります"@ja.
<< kg:id_163 prop:contermeasure kg:id_164 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "引き続きクラウドファンディングの活用や新たな返礼品の設定などにより、寄附者の増加を図り自主財源を確保するとともに、地元産品のＰＲを推進してまいります"@ja.
<< kg:id_165 prop:contermeasure kg:id_166 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "業務内容の調査・課題の洗い出しを行い、職員の意識改革を促しながら、市役所全体で働き方改革を推進してまいります"@ja.
<< kg:id_167 prop:contermeasure kg:id_168 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "下水道事業については、下水道事業への地方公営企業法の適用を図るとともに"@ja.
<< kg:id_169 prop:contermeasure kg:id_170 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "水道事業と下水道事業の組織統合を行い、安定的な上下水道の提供、効率的で健全な経営に努めてまいります"@ja.
<< kg:id_171 prop:contermeasure kg:id_172 >>
    prop:text-txt_contents "鳥海高原牧場の民間移管に伴い、土地、建物、備品について無償貸付するため"@ja.
}
