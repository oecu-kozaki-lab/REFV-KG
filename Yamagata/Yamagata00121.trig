kg:st_1 rdfs:label "五十嵐英治議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "人口減少対策として子育て支援策の充実が最重要課題と考える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "長岡市のお父さんお母さんたち"@ja.
kg:st_2 rdfs:type cls:st_69.
cls:st_69 rdfs:label "保護者"@ja.
kg:op_2 prop:content "雨や雪の日でも遊べる子育て支援施設を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "ワークショップ参加市民"@ja.
kg:st_3 rdfs:type cls:st_42.
cls:st_42 rdfs:label "市民"@ja.
kg:op_3 prop:content "冬は外で遊べないので室内で遊べる広い施設をふやしてほしい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:st_4 rdfs:label "丸山市長"@ja.
kg:st_4 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "子供を産み育てやすい環境整備につながる施設整備が望ましい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_4.
kg:op_5 prop:content "子育て世代が酒田で子育てを楽しめる施策として有効と考える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:op_6 prop:content "現施設だけでは十分ではないと認識している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:op_7 prop:content "年齢に応じた十分なスペース確保が課題と認識している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:st_5 rdfs:label "市民"@ja.
kg:st_5 rdfs:type cls:st_42.
kg:op_8 prop:content "駐車場が少なく立体駐車場のため子供連れでは不便"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_5.
kg:op_9 prop:content "現施設のみでは十分ではないと考えている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "子育てを基本方針の一つに掲げ図書を通じた支援機能を充実させる考え"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "3階部分は図書を通じた子育て支援にも活用できるよう機能充実を図りたい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "平時開放により子育て世代にも活用してもらえる施設にしたい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "子育て支援にもつながる整備を検討したい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "まずは関係部署や関係機関との連携強化で対応したい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
kg:op_15 prop:content "長岡市の例も含めて組織統合を内部で勉強し検討したい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "専任担当部署化が大幅増額の要因と評価する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "楽天サイト掲載が取扱件数増加の大きなきっかけになった"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "つや姫30kg分割発送の企画が成功要因だった"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:st_6 rdfs:label "永田斉総務部市政推進調整監兼危機管理監"@ja.
kg:st_6 rdfs:type cls:st_47.
cls:st_47 rdfs:label "行政職"@ja.
kg:op_19 prop:content "返礼品拡充が寄附申込増加につながったと認識している"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:op_20 prop:content "新たな寄附者の確保と拡充に努めた"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_6.
kg:op_21 prop:content "総務省通知への対応前の駆け込み需要もあったと感じている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:op_22 prop:content "つや姫をきっかけに酒田米の評判向上につながったと評価する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "地場産品を全国に知ってもらえる好機になった"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "返礼品人気が農畜産物生産者の励みになった"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "制度の健全な発展のため資産性の高い返礼品を除外する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "総務省通知を踏まえ返礼割合を3割に見直す"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "地元産業振興と地元産品PRにつながる返礼品提供を続けたい"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "クラウドファンディング活用で財源確保と地元産業振興につなげたい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:op_29 prop:content "時間帯によって地元で活動できる団員が確保できない地域があると認識している"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "地域によっては消防力確保に課題がある"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "消防団OBを中心とする活動協力員に後方支援をお願いしている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "負担感を抑えつつ実際の消火活動が可能な機能別消防団員の導入を急ぎ検討したい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:st_7 rdfs:label "今野哲昭総務部付消防調整監"@ja.
kg:st_7 rdfs:type cls:st_47.
kg:op_33 prop:content "老朽化し腐食の進んでいるものから順に更新している"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_7.
kg:op_34 prop:content "汚染水処理が難しく容易に清掃できない防火水槽がある"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_7.
kg:op_35 prop:content "水の汚れがある貯水槽もあり清掃未実施の場所がある"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_7.
kg:op_36 prop:content "無蓋貯水槽の更新を継続して進める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_7.
kg:op_37 prop:content "既設無蓋貯水槽へのふた設置を前向きに検討する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_7.
kg:st_8 rdfs:label "佐藤伸二議員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_38 prop:content "転作田活用作物としてそばは農家にとって切り離せない"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:op_39 prop:content "農家の高齢化や規模拡大の中でそば栽培は重要"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_8.
kg:st_9 rdfs:label "成澤嘉昭農林水産部長"@ja.
kg:st_9 rdfs:type cls:st_47.
kg:op_40 prop:content "ルチンの機能性を生かした加工品開発に取り組みたい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_9.
kg:op_41 prop:content "現地の感触や評価を踏まえ輸出可能性を検討したい"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "機能性を生かした新たな加工品開発に取り組みたい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_9.
kg:st_10 rdfs:label "田中愛久商工観光部長"@ja.
kg:st_10 rdfs:type cls:st_47.
kg:op_43 prop:content "米粉利用は既に商品が出回っており独自性や差別化は容易ではない"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_10.
kg:op_44 prop:content "モニュメント以外にも多様なPR手法を重視したい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_10.
kg:op_45 prop:content "像に限らず看板や映像も含め観光案内所で検討したい"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_10.
kg:st_11 rdfs:label "阿部勉企画振興部長"@ja.
kg:st_11 rdfs:type cls:st_47.
kg:op_46 prop:content "県内就職率は上昇しているが依然として県平均より低い"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_11.
kg:op_47 prop:content "取り組み内容を充実させ地元就職意識を高めたい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_11.
kg:op_48 prop:content "若者が地元に住み働きたい環境づくりを進めたい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_11.
kg:op_49 prop:content "職歴に応じた求人開拓や企業見学調整などきめ細かな対応ができている"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_11.
kg:op_50 prop:content "民間事業者と連携し住まい情報提供体制を整えている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_11.
kg:op_51 prop:content "若い世代は酒田を好きとする割合が高い"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_11.
kg:op_52 prop:content "若者の居場所づくりとして交流スペース整備を進めている"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_11.
kg:op_53 prop:content "本市では地域商社組織が未整備との認識に立っている"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:op_54 prop:content "農産物や観光資源の活用に向け地域商社事業を急ぎ検討したい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_4.
kg:op_55 prop:content "ニーズ把握が課題である"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_4.
kg:op_56 prop:content "ロット確保と安定供給体制の確立が課題"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:op_57 prop:content "農商工連携で得意分野を結び新商品開発を進めたい"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_4.
kg:op_58 prop:content "新商品開発や販売機能強化のため支援センター開設を進める"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_4.
kg:op_59 prop:content "歴史文化自然環境イベント食などの強みを発信する必要がある"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_4.
kg:op_60 prop:content "外部機会を逃さず誘客に結びつける仕掛けが重要"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_4.
kg:op_61 prop:content "市全体でおもてなしする体制整備を進めている"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_4.
kg:st_12 rdfs:label "本間匡志総務部長"@ja.
kg:st_12 rdfs:type cls:st_47.
kg:op_62 prop:content "将来負担軽減に備え類似団体平均を目安に積み増したい"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_12.
kg:op_63 prop:content "将来への備えとして基金積立が必要"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_12.
kg:op_64 prop:content "持続可能な行財政運営のため分析評価手法を検討したい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_12.
kg:op_65 prop:content "参考値だが一定の経済効果はあったとみている"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_4.
kg:op_66 prop:content "市民の自発的な取り組みが最大の成果であり大切な財産"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_4.
kg:op_67 prop:content "直前まで人数が確定せず情報収集が課題だった"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_4.
kg:op_68 prop:content "県と連携し実際の乗客数等の情報収集を強化したい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_4.
kg:op_69 prop:content "港単体でなく地域連合でプロモーションを進めたい"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_4.
kg:op_70 prop:content "酒田港の優位性を生かし企業立地を進めたい"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_10.
kg:op_71 prop:content "立地企業の協力を得て工場施設を活用した取り組みも検討したい"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_10.
kg:st_13 rdfs:label "対象地域住民"@ja.
kg:st_13 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_72 prop:content "以前より明るくなってよかった"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_13.
kg:op_73 prop:content "LEDが明る過ぎてまぶしい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_13.
kg:st_14 rdfs:label "桐澤聡市民部長"@ja.
kg:st_14 rdfs:type cls:st_47.
kg:op_74 prop:content "現場確認の上で向き調整など柔軟に対応する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_14.
kg:op_75 prop:content "6,000灯更新で大きな削減効果が見込まれる"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_14.
kg:op_76 prop:content "防犯灯のような大規模更新は困難"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_14.
kg:op_77 prop:content "老朽化した道路照明灯から順次更新していく"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_14.
kg:st_15 rdfs:label "岩堀慎司健康福祉部長"@ja.
kg:st_15 rdfs:type cls:st_47.
kg:op_78 prop:content "健康増進ゾーンは現時点でおおむね目標を達成している"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_15.
kg:st_16 rdfs:label "利用者"@ja.
kg:st_16 rdfs:type cls:st_22.
cls:st_22 rdfs:label "利用者"@ja.
kg:op_79 prop:content "健康維持や医療費軽減につながっている"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_16.
kg:op_80 prop:content "古い器具が多く部品がなく使用中止のものもある"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_15.
kg:op_81 prop:content "利用者の利便性確保のため更新を進めたい"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_15.
kg:st_17 rdfs:label "高橋正和議員"@ja.
kg:st_17 rdfs:type cls:st_16.
kg:op_82 prop:content "厨房設備が老朽化し利用増加への対応が困難になっている"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_17.
kg:st_18 rdfs:label "菅原司芝教育部長"@ja.
kg:st_18 rdfs:type cls:st_47.
kg:op_83 prop:content "新年度予算計上に向け調理室改修を進めたい"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_18.
kg:op_84 prop:content "宿泊型体験学習や広報で利用頻度を上げたい"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_18.
kg:op_85 prop:content "地域活性化につながる施設のあり方と運営体制を検討したい"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_18.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "人口減少問題に早急に対処するには、子育て支援策の充実が最重要課題であると私は考えております"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "雨や雪の日でも子供を伸び伸びと遊ばせることのできる子育て支援施設が必要だとの、雪国長岡のお父さんお母さんたちの要望から生まれた取り組み"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市民が参加をいたしますワークショップにおきましても、冬は外で遊べないので室内で遊べる広い施設をふやしてほしいといった、こういった声も出ているところでございます"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "子供を産み育てやすい環境を整えるとともに、子育て世代が酒田で子育てを楽しむことができる施策を実施するためにも、ぜひこういった施設については、私自身も整備ができればいいなと"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "子供を産み育てやすい環境を整えるとともに、子育て世代が酒田で子育てを楽しむことができる施策を実施するためにも"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "現在は大型遊具の老朽化ですとか"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "混雑時に年齢に応じた十分なスペースの確保ができないこと"@ja.
<< kg:id_7 prop:cause kg:id_10 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "市民からは駐車台数が少なくて、立体駐車場であるために、子供連れでの訪問は大変不便であると、そういった意見もいただいているところでございまして"@ja.
<< kg:id_7 prop:effect kg:id_11 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "この施設だけで酒田市の施設が十分かと言われますと、そうではないのではないかなと、このように考えているところでございます"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "子育てについても基本方針の一つとして掲げておりまして、この方針に沿って、ライブラリーセンターでは図書を通じた子育て支援という面から、児童図書コーナーですとか読み聞かせ専用スペース、さらには授乳室、児童トイレなどを整備する計画"@ja.
<< kg:id_12 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "３階部分については、図書館関連の講座ですとかグループ活動など、図書館活動を活性化させるために自由に利用できるスペースとして位置づけをしておりますけれども、育児セミナーですとか、あるいは読み聞かせなど、図書を通じた子育て支援にも活用できるスペースとして、ぜひ機能の充実を図ってまいりたい"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "平時には市民のために開放する考えでございまして、子育て世代にも有効に活用していただくことはできるものと"@ja.
<< kg:id_15 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "子育て支援にもぜひつながるような、そういった整備の対応ができればと、このように考えているところでございます"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "まずは現時点におきましては、ネウボラ事業等の取り組みも進めている関係もございまして、子供の成長に合わせて子育て支援が行えるように、それぞれの関係部署や関係機関との連携強化を図っていく対応でまずは取り組んでまいりたい"@ja.
<< kg:id_18 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "子供、子育て支援に関する市役所の組織改編等につきましては、長岡市の例なども含めて内部で勉強をしてまいります"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "平成28年度、丸山市長が市長公室を新設し、ふるさと納税の専任担当部署としたことで、新たにさまざまな取り組みを実施した結果、ふるさと納税は大幅に増額し"@ja.
<< kg:id_21 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "インターネット大手の楽天ふるさと納税サイトに初掲載するときに"@ja.
<< kg:id_21 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "２万円の寄附金額の返礼品につや姫30kg分割発送を可能とした目玉商品を企画し"@ja.
<< kg:id_21 prop:cause kg:id_25 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "今年度は新たに、花王酒田工場生産の製品ですとか土門拳記念館の図録などを追加をいたしまして、返礼品の品目の拡大と内容の充実を図ったところ"@ja.
<< kg:id_21 prop:cause kg:id_26 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "今年度は５月と８月から、ふるさと納税の制度を活用しましたガバメントクラウドファンディングを実施をいたしまして、新たな寄附者の確保と拡充に努めているところ"@ja.
<< kg:id_21 prop:cause kg:id_27 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "いわゆる駆け込みの部分もあったのかなと感じているところでございます"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "つや姫を受け取った方々のコメントも、おいしさをアピールするものが多く寄せられ、一躍酒田米の評判を高めました"@ja.
<< kg:id_28 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "酒田の地場産品を全国に知ってもらえるよい機会となりました"@ja.
<< kg:id_28 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "米を中心とした農畜産物が返礼品として人気が高かったことは、農畜産物生産者にも夢と誇りを与えるものでありました"@ja.
<< kg:id_28 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "プリンターと時計、それからゴルフクラブセットを７月から返礼品より除外をしたところ"@ja.
<< kg:id_28 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "10月１日受け付け分より現行約５割から３割という内容に変更をする予定"@ja.
<< kg:id_28 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "今後とも地域の魅力あふれる返礼品を提供するとともに"@ja.
<< kg:id_28 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "ガバメントクラウドファンディングを活用するなど、本市の地元産業の振興と地元産品のＰＲに今後ともつなげていきたい"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "本市の団員の77％が会社員等の被雇用者という状況でございまして、時間帯によっては火災等救急時に地元で活動できる団員が確保できなくなっている地域"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "時間帯によっては火災等救急時に地元で活動できる団員が確保できなくなっている地域、そういった班もある"@ja.
<< kg:id_36 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "平成23年度からは活動協力員制度を設けまして、消防団のＯＢを中心に現在527人が登録をして、有事の際の後方支援をお願いをしているところ"@ja.
<< kg:id_36 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "実際の消火活動が可能となります機能別消防団員として活躍していただく方向で、今検討をしているところでございます"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "防火水槽の更新については、老朽化し腐食の進んでいるものから順に更新をしており"@ja.
<< kg:id_41 prop:cause kg:id_43 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "清掃に伴う大量の汚染水が発生しますけれども、この処理が難しいところや、あとは放水が容易にできないところなど、容易に清掃ができないところもありまして"@ja.
<< kg:id_41 prop:effect kg:id_44 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "水の汚れについては確かに議員御指摘のとおりの貯水槽もございます"@ja.
<< kg:id_41 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "無蓋貯水槽を廃止し新たな貯水槽に更新するのは、隔年で４基の更新をめどとして実施しております"@ja.
<< kg:id_41 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "既設の無蓋の貯水槽に新たにふたをかけるという対策も前向きに検討していきたい"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "米の生産量を調整するために生じた転作田に、土地利用型作物として、また労働力の低減を図るための作物として、そばの栽培が行われております"@ja.
<< kg:id_47 prop:cause kg:id_49 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "農家の高齢化や規模拡大が進んでいる中、農家にとって経営上切り離すことができない"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "そばに特徴的に含まれるルチンはポリフェノールの一種であり、心臓疾患や動脈硬化、高血圧などの生活習慣病の予防に役立ち、高血圧の改善や血糖値の回復作用がある"@ja.
<< kg:id_52 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "むきそばや日本そばの料理や調理方法などについて紹介し、現地での感触や評価を踏まえながら、輸出の可能性について検討してまいりたい"@ja.
<< kg:id_54 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "その機能性を生かした新たな加工品開発に、大学や研究機関などと連携を図りながら取り組んでまいりたい"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "既に商品が出回っている中、独自性や差別化を打ち出すことは容易ではない"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "ホームページの充実、今回のようなイベントの開催、国内外で行われますラーメンイベントの参加などによりまして、マスコミやＳＮＳで取り上げられることも有効なＰＲ"@ja.
<< kg:id_58 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "像だけじゃなくて看板とかですね、あるいは映像なんかもあると思います。今後駅前にできます新しい観光案内所につきましては、さまざまな工夫ができると思いますので、その中で検討させていただきたい"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "酒田地域の高校生の県内就職率は、県平均78％と比べ69％と、依然として低い数値"@ja.
<< kg:id_61 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "進学校の生徒へも対象を広め、地元就職に対してより実感の湧くような機会をつくるなど、取り組み内容の充実に努めてまいります"@ja.
<< kg:id_61 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "インキュベーション施設ライトハウスでの活動や、若者に地元で働くことの楽しさを伝えるトークイベント、酒田モシエノ大学の自発的な活動を後押しすることにより、この地域に住み働きたいという環境をつくりたい"@ja.
<< kg:id_65 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "ＵＩＪターンコーディネーターを配置をし、ＵＩＪターン人材バンクで取り組んでおります"@ja.
<< kg:id_65 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "相談内容に応じまして移住相談窓口で丁寧に対応してございます"@ja.
<< kg:id_68 prop:effect kg:id_69 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "酒田が好き、どちらかといえば好きという方の30代までの割合は86.3％と高い数値"@ja.
<< kg:id_68 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "今年度、文化センターに若人交流スペースの設置を進めているところ"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "本市におきましては、まだ地域商社組織としては未整備であると、このような認識に立っておりまして"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "本市としても農産物や観光資源の活用、掘り起こしに向けた地域商社事業や、その組織化について急ぎ検討をしていきたい"@ja.
<< kg:id_75 prop:cause kg:id_76 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "課題といたしましては、実需者や消費者がどのような農林水産物を望んでいるのかのニーズの把握"@ja.
<< kg:id_75 prop:cause kg:id_77 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "需要に応じたロットの確保、そして、安定供給を図るための生産流通体制の確立"@ja.
<< kg:id_75 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "生産を得意とする生産者、それから加工を得意とする製造業者、そして販売を得意とする販売業者をマッチングをして"@ja.
<< kg:id_75 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "仮称ではありますけれども、産業振興まちづくり支援センターの開設に向けて、ことしの10月からその準備に入ることにしている"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "歴史、文化、自然環境、それからイベントや食といった本市の強みを生かして、全国に向けて発信していくことが必要"@ja.
<< kg:id_80 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "クルーズ船の寄港ですとかジオパーク、日本遺産の認定、あるいはＮＨＫ大河ドラマ「西郷どん」の放映などの機会を逃さずに、きちんとこれを誘客に結びつけていく仕掛けが重要"@ja.
<< kg:id_80 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "市全体が一体となって本市にお越しいただいたお客様をおもてなしをする体制といたしまして、ことしの２月23日に酒田交流おもてなし市民会議を設立をし"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "将来負担の軽減に備え、類似団体の平均を目安に、毎年２億円ずつ財政調整基金を積み増していきたい"@ja.
<< kg:id_84 prop:cause kg:id_86 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "人口減少、税収減もこれから見込まれると、それから公共施設の更新、こういったものもこれから本格的に始まってくるというようなところから、全国どの団体もやはりそういった将来への備えという部分では必要"@ja.
<< kg:id_84 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "今後も持続可能な行財政運営を行う上では、実績を踏まえた中期財政計画の分析、評価を行う必要があると認識しておりまして"@ja.
<< kg:id_88 prop:effect kg:id_89 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "約1,320万円が経済効果として推計をされるのではないかな"@ja.
<< kg:id_88 prop:effect kg:id_90 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "市民がこのように多くの自発的な取り組みを企画して実施したことが最も大きな成果"@ja.
<< kg:id_88 prop:cause kg:id_91 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "酒田港に入るもう本当に直前まで、何人来るかというところの情報が確定されていなかった"@ja.
<< kg:id_88 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "今後も山形県と連携をして、外国船社との信頼関係構築に努めて、タイムリーな、より実際の乗客数等の情報収集を行っていきたい"@ja.
<< kg:id_88 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "酒田市と函館、秋田、新潟、高岡のこの５つの港の連携関係の構築を今図っているところで、それぞれの港単体ではなくて日本海側の港、地域連合して、外国の船社に誘致をしていく動き"@ja.
<< kg:id_94 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "国・県と連携しながら、そのような社会的な要請に応じ、酒田港の優位性を生かしつつ、さらなる企業立地に取り組んでまいりたい"@ja.
<< kg:id_94 prop:contermeasure kg:id_96 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "企業立地が進んだ際には、そのような工場施設を活用した取り組みも検討し得るもの"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "対象地域の皆様からは、以前よりも明るくなってよかったという声を多くいただいております"@ja.
<< kg:id_97 prop:effect kg:id_99 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "ＬＥＤが明る過ぎる、まぶしいというような声を寄せられることもあり"@ja.
<< kg:id_97 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "その際は現場を確認しながら防犯灯の向きを調整するなどの対応をとっている"@ja.
<< kg:id_97 prop:effect kg:id_101 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "6,000灯の更新で、年間ベースで申し上げますと800万円から900万円程度になるのではないか"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "道路照明灯のＬＥＤ化は、防犯灯や家庭用照明器具と比較し、設置費用が高額となりますので、初期投資費用に見合ったランニングコストの低減が見込めない"@ja.
<< kg:id_102 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "今後も引き続き、老朽化が確認されたものから順次ＬＥＤ照明への更新を行っていく計画"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "成果指標の目標値を100人として事業に臨んでおりますが、現時点ではおおむね達成できている"@ja.
<< kg:id_107 prop:effect kg:id_108 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "利用者からは、健康診断の数値に改善が見られ、冬場の健康、体力維持、そして病気、けが予防につながり、医療費の軽減につながっているという話も伺っておる"@ja.
<< kg:id_107 prop:cause kg:id_109 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "この運動器具につきましては、開設当初から使っているものが多く、故障の際には修理部品がない場合もあり、使用中止としているものもございます"@ja.
<< kg:id_107 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "使用中止としている器具は現在更新の手配をしており、今後ともできるだけ利用者の利便性を図ってまいりたい"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "調理研究室の厨房設備の老朽化により使い勝手が悪く、利用の増加に対応することが困難になってきています"@ja.
<< kg:id_111 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "アイランドキッチンを中央に２台設置し、大きなガス台と深いシンクを壁側に設置するような形で改修をしていきたいということで、新年度予算の計上に向けて対応してまいりたい"@ja.
<< kg:id_111 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "豊かな自然を生かし宿泊型体験学習を企画するなど、利用頻度を上げる方法を検討するとともに、新規の団体からも利用していただけるよう、ホームページや広報等で情報発信を行い、ＰＲしていきたい"@ja.
<< kg:id_111 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "施設のあり方や運営体制について、関係する部署とも協議を行いながら検討をしていきたい"@ja.
}
