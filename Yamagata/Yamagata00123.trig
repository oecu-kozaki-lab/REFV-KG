kg:id_40 rdf:type cls:c_5145.
cls:c_5145 rdfs:label "要望伝達"@ja.
kg:id_1 prop:countermeasure kg:id_40.
kg:id_41 rdfs:label "庄内地域の自治体首長と連携して関係機関に地元の声を届けること"@ja.
kg:id_41 rdf:type cls:c_2005.
cls:c_2005 rdfs:label "複合経営"@ja.
kg:id_1 prop:countermeasure kg:id_41.
kg:id_42 rdfs:label "農家所得の不安定"@ja.
kg:id_43 rdfs:label "稲作だけではなく複合経営により農家所得を上げること"@ja.
kg:id_42 prop:countermeasure kg:id_43.
kg:st_1 rdfs:label "梶原宗明議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "減収の原因をきちんと把握することが重要と求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "減収の原因をきちんと把握することが重要と求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_3 prop:content "異常気象が常態化するなら高品質で安定した収量を上げられる栽培管理を徹底すべきと考える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "中里智子農林水産部長"@ja.
kg:st_3 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_4 prop:content "根張りが弱かったため苗づくりの工夫を関係者と話し合いたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "異常気象に強い土づくりや栽培管理が必要と考える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "庄内北部に特徴的な現象として分析している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "庄内北部に特徴的な現象として分析している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "異常気象の影響が大きかったと認識している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "根張りが弱かったことも影響しており苗づくりの工夫が必要とみる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "酒田市・遊佐町地域で稲の体力を消耗させたと分析する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "酒田市・遊佐町地域で稲の体力を消耗させたと分析する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "栽培基準が内陸型ではないかとの声があり庄内が強く発言すべきと述べる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "つや姫をやめたいという人も出ており影響を調べるべきと求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "農家の実感としては不作ではなく凶作との声がある"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "農家の収入が地域経済に及ぼす影響は非常に大きいと懸念する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "生産者の意欲をそぐことがないよう支援が必要と述べる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "生産者の意欲をそがないため無利子の運転資金措置を講じたと説明する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "実収と基準反収の差をきちんと精査して訴えるべきと求める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "販売面でも大変になると懸念する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "契約に満たないと地域の米の信用問題にかかわると懸念する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "農家の収入減が消費や購買を冷やし地域経済に波及すると懸念する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "稲作農家のつなぎ資金の確保対策として必要な措置と評価する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "農業者が経営の維持安定に向けて取り組む際の負担軽減を図る措置と説明する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "しっかりと苗づくりの工夫を関係者と話し合いたい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "苗の初期生育確保に向けて重要と説明する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "根の生育を阻害するガスの発生を抑えるため重要と説明する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "異常気象への対応として特に重要と説明する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "異常気象への対応として特に重要と説明する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "栽培マニュアルや基準の見直しを求める声が上がっていると指摘する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "高品質で安定した収量のためまず栽培管理を徹底すべきと考える"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "必要であればマニュアルも見直されるべきと考える"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "本市の基幹産業である農業の持続的発展のため必要と考える"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "異常気象に強い土づくりや栽培管理につなげたいと考える"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "藤井教授の協力を得ながら先進的な農業を進めたいと述べる"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "地域一体となり各機関に訴えるべきと求める"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "地域一体となり各機関に訴えるべきと求める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "鶴岡市長や三川町長庄内町長遊佐町長と一緒に地元の声を届けたいと述べる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "ネギやアスパラや花卉の産地化に引き続き取り組みたいと述べる"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
