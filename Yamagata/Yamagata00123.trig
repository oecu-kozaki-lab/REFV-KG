    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "７月の高温少雨ですとか、たび重なる台風等による強風、フェーン現象、そして大雨等によります稲本体と根の活力の消耗も大きく影響したものと考えられております。"@ja.
<< kg:id_1 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "７月の高温少雨ですとか、たび重なる台風等による強風、フェーン現象、そして大雨等によります稲本体と根の活力の消耗も大きく影響したものと考えられております。"@ja.
<< kg:id_1 prop:cause kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "たび重なる台風等による強風、フェーン現象、そして大雨等によります稲本体と根の活力の消耗も大きく影響したものと考えられております。"@ja.
<< kg:id_1 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "特に、庄内地方の中でも酒田市・遊佐町地域は、７月末から10月までに発生した５つの台風による強風やフェーン現象が、稲の体力を消耗させたのではないかと、このように分析をしております。"@ja.
<< kg:id_1 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "特に、庄内地方の中でも酒田市・遊佐町地域は、７月末から10月までに発生した５つの台風による強風やフェーン現象が、稲の体力を消耗させたのではないかと、このように分析をしております。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "また、出荷基準についても、基準ふるい目幅が通常の1.85mmより大きい1.90mmを採用していることもくず米が多く出た要因であると、このように考えております。"@ja.
<< kg:id_13 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "特につや姫はくず米と呼ばれる基準ふるい目幅サイズ以下のものが非常に多くて、これが373kgとなり、平成29年産の収量と比較すると、はえぬきで75kgの減収に対して、つや姫は140kgの大幅な減収となっているところでございます。"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "それにより、本市農業の基幹作物である稲作にも大きな影響を受けたものと思います。"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "その一方で、今回の異常気象による減収によりまして、農家収入が大きく減少している状況等を踏まえ"@ja.
<< kg:id_1 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "来年の水稲栽培に必要な水稲の種子や肥料、農薬といった農業用資材の購入等に支障を来し、生産者の意欲をそぐことがないように"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "来年の水稲栽培に必要な水稲の種子や肥料、農薬といった農業用資材の購入等に支障を来し、生産者の意欲をそぐことがないように"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "主食用米として販売する米の実数がぐっと下がるわけなんですよ。"@ja.
<< kg:id_1 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "すると、今、販売するほうでは、今度米が集まらないという現象が実は起きています。"@ja.
<< kg:id_1 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "その契約に満たないと、この地域のある意味米の信用問題にもかかわるということで"@ja.
<< kg:id_1 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "そういったことになると、この地域の経済が回りにくくなるんではないかなと思います。"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "今回の利子補給事業は稲作農家、特に法人化等により大規模栽培している農家にはつなぎ資金の確保対策として必要な措置であると考えます。"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "今回補正予算の中で異常気象農作物被害対策資金利子補給事業、これを設定し、これにより無利子で運転資金を活用できるように措置をしたところでございます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "このような異常気象に対応するための対策といたしましては、まずは丈夫な苗づくりが重要でありまして"@ja.
<< kg:id_1 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "苗の初期生育確保に向けた土づくり肥料の散布"@ja.
<< kg:id_1 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "根の生育を阻害するガスの発生を抑えるためのわらの分解促進"@ja.
<< kg:id_1 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "そして生育状況に応じた追肥、水管理等が特に重要であると"@ja.
<< kg:id_1 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "そして生育状況に応じた追肥、水管理等が特に重要であると"@ja.
<< kg:id_13 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "12月３日に県知事とＪＡの組合長との意見交換の中で、つや姫の栽培マニュアルの見直し検討要望が伝えられたと"@ja.
<< kg:id_13 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "まずはマニュアルに沿ってしっかり栽培管理が行われるように対策が話し合われているところでございます。"@ja.
<< kg:id_13 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "必要であればマニュアルも見直されるべきであると、私はこのように考えております。"@ja.
<< kg:id_1 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "科学的データに基づく作業の省力化、合理化やドローンですとか人工衛星によるセンシング技術も活用した米づくり、いわゆるスマート農業に取り組む必要があると"@ja.
<< kg:id_1 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "ドローンですとか人工衛星によるセンシング技術も活用した米づくり、いわゆるスマート農業に取り組む必要があると"@ja.
<< kg:id_1 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "藤井教授の協力を得ながら、今後、本市の大宮にあります庄内バイオ研修センターも活用して、先進的な農業を進めていきたいと"@ja.
<< kg:id_1 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "本市のみならず庄内地域全体の特性、意見を集約して地域に適した栽培体系の検討や消費拡大に向けた取り組みを地域一体となり各機関に訴えるべきと考えます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "地域に適した栽培体系の検討や消費拡大に向けた取り組みを地域一体となり各機関に訴えるべきと考えます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "鶴岡市長さんですとか、三川、庄内、遊佐の３町長さんと一緒に関係機関にしっかりと地元の声を届けてまいりたいと"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "農家の所得を安定する対策といたしましては、稲作だけではなく複合経営によりまして農家所得を上げていきたいと思っておりまして"@ja.
}
