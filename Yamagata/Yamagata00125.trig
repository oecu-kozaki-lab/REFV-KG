kg:st_1 rdfs:label "江口暢子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "次世代にどのようなバトンを渡すべきか検討が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "子供の姿が町から消え始めていることに危機感を持つ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "矢口明子副市長"@ja.
kg:st_2 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_3 prop:content "父親の喫煙率が高く何らかの対策が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "母親の喫煙率は低いが子供の年齢が上がるごとに増加している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "子供や乳幼児への受動喫煙対策は健やかな育ちのために必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "公共施設の受動喫煙対策実施率100％の早期達成を目指す"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "子供の動線を考えた喫煙場所への配慮が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "子供を含む非喫煙者が受動喫煙しないよう対策をとっている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "乳幼児健診における父親母親の喫煙率を毎年下げることを目標とする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "乳幼児の睡眠時間の実態把握が必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "企業等の協力を得ながら地域全体で推進していく必要がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "親の収入が低いと十分な教育が受けられず貧困の連鎖が生じる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:st_3 rdfs:label "山形県"@ja.
kg:st_3 rdf:type cls:st_2.
kg:op_13 prop:content "経済的背景が子供の生活の不安や進学の希望に影響を与えている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "市民一人一人の所得を上げることが重要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "交流人口の増加や経済効果など多くのプラス効果が期待される"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "旅行消費による経済効果が期待される"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "観光資源の磨き上げにつながる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:st_4 rdfs:label "永田斉地域創生部長"@ja.
kg:st_4 rdf:type cls:st_2.
kg:op_18 prop:content "駅起点や鳥海山麓出羽三山も含めた広域誘客を図りたい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:st_5 rdfs:label "阿部勉企画部長"@ja.
kg:st_5 rdf:type cls:st_2.
kg:op_19 prop:content "既存路線と住み分けを図り新たな需要につながると期待"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_5.
kg:op_20 prop:content "経済界など関係機関と協力し必要な支援を県に要望する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:st_6 rdfs:label "進藤晃議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_21 prop:content "市街地の低地や道路で内水氾濫が起きたとみられる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:st_7 rdfs:label "梅木和広危機管理監"@ja.
kg:st_7 rdf:type cls:st_2.
kg:op_22 prop:content "災害対応や避難路の選択に活用できるようにしたい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_7.
kg:st_8 rdfs:label "丸山至市長"@ja.
kg:st_8 rdf:type cls:st_2.
kg:op_23 prop:content "大きな噴石や火砕流は短時間で影響が及び生命への危険性が高い"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_8.
kg:st_9 rdfs:label "冨樫覚議員"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_24 prop:content "一日も早い指定が必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_9.
kg:st_10 rdfs:label "後藤泉議員"@ja.
kg:st_10 rdf:type cls:st_16.
kg:op_25 prop:content "多くの事業者がFITを利用して発電事業に参入している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_10.
kg:st_11 rdfs:label "田中斉議員"@ja.
kg:st_11 rdf:type cls:st_16.
kg:op_26 prop:content "冠水道路を通行した結果車を修理に出した例がある"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_11.
kg:op_27 prop:content "住民の不安は払拭されていない"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_11.
kg:op_28 prop:content "大型鋼船や多数の外国木造船の出現で安全な操業が困難な状況"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_8.
kg:op_29 prop:content "山形県や県漁協関係者とともに水産庁へ取り締まり強化を要請した"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_8.
kg:op_30 prop:content "漁業者が減少している中でも一定の水揚げ量は維持できている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_8.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "近年では年間1,000人を超えるペースで人口が減少しているという現状にあります"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "昨年、平成29年の出生数は615人と、町の中から子供の姿が消え始めています"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "父親の喫煙状況は、３カ月健診時、１歳６カ月健診時、３歳児健診時で、平成28年、平成29年、連続で40％を超えております"@ja.
<< kg:id_5 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "母親の喫煙状況は数％台と父親よりは低いものの、子供の年齢数が上がるごとに増加している状況でありました"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "受動喫煙による健康影響が大きい子供、患者等に特に配慮すると掲げております。望まない受動喫煙の対策は、特にみずからの判断において受動喫煙に対してその意思を述べることができない子供、乳幼児における対策は、健やかな育ちのために必要なことであります"@ja.
<< kg:id_5 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "国は本年７月に、望まない受動喫煙をなくすことを目的とした改正健康増進法を成立、オリンピック・パラリンピック開催前の2020年４月に全面施行するとしております"@ja.
<< kg:id_5 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "施設の類型・場所ごとに禁煙措置や喫煙場所の特定を行うとともに、喫煙可能な場所には掲示を義務づける"@ja.
<< kg:id_5 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "2015年にやまがた受動喫煙防止宣言を行って、全県内に受動喫煙に対する意識づけのための広報、啓発に取り組んできました"@ja.
<< kg:id_5 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "受動喫煙対策推進委員会を新たに立ち上げ、条例化に向けて広く意見を求め、県の今定例会に山形県受動喫煙防止条例の制定を提案しているところであります"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "本市の公共施設における受動喫煙対策実施率は、敷地内禁煙、施設内禁煙としている割合が平成29年４月現在で97.4％でありました。その後、平成30年４月現在では５施設において施設内禁煙になったため99.5％になり"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "体育施設においては、建物内で禁煙をお願いし、敷地内に喫煙場所を設けている状況にあります"@ja.
<< kg:id_5 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "国体記念体育館や武道館では、入り口から離れた場所に喫煙場所を移動し、子供を含め、非喫煙者の方が受動喫煙することがないよう対策をとっております"@ja.
<< kg:id_5 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "喫煙者に対する指導や民間事業者への協力要請などに取り組んでまいりたいと思います"@ja.
<< kg:id_5 prop:countermeasure kg:id_19 >>
    prop:text-txt_contents "喫煙者に対する指導や民間事業者への協力要請などに取り組んでまいりたいと思います"@ja.
<< kg:id_5 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "第１に、マタニティー教室で受動喫煙防止のパンフレットを配付しております"@ja.
<< kg:id_5 prop:countermeasure kg:id_21 >>
    prop:text-txt_contents "母子健康手帳交付時には、本人及び家族に喫煙者がいる場合は、早産や新生児突然死症候群などとの因果関係を説明するなど、禁煙指導に力を入れております"@ja.
<< kg:id_5 prop:countermeasure kg:id_22 >>
    prop:text-txt_contents "乳幼児健診では、各健診時にパンフレット等を活用し、受動喫煙について情報提供や個別指導を行っております"@ja.
<< kg:id_5 prop:countermeasure kg:id_23 >>
    prop:text-txt_contents "特に３カ月健診では、離乳食と歯の話の中で、歯科衛生士による集団指導も行っております"@ja.
<< kg:id_5 prop:countermeasure kg:id_24 >>
    prop:text-txt_contents "若年者健診結果説明会や特定健診結果相談会、また特定保健指導など、成人の事業においても喫煙者には個別指導を実施しております"@ja.
<< kg:id_5 prop:countermeasure kg:id_25 >>
    prop:text-txt_contents "平成30年度に新たに配置された歯科衛生士による地区での講座の中でも、成人に対して子供への受動喫煙の影響について周知していきたいと考えております"@ja.
<< kg:id_5 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "具体的には、まず乳幼児健診における父親、母親の喫煙率を毎年確実に下げていくことを目標としたいと考えております"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "子供の眠りは子供の心身の発達と密接に関係しています"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:text-txt_contents "子供の脳や体の健やかな発育にはしっかりとした睡眠が欠かせない"@ja.
<< kg:id_27 prop:cause kg:id_30 >>
    prop:text-txt_contents "平成29年度の３歳児健診では、715人の受診者のうち、午後10時以降に就寝するお子さんは179人、約25％となっておりました"@ja.
<< kg:id_27 prop:cause kg:id_31 >>
    prop:text-txt_contents "３歳児健診では、テレビやゲーム、スマホ等の使用についても聞き取ったりするなどして"@ja.
<< kg:id_27 prop:countermeasure kg:id_32 >>
    prop:text-txt_contents "見直しが必要な家庭について個別指導を行っております"@ja.
<< kg:id_27 prop:countermeasure kg:id_33 >>
    prop:text-txt_contents "早寝早起きで生活リズムを整えることの必要性に加え"@ja.
<< kg:id_27 prop:countermeasure kg:id_34 >>
    prop:text-txt_contents "保育園や幼稚園などでも早寝早起き朝ごはんの推奨などに取り組んでおります"@ja.
<< kg:id_27 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "親の職場における長時間労働の是正や、子育てに関するさまざまな支援の活用により、家族が子供と一緒にいられる時間をふやし、子供を早く寝かしつけることができるようにするなど、企業等の協力を得ながら、ワーク・ライフ・バランスを地域全体で推進していかなければならない"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "貧困は、親の収入が低いと十分な教育が受けられず、進学・就職が不利になり、収入の高い職に就けないといった連鎖があると言われております"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:text-txt_contents "生活意識では、貧困世帯で生活が苦しいとの回答が70.8％に上り"@ja.
<< kg:id_36 prop:effect kg:id_39 >>
    prop:text-txt_contents "子供を塾や習い事に通わせられなかったとした保護者は30.6％に上っています"@ja.
<< kg:id_36 prop:effect kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "公表された調査結果の概要では、経済的背景が子供の生活の不安や進学の希望に影響を与えていることがうかがえると県ではコメントしております"@ja.
<< kg:id_36 prop:countermeasure kg:id_41 >>
    prop:text-txt_contents "平成30年２月に酒田市子どもの貧困対策をまとめて、市全体で取り組んでいるところでございます"@ja.
<< kg:id_36 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "本市の総合計画の目標にも掲げました、市民一人一人の所得を上げることが重要だと考えております"@ja.
<< kg:id_36 prop:countermeasure kg:id_43 >>
    prop:text-txt_contents "所得の向上とともに、健やかに育成される環境を整備し、教育の機会均等を図るなど、市全体として子供の貧困対策の充実に取り組んでいきたい"@ja.
<< kg:id_36 prop:countermeasure kg:id_44 >>
    prop:text-txt_contents "教育の機会均等を図るなど、市全体として子供の貧困対策の充実に取り組んでいきたい"@ja.
<< kg:id_45 prop:cause kg:id_46 >>
    prop:text-txt_contents "増加の理由としましては、直接的には、台湾チャーター便の増加ですとか"@ja.
<< kg:id_45 prop:cause kg:id_47 >>
    prop:text-txt_contents "民間のツアー造成事業者へのアプローチ効果や"@ja.
<< kg:id_45 prop:cause kg:id_48 >>
    prop:text-txt_contents "タイからの誘客を促進しているみちのくインバウンド推進協議会の活動等によりふえているところと認識しております"@ja.
<< kg:id_45 prop:cause kg:id_49 >>
    prop:text-txt_contents "日本を複数回訪れるリピーターの方も東北に足を向け始めていると考えているところでございます"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "インバウンドによる交流人口の増加、旅行消費による経済効果は、地域の活性化、本市の観光資源の磨き上げ等、多くのプラスの効果が期待される"@ja.
<< kg:id_50 prop:effect kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "インバウンドによる交流人口の増加、旅行消費による経済効果は"@ja.
<< kg:id_50 prop:effect kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地域の活性化、本市の観光資源の磨き上げ等、多くのプラスの効果が期待される"@ja.
<< kg:id_50 prop:countermeasure kg:id_54 >>
    prop:text-txt_contents "例えば食品の材料などの英語説明を表示してもらうことで、手に取ってもらいやすくなる工夫をしているところでございます"@ja.
<< kg:id_50 prop:countermeasure kg:id_55 >>
    prop:text-txt_contents "今後のクルーズ船寄港時に対応していただけるよう、店舗への情報提供を行っているところでございます"@ja.
<< kg:id_50 prop:countermeasure kg:id_56 >>
    prop:text-txt_contents "インバウンド向けアクティビティ予約サイトを上手に活用することで、まずは知ってもらい、それからトラブルなく楽しい体験をしていただくことが可能になる"@ja.
<< kg:id_50 prop:countermeasure kg:id_57 >>
    prop:text-txt_contents "もっと短時間で体験できる仕組みをつくるなどの対応が必要と考えているところでございます"@ja.
<< kg:id_50 prop:countermeasure kg:id_58 >>
    prop:text-txt_contents "食が育まれた地域の歴史や文化、環境を一つのストーリーとして提供することで、立派なアクティビティになる"@ja.
<< kg:id_50 prop:countermeasure kg:id_59 >>
    prop:text-txt_contents "酒田に行けばこんな体験ができるという情報発信をしっかりと行っていきたい"@ja.
<< kg:id_50 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "駅起点で酒田を楽しむ、あるいは鳥海山麓や出羽三山もあわせて楽しむための手段や食、あるいは宿泊など情報発信を行いまして、広域で誘客を図っていきたい"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "新規路線は成田空港間になるため、既存路線との住み分けが図られ、インバウンドのお客様やこれまでとは違った客層など、新たな需要の掘り起こしにつながるものと期待しております"@ja.
<< kg:id_61 prop:effect kg:id_63 >>
    prop:text-txt_contents "庄内から都心に向かう地元住民にとりましても、交通手段の選択肢がふえることになり"@ja.
<< kg:id_61 prop:effect kg:id_64 >>
    prop:text-txt_contents "都心への交通の利便性の向上につながる動きである"@ja.
<< kg:id_61 prop:effect kg:id_65 >>
    prop:text-txt_contents "地域の交流人口増加の観点からも非常に期待しているところです"@ja.
<< kg:id_61 prop:countermeasure kg:id_66 >>
    prop:text-txt_contents "庄内空港の新規路線就航に向けた取り組みとして、空港ビルの施設改修など受け入れ体制の整備費6,700万円を盛り込んでおります"@ja.
<< kg:id_61 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "経済界など関係機関と協力しながら、ＬＣＣ就航の実現に向けまして、環境整備など必要な支援を県に対して要望してまいります"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:text-txt_contents "８月５日の豪雨では、短時間に大量の雨が降ったことによるいわゆる内水氾濫により"@ja.
<< kg:id_70 prop:cause kg:id_71 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "短時間による大雨の影響で側溝や下水道の雨水処理能力を超えることで起きる内水氾濫"@ja.
<< kg:id_68 prop:effect kg:id_72 >>
    prop:text-txt_contents "道路冠水はもとより、住宅への浸水被害が多く発生いたしました"@ja.
<< kg:id_68 prop:effect kg:id_73 >>
    prop:text-txt_contents "道路冠水はもとより、住宅への浸水被害が多く発生いたしました"@ja.
<< kg:id_70 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "浸水区域を示したわかりやすい図面を作成するなどして、災害対応、住民が避難行動をとる場合の避難路の選択などに活用できるようにしていきたい"@ja.
<< kg:id_75 prop:countermeasure kg:id_76 >>
    prop:text-txt_contents "本市では、国と連携し、最上川、赤川など国の直轄区間における５観測所での水害対応のタイムラインを策定しているところでございます"@ja.
<< kg:id_75 prop:countermeasure kg:id_77 >>
    prop:text-txt_contents "山形県管理の二級河川についても、山形県や関係自治体で構成する山形県二級河川大規模氾濫時の減災対策協議会におきまして、平成33年度までに作成する"@ja.
<< kg:id_75 prop:countermeasure kg:id_78 >>
    prop:text-txt_contents "国と県と連携いたしまして毎年洪水対応演習を行っております"@ja.
<< kg:id_75 prop:countermeasure kg:id_79 >>
    prop:text-txt_contents "河川国道事務所長から直接情報伝達を受けるホットライン訓練などもこの中で実施している"@ja.
<< kg:id_75 prop:countermeasure kg:id_80 >>
    prop:text-txt_contents "今後は、総合防災訓練としても洪水想定の訓練を行うなど、タイムラインの実効性を高めていきたい"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:text-txt_contents "洪水ハザードマップや津波ハザードマップを作成し全戸配布するとともに、ホームページ上で公開するなどして周知している"@ja.
<< kg:id_81 prop:countermeasure kg:id_83 >>
    prop:text-txt_contents "引き続き出前講座や説明会などで適切な理解、利用を図られるようにしてまいりたい"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:text-txt_contents "本市の場合は、積雪期の融雪型火山泥流の発生によりまして、日向川流域において最大で19地区が浸水などの被害想定区域となっている"@ja.
<< kg:id_84 prop:effect kg:id_86 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "現象が生じてから短時間で登山者、観光客に影響が及び、生命に対する危険性が非常に高くなる"@ja.
<< kg:id_84 prop:countermeasure kg:id_87 >>
    prop:text-txt_contents "平成29年度は、火山対策として県・市町の防災行動の指針となる防災対策"@ja.
<< kg:id_84 prop:countermeasure kg:id_88 >>
    prop:text-txt_contents "平成30年度は登山者、住民などの避難行動の指針となる避難計画を策定をしている"@ja.
<< kg:id_84 prop:countermeasure kg:id_89 >>
    prop:text-txt_contents "来年度、平成31年度は自衛隊や警察、消防などの機関が救助を行う場合の指針となります救助計画などを策定する予定"@ja.
<< kg:id_84 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "鳥海山火山防災協議会では平成31年度に避難促進施設の選定基準を検討していく予定"@ja.
<< kg:id_84 prop:countermeasure kg:id_91 >>
    prop:text-txt_contents "火山活動や噴火の状況に応じて登山道の閉鎖ですとか、入山規制、道路の通行規制を行うなど統一した防災対応を実施していく"@ja.
<< kg:id_84 prop:countermeasure kg:id_92 >>
    prop:text-txt_contents "市では、関係機関への情報伝達と同時に緊急速報メールや防災行政無線、ＳＮＳなどによりまして警戒が必要な範囲からの避難を呼びかける"@ja.
<< kg:id_84 prop:countermeasure kg:id_93 >>
    prop:text-txt_contents "山形県がヘリコプターによる上空からの周知を行うこととなっております"@ja.
<< kg:id_94 prop:cause kg:id_95 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "ここに来て一挙に多くの事業者が固定価格買い取り制度、ＦＩＴを利用して発電事業に参入してきているようです"@ja.
<< kg:id_94 prop:countermeasure kg:id_96 >>
    prop:text-txt_contents "酒田市の総合計画に掲げる主な施策であります、酒田臨海工業団地における再生可能エネルギー産業の集積"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:text-txt_contents "八幡総合支所、松山農村環境改善センター、ひらたタウンセンター、とびしま総合センターの４施設に、平成27年度に太陽光発電施設と蓄電池の設置を完了しております"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:text-txt_contents "林業の採算性の悪化や"@ja.
<< kg:id_99 prop:cause kg:id_101 >>
    prop:text-txt_contents "所有者や境界がわからない森林の増加"@ja.
<< kg:id_99 prop:cause kg:id_102 >>
    prop:text-txt_contents "担い手の不足などにより手入れが行き届いていない森林の存在が今、顕在化している"@ja.
<< kg:id_99 prop:effect kg:id_103 >>
    prop:text-txt_contents "手入れが行き届いていない森林の存在が今、顕在化しているところでございます"@ja.
<< kg:id_104 prop:countermeasure kg:id_105 >>
    prop:text-txt_contents "森林所有者に対する経営管理の意向調査"@ja.
<< kg:id_104 prop:countermeasure kg:id_106 >>
    prop:text-txt_contents "それに鑑みました森林整備に加えまして"@ja.
<< kg:id_104 prop:countermeasure kg:id_107 >>
    prop:text-txt_contents "公共建設物などへの木材利用に充当する予定としております"@ja.
<< kg:id_104 prop:countermeasure kg:id_108 >>
    prop:text-txt_contents "森林環境譲与税基金条例を新設し、将来の事業を実施する基金を積み立てる予定としている"@ja.
<< kg:id_99 prop:countermeasure kg:id_109 >>
    prop:text-txt_contents "林業経営に適した森林は意欲と能力のある林業経営者に再委託いたします"@ja.
<< kg:id_99 prop:countermeasure kg:id_110 >>
    prop:text-txt_contents "林業経営に適さない森林ですとか、再委託に至るまでの森林につきましては市が公的管理をいたします"@ja.
<< kg:id_99 prop:effect kg:id_111 >>
    prop:text-txt_contents "間伐が手おくれになったりすることの解消"@ja.
<< kg:id_99 prop:effect kg:id_112 >>
    prop:text-txt_contents "伐採以後の再造林の促進などが図られる"@ja.
<< kg:id_113 prop:effect kg:id_114 >>
    prop:text-txt_contents "安定的に木材が供給されることで酒田産木材の利用を促進し"@ja.
<< kg:id_113 prop:effect kg:id_115 >>
    prop:text-txt_contents "雇用の創出ですとか"@ja.
<< kg:id_113 prop:effect kg:id_116 >>
    prop:text-txt_contents "地域経済の活性化が図られるように取り組んでいきたい"@ja.
<< kg:id_72 prop:effect kg:id_117 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "今回、豪雨で道路冠水を突っ切った結果、車を修理に出した方もおり"@ja.
<< kg:id_72 prop:countermeasure kg:id_118 >>
    prop:text-txt_contents "通行が困難と判断した場合に道路管理者や警察が速やかに通行どめを行っております"@ja.
<< kg:id_119 prop:countermeasure kg:id_120 >>
    prop:text-txt_contents "床下浸水等があった場合は、環境衛生課による消毒作業のほか"@ja.
<< kg:id_119 prop:countermeasure kg:id_121 >>
    prop:text-txt_contents "発生したごみ処分の免除の対応をとっておるところでございます"@ja.
<< kg:id_122 prop:countermeasure kg:id_123 >>
    prop:text-txt_contents "市街地における浸水対策といたしましては、昭和45年から着手しております合流式下水道の整備"@ja.
<< kg:id_122 prop:countermeasure kg:id_124 >>
    prop:text-txt_contents "現在、緊急度の高い地区から雨水幹線の整備に着手しておるところです"@ja.
<< kg:id_122 prop:countermeasure kg:id_125 >>
    prop:text-txt_contents "新井田川等への河川へ強制的に排水するための幹線排水路のポンプ施設"@ja.
<< kg:id_122 prop:countermeasure kg:id_126 >>
    prop:text-txt_contents "一時的にピークをカットする貯留施設の整備"@ja.
<< kg:id_122 prop:countermeasure kg:id_127 >>
    prop:text-txt_contents "側溝の断面改修などを行って浸水区域における被害の軽減を図っている"@ja.
<< kg:id_122 prop:countermeasure kg:id_128 >>
    prop:text-txt_contents "平成28年度に3,400立方メートルの雨水を一時貯留する雨水貯留槽の整備を行って"@ja.
<< kg:id_122 prop:countermeasure kg:id_129 >>
    prop:text-txt_contents "平成24年度に東泉地区、平成26年度に若浜地区に排水ポンプゲートを設置しております"@ja.
<< kg:id_130 prop:effect kg:id_131 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "日本海沿岸住民の不安をかきたてることとなりました"@ja.
<< kg:id_130 prop:countermeasure kg:id_132 >>
    prop:text-txt_contents "海上保安庁では、木造船の監視対策として航空機によるパトロールを強化し対応をしている"@ja.
<< kg:id_130 prop:countermeasure kg:id_133 >>
    prop:text-txt_contents "庄内海岸への漂流・漂着船等に係る関係機関連絡調整会議という会議を開催をしておりまして、関係機関で連携をしながら対応をしている"@ja.
<< kg:id_134 prop:countermeasure kg:id_135 >>
    prop:text-txt_contents "漂流船が確認された場合は船舶関係者に通知をしている"@ja.
<< kg:id_134 prop:countermeasure kg:id_136 >>
    prop:text-txt_contents "漂流船が発見された場合は金属製の反射物や目印を取りつける作業を行い、航行の安全対策を行っている"@ja.
<< kg:id_130 prop:countermeasure kg:id_137 >>
    prop:text-txt_contents "漂着船については海岸管理者である山形県が撤去と処分を行っている"@ja.
<< kg:id_138 prop:cause kg:id_139 >>
    prop:text-txt_contents "外国船による違法操業が相次いだことから"@ja.
<< kg:id_138 prop:effect kg:id_140 >>
    prop:text-txt_contents "今年度の水揚げ量は11月末現在で1,170ｔでございまして、前年同期の８割にとどまっている"@ja.
<< kg:id_141 prop:effect kg:id_142 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "大型の鋼船、鋼鉄製の船が出現をして、また、外国の木造船も多数出現するなど、漁業者の安全な操業が困難な状況"@ja.
<< kg:id_141 prop:countermeasure kg:id_143 >>
    prop:text-txt_contents "水産庁漁業取締船や海上保安庁巡視船をスルメイカの漁場であります大和堆へ派遣をして"@ja.
<< kg:id_141 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "11月２日、私も山形県や山形県漁業協同組合の関係者とともに、水産庁に対して取り締まり強化の要請に伺った"@ja.
<< kg:id_141 prop:effect kg:id_145 >>
    prop:text-txt_contents "酒田港を船籍とする中型イカ釣り船が日本海の大和堆付近の日韓の暫定水域で韓国の漁船と衝突する事故が発生"@ja.
<< kg:id_141 prop:countermeasure kg:id_146 >>
    prop:text-txt_contents "県漁業協同組合では所属する全ての漁船に対して、改めて安全操業に関する注意喚起を行っている"@ja.
<< kg:id_147 prop:countermeasure kg:id_148 >>
    prop:text-txt_contents "漁場の環境保全や資源の保護、つくり育てる漁業が重要でありまして、ヒラメ等の種苗放流を引き続き実施をしている"@ja.
<< kg:id_147 prop:countermeasure kg:id_149 >>
    prop:text-txt_contents "ヒラメの稚魚が３万1,400尾"@ja.
<< kg:id_147 prop:countermeasure kg:id_150 >>
    prop:text-txt_contents "トラフグの稚魚が１万7,000尾を放流した"@ja.
<< kg:id_147 prop:countermeasure kg:id_151 >>
    prop:text-txt_contents "ヒラメの稚魚6,000尾"@ja.
<< kg:id_147 prop:countermeasure kg:id_152 >>
    prop:text-txt_contents "アワビの稚貝１万8,000個"@ja.
<< kg:id_147 prop:countermeasure kg:id_153 >>
    prop:text-txt_contents "サザエの稚貝２万2,200個の種苗放流を行った"@ja.
<< kg:id_147 prop:countermeasure kg:id_154 >>
    prop:text-txt_contents "今年度は漁業者の所得向上を目的に、新たに高級魚のキジハタの放流なども行っている"@ja.
<< kg:id_155 prop:effect kg:id_156 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "こうした種苗放流によりまして、漁業者が減少している中でも一定の水揚げ量は維持できている"@ja.
<< kg:id_147 prop:countermeasure kg:id_157 >>
    prop:text-txt_contents "山形県の水産試験場では効果的な放流場所やサイズに関して調査、研究を続けております"@ja.
}
