<< kg:id_107 prop:effect kg:id_110 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "生命の危険な状態からの回避と早期の社会復帰が期待されます"@ja.
