kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_3.
kg:op_59 prop:content "酒田創生につながるストック効果を期待する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_3.
kg:op_60 prop:content "未着手区間の早期整備着手を国に強力に働きかける"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_3.
kg:op_61 prop:content "地域を挙げて国に強力に働きかける"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:op_62 prop:content "地域を挙げて国に強力に働きかける"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_3.
kg:op_63 prop:content "地域を挙げて国に強力に働きかける"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_3.
kg:op_64 prop:content "公平な負担と安定した収入確保が必要"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_3.
kg:op_65 prop:content "基金を保持しながら財政基盤を確立する必要がある"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_3.
kg:op_66 prop:content "地元産品のP Rを兼ねた自主財源確保策として引き続き取り組む"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_3.
kg:op_67 prop:content "地元産品のPRを兼ねた有効な自主財源確保策として取り組む"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_3.
kg:op_68 prop:content "寄附金の使い道を見える化し一層の推進と拡大を図る"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_3.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:text-txt_contents "本案は、職員による不祥事が発生または発生が疑われる場合において、実態の把握や再発防止を図る目的で、第三者による調査・検証を行う組織を設置するため、条例を制定するものであり"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "本案は、企業立地の促進等による地域における産業集積の形成及び活性化に関する法律の一部を改正する法律が制定されたことに伴い、所要の改正を行うものであり"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "本案は、企業立地の促進と既存企業の育成を図るため、用地取得助成金の適用期限を延長することについて、所要の改正を行うものであり"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "本案は、平成29年度中町モール改修工事において、採用した既存地質調査結果と現地の地質とに相違があり"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:text-txt_contents "大屋根の基礎構造を見直したこと等により、請負金額及び工期を変更するため"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:text-txt_contents "１月の大寒波による除雪対応により、今後の除雪経費に不足が生じるおそれがあるため"@ja.
<< kg:id_10 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "１月の大寒波による除雪対応により、今後の除雪経費に不足が生じるおそれがあるため、当該経費を増額することについて専決処分した"@ja.
<< kg:id_13 prop:effect kg:id_11 >>
    prop:text-txt_contents "１月下旬以降の大寒波による除雪対応により、今後の除雪経費に不足が生じるおそれがあるため"@ja.
<< kg:id_13 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "１月下旬以降の大寒波による除雪対応により、今後の除雪経費に不足が生じるおそれがあるため、当該経費を増額することについて専決処分した"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:text-txt_contents "ふるさと納税寄附金件数の増に伴う、ふるさと納税推進事業費の増額"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:text-txt_contents "国の補正予算に伴う担い手確保・経営強化支援事業費の新たな計上"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:text-txt_contents "消防本署跡地の駐車場整備に伴う観光物産施設管理運営事業費の増額"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:text-txt_contents "県施行急傾斜地崩壊対策事業負担金の確定に伴う公共土木施設災害復旧事業費の増額"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:text-txt_contents "後年度負担の軽減を目的に、市債の繰上償還を実施するための公債費元金の増額"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:text-txt_contents "歳入では、市民税及び固定資産税の増収などによる市税"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:text-txt_contents "普通交付税の確定による地方交付税"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:text-txt_contents "土地売払収入の増による財産収入"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:text-txt_contents "ふるさと納税寄附金の増による寄附金"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "収益がふえた要因として４点挙げましたが、その一つに、病棟を廃止したことによって自宅で点滴をされている患者さんがいるためとしました"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "独立行政法人に移管する前に少しでも借金を償還して一般会計に引き継ぐための企業債償還金も含まれておりました"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "八幡病院の土地と建物は普通財産に変更した後に独立行政法人に無償で貸し付けるものであり"@ja.
<< kg:id_38 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "移管後もクリニックについては酒田市の財産のため、施設の改修については酒田市の判断であり、移管後の利活用や将来の改築についても、酒田市は市民要望を踏まえて独法にきちんと意見が言える"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "八幡病院の病棟を廃止して診療所化したもとで独立行政法人に移管が前提の議案でありました"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "このように、まちづくりへの市民参画が今回の総合計画策定を機に市民に浸透しつつあるのではないかと思われました"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "人口減少、少子高齢化が進む本市は、消滅可能性都市の一つに取り上げられるなど厳しい状況にあります"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "鳥海山・飛島ジオパーク認定や北前船寄港地・船主集落の日本遺産認定、酒田港初となる外航クルーズ船の寄港など、港町酒田を大きく国内外に発信しています"@ja.
<< kg:id_48 prop:effect kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "鳥海山・飛島ジオパーク認定や北前船寄港地・船主集落の日本遺産認定、酒田港初となる外航クルーズ船の寄港など、港町酒田を大きく国内外に発信しています"@ja.
<< kg:id_49 prop:effect kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "鳥海山・飛島ジオパーク認定や北前船寄港地・船主集落の日本遺産認定、酒田港初となる外航クルーズ船の寄港など、港町酒田を大きく国内外に発信しています"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "総合未来会議（市民ワークショップ）を全11回、多職種・多分野版未来会議を１回、未来を担う東北公益文科大学版未来会議を全４回開催し、延べ1,300人を超える市民の参画を得て策定をいたしました"@ja.
<< kg:id_52 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "このたびの予算編成では、１、産業振興まちづくりセンターを核とした仕事おこし、まちおこしの推進力の強化"@ja.
<< kg:id_54 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "文化芸術、歴史の力を酒田の魅力磨きのツールとして活かす考えです"@ja.
<< kg:id_56 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "医療や保育などの健康福祉分野においては、関係機関との連携を強化し"@ja.
<< kg:id_56 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "病児病後児保育の送迎支援"@ja.
<< kg:id_56 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "救急車から医師に心電図データ等を送信するシステムの導入など、市民の皆様の生命と暮らしを支える体制の充実に努めていきます"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "平成30年度予算は、人口減少の荒波の中、この新総合計画に基づく「まち」の創生につなげていくために本市が全力航行する予算と考えています"@ja.
<< kg:id_62 prop:effect kg:id_63 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "本市を含む多くの地方都市においては、高校卒業後の進学や就職による市外転出が人口減少の要因となっており"@ja.
<< kg:id_62 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "若い世代が地元企業を知る機会の提供や、ＵＩＪターン就職のマッチングに注力していきます"@ja.
<< kg:id_62 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "若い世代が地元企業を知る機会の提供や、ＵＩＪターン就職のマッチングに注力していきます"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "働く女性が安心して育児休暇を取得し、事業主にはその間の人材確保を容易にするといった、本市事業所における育児休暇取得を促進する環境を整えるため、育休代替支援人材バンクなど、育休代替支援方法を検討します"@ja.
<< kg:id_66 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "産業振興まちづくりセンターに女性活躍支援員を配置し、事業主に対して山形いきいき子育て応援企業の登録認定を促すなど、各種支援制度の周知に努めます"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "子育てをしながら働く方を支援するため、あきほ病児・病後児保育所の定員を拡充するとともに"@ja.
<< kg:id_69 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "保育所等と日本海総合病院との間の送迎も行います"@ja.
<< kg:id_72 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "介護を理由に離職する方をゼロにすることを目指して、介護サービスの基盤整備を計画的に実施します"@ja.
<< kg:id_74 prop:cause kg:id_75 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "平成30年産米からは、国による生産数量目標の配分が廃止される"@ja.
<< kg:id_74 prop:cause kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "米の直接支払交付金も廃止されるなど、米政策が大きく転換します"@ja.
<< kg:id_74 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "本市では、新たな「酒田市の農業の方向性」を策定し、担い手の農業経営基盤の強化と農業産出額の増加を実現するための対策に取り組みます"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "所有者の所在が不明な森林や、林地の境界が不明確な森林が増加し、森林整備に支障を来している状況"@ja.
<< kg:id_78 prop:cause kg:id_80 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "所有者の所在が不明な森林や、林地の境界が不明確な森林が増加し、森林整備に支障を来している状況"@ja.
<< kg:id_78 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "所有者等の情報を一元化した林地台帳の整備を行うことにより、森林施業の集約化を進めます"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "人口減少によるまちのにぎわい、地域の経済が縮小していかざるを得ない状況において、本市を訪れる観光客を初めとする交流人口を拡大していくことは重要なテーマである"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "本市の高齢化率は平成29年12月末時点で34％を超えました。いつまでも自立した日常生活を営むためには、社会に参加するという意識の醸成が重要です"@ja.
<< kg:id_84 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "自治会等が取り組む身近な居場所づくりや介護予防、健康づくりへの支援を拡充するとともに"@ja.
<< kg:id_84 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "介護予防・生活支援サービス事業に取り組む団体への支援も引き続き行っていきます"@ja.
<< kg:id_88 prop:effect kg:id_89 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "人口減少や核家族化が進み、保護者の働き方が多様化する中、子育て世代が希望に応じて社会で活躍できるよう環境を整備していく必要があります"@ja.
<< kg:id_88 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "保育環境の充実のため、民間保育園の施設改修を支援するとともに"@ja.
<< kg:id_88 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "若竹保育園と浜田保育園を統合した保育園の開設を進め、保護者ニーズが高い一時預かり等の特別保育の充実を図ります"@ja.
<< kg:id_88 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "発達支援室の相談員を増員し相談体制を強化するとともに"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "保育園等の運営に影響を与えている保育士等の人材不足"@ja.
<< kg:id_93 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "保育士等の人材不足を改善するために、保育士等の処遇改善を行う"@ja.
<< kg:id_93 prop:contermeasure kg:id_96 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "保育士養成校の学生等を対象にした保育士就職ガイダンスを実施して、保育士等の人材確保に努めます"@ja.
<< kg:id_97 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "安定かつ持続可能な地域医療体制を目指し、地方独立行政法人山形県・酒田市病院機構に八幡地域、松山地域、飛島地域の診療体制を移管統合します"@ja.
<< kg:id_97 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "病院機構を含む市内９法人で構成する地域医療連携推進法人日本海ヘルスケアネットが設立されることから、医療と介護の連携に取り組み、地域包括ケアシステムの構築を推進します"@ja.
<< kg:id_100 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "家庭系ごみの有料化については、平成29年度に実施した市民説明会や市民アンケート等でいただいた意見等を参考にしながら、引き続き検討を進めます"@ja.
<< kg:id_102 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "風力発電事業については、現在、山形県立自然公園条例に基づく手続を進めています。再生可能エネルギーの活用と自然環境の保全の両立が図られるよう努めていきます"@ja.
<< kg:id_104 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "迅速かつ的確に対応できるよう、情報伝達体制の整備や実効性のある訓練の充実を図ります"@ja.
<< kg:id_104 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "迅速かつ的確に対応できるよう、情報伝達体制の整備や実効性のある訓練の充実を図ります"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "生命に重大な危険を及ぼす心疾患が疑われる患者の詳細な心電図データを搬送先の医療機関に送信することで"@ja.
<< kg:id_107 prop:effect kg:id_109 >>
