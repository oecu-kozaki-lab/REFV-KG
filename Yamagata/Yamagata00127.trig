kg:st_1 rdfs:label "後藤泉議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "被害への早急な状況確認と支援を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "被害に遭った人への支援を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "被害の全容調査と支援対応を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "行政当局に迅速な確認と支援対応を求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "地域交通の脆弱性が改めて浮き彫りになったと指摘"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "交通網の脆弱性解消が必要と指摘"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "交通網の脆弱性解消が必要と指摘"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地域の交通脆弱性が深刻だと指摘"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "安全重視は進んだが高速交通としては後退していると指摘"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "徐行運転増加で高速交通網に逆行していると指摘"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "高速交通体制がなければ交流人口拡大は難しいと指摘"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "高速交通体制整備が経済活性化に不可欠と指摘"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "交通基盤強化へ地域一丸の運動が重要と主張"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "延長により使い方と返済計画の見直しが必要になると指摘"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "延長は自治体財政計画に影響すると指摘"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "有利な起債は活用すべきと述べる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "本市産業発展の核となる施策として大きな期待を示す"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "市民や地元企業の期待が大きいと述べる"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "産業発展の核となる施策だと評価"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "歴史資料や文化財の早急なデジタル化を要望"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "市民の注目度が高い事業として整備検討手法を問う"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "宣言だけでなく日本一宣言となる実効性を求める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "制度周知と企業への丁寧な説明が必要と指摘"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "働く女性への制度周知を強化すべきと主張"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "企業側への丁寧な説明と周知が必要と主張"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "防災意識高揚の施策をもっと展開すべきと主張"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "民間の危機意識に学ぶべきと示唆"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "当初から環境アセス逃れが問題視されていたと指摘"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "景観への重大な支障を懸念"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "砂草地の問題が未解決のまま進められたと批判"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "専門家意見を十分集約していないと批判"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "地元研究者の意見聴取不足を指摘"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "未解決論点を残したまま許可した県を批判"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "市民協働に反する決め方だったと批判"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "現市政の理念と相反する負の政策と位置づける"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "将来世代にリスクを負わせないため再検討を求める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "高速交通体系の脆弱性解消が進んでいないと指摘"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "道路・鉄道・空を含めた具体的運動を求める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_39 prop:content "新総合計画実行予算として重点化したと説明"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "新総合計画実行予算として重点化したと説明"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "安全・安心分野にも注力したと説明"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "市民協働を重視した予算と説明"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "人口減少抑制へ多様な施策を盛り込んだと説明"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "市民所得向上を新総合計画の主要目標と説明"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "定住意向を高める施策を重視すると説明"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "有利な財源活用を検討すると説明"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "有利な起債活用を検討すると説明"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "有利な起債活用を検討すると説明"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "有利な起債活用を検討すると説明"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "つなぐをキーワードに産学官金連携で進めると説明"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "課題とシーズをつなぎ売上アップにつなげると説明"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "準備から販路まで伴走支援すると説明"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "女性が働きやすい環境整備を企業にＰＲすると説明"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "支援制度の周知にも努めると説明"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "新たなビジネスや農商工連携のきっかけづくりを目指すと説明"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "具体的な評価指標を設定していると説明"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "創業件数の目標を設定したと説明"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "国史跡指定に向けた調査を進めると説明"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "歴史観光資源との機能連携が重要と説明"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "観光交流機能を中心に整備検討すると説明"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:st_3 rdfs:label "永田斉総務部市政推進調整監兼危機管理監"@ja.
kg:st_3 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_61 prop:content "より実効性の高い訓練へ切り替えると説明"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:op_62 prop:content "地域での避難所運営訓練を中心に実効性を高めると説明"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_3.
kg:op_63 prop:content "防災対策強化として進めると説明"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_3.
kg:op_64 prop:content "防災対策強化として普及を進めると説明"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_3.
kg:op_65 prop:content "ハード面の防災対策を進めると説明"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_3.
kg:op_66 prop:content "消防団の機動力強化を図ると説明"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_3.
kg:op_67 prop:content "自然環境と調和したよりよい事業にしていく考えを示す"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "人口減少下で高速交通整備は不可欠と認識を示す"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "短中期的に実現可能性が高い高速道路整備を重視すると説明"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "縦軸横軸の高速道路網整備を喫緊の課題と説明"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "空港の利便性向上へ取り組む必要があると説明"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "格安航空会社誘致も課題と説明"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "関西圏との路線拡充も必要と説明"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "短期間かつ低コストで実現可能な手法として訴えていくと説明"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "効率的な整備手法として中速鉄道の考え方を取り入れるよう運動すると説明"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "先日３月１日から２日にかけて、飛島では最大瞬間風速40ｍに近いほどの大変な風が吹き荒れたように春の嵐が各地を襲い"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "春の嵐が各地を襲い、県内もあちらこちらで被害が発生しているようであります。本市においても被害が報告されているようです"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本市においても被害が報告されているようですが、まだ全容は調査中のようであります"@ja.
<< kg:id_3 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "行政当局におかれましては、いち早い状況確認と御支援ができますように御対応をお願い申し上げます"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "庄内空港の空の便はもちろんのこと"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "羽越本線と陸羽西線、両方の鉄路も不通"@ja.
<< kg:id_7 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "羽越本線と陸羽西線、両方の鉄路も不通"@ja.
<< kg:id_7 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "まさに庄内は陸の孤島と化してしまった"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "高性能レーダーによって安全の重視は進みましたが"@ja.
<< kg:id_12 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "徐行運転もふえ、高速交通網という名には反比例するような状況にもなっている"@ja.
<< kg:id_12 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "この地域が陸路も鉄路も全国的な当たり前の高速交通体制を享受できるようにならなければ、交流人口の拡大や経済の活性化にはつながらず"@ja.
<< kg:id_12 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "交流人口の拡大や経済の活性化にはつながらず"@ja.
<< kg:id_7 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "そのためにはこれからもますます地域一丸となって力を入れた運動が重要と再認識したところであります"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "合併特例債の発行期限がさらに５年間延長されるという国の動きが報道され"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "全国の合併した市町村は、その使い方と返済の計画を見直すことになる"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "このような大変有利な借り入れは当然利用すべきであると思う"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "これまでさまざまな検討を重ねてこられた産業振興まちづくりセンターが、いよいよ来月オープン"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "多くの市民や地元企業の方々からは大変大きな期待が寄せられている"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "私はまさに本市の産業発展の核となる施策であると思っています"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "貴重な歴史資料や有形・無形の文化財等のデジタル化による保存と発信について早急な実施を要望"@ja.
<< kg:id_30 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "山居倉庫周辺地区の整備検討が始まるようであります"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "「日本一女性が働きやすいまち」を目指す宣言"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "また減額補正されるようでは意味がありません"@ja.
<< kg:id_34 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "いかに働く女性に支援制度を周知していくか"@ja.
<< kg:id_34 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "雇用している企業側へも丁寧な説明と周知をしていくか"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "本市でも市民の防災意識の高揚のための施策をもっと展開していただきたい"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "酒田共同火力発電株式会社では、自前で津波防災タワーを建設しました。常日ごろの危機意識が建設に結びついている"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "この事業に関しては当初から環境アセス逃れと指摘され"@ja.
<< kg:id_42 prop:cause kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "日本海を代表する白砂青松の海岸の風致景観に著しい支障を与えるおそれがある"@ja.
<< kg:id_42 prop:cause kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "今特に問題とされている砂草地に関することでは、自主アセスといえども庄内森林管理署の見解を理解していない"@ja.
<< kg:id_42 prop:cause kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "山形大学の海岸林などの専門の先生方の意見を集約していないこと"@ja.
<< kg:id_42 prop:cause kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "地元の砂草地研究の第一人者の意見を聞いていないこと"@ja.
<< kg:id_42 prop:effect kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "たくさんの未解決な議論がまだまだあったにもかかわらず、県はゴーサインを出してしまいました"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "市民との合意形成も何もされてこなかったトップダウンの政策"@ja.
<< kg:id_49 prop:effect kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "市民協働を理念に置く丸山市政においては相反する決め方で決定された"@ja.
<< kg:id_49 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "一歩立ちどまることになろうとも、本市での最適地を模索し、再生可能エネルギーの形成を再検討していくべき"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "その脆弱性と未接続・未整備区間の解消がなかなか進まない状況"@ja.
<< kg:id_53 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "本市として、また庄内全体として、道路、鉄道、また空も含め、今後どのように具体的に運動を展開していくのか"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "平成30年度の予算は産業おこし、そして人づくり、さらには安全・安心、そして市民協働、この４点に注力した予算案"@ja.
<< kg:id_56 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "平成30年度の予算は産業おこし、そして人づくり、さらには安全・安心、そして市民協働、この４点に注力した予算案"@ja.
<< kg:id_56 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "平成30年度の予算は産業おこし、そして人づくり、さらには安全・安心、そして市民協働、この４点に注力した予算案"@ja.
<< kg:id_56 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "平成30年度の予算は産業おこし、そして人づくり、さらには安全・安心、そして市民協働、この４点に注力した予算案"@ja.
<< kg:id_61 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "とりわけ人口減少の抑制、それから市民所得の向上、さらには酒田市に住み続けたいと思う市民をふやすというこの３つの目標を達成するためにさまざまな施策を盛り込ませていただきました"@ja.
<< kg:id_63 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "市民所得の向上"@ja.
<< kg:id_65 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "酒田市に住み続けたいと思う市民をふやす"@ja.
<< kg:id_67 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "補助金ですとか"@ja.
<< kg:id_67 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "過疎対策事業債"@ja.
<< kg:id_67 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "辺地対策事業債"@ja.
<< kg:id_67 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "緊急防災・減災事業債"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "「つなぐ」という言葉をキーワードに、産学官金が連携をして産業振興を進めていくための組織"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "課題を持つ企業と課題を解決できるシーズを持った企業、そして専門家等をマッチングさせて企業の売り上げアップにつながるように支援"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "創業促進支援員を配置をして、起業の準備から資金調達、そして創業後の販路まで伴走支援する"@ja.
<< kg:id_32 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "女性活躍支援員を配置をいたしまして、女性が働きやすい環境整備が企業のメリットになることを事業者にＰＲ"@ja.
<< kg:id_32 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "各種支援制度の周知にも努めていきたい"@ja.
<< kg:id_80 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "新たなビジネスや農商工連携などの取り組みが生まれるようなセミナーですとかセッションを定期的に開催"@ja.
<< kg:id_25 prop:effect kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "センターでマッチングする件数を年間135件"@ja.
<< kg:id_25 prop:effect kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "創業件数としては30件という目標数値を設定"@ja.
<< kg:id_84 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "史跡の指定を受けるために行う"@ja.
<< kg:id_30 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "山居倉庫との機能連携を意識した整備、これが重要になってくる"@ja.
<< kg:id_30 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "交流人口の増加に資する観光交流機能をイメージして整備を検討していきたい"@ja.
<< kg:id_88 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "従来の展示型訓練から大幅に見直しをしまして、多くの住民が参画し、住民みずからが実際の災害をイメージし経験してもらう訓練に切りかえ"@ja.
<< kg:id_88 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "地域による小学校での避難所運営訓練を核としまして"@ja.
<< kg:id_88 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "防災行政無線のデジタル化"@ja.
<< kg:id_88 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "防災ラジオの普及"@ja.
<< kg:id_88 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "消防庁舎、総合防災センターの整備を進める"@ja.
<< kg:id_88 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "消防団に新たに資機材搬送車を導入することにより機動力の強化"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "改めて植生回復などについての意見をいただきながら、自然環境と調和したよりよい事業となるように鋭意進めてまいりたい"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "地域や経済、社会に深刻な影響を及ぼすことが懸念される"@ja.
<< kg:id_97 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "日本海沿岸、東北自動車道、それから新庄酒田地域高規格道路、この縦軸と横軸の高速道路網の一刻も早い開通の実現"@ja.
<< kg:id_97 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "新庄酒田地域高規格道路、この縦軸と横軸の高速道路網の一刻も早い開通の実現"@ja.
<< kg:id_101 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "東京便の通年５便化"@ja.
<< kg:id_101 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "ＬＣＣ、格安航空会社の誘致"@ja.
<< kg:id_101 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "関西圏との路線の拡充"@ja.
<< kg:id_105 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "在来線を活用して鉄道高速化を図るローカルプロジェクトとして、短期間かつ低コストで実現可能な整備手法"@ja.
<< kg:id_105 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "中速鉄道ということについての考え方、これをぜひ取り入れていただければということで、そのための運動はしっかりと展開"@ja.
}
