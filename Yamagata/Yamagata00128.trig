kg:st_1 rdfs:label "佐藤喜紀議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "企業誘致で新たな雇用を生み人口減少対策につなげるべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "企業誘致で新たな雇用を生み人口減少対策につなげるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "企業誘致で新たな雇用を生み人口減少対策につなげるべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "企業誘致で新たな雇用を生み人口減少対策につなげるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "厳しく困難な未来を回避するため企業誘致は欠かせない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "厳しく困難な未来を回避するため企業誘致は欠かせない"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "企業誘致は新たな雇用の創出や若年層定住拡大につながる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "企業誘致の成功で人口増加と雇用創出が期待できる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "企業誘致の成功で人口増加と雇用創出が期待できる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "若年層定住の拡大に向け企業誘致のターゲット業種を明確にすべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_11 prop:content "若い人たちの定住化につなげるため酒田港活用のメリットがある企業をターゲットにする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "若い人たちの定住化につなげるため成長分野の企業をターゲットにする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "既存企業との結びつきを期待できるものづくり企業を進めたい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "食品関連企業の立地を進めたい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "情報通信関連企業の立地を進めたい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "運輸倉庫業等の企業立地を進めたい"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "再生可能エネルギー産業の集積に効果の高い企業立地に努める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "酒田港の利活用促進に効果の高い企業立地に努める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "工業用地化には用途地域変更が必要で慎重な検討が必要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "工業用地化には用途地域変更が必要で慎重な検討が必要"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "埋め立て整備完了後に早期活用できるよう県に働きかける"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "再生可能エネルギー導入拡大で環境関連産業の育成が期待できる"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "再生可能エネルギー導入拡大で雇用創出が期待できる"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:st_3 rdfs:label "田中愛久商工観光部長"@ja.
kg:st_3 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_24 prop:content "酒田港の優位性と工業用水確保などが立地条件として適していた"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "工業用水を安定的に確保できることが立地条件として適していた"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "十分な用地を確保できることが立地条件として適していた"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "波及効果の高い産業で本市経済の活性化に寄与する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "港湾利用や荷役運搬の増加が見込まれる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "関連産業の新規雇用創出も見込まれる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "本市経済の活性化に寄与する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "本市のエネルギー産業基地としてのイメージアップが期待できる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "子供たちの学びの場としての活用も期待する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "隣接自治体案件でも酒田市民に関わるなら職員対応が必要"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "隣接自治体案件でも酒田市民に関わるなら職員対応が必要"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "隣接地での企業立地が具体化した際は近隣市町村と連携し市職員が対応する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "次回以降は本市職員が同席し住民不安に対応する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "耐震性や施設利用状況の課題で具体化していない"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "コミセン利用もあり具体化していない"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:st_4 rdfs:label "阿部勉企画振興部長"@ja.
kg:st_4 rdf:type cls:st_18.
kg:op_39 prop:content "地域の意見を聞きながら行政活用を基本に進める"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "新年度から行政経営課で遊休施設化しないよう方針を定める"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "死亡時の相続登記を促すことが所有者不明土地を増やさない水際対策になる"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:st_5 rdfs:label "佐藤猛議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_42 prop:content "災害復旧や道路拡幅などで自治体にとって厄介な問題である"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "相続人調査や相続人多数化で改善まで長期化する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "相続登記未了で誰と契約すべきかわからず農地移動が難しくなる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "所有者不明で境界確定できず森林整備や木材利用ができない例がある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "伐採適齢期の森林が放置され山林荒廃につながる"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "所有者不明森林の放置は二次災害の危険性を高める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "死亡届時の案内は所有者不明土地を増やさない重要な水際対策である"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "法務局リーフレット配布で相続登記を促す"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "関係窓口で相続登記の促しを強化する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "各課窓口での対応強化で所有者不明土地が増えないよう取り組む"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:st_6 rdfs:label "本間匡志総務部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_52 prop:content "資産価値が低い土地では登記しない傾向が増えている"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_6.
kg:st_7 rdfs:label "村上幸太郎教育長"@ja.
kg:st_7 rdf:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_53 prop:content "教職員の受講率を高め学校現場の安全管理意識を高める"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "中学校教員の受講者を増やすため中学校会場での実施を進めた"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "夜間開放も考慮し全小中学校で体育館付近に設置している"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "授業や行事に応じてAEDを移動し不慮の事故に備える"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_7.
kg:op_57 prop:content "心停止発生から5分以内除細動のため複数台設置を検討する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_7.
kg:op_58 prop:content "生徒自身が自分や他人の命を守る資質能力を育てたい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_7.
kg:op_59 prop:content "保健体育に限らずさまざまな場面で安全教育を進める"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_7.
kg:op_60 prop:content "外見でわかりにくい障がいのある人にとって有効な手段である"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_5.
kg:st_8 rdfs:label "岩堀慎司健康福祉部長"@ja.
kg:st_8 rdf:type cls:st_18.
kg:op_61 prop:content "視覚的に事情を伝えられ理解や配慮支援の拡大が期待できる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_8.
kg:op_62 prop:content "災害時や緊急時にも効果が期待できる"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_8.
kg:op_63 prop:content "県の導入普及に合わせ本市でも来年度から普及活用する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_8.
kg:op_64 prop:content "常時装着への抵抗や犯罪被害への懸念も踏まえヘルプカードを検討する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_8.
kg:op_65 prop:content "市民の認知と協力が欠かせないため積極的に普及啓発する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_8.
kg:op_66 prop:content "関係機関にも機会を捉えてPRし普及啓発に努める"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_8.
kg:op_67 prop:content "今後の利用者増加に対応できる後見人養成が必要"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_8.
kg:op_68 prop:content "現状は足りているが今後は後見人不足が生じると捉えている"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_8.
kg:op_69 prop:content "成年後見制度利用促進法に基づく課題として捉えている"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_8.
kg:op_70 prop:content "まず関係団体との連携ネットワークを早期に立ち上げたい"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_8.
kg:op_71 prop:content "中核機関としてのセンター設置は今後必要と認識している"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_8.
kg:op_72 prop:content "市民への制度周知浸透に力を注ぐべき"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_8.
kg:op_73 prop:content "制度の周知浸透と後見人養成に力を注ぐべき"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_8.
kg:op_74 prop:content "養成だけでなく養成後支援や継続研修が不可欠である"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_8.
kg:op_75 prop:content "中核機関の存在が重要である"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_8.
kg:st_9 rdfs:label "永田斉総務部市政推進調整監兼危機管理監"@ja.
kg:st_9 rdf:type cls:st_91.
cls:st_91 rdfs:label "監"@ja.
kg:op_76 prop:content "避難が難しい地域での避難が可能となり大きな課題が解消される"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_9.
kg:op_77 prop:content "大きな課題が解消され非常に意義がある"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_9.
kg:op_78 prop:content "円滑な避難が可能となるよう誘導標識整備を検討する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_9.
kg:op_79 prop:content "浸水深が浅い地域では垂直避難や地域の助け合いで対応する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_9.
kg:op_80 prop:content "地域での助け合いによる避難行動で対応する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_9.
kg:op_81 prop:content "現在のところ市単独での建設は考えていない"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_9.
kg:op_82 prop:content "見ている訓練から住民が実際に対応する訓練へ転換する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_9.
kg:op_83 prop:content "住民みずからが実際に対応する訓練を中心に組み立てる"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_9.
kg:op_84 prop:content "総合防災訓練以外でも避難所運営訓練を広げたい"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_9.
kg:op_85 prop:content "多くの女性に参加いただき意見が反映される体制を構築する"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_9.
kg:op_86 prop:content "女性の意見が反映される体制をしっかり構築する"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_9.
kg:op_87 prop:content "危険な場所と逃げる方法を体感でき地域で語り合える優れた手法である"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_9.
kg:op_88 prop:content "市民の購入が広く進むよう支援する"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_9.
kg:op_89 prop:content "高齢者だけの世帯約4000世帯の6割以上を目標にする"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_9.
kg:op_90 prop:content "他市状況も調査し給付対象品目追加を検討する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_9.
kg:op_91 prop:content "出前講座やホームページ活用など周知強化が必要"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_3.
kg:op_92 prop:content "これまで全戸配布や回覧広報掲載を行ってきた"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_3.
kg:op_93 prop:content "回覧や広報掲載も継続して行ってきた"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_3.
kg:op_94 prop:content "平成30年度から出前講座メニューに加え説明する"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_3.
kg:op_95 prop:content "ホームページ活用などでPRを強化する"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_3.
kg:op_96 prop:content "実際の車両を使った乗り方教室を実行したい"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_3.
kg:op_97 prop:content "事業者了承が得られておらず課題整理が必要"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_3.
kg:op_98 prop:content "キャンセルや責任の所在が課題となっている"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_3.
kg:op_99 prop:content "地区再編も必要でハードルが高い"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_3.
kg:op_100 prop:content "親しまれ浸透していくため愛称を検討したい"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_3.
kg:op_101 prop:content "財源確保の有効手段だが名称変更や企業調整など課題も多い"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_3.
kg:op_102 prop:content "山形運輸支局の助言も得ながら実現可能な方策を協議する"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_3.
kg:op_103 prop:content "地域住民の足の確保と民間事業者への影響のバランスが課題"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_3.
kg:op_104 prop:content "運賃体系や負担割合の整理が必要"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_3.
kg:op_105 prop:content "合併に伴う機能重複施設の保有で人口1人当たり延床面積が高い"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_6.
kg:op_106 prop:content "今後大規模改修や建て替えが増加する"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_6.
kg:op_107 prop:content "除却が進まず延床面積が微増している"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_6.
kg:op_108 prop:content "維持管理費縮減のため効率的管理運営が必要"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_6.
kg:op_109 prop:content "効率的管理運営とあわせ適正化が必要"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_6.
kg:op_110 prop:content "今後利用可能な施設は民間活力導入も含め検討する"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_6.
kg:op_111 prop:content "老朽化で利活用が難しい施設は売却や除却を進めたい"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_6.
kg:op_112 prop:content "経営的庁内横断的視点で適正化を推進する組織を設置する"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_6.
kg:op_113 prop:content "スクラップアンドビルドを意識し全庁横断的に進める"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_6.
kg:op_114 prop:content "10年ごとの期別単位で早目早目に情報提供し丁寧に進める"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_6.
kg:op_115 prop:content "情報共有を進め合意形成に努める"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_6.
kg:op_116 prop:content "山居倉庫は酒田市の宝物であり行政が残すべきものは残すべき"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_2.
kg:op_117 prop:content "歴史的価値のある財産として後世に伝えていくことが肝要"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_2.
kg:op_118 prop:content "行政だけで運営せず民間にも使ってもらえる手法を検討したい"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_4.
kg:op_119 prop:content "業界の自助努力に加え行政も受注機会や発注平準化で支える必要がある"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_2.
kg:op_120 prop:content "若い世代に建設業の魅力を伝える必要がある"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_2.
kg:op_121 prop:content "休日や労働環境の改善が必要"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_2.
kg:op_122 prop:content "過去の採用抑制が現在の人材不足に響いている"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_2.
kg:op_123 prop:content "入職促進だけでなく定着対策も重要である"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_2.
kg:op_124 prop:content "建設業協会が就職促進と定着に全力で取り組んでいる"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_2.
kg:op_125 prop:content "安定した仕事量確保のため公共事業の早期発注に努める"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_2.
kg:op_126 prop:content "年間を通した平準化で安定雇用につなげたい"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_2.
kg:op_127 prop:content "十分な工期確保に努める"@ja.
kg:op_127 rdf:type cls:opinion.
kg:op_127 prop:speaker kg:st_2.
kg:op_128 prop:content "国県に地元業者優先受注や受注機会増大を要望していく"@ja.
kg:op_128 rdf:type cls:opinion.
kg:op_128 prop:speaker kg:st_2.
kg:op_129 prop:content "企業見学や若手社員との意見交換で地元就職促進を図る"@ja.
kg:op_129 rdf:type cls:opinion.
kg:op_129 prop:speaker kg:st_2.
kg:op_130 prop:content "企業情報冊子配布による地元就職促進に取り組んでいる"@ja.
kg:op_130 rdf:type cls:opinion.
kg:op_130 prop:speaker kg:st_2.
kg:op_131 prop:content "介護人材不足は深刻さを増している"@ja.
kg:op_131 rdf:type cls:opinion.
kg:op_131 prop:speaker kg:st_2.
kg:op_132 prop:content "研修参加が困難で人材育成に支障が出ている"@ja.
kg:op_132 rdf:type cls:opinion.
kg:op_132 prop:speaker kg:st_2.
kg:op_133 prop:content "休暇取得にも支障が出ており数名の増員が必要とされる"@ja.
kg:op_133 rdf:type cls:opinion.
kg:op_133 prop:speaker kg:st_2.
kg:op_134 prop:content "処遇改善は引き続き必要である"@ja.
kg:op_134 rdf:type cls:opinion.
kg:op_134 prop:speaker kg:st_2.
kg:op_135 prop:content "キャリアアップは意欲向上と離職防止につながる"@ja.
kg:op_135 rdf:type cls:opinion.
kg:op_135 prop:speaker kg:st_2.
kg:op_136 prop:content "メンタルヘルス対策や介護ロボットICT化など職場環境改善が必要"@ja.
kg:op_136 rdf:type cls:opinion.
kg:op_136 prop:speaker kg:st_2.
kg:op_137 prop:content "働きながらキャリアアップする研修として期待している"@ja.
kg:op_137 rdf:type cls:opinion.
kg:op_137 prop:speaker kg:st_2.
kg:op_138 prop:content "資格取得後一定期間勤務で返還免除する取り組みに期待している"@ja.
kg:op_138 rdf:type cls:opinion.
kg:op_138 prop:speaker kg:st_2.
kg:op_139 prop:content "深夜勤務や対人関係のストレスに対応する必要がある"@ja.
kg:op_139 rdf:type cls:opinion.
kg:op_139 prop:speaker kg:st_2.
kg:op_140 prop:content "国県補助活用で負担軽減を進めている"@ja.
kg:op_140 rdf:type cls:opinion.
kg:op_140 prop:speaker kg:st_2.
kg:op_141 prop:content "事務効率化を図るICT化を補助活用し進めている"@ja.
kg:op_141 rdf:type cls:opinion.
kg:op_141 prop:speaker kg:st_2.
kg:op_142 prop:content "調査結果を踏まえ引き続き事業者との実態把握を行う"@ja.
kg:op_142 rdf:type cls:opinion.
kg:op_142 prop:speaker kg:st_8.
kg:op_143 prop:content "人材不足解消に向けた取り組みを協議会で検討したい"@ja.
kg:op_143 rdf:type cls:opinion.
kg:op_143 prop:speaker kg:st_8.
kg:op_144 prop:content "介護職を進路選択肢として意識してもらえるようにしたい"@ja.
kg:op_144 rdf:type cls:opinion.
kg:op_144 prop:speaker kg:st_8.
kg:op_145 prop:content "観光客が多い店舗の求めに応じて必要なパンフレットを届けている"@ja.
kg:op_145 rdf:type cls:opinion.
kg:op_145 prop:speaker kg:st_3.
kg:op_146 prop:content "コンビニの存在は大きく市からどのような情報提供ができるか検討する"@ja.
kg:op_146 rdf:type cls:opinion.
kg:op_146 prop:speaker kg:st_3.
kg:op_147 prop:content "道路交通状況や避難所開設情報を掲示し広く周知を図りたい"@ja.
kg:op_147 rdf:type cls:opinion.
kg:op_147 prop:speaker kg:st_3.
kg:op_148 prop:content "今後もセブンイレブン等民間企業と連携し災害対応に努める"@ja.
kg:op_148 rdf:type cls:opinion.
kg:op_148 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本市における人口減少は、労働力の減少、経済成長の鈍化、地域経済の縮小、地域財政の持続、継続性の危機など、私たちの未来に大きな影を落とし"@ja.
