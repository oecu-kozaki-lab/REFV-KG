<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "本市における人口減少は、労働力の減少、経済成長の鈍化、地域経済の縮小、地域財政の持続、継続性の危機など、私たちの未来に大きな影を落とし"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "このままでは働く人より支えられる人が多くなり、十分な社会保障は行えなくなります"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "このままでは働く人より支えられる人が多くなり、十分な社会保障は行えなくなります"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "この厳しく困難な未来を回避するためにも企業誘致は欠かせないものであり、新たな雇用の創出が人口減少対策につながり、若年層定住者の拡大にもつながると考えられます"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "企業誘致の成功から人口増加、雇用の創出につながるのではないかと期待をするところであります"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "企業誘致の成功から人口増加、雇用の創出につながるのではないかと期待をするところであります"@ja.
<< kg:id_11 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "若者の流出を食いとめることも必要であると考えます"@ja.
<< kg:id_8 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "若い人たちの定住化につなげるために、本市の特徴でもあります酒田港の活用、これを念頭において、酒田港の活用のメリットのある企業、こういったものや、成長分野等の企業をターゲットに誘致活動を進めているところでございます"@ja.
<< kg:id_8 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "若い人たちの定住化につなげるために、本市の特徴でもあります酒田港の活用、これを念頭において、酒田港の活用のメリットのある企業、こういったものや、成長分野等の企業をターゲットに誘致活動を進めているところでございます"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "酒田京田西工業団地、ここには既存企業との結びつきを期待できるものづくり企業ですとか"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "酒田京田西工業団地、ここには既存企業との結びつきを期待できるものづくり企業ですとか、食品関連企業"@ja.
<< kg:id_14 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "酒田京田西工業団地、ここには既存企業との結びつきを期待できるものづくり企業ですとか、食品関連企業、情報通信関連企業"@ja.
<< kg:id_14 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "酒田京田西工業団地、ここには既存企業との結びつきを期待できるものづくり企業ですとか、食品関連企業、情報通信関連企業、そして運輸倉庫業等の企業立地を進めていきたい"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "酒田臨海工業団地につきましては、再生可能エネルギー産業の集積と、酒田港の利活用の促進に効果の高い企業の立地に努めていきたい"@ja.
<< kg:id_19 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "酒田臨海工業団地につきましては、再生可能エネルギー産業の集積と、酒田港の利活用の促進に効果の高い企業の立地に努めていきたい"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "この２つの旧高等学校の跡地につきましては、その用途地域が第１種低層住居専用地域となっております。したがって、工場、倉庫、事務所などの建築物が制限されますことから、工業用地とするためには用途地域の変更手続が必要になってまいります"@ja.
<< kg:id_24 prop:cause kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "この２つの旧高等学校の跡地につきましては、その用途地域が第１種低層住居専用地域となっております。したがって、工場、倉庫、事務所などの建築物が制限されますことから、工業用地とするためには用途地域の変更手続が必要になってまいります"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "埋め立て整備完了後、早期に工業団地として活用できるように、工業団地化を図ることなどについて県に働きかけをしていきたい"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "バイオマス発電等の再生可能エネルギーの導入、拡大により、環境関連産業の育成や雇用の創出といった経済対策としての効果も期待される"@ja.
<< kg:id_27 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "バイオマス発電等の再生可能エネルギーの導入、拡大により、環境関連産業の育成や雇用の創出といった経済対策としての効果も期待される"@ja.
<< kg:id_27 prop:cause kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "バイオマス発電は、海外等からチップなどの原材料の輸入しやすさといった酒田港の優位性、利便性のよさや"@ja.
<< kg:id_27 prop:cause kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "工業用水を安定的に確保できること"@ja.
<< kg:id_27 prop:cause kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "工業団地内に十分な用地を確保できることなどから、酒田臨海工業団地の立地条件が適していたと考えております"@ja.
<< kg:id_27 prop:effect kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "発電施設での新規雇用のほか"@ja.
<< kg:id_27 prop:effect kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "港湾利用や荷役運搬の増加など"@ja.
<< kg:id_27 prop:effect kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "関連産業の新規雇用の創出も見込まれる"@ja.
<< kg:id_27 prop:effect kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "波及効果の高い産業であり、本市経済の活性化に寄与するものと考えております"@ja.
<< kg:id_27 prop:effect kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本市のさまざまなエネルギー産業基地としてのイメージアップが期待できる"@ja.
<< kg:id_27 prop:effect kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "地元の子供たちへの環境やエネルギーの学びの場としても活用を期待をしております"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "酒田市の職員の出席がないという声や、酒田市の環境アセスに対する考えが聞けないことへの不満という意見がありました"@ja.
<< kg:id_38 prop:cause kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "酒田市の環境アセスに対する考えが聞けないことへの不満という意見がありました"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "近隣市町村と連携や情報交換を行いながら、内容に応じては必ず本市の職員が対応することとしたい"@ja.
<< kg:id_41 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "次回以降につきましては、本市の環境衛生課の職員が同席することとしております"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "耐震性の問題"@ja.
<< kg:id_44 prop:cause kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "その施設がコミセンで使われているような状況もありまして、なかなか具体化していない"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "学校の跡地活用につきましては、基本的には行政が活用していくということを基本にしながら、地域の皆様から丁寧に御意見をいただきながら、その跡地利用については今後検討を進めていきたい"@ja.
<< kg:id_47 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "新年度からは新たに行政経営課が設置されてまいります。その中で学校跡地について、遊休施設にならないような形でしっかりと方針を定めて、活用を進めていければ"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "所有者が亡くなっており、かつ相続登記が未了のもの"@ja.
<< kg:id_50 prop:effect kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "公共事業に伴う用地取得等において、当該土地が相続登記未了の場合、通常の場合と比較して事務手続等により多くの時間と手間を要する"@ja.
<< kg:id_50 prop:effect kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "管理不全な状況の改善に向けた市との話し合いが円滑に進まず、結果として状況が改善されない、そういった場合や、改善するまで非常に長期の時間を要する"@ja.
<< kg:id_50 prop:effect kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "農地の売買、そして貸し借りをしたくても、当該土地が相続登記未了である場合は、誰と契約を交わせばいいのかわからずに、売買、貸し借りをするのが困難"@ja.
<< kg:id_50 prop:effect kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "地域によって所有者不明のために境界等も確定できないことから、森林の整備あるいはそこの木材の利用といったことができない例も生じてまいります"@ja.
<< kg:id_50 prop:effect kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "伐採適齢期を迎えた森林が、所有者が不明なためそのまま放置されることで、山林の荒廃につながり"@ja.
<< kg:id_50 prop:effect kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "自然災害による地すべりなどの２次災害の発生の危険性、こういったものも危惧される"@ja.
<< kg:id_50 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "死亡後に行う手続一覧表というものを作成をして、死亡の届け出があった際に御遺族の方に渡しておりまして、その中に、相続登記に関する手続を案内をしている"@ja.
<< kg:id_50 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "法務局から依頼を受けて相続登記のリーフレット、こういったものも一緒に配布をしている"@ja.
<< kg:id_50 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "税務課、農地を所有されていた方については農業委員会の窓口におきましても、こうした相続登記の促しをさせていただいている"@ja.
<< kg:id_50 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "各課の窓口等での対応を強化をして、所有者不明の土地が余りふえないような、そういった対応をしっかりと取り組んでまいりたい"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "資産価値のある土地であれば、相続登記も進みますけれども、そうでない土地では時間とコストがかかってくるというようなことで、そうしてまで登記をしないという傾向がやはりふえている"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "子どもの命を守る安全教育推進事業を立ち上げておりまして、教職員対象の救命救急講習会を実施してきた"@ja.
<< kg:id_64 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "中学校教員の受講者をふやすために、中学校会場での実施を進めた"@ja.
<< kg:id_64 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "現在市内の全ての小中学校において体育館付近に１台ずつ設置されております"@ja.
<< kg:id_64 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "水泳の授業ではプールサイドにＡＥＤを移動したり、あるいは、長距離走や運動会などの行事ではグラウンドに移動したりと、各校で不慮の事故に備えて対応している"@ja.
<< kg:id_64 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "各学校に複数のＡＥＤの設置が実現できるよう、検討してまいりたい"@ja.
<< kg:id_64 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "消防署の方による生徒対象のＡＥＤ講習を実施している"@ja.
<< kg:id_64 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "全校集会で教職員がＡＥＤを操作しまして、実演して生徒たちに見せる"@ja.
<< kg:id_72 prop:effect kg:id_73 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "このような方が周囲に、自分は支援や配慮が必要だということを知らせる手段として有効なのがヘルプマークであります"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "視覚的に何らかの事情があることを周囲に伝えることで、障がいへの理解や配慮、支援の拡大が期待できる"@ja.
<< kg:id_74 prop:effect kg:id_76 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "災害時や緊急時などにも効果が期待できる"@ja.
<< kg:id_74 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "本市といたしましても、来年度から普及活用してまいります"@ja.
<< kg:id_74 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "みずからの意思で提示できるヘルプカードについて検討をし、よりよい形で普及が図られるよう進めてまいりたい"@ja.
<< kg:id_74 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "市広報、ホームページなどでヘルプマークに関して情報発信していく"@ja.
<< kg:id_74 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "関係機関等に対しましても、機会を捉えてＰＲをするなど、積極的にその普及啓発に努めてまいりたい"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "今後認知症高齢者等の増加が見込まれる中"@ja.
<< kg:id_81 prop:effect kg:id_83 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "後見人等の不足が今後生じてくるものと捉えております"@ja.
<< kg:id_84 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "成年後見制度の利用の促進に向けた基本的な計画を定めるよう努めること"@ja.
<< kg:id_84 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "行政、社会福祉協議会と弁護士会、社会福祉士会、司法書士会の専門職団体等で構成する地域連携ネットワークを構築すること"@ja.
<< kg:id_84 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "中核機関となる成年後見支援センターを設置することが求められており"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "６割近い方が成年後見制度の内容を知らなかった"@ja.
<< kg:id_88 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "市民への制度の周知浸透、加えて今後予測される利用者の増加に対応できる後見人の養成に力を注いでいくべき"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "実際に市民後見人候補者が家庭裁判所から選任される件数は少ない状況にあり"@ja.
<< kg:id_91 prop:cause kg:id_93 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "養成のみならず、養成後の支援体制ですとか、後見活動の質を高めるための継続的な研修などが不可欠"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "酒田共同火力発電株式会社が所有する石炭埠頭津波避難塔を、市が津波一時避難施設として指定する協定を締結した"@ja.
<< kg:id_94 prop:effect kg:id_96 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "津波災害に関して避難が難しいとされていた地域での避難が可能となり、大きな課題が解消され"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "県とも連携しながら、円滑な避難が可能となるよう、誘導標識の整備を今後検討していきたい"@ja.
<< kg:id_99 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "浸水深が浅い地域では自宅等での垂直避難を検討するほか"@ja.
<< kg:id_99 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "地域での助け合いによる避難行動によって対応していくことになる"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "現在のところ、市が単独で津波避難タワーを建設することは考えていない"@ja.
<< kg:id_104 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "住民の参加者全員が何らかの体験をして、訓練の成果を実感できる訓練になるよう、大幅な見直しを検討している"@ja.
<< kg:id_104 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "災害発生から避難所運営まで住民みずからが実際に対応する訓練を中心に組み立てる予定"@ja.
<< kg:id_104 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "コミュニティ振興会単位での訓練において避難所運営訓練を取り入れてもらうよう、今後働きかけていきたい"@ja.
<< kg:id_108 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "避難所運営委員会には必ず女性を入れることを明記している"@ja.
<< kg:id_108 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "多くの女性に参加いただきながら、運営委員会等でその意見が反映されるよう、体制をしっかりと構築していきたい"@ja.
<< kg:id_111 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "逃げ地図は、目標避難地点までの時間を色鉛筆で塗り分けることで、直感的に危険な場所と逃げる方法を体感できるすぐれた手法"@ja.
<< kg:id_113 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "防災ラジオの災害時の有効性の周知を図りながら、市民の購入が広く進むよう支援を行っていきたい"@ja.
<< kg:id_113 prop:countermeasure kg:id_115 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "高齢者だけの世帯、約4,000世帯ございますが、この６割以上を一つの目標と考えている"@ja.
<< kg:id_116 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "所管部署において品目に加えられるか、他市の状況等も調査しながら、今後検討していきたい"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "議員の御指摘のとおり、十分に浸透できなかった面もあったと認識をしております"@ja.
<< kg:id_120 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "利用ガイドのデマンド地域の全戸配布を行っております"@ja.
<< kg:id_120 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "回覧、広報での記事掲載など"@ja.
<< kg:id_120 prop:countermeasure kg:id_123 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "平成30年度からは出前講座のメニューに新たに加えて説明をする"@ja.
<< kg:id_120 prop:countermeasure kg:id_124 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "ホームページを活用したＰＲのほか"@ja.
<< kg:id_120 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "実際に車両を使って乗り方教室のようなものもぜひ実行したい"@ja.
<< kg:id_126 prop:cause kg:id_127 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "当日の人数変更や待ち合い場所の変更等で混乱が予想されること"@ja.
<< kg:id_126 prop:cause kg:id_128 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "グループ乗り合いの際のキャンセル等の取り扱いや責任の所在をどうするのか"@ja.
<< kg:id_126 prop:cause kg:id_129 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "運行地区によって運行曜日、運行事業者が異なることから、グループ化に対応した地区の再編も必要"@ja.
<< kg:id_130 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "デマンドタクシーが地域住民に親しまれ浸透していくためにも、今後、利用者の意見や先進事例などを参考にしながら、検討してまいりたい"@ja.
<< kg:id_132 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "財源の確保という観点で大変有効な手段の一つであることは認識をしておりますが、停留所の名称の変更にはさまざまな課題も"@ja.
<< kg:id_134 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "今後その協議を始めるところであります。その中でどのような公共交通体系が望ましいか検討を重ねていく"@ja.
<< kg:id_134 prop:cause kg:id_136 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "通常の営業を行うタクシー事業者や、同じ路線を走るバス事業者の営業の圧迫につながる可能性"@ja.
<< kg:id_134 prop:cause kg:id_137 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "受益者並びに行政の負担の割合をどうするかといった課題もあります"@ja.
<< kg:id_138 prop:cause kg:id_139 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "機能の重複した施設を複数保有するなど、多種多様な施設の保有量が増加し、人口１人当たりの延床面積は約4.4㎡"@ja.
<< kg:id_138 prop:cause kg:id_140 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "保有している公共施設の大半は、1970年代から1980年代にかけて整備されておりまして、今後、大規模な改修や建てかえとなる施設が増加していく"@ja.
<< kg:id_138 prop:cause kg:id_141 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "用途廃止となった学校、旧学校などの除却が進まないため"@ja.
<< kg:id_142 prop:countermeasure kg:id_143 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "できるだけ維持管理費用を縮減するために、効率的な管理運営を行う"@ja.
<< kg:id_142 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "公共施設の適正化を図っていく必要がある"@ja.
<< kg:id_145 prop:countermeasure kg:id_146 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "今後利用が可能な施設は民間活力の導入を含め、さまざまな視点から検討"@ja.
<< kg:id_145 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "老朽化などにより利活用が難しい施設等については、できるだけ売却や除却を進めていきたい"@ja.
<< kg:id_148 prop:countermeasure kg:id_149 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "経営的、庁内横断的な視点で検討し、適正化を推進していく組織として、来年度、行政経営課を設置いたします"@ja.
<< kg:id_148 prop:countermeasure kg:id_150 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "施設の統廃合や複合・多機能化、未利用資産の利活用等について、例えば分野の異なる複数の施設についても、スクラップ・アンド・ビルドを意識しながら複合化を進める"@ja.
<< kg:id_148 prop:countermeasure kg:id_151 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "10年ごとの期別単位の中で対象となっている施設について、早目早目に情報を提供しながら進めていきたい"@ja.
<< kg:id_148 prop:countermeasure kg:id_152 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "出前講座などを開催するとともに、市広報や市ホームページなどを活用して、わかりやすい情報の提供を行いながら合意形成に努めていきたい"@ja.
<< kg:id_153 prop:countermeasure kg:id_154 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "史跡の認定受けられれば、その国の補助を受けて、酒田市が取得し、将来ともにこの市の財産として維持保全に努められる"@ja.
<< kg:id_153 prop:effect kg:id_155 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "あれをしっかりと後世に伝えていく、歴史的な価値のある財産として伝えていくことが肝要"@ja.
<< kg:id_156 prop:countermeasure kg:id_157 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "ＰＰＰというような公民連携の手法などを使いながら、行政だけで運営するのではなく、民間からも使っていただけるような手法も、その用途の中で検討できれば"@ja.
<< kg:id_158 prop:cause kg:id_159 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "将来の技術者として人材を育てていく余裕がないなどの企業側の問題"@ja.
<< kg:id_158 prop:cause kg:id_160 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "工事現場での外勤が主となる建設業よりも内勤を希望するという働き手側の傾向"@ja.
<< kg:id_158 prop:cause kg:id_161 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "ほかの業種に比べて休日が少なく、友人と休みが合わないことが、特に若い世代からは敬遠される要因"@ja.
<< kg:id_158 prop:cause kg:id_162 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "採用を見合わせた時期がありまして、そのことが40歳前後の中堅クラス世代の不足となって現在になって響いている"@ja.
<< kg:id_158 prop:cause kg:id_163 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "就職後３年未満の定着率が非常に低い状況にある"@ja.
<< kg:id_158 prop:countermeasure kg:id_164 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "賃金、それから安全衛生等の労働環境の改善を図って、建設産業への就職者、入職者の促進と定着について全力を挙げて取り組まれている"@ja.
<< kg:id_158 prop:countermeasure kg:id_165 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_125;
    prop:text-txt_contents "公共事業の早期発注ですとか"@ja.
<< kg:id_158 prop:countermeasure kg:id_166 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "年間を通した平準化"@ja.
<< kg:id_158 prop:countermeasure kg:id_167 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_127;
    prop:text-txt_contents "十分な工期の確保に努める"@ja.
<< kg:id_158 prop:countermeasure kg:id_168 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "国・県発注工事等も地元業者が優先して受注できる仕組みづくりですとか、受注機会の増大などを引き続き取り組んでいきたい、そして国・県等には要望していきたい"@ja.
<< kg:id_169 prop:countermeasure kg:id_170 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_129;
    prop:text-txt_contents "地元企業を見学するツアーを実施をして、１年生31名が４社を訪問し、企業見学と若手社員との意見交換を行った"@ja.
<< kg:id_169 prop:countermeasure kg:id_171 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_130;
    prop:text-txt_contents "企業情報冊子の配布による地元就職の促進に取り組んでいる"@ja.
<< kg:id_172 prop:effect kg:id_173 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "人員の配置基準を満たしてはいるものの、人的余裕がないこと"@ja.
<< kg:id_172 prop:effect kg:id_174 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_132;
    prop:text-txt_contents "新たな資格取得や質の向上のための研修に参加できないこと"@ja.
<< kg:id_172 prop:effect kg:id_175 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "職員の休暇取得のためには、各事業所でさらに数名程度の人員が必要"@ja.
<< kg:id_172 prop:countermeasure kg:id_176 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_134;
    prop:text-txt_contents "介護人材の確保のためには、御指摘のとおり、職員の処遇改善"@ja.
<< kg:id_172 prop:countermeasure kg:id_177 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_135;
    prop:text-txt_contents "資格取得等によるキャリアアップは、職員の意欲向上が図られ、離職防止にもつながる"@ja.
<< kg:id_172 prop:countermeasure kg:id_178 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_136;
    prop:text-txt_contents "職場環境の整備、改善などが必要"@ja.
<< kg:id_172 prop:countermeasure kg:id_179 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_137;
    prop:text-txt_contents "特定非営利活動法人あらたと東北公益文科大学の共催で、実務者研修が行われている"@ja.
<< kg:id_172 prop:countermeasure kg:id_180 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_138;
    prop:text-txt_contents "資格取得の研修のために必要な費用の貸し付けや助成を行い、資格取得後に一定期間当該法人で勤務した場合、その費用の返還を免除している"@ja.
<< kg:id_172 prop:countermeasure kg:id_181 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_139;
    prop:text-txt_contents "事業所ではメンタルヘルス対策が行われております"@ja.
<< kg:id_172 prop:countermeasure kg:id_182 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_140;
    prop:text-txt_contents "介護ロボットによります負担の軽減"@ja.
<< kg:id_172 prop:countermeasure kg:id_183 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_141;
    prop:text-txt_contents "書類の電子化などによる事務の効率化を図るＩＣＴ化を、国・県の補助を活用しながら進めている"@ja.
<< kg:id_172 prop:countermeasure kg:id_184 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_142;
    prop:text-txt_contents "引き続き事業者等との人員の実態把握、これを行いながら"@ja.
<< kg:id_172 prop:countermeasure kg:id_185 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_143;
    prop:text-txt_contents "人材不足解消に向けた取り組みについて、協議会を設置して検討してまいりたい"@ja.
<< kg:id_172 prop:countermeasure kg:id_186 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_144;
    prop:text-txt_contents "中学生、高校生を対象にした介護職の理解の促進、あるいは興味関心の続くように、向上につながる事業"@ja.
<< kg:id_187 prop:countermeasure kg:id_188 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_145;
    prop:text-txt_contents "観光客等が訪れることが多く、お客様サービスの一環として観光パンフレット等を置きたいというお店からの求めに応じまして、必要なものをお届けしている"@ja.
<< kg:id_187 prop:countermeasure kg:id_189 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_146;
    prop:text-txt_contents "相互にどのような情報が必要か、あるいはどのような市からの情報提供ができるかを検討してまいりたい"@ja.
<< kg:id_190 prop:countermeasure kg:id_191 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_147;
    prop:text-txt_contents "道路交通の状況、避難所開設の情報など、災害関連情報をコンビニエンスストアに掲示をお願いすることにより、広く周知が図られるようにしていきたい"@ja.
<< kg:id_192 prop:countermeasure kg:id_193 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_148;
    prop:text-txt_contents "セブンイレブンジャパンとの、災害時における応急生活物資供給等の協力に関する協定"@ja.
}
