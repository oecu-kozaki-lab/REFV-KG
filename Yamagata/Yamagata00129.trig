    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "また、地域文化遺産活性化事業補助金の採択に伴い、未来へ受け継ぐ伝統文化はぐくみ事業費をそれぞれ増額しております"@ja.
<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "議第62号については、風力発電事業の円滑な運営とその経理の適正を図るため、風力発電事業特別会計を設置するものであります"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "議第63号については、地方税法等の一部改正に伴い、中小企業の一定の設備投資に係る固定資産税の特例措置を創設する"@ja.
<< kg:id_34 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "市たばこ税の税率や課税方式を改正するなど、所要の改正を行うものであります"@ja.
<< kg:id_37 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "議第65号については、地域再生法等の一部改正に伴い、本条例の適用期限を２年間延長するなど、所要の改正を行うものであります"@ja.
<< kg:id_39 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "議第69号については、庄内空港レンタカー協議会に対し、長期かつ独占的に利用させている重要な公の施設である酒田市空港レンタカー駐車場について、当該駐車場の拡張に伴い利用に供する面積を変更するため、議会の議決を求めるものであります"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "議第70号及び議第71号については、酒田港外港地区における公有水面埋立工事の部分竣功により、新たに生じた土地を確認し"@ja.
<< kg:id_43 prop:cause kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "その新たに生じた土地について、字の区域を変更するため、議会の議決を求めるものであります"@ja.
}
