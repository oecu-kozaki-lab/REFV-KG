kg:id_115 prop:effect kg:id_117.
kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "総合計画に基づくさらなる効果策の推進が必要と認識する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "健全な財政運営のため事務事業見直しと公平な負担確保が必要とする"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "必要な施策の選択に慎重な判断をもって予算編成に努める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "人口減少抑制を平成31年度の主要目標に位置づける"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "高校生が酒田を知り市政に関心を持ち酒田を好きになることを促したい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "卒業後に本市へ居住し就業する若者を継続支援する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "全中学校に1名ずつ配置し負担軽減を図る"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "2020年夏に使用できるよう整備を進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "地域文化の創造拠点と多様な交流拠点として整備を検討する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "関係機関との連携を深めコンシェルジュ増員で販売促進分野を強化する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "小規模事業者への支援措置を拡充する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "企業の人材確保が大きな課題になっていると認識する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "県外人材採用経費を支援しUIJターン就職を促進する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "UIJターン就職促進で社会減による人口減少を抑えたい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "厳しい気象状況の中でも安定した経営基盤づくりが必要とする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "厳しい気象状況の中でも安定した経営基盤づくりが必要とする"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "厳しい気象状況の中でも安定した経営基盤づくりが必要とする"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "農業振興の3本柱で対応する方針を示す"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "農業振興の3本柱で対応する方針を示す"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "農業産出額増加に向けて担い手確保や複合経営推進が必要とする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "女性若者移住者など多様な新規就農者の発掘に努める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "ICT活用による効率化と高品質化を進める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "農業者自らの販売拡大活動も支援する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "ICT技術を活用した農業を推進する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "ドローン活用やノウハウのデータ化の拠点として運営する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "販売拡大の切り札として輸出環境整備を進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "林業成長産業化と森林資源管理の両立に対応する必要がある"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "将来の森林整備事業の基礎づくりを進める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "いかのまち酒田を旗印に活性化を図る"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "東京圏から就職した移住者へ最大100万円を支給する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "市民ネットワーク形成やインバウンド対応を支える組織を整える"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "イベントノウハウ継承と中長期観光戦略を効率的に進める組織が必要とする"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "大型クルーズ船寄港を地域経済活性化につなげたい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "住民主体の居場所づくりや介護予防支援を継続する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "住民主体の取り組みを引き続き支援する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "低所得世帯や子育て世帯への支援が必要とする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "負担軽減策として実施する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "生活支援と消費の下支えを図る"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "県内トップクラスまで助成額を引き上げる"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "一時預かりや休日保育を充実させる必要がある"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "新設保育園で特別保育を充実させる"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "新たに学習支援事業を実施する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "放課後を安全安心に過ごせる環境を整える"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "地域包括ケアシステム構築を推進する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "庄内町遊佐町との協議を重ねながら検討を進める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "十里塚地区での事業を計画どおり進める"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "経験から得た課題に迅速かつ的確に対応できるようにしたい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "課題に対応するため防災対策を強化する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "情報伝達体制を強化する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "迅速な初動体制を整える"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "避難所体制を強化する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "孤立リスクに備えた備蓄を進める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "市民が災害危険性を理解し適切に避難できるようにする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "雨水排水施設整備と維持管理を一元的に行う"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "代替交通の確保が必要とする"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "10月から新たな路線を増やして運行する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "持続可能で利便性の高い公共交通網のあり方を検討する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "持続可能で利便性の高い公共交通網のあり方を検討する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "将来にわたり維持できる交通網を模索する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "島内のマンパワーを増強する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "2022年度のグランドオープンを目指す"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:op_62 prop:content "未接続区間の早期整備を国に働きかけるべきとする"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "地域を挙げて国に働きかける"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:op_64 prop:content "持続可能なサービス提供へ需要予測を重視して進める"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "管理運営費削減と経営健全化を図る"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_1.
kg:op_66 prop:content "取水停止回避のため必要な対策を進める"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_1.
kg:op_67 prop:content "取水停止を回避する対策が必要とする"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "塩水遡上による取水停止回避を進める"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_1.
kg:op_69 prop:content "時間外勤務上限設定や年休取得義務化を踏まえ是正を進める"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_1.
kg:op_70 prop:content "まちづくりをさらにステップアップさせる覚悟を示す"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_1.
kg:op_71 prop:content "残された政策課題に責任を持って取り組む意思を示す"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "東京一極集中が進み、人口減少に歯どめがかからない現況"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "社会保障費の増加等により財政は極めて厳しい状況にあります"@ja.
<< kg:id_3 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "財政の逼迫も深刻な状況であり、コスト縮減とあわせて今後の必要な施策の選択に当たっては慎重な判断をもって予算編成に努めたところです"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "総合計画２年目の平成31年度は、「人口減少の抑制」...この３つの目標の達成に向けて一歩一歩前進する施策を展開していきます"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "高校生版「元気みらいワークショップ」を開催し、次代を担う高校生から酒田を知り、市政に関心を持ち、酒田を好きになってもらうことで、高校生の地元定着と地元回帰を促進します"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "東北公益文科大学を卒業後、本市に居住し就業する若者を対象とした奨学金の返還支援を継続し、学生の地元定着を促進します"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "県と連携して配置した部活動指導員を平成31年度は全ての中学校に１名ずつ配置し、教員の負担軽減を図ります"@ja.
<< kg:id_14 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "学校施設の整備については、2020年夏に使用できるように全小中学校の普通教室へのエアコン設置を進めます"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "移転する松山小学校の跡地活用については、地域文化の創造拠点と、多様な人と価値の交流拠点となる文化創造交流施設として、（仮称）酒田市内郷アートプレイセンターの整備を検討します"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "産業振興まちづくりセンター「サンロク」については、創業支援や異業種交流、農商工連携や６次産業化など、地域の産業力アップのため、関係機関との連携を一層深めるとともに、コンシェルジュを１名増員し、インターネットを活用した販売促進等の分野を強化します"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本市独自の「元気な小規模事業者持続化特別助成金」を支給するなど、小規模事業者に対する支援措置を拡充します"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "雇用情勢の改善に伴い、企業における人材確保が大きな課題となっている"@ja.
<< kg:id_24 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "その対策として、人材確保支援助成金制度を創設します。これは、市内企業を対象に県外の人材採用に要する経費を支援するもので、本市へのＵＩＪターン就職を促進し、社会減による人口減少の抑制に努めます"@ja.
<< kg:id_6 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "社会減による人口減少の抑制に努めます"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "昨年は、渇水、豪雨、台風によるたび重なる気象災害に加え"@ja.
<< kg:id_27 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "昨年は、渇水、豪雨、台風によるたび重なる気象災害に加え"@ja.
<< kg:id_27 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "昨年は、渇水、豪雨、台風によるたび重なる気象災害に加え"@ja.
<< kg:id_27 prop:cause kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "夏場の天候不順や日照不足が要因で、米の作況指数は「やや不良」と、14年ぶりに平年並みを下回りました"@ja.
<< kg:id_27 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "夏場の天候不順や日照不足が要因で、米の作況指数は「やや不良」と、14年ぶりに平年並みを下回りました"@ja.
<< kg:id_27 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "米の作況指数は「やや不良」と、14年ぶりに平年並みを下回りました"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "「担い手の確保・育成」、「複合経営の推進」、「販路・消費の拡大」を３本柱とした農業振興に取り組みます"@ja.
<< kg:id_34 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "「担い手の確保・育成」、「複合経営の推進」、「販路・消費の拡大」を３本柱とした農業振興に取り組みます"@ja.
<< kg:id_34 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "「担い手の確保・育成」、「複合経営の推進」、「販路・消費の拡大」を３本柱とした農業振興に取り組みます"@ja.
<< kg:id_38 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "ＩＣＴ技術を活用した農業の効率化、農産物の高品質化を図るスマート農業の取り組みを推進します"@ja.
<< kg:id_40 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "庄内バイオ研修センターをスマート農業研修センターに転換し、ドローン等を活用した圃場の健康診断、熟練農業者が持つノウハウのデータ化、農業者や農協の営農指導員等を対象とするスマート農業研修の拠点として運営します"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "販売拡大の切り札である農産物の輸出については、庄内空港や酒田港から諸外国への農産物等の輸出が可能となるよう、関係機関への働きかけを強めます"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "４月に施行される森林経営管理法に基づき、林業の成長産業化と森林資源の適切な管理の両立を図るため、本市は森林の経営管理が円滑に行われるよう努める必要があります"@ja.
<< kg:id_44 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "新たに創設される森林環境譲与税を活用し、将来の森林整備事業等を実施するための基礎となる林地の現況把握や基金造成などを行います"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "イカ釣り船によるスルメイカの酒田港への水揚げを促進し、「いかのまち酒田」を旗印に水産業及び関連する産業の活性化を図ります"@ja.
<< kg:id_49 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "東京圏から市内中小企業等に就職した移住者に対し、移住に要する費用など最大100万円を支給する国の制度を活用した移住支援金制度を創設します"@ja.
<< kg:id_51 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "国際交流活動にかかわる市民ネットワークの形成、グローバル人材の育成、インバウンド対応などさまざまな国際交流活動を支える組織として、（仮称）酒田市国際交流協会を設立します"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "中長期観光戦略を効果的かつ効率的に推進する多様な関係者をマネジメントする組織として、（仮称）酒田観光戦略推進機構を設立します"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "「港」発の交流でまちがにぎわい、経済波及効果がより拡大するよう努めます"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "本市の高齢化率は平成30年12月末時点で34.8％となりました"@ja.
<< kg:id_57 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "自治会やコミュニティ振興会など住民が主体となって取り組む身近な居場所づくりや介護予防、健康づくりへの支援を引き続き行います"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "10月には、消費税率10％への引き上げが予定されています"@ja.
<< kg:id_60 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "その対策として、低所得世帯の高齢者等に対して家庭用灯油等の購入費の一部を助成します"@ja.
<< kg:id_60 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "市民税非課税の方や３歳未満のお子さんがいる世帯への生活支援と消費の下支えとなるようプレミアムつき商品券事業を実施します"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "少子化対策として、不妊治療を受ける御夫婦に対する助成額を県内トップクラスまで引き上げます"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "保護者の多様な働き方に伴う保育ニーズの変化に対応するため"@ja.
<< kg:id_66 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "一時預かりや休日保育などの特別保育についても充実を図ります"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "子供の貧困対策として、ひとり親家庭の小中学生を対象にした学習支援事業を新たに実施します"@ja.
<< kg:id_71 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "学童保育所の待機児童解消のため、（仮称）若浜学区第二学童保育所の整備に着手します"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "地域医療連携推進法人日本海ヘルスケアネットが行う医療と介護の連携業務等に対して必要な支援を行うとともに、地域包括ケアシステムの構築を推進します"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "家庭系ごみの有料化については、庄内町、遊佐町との協議を重ねながら引き続き検討を進めます"@ja.
<< kg:id_77 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "本市が十里塚地区で行う風力発電事業については、10月ごろからの発電所建設着工を予定し、2021年初頭の運転開始を目指します"@ja.
<< kg:id_79 prop:effect kg:id_80 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "昨年は、８月豪雨災害により本市で初めて避難指示を発令しました"@ja.
<< kg:id_79 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "この経験から得られた課題に対して迅速かつ的確な対応ができるよう、防災対策を強化します"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "情報伝達に関しては、防災ラジオの有償頒布の拡大を図るとともに"@ja.
<< kg:id_82 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "職員の非常招集システムを新たに導入します"@ja.
<< kg:id_85 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "避難所の体制を強化するため、学校等へのＬＰガス発電機、ブルーシートの配備等を進めます"@ja.
<< kg:id_85 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "孤立する可能性のある避難所には新たに食料・飲料水の備蓄を行います"@ja.
<< kg:id_88 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "市民が災害危険性を理解し適切な避難行動がとれるよう、県管理河川の新洪水浸水想定に基づくハザードマップの作成・配布を行います"@ja.
<< kg:id_88 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "大雨による浸水・冠水等の災害対応と、雨水排水施設の整備・維持管理を一元的に行うため、建設部土木課に雨水対策室を設置します"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "民間バス路線の一部が９月末で廃止されることに伴い"@ja.
<< kg:id_91 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "10月からるんるんバスの路線を新たにふやして運行します"@ja.
<< kg:id_94 prop:cause kg:id_95 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "バス運転手の不足や労働環境などの課題を踏まえ"@ja.
<< kg:id_94 prop:cause kg:id_96 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "バス運転手の不足や労働環境などの課題を踏まえ"@ja.
<< kg:id_94 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "将来にわたり持続可能でバス利用者にとっても利便性の高い公共交通網のあり方について検討します"@ja.
<< kg:id_98 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "新たに消防職員を２名配置し、島内における安全安心のためのマンパワーを増強します"@ja.
<< kg:id_100 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "（仮称）酒田コミュニケーションポートの整備を着実に進め、酒田の玄関口である駅前のにぎわい創出に向けて、2022年度のグランドオープンを目指します"@ja.
<< kg:id_102 prop:effect kg:id_103 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "戸沢立川道路を初めとする接続していない部分があることは、本市産業力の強化や交流人口の拡大にとってマイナスとなっています"@ja.
<< kg:id_104 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "日本海沿岸東北自動車道の整備促進や、横軸となる新庄酒田道路、そして石巻につながるみちのくウエストラインの早期整備について、地域を挙げて国に働きかけます"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "下水道事業については、将来にわたる持続可能なサービスの提供に向けて、需要予測を重視しつつ、処理区や施設の統廃合などに取り組みます"@ja.
<< kg:id_106 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "処理施設の維持管理包括委託実施や、事業の広域化・共同化などの検討により管理運営費の削減を図り、将来に向けた経営の健全化に努めます"@ja.
<< kg:id_109 prop:cause kg:id_110 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "水道事業については、最上川での塩水遡上による取水停止を回避するため"@ja.
<< kg:id_109 prop:effect kg:id_111 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "最上川での塩水遡上による取水停止を回避するため"@ja.
<< kg:id_109 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "必要な対策を進めます"@ja.
<< kg:id_113 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "職員の時間外勤務時間の上限設定や年休取得が義務化されることに伴い、働き方改革をより一層推進し、長時間労働を是正します"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "人口減少という避けがたい時代の流れを受けて、まだ葉も出ていない、実も結んでいない取り組みが多く存在する"@ja.
<< kg:id_115 prop:effect kg:id_117 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "種をまくことさえできていない政策課題が目の前にあることも事実であります"@ja.
}
