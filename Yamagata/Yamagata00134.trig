kg:st_1 rdfs:label "本多茂議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "子育てしやすい地域づくりにしっかり取り組むべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "子育てしやすい地域づくりにしっかり取り組むべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_3 prop:content "住みよさ暮らしやすさをアピールし社会減対策を講じたい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "若い人を呼び込み子育てしやすい地域づくりが必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "市民に大きな衝撃を与えた人口推計であり対策が必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "このままでは総合計画の目標人口確保は厳しい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "市内に人を呼び込み若い世代の流出を防ぐ社会減対策に取り組む"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "住みよさ暮らしやすさをアピールしながら社会減対策を講じたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "新たに力を入れる施策として移住支援金制度を創設する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "少子化対策は成果が出るまで時間がかかるが継続が必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "人口減少と少子化を食いとめる施策内容を明確にすべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "自然減対策として妊娠出産子育て支援に取り組む"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "新たに力を入れる施策として病児病後児保育を拡充する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "保護者のニーズに応じた子育て支援を強化する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "県内トップレベルまで拡充し新たに力を入れる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "待機児童解消は大変大きな課題である"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "子供たちと親が安心して学童保育を利用できる対策を続けるべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "学童の待機児童は移住定住にも影響する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "待機児童解消に向け設計業務に取り組む"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "児童が希望どおり学童保育所に入れるよう環境整備を図る"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:st_3 rdfs:label "村上幸太郎教育長"@ja.
kg:st_3 rdf:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_21 prop:content "小中の接続課題に積極的に対応する必要がある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "学校生活に満足していない生徒への対応が求められる"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "系統的な学習のつまずきへの対応が必要"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "学力向上のため九年間を通じた指導が必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "地域や家庭PTAの連携も含めしっかり取り組むべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "学校家庭地域が一緒に考え共有することが大切"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "生徒指導では協働する集団生活を通して育成を狙う"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:st_4 rdfs:label "永田斉地域創生部長"@ja.
kg:st_4 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_28 prop:content "都会からいきなり不便な田舎より都市機能のある住み方を望む人が多い"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "移住先には都市機能が必要との声が多い"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "参加する暮らしに人が集うまちをコンセプトに進める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "まずはモデルケースとして消防本署跡地で先駆的に進めたい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "情報発信を継続し移住検討者とのかかわりづくりを進める"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "具体的な進展を図りたい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "継承への不安を払拭するため新組織が必要"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "しっかりとした観光振興の組織が必要"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "市民にもわかりやすい組織のあり方が必要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "イベントを実施する部隊の後継者育成が必要"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "組織の中でノウハウをしっかり継承したい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "市民全体が主体となる交流活動を促進したい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "国際感覚豊かな人材育成やインバウンド対応の充実につなげたい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "持続可能な地域社会のため地域コミュニティが重要"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:st_5 rdfs:label "後藤泉議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_42 prop:content "行政と地域とのあり方を一緒に考えることが課題"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "地域コミュニティの維持活性化は酒田の発展に大きな意味を持つ"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "人口減少高齢社会を前提とした基本方針を年度内にまとめたい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "地域の皆さんの意見を聞きながら方針策定に臨むべき"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "地域の実態を踏まえ不安のない対応が必要"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "地域の状況にも一定の配慮をした"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "全体の算定方法を見直した"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "条件が不利な団体へ配慮した"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "地域の状況に応じて新たな加算を設けた"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "地域の人材育成や頑張りにこれまで以上に支援する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "市民負担がふえないよう努力が必要"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "あれもこれも全部事業として手がけることは困難"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "慎重な判断を持って取り組む必要がある"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "地方創生推進交付金や過疎対策事業債などを活用してきた"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "健全な財政運営には抑制が必須"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "子育て支援充実のための施策に活用できるよう検討する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:st_6 rdfs:label "市原栄子議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_58 prop:content "国から無償化財源が確実に措置されるか心配である"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_6.
kg:op_59 prop:content "子供たちの安全を守る経営や環境を確保確認すべき"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_6.
kg:op_60 prop:content "今後も安全かつ適正な保育が実施されるよう市がかかわる"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "現在の経済状況では市民生活への影響が大きい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_6.
kg:op_62 prop:content "消費税を上げたら間違いなく消費は冷え込むとの警告がある"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_6.
kg:op_63 prop:content "経済の回復基調が持続するようさまざまな施策を講じる"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "スクラップアンドビルドのチャンスとして取り組んだ"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "各部の現状に即応した効果的効率的な事業予算の組み立てとなった"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "課題解決に向けスマート農業実践研修会を計画している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "技術習得と活用方法を学ぶ必要がある"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "気象災害に負けない良食味の米づくりにつなげたい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "昨年の不作もこうしたことが原因と考える"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "農業者が有効性や活用方法を学べるようにする"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "農業研修の拠点として経営や技術の相談もできる施設にする"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "森林整備は喫緊の課題である"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "課題を解消して森林整備を進める必要がある"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "長期的な整備のため基礎づくりに取り組む"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "国民が負担を分かち合って森林を支える仕組みとして活用する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "初年度は基礎づくり基盤づくりにじっくり取り組む"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "酒田の水産業や特色ある食文化を全国に発信できた"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "地域の魅力発信につながった"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "この地域では都会以上に人材不足が深刻な企業もある"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_5.
kg:op_80 prop:content "UIJターン就職を促進し人材不足の解消を図る"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "県外人材を採用する機会をふやすため支援する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "有料職業紹介事業者の活用を支援する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "県外から採用した社員の定着を後押しする"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "労働時間の短縮と人材不足に対応する有力なツールである"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:st_7 rdfs:label "菅原司芝教育部長"@ja.
kg:st_7 rdf:type cls:st_18.
kg:op_85 prop:content "メンタル面の不安を専門医に相談できる体制が十分でない"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_7.
kg:op_86 prop:content "教職員のメンタルヘルス対策は大きな課題である"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_7.
kg:op_87 prop:content "50人未満の小中学校でも産業医のような役割を担う医師を利用できる体制をつくる"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_7.
kg:op_88 prop:content "心身の不調の早期発見や治療につなげたい"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_7.
kg:op_89 prop:content "長時間労働が常態化している教職員の不調防止を図る"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_7.
kg:op_90 prop:content "豪雨時対応をこれまで以上に迅速化する必要がある"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
kg:op_91 prop:content "窓口一本化で市民にわかりやすくし情報集約共有を図る"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_2.
kg:op_92 prop:content "よりよい体制の構築に努めたい"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "交流関係人口の拡大やコミュニティ活性化ジオパーク推進につなげたい"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
kg:st_8 rdfs:label "進藤晃議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_94 prop:content "民間のノウハウを生かした地域づくりが重要"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_8.
kg:op_95 prop:content "鳥海山や玉簾の滝を訪れる観光客にも立ち寄ってもらいたい"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_2.
kg:op_96 prop:content "地域の方々が気軽に集まるコミュニティカフェにしたい"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_2.
kg:op_97 prop:content "PRや情報発信学習の場として活用したい"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_2.
kg:op_98 prop:content "新庄酒田道路をはじめ交通インフラ整備にさらに力を入れる必要がある"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_5.
kg:op_99 prop:content "一刻も早くつながるよう働きかけを強めたい"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_2.
kg:op_100 prop:content "市民にはトーンダウンしているように見え説明が必要"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_5.
kg:op_101 prop:content "厳しい状況だが声としては引き続き県に伝えていく"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_2.
kg:op_102 prop:content "まずは陸羽西線利用者減少に歯どめをかけることが先決"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_2.
kg:op_103 prop:content "利便性の高いダイヤ改善と利用促進に努めたい"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_2.
kg:op_104 prop:content "文化芸術によるまちづくりの推進拠点に育てたい"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_7.
kg:op_105 prop:content "地域振興に寄与していく施設に育てたい"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_7.
kg:op_106 prop:content "構想段階から市民がどう関わるかが重要"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_5.
kg:op_107 prop:content "市民との協働を基本に構想へ盛り込みたい"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_7.
kg:op_108 prop:content "文化芸術によるまちづくりの推進拠点として地域振興に寄与する"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_7.
kg:op_109 prop:content "長時間労働の是正に向けて取り組みを進める"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_2.
kg:op_110 prop:content "事務手続の簡素化やペーパーワーク削減を進める"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_2.
kg:op_111 prop:content "職員間のコミュニケーション促進や意識啓発風土醸成に資する"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "平成30年の人口推移によると、自然動態で出生が552人、亡くなられた方が1,595人であります。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "平成30年の人口推移によると、自然動態で出生が552人、亡くなられた方が1,595人であります。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "社会動態では、転入が2,082人、転出が2,567人の485人減少であります。"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "20歳から64歳の実質生産人口が1,230人ほど減少をしています。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "国立社会保障・人口問題研究所が発表した2040年の本市の人口が７万1,000人程度まで減ってしまうという人口推計は、市民に大きな衝撃を与えました。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "このまま推移すると、2040年に７万1,000人を、そして総合計画の最終年度である2027年の目指す人口９万5,000人の確保も厳しくなると思われます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "これまでも、人口減少、少子化対策として、ほかの地域からの人を呼び込む移住対策でありますＵＩＪターンマッチング支援事業ですとか、酒田移住交流推進事業"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "これまでも、人口減少、少子化対策として、ほかの地域からの人を呼び込む移住対策でありますＵＩＪターンマッチング支援事業ですとか、酒田移住交流推進事業"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "首都東京圏から市内の中小企業等に就業した移住者に対する移住支援金制度の創設"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "生まれた子供の数も552人と過去最低であります。"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "人口減少・少子化を食いとめる対策は、成果が出るまで時間がかかると言われております。"@ja.
<< kg:id_11 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "さらには妊娠・出産・子育て包括支援、これはネウボラ事業ですね"@ja.
<< kg:id_11 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "あきほにあります病児・病後児保育所の定員拡充"@ja.
<< kg:id_11 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "かかりつけ医への送迎サービス、付き添いサービスの実施"@ja.
<< kg:id_11 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "特定不妊治療への助成額を県内トップレベルまで拡充する取り組み"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "少子化が進みまして、共働き世帯が増加をして、女性就業率が高まる中で"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "少子化が進む中で、共働き世帯の増加や女性就業率の高まり等により本市の学童入所数は増加傾向にあり"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "学童の待機児童がいることは若い世代の移住・定住にも影響してくるものと思われます。"@ja.
<< kg:id_18 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "平成31年度は、待機児童解消に向けて、若浜学区の第２学童保育所整備のための設計業務に取り組んでいく"@ja.
<< kg:id_18 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "児童が希望どおり学童保育所に入れるよう、空き教室活用等の検討も含め、計画的に環境整備を図っていきたい"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "近年、例えば小学校と中学校の指導方法の違い、進級・進学に伴う人間関係の変化にうまく適用できないケースが増加の傾向にあり"@ja.
<< kg:id_24 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "進級・進学に伴う人間関係の変化にうまく適用できないケースが増加の傾向にあり、学級の生活に満足していない生徒への対応が求められてきております。"@ja.
<< kg:id_24 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "学習指導については、小中学校の指導方法の違いに戸惑う生徒も見られ"@ja.
<< kg:id_24 prop:cause kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "また系統的な学習のつまずきと、その回復への対応も求められております。"@ja.
<< kg:id_24 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "学力の向上と生徒指導の充実を目指す小中一貫教育の推進"@ja.
<< kg:id_24 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "学校、家庭、地域も、義務教育９年間で子供がどのように成長していくことを望むのか一緒に考え、目指す15歳の姿を共有していくことが大切になります。"@ja.
<< kg:id_24 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "生徒指導につきましては、学校生活の中でほかの人と協働する集団生活を通して、人間関係を構築する力、あるいは自尊感情の育成を狙ってまいりたい"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "首都圏の声として、町なかを希望する割合が非常に高かったことから、市街地における市有地であります千石町の消防本署跡地を拠点候補地とした"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "交通の便、社会資源や都市機能が必要との多くの意見をいただいているところでございます。"@ja.
<< kg:id_32 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "移住者が地域づくりにも積極的にかかわれるよう、「参加する暮らしに人が集うまち」とのコンセプトで基本計画を策定し"@ja.
<< kg:id_32 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "まずはモデルケースとして消防本署跡地を活用して先駆的に取り組みを進めたい"@ja.
<< kg:id_32 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "平成31年度は、この基本計画に基づいて、拠点整備について事業者選定を進めるほか、首都圏での情報発信を継続して"@ja.
<< kg:id_32 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "移住検討者と地域のかかわりづくりを進めるなど、具体的な進展を図ってまいりたい"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "一定のノウハウなどの継承、あるいはイベントの組み立て方とか、そういったものがやはり特定の団体だけに集中しがちになってきておりまして"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "将来にわたってそれをしっかりと運営する、いわゆる継承という形で不安視するところが出てきた"@ja.
<< kg:id_39 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "酒田まつりや酒田花火ショーなどイベントのノウハウを継承するとともに、中長期観光戦略を効果的かつ効率的に推進する多様な関係者をマネジメントする組織として酒田観光戦略推進機構を設立する"@ja.
<< kg:id_39 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "さまざまなイベントを実施する部隊の後継者の育成ですとか"@ja.
<< kg:id_39 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "ノウハウの蓄積などもこういった組織の中でしっかりと継承していければ"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "酒田市国際交流協会、まだまだ仮称でありますが、こういった組織を設立したい"@ja.
<< kg:id_45 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "市民主体の国際交流活動にかかわるネットワークを形成したり、あるいはインバウンド対応の充実などなど"@ja.
<< kg:id_48 prop:cause kg:id_1 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "自治会も人口減少、高齢化の進展によりまして、これまでできていた地域活動が非常に実施が難しくなってきている"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "自治会も人口減少、高齢化の進展によりまして、これまでできていた地域活動が非常に実施が難しくなってきている"@ja.
<< kg:id_48 prop:effect kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "これまでできていた地域活動が非常に実施が難しくなってきているというところも出てきております。"@ja.
<< kg:id_48 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "この人口減少、高齢社会を前提とした地域運営の仕組みづくりのための基本方針、これを平成31年度中に何とかまとめられれば"@ja.
<< kg:id_48 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "ことし２月にはコミュニティ振興会の役員の皆さんたちと一緒にワークショップを開催したところであります。"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "これまでの算定方法は、平成27年度までの補助金の決定額が算定根拠になっていたこと、それから地域の意欲や課題に沿った算定となっていないこと"@ja.
<< kg:id_53 prop:cause kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "コミュニティ振興会費が高い地域への支援が求められていること"@ja.
<< kg:id_53 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "具体的には、算定方法は均等割・人口割を基本としながら"@ja.
<< kg:id_53 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "人口が少ない小規模な団体への加算を設けるとともに"@ja.
<< kg:id_53 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "コミュニティ振興会費が高い団体への加算を新たに設けるなどして"@ja.
<< kg:id_53 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "地域の人材を育成するための研修会等に参加する経費ですとか、地域運営組織形成に向けた地域計画の策定や計画を実行するための経費に対しての加算を新設して"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "社会保障費や経常的経費の増加により、財政は極めて厳しい状況にあります。"@ja.
<< kg:id_60 prop:cause kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "社会保障費や経常的経費の増加により、財政は極めて厳しい状況にあります。"@ja.
<< kg:id_60 prop:effect kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "これから取り組むべき事業につきましては選択と集中、慎重な判断を持って取り組んでいく必要がある"@ja.
<< kg:id_60 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "例えば地方創生推進交付金といった国・県の補助金や交付金ですとか、あるいは過疎対策事業債、さらには辺地対策事業債、そして緊急防災・減債事業債などを活用して"@ja.
<< kg:id_60 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "今後も健全な財政運営を行うには地方債残高及び公債費の抑制は必須である"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "仮に平成30年度ベースで法人分の３歳から５歳児を対象に試算した場合は約１億円程度軽減されるものと試算をしております。"@ja.
<< kg:id_66 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "国は初年度の平成31年度の無償化に係る経費は全額国費負担としておりまして、そのために子ども・子育て支援臨時交付金を交付をし"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "全国的に、こうした施設に対して、設備や専門職員など認可保育園との格差があるのではないかとの心配する声も聞かれています。"@ja.
<< kg:id_69 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "認可外保育施設については、施設設置の届け出や立入調査が県から本市に委譲されていて、改善指導等を行っているところでございます。"@ja.
<< kg:id_72 prop:effect kg:id_73 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "このまま増税が行われれば市民生活に大きな影響があるのではないかと考えますが"@ja.
<< kg:id_72 prop:effect kg:id_74 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "国内景気がさらに悪化し、消費の減少、企業倒産の増加、失業率の上昇といった負の連鎖に直面する可能性もある"@ja.
<< kg:id_72 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "プレミアム付商品券などの予算を計上するなど、経済の回復基調が持続するよう、さまざまな施策を講じている"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "全ての部で３％のマイナスシーリングを達成しております。"@ja.
<< kg:id_76 prop:effect kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "その結果、約３億円の一般財源を生み出したところでございます。"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "農業従事者の減少によります労働力不足"@ja.
<< kg:id_79 prop:cause kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "ベテラン農業者のリタイアによる生産技術継承の困難"@ja.
<< kg:id_79 prop:cause kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "たび重なる気象災害などによって、収量の低下が課題になっている"@ja.
<< kg:id_79 prop:effect kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "収量の低下が課題になっているところでございます。昨年の不作の原因もこういったことが原因"@ja.
<< kg:id_79 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "こうした課題の解決に向けて、スマート農業実践研修会というものの開催を計画している"@ja.
<< kg:id_79 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "新たにスマート農業研修センターとして"@ja.
<< kg:id_86 prop:cause kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "林業の採算性の悪化"@ja.
<< kg:id_86 prop:cause kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "所有者や境界がわからない森林が増加していること"@ja.
<< kg:id_86 prop:cause kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "さらには担い手の不足等によりまして手入れが行き届いていない森林の存在が多くなってきております。"@ja.
<< kg:id_86 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "森林環境税と森林環境譲与税が創設されたところであります。森林環境譲与税は平成31年度から行われ"@ja.
<< kg:id_86 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "森林所有者への意向調査、そういったものを行う"@ja.
<< kg:id_92 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "日本さかな検定は、日本さかな検定協会が主催をして、ととけんの愛称で親しまれている"@ja.
<< kg:id_92 prop:effect kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "これにより本市水産業や特色ある食文化が全国に発信されたのではないかな"@ja.
<< kg:id_95 prop:cause kg:id_96 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "都会にも増して絶対的な卒業人数が少ないこともあり、労働力、人材不足は深刻な企業もある"@ja.
<< kg:id_95 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "人材確保支援助成金制度が創設される"@ja.
<< kg:id_95 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "求人サイトへの掲載費用"@ja.
<< kg:id_95 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "有料職業紹介事業者へ支払う人材紹介手数料"@ja.
<< kg:id_95 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "県外から採用した社員に対して企業が支払う移転手当及び対象社員に貸し付けをする自動車のリース費用"@ja.
<< kg:id_101 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "パソコン上で日々経理、人事労務、生産管理など人が行っている繰り返し処理を自動化する仕組み"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "市内小中学校の教職員は全て50名未満であります。そのため、産業医は配置されておらず"@ja.
<< kg:id_103 prop:effect kg:id_105 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "教職員がメンタル面での不安等について専門の医師に相談できる体制や、不調を未然に防止する体制が余り整っていない"@ja.
<< kg:id_103 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "教職員が50人未満の小中学校でも産業医のような役割を担う医師を利用できる仕組み及び体制をつくっていく"@ja.
<< kg:id_103 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "このストレスチェックを導入し、高ストレスで医師による面接指導が必要と判断された教職員についての面接指導"@ja.
<< kg:id_103 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "時間外労働が一月に100時間を超えるなど長時間労働が常態化している教職員に対する面接指導"@ja.
<< kg:id_109 prop:cause kg:id_110 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "昨年夏の記録的な豪雨による雨水浸水被害を受け"@ja.
<< kg:id_109 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "雨水対策業務について土木課に集約することにより、まずは窓口が一本化され市民にとってわかりやすい"@ja.
<< kg:id_109 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "組織改編として建設部土木課に雨水対策室を設置する"@ja.
<< kg:id_113 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "日向コミュニティセンター内に、地域が運営しコーヒーや軽食などを提供するカフェを開設する事業"@ja.
<< kg:id_113 prop:countermeasure kg:id_115 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "株式会社良品計画では自社でカフェを運営したり、一般の会社に一坪カフェを出店しているということもありまして、このジオカフェ事業においては、カフェスペースのデザインであったり運営のノウハウを提供していただく"@ja.
<< kg:id_113 prop:effect kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "日向地区、八幡地域への交流、関係人口の拡大、それから経済波及効果が考えられる"@ja.
<< kg:id_113 prop:effect kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "担い手の確保や育成に向けて地区における集いの場をつくって、コミュニティ振興会の活性化につなげたい"@ja.
<< kg:id_113 prop:effect kg:id_118 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "ジオについてのＰＲや情報発信を行ったり、学習したり、またはジオガイドあるいはジオのファンクラブなどの関係団体から使っていただいて、ジオパークをさらに盛り上げていきたい"@ja.
<< kg:id_119 prop:cause kg:id_120 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "やはりまだミッシングリンク部分がございます"@ja.
<< kg:id_119 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "国・県、関係機関にやはり強力にアピールをしていく必要がある"@ja.
<< kg:id_122 prop:cause kg:id_123 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "オール山形でフル規格新幹線の整備実現を優先するんだという考え方を山形県が強力に押し出してきている"@ja.
<< kg:id_122 prop:effect kg:id_124 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "山形新幹線庄内延伸のその喫緊での実現というのはなかなか厳しい状況にある"@ja.
<< kg:id_122 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "山形新幹線と接続する快速列車の増発ですとか"@ja.
<< kg:id_122 prop:countermeasure kg:id_126 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "通勤、通学者が利用しやすい時間帯などの利便性の高いダイヤへの改善を要望していく"@ja.
<< kg:id_127 prop:countermeasure kg:id_128 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "市内外のアーティストや市民の活動の場としてのスタジオ、アトリエ機能"@ja.
<< kg:id_127 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "交流集いの場としての機能"@ja.
<< kg:id_127 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "子供たちの遊びと学びのプレイセンター機能"@ja.
<< kg:id_127 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "ワークショップとかそういうものを活用しながら、構想の中に少し盛り込んでいければ"@ja.
<< kg:id_127 prop:effect kg:id_132 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "交流人口、関係人口の増加を図り、地域振興に寄与していく施設に育てていきたい"@ja.
<< kg:id_133 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "副市長をトップとして、各部長をメンバーとするスマートワーク推進部会を立ち上げて"@ja.
<< kg:id_133 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "業務日報の活用と分析によりまして、事務手続の簡素化やペーパーワークの削減等を進めて"@ja.
<< kg:id_133 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "ことしで５年目となります業務改善運動は、実際の改善効果だけではなくて、改善過程での職員間のコミュニケーションの促進ですとか、職員一人一人の意識啓発、市役所全体としての風土醸成にも資する"@ja.
}
