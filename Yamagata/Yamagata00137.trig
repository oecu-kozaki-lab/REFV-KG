kg:st_1 rdfs:label "伊藤マツ子議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "採石法だけでなく他の法律も駆使して採石を止めるべきだと求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "町は採石再開を前提にせず止めるための対応を講じるべきだと求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "320メートル以上でも安全とは言えず予防原則で採石を止めるべきだと主張する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "調査結果から湿地消失の可能性があり採石は認められないと主張する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "湧水への悪影響が懸念されるため県へ明確に伝えるべきだと求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "水道水源への影響は重大であり採石を止めるべきだと主張する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "深い地下水への影響可能性がある以上予防原則を重視すべきだと主張する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_2 rdfs:label "時田博機町長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_8 prop:content "水資源に重要な地域であり県は条例の趣旨を踏まえて認可判断すべきだとする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "下流域の水資源確保に重要な地域であり慎重な認可事務を求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "地域の自然環境と景観を守る必要があるとする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "住民生活への不安に配慮し協定で安全運行を求める必要があるとする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "協定なしで認可される事態は絶対に避けるべきだと判断した"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "協定締結で採石再開され三年間採り尽くされる危険を懸念する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "採石跡地の修復に税金を使うのは無駄遣いだと批判する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "公有地化や税金投入は住民訴訟のリスクがあると警告する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "岩石採取の影響を最小限にするため協定締結が必要と判断した"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "地元や関係者を含む監理委員会で協議しながら歯止めをかける考えを示す"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "法律を上回る歯止めとして320メートル以下を掘らせない協定を設けた"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:st_3 rdfs:label "企画課長池田与四也"@ja.
kg:st_3 rdfs:type cls:st_47.
cls:st_47 rdfs:label "行政職"@ja.
kg:op_19 prop:content "320メートル以上でも影響があれば中断協議する予防措置を協定に入れたと説明する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "追加調査により状況把握を続けるべきだとする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "住民生活の不安を減らすため安全運行を徹底させる考えを示す"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "農業用水等への濁水流入を防ぐため厳格な対策が必要とする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "景観と環境保全のため採取後の緑化を求める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "住民生活への影響軽減のため作業時間を制限する考えを示す"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "採石場周辺の環境悪化を防ぐため不法投棄対策が必要とする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "公有地化こそ長年の問題解決の糸口であり早期実現を目指す"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "県は下流域の水資源確保に重要な地域であることを認識して判断すべきだとする"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "鳥海山と自然環境を次世代に継承するため公有地化と森林再生が必要とする"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:st_4 rdfs:label "赤塚英一議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_29 prop:content "人口減少の大きな要因として就業状況の改善が必要だと指摘する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:st_5 rdfs:label "川俣雄二地域生活課長"@ja.
kg:st_5 rdfs:type cls:st_47.
kg:op_30 prop:content "定住したくない理由の背景に町内雇用の不足があると説明する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "働き場の確保ができず若い人が町外に行かざるを得ないことを残念に思う"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "定住策として雇用の確保が不可欠だと強調する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:st_6 rdfs:label "佐藤源市産業課長"@ja.
kg:st_6 rdfs:type cls:st_47.
kg:op_33 prop:content "企業雇用や農林水産業の落ち込みが町民所得低下につながっていると認識する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "働き場確保のため企業誘致支援を強化してきたと説明する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "企業の立地と雇用創出を後押しする助成制度を整備しているとする"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "地域内外の事業連携を通じ雇用増加を図る考えを示す"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "既存事業所の雇用維持拡大を支援しているとする"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "地元企業の人材育成を通じた雇用安定を目指す"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "一時的雇用に終わらせず継続雇用を支える制度が必要だとする"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "関係機関と連携しながら雇用増加策を進めるべきだとする"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "商品開発と販売確保を進め農林水産業と結びつけた雇用拡大を図る考えを示す"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:st_7 rdfs:label "髙橋久一議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_42 prop:content "高齢化とともに認知症は増加しており対策が必要だと指摘する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_7.
kg:op_43 prop:content "認知症は生活に大きな支障をもたらすため早期受診が重要だと述べる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_7.
kg:op_44 prop:content "社会生活に支障が出る前に早期診断と治療につなげるべきだとする"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_7.
kg:op_45 prop:content "在宅介護の家族負担軽減策を充実させる必要があると求める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_7.
kg:op_46 prop:content "町民に認知症への理解と対応方法を広く周知すべきだと求める"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_7.
kg:op_47 prop:content "相談先や受診先や利用サービスが分かる認知症ケアパスを整備したいとする"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "包括支援センターを軸に認知症支援ネットワークを強化すべきだとする"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "徘回などで在宅介護負担が大きい場合はグループホーム利用を進めるべきだとする"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "ケースに応じた在宅サービスの組み合わせで生活継続を支えるべきだとする"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "健康寿命を延ばすため認知症予防の普及啓発をさらに充実させる考えを示す"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "採石法が業者の採石を推進する内容になっているもとで"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "平成25年７月23日に事業者が認可申請した岩石採取計画"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "標高320メーターより下の掘削をした場合にどのような影響が生じるかについても現段階で把握は困難"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今後採石場から排出がふえると、上部の湿地の消失や臂曲地区の湧水に影響があらわれる可能性がある"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "今後採石場から排出がふえると、上部の湿地の消失や臂曲地区の湧水に影響があらわれる可能性がある"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "岩石採取等により表土を削除することは、水道水源や湧水が重金属の影響を受けやすくなることが指摘できる"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "採石場が現時点で地表溶岩より深い層の水の流れの一部を切っていることから、深い地下水の流れに影響を与える可能性がある"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "下流域に農業用水横堰や白井新田簡易水道の水源がある湧水がある"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "下流域に農業用水横堰や白井新田簡易水道の水源がある湧水がある"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "鳥海山の眺望を損なっている"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "運搬車両の通行により、日常生活に不安を感じている"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "協定がない中での事業認可された場合には、何の歯どめもなくなるという事態が想定されます"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "協定を結んだことで採石が再開され、３年間とるだけとるということに何の危惧もないのでしょうか"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "採石跡地の修復も町でやることになりかねませんし、税金の無駄遣いであり"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "こんなことに税金を組むようなことになれば、私は住民訴訟も起きかねないだろうな"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "岩石採取の影響を最小限にするために環境保全に関する協定を締結すべきと判断をした"@ja.
<< kg:id_1 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "苦情、問題等の解決のため、臂曲岩石採取事業監理委員会を設置し、協議の上、問題解決を図る"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "標高320メーターより下の掘削は行わないこと"@ja.
<< kg:id_1 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "標高320メートル以上の岩石採取であっても、白井新田簡易水道水源、農業用水（横堰）等に明らかな影響があったと認められた場合は、甲は直ちに採取を中断し委員会において協議する"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "地下水脈調査の追加調査を行う場合は、事業者は協力するとしております"@ja.
<< kg:id_1 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "ダンプ等の通行に当たっては、安全運行マニュアルを作成し、運搬業務に従事する者への教育を徹底する"@ja.
<< kg:id_1 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "採取場内の濁水が場外へ流出し、農業用水等に濁水が流入しないよう対策に万全を期すこと"@ja.
<< kg:id_1 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "最終のり面を形成しながら掘削し、速やかに緑化を行うこと"@ja.
<< kg:id_1 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "掘削及び作業運搬は原則として午前７時から午後５時までとし、深夜、早朝の作業は行わないこと"@ja.
<< kg:id_1 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "不法投棄に対し万全の対策を講ずること"@ja.
<< kg:id_1 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "第１条に規定する採取場を含む甲の所有地について、乙による公有地化に向け別途覚書を締結するものとする"@ja.
<< kg:id_1 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "これらの２つの条例の制定趣旨を十分に踏まえて、認可事務に当たっていただきたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "少しでも早く公有地化を実現し、豊かな森林への再生を図っていきたい"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "人口の流出、減少はいまだに続いております。この一番の要因は、就業状況にあるのではないか"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "通勤、通学が不便だからという答えが55.6％ほどありました。つまりは町内に雇用の場がないということも含めて"@ja.
<< kg:id_30 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "働き場の確保、そしてどうしても町外に行かざるを得ない若い人たちの姿"@ja.
<< kg:id_30 prop:effect kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "人口減少を抑え、増加に転ずるためにいろいろな施策を講じてきましたが、人口の流出、減少はいまだに続いております"@ja.
<< kg:id_30 prop:effect kg:id_35 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "それらのいわゆる所得、町民全体の所得を上げるということにつきましては"@ja.
<< kg:id_30 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "企業奨励条例を初めとする各助成制度の拡充"@ja.
<< kg:id_30 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "工業用水道料金支援補助等の新たな助成制度の創設"@ja.
<< kg:id_30 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "ビジネスネットワークの設立等々の施策を講じてきております"@ja.
<< kg:id_30 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "雇用対策での雇用創出対策助成金の大幅な助成の拡大"@ja.
<< kg:id_30 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "中小企業への技術者養成研修等への助成制度も大幅に拡大してきた"@ja.
<< kg:id_30 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "今年度は県事業終了後の継続雇用を支援する新たな助成制度を創設した"@ja.
<< kg:id_30 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "ハローワーク、地区雇用対策協議会、町商工会等と連携を密にし、雇用対策に取り組んでいきたい"@ja.
<< kg:id_30 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "本町の基幹産業である農林水産業とタイアップした雇用の拡大を図ってまいる所存であります"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "高齢化の進展とともに認知症の人数も増加しており"@ja.
<< kg:id_44 prop:effect kg:id_46 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "記憶、判断力の障害などが起こり"@ja.
<< kg:id_44 prop:effect kg:id_47 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "社会生活や対人関係に支障が出ている状態"@ja.
<< kg:id_44 prop:effect kg:id_48 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "在宅介護における家族の精神的、身体的、経済的負担は、とても大きなものです"@ja.
<< kg:id_44 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "町民に認知症に関する広報、啓発活動が必要と考えます"@ja.
<< kg:id_44 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "これを認知症ケアパスとして各家庭に配備し、もしものときに備えておきたい"@ja.
<< kg:id_44 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "地域包括支援センターで医療と介護の連携を目指し、県の在宅医療推進モデル事業を活用した認知症支援ネットワーク会議を行っております"@ja.
<< kg:id_44 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "認知症生活共同介護事業所、俗に言うグループホームへの入所を進めております"@ja.
<< kg:id_44 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "家族の見守りとたまにデイサービスを利用したり、ほかにショートステイも利用できますので、ケースに応じたケアプランが組まれている"@ja.
<< kg:id_44 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "運動や食生活を初めとする適切な生活習慣の普及を初め、認知症の早期発見、治療、適切な対応等、町民への啓発普及への取り組みもさらに充実させてまいりたい"@ja.
}
