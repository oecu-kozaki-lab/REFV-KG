kg:st_1 rdfs:label "伊藤マツ子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "子供が使っても危なくないものだけを設置すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "子供の遊具と別の場所に健康遊具を設置すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "山形県吉村知事"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_3 prop:content "ロコモ予防が重要と呼びかける"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "ロコモは重要な健康課題で認知向上が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "寝たきり防止のためロコモ予防に取り組むべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "時田町長"@ja.
kg:st_3 rdf:type cls:st_29.
kg:op_6 prop:content "ロコモ予防と介護予防事業に力を入れる必要がある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "日常生活の中でながら運動を広げるべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "良質なたんぱく質をしっかりとることが重要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "ごろ寝ではなく体を動かす意識が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "高齢者増加で介護保険制度も医療保険制度も大変になると懸念"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "筋肉量低下も関係し体力づくりが大事"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "歩くことと筋肉トレーニングで強い体力づくりが必要"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "元気な老後を目指し継続して実施している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "マンパワー養成は非常に重要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "講座や健康教室で参加者に合わせて実施し早期発見早期対策に努める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "町民が集まる機会を利用して実施すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "ゆざ元気サポーターやスポーツ推進委員等に働きかけ前向きに取り組む"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "しゃんしゃん第2体操だけでなく多くのロコトレ運動を普及したい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "ロコモ予防にもつながる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "高齢者でもしっかりとることが重要"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "予防策は共通しており双方あわせて取り組む"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "高齢者の健康維持や中高年の生活習慣予防につながるため検討している"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "事故防止のため明確なエリア分けが必要"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "幼児児童が遊ぶ公園から切り離した設置が効果的"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "利用者の意見や他施設との連携を図り判断する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "子供向け遊具も含め積極的に活用してほしい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:st_4 rdfs:label "健康福祉課長本間康弘"@ja.
kg:st_4 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_27 prop:content "アンケートをとりながらロコチェックやロコトレの情報提供と指導をしたい"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "安全な遊具を研究し配列も考えながら進めたい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "歩行運動の遊具に足を挟んで骨折したとか懸垂器具で着地した際にバランスを崩し、腕を骨折したという子供の重傷事故も目立つ"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "歩行運動の遊具に足を挟んで骨折したとか懸垂器具で着地した際にバランスを崩し、腕を骨折したという子供の重傷事故も目立つ"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "高齢になったとき足腰の衰えで寝たきりや介護状態になってしまうロコモティブシンドロームの予防が重要です"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:text-txt_contents "ロコモの原因は加齢に伴う運動器自体の疾患、変形性関節症、骨粗鬆症に伴う変形脊髄症、腰部脊柱管狭窄症などがそれに当たります"@ja.
