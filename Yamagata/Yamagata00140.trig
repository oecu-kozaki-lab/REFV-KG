kg:id_81 prop:cause kg:id_82.
kg:id_83 rdfs:label "議場前掲示板への配置計画の掲示"@ja.
kg:id_83 rdf:type cls:c_8121.
cls:c_8121 rdfs:label "掲示周知"@ja.
kg:id_81 prop:contermeasure kg:id_83.
kg:id_84 rdfs:label "説明会資料の全世帯配布"@ja.
kg:id_84 rdf:type cls:c_7594.
cls:c_7594 rdfs:label "資料配布"@ja.
kg:id_81 prop:contermeasure kg:id_84.
kg:id_85 rdfs:label "洋上風力発電事業"@ja.
kg:id_85 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_86 rdfs:label "庄内沖が恵まれた風況にあること"@ja.
kg:id_86 rdf:type cls:c_8122.
cls:c_8122 rdfs:label "好風況"@ja.
kg:id_85 prop:cause kg:id_86.
kg:id_87 rdfs:label "海が遠浅で施工しやすいこと"@ja.
kg:id_87 rdf:type cls:c_8123.
cls:c_8123 rdfs:label "施工適地"@ja.
kg:id_85 prop:cause kg:id_87.
kg:id_88 rdfs:label "町民の疑問や不安が解消されるよう説明会の開催等を山形県や事業者に求めること"@ja.
kg:id_88 rdf:type cls:c_94.
cls:c_94 rdfs:label "説明会開催"@ja.
kg:id_78 prop:contermeasure kg:id_88.
kg:id_89 rdfs:label "風車の設置基準ガイドラインの作成と公開を山形県に求めること"@ja.
kg:id_89 rdf:type cls:c_8124.
cls:c_8124 rdfs:label "基準策定"@ja.
kg:id_78 prop:contermeasure kg:id_89.
kg:id_90 rdfs:label "風車設置に伴う地域へのリスクを最小化するための協定の締結を公募選定事業者の条件とすること"@ja.
kg:id_90 rdf:type cls:c_7949.
cls:c_7949 rdfs:label "協定締結"@ja.
kg:id_78 prop:contermeasure kg:id_90.
kg:id_91 rdfs:label "予防管理の徹底を公募選定業者に求めること"@ja.
kg:id_91 rdf:type cls:c_8125.
cls:c_8125 rdfs:label "予防管理"@ja.
kg:id_78 prop:contermeasure kg:id_91.
kg:id_92 rdfs:label "住民への丁寧な説明を国県公募参加意向のある事業者へ求めること"@ja.
kg:id_92 rdf:type cls:c_87.
cls:c_87 rdfs:label "住民説明"@ja.
kg:id_78 prop:contermeasure kg:id_92.
kg:id_93 rdfs:label "遊佐町のカーボンニュートラル宣言"@ja.
kg:id_93 rdf:type cls:c_700.
cls:c_700 rdfs:label "脱炭素宣言"@ja.
kg:id_78 prop:contermeasure kg:id_93.
kg:st_1 rdfs:label "那須正幸議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "デジタルや動画配信を活用し接触を減らしながら魅力発信すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "来訪できない人向けに現地の様子が伝わる動画紹介が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "風の音や町の雰囲気が伝わる動画で紹介すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "時田町長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "所有者の承諾が得られれば動画配信を検討する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "利用者ニーズと借上げ期間終了後も見据えて整備を検討する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "所有者の理解を得ながら進める必要がある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "利用者が求める生活体験につながる整備が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "10年間の借上げ期間終了後も視野に入れて計画する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "コロナ禍でも対応できる体制と計画が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "加工場利用者や生産者のバックアップと販路拡大がさらに必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "地場産品を使った商品が多く生まれるよう支援したい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "地域活性化を図る役割が求められている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "加工場を軸に事業と組織の見直しを図る"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "共同宣言を活用した特産品開発を進める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "販路開拓を進め事業と組織の見直しを図る"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "生産者情報やレシピも加えた見やすい通販サイトにすべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "前例にとらわれず新たな時代に対応する必要がある"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "既存のネットワークを活用して事業推進すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "アフターコロナを見据えて推進していく"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "利用に際しての管理体制に不安の声が出ている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "統合直後から利用があるため早急な体制整備が必要"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "無人化になる可能性があり管理体制に不安がある"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "これまで同様に安心して利用できるよう運用体制を検討している"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "検討委員会を開催し議論していきたい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "地域活動やニーズにも配慮して利活用方法を検討する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "活用へ向け国県に照会しながら調整が必要"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "施設形態が変わると繰上償還となる場合もあり調整が必要"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "国県に照会しながら活用へ向けた調整を進める必要がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "スポーツ少年団や子ども教室の活動に支障が出ないよう配慮したい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "財源確保を踏まえ慎重に判断する必要がある"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "販売方法には感染防止上の課題がある"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "販売方式では購入負担が課題になる"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "事業実施のコスト負担が大きい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "換金業務の担い手確保も課題である"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "枚数増加で実施困難となることも想定される"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "中小事業者への波及効果を考慮する必要がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "ペイペイ還元キャンペーンで中小事業者に大きな経済波及効果があった"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "財源確保に努めながらこれからも経済対策を検討する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:st_3 rdfs:label "斎藤弥志夫議員"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_39 prop:content "ゲームは1時間までの意識づけが必要"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "自分でルールを決めて守ることが大切"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "ゲーム管理表は自己管理を育てる効果的な取組の一つである"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "小中連携しながら自己管理能力の育成に取り組んでいる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:st_4 rdfs:label "那須教育長"@ja.
kg:st_4 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_43 prop:content "家庭の教育力が重要であり大人の自覚が必要"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:op_44 prop:content "認定まで何年もかかる前提で準備を始めている"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "2024年推薦に向け体制整備と普及啓発を進めている"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "専門員が赴任しており体制整備が進んでいる"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:st_5 rdfs:label "髙橋冠治議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_47 prop:content "一般市民や町民への理解をさらに深める活動が必要"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "今まで以上に知ってもらい体験してもらえるよう周知に努める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:st_6 rdfs:label "佐藤俊太郎議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_49 prop:content "5年後10年後を見据え今から手を打つ必要がある"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:op_50 prop:content "地域医療を支える人材確保育成を重要課題として取り組んでいる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "在宅医療と介護の連携推進も含め医師確保に取り組む"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "現時点で確認されたケースはないが今後なる可能性がある児童生徒は把握している"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "関係機関で情報共有し必要時に具体的支援を協議する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "関係機関の連携が重要である"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "多様な機関と連携しながら支援していく"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "カーボンゼロ実現により持続可能な地域づくりの大きな役割を担う"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "環境共生の町遊佐の理念に合致する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:st_7 rdfs:label "阿部満吉議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_58 prop:content "町民に計画内容が伝わっておらず不安が大きい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_7.
kg:st_8 rdfs:label "畠中地域生活課長"@ja.
kg:st_8 rdfs:type cls:st_95.
cls:st_95 rdfs:label "課長"@ja.
kg:op_59 prop:content "計画図を見える場所に掲示して周知を図っている"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_8.
kg:op_60 prop:content "周知不足との意見を受け1月1日号広報に併せて配布する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_8.
kg:op_61 prop:content "風速7メートル以上が適しており遊佐沖は条件を満たしている"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_8.
kg:op_62 prop:content "着床方式の工事がしやすい場所として選定された"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_8.
kg:op_63 prop:content "今後もあらゆる機会を利用して説明を求めていく"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "騒音や影などの課題をクリアするため基準が必要"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "リスクはゼロではないため最小化する協定締結が必要"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "あらかじめ防ぐ考え方を重視する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "過疎地域持続的発展計画にもある住民説明を求めていく"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "持続可能な未来づくりと地球温暖化防止に向け宣言したい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "これは、新型コロナウイルス感染症拡大による移動の制限、感染が拡大する地域にお住まいの方に利用の自粛をお願いしたためです"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "感染が拡大する地域にお住まいの方に利用の自粛をお願いしたためです"@ja.
<< kg:id_4 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "議員からご提案いただいた町内の風景やお試し住宅の紹介動画の配信は人の接触を最小限にし、かつ現代のソーシャルネットワークサービスを含むインターネットの普及に対応した有効な手段と考えます"@ja.
<< kg:id_4 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "紹介の承諾をいただければ、ＩＪＵターン促進協議会ホームページや動画配信サイトのユーチューブ、遊佐町公式チャンネル等を活用し、配信することも可能であります"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "新規のお試し住宅の整備につきましては、立地条件、交通手段、物件の構造や状態、このコロナ禍での利用頻度等を踏まえて対象物件を選定し、所有者の承諾を得る必要があります"@ja.
<< kg:id_7 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "所有者の承諾を得る必要があります"@ja.
<< kg:id_7 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "移住希望者が移住後の住居に求める条件は多岐にわたっているため、それらを配慮した整備も必要であります"@ja.
<< kg:id_7 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今後は、利用者から短い期間でも自分が求める本町での生活を体験していただいて、移住につなげるため、利用者ニーズを把握し、現在のお試し住宅の10年間の借り上げ期間終了後の状況も視野に入れ、物件整備も含めた事業計画を検討しているところであります"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "昨年度からコロナ禍での遊佐ノ市の事業が中止となり、遊佐を出られない状態で遊佐ブランドを推進するという困難な課題に直面し、現在も事業の縮小を余儀なくされております"@ja.
<< kg:id_12 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "遊佐を出られない状態で遊佐ブランドを推進するという困難な課題に直面し、現在も事業の縮小を余儀なくされております"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "地場産品を使った商品が加工場から多く誕生するよう、適切な衛生管理に努めながら支援していきたいと考えております"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "共同加工場の管理運営や遊佐産にこだわった商品の開発支援と販路開拓の司令塔として、地域活性化を図る役割が求められております"@ja.
<< kg:id_17 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "加工場を軸とした６次産業化の推進や生活クラブ生協や庄内みどり農協との共同宣言を生かした特産品開発、マーケティングを基にした販路開拓、ＥＣサイトの運営等、ポストコロナを見据えて事業と組織の見直しを図ってまいります"@ja.
<< kg:id_17 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "生活クラブ生協や庄内みどり農協との共同宣言を生かした特産品開発"@ja.
<< kg:id_17 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "マーケティングを基にした販路開拓"@ja.
<< kg:id_17 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "ＥＣサイトの運営等、ポストコロナを見据えて事業と組織の見直しを図ってまいります"@ja.
<< kg:id_17 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "加えて、外部から専門家を招き、町が築いてきたビジネスネットワークを活用しながら、前例にとらわれない新たな時代に対応し、遊佐ブランド推進事業、アフターコロナをも見据えて推進していかなければならないと考えております"@ja.
<< kg:id_17 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "町が築いてきたビジネスネットワークを活用しながら"@ja.
<< kg:id_17 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "前例にとらわれない新たな時代に対応し、遊佐ブランド推進事業、アフターコロナをも見据えて推進していかなければならない"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "統合後の施設の管理はどこでするのか、まだ明確ではありません"@ja.
<< kg:id_26 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "管理開始の日程も決まっておらず"@ja.
<< kg:id_26 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "施設が無人化になる可能性もあるのではないでしょうか"@ja.
<< kg:id_26 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "このことから、体育館、グラウンドの貸出しや小学校の放課後子ども教室の開設について、小学校統合後の期間においても継続して実施していく必要がありますので、これまで同様に安心して利用できるよう、運用体制について検討しているところであります"@ja.
<< kg:id_31 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "空き校舎利用の基本的な考え方や優先順位、配慮事項など、町としての利活用方針案を策定し、検討委員会を開催し、議論していきたいと考えております"@ja.
<< kg:id_31 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "中長期的な視野で町の公共施設や保有量の適正化を図り、町の行政需要への対応を進めるとともに、これまでの地域活動やニーズ等にも配慮して利活用方法や適切な管理体制を検討したい"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "建設時に国から補助金を受けていることや未償還分の起債をどうするかなどの課題も残っております"@ja.
<< kg:id_34 prop:cause kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "未償還分の起債をどうするかなどの課題も残っております"@ja.
<< kg:id_34 prop:cause kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "施設の形態が変わると補助金の返還や、起債については繰上償還が条件となる場合もありますので、国、県に照会しながら活用へ向けた調整を進める必要がある"@ja.
<< kg:id_34 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "本格的な活用までに時間がかかる場合は、可能な範囲で暫定利用なども検討しながら、現在使用しているスポーツ少年団や子ども教室の活動になるべく支障ができないよう配慮していきたい"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "高いプレミアム率は、町民の消費喚起にはなるとはいえ、必要な財源も比例して大きくなります"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "販売方法の課題としては、コロナ禍であるのに売場に人が殺到して密になりやすいこと"@ja.
<< kg:id_39 prop:cause kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "町民に購入負担が生じてしまうことなどが挙げられております"@ja.
<< kg:id_39 prop:cause kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "商品券の印刷及び販売と換金に多くの経費と労力がかかることから"@ja.
<< kg:id_39 prop:cause kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "他市町では金融機関が商品券の換金業務を請け負わない事例も出てきており"@ja.
<< kg:id_39 prop:cause kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "商品券の枚数が増えると事業の実施が困難になることも今後想定されております"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "現行のプレミアム付き商品券、大手事業者が含まれるため、町の中小事業者への経済効果が弱まる傾向もあると言われております"@ja.
<< kg:id_48 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "８月に実施したキャッシュレス決済サービス導入促進事業では、ペイペイ還元キャンペーンにより、町の中小事業者に大きな経済波及効果がありました"@ja.
<< kg:id_48 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "コロナ禍を町の中小企業が乗り越えられるよう、新しい生活様式に対応した取組を進め、地域経済を維持して発展するための財源確保に努めながら、これからも経済対策を検討してまいりたい"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "長時間のゲームが悪影響を及ぼすことも確認されております"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "もっとゲームをやりたいという欲望を抑えてゲーム時間を１時間以内に抑えることができる子は自己管理ができるので、受験についても目的を設定して進めることができるというもの"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "小学校では、期間を区切ってではありますが、家庭と協力しながらメディア時間のルールを決め、時間を記録し、評価する取組を行っております"@ja.
<< kg:id_55 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "中学校では、自分で計画を立てて実行することを大切にしており、生徒全員がスケジュール手帳を持ち、勉強時間やテレビゲームの時間等を自分で決めております"@ja.
<< kg:id_55 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "今後も家庭の協力を得ながら、子供たちのテレビゲーム時間の管理を含めた自己管理能力の育成に向けた取組を行ってまいる所存であります"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "ユネスコ世界ジオパークの認定を目指すには、日本ユネスコ国内委員会から鳥海山・飛島ジオパークはユネスコ世界ジオパークとしてふさわしい価値を備えているというお墨つきをいただき、ユネスコに推薦していただく必要がある"@ja.
<< kg:id_59 prop:cause kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "ユネスコ世界ジオパークの認定までには今から準備を始めたとしても何年もかかるものと考えられております"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "現在、2024年のユネスコ推進に向けて人員の確保を含む体制整備と地域住民へのジオパークの普及啓発活動を展開しております"@ja.
<< kg:id_62 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "人員の確保を含む体制整備と地域住民へのジオパークの普及啓発活動を展開しております"@ja.
<< kg:id_62 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "その中で町民の認知度を向上させ、ジオパーク活動の担い手を増やしていくことは必要不可欠であります"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "遊佐町においても、医師や看護師の不足は喫緊の課題となっております"@ja.
<< kg:id_68 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "町では、地域医療を支援する上で医療従事者の人材確保、育成を重要課題として位置づけ、平成25年度より地域医療安定化対策支援事業、看護師等奨学金貸付事業を町単独で実施いたしております"@ja.
<< kg:id_70 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "山形県医師確保計画、地域医療構想の推進の下、関係機関と協議を重ねながら、新型コロナウイルス感染症対策を含めた在宅医療と介護の連携を推進するため、今後も医師確保に引き続き取り組んでいきたい"@ja.
<< kg:id_72 prop:cause kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "家庭環境の状況から、今後ヤングケアラーになる可能性があると思われる児童生徒が数名いることは把握しております"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "協議組織の構成は、教育、福祉、医療、警察、児童相談所など、多くの関係機関で構成されており、ヤングケアラーの概念についての共通認識を図る"@ja.
<< kg:id_74 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "ヤングケアラーの対応につきましては、福祉、介護、教育、医療などの関係機関が連携して、早期発見、早期支援に努めていくことが重要である"@ja.
<< kg:id_74 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "今後そのような状況にある子供が確認された場合は、子供の権利侵害や家庭の状況に関してアセスメントを行い、必要に応じて家事援助サービスや介護サービスにつなぐなど、多様な機関と連携しながら支援してまいります"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "ＣＯ２を排出しないで毎日の生活に不可欠な電力をつくり出す、いわゆるカーボンゼロを実現することにより持続可能な地域づくりの大きな役割を担い"@ja.
<< kg:id_78 prop:effect kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "地球を未来につなぐ脱炭素にもつながるものと考えております"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "説明会では、町民の多くの皆さんから理解がまだ薄いと、そしてまだ理解が得られていないのではないかというようなご意見を多くいただいたところでございます"@ja.
<< kg:id_81 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "説明会後すぐに役場の来庁者の目に入るところ、議場の前のところにありますけれども、計画を示したものが欲しいというご意見多かったので、その部分ピックアップしまして、配列とか区域とか、その分だけですけれども、議場の前の掲示板のところへ貼らせていただいております"@ja.
<< kg:id_81 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "周知を図るためということで、先般の説明会資料、皆さんにお配りしましたけれども、説明資料につきまして、周知を図るためということで１月１日号の広報に併せまして全世帯のほうへ皆様へ配布させていただきたい"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "まず風況がいいということです。説明会でも説明あったとおり、７メーター以上の風速が適しているというような場所なのだそうでございます"@ja.
<< kg:id_85 prop:cause kg:id_87 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "遠浅で施工もしやすいと、着床方式ということで県のご説明ありますけれども、海が遠浅で、事業入るときも工事がしやすいというようなことで遊佐沖、選定されたような経過がございます"@ja.
<< kg:id_78 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "洋上風力発電計画については、今後もあらゆる機会を利用し、町民の疑問、不安が解消されるよう説明会の開催等、山形県や事業者には求めていきたいと考えております"@ja.
<< kg:id_78 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "風車の騒音、影の影響などから様々な課題をクリアするための風車の設置基準、ガイドラインの作成と公開を山形県に求めていこうと思っています"@ja.
<< kg:id_78 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "風車設置に伴う地域へのリスクを最小化するための協定の締結を公募選定事業者の条件とすることを法定協議会に求めていきたいと思っています"@ja.
<< kg:id_78 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "３つ目として、実は臂曲の岩石採取について、担当の当時の伊原弁護士があらかじめ防ぐという考えを非常に重要視していただきました。予防管理の徹底を公募選定業者に求めたいと思っております"@ja.
<< kg:id_78 prop:contermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "住民への丁寧な説明を国、県、公募参加意向のある事業者へ求めていきたいと思っております"@ja.
<< kg:id_78 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "遊佐町においても持続可能な未来づくりと地球温暖化防止に向け、カーボンニュートラルの宣言をしていきたいと考えております"@ja.
}
