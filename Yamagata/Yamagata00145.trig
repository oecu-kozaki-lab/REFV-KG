kg:st_1 rdfs:label "佐藤光保議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "苦境に立つ町民の暮らしを支え抜く政策への切替えが必要とする"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "倒産や廃業、雇用への影響に備えた支援が重要とする"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "小学校統合後の3密回避や不登校、学童保育の状況説明を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "中止と補償は一体であり団体への配慮が必要とする"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "不用となった一般財源の活用を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "時田町長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_6 prop:content "地方創生臨時交付金の活用を含め支援事業に取り組むとする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "観光宿泊関連への支援策を検討しているとする"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:st_3 rdfs:label "那須教育長"@ja.
kg:st_3 rdfs:type cls:st_57.
cls:st_57 rdfs:label "教育行政"@ja.
kg:op_8 prop:content "学校行事の縮小や中止、教育課程の見直しなど影響が当面続くとする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:st_4 rdfs:label "本宮副町長"@ja.
kg:st_4 rdfs:type cls:st_98.
cls:st_98 rdfs:label "行政幹部"@ja.
kg:op_9 prop:content "国県の方針を基に計13回会議を開催し協議したと説明する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "消防団や分署、交番、厚生会、社協も参加し広い視点で協議したとする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "感染予防と社会経済の回復に向け努めるとする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "特に被害があった事業者に緊急的に助成を行ったとする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:st_5 rdfs:label "佐藤産業課長"@ja.
kg:st_5 rdfs:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_13 prop:content "5月末現在で136件の受付があり今後も支援に取り組むとする"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:op_14 prop:content "経済対策として町独自に実施していると説明する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "感染防止の徹底と社会経済活動の回復の両立のため取り組むとする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "学校運営への影響が当面続くとする"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "学校再開後も影響が続くとする"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "ほぼ通常に戻りつつあるが影響は残るとする"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "事業規模を縮小した町民ワンデーウオークを実施予定とする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "新庁舎建設に要する建材の海外からの供給見込みを確認すべきとする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:st_6 rdfs:label "堀総務課長"@ja.
kg:st_6 rdfs:type cls:st_32.
kg:op_21 prop:content "工期に影響が出ないよう対応可能とする"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:op_22 prop:content "積極的に使って経済を回すことを優先すべきとする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:op_23 prop:content "町民が苦しんでいるときは基金を活用して支えるべきとする"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:st_7 rdfs:label "那須正幸議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_24 prop:content "分散避難や感染予防備品の整備が必要とする"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_7.
kg:op_25 prop:content "県ガイドラインを参考に検討を進めているとする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "分散避難として総合的に判断するとする"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "現在検討を進めているとする"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "高齢化も要因だがコロナの影響も多少あったとする"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "持続可能な農業経営のため支援に取り組むとする"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "農家負担なしで実施できる事業もあり支援に取り組むとする"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "町内でお金が循環するよう努めるとする"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:st_8 rdfs:label "畠中地域生活課長"@ja.
kg:st_8 rdfs:type cls:st_32.
kg:op_32 prop:content "新型コロナの影響で5月頃から6月頃にずれ込むとする"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_8.
kg:op_33 prop:content "今後の会議開催は不透明な状況とする"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_8.
kg:st_9 rdfs:label "中川健康福祉課長"@ja.
kg:st_9 rdfs:type cls:st_32.
kg:op_34 prop:content "新型コロナの影響で閉店が起き生活保護決定に至った事例が1件あるとする"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_9.
kg:op_35 prop:content "休業や失業で生活資金に困っている方々向けに実施しているとする"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_9.
kg:op_36 prop:content "それぞれの事業者が危機感を持って感染防止対策を実施したとする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_9.
kg:op_37 prop:content "必要がある場合を除き面会禁止としたとする"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_9.
kg:op_38 prop:content "細心の注意を払った取組をお願いしたとする"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_9.
kg:op_39 prop:content "一時的に減少したが現在は徐々に回復しているとする"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_9.
kg:op_40 prop:content "学童の居場所を確保できたとする"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_9.
kg:op_41 prop:content "あそぶ塾の子供たちの勉強を支えたとする"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "少ない職員での避難所対策と町民周知を急ぐべきとする"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_7.
kg:op_43 prop:content "地方創生臨時交付金や県支援事業を活用し十分な量を確保するとする"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "売上げのない事業所の多角化支援が必要とする"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_7.
kg:op_45 prop:content "テークアウトやキッチンカー導入など新たな生活様式への工夫を支援するとする"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "新たな生活スタイルを提案し需要増につなげたいとする"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "利用促進を周知し活性化につなげたいとする"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:st_10 rdfs:label "髙橋教育課長"@ja.
kg:st_10 rdfs:type cls:st_57.
kg:op_48 prop:content "新型コロナの影響で収入減が認められた場合に早急に対応するとする"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_10.
kg:op_49 prop:content "第3次支援として早期対応したいとする"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "第3次支援として臨時会で対応したいとする"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "感染症予防のために設置を計画しているとする"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "地域産業と地域経済を維持するため補助率40％で予定するとする"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "第4次支援としてスキームを検討中とする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "宿泊費補助ではなく特産品を届ける形で町内経済に還元したいとする"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "切れ目のない経済支援として検討するとする"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:st_11 rdfs:label "斎藤弥志夫議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_56 prop:content "景観を害するため早期の解体撤去が必要とする"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_11.
kg:op_57 prop:content "現状では何の意味もない橋となっていると指摘する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_11.
kg:op_58 prop:content "町の財政状況を踏まえできる限り早期に解体を進めたいとする"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "無用の長物であり解体撤去すべきとする"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_11.
kg:op_60 prop:content "景観改善のため最低限解体が必要とする"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_11.
kg:op_61 prop:content "予算の優先度を見据えた上で地元との協議を進めるとする"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "感染拡大は、人的な被害だけでなく、外出自粛、休業要請、各種学校の休業やイベント、地域行事の中止などにより、産業、観光業、教育、文化、地域振興等、幅広い分野で深刻な影響を及ぼしております。"@ja.
