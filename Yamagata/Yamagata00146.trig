kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "地域経済と住民生活支援のため12事業を盛り込んだ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "収束が見込めず計画実施が困難なため中止を決定した"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "感染症の現状と国方針を踏まえて中止判断に至った"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "派遣事業は正式に中止せざるを得なかった"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "移動自粛のため受入れ停止していたが再開後も慎重対応を続ける"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "７月１日から利用を再開したが慎重に対応している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "移住相談会ができないためオンライン相談を始めた"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "登山客に大きな迷惑をかけたが現在は通常使用可能になった"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "予定より大幅に遅れ登山客に迷惑をかけた"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "安全管理に加え感染症対策にも配慮して運営した"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "影響を受けた店舗等を応援し地域経済を維持する必要があった"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "町内店舗を応援し地域経済の維持を図るため実施した"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "観光宿泊業や飲食業など幅広い業種を支援した"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "助成金交付により地域経済の維持に努めた"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:st_3 rdfs:label "那須教育長"@ja.
kg:st_3 rdfs:type cls:st_57.
cls:st_57 rdfs:label "教育行政"@ja.
kg:op_23 prop:content "各校で見直しを行い短い夏休みでも２学期を順調に開始した"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "新校開校準備の協議再開に向けて部会開催を再開した"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "委員が一堂に会する会議は中止となった"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "感染対策を万全にしながら個別相談会を行った"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:st_4 rdfs:label "時田町長"@ja.
kg:st_4 rdfs:type cls:st_2.
kg:op_27 prop:content "国県の対策を反映し避難時の感染予防に対応している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "参加者間の距離に配慮しながら訓練を実施する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "学校施設ごとの具体的な避難所対応をマニュアル化している"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "経済の立て直しを優先して計画した"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "町民全世帯に平等に行き渡るようにした"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "早急な経済回復を優先し追加販売を行った"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "商品券を早く使ってもらい経済効果につなげたい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "次回も町民全世帯へ平等に行き渡るよう販売する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "地域経済や住民生活支援のため交付金を活用している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "新しい生活様式や地域経済活性化への対応として取りまとめを進めている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:st_5 rdfs:label "佐藤光保議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_37 prop:content "2020年度産米価に大きな影響が出ている"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "どの品種も昨年度産米を下回る水準になっている"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:st_6 rdfs:label "佐藤産業課長"@ja.
kg:st_6 rdfs:type cls:st_2.
kg:op_39 prop:content "町内農家に深刻な影響を与えている"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_6.
kg:op_40 prop:content "３月から４月にかけて昨年度の６割程度まで単価が落ち込んだ"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "一部出荷調整を行わざるを得ない状況になった"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:op_42 prop:content "今年度産米の価格水準への影響が懸念される"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_6.
kg:op_43 prop:content "民間在庫増により価格下落が懸念される"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_6.
kg:op_44 prop:content "国の交付金を活用して農業経営継続を支援している"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "農業機械等導入への補助で経営継続を支援している"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "県独自施策として花卉の種苗費を支援している"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:op_47 prop:content "肉用牛の収入減少の一部を補填している"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "町独自支援として主食用米ブランド強化を進める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_6.
kg:op_49 prop:content "花卉需要喚起のため公共施設展示を実施しようとしている"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:st_7 rdfs:label "中川健康福祉課長"@ja.
kg:st_7 rdfs:type cls:st_2.
kg:op_50 prop:content "感染症の影響で収入が途絶え生活保護申請したケースが２件ある"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_7.
kg:op_51 prop:content "休業や失業による生活困窮世帯向けの貸付制度利用が増えている"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "貸付上限を10万円から20万円に引き上げた"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_7.
kg:op_53 prop:content "失業等で生活維持が困難な世帯向けに支援制度がある"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "学校運営協議会委員が一堂に会する会議は中止となった"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "感染症の推移を注視しながら開設準備を進めた"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "遊泳禁止日も多かったが多くの来場者があった"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "安全管理と感染症対策により無事に終えることができた"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "感染症対策として定員を半数にして営業している"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "問い合わせには積極的に対応していく"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "三密回避の影響で登山者が多く賑わっている"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "そんな異常気象が続く中で、今年の７月28日、まさかと思う、そんな災害が最上川でも発生しました。ゲリラ豪雨とも言える大雨により最上川が氾濫し"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "ゲリラ豪雨とも言える大雨により最上川が氾濫し、災害地区では800棟を超える家屋が浸水"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "災害地区では800棟を超える家屋が浸水、道路の寸断、そして断水、農業被害が出ております"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "災害地区では800棟を超える家屋が浸水、道路の寸断、そして断水、農業被害が出ております"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "災害地区では800棟を超える家屋が浸水、道路の寸断、そして断水、農業被害が出ております"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "７月28日に、第14回対策本部会議を開催し、新しい生活様式の推進等を盛り込み、新型コロナウイルス感染症への本町対応方針を改正しました"@ja.
<< kg:id_9 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本町でも、国・県と同様に８月31日までの開催制限期間を９月30日まで延長することを決定しました"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "町では、新型コロナウイルスの感染拡大の影響を受けた地域経済や住民生活を支援する事業として"@ja.
<< kg:id_7 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "総額２億3,147万8,000円におよぶ12の事業を盛り込んだ、地方創生臨時交付金実施計画を国に提出しました"@ja.
<< kg:id_7 prop:cause kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "派遣時期までの収束が見込めず、事業の計画・実施が困難な状況であることから正式に事業の中止を決定しました"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "新型コロナウイルス感染症に係る現状と国の方針を説明のうえ、状況によっては事業を中止させていただく旨の了承をいただいていましたが"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "派遣時期までの収束が見込めず、事業の計画・実施が困難な状況であることから正式に事業の中止を決定しました"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "県境を跨いだ移動の自粛などで、受入れを停止していた広野・布倉のお試し住宅について"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "広野・布倉のお試し住宅について、７月１日より利用を再開しました"@ja.
<< kg:id_20 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "首都圏での移住相談会などは開催できない状況が続いていますので、ｗｅｂ会議システムＺＯＯＭを用いたオンライン移住相談の受付も始めました"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "御浜、山頂の公衆トイレについては、長梅雨の影響でヘリによる管理物資の荷上げ作業が８月下旬にずれこみ、予定より大幅に開設が遅れ"@ja.
<< kg:id_23 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "予定より大幅に開設が遅れ、登山客の皆様に大変ご迷惑をおかけしました"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "運営に関わった皆様からは、通常の安全管理だけでなく、感染症対策にも配慮いただきました"@ja.
<< kg:id_7 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "新型コロナウイルス感染症により、影響を受けた町内の店舗等を応援し、地域経済の維持を図るため"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "１セット14,000円分の商品券を10,000円で販売するプレミアム付商品券事業を行いました"@ja.
<< kg:id_31 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "地域産業、地域経済の維持を図るため、５月15日から新型コロナウイルス感染症対策の第二次支援として観光宿泊業、飲食業、小売業のほか、製造業、生活関連サービス業等を追加し、第二次緊急経済支援助成金の申請を受け付けました"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "７月31日までに331件3,141万4,000円の交付を行い、地域経済の維持に努めました"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "各校では、授業時数確保のために教育課程の大幅な見直しが図られ、例年よりも短い夏休みとなりましたが"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "新型コロナウイルスの影響により部会等の開催を見合わせておりましたが"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "学校運営協議会の委員が一堂に会する第１回コミュニティ・スクール推進会議は、コロナウイルスの影響により中止となりました"@ja.
<< kg:id_39 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "新型コロナウイルスへの対策を万全にしながら、県外から訪れた遊佐高校の見学希望者８人に対する個別相談会を実施しました"@ja.
<< kg:id_41 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "本町でも避難時の新型コロナウイルス感染予防につきましては、国、県が示した対策を反映させながら、町の地域防災計画や平成25年度に策定した避難所開設運営マニュアルに基づいて対応いたしております"@ja.
<< kg:id_41 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "避難訓練につきましても、今年も10月４日午前８時より全町一斉の避難訓練を実施いたします"@ja.
<< kg:id_41 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "個別の学校、施設等の感染予防に対応した避難所開設マニュアルについては、現在策定中であります"@ja.
<< kg:id_29 prop:cause kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "今回の我が町のプレミアム付き商品券事業は、消費に与える影響を緩和し、地域経済の維持を図るため"@ja.
<< kg:id_29 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "町民全世帯に平等に行き渡るよう、１世帯２セットまでの限定とし"@ja.
<< kg:id_29 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "１世帯２セット限定の条件を緩和し、１人２セットまでとして追加販売を行ったものであります"@ja.
<< kg:id_29 prop:effect kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "８月28日には残りの商品券が全て完売したという状況になりました"@ja.
<< kg:id_29 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "11月上旬から第二弾のプレミアム付き商品券秋冬版を販売する予定であります"@ja.
<< kg:id_50 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "町では、この交付金を活用するに当たり国から示された第一次交付限度額の１億63万1,000円を超える総事業費２億1,896万6,000円に及ぶ12の事業を取りまとめ、５月に第一次実施計画書を提出し"@ja.
<< kg:id_50 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "現在９月末を期限とする第二次実施計画の策定に向け、取りまとめを行っている段階であります"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "新型コロナウイルス感染症拡大の影響で、外食用需要が消滅し、米の過剰在庫によって2020年度産米価に大きな影響が出ています"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "主食用米のＪＡ概算金額は、どの品種も昨年度産米を下回る水準です"@ja.
<< kg:id_53 prop:effect kg:id_56 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "コロナ禍の影響によります外出自粛、催事の中止等によりまして、今年の２月以降、野菜、牛肉、花卉等の需要が全国的に大きく落ち込みまして、関係する農家の皆様方には深刻な影響を与えております"@ja.
<< kg:id_53 prop:effect kg:id_57 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "当町におきましては、ウルイ、花卉全般への影響が大きく、２月下旬から販売価格が低迷しまして、３月から４月にかけて、昨年度の６割程度まで単価が落ち込み"@ja.
<< kg:id_53 prop:effect kg:id_58 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "一部出荷調整を行わざるを得ない状況となっております"@ja.
<< kg:id_53 prop:effect kg:id_59 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "外食、昼食需要の冷え込み等によりまして、米の現物市場のスポット取引価格については低下傾向が続いていることに加え"@ja.
<< kg:id_53 prop:effect kg:id_60 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "６月の全国民間在庫量は昨年度と比べまして約23万トン上回っているという状況でありますので、今年度産米の価格水準への影響が大変懸念をされているという状況であります"@ja.
<< kg:id_61 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "野菜、花卉などの次期作支援に係る高収益作物次期作支援交付金"@ja.
<< kg:id_61 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "農業機械等導入に係る経営継続補助金等がございます"@ja.
<< kg:id_61 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "県のほうでも花卉の種苗費を支援します県産花卉次期作緊急支援事業"@ja.
<< kg:id_61 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "肉用牛の収入減少の一部を補填します肉用牛経営安定対策事業等、独自の施策を実施をしているという状況であります"@ja.
<< kg:id_61 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "新型コロナウイルス関連農業打撃克服対策事業として、コロナに負けない主食用ブランド力の強化に向けた積極的な土づくりに対する支援"@ja.
<< kg:id_61 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "花卉の需要喚起に係る公共施設への切り花の展示等を実施しようとして"@ja.
<< kg:id_53 prop:effect kg:id_68 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "今年度に入って新たに生活保護を受給された世帯、新たに生活保護が始まったという世帯の中で、新型コロナウイルス感染症の影響で収入が途絶えたりして生活保護を申請したというケースは２件"@ja.
<< kg:id_53 prop:effect kg:id_69 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "今般新型コロナウイルス感染症の影響による休業等で収入が減少し、緊急かつ一時的な生計維持のための貸付けを必要とする世帯のための特例として"@ja.
<< kg:id_53 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "制度を拡充して貸付上限を10万円から20万円に引き上げて"@ja.
<< kg:id_53 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "主に失業等によりまして生活に困窮して日常生活の維持が困難になっている世帯については、総合支援資金ということで、こちらのほうは上限20万円を３か月間にわたって貸し付けるという制度がございます"@ja.
<< kg:id_53 prop:effect kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "学校運営協議会の委員が一堂に会する第１回コミュニティ・スクール推進会議は、コロナウイルスの影響により中止となりました"@ja.
<< kg:id_26 prop:cause kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "海水浴場については、新型コロナウイルス感染症の推移、近隣自治体等の動向を注視しつつ開設準備を進め"@ja.
<< kg:id_26 prop:effect kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "天候不順により遊泳禁止日も多かったものの、多くの海水浴客から来場いただき"@ja.
<< kg:id_26 prop:effect kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "大きな事故も無く無事に終えることができました"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "湯ノ台口の滝ノ小屋については、宿泊受入定数を半数にして営業しています"@ja.
<< kg:id_7 prop:effect kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "コロナ禍により、自然豊富な地方暮らしへの関心が高まっていますので、問い合わせに対しては積極的に対応していきます"@ja.
<< kg:id_7 prop:effect kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "コロナ禍の影響で三密を避けるためか、登山への関心が高くなっているようで多くの登山者で賑っています"@ja.
}
