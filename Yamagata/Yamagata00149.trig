kg:id_11 prop:contermeasure kg:id_90.
kg:st_1 rdfs:label "斎藤弥志夫議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "消費落ち込み対策として50％プレミアム商品券が有効と考える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域消費を直接促す施策として商品券発行を提案する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "コロナ禍で落ち込む業界支援として商品券発行が必要と考える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "時田町長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "消費への影響緩和のため昨年度は商品券事業を2回実施した"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "商品券の高換金率から地域経済への波及効果は大きかったと分析する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "コロナ禍では販売方式が密を生み課題となった"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "紙商品券は事務負担と経費負担が大きい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "安全性と公平性を踏まえて事業を検討したい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "感染防止に対応した新しい商品券の形が必要と考える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "観光客増加を踏まえ寄附金箱設置で寄附が期待できると考える"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "人気上昇を活用し維持管理資金の寄附を募るべきと考える"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "施設維持管理や自然環境保全のため既に9か所へ設置している"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "寄附は施設維持管理や鳥海山の自然環境保全等に活用している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "神社所有地であり既存チップボックスの趣旨とも異なるため難しいと考える"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "固定しにくく防犯面から設置は困難と考える"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "観光スポットとして重要なため他の方法を検討したい"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "神社のさい銭箱ではなく集落への善意の受入れ箱である"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "盗難対策として防犯性の高い箱を町が設置した"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "議員の提案内容を集落へ伝えたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "避難遅れによる被災を踏まえ法改正が行われた"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "屋外移動中の被災多発が避難情報改正の背景である"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "高齢者等の被災多発を踏まえ早めの避難情報が必要と考える"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "想定を超える自然災害に備え早期発令に努める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "衛生面やアレルギーへの配慮から原則禁止としている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "衛生面の問題から屋内持込みを原則禁止としている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "他の避難者への配慮が必要と考える"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "状況に応じて一般避難所とは別室対応も可能と考える"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "飼い主への周知啓発を進める必要がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "自主防災組織の訓練機会を活用して理解を深めたい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "利用が想定を大きく上回り早期終了は妥当だったと考える"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "導入店舗が増えキャッシュレスの威力を実感した"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "短期間で多額の消費が生まれ地域経済効果があった"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "短期間で大きな消費額が動いたことを評価している"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "還元により町内で資金循環が生じた"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "利用者と事業者の声を確認し今後の対策に生かしたい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:st_3 rdfs:label "渡会和裕産業課長"@ja.
kg:st_3 rdfs:type cls:st_38.
cls:st_38 rdfs:label "職員"@ja.
kg:op_36 prop:content "国の臨時交付金を活用しキャッシュレス促進と経済活性化を図った"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "町内経済活性化のため事業を実施した"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "辞退が続いたため今年度は住所要件を付して募集した"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "必要人数を確保するため住所要件を復活させた"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "今年度は確実に必要人数を採用したいとの考えで住所要件を付した"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "再生可能エネルギーの主力電源化による温暖化対策が背景にある"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "県のエネルギー戦略として自給率向上が目的である"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "地域活性化や産業振興も背景にある"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "今後も継続して説明会開催を県に求める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "騒音や低周波や鳥類や海洋生物への配慮を県に求めている"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "安全性を重視した機種選定を県へ求めている"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "町民の疑問や不安が解消されるよう説明会を求める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "経済的困窮で生理用品を用意できない女性や児童生徒への支援が課題である"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "家庭事情を考慮した支援が必要と考える"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "生理の貧困への支援を求める声が高まっている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "当面は保健室常備と必要な児童生徒への無償配布で対応する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "子供たちに寄り添った相談支援を進めたい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "町の各計画とLAS-Eを日常的に実践することが大切と考える"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "居宅での生活継続を支援するため機器を貸与している"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "対象者へ固定電話回線を使う通報機器等を貸与している"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "固定電話を持たない世帯への対応が課題である"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "機械だけでなく地域ぐるみの見守り体制が重要と考える"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "小中学生の接種では副反応に十分注意する必要がある"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "理解と同意を得ながら安心安全な接種体制を構築したい"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "副反応対応は医療機関と消防と連携して行う"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "未接種児童生徒への差別防止も必要と考える"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "コロナ禍で対面相談や体験機会が失われ移住実績が落ちた"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "コロナ禍の影響で移住実績は平均を下回った"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "コロナ対応として8月からオンラインセミナーを開始した"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "事前連絡による個別相談で移住希望者へ対応している"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "従来の手法にとらわれず新計画を検討している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "予想を上回る利用で予算超過見込みとなった"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "予算超過防止のため終了を決定した"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "予定より1か月早い終了で迷惑をかけたことを申し訳なく思う"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "予算超過見込みを受け8月10日から協議を開始した"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "PayPay側との調整後に20日周知で合意した"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "消費税率が10％への引上げに伴って、所得の少ない方、小さな乳幼児のいる子育て世帯に対して、税率引上げ直後における消費の落ち込みを緩和し"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "地域における消費を下支えすることを目的として全国の市区町村が発行、販売するものでありました"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "新型コロナウイルスのパンデミックや国内感染流行による観光業界の落ち込みを緩和させる目的でプレミアム付き商品券を発行している自治体も数々ありまして"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "昨年度は、新型コロナウイルス感染症の消費に与える影響を緩和する目的で、夏と冬の２回実施いたしました"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "換金率から町民の消費喚起になり、地域経済への波及効果は大きかったものと分析をしております"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "課題としましては、コロナ禍の中で販売所に人が殺到して密になったこと"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "商品券の印刷及び販売と換金に多くの経費と労力がかかったことなどが挙げられております"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "安全と公平を優先し、財源確保に努めながら事業を検討してまいりたいと考えております"@ja.
<< kg:id_11 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "電子化の時代の中で、紙媒体のプレミアム付き商品券は新型コロナウイルス感染症防止に対応した新しい形での取組が求められております"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "丸池様は見物人が増えているし"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "町内のジオサイトとしては胴腹滝よりも人気が上がっているように見受けられます"@ja.
<< kg:id_11 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "観光物産係で所管している寄附金箱については、山岳トイレ５か所、観光トイレに４か所、合計９か所でチップボックスとして設置しております"@ja.
<< kg:id_11 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "施設の維持管理に係る経費、加えて山岳トイレであれば鳥海山の自然環境保全等への利用をさせていただくことに対し、チップという形でいただいております"@ja.
<< kg:id_14 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "丸池様については鳥海山大物忌神社所有地の土地になっています。また、これまで設置しているチップボックスについては、観光施設として設置されるトイレを利用した際の御礼、お気持ちとしていただいたものになりますので、丸池様への寄附箱の設置は難しいものと考えております"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "簡易トイレへの設置については防犯上の観点からも非常に厳しいものと考えております"@ja.
<< kg:id_11 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "今回は寄附金箱でのご提案をいただきましたが、これらの観光スポットとしての重要な位置づけのために間違いありませんので、他の方法などを検討していきたいと考えております"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "三ノ俣集落で水くみに来られる方からの善意の受け取り箱を設置し、集落への寄附金として管理していたところ"@ja.
<< kg:id_23 prop:cause kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "盗難が多発するため、防犯性が高い受入れ箱の要望を受けて町が設置したものであります"@ja.
<< kg:id_11 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "議員からいただいたご提案は集落にお伝えをさせていただきたいと考えております"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "甚大な災害をもたらした令和元年東日本台風（台風第19号）等において、避難しなかったり逃げ遅れたことによる被災"@ja.
<< kg:id_27 prop:cause kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "豪雨浸水等の屋外移動中の被災"@ja.
<< kg:id_27 prop:cause kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "高齢者等の被災が多く発生したため、国で法律の一部改正を行ったものであります"@ja.
<< kg:id_11 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "町として空振りを恐れず、早い段階での避難情報の発令に努めていきたいと考えております"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "避難所、いわゆる屋内への動物の持込みは原則禁止とし、屋外に飼育スペースを設けると定めております"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "これは、災害時の避難所の衛生面"@ja.
<< kg:id_32 prop:cause kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "動物アレルギーを持っている方など、他の避難者への配慮から取り決めたものであります"@ja.
<< kg:id_11 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "まずは避難所運営組織で協議し、そこで理解を得られれば一般避難所とは別の一室を開放する等の対応も可能と考えております"@ja.
<< kg:id_11 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "これらについて飼い主の皆様に広報等啓発を行いながら"@ja.
<< kg:id_11 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "自主防災組織の避難所開設訓練等の機会を利用し、ペット同行避難者がいた場合の対応について引き続き理解を深めるための周知を進めてまいります"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "当初の予想を大きく上回る利用をいただき、予算額を超える見込みとなったことから、８月31日で早期終了とさせていただいたところです"@ja.
<< kg:id_39 prop:effect kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "町内のキャッシュレス決済導入に一定の成果があったことについては、キャッシュレス決済の威力というのですか、導入店舗数が目標の、140店舗と申しましたが、実際には120店舗でのスタートになり"@ja.
<< kg:id_39 prop:effect kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "地域経済効果というのでしょう、促進に大きな効果があったことであります"@ja.
<< kg:id_39 prop:effect kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "８月31日までのキャンペーンの総決済額は１億8,659万3,693円"@ja.
<< kg:id_39 prop:effect kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "還元額が3,491万7,698円となっていると伝えられております"@ja.
<< kg:id_11 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "これから事業者と利用者にアンケートを募り、その声をきちんと受け止め、会議を開いて確認し、今後の地域経済対策に生かしてまいりたい"@ja.
<< kg:id_39 prop:cause kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "新型コロナウイルス対策の一環として非接触型決済の導入及び町内の消費喚起のためボーナス還元事業をします"@ja.
<< kg:id_39 prop:cause kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "町内の消費喚起のためボーナス還元事業をします"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "試験が終わって合格者が決定し、本人に通知するとともに、採用に向けての承諾をいただく段になって辞退されるケースがありました"@ja.
<< kg:id_48 prop:cause kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "結果として町が採用を目指していた人数に届かなかったということが現実としてありました"@ja.
<< kg:id_11 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "今年度ぜひとも目指す人、人数を採用したいという思いから、職員採用の区分、行政では受験資格に住所要件を付しての募集を行ったところであります"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "再生可能エネルギーの主力電源化による地球温暖化対策とエネルギーの自給率の向上並びに県内産業の振興及び地域活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_52 prop:cause kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "エネルギーの自給率の向上"@ja.
<< kg:id_52 prop:cause kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "県内産業の振興及び地域活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_56 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "毎年町からの要望により、町内各地区ごとに山形県による事業説明会を開催しており、今後も継続し、説明会の開催を要望してまいります"@ja.
<< kg:id_56 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "町は山形県へ、事業規模が大きいことから、騒音及び低周波の影響、環境への配慮、ハクチョウ等の鳥類への影響、サケ等海洋生物への負荷低減に向けて取り組むことなど"@ja.
<< kg:id_56 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "風車の機種についてはコストによる選定ではなく、安全面に最大限配慮すること等の意見を提出いたしております"@ja.
<< kg:id_56 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "今後もあらゆる機会を利用し、町民への説明会の開催を山形県や事業者に求めていきたい"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "経済的な困窮や家庭的な背景など、様々な事情により生理用品を用意することが難しい女性や女子児童生徒に対する支援が課題となっているところであります"@ja.
<< kg:id_61 prop:cause kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "経済的な困窮や家庭的な背景など、様々な事情により生理用品を用意することが難しい"@ja.
<< kg:id_61 prop:effect kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "いわゆる生理の貧困が社会問題になっている中で、支援を求める声が高まっており"@ja.
<< kg:id_11 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "当面はこれまでと同様の対策として保健室に生理用品を常備し、必要な児童生徒への無償配布を行うこととし"@ja.
<< kg:id_11 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "児童生徒の抱える様々な現状の把握に努めながら、子供たちに寄り添った相談支援を行ってまいりたい"@ja.
<< kg:id_67 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "我が町においては、計画期間が10年ごとの長期計画である遊佐町環境基本計画と計画期間が５年の短期計画であるエコアクションプラン、さらには町自ら環境負荷の低減に向け率先して取り組む行動指針でありますＬＡＳ―Ｅ等をふだんから意識し、実践していくことが大切であると考えております"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "独り暮らしの高齢者等の急病や災害等の緊急時に迅速かつ適切な対応を図るため、緊急通報機器を貸与し"@ja.
<< kg:id_11 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "利用者には電話機に備え付ける機器とペンダントタイプの送信機、火災センサーを貸与しております"@ja.
<< kg:id_69 prop:effect kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "このシステムは固定電話回線を利用しているため、電話回線を契約していない世帯には設置できないことが課題の一つとして挙げられております"@ja.
<< kg:id_11 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "親族や近隣住民の皆様、そして民生児童委員や包括支援センター等、関係機関が連携して地域ぐるみで見守っていく体制をつくっていくことがより重要であると考えております"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "接種部の疼痛や発熱時の全身反応を認める割合が高齢者よりも高いことが報告されております"@ja.
<< kg:id_11 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "対象となる小中学生の保護者に対し、ワクチン接種希望の有無、個別接種、集団接種の意向調査を実施し、ワクチン接種への理解と同意を得ながら、安心、安全な接種体制の構築に努めていきたい"@ja.
<< kg:id_11 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "接種後の副反応への対応については、遊佐医会の先生方、そして酒田地区広域行政組合消防本部と連携を図りながら対応していきたい"@ja.
<< kg:id_11 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "ワクチン接種後は、ワクチンを接種しなかった子供たちに対する差別的行為がないような配慮も必要と考えております"@ja.
<< kg:id_79 prop:effect kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "緊急事態措置、まん延防止等重点措置が取られる中、県境を越えた移動が制限されたため、首都圏等での移住相談会等の開催、移住希望者から来庁していただいて移住体験や直接面談をしての移住相談の実施もかなわない"@ja.
<< kg:id_79 prop:effect kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "令和２年度は、11組17名の移住にとどまりました"@ja.
<< kg:id_11 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "新たな町独自で８月からインターネットを使用した移住オンラインセミナーを行っております"@ja.
<< kg:id_11 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "このほかにも、事前連絡による個別のオンライン移住相談にも取り組んでおります"@ja.
<< kg:id_11 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "第３次遊佐町定住促進計画の策定作業を進めており、各課にて状況分析と、これまでの施策実績を踏まえた課題抽出と施策内容の検討を行っております"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "当初の予想を上回る利用をいただき、予算額を大きく超える見込みとなったことから、８月31日で早期終了とさせていただきました"@ja.
<< kg:id_85 prop:cause kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "予算額を大きく超える見込みとなったことから、８月31日で早期終了とさせていただきました"@ja.
<< kg:id_85 prop:effect kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "予定を１か月繰り上げてのキャンペーン終了となり、事業者と利用者の皆様にご迷惑をおかけしたことは申し訳なく思っております"@ja.
<< kg:id_11 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "８月10日からＰａｙＰａｙ株式会社と早期終了についての契約協議を開始いたしました"@ja.
<< kg:id_11 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "８月20日に事業者及び利用者への周知をすることでＰａｙＰａｙ側と合意に至りました"@ja.
}
