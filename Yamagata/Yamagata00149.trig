kg:id_83 rdfs:label "個別のオンライン移住相談に取り組む"@ja.
kg:id_83 rdf:type cls:c_2327.
kg:id_11 prop:contermeasure kg:id_83.
kg:id_84 rdfs:label "新型コロナやアフターコロナを考慮した第3次定住促進計画を策定する"@ja.
kg:id_84 rdf:type cls:c_627.
cls:c_627 rdfs:label "計画策定"@ja.
kg:id_11 prop:contermeasure kg:id_84.
kg:id_85 rdfs:label "キャッシュレス決済導入促進支援事業の早期終了"@ja.
kg:id_85 rdf:type cls:c_8525.
cls:c_8525 rdfs:label "事業早期終了"@ja.
kg:id_86 rdfs:label "当初の予想を上回る利用"@ja.
kg:id_86 rdf:type cls:c_1979.
cls:c_1979 rdfs:label "利用増加"@ja.
kg:id_85 prop:cause kg:id_86.
kg:id_87 rdfs:label "予算額を大きく超える見込み"@ja.
kg:id_87 rdf:type cls:c_8025.
cls:c_8025 rdfs:label "予算超過"@ja.
kg:id_85 prop:cause kg:id_87.
