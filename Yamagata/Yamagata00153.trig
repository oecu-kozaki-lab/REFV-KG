kg:st_1 rdfs:label "佐藤俊太郎議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "高齢者世帯が多く個人任せの除雪は今後難しい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "高齢者世帯が多く間口除雪を個人に任せ続けるのは難しい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "寄せられた雪の処理は人力では大変だ"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "時田町長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "地域ぐるみで生活道路確保を支援している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "区長"@ja.
kg:st_3 rdfs:type cls:st_92.
cls:st_92 rdfs:label "地域代表"@ja.
kg:op_5 prop:content "単価や上限金額の見直しを求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "除雪実態を調査し単価や上限金額を検討する必要がある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "単価や上限金額の見直しが必要だ"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "実態調査を行い単価や上限金額を検討する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "単価や上限金額の見直しを求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "単価や上限金額を検討する必要がある"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:st_4 rdfs:label "畠中地域生活課長"@ja.
kg:st_4 rdfs:type cls:st_47.
cls:st_47 rdfs:label "行政職"@ja.
kg:op_11 prop:content "除雪担当課と健康福祉課の連携が大切だ"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "国と県と町でそろえた対応は難しい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "高齢者世帯は雪かき応援事業を活用してほしい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "ＩＣＴを活用した間口除雪の採用を検討してほしい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "寒河江市や新庄市の情報を収集し研究したい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "排土板やシャッターつき排土板などを含め検討したい"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "除雪機は物があっても使いにくい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "運搬車両がなければ借りに行けない"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "運搬車両を持つ人は自分の除雪機も持っている場合が多い"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:st_5 rdfs:label "髙橋企画課長"@ja.
kg:st_5 rdfs:type cls:st_47.
kg:op_20 prop:content "貸出制度の周知を図り活用を進めたい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:op_21 prop:content "高齢化で除雪する側も将来支援される側に回る可能性が高い"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "5年10年先を見越して対応すべきだ"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:st_6 rdfs:label "中川健康福祉課長"@ja.
kg:st_6 rdfs:type cls:st_47.
kg:op_23 prop:content "まず現在の事業を続けられるだけ続け大変な状況になったら次の手だてを考える"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_6.
kg:op_24 prop:content "交流を通じて不当な扱いを排除できるのではないか"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "増加率は前年の13.6％から大きく鈍化、新型コロナウイルス感染拡大に伴う雇用情勢悪化が影響した"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:text-txt_contents "コロナ禍により技能実習生の雇用が困難な事業所には、雇用維持に努めるための雇用調整助成金の活用"@ja.
<< kg:id_5 prop:contermeasure kg:id_6 >>
    prop:text-txt_contents "実習が困難になった技能実習生に対する再就職支援、いわゆる雇用維持支援"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:text-txt_contents "感染した実習生への在留資格変更などの措置を行っております"@ja.
<< kg:id_9 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "遊佐町国際交流推進協議会がＮＰＯ法人いなか暮らし遊佐応援団へ委託している国際理解事業で日本語講座を行っております"@ja.
<< kg:id_9 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "ＮＰＯ法人いなか暮らし遊佐応援団では、国や県からの情報や新型コロナウイルスに関する情報も日本語講座を通して情報提供を行っている"@ja.
<< kg:id_9 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "遊佐町での暮らしのサポート窓口として随時相談への対応も行っているところでございます"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "このような高齢化社会においては、他の自治体でもいろいろな対策を講じています"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "65歳以上の独り暮らしが多い、また老人夫婦の家庭が多いという現状を踏まえますと、なかなか個人にお任せをするということが今後はできかねるのではないのかな"@ja.
<< kg:id_15 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "これが寄せられた雪までと思うと、これはかなり人力では大変だ"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "高齢者世帯等虚弱なお年寄りの方々が冬期間の生活を安心して過ごせるよう、生活道路の確保を地域ぐるみで行うことを支援するため、平成21年度から雪かき応援事業を実施しております。今後の課題としては、区長さんへ事業説明会の場などで１日当たりの単価や上限金額について見直しをしてほしいとのご意見等もいただいております"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "最近は人力ではなく機械を使っての除雪を実施するケースも多く"@ja.
<< kg:id_20 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "積雪の多い年などは赤字になってしまうこともあると伺っております"@ja.
<< kg:id_20 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今後、除雪作業の実態について調査を行い、単価や上限金額について検討を加えていく必要がある"@ja.
<< kg:id_20 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "１日当たりの単価や上限金額について見直しをしてほしいとのご意見等もいただいておりますので、考えていかなければならないと思っています"@ja.
<< kg:id_25 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "高齢者世帯や障がいをお持ちになっている方でございますので、今後とも除雪担当課と健康福祉課との連携を図りながら対応していくことが大切"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:text-txt_contents "限られた時間と限られた機械の台数で行うため"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:text-txt_contents "各家庭の出入口に堆積した雪につきましては、各家庭のご協力によりまして処理をしていただいております"@ja.
<< kg:id_27 prop:cause kg:id_30 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "町道沿いの住民と、そして国道、県道沿いの住民との間に不公平感が生じないように対応することも必要"@ja.
<< kg:id_31 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "高齢者世帯の皆様におきましては雪かき応援事業をご活用いただきまして、ご協力をお願いできれば"@ja.
<< kg:id_31 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "先進地のまず寒河江市さん、新庄市ということで今ご提案ありましたので、町のほうでも少し情報を収集しまして、研究をさせていただきたい"@ja.
<< kg:id_31 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "排土板様々今ございます。開いたり閉じたりということで、もう一つ、間口除雪置かない場合、シャッターつきの、左にシャッターついていて、このうち間口には置けないという場合は、シャッターついて、その間口に雪が置かれないような形で、シャッターつきの排土板あるとお聞きしていますので、その辺を含めまして様々な機種検討させて今後対応をしていきたい"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:text-txt_contents "赤い旗立てたときにこのうちは高齢者世帯ですよということで明らかにそういう形になったものですから、押し売りとかで、そのような形で様々問題が出てきました"@ja.
<< kg:id_37 prop:contermeasure kg:id_38 >>
    prop:text-txt_contents "まずは排雪作業を実施する前に車道の幅員が狭い路線につきましては、ロータリ除雪車による幅出しを業者のほうへ指示"@ja.
<< kg:id_39 prop:contermeasure kg:id_40 >>
    prop:text-txt_contents "幅出し作業によっても車道の確保や通学路の確保が難しいと判断した場合につきましては、道路状況を十分に把握した上で、必要に応じ、排雪作業を実施する"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:text-txt_contents "市街地にも設置できればいいと思いますが、一定面積を持つ町有地や排雪場所までの一定幅員を持つ町道が接続された適地が見当たりございません"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:text-txt_contents "河川敷につきましては河川管理者であります山形県からの許可が必要"@ja.
<< kg:id_43 prop:cause kg:id_45 >>
    prop:text-txt_contents "河積の減少が伴うことや融雪の際の出水の懸念などある"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "非常に、物はありますけれども、使いにくい"@ja.
<< kg:id_46 prop:cause kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "借りる際には、除雪機を運搬する車両が必要となります。この運搬する車両がなければ、これはもう借りに行けない"@ja.
<< kg:id_46 prop:cause kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "この運搬車両を所持している方々は、大体においてトラクターもしくは自己で除雪車をお持ちだ"@ja.
<< kg:id_50 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "こういった制度に今後も周知を図りながら活用を図っていきたい"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "高齢化が非常に多くなって、ボランティアをする人間ももちろん１年１年、１歳１歳年を取るのがもう当たり前の話ではありますが、今度は逆にボランティアをされる側にもう回る可能性が非常に大きい"@ja.
<< kg:id_52 prop:effect kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "果たしてこの事業が今後継続するのかどうなのか。やはり５年、10年先を見越して対応をしたほうがよろしい"@ja.
<< kg:id_52 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "現在続けているこの事業については、まだしばらく地元の方々から頑張っていただけるのかなという見込みでございますので、続けられるだけ続けていただきまして、また大変な状況になりましたら、そのときに次の手だてを考えていく"@ja.
<< kg:id_56 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "顔を見知る、交流をすることによって、そういうことも排除できるのではないかと考えてございます"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:text-txt_contents "法律では技能実習生の保護として人権侵害行為等についての禁止規定や罰則を設けており"@ja.
<< kg:id_60 prop:contermeasure kg:id_61 >>
    prop:text-txt_contents "電話または電子メール等での母国語相談窓口の設置により、技能実習生がいつでも相談できる体制が整えられている"@ja.
}
