cls:c_7251 rdfs:label "運営検討"@ja.
kg:id_85 prop:contermeasure kg:id_89.
kg:id_90 rdfs:label "遊佐パーキングエリアタウン計画推進委員会の設置"@ja.
kg:id_90 rdf:type cls:c_2488.
cls:c_2488 rdfs:label "推進組織"@ja.
kg:id_85 prop:contermeasure kg:id_90.
kg:st_1 rdfs:label "町長メッセージ"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "町民に感染予防対策の徹底と冷静な行動を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "町民に感染予防対策の徹底と感染者への配慮を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤光保議員"@ja.
kg:st_2 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_3 prop:content "国の制度として30人学級を実現すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "保護者の多くの方々"@ja.
kg:st_3 rdfs:type cls:st_69.
cls:st_69 rdfs:label "保護者"@ja.
kg:op_4 prop:content "多人数になり子供が埋没しないか不安"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "遊佐町の未来の教育にとって必要な課題"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "国の制度化は県と町の教育財政にプラス"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "少人数学級は大規模校にこそ必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "遊佐町の農業の持続可能性にとって意見書提出は必須"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "町の基幹産業である農業への影響は深刻"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "請願に基づく意見書提出は必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:st_4 rdfs:label "時田町長"@ja.
kg:st_4 rdfs:type cls:st_2.
kg:op_11 prop:content "全市町村が一丸となることを条件に賛同"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:st_5 rdfs:label "赤塚英一議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_12 prop:content "避難者のプライバシー確保のため整備が必要"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_5.
kg:st_6 rdfs:label "那須正幸議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_13 prop:content "今後５年から10年後に空き家がさらに加速して増える"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_6.
kg:op_14 prop:content "相続登記の確認や相談の場が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_6.
kg:op_15 prop:content "問題となる空き家が増える前の対策が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:op_16 prop:content "町民の税負担増につながりかねない"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_6.
kg:st_7 rdfs:label "畠中地域生活課長"@ja.
kg:st_7 rdfs:type cls:st_2.
kg:op_17 prop:content "来年度の予算獲得を目指す"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_7.
kg:st_8 rdfs:label "斎藤弥志夫議員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_18 prop:content "環境保全のため役場が特別回収すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_8.
kg:op_19 prop:content "本当に必要かどうか慎重に判断する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "設置費用や倒壊リスクも含めて検討する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "地域に豊かさをもたらすツールとしての高速道路でなければならない"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "４月17日、県より、前日に続く本町４例目となる新型コロナウイルス感染者の遊佐中学校での確認事例が公表された"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:text-txt_contents "翌18日、第24回遊佐町新型コロナウイルス感染症対策本部会議を開催し、町の対応について協議しました。遊佐中学校の休校措置を決定"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "４月19日に町長メッセージを全戸配布し、町民に感染予防対策の徹底、感染された方への配慮と冷静な行動をお願いしました"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "４月23日の政府の緊急事態宣言発表を受けて"@ja.
<< kg:id_5 prop:contermeasure kg:id_7 >>
    prop:text-txt_contents "４月25日、従来の庁舎内新型コロナウイルス感染症対策本部を、庁外関係機関からも参加いただく新型インフルエンザ等対策特別措置法に基づく対策本部に移行しました"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:text-txt_contents "遠方からの集客が難しい状況の中"@ja.
<< kg:id_8 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "４月28日から観光宿泊業の支援のための誘客対策及び飛島・鳥海山ジオパークの日本ジオパーク再認定を記念した「泊まってお得キャンペーン！」を開始しました"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:text-txt_contents "近隣住民の利用による「マイクロツーリズム」の促進"@ja.
<< kg:id_8 prop:effect kg:id_12 >>
    prop:text-txt_contents "町内の経済活性化をねらい"@ja.
<< kg:id_8 prop:effect kg:id_13 >>
    prop:text-txt_contents "地元の良さの再発見・再確認などの効果を期待するものです"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "年末年始の暴風雪・豪雪により、被害を受けたパイプハウス等の農業関連施設"@ja.
<< kg:id_14 prop:effect kg:id_16 >>
    prop:text-txt_contents "被害を受けたパイプハウス等の農業関連施設"@ja.
<< kg:id_14 prop:contermeasure kg:id_17 >>
    prop:text-txt_contents "国の持続的生産強化事業を活用して25棟の復旧と補強の支援を行いました"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:text-txt_contents "４月10日から11日にかけて低温となった影響で霜が降り"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:text-txt_contents "柿等の果樹の芽が枯死する霜害が町内各地で発生しました"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:text-txt_contents "被害の範囲は４ｈａ以上にも及ぶとみられ"@ja.
<< kg:id_18 prop:effect kg:id_22 >>
    prop:text-txt_contents "今年の収穫に深刻な影響を及ぼすことが予想されます"@ja.
<< kg:id_18 prop:contermeasure kg:id_23 >>
    prop:text-txt_contents "今後、山形県、ＪＡ等関係機関と連携しながら、被害の詳細把握に努める"@ja.
<< kg:id_18 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "対応策について検討していきます"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:text-txt_contents "令和２年度に調査をした被害木については"@ja.
<< kg:id_25 prop:contermeasure kg:id_27 >>
    prop:text-txt_contents "県と共に全量駆除を予定しており"@ja.
<< kg:id_25 prop:contermeasure kg:id_28 >>
    prop:text-txt_contents "今後の被害縮小のため、１回目の薬剤散布を６月２日と３日に実施しました"@ja.
<< kg:id_25 prop:contermeasure kg:id_29 >>
    prop:text-txt_contents "２回目の薬剤散布は６月下旬から７月上旬に予定しており"@ja.
<< kg:id_25 prop:contermeasure kg:id_30 >>
    prop:text-txt_contents "引き続き伐倒・破砕処理等の作業に取り組んでいきます"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "今のままの自治体任せの少人数学級では、財政力の違いで格差が生まれることにつながっていきます"@ja.
<< kg:id_31 prop:cause kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "保護者の多くの方々が、今まで人数が少なく丁寧に指導してもらってきたのに、多人数になって我が子はその他大勢として埋没してしまわないだろうかと不安を持っています"@ja.
<< kg:id_31 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "国の制度として責任として30人学級を実現してほしいとの意見書の提出を求める請願です"@ja.
<< kg:id_31 prop:effect kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "国の制度として30人学級が実現すれば、県の負担はなくなっていきます。遊佐町の教育財政にとってもプラスになります"@ja.
<< kg:id_31 prop:effect kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "子供の数は増えてもクラスサイズが小さくなって、今までと変わらず丁寧な指導を可能とする少人数学級は大規模校にこそ必要な制度です"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "新型コロナ禍による米の需給改善と米価下落対策を求める請願"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "我が町の基幹産業である農業、わけても稲作を取り巻く環境の厳しさはひとしおであります"@ja.
<< kg:id_37 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "請願に基づきこの意見書を提出することは、遊佐町の農業の持続可能性にとって必須と考えるものであります"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本町としてはこの趣旨に照らし、全市町村が足並みをそろえて一丸となって取り組むことが不可欠であるとの条件つきで賛同する旨回答したところであります"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:text-txt_contents "ゼロカーボンは導入される自然由来の再生可能エネルギーの活用"@ja.
<< kg:id_43 prop:cause kg:id_45 >>
    prop:text-txt_contents "エコアクションプランに沿った省エネ活動による二酸化炭素の排出量削減"@ja.
<< kg:id_43 prop:cause kg:id_46 >>
    prop:text-txt_contents "町の総面積の50％を超える森林の二酸化炭素吸収量により達成されるものと理解をしております"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:text-txt_contents "平成27年度以降、国の社会資本整備総合交付金事業によって各地区のまちづくりセンターや小学校の敷地内に防災倉庫の建築を行い"@ja.
<< kg:id_47 prop:contermeasure kg:id_49 >>
    prop:text-txt_contents "倉庫内には水、乾パンや炊き出し用の非常食のほか"@ja.
<< kg:id_47 prop:contermeasure kg:id_50 >>
    prop:text-txt_contents "避難所用マット、毛布、簡易トイレ、屋外用テント、照明器具、発電機、リヤカー、担架、救助用の工具などを町で整備"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:text-txt_contents "昨年度はコロナ対策ということで国の新型コロナ対応臨時交付金を活用して"@ja.
<< kg:id_51 prop:contermeasure kg:id_53 >>
    prop:text-txt_contents "消毒用アルコール、ウエットティッシュ、防護服、ゴーグル、マスク、非接触型体温計、パーティション、段ボールベッドなどについても整備を図った"@ja.
<< kg:id_51 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "今年度も訓練等で使用した分の非常食を補充を行うとともに、昨年度に引き続き避難所開設時における感染防止対策として、屋内用テントの整備についても検討しているところであります"@ja.
<< kg:id_55 prop:cause kg:id_56 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "全国的に問題となっております人口減少と空き家予備群"@ja.
<< kg:id_55 prop:cause kg:id_57 >>
    prop:text-txt_contents "65歳以上の独り暮らしは平成元年では155人でしたが、令和２年では753人"@ja.
<< kg:id_55 prop:cause kg:id_58 >>
    prop:text-txt_contents "老人夫婦のみの世帯も年々増加の傾向で、平成元年では193世帯でしたが、令和２年までに596世帯と増加"@ja.
<< kg:id_55 prop:cause kg:id_59 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "相続登記がされていない"@ja.
<< kg:id_55 prop:cause kg:id_60 >>
    prop:text-txt_contents "相続人が増えて手が出せない"@ja.
<< kg:id_55 prop:cause kg:id_61 >>
    prop:text-txt_contents "相続放棄されている"@ja.
<< kg:id_55 prop:cause kg:id_62 >>
    prop:text-txt_contents "所有者が意識確認のできない状況である"@ja.
<< kg:id_55 prop:effect kg:id_63 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "このような状態が続くと問題になる空き家となり、危険空き家となっていきます"@ja.
<< kg:id_55 prop:effect kg:id_64 >>
    prop:text-txt_contents "行く末には行政代執行による家屋の解体"@ja.
<< kg:id_55 prop:effect kg:id_65 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "さらには解体費の回収ができなくなり、財政にしわ寄せが来て町民の税金の増額につながっていきます"@ja.
<< kg:id_55 prop:contermeasure kg:id_66 >>
    prop:text-txt_contents "固定資産税の納税通知書の発送時に町の空き家状況、空き家バンク制度や各種補助、相談窓口等をまとめた周知チラシを同封しております"@ja.
<< kg:id_55 prop:contermeasure kg:id_67 >>
    prop:text-txt_contents "今年度初めて税金が出ない方々へ土地家屋名寄せ帳をお送りすることとし、去る５月末付で送付をさせていただいております"@ja.
<< kg:id_55 prop:contermeasure kg:id_68 >>
    prop:text-txt_contents "県の宅建協会や県司法書士会等の協力を得ながら年１回空き家無料相談会を開催しております"@ja.
<< kg:id_55 prop:contermeasure kg:id_69 >>
    prop:text-txt_contents "高齢者が参加する健康づくり事業等の機会を利用した周知"@ja.
<< kg:id_55 prop:contermeasure kg:id_70 >>
    prop:text-txt_contents "司法書士等と連携した地区単位での相談会の開催等により"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:text-txt_contents "平成24年度に実施した橋梁長寿命化計画策定時に木橋部の桁、支承部に劣化が見つかった"@ja.
<< kg:id_71 prop:effect kg:id_73 >>
    prop:text-txt_contents "この年の10月より全面通行止めをしております"@ja.
<< kg:id_71 prop:contermeasure kg:id_74 >>
    prop:text-txt_contents "平成30年度に栄橋撤去について集落への説明会を実施し、地域と意見交換を行ってきた"@ja.
<< kg:id_71 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "町の財政状況を踏まえ、できる限り早期に解体を進めてまいりたいと考えております"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "不法投棄は、道路、河川、公園、広場などの公共用地や個人が所有する土地など区別なく行われ、良好な生活環境を著しく損なうものです"@ja.
<< kg:id_76 prop:contermeasure kg:id_78 >>
    prop:text-txt_contents "町内全域における不法投棄の抑制を目的として監視パトロールの実施"@ja.
<< kg:id_76 prop:contermeasure kg:id_79 >>
    prop:text-txt_contents "警告看板、立入禁止ロープの設置等を行い"@ja.
<< kg:id_76 prop:contermeasure kg:id_80 >>
    prop:text-txt_contents "警告看板、立入禁止ロープの設置等を行い"@ja.
<< kg:id_76 prop:contermeasure kg:id_81 >>
    prop:text-txt_contents "庄内の市町村、山形県、警察、各衛生組織連合会、産業資源循環協会等の関係団体から成る庄内地区不法投棄防止対策協議会を組織し、庄内一円で大型不法投棄の撤去等、一団体規模では対処が難しい事案について協力、情報共有しながら対処を行っております"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "まずは、施設利用者の声に耳を傾けて、利便性について確認をし"@ja.
<< kg:id_82 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "時計は設置費用と維持管理経費が必要となりますので、屋外時計であれば倒壊等で鉄道施設を破損する危険性がないのか、コスト、リスクも配慮しながら慎重に判断する必要がある"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:text-txt_contents "国道７号線の道路交通量のほとんどが日沿道の交通にシフトされることが予想されております"@ja.
<< kg:id_85 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "本町としては地域に豊かさをもたらすツールとしての高速道路でなければならないの思いで、日沿道開通に合わせて令和８年度の開業を目指し、遊佐鳥海インターチェンジ付近に新たな道の駅として遊佐パーキングエリアタウンを整備する計画としております"@ja.
<< kg:id_85 prop:contermeasure kg:id_88 >>
    prop:text-txt_contents "現在は利便性を重視したアクセス道路の整備について合意形成を図っているところであります"@ja.
<< kg:id_85 prop:contermeasure kg:id_89 >>
    prop:text-txt_contents "今年度は国の補助事業を活用しながら施設の採算性の整理や管理運営方法についての検討を進めることとしております"@ja.
<< kg:id_85 prop:contermeasure kg:id_90 >>
    prop:text-txt_contents "今年度より行政内部だけでなく、民間の外部委員を交えた遊佐パーキングエリアタウン計画推進委員会を設置し、先日６月２日には第１回目の会議を開催したところであります"@ja.
}
