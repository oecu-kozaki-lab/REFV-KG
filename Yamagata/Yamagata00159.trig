kg:st_1 rdfs:label "日本共産党の佐藤光保議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "対策を急ぐべきと考える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "遊佐町長時田博機"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_2 prop:content "数値化して削減施策の検討につなげたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "排出量把握により削減目標と施策検討が可能になる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "新たな雇用をつくる機会になると考える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "雇用創出効果は大きいと示した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "経済成長に結び付くと評価する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "輸入削減効果も大きいと示した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "待望でも停滞でもなく成長につながると考える"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "今こそ必要になっていると考える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "地域と共生する再エネであるべきと考える"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "肝要だと考える"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "住宅関連工事は雇用と脱炭素の両面で有効と考える"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "費用回収が比較的早いと説明した"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "戦略として可能性が広がると考える"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "一人一人の参加を広げる必要があると訴える"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "不足が心配される年になると考える"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "農業分野での再エネ使用率向上とＣＯ２削減が重要と考える"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "重要になってきていると考える"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "具体的な事業の進め方を協議検討したい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "付加価値向上を目指せると考える"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "流れを見定めつつ取り組んでいく"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "大切な取組だと考える"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "住宅の省エネにつながると認める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "多くの人に活用してほしい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "再エネを生かし切れていないと指摘する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "必要だと考える"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "最大限生かすには整備が必要と述べる"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "不可欠だと述べる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "ロスのない地産地消の仕組みが必要と考える"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "必要だと考える"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:st_3 rdfs:label "遊佐町地域生活課長太田智光"@ja.
kg:st_3 rdfs:type cls:st_95.
cls:st_95 rdfs:label "課長"@ja.
kg:op_31 prop:content "エネルギーの地産地消ができるシステムと説明する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "停電時にも活躍できるシステムと説明する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "取り入れていくことも大切と考える"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "調整弁扱いでは生かし切れないと指摘する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "再エネは調整弁扱いでは生かし切れないと考える"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "追加施策が増えたと説明する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "今後も引き続き省エネにつながる周知を図りたい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "省エネにつながる制度としてもっと周知するべきと感じている"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:st_4 rdfs:label "斎藤弥志夫議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_39 prop:content "赤字を出さない経営の実現が課題と指摘する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "理想像として挙げられるが実践には困難が伴う"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "一歩前進になる制度と捉える"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:op_42 prop:content "選定要件を十分備える必要があると指摘する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:op_43 prop:content "品質向上につながると考える"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "町の新しい道の駅のテーマとコンセプトを示した"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "コンセプトの一つとして位置づけている"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "重要な要素として議論を深めている"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "少子化防止対策として効果があると考える"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "人口減少対策になる可能性があると考える"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:op_49 prop:content "少子化防止の重要な施策になると考える"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "切れ目のない子育て支援の充実を図っている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "町の財政を考えると支援金見直しの議論が必要と考える"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "交通の方法に関する教則に基づく措置として説明する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "状況に応じた避難行動が重要と考える"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "早急な高台避難が必要と考える"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "間に合わない状況もあるため早急な避難が必要と考える"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "地域の支え合いにより支援する制度と説明する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "地域防災計画を改正して個別避難計画を作成したい"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "災害発生時に備えたいと考える"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "課題把握と解決のため必要と考える"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:st_5 rdfs:label "遊佐町総務課長佐藤光弥"@ja.
kg:st_5 rdfs:type cls:st_95.
kg:op_60 prop:content "今年度構築に向けて検討している"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_5.
kg:st_6 rdfs:label "髙橋冠治議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_61 prop:content "感染能力が非常に高いと驚く"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_6.
kg:op_62 prop:content "感染者が感染させるリスクが付きまとうと懸念する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_6.
kg:op_63 prop:content "保健所が感染者情報を持っているからできる対応と認識する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "個別支援は行っていないし情報管理に細心の注意を払っている"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "今後も収束に向けて取り組む"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "町民にお願いしている"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "立ち寄りやすい道の駅整備が必要と考える"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "立ち寄りやすい道の駅を実現したい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "インターチェンジ近傍整備の利点と捉える"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "道路交通ネットワークが大きく貢献できると考える"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "今後なお一層強化していきたい"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "駅前のにぎわい再生の重要事業であったが閉店申し出があった"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "閉店申し出の理由として説明する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "閉店申し出の理由として説明する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "観光振興と駅前のにぎわい再生につながる有力事業と考える"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "有力な利活用事業と考える"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "事業所改装を行う予定と説明する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "今年度の継続事業として実施予定と説明する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "民間提案を受けて検討を開始している"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "今後も取り組んでいく所存である"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "安心して気軽に参加できる環境整備のため研究検討したい"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "この時間帯が一番手薄になると説明する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "災害発生時の初動活動に支障がないよう取り組んでいる"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "経験者として期待できる団員である"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "消防団経験者を中心に効果があった事例と説明する"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "消防団幹部と協議を重ねながら確保と支援を続けたい"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "温暖化が叫ばれて久しいわけですが、その言葉も温暖化から気候変動、気候危機、最近では気候正義という言葉まで登場しております。気候危機対策が急がれます。"@ja.
<< kg:id_3 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "これは町内でどのくらい再生可能エネルギーが生産されているか。また、どのくらいＣＯ２などの温室効果ガスを排出しているかなど、きちんと数値化、つまり見える化するための現状把握を行う調査となります。"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "それにより、削減すべき温室効果ガスの量を明らかにし、会議に諮り、それに対し吸収対策など、今後町が取り組むべき施策を検討していきたいと考えております。"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "気候危機打開は、再生可能エネルギー、省エネルギーの抜本的普及で、新たな雇用をつくる機会となります。"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "2030年までにエネルギー需要を約40％削減する省エネと再生可能エネルギーで電力の44％を賄うエネルギー転換を実施すれば、年間254万人の雇用が新たに生まれ"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "投資額は、2030年までの累計で202兆円となり、ＧＤＰを205兆円押し上げ"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "化石燃料の輸入削減額は52兆円になるとされています。"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "脱炭素社会の実現は、待望でも停滞でもなく、持続可能な成長に道を開くものなのであります。"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "再生可能エネルギーを地域主体で進める分散型の再エネ社会が今こそ必要になっていると考えます。"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "再エネ等設備を設置する場合は、地域の市民参加を保障しながら進めることが必要であると考えます。"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "気候危機対策として、省エネルギーの推進は肝要です。"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "特に一般住宅でのエネルギー消費性能向上を目指すことは、その関連する工事は、地元の雇用に役立ち、脱炭素にもつながります。"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "省エネは多くは、三、四年で投資した費用の回収ができると言われております。"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "住宅リフォームによる省エネやごみ焼却の熱利用など、技術力やアイデアで可能性が広がる戦略であると考えます。"@ja.
<< kg:id_1 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "自分にできることなんかたかが知れていると考える人々に対しては、幅広い参加こそが必要と呼びかけたいと思います。"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "最も寒い冬を想定した場合は、東京電力はマイナス0.6％という電力状況だということが発表され、まさに電力の不足が心配される年になるのかなと、このように考えております。"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "例えば農業分野は、二酸化炭素やメタンなどの温室効果ガスの排出源とされており"@ja.
<< kg:id_29 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "農業分野における再生可能エネルギー使用率の向上、ＣＯ２削減等の取組が重要になってきております。"@ja.
<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "開発米部会と連携し、先進事例の視察や研究を行い、バイオマスの利用システム、生活クラブエナジーとの連携なども含め、具体的な事業の進め方について協議、検討したいと考えております。"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "そうした取組を進めることで、遊佐町の農産物の環境的な付加価値を高めていくことを目指せるものと考えております。"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "町としてそうした流れを見定めつつ、補助制度などを活用しながら取り組んでまいります。"@ja.
<< kg:id_38 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "各家庭、町民の皆さん一人一人が省エネを意識し、生活することも温室効果ガスの排出減少に向けた大切な取組です。"@ja.
<< kg:id_40 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "二重サッシなどの窓の交換により、断熱効果を高めることも、住宅における省エネにつながります。"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "持家住宅リフォーム支援金制度で、断熱化、寒さ対策としての複層ガラス等を設置する工事についても、支援金の対象としておりますので、ぜひ多くの皆様から活用いただければと思っております。"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "再エネを生かし切れていないと、発電してもそれを止めなければならないと、流せないということが言われております。"@ja.
<< kg:id_44 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "やはりこの再生可能エネルギーについては、優先利用の原則確立がなされることが必要だろうというふうに考える次第です。"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "天候や電力によって発電出力が左右される太陽光や風力発電を最大限に生かすには、揚水発電や蓄電池の整備とともに、余った電力を電力の消費地である大都市へ融通するための連系線の整備も必要です"@ja.
<< kg:id_49 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "省エネの推進とともに、再エネ電力の優先利用原則を確立し、送電網供給体制を整備することが不可欠です"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "どうしても遠くまで送電するということになれば、ロスが出るのはこれは確実でありまして"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "やはりそこのところをロスのない地産地消できるそういう仕組みにしていかなければならないのではないかというふうに考える次第です。"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "限られた地域の中で、太陽光発電ですとか、バイオマス発電などの再生エネルギーで電気を作って、蓄電池などで電力量をコントロールし、地域内の電力供給を賄うことのできるエネルギーの地産地消ができるシステムを地域マイクログリッドというふうに呼ばれているようであります。"@ja.
<< kg:id_55 prop:effect kg:id_57 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "地震や台風などの災害により、停電などが発生した場合、平常時は電力会社とつながっている送電線ネットワークを切り離して、地域単独のネットワークに切り替えることで、安定的に電力の供給ができるという災害時にも活躍できるようなシステム"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "今後カーボンニュートラル社会の実現に向けて、こういう地域マイクログリッド事業のようなシステムも取り入れていくということも大切なことだというふうには考えております。"@ja.
<< kg:id_44 prop:effect kg:id_60 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "電気事業者の都合でせっかくの再生可能エネルギーが無駄になると。"@ja.
<< kg:id_44 prop:effect kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "原子力、原発でのエネルギーを優先されているということになっていて、調整弁扱いでは再生可能エネルギーというのは生かし切れないのだろうというふうに考える次第です。"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "新たにその事業に対して、追加内容ということで、いわゆる住宅の居間だけ、茶の間、いわゆる居間だけを断熱するという工事も、そういう補助の対象にしますよというような追加の施策が増えたというふうなところで"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "断熱二重サッシの交換ですとか、いわゆるペアガラスへの交換ですとか、そのようなところ、断熱効果を生むようなリフォームについても、基本的には全く駄目というものはなく、全てこれまでも該当させてきているところがございます"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "今の住宅リフォーム支援金の制度の周知も含めて、町民に広く周知を図っていきたいというふうに考えております。"@ja.
<< kg:id_68 prop:effect kg:id_69 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "こうした施設は、逆に地域自治体の負の資産となってしまい、それを抱える自治体の大きな課題となっているのが現状のようであります。"@ja.
<< kg:id_70 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "道の駅が地域の原動力となるには、地元の生産者が直接的に関わっているということ、それから観光客の目的地になっている。それから、地域観光のハブ的な役割を担っていると。それから、地域住民にとってのショッピングモールになっていると。それから、地域のコミュニティーセンターになっているなどのことが理想として挙げられる場合がありますが、現実的にはかなりハードルが高い"@ja.
<< kg:id_72 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "防災道の駅制度は、都道府県の地域防災計画で、広域的な防災拠点に位置づけられている道の駅について、防災道の駅として選定し、防災拠点としての役割を果たすための重点的な支援を実施するものであります。"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "建物の耐震化、無停電化、通信や水の確保により、災害時でも業務実施可能な施設になっていること"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "重点道の駅や防災道の駅を目指すことは、道の駅の品質向上につながると考えられることから"@ja.
<< kg:id_78 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "鳥海山の麓の町として、庄内の食と文化を発信し、来る人を鳥海山で魅了する地域の核となる道の駅を目指します。"@ja.
<< kg:id_78 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "そして、５として防災拠点となる道の駅としております。"@ja.
<< kg:id_81 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "事業スキームの整理は、道の駅の健全な運営を行う上で、重要な要素となりますので"@ja.
<< kg:id_83 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "白鷹町ではゼロから２歳児の保育料を無償にすることが昨年12月の白鷹町議会で決定されまして、令和４年度から実施されています。"@ja.
<< kg:id_85 prop:effect kg:id_86 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "このくらいのレベルだと子育てがしやすい町としての評価が高まって、移住者が増えたり、人口減少に歯止めがかかることもあるのではないかと考えます"@ja.
<< kg:id_87 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "遊佐町も白鷹町のようにゼロから２歳の子の保育料を無償にして、３歳から５歳の国への無償政策と併せて、小学校入学前の子の保育料完全無償化を実現することが少子化を防止する重要な施策になると考えます"@ja.
<< kg:id_89 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "ゼロ歳児から２歳児までの保護者へ、保育園入園の有無にかかわらず、年間12万円のすくすくゆざっ子支援金を平成30年４月から支給しております"@ja.
<< kg:id_91 prop:effect kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "町の財政を考えますときに、保育料の完全無償化の実施に対しては、この支援金について多少見直しを図る必要があるのではないかと考えております。"@ja.
<< kg:id_93 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "道路の左側に寄せて駐車し、エンジンを止め、鍵をつけたままとするか、車内の分かりやすい場所に置いておくこととし、ドアはロックせず、避難する人の通行や災害応急対策の実施の妨げになる場合には、駐車しないことと規定されております。"@ja.
<< kg:id_95 prop:contermeasure kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "これまで避難のために車を使用しないこととされてきましたが、津波から避難するためやむを得ない場合は、車を使用しての避難も認められております。"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "この地震で発生が予測される津波は、最高水位約15メートル、町内沿岸への津波の到達時間は最短で９分であります。"@ja.
<< kg:id_99 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "沿岸部では、津波警報の発表とともに、早急に高台に避難をしないと間に合わない状況もあります"@ja.
<< kg:id_101 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "集落、自主防災組織、地域包括支援センター、民生児童委員、近隣住民などが連携して支援していく制度であります。"@ja.
<< kg:id_103 prop:effect kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "災害対策基本法の改正により、要支援者の個別避難計画の策定が市町村の努力義務になりました"@ja.
<< kg:id_105 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "集落、地域包括支援センター、社会福祉協議会、民生児童委員等のご協力をいただき、個別避難計画を作成し、災害発生時に備えたいと考えております。"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "実際に要支援者の訓練への参加を促し、要支援者を実際に避難させる訓練を実施することで、課題を把握し、解決していくことも必要であると考えております。"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "情報の伝達方式については、今検討をしているところでございまして、町政座談会の中でも、そういったことを実施してくれというお声もありましたので、今年度その構築に向けて今検討しているところでございます。"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "第６波と言われるオミクロン株による感染能力がいかに高いかというふうに驚くところであります。"@ja.
<< kg:id_113 prop:effect kg:id_114 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "中には頼れる家族もなく、日常生活に欠かせない食料品や日用雑貨等、感染者が自ら買物に行かなければならず、感染者が感染させるリスクが付きまとう日々であったと伺います。"@ja.
<< kg:id_115 prop:contermeasure kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "自宅療養の希望者に対し、庄内保健所から１人につき１週間分のレトルト食品や缶詰等の食品が届けられております。"@ja.
<< kg:id_117 prop:effect kg:id_118 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "町では、感染者の情報については、庄内保健所から公表情報の内容とほとんど同じ内容しか来ないため"@ja.
<< kg:id_119 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "今後もワクチン接種や感染防止対策の予防対策に重点を置いて、感染症の収束に向けて取り組んでまいります。"@ja.
<< kg:id_121 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "感染された方とそのご家族や職場、医療従事者と関係者を特定、心のない言動による誹謗中傷や偏見等を回避するために、県などの公共機関が発表している以外の情報や臆測は行わないよう、町民の皆様にお願いをしているところであります。"@ja.
<< kg:id_123 prop:effect kg:id_124 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "日沿道開通後には、本町が素通りされる町になってしまうことが懸念をされております。"@ja.
<< kg:id_125 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "日沿道開通後も立ち寄りやすい道の駅を実現するため、開通予定である令和８年を目標に、遊佐鳥海インターチェンジ隣接での新たな道の駅を整備する計画を進めております。"@ja.
<< kg:id_127 prop:effect kg:id_128 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "インターチェンジ近傍に整備することから、新たな道の駅は、道路利用者のアクセス利便性が非常に高いと言えます。"@ja.
<< kg:id_127 prop:effect kg:id_129 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "道路利用者の休憩施設、災害時の一時避難所としての活用、大規模災害の援助部隊の集結等、道路交通ネットワークが大きく貢献できるものと考えております。"@ja.
<< kg:id_130 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "一体型整備のための要望活動を今後なお一層強化し、協定締結に向けた協議を進めてまいりたいと考えております。"@ja.
<< kg:id_132 prop:effect kg:id_133 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "昨年の６月ぽっぽやの皆さんから、スタッフの高齢化と駅利用者の減少による収益の悪化を理由に閉店したいとの申出がありました。"@ja.
<< kg:id_133 prop:cause kg:id_134 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "スタッフの高齢化と駅利用者の減少による収益の悪化を理由に閉店したいとの申出がありました。"@ja.
<< kg:id_133 prop:cause kg:id_135 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "スタッフの高齢化と駅利用者の減少による収益の悪化を理由に閉店したいとの申出がありました。"@ja.
<< kg:id_136 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "遊佐カレーを運営する株式会社フーデライト庄内から、電動アシスト付自転車、Ｅバイクの有料レンタル事業を実施したいとの申出がありました。バイクを活用して、町内の大自然を肌で感じなが巡る新しいツーリズムの提案は、町の観光振興に貢献し、駅前のにぎわい再生にもつながることから、有力な利活用事業として検討を重ねました。"@ja.
<< kg:id_138 prop:effect kg:id_139 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "町内の大自然を肌で感じなが巡る新しいツーリズムの提案は、町の観光振興に貢献し、駅前のにぎわい再生にもつながることから"@ja.
<< kg:id_138 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "６月には、Ｅバイク事業所の改装を行う予定で、７月のオープンを目指した準備を進めております。"@ja.
<< kg:id_132 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "今年度の賑わい再生事業は、新規事業でＥバイクを、継続事業で街かどサロンと軽トラ市、ホール展示等を実施する予定であります。"@ja.
<< kg:id_132 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "現在ゆざっとプラザに特産品の自動販売機を設置する事業提案を町内の事業者から受けており、検討を開始しております。"@ja.
<< kg:id_132 prop:contermeasure kg:id_143 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "町としては民間の力を軸として、官民連携を図り、今後も遊佐駅前の賑わい再生事業に取り組んでまいる所存であります。"@ja.
<< kg:id_144 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "より多くの町民がボランティア活動などに安心して、気軽に参加できることが地域の活性化の一助になると考えておりますので、そのような環境を整備するため、他市町村の状況も参考にしながら、このような地域住民活動保険のような保険制度について、研究、検討していきたいと考えております。"@ja.
<< kg:id_146 prop:cause kg:id_147 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "特に消防団員が一番手薄になるのは、多くの消防団員が仕事で町外にいる平日の日中の災害と想定されます"@ja.
<< kg:id_146 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "災害発生時の初動活動に支障がないように、一度消防団を退団した団員でも、消防団に再入団していただき、災害発生時にはいち早く出動し、災害現場での初動対応を実施することが可能な団員を確保する取組を行っております。"@ja.
<< kg:id_149 prop:effect kg:id_150 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "再入団の団員は、長年の訓練や経験の蓄積があるだけでなく、地域の実情にも精通している経験者であるため、災害時の初動活動に期待できる団員でもあります。"@ja.
<< kg:id_151 prop:effect kg:id_152 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "３月に吹浦地区で発生した一般建物火災の際は、消防団経験者を中心に、自主防災活動の初期消火が行われ、被害を最小限に食い止めたという事例もあります。"@ja.
<< kg:id_153 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "危険を伴う活動時の事故に対する補償も必要であるため、消防団幹部と今後も協議を重ねながら、消防団経験者の確保と自主防災活動への支援を引き続き実施していきたいと考えております。"@ja.
}
