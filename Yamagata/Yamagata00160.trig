kg:st_1 rdfs:label "本間知広委員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "今後も続く可能性があり何とか乗り切る必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "今後も続く可能性があり何とか乗り切る必要がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "後藤町民課長"@ja.
kg:st_2 rdfs:type cls:st_38.
cls:st_38 rdfs:label "職員"@ja.
kg:op_3 prop:content "住民票の写しの交付から始めたい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "印鑑登録証明書の交付から始めたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "住民にとって必要なときに利用できるメリットがある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "高齢者や記載困難者のサポートになる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "本人確認や申請書を省くことができる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "誤りもなくなるため期待できる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "便利になるにはマイナンバーカードを作る必要がある"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "24時間化の情報は入っていない"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:st_3 rdfs:label "佐藤総務課長"@ja.
kg:st_3 rdfs:type cls:st_38.
kg:op_11 prop:content "共同利用システムにより経費が相当安くなっている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "初期投資の一部は特別交付税で対応できる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:st_4 rdfs:label "池田健康福祉課長"@ja.
kg:st_4 rdfs:type cls:st_38.
kg:op_13 prop:content "社会福祉協議会に委託して実施する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "社会福祉協議会に委託して実施する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
kg:op_15 prop:content "各分野が連携して相談を受け支援プランを作成する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "社会福祉協議会との打合せで残りの取組も進めることになった"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "当初見込みを超えて移住者が増えている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "不足分に加え今後の増加も見込んで補正している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "増加要因を精査して今後に生かすべきだ"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "定住促進担当とも確認しながら進めたい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:st_5 rdfs:label "佐藤俊太郎委員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_21 prop:content "洪水時の安全面も考慮し高い場所としての活用も検討すべきだ"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:st_6 rdfs:label "渡会企画課長"@ja.
kg:st_6 rdfs:type cls:st_38.
kg:op_22 prop:content "防災拠点という位置づけで整備を進めたい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:op_23 prop:content "長く使え運用経費が少ない機種を選ぶべきだ"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "屋根上の葉の蓄積も含め管理を進めるべきだ"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "統一感があり目立つ窓口づくりが必要だ"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "統一感のあるサポート窓口を設置する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "70代を中心に高齢者の利用が多い"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "オミクロン対応ワクチン接種に関する委託料である"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "医療機関や保健所の判断になる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "特にコンクリート単価が想定より上がっている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "建設資材上昇と諸経費上昇が重なっている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "危険度も高く衛生上も芳しくないため早期有蓋化を進めるべきだ"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "できるだけ早い段階で全数有蓋化を進めるべきだ"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:op_34 prop:content "今年は実績が増え追加補正が必要になった"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "非課税世帯限定を外し加算方式にした"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "フォーラムを契機に次の取組につなげたい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:op_37 prop:content "遊佐町のPRが不足しているとの声がある"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_6.
kg:op_38 prop:content "文書費の増額要因は主に課税誤り処理に関する郵送料である"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:st_7 rdfs:label "菅原教育課長"@ja.
kg:st_7 rdfs:type cls:st_38.
kg:op_39 prop:content "教員への連絡や不測の事態対応のため必要である"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_7.
kg:st_8 rdfs:label "菅原和幸委員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_40 prop:content "多様な意見を踏まえ情報交換が大切だ"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_8.
kg:st_9 rdfs:label "太田地域生活課長"@ja.
kg:st_9 rdfs:type cls:st_38.
kg:op_41 prop:content "先進地の情報交換や学ぶべき点の把握に役立つ"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "道路の拡幅等が変わるため台帳補正が必要である"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_9.
kg:op_43 prop:content "昨年の大雪を踏まえて試行導入する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_9.
kg:op_44 prop:content "委託業者の日報作成負担の軽減が見込める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_9.
kg:op_45 prop:content "来年度計画を前倒しするような形で施工する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_9.
kg:op_46 prop:content "開設に必要な最低限の除砂等を既決予算で実施した"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:op_47 prop:content "昨年度同様に1件当たり2500円の特産品送付を予定する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "3年間で14名の生徒を受け入れている"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_6.
kg:op_49 prop:content "今年度は7名となり男子寮2棟女子寮2棟が必要となった"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:st_10 rdfs:label "時田町長"@ja.
kg:st_10 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_50 prop:content "地域に入れていくと子供たちの学び方が変わる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_10.
kg:op_51 prop:content "町で河川全体を見て情報連絡体制をつくる"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_9.
kg:st_11 rdfs:label "舘内産業課長"@ja.
kg:st_11 rdfs:type cls:st_38.
kg:op_52 prop:content "駅前のにぎわい再生のため冷凍自販機設置を支援する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_11.
kg:op_53 prop:content "加工場利用が明らかに増えている"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_11.
kg:op_54 prop:content "資材単価の高騰で件数が少なくても予算上限に早く達している"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_9.
kg:op_55 prop:content "資材によっては1.5倍から2倍になっている"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_9.
kg:op_56 prop:content "三隣亡でも新築住宅が軒並み建っている"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_9.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "特に今回の補正見ましても、特に燃料代の高騰による税金、その補正ですとか"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "資材が高騰、例えばその調達であったり、そういったことに絡むものであったりとか"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "コンビニ交付というのは、マイナンバーカードを使いまして、町が発行する証明書、これは全国のコンビニエンスストア、キオスク端末で取得できるサービスとなります。まずは住民票の写し"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "まずは住民票の写し、こちらと印鑑登録証明書の、この２点から始めたい"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "毎日６時半から23時までの時間、限られますけれども、この時間帯に交付ができるようになります。窓口閉庁後の夜間、それから休日でも、いつでも必要なときにご利用いただける"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "高齢者の方ですとか、それから申請書のほうを記載することが困難な方、こちらのサポートになります"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本人確認や申請書を省くことができるということになります"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "誤りもなくなるということになりますので、非常に期待できる端末であります"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "私も持っております、マイナンバーカード。これがないと端末が動かない"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "これは全国的にシステム上決まっている時間でございますので、今のところ24時間行うという情報は全く入っておりません"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "Ｊ―ＬＩＳといって、地方公共団体情報システム機構というところで共同利用するシステムを開発というか、つくっております。それを利用することによって経費のほうが相当安くなっている"@ja.
<< kg:id_19 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "初期投資の部分については特別交付税で算定してくれるという、一部ですけれども、そういうこともございます"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "この補正予算の内容としましては２番目の多機関協働の取組"@ja.
<< kg:id_21 prop:cause kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "３番目の参加支援の取組について、これについても社会福祉協議会のほうに委託しまして事業を実施していくための補正予算"@ja.
<< kg:id_21 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "この移行準備事業の中でしなければいけないというのが４項目ありまして、１つは庁内連携体制の構築"@ja.
<< kg:id_21 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "２つ目が多機関協働の取組ということで、先ほど障がいとかいろいろ分野ありましたけれども、その分野それぞれ連携して相談を受け付けて、支援のプランを作成して実施する"@ja.
<< kg:id_21 prop:contermeasure kg:id_26 >>
    prop:text-txt_contents "３番目として参加支援の取組ということで、今それぞれの地区で生活支援体制事業を、生活支援の事業を行っているわけですけれども、それに結びつけていくという参加支援"@ja.
<< kg:id_21 prop:contermeasure kg:id_27 >>
    prop:text-txt_contents "４番目としまして、アウトリーチ等を通じた継続的支援の取組ということで、支援が必要なのだけれども、まだ支援が届いていない人に支援を届ける取組"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "当初につきましては、この事業自体がそんなにはっきりはしていなかった部分もあったのですけれども"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "子育て世帯の移住者が増えていることでありまして"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "当初予定しました８人分を既に超えていまして、ちょっと不足分が出ている"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "定住促進のほうも関係していますので、そちらのほうともちょっと確認をしながら進めたい"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:text-txt_contents "事業用地でございますけれども、道路よりもまず低いといったところになっておりますので、埋立てが必要になってまいります"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:text-txt_contents "上下水道管、あとパイプライン布設については、県のこちらの工事に合わせて施工する必要がある"@ja.
<< kg:id_40 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "当然パーキングエリアタウンは防災拠点という位置づけで整備を進めたい"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:text-txt_contents "現在和式の便器となっておりますけれども、この和式の便器に不具合が見られた"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:text-txt_contents "経年によって、修繕するための部品供給が見込めないことから、修繕ではなく交換というふうにこちらでは判断"@ja.
<< kg:id_46 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "今回の交換工事によりまして、２つとも洋式に換えたい"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "今後まだ撤去業務が発生することもあろうということも想定をさせていただきまして、50万円ほど計上"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "申請率が伸びている自治体の先進事例などを見ますと、ユニフォームですとかのぼり旗、そのほかのグッズが統一されて、遠くからでもすぐにマイナンバーカードの申請会場だなというふうに分かる"@ja.
<< kg:id_52 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "内容は、ただいま申し上げましたが、のぼり、それから出張申請用のベスト、それからテーブルクロス、それから公用車の両脇にマグネットで広告をつけて"@ja.
<< kg:id_54 prop:effect kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "70代の方が一番多く、43.8％の方がこのマイナポイントの申込みサポート会のほうにおいでいただいて"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "オミクロン対応ワクチン接種に関する委託料になります"@ja.
<< kg:id_56 prop:effect kg:id_58 >>
    prop:text-txt_contents "対象としましては１回目、２回目、２回打った方を対象としております。年齢としましては、12歳以上の方が対象"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "残念ながら、当町ではそういった権限はありません。医療機関、あるいは保健所等の判断"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "建設資材の上昇、特にコンクリートを多く使いますので、コンクリート自体の単価が７月の調整で非常に想定より1.2倍ほど"@ja.
<< kg:id_63 prop:cause kg:id_62 >>
    prop:text-txt_contents "あるいは人件費も上がってきているということであります"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "建設資材が1.2倍、それに係って諸経費についても1.2倍ということになりますと、掛け合わせて1.44、約1.4倍"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "生活環境上、無蓋の防火水槽に関しては、危険度も高いでしょうし、衛生上もあまり芳しくないように感じます"@ja.
<< kg:id_66 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "できるだけ早い段階で、この199、全数有蓋化になるようにお願い"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:text-txt_contents "現在の新型コロナウイルス感染症の拡大の影響、そういったものによりまして、テレワークによる業務形態を取り入れる事業者が増えている現状"@ja.
<< kg:id_71 prop:contermeasure kg:id_72 >>
    prop:text-txt_contents "テレワークを伴う移住を検討している方へ、本町への移住促進"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:text-txt_contents "ワーケーションを行う方とのつながりを創出することで関係人口の増加を図りたい"@ja.
<< kg:id_75 prop:cause kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "今現在相談を受けているものが２件ございまして、１件についてはＤランクで...60万円を想定をしております。ですと、予算使い切ってしまいます"@ja.
<< kg:id_77 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "昨年度から要綱を見直しまして、当初は非課税世帯のみの対象としていたものを、そこの部分外して、それにつきましては加算ということで対応"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:text-txt_contents "当初予定しておりませんでした遊楽里の吸収冷温水機、集中エアコンでございます。エアコンの機器の故障による緊急修繕"@ja.
<< kg:id_81 prop:contermeasure kg:id_82 >>
    prop:text-txt_contents "こちらは臂曲地区の岩石採取に係る訴訟事件、係争ございましたけれども、そちらの経過の説明ですとか、そういったものが主になろうかと思います"@ja.
<< kg:id_81 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "策定の際のお話ですとか今後に向けての取組に対しての提案等、そういったものがいただけるのかな"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:text-txt_contents "今やっておりますのが水量の調査ですとか"@ja.
<< kg:id_84 prop:contermeasure kg:id_86 >>
    prop:text-txt_contents "水の成分の分析ですとか、そういったところは業者さんに委託をして"@ja.
<< kg:id_84 prop:effect kg:id_87 >>
    prop:text-txt_contents "これまでの推移、そういったものをまず記録をする、調査をしていく"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "ほかの３市と比較した場合、当遊佐町の部分のＰＲが不足しているのではないかといった声がございまして"@ja.
<< kg:id_90 prop:contermeasure kg:id_91 >>
    prop:text-txt_contents "今考えておりますのが防災センターの１階と２階の間のスペースを活用して、そちらに横断幕タイプのものを検討しております"@ja.
<< kg:id_92 prop:cause kg:id_93 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "固定資産税の課税誤り等に係る処理が今年も続いているということで、それに関する通信料というか、郵便の料金がかさんでいる"@ja.
<< kg:id_94 prop:cause kg:id_95 >>
    prop:text-txt_contents "統合後は職員数が増になるということはもちろんでございまして、電話の回線を増やす必要がある"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "緊急を要するような事態、これにも対応するためには、通話手段ということで、やはり業務の効率化、不測の事態に対処できるよう体制を整えるために、ＰＨＳの設備のほうも付与する"@ja.
<< kg:id_98 prop:cause kg:id_99 >>
    prop:text-txt_contents "職員の駐車場の街路灯、これ１基の交換工事に係る経費を計上しております。図書館のほうの開館の平成３年以来の街路灯でございましたけれども、このたびポールの根元のほうが腐食"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:text-txt_contents "当該地は、海外林の最前線で当たるため、潮風等による影響が強く、松苗を保護する必要があるため"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:text-txt_contents "地元青塚集落からの要望もございまして、防風柵を設置したところでございます"@ja.
<< kg:id_104 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_40;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "今後、本町も法定協議会が進めていく中で、いろいろ先進地の情報交換、情報を得たり、いろいろ学ぶべきところ"@ja.
<< kg:id_106 prop:cause kg:id_107 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "新設のみならず、道路改良並びに側溝整備を行っても道路の拡幅等変わってきますので、そういうものも含めて全て"@ja.
<< kg:id_108 prop:cause kg:id_109 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "昨シーズンの大雪を踏まえて、状況を踏まえてということで、今回あくまでも除雪管理システムのトライアル"@ja.
<< kg:id_110 prop:effect kg:id_111 >>
    prop:text-txt_contents "ＧＰＳがついている機器をいわゆる除雪車につけまして、要はＧＰＳつきですので、現在どこの辺を走っているとか、そういうところがまず分かる"@ja.
<< kg:id_110 prop:effect kg:id_112 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "毎日各委託業者のほうに日報等のまとめをお願いしているのですが、なかなかこれも大変な作業になるのですが、そういうものがこのシステムを入れることによって簡易に済む"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:text-txt_contents "これまでは竹林の中で全く状況が見えなかったということで、町のほうでも把握をしておりませんでした。今年の春、２月ぐらいでしょうか、高速道路工事が入るというところで周辺を伐採したところ、そのひび割れが分かった"@ja.
<< kg:id_115 prop:contermeasure kg:id_116 >>
    prop:text-txt_contents "南山地区ののり面補修工事に関わる設計委託料"@ja.
<< kg:id_117 prop:cause kg:id_118 >>
    prop:text-txt_contents "６月30日に一部落橋したというような状況になりまして"@ja.
<< kg:id_119 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "白木側のほうから仮桟橋を造って、今の木橋の脇に仮桟橋を造って撤去していく"@ja.
<< kg:id_121 prop:cause kg:id_122 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "海水浴場、ビーチへの砂ですとか漂着ごみの堆積が非常に多かった"@ja.
<< kg:id_121 prop:effect kg:id_123 >>
    prop:text-txt_contents "既決予算の範囲内で利用に支障ない程度、海水浴場として開設できる最低限のところで工事をさせていただいたものとなります。そのため、今の補正で計上させていただいておりますのが、先に使わせていただいてしまったものですから、その補填"@ja.
<< kg:id_124 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "１件当たり2,500円の特産品をお送りするということを想定"@ja.
<< kg:id_126 prop:effect kg:id_127 >>
    prop:text-txt_contents "山形県のやまがた冬割、そちらの事業との相乗効果もございまして、１月の13日受付分で終了"@ja.
<< kg:id_128 prop:effect kg:id_129 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "この３年間で14名、現状では14名の生徒さんが遊佐町に自然体験型留学生ということで来ていただいております"@ja.
<< kg:id_130 prop:cause kg:id_131 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "４年度の留学生の人数が７名となりましたので、そちらに対応するためには男子寮２棟、女子寮２棟必要だということになって"@ja.
<< kg:id_132 prop:effect kg:id_133 >>
    prop:text-txt_contents "管理する寮の数が増えたことによりまして、夜間の子供たちの監護ですとか、食事の提供ですとか、そういったことをしていただく生活相談員さんへの謝礼がかなり増えている...施設が増えたことによりましての光熱水費の増"@ja.
<< kg:id_134 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "やっぱりリフォーム空き家を活用したほうが、ずっと地域と共にある、そして地域のよさも子供たち学べる"@ja.
<< kg:id_136 prop:cause kg:id_137 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "組合がなくなるということで、新たに遊佐町の河川情報連絡会というものを10月１日付で今立ち上げたい"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:text-txt_contents "これまでの月光川水害予防組合議員の皆さんであれば年間６万円の議員報酬あったわけですけれども、これから新たに委員を組織する"@ja.
<< kg:id_140 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "町の玄関口である駅前のにぎわいを再生するために、遊佐フードを入れた冷凍自動販売機を設置する事業"@ja.
<< kg:id_142 prop:effect kg:id_143 >>
    prop:text-txt_contents "24時間対応の自販機となってございまして"@ja.
<< kg:id_144 prop:cause kg:id_145 >>
    prop:text-txt_contents "昨年度11月から貸しオフィスに加藤総業さんが加わっておりまして"@ja.
<< kg:id_146 prop:cause kg:id_145 >>
    prop:text-txt_contents "燃料高騰等の影響によりまして、金額が上がっている"@ja.
<< kg:id_147 prop:cause kg:id_145 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "加工場の利用の状況を見ますと、令和３年度から令和４年度の利用状況を見比べますと、明らかにこの５か月間で利用の金額がかなりの増額"@ja.
<< kg:id_148 prop:cause kg:id_149 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "件数は少なめなのですけれども、早めに予算がいっぱいいっぱいになっている"@ja.
<< kg:id_150 prop:cause kg:id_151 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "単価がもう高いと、1.5倍以上、下手すると資材によっては２倍とか"@ja.
<< kg:id_152 prop:effect kg:id_153 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "三隣亡ということで、新築というの少ないのかなというふうに踏んでいたところですが、ところがということで、庁舎前、新庁舎前の建築状況を見ていただいてもお分かりのとおり、新築住宅が軒並み建っている"@ja.
}
