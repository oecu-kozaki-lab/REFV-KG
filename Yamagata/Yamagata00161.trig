kg:st_1 rdfs:label "佐藤光保議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "進捗状況の確認を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "時田町長"@ja.
kg:st_2 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_2 prop:content "今後町が取り組む施策の基礎資料として重要と認識"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "割合の高い運輸分野への施策検討が必要とする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "割合の高い家庭分野への施策検討が必要とする"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "車が必要な地域特性を踏まえた対策を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "車は不可欠でありつつ排出削減策を考える必要があるとする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "高い割合を占める分野として重点対策が必要とする"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "高い割合を占める分野として重点対策が必要とする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "無視できない排出量であり削減対策が必要とする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "バイオガス発電への活用可能性を問う"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "農業分野も重要な削減対象と認識"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "農業分野の削減対策も進める必要があるとする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "既存補助制度の活用を進めたいとする"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "来年以降も制度継続を確認したい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:st_3 rdfs:label "太田地域生活課長"@ja.
kg:st_3 rdf:type cls:st_2.
kg:op_15 prop:content "継続して予算計上したい考えを示す"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "県の補助制度も含め様々な制度活用を促す"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "町として情報提供を強化する考えを示す"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "国や県の動向を見ながら支援制度を更新する考えを示す"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "最新情報の発信と意識啓発を進めたいとする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "排出の少ない車取得への支援が有効とみる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "燃費の良い車取得支援を検討対象とする"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "電気自動車購入支援をこれから考える必要があるとする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "将来的には水素活用交通への移行も必要とみる"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "メタンガスのバイオガス発電活用可能性を問う"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "過去に提案はあったが適地が乏しいと説明"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "本町では立地条件が課題と説明"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "話し合いのテーブルに上げる価値があると評価"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "町民参加型の運営体制づくりが必要と主張"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "交付金活用による無償化の継続意向を問う"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "子育て世帯支援として意義があると評価"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "物価高騰下で保護者負担軽減が必要と説明"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "生活支援策として全額助成を実施したと説明"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "設定単価内で提供できており値上げはしない考えを示す"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "設定単価内での提供が困難なら補助を検討するとする"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "物価高騰時の助成を要望する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "単独運営が高い要因の一つと説明"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "20立方程度を超えると県内で最も高い水準になると説明"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:st_4 rdfs:label "本間知広議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_38 prop:content "過剰な整備があったのではないかと指摘"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "当時の計画で需要増を見込んでいたと説明"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "早期の耐震化と更新が必要と判断"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "耐震化を早期に進める必要があるとする"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "計画で何を目指すのか確認したい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:op_43 prop:content "施設耐震化と更新を早期に進めるため策定したと説明"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "現有施設で最も古く耐震診断結果も厳しいため優先すると説明"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "地震時の保有水喪失を防ぎ応急給水水源を確保するためと説明"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "昭和40年代整備の非耐震管の布設替えを行うと説明"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "地震時の断水リスク軽減が必要と説明"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "東日本大震災時の経験からバックアップ体制確立が必要とする"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "料金収入の減少は避けられないと認識"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "使用量減少が将来的な料金上昇につながることを懸念"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "財源確保には料金改定時期の検討も必要とする"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "配水区域拡大で老朽配水池廃止可能性を検討する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "人口減少を踏まえ維持管理費縮減を図る考えを示す"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "広域連携の現状を確認したい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_4.
kg:op_55 prop:content "遊佐の水源確保を前提に慎重に検討したい"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "給水形態を変えず経営部分のみ統合の可能性を考える"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:st_5 rdfs:label "池田健康福祉課長"@ja.
kg:st_5 rdf:type cls:st_2.
kg:op_57 prop:content "利用者増を見込み必要な子供が保育を受けられるよう対応する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_5.
kg:op_58 prop:content "場所の課題に対応するため空き校舎活用を進める"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:st_6 rdfs:label "阿部満吉議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_59 prop:content "3園運営が厳しくなると懸念"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_6.
kg:op_60 prop:content "保護者や地域と話し合いながら今後を検討するとする"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_5.
kg:op_61 prop:content "園児減少を前提に今後の方針を検討している"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_5.
kg:st_7 rdfs:label "髙橋冠治議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_62 prop:content "関係車両の集中による安全面を懸念する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_7.
kg:op_63 prop:content "朝の交通集中と周辺集落への配慮が必要と指摘"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_7.
kg:op_64 prop:content "安全で合理的な運行方法として方針を決定した"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "児童生徒の乗車範囲に対応した再編と説明"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "新路線運行前に実地確認と指導を行う考えを示す"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "試運転を通じて課題把握し改善する考えを示す"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "地域と保護者の協力で安全を確保したいとする"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "学校や地域から情報を得て危険箇所解消を進める"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "拡幅だけで十分か慎重な検証が必要と指摘"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_7.
kg:st_8 rdfs:label "菅原教育課長"@ja.
kg:st_8 rdf:type cls:st_2.
kg:op_71 prop:content "大型バス交互通行可能な規格で改良すると説明"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_8.
kg:op_72 prop:content "やむなく送迎される場合の安全確保策として周知徹底する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_8.
kg:op_73 prop:content "条例に沿って町の責務を果たすよう努めてきたと説明"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "今後も条例を活用して協働のまちづくりを進めたいとする"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "人口に見合った暮らしやすさを求めるべきと主張"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_6.
kg:st_9 rdfs:label "佐藤俊太郎議員"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_76 prop:content "安全確保上当然の協力依頼と評価する"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_9.
kg:op_77 prop:content "道路安全確保の観点から管理強化が必要と考える"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_9.
kg:op_78 prop:content "道路上に張り出した枝木への対応は必要と認める"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_9.
kg:op_79 prop:content "公園ごとに状況に応じた委託管理を行っていると説明"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_3.
kg:op_80 prop:content "危険木等は所管課で対応していると説明"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_3.
kg:op_81 prop:content "10か条を踏襲するか確認したい"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_9.
kg:st_10 rdfs:label "土門教育長"@ja.
kg:st_10 rdf:type cls:st_104.
cls:st_104 rdfs:label "教育"@ja.
kg:op_82 prop:content "多くの英知を結集した内容であり踏襲する考えを示す"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_10.
kg:op_83 prop:content "大人の手本が子供の健全育成の近道と考える"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_10.
kg:op_84 prop:content "情操教育は学校教育全体で育むべきものとする"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_10.
kg:op_85 prop:content "優しさに加えて多様性を認め合う姿勢を伸ばしたいとする"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_10.
kg:op_86 prop:content "議論と相互承認を通じた自己確立が可能と考える"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_10.
kg:op_87 prop:content "具体的な環境整備の説明を求める"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_9.
kg:op_88 prop:content "教員が寄り添い共に考えることが第一歩と説明"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_10.
kg:op_89 prop:content "寄り添う関係が将来への意欲形成につながるとする"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_10.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "ゼロカーボンに向けた現況調査事業というのがありますが、この進捗状況はどうか伺います。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "調査の結果を基に、削減すべき温室効果ガスの量を明らかにし、再エネ導入指針や吸収源対策など、今後町が取り組むべき施策の検討材料となる貴重なものであります。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "排出量の分野別内訳としては、割合の多い順から自動車、鉄道などの運輸部門が40％"@ja.
<< kg:id_5 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "排出量の分野別内訳としては、割合の多い順から自動車、鉄道などの運輸部門が40％、家庭部門が26％"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "運輸部門は、人口が少ない地域は車依存の傾向が強く出るため、割合が高くなるということです。"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "今後割合の高い運輸、家庭分野に対する施策の検討が必要であると考えております。"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今後割合の高い運輸、家庭分野に対する施策の検討が必要であると考えております。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "本町の基幹産業である農業分野、特に稲作における温室効果ガスであるメタン排出量の推計もしていただいております。令和元年度の推計値ですが、本町では年間１万3,000トン排出されております。"@ja.
<< kg:id_13 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "エネルギー由来のＣＯ２排出量と比較しても無視できない量であると考えます。"@ja.
<< kg:id_13 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "農業分野に対する削減対策も検討していく必要があると考えているところであります。"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "現在本町では、太陽光やバイオマス発電などの再生可能エネルギーの設備の設置に関し補助制度を設けております。"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "また、持家住宅リフォーム支援金制度による省エネ化に対する助成も行っております。"@ja.
<< kg:id_17 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "山形県においても、やまがた未来くるエネルギー補助金という再生可能エネルギー設備導入のための補助制度や、住宅、建築物の省エネ性能向上のためのやまがた健康住宅・再エネ設備パッケージ補助金制度を設けておりますので、そういった様々な制度を活用いただければと思っております。"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "また、町としてもそうした制度の紹介、情報の提供に努めていきたいと考えております。"@ja.
<< kg:id_22 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "町といたしましても、国や県の動向を見つつ、新たな設備への対応や助成内容の見直しなどを行っていく所存であります。"@ja.
<< kg:id_22 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "また、補助金だけでなく、再エネ設備導入や省エネに関するセミナーの開催等を行い、町民の皆さんに最新のエネルギー情報を発信するとともに、ゼロカーボンに向けた意識の啓発に努めていきたいと考えております。"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "町では例えば車の……エコカーですか、エコカー補助金なるものを設定したときもありました。"@ja.
<< kg:id_26 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "やっぱり燃費、ＣＯ２の排出の少ない車を取得するときの支援"@ja.
<< kg:id_26 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "またＥＶ、電気自動車等の購入に対する支援等もこれからやっぱり考えていかなければならないであろうと思っています。"@ja.
<< kg:id_26 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "水素の内燃エンジンを使ったものによって排出されるものが水しか出ないということでありますので、いわゆるそれらを使った交通機関への移行等も将来的には考えていかなければならないものだと"@ja.
<< kg:id_31 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "そのメタンガスというのは、私が先ほど壇上で説明したバイオガス発電のほうに使えるというような、そういった可能性はありませんか。"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "本町においてはいわゆる畜産の現状、現在畜舎が建ってあるような位置的なところもあって、なかなか適地がないのではないか"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "それら等生活クラブ生協等との議論の上での検討というのは、大いに話合いの一つのテーブルに上げるということは非常に参考になるのかなと思います"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "行政と町民とが協働して運営できるように回していくような、そういう仕組みづくりがこれからは必要ではないか"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "新型コロナウイルス感染症対応地方創生臨時交付金を活用して、給食の無償化が実施されております。"@ja.
<< kg:id_38 prop:effect kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "子育て世帯に対する支援としてその意義が認められたものでございます"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "コロナ禍における物価高騰等に直面する児童生徒保護者の負担軽減を図る生活支援策の一環として"@ja.
<< kg:id_38 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "９月から12月のおおむね２学期分の給食費を全額助成するということをさせていただきました。"@ja.
<< kg:id_41 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "給食費についての値上げは実施せず、現在の単価設定を維持していきたいと考えております。"@ja.
<< kg:id_41 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "設定単価内で提供できることが困難な場合にその食材単価の上昇分に対して補助を検討していきたいと考えているところであります。"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "本町の水道料金が高い要因につきましては、今議員おっしゃるようなとおりの要因に加えまして、本町の水道事業、町が全て単独、独自で賄っているということが要因かと思っているところであります。"@ja.
<< kg:id_46 prop:cause kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "本町の場合従量料金、つまり使用水量１立方当たり319円、基本料金を超えますと加算されていくという料金体系を取ってございます。そのため、大体ですけれども、20立方ぐらいを超えた辺りから県内ではもう一番高いというような料金の体系に現在なっている"@ja.
<< kg:id_46 prop:cause kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "当時の計画におきましては生活様式の多様化による水需要が増加する、一部地域では水圧が著しく低下していると、さらにはリゾート施設及び工業団地の造成、下水道整備事業による加算給水というものを見込んだという当時の計画書によると、それで既設の配水池に増設する計画を策定して整備した"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "令和10年までに法定耐用年数を超過する延長は５万76メーター、全体の23.9％になっております。"@ja.
<< kg:id_50 prop:effect kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "一方管路の耐震化については延長比率で20％に満たない状況にあります。"@ja.
<< kg:id_50 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "本町においても施設の耐震化と更新を早期に進める必要があると判断し、令和２年度には水道施設の耐震診断と管路の地震被害想定調査を実施し、これらのデータを基に令和３年度に水道事業耐震化更新計画を策定したところであります。"@ja.
<< kg:id_50 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "大楯浄水場敷地内の第２水源建屋の改築"@ja.
<< kg:id_50 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "平津配水池緊急遮断弁の設置"@ja.
<< kg:id_50 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "重要拠点施設を結ぶ基幹管路の送配水管の更新"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "地震時には漏水した管路から配水池の保有水が喪失してしまって、応急給水に使用する水が確保できないという状況が想定される"@ja.
<< kg:id_57 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "本計画では水道施設の耐震化のみに限らず、災害発生時を想定した非常用電源の整備や応急給水栓の設置などバックアップ機能の強化、確保にも努めていきたい"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "人口減少に伴う水需要の低下は避けられないものであり、料金収入について減少が続くものと想定しております。"@ja.
<< kg:id_60 prop:effect kg:id_62 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "人口減少に伴う水需要の低下は避けられないものであり、料金収入について減少が続くものと想定しております。"@ja.
<< kg:id_60 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "配水池からの配水区域の見直しであります。タンク容量に余裕のある配水池から配水区域を拡大することにより、将来的に老朽化により改築が必要となる配水池の廃止が可能であるか検討していきたい"@ja.
<< kg:id_60 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "水道施設等を改修する際にサイズダウンを検討する、これまでより人は増えないわけですから、サイズダウンを検討して、維持管理に要する経費についても縮減が可能なのか検討していきたい"@ja.
<< kg:id_60 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "現在県が中心となって進められている庄内圏域での広域連携による経営部門の統合の可能性について県から参加を求められておりますので、一応はこれらについても検討していかなければならない"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "今後利用者が増えるということも見込みまして、本当に真に保育が必要な子供はできるだけというか、子供たちがちゃんと保育を受けられるようにということでまず対応していきたい"@ja.
<< kg:id_66 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "蕨岡のほうのあそぶ塾につきましては蕨岡小学校の空き校舎を利用して、そちらのほうで放課後児童クラブを続けていくという方向で今進めている"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "実際今出生が年間60名前後だというふうに思っておりますので、３園運営するにも大変だというふうに感じます。"@ja.
<< kg:id_69 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "募集の結果を見て、そして今後どうしていくかということをスケジュールも含めて検討していくということになります。"@ja.
<< kg:id_69 prop:effect kg:id_72 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "今後吹浦保育園につきましては、まずは10名ぐらいずつ減っていくだろうという見込みで今のところいる"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "統合に伴い１路線から10路線に大幅に増便されることになっております。利用児童数は、冬期を含めて323人というふうに見込んでおります。"@ja.
<< kg:id_73 prop:effect kg:id_75 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "関係車両の多くが小学校に隣接する県道、町道に集中するわけであります。"@ja.
<< kg:id_73 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "遊佐小学校以外の４校の児童については全員バス通学とする。"@ja.
<< kg:id_73 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "現行の９路線を基本として、児童生徒の乗車範囲に対応した12路線に再編する"@ja.
<< kg:id_73 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "新路線の運行に向けて、バス運転手の運行ルート研修を行い、小学校児童のバス乗車練習及び乗車指導を行うこととしております。"@ja.
<< kg:id_73 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "この試運転において、運行時間等について確認し、運行に当たっての課題等を検証していくこととしております。"@ja.
<< kg:id_73 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "区長、見守り隊、保護者の皆さんからも自宅からバス停までの見守りとバス乗車の仕方の見守りをお願いしているところであります。"@ja.
<< kg:id_73 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "学校、地域の皆さんから情報をいただきながら、この会議にも活用し、危険箇所の解消に取り組んでいきたいと考えております。"@ja.
<< kg:id_73 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_70;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "校舎北側の町道の拡幅工事等を実施しながら安全確保を努めていきます"@ja.
<< kg:id_73 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "やむなく送迎される場合などにおきまして、やはり安全性の観点という点から、各保護者には体育館前駐車場の利用をお願いする予定"@ja.
<< kg:id_84 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "この条例に沿って、審議会等の会議の公開や政策形成過程におけるパブリックコメントの実施、情報公開条例に基づいた行政文書の公開など、町としての責務を果たすよう努めてまいりました。"@ja.
<< kg:id_84 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "今後もよりよい地域社会を築くために、この条例を活用して町民の皆さんの参画と協働の下、お互いの立場を尊重しながらまちづくりを進めていきたいと考えております。"@ja.
<< kg:id_87 prop:cause kg:id_88 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "人口の減少は全国的な傾向であり、殊さら危機意識を持つべきものとは思ってはおりませんが、人口に見合った暮らしやすさを求めていくことが地方の小さな町の在り方ではないか"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "私有地から道路上に張り出している枝木は土地所有者の方に剪定や伐採をお願いしています。町道に隣接する山林などから道路上に枝などが張り出して、特にこの時期になると自動車などの運行の妨げとなり大変危険です。"@ja.
<< kg:id_89 prop:effect kg:id_91 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "特にこの時期になると自動車などの運行の妨げとなり大変危険です。"@ja.
<< kg:id_89 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "つきましては、枝木等の剪定や伐採へのご協力をお願いします。"@ja.
<< kg:id_93 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "都市公園、河川公園、児童公園につきましては、それぞれ日常的な管理、植栽の管理や草刈り、トイレ清掃などにつきましてですが、公園ごとに地元集落、管理組合、シルバー人材センター、業者等に委託しておりまして"@ja.
<< kg:id_93 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "枯れ木や倒木の処理対応につきましては、先ほどの答弁にもありましたとおり、それぞれ各所管課で対応しているという状況です。"@ja.
<< kg:id_96 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_81;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "「躍動」する遊佐っ子10か条は、2015年に制定するまで多くの英知を結集した内容と承知しておりますので、私は踏襲する考えでおります。"@ja.
<< kg:id_96 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "特に大人が率先して取り組み、手本を示すことが子供の健全育成の近道であると考えております。"@ja.
<< kg:id_96 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "今後の情操教育の方針につきましては、特別な教科道徳を要として、学校教育全体を通して醸成していくものと考えております。"@ja.
<< kg:id_96 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "最近では互いの違い、多様性を認め合う寛容性や関係性が確実に育ってきているように見受けられます。"@ja.
<< kg:id_96 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "今後は、優しい人柄の町民性に加え、自分なりの考えを持ち、互いを認め合う中で議論を尽くし、一人一人がアイデンティティーを確立していくことが可能であると考えております。"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_87;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "私は、まず先生方にはやりたいことが多岐にわたる子供たちの声や気持ちに寄り添い、耳を傾け、共に考えていく関係性であってほしいと願っています。"@ja.
<< kg:id_102 prop:effect kg:id_104 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "このことがやる気のスイッチをオンにするきっかけになり、ひいては将来に向けたモチベーションや進路選択の一つとなっていく"@ja.
}
