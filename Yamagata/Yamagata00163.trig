kg:st_2 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_2 prop:content "正式な協議を経て再検討するのが適切"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "正式決定ではなく事務方検討の中で入った案だった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "社会福祉協議会は突然の白紙撤回で経緯が分からず困惑した"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "基本計画に別用途を入れると社会福祉協議会の選択肢がなくなる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_3 rdfs:label "時田町長"@ja.
kg:st_3 rdf:type cls:st_2.
kg:op_6 prop:content "新年度から地域行事やスポーツ活動で活用できるよう整備する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "地域防災の拠点としても活用する考え"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "稲川と西遊佐の教室を統合して新たに開設する予定"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "新年度に食品加工所等としての活用を検討する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "ビジネス創出事業として活用可能か検討する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "国の方針と法に基づき町も協議に参画している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "町は法に基づく協力義務がありノーと言う立場にない"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "地域振興策や町づくりの施策展開に期待している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "町民の大きい声も小さい声もすくい上げるべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "町民の不安の声を払拭する必要がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "留意事項を明記し事業者公募指針にもつなげる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "地域要望や調査実施を意見取りまとめに記載する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "第1回法定協議会から一貫してリスク最小化を求めている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "事業者決定後に協定を結び不安払拭に対応する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:st_4 rdfs:label "本間知広議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_20 prop:content "サイト追加で寄附金が飛躍的に増えた"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "寄附金増加には魅力ある返礼品が重要"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "ブランド推進事業と連携し新規返礼品の掘り起こしを進めた"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "税収に匹敵する規模で非常にありがたい財源"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "遊佐ならではの魅力的な返礼品の開発を強化する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "新しいポータルサイトの導入は寄附額を伸ばす要因になる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "自然動態で死亡超過が続いている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "社会動態で転出超過が人口減少要因"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "少子化による出生減少が大きな要因"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "若者や子育て世代の流出が課題"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "働く場不足や創業環境の問題がある"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "住宅確保も人口減少対策の重要課題"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:st_5 rdfs:label "赤塚英一議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_32 prop:content "このままでは早々に限界自治体になるおそれがある"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "高齢化の進行で町の維持が困難になる懸念がある"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:op_34 prop:content "伝統文化自然の継承が難しくなる"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_5.
kg:op_35 prop:content "第3次定住促進計画で若者定住を課題に据えている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "総合的な対策として雇用や創業環境の充実が必要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "移住定住施策を継続して強化する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "関係人口の創出拡大も課題として取り組む"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:st_6 rdfs:label "舘内産業課長"@ja.
kg:st_6 rdf:type cls:st_2.
kg:op_39 prop:content "地元回帰につながる創業就労支援や情報発信を総合的に行う"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_6.
kg:op_40 prop:content "若者が町で働くための拠点整備を図る"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "企業立地の条件整備向上を踏まえ誘致を進める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:op_42 prop:content "新たな事業や出店を支援し働く場の確保につなげる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_6.
kg:op_43 prop:content "完全決着ではなく今後も備えが必要"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "裁判が一段落しても残された課題がある"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "フォーラムで将来を見据えた提言を受けた"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "フォーラム提言を踏まえ条例等の見直しを進める"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:st_7 rdfs:label "渡会企画課長"@ja.
kg:st_7 rdf:type cls:st_2.
kg:op_47 prop:content "湧水量や水質のモニタリングを継続する必要がある"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_7.
kg:op_48 prop:content "町民向けの報告解説の機会を設けたい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_7.
kg:op_49 prop:content "経年変化把握のためモニタリング継続が必要"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_7.
kg:op_50 prop:content "水質把握のため周辺湧水調査を続ける"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_7.
kg:op_51 prop:content "専門家の助言を得て雨水調査に対応したい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "町民共有の財産として将来にわたり保全するため指定したい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_7.
kg:op_53 prop:content "利用者増に伴い歳出も増えていく"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "配食サービスは物価高の影響を受け委託料単価引上げ要望がある"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "物価高騰を踏まえ予算を増額した"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "関係機関を通じて対象者への周知を進める"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:op_57 prop:content "コロナ感染拡大が活動減少の大きな要因"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_3.
kg:op_58 prop:content "週1回以上の体操で筋力低下防止につながる"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_3.
kg:op_59 prop:content "人と一緒に続けることで認知症やひきこもり予防になる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_3.
kg:op_60 prop:content "参加者が飽きずに活動できるよう継続支援する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_3.
kg:op_61 prop:content "体操以外も組み合わせ継続参加を促す"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:op_62 prop:content "オンライン資格確認導入医療機関では診療費に影響がある"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_3.
kg:st_8 rdfs:label "池田健康福祉課長"@ja.
kg:st_8 rdf:type cls:st_2.
kg:op_63 prop:content "資格確認書がないと受診時に不利益が生じる可能性がある"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_8.
kg:op_64 prop:content "マイナンバーカードを持たない人には資格確認書で対応する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "新遊佐小学校がスタートするわけでありますが、それに伴い、空き校舎の利活用というものが当然ついてまいります。今まで学校の統合の際に、やはり空き校舎の問題、これはどこの自治体も苦慮しているのが実態であります。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "会としては、正式な議論は今までやったことがないと。それは、当然評議員会、理事会で議論してから次に進めるべきではないですか"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "事務方の検討の中でその計画の中に入れ込んだという経過がございました。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "社会福祉協議会サイドでは、藤崎小学校跡地に移転することで計画もずっと進んでおりまして、突如の白紙撤回ということでありました。社会福祉協議会でもそれに至った経緯がよく分からない"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "藤崎小学校に移るという計画であれば、空き校舎の利活用の基本計画の中にそれを入れてしまえば社会福祉協議会の選択肢がなくなるということです。"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "体育館とグラウンド、社会体育施設としてまた地域行事やスポーツ活動で引き続き活用できるように、新年度に向けて町の条例変更等も含めた管理体制の整備を図ってまいりたい"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "非常災害時には、地域防災の拠点として避難所開設等にも利用できるようにしていきたい"@ja.
<< kg:id_7 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "稲川と西遊佐の各まちづくりセンターで実施している放課後子ども教室を統合して、新たに藤崎小学校に開設する予定"@ja.
<< kg:id_7 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "新年度に調理室などの食品加工所等での活用の検討を進める"@ja.
<< kg:id_7 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "ビジネス創出事業として貸しオフィス、シェアオフィス等での活用が可能なのか"@ja.
<< kg:id_7 prop:countermeasure kg:id_13 >>
    prop:text-txt_contents "２階部分については町の旧文書保存庫としての活用も見込まれております"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "遊佐町沖洋上風力発電事業は、国が主導する一大プロジェクトであり、今さら申すまでもなく、再エネ海域利用法に基づき協議、手続が進められております。"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "関連地方公共団体は国に協力して施策を推進するように努めなければならない"@ja.
<< kg:id_14 prop:effect kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "今後の本町の活性化、持続可能な町づくりの構築などにつながる施策の展開に向けて大いに期待をされているものと考えます。"@ja.
<< kg:id_14 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "町民の様々な不安の声を払拭するために、発電事業者と協定を結び、国、県を含めた万全の対応を取っていかなければならない"@ja.
<< kg:id_14 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "促進区域の指定のための協議会意見取りまとめの作業中であります。この意見取りまとめには、風車撤去を含めた事業完了までの期間、発電事業者が責任を持って取り組んでいくための留意事項を明記する"@ja.
<< kg:id_14 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "具体的には、地域としての要望や将来の展望、漁業影響調査の実施、風車建設における様々な配慮事項などが明記されることとなり"@ja.
<< kg:id_14 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "私が第１回法定協議会から一貫して述べさせていただいております経済的、環境的なリスクの最小化についても記載させていただく方向で進めております。"@ja.
<< kg:id_14 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "発電事業者と協定を結び、国、県を含めた万全の対応を取っていかなければならない"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "楽天のサイトを増やしたことで寄附金が飛躍的に増えた年でありました。"@ja.
<< kg:id_23 prop:cause kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "寄附金の増加のためには、まず魅力ある返礼品を取りそろえることが重要と考えます。"@ja.
<< kg:id_23 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "令和２年度からふるさと納税の受付業務が産業課となり、特産品開発を担う担当課での取組となったことで、遊佐ブランド推進事業と連携しながら新規返礼品の掘り起こしと認定を進めてきました。"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "４年度につきましては、返礼品などの経費を除いた４億5,000万円が予算に充当されております。いわゆる税収ですか、これが13億円でありますので、寄附で４億5,000万円、本当にこれは大きいですし、本当にありがたい話であります。"@ja.
<< kg:id_27 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "今後も、遊佐ブランドをさらに推進し、遊佐ならではの魅力的な返礼品の開発を強化していきたいと考えております。"@ja.
<< kg:id_27 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "新たなふるさと納税のポータルサイトとして、モンベルフレンドエリアに加入いたしました。ワンストップ申請のオンライン申請や新しいポータルサイトの導入は、今後寄附額を伸ばす要因となる"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "自然動態では死亡者数が出生者数を上回り"@ja.
<< kg:id_31 prop:cause kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "社会動態では転出者が転入者を上回っている"@ja.
<< kg:id_31 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "この要因は少子化による出生児数の減少"@ja.
<< kg:id_31 prop:cause kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "進学や就職、結婚、子育て、住宅購入などをきっかけとした若者、子育て世代の町外への流出"@ja.
<< kg:id_31 prop:cause kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "離農や働く場不足などの就労、創業の問題"@ja.
<< kg:id_31 prop:cause kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "定住のための住宅確保の問題"@ja.
<< kg:id_31 prop:effect kg:id_38 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "現在の人口推移だけを見れば、早々に限界自治体になってしまう可能性も考えなくてはならないでしょう。"@ja.
<< kg:id_31 prop:effect kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "このままではいずれ町を維持していくのも困難になるという可能性も出てきます。"@ja.
<< kg:id_31 prop:effect kg:id_40 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "これまで先人が守ってきた伝統や文化、自然を将来にわたり維持し、未来につなげていくことが困難になるのではないでしょうか。"@ja.
<< kg:id_31 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "若者の定住促進、雇用の安定と就労、創業環境の充実、Ｕターン、移住希望者の定住促進、関係人口の創出、拡大の４つを取り組むべき課題として捉え"@ja.
<< kg:id_31 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "雇用の安定と就労、創業環境の充実"@ja.
<< kg:id_31 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "Ｕターン、移住希望者の定住促進"@ja.
<< kg:id_31 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "関係人口の創出、拡大"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "若者を中心としたビジネス創出事業を計画に上げさせていただいております。これにつきましては、若者に対して地元回帰につながる創業、就労支援、地元企業や仕事を学ぶ機会の創出、オンラインでの町内企業情報の発信、ビジネス講座による起業化支援などを行って"@ja.
<< kg:id_45 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "サテライトオフィス、コワーキング、貸しオフィス等などのビジネス拠点の創出を図りながら、若者が町で働くための総合的な取組を行う予定"@ja.
<< kg:id_45 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "工業専用地域等への企業立地の積極的な推進も併せて継続する重要な課題である"@ja.
<< kg:id_45 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "創業等支援補助金については、活用によって新たに遊佐町内で創業した小規模事業者、その中でも遊佐町内において建物を賃借などして小売、飲食業のいずれかを営業する小規模事業者、あと遊佐町外から町内のほうに新規出店した、そういった事業者に対して支援を行う制度"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "新たな採石計画が提出される可能性とか、採石場の災害防止対策や緑化の問題もあり、完全決着には至っておりません。"@ja.
<< kg:id_50 prop:cause kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "採石場の災害防止対策や緑化の問題もあり、完全決着には至っておりません。"@ja.
<< kg:id_50 prop:effect kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "将来にわたって健全な水循環を享受するために、今後の遊佐町に期待することとして貴重な提言をいただきました。"@ja.
<< kg:id_50 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "いただいた提言は、大きく分類すると、町条例や遊佐町水循環保全計画の見直し"@ja.
<< kg:id_50 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "科学的調査の継続、蓄積"@ja.
<< kg:id_50 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "学習機会の創出"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "吉出山の湧水量、こちらを把握するために白井水源の湧水量ですとか横堰の水位、湧水流入量調査、こちらをまず継続して実施をしたい"@ja.
<< kg:id_57 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "湧水の水質を把握するための採石場周辺の湧水調査、今ヘキサダイヤグラム、こういったものは継続して行っていきたい"@ja.
<< kg:id_57 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "雨水調査も必要とのご提言を頂戴しておりますので、専門家の皆様から頻度ですとか調査項目について助言をいただきながら対応していきたい"@ja.
<< kg:id_57 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "町内の水循環を象徴する地下水につきましては、町民共有の財産としまして将来にわたって保全されるように、遊佐町水循環遺産として指定を行っていきたい"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "ホームヘルプサービス以外について利用者が少しずつ増え、歳出も増えていくと考えられます"@ja.
<< kg:id_62 prop:cause kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "特に食の自立支援事業については、材料費の高騰により委託料の単価の値上げを要望されており"@ja.
<< kg:id_65 prop:effect kg:id_66 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "材料費の高騰により委託料の単価の値上げを要望されており、令和５年度予算を増額しております。"@ja.
<< kg:id_65 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "実際に対象となる方と関わることになる包括支援センター、社会福祉協議会、ケアマネジャー、民生児童委員を通して制度の周知を図っている"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "コロナ禍により休止したところが７か所、参加者減による休止７か所、冬期休止が６か所等となっており、コロナ感染症拡大が活動減少の大きな要因となっております。"@ja.
<< kg:id_70 prop:effect kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "週１回以上体操を行うことによって筋力の衰えを少しでも防ぐことができます"@ja.
<< kg:id_70 prop:effect kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "他の人と一緒にいることで続けることができ、また認知症やひきこもりの予防になっていると考えております。"@ja.
<< kg:id_70 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "作業療法士による地域リハビリテーション活動や保健師、栄養士、歯科衛生士による健康教室等を行い、参加者が飽きずに楽しく活動できるよう継続支援を図っております。"@ja.
<< kg:id_70 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "保健師、栄養士、歯科衛生士による健康教室等を行い"@ja.
<< kg:id_75 prop:effect kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "オンライン資格確認を導入、あるいは導入を予定している医療機関で、マイナンバーカードを利用しないで診察を受けた場合は今より診療費が高くなります。"@ja.
<< kg:id_75 prop:effect kg:id_77 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "まずは保険証が自分にはない状態というふうになってしまうということです。"@ja.
<< kg:id_75 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "マイナンバーカードを持っていないとの理由でオンライン資格確認ができない人については、申請により資格確認書を提供することとしております。"@ja.
}
