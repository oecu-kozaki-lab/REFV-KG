kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "短期間でも地域と生活習慣の違いによるトラブルに配慮すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "外国人実習生への理解不足が不信感や地域トラブルにつながり得る"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "ごみ出しや生活習慣など基本的な地域ルールを伝える体制が必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地区運動会など地域行事への参加促進で地域に溶け込みやすくなる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "渡会企画課長"@ja.
kg:st_2 rdfs:type cls:st_95.
cls:st_95 rdfs:label "課長"@ja.
kg:op_7 prop:content "日本語講座などの場が横のつながりや情報交換の機会になる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "属人化した業務はＤＸ推進の弊害になるため改善が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_3 rdfs:label "佐藤総務課長"@ja.
kg:st_3 rdfs:type cls:st_95.
kg:op_9 prop:content "システム管理により誰がどこでも仕事ができる体制をつくりたい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "人事異動があっても業務継続できる体制整備が必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "行政資料や文書を整理し使いやすい状態にすべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "文書のＰＤＦ保存は可能だが既存資料の電子化は今後の検討課題"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "最初の整理段階こそ予算と人員をつけて進めるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "拠点整備だけでなく町内各地に人を誘導する町づくりにつなげたい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "高速道路整備による利便性向上を移住先として選ばれる材料にすべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "新道の駅とのつながりを持たせた住宅確保にも取り組む必要がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:st_4 rdfs:label "時田町長"@ja.
kg:st_4 rdfs:type cls:st_96.
cls:st_96 rdfs:label "町長"@ja.
kg:op_17 prop:content "人口減少に歯止めをかけるには住宅政策の整備が不可欠"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "下水施設の老朽化は生活直結のため特に懸念が大きい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "基金がない現状は事業会計化後の運転資金面で厳しい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "企業会計移行後の資金や基金の在り方は今後検討が必要"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "高齢化の進行で今後交通支援の必要性はさらに高まる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "免許返納が進むほど日常の足の確保が重要になる"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:st_5 rdfs:label "池田健康福祉課長"@ja.
kg:st_5 rdfs:type cls:st_95.
kg:op_23 prop:content "使い切った人への追加交付を12枚から16枚へ拡充する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "地域の共助による買物支援の広がりは心強く町としても応援したい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "制度変更で観光客の持込み走行が想定され安全対策が必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "歩行者にとって周囲を走行する危険性はある"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "安全確保のため看板設置やルール周知を事前に進めるべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:st_6 rdfs:label "阿部満吉委員"@ja.
kg:st_6 rdfs:type cls:st_3.
kg:op_28 prop:content "洋式に慣れた子どもにとって和式トイレが残る状況は改善が必要"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:op_29 prop:content "和式トイレが使えず我慢する子どもが出ないよう配慮すべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_6.
kg:st_7 rdfs:label "菅原教育課長"@ja.
kg:st_7 rdfs:type cls:st_95.
kg:op_30 prop:content "低学年棟から順次洋式化し3か年で整備を進める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_7.
kg:op_31 prop:content "他校からの移動も含め基準を上回る蔵書数を確保する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_7.
kg:op_32 prop:content "町立図書館やPTAとも連携し読書活動の推進に努める"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_7.
kg:op_33 prop:content "統合は子どもに大きなストレスをかけるため人材補強が必要"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:st_8 rdfs:label "土門教育長"@ja.
kg:st_8 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_34 prop:content "SCやSSWや教育支援員を配置し統合後の支援体制を整える"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_8.
kg:op_35 prop:content "未然防止と早期対応のため報告連絡相談体制を機能させる"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_8.
kg:st_9 rdfs:label "太田地域生活課長"@ja.
kg:st_9 rdfs:type cls:st_95.
kg:op_36 prop:content "再生エネルギー導入と省エネの両面から次期計画を作成する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_9.
kg:op_37 prop:content "洋上風力は健康被害や景観悪化や圧迫感への懸念が大きい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_6.
kg:op_38 prop:content "風車規模や離岸距離の見直しも含め計画を再検討すべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_6.
kg:op_39 prop:content "全箇所対応は難しいが従来箇所を継続し新たな要望も検討する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_9.
kg:op_40 prop:content "従来箇所は継続し新たな要望があれば確認して対応を検討する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_9.
kg:st_10 rdfs:label "舘内産業課長"@ja.
kg:st_10 rdfs:type cls:st_95.
kg:op_41 prop:content "創業就業支援や高校生が仕事を学ぶ機会創出を目的に事業を進める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_10.
kg:op_42 prop:content "若者の意見を踏まえた構想づくりが重要で高校生も参加させたい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_10.
kg:op_43 prop:content "安全安心な岩ガキとしてブランド化を進める取組を支援する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_10.
kg:op_44 prop:content "岩ガキがつきやすい環境整備として岩盤清掃を実施している"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_10.
kg:op_45 prop:content "禁漁と休業補償も視野に岩ガキ増殖策を検討すべき"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "補助制度はあるが費用負担が普及の壁になっている"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_9.
kg:op_47 prop:content "引き続き補助制度の周知に努める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_9.
kg:op_48 prop:content "検査結果が悪い施設には区長連絡など個別対応を進める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_9.
kg:op_49 prop:content "個人住宅の太陽光発電やまきストーブ導入を補助している"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_9.
kg:st_11 rdfs:label "斎藤弥志夫委員"@ja.
kg:st_11 rdfs:type cls:st_3.
kg:op_50 prop:content "電気利用の合理化のため蓄電池設置への補助も検討すべき"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_11.
kg:op_51 prop:content "庄内全体では酒田市で被害拡大率が高まっている"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_10.
kg:op_52 prop:content "地上散布や無人ヘリ散布や衛生伐駆除で防除を進める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_10.
kg:op_53 prop:content "専門知識を持つ支援員が各学校を巡回し教員支援や情報共有を行っている"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "全体研修会も活用し先生方の質向上につなげたい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "大学生などが継続的に町の仕事に関われるインターンシップ制度を前向きに検討する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_4.
kg:op_56 prop:content "継続的に遊佐に来てもらえるよう交通費と謝礼の支援を検討したい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:st_12 rdfs:label "髙橋冠治委員"@ja.
kg:st_12 rdfs:type cls:st_3.
kg:op_57 prop:content "費用対効果を踏まえ事業継続の判断時期に来ている"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_12.
kg:st_13 rdfs:label "池田副町長"@ja.
kg:st_13 rdfs:type cls:st_99.
cls:st_99 rdfs:label "副町長"@ja.
kg:op_58 prop:content "飼育委託と卸機能の連携で市場に安定供給する第2ステージに進めたい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_13.
kg:op_59 prop:content "生産費の縮減と付加価値をつけた販売で採算ベースを目指す"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_13.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "ここ３年間でしょうか、令和２年度から中止となっておりますけれども、ハンガリー・ソルノク市の派遣事業、こちらを一応は予定をしておりますが、今年度もまだ先行きが不透明ということもございますので"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "これまでやっぱりコロナ禍ということもあって、ソルノク市とこれまで密に行ってきた交流事業はなかなか滞ったというイメージ持っています"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "そこの地域との生活習慣、今までと違ったところへ来るわけですから、そこでのトラブルであったり、そういうことも考えられると思います"@ja.
<< kg:id_4 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "見たことない方を集落でよく見かけるとなると、やはりなかなかいろんな形で不信感であったりトラブルであったりにつながる可能性もあるかと思います"@ja.
<< kg:id_4 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "例えばごみ出しのやり方だったり、ちょっとした習慣であったり、そういうのをきちんとお伝えできるような状況にしておくだとか"@ja.
<< kg:id_4 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "ぜひ運動会なり、そういう何かしらあったときには積極的に受け入れてくださいという、今だと割と皆さん受け入れてくれますけれども、そういうのを一言言ってあげるだけでも地域に溶け込みやすくなるのかなと思います"@ja.
<< kg:id_4 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "日本語講座を開催しておりますけれども、そちらのほうにも実習生の方が１名参加されているというようなお話も聞いていますので、そういった場面に出ていただくことによって、また横のつながりとか情報交換とか顔見知りの方も増えていくのかな"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "特に属人化と言われる、この人でなければできないだとか、私でなければできないみたいな、そういう業務というのは、このＤＸ化を進める上では非常に弊害になっている部分あります"@ja.
<< kg:id_10 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "システムでその辺を管理することができれば一番かなと"@ja.
<< kg:id_10 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "誰がどこに行っても仕事ができるような状況はつくりたいと思っております"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "いろんな図面であったり、写真であったりはあるのですけれども、整理されていない部分っていっぱいあって、多くが旧菅里中学校に持っていってそのままになっているのではないか"@ja.
<< kg:id_14 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "そういった資料とか文書をデジタル化して保存していけば量も減るし、保存も可能かなということではあります"@ja.
<< kg:id_14 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "やっぱりそこはちゃんと予算と人員つけてやられたほうがいいのかなと思っています"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "拠点づくりだけではなく、それが町づくりにつながるような形で一応いろいろ描いてございますので、その計画を着実に進めていきたい"@ja.
<< kg:id_18 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "利便性が向上することによって遊佐町が移住先として選んでもらえるようになったり、結果的には移住者の増加につながる可能性がある"@ja.
<< kg:id_18 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "パーキングエリアタウン、新道の駅とのつながりを持たせたような形の移住、定住の受皿となるような住宅の確保、そういったことにも一緒に取り組んでいく必要がある"@ja.
<< kg:id_18 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "やっぱり住宅政策をしっかり整えていかないと、人口の減少は歯止めがかからないということがもうはっきりしています"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "やはり下水に関しては非常に建物の老朽化等ありますので、まして生活に直結する部分"@ja.
<< kg:id_23 prop:cause kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "そのときにやっぱり基金がないのが非常に厳しいのかなと思ってお話聞いていたのですけれども"@ja.
<< kg:id_23 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "企業会計に移ったときの当然資金というのも必要になろうかと思いますけれども、そういった運転資金含めて基金をどうしていくかということについては、今後検討していかなければならない"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "高齢化率が非常に高くなってきた当町でございますので、多分今後この部分は非常に額が増えてくる可能性がある"@ja.
<< kg:id_27 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "これから特に高齢者が増えてくる、併せて免許返納になってくると、やはりふだんの足としての部分が厳しくなってくる"@ja.
<< kg:id_27 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "令和５年度につきましてはさらに４枚追加して、追加を16枚としてやっていきたいと考えているところであります"@ja.
<< kg:id_27 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "西遊佐地区で始まったエプロンサービスの買物支援ですか、あれが西遊佐ばかりでなくて、ほかのまち協等でも自主的にやっていただけるという流れができていること大変心強く思っています"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "今年の７月からですか、電動キックスケート、キックスケーターですか、これが免許なしで乗れるという話聞きました"@ja.
<< kg:id_32 prop:effect kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "歩行者等についてはそういったものが周りを走るという危険性はあろうかと思います"@ja.
<< kg:id_32 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "きちんとした形で安全のための例えば看板であったり、告知方法であったり、そういうのをしっかりしていかないとなかなか大変なのかなと思います"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "まだ和式トイレが残っていたというのは私も認識不足でございました"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "和式トイレなんかだと使えなくて、うちまで我慢するというようなことも"@ja.
<< kg:id_36 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "低学年棟の男女トイレを洋式化にする改修工事を行う予定でございます。来年度は中学年棟ということで、３か年計画の中での計画的な実施"@ja.
<< kg:id_40 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "今年度内で他の小学校からも一定数、約1,600冊ほどでございますけれども、学校相互に検索をかけて、図書分類や発達段階に応じた精選した内容の図書を移動して蔵書に加える予定"@ja.
<< kg:id_40 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "今後も、町立図書館、あるいは先ほど夜のお月見読書会ですか、ＰＴＡなどとも連携を取りながら、読書活動の推進に努めてまいりたい"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "いわゆる統合というのはかなり子供たちにはストレスがかかってくるのだろうというふうに思います"@ja.
<< kg:id_43 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "ＳＣというスクールカウンセラーという資格を持った臨床心理士がいたり、またはスクールソーシャルワーカーということで相談員がいたり、そして各校には２ないし３名の教育支援員"@ja.
<< kg:id_43 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "また、報連相という報告、連絡、相談ということも、その体制も機能させながら"@ja.
<< kg:id_47 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "再生エネルギーの導入と省エネ、いわゆる家庭、事業所なり省エネの推進というものを並行して進めながら、カーボンニュートラルを達成するために町としてどう取り組んでいくかという、どう向き合っていくかという計画をつくる"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "あまりにも岸から近い洋上風力の建設になりますので、その辺で健康被害が心配であるとか、やはり一番は景観と圧迫感もあるし、何せ300メーター以上のものが立つということはかなり脅威"@ja.
<< kg:id_49 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "風力発電の風車の小型化であるとか、あと海岸からの離岸距離を大きく取っていただくとか"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "おっしゃるとおり全箇所、いわゆる河川敷の全箇所というふうにはならないというふうには思っております"@ja.
<< kg:id_52 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "引き続きこれまでと同様の箇所については行いますし、今後新たな要望等あれば確認をして、対応できるかどうかは検討させていただきたい"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "こちらは若者の地元回帰につながる創業、就業支援や、高校生等が仕事を学ぶ、そういった機会の創出を主な目的としております"@ja.
<< kg:id_55 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "まずは事業構想会議を開催して、メンバーの中に商工会等の関係機関をはじめ、町内外の若手事業者から参加してもらいたい"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "吹浦産岩ガキにオゾンマイクロナノバブル方式による殺菌を加えて、安全、安心な岩ガキとしてブランド化を目指し、その販売のＰＲに努める"@ja.
<< kg:id_58 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "協議会のほうで岩ガキがつきやすい環境整備を行うために、年に数回、岩盤清掃も実施しております"@ja.
<< kg:id_58 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "禁漁した場合の休業補償ということも頭に入れた岩ガキ増殖ということも考えてほしい"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "なかなか補助金があるといっても経費がかかるということはありますので"@ja.
<< kg:id_62 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "引き続き周知に努めたいと思っております"@ja.
<< kg:id_62 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "そういう検査結果に基づいて、非常によろしくないような結果のところは個別に対応したりという対応をしております"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "個人の方が太陽光設備ですとか木質バイオマス燃焼機器、そのようなものを導入されるときに補助をするという制度"@ja.
<< kg:id_66 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "これからはバッテリーを設置する人にもぜひ補助金をつけていただけないかと思います"@ja.
<< kg:id_69 prop:effect kg:id_70 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "今年度については若干松枯れの状況が、遊佐ではないのですけれども、酒田のほうで、庄内というくくりの中で見れば酒田市のほうで結構被害が、拡大率が高まっている"@ja.
<< kg:id_69 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "病害虫の防除事業においては、ノズル、スパウダーによる地上散布とラジコンヘリによる無人ヘリ散布というふうに分かれるわけですが"@ja.
<< kg:id_72 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "１人の支援員のほうが年間通じて先ほど申し上げました約240日くらい各学校を回って、年間で行く日というのは計画されておりまして、巡回をしながらその対応だったり、情報共有などをしてもらっている"@ja.
<< kg:id_72 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "毎年度職員全体研修会ということで学習センターのホールなどで行っておりますけれども、そういった中でもＩＣＴ活用に係る研修なども今年度行っておった"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "大学生のうちでも仕事の活動に参画できるような制度としてインターシップ制度をとという提言がありましたし"@ja.
<< kg:id_75 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "月１回遊佐に来ていただいて、６か月でもいいですよね。そんな形で来ていただいたときの交通費と謝礼をやっぱり払えるようなことになれば"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "かなりの赤字といえば赤字。このアワビの養殖事業、これは町長肝煎りでやったわけであります"@ja.
<< kg:id_78 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "来年度は、アウトソーシング委託料という形で、専門の事業者に飼育の委託をする形で、そしてこれまた株式会社のほうで卸の機能を担う形で連携して、市場に安定的に物を回していきたい"@ja.
<< kg:id_78 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "生産費の縮減と付加価値をつけた販売、売値の改めての市場調査と研究を重ねながら進めていきたい"@ja.
}
