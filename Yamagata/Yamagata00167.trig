kg:st_1 rdfs:label "齋藤武委員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "議会あるいは町として的確な事業対応が必要と考える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "品質悪化の全体像を見極める必要があるとみている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "町として的確な事業対応が必要と考える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "品質低下を踏まえた支援策が必要と求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "渡会企画課長"@ja.
kg:st_2 rdfs:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_5 prop:content "業務内容を正確に伝える募集が重要と考える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "思ったとおり採用まで至らない部分もあると説明する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "実際の活動と募集内容のずれを防ぐ募集を心がけている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "外からの目や若い感覚を取り入れる必要があると考える"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "若い発想やＳＮＳ活用を情報発信に生かしている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:st_3 rdfs:label "池田総務課長"@ja.
kg:st_3 rdfs:type cls:st_32.
kg:op_10 prop:content "段階的に規模縮小から再開してきたと説明する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "高齢者中心の小さな行事ではやめたものもあると認識している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "小さな行事ではなくなっているものもあるとみている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "コロナ前に少しずつ戻す形で進めている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "より多く受験してもらうため条件を外したと説明する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "業務に支障のないよう採用していきたい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "職員体制を整えていく必要がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "多くの人から受験してもらい職員になってもらいたい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:st_4 rdfs:label "菅原和幸委員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_18 prop:content "担ってきた役割を新たな形で引き継ぐ必要があると考える"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "婦人会の役割の継承策を考えるべきと述べる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:st_5 rdfs:label "監査委員会"@ja.
kg:st_5 rdfs:type cls:st_44.
cls:st_44 rdfs:label "監査機関"@ja.
kg:op_20 prop:content "計画的に修繕整備を検討すべきと指摘する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:st_6 rdfs:label "鳥海教育課長"@ja.
kg:st_6 rdfs:type cls:st_32.
kg:op_21 prop:content "緊急度を考慮しながら修繕に努める考えを示す"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:op_22 prop:content "計画的修繕の方針だが緊急度を見て対応する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:st_7 rdfs:label "学校の保護者"@ja.
kg:st_7 rdfs:type cls:st_69.
cls:st_69 rdfs:label "保護者"@ja.
kg:op_23 prop:content "家計的に非常にありがたいので補助継続を望む"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_7.
kg:op_24 prop:content "補助継続を望む"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_7.
kg:op_25 prop:content "施設外業務ができない状況を解消するための見直しと説明する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "人件費や委託料上昇が増額要因と説明する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:st_8 rdfs:label "太田地域生活課長"@ja.
kg:st_8 rdfs:type cls:st_32.
kg:op_27 prop:content "実績に基づく補助ではなく配分によると説明する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_8.
kg:op_28 prop:content "通学路を優先してライン表示をしている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_8.
kg:op_29 prop:content "補正で繰出金を追加したと説明する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_8.
kg:op_30 prop:content "一般会計からの繰出しは既に５億円を超えていると説明する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_8.
kg:op_31 prop:content "運転資金も必要となり繰出金増が見込まれる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_8.
kg:op_32 prop:content "再エネ拡大を主に記載した計画見直しを行った"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_8.
kg:op_33 prop:content "町も国に準じて取り組んでいく考えを示す"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_8.
kg:op_34 prop:content "現況調査を踏まえ計画策定を進めている"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_8.
kg:op_35 prop:content "先行地域から情報を得て勉強したいと考えている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_8.
kg:op_36 prop:content "先行地域からいろんな情報を聞いて勉強したい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_8.
kg:op_37 prop:content "住民の疑問に答え不安払拭に向けて説明を続ける"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_8.
kg:st_9 rdfs:label "舘内産業課長"@ja.
kg:st_9 rdfs:type cls:st_32.
kg:op_38 prop:content "担い手の経営悪化が懸念されるため支援した"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_9.
kg:op_39 prop:content "103経営体に支援を交付した"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_9.
kg:st_10 rdfs:label "時田町長"@ja.
kg:st_10 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_40 prop:content "交流をもう一度つくり直す時期に来ていると考える"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_10.
kg:op_41 prop:content "ショッピングセンター的な場所を活用した子供たちの居場所づくりが必要と考える"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_10.
kg:op_42 prop:content "若い人が気軽に集える場所を準備すべきと考える"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_10.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "私のところのササニシキという品種、刈ったのがあるものですから、今朝ちょっと試験的にむいてみました。非常に品質が心配だったのですけれども、一部しか見ていないので断言はできないのですけれども、やはり高温障害を受けています。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "具体的に言うとちょっと専門用語になるのですけれども、基部未熟という根っこに近いほうの部分にやっぱり白い部分があって、十分でん粉が詰まっていない状況でした。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "ですので、少なくとも１等は無理だなというふうに覚悟をしているところであります。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "もちろんこれから稲刈り進みますので、全体像見えてくると思うのですけれども、それについては議会あるいは町としても的確な事業の対応が必要かなと思っているところであります。"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "募集をかければすぐ来るというものではないのですけれども、やっぱり全国的にいろいろな取組をされていますので、協力隊を志す方もいろいろな情報を全国から集めて、自分にとってより適したミッションを提示したところ、条件のいいところということで、情報等を集めながらの応募のようであります"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "応募はいただきましたけれども、面接の時点でちょっと採用まで至らなかったとか、そういった場面もございました。"@ja.
<< kg:id_6 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "遊佐町で考える協力隊にお願いしたい課題、そういったものをきちんとお伝えをする、業務の内容を正確にお伝えをして、実際活動してみたらちょっと話が違うのではないのといった形を取らないように募集はしていきたいなというふうに心がけているところです。"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "どうしても情報発信の部分でなかなか皆さんにうまく伝わらないといいましょうか、発信の部分が弱いというご指摘をいただいておりましたので"@ja.
<< kg:id_10 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "やはりそこに地域おこし協力隊、外からの目といいましょうか、若い視点、若い発想、若い感覚、あとは今ＳＮＳ等も若い方は使いこなしているといったこともありますので、そういったものを使っての情報発信などを担っていただく"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "コロナ禍ということで過去何年か行事というものはまずほとんどしなくなったというのがあります。"@ja.
<< kg:id_13 prop:cause kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "やっぱり高齢でなかなかできないといったことでやめた行事も多分あるかとは思います。"@ja.
<< kg:id_13 prop:effect kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "やめた行事も多分あるかとは思います。"@ja.
<< kg:id_13 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "規模を縮小して行事を始めると。当然呼ぶ人、参加する人を限定させて行事をやってきたという流れがありまして、昨年度あたりはそれがかなり少し緩くなって、少し人数を増やそうとかといった感じで行事を進めてきたところであります。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "昨年度につきましては、合格ということでした人から辞退ということもありまして、なかなか採用が少なくなってしまった"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "本町は、類似団体、類似団体というのは同じ規模の市町村です。と比較し、一般行政部門でマイナス16％、普通会計全体でマイナス8.5％ほど職員数が不足している状況にある。"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "必要な行政サービスの提供が滞ることのないよう、定員管理計画の中で職員体制を整えていくことが必要である"@ja.
<< kg:id_18 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "多くの方からまず受験していただいて、職員になっていただきたいということで、今年度から条件を外して、より多くの人から受けてもらうようにしたところであります。"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "実は婦人会の組織がいずれ解散するという情報もあります。"@ja.
<< kg:id_23 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "今後やはりその辺の婦人会の皆様が担ってきたものを新たな形でやっぱり求めていくべきなのかなと思いまして"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "社会教育施設の修繕整備について、建築から数十年なっていることから、計画的に修繕を検討されたい"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "経年劣化による、突発的な修繕が毎年発生している状況にございます。"@ja.
<< kg:id_26 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "計画的に修繕等をしていく方針ですが、経年劣化による、突発的な修繕が毎年発生している状況にございます。このような状況ですが、緊急の度合いを考慮しながら修繕等に努めていきたい"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "学校のほうを通じて家計的に家計の上で非常にありがたいと、あとこれをもっと、この補助をもっと継続してもらえないのかといった声は寄せられております。"@ja.
<< kg:id_30 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "学校のほうを通じて家計的に家計の上で非常にありがたいと、あとこれをもっと、この補助をもっと継続してもらえないのかといった声は寄せられております。"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "施設外の業務ができないことなどを解消するためにパートの職員を常勤雇用にしました。"@ja.
<< kg:id_33 prop:cause kg:id_35 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "最低賃金改定等によって施設管理業務等の委託料について33万円の増額"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "この事業費ですが、実績に基づいているものではありませんで、国のほうからいわゆる配分というような形で、国から県を通して来る補助金でありますが、あくまで配分となりますので、こちらでこの実績額に基づいたものではない"@ja.
<< kg:id_38 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "基本的にはセンターライン、また外側線、路肩のほうにラインを描くということであります。基本的に通学路を優先として、そういう表示をしている"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "昨年につきましては当初４億4,000万円でありましたが、修繕が非常に多く発生しまして、９月補正において4,000万円を追加いただきましての４億8,000万円ということでありました。"@ja.
<< kg:id_40 prop:effect kg:id_42 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "地域集落排水事業のほうにも一般会計の繰出金いただいております。...そちらが6,800万円決算にのっておりますが、ございますので、既に５億円は超えているというような状況にはなっております。"@ja.
<< kg:id_40 prop:effect kg:id_43 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "公営企業会計に移るということで、来年度以降、...現在のような繰出金にいわゆる起債償還費に充てるようなこういう金額に加えまして運転資金というものも必要になってきます。ということを考えますと、現在の合計額の繰出金よりもさらに多くの繰出金をいただくようなことになるかと考えているところであります。"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "今後再生可能エネルギー、いろんなところ、太陽光をはじめいろんなものが、これまでもこの５年間で進んできましたし、これからもいろいろ進んでいくというところ、そういうところを主に記載をしながらの計画づくりとなっております。"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "国が進めます2050年までに温室効果ガスの排出量を正味ゼロにするという国の目標、それを町におきましても国に当然準じまして、町のほうでもそれに向けてこれから取り組んでいく"@ja.
<< kg:id_46 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "ゼロカーボンの現況調査というのも行っておりました。それを踏まえて、大きな環境基本計画、町の環境全体を網羅する計画を策定して、今年度実施しておりますエネルギー基本計画につなげている"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "洋上風力に関わるいろんな市町村間、悩みがやっぱり多いということでの情報交換ですとか、国においてもまだ始まったばかりの事業でありますので、いろんな課題、問題点を国にも申し述べていくというような意味合いで組織がつくられた"@ja.
<< kg:id_49 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "遊佐町においては、いろいろこれから遊佐町沖で進められている状況ございますので、先行地域からいろんな情報をやはり聞いて勉強していきたいというところで、入会をさせてもらったところであります。"@ja.
<< kg:id_49 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "いろいろ町民の皆さんに説明をいろいろしていかなければならないというふうに思っております。出前講座、今年度から生涯学習出前講座のほうにもメニューにも載せておりますし、...そういうところに出向いて、現状ですとか、今後のスケジュールですとか、あとは住民の皆さんがいろいろ思っていることなんかも聞き取りもしながら進めていきたい"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "コロナ禍による農産物の価格低迷など、そういった農業の担い手である認定農業者等の経営悪化が懸念される"@ja.
<< kg:id_53 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "担い手支援として、ナラシ対策における積立金に対する助成とさせていただいておりまして、積立金額の３分の１を補助するというような内容でございます。103経営体に対しまして、総額2,487万9,470円を支援として交付させていただいた"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "いわゆる交流がなかなかコロナでできなくなっているということ、本当に私から見ればイケ・サンパーク、池袋にやっぱり遊佐の市を出したり、地域の発信をするとかいろんな形が、友好としての交流もできないという形がずっと続いておりました。"@ja.
<< kg:id_56 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "ああいうショッピングセンター的なところに子供たちの居場所を、そんな歩いては遠くはないですから、どんな形、子供たちがどのような形の居場所を要望しているか、まだ想定はしていませんが、それ必要なのかなと、そのような感じはしています。"@ja.
<< kg:id_56 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "若い人たちが気軽に集える場所、そういう準備をやっぱり整えて、若い人たちの力を借りて地域の活性化、活力呼び戻しのためにこれから仕掛けていかないと、検討していかなければ、大きな課題だと思っております。"@ja.
}
