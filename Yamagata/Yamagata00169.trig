kg:st_1 rdfs:label "時田町長"@ja.
kg:st_1 rdfs:type cls:st_60.
cls:st_60 rdfs:label "自治体職員"@ja.
kg:op_1 prop:content "ビジネスホテルとして比較する施設ではない"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "池田副町長"@ja.
kg:st_2 rdfs:type cls:st_60.
kg:op_2 prop:content "国の補助を受けた町民施設であり設置目的上の制約がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "客室に浴室がないことによる問題は現状生じていない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "現場感覚では全く問題ない"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "大浴場や温泉動線の利便性が宿泊客に評価されている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "韓国人客を含め大浴場ニーズに十分応えている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "斎藤弥志夫議員"@ja.
kg:st_3 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_7 prop:content "浴室やシャワーがないと現代のホテル需要に合わない"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "浴室整備で快適性向上は確実だと考える"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "外国人観光客増加に対応するには洋室の浴室やシャワー整備が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "全室に浴室または少なくともシャワーを早急に設置すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "お客様ニーズを捉え必要に応じて検討したい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "浴室が無理でも安価なシャワー室の設置を検討すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "壁構造や客室の狭さから現時点では不適切と判断した"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "顧客ニーズの変化を踏まえて必要なら見直す"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "将来的なモデルチェンジの必要性は理解している"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "構造上シャワー設置は苦情の元になり得る"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "設置によるデメリットも考慮して見送った"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_4 rdfs:label "渡会企画課長"@ja.
kg:st_4 rdfs:type cls:st_60.
kg:op_18 prop:content "限られた予算では安全性優先となり浴室整備の優先度は低い"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "まずは利用客の安全と快適性を優先すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:st_5 rdfs:label "本間知広議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_20 prop:content "子供の数の減少が学校存続に直結する危機感がある"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:op_21 prop:content "高校がなくなると若者減少がさらに進む"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "入学者増加と関係人口創出につながっている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "進学や保護者とのつながりを通じて定住や関係人口創出に効果がある"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "県外生の保護者との関係も地域とのつながりを生んでいる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "地域でしかできない学びを提供することが魅力化の核になる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "小中学生にとって遊佐高生が憧れとなる取組が必要"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "外部人材が地域資源を生かした教育プログラムを担っている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "定住には仕事の確保が不可欠"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:st_6 rdfs:label "舘内産業課長"@ja.
kg:st_6 rdfs:type cls:st_60.
kg:op_29 prop:content "高校生の就労体験と地元就職起業を結びつける上で連携は重要"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_6.
kg:st_7 rdfs:label "佐藤俊太郎議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_30 prop:content "人口構造の変化で団員確保が厳しくなっている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_7.
kg:op_31 prop:content "全国的課題であり町でも欠員が深刻化している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "訓練や装備の充実支援で処遇改善を図る"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "報酬支払いの明確化を進めている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "アンケート結果を踏まえ団員負担軽減を図った"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "処遇改善検討委員会で制度見直しを進める"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:st_8 rdfs:label "池田総務課長"@ja.
kg:st_8 rdfs:type cls:st_60.
kg:op_36 prop:content "団活動を知ってもらうことが入団促進に重要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_8.
kg:op_37 prop:content "18歳から20歳の団員がいないなど若年層不足が深刻"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_7.
kg:op_38 prop:content "少年消防クラブ活動と併せて将来の担い手育成につなげたい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:st_9 rdfs:label "鳥海教育課長"@ja.
kg:st_9 rdfs:type cls:st_60.
kg:op_39 prop:content "子どもたちに消防の知識や体験を深めてもらいたい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_9.
kg:st_10 rdfs:label "齋藤武議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_40 prop:content "高温で最終的な品質と収量が読めず不安が大きい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_10.
kg:op_41 prop:content "例年になく猛暑で積算温度も高く早期刈取りが望まれている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "農業全体で資材高騰が経営を圧迫している"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_10.
kg:st_11 rdfs:label "農業委員会会長佐藤充"@ja.
kg:st_11 rdfs:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_43 prop:content "肥料や燃料高騰で農家は大変厳しい状況にある"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_11.
kg:op_44 prop:content "後継者不足で農業の危機が加速度的に進んでいる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_10.
kg:op_45 prop:content "高齢化と後継者不足で農業を取り巻く状況は厳しい"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "10ヘクタールなら100万円にもなり経営負担が重い"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_10.
kg:op_47 prop:content "小作料引下げは有効な農家負担軽減策である"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_10.
kg:op_48 prop:content "来年度に向け下げる方向で農政部会と総会で検討したい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_11.
kg:op_49 prop:content "離農農地対策として地域で将来像を共有し集積を進める必要がある"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "国の施策として進む中で町も協力していく必要がある"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:st_12 rdfs:label "駒井江美子議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_51 prop:content "住民の最大の不安は超低周波音を含む騒音による健康被害である"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_12.
kg:op_52 prop:content "大規模な洋上風車で健康被害が増える懸念がある"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_12.
kg:op_53 prop:content "健康被害などが予測できる場合は予防的対策を講じる考えだ"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "事前調査や体制整備でリスク最小化を図るべきだ"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:st_13 rdfs:label "太田地域生活課長"@ja.
kg:st_13 rdfs:type cls:st_60.
kg:op_55 prop:content "選定事業者決定後に協定や窓口組織づくりを想定している"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_13.
kg:op_56 prop:content "県に協定の立会人となってもらうことを求めている"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "将来的に心配したが何事もなかったと思えるよう関わる"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "町としてアンケートや健康調査を行う予定は今のところない"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_13.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "遊楽里は、単に宿泊のみに利用を目的として建設された施設ではなく、宿泊研修施設として、加えて温泉を利活用できる温泉宿泊施設として建設された"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "客室に浴室がないことによる苦情は今まで寄せられておりません、お客様からは"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "逆に大浴場の温泉が利用できること、これについては専用の通路、雨降っても雪降ってもあぽん西浜まで行けるように改めたこともありまして...それら等についても評価としては大変いい評価をいただいている"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "浴室の設置が容易でないならせめてシャワー室を設置しないと時代遅れの経営になりそうです"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "改造した洋間８部屋に全部浴室を設ければ、イメージが大分変わってビジネスホテルらしくなると思います。お客さんにようやくビジネスホテルとして売り込むことができるし、お客さんの快適性が向上するのも確実です"@ja.
<< kg:id_3 prop:effect kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "最近インバウンド、外国人観光客の訪日がかなり増えている...外国人が増えるほど洋風化が進み、ホテルの洋間に浴室やシャワー室があるのは常識になります"@ja.
<< kg:id_9 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "早急に私は全室に浴室または少なくともシャワーを設置していただきたいと思います"@ja.
<< kg:id_9 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "浴室の設置が容易でないならせめてシャワー室を設置しないと時代遅れの経営になりそうです"@ja.
<< kg:id_9 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "お客様のニーズは常に変化していくものと考えておりますので、今後もお客様ニーズをしっかりと捉えながら、必要に応じて検討していきたい"@ja.
<< kg:id_9 prop:cause kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "和室の部屋って壁構造が薄いのです。ですから、浴室だとか、特にシャワーなんか、これ恐らくお客様にとってはシャワー室を設けたら今の壁構造では苦情の元になっていくと認識しております"@ja.
<< kg:id_9 prop:cause kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "浴室なりシャワー室を設けることによって客室が手狭になっていくというデメリットもあったりして"@ja.
<< kg:id_9 prop:cause kg:id_15 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "経年劣化によりまして、想定外で対応しなければならない事案がかなり続いております"@ja.
<< kg:id_9 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "やはり遊楽里をご利用いただくお客様から安全に快適に過ごしていただくと、そういったところを第一優先として施設、設備の維持補修、そういったものに努めております"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "やはりどこの国も今の日本のような状況になるかもしれないという危機感を持ちながら...それほど子供の数が日本では減っているのだということであります"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "もしこれ地元に高校がなくなれば、高校進学ということで地域を離れていく生徒、子供が多くなって、それによってますます地元に残る若者が減少するということが考えられます"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "入学者の増加を図ることを目的に、令和元年より山形県外から遊佐高へ入学する県外留学生の募集を開始し、令和２年度より受入れを始めております"@ja.
<< kg:id_20 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "卒業した県外留学生の中から東北公益文科大学への進学者を輩出するなど、若年層の移住、定住の契機となる"@ja.
<< kg:id_20 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "県外生の保護者から何回もふるさと納税をしていただくなど、県外生を媒介としながら新たな関係人口の創出にもつながってきております"@ja.
<< kg:id_20 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "遊佐高校においてもきちんと高校教育と地域資源を接続した特色ある学校環境づくりを行っていただいて、中学校に向けたＰＲを行っていく"@ja.
<< kg:id_20 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "今年度初めての取組としまして、小中高校が連携して西浜の海浜清掃を実施したところであります。後輩である小中学生にとって遊佐高生が憧れの存在になるような取組が必要"@ja.
<< kg:id_20 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "この教育コーディネーターの業務内容としましては、特色ある教育の実現を目指しまして高校の教員と協働した学校カリキュラムづくり、地域のキーマンとなる方、地元企業と連携した地域資源を生かした教育プログラムの考案などを担っている"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "働き場がないとやはり定住は難しいなというふうに率直に思っております"@ja.
<< kg:id_27 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "若者を中心としたビジネス創出事業を進めていく上でも遊佐高校魅力化事業との連携は非常に重要であると産業課サイドも認識しておるところでございます"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "当町においても、少子高齢化、人口減少化とともに、団員数が減り続いている状況にあります"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "令和５年４月１日現在で544名...消防団の条例上の定員は600名となっておりますし、令和４年度から13名の減少、定員から見れば76名の欠員が生じている状態"@ja.
<< kg:id_30 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "令和４年度より各分団の訓練や装備品の購入等に要する費用を支援することを目的に、遊佐町消防団運営交付金制度を新たに創設し"@ja.
<< kg:id_30 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "団員の報酬や出動手当についても団員個人の口座への振込を実施し、報酬支払いの明確化も図っております"@ja.
<< kg:id_30 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "消防団員の大きな負担になっている山形県消防協会庄内支部操法大会を令和４年度から廃止をし、団員の負担軽減を図っております"@ja.
<< kg:id_30 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "火災や災害等の緊急的な出動に対する出動手当の見直しや地域の実情に応じた機能別消防団の制度の導入について検討するため、消防団幹部６名と事務局で構成する処遇改善検討委員会を立ち上げております"@ja.
<< kg:id_30 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "入団促進図るという上では、消防団員の活動をよく知っていただく...その知っていただくためには確かにＳＮＳを活用したりとか広報を利用したりとかという方法が大切"@ja.
<< kg:id_30 prop:cause kg:id_38 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "特に若年層の入団者数の減少が著しいため"@ja.
<< kg:id_30 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "酒田地区広域消防組合消防本部が主催するちびっこ消防祭りや消防フェスティバルの開催等を通じて防火意識や消防団活動の紹介等を行っていきたい"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_40;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "文字どおり記録的な猛暑の中で何とか稲がこうべを垂れてきました。夜温が高く、用水が足りていなかった水田もあり、最終的な状況はもみすりをしてみないと分からないため、品質と収量の面で不安を抱えたままの稲刈りとなります"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_42;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "猛暑にかかわらず農業全体ではウクライナ情勢などを反映し、肥料や燃料、各種資材が高止まりしています"@ja.
<< kg:id_40 prop:cause kg:id_43 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_44;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "後継者は圧倒的に不足し、農業の危機は加速度的に進行しています"@ja.
<< kg:id_40 prop:effect kg:id_44 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "仮に水田10アール当たり１万円だった場合、10ヘクタールでは100万円にもなります。生産調整面積が４割にも上り、農作物の販売価格の上昇が限定的な現状では、この100万円の捻出はかなり大きな負担です"@ja.
<< kg:id_40 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_47;
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "小作料を一定程度引き下げることができれば、有意に農家負担が軽減されます"@ja.
<< kg:id_40 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "今後は離農農地対策として、農地における農業者の自発的な話合いによる地域計画の策定を推進し、農地の有効活用継続や農業経営の効率化をめぐる担い手への農地利用の集積、集約も含めるなど、事業が重要になってくる"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "国はカーボンニュートラル社会の実現のための手段として洋上風力の導入を進めており"@ja.
<< kg:id_47 prop:effect kg:id_49 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "住民は、風力発電による耳に聞こえない超低周波音を含む騒音による睡眠障害や健康被害について強い不安を抱いています"@ja.
<< kg:id_47 prop:effect kg:id_50 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "今計画されている洋上風力発電の規模は、陸上風車とは比べ物にならない大きさです。既存風車との複合的影響による健康被害が増えるのではないかと心配されます"@ja.
<< kg:id_47 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "超低周波による健康被害等、被害が多少なりとも予測できる場合においては、被害が起こらないよう最新の科学的知見に基づき対策をあらかじめ検討しておく"@ja.
<< kg:id_47 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "仮に被害が発生した場合においてもその影響を最小限にするよう対処していきたい"@ja.
<< kg:id_47 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_55;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "町がこれから事業所並びに県にもお話をかけておりますから、選定事業者が決まりましたら事業についての協定を結ぶ...そういうものに対応するための組織づくりをするということを想定しての文言"@ja.
<< kg:id_47 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "引き続き住民の皆様の不安の払拭に努め、将来的に心配はしたもののほとんど何事もなかったよねって思えるような"@ja.
<< kg:id_47 prop:effect kg:id_55 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "町としてそういうアンケート調査をしようというような予定は今のところしておりません"@ja.
}
