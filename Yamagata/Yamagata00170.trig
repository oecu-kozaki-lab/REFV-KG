kg:id_95 rdf:type cls:c_9528.
cls:c_9528 rdfs:label "計画流動性"@ja.
kg:id_91 prop:cause kg:id_95.
kg:id_96 rdfs:label "修正案可決により関連予算削除"@ja.
kg:id_96 rdf:type cls:c_9529.
cls:c_9529 rdfs:label "予算削除"@ja.
kg:id_91 prop:effect kg:id_96.
kg:id_97 rdfs:label "予算修正案の提出"@ja.
kg:id_97 rdf:type cls:c_9530.
cls:c_9530 rdfs:label "修正案提出"@ja.
kg:id_91 prop:contermeasure kg:id_97.
kg:st_1 rdfs:label "駒井江美子委員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "今後のまちセン整備でも用途変更時の予算確認に注意すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "用途変更の手続確認が不足していた可能性を指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "実際やってみて不足部分が次々に出たのではないかと確認"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "40周年は前もって分かっていたのになぜ今補正なのかと確認"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "渡会企画課長"@ja.
kg:st_2 rdfs:type cls:st_38.
cls:st_38 rdfs:label "職員"@ja.
kg:op_5 prop:content "前回参加者の声を踏まえ音楽交流を事業のベースにした"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "記念品は早めに選定準備したほうがよい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_3 rdfs:label "副町長池田与四也君"@ja.
kg:st_3 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_7 prop:content "蕨岡で培われた餅加工技術の継承を図りたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "技術の継承と雇用確保の好機だと捉えている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "起業家が現れたことを千載一遇のチャンスと捉えた"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "生活クラブとの信頼と責任を果たす事業だ"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:st_4 rdfs:label "舘内産業課長"@ja.
kg:st_4 rdfs:type cls:st_38.
kg:op_11 prop:content "雇用創出を目的に貸し工房を整備する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "蕨岡で培われた餅加工のノウハウを継承したい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "農家収入の増大にもつながる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:st_5 rdfs:label "今野博義委員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_14 prop:content "食品加工場としての基準確認や予算検証を十分行うべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "既存施設で代用できないかさらに検証すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_5.
kg:op_16 prop:content "衛生面や追加改修の不安があり慎重に審査すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:op_17 prop:content "ペイペイ以外の用途も含め効果検証をより行うべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_5.
kg:op_18 prop:content "町負担もある以上 産業振興効果をしっかり検証すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_5.
kg:op_19 prop:content "総額と決済額から利用率は年々上昇している"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "高齢者にもペイペイ利用支援を行っている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:st_6 rdfs:label "渋谷敏委員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_21 prop:content "当初予算の精度を上げ 補正依存を減らすべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:st_7 rdfs:label "太田地域生活課長"@ja.
kg:st_7 rdfs:type cls:st_38.
kg:op_22 prop:content "９月補正で一定額を措置し その後の降雪状況で追加判断する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_7.
kg:op_23 prop:content "建設資材高騰もあり 今後も需要増を見込んで検討すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_6.
kg:st_8 rdfs:label "那須正幸委員"@ja.
kg:st_8 rdfs:type cls:st_16.
kg:op_24 prop:content "情報公開を明確に進め 町民理解につなげるべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_8.
kg:st_9 rdfs:label "時田町長"@ja.
kg:st_9 rdfs:type cls:st_29.
kg:op_25 prop:content "町の責任として風車設置時の景観を示す必要がある"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_9.
kg:op_26 prop:content "より現実に近いモンタージュを町が作成する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_7.
kg:op_27 prop:content "視覚に訴える資料を使い町民周知を進める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_7.
kg:st_10 rdfs:label "佐藤俊太郎委員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_28 prop:content "将来的にも優先的に受け入れられるよう調整してほしい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_10.
kg:op_29 prop:content "拾うだけでなく流れ着かない抜本対策が必要"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_10.
kg:op_30 prop:content "将来的に沢水依存を減らす方策も検討してほしい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_10.
kg:st_11 rdfs:label "松永裕美委員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_31 prop:content "町民も利用できるコインランドリーとして善処してほしい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_11.
kg:op_32 prop:content "指定管理者と協議し対応可能性を検討する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "民生委員や区長と連携し補助制度を積極周知すべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_10.
kg:op_34 prop:content "看板が認知症理解の効果につながることを期待する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_10.
kg:op_35 prop:content "介護現場や高齢者支援のため接種体制確保は重要"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_11.
kg:st_12 rdfs:label "菅原和幸委員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_36 prop:content "冬前に検証し 地域意見を踏まえて対応すべき"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_12.
kg:st_13 rdfs:label "齋藤武委員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_37 prop:content "公金投入には納得できる説明が必要で 共同宣言だけでは足りない"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_13.
kg:op_38 prop:content "餅加工技術や販路はあるため 実証より設備と人員整備の問題だ"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_13.
kg:op_39 prop:content "個人では金銭的信用やマネジメントに限度があり見直すべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_13.
kg:op_40 prop:content "なし崩し的な既成事実化を避け 慎重に進めるべき"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_13.
kg:op_41 prop:content "事業を落ち着いて検討し直し 農業振興の一手段となることを願う"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_13.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "小学校統合により空き校舎となる校舎の使用に関して、今年３月、消防による立会い検査を実施した際に指摘を受けた事項でございます。自動火災報知機の親機、旧職員室と放課後児童クラブの部分の教室が離れているということで、火災が確認できるところに設置するようご指導をいただいた"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "用途変更、今まで学校のほうとして使っていたところですと免除されていた建築基準法の規定で、居室ですとか通路などの壁、天井などについては免除されていたところが、今回学校の用途が変更になるということで、居室のほうは難燃材料以上の、そして通路については準不燃材以上というものにしなければならない"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "実際入ってみますと、建築基準法準拠のための内装改修及び間仕切りの鉄扉設置工事、そして外部水道メーターのための根幹取り出し掘削復旧工事などが必要となりまして、1,250万円を追加計上させていただくものとなっております"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "実際当初では想定していなかったところ、実施計画が入る際になりまして"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "こちら、1,300万円ほどの計上をさせていただいております施設改良工事でございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:text-txt_contents "旧蕨岡小学校放課後児童クラブで行っております箇所、こちらについての自動火災報知機の設置、50万でございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:text-txt_contents "建築基準法準拠のための内装改修及び間仕切りの鉄扉設置工事"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "建築基準法準拠のための内装改修及び間仕切りの鉄扉設置工事"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "外部水道メーターのための根幹取り出し掘削復旧工事などが必要となりまして"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "当初予算編成の時点で予算要求をさせていただきましたけれども、その際にはやはりコロナが収まらないといった状況もございましたものですから、査定の段階で、情勢を見ながら、行けるような状態になれば補正対応しましょうといったところを財政担当の部署とは話をしてきておりました"@ja.
<< kg:id_11 prop:cause kg:id_13 >>
    prop:text-txt_contents "その後いろいろ現地に赴いて状況確認をさせていただいたり、受入れ側の意向等確認をさせていただきましたけれども、それによって実施は可能だというふうに判断をさせていただいたところでございます"@ja.
<< kg:id_11 prop:cause kg:id_14 >>
    prop:text-txt_contents "現在はコロナも収束している状況にございますし、２月に私がハンガリーに赴いた際にも、皆さんマスクは全くしておりませんでしたし、コロナも過去のものとなっているというような印象も受けました"@ja.
<< kg:id_11 prop:cause kg:id_15 >>
    prop:text-txt_contents "あともう一点、ウクライナ情勢もありましたが、ハンガリー側としてはそこまで深刻に受け止めていないといったようなことでありましたので"@ja.
<< kg:id_11 prop:effect kg:id_16 >>
    prop:text-txt_contents "今回９月の補正に計上させていただいて、11月の40周年記念事業並びにまた３月の子供たちの派遣事業、そちらを予算化をさせていただいて、実施をさせていただきたい"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "今回も前回参加された皆様の声もありまして、40周年を記念した音楽交流、音楽の演奏会をやりたいものだということがありましたので、それをベースにしながら今回事業を組み立てた"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "演奏会、実際指揮をされる指揮者の方ですとか、会場、リハーサルで使う会場の使用料、そういったものもこちらの予算から出させていただきたい"@ja.
<< kg:id_17 prop:contermeasure kg:id_20 >>
    prop:text-txt_contents "40周年を記念した音楽交流、音楽の演奏会をやりたいものだということがありましたので"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "施設の老朽化によりまして設備の更新のめどが立たず、令和３年度で閉鎖となっている状況でございます"@ja.
<< kg:id_21 prop:cause kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "こうした状況によって長年地元で培われた餅の加工技術が地元で継承されず、町内のモチ米生産も減少しているという状況にあります"@ja.
<< kg:id_21 prop:cause kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "地元の鳥海山の水と風土を生かした農産物加工品を多くの方に広めたい、そうしたことを強く願う方によりまして、こういった事業にチャレンジしたいと希望する方が出てまいりました"@ja.
<< kg:id_21 prop:cause kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "このことは、生活クラブ連合会のほうでもそういった状況を、地元の継承のこともありまして、惜しむ声が多々ございました"@ja.
<< kg:id_21 prop:effect kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "この事業の目的としましては、生活クラブ連合会の消費財としての餅加工製造を町内事業者が継承する取組を共同宣言事業として位置づけて支援を行い、ひいては雇用創出"@ja.
<< kg:id_21 prop:effect kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "ひいては雇用創出、加工技術の継承、６次産業の担い手育成を目的に"@ja.
<< kg:id_21 prop:effect kg:id_28 >>
    prop:text-txt_contents "ひいては雇用創出、加工技術の継承、６次産業の担い手育成を目的に"@ja.
<< kg:id_21 prop:effect kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "将来的に見ても、加工用に町内のモチ米を使用することで地元のモチ米生産を維持して、さらには持続可能な町の農業を実現することにもつながる"@ja.
<< kg:id_21 prop:contermeasure kg:id_30 >>
    prop:text-txt_contents "小学校の空き校舎を活用して持続可能な餅加工が可能な貸し工房を整備するものでございます"@ja.
<< kg:id_21 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "今年度は生活クラブ生協側の要望もございますので、機械の試運転を兼ねた、そういった品質検査などを行いながら、品質を保つための検証を行うこと"@ja.
<< kg:id_21 prop:contermeasure kg:id_32 >>
    prop:text-txt_contents "設備投資、備品撤去、電気配線工事、給排水設備"@ja.
<< kg:id_21 prop:cause kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "調理室の規模並びに形状から、まず空き校舎、この利活用基本計画にあるほかの利用用途の関係性を考慮した結果、現時点でまず藤崎小学校調理室がこの実証事業に適していると判断した"@ja.
<< kg:id_21 prop:effect kg:id_34 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "今現在、衛生面クリアの確認は取れておらないという状況でございました"@ja.
<< kg:id_21 prop:contermeasure kg:id_35 >>
    prop:text-txt_contents "衛生面をクリアするために必要な全体工事の精査を今後実証事業の中で連合会の助言と保健所等の確認を進めさせていただきながら、一括で工事ができるように調理室の全体改修工事費の概算を算出してまいりたい"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "補助金の交付の対象となる事業につきましては、令和５年４月１日から令和６年２月29日までにおいて市町村が実施する例えばプレミアム付き商品券発行とか、キャッシュレス決済ポイント還元など、県内経済の活性化に資する事業"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "キャッシュレス決済導入促進支援事業の委託料、総額で6,369万7,000円となってございます"@ja.
<< kg:id_36 prop:effect kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "その数値に基づきますと、やはり年々、利用率、総額等、決裁額から見た上昇率でございますが、年々上昇しているというような状況にございます"@ja.
<< kg:id_36 prop:contermeasure kg:id_40 >>
    prop:text-txt_contents "これまで昨年は同じく11月と令和５年３月に実施しております。それと同じ事業となっております"@ja.
<< kg:id_36 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "各年度、その事業を実施するに当たっては、その事業の実施する前に、スマホを使ったペイペイを導入するやり方、仕方とか、そういった細かいところの支援をスマホ教室というようなことで開いて"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "近年の実績額を踏まえて、今回6,000万円という金額を算出したところでございます"@ja.
<< kg:id_42 prop:cause kg:id_44 >>
    prop:text-txt_contents "この除雪委託料の中には、実際除雪機が運行する、いわゆる建設会社さん等々に委託する委託料のほかに、除雪機械の修繕料、約1,700万円から800万円、そのほか防雪柵の設置の委託料、準備のための委託料、待機料も含めて入っております"@ja.
<< kg:id_42 prop:effect kg:id_45 >>
    prop:text-txt_contents "補正額が7,292万円となってございますが、この中の除雪委託料6,000万円について"@ja.
<< kg:id_42 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "例年９月補正の段階で一定程度補正を要求させていただいておりまして、今後の期間の降雪の状況を見て、場合によってはまた追加をさせていただく"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "８月末の段階では136件、補助確定額としては3,998万円ということで、８月の下旬で申請を今止めているというような状況であります"@ja.
<< kg:id_47 prop:effect kg:id_49 >>
    prop:text-txt_contents "補正額1,500万円のうち1,000万円が持家住宅補助金となってございます"@ja.
<< kg:id_47 prop:contermeasure kg:id_50 >>
    prop:text-txt_contents "今年度についても例年同様、９月補正において1,000万円の補正をさせていただく"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "町民の方からもそういうものを明示して説明をというようなお願いもいただいていたところですが、３月の末日の法定協議会の意見取りまとめを踏まえまして、今般９月１日から国による公告も出たところでありますが、本町遊佐町沖のいわゆる区域が定まっております"@ja.
<< kg:id_51 prop:effect kg:id_53 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "洋上風力の事業に関わる本町におけるモンタージュ写真、３枚、４枚程度になりますか。町のほうで今後作成したいということでの補正予算のお願いであります"@ja.
<< kg:id_51 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "多くの事業所が計画をしている30基というところを今回考えておりまして、その30基の並べ方ですけれども、単純に沖合から１海里のところ、そこを１列目ということで考えまして、南北に10本それを置く３列"@ja.
<< kg:id_51 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "今後集落ですとか、いろんな団体から洋上風力について、そういう講座を受けたいということであれば、そういうところにしっかり対応していきたいと。その際にやはり視覚に訴えるようなものがあったほうがイメージも湧く"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:text-txt_contents "国土交通省のほうから最上川の河川掘削土、こちらのほうが調達可能となったものですから、こちらを受け入れるための工事費として1,000万円計上させていただきました"@ja.
<< kg:id_56 prop:effect kg:id_58 >>
    prop:text-txt_contents "パーキングエリアタウン整備工事費、概要書によりますとストックヤードの盛土工事第２工区1,000万円"@ja.
<< kg:id_56 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "現時点での想定ではありますけれども、量としましては１万立米を想定をしてございます"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "７月14日の時点で海水浴場オープン迎えたわけですが、その翌日、翌々日の大雨によりまして、またごみが打ち寄せられておりまして"@ja.
<< kg:id_60 prop:effect kg:id_62 >>
    prop:text-txt_contents "海水浴シーズン始まったばっかりで、なかなかお客様をお呼びできないような状態となった"@ja.
<< kg:id_60 prop:contermeasure kg:id_63 >>
    prop:text-txt_contents "急遽こちらを清掃するための予算として計上させていただいた"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "今年はかなり酷暑といいましょうか、雨が降らない期間がかなり続きました。そういったこともございまして、大平山荘の給水といいましょうか、水が沢水を利用しているわけではありますけれども、雨が降らないために業務に支障を来すような状態となってしまった"@ja.
<< kg:id_64 prop:effect kg:id_66 >>
    prop:text-txt_contents "雨が降らないために業務に支障を来すような状態となってしまったものですから"@ja.
<< kg:id_64 prop:contermeasure kg:id_67 >>
    prop:text-txt_contents "給水作業を委託する経費として計上させていただいたものでございます"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "やはり利用者からの要望がこれまでもあったということと、あと今後大規模な工事等が予想されておりますので、そういった従事者の方が長期宿泊される際に、ぜひ遊楽里を使っていただきたいといったようなことでのあっせん材料として整備をしたい"@ja.
<< kg:id_68 prop:effect kg:id_70 >>
    prop:text-txt_contents "遊楽里の多目的エリアという位置づけをさせていただきながら、２階の自販機コーナーございますけれども、そちらを改修をさせていただいて、コインランドリーを設置したい"@ja.
<< kg:id_68 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "施設の空きスペースの有効利用とか、そういったことも考えてのものになります"@ja.
<< kg:id_72 prop:cause kg:id_73 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "令和４年度の調査時の件数ということでありますけれども、Ｃランクが124件、それからＤランクが172件、合わせて296件"@ja.
<< kg:id_72 prop:effect kg:id_74 >>
    prop:text-txt_contents "空家対策費140万円、空家解体撤去補助金、概要書を見ますと不足分"@ja.
<< kg:id_72 prop:contermeasure kg:id_75 >>
    prop:text-txt_contents "空家解体撤去補助金"@ja.
<< kg:id_76 prop:cause kg:id_77 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "アルツハイマー月間時の認知症啓発用の看板の製作委託料"@ja.
<< kg:id_76 prop:contermeasure kg:id_78 >>
    prop:text-txt_contents "町、そして認知症の推進を委託していますゆうすいなど、介護福祉サービスに関係するところに看板なり、看板といいますか、アクリル板になるのですが、そちらのほうを設置したい"@ja.
<< kg:id_76 prop:contermeasure kg:id_79 >>
    prop:text-txt_contents "今年度新たに認知症サポーター養成を卒業された方につきまして、ステップアップ講座という形のものを新規に事業を起こしております"@ja.
<< kg:id_76 prop:contermeasure kg:id_80 >>
    prop:text-txt_contents "こちらに認知症サポート医である遊佐病院のいづみ先生のほうから講師として来ていただく"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "当初、７割程度を想定しておったのですが、大分多くの方から来ていただいて、時間的にも日数的にも大分厳しい状況でございました。春接種実施につきましては、既に６月集団接種ということで終わっておりまして、８月15日現在75.3％という接種率になっております"@ja.
<< kg:id_81 prop:effect kg:id_83 >>
    prop:text-txt_contents "これから10月始まります秋接種については、今まで25回で計算しておったところでございますが、30回に増やしたところで"@ja.
<< kg:id_81 prop:contermeasure kg:id_84 >>
    prop:text-txt_contents "体制確保事業の中で予防接種に係る事務の方の委託料と送迎バス、添乗も含めてでございますが、そちらのほうの委託料が37万4,000円でございます。あと、ワクチン接種事業としまして集団接種に係る医師、看護師への委託料62万4,000円、そして個別接種についても増加が見込めるということで113万9,000円を計上"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "十六羅漢のバス待合所あるわけなのですけれども、そこが令和２年のときにちょっと半壊して、応急的に補修して、これまで使っていたのですけれども、それがやっぱりちょっと古いということで、早めに撤去したほうが安全なのかな"@ja.
<< kg:id_85 prop:cause kg:id_87 >>
    prop:text-txt_contents "出戸のバス待合所があるのですけれども、これ酒田河川国道事務所のほうからも言われているのですけれども、高速道路の関係で、ちょうど高速道路を今造っているところと旧国道のところの立体交差するような場所があるのですけれども、その関係でバスの待合所を移設する"@ja.
<< kg:id_85 prop:contermeasure kg:id_88 >>
    prop:text-txt_contents "十六羅漢のバス待合所...早めに撤去したほうが安全なのかなということで、まずそれの撤去工事費ということで20万円"@ja.
<< kg:id_85 prop:contermeasure kg:id_89 >>
    prop:text-txt_contents "中小野曽というバス停について、これも現場確認したところ大分古くなっていて、ちょっと危険かなということで考えましたので、これも撤去工事ということで20万円計上"@ja.
<< kg:id_85 prop:contermeasure kg:id_90 >>
    prop:text-txt_contents "出戸のバス待合所...その関係でバスの待合所を移設するものでございます。これが10万円"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "餅加工計画の全体像が答弁からは十分見えません。いわゆる事業計画と言ってしかるべきものです。町がこれからどの程度金銭的に関わる必要があるのか不明です"@ja.
<< kg:id_91 prop:cause kg:id_93 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "実証事業とされていますが、餅加工自体は技術的には確立されており、今回のケースでは販路はおおむね確保されていると思われるので、残るは設備や人員をどう整えるかということになる"@ja.
<< kg:id_91 prop:cause kg:id_94 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "行政が一個人に対し最終的な支出の額が見えない設備投資をしてまで加工場を整え、貸し出すということはかなり異例だと考えます"@ja.
<< kg:id_91 prop:cause kg:id_95 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "遊佐町空き校舎利活用基本計画では、この餅加工場のことは確定的には記載されておらず、流動的な要素があります。一方、一度設備投資をしてしまうと、旧藤崎小学校の利活用の一部に既成事実が生じてしまいます"@ja.
<< kg:id_91 prop:effect kg:id_96 >>
    prop:text-txt_contents "修正案の内容は、旧藤崎小学校の６次産業、いわゆるただいまやり取りされました餅加工場整備に係る予算を削るというものであります"@ja.
<< kg:id_91 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "昨夜の常任委員会でのやり取りも踏まえ、提案理由を申し述べます。修正案の内容は、旧藤崎小学校の６次産業、いわゆるただいまやり取りされました餅加工場整備に係る予算を削るというものであります"@ja.
}
