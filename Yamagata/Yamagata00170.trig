kg:id_91 rdfs:label "遊佐町一般会計補正予算第3号の藤崎小学校餅加工場整備"@ja.
kg:id_91 rdf:type cls:c_9486.
kg:id_92 rdfs:label "事業計画の全体像と町負担額が不明確"@ja.
kg:id_92 rdf:type cls:c_9525.
cls:c_9525 rdfs:label "計画不明確"@ja.
kg:id_91 prop:cause kg:id_92.
kg:id_93 rdfs:label "実証事業という考え方への疑義"@ja.
kg:id_93 rdf:type cls:c_9526.
cls:c_9526 rdfs:label "実証疑義"@ja.
kg:id_91 prop:cause kg:id_93.
kg:id_94 rdfs:label "行政が一個人に対し設備投資して貸し出すのは異例"@ja.
kg:id_94 rdf:type cls:c_9527.
cls:c_9527 rdfs:label "事業方式疑義"@ja.
kg:id_91 prop:cause kg:id_94.
