kg:st_1 rdfs:label "菅原和幸議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "温暖化を止めることが今行うべきことと認識する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "今後10年間の対応が日本の未来を左右すると考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "時田町長"@ja.
kg:st_2 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_3 prop:content "2050年カーボンニュートラル実現に向け積極的に取り組む"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "2030年までの町の施策の方向性を定める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "2030年までの町の施策の方向性を定める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "2030年までの町の施策の方向性を定める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "今後の課題として進める必要がある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "今後の課題として進める必要がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "現在の町の体制では難しいと考える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "先行地域指定にこだわらず活用を図りたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "真に遊佐で消費される仕組みになっていない"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "遊佐町に合った地産地消の仕組みをつくり持続可能な町を目指す"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "再エネ導入や脱炭素事業推進のため組織再編を検討する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "遊佐町のサケ事業は危機的状況にあると感じる"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "高温が影響していると受け止めている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "ふ化事業も危機的状況にある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "先人から続く事業が危機的状況にある"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:st_3 rdfs:label "遊佐町の漁協に関係している方"@ja.
kg:st_3 rdfs:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_18 prop:content "魚がいなくなっている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "日本海沿岸側の１等米比率の悪化は温暖化の影響ではないかと感じる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:st_4 rdfs:label "舘内産業課長"@ja.
kg:st_4 rdfs:type cls:st_38.
cls:st_38 rdfs:label "職員"@ja.
kg:op_20 prop:content "令和６年度以降は森林経営管理制度に向けた意向調査に入る予定"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "意向調査結果を踏まえ事業に入る予定"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:st_5 rdfs:label "土門教育長"@ja.
kg:st_5 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_22 prop:content "理解を深める必要があり学習や教育の場も必要と考える"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "現状ではどの外部機関ともつながりにくくデリケートな状況にある"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "今私たちができることを議論し進んでいくのは行政として当然"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:st_6 rdfs:label "松永裕美議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_25 prop:content "産後の母親が安心できる新たなアウトリーチ型支援が必要と考える"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "人が人と会い玄関先で相談のきっかけをつくれる新しい政策になる"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "妊娠期から出産子育てまで一貫して身近で相談に応じ必要な支援につなぐ"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "安心して出産子育てができる環境を整える"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "不安解消につながるようサービスの充実に努めている"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "不安解消につながるようサービスの充実に努めている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "不安解消につながるようサービスの充実に努めている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "不安解消につながるようサービスの充実に努めている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "不安解消につながるようサービスの充実に努めている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "産後は精神的に不安定になりやすい時期である"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "産後うつ病のリスクが高い傾向がある"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "産後うつ病のリスクが高い傾向がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "入院中や新生児訪問の機会に実施していく"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "不安が軽減されるよう努めている"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "産後うつ病の予防や産後虐待防止につながる取組として検討を進める"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "宿泊料や使用料の若干の値上げを考える時期ではないか"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "必要と判断されれば条例改正等も含め対応する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "ネーティブな英語に触れる機会が多く大変充実した授業が行われている"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "専門性の高い方から講師を引き受けてもらい好評を得ている"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "民間の協力が得られるなら検討の余地はある"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:st_7 rdfs:label "渡部健康福祉課長"@ja.
kg:st_7 rdfs:type cls:st_38.
kg:op_45 prop:content "全ての妊産婦子育て世帯子供へ一体的に相談を行う機関として準備を進める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_7.
kg:op_46 prop:content "関係機関と協働して支援を行っていく予定"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_7.
kg:op_47 prop:content "新生児訪問時に記入してもらい状況を聞き取り見守り支援につなげる"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_7.
kg:op_48 prop:content "産後うつ病予防や児童虐待防止につながる取組として前向きに検討したい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_7.
kg:st_8 rdfs:label "池田総務課長"@ja.
kg:st_8 rdfs:type cls:st_38.
kg:op_49 prop:content "施設運営は厳しくなっている施設もある"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_8.
kg:op_50 prop:content "令和６年度に向け各課に利用料と維持費の整合を検討してもらいたいと伝えた"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_8.
kg:op_51 prop:content "利用者の利便性や利用状況費用対効果を考慮し検討する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "現在は西コートの利用がない状況"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "現在の状況では使用するのは難しい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "現在の利用状況を踏まえて検討が必要"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "整備計画決定までは東側のみ使用可能と明記する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "防災センターから遠い地域では不便さを感じている方がいると認識している"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "より身近な場所で手続できるよう利便性を高めたい"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "住民の利便性向上のため調整を進める"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "餌を求めて人里に下りてきていると考えられる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "人的被害防止のため集落内出没時の対応を徹底していく必要がある"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "人的被害が発生しないよう関係機関との連携を図っていきたい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "集落周辺の出没リスクを減少するため実施したい"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "地域ぐるみの対策に協力いただくよう発信したい"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "今後さらに被害が拡大するものと懸念する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "今後さらに被害が拡大するものと懸念する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "今後さらに被害が拡大するものと懸念する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "有効性や適切な管理方法を周知し設置を進めたい"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "町民や来訪者への情報提供と注意喚起に努めたい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:st_9 rdfs:label "鳥海教育課長"@ja.
kg:st_9 rdfs:type cls:st_38.
kg:op_69 prop:content "熊の目撃情報が増えていくようであれば検討する必要がある"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_9.
kg:op_70 prop:content "今年度は２件の申請があり県と町が４分の１ずつ負担する補助を活用している"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_4.
kg:op_71 prop:content "安全対策の面から見通しのよい状況を保つことが必要"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_4.
kg:op_72 prop:content "より地域にとって使いやすく利便性の高い道路として整備いただいた"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "本体整備に地域の皆様の声を反映させたい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:st_10 rdfs:label "渡会企画課長"@ja.
kg:st_10 rdfs:type cls:st_38.
kg:op_74 prop:content "管理運営事業者と共に計画をまとめることが今回の特徴"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_10.
kg:op_75 prop:content "皆様からの意見をいただいて設計に反映させたい"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_10.
kg:op_76 prop:content "町内外の事業所から関心表明書が提出され期待している"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_10.
kg:op_77 prop:content "約5000万円程度事業費を抑えることができると見込む"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_10.
kg:op_78 prop:content "現段階で想定している補助制度"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_10.
kg:op_79 prop:content "道路休憩施設機能部分は国の負担で整備される"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_10.
kg:op_80 prop:content "ただ目先の損得ではなく町の将来の拠点をもう一つ造る気持ちで進めたい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "遊佐に来たい人住みたい人を呼び寄せる拠点を目指す"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "吹浦の都市計画区域も含め人が住む地域として活用していくことを考えたい"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "調査により想定される被害量については、普通林において前年度比約300％程度の増加が見込まれています"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:text-txt_contents "今月下旬より冬季の松くい虫被害木伐倒駆除を行い"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:text-txt_contents "６月のマツノマダラカミキリの羽化脱出日までに、被害木の全量駆除を目指します"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "エネルギー・食料品等の物価高騰の影響が大きい低所得世帯に速やかに生活・暮らしの支援を行うため"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:text-txt_contents "エネルギー・食料品等の物価高騰の影響が大きい低所得世帯に速やかに生活・暮らしの支援を行うため"@ja.
<< kg:id_5 prop:contermeasure kg:id_8 >>
    prop:text-txt_contents "住民税非課税世帯に対して１世帯当たり５万円を給付する「令和５年度遊佐町電力・ガス・食料品等価格高騰重点支援地方交付金支給事業」を実施しました"@ja.
<< kg:id_5 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "令和５年11月２日に閣議決定された追加交付分の７万円の支給事業についても、本定例会の補正予算に計上し、事業実施に向けた準備を進めています"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:text-txt_contents "各地区の区長の皆さんと統合して初めて迎える冬を前に、スクールバスの運行状況や待合所の整備方針等について意見交換会を行いました"@ja.
<< kg:id_10 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "スクールバスの運行状況や待合所の整備方針等について意見交換会を行いました"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今年は、地球の温暖化に起因すると考えられる気象や環境の変化を当町でも生活面や産業面などで感じた年でありました"@ja.
<< kg:id_13 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "地球温暖化対策の推進に関する法律の第21条には、県及び市町村は、地方公共団体実行計画を策定すると規定されております"@ja.
<< kg:id_13 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "現在町のエネルギー基本計画の改定作業を行っております"@ja.
<< kg:id_13 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "再生可能エネルギーの導入、省エネの推進、温室効果ガス吸収源対策を３本柱に"@ja.
<< kg:id_13 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "再生可能エネルギーの導入、省エネの推進、温室効果ガス吸収源対策を３本柱に"@ja.
<< kg:id_13 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "再生可能エネルギーの導入、省エネの推進、温室効果ガス吸収源対策を３本柱に"@ja.
<< kg:id_13 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "今後町有施設におけるさらなる省エネ化、再エネ設備の導入が課題になってくるものと思われています"@ja.
<< kg:id_13 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今後町有施設におけるさらなる省エネ化、再エネ設備の導入が課題になってくるものと思われています"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "先行区域の選定を受けるためには、町全体、全地域においての具体的な取組が必要であり、指定を受けるためのハードルが非常に高く、現在の町の体制では難しいものと考えております"@ja.
<< kg:id_22 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "先行地域指定にこだわらず、地域脱炭素移行・再エネ推進交付金とした重点加速事業、脱炭素推進事業債などの支援制度もありますので、現時点ではそちらの活用も図っていきたいと考えております"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "そこで発電された電力は売電事業に使われているものがメインであり、真に遊佐でそれらの自然再生可能エネルギーが遊佐で消費されるという仕組みにはなっていないのが現状です"@ja.
<< kg:id_25 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "町や生活クラブ連合会、ＪＡなど関係機関、団体も議論に参加しながら、官民連携、協働の遊佐町に合った地産地消の仕組みをつくり、持続可能な遊佐町を目指してまいりたいと考えております"@ja.
<< kg:id_28 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "再生可能エネルギー導入や脱炭素に向けた事業を町として進めていくために、令和６年度に向け、組織の再編について検討をしていきたいと考えております"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "庄内沖の温度が、海水温が上がっているということで、今年の海水温は平年より２度ほど高くなっておって"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "やはり先ほど言ったとおり遡上が非常に遅くなっているということでした、その当時。２週間ほど遅れて、上がってきても小ぶりというか"@ja.
<< kg:id_30 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "今朝の新聞にはやはり河川の採捕は例年の１割から４割程度であると"@ja.
<< kg:id_30 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "ふ化事業の関係も、北海道のほうから卵を持ってこないとならないというようなこともございました"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "やはり魚がいなくなっていると"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "勝手な解釈ですが、温暖化の影響になっているのかなと勝手に思っているところでございます"@ja.
<< kg:id_39 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "昨年度、令和４年度は航空レーザー測量を実施し、今年度、そのデータの解析を行っております。さらに、この結果を基にいたしまして、令和６年度以降は森林経営管理制度に向けた意向調査に入る予定としております"@ja.
<< kg:id_39 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "その後は、意向調査の結果にもよりますけれども、集積計画策定を行いながら、路網整備等の事業に入る予定としております"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "脱炭素社会の実現の重要性についてはさらに理解を深める必要があると認識しているところでございます。そのための学習や教育の場も必要であると考えております"@ja.
<< kg:id_42 prop:cause kg:id_44 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "現在遊佐町沖洋上風力発電の業者選定が検討されている中でありまして、様々な業者から地域貢献策として、教育委員会のほうに脱炭素社会やカーボンニュートラル等に関する環境教育の講師派遣等の提示がなされているところでありますが、現状においては、どの外部機関ともつながりにくい状況であります"@ja.
<< kg:id_45 prop:effect kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "できるところからカーボンゼロは進めていかなければ、地球の将来の次の世代、そしてその次の世代に対して大変なやっぱり負担をかけるのではないかという思いを非常に持っております"@ja.
<< kg:id_47 prop:effect kg:id_48 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "妊産婦のうち妊娠、出産、産後の期間に不安や負担を抱えていらっしゃる女性は８から９割程度いらっしゃる"@ja.
<< kg:id_47 prop:contermeasure kg:id_49 >>
    prop:text-txt_contents "出産のママさんと赤ちゃんを対象に保健師の方が家庭を巡回して回る赤ちゃん健やか訪問という事業も既にスタートしている"@ja.
<< kg:id_47 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "月に１回もしくは二月に１回、玄関先まで赤ちゃんのおむつを戸配させていただく手法でございます"@ja.
<< kg:id_47 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "妊娠期から出産、子育てまで一貫して身近で相談に応じ、必要な支援につなぐ伴走型相談支援"@ja.
<< kg:id_47 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "妊娠期と産後にそれぞれ５万円を給付する経済的支援を組み合わせた支援が開始されております"@ja.
<< kg:id_47 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "妊産婦同士の交流ができる講座の開設や新生児訪問、助産師による母乳相談事業、宿泊型産後ケアや訪問型産後ケアなど、妊産婦の不安解消につながるよう、サービスの充実に努めております"@ja.
<< kg:id_47 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "妊産婦同士の交流ができる講座の開設や新生児訪問、助産師による母乳相談事業、宿泊型産後ケアや訪問型産後ケアなど、妊産婦の不安解消につながるよう、サービスの充実に努めております"@ja.
<< kg:id_47 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "妊産婦同士の交流ができる講座の開設や新生児訪問、助産師による母乳相談事業、宿泊型産後ケアや訪問型産後ケアなど、妊産婦の不安解消につながるよう、サービスの充実に努めております"@ja.
<< kg:id_47 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "妊産婦同士の交流ができる講座の開設や新生児訪問、助産師による母乳相談事業、宿泊型産後ケアや訪問型産後ケアなど、妊産婦の不安解消につながるよう、サービスの充実に努めております"@ja.
<< kg:id_47 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "妊産婦同士の交流ができる講座の開設や新生児訪問、助産師による母乳相談事業、宿泊型産後ケアや訪問型産後ケアなど、妊産婦の不安解消につながるよう、サービスの充実に努めております"@ja.
<< kg:id_58 prop:cause kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "産後は、慣れない育児による不規則な生活リズムで育児疲れから精神的に不安定になりやすい時期であるため"@ja.
<< kg:id_58 prop:cause kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "初めての出産や身近に支援者がない方に産後の鬱病のリスクが高い傾向があり"@ja.
<< kg:id_58 prop:cause kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "初めての出産や身近に支援者がない方に産後の鬱病のリスクが高い傾向があり"@ja.
<< kg:id_58 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "入院中や新生児訪問の機会に産後鬱病早期発見のためのスクリーニングを実施していきます"@ja.
<< kg:id_58 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "訪問や個別相談事業を通して不安が軽減されるよう努めております"@ja.
<< kg:id_58 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "定期的な相談支援の機会を提供することは産後鬱病の予防や産後虐待防止につながる取組でもありますので、産婦の体調回復や育児不安の軽減が図れるように検討を進めてまいります"@ja.
<< kg:id_65 prop:cause kg:id_66 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "原油高高騰や様々な物価が日常生活では上がってきているという現状も鑑みまして"@ja.
<< kg:id_65 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "今後情勢等の変化により、使用料の営業についての意向があった際には、その情勢を踏まえ、必要と判断されれば、条例の改正等も含めた対応をいたしてまいります"@ja.
<< kg:id_68 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "授業の全ての時間にＡＬＴが入っておりますので、ネーティブな英語に触れる機会が多く、大変充実した授業が行われていると伺っております"@ja.
<< kg:id_68 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "その開校教科の一つである英語につきましては、専門性の高い方から講師を引き受けていただいており、大変好評を得ております"@ja.
<< kg:id_68 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "今後地域の民間の協力が得られるなら、検討の余地はあるものと考えております"@ja.
<< kg:id_72 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "子育て世代包括支援センターと子ども家庭総合支援拠点、それぞれの設立の意義や機能を維持した上で組織を見直して、全ての妊産婦、子育て世帯、子供へ一体的に相談を行う機能を有する機関として、こども家庭センターの設置が市町村の努力義務として法定化されたものでございます"@ja.
<< kg:id_72 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "妊娠届から妊産婦の支援、そして子育てや子供に関する相談を受けて、支援を要する子供、妊産婦等へのサポートプランを作成して、関係機関と協働して支援を行っていく予定でございます"@ja.
<< kg:id_58 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "新生児訪問、赤ちゃん健やか訪問というものを３か月くらいまでの間に保健師のほうが訪問させていただいているところでございますが、その際に産婦の皆さんから記入をしていただいて、その後保健師のほうが状況など聞き取りをして、そして見守り支援が必要な方については支援をしていく"@ja.
<< kg:id_58 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "定期的な相談機会を提供することは産後鬱病の予防、あとは児童虐待の防止という形のものにもつながる取組でございますので、産婦の体力の回復、そして育児不安の軽減という形も図られると思いますので、前向きにちょっと検討していきたいと思っております"@ja.
<< kg:id_77 prop:cause kg:id_78 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "今の光熱費の高騰によりまして、やっぱり施設運営とかは厳しくなっているというような施設もある"@ja.
<< kg:id_77 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "令和６年度に向けて、各課のほうになのですけれども、それぞれ施設の維持費、いわゆる光熱費と利用料のほうがきちんと合っているのかどうかというのを検討してもらいたいということで話はさせていただいたところであります"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:text-txt_contents "現在、町民スポーツ広場、サン・スポーツランド遊佐の管理棟、野球場、テニスコートの隣のトイレについては、和式や簡易洋式トイレとなっております"@ja.
<< kg:id_80 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "近年の小中学校や公共施設のトイレの洋式化、利用者の利便性、施設の利用状況や費用対効果を考慮しながら、水洗の洋式トイレ化に向けて改修の検討をしていくことにしております"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "サン・スポーツランドと野球場の利用で十分対応できるということもあり、現在は町民広場西コートの利用はない状況となっております"@ja.
<< kg:id_83 prop:cause kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "そのため、現在は年１回の草刈り等の必要最小限の管理のみを行っております。スポーツで利用することは難しい状況です"@ja.
<< kg:id_83 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "今後の整備計画については、現在の利用状況も踏まえた上で、将来に向けての計画的な事業運営において検討していく必要があると考えております"@ja.
<< kg:id_83 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "町のホームページの施設案内の中で、町民スポーツ広場東側コートのみ使用できる旨を記載していきたいと考えております"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "ポイントカードと景品等の交換については、これまで金券の取扱いや事業の効率化による防災センターでの対応としていましたが、そのため移動困難な方々について、通いの場の代表者がまとめて交換に来てくださるところもありますが、一方で防災センターから遠い地域について、不便さを感じている方がいらっしゃるという認識もいたしているところであります"@ja.
<< kg:id_88 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "ポイント交換場所につきましては、より身近な場所で手続ができるように住民の利便性を高めていきたいと考えており、希望に応じて地区単位での出張ポイント交換会や"@ja.
<< kg:id_88 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "出前講座で実施できるよう調整を進めてまいります"@ja.
<< kg:id_92 prop:cause kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "今年は特に山のブナが大凶作と言われていることが影響し、餌不足になったツキノワグマが餌を求めて人里に下りてきていることで、目撃や農作物の被害が増加したと考えられております"@ja.
<< kg:id_92 prop:effect kg:id_94 >>
    prop:text-txt_contents "今年の町内のツキノワグマの目撃、被害の情報は、11月現在で100件を超え、昨年１年間の16件とは比較にならないほど過去最大の件数となりました"@ja.
<< kg:id_92 prop:effect kg:id_95 >>
    prop:text-txt_contents "昨年度は１頭でありましたが、今年は既に13頭となっており、目撃数と同様に過去最大となっております"@ja.
<< kg:id_92 prop:effect kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "集落内で出没した場合、いつ人的被害が発生してもおかしくない状況となります"@ja.
<< kg:id_92 prop:contermeasure kg:id_97 >>
    prop:text-txt_contents "平成28年度より遊佐町鳥獣被害対策実施隊を設置し、有害鳥獣の捕獲、防除に努めてきました"@ja.
<< kg:id_92 prop:contermeasure kg:id_98 >>
    prop:text-txt_contents "平成28年には農協、森林組合、猟友会、警察、消防、区長代表、県などを構成機関として遊佐町鳥獣被害防止対策協議会を設立し、被害防止に向けた体制を整えてきたところであります"@ja.
<< kg:id_92 prop:contermeasure kg:id_99 >>
    prop:text-txt_contents "状況に応じて看板の設置や回覧文書などによる注意喚起を行っております"@ja.
<< kg:id_92 prop:contermeasure kg:id_100 >>
    prop:text-txt_contents "目撃等の情報は総務課危機管理係、教育委員会、健康福祉課の学校、保育園担当者と共有をし"@ja.
<< kg:id_92 prop:contermeasure kg:id_101 >>
    prop:text-txt_contents "目撃等の情報は町のホームページにも掲載し、情報発信を行っているところであります"@ja.
<< kg:id_92 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "市街地に出没した際に人的被害が発生しないように、市街地出没対応マニュアルを作成することなどして、より具体的な対応についての関係機関との連携を図っていきたいと考えております"@ja.
<< kg:id_92 prop:contermeasure kg:id_103 >>
    prop:text-txt_contents "通学路となっている場所での出没に対しましては、迅速に情報の連携ができるように進めていきます"@ja.
<< kg:id_92 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "少しでも集落周辺の出没リスクを減少するため、熊の餌となる集落周辺にある放置果樹への対策を実施"@ja.
<< kg:id_92 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "取り残しの果樹の撤去、食品や生ごみの放置、戸締まり等に注意するなど、地域ぐるみの対策にご協力いただくよう発信していきたい"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:text-txt_contents "小中学校に伝達し、小中学校においては、保護者にメールでの一斉送信により、各家庭でのスクールバスの下車後も含め、登下校時の送迎等の協力をお願いしているところです"@ja.
<< kg:id_106 prop:contermeasure kg:id_108 >>
    prop:text-txt_contents "中学校においては、授業終了後、保護者が迎えに来る時間まで学校で待機することができるような対応もしております"@ja.
<< kg:id_106 prop:contermeasure kg:id_109 >>
    prop:text-txt_contents "熊に関する注意喚起の文書も小中学校に配布し、児童生徒に対して指導も行っている状況であります"@ja.
<< kg:id_110 prop:effect kg:id_111 >>
    prop:text-txt_contents "イノシシによる被害の状況ですが、箕輪、白井新田、藤井、金俣、三ノ俣、杉沢等で目撃、農地の掘り起こしや農作物の被害が13件発生しており"@ja.
<< kg:id_110 prop:effect kg:id_112 >>
    prop:text-txt_contents "３頭の捕獲を行いました"@ja.
<< kg:id_110 prop:cause kg:id_113 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "イノシシは繁殖力が強く"@ja.
<< kg:id_110 prop:cause kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "町内のほぼ全域で痕跡が確認されていることや"@ja.
<< kg:id_110 prop:cause kg:id_115 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "８頭以上の群れも確認されていることから、今後さらに被害が拡大するものと懸念されます"@ja.
<< kg:id_110 prop:contermeasure kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "電気柵等の侵入防止柵の設置が有効であるため、電気柵の有効性や適切な管理方法を周知し、設置を進めてまいりたいと考えます"@ja.
<< kg:id_110 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "今後も生息状況の調査、被害対策を進めながら、町民及び町内外からの来訪される方に鳥獣に関する情報提供を行うとともに、注意喚起に努めてまいりたいと考えております"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "今のところまず熊鈴については配布しておりませんが、今後熊の目撃情報が増えていくようであれば、検討する必要もあるのかなと考えております"@ja.
<< kg:id_110 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "今年度は２件の申請がございます。これは、補助金を活用しての電気柵の設置というふうになってございまして、購入に係る費用の２分の１が購入者への負担、県と町が４分の１ずつの負担となってございまして、10万円が上限の、そういった補助事業を活用しての設置となっております"@ja.
<< kg:id_110 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "やぶにしておくと、そこは安全対策の面からも、かなり問題の箇所というような位置づけになるかと思いますので、ある程度安全対策を求めるために、見通しのよい状況に、そういう状況を保つというか、そういったことは必要になるのかなと考えます"@ja.
<< kg:id_122 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "国土交通省及び山形県のご理解、ご協力もあって、本町の要望を受けて、遊佐鳥海インターの取付け道路の形状変更を行うなど、より地域にとっては使いやすい、利便性の高い道路として整備いただき"@ja.
<< kg:id_122 prop:contermeasure kg:id_124 >>
    prop:text-txt_contents "今年度は、公募プロポーザルを経て、新しい道の駅の指定管理、民間の候補としてのジオ鳥海パートナーズグループを選定しました"@ja.
<< kg:id_122 prop:contermeasure kg:id_125 >>
    prop:text-txt_contents "建築基本設計者として、株式会社羽田設計事務所を選定いたしました"@ja.
<< kg:id_122 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "例えばワークショップを開催するなどして、地域の皆様の声を本体整備にも反映させていきたいと考えているところであります"@ja.
<< kg:id_122 prop:contermeasure kg:id_127 >>
    prop:text-txt_contents "周辺道路への水道管、下水道管の埋設"@ja.
<< kg:id_122 prop:contermeasure kg:id_128 >>
    prop:text-txt_contents "ストックヤードとして国交省や県の他の事業での発生土を受け入れる、いわゆる盛土材の確保などにも進めて、実施してきたところであります"@ja.
<< kg:id_122 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "管理運営事業者と共に管理運営事業者の意向を設計に反映していくと、反映しながら計画をまとめるというところが今回の業務の特徴"@ja.
<< kg:id_122 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "専門家ですとか運営事業者、そこに町民の皆さんを巻き込んだ形でのワークショップ"@ja.
<< kg:id_122 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "町内外の10者を超える事業所から今回の事業協力、提携をしたいといったような関心表明書なるものの提出がございました"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "単純計算でいきますと5,000万円程度は事業費を抑えることができるというふうにこちらでは踏んでございます"@ja.
<< kg:id_132 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "現段階で想定しているものといたしましては、内閣府の地方創生拠点整備交付金でございます"@ja.
<< kg:id_132 prop:contermeasure kg:id_135 >>
    prop:text-txt_contents "そのほか農水省、環境省などの補助メニュー、そういったものもあるようではございますので、活用可能かというところを調査検討中"@ja.
<< kg:id_132 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "道路休憩施設機能は国、国交省のほうで負担して整備していただくことになりますので、町の負担は幾らかは減るというふうに思ってございます"@ja.
<< kg:id_132 prop:contermeasure kg:id_137 >>
    prop:text-txt_contents "そのほか交付税措置のある過疎債、そういったものを活用をしていきたい"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "町としての新たな拠点をもう一つつくるのだという意味でのタウンという形、パーキングエリアタウン"@ja.
<< kg:id_138 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "遊佐に来たい人、住みたい人をやっぱり呼び寄せる"@ja.
<< kg:id_138 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "無料の高速を使いながら、どんどん通える、そしてそこにはすばらしい景観とスーパー道の駅がある、それを目指して進めてまいりたいと思っています"@ja.
}
