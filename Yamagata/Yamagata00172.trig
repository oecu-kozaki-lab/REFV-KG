kg:st_1 rdfs:label "斎藤弥志夫議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "促進区域指定により漁業への支障はないとみなせるのではないか"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "時田町長"@ja.
kg:st_2 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_2 prop:content "漁業に全く影響がないわけではないが共生策で共存共栄は可能と考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "地域生活課長 太田智光"@ja.
kg:st_3 rdfs:type cls:st_60.
cls:st_60 rdfs:label "自治体職員"@ja.
kg:op_3 prop:content "構造物が建つ以上支障はあるが振興策や共生策と併せて共存していく認識である"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:st_4 rdfs:label "酒田港風力発電事業者協議会会長"@ja.
kg:st_4 rdfs:type cls:st_107.
cls:st_107 rdfs:label "事業者団体"@ja.
kg:op_4 prop:content "地域協調型事業として地域経済活性化につなげたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_4.
kg:op_5 prop:content "住居への直接的な影響はほぼないと認識している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "低周波問題は過度に心配する必要はなく前向きに事業に臨むべきだ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_5 rdfs:label "能代市エネルギー産業政策課"@ja.
kg:st_5 rdfs:type cls:st_108.
cls:st_108 rdfs:label "自治体組織"@ja.
kg:op_7 prop:content "景観は主観の問題であり大きな問題ではないとの認識を示した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_5.
kg:op_8 prop:content "景観などへの不安の払拭に努めたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "健康問題は世間で言われるほど心配する必要はない"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "健康に害を及ぼすものを建ててよいという法律はなく環境影響評価で確認すべきだ"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "市民の理解は進んでおり健康被害はないと説明した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_5.
kg:st_6 rdfs:label "能代観光協会"@ja.
kg:st_6 rdfs:type cls:st_109.
cls:st_109 rdfs:label "観光団体"@ja.
kg:op_12 prop:content "洋上風力発電事業の開始後に視察団の増加が起きている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_6.
kg:op_13 prop:content "湾岸エリアの活気が生まれていると説明した"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_6.
kg:op_14 prop:content "観光の増加が見込まれる変化が起きている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_6.
kg:op_15 prop:content "宿泊予約の増加が見込まれる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:op_16 prop:content "食事予約の増加が見込まれる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_6.
kg:op_17 prop:content "超低周波音や景観への不安の払拭に努めたい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "漁業への影響を前提に振興策や共生策で洋上風力との共生を図るべきだ"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "事業者による振興策や共生策と併せて共存していくべきだ"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "実際の運営後も漁業センサスのような調査は必要だ"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "事前の環境影響評価をしっかり行った上で建設に着手すべきだ"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "町として国や県と連携し事業完了まで責任を持って見守る"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "異常発生時の運転停止措置を含めた協定締結を進めたい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "県と協議会の連携による地元企業向けセミナーは参入促進に有効だ"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "先行区域に学ぶ研修会を通じて地元の準備を進めるべきだ"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "酒田市の経済界や商工会と勉強会を進め地元に事業を根づかせたい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "地元から技術者を多く育成し長期的なメンテナンスにも対応すべきだ"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "全国の先行事例を参考に地元でメンテナンス事業ができる形を目指したい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "高速道路が通る町であることを町自ら動画でアピールすべきだ"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:st_7 rdfs:label "企画課長 渡会和裕"@ja.
kg:st_7 rdfs:type cls:st_60.
kg:op_30 prop:content "提案を受け止め有効な観光PRにつながる形を検討したい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_7.
kg:st_8 rdfs:label "副町長 池田与四也"@ja.
kg:st_8 rdfs:type cls:st_11.
kg:op_31 prop:content "町自力の情報発信として前向きに検討したい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_8.
kg:op_32 prop:content "消費者と生産者の関係から一歩進み新しいステージに前進する提携だった"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "石けん運動やアルミ工場移転問題で町民の環境意識向上に大きく貢献した"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "生活クラブ関連事業を通じて農業支援に来る人が遊佐町にも来ておりありがたい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "3部会を核に基幹産業と地域社会の持続的発展課題に取り組むべきだ"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "水の出る区域を守るために土地を買い求めたことは大きかった"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "生活クラブや夢都里路くらぶと連携し農業体験を交えた事業を検討中である"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:st_9 rdfs:label "産業課長 舘内ひろみ"@ja.
kg:st_9 rdfs:type cls:st_60.
kg:op_38 prop:content "現地までの交通の不便さと少人数体制が課題である"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_9.
kg:st_10 rdfs:label "渋谷敏議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_39 prop:content "冬期間の登下校にさらなる安全対策が必要だ"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_10.
kg:op_40 prop:content "住宅や私有地の前や道路幅の狭い場所が多く待合所整備は容易でない"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "教育長と課長が全ての場所を確認し現状把握を進めた"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "統合後初の冬を前に区長と安全対策等の意見交換を行った"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "バス停までの除雪は自主除雪制度を活用した地域協力をお願いしている"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "保護者を含め集落で協議した上で街灯整備を要望してもらう対応としている"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "関係機関と合同点検を行い信号機設置要望箇所などを確認した"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "熊などの情報を学校経由で保護者に伝え送迎協力をお願いしている"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "中学校では保護者が迎えに来るまで学校待機できるようにしている"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "置き去り防止も含め運転手間で安全管理を徹底している"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:st_11 rdfs:label "齋藤武議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_49 prop:content "移住後のミスマッチを防ぐため地域の慣習やルールを事前に伝える必要がある"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_11.
kg:op_50 prop:content "教科書作りの過程自体が住民にとって地域を見詰め直す効用を持つ"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_11.
kg:op_51 prop:content "移住者が自治会や地域理解を深める資料として一面有効な手段だ"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "取り組みたい集落があれば出前講座的に関わることは現実的だ"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_7.
kg:op_53 prop:content "これまで集落支援員を活用し移住者へのフォローと集落との橋渡しを行ってきた"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "共働き家庭の増加により放課後の受皿拡大が効果的だ"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:st_12 rdfs:label "駒井江美子議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_55 prop:content "少子化と核家族化で放課後の過ごし方に困る子供が増えている"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_12.
kg:op_56 prop:content "放課後子ども教室と合わせないと見守り需要を満たせない状況である"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "放課後児童クラブだけでも時間帯や日取りの受入れはまだ十分ではない"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "既存クラブへの支援拡充と新規参入支援で受皿確保を進めたい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "空き校舎や未利用施設の提供も視野に民間参入しやすい条件整備を進める"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "統合後おおむね5年は見守り型を維持しその後の体験型移行を準備する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "移住した子育て世帯の経済的不安を軽減し安心して子育てできる環境を支援する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "学校から放課後児童クラブ等への移動で保護者負担の軽減を図っている"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "老朽化施設の更新と空き校舎の有効活用という二つの課題を同時に解決することが重要だ"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:st_13 rdfs:label "今野博義議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_64 prop:content "要望を盛り込んだ改修費が高額となり大幅縮小案が示された"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_13.
kg:op_65 prop:content "蕨岡では講堂的設備が整えられず地域活動に支障が出る懸念がある"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_13.
kg:op_66 prop:content "地域の要望を反映させるため各地区4回の改築検討委員会を開いた"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "大規模イベントは隣接体育館の活用を想定している"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "企画係が全体調整役となり関係係で進捗確認と情報共有を行っている"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "変更案について地区と合意形成した上で令和6年度工事完了を目指す"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "空き校舎をビジネス拠点として活用し企業誘致と起業者支援につなげたい"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "事業者選定はプロポーザルによる公募形式を予定している"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "旧校舎の活用には地域貢献に理解のある事業者に入居してもらいたい"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "大規模スペースは事業者負担の改修可能性も視野に企業誘致を進めたい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
