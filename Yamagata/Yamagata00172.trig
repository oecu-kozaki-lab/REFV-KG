    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "洋上風力発電は海域を利用することによる漁業などへの影響はもちろん、部材の多さや事業規模の大きさから、地元経済にも大きな影響を与えることが予想され"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "洋上風力発電は海域を利用することによる漁業などへの影響はもちろん、部材の多さや事業規模の大きさから、地元経済にも大きな影響を与えることが予想され"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "町長はようやく事業が本格的にスタートする、超低周波音の影響や景観など、事業に対する多くの心配や不安の声も寄せられている"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_7;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "町長はようやく事業が本格的にスタートする、超低周波音の影響や景観など、事業に対する多くの心配や不安の声も寄せられている"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "能代市のエネルギー産業政策課の話では、エネルギーのまちづくりを目指す能代市の方針に市民の理解は進んでおり、不安に思われることがある健康被害はないということであります"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "能代観光協会は、洋上風力発電事業が始まってから、まちは視察団の増加、湾岸エリアの活気、プラス観光の増加、宿泊、食事予約の増加が見込まれる変化が起こっていると説明していて"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "能代観光協会は、洋上風力発電事業が始まってから、まちは視察団の増加、湾岸エリアの活気、プラス観光の増加、宿泊、食事予約の増加が見込まれる変化が起こっていると説明していて"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "能代観光協会は、洋上風力発電事業が始まってから、まちは視察団の増加、湾岸エリアの活気、プラス観光の増加、宿泊、食事予約の増加が見込まれる変化が起こっていると説明していて"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "能代観光協会は、洋上風力発電事業が始まってから、まちは視察団の増加、湾岸エリアの活気、プラス観光の増加、宿泊、食事予約の増加が見込まれる変化が起こっていると説明していて"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "能代観光協会は、洋上風力発電事業が始まってから、まちは視察団の増加、湾岸エリアの活気、プラス観光の増加、宿泊、食事予約の増加が見込まれる変化が起こっていると説明していて"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "町長はようやく事業が本格的にスタートする、超低周波音の影響や景観など、事業に対する多くの心配や不安の声も寄せられている、そうした不安の払拭に努めたいと"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "法定協議会の意見取りまとめの中でも示している発電事業者による漁業振興・共生策等を通じて、発電事業者と共存共栄が実現可能であるかという観点で判断されています"@ja.
<< kg:id_1 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "なお、漁業への影響に関しては、今後漁業影響調査が行われることで詳細に示されていくこととなると思っております"@ja.
<< kg:id_1 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "今後、発電事業者が実施する事前の環境影響評価により調査、シミュレーション等をしっかり行った上で影響がないと判断されることで、建設に着手することとなっております"@ja.
<< kg:id_1 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "町としても国や県と連携して、事業完了まで責任を持って見守りを続けるものと考えております"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "発電事業者と異常発生時の運転停止措置を含めた協定締結など、町としての対応もしっかり行っていきたいと考えております"@ja.
<< kg:id_1 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "県では酒田港風力発電事業者協議会と連携し、地元企業向けのセミナーを開催しておりますし"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "地元でも先行区域に学ぶ研修会を行っております"@ja.
<< kg:id_1 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "秋田県では、風力発電事業における情報共有や勉強会の開催、周辺産業の創出に向け"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "技術屋さんの養成はやっぱり必要だと思うのです。...長期的に見て、メンテナンス作業もいずれ必要になってくる"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_30;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "これからは場合によって遊佐町自ら作成して、高速道路が通る町であることをアピールする必要があると思います"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "３者が抱えている地域課題や生活、組織課題を、提携と交流を通じて解決していきたいという願いがあったものであります"@ja.
<< kg:id_24 prop:effect kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "さきに申し述べた石けん運動や月光川上流区域でのアルミ工場の移転問題など、町民の環境問題の意識の大いなる高まりに貢献していただきました"@ja.
<< kg:id_24 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "生活クラブがそれを支えて実現し、そしてその来た皆さんの熱意、農業やってみたい、応援してみたいという方は、遊佐町にも援農という形でおいでいただいている"@ja.
<< kg:id_24 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "今後につきましても、共同宣言を推進させるため、まちづくり、そして環境、農業振興の３部会を核に事業を展開して"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "これは乱開発を防止し、水脈を守るために買取りをした胴腹滝上流部の山林を町民と生活クラブの連携によって、共存の森として設置し"@ja.
<< kg:id_29 prop:contermeasure kg:id_31 >>
    prop:text-txt_contents "現在は、下草刈り、枝払い、植生調査、森の散策等、森に親しむということを一つのテーマとして、主にソフト事業を中心に実施しております"@ja.
<< kg:id_29 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "今後の事業展開として、農業体験等を交えた森づくり事業を実施していきたいと検討中であります"@ja.
<< kg:id_29 prop:effect kg:id_33 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "共存の森についてのソフト事業ということでございまして、...現地まで交通手段が容易でない山の奥というようなところもありますし、あとさらに現場で実際このソフト事業に取り組む段階でのスタッフの作業ということの観点でも、やはり実際事業自体が少人数の体制で実施しているような状況でございます"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "特に冬期間の登下校における安全対策をどのようにされているかについて伺います"@ja.
<< kg:id_34 prop:effect kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "特に待合所が未設置のバス停については、住宅や私有地の前にバス停があったり、道路の幅の狭い場所だったりと、待機場所を設置する敷地を確保することが困難な場所がほとんどであった"@ja.
<< kg:id_34 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "６月から８月にかけて、バス停留所の設置状況を調査させていただきました"@ja.
<< kg:id_34 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "10月に入りましてから、統合して初めての冬を迎える前に、スクールバスの運行状況や待合所の整備、登下校時の安全対策等についての地区ごとに、区長の皆様と意見交換をさせていただきました"@ja.
<< kg:id_34 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "除雪につきましては集落内で燃料費の補助である自主除雪制度を活用した協力をお願いしたところであります"@ja.
<< kg:id_34 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "街灯の整備につきましては、保護者を含め、集落で協議した上で要望いただくようお願いしているところであります"@ja.
<< kg:id_34 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "例年、通学路の安全確保のため、遊佐町通学路安全推進会議を開催しており、こちらにつきましては10月に国、県、町の道路管理担当者及び警察等の関係機関と合同点検を実施し"@ja.
<< kg:id_34 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "産業課よりいただいた情報を小中学校に伝達して、小中学校においては保護者にメールで一斉送信により、各家庭でのスクールバス下車後も含め、登下校の送迎等の協力をお願いしている"@ja.
<< kg:id_34 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "また、中学校においては、授業が終了後、保護者が迎えに来る時間まで学校で待機させることができるような対応もしております"@ja.
<< kg:id_34 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "スクールバス運行に関わる安全対策としては、運行管理に関するマニュアルを作成し、運転手と共有し、置き去り防止も含めて、月例で運転手間でのミーティングも開催しているところであります"@ja.
<< kg:id_45 prop:cause kg:id_46 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "都市部から地方への移住が活発になるにつれ、時として移住後のミスマッチということも生じています。そこで、移住者に向け、事前に集落や地域の慣習やルールなどを知ってもらうために、集落の教科書などと呼ばれるガイドブック作りが各地で始まっています"@ja.
<< kg:id_45 prop:effect kg:id_47 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "このガイドブック作りの過程では、もとからの住民が話し合う機会が設けられます。このことから必然的に、自らがこれまで住んできた集落や地域を見詰め直すことになり"@ja.
<< kg:id_45 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "移住相談においても、集落の環境や行事、自治会費などの問合せもあることから、移住定住を希望する人が、自治会や地域の理解を深めるための資料として、地区の習慣や行事などが確認できる、いわゆる集落の教科書を作成することは、一面有効な手段であるとは考えております"@ja.
<< kg:id_45 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "遊佐町では、これまで集落支援員を配置し、活用し、移住者へのフォローと集落との橋渡し役として、移住者のサポートを行ってまいりました"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "子育てを取り巻く環境は、全国的な人口減少、核家族化や共働き世帯の増加などにより大きく変化してきております"@ja.
<< kg:id_50 prop:cause kg:id_52 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "少子化の影響で近所に住んでいる子供がいなくて、放課後の過ごし方に困る子供たちがいること、核家族化でおうちに誰もいないお子さんが増えている現状を見ると"@ja.
<< kg:id_50 prop:effect kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "見守りが必要な児童は放課後児童クラブだけでは充足することができず、放課後子ども教室を合わせないと充足できないことが課題として確認されております"@ja.
<< kg:id_50 prop:effect kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "土曜日や長期休暇、平日で午後６時以降の時間帯など、放課後子ども教室でカバーできない時間帯や日取りなどは放課後児童クラブのみで十分カバーできておらず"@ja.
<< kg:id_50 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "放課後児童クラブについては、既存クラブへ町が支援を拡充することや、民間事業者の新規開設に向ける各種支援を行うことを基本的な考えとしながら"@ja.
<< kg:id_50 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "空き校舎の活用や町の未利用施設等の提供も視野に置きながら、民間事業者が容易に参入できるよう条件の整備を進めることとしております"@ja.
<< kg:id_50 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "統合からおおむね５年は現存の見守り型を維持し、その間地域と連携した事業実施を模索しながら運営体制や内容の見直しを図り、５年後の体験型への移行準備を進めることとしております"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "町外より移住された子育て世帯に対し子育て世帯移住奨励金として、子供１人当たり月額１万円を３年間交付し、新天地での子育てにかかる経済的な不安を少しでも軽減し"@ja.
<< kg:id_58 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "学校、教育委員会等と協力し、学校から放課後児童クラブ等への移動はスクールバスを利用するなどし、保護者の負担を軽減するよう取組を行っております"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "空き校舎への移転によって、老朽化した蕨岡、高瀬、まちづくりセンターの更新と、空き校舎を有効活用し、町全体の施設保有量を減らすという２つの課題を解決できることが重要であると考えております"@ja.
<< kg:id_61 prop:effect kg:id_63 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "要望を網羅する形で概算の工事費の精査を行いましたが、遊佐町総合発展計画の第８期実施計画策定において事業費の全体調整を行う過程で事業費の減額が必要となったところであります"@ja.
<< kg:id_61 prop:effect kg:id_64 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "蕨岡に関しては、２階にあった190平方メートルの研修室スペースはあるものの、１階の改修エリアには現まちづくりセンターのような広さの講堂スペースはありません"@ja.
<< kg:id_61 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "実施計画業務に地区の皆様の要望を反映させたいとの考えで、９月までに各地区４回の改築検討委員会を開催し、要望を取りまとめてきました"@ja.
<< kg:id_61 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "これまで講堂で行ってきた規模のイベントを行う際は、現在社会体育施設として使用している体育館、隣接する体育館の活用を想定しております"@ja.
<< kg:id_61 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "企画係が全体調整役となり、各係所管部分の進捗確認と情報共有を目的に、関係係職員で構成する、空き校舎利活用調整会議を設け、これまで３回開催しております"@ja.
<< kg:id_61 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "実施設計の業務期間として、当初の12月上旬から２月末までの延長を予定しております。変更案に対する両地区の皆さんとの合意形成を行った上で、予定どおり令和６年度の工事完了及び移転に向け進めていきたい"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "貸しオフィスとして利用する理由は、空き校舎をビジネスの拠点として事業者に活用していただき、企業誘致と起業者支援につなげていきたいという狙いがあります"@ja.
<< kg:id_69 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "ご質問の事業者の採択は、プロポーザルによる公募形式を予定しております"@ja.
<< kg:id_69 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "旧校舎ですので、地域貢献に理解のある事業者に入居していただきたいと考えております"@ja.
<< kg:id_69 prop:contermeasure kg:id_73 >>
    prop:text-txt_contents "町として行う校舎教室の改修は、貸しオフィスとして有償で貸し出すために、建築基準法で建物用途を学校から貸しオフィスに変更することに必要な工事を想定しております"@ja.
<< kg:id_69 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "特に広いスペースを保有するとなれば、事業者の改修費を負担するといった可能性も視野に入れながら、今後、企業誘致にも努めてまいりたい"@ja.
}
