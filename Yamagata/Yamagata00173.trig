kg:st_1 rdfs:label "五十嵐英治議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "公演実現まで大きなトラブルだった"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "酒田市を内外に発信する大きな成果だった"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "座長の病状で座員や関係者に不安が広がった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "村上幸太郎教育長"@ja.
kg:st_2 rdfs:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_4 prop:content "両公演とも高い評価を受けたと感じている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "国内外に酒田をPRできたと思う"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "継承の決意が新たになったことが大きな成果"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "丸山至市長"@ja.
kg:st_3 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_7 prop:content "ポーランドの皆さんに相当な感動を与えた"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "黒森歌舞伎は地域の誇りであり地域の宝だと認識を強めた"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:st_4 rdfs:label "丸山市長"@ja.
kg:st_4 rdfs:type cls:st_17.
kg:op_9 prop:content "地域全体で力強く取り組みたい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:st_5 rdfs:label "五十嵐良弥新座長"@ja.
kg:st_5 rdfs:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_10 prop:content "市関係者の物心両面の支えが公演実現の心の支えになった"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "国や県に積極的に支援を要請した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "要望があれば市として相談に乗りたい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "法律改正で設置が努力義務となり導入が加速度的に進んだ"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "学校と地域住民が力を合わせる体制になる"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "小中一貫教育と両輪で行うと効果が倍増する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "導入には教育振興基本計画への位置づけが必要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:st_6 rdfs:label "佐藤喜紀議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_17 prop:content "人口減少で国内旅行者が減少している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_6.
kg:op_18 prop:content "限られた旅行需要で地域間競争が激化している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_6.
kg:op_19 prop:content "観光客が酒田の魅力を感じられる環境が整いつつある"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:st_7 rdfs:label "佐々木好信交流推進調整監"@ja.
kg:st_7 rdfs:type cls:st_38.
cls:st_38 rdfs:label "職員"@ja.
kg:op_20 prop:content "酒田さんぽが観光情報発信の中心"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_7.
kg:op_21 prop:content "農業就業人口の減少が課題"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:op_22 prop:content "就業者の高齢化が進んでいる"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:op_23 prop:content "漁獲量の減少傾向も深刻さを増している"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_6.
kg:op_24 prop:content "情報発信強化は認知度向上と酒田ファン増加につながる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_6.
kg:st_8 rdfs:label "竹越攻征農林水産部長"@ja.
kg:st_8 rdfs:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_25 prop:content "カレンダーに行事を並べ総点検して来年度事業に向かいたい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_8.
kg:op_26 prop:content "公務員だけでなくプロの技術を予算をつけて得るのもよい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_8.
kg:op_27 prop:content "情報発信ツールの利用頻度に偏りが大きい"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "一部の市民の利用にとどまっている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:st_9 rdfs:label "梅木和広危機管理監"@ja.
kg:st_9 rdfs:type cls:st_38.
kg:op_29 prop:content "できる限り多様な方法で情報発信している"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_9.
kg:op_30 prop:content "新たな情報発信手段も検討し多くの人が情報に触れる機会を増やすことが重要"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_9.
kg:op_31 prop:content "知名度向上と酒田ファンづくりを通じ経済発展と振興につなげたい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "直接触れる機会の提供で酒田のよさを紹介している"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "現時点では市の情報を一括掲載する自治体アプリ導入は考えていない"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "今後環境の変化等を踏まえながら少し勉強したい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:st_10 rdfs:label "菊池裕基健康福祉部長"@ja.
kg:st_10 rdfs:type cls:st_18.
kg:op_35 prop:content "高齢者や認知症の方が増加しており利用者が増える可能性が高い"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_10.
kg:op_36 prop:content "認知症の方の増加も頭に入れておく必要がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_10.
kg:op_37 prop:content "市民後見人養成支援のため中核機関となるセンター設置検討を進めたい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_10.
kg:op_38 prop:content "情報交換会を発展させネットワーク構築に結びつけたい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_10.
kg:op_39 prop:content "医療機関を介して後見人変更を訴える相談事例があった"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_10.
kg:op_40 prop:content "相談内容を聞き家庭裁判所につなぐ対応をとっている"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_10.
kg:op_41 prop:content "広範囲の降雨で支流氾濫と最上川洪水が起きる危険がある"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "流域型洪水の怖さを改めて認識した"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_9.
kg:op_43 prop:content "今年度策定した洪水タイムラインに沿って対応する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_9.
kg:op_44 prop:content "国は住民主体の防災対策に転換していくとしている"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_9.
kg:op_45 prop:content "自分の命は自分で守る意識の啓発が必要"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_9.
kg:op_46 prop:content "住民が主体的に行う活動を支援して防災力を高めたい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_9.
kg:op_47 prop:content "緊急避難場所としての指定を今後も拡大する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_9.
kg:op_48 prop:content "資機材整備は保管場所や費用面が課題"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_9.
kg:op_49 prop:content "企業との災害協定も含め取り組みたい"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_9.
kg:st_11 rdfs:label "武田恵子議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_50 prop:content "周辺住民は改善と不安解消を求めている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_11.
kg:op_51 prop:content "周辺住民は日常的に不安を抱いている"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_11.
kg:op_52 prop:content "一目でわかるよう早急に改善したい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "総合相談窓口がわかるようにはっきり掲載したい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "改めて広報にも特集として掲載したい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "酒田市としても速やかに策定したい"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "既存のネットワーク協議会を法定協議会としても機能するよう活用したい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:op_57 prop:content "速やかに全庁に情報提供し所管施設等へ注意喚起した"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_10.
kg:op_58 prop:content "今後の検討課題である"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_10.
kg:op_59 prop:content "今回のことはいい教訓であり見直しを検討したい"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_10.
kg:st_12 rdfs:label "阿部勉企画部長"@ja.
kg:st_12 rdfs:type cls:st_18.
kg:op_60 prop:content "企業の理解を深めるためセミナーや視察を通じ支援したい"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_12.
kg:op_61 prop:content "国や県に要望を継続する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_12.
kg:op_62 prop:content "地方への研究機関誘致は難しい"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_12.
kg:op_63 prop:content "連合の取り組みを通じ情報収集に努める"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_12.
kg:op_64 prop:content "庄内沿岸域は洋上風力の適地"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_12.
kg:op_65 prop:content "関連企業集積と新たな雇用が期待される"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_12.
kg:op_66 prop:content "漁業者第一で良好な関係が最重要"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_12.
kg:op_67 prop:content "関連インフラ整備をしっかり国県に要望したい"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_12.
kg:st_13 rdfs:label "矢口明子副市長"@ja.
kg:st_13 rdfs:type cls:st_40.
cls:st_40 rdfs:label "副市長"@ja.
kg:op_68 prop:content "酒田駅大学線7便が常時混雑している"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_13.
kg:op_69 prop:content "今年度は大学前で3回満車で乗れない人がいた"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_13.
kg:op_70 prop:content "来年度以降はタクシーによる代行輸送を検討する"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_13.
kg:op_71 prop:content "道路事情で住宅街の中まで入れない事情がある"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_13.
kg:op_72 prop:content "2022年3月をめどに路線新設や経路変更も含めて取り組む"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_13.
kg:op_73 prop:content "調整済みで速やかに移設する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_13.
kg:st_14 rdfs:label "齋藤直議員"@ja.
kg:st_14 rdfs:type cls:st_16.
kg:op_74 prop:content "広告収入増は大きな経費負担の解消につながる"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_14.
kg:op_75 prop:content "来年以降は車体広告の予約を3件いただいている"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_13.
kg:op_76 prop:content "今まで以上に広告募集を考えていきたい"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_13.
kg:op_77 prop:content "昨年より被害額が増えたのは架空請求詐欺による高額被害のため"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_13.
kg:op_78 prop:content "民生委員に見守りや訪問活動での啓発協力をお願いしてきた"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_13.
kg:op_79 prop:content "留守番電話設定を民生委員からも注意喚起してもらう"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_13.
kg:op_80 prop:content "複層的な啓発強化に取り組みたい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_13.
kg:op_81 prop:content "車内広告は早期実現に向け公共交通担当部門と連携したい"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_13.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "これは日本とポーランドとの国交樹立100周年を記念した歴史的な公演となりました"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "黒森歌舞伎ポーランド公演が２カ年の準備期間を経て、11月２日から９日の日程で実施されました"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "公演が近づいた９月下旬に、それまでポーランド公演実現に向けさまざまな推進活動の中心となって行動してきた冨樫久一座長が脳疾患で倒れ"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "酒田黒森歌舞伎ポーランド公演が一躍大きな話題となったことは、まさに酒田市を内外に情報発信することができた大きな成果であります"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "厳しい病状のため、座員や関係者の間には大きな不安が広がりました"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "両公演とも、観客数やレセプションでの観客の皆さんからの感想をいただきましたけれども、高い評価をいただいたのではないかと感じているところでございます"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:text-txt_contents "公演終了後には観客からのスタンディングオベーションが鳴りやまなかったと伺っております"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "ポーランド国内のラジオで放送されておりますし、日本では12月13日の深夜に放送されましたＮＨＫのラジオ深夜便でも取り上げてもらうなど、国内外に酒田をＰＲできたと思っております"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "黒森歌舞伎妻堂連中の皆さんが、今回のポーランド公演を通して、これまで受け継がれてきた黒森歌舞伎をこれからもしっかり継承していこうという決意を新たにされたということが、今回の公演の大きな成果ではないかと考えているところでございます"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "ポーランドの皆さんにも相当な感動を与えて帰ってくることができました"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "まさにこの黒森歌舞伎、これは地域の誇りであるし、地域の宝だという認識を改めて強くしたところでございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "国内外、それから県内外の民間企業、そして国・県・市、さらには市民の皆さんから事業への支援をいただきながら、ポーランド公演に向けてぜひ力強く、地域全体で取り組んでまいりたい所存である"@ja.
<< kg:id_1 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "市関係者の方々より、物心両面にわたるお力添えや御指をいただきましたことが座員や関係者にとっては非常に大きな心の支えとなり、今回のポーランド公演を無事に実現することができた"@ja.
<< kg:id_1 prop:contermeasure kg:id_15 >>
    prop:text-txt_contents "１つは勘亭流の書家によるワークショップ"@ja.
<< kg:id_1 prop:contermeasure kg:id_16 >>
    prop:text-txt_contents "２つ目には黒森小学校とポーランドの小学校との両方で行います夢傘福アートプロジェクト"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:text-txt_contents "３つ目は押絵倶楽部によりますワークショップ"@ja.
<< kg:id_1 prop:contermeasure kg:id_18 >>
    prop:text-txt_contents "４つ目は歌舞伎体験というワークショップですけれども、こういったさまざまなワークショップを行っております"@ja.
<< kg:id_1 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "国や県に積極的に支援を要請した結果、例えば国際交流基金、日本万国博覧会記念基金、三井住友海上文化財団あるいは丸高歴史文化財団より助成金をいただいていると伺っております"@ja.
<< kg:id_1 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "そういったような交流に対する要望が出てきた場合には、市としても相談に乗ってまいりたいなと考えているところでございます"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "平成29年３月の法律改正で、コミュニティ・スクールの設置については教育委員会の努力義務に課せられているという状況でございます"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "学校運営協議会という組織を中核として、学校と地域住民が力を合わせて学校の運営に取り組む地域とともにある学校をより進化させることができる体制"@ja.
<< kg:id_21 prop:effect kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "小中一貫教育とコミュニティ・スクールを両輪で行っているという自治体はかなりございます。一緒にやって効果が倍増するという部分もございます"@ja.
<< kg:id_21 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "コミュニティ・スクールをスタートさせるためには、教育振興基本計画にきちんと計画を位置づける必要がございます"@ja.
<< kg:id_21 prop:contermeasure kg:id_26 >>
    prop:text-txt_contents "具体的には組織づくりや委員の任命、報酬の準備"@ja.
<< kg:id_21 prop:contermeasure kg:id_27 >>
    prop:text-txt_contents "市長部局との連携"@ja.
<< kg:id_21 prop:contermeasure kg:id_28 >>
    prop:text-txt_contents "学校の管理職や教職員、学校協議会委員への周知と研修"@ja.
<< kg:id_21 prop:contermeasure kg:id_29 >>
    prop:text-txt_contents "保護者の方、地域住民の方、関係団体に向けてどのような制度なのかということをしっかりと説明する必要がある"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "人口減少に伴う国内旅行者の減少"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "限られた旅行需要で地域間競争が激化しております"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "観光客が最適に酒田の魅力を感じられる環境が整いつつあると感じております"@ja.
<< kg:id_33 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "本市の観光情報サイトであります「酒田さんぽ」につきましては、月平均４万4,000件のアクセスがあるという状況でございます。酒田の観光における情報発信の中心"@ja.
<< kg:id_33 prop:contermeasure kg:id_36 >>
    prop:text-txt_contents "英語版の観光情報サイト「Ｓａｋａｔａ　Ｔｏｕｒｉｓｍ」というのをつくっております"@ja.
<< kg:id_33 prop:contermeasure kg:id_37 >>
    prop:text-txt_contents "五カ国語に対応している「ルートガイドｆｏｒ庄内・酒田」"@ja.
<< kg:id_33 prop:contermeasure kg:id_38 >>
    prop:text-txt_contents "ことしの３月、23基の観光施設を紹介する「まちなかサイン」を設置しております"@ja.
<< kg:id_33 prop:contermeasure kg:id_39 >>
    prop:text-txt_contents "市のホームページ、パンフレットなどにつきましても段階的に多言語化をしている状況でございます"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "農業就業人口は減少傾向にあり"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "就業者の高齢化率も50％を超える"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "漁業後継者不足が深刻な問題となっており、漁獲量においても減少傾向にあります"@ja.
<< kg:id_45 prop:effect kg:id_46 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "酒田産農水産品について情報発信の強化や生産者、市民との連携を強化することにより、酒田産農水産品の認知度向上や酒田ファンをふやすことへつながるものと考えられます"@ja.
<< kg:id_45 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "カレンダーにそういった行事を並べて、横から縦から斜めから、裏側、上から、あらゆる角度で総点検をして来年度の事業に向かっていきたい"@ja.
<< kg:id_45 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "プロの技術というのを少し予算をつけながら得てみるのもいいのではないかなと考えております"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "年齢や職業、行政への関心度の違いにより、利用頻度については偏りが大きく"@ja.
<< kg:id_49 prop:effect kg:id_51 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "一部の市民の利活用にとどまっているように感じられます"@ja.
<< kg:id_49 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "広報紙、市ホームページ、ＳＮＳ、コミュニティＦＭ、メールマガジン、各報道機関へのプレスリリースや記者会見など、できる限り多様な方法での情報発信を行っております"@ja.
<< kg:id_49 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "今後も新たな情報発信手段なども検討し、より多くの人が情報に触れる機会をふやすことが重要であると考えているところでございます"@ja.
<< kg:id_54 prop:effect kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本市の知名度の向上、そして酒田ファンづくり、そしてひいては本市の経済発展、本市の振興に結びつけていきたい"@ja.
<< kg:id_54 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "パンフレットや映像などだけでなくて直接、酒田の文化や歴史、それから日本酒等の特産品に触れる機会を提供して、酒田の町のよさを紹介し、発信をしているところでございます"@ja.
<< kg:id_54 prop:contermeasure kg:id_57 >>
    prop:text-txt_contents "市のフェイスブックでも同時にさまざまな交流の状況について、市民、市内外の皆さんに紹介をさせていただいているところでございます"@ja.
<< kg:id_58 prop:cause kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "平成28年10月の全面リニューアルによりまして、スマートフォンでの閲覧に最適化したページを導入しているところでございます"@ja.
<< kg:id_58 prop:cause kg:id_60 >>
    prop:text-txt_contents "県内の自治体広報をまとめて掲載しているポータルサイト、ヤマガタイーブックスですとか、全国の自治体広報を閲覧できるアプリ、マチイロというアプリ、ここにも本市広報紙のＰＤＦデータを提供しておりまして"@ja.
<< kg:id_61 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "今後環境の変化等も踏まえながら、少し勉強してまいりたいなと思っております"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "高齢者や認知症の方が増加している状況から、今後一層成年後見制度を活用する方がふえる可能性は高いものと認識をしております"@ja.
<< kg:id_63 prop:cause kg:id_65 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "現在認知症の方というのが、介護保険課で把握している方では4,700人"@ja.
<< kg:id_66 prop:contermeasure kg:id_67 >>
    prop:text-txt_contents "現在市ホームページ、それから福祉課窓口でのリーフレットの配布、また個別の相談による後見人制度の周知を図っておりまして、ほかにも出前講座で自治会やコミュニティ振興会などに出向いて制度の説明を行っているところでございます"@ja.
<< kg:id_66 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "まずはそれらを支援するための中核機関となります成年後見支援センターの設置検討を進めていきたいと考えております"@ja.
<< kg:id_66 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "今後はこの情報交換会を発展させ、地域連携ネットワークの構築に結びつけていきたいと考えております"@ja.
<< kg:id_70 prop:effect kg:id_71 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "申立人が後見人を変更してほしいと訴えているとの相談を受けた事例はございます"@ja.
<< kg:id_70 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "後見人業務のチェック機能を持つ家庭裁判所につなぐ対応をとっております"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "広範囲で雨が降ることによって、支流での氾濫とともに最上川の洪水が発生し、大規模な災害に至る危険性があり"@ja.
<< kg:id_73 prop:effect kg:id_75 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "大規模な災害に至る危険性があり、改めて流域型洪水の怖さを認識したところであります"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:text-txt_contents "本市最上川下流域水位が最も上昇したのは台風通過後の13日午前11時から午後２時ごろにかけてでございました"@ja.
<< kg:id_73 prop:contermeasure kg:id_78 >>
    prop:text-txt_contents "最上川上流部の降雨量や今後の雨雲の動き、各水位観測所での水位変化などの情報を国土交通省酒田河川国道事務所や山形地方気象台から収集し"@ja.
<< kg:id_73 prop:contermeasure kg:id_79 >>
    prop:text-txt_contents "最大６時間先の水位予測について情報を共有して、市民の避難誘導準備に備えたところであります"@ja.
<< kg:id_73 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "今年度は関係機関とともに洪水タイムラインを策定しており、災害対応に当たっては当該タイムラインに沿った防災行動をとることとしています"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "突発的に発生する激甚な災害への行政主導のハード対策・ソフト対策に限界が生じており、住民主体の防災対策に転換していく"@ja.
<< kg:id_83 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "市民一人一人が防災意識を持ち、自分の命は自分で守るという意識の啓発に努めていく必要があります"@ja.
<< kg:id_83 prop:contermeasure kg:id_85 >>
    prop:text-txt_contents "市の総合防災訓練や地域の防災訓練に取り入れていただきながら、発災後の避難所運営にかかわる地域の主体性を醸成しているところであります"@ja.
<< kg:id_83 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "自主防災組織による地区防災計画の策定や避難地図の作成など、住民が主体的に行う活動をしっかりと支援していくことにより、防災力を高めていきたい"@ja.
<< kg:id_87 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "津波浸水区域以外でも、洪水の避難対応を含め、緊急避難場所としての指定については今後も拡大してまいります"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "生活に必要な資機材等の整備については、市が直接導入するには保管場所や費用面などの課題もある"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "応援協定などによって企業から支援していただく部分も検討していきたい"@ja.
<< kg:id_92 prop:effect kg:id_93 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "暴風や積雪時に不安を感じた市民は、改善と不安解消を求めているのです"@ja.
<< kg:id_92 prop:effect kg:id_94 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "不審者が入ってくるのではないか、小動物のすみかになってしまうのではないか、事件や事故など起きなければいいが、という不安を抱いている市民"@ja.
<< kg:id_95 prop:contermeasure kg:id_96 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "市のホームページのトップページにあります「住宅・都市環境」というボタンみたいなものがあります。このカテゴリーの中に「空き家」としっかり明記をして、空き家という文字を併記し、一目でわかるようにすることで、ワンクリックで空き家のページにたどり着くような改善を、早急にしたい"@ja.
<< kg:id_95 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "このサイトの相談先一覧に市の空き家の総合相談窓口がわかるようにはっきりと掲載をしてまいりたい"@ja.
<< kg:id_95 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "改めて広報にも特集として掲載をし、空き家の現状、相談窓口の周知等にしっかりと、広報紙の面でも努めてまいりたい"@ja.
<< kg:id_99 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "この空家等対策計画につきましては、今後速やかに酒田市としても策定してまいりたい"@ja.
<< kg:id_99 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "この組織を母体に法定協議会としても機能するように何とか活用をしていきたい"@ja.
<< kg:id_102 prop:effect kg:id_103 >>
    prop:text-txt_contents "12月14日現在の今回の細菌性赤痢の発生数は23名、内訳といたしましては、保育園児が13名、その家族が９名、それからその他１名"@ja.
<< kg:id_102 prop:contermeasure kg:id_104 >>
    prop:text-txt_contents "12月４日中に庄内保健所で保育所に入り状況を確認し、消毒方法などを指導する"@ja.
<< kg:id_102 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "健康課からは速やかに全庁に情報提供をするとともに、施設の所管課等に対しては、所管施設等への注意喚起や感染予防に関する周知の依頼をお願いしております"@ja.
<< kg:id_102 prop:contermeasure kg:id_106 >>
    prop:text-txt_contents "教育委員会では、小中学校長宛てに注意喚起及び消毒方法について通知を出しております"@ja.
<< kg:id_102 prop:contermeasure kg:id_107 >>
    prop:text-txt_contents "子育て支援課では、保育園、認定こども園、それから児童センター、子育て支援センターやファミリーサポートセンター、それから学童保育所、また、介護保険課のほうでも、市内の入所施設や通所施設等に情報提供と注意喚起をしております"@ja.
<< kg:id_102 prop:contermeasure kg:id_108 >>
    prop:text-txt_contents "市民に対しては、ホームページで同様の周知を図っているところでございます"@ja.
<< kg:id_109 prop:effect kg:id_110 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "庁内各課から全ての施設まで注意喚起が行き届かない面があったことから、このことにつきましては、今後の検討課題とさせていただきたい"@ja.
<< kg:id_109 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "今回のことにつきましては、いい教訓になろうと考えております。こういったことも含めて見直し等も検討していきたい"@ja.
<< kg:id_112 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "水素エネルギーに関するセミナーの開催や先進地の視察などを通じまして、水素を活用する社会環境の整備及びサプライチェーンの構築につながる取り組みを支援していきたい"@ja.
<< kg:id_112 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "水素技術の開発研究及び先進的モデルの確立に向けた実証実験の促進について、国や県に対しまして要望を継続してまいります"@ja.
<< kg:id_115 prop:cause kg:id_116 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "実用化の見通しはいまだ立っておらず、地方への研究機関の誘致は難しい"@ja.
<< kg:id_117 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "本市としましては、実証実験等進展を注視するなど、今後も連合の取り組みを通じ、情報収集に努めてまいります"@ja.
<< kg:id_119 prop:cause kg:id_120 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "庄内沿岸海域の風速が年平均で７ｍ以上となっており、洋上風力発電の事業化の目安とされる風速を超えていることから、庄内の沿岸域は、洋上風力の適地とされております"@ja.
<< kg:id_119 prop:effect kg:id_121 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "洋上風力発電事業が進むことで、関連します企業集積も図られ、新たな雇用も生まれることが期待されます"@ja.
<< kg:id_119 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "直接的な影響を受けます漁業者の理解を何よりも重要と位置づけまして、県とより一層の連携を図ってまいりたい"@ja.
<< kg:id_119 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "洋上風力発電事業にあわせまして、関連するインフラの整備についてもしっかりと国・県に対して要望をしてまいりたい"@ja.
<< kg:id_124 prop:cause kg:id_125 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "酒田駅大学線のかんぽの宿発７便、夕方の５時５分発ですけれども、この便が工業団地や大学からの帰宅者で常時混雑しております"@ja.
<< kg:id_124 prop:effect kg:id_126 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "今年度は、大学前で３回満車で乗れなくなった人がいることを確認しております"@ja.
<< kg:id_124 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "来年度以降は、この酒田駅大学線の７便について、タクシーによる代行輸送を検討しております"@ja.
<< kg:id_128 prop:cause kg:id_129 >>
    prop:text-txt_contents "るんるんバスの経路は、民間路線バスとの競合をなるべく避けるように"@ja.
<< kg:id_128 prop:cause kg:id_130 >>
    prop:text-txt_contents "デマンドタクシーの利用可能なエリアともすみ分けを行っております"@ja.
<< kg:id_128 prop:cause kg:id_131 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "道路幅員や交通事情を勘案し、住宅街の中までなかなか入れないという事情もございます"@ja.
<< kg:id_128 prop:contermeasure kg:id_132 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "2022年３月をめどに進めておりますバス路線再編の検討の中で、路線の新設や経路の変更、またバス停の配置も含めて取り組んでいきたい"@ja.
<< kg:id_133 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "このバス停の移設について、自治会長、近隣住民とは調整済みでありまして、適切に周知期間を設けた上で速やかに移設をいたします"@ja.
<< kg:id_135 prop:effect kg:id_136 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "広告収入の増は大きな経費負担の解消につながると思います"@ja.
<< kg:id_135 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "来年以降は、るんるんバスへの車体広告の予約を３件いただいております"@ja.
<< kg:id_135 prop:contermeasure kg:id_138 >>
    prop:text-txt_contents "今年度からは、広告で得られた収入を原資としたバスの時刻表も作成させていただきまして"@ja.
<< kg:id_135 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "さらに、バス停への広告の募集も検討しておりまして、今まで以上に広告募集、何ができるか考えていきたい"@ja.
<< kg:id_140 prop:effect kg:id_141 >>
    prop:text-txt_contents "令和元年11月末現在の酒田警察署管内における特殊詐欺被害認知件数は３件、被害額は約2,500万円となっております"@ja.
<< kg:id_140 prop:effect kg:id_142 >>
    prop:text-txt_contents "被害者は、３名とも高齢者でありました"@ja.
<< kg:id_140 prop:cause kg:id_143 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "昨年に比べ被害額がふえたのは、架空請求詐欺による高額被害が発生したためです"@ja.
<< kg:id_144 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "民生委員を対象とした研修会や出前講座を通じて、特殊詐欺の手口などの情報共有のほか、見守りや訪問活動の中で特殊詐欺防止の啓発活動などへの協力をお願いしてきております"@ja.
<< kg:id_144 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "この固定電話の常時留守番電話設定による被害防止の呼びかけを、警察官の巡回だけではなく、高齢者、障がい者の状況を把握している民生委員の皆様からも訪問の折に注意喚起していただきますよう、改めてお願いをしてまいります"@ja.
<< kg:id_144 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "地域包括センターなどにも同様の協力をお願いするなど、複層的な啓発強化に取り組んでいきたい"@ja.
<< kg:id_144 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "車内広告につきましては、早期の実現に向けて、市の公共交通担当部門と連携していきたいと思っております"@ja.
}
