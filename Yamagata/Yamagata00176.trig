kg:st_1 rdfs:label "市原栄子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "公的サービス利用のため実質的な取得強要になると危惧する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "カード未保有者が不利益を受けるおそれを懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "多くの情報が1枚に集約されることで悪用リスクが高まると懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "標準化の押しつけが自治体独自施策を妨げると懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "システムに行政を合わせることで独自サービスが抑制されると危惧する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "統一標準化は住民サービスを低下させると指摘する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地方自治の多様性をなくすと指摘する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "自治体の自主性を失わせると懸念する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "情報共有だけでなく情報抑制にもなりかねないと指摘する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "情報集積が進むほどリスクが高まると懸念する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "情報は集積されるほど攻撃対象になりやすいと指摘する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "一度漏れた情報は回収不能で深刻だと指摘する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "個人情報集積はプライバシー侵害の危険を高めると懸念する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "個人データの照会が監視社会につながる危険を指摘する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "本人の知らないところで不利益利用される懸念を示す"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "デジタル化の進展に対応して保護ルールを強化すべきと主張する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "市の条例改正を行うべきと求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "国に法整備を求めるべきと主張する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "制度の認知不足が受給につながっていないと指摘する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "所得制限も受給の壁になっていると指摘する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "手続の煩雑さで申請を諦める事例があると指摘する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "介護の現場と連携し制度周知と申請支援を進めるべきと求める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "判断や手続が難しいため申請支援体制が必要と主張する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "高齢者向け福祉制度の講習会を行うべきと提案する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "旧式の間取りが高齢単身者に不向きだと指摘する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "バリアフリーでない住宅が高齢者の居住に不適切と指摘する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "現在の単身用住宅は高齢者の一人暮らしに無理があると述べる"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "空きのある住宅をバリアフリー化し単身高齢者向けに転用すべきと提案する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "酒田市在住2人の保証人要件はハードルが高いと指摘する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "保証人要件のため入居を断念する人がいると指摘する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "金銭保証と身元引受を分ければ頼みやすくなると提案する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "金銭保証は機関保証を活用できるよう制度変更を求める"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "高齢化に伴い孤独死問題への対応が必要と指摘する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "高齢者に限らず全住戸に見守り機能を付けるべきと提案する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "高齢者にはわずかな段差でも大きな負担になると指摘する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "階段負担が閉じこもりと身体機能低下を招くと指摘する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "高齢者や子育て世代のためにスロープ化を求める"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:st_2 rdfs:label "阿部秀徳議員"@ja.
kg:st_2 rdf:type cls:st_16.
kg:op_38 prop:content "変異株により第4波が懸念されると指摘する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "供給不足で接種体制の見通しが不透明だと問題提起する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "副作用を想定した準備が必要と指摘する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "接種の有無による差別への対応が必要と指摘する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:st_3 rdfs:label "白畑真由美健康福祉部子ども・家庭支援調整監"@ja.
kg:st_3 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_42 prop:content "接種しない人への誹謗中傷を防ぐため分かりやすい広報で呼びかける"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:st_4 rdfs:label "宮崎和幸企画部長"@ja.
kg:st_4 rdf:type cls:st_32.
kg:op_43 prop:content "石炭輸入減が貨物量減少の大きな要因と説明する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:op_44 prop:content "全国的な電源構成の変化が酒田港貨物量に影響したと説明する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:op_45 prop:content "発電所の稼働率低下が石炭輸入減につながったと説明する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_4.
kg:op_46 prop:content "その他日用品の輸出減が大きく影響したと説明する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "経済情報誌では中国市場の競争激化の影響が報じられていると説明する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "コロナでコンテナ物流が停滞したと説明する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:op_49 prop:content "コンテナ不足が海上運賃上昇を招いていると説明する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "荷主企業の掘り起こしを進める必要があると述べる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "輸出拡大は恒常的課題として取り組む必要があると述べる"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:op_52 prop:content "コロナ禍でも工夫してポートセールスを進めるとする"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:op_53 prop:content "サブ港湾確保やトライアル助成をPRし利用を促すと説明する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:op_54 prop:content "商談会を通じて酒田港利用拡大につなげたいと述べる"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_4.
kg:op_55 prop:content "再開に向けて船会社と協議していくと説明する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_4.
kg:op_56 prop:content "大規模プロジェクト推進には基地港湾が不可欠と説明する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:op_57 prop:content "基地港湾指定には県の港湾計画変更が必要と説明する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_4.
kg:op_58 prop:content "2つ以上の事業者利用要件のため促進区域指定が必要と説明する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_4.
kg:op_59 prop:content "大規模風車は環境や景観への影響が大きいと懸念する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "環境や景観への影響を考慮した施設規模が示されると説明する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_4.
kg:op_61 prop:content "伏流水への影響評価を事業者に求めると説明する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_4.
kg:op_62 prop:content "事業開始前から撤去後まで継続的なモニタリングを求めると説明する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:st_5 rdfs:label "矢口明子副市長"@ja.
kg:st_5 rdf:type cls:st_32.
kg:op_63 prop:content "重複路線が運行効率を下げていると説明する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_5.
kg:op_64 prop:content "料金体系の違いが利用者に分かりにくさを生んでいると説明する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_5.
kg:op_65 prop:content "高齢者の利用負担からデマンド拡大の声があると説明する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_5.
kg:op_66 prop:content "経費増と運転手不足が公共交通維持の課題と説明する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_5.
kg:op_67 prop:content "持続可能性と利便性向上のため路線改編を進めると説明する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_5.
kg:op_68 prop:content "分かりやすく効率的な路線体系へ改編すると説明する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_5.
kg:op_69 prop:content "郊外部は基本的にデマンドタクシー運行エリアとすると説明する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_5.
kg:op_70 prop:content "通学通勤にも使えるよう運行日を拡充すると説明する"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_5.
kg:op_71 prop:content "利用しやすさ向上のため運行時刻と乗降場所を見直すと説明する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_5.
kg:op_72 prop:content "観光客利便性のためJRとの接続を維持すると説明する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_5.
kg:op_73 prop:content "観光客の利便性向上のため観光地経由便を設定すると説明する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_5.
kg:op_74 prop:content "分かりやすい乗換環境のためバス停を集約すると説明する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_5.
kg:op_75 prop:content "生活利用者の増加が今後見込めないと説明する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_5.
kg:op_76 prop:content "利用者増には観光利用促進が重要と述べる"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_5.
kg:op_77 prop:content "観光需要を見込んだ列車運行を働きかけると説明する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_5.
kg:op_78 prop:content "多くの関係機関と連携し利用促進と利便性向上要望を継続すると説明する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_5.
kg:st_6 rdfs:label "齋藤美昭議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_79 prop:content "大会中止や練習制限などスポーツ界への打撃が大きいと指摘する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_6.
kg:op_80 prop:content "象徴的な影響として東京大会延期を挙げる"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_6.
kg:op_81 prop:content "各競技団体の大会中止を余儀なくされたと指摘する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_6.
kg:op_82 prop:content "練習できない状況が続いたと指摘する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_6.
kg:st_7 rdfs:label "本間優子教育次長"@ja.
kg:st_7 rdf:type cls:st_32.
kg:op_83 prop:content "施設利用再開後は感染対策を徹底してきたと説明する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_7.
kg:op_84 prop:content "大会主催者がガイドラインに沿って開催していると説明する"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_7.
kg:op_85 prop:content "感染対策の長期化で健康二次被害が懸念されると説明する"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_7.
kg:op_86 prop:content "形を変えて地域のにぎわいとコミュニティ維持につなげると説明する"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_7.
kg:op_87 prop:content "大会規模を絞って安全安心な運営を目指すと説明する"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_7.
kg:op_88 prop:content "コロナ対策を講じ安全安心な大会運営を行うと説明する"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_7.
kg:st_8 rdfs:label "安藤浩夫議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_89 prop:content "人口減少で地域役員の担い手不足が深刻化していると指摘する"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_8.
kg:op_90 prop:content "地域行事や事業の担い手不足が生じていると指摘する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_8.
kg:op_91 prop:content "担い手不足が防災活動や支え合い活動に支障を生じさせていると指摘する"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_8.
kg:op_92 prop:content "住民主体で地域課題を考え実行することが郷土愛と誇りにつながると述べる"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_8.
kg:op_93 prop:content "集落支援員は今後の地域リーダー育成につながる機会だと評価する"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_8.
kg:op_94 prop:content "地域おこし協力隊が地区をよい方向へ変えてきていると評価する"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_8.
kg:op_95 prop:content "協力隊の活動が地区の参加意識や情報発信を高めていると評価する"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_8.
kg:st_9 rdfs:label "大沼康浩地域創生部長"@ja.
kg:st_9 rdf:type cls:st_32.
kg:op_96 prop:content "イベント中止が新規移住相談者減少の理由と説明する"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_9.
kg:op_97 prop:content "イベント全体では移住相談者数が減少したと説明する"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_9.
kg:op_98 prop:content "日常的な相談人数は増えており移住ニーズの高まりを認識していると述べる"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_9.
kg:op_99 prop:content "リモートワークしながら暮らすライフスタイルを後押しすると説明する"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_9.
kg:op_100 prop:content "お試し住宅でリモートワークを体験できるよう整備すると説明する"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_9.
kg:op_101 prop:content "個々のニーズに応じたきめ細かな対応が必要と説明する"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_9.
kg:op_102 prop:content "酒田ならではの体験を移住検討者への強みにしたいと述べる"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_9.
kg:op_103 prop:content "年3回の交流会で移住後のつながりづくりを応援していると説明する"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_9.
kg:op_104 prop:content "地域が移住者をスムーズに受け入れられるよう紹介や橋渡しを行うと説明する"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_9.
kg:st_10 rdfs:label "大谷謙治市民部長"@ja.
kg:st_10 rdf:type cls:st_32.
kg:op_105 prop:content "3地域とも人口減少と少子高齢化が進行していると説明する"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_10.
kg:op_106 prop:content "地域の魅力と特色を生かした地域社会づくりを進める方針と説明する"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_10.
kg:op_107 prop:content "若者定住対策はなお十分な歯止めに至っていないと認識する"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_10.
kg:op_108 prop:content "新たな移住者が地域への刺激となり人口流出の歯止めになると期待する"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_10.
kg:op_109 prop:content "協力隊の活躍を高く評価していると述べる"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_10.
kg:op_110 prop:content "コミュニティビジネスや移動販売で新たな芽が出始めていると評価する"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_10.
kg:op_111 prop:content "景観を維持する建築への助成制度を運用していると説明する"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_10.
kg:op_112 prop:content "歴史文化を生かした散策とイベントで城下町の魅力を発信していると説明する"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_10.
kg:op_113 prop:content "連携の成果が少しずつ見えてきていると説明する"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_10.
kg:op_114 prop:content "交流が続き平田地域の産業振興の一助になっていると説明する"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_10.
kg:op_115 prop:content "丁寧に住民意見を集めて原案づくりを進めると説明する"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_10.
kg:op_116 prop:content "地域の歴史資源を大切にしたいという意見を参考にすると述べる"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_10.
kg:op_117 prop:content "重要な景観資源を保全し散策を楽しめる環境整備を進めると述べる"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_10.
kg:op_118 prop:content "歴史公園周辺の景観に合うよう修繕を検討していると説明する"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_10.
kg:op_119 prop:content "景観を意識した取組を新しい計画で進めたいと述べる"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_10.
kg:op_120 prop:content "竹林の乱立と荒廃は地域課題の一つと認識する"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_10.
kg:op_121 prop:content "タケノコ活用は有害鳥獣対策にもつながると考える"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_10.
kg:op_122 prop:content "里山の遊休資源活用として加工品試作が進んでいると説明する"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_10.
kg:op_123 prop:content "地域おこし協力隊が竹あかり試作に取り組む計画と説明する"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_10.
kg:op_124 prop:content "熊の食害は大きな問題と認識する"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_10.
kg:op_125 prop:content "幼竹収穫と活用は新収入と地域活性化につながると考える"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_10.
kg:st_11 rdfs:label "田中愛久総務部長"@ja.
kg:st_11 rdf:type cls:st_32.
kg:op_126 prop:content "歳出増と税収横ばいで財政状況が悪化していると説明する"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_11.
kg:op_127 prop:content "財政悪化の要因は社会保障費の受益と負担のバランスにあると説明する"@ja.
kg:op_127 rdf:type cls:opinion.
kg:op_127 prop:speaker kg:st_11.
kg:op_128 prop:content "コロナ禍が国家財政の異常事態をさらに増幅させていると認識する"@ja.
kg:op_128 rdf:type cls:opinion.
kg:op_128 prop:speaker kg:st_11.
kg:op_129 prop:content "基金は財源不足への備えとして重要と説明する"@ja.
kg:op_129 rdf:type cls:opinion.
kg:op_129 prop:speaker kg:st_11.
kg:op_130 prop:content "基金は公共施設老朽化対策にも使う目的があると説明する"@ja.
kg:op_130 rdf:type cls:opinion.
kg:op_130 prop:speaker kg:st_11.
kg:op_131 prop:content "人口減少による税収減への対応にも必要と説明する"@ja.
kg:op_131 rdf:type cls:opinion.
kg:op_131 prop:speaker kg:st_11.
kg:op_132 prop:content "豪雪や災害対応のためにも一定程度の蓄えが必要と説明する"@ja.
kg:op_132 rdf:type cls:opinion.
kg:op_132 prop:speaker kg:st_11.
kg:op_133 prop:content "同用途施設の複数存在を踏まえ統廃合後に重点投資すべきと説明する"@ja.
kg:op_133 rdf:type cls:opinion.
kg:op_133 prop:speaker kg:st_11.
kg:st_12 rdfs:label "竹越攻征農林水産部長"@ja.
kg:st_12 rdf:type cls:st_32.
kg:op_134 prop:content "酒田市の強みはまさに農林水産業にあると述べる"@ja.
kg:op_134 rdf:type cls:opinion.
kg:op_134 prop:speaker kg:st_12.
kg:op_135 prop:content "若者のニーズに合った施策で就業定着を図るべきと述べる"@ja.
kg:op_135 rdf:type cls:opinion.
kg:op_135 prop:speaker kg:st_12.
kg:op_136 prop:content "若者の就農支援策としてもっけ田農学校などを進めると説明する"@ja.
kg:op_136 rdf:type cls:opinion.
kg:op_136 prop:speaker kg:st_12.
kg:op_137 prop:content "施策に合ったニーズ対応として土づくりなどを進めると説明する"@ja.
kg:op_137 rdf:type cls:opinion.
kg:op_137 prop:speaker kg:st_12.
kg:op_138 prop:content "具体案はないが誘致に取り組んでいきたいと述べる"@ja.
kg:op_138 rdf:type cls:opinion.
kg:op_138 prop:speaker kg:st_4.
kg:op_139 prop:content "庄内地方重要事業として合同庁舎建設を要望したいと述べる"@ja.
kg:op_139 rdf:type cls:opinion.
kg:op_139 prop:speaker kg:st_4.
kg:op_140 prop:content "JRも含め景観に配慮した整備が進んでいると説明する"@ja.
kg:op_140 rdf:type cls:opinion.
kg:op_140 prop:speaker kg:st_4.
kg:op_141 prop:content "ハードだけでなくソフト面のにぎわい創出も重要と述べる"@ja.
kg:op_141 rdf:type cls:opinion.
kg:op_141 prop:speaker kg:st_4.
kg:st_13 rdfs:label "後藤仁議員"@ja.
kg:st_13 rdf:type cls:st_16.
kg:op_142 prop:content "以前は駐輪場の景観が良くない時期があったと指摘する"@ja.
kg:op_142 rdf:type cls:opinion.
kg:op_142 prop:speaker kg:st_13.
kg:op_143 prop:content "整理作業員の増員で整頓を進め景観を損なわないようにすると説明する"@ja.
kg:op_143 rdf:type cls:opinion.
kg:op_143 prop:speaker kg:st_4.
kg:op_144 prop:content "グランドデザインでも屋根なし駐輪場の課題を整理していると説明する"@ja.
kg:op_144 rdf:type cls:opinion.
kg:op_144 prop:speaker kg:st_4.
kg:op_145 prop:content "駅前広場改修の際に屋根付駐輪場整備に取り組みたいと述べる"@ja.
kg:op_145 rdf:type cls:opinion.
kg:op_145 prop:speaker kg:st_4.
kg:op_146 prop:content "駅前全体の利便性向上を図る形でJRと協議していると説明する"@ja.
kg:op_146 rdf:type cls:opinion.
kg:op_146 prop:speaker kg:st_4.
kg:op_147 prop:content "補助制度を活用して整備を進めたいと述べる"@ja.
kg:op_147 rdf:type cls:opinion.
kg:op_147 prop:speaker kg:st_4.
kg:st_14 rdfs:label "藤井昌道建設部長"@ja.
kg:st_14 rdf:type cls:st_32.
kg:op_148 prop:content "短時間の強い雨が冠水と浸水被害を引き起こしたと説明する"@ja.
kg:op_148 rdf:type cls:opinion.
kg:op_148 prop:speaker kg:st_14.
kg:op_149 prop:content "道路冠水で多くの通行止めが発生したと説明する"@ja.
kg:op_149 rdf:type cls:opinion.
kg:op_149 prop:speaker kg:st_14.
kg:op_150 prop:content "通学路冠水で学校が登校時間を繰り下げたと説明する"@ja.
kg:op_150 rdf:type cls:opinion.
kg:op_150 prop:speaker kg:st_14.
kg:op_151 prop:content "住宅などで計27件の被害報告があったと説明する"@ja.
kg:op_151 rdf:type cls:opinion.
kg:op_151 prop:speaker kg:st_14.
kg:op_152 prop:content "雨水幹線やポンプ施設や側溝整備を進めていると説明する"@ja.
kg:op_152 rdf:type cls:opinion.
kg:op_152 prop:speaker kg:st_14.
kg:op_153 prop:content "地盤沈下地区の道路冠水や住宅浸水対策を最優先にすると説明する"@ja.
kg:op_153 rdf:type cls:opinion.
kg:op_153 prop:speaker kg:st_14.
kg:op_154 prop:content "幹線となる雨水排水施設整備を進めていると説明する"@ja.
kg:op_154 rdf:type cls:opinion.
kg:op_154 prop:speaker kg:st_14.
kg:op_155 prop:content "緊急自然災害防止対策事業でポンプ更新を実施すると説明する"@ja.
kg:op_155 rdf:type cls:opinion.
kg:op_155 prop:speaker kg:st_14.
kg:op_156 prop:content "浸水解消に向けポンプ能力増強を予定していると説明する"@ja.
kg:op_156 rdf:type cls:opinion.
kg:op_156 prop:speaker kg:st_14.
kg:op_157 prop:content "富士見町地区の浸水被害軽減のため排水路断面を大きくすると説明する"@ja.
kg:op_157 rdf:type cls:opinion.
kg:op_157 prop:speaker kg:st_14.
kg:op_158 prop:content "市民の安心につながる支援策の第一歩として検討すると説明する"@ja.
kg:op_158 rdf:type cls:opinion.
kg:op_158 prop:speaker kg:st_14.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今後運転免許証や各種免許、国家資格、自治体検診などの健康管理サービスなど、多くのサービスとの連携を進めるとしています。こうした一連の動きは、マイナンバーカードを持たないと公的なサービスを含めた様々なサービスが受けられない状況をつくり出し、実質的にカード取得を強要することになるではないかと危惧するものであります。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "こうした一連の動きは、マイナンバーカードを持たないと公的なサービスを含めた様々なサービスが受けられない状況をつくり出し、実質的にカード取得を強要することになるではないかと危惧するものであります。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "多くの情報が１枚のカードでできることは、逆に他者から悪用される危険もはらんでいるのではないでしょうか。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "この自治体クラウドを活用するために、主要業務の標準化を推進するとしています。"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "自治体クラウドによって、システムに行政の仕事内容を合わせることが目的となり、自治体独自のサービスが抑制されてしまうのではないかと危惧するものです。"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "このような自治体への統一・標準化の押しつけは、サービス低下を引き起こし"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地方自治の多様性をなくし、自治体の自主性を失わせるものではないでしょうか。"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "地方自治の多様性をなくし、自治体の自主性を失わせるものではないでしょうか。"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "システムの統一で情報共有がしやすくなるとも言っていますが、実際には、情報抑制にもなりかねません。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "行政機関は国内最大のデータホルダーであり、これからはマイナンバーカードやマイナポータルにも多くの情報が集積されていきます。"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "情報は集積されるほど利用価値が高まり、攻撃されやすくなると言われています。"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "また、一度漏れた情報は流通・売買され、取り返しがつきません。"@ja.
<< kg:id_16 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "プライバシー侵害のおそれが高まることになるのです。"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "また、これらの個人データが調査機関へ照会されない保証はなく、監視社会へ導く危険性もあります。"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "現在のＩＴ社会では、国家や企業などに集積された個人データが、本人の知らないところでやり取りされ、プロファイリングやスコアリングされ、本人に不利益な使い方をされる懸念もあります。"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "だからこそ、個人情報保護のルールを強化する必要があるのではないでしょうか。"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "市の条例の改正や国にきちんとした法の整備を行うべきと申し上げるべきと考えますが"@ja.
<< kg:id_25 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "市の条例の改正や国にきちんとした法の整備を行うべきと申し上げるべきと考えますが"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "この制度は高齢で介護認定を受けていても、また障害者手帳を持っていなくても受けられる制度であるということがあまり知られていないという状況です。"@ja.
<< kg:id_29 prop:cause kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "所得制限もあり、手続も煩雑であることから"@ja.
<< kg:id_29 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "手続も煩雑であることから途中で諦めてしまう、このような事例が全国で出ていると言われています。"@ja.
<< kg:id_29 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "市は積極的にケアマネジャーや地域包括支援センターと連携し、制度の周知を図っていく、また必要な方は申請まで持っていく、このようなことをする必要があるではないでしょうか。"@ja.
<< kg:id_29 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "該当するかどうかの判断や申請時の手続の煩雑さもあり、申請のサポート体制が必要であると考えます。"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "高齢者でも利用できる福祉施策の講習会、これをすべきではないかと考えますが"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "多くが古いメゾネット、昔は長屋タイプと言っておりましたが、こういったタイプであり、２階建てで、１階はダイニングキッチンと風呂場、寝室は２階というふうな間取りになっています。"@ja.
<< kg:id_37 prop:cause kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "風呂場も旧式であり、バリアフリーという概念からは程遠いと言わざるを得ません。"@ja.
<< kg:id_37 prop:effect kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "このタイプでは、高齢者が１人で安全に安心して暮らしていくには無理があることを以前から申し上げてまいりました。"@ja.
<< kg:id_37 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "１階などのバリアフリー化を進めて単身高齢者向けへ変更し、入居を進めていくべきではないかと考えますが"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "本市では入居に当たり、酒田市在住の連帯保証人を２人立てることになっています。"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "保証人が見つからずに、居住を諦めたというお話も聞いています。"@ja.
<< kg:id_42 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "保証人について、まず家賃の滞納などの保証と居住者に何かあったときのために手助けをしていただける方と分けることはできないのでしょうか。"@ja.
<< kg:id_42 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "滞納などの金銭的な問題については保証人協会のような制度を使えるようにし"@ja.
<< kg:id_47 prop:effect kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "高齢化が進む中で、孤独死の問題が言われています。"@ja.
<< kg:id_47 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "見守り機能を全部屋につけることも必要ではないかと考えますが"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "今、高齢化が進んでいることで、少しの階段でも高齢者にとっては大変な苦労となります。"@ja.
<< kg:id_50 prop:effect kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "このことで高齢者が閉じ籠もりになり、さらに体が弱っていく、こうした悪循環を生まないためにも"@ja.
<< kg:id_50 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "１階階段のスロープ化はできないかということです。"@ja.
<< kg:id_54 prop:effect kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "感染力が大変強い変異株が全国各地で確認をされ、緊急事態解除後の経済活動が活発化すれば、５月後半にはリバウンド、もしくは第４波が懸念されるという研究データが専門家の研究チームから示されております。"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "県内へのワクチン配分の見通しは、４月中旬まで２万8,000人弱分、接種を受けられる割合というのが県全体で7.8％でしかなく、以降の予定は未定であると報道されております。"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "ワクチン接種に対しては、個人差はあるものの、副作用、副反応とも申しますけれども、それが出る可能性があり得ると思います。"@ja.
<< kg:id_60 prop:effect kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "接種の有無による風評差別など、懸念されるところであります。"@ja.
<< kg:id_58 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "市ホームページや酒田市ＬＩＮＥ公式アカウント、ツイッター、市広報など、その時点で最も有効な方法を活用し、分かりやすい広報により市民の皆様に呼びかけてまいりたいと考えております。"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "その大きな要因でございますが、酒田共同火力発電所の燃料となります石炭の輸入が減少したもので"@ja.
<< kg:id_63 prop:cause kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "全国的に天然ガス火力発電及び再生可能エネルギーによる電力供給が増加した一方で、石炭火力発電による電力供給が減少し"@ja.
<< kg:id_63 prop:cause kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "酒田共同火力発電所の稼働率も低下したためとお聞きしているところでございます。"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "コンテナ貨物量が減少した要因は、輸出におけるその他日用品が2,912ＴＥＵの減少となっており"@ja.
<< kg:id_67 prop:cause kg:id_69 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "経済情報誌等によりますと、中国における紙おむつ市場の競争激化の影響があるとも報道されております"@ja.
<< kg:id_70 prop:cause kg:id_71 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "新型コロナウイルス感染症の影響によりまして、全世界的にコンテナの動きが悪くなったため"@ja.
<< kg:id_71 prop:effect kg:id_72 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "コンテナ不足により海上運賃が高騰していると報道されてございます。"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "このように、酒田港は、大口の荷主企業の動向により貨物量が左右されやすいことから、新たな荷主開拓と酒田港からの輸出拡大は恒常的な課題でございまして"@ja.
<< kg:id_73 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "新たな荷主開拓と酒田港からの輸出拡大は恒常的な課題でございまして"@ja.
<< kg:id_73 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "新年度は、新型コロナウイルスの状況を勘案しながらということになりますけれども、“プロスパーポートさかた”ポートセールス協議会において、オンラインを活用したセミナーなど工夫して取り組んでまいります。"@ja.
<< kg:id_73 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "特に、酒田港の利用割合が低い県内の内陸部や、県外の港湾を利用している企業には、メインとなる利用港湾とは別にサブの利用港湾の確保の視点や、トライアル助成などをＰＲしながら利用を促してまいりたいと考えてございます。"@ja.
<< kg:id_73 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "中国との貿易に意欲のある企業を募って商談会を開催をし、酒田港の利用拡大につなげていきたい"@ja.
<< kg:id_73 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "ＣＯ２削減のために環境負荷の少ない貨物輸送への転換、トラックドライバーの担い手不足などの社会情勢なども踏まえまして、一昨年より国内ＲＯＲＯ船の誘致に取り組んでおりました"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "大規模な洋上風力発電プロジェクトを推進するためには、洋上風力発電施設の建設、メンテナンスの拠点となる基地港湾が不可欠でございます。"@ja.
<< kg:id_80 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "国から基地港湾の指定を受けるためには、幾つかの基準、要件等がございますけれども、その中でも港湾管理者である山形県が港湾法第３条の３第１項で定める港湾計画というものを変更する必要がございます。"@ja.
<< kg:id_80 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "基地港湾指定には、２つ以上の洋上風力発電事業者の港湾利用が見込まれることが要件の一つとされていることから、遊佐町沖、それから酒田市沖が海洋再生可能エネルギー発電設備の整備に係る海域の利用の促進に関する法律に基づく促進区域、これに指定される必要がございます。"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "現在、陸上に建てられている風車の倍規模のものが想定されていると聞いております。その場合、環境や景観に対する影響はかなり大きいのではないかと思われます。"@ja.
<< kg:id_84 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "通常、環境影響評価を進める過程において環境や景観に与える影響を考慮した施設規模が事業者から示されることとなります。"@ja.
<< kg:id_84 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "鳥海山からの伏流水への影響について、調査や予測及び評価を実施することが盛り込まれている"@ja.
<< kg:id_84 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "サケなどの漁業対象魚種について、事業開始前から事業終了に伴う設備撤去及びその後の一定期間を通した継続的な漁業影響調査、モニタリング、こういったものの実施を事業者に求めていくこととしているところでございます。"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "各路線が部分的に重複していることによる運行効率の低下が生じております。"@ja.
<< kg:id_89 prop:cause kg:id_91 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "運賃体系は民間事業者が距離制、市営バスが定額制で料金差が生じており、これも利用者にとって分かりにくいものとなっております。"@ja.
<< kg:id_89 prop:cause kg:id_92 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "バス停まで歩くことやバス停で待つことがつらいという高齢者を中心にデマンドタクシーの運行エリアとしての拡大を求める声があります。"@ja.
<< kg:id_89 prop:cause kg:id_93 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "公共交通全体では、バス運転手の人件費増加などを背景に運行経費が増加しており、将来的には運転手不足も懸念されております。"@ja.
<< kg:id_89 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "令和４年度の公共交通の改編に当たっては、持続可能な公共交通と利用者の利便性の向上、これを一体的に実現することを目指して、市街地エリアはるんるんバスの全面的な改編を行い"@ja.
<< kg:id_89 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "酒田駅前、中町周辺、日本海総合病院の３拠点は必ず経由するようにし、分かりやすく、かつ効率的な路線体系に変更することを考えております。"@ja.
<< kg:id_89 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "郊外と総合支所エリアは、基本的にはデマンドタクシーの運行エリアとし"@ja.
<< kg:id_89 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "通学や通勤にも利用できるよう運行日を週３日から平日５日間にし"@ja.
<< kg:id_89 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "さらに朝１便の運行時刻を早めて、指定乗降場所を増やすなどの拡充を図ります。"@ja.
<< kg:id_99 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "現在に引き続いて、改編後もそのいなほ３号、それとるんるんバス、酒田駅大学線が接続するようにいたします。"@ja.
<< kg:id_99 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "山王くらぶ、日和山公園、さかた海鮮市場も経由するようにして観光客の利便性の向上を図りたいと考えております。"@ja.
<< kg:id_99 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "酒田駅前の再開発事業においてバスベイを整備することにより、バス停を集約して利用者に分かりやすくしたいと考えております。"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "少子化などの影響に伴い、陸羽西線における通学や通勤目的の生活利用者の増加は、今後なかなか見込めないところであります。"@ja.
<< kg:id_103 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "陸羽西線の利用者数増加のためには、観光利用による利用促進を図っていくことが重要であると考えております。"@ja.
<< kg:id_103 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "今後も観光利用を見込んだ運行をＪＲ東日本仙台支社に働きかけてまいります。"@ja.
<< kg:id_103 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "多くの関係機関が連携して観光利用の促進、利便性向上のための運行ダイヤ改善の要望活動などなどの取組を継続していきたいと考えております。"@ja.
<< kg:id_108 prop:effect kg:id_109 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "今年度は新型コロナウイルス感染症の影響によりスポーツ界では大きな打撃を受けました。"@ja.
<< kg:id_108 prop:effect kg:id_110 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "本来であれば昨年開催されるはずだった東京オリンピック・パラリンピックの延期"@ja.
<< kg:id_108 prop:effect kg:id_111 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "スポーツの各競技団体も大会の開催中止を余儀なくされました。"@ja.
<< kg:id_108 prop:effect kg:id_112 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "小学校のスポーツ少年団、中体連、高体連をはじめ、社会人も練習ができないなどの練習環境も大変な状況でした。"@ja.
<< kg:id_108 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "休館解除後は、各施設において手洗いや換気の実施、ソーシャルディスタンスの確保、プレー時以外でのマスクの着用、手指消毒用のアルコールを設置するなど、貼り紙や施設管理人からの呼びかけもしてもらうなど、注意喚起を実施しております。"@ja.
<< kg:id_108 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "大会等の開催に当たっては、競技ごとに大会開催ガイドラインなどが作成されており、大会主催者となる運営側でガイドラインに沿った大会を開催していただいております。"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "中長期にわたり感染症対策と向き合う中で運動不足から身体的及び精神的な健康を脅かす健康二次被害も懸念されています。"@ja.
<< kg:id_115 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "令和３年度に向けては、関係団体や地域の意見を取り入れ、現状ででき得るコロナ対策を講じ、開催時間や開催内容など形を変えて引き続き地域のにぎわいとコミュニティの維持につながるようなスポーツイベントとして開催していきたい"@ja.
<< kg:id_115 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "湊酒田つや姫ハーフマラソン大会に関しましては、ハーフ、10キロに限定してランナーを募集する予定でございます"@ja.
<< kg:id_115 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "会場入口での検温、２週間の体調管理チェックシートの提出の義務化、部門ごとに分けてスタートするウエーブスタート等を今後の会議で検討していきながら、安全安心な大会運営を行っていきたい"@ja.
<< kg:id_120 prop:effect kg:id_121 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "自治会、コミュニティ振興会の役員の成り手不足"@ja.
<< kg:id_120 prop:effect kg:id_122 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "地域の行事や各種事業の担い手不足などにより"@ja.
<< kg:id_120 prop:effect kg:id_123 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "防災活動や支え合い活動に支障が出てきている地域もあり"@ja.
<< kg:id_124 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "自らの地域課題を住民で考え、郷土愛を醸造して実行することにより地域に誇りを持てることにつながり"@ja.
<< kg:id_124 prop:countermeasure kg:id_126 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "集落支援員を設置することにより今後の地域のリーダーとなる人材育成につながる機会と考えます"@ja.
<< kg:id_127 prop:countermeasure kg:id_128 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "私は、隊員が赴任してきてから徐々に地区がよい方向へ変わってきていると思われます。"@ja.
<< kg:id_127 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "新しい発想の祭りや伝承芸能、青沢獅子踊りの３年ぶりの復活、地区情報紹介のインターネット、ＳＮＳの活用による配信などがあり"@ja.
<< kg:id_130 prop:effect kg:id_131 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "その減少の理由は、首都圏での移住相談会などが相次いで中止になった影響によるものでございます。"@ja.
<< kg:id_130 prop:effect kg:id_132 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "令和元年度はイベントや窓口対応など全てを含めた新規の移住相談者人数は195名でした。それに対しまして、令和２年度は２月末時点で89名であり、減っております。"@ja.
<< kg:id_130 prop:effect kg:id_133 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "今年度は２月末時点で78人と、昨年度の相談人数59人を上回っている状況であり、コロナ禍における移住ニーズの高まりを認識しているところでございます。"@ja.
<< kg:id_134 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "補助の対象となる中古住宅等の改修経費としてインターネット環境の導入経費を追加いたします。リモートワークをしながら酒田で暮らすというライフスタイルを後押しする狙いがございます。"@ja.
<< kg:id_134 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "移住お試し住宅のインターネット環境整備であり、リモートワークをしながらの酒田での暮らしをお試し住宅の利用期間中に体験していただくためのものでございます。"@ja.
<< kg:id_137 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "移住相談窓口では、対応の中で移住者の方、一人一人に応じた志向やニーズを丁寧に酌み取りながら、酒田の持つ資源をお伝えし"@ja.
<< kg:id_137 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "若者世代を対象とした移住ツアーの中でも酒田らしい体験ができるようなコンテンツを検討してまいります。"@ja.
<< kg:id_140 prop:countermeasure kg:id_141 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "市では年３回の移住者交流会を開催し、移住後の人的ネットワークづくりを応援をしております。"@ja.
<< kg:id_140 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "コミュニティ振興会の方や地域おこし協力隊、集落支援員の方、そういった方々の御協力を賜るように御紹介をし、おつなぎするなどの地域が移住者をスムーズに受け入れることができるような施策については、市としてもできることを行ってまいります。"@ja.
<< kg:id_143 prop:effect kg:id_144 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "３地域ともに確かに人口減少に歯止めがかからないという状況がございまして、若年者比率も大きく落ち込み、少子高齢化が進行しているという状況でございます。"@ja.
<< kg:id_145 prop:countermeasure kg:id_146 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "３地域の持つ魅力や特色を明確にして、個性あふれ活力ある地域社会の実現に努めることとしたところでございます。"@ja.
<< kg:id_147 prop:effect kg:id_148 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "やはり八幡地域からの若者の流出や少子化への歯止めまでは至っていないという状況でございます。"@ja.
<< kg:id_149 prop:countermeasure kg:id_150 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "これらの移住者の方々は、過疎地域で人口減少が著しい地域においても、よい意味で地域に対しての刺激剤となっており、若者を含めた地域人口流出の歯止めになってくれるのではないかと期待をしているところでございます。"@ja.
<< kg:id_151 prop:countermeasure kg:id_152 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "やはり地域おこし協力隊の活躍については高く評価をしているところでございます。"@ja.
<< kg:id_151 prop:countermeasure kg:id_153 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "日向里かふぇといったコミュニティビジネスの立ち上げや、株式会社良品計画の初の試みとなる移動販売も試験的に実施するなど"@ja.
<< kg:id_154 prop:countermeasure kg:id_155 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "松山歴史公園周辺地区は、景観形成重点地域として指定をされており、当該地区における建築物の新築や増改築において景観を維持する部材を用いた場合には、一定の助成金額を受けられる地区となっております。"@ja.
<< kg:id_154 prop:countermeasure kg:id_156 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "歴史公園エリアを会場にした松山にぎわい創出事業、まつやま大手門くらふとフェアを開催しておりまして、上堰から總光寺までを巡る城下町散策ということも実施をしているところでございます。"@ja.
<< kg:id_157 prop:countermeasure kg:id_158 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "一昨年前より、ふれあい商工会主催により食を中心とした事業、わがままマルシェを立ち上げるなど、連携の成果が少しずつ見えてきております。"@ja.
<< kg:id_159 prop:countermeasure kg:id_160 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "農村での生活を体験した子供たちが成人し、平田地域や酒田の農産物を積極的に買い求めたり、何度も受入れ家庭を訪問するなど交流が続き、平田地域の産業の振興の一助ともなっているところでございます。"@ja.
<< kg:id_161 prop:countermeasure kg:id_162 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "地域協議会委員からの意見聴取や自治会長アンケート、地域住民ワークショップと様々な手法により丁寧に基礎的な資料となる住民意見を集めてきたところでございます。"@ja.
<< kg:id_161 prop:countermeasure kg:id_163 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "地域の歴史資源を大切にしたいという意見も出されておりますので、それらを参考にしながら、これから原案づくりを進めてまいりたい"@ja.
<< kg:id_164 prop:countermeasure kg:id_165 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "引き続き、景観助成制度を利用した町並みの保存を行っていくとともに、散策を楽しめる空間としての環境整備を考えてまいりたい"@ja.
<< kg:id_164 prop:countermeasure kg:id_166 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "藤公園の藤棚が大分老朽化してきているということがございまして、歴史公園周辺の景観にマッチさせるべく、現在、修繕等を検討しているところでございます。"@ja.
<< kg:id_167 prop:countermeasure kg:id_168 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "新しい計画の中では、景観や自然を満喫できる世代ごとのイベントや開放感あふれる眺海の森野外ステージの活用など、景観を意識した取組を進めていきたい"@ja.
<< kg:id_169 prop:effect kg:id_170 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "全国的には、やはり竹林の乱立で里山の荒廃につながる事例も多く報告されており、荒れた竹林は地域にとっても大きな課題の一つとなっております。"@ja.
<< kg:id_169 prop:countermeasure kg:id_171 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "タケノコを農産物として積極的に活用することにより、有害鳥獣対策にも我々もつながるものと考えているところでございます。"@ja.
<< kg:id_169 prop:countermeasure kg:id_172 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "ホワイト・グリーン・鳥海という団体が令和２年度から県事業を活用して、里山の遊休資源の活用を目的としたモウソウチクを使ったメンマ、それから、どんごえ、どんごいとも言いますけれども、イタドリです。などの塩蔵などの加工品を試作などをしている"@ja.
<< kg:id_169 prop:countermeasure kg:id_173 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "地域おこし協力隊員が令和３年度にモウソウチクを活用した竹あかりなどの試作に取り組む計画として伺っているところでございます。"@ja.
<< kg:id_169 prop:effect kg:id_174 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "タケノコの熊による食害は大きな問題となっており"@ja.
<< kg:id_175 prop:effect kg:id_176 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_125;
    prop:text-txt_contents "モウソウチクについては、幼竹を収穫することで青竹の増加を防ぎ、竹林を美しく保つことに役立つとともに、このような活動は里山での新たな収入や中山間地域の活性化につながるものと考えているところでございます。"@ja.
<< kg:id_177 prop:cause kg:id_178 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "国の財政状況は歳出が膨張を続け、税収が横ばいのままであるため、その差が開き続け"@ja.
<< kg:id_177 prop:cause kg:id_179 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_127;
    prop:text-txt_contents "悪化の要因といたしましては、社会保障費の受益と負担のバランスが悪いためであり"@ja.
<< kg:id_130 prop:effect kg:id_180 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "コロナ禍が国家財政の異常事態をさらに増幅させていることをひしと感じているところであります。"@ja.
<< kg:id_181 prop:countermeasure kg:id_182 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_129;
    prop:text-txt_contents "財政調整基金の積立て目的は、１つとしては、合併算定替え終了に伴います財源不足に備えること"@ja.
<< kg:id_181 prop:countermeasure kg:id_183 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_130;
    prop:text-txt_contents "２つ目といたしまして、公共施設等の老朽化対策に使うこと"@ja.
<< kg:id_181 prop:countermeasure kg:id_184 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "３つ目といたしまして、人口減少による税収減対策に使うこと"@ja.
<< kg:id_181 prop:countermeasure kg:id_185 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_132;
    prop:text-txt_contents "４番目といたしましては、豪雪や災害への対応と認識をしておるところでございます。"@ja.
<< kg:id_186 prop:countermeasure kg:id_187 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "施設の統廃合を進め、公共施設の総量削減を前提として、今後残すべき施設へ資金を投下する必要があると考えております。"@ja.
<< kg:id_188 prop:cause kg:id_189 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_134;
    prop:text-txt_contents "本市の強みは、まさに農林水産業と考えておりまして、丸山市長からの施政方針の中でも本地域の活力の源は農林水産業であると"@ja.
<< kg:id_190 prop:countermeasure kg:id_191 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_135;
    prop:text-txt_contents "新規就業者へ定着、強化していく"@ja.
<< kg:id_190 prop:countermeasure kg:id_192 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_136;
    prop:text-txt_contents "例えば農業でありますと、もっけ田農学校でありますとか"@ja.
<< kg:id_190 prop:countermeasure kg:id_193 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_137;
    prop:text-txt_contents "それから土づくりというのをやっていきますけれども"@ja.
<< kg:id_194 prop:countermeasure kg:id_195 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_138;
    prop:text-txt_contents "政府関係機関、研究機関、それから研修機関等の誘致にぜひ取り組んでいきたいなとは考えてございます。"@ja.
<< kg:id_194 prop:countermeasure kg:id_196 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_139;
    prop:text-txt_contents "国や県の施設を最適化する合同庁舎の建設、これについて今後、令和４年度の山形県の庄内地方重要事業の中でこれは一緒になって要望していきたい"@ja.
<< kg:id_197 prop:countermeasure kg:id_198 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_140;
    prop:text-txt_contents "駅舎についても耐震補強工事に併せて、外壁については、議員おっしゃるとおりに光の湊のＡ棟の低層部と色調を合わせていただけるなど、ＪＲ東日本からも景観については特段の御配慮をいただいているところでございます。"@ja.
<< kg:id_197 prop:countermeasure kg:id_199 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_141;
    prop:text-txt_contents "今後、地元商店街ですとか、高校生などと協力して、人でにぎわう景観というのもつくっていきたいなと考えてございます。"@ja.
<< kg:id_200 prop:cause kg:id_201 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_142;
    prop:text-txt_contents "以前、自転車の整理作業がうまくいかなく、駐輪場の景観がいかがなものかと思ったときもありました。"@ja.
<< kg:id_200 prop:countermeasure kg:id_202 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_143;
    prop:text-txt_contents "駐輪場の適切な利用につきましては、各高校のほうにもいろいろお願い、周知を図っているんですけれども、令和３年度につきましては、まちづくり推進課において整理作業員の増員のほうを皆様方のほうにお願いをしている"@ja.
<< kg:id_203 prop:cause kg:id_204 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_144;
    prop:text-txt_contents "駐輪場の現状につきましては、やはり雨とか雪とか天候に対しての対策が十分でないというような課題整理をしておりまして"@ja.
<< kg:id_203 prop:countermeasure kg:id_205 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_145;
    prop:text-txt_contents "今後、この駅前広場の改修をする際には、屋根付駐輪場の整備にもぜひ取り組んでいきたいと考えてございます。"@ja.
<< kg:id_203 prop:countermeasure kg:id_206 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_146;
    prop:text-txt_contents "周辺との景観ですとか歩行者、それから自動車、タクシーなど、駅前広場全体のこういった動線、こういったものを考慮して、駅前の利便性の向上が図られるようにＪＲ新潟支社と現在協議をしてございます。"@ja.
<< kg:id_203 prop:countermeasure kg:id_207 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_147;
    prop:text-txt_contents "国の補助制度を活用した整備を併せて行っていきたいと思っているところでございます。"@ja.
<< kg:id_208 prop:cause kg:id_209 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_148;
    prop:text-txt_contents "短時間での強雨により、主要地方道酒田松山線をはじめ、市内の多くの路線で冠水による通行止めとなり"@ja.
<< kg:id_208 prop:effect kg:id_210 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_149;
    prop:text-txt_contents "市内の多くの路線で冠水による通行止めとなり"@ja.
<< kg:id_208 prop:effect kg:id_211 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_150;
    prop:text-txt_contents "通学路が冠水した松原小学校、浜田小学校、若浜小学校や第六中学校では登校時間を繰り下げて対応したところでございます。"@ja.
<< kg:id_208 prop:effect kg:id_212 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_151;
    prop:text-txt_contents "床上浸水が４件、床下浸水が22件、車庫内への浸水１件の計27件の被害報告が寄せられました。"@ja.
<< kg:id_213 prop:countermeasure kg:id_214 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_152;
    prop:text-txt_contents "本市の浸水対策は、現在、計画時間雨量50.4ミリまでの降雨を処理可能とする施設整備、雨水幹線、ポンプ施設、側溝等を進めております。"@ja.
<< kg:id_213 prop:countermeasure kg:id_215 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_153;
    prop:text-txt_contents "まずはこうした地区において浸水解消等を図っていくことが最優先の取組であると考えております。"@ja.
<< kg:id_213 prop:countermeasure kg:id_216 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_154;
    prop:text-txt_contents "平成28年度から高砂地区において幹線となる雨水排水施設の整備をはじめ"@ja.
<< kg:id_213 prop:countermeasure kg:id_217 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_155;
    prop:text-txt_contents "令和３年度には国の緊急自然災害防止対策事業を活用し、富士見町地区や京田地区等において老朽化したポンプ施設の更新の実施"@ja.
<< kg:id_213 prop:countermeasure kg:id_218 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_156;
    prop:text-txt_contents "錦町地区や豊里地区においては、浸水解消に向けたポンプ能力の増強等を予定しているところでございます。"@ja.
<< kg:id_213 prop:countermeasure kg:id_219 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_157;
    prop:text-txt_contents "ボックスカルバートがあるわけなんですけれども、これを改修することによってそのボトルネックを解消し、流れる断面積を大きくするということで、札谷地排水路の流下能力を向上させ、富士見町地区の浸水被害を軽減していきたい"@ja.
<< kg:id_213 prop:countermeasure kg:id_220 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_158;
    prop:text-txt_contents "この止水シートをモデル的に導入して、それから希望する市民がいらっしゃれば貸出しを行って、実際どの程度、効果が発揮されるかの試験検証を行いながら、市民の方々のお気持ちを少しでも安心させられるような支援策の第一歩として、これから検討していきたい"@ja.
}
