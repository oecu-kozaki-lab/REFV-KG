kg:id_104 rdf:type cls:c_3095.
cls:c_3095 rdfs:label "加算廃止"@ja.
kg:id_102 prop:cause kg:id_104.
kg:id_105 rdfs:label "酒田産の地域木材利用について市独自に最大10万円の加算を行う"@ja.
kg:id_105 rdf:type cls:c_10036.
cls:c_10036 rdfs:label "木材加算"@ja.
kg:id_102 prop:contermeasure kg:id_105.
kg:st_1 rdfs:label "酒田市長丸山至"@ja.
kg:st_1 rdfs:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "地域経済の活性化や新しい産業基盤の創出につながるとみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "関連産業の立地や資材取引増加による波及効果を期待する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "雇用者所得の増加や消費需要喚起による波及効果を見込む"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域に新しい産業基盤を生み出すと考える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "地域経済の活性化につながると考える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "海域利用者の合意形成が重要とする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "環境への配慮を当然重要とする"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "景観への配慮を当然重要とする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "地域と協調した事業化に向けた議論の場として部会設置を進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "関係者間の理解促進のため課題と対応策の議論が必要とする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "市民への周知と機運醸成のため説明会開催に努める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "環境や景観への影響は環境影響評価法の手続の中で検討されるべきとする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:st_2 rdfs:label "酒田市地域創生部長大沼康浩"@ja.
kg:st_2 rdfs:type cls:st_60.
cls:st_60 rdfs:label "自治体職員"@ja.
kg:op_13 prop:content "新設された設問への対応が弱く順位を下げたと分析する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "紹介できる空き家情報が少なく苦慮している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "新規登録が少ないことが課題だとする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "物件条件や権利関係の未整理が新規掲載増加の妨げとみる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "良好な空き家でも賃貸に出さない傾向があるとみる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "移住実現者はおおむね暮らしに満足していると認識する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "移住後の居場所づくり支援が必要とみる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "移住後のサポートとして交流会参加を促している"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "移住希望者が見やすいよう古い情報の削除を進める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "良い空き家物件の情報提供に向け掲載件数増加を進める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:st_3 rdfs:label "総務部危機管理監那須欣男"@ja.
kg:st_3 rdfs:type cls:st_60.
kg:op_23 prop:content "人口減少で若年層の入団が減っているとみる"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "新入団員不足が高齢化と減少につながっているとみる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "サラリーマン化に伴い平日日中の対応力低下が課題とする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "団員減少や偏在化が活動低下の課題とする"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "課題対応のため団員確保を強化する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "OB団員の機能別消防団活用で平日日中対応を補う"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "不在地域への声かけで偏在解消を図る"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "自主防災組織と消防団の連携が避難促進に効果を上げた"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "募集広報を通じて団員確保を進める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "協力事業所拡大と事業所への働きかけで団員確保を図る"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "屋外スピーカーは屋内伝達に限界があると認める"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "気象条件や反響音などで聞き取りにくい課題があるとする"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "屋外でも反響や周辺音で聞こえにくい場合があるとする"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "緊急情報伝達には多重化が必要とする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "防災ラジオが有効な手段であり頒布拡大を進める"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "SNSやアプリも活用し正確な情報をより早く伝える方針"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:st_4 rdfs:label "企画部長宮崎和幸"@ja.
kg:st_4 rdfs:type cls:st_60.
kg:op_39 prop:content "修繕されない屋外広告物や類似危険物は重大事故につながると警戒する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "未撤去物件に個別に補助制度を案内する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "周知啓発を強化し相談や補助制度利用増加につなげたい"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:st_5 rdfs:label "選挙管理委員会委員長高橋清貴"@ja.
kg:st_5 rdfs:type cls:st_111.
cls:st_111 rdfs:label "行政委員"@ja.
kg:op_42 prop:content "投票時間短縮は投票機会減少につながるため慎重に検討すべきとする"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "利益誘導と取られかねず選管が主導すべきでないと考える"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:op_44 prop:content "地域学校市の役割分担を明確にするためマニュアルを整備した"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "連絡員配置で避難所運営体制を整えた"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "女性防災リーダー育成で女性の視点を避難所運営に反映させる"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "女性視点を反映したマニュアル見直しを進める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "実際の災害を想定した訓練を積み上げる必要がある"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "県内機関以外との情報共有が限定的なのが現状とする"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "リアルタイム確認と迅速な意思決定のため総合的システムを求める"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "実働機関との連携が重要と認識する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "センサーやドローンの観測情報収集が重要と認識する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "被害情報と避難所情報の集約が重要と認識する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "防災パッケージシステムとの一元化も含め研究を進める"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:st_6 rdfs:label "健康福祉部長菊池裕基"@ja.
kg:st_6 rdfs:type cls:st_60.
kg:op_55 prop:content "接種は本人意思によるものであり差別防止を周知する必要がある"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_6.
kg:op_56 prop:content "分かりやすい広報でハラスメント防止を呼びかける"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_6.
kg:op_57 prop:content "因果関係の有無を問わず報告制度に沿った対応が必要とする"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_6.
kg:op_58 prop:content "健康被害認定時には医療費や手当等の給付を受けられる"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_6.
kg:st_7 rdfs:label "地域創生部長大沼康浩"@ja.
kg:st_7 rdfs:type cls:st_60.
kg:op_59 prop:content "既存の食事券施策が継続していることを理由に挙げる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_7.
kg:op_60 prop:content "利用者と事業者の多くがキャッシュレスを評価している"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_7.
kg:op_61 prop:content "全市民配布型商品券は還元キャンペーンより経済効果が小さいとみる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_7.
kg:op_62 prop:content "限られた国費の中では経済効果の大きい事業を優先すべきとする"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_7.
kg:op_63 prop:content "アプリ導入から使い方まで個別相談で支援する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_7.
kg:op_64 prop:content "通信会社を問わず相談できる体制を整える"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_7.
kg:st_8 rdfs:label "建設部長藤井昌道"@ja.
kg:st_8 rdfs:type cls:st_60.
kg:op_65 prop:content "県補助の縮小により補助上限が下がる"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_8.
kg:op_66 prop:content "県制度改正で加算措置が廃止された"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_8.
kg:op_67 prop:content "林業振興の観点から酒田産材利用加算は市独自で継続する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_8.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "遊佐町沖及び酒田市沖への洋上風力発電事業の導入及びそれに伴う基地港湾の指定については、港湾整備、発電設備の施工、それから、施工後の運転・保守による直接的な経済効果"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "建設資材や原材料の取引の増加ですとか、関連産業の立地による第１次的な経済波及効果"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "雇用者所得の増加あるいは消費需要喚起による第２次的な経済波及効果"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "この地域における新しい産業基盤の創出"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "地域経済の活性化につながるものと考えているところでございます"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "洋上風力発電事業の導入に当たっては、海域利用者の合意形成を図る"@ja.
<< kg:id_7 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "洋上風力発電事業の導入に当たっては、海域利用者の合意形成を図るとともに、環境、景観に配慮すること、これは当然重要だと考えております"@ja.
<< kg:id_7 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "洋上風力発電事業の導入に当たっては、海域利用者の合意形成を図るとともに、環境、景観に配慮すること、これは当然重要だと考えております"@ja.
<< kg:id_11 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "酒田市沖への洋上風力発電の導入検討を進めるために、令和３年度に酒田沿岸域検討部会を設置することが決定されました"@ja.
<< kg:id_11 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "地域と協調した事業化に向けて課題の抽出や対応策等の議論を行って、関係者間の理解促進に努めていく"@ja.
<< kg:id_14 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本市といたしましても、山形県と連携して説明会を開催するなど、市民に対して洋上風力発電事業の周知に努めまして、地域の機運醸成を図る"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "この洋上風力発電事業による環境や景観への影響については、本事業で想定される発電出力が環境影響評価法上の第１種事業となる１万キロワットを超えることから、事業者が行う環境影響評価法の手続の中で検討されることになります"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "新たに設定された質問項目は、コロナ禍でのイベント開催の状況やオンラインの取組のほか、個別の給付事業の有無などが多く、本市としてはその辺りが順位を下げた要因と分析をしております"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "移住を希望されている方から空き家を紹介してほしいと相談されるケースもありますが、実際のところ紹介できる空き家情報がほとんどなく、苦慮している状況でございます"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "課題としては、新規案件の登録が少なく、サイトの掲載件数が増えないことが挙げられます"@ja.
<< kg:id_22 prop:cause kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "立地が悪いものや相続などの権利関係が整理されていないケースも多く、なかなか新規掲載の増加に結びつかないことが一因かと考えております"@ja.
<< kg:id_22 prop:cause kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "酒田の人は、程度が良くても他人に貸したがらない、賃貸物件に出さないという傾向もございます"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "移住相談窓口で移住を実現した方々の声を聞きますと、おおむね酒田での暮らしに満足しているものと認識をしております"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "一方で、移住当初、居場所やネットワークづくりに苦慮されている方もいらっしゃるようで"@ja.
<< kg:id_30 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "移住相談窓口では、年３回の移住者交流会にお誘いするなど、移住後のサポートも行っているところでございます"@ja.
<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "古い情報については速やかに削除するなど、移住希望者が見やすいように運営をしてまいります"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "今後も空き家等情報サイトの掲載件数を増やしていくよう引き続き協議会の構成団体に働きかけるとともに、空き家の相談者に対しても周知を図り、移住希望者に良い空き家物件を情報提供できるようにしてまいります"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "原因としまして、人口減少により、特に20代から30代の新入団員が減少していること"@ja.
<< kg:id_36 prop:cause kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "新入団員がいないことにより高齢になっても退団できないなどが団員数の減少、高齢化につながっているものと考えております"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "消防団員のサラリーマン化に伴う平日日中の災害対応ができない"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "現在、消防団の抱える課題としては、団員数の減少による活動の低下、団員のサラリーマン化に伴う平日日中の災害対応ができない、また、市街地においては団員の地域偏在化が見られることなどが挙げられます"@ja.
<< kg:id_36 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "課題の対応のため、団員確保に積極的に取り組む"@ja.
<< kg:id_44 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "消防団を退団したＯＢ団員が機能別消防団として災害に対応していく"@ja.
<< kg:id_46 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "市街地の団員の偏在化については、不在地域にも幅広く声かけ等を行いまして、偏在化の解消に努めたいと考えております"@ja.
<< kg:id_48 prop:effect kg:id_49 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "平成30年８月５日の豪雨では、地域の自主防災組織と連携し、消防団員が各家庭を１軒１軒回って避難を促したことにより、多くの方の避難につながりました"@ja.
<< kg:id_50 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "団員の確保につきましては、市としては各コミセンへのポスター掲示やホームページでの掲載、消防フェスティバルなどの募集広報などを行っております"@ja.
<< kg:id_50 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "消防団協力事業所の拡大を進め、事業所へ団員入団をお願いしながら、団員の確保に努めていきたい"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "防災行政無線の屋外スピーカーは、災害時の情報伝達において重要かつ有効な手段でございます。しかしながら、これは万能でなく、屋内にいる人にはなかなか伝わりにくい"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "気象条件に影響を受けるなどの課題があるのも事実でございます"@ja.
<< kg:id_53 prop:effect kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "屋外でも場所によりましては建物への音の反響で聞き取りにくくなる場合や、他の音源が近くにあることで聞こえない場合もあり、また、天候が悪い日も同様となります"@ja.
<< kg:id_57 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "この課題に的確に対応するためには、緊急情報を自動受信できるプッシュ型情報伝達の多重化を進める必要がございます"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "災害発生時に災害情報を自動起動し、お知らせする機能を持つ防災ラジオが有効な手段と考えており、その頒布の拡大を図っているところでございます"@ja.
<< kg:id_59 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "市ホームページや酒田市公式ＬＩＮＥ、フェイスブック、ツイッターなどの市公式ＳＮＳやヤフー防災アプリなど、様々なツールを駆使していき、プッシュ型の情報伝達の多重化を図り、正確な情報をより早く伝えることに努めていきたい"@ja.
<< kg:id_62 prop:effect kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "劣化ですとかが進行しますし、倒壊、落下など重大な事故にもつながりかねない"@ja.
<< kg:id_62 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "撤去未実施の50件に関して個別に補助制度、これにつきまして令和元年度までは補助上限８万円だったものを、令和２年度以降は補助上限15万円まで制度拡充しております。利用案内を行う"@ja.
<< kg:id_62 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "全市的には引き続きホームページや広報への掲載、固定資産税への納入通告書への資料の同封等を通じまして、さらなる周知・啓発を図っていき、市民からの相談や補助制度利用数の増加に努めていきたい"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "投票時間を短くすることは、有権者の投票機会を減らすことにもなるため"@ja.
<< kg:id_68 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "総務省におきましても、選挙を管理する側の選挙管理委員会がイニシアチブを取ってやるべきものではないとの考え方でございます。したがって、選挙管理委員会におきましては、積極的に支援することは考えていないところでございます"@ja.
<< kg:id_70 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "平成30年に避難所運営マニュアル、これは共通編、個別編がございますが、これを策定しております"@ja.
<< kg:id_70 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "各避難所に職員２名を連絡員として事前に配置することにより体制を整えました"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "令和３年度は自主防災組織を牽引していく存在となる女性防災リーダー育成のための女性防災講座やワークショップを行っていく所存でございます"@ja.
<< kg:id_73 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "女性の視点に立った避難所運営マニュアルの見直しを含め不断の見直しを図りながら、より機能的な避難所運営をしていく"@ja.
<< kg:id_76 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "協定締結企業や関係団体と連携し、避難所運営を基幹訓練とした実践型訓練を実施し、実際に大きな災害が起こっても迅速かつ的確に対応できるように訓練を積み上げていきたい"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "このシステムはＳＩＰ４Ｄとは連携していないため、山形県と県内各市町村や消防、警察とは情報共有ができますが、その他の機関との情報共有は限定的であるというのが現状でございます"@ja.
<< kg:id_80 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "市として本システムに期待するスペックとしましては、まず災害発生状況をリアルタイムに確認でき、状況認識の統一と迅速な意思決定を図り、住民の方々へ迅速な災害情報伝達が可能となるような総合的な防災パッケージシステムであります"@ja.
<< kg:id_80 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "具体的には、まず県に加えて消防、警察、国土交通省、自衛隊など関係防災機関との情報の連携"@ja.
<< kg:id_80 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "水位や雨量センサー、災害用ドローンによる観測情報の収集"@ja.
<< kg:id_80 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "被害情報や避難所情報の集約が重要であると認識しており"@ja.
<< kg:id_85 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "この情報共有システムを入れることによって、防災パッケージシステムと併せて、一元化すればいいのか、それを別個で立てればいいのか、これについてはまた引き続き研究は必要ですが、研究を進めて具現化を図っていきたい"@ja.
<< kg:id_87 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "このことについては受診券送付の際にチラシを同封するなどして、御理解をいただくよう十分に配慮してまいりたい"@ja.
<< kg:id_87 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "本市としては、接種しないことに伴うハラスメントの防止を図るため、市ホームページや酒田市のＬＩＮＥ公式アカウント、またツイッター、市広報など、その時点で最も有効な方法を活用し、分かりやすい広報により市民皆様に呼びかけてまいりたい"@ja.
<< kg:id_90 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "ワクチン接種後に副反応を疑う症状がある場合は、接種との因果関係の有無を問わず、予防接種法の規定により、医師は厚生労働大臣に報告しなければならないとされております"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "一般的にワクチン接種により治療が必要になったり、障がいが残ったりした場合、予防接種法に基づく救済制度が設けられております"@ja.
<< kg:id_94 prop:cause kg:id_95 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "国が実施しておりますＧｏｔｏＥａｔキャンペーン食事券について、販売期間が当初令和３年２月28日まででありましたが、現在、令和３年５月31日までに延長されております"@ja.
<< kg:id_94 prop:cause kg:id_96 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "消費者側の90.1％、事業者側の82.6％がキャッシュレス決済のほうがよかったと回答しております"@ja.
<< kg:id_94 prop:cause kg:id_97 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "本市が実施しているような還元キャンペーンと比較しますと、消費を増やすという意味では経済効果が少ないと考えております"@ja.
<< kg:id_94 prop:cause kg:id_98 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "限られた財源の中で、新型コロナウイルス感染症の拡大に伴い、多くの対策が必要であるため、優先順位をつけた上で、より経済効果が大きい事業を実施する必要があると考えております"@ja.
<< kg:id_99 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "デジタル弱者に対する対策としては、前回同様、個別相談によりアプリの入れ方からチャージの方法、実際の使い方までを細かくレクチャーする使い方相談会を市役所１階フリースペースで実施する予定でございます"@ja.
<< kg:id_99 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "市内の携帯電話販売店においても、契約している通信会社にかかわらず、土日祝日もキャッシュレス決済の使い方を相談できる体制を整えてまいります"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "県による人口減少対策としての世帯要件分は最大50万円、内訳は県30万円、市20万円です。これから最大30万円、内訳は県15万円、市15万円に補助金が減額となり"@ja.
<< kg:id_102 prop:cause kg:id_104 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "地域産木材利用や空き家活用における加算措置については廃止となりました"@ja.
<< kg:id_102 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "酒田産の地域木材利用につきましては、林業の振興の面から必要であると考えているため、これにつきましては、市独自に最大10万円の加算を行いたい"@ja.
}
