kg:id_100 rdf:type cls:c_10034.
cls:c_10034 rdfs:label "利用相談"@ja.
kg:id_99 prop:contermeasure kg:id_100.
kg:id_101 rdfs:label "市内の携帯電話販売店でキャッシュレス決済の使い方を相談できる体制を整える"@ja.
kg:id_101 rdf:type cls:c_2611.
cls:c_2611 rdfs:label "相談体制"@ja.
kg:id_99 prop:contermeasure kg:id_101.
kg:id_102 rdfs:label "住宅リフォーム総合支援事業の補助金減額"@ja.
kg:id_102 rdf:type cls:c_3094.
