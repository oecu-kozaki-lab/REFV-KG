kg:st_1 rdfs:label "齋藤美昭議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "地方の独自財源の確保策として重要で地域活性化に寄与すると評価"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "返礼品は地場産業の発展に役立つと評価"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "事業に対して寄附を募る取組の推進を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "寄附者を酒田ファンとして交流人口拡大や移住促進につなげる施策を求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "コロナ禍の応援消費は地域に大きな支援効果があったと評価"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_2 rdfs:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_6 prop:content "地場産品の取扱い増加により地域経済への直接効果があったと総括"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "ポータルサイトを通じたシティープロモーション効果が大きくなったと認識"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "事業者がエンドユーザーを意識した物づくりを行うようになったと評価"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "ふるさと納税はお取り寄せ需要の受け皿になったと認識"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:st_3 rdfs:label "返礼品提供事業者"@ja.
kg:st_3 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_10 prop:content "飲食店取引が停滞する中で返礼品需要が収益減少を和らげた"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "寄附者の応援メッセージが大きな励みになった"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "寄附金額の伸びは地道な返礼品開発の成果でもあると認識"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "サンロクや委託事業者との連携による事業者支援が効果を上げた"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "市の特徴的な取組のPRになり寄附者の思いを反映できると評価"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "PRしたい事業に活用していく方針"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "企業版ふるさと納税は新たな財源調達手段になったと認識"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "企業に積極的に働きかけて推進を図るべきとする"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "寄附者に酒田を身近に感じてもらう情報提供を進める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "返礼品以外の情報も含めた配信を充実させる方針"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "制度見直しや廃止に備え事業者の販路拡大支援を継続すべきとする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "寄附者の意見やコメントを収集する仕組みを充実させたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "庁内全体で再度取り組める体制を考えるべきとする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "イベント機会を捉えた周知を進めたい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "生まれ育った地域を局所的に応援する取組は本旨に合うと受け止める"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "地方の独自財源の確保策として重要な事業であり、返礼品については、地域経済、地場産業の活性化に大きく寄与している"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "返礼品については、地域経済、地場産業の活性化に大きく寄与している"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "事業に対して寄附を募る、ガバメントクラウドファンディングについても取組の推進を要望してきました"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "本市、酒田市にふるさと納税をしてくれた人は酒田ファンであり、本市の情報発信を担ってもらい、交流人口の拡大や移住促進につなげていけるような施策をお願いしてきました"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "地域活性化につながっていると感じる理由としては、「お礼の品、俗に言う返礼品が、事業者の助け、支援につながっている」という回答が29.8％と最も多く"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "地域活性化につながっていると感じる理由としては、「政策の財源になっている」が23.6％"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:text-txt_contents "地域活性化につながっていると感じる理由としては、「地域のＰＲにつながる」が23.5％"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "寄附額が増加した要因については、６割以上の自治体が、コロナ禍にあって、寄附者が生産者の応援を意識したことが影響したと考えており"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:text-txt_contents "地場産業の売上げは落ち込んだが、ふるさと納税の受注数が増加したことにより少しでも経済活性化につながった"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:text-txt_contents "ピンチをチャンスと捉え、地域事業者の積極的な経営マインドにつながっているなど、ふるさと納税によって、売上げだけでなく地域事業者のモチベーション向上につながっている"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:text-txt_contents "持続可能な財政基盤の確立、財源確保策の取組としてふるさと納税が挙げられ、攻めの取組をしていく"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "寄附の伸びに応じて地場産品の取扱いが増えたことによる地域経済への直接的な効果があったものと捉えております"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "昨年度は約18万件の御寄附を頂くようになったことから、ふるさと納税のポータルサイトを通じたシティープロモーションの効果も大きくなった"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業者自身が日頃から、いわゆるエンドユーザーを意識した物づくり、これを行うようになるなど、地域事業者の成長を促す効果もあり"@ja.
<< kg:id_9 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "コロナ禍においては、飲食店の営業自粛、それから人流の制限などによって巣籠もりの生活が続く中、いわゆるお取り寄せでの商品購入が増えまして、ふるさと納税もそのツールの一つとして利用されていた"@ja.
<< kg:id_9 prop:effect kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "ある返礼品提供事業者からは、コロナの影響によって飲食店との取引が停滞する中、ふるさと納税での返礼品需要があったことで収益の減少が緩和されて助かった"@ja.
<< kg:id_9 prop:effect kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "寄附者から、事業者を応援するメッセージも多くいただいておりまして、コロナで苦しむ事業者にとりまして大きな励みになった"@ja.
<< kg:id_1 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "これまでも返礼品提供事業者とともに、寄附者から選ばれる返礼品の開発、例えば、寄附者の利便性を高めるように、御自宅まで毎月定期的に届けられるようにというようなことの定期便、これを充実をさせていただいたり、主力の返礼品であるお米以外の返礼品開発にも力を入れてラインナップを充実してきたというような地道な取組、これが功を奏した"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "サンロクのコンシェルジュ、担当職員、それからふるさと納税業務の委託事業者、この３者が、返礼品提供事業者を直接訪問したり、ウェブでのミーティングを開催させていただいたりしながら事業者支援をしてきた効果が大きい"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "市の施策を応援していただくガバメントクラウドファンディング型のふるさと納税は、市の特徴的な取組のＰＲになる上、寄附された方の思いをより明確に反映できる"@ja.
<< kg:id_22 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "今後も、酒田市としてＰＲしたい事業を対象事業とするなどして、ガバメントクラウドファンディングを積極的に活用していきたい"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "企業版ふるさと納税が財源調達の新たな選択肢の一つとなった"@ja.
<< kg:id_25 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "まずは、企業に様々な方法でアプローチすることで、企業版ふるさと納税の推進を図りたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "寄附者の希望に応じて観光情報や地域情報などの提供を行うことで、酒田をより身近に感じてもらえるように取り組んでいきたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "楽天ふるさと納税を通じた寄附者には、このサイトの機能で定期的にメルマガの配信を行っております。総務省の指導もございまして、その配信の内容の半分以上は、返礼品以外の情報にしております"@ja.
<< kg:id_1 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "もし将来的に制度が廃止された場合であっても、事業者が収益を確保できるよう、返礼品提供事業者のｅコマースへの取組を引き続き支援していきたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "御寄附をいただく際に御意見などをいただけるような、そんな仕組み、コメントなり、そういったものもちょっと充実させていければなと思った"@ja.
<< kg:id_22 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "庁内全体でもう一度取り組めるような体制を少し考えていければと思います"@ja.
<< kg:id_22 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "武蔵野市でイベントがあるときなどは、イカのガバメントクラウドファンディングのチラシなども配布をさせていただいたことなどもございます。そういった機会を捉えて情報発信をしていければ"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "地域外の方が、局所的に自分の生まれた町と、議員のお話を伺うと、それは非常にふるさと納税の本旨に合った取組なのかな"@ja.
}
