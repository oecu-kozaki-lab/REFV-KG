<< kg:id_41 prop:cause kg:id_44 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "結婚・出産に対する価値観の変化"@ja.
<< kg:id_41 prop:cause kg:id_45 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "子育てに対する負担感の増大"@ja.
<< kg:id_41 prop:cause kg:id_46 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "経済的不安定の増大"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "観光施設入込数ですとか外国人観光客入込数庄内空港定期便搭乗者数、この実績値は、前年同期比でいうと大幅に減少をしてございます"@ja.
<< kg:id_49 prop:cause kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "観光施設入込数ですとか外国人観光客入込数庄内空港定期便搭乗者数、この実績値は、前年同期比でいうと大幅に減少をしてございます"@ja.
<< kg:id_50 prop:cause kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "観光施設入込数ですとか外国人観光客入込数庄内空港定期便搭乗者数、この実績値は、前年同期比でいうと大幅に減少をしてございます"@ja.
<< kg:id_51 prop:cause kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "クルーズ船寄港回数に至っては実績がゼロになるなど、コロナ禍による直接的なマイナスの影響があった"@ja.
<< kg:id_52 prop:cause kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "住民基本台帳上の2020年の婚姻件数を見ますと実績が370件、対前年比マイナス32件と悪化してございまして、コロナ禍によるマイナスの影響があった"@ja.
<< kg:id_53 prop:cause kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "公共交通乗車人数、乗合バスですとかデマンドタクシー、生活交通バスにつきましては、実績が25万8,076人、前年同期比でマイナス９万3,196人と悪化しております"@ja.
<< kg:id_54 prop:cause kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "八幡、松山、平田地域、飛島地区の交流人口の増加については、実績が61.4万人と前年同期比でマイナス24.9万人と悪化しているようでございます。いずれもコロナ禍によるマイナスの影響があった"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "新規高卒者の県内就職率につきましては、実績率が67.6％、前年同期比でプラス11.6ポイント改善しました。これも、やはり高校生の地元志向が高まったものと考えておりますが、やはりコロナの影響があったのかな"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "転出数が大幅に減少しておりまして、やはりコロナ禍によって少し転出を見合わせたんじゃないかなという、その影響があった"@ja.
<< kg:id_59 prop:effect kg:id_60 >>
    prop:text-txt_contents "風力発電事業につきましては、山形県エネルギー戦略の推進に貢献するとともに"@ja.
<< kg:id_59 prop:effect kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "事業によって得られる利益を広く市民に還元するという目的で実施をしてきた"@ja.
<< kg:id_62 prop:effect kg:id_63 >>
    prop:text-txt_contents "昨年度は果樹が140アール、2,050キログラム"@ja.
<< kg:id_62 prop:effect kg:id_64 >>
    prop:text-txt_contents "豆類が20アール、200キログラムの被害"@ja.
<< kg:id_62 prop:effect kg:id_65 >>
    prop:text-txt_contents "６月にメロンの受粉用として畑に置いていた養蜂箱、これは蜜蜂を入れる箱でございますが、こちらのほうが複数荒らされるという被害が出ております"@ja.
<< kg:id_62 prop:effect kg:id_66 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "近年は熊が人家近く、30メートルから50メートル以内に熊が現れているという情報も多く、地元住民の不安感、危機感が強まっている"@ja.
<< kg:id_62 prop:effect kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "地域以外の方の安全にもつながることでございますので、これにつきましては、できる限り警察等に通報していただくよう"@ja.
<< kg:id_62 prop:effect kg:id_68 >>
    prop:text-txt_contents "熊の出没を受けた登下校の時間変更や休校などの情報は速やかに警察へも連絡し"@ja.
<< kg:id_69 prop:effect kg:id_70 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "市民の文化芸術の発表の場、参加の場が閉じたことは、多少なりとも市民に影響があったのではないか"@ja.
<< kg:id_71 prop:effect kg:id_72 >>
    prop:text-txt_contents "中心市街地のにぎわい創出により、近隣の飲食店や小売店への回遊効果"@ja.
<< kg:id_71 prop:effect kg:id_73 >>
    prop:text-txt_contents "市民が文化芸術を発表し、触れることができるようなそういう身近な施設として、一定程度の役割を果たした"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "従来の警戒レベル４避難勧告・避難指示の違いの分かりにくさを解消するのが狙い"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:text-txt_contents "既に安全な避難ができず命が危険な状況にある"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:text-txt_contents "実際に給付されるまでの期間がオンラインのほうが圧倒的に短い結果"@ja.
<< kg:id_78 prop:effect kg:id_80 >>
    prop:text-txt_contents "市側のほうにも、メリットとしては給付手続の省力化というのが挙げられる"@ja.
<< kg:id_81 prop:effect kg:id_82 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "例えば配偶者の方で、あってはならないんですが、家庭内暴力があったり そうした際には、世帯主が例えば夫であれば、給付金は旦那さんの口座に振り込まれてしまう"@ja.
<< kg:id_83 prop:effect kg:id_84 >>
    prop:text-txt_contents "住民票や所得証明書等の提出が省略できるようになっております"@ja.
<< kg:id_83 prop:effect kg:id_85 >>
    prop:text-txt_contents "事務作業とか若干の事務経費も軽減されている"@ja.
<< kg:id_86 prop:effect kg:id_87 >>
    prop:text-txt_contents "経済波及効果は約186億円"@ja.
<< kg:id_86 prop:effect kg:id_88 >>
    prop:text-txt_contents "雇用創出効果は1,586人"@ja.
<< kg:id_86 prop:effect kg:id_89 >>
    prop:text-txt_contents "税収増大効果は県税、市町村税を合わせて約２億4,800万円"@ja.
<< kg:id_90 prop:effect kg:id_91 >>
    prop:text-txt_contents "水素やアンモニア等を活用したエネルギー関連企業の立地"@ja.
<< kg:id_90 prop:effect kg:id_92 >>
    prop:text-txt_contents "洋上風力発電の円滑な導入と基地港湾の指定"@ja.
<< kg:id_90 prop:effect kg:id_93 >>
    prop:text-txt_contents "地域に雇用と経済波及効果を創出していく"@ja.
<< kg:id_94 prop:effect kg:id_95 >>
    prop:text-txt_contents "地域の実情や特性に応じたまちづくり施策として取り組むことで、地域が活性化することが期待されております"@ja.
<< kg:id_94 prop:effect kg:id_96 >>
    prop:text-txt_contents "移住者が地域で活躍する仕組みの実現が期待できる構成"@ja.
<< kg:id_59 prop:contermeasure kg:id_97 >>
    prop:text-txt_contents "事業の収益につきましては、風力発電事業地域未来創造基金、こちらのほうに積立てをして"@ja.
<< kg:id_59 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "地域振興事業等に充てることとしております"@ja.
<< kg:id_99 prop:contermeasure kg:id_100 >>
    prop:text-txt_contents "施設の安全性や劣化の程度なども考慮した上で優先順位をつけて予算計上している"@ja.
<< kg:id_101 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "光ケ丘野球場は、スポーツ少年団で活躍する小学生から中学生、高校生、大学生、社会人まで、多くの団体が大会や練習の会場として使用する重要なスポーツ施設であり、今後も継続して維持管理していく施設である"@ja.
<< kg:id_103 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "公共施設等老朽化対策の財源にということは、本市における積立て目的に合致しておりまして、これまでも緊急性に配慮しながら優先順位をつけて実施してまいりました 施設改修への対応につきましては、緊急性と必要性を十分に検討の上、判断してまいりたい"@ja.
<< kg:id_62 prop:contermeasure kg:id_105 >>
    prop:text-txt_contents "できる限り警察等に通報していただくよう機会があるごとに市民の方にお願いしている"@ja.
<< kg:id_62 prop:contermeasure kg:id_106 >>
    prop:text-txt_contents "市民等からの通報を受けまして、警察や各総合支所の職員、それから、環境衛生課職員による現地調査と警戒を実施する"@ja.
<< kg:id_62 prop:contermeasure kg:id_107 >>
    prop:text-txt_contents "市の関係各課、市内外の関係機関、猟友会や庄内総合支所等への連絡、それから、地域のコミュニティ振興会や自治会、地元の幼稚園・保育園、小中学校、高校等への連絡を行っている"@ja.
<< kg:id_62 prop:contermeasure kg:id_108 >>
    prop:text-txt_contents "広報車による街宣、それから、防災無線での広報等を実施しているほか、今年度からは 市のＬＩＮＥ、それから、ツイッター、フェイスブック等での情報発信も行っております"@ja.
<< kg:id_62 prop:contermeasure kg:id_109 >>
    prop:text-txt_contents "農作物の収穫した残り、それから、生ごみ等については、熊にとっては餌になってしまうことから、野外に放置しないように市広報等を通じて周知を図っている"@ja.
<< kg:id_62 prop:contermeasure kg:id_110 >>
    prop:text-txt_contents "耕作放棄地の発生防止のために、農地の維持管理を目的といたしました中山間地域等直接支払交付金を交付するなど、適切な営農支援を行っている"@ja.
<< kg:id_62 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "森林などの下草や灌木、低木ですけれども、この刈り払いをしっかり行いながら、見通しを良くする緩衝帯をつくることで、警戒心の強い熊の隠れ場所をなくし、出没しにくくすることが考えられます"@ja.
<< kg:id_62 prop:contermeasure kg:id_112 >>
    prop:text-txt_contents "地域住民と協働して課題解決に取り組み、地域ぐるみで対策を検討していく必要がある"@ja.
<< kg:id_113 prop:contermeasure kg:id_114 >>
    prop:text-txt_contents "今年度新たにアーティスト・イン・レジデンス事業というものを実施いたします"@ja.
<< kg:id_113 prop:contermeasure kg:id_115 >>
    prop:text-txt_contents "飯森山周辺の文化施設・教育施設で行うアートマルシェ"@ja.
<< kg:id_113 prop:contermeasure kg:id_116 >>
    prop:text-txt_contents "未就学児を対象といたしますアートスタート事業"@ja.
<< kg:id_113 prop:contermeasure kg:id_117 >>
    prop:text-txt_contents "酒田市芸術文化協会に対しまして、その事業運営や酒田市民芸術祭の実施などの支援を行っているほか、酒田フィルハーモニー管弦楽団・酒田吹奏楽団に対する支援"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:text-txt_contents "酒田市美術館の市民ギャラリー、この整備については、今後の施設整備計画において展示壁面の改修を計画していく方針"@ja.
<< kg:id_118 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "山居倉庫などの利活用の計画にギャラリー機能を盛り込んでいくことが可能かどうかなど、検討を行っていきたい"@ja.
<< kg:id_121 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "どう発見していくかということが非常に重要なことなんだろうと思います。そのためにも認知度を上げていくことというのが最重要なことではないか"@ja.
<< kg:id_121 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "学校が心理的に安全・安心な場所になっていることも早期の発見には欠かせない"@ja.
<< kg:id_121 prop:contermeasure kg:id_124 >>
    prop:text-txt_contents "ヤングケアラーに関する理解促進を図りながら、早期の発見ができるよう環境を整えて、その適切な支援につないでいく"@ja.
<< kg:id_125 prop:contermeasure kg:id_126 >>
    prop:text-txt_contents "災害発生のおそれが高い際に出してきた避難勧告を廃止し、避難指示に一本化する"@ja.
<< kg:id_125 prop:contermeasure kg:id_127 >>
    prop:text-txt_contents "警戒レベル５緊急安全確保の発令を待たずに、警戒レベル４までに必ず避難をするように広く呼びかけていく"@ja.
<< kg:id_125 prop:contermeasure kg:id_128 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "警戒レベル２大雨・洪水・高潮注意報や警戒レベル１早期注意情報の段階であったとしても 市民に対して災害への備えや避難準備のため早めに予令を行う"@ja.
<< kg:id_125 prop:contermeasure kg:id_129 >>
    prop:text-txt_contents "昨年創設した要配慮者のホテル及び旅館への自主避難・早期避難支援制度の周知を併せて行う"@ja.
<< kg:id_125 prop:contermeasure kg:id_130 >>
    prop:text-txt_contents "安全な親戚・知人宅やホテル・旅館への避難といった分散避難"@ja.
<< kg:id_125 prop:contermeasure kg:id_131 >>
    prop:text-txt_contents "自宅であっても、倒壊等の危険がなく、また、浸水深以上で、水・食糧等の備えが十分あるなどの条件が確認できれば、自宅にとどまり安全を確保する在宅避難が可能"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "本市６月16日号の広報に掲載したほか、市のホームページやフェイスブック、ＬＩＮＥ等で周知 コミュニティセンターや市所管施設等においてポスターを掲示 市役所、総合文化センター、各総合支所でチラシ配布"@ja.
<< kg:id_132 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "そういった訓練を繰り返しやはりやっていくことが必要なのかな"@ja.
<< kg:id_135 prop:contermeasure kg:id_136 >>
    prop:text-txt_contents "令和３年３月に酒田市空き家等対策計画を策定させていただいた"@ja.
<< kg:id_135 prop:contermeasure kg:id_137 >>
    prop:text-txt_contents "希望者に空き家等の無料相談会につなげるという取組を行っております"@ja.
<< kg:id_135 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "空き家等無料相談会の回数を２回から３回に増やしたい"@ja.
<< kg:id_135 prop:contermeasure kg:id_139 >>
    prop:text-txt_contents "自治会の空き家見守り隊との意見交換会などもしてみたい"@ja.
<< kg:id_135 prop:contermeasure kg:id_140 >>
    prop:text-txt_contents "相談者に市の単独で行っております解体補助金の周知"@ja.
<< kg:id_135 prop:contermeasure kg:id_141 >>
    prop:text-txt_contents "ホームページの空き家等情報サイトへの掲載を呼びかける"@ja.
<< kg:id_142 prop:contermeasure kg:id_143 >>
    prop:text-txt_contents "小中学校のカリキュラムの一環としてこの２つの美術館を活用してもらいたい"@ja.
<< kg:id_142 prop:contermeasure kg:id_144 >>
    prop:text-txt_contents "スクールプログラム対象の展覧会が終わるごとに、教育委員会と、それから、美術館側で振り返りの話合いを実施しまして、改善事項を協議する"@ja.
<< kg:id_142 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "土門拳記念館や酒田市美術館の所蔵作品の鑑賞をする、常設展等です。そういったところを鑑賞して、本市出身の芸術家の生涯や功績を知るということも、このスクールプログラムの中で取り組んでいけたら"@ja.
<< kg:id_146 prop:contermeasure kg:id_147 >>
    prop:text-txt_contents "この目的を実現するための第一歩として、組織体制の強化と管理業務の効率化"@ja.
<< kg:id_146 prop:contermeasure kg:id_148 >>
    prop:text-txt_contents "組織体制の強化と管理業務の効率化"@ja.
<< kg:id_146 prop:contermeasure kg:id_149 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "新たに若手の学芸員を２名増員を行った"@ja.
<< kg:id_146 prop:contermeasure kg:id_150 >>
    prop:text-txt_contents "長期的な視野に立った企画の実施"@ja.
<< kg:id_146 prop:contermeasure kg:id_151 >>
    prop:text-txt_contents "文化芸術に携わる人材の育成を図る"@ja.
<< kg:id_152 prop:contermeasure kg:id_153 >>
    prop:text-txt_contents "休日の申請受付窓口の開設"@ja.
<< kg:id_152 prop:contermeasure kg:id_154 >>
    prop:text-txt_contents "企業とか団体に出向きまして申請を受け付けます出張窓口サービス"@ja.
<< kg:id_152 prop:contermeasure kg:id_155 >>
    prop:text-txt_contents "昨年度行いましたカードリーダー助成"@ja.
<< kg:id_152 prop:contermeasure kg:id_156 >>
    prop:text-txt_contents "電子申請促進キャンペーン"@ja.
<< kg:id_157 prop:contermeasure kg:id_158 >>
    prop:text-txt_contents "まずはオンライン申請、オンラインによるサービスの提供の拡大に努めていきたい"@ja.
<< kg:id_159 prop:contermeasure kg:id_160 >>
    prop:text-txt_contents "利用者が支払う使用料あるいは使用料だけでは賄い切れない経費の税負担の考え方を統一化、明確化する作業を行っております"@ja.
<< kg:id_159 prop:contermeasure kg:id_161 >>
    prop:text-txt_contents "冷暖房費、これにつきましても、使用料に込み込みというような形で対応"@ja.
<< kg:id_159 prop:contermeasure kg:id_162 >>
    prop:text-txt_contents "改定額の上限というのは現行使用料の２倍というようなルール"@ja.
<< kg:id_163 prop:contermeasure kg:id_164 >>
    prop:text-txt_contents "しっかりと選択と集中をしていかないとなかなか厳しい状況"@ja.
<< kg:id_165 prop:contermeasure kg:id_166 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "計画的に修繕をするか、しないかというお尋ねであれば、それはしっかりやらせていただきます"@ja.
<< kg:id_167 prop:contermeasure kg:id_168 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "ネーミングライツをやりますとか看板を出しますという そういったものも少し検討させていただいて、少しでも歳入を確保しながら"@ja.
<< kg:id_169 prop:contermeasure kg:id_170 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "酒田市総合計画の後期計画の策定の見直し作業 このタイミングに合わせまして、第２期戦略につきましても、この総合計画との整合を図りながら、現状と合わなくなっている既存の施策ですとかＫＰＩなどを見直したい"@ja.
<< kg:id_171 prop:contermeasure kg:id_172 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "酒田市無電柱化推進計画 これにつきましてはその目的から、そして国庫補助を活用できるといった観点等から、策定していきたい"@ja.
<< kg:id_171 prop:contermeasure kg:id_173 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "本市が中心的な役割を担う無電柱化連絡協議会、これの設置の必要性は強く認識をしている"@ja.
<< kg:id_171 prop:contermeasure kg:id_174 >>
    prop:text-txt_contents "こうした既定プロセスの２段階協議に入る前の事前準備的な行為としてすり合わせや調整を行っていれば、国の２段階協議がよりスピーディーかつスムーズに進む"@ja.
<< kg:id_175 prop:contermeasure kg:id_176 >>
    prop:text-txt_contents "こうした基金等の活用を企業に促していくことによりまして、企業の脱炭素化に向けた取組を後押ししていきたい"@ja.
<< kg:id_177 prop:contermeasure kg:id_178 >>
    prop:text-txt_contents "山形県と連携して、酒田港の基地港湾指定を目指してまいります"@ja.
<< kg:id_179 prop:contermeasure kg:id_180 >>
    prop:text-txt_contents "まずは現状と課題の分析を行い、目標の設定を進めてまいります"@ja.
<< kg:id_179 prop:contermeasure kg:id_181 >>
    prop:text-txt_contents "検討が具体化してきた際には、民間企業の考えも聞き取りしながら検討を深めてまいりたい"@ja.
<< kg:id_94 prop:contermeasure kg:id_182 >>
    prop:text-txt_contents "新たな生涯活躍のまちは、対象を全世代に拡大し 多世代の移住者を対象としております"@ja.
<< kg:id_94 prop:contermeasure kg:id_183 >>
    prop:text-txt_contents "市有地を使って民間事業者の資金力とノウハウにより整備運営を行う、いわゆる公民連携の仕組みによって進める"@ja.
<< kg:id_94 prop:contermeasure kg:id_184 >>
    prop:text-txt_contents "事業計画のブラッシュアップを行い、基本協定締結を目指してまいります"@ja.
<< kg:id_94 prop:contermeasure kg:id_185 >>
    prop:text-txt_contents "これまでも首都圏を含めて移住についてのＰＲ活動もさせていただいております"@ja.
<< kg:id_186 prop:contermeasure kg:id_187 >>
    prop:text-txt_contents "空調や遮光など、保管環境におきましては著しく改善されている"@ja.
<< kg:id_186 prop:contermeasure kg:id_188 >>
    prop:text-txt_contents "文化資料館に現在、中町庁舎内にある光丘文庫の所蔵資料や市立資料館に所蔵している資料の一部を移転して、展示活用することも考えている"@ja.
<< kg:id_186 prop:contermeasure kg:id_189 >>
    prop:text-txt_contents "学芸員資格や教員資格を持った現在の資料館調査員や、光丘文庫の古典籍調査員も配置することを検討"@ja.
<< kg:id_190 prop:contermeasure kg:id_191 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "現在は旧光丘文庫の建物につきましては、必要最小限の管理ということで、機械警備、電気、それから防災設備点検、敷地内の清掃など業務を委託"@ja.
<< kg:id_190 prop:contermeasure kg:id_192 >>
    prop:text-txt_contents "教育委員会だけではなくて、全庁的に検討していきたい"@ja.
<< kg:id_190 prop:contermeasure kg:id_193 >>
    prop:text-txt_contents "長期的な計画に基づいて対策を考えていく"@ja.
}
