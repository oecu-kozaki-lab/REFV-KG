kg:st_1 rdfs:label "菅原正成農林水産部長"@ja.
kg:st_1 rdfs:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_1 prop:content "需要減少で若い世代が農業で生計を立てにくく就農しなかった"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "価格低迷で若い世代が就農を控えた"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "稲作経営の先行き不安が就農の抑制につながった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "親世代も就農を勧めにくく世代交代が進まなかった"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "世代交代の停滞が就業人口減少と高齢化を招いた"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "担い手への農地集積が進み就業者人口減少の一因となった"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "65歳以上の就農者増加が高齢化率を押し上げている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "高齢農家世帯で世代交代が進まず高齢化が進行している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "法人化推進により非農家出身の雇用就農者が増えた"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "農業法人の増加が雇用就農を増やした"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "農業をビジネスとみる見方が新規参入を後押しした"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "担い手や後継者の育成に大きな意義がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "経験や勘だけに頼らない農業継承を目指す"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "先輩農家との交流で担い手育成効果を高める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "目的別カリキュラムで地域の担い手育成を図る"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "コロナ禍の消費低迷が米価下落の背景にある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "作況や需給見通しなどが総合的に判断された"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "需給見通しが米価決定に影響した"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "市場相場も米価下落の判断材料になった"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "農家所得の減少が見込まれる厳しい状況だ"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "本市経済にも相当大きな影響を及ぼす"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "出口戦略として米の消費拡大をしっかり行う必要がある"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "安定供給や農業継続のため国の支援を今まで以上に求める必要がある"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:st_2 rdfs:label "松本国博議員"@ja.
kg:st_2 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_24 prop:content "当初予定どおりに進まない背景に供給不安定がある"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:st_3 rdfs:label "丸山至市長"@ja.
kg:st_3 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_25 prop:content "配分量不足のため集団接種中止や個別接種の対象限定を余儀なくされた"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "ワクチン不足で予定日程の一部中止が生じた"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "個別接種を高齢者や基礎疾患のある方に限定せざるを得なかった"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "妊婦と新しい命を守るため優先接種を決めた"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "受験や就職活動に臨む生徒学生の不安軽減のため優先接種を実施した"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "かかりつけ産科医療機関で優先的に個別接種できるよう調整した"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "最も早く接種できる日程を確保して配偶者などに案内した"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "中学3年生と高校3年生に優先接種日程を確保した"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "当事者からの要望を受け実施決定を早めた"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "国や県の通知もあり優先接種の決定を早めた"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "接種済み優遇の事業は未接種者に差別と受け取られる恐れがある"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "差別を生まないよう適時適切に周知を図る"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "認証基準を満たすため座席間隔確保が必要で取り組みをためらう声がある"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "基準達成のため座席数削減が必要になる"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "採算悪化を理由に制度活用をためらう事業者がいる"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "安全安心をアピールする手段として積極的な活用を周知したい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "コロナ禍で若者を中心に地方移住志向が高まっている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "移住者向け住宅と地域交流拠点整備を進め発信力ある事業にしたい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "テレワーク推進のため住宅改修補助にネット環境整備費を追加した"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "ホームページで移住関連情報を一元化し効果的発信を図る"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:st_4 rdfs:label "松田俊一健康福祉部地域医療調整監"@ja.
kg:st_4 rdfs:type cls:st_32.
kg:op_45 prop:content "妊娠や出産への影響不安に丁寧に相談対応している"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_4.
kg:op_46 prop:content "情報があふれる中で正しい情報の周知が必要だ"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "出産への影響を心配する妊婦が多い"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "正しい情報を活用し妊婦の不安を取り除くよう周知する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:st_5 rdfs:label "齋藤一志教育次長"@ja.
kg:st_5 rdfs:type cls:st_51.
cls:st_51 rdfs:label "教育関係者"@ja.
kg:op_49 prop:content "接種有無を理由に悪く言ったりいじめたりすることは絶対にあってはならないと強調した"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_5.
kg:op_50 prop:content "接種の有無が分かりにくいよう日程を複数設定して配慮している"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_5.
kg:op_51 prop:content "偏らない客観的な内容を示して判断材料にしてもらう"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_5.
kg:st_6 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_6 rdfs:type cls:st_32.
kg:op_52 prop:content "制度の趣旨や手続の理解不足が普及の妨げになっている"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_6.
kg:op_53 prop:content "認定取得後の活用も含めて改めて周知を図りたい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_6.
kg:st_7 rdfs:label "矢口明子副市長"@ja.
kg:st_7 rdfs:type cls:st_29.
kg:op_54 prop:content "エアコン単独は対象外だが要件工事と一緒なら補助対象になる"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "平成30年度から初めての夏を迎える生活保護受給世帯にエアコン給付実績がある"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "通常起こり得ない大きな被害には国や県への働きかけをしていきたい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_7.
kg:op_57 prop:content "急激な降雨で排水能力を超えると内水氾濫が生じる"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_7.
kg:op_58 prop:content "河川水位上昇で排水不能となることも内水氾濫の要因だ"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_7.
kg:op_59 prop:content "直近5年で床下浸水190戸の住家被害があった"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_7.
kg:op_60 prop:content "直近5年で床上浸水3戸の住家被害があった"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_7.
kg:op_61 prop:content "浸水被害地域に戸別訪問し支援要望も聞き取った"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_7.
kg:op_62 prop:content "消毒やごみ処分案内を速やかに周知した"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_7.
kg:op_63 prop:content "市の重要事業として県に整備要望した"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_7.
kg:op_64 prop:content "内水氾濫解消に有効だが事業費や用地確保など課題も多い"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_7.
kg:op_65 prop:content "ポンプ場整備には多額の事業費が必要になる"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_7.
kg:op_66 prop:content "雨水貯留槽整備にも多額の事業費が必要になる"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_7.
kg:op_67 prop:content "別系統排水で施設規模縮小の可能性も含め効率的対策を検討する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_7.
kg:op_68 prop:content "経済的困窮などで生理用品を用意しにくい方への支援事業だ"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_7.
kg:op_69 prop:content "家庭の事情なども支援対象の背景にある"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_7.
kg:op_70 prop:content "公共施設でカードやチラシを設置し周知している"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_7.
kg:op_71 prop:content "複数媒体でPRを行っている"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_7.
kg:op_72 prop:content "利用状況を踏まえて配布場所拡充や再配置を検討する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_7.
kg:op_73 prop:content "負担感なく受け取れるよう配慮している"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_7.
kg:op_74 prop:content "相談先周知の方法として有効だと考えている"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_7.
kg:op_75 prop:content "受け取りやすい環境整備のためアンケート実施も検討する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_7.
kg:st_8 rdfs:label "大谷謙治市民部長"@ja.
kg:st_8 rdfs:type cls:st_32.
kg:op_76 prop:content "自主返納者数は年々増加している"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_8.
kg:op_77 prop:content "代替交通利用のきっかけとして支援している"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_8.
kg:op_78 prop:content "交付手数料を助成して返納を促している"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_8.
kg:op_79 prop:content "公共交通利用のきっかけづくりとして運賃割引を行っている"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_8.
kg:st_9 rdfs:label "鈴木和仁教育長"@ja.
kg:st_9 rdfs:type cls:st_51.
kg:op_80 prop:content "年度当初に危険箇所を調査し教育委員会で集約している"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_9.
kg:op_81 prop:content "関係機関で情報共有し危険箇所ごとに対策を検討している"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_9.
kg:op_82 prop:content "現地確認が必要な箇所は学校やPTAや自治会なども参加して合同点検している"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_9.
kg:op_83 prop:content "見守り活動は交通事故の未然防止に大きく寄与している"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_9.
kg:op_84 prop:content "立哨者を見かけることで運転者への抑止が効く"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_9.
kg:op_85 prop:content "PDCAを重視し安全確保のため必要な対策を講じている"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_9.
kg:op_86 prop:content "半数以上の小中学校で作成し家庭配布や掲示で注意喚起している"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_9.
kg:op_87 prop:content "ゾーン30より厳しい規制として5か所に設定している"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_9.
kg:st_10 rdfs:label "宮崎和幸企画部長"@ja.
kg:st_10 rdfs:type cls:st_32.
kg:op_88 prop:content "自家用車の普及で地域公共交通の利用者が大きく減った"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_10.
kg:op_89 prop:content "運転手確保も地域公共交通の課題だ"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_10.
kg:op_90 prop:content "運行経費が年々増加している"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_10.
kg:op_91 prop:content "令和4年度に向けてバス路線を再編する"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_10.
kg:op_92 prop:content "利便性向上と持続可能な公共交通確立を目指す"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_10.
kg:op_93 prop:content "臨時休業後のアンケートで睡眠不調を訴える児童生徒が見られた"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_9.
kg:op_94 prop:content "身体的不調を訴える児童生徒が少し多く見られた"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_9.
kg:op_95 prop:content "生活リズムの崩れが身体的不調につながっている"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_9.
kg:op_96 prop:content "感染不安が精神的不安や体調不良にもつながっている"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_9.
kg:op_97 prop:content "担任と養護教諭が丁寧に見取りを行っている"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_9.
kg:op_98 prop:content "カウンセラー助言や個別指導で不安解消に努めている"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_9.
kg:op_99 prop:content "基本的な感染防止をさらに徹底している"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_9.
kg:op_100 prop:content "30分に1回以上の換気を再度指示した"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_9.
kg:op_101 prop:content "給食時の黙食を徹底している"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_9.
kg:op_102 prop:content "マスクを外す場面での会話回避を指示している"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_9.
kg:op_103 prop:content "更衣室等でも会話をしないよう再度指示した"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_9.
kg:op_104 prop:content "本市は関係者に陽性者が出た時点で原則学校全体を臨時休業としている"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_9.
kg:op_105 prop:content "再開時期は保健所と連携して判断している"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_9.
kg:op_106 prop:content "端末は授業の補助ツールとして調べ学習などで活用している"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_9.
kg:op_107 prop:content "協働学習で意見発信や交換に活用している"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_9.
kg:op_108 prop:content "ドリル教材を朝学習や自主学習に取り入れている"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_9.
kg:op_109 prop:content "学びの保障として遠隔授業を取り入れた学校があった"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_9.
kg:op_110 prop:content "現行基準は国の補助金要綱に示された通学距離に基づいている"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_9.
kg:op_111 prop:content "学校を取り巻く環境変化を踏まえ国の動きを注視したい"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_9.
kg:op_112 prop:content "感染拡大の影響で市民から意見を聞くワークショップを中止せざるを得なかった"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_3.
kg:op_113 prop:content "幅広い世代から要望が多く重要な施策の一つと認識している"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_3.
kg:op_114 prop:content "コロナ後の視点で酒田市民に本当に必要な施設の在り方を整備手法も含め検討したい"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_3.
kg:op_115 prop:content "緊急事態宣言では知事が飲食店などに休業要請できる"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_4.
kg:op_116 prop:content "命令に応じない事業者には30万円以下の過料を科すことができる"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_4.
kg:op_117 prop:content "重点措置は地域を限定して適用される"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_4.
kg:op_118 prop:content "重点措置では休業ではなく時短要請にとどまる"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_4.
kg:op_119 prop:content "第5波収束と医療体制崩壊防止のため県内全域で集中的対策を行った"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_4.
kg:op_120 prop:content "医療提供体制崩壊防止が集中期間設定の目的だ"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_4.
kg:op_121 prop:content "県民や事業者や学校関係へ協力要請を行った"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_4.
kg:op_122 prop:content "医療提供体制強化にも取り組んだ"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_4.
kg:op_123 prop:content "新規感染者数が目標に達しないため期間延長した"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_4.
kg:op_124 prop:content "時短要請がないため協力金支給の対象にならない"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_4.
kg:op_125 prop:content "感染拡大長期化で飲食業への影響が続いている"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_4.
kg:op_126 prop:content "第5波による自粛や会合制限がさらに影響を与えた"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_4.
kg:op_127 prop:content "県外客を断ったため売上が減少した店舗がある"@ja.
kg:op_127 rdf:type cls:opinion.
kg:op_127 prop:speaker kg:st_4.
kg:op_128 prop:content "同一テナント内の感染で営業自粛を余儀なくされた"@ja.
kg:op_128 rdf:type cls:opinion.
kg:op_128 prop:speaker kg:st_4.
kg:op_129 prop:content "営業再開後も来客回復が進まない店舗がある"@ja.
kg:op_129 rdf:type cls:opinion.
kg:op_129 prop:speaker kg:st_4.
kg:op_130 prop:content "世界需要が高い分野では回復が進んでいる"@ja.
kg:op_130 rdf:type cls:opinion.
kg:op_130 prop:speaker kg:st_4.
kg:op_131 prop:content "巣ごもり需要で製造業や小売業の一部が回復した"@ja.
kg:op_131 rdf:type cls:opinion.
kg:op_131 prop:speaker kg:st_4.
kg:op_132 prop:content "都市インフラ関連企業の立地も景況判断のプラス要因だ"@ja.
kg:op_132 rdf:type cls:opinion.
kg:op_132 prop:speaker kg:st_4.
kg:op_133 prop:content "全体としては昨年度より景況が回復傾向にある"@ja.
kg:op_133 rdf:type cls:opinion.
kg:op_133 prop:speaker kg:st_4.
kg:op_134 prop:content "カーボンニュートラル特化計画はないが総合計画等で再エネ政策を進めている"@ja.
kg:op_134 rdf:type cls:opinion.
kg:op_134 prop:speaker kg:st_3.
kg:op_135 prop:content "環境に配慮しながら直営風力発電を今年4月から運転開始した"@ja.
kg:op_135 rdf:type cls:opinion.
kg:op_135 prop:speaker kg:st_3.
kg:op_136 prop:content "酒田港を基地港湾・カーボンニュートラルポートにする勉強会を立ち上げた"@ja.
kg:op_136 rdf:type cls:opinion.
kg:op_136 prop:speaker kg:st_3.
kg:op_137 prop:content "国県沿岸自治体地元企業で検討会を立ち上げた"@ja.
kg:op_137 rdf:type cls:opinion.
kg:op_137 prop:speaker kg:st_3.
kg:op_138 prop:content "酒田市沖の洋上風力発電導入に向け県と協議を開始している"@ja.
kg:op_138 rdf:type cls:opinion.
kg:op_138 prop:speaker kg:st_3.
kg:op_139 prop:content "カーボンニュートラルは環境活動だけでなく産業形成の解決策にもなる"@ja.
kg:op_139 rdf:type cls:opinion.
kg:op_139 prop:speaker kg:st_3.
kg:op_140 prop:content "国の成長戦略や温暖化対策計画を踏まえ総合計画後期計画に取り入れたい"@ja.
kg:op_140 rdf:type cls:opinion.
kg:op_140 prop:speaker kg:st_3.
kg:op_141 prop:content "中長期戦略では地域産業活性化と酒田港活用が外せない"@ja.
kg:op_141 rdf:type cls:opinion.
kg:op_141 prop:speaker kg:st_3.
kg:op_142 prop:content "昨年末くらいから意識的に意見交換を行ってきた"@ja.
kg:op_142 rdf:type cls:opinion.
kg:op_142 prop:speaker kg:st_3.
kg:op_143 prop:content "非効率石炭火力の扱いが今後の動向に大きく関わる"@ja.
kg:op_143 rdf:type cls:opinion.
kg:op_143 prop:speaker kg:st_3.
kg:op_144 prop:content "立地自治体としてリプレースを含め望ましい在り方について必要な声を上げていく"@ja.
kg:op_144 rdf:type cls:opinion.
kg:op_144 prop:speaker kg:st_3.
kg:op_145 prop:content "石炭火力削減と同時に雇用や産業シフトを含む地域政策を国に求めるべきだ"@ja.
kg:op_145 rdf:type cls:opinion.
kg:op_145 prop:speaker kg:st_3.
kg:st_11 rdfs:label "安川智之地域創生部産業振興調整監"@ja.
kg:st_11 rdfs:type cls:st_32.
kg:op_146 prop:content "ワンストップ相談窓口で創業希望者を総合支援している"@ja.
kg:op_146 rdf:type cls:opinion.
kg:op_146 prop:speaker kg:st_11.
kg:op_147 prop:content "事業計画や資金調達や販路拡大まで支援員が対応している"@ja.
kg:op_147 rdf:type cls:opinion.
kg:op_147 prop:speaker kg:st_11.
kg:op_148 prop:content "上限100万円の補助が初期投資負担軽減に有効に働いている"@ja.
kg:op_148 rdf:type cls:opinion.
kg:op_148 prop:speaker kg:st_11.
kg:op_149 prop:content "保証料負担軽減で保証制度を利用しやすくしている"@ja.
kg:op_149 rdf:type cls:opinion.
kg:op_149 prop:speaker kg:st_11.
kg:op_150 prop:content "コロナ禍を受けた新事業展開としてキッチンカー購入を始めた事業者がいる"@ja.
kg:op_150 rdf:type cls:opinion.
kg:op_150 prop:speaker kg:st_11.
kg:op_151 prop:content "潜在的な創業希望者の掘り起こしが課題だ"@ja.
kg:op_151 rdf:type cls:opinion.
kg:op_151 prop:speaker kg:st_11.
kg:op_152 prop:content "今年度から創業前のもやもやした相談を受け案件掘り起こしに努めている"@ja.
kg:op_152 rdf:type cls:opinion.
kg:op_152 prop:speaker kg:st_11.
kg:op_153 prop:content "金融機関から支援員派遣を受け必要なサポートをしている"@ja.
kg:op_153 rdf:type cls:opinion.
kg:op_153 prop:speaker kg:st_11.
kg:op_154 prop:content "県外向け移住ポータルサイトに創業相談やコワーキング利用情報を掲載している"@ja.
kg:op_154 rdf:type cls:opinion.
kg:op_154 prop:speaker kg:st_11.
kg:op_155 prop:content "酒田で実際に創業し活動している事例発信は有効だ"@ja.
kg:op_155 rdf:type cls:opinion.
kg:op_155 prop:speaker kg:st_11.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "日本は人口減少が加速し、本市も例外なく影響を受けております。地域の活動や文化活動、経済の面では、購買力低下などの内需に影響する"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "日本は人口減少が加速し、本市も例外なく影響を受けております。地域の活動や文化活動、経済の面では、購買力低下などの内需に影響するだけでなく、多くの業態において人手不足となっております"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "また、事業を存続・継続するための後継者不足もまた重大な課題となっております"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "これは、農産物の需要の減少や価格の低迷により、農業で生計を立てることに難しさを感じた若い世代が就農してこなかったと思われます"@ja.
<< kg:id_6 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "これは、農産物の需要の減少や価格の低迷により、農業で生計を立てることに難しさを感じた若い世代が就農してこなかったと思われます"@ja.
<< kg:id_6 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "こうした中で、稲作経営の先行きに不安を抱えて就農をためらったり"@ja.
<< kg:id_6 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "また、親が子に就農を勧められず、自ら現役で農業を続けることになったり、世代交代できなかったと推測しております"@ja.
<< kg:id_6 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "自ら現役で農業を続けることになったり、世代交代できなかったと推測しております"@ja.
<< kg:id_6 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "一方で、認定農業者、それから、農業法人の担い手への農地の集積率が増加していることで、農業就業者人口が減少したことも要因の一つでございます"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本市の農業就業人口は毎年減少している一方で、65歳以上の農業就農者は増加しております。これが高齢化率を上げている要因になってございます"@ja.
<< kg:id_13 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "このため、農業就業人口は増加せず、また、高齢農家世帯では世代交代が行われず、高齢化が進んでいる現状でございます"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "酒田市農業の方向性にもありますように、農業経営体の法人化を推進してきました。これにより、農業法人の増加に伴って、非農家出身の雇用就農者が増加しております"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "これにより、農業法人の増加に伴って、非農家出身の雇用就農者が増加しております"@ja.
<< kg:id_16 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "最近では、経営目線で農業に取り組む農業法人も増加しております。農業がビジネスと捉えられるようになったことも一因であると考えております"@ja.
<< kg:id_20 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "このたび、担い手等の育成のために準備を進めてきました酒田もっけ田農学校がいよいよ来月、10月６日に開講する予定でございます。担い手や後継者の育成等において、大きな意義があると考えております"@ja.
<< kg:id_20 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "当学校では、新規就農者や農業に興味のある方を対象にして、水稲作業の全ての工程について、その必要性や効果を実証し、知識や科学的根拠に基づいた農業を実践するとともに"@ja.
<< kg:id_20 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "知識や科学的根拠に基づいた農業を実践するとともに、先輩農家との交流"@ja.
<< kg:id_20 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "さらには受講者の目的に応じたカリキュラムを通して米作りを実施していきます"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "このことにつきましては、コロナ禍による消費低迷"@ja.
<< kg:id_25 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "それから、今年の作況、悪くはないという情報もあるわけですけれども"@ja.
<< kg:id_25 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "こういったものとか、あるいは今後の需給の見通し"@ja.
<< kg:id_25 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "あるいは市場相場など、総合的に判断されて決定されたものだと認識してございます"@ja.
<< kg:id_25 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "単価については大変厳しい状況であるということで、農家所得の減少が見込まれる"@ja.
<< kg:id_25 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "本市の経済にも相当大きな影響を及ぼすものと受け止めてございます"@ja.
<< kg:id_25 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "本市としては、例えば出口戦略としての米の消費拡大事業などは、今後もしっかりと行っていく必要があるんだろうと思っております"@ja.
<< kg:id_25 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "やはりこれは国などの支援を今まで以上に求めていく必要があるんだろうと考えております"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "今現在、国・県からのワクチン供給が不安定であり、当初の予定どおりに進んでおりません"@ja.
<< kg:id_34 prop:cause kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "しかしながら、本市に配分されるワクチン量が不十分なために、８月から集団接種は、予定した日程を一部中止をしたり、それから、個別接種については、65歳以上の高齢者及び基礎疾患のある方などに限定をして接種をしてきたという状況にございます"@ja.
<< kg:id_34 prop:effect kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "８月から集団接種は、予定した日程を一部中止をしたり"@ja.
<< kg:id_34 prop:effect kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "個別接種については、65歳以上の高齢者及び基礎疾患のある方などに限定をして接種をしてきたという状況にございます"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "本市では、妊娠後期に感染すると重症化のリスクが高まるとされている妊婦とその配偶者やパートナー"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "受験や就職活動などを控えている中学３年生や高校３年生に相当する方を対象に優先接種を実施をする"@ja.
<< kg:id_39 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "妊婦につきましては、妊婦健康診査で受診をしております日本海総合病院をはじめとする市内及び鶴岡市内のかかりつけ産科医療機関において、優先的に個別接種できるよう各医療機関と調整をし"@ja.
<< kg:id_44 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "妊婦の配偶者などにつきましては、現時点で最も早く接種日程を確保できる９月25日土曜日と26日日曜日に実施する集団接種で優先的に接種できることとし"@ja.
<< kg:id_41 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "中学３年生803人と高校３年生など904人については、集団接種では９月19日から10月３日までの土曜日と日曜日の実施日に優先接種できる日程を確保し"@ja.
<< kg:id_39 prop:cause kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "これら優先接種は、それぞれから要望が寄せられていたこと"@ja.
<< kg:id_39 prop:cause kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "また、国や県からも優先的に接種できるよう配慮を求める旨の通知があったことから、酒田市としても実施する決定を早めたところでございます"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "接種をしていない方からは差別と受け取られてしまう場合もあろうかと思います"@ja.
<< kg:id_49 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "市としては、ワクチン接種差別はあってはならないものと捉えているところでございまして、今後も国からの情報提供に注視しながら、ワクチン接種差別を生まないよう広報や各種通知等を活用し、適時適切に周知を図っていきたい"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "認証基準をクリアするために座席の間隔を１メートル以上空けなきゃいけない"@ja.
<< kg:id_52 prop:effect kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "それを確保するためには座席数を減らさなければならない"@ja.
<< kg:id_52 prop:effect kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "それでは採算が合わないといった理由から、取組をためらうとの声も聞こえてまいります"@ja.
<< kg:id_52 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "安全・安心をアピールするための手段として、この制度の積極的な活用については、機会を捉えて、本市としてもやはり周知を図っていく必要がある"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "長引くコロナ禍によりまして、若者を中心に地方への移住志向がより高まっているものと認識をしております"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "酒田市の生涯活躍のまち構想、これにつきましては、消防本署の跡地を活用した移住者向け住宅と地域交流拠点を整備運営する予定事業者を今年の４月に選定をいたしました"@ja.
<< kg:id_59 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "今年度からは移住者向け住宅改修補助金の対象経費にインターネット環境の整備費用を追加するなどの支援も開始をしたところでございました"@ja.
<< kg:id_59 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "新たに市のホームページにおいて、企業や個人の移転・移住に関する情報を一元的に紹介するページを設けたところでございます"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "ワクチンだけにとどまらず、コロナウイルス感染症に関しての影響からの妊娠や出産、不安に関しての訴えを述べられるような妊婦もございます"@ja.
<< kg:id_63 prop:cause kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "いわゆるインターネットなどで様々な本当に情報があふれているといいますか、そういったところがございます"@ja.
<< kg:id_63 prop:cause kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "妊婦の中にも出産やそういったところに影響が出ないかということを御心配の方々がたくさんいらっしゃいます"@ja.
<< kg:id_63 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "日本産婦人科学会、感染症学会だったり、厚生労働省のほうからも正しい情報というようなことでいろいろな情報が出ておりますので、そういったものをきちんと活用しながら、いろいろな場面で妊婦の不安を取り除くような形で周知も図っていきたい"@ja.
<< kg:id_68 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "ワクチンを受けている、受けていないといった理由で周りの人を悪く言ったり、いじめたりすることは絶対にあってはなりません"@ja.
<< kg:id_68 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "接種の日にちを複数設定して、誰が接種していないか、なるべくお互いに分からないようにというふうな配慮もしております"@ja.
<< kg:id_71 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "厚生労働省で12歳以上の子供と保護者を対象につくったチラシをこの案内と一緒に配付しております"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "まだまだ制度の趣旨だとか、あるいは手続の面だとか、そういったところの理解が少し進んでいないのかなというところもございます"@ja.
<< kg:id_73 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "これまで認定をいただいた方、どのように活用しているか、そういったところを含めて、改めて周知を図っていきたい"@ja.
<< kg:id_76 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "エアコンの設置に合せて、例えば断熱窓や手すりの設置など、住宅の質の向上を図る要件工事と一緒に工事を行う場合は補助の対象となります"@ja.
<< kg:id_78 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "生活保護受給世帯については、保護開始から初めての夏を迎える世帯に対してはエアコンを給付することができるようになりまして、酒田市もこの制度改正があった平成30年度から、これまで５件の実績がございます"@ja.
<< kg:id_80 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "被害の程度によって、国や県への働きかけをしていきたいと考えております"@ja.
<< kg:id_82 prop:cause kg:id_83 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "内水氾濫による被害は、台風や線状降水帯などの急激な降雨に対して、排水施設の能力を超えたり"@ja.
<< kg:id_82 prop:cause kg:id_84 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "河川の水位が上昇し雨水を排水できない場合に生じるものであります"@ja.
<< kg:id_82 prop:effect kg:id_85 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "床下浸水が190戸"@ja.
<< kg:id_82 prop:effect kg:id_86 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "床上浸水が３戸の住家被害が生じました"@ja.
<< kg:id_82 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "市の職員が戸別訪問調査を行い、被害状況の把握に加えて、支援の要望などの聞き取りを行いました"@ja.
<< kg:id_82 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "家屋周辺の消毒を実施することや、浸水により発生したごみ処分などの案内について、被害発生から３日後には隣組の回覧を行い、情報提供を行いました"@ja.
<< kg:id_89 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "主要地方道酒田松山線の冠水対策を酒田市の重要事業と位置づけ、今年の５月に山形県に対し整備を要望したところであります"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "御質問のポンプ場や雨水貯留槽については、内水氾濫の解消を図る上で有効な手法であり、条件が整えば技術的に可能な対策と考えております"@ja.
<< kg:id_89 prop:effect kg:id_92 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "ポンプ場が約60億円"@ja.
<< kg:id_89 prop:effect kg:id_93 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "雨水貯留槽が約30億円"@ja.
<< kg:id_89 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "この雨水については本溝排水路に流さず、別系統で新井田川まで新たな雨水幹線を整備し、そして、ポンプ場などで強制排水するという手法であります"@ja.
<< kg:id_95 prop:cause kg:id_96 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "生理用品サポート事業は、新型コロナウイルス感染症拡大の影響による経済的な困窮のほか"@ja.
<< kg:id_95 prop:cause kg:id_97 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "家庭の事情など何らかの理由で生理用品を用意することが難しい方へ支援をするもので"@ja.
<< kg:id_98 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "市役所や交流ひろば及び健康センターなどの公共施設で、各施設の実情に応じてチラシ及び受け取り希望カードを設置して、掲示をしております"@ja.
<< kg:id_98 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "また、広報紙やホームページ、酒田ＦＭハーバーラジオなどを活用したＰＲも行っております"@ja.
<< kg:id_98 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "今後は、これまでの利用状況を踏まえて、配布場所の拡充や在庫用品の再配置を検討していきたい"@ja.
<< kg:id_98 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "必要な方が負担感なく受け取ることができるよう受け取り希望カードなどの提示による受け取りや、女性職員が対応するなど十分に配慮して行っております"@ja.
<< kg:id_98 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "配布の袋には子ども・家庭総合支援室のチラシや相談窓口の一覧表を入れておりますので、相談先を周知する方法としては有効だと考えております"@ja.
<< kg:id_98 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "今後は、利用者へのアンケート実施の検討も含め、希望する方が受け取りやすい環境の整備に引き続き努めていきたい"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "本市の返納者数は年々増加傾向にある"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "免許返納時１回限りとして5,000円相当のタクシー券またはバス回数券の交付"@ja.
<< kg:id_107 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "運転経歴証明書の交付手数料1,100円の助成"@ja.
<< kg:id_107 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "運転経歴証明書の提示によります酒田市乗合バスとデマンドタクシーの運賃の100円割引を行っている"@ja.
<< kg:id_111 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "毎年でございますけれども、まず年度当初４月に教育委員会から各小学校に危険箇所の調査、報告を依頼しております"@ja.
<< kg:id_111 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "国、県、市の道路管理者や酒田警察署、市の担当課などによる通学路安全推進会議を開催しまして、その集約した情報を共有するとともに、危険箇所ごとに対策を検討し"@ja.
<< kg:id_111 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "さらに現地確認が必要な箇所については合同で点検を実施しているところでございます"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "登校時における交通事故の未然防止に大きく寄与していると考えております"@ja.
<< kg:id_115 prop:effect kg:id_117 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "見守り活動をしている方々を運転者の立場で発見すると、抑止が効くといいますか、スピードにも注意したり"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "合同点検の実施・対策の検討、対策の実施、それから対策効果の把握、対策の改善・充実とこういうＰＤＣＡのサイクルを重視しながら、安全確保のために必要な対策を講じている"@ja.
<< kg:id_120 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "主に学校ごとに作成しておりまして、本市では半数以上の小中学校で作成しているところでございます"@ja.
<< kg:id_122 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "登校時に限定した車両通行止め、いわゆるスクールゾーンがあります。これは、指定された道路について指定時間帯の車両通行を禁止し、歩行者専用道路にするものでございますけれども、ゾーン30よりも厳しい規制になっております。本市では５か所に設定されております"@ja.
<< kg:id_124 prop:cause kg:id_125 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "鉄道、バス、タクシーなどの地域公共交通でございますけれども、自家用車の普及とともに利用者数、大分激減してございます"@ja.
<< kg:id_124 prop:cause kg:id_126 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "運転手の確保ですとか"@ja.
<< kg:id_124 prop:cause kg:id_127 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "運行に係る燃料費、これらの増加によりまして年々経費が増加している"@ja.
<< kg:id_128 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "この改正によりましてアクセス性を高めるとともに、分かりやすく利用しやすいバス路線に再編をする"@ja.
<< kg:id_128 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "また、デマンドタクシーの運行内容も充実を図っていくことで、より利用者の利便性が向上し、地域公共交通が持続可能なものとなるような、そういったふうに確立できるものとして考えてございます"@ja.
<< kg:id_131 prop:effect kg:id_132 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "再開後アンケートを取っておるんですけれども、よく眠れないときがある"@ja.
<< kg:id_131 prop:effect kg:id_133 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "頭痛や腹痛があるなどの身体的な不調を訴える児童・生徒が少し多く見られます"@ja.
<< kg:id_131 prop:cause kg:id_134 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "生活のリズムの崩れが身体的な不調にも結びついているのではないかと考えているところです"@ja.
<< kg:id_131 prop:cause kg:id_135 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "コロナに感染するのではないか心配だとか、コロナのことで学校に行くのが不安になるですとか、そういう精神的な不安を訴える児童・生徒もおりまして"@ja.
<< kg:id_131 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "各学校では担任の先生、それから養護教諭の先生を中心といたしまして、児童・生徒の丁寧な見取りをしていただいております"@ja.
<< kg:id_131 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "必要に応じてスクールカウンセラーからの助言等もいただき、個別指導などを通して、悩みや不安をできる限り解消できるよう努めている"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "さらに、不織布マスクの着用"@ja.
<< kg:id_138 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "30分に１回以上の換気"@ja.
<< kg:id_138 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "給食では黙食の徹底"@ja.
<< kg:id_138 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "体育や部活動においてマスクを外す場面では会話を避ける"@ja.
<< kg:id_138 prop:contermeasure kg:id_143 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "更衣室等での着替えにおいては会話をしないことなど、各学校に再度指示依頼をしている"@ja.
<< kg:id_144 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "本市としては、関係者に陽性者が判明したその時点で原則臨時休業としております"@ja.
<< kg:id_144 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "学校再開については感染状況に応じまして、保健所と連携を取りながら判断している"@ja.
<< kg:id_147 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "調べ学習で検索したりですとか"@ja.
<< kg:id_147 prop:contermeasure kg:id_149 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "グループ等での協働学習で自分の意見を発信したり、あるいは友達の意見と意見の集約や交換を行ったり"@ja.
<< kg:id_147 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "おさらいや朝学習・夏休みの自主学習としてドリル教材を利用したりするなど"@ja.
<< kg:id_147 prop:contermeasure kg:id_151 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "臨時休業した学校では、学びの保障ということで、遠隔授業を取り入れた学校もございました"@ja.
<< kg:id_152 prop:cause kg:id_153 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "このスクールバスの運行基準、これは国のへき地児童生徒援助費等補助金交付要綱に示されているとおりで、通学条件の緩和を図る遠距離通学児童・生徒の通学距離、これに基づいて設定している"@ja.
<< kg:id_152 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "今後もその学校現場の声や地域の方々の御意見等に耳を傾けますとともに、国の動きを注視していきたい"@ja.
<< kg:id_155 prop:cause kg:id_156 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "具体的なアクションとして、令和２年度に市民からの意見を聞くための市民ワークショップの開催、これを予定していたところでございました。しかしながら、新型コロナウイルス感染拡大の影響によりまして、なかなか市民の皆さんから集まっていただくということもできない"@ja.
<< kg:id_157 prop:cause kg:id_158 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "子育て世代の皆様だけでなくて、おじいちゃん、おばあちゃんの世代の皆様からも要望が多いことは大変認識は私自身もしておりますし、引き続き重要な施策の一つとしては捉えている"@ja.
<< kg:id_157 prop:contermeasure kg:id_159 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "これからのアフターコロナ、ウィズコロナの時代に、酒田市民が本当に必要とする屋内型の児童遊戯施設、これはどうあるべきなのかということについて、これは整備手法も含めてでありますけれども、これからまた検討をしていきたい"@ja.
<< kg:id_160 prop:effect kg:id_161 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "宣言地域の知事は、飲食店など事業者に休業要請をすることができます"@ja.
<< kg:id_160 prop:effect kg:id_162 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "それでも応じないと30万円以下の過料を科すことができるものです"@ja.
<< kg:id_163 prop:effect kg:id_164 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "原則として知事が指定する市区町村や地域のみが対象となるものでございます"@ja.
<< kg:id_163 prop:effect kg:id_165 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "重点措置地域では、知事は休業を求められず、要請できるのは営業時間の短縮にとどまります"@ja.
<< kg:id_166 prop:cause kg:id_167 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "本取組につきましては、新型コロナ第５波の一日も早い収束を目指す"@ja.
<< kg:id_166 prop:cause kg:id_168 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "医療提供体制の崩壊を防ぐため、期間を限定して、県内全域を対象に県民挙げて集中的に感染拡大対策に取り組んだ"@ja.
<< kg:id_166 prop:contermeasure kg:id_169 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "取組内容としましては特措法第24条第９項に基づいた県民、事業者、学校関係への協力要請を行う"@ja.
<< kg:id_166 prop:contermeasure kg:id_170 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "医療提供体制の強化等に取り組んでおります"@ja.
<< kg:id_166 prop:cause kg:id_171 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "目標としておりました１日当たりの新規感染者数１桁に至っていないことから、期間を本日９月15日まで延長し取組を継続した"@ja.
<< kg:id_166 prop:effect kg:id_172 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "県が実施しました特別集中期間では、事業者には県外出張の半減とテレワークの導入などについて協力を要請しておりますが、時短要請はしていないため、協力金は支給されない"@ja.
<< kg:id_173 prop:cause kg:id_174 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_125;
    prop:text-txt_contents "本市の飲食業の状況につきましては、昨年度来の新型コロナウイルスの感染拡大が長期化しており"@ja.
<< kg:id_173 prop:cause kg:id_175 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "８月以降の第５波と言われる感染拡大による外出の自粛や会合の制限で、さらに影響が生じている"@ja.
<< kg:id_173 prop:cause kg:id_176 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_127;
    prop:text-txt_contents "感染防止対策のために県外のお客様をお断りしたために売上げが減少した店舗"@ja.
<< kg:id_173 prop:cause kg:id_177 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "テナント形式の店舗従業員の方が新型コロナに感染したことにより、当面の間、同じテナントに入っている店舗も営業を自粛した"@ja.
<< kg:id_173 prop:effect kg:id_178 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_129;
    prop:text-txt_contents "営業再開後も来客がないなどの状況があると伺っております"@ja.
<< kg:id_179 prop:cause kg:id_180 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_130;
    prop:text-txt_contents "半導体関連など世界的な需要が高まっている分野"@ja.
<< kg:id_179 prop:cause kg:id_181 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "感染拡大に伴います巣籠もり需要が高まっている分野の製造業や小売業"@ja.
<< kg:id_179 prop:cause kg:id_182 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_132;
    prop:text-txt_contents "都市インフラに関連する業種の本市への立地が続いており、景況判断のプラス要因として考えております"@ja.
<< kg:id_179 prop:effect kg:id_183 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "昨年度と比較しますと全体としては景況が回復傾向にあると捉えているところでございます"@ja.
<< kg:id_184 prop:contermeasure kg:id_185 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_134;
    prop:text-txt_contents "本市におきましては、実はこのカーボンニュートラルに特化した戦略ですとか計画は策定はしておらないところでございますが、平成30年策定の酒田市総合計画及び令和２年策定の第２期酒田市まち・ひと・しごと創生総合戦略の中で、再生可能エネルギーに係る取組を掲げて政策を推進しております"@ja.
<< kg:id_184 prop:contermeasure kg:id_186 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_135;
    prop:text-txt_contents "現在御承知のとおり、直営の風力発電事業に取り組んでおって、今年４月から運転を開始しているところでございます"@ja.
<< kg:id_184 prop:contermeasure kg:id_187 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_136;
    prop:text-txt_contents "６月３日に酒田市と山形県とで酒田港基地港湾等カーボンニュートラルポート連携会議という会議を立ち上げて、酒田港を洋上風力発電の基地港湾等を目指し、かつカーボンニュートラルポートにしていこうというそういう勉強会を立ち上げている"@ja.
<< kg:id_184 prop:contermeasure kg:id_188 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_137;
    prop:text-txt_contents "昨日９月14日には酒田港のカーボンニュートラルポート検討会という、これは国と県と沿岸自治体、酒田、遊佐、それから地元の企業、それで構成する検討会をも立ち上げたところでございます"@ja.
<< kg:id_184 prop:contermeasure kg:id_189 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_138;
    prop:text-txt_contents "山形県等と酒田市沖での洋上風力発電の導入の検討に向けた協議を今、山形県との間で開始しているところでございます"@ja.
<< kg:id_184 prop:effect kg:id_190 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_139;
    prop:text-txt_contents "カーボンニュートラルに向けた取組が、環境活動というだけではなくて、ビジネスソリューション、横文字で恐縮でございますが、私なりには産業形成の解決策だと捉えています"@ja.
<< kg:id_184 prop:contermeasure kg:id_191 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_140;
    prop:text-txt_contents "国のグリーン成長戦略ですとかエネルギー基本計画、地球温暖化対策計画の方向性を踏まえた上で、今年と来年で策定をいたしますが、総合計画の後期計画の中にしっかりと取り入れて"@ja.
<< kg:id_184 prop:contermeasure kg:id_192 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_141;
    prop:text-txt_contents "中期的、それから長期的な戦略を組むに当たっては、やはり本市の持続可能なまちの姿、これを考えていかなければいけないということで、まずは地域産業の活性化と酒田港の活用、これは外してはならない重要なポイントである"@ja.
<< kg:id_193 prop:contermeasure kg:id_194 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_142;
    prop:text-txt_contents "私も昨年末くらいから酒田共同火力発電株式会社、そしてその親会社であります東北電力株式会社と、意識的に機会を捉えて意見交換を行わせていただいた"@ja.
<< kg:id_193 prop:cause kg:id_195 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_143;
    prop:text-txt_contents "非効率石炭火力発電の今後の在り方、それから、このことは酒田共同火力発電の今後の動向に大きく関わってくる"@ja.
<< kg:id_193 prop:contermeasure kg:id_196 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_144;
    prop:text-txt_contents "東北電力に対しましても、リプレースを含めて、酒田共同火力発電の望ましい在り方について、立地している自治体として必要な声は上げていきたい"@ja.
<< kg:id_193 prop:contermeasure kg:id_197 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_145;
    prop:text-txt_contents "国が石炭火力発電の着実な削減を進めていくというのであれば、同時にそれに代わる地域の雇用や産業のシフト、産業構造の変化も含めてですけれども、そういったことについて、地域が存続できる、その地域政策とセットで示されるべきでありましょうというそういう観点から、しっかりと我々の声を国に働きかけていきたい"@ja.
<< kg:id_198 prop:contermeasure kg:id_199 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_146;
    prop:text-txt_contents "酒田市産業振興まちづくりセンターサンロクの中に、創業に関するワンストップ相談窓口を設けております"@ja.
<< kg:id_198 prop:contermeasure kg:id_200 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_147;
    prop:text-txt_contents "創業・事業承継支援員が創業希望者の事業計画の策定ですとか資金調達、販路の拡大などの相談対応"@ja.
<< kg:id_198 prop:contermeasure kg:id_201 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_148;
    prop:text-txt_contents "上限100万円、対象経費の２分の１の補助になりますけれども、酒田市開業支援補助金を整備しておりまして、これが実に有効に働いている"@ja.
<< kg:id_198 prop:contermeasure kg:id_202 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_149;
    prop:text-txt_contents "信用保証協会に対して保証料というものを支払う必要がありますけれども、それを市が一部負担することによって、新規開業者が保証料負担を軽減して保証制度を利用できるようにしております"@ja.
<< kg:id_203 prop:cause kg:id_204 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_150;
    prop:text-txt_contents "今回のコロナ禍を受けまして、店舗だけでの経営は難しいということで新事業展開としてキッチンカーを購入されて始めたという方"@ja.
<< kg:id_205 prop:cause kg:id_206 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_151;
    prop:text-txt_contents "我々としてまだ課題だなと思っているのは、潜在的な創業希望者の掘り起こしだろうと思っています"@ja.
<< kg:id_205 prop:contermeasure kg:id_207 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_152;
    prop:text-txt_contents "いわゆるもやもやした時期と我々は呼んでいますけれども、そういったときに相談する先というのが極めてない、そういったところで、サンロクとしてはそういう時期の御相談をキャリアカウンセリングのような形で面談、御相談を受けてということを今年度から始めている"@ja.
<< kg:id_208 prop:contermeasure kg:id_209 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_153;
    prop:text-txt_contents "今年４月からその協定に基づきまして、酒田金融協会会員の金融機関から創業・事業承継支援員を派遣いただいていまして、必要なサポートをしている"@ja.
<< kg:id_210 prop:contermeasure kg:id_211 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_154;
    prop:text-txt_contents "県外の方の酒田へのＵＩＪターンの促進を目的としました酒田市移住ポータルサイト「ａｔ　ｓａｋａｔａ」にサンロクについて掲載をしております"@ja.
<< kg:id_210 prop:contermeasure kg:id_212 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_155;
    prop:text-txt_contents "また、サンロクのフェイスブックを通じて多くの創業事例を紹介させていただいております"@ja.
}
