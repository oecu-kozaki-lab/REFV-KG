kg:id_154 rdf:type cls:c_10274.
cls:c_10274 rdfs:label "企業誘致課題"@ja.
kg:id_155 rdfs:label "必要なインフラや行政支援や生活環境情報が一元的に発信できていないこと"@ja.
kg:id_155 rdf:type cls:c_2353.
