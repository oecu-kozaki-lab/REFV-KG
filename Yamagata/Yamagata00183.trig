kg:id_185 rdf:type cls:c_10353.
cls:c_10353 rdfs:label "利用促進活動"@ja.
kg:id_181 prop:countermeasure kg:id_185.
kg:id_186 rdfs:label "山形新幹線庄内延伸の実現困難"@ja.
kg:id_186 rdf:type cls:c_6552.
cls:c_6552 rdfs:label "延伸困難"@ja.
kg:id_187 rdfs:label "県の事業として位置づけがなされていないこと"@ja.
kg:id_187 rdf:type cls:c_10354.
cls:c_10354 rdfs:label "県事業未定"@ja.
kg:id_186 prop:cause kg:id_187.
kg:id_188 rdfs:label "山形新幹線庄内延伸"@ja.
kg:id_188 rdf:type cls:c_10355.
cls:c_10355 rdfs:label "路線延伸"@ja.
kg:id_189 rdfs:label "県土の一体的な発展につながる"@ja.
kg:id_189 rdf:type cls:c_2491.
cls:c_2491 rdfs:label "地域発展"@ja.
kg:id_188 prop:effect kg:id_189.
kg:id_190 rdfs:label "陸羽西線の廃線を防ぐ唯一の手だて"@ja.
kg:id_190 rdf:type cls:c_2492.
cls:c_2492 rdfs:label "廃線防止"@ja.
kg:id_188 prop:effect kg:id_190.
kg:id_191 rdfs:label "庄内開発協議会として要望を継続する"@ja.
kg:id_191 rdf:type cls:c_2493.
cls:c_2493 rdfs:label "要望継続"@ja.
kg:id_188 prop:countermeasure kg:id_191.
kg:st_1 rdfs:label "松本国博議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "スポーツを通じた交流の意義は大きい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "中止は非常に残念だった"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "鈴木和仁教育長"@ja.
kg:st_2 rdf:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_3 prop:content "心身の健康維持と増進に効果がある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "観戦や実践は健康維持増進に効果がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "誰もが楽しむことで長寿社会の実現につながる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "観光として活用し経済活動につなげるべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "交流人口増加につなげるべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "スポーツ観光の側面をこれまで以上に活用すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "メイン球場にもっと手をかけるべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "野球場として瀕死の状態だ"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "もはや野球場で観戦する形ではない"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "整備の在り方を優先順位も含め検討する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "最低限プレーできる設備を早急に整えるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_3 rdfs:label "丸山至市長"@ja.
kg:st_3 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_14 prop:content "市民や競技関係者の意見を聞き整備方針を固めたい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "時間や場所にとらわれず手続できる効果がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "内部事務の入力作業や分析の省力化に寄与する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "生活の中でデジタル変革を実感できる取組として進めたい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "主体的学習や探究的学習につなげたい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:st_4 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_4 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_19 prop:content "ＱＲコードやチラシなどで観光情報発信に取り組みたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "国民が安心できる説明を国に求めている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "来年度試験的な実施を考えたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:st_5 rdfs:label "斎藤周議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_22 prop:content "第６波に備えた対策強化が必要だ"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "ワクチンと同時に徹底した検査が必要だ"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:st_6 rdfs:label "松田俊一健康福祉部地域医療調整監"@ja.
kg:st_6 rdf:type cls:st_114.
cls:st_114 rdfs:label "医療担当"@ja.
kg:op_24 prop:content "基本的感染予防策の継続が重要だ"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_6.
kg:op_25 prop:content "庄内地域の検査体制充実につながる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "デジタル弱者を特に注目するのでなく行動促進で地域経済を守る"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:st_7 rdfs:label "菅原正成農林水産部長"@ja.
kg:st_7 rdf:type cls:st_18.
kg:op_27 prop:content "米農家は大変厳しい状況に直面している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_7.
kg:op_28 prop:content "大きな下げ幅で厳しい状況だ"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_7.
kg:op_29 prop:content "県内でいち早く対策を講じた"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_7.
kg:st_8 rdfs:label "遠田敏子議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_30 prop:content "必要な情報が届かず接種機会を逃した人が多い"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_8.
kg:op_31 prop:content "検診と合わせて非常に有効だ"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:st_9 rdfs:label "白畑真由美健康福祉部長"@ja.
kg:st_9 rdf:type cls:st_18.
kg:op_32 prop:content "個別通知などで周知徹底したい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_9.
kg:op_33 prop:content "空白期間の対象者へ適切に対応したい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "子供の将来や健康に大きな影響を与える"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_8.
kg:st_10 rdfs:label "齋藤一志教育次長"@ja.
kg:st_10 rdf:type cls:st_48.
cls:st_48 rdfs:label "教育次長"@ja.
kg:op_35 prop:content "潜在的な子供はもっと多い可能性がある"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_10.
kg:op_36 prop:content "学校は比較的早期発見しやすい環境にある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_10.
kg:op_37 prop:content "来年度以降も引き続き実態調査を実施したい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_10.
kg:op_38 prop:content "教育と福祉の連携をよりスピーディに図る"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_10.
kg:op_39 prop:content "高齢者にも丁寧な周知活動が必要だ"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_8.
kg:st_11 rdfs:label "大谷謙治市民部長"@ja.
kg:st_11 rdf:type cls:st_18.
kg:op_40 prop:content "高齢者にとっても大変便利なカードだ"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_11.
kg:op_41 prop:content "状況に応じてしっかり対応したい"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_11.
kg:op_42 prop:content "感染症対策を講じながら進めたい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_11.
kg:st_12 rdfs:label "佐藤喜紀議員"@ja.
kg:st_12 rdf:type cls:st_16.
kg:op_43 prop:content "選ばれる観光地となる取組が必要だ"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_12.
kg:op_44 prop:content "自然・食・文化を多角的に楽しむ旅を提供したい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "コロナ禍でも実施可能な取組を進める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "船社に応じた個別のおもてなしで対応したい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "学校と保護者に丁寧に説明し承認を得て実施したい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:st_13 rdfs:label "池田里枝教育次長"@ja.
kg:st_13 rdf:type cls:st_48.
kg:op_48 prop:content "受験や就職時期への配慮や市民意向から二十歳対象を維持する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_13.
kg:op_49 prop:content "若年層の消費者被害防止の周知が必要だ"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_11.
kg:op_50 prop:content "若年層が被害に遭わないよう注意喚起を続ける"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_11.
kg:op_51 prop:content "屋外活動後の宿泊利用も可能で有効活用してほしい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_13.
kg:st_14 rdfs:label "後藤仁議員"@ja.
kg:st_14 rdf:type cls:st_16.
kg:op_52 prop:content "高齢化の中で生活インフラ整備の方向性を見いだすべき"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_14.
kg:st_15 rdfs:label "矢口明子副市長"@ja.
kg:st_15 rdf:type cls:st_40.
cls:st_40 rdfs:label "副市長"@ja.
kg:op_53 prop:content "必要性や緊急性、効果を勘案し優先度を判断する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_15.
kg:op_54 prop:content "地域防災力を高める取組を支援していく"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_15.
kg:op_55 prop:content "担い手確保は大変重要な課題だ"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_15.
kg:op_56 prop:content "まず指定文化財の現況確定が課題だ"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_13.
kg:op_57 prop:content "本市の文化財保護活動への関わり方を検討したい"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_13.
kg:op_58 prop:content "研究者だけでなく多くの市民に喜ばれる施設を目指す"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_13.
kg:op_59 prop:content "当該発電所が稼働している現状では考えていない"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_15.
kg:op_60 prop:content "総合計画後期計画の中で具体的施策とともにつなげたい"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_15.
kg:op_61 prop:content "クールチョイスの浸透を図りたい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_15.
kg:op_62 prop:content "市全体のＣＯ２削減の方向性をしっかり示したい"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_11.
kg:op_63 prop:content "広報やホームページなどで周知を進めたい"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_15.
kg:op_64 prop:content "存続は黄色信号から赤信号に点滅しかかっている"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_3.
kg:op_65 prop:content "県の事業として位置づけられなければ前に進まない"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_3.
kg:op_66 prop:content "より大きく広範な組織の中で利便性向上を図るべきと判断した"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_3.
kg:op_67 prop:content "県が具体的方針として掲げなければ動き出さない"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_3.
kg:op_68 prop:content "庄内最上村山置賜を貫く県土の一体的な発展につながる"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_3.
kg:op_69 prop:content "実現に向けた働きかけを弱めるつもりはない"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_3.
kg:op_70 prop:content "来年度は会長としてイニシアチブを取って声を大にして要望する"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "新型コロナウイルス感染症の影響により、１年遅れの延期開催でありました"@ja.
<< kg:id_3 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "しかし、トライアスロン競技のニュージーランド代表チームの事前キャンプが中止になるなど、非常に残念なこともありました"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "スポーツと学習向上の相乗効果も認められております"@ja.
<< kg:id_4 prop:effect kg:id_6 >>
    prop:text-txt_contents "脳の発達、集中力のアップやストレス発散、身体健康増進の観点からもスポーツは重要かと思われます"@ja.
<< kg:id_4 prop:effect kg:id_7 >>
    prop:text-txt_contents "脳の発達、集中力のアップやストレス発散、身体健康増進の観点からもスポーツは重要かと思われます"@ja.
<< kg:id_4 prop:effect kg:id_8 >>
    prop:text-txt_contents "脳の発達、集中力のアップやストレス発散、身体健康増進の観点からもスポーツは重要かと思われます"@ja.
<< kg:id_4 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "脳の発達、集中力のアップやストレス発散、身体健康増進の観点からもスポーツは重要かと思われます"@ja.
<< kg:id_4 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "見てわくわくしたり、感動したりして楽しむこと、特にトップアスリート等の競技スポーツを観戦することで興奮や感動をすることは、心身の健康維持と増進に効果があるものと考えております"@ja.
<< kg:id_4 prop:effect kg:id_11 >>
    prop:text-txt_contents "子供にとってスポーツは、生涯にわたってたくましく生きるための健康や体力の基礎を培う"@ja.
<< kg:id_4 prop:effect kg:id_12 >>
    prop:text-txt_contents "公正さと規律を尊ぶ態度や克己心を育むなど人間形成に重要な役割を果たすものと捉えているところでございます"@ja.
<< kg:id_4 prop:effect kg:id_13 >>
    prop:text-txt_contents "公正さと規律を尊ぶ態度や克己心を育むなど人間形成に重要な役割を果たすものと捉えているところでございます"@ja.
<< kg:id_4 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "誰もが気軽にスポーツを「する」、「みる」、「ささえる」、この活動を通し楽しむことで、心身の健康の保持増進と健康で活力に満ちた長寿社会の実現ができるものと考えております"@ja.
<< kg:id_4 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "この事例のように、スポーツが経済活動・交流人口増加に貢献しており"@ja.
<< kg:id_4 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "この事例のように、スポーツが経済活動・交流人口増加に貢献しており"@ja.
<< kg:id_17 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "現在は海外からの旅行者、いわゆるインバウンドがしばらく期待できない状況にある"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "フィールド内の不備、運営施設内の雨漏りの常態化"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "フィールド内の不備、運営施設内の雨漏りの常態化"@ja.
<< kg:id_18 prop:cause kg:id_21 >>
    prop:text-txt_contents "医務室にはエアコンも整備されておらず"@ja.
<< kg:id_18 prop:cause kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "ついには観戦スタンドのおよそ８割が立入り禁止となり"@ja.
<< kg:id_18 prop:cause kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "照明設備の老朽化により、照明器具の落下の危険性があるため、現在、観覧席の一部を立入り禁止としております"@ja.
<< kg:id_18 prop:effect kg:id_24 >>
    prop:text-txt_contents "地区大会の開催はもちろん、練習試合もままならない施設となっております"@ja.
<< kg:id_18 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "地区大会の開催はもちろん、練習試合もままならない施設となっております"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "競技団体関係者をはじめ外部関係者を含めた懇談会を立ち上げ、検討してまいりたいと思っております"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "時間や場所にとらわれずに手続等ができるという市民の利便性の向上"@ja.
<< kg:id_28 prop:effect kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "オンライン申請ではその必要がなくなったり、それから、データの分析が省力化されるなど、業務の効率化にも寄与している"@ja.
<< kg:id_31 prop:countermeasure kg:id_32 >>
    prop:text-txt_contents "離島が抱える課題解決のため、ＩＣＴ技術の実装を図るための事業"@ja.
<< kg:id_31 prop:countermeasure kg:id_33 >>
    prop:text-txt_contents "観光客向けのスマート・オーダーシステム"@ja.
<< kg:id_31 prop:countermeasure kg:id_34 >>
    prop:text-txt_contents "ｅモビリティを活用した食事の配送システムの構築などに取り組んでいるところでございます"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:text-txt_contents "有機ＥＬを活用した遠隔診療実証実験"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "市民一人一人の属性や希望に合わせた情報発信を行うなどによりまして、市民が必要な情報を必要なときに入手することが可能となる市民マイページというものの構築を現在考えているところでございます"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:text-txt_contents "氏名や住所など一度入力したデータを何度も入力する必要がないワンスオンリーによるオンライン申請が実現するようになる"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "教育のデジタル変革を今年度調査を実施している電子学習ドリルの実証を皮切りに、デジタル技術を活用して子供一人一人に応じた学び方や指導の在り方を考察して"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "例えばＱＲコードで酒田の観光情報を流すとか、そういったことができるようなチラシ１枚、ポスター１枚、それでも効果があるのかなと思いますので、そういったところをこれから取り組んでまいりたいと思っております"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "マイナンバー制度の安全性や信頼性について、丁寧かつ十分に説明するなど、国として行うことが盛り込まれております"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "記者会見の会場でのネット環境の確保などの課題も整理をしながら、私としては来年度試験的な実施を考えていきたい"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "今後は感染拡大していく可能性が高い"@ja.
<< kg:id_49 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "軽い症状でも積極的に診察や検査を受けるよう呼びかけた"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:text-txt_contents "第５波は、家庭内感染が多く発生しました"@ja.
<< kg:id_52 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "不織布マスクの着用、小まめな手洗いや手指消毒、３密の回避、換気の励行などを継続して実践いただくことが重要"@ja.
<< kg:id_52 prop:countermeasure kg:id_55 >>
    prop:text-txt_contents "不織布マスクの着用、小まめな手洗いや手指消毒、３密の回避、換気の励行"@ja.
<< kg:id_52 prop:countermeasure kg:id_56 >>
    prop:text-txt_contents "不織布マスクの着用、小まめな手洗いや手指消毒、３密の回避、換気の励行"@ja.
<< kg:id_52 prop:countermeasure kg:id_57 >>
    prop:text-txt_contents "不織布マスクの着用、小まめな手洗いや手指消毒、３密の回避、換気の励行"@ja.
<< kg:id_52 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "県からは新たにＰＣＲ自主検査センターを鶴岡市立荘内病院に設置するための予算を12月県議会に上程"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:text-txt_contents "県では、庄内地域に新たに部屋数168室の宿泊療養施設を確保している"@ja.
<< kg:id_59 prop:countermeasure kg:id_61 >>
    prop:text-txt_contents "宿泊療養施設の医療体制は、午前８時から午後４時45分までの日中は看護師が常駐しており"@ja.
<< kg:id_59 prop:countermeasure kg:id_62 >>
    prop:text-txt_contents "緊急時などにつきましては当番医が対応できる体制が取られているところでございます"@ja.
<< kg:id_52 prop:countermeasure kg:id_63 >>
    prop:text-txt_contents "コロナ病床をこれまでの237床から42床増加し、279床を確保した"@ja.
<< kg:id_52 prop:countermeasure kg:id_64 >>
    prop:text-txt_contents "地区医師会に所属している医師が電話診療などを実施するなどの体制も構築されております"@ja.
<< kg:id_52 prop:countermeasure kg:id_65 >>
    prop:text-txt_contents "地区薬剤師会に所属している薬剤師が患者の御自宅まで薬を届けているところです"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "デジタルを特にそこで注目させるのではなくて、市民一人一人の行動を促していくということに進めていきたい"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "新型コロナウイルス感染症の影響等により、中食・外食事業者向けの販売数量が減少し"@ja.
<< kg:id_68 prop:cause kg:id_70 >>
    prop:text-txt_contents "過剰な民間在庫になったことによるものと認識してございます"@ja.
<< kg:id_68 prop:effect kg:id_71 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "米農家は大変厳しい状況に直面しているものと認識しております"@ja.
<< kg:id_68 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "次期作支援の取組として、令和３年産米の生産の経費である種子購入代金の一部を支援する事業"@ja.
<< kg:id_68 prop:countermeasure kg:id_73 >>
    prop:text-txt_contents "10アール当たり1,000円を補助するものでございます"@ja.
<< kg:id_74 prop:cause kg:id_75 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "接種後の痛みや運動障害の報告が相次いだことにより、これまで接種の勧奨が中止となっており"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "子宮頸がんの発症を予防するとされているのが、このヒトパピローマウイルスワクチン"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:text-txt_contents "ＨＰＶワクチン接種により、ヒトパピローマウイルス感染や子宮頸部の高度異形成、その予防効果が示され"@ja.
<< kg:id_78 prop:effect kg:id_80 >>
    prop:text-txt_contents "ＨＰＶワクチン接種により、ヒトパピローマウイルス感染や子宮頸部の高度異形成、その予防効果が示され"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "もし、具体的にキャッチアップ接種が開始された場合は、市のホームページや市広報で掲載することはもちろんですけれども、対象者の方々に個別通知を以前に行っていたのと同じように通知を差し上げて"@ja.
<< kg:id_81 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "この33名の方へのワクチン接種費用を本市独自で助成をしているところでございます"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "心身の発達、人間関係、勉強、進路にまで影響を及ぼしております"@ja.
<< kg:id_84 prop:effect kg:id_86 >>
    prop:text-txt_contents "心身の発達、人間関係、勉強、進路にまで影響を及ぼしております"@ja.
<< kg:id_84 prop:effect kg:id_87 >>
    prop:text-txt_contents "心身の発達、人間関係、勉強、進路にまで影響を及ぼしております"@ja.
<< kg:id_84 prop:effect kg:id_88 >>
    prop:text-txt_contents "心身の発達、人間関係、勉強、進路にまで影響を及ぼしております"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "家庭内のことで問題が表に出てきづらいこと"@ja.
<< kg:id_89 prop:cause kg:id_91 >>
    prop:text-txt_contents "本人や家族にヤングケアラーであるという自覚がない"@ja.
<< kg:id_89 prop:cause kg:id_92 >>
    prop:text-txt_contents "ヤングケアラーについて知らないといったことも考えられます"@ja.
<< kg:id_84 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "学校は、比較的早期発見しやすい環境にあります"@ja.
<< kg:id_84 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "本市では来年度以降も引き続き実態調査を実施していきたいと考えているところでございます"@ja.
<< kg:id_84 prop:countermeasure kg:id_95 >>
    prop:text-txt_contents "ポスター、リーフレットが令和４年１月に、もうすぐですけれども、送付される予定"@ja.
<< kg:id_84 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "子ども・家庭総合支援室が設置されていますが、こちらのほうの役割の１つが連絡調整"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "登録も済んでおられない高齢者の方々にとっては、不利益が生じてまいります"@ja.
<< kg:id_99 prop:effect kg:id_100 >>
    prop:text-txt_contents "住民票や印鑑登録証明書など、土日・祭日などでもコンビニで取得できる"@ja.
<< kg:id_99 prop:effect kg:id_101 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "高齢者にとっては介護保険の申請"@ja.
<< kg:id_99 prop:effect kg:id_102 >>
    prop:text-txt_contents "年金の相談・照会、各種届出・申請などが簡単にできるようになっている"@ja.
<< kg:id_99 prop:effect kg:id_103 >>
    prop:text-txt_contents "健康保険証としてマイナンバーカードを利用すれば"@ja.
<< kg:id_99 prop:effect kg:id_104 >>
    prop:text-txt_contents "窓口での限度額以上の医療費の一定支払いが不要になる"@ja.
<< kg:id_105 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "本市ではマイナンバーカードの出張窓口サービスを実施しております"@ja.
<< kg:id_105 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "老人福祉施設等への出張申請手続については、やはり新型コロナウイルス感染症対策もしっかり講じながら、実施に向けて関係機関と調整をしながら進めてまいりたい"@ja.
<< kg:id_108 prop:effect kg:id_109 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "長引くコロナ禍は本市観光産業にも大きな影響を与えているものと考えられます"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:text-txt_contents "生活様式の変化に対応して、３密を回避しやすい屋外、個人や家族など少人数でマイカーを利用した旅行が好まれるなど、観光スタイルにも変化が見られます"@ja.
<< kg:id_112 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "体験型ツアーのニーズの高まりに応える、いわゆるアドベンチャーツーリズムといった新しいスタイルもぜひ提供していきたい"@ja.
<< kg:id_112 prop:countermeasure kg:id_114 >>
    prop:text-txt_contents "デジタル変革を活用した旅を丸ごと購入できる予約決済システムの地域内での活用"@ja.
<< kg:id_115 prop:cause kg:id_116 >>
    prop:text-txt_contents "インバウンドの受入れに関しては、コロナ禍で全く止まっている状況"@ja.
<< kg:id_117 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "コロナ禍でも実施可能なウェブによる情報発信"@ja.
<< kg:id_117 prop:countermeasure kg:id_119 >>
    prop:text-txt_contents "地域通訳案内士や英語ガイドの研修会の実施などには取り組んでいけます"@ja.
<< kg:id_117 prop:countermeasure kg:id_120 >>
    prop:text-txt_contents "台湾に対しては、年明け１月に県が実施するオンライン商談会に参加をして誘客を図る"@ja.
<< kg:id_121 prop:cause kg:id_122 >>
    prop:text-txt_contents "埠頭内への高校生を含めた市民の立入りを禁止してほしいとの意向があったために、従来実施していた市民と触れ合うようなおもてなしを大幅に縮小した"@ja.
<< kg:id_123 prop:countermeasure kg:id_124 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "船会社ごとに策定する独自のガイドラインに沿った準備が必要"@ja.
<< kg:id_123 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "フェースシールドやマスクの着用、消毒の徹底など、感染症予防対策を講じながら可能な範囲で参加できる機会を設けていきたい"@ja.
<< kg:id_126 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "従来同様二十歳の方を対象として実施する予定でございます"@ja.
<< kg:id_126 prop:effect kg:id_128 >>
    prop:text-txt_contents "18歳以上であれば成年者となり、親の同意がなくても契約することができる"@ja.
<< kg:id_126 prop:effect kg:id_129 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "成年になると未成年者取消権は行使できなくなるため、様々な契約トラブルに巻き込まれる可能性があります"@ja.
<< kg:id_130 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "学校や各団体等からの要請があれば、積極的に出前講座を開催し、若年層が消費者被害に遭わないようにしっかりと注意喚起に努めてまいりたい"@ja.
<< kg:id_130 prop:countermeasure kg:id_132 >>
    prop:text-txt_contents "消費者ホットライン188（いやや）の周知"@ja.
<< kg:id_133 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "議員お尋ねのケースにつきましても利用は可能となっております"@ja.
<< kg:id_135 prop:countermeasure kg:id_136 >>
    prop:text-txt_contents "現在、無印良品の移動販売車が月に１度、駐車場で販売を行っている現状もございます"@ja.
<< kg:id_135 prop:effect kg:id_137 >>
    prop:text-txt_contents "近隣住民の皆様からは、生鮮食品や食料の販売や食堂を求める声もあると伺っております"@ja.
<< kg:id_138 prop:effect kg:id_139 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "もう危なくて運転できないと、そういう声が数多く寄せられました"@ja.
<< kg:id_138 prop:cause kg:id_140 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "厳しい財政状況にある中、多様化する市民ニーズに対し、質の高い行政サービスを実現するためには、各事業の必要性や緊急性、効果を十分に勘案し"@ja.
<< kg:id_141 prop:cause kg:id_142 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "その給水能力は１時間当たり10立方メートルであり、１時間当たり60立方メートル以上が必要とされる消火栓の基準を満たしていない状況です"@ja.
<< kg:id_141 prop:countermeasure kg:id_143 >>
    prop:text-txt_contents "市では、ほかの地区よりも平田小林地区に多くの防火貯水槽を設置し、有事の際に備えております"@ja.
<< kg:id_141 prop:countermeasure kg:id_144 >>
    prop:text-txt_contents "軽便ポンプを地元集会所に配備することにいたしました"@ja.
<< kg:id_145 prop:cause kg:id_146 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "ここ数年、除雪協力者となる担い手が不足している状況にあり"@ja.
<< kg:id_145 prop:countermeasure kg:id_147 >>
    prop:text-txt_contents "今後は現役世代の多くの方からも関わっていただく必要がある"@ja.
<< kg:id_145 prop:countermeasure kg:id_148 >>
    prop:text-txt_contents "そういった民間事業者に活動していただけるような何か仕組みづくりができないか、これも検討していきたい"@ja.
<< kg:id_149 prop:countermeasure kg:id_150 >>
    prop:text-txt_contents "今年の10月26日に立ち上げたものでございます"@ja.
<< kg:id_149 prop:countermeasure kg:id_151 >>
    prop:text-txt_contents "令和５年１月に文化庁へ提出し、その後、山居倉庫保存活用計画書として認定していただくスケジュール"@ja.
<< kg:id_149 prop:countermeasure kg:id_152 >>
    prop:text-txt_contents "令和５年度に、あくまで現段階のスケジュールでございますが、山居倉庫の公有化と保存活用に係る具体的な整備計画の策定を進めまして"@ja.
<< kg:id_153 prop:countermeasure kg:id_154 >>
    prop:text-txt_contents "現状変更または保存に影響を及ぼす行為を行う場合には、文化財保護法の規定に従って文化庁長官の許可を受ける必要がございます"@ja.
<< kg:id_155 prop:cause kg:id_156 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "世代交代によって指定文化財の所有者変更漏れや地域外への売却などの事例が散見されます"@ja.
<< kg:id_157 prop:countermeasure kg:id_158 >>
    prop:text-txt_contents "今年度から令和４年度までの２か年で、本市の国・県・市指定文化財の現況調査を行いまして"@ja.
<< kg:id_157 prop:countermeasure kg:id_159 >>
    prop:text-txt_contents "その後、未指定文化財、まだ指定されていない文化財の調査等を行いまして"@ja.
<< kg:id_160 prop:countermeasure kg:id_161 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "歴史的建造物の保存活用に係る専門家として、地域に眠る歴史的文化遺産を発見、保存して、まちづくりに生かす活動"@ja.
<< kg:id_162 prop:countermeasure kg:id_163 >>
    prop:text-txt_contents "仮称でございますが、文化資料館の整備を現在検討しているところでございます"@ja.
<< kg:id_162 prop:countermeasure kg:id_164 >>
    prop:text-txt_contents "特定歴史公文書を公開する公文書館としての機能"@ja.
<< kg:id_162 prop:countermeasure kg:id_165 >>
    prop:text-txt_contents "令和６年度に開館をしたいと予定を組んでおります"@ja.
<< kg:id_162 prop:countermeasure kg:id_166 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "常設展示では、酒田の歴史が時系列で分かるようなものにしていきたい"@ja.
<< kg:id_167 prop:cause kg:id_168 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "当該発電所が稼働している現状においては、ゼロカーボンシティ宣言は考えていないところでございます"@ja.
<< kg:id_169 prop:countermeasure kg:id_170 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "再生可能エネルギーを地産地消する本市独自の宣言であります再エネ循環都市宣言"@ja.
<< kg:id_171 prop:effect kg:id_172 >>
    prop:text-txt_contents "市民や事業者の意識としては、残念ながら省エネや節電への取組については減少傾向、悪化傾向にあった"@ja.
<< kg:id_171 prop:countermeasure kg:id_173 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "市民や事業者向けにさらに周知を進めることで、クールチョイスの浸透を図っていきたい"@ja.
<< kg:id_171 prop:countermeasure kg:id_174 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "来年以降、この区域施策編の策定を市として検討してまいりたい"@ja.
<< kg:id_175 prop:countermeasure kg:id_176 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "まずはＪ－クレジット制度について広報やホームページなど各種媒体により市民や市内企業への周知を進めたい"@ja.
<< kg:id_175 prop:countermeasure kg:id_177 >>
    prop:text-txt_contents "市が所有する施設の設備更新のとき、あるいは森林についてクレジット化が可能かどうかを検討してみたい"@ja.
<< kg:id_178 prop:cause kg:id_179 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "令和２年度の利用状況が１日当たり163人となっております。ＪＲ東日本が発足した昭和62年度の2,185人に比較しますと、93％も減少している"@ja.
<< kg:id_178 prop:effect kg:id_180 >>
    prop:text-txt_contents "来年３月のダイヤ改正では、利用状況に合わせて一部の列車で酒田新庄間の直通運転を取りやめる"@ja.
<< kg:id_181 prop:cause kg:id_182 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "山形県はオール山形で、フル規格の奥羽・羽越新幹線の早期整備を進めている"@ja.
<< kg:id_181 prop:cause kg:id_183 >>
    prop:text-txt_contents "山形新幹線庄内延伸に向けたその活動はなかなか広がらずに限定的なものになっていた"@ja.
<< kg:id_181 prop:countermeasure kg:id_184 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "山形県も会員になっている、そしてより大きくかつ広範な組織であります山形県鉄道利用・整備強化促進期成同盟会"@ja.
<< kg:id_181 prop:countermeasure kg:id_185 >>
    prop:text-txt_contents "陸羽東西線利用推進協議会、この中でＪＲ陸羽西線の利便性向上や利用促進について積極的に活動すべきと判断"@ja.
<< kg:id_186 prop:cause kg:id_187 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "この山形新幹線庄内延伸の実現には、まずは県の事業としての位置づけがなされなければ全く前に進まない"@ja.
<< kg:id_188 prop:effect kg:id_189 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "庄内、最上、村山、置賜を貫く県土の一体的な発展につなげて"@ja.
<< kg:id_188 prop:effect kg:id_190 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "さらに陸羽西線の廃線を防ぐ唯一の手だてである"@ja.
<< kg:id_188 prop:countermeasure kg:id_191 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "庄内開発協議会の重要事業要望の中にもちゃんと盛り込んであります"@ja.
}
