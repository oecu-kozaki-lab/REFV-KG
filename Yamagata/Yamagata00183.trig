kg:id_184 rdfs:label "山形県鉄道利用・整備強化促進期成同盟会での活動"@ja.
kg:id_184 rdf:type cls:c_10352.
cls:c_10352 rdfs:label "同盟会活動"@ja.
kg:id_181 prop:countermeasure kg:id_184.
