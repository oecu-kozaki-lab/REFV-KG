kg:st_1 rdfs:label "佐藤弘議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "学校現場はマンパワー不足が深刻で増員が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "支援を待っている子供たちのため教育支援員を増やすべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "要望数に対して配置が足りず子供への支援が不足している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "教員の研修だけでなくICT支援員の専門支援が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "拠点研修だけでは学校現場の支援ニーズに合っていない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "文部科学省"@ja.
kg:st_2 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_6 prop:content "学校と地域が協働・融合した部活動へ移行すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "部活動指導員をもっと増やし改革につなげるべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "令和５年度以降は休日の部活動を段階的に地域移行すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:st_3 rdfs:label "齋藤一志教育次長"@ja.
kg:st_3 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_9 prop:content "受皿整備が進まないと地域移行は進められない"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "全体移行は難しいができるところから進める必要がある"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:st_4 rdfs:label "齋藤直議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_11 prop:content "雇用確保のため中小企業への継続支援が必要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "雇用の安定を守るため支援が必要"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:st_5 rdfs:label "酒田市内企業521社回答のアンケート結果"@ja.
kg:st_5 rdf:type cls:st_115.
cls:st_115 rdfs:label "調査結果"@ja.
kg:op_13 prop:content "コロナ禍の長期化で売上げ減少の影響が広がっている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:op_14 prop:content "飲食店と旅行業はコロナの直撃を受けている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:st_6 rdfs:label "丸山市長"@ja.
kg:st_6 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_15 prop:content "まずは国県制度を周知し活用を図るべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:op_16 prop:content "アンケートや雇用情勢を踏まえ独自対策も考える"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_6.
kg:op_17 prop:content "地域経済の起爆剤として効果が大きい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "現時点では再度の実施は考えていない"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_6.
kg:op_19 prop:content "残り約4％は所得制限により対象外"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:op_20 prop:content "申請を受けて審査後に支給する必要がある"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_6.
kg:op_21 prop:content "申請機会を失わないよう広報やホームページでも周知する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:op_22 prop:content "新工業団地造成を今から考えるべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:st_7 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_7 rdf:type cls:st_32.
kg:op_23 prop:content "立地環境の魅力向上が分譲進展につながった"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_7.
kg:op_24 prop:content "前向きに考えたいが総合的判断が必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_7.
kg:st_8 rdfs:label "江口暢子議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_25 prop:content "観光だけでなく市民も来やすい工夫が必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_8.
kg:op_26 prop:content "市民が利用しやすい視点も持つべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_8.
kg:op_27 prop:content "山居倉庫と連携したにぎわい拠点と日常生活拠点を目指す"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_7.
kg:st_9 rdfs:label "宮崎和幸企画部長"@ja.
kg:st_9 rdf:type cls:st_32.
kg:op_28 prop:content "県道や新井田川を越える体験を魅力として高めたい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_9.
kg:st_10 rdfs:label "那須欣男総務部危機管理監"@ja.
kg:st_10 rdf:type cls:st_32.
kg:op_29 prop:content "観光客にも分かりやすく安全に避難できる対策が必要"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_10.
kg:st_11 rdfs:label "池田里枝教育次長"@ja.
kg:st_11 rdf:type cls:st_32.
kg:op_30 prop:content "保存活用計画の中で樹勢回復方策を協議する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_11.
kg:op_31 prop:content "現状では回復しておらず回復策の検討が必要"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_11.
kg:op_32 prop:content "ヘルメット着用の徹底が必要"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_8.
kg:st_12 rdfs:label "鈴木和仁教育長"@ja.
kg:st_12 rdf:type cls:st_72.
cls:st_72 rdfs:label "教育機関"@ja.
kg:op_33 prop:content "教育活動で使う中学生は100％加入確認している"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_12.
kg:op_34 prop:content "中学校で保護者判断としている学校も着用方向に持っていく必要がある"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "全学校に電子錠整備を進めるべき"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_8.
kg:op_36 prop:content "防犯対策充実のためまず職員玄関への電子錠整備を進めたい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_12.
kg:op_37 prop:content "既存Wi-Fi環境への影響を踏まえ別方式でのカメラ活用を勉強したい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_12.
kg:op_38 prop:content "引き続き中心市街地活性化に取り組む必要がある"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_6.
kg:op_39 prop:content "国の補助活用を含め市の支援の在り方を検討する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_6.
kg:op_40 prop:content "長期戦略として誘導策を考える必要がある"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "防火準防火地域の割増しも含め好評に利用されている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:op_42 prop:content "中心市街地へのアクセス確保と公共交通の利便性向上を図る"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_6.
kg:op_43 prop:content "酒田の強みを生かした誘客の中心的役割を担う組織を目指す"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_7.
kg:op_44 prop:content "来年度上半期に法人立ち上げ令和5年度認定を目指す"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_7.
kg:op_45 prop:content "円滑に移転が行われるよう市が調整していく"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_7.
kg:op_46 prop:content "生産者や団体と意見交換しブランド化や販路拡大を進めたい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_7.
kg:st_13 rdfs:label "市村浩一議員"@ja.
kg:st_13 rdf:type cls:st_16.
kg:op_47 prop:content "酒田の歴史資料を常時調査研究し公開する施設にすべき"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_13.
kg:op_48 prop:content "子供たちが酒田を深く知り誇りを感じられるようにしている"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_12.
kg:op_49 prop:content "市内企業の出前や出張販売利用で地元飲食店を応援する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:st_14 rdfs:label "大壁洋平議員"@ja.
kg:st_14 rdf:type cls:st_16.
kg:op_50 prop:content "人口減少を見据えた新しい社会づくりが必要"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_14.
kg:st_15 rdfs:label "本間義紀企画部デジタル変革調整監"@ja.
kg:st_15 rdf:type cls:st_32.
kg:op_51 prop:content "3年間を重点期間として各種事業を推進する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_15.
kg:op_52 prop:content "105様式や定期船手続などをオンライン化した"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_15.
kg:op_53 prop:content "事務作業削減と会議録作成の省力化を進めている"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_15.
kg:op_54 prop:content "来年度以降は地域のデジタル変革を強化したい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_15.
kg:op_55 prop:content "オンライン授業や講座のためITインフラ整備は急務"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_14.
kg:op_56 prop:content "酒田市内と飛島で5G整備が進むことを期待する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_15.
kg:op_57 prop:content "持続可能な自治体経営のため民間事業者との連携が必要"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_6.
kg:op_58 prop:content "民間の知恵や資金やノウハウを生かし市民サービス向上を図る"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_6.
kg:op_59 prop:content "窓口一本化と事務手続の見える化でスピード感を持って進めるべき"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_6.
kg:op_60 prop:content "民間事業者との連携についてスピード感を持って推進する体制を整えた"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_6.
kg:st_16 rdfs:label "冨樫覚議員"@ja.
kg:st_16 rdf:type cls:st_16.
kg:op_61 prop:content "重視度が高く満足度が低い項目を優先的に改善すべき"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_16.
kg:st_17 rdfs:label "矢口明子副市長"@ja.
kg:st_17 rdf:type cls:st_94.
cls:st_94 rdfs:label "副首長"@ja.
kg:op_62 prop:content "市民と対話し協働できる職員の育成に力を入れている"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_17.
kg:op_63 prop:content "やりがいを持って働ける制度構築を進めている"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_17.
kg:op_64 prop:content "働きやすい職場をつくることが市民満足度向上に向かう"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_17.
kg:op_65 prop:content "究極のワンストップは難しいがまず相談窓口一本化を進めたい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_17.
kg:op_66 prop:content "まず受け止める窓口を用意し必要に応じ専門部署へつなぐ"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_17.
kg:op_67 prop:content "ウェブ回答導入で回答率が上昇したと考える"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_17.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今年度、教育支援員をはじめ、いろいろな人員が減員されたしわ寄せは、確実に学校教育に影を落としています。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今年度、本市の教育支援員は10名減員され、50名配置されています。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "配置の要望につきましては、学校から92名の要望がございました。令和４年度は、今年度同様に教育支援員は教育支援コーディネーター１名を含めて50名の配置を考えておるところでございます。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "令和４年度についてもＩＣＴ支援員は配置せず、情報教育推進室を中心したＩＣＴ教育の推進を続けてまいりたいと考えているところでございます。"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "教育委員会では、学校に個別に入るより、きちんと拠点を一つ設けて、そちらのほうで研修していく方針のようですが、現場の要望と乖離しているように思います。"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "部活動を学校単位から地域単位の取組とすることが指摘されています。"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "部活動における教師の負担軽減に加え、部活動の指導等に意欲を有する地域人材の協力を得て、生徒にとって望ましい部活動の実現を図るものである。"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "令和５年度以降、休日の部活動の段階的な地域移行、合理的で効率的な部活動の推進が掲げられています。"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "地域移行に向けては受皿の整備、こちらのほうができていないと進みません。"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "全体でという形になると、なかなか厳しいかと思いますが、そういったできるところから進めていくというようなことは必要なのかなと考えているところでございます。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "この２年間、新型コロナウイルスの影響で、事業者にとりましては、売上げの低迷などで非常に影響があったところ"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "企業においては、今年の春の採用予定者の取消しなど、検討・実施した企業もあり、雇用の安定には大きく影響を与える状況と思います。"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "コロナ禍が長期化していることにより、ほぼ全ての業種で売上げ減少の影響が大きくなっていると報告があります。"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "特に飲食店や旅行業に関しては、100％影響があるとのことで、コロナの影響が直撃をされている"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "このように、国・県の制度、これも必要に応じた措置が講じられておりますので、その周知を徹底した上で、まずは、国・県制度の活用をしっかりと図っていくことが最優先かなと思っております。"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "本市の経済状況などを踏まえて、新たに、そのための財源が国から示されるということが前提になりますけれども、その上で、独自の経済対策なども考えていきたいと考えているところでございます。"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地元経済の復活を目指し、キャンペーンを取り組み、市民または店舗からも大変好評でした。経済効果は26億円を超える事業となりました"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "還元されたポイントが逆に他地域で消費される可能性があるということ、それから２番目として、これまで２回実施したことで市民にキャッシュレス決済の利便性というものが浸透して、今後さらに実施する際には、これまで以上の多額の決済が見込まれるために、相当額の予算を計上する必要があるということ、この２点から、現時点では再度のキャンペーン実施については考えていないところでございます。"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "残り約４％の世帯については、児童手当受給者の所得が基準となる金額、所得制限限度額という金額の制限がございまして、４％の世帯の皆さんは、その限度額以上であるために、支給の対象とならないものでございます。"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "高校生等は児童手当の対象ではないために、所得判定資料や口座情報、振り込む口座の情報を持ち合わせておりません。"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "高校生等を養育する世帯や公務員の世帯の方への申請に関する案内は、準備が整い次第、年明けの１月以降、できるだけ早く個別に発送したいと考えております。また、給付の対象となる方が申請する機会を失うことがないよう、市の広報、ホームページなど、様々な方法での周知に努めたいと思います。"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "酒田京田西工業団地につきましては、分譲率98.4％、未分譲区画は１区画約0.3ヘクタールということになってございます。...酒田臨海工業団地につきましては、分譲率は94.9％となってございまして、未分譲区画は１区画約13.4ヘクタール"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "県外からの立地企業が順調に業績を拡大し、拡張が相次いでいるということ、高速交通網の整備に伴いまして、物流の拠点化に伴う立地が進んだこと、そして工業団地内で操業開始が続きまして、いわゆる団地内でサプライチェーンが形成されるなど、工業団地そのものの魅力が向上した"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "都市計画法、あるいは農地法などの土地利用規制や開発手法など、市の考えだけでは前に進まない状況にあるということと同時に、行政で造成した場合の多額の費用、売却の確実性、いわゆる売れ残りが生じないようなことという趣旨になります、総合的に判断しなければならない"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "酒田夢の倶楽の入館者数、令和元年度81万2,103人、令和２年度44万8,494人、令和元年度と比較いたしますと、45％の減少になってございます。"@ja.
<< kg:id_46 prop:cause kg:id_45 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "令和元年度は３億2,400万円の売上げでございます。令和２年度につきましては、１億6,800万円、令和元年度と比較いたしますと、48％の減少"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "商業跡地につきましては、民間事業者提案により商業、物産、産直施設及び駐車場を整備しまして、来街者にとりまして山居倉庫と連携したにぎわいの拠点、市民にとりましては生活利便性が向上する日常生活の拠点となりまして、山居倉庫周辺エリアに交流と日常的なにぎわいが生まれる環境を目指す"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "新井田川あるいは新内橋を挟んで川を渡る、要するに、その瞬間、対岸が現代、それから山居倉庫側が明治、そういったのが、タイムスリップしたような魅力を感じ取ってもらう"@ja.
<< kg:id_51 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "山居倉庫周辺では津波避難ビル、また、酒田商業高校跡地では津波や洪水の浸水想定区域外となる市役所、また希望ホール等への避難を促す看板を設置する等、観光客がより分かりやすく、より安全に避難できるよう対策を講じていく所存でございます。"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "この衰退の原因につきましては、過去に調査をしたところによりますと、まずは石畳の影響、それから、多数の歩行者によります土壌の表層部、表面の部分ですけれども、こちらが固く締まってしまっていると。それから、土地に高低差がございまして、この高低差による粘りの偏り、このあたりが原因ではないか"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "ケヤキ並木の傷みについては、現状では回復はしておりません。なお、樹勢、樹木の勢いですけれども、こちらの衰えというのは続いているものと見ております。"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "ヘルメットを着用していないと、自転車事故での死亡・重症化率は、着用している場合の約６倍も高くなる"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "中学校では、自転車通学をする子供たち、それから部活動等で自転車を使う生徒につきましては、自転車使用許可申請書、これを提出いただいております。その際に保険加入の有無、これをチェックする項目を設けまして確認をしている"@ja.
<< kg:id_58 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "中学校についてと、こちらのほうについては、先ほど答弁でもあったように、実は保護者の判断にお任せしている学校があるのです。まず、そちらのほうについて、今、要請しておりますけれども、きちんと着用という方向にまず持っていくということが１つ必要かなと。"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "学校によって現状がばらばらでございます。オートロックがきちんとついているところもあれば、インターホンもないところもあれば、ちょっと現状ではばらばらになっております。"@ja.
<< kg:id_63 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "今後は、地域の実情や学校の実情を踏まえながら、各学校の職員玄関、まずはここにオートロック式といいますか、電子錠といいますか、等をするなど計画的に整備を進めていきたいと考えているところです。"@ja.
<< kg:id_63 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "今後は、警備保障会社等による防犯カメラの活用などということができないか、ちょっと勉強していきたいと考えているところです。"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "中心市街地の人口減少率、本市全体の平均値よりも進んでおりまして、さらに、昨今のコロナ禍による外食の自粛に加えて、先ほどもございましたが、清水屋の閉店なども相まって、にぎわいの創出が大変難しい状況になっている"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "市としても、地元経済界と一緒にこのエリアの再生に向けて取り組むものであり、その中で、国の補助事業の活用をはじめ、市としての支援の在り方を検討してまいりたい"@ja.
<< kg:id_70 prop:cause kg:id_71 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "酒田の場合の中心市街地への居住誘導を考えたときに、コストの高さというか、コストが安いということ、それから利便性があるというこの２つの要素をつくり出す必要がある"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "防火・準防火地域内に建築する場合は、工事費が割高になることから、20万円の割増しをします。...利用状況としては、22件の申請がありまして、受付開始日で予算額にもう達してしまったという好評な事業でございます。"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "来年、令和４年８月１日実施予定の地域公共交通の改編に当たっては、全ての路線バス・デマンドタクシーが中町周辺と酒田駅前の拠点を経由する路線に設定をして、利用者の利便性向上と利用者の増加に取り組んでいく"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "本市が考えておりますＤＭＯは、酒田の強みを生かした誘客のための企画、ターゲットの設定、マーケティング等、観光誘客の方向性を地域の観光事業者、宿泊事業者、交通事業者、ＮＰＯ、観光ガイド、学生など観光に携わる方々と共有し、共に観光誘客に取り組むための中心的な役割を担う組織"@ja.
<< kg:id_76 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "来年度上半期に法人を立ち上げまして、候補ＤＭＯの申請を行う予定でございます。...翌令和５年度に認定ＤＭＯとなることを目指していくところでございます。"@ja.
<< kg:id_79 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "物産機能につきましては、酒田観光戦略推進協議会が物産スペースを借り上げ、夢の倶楽協力会の皆さんから商品を取り扱っていただくという予定で...円滑に移転が行われるよう、市がしっかりと調整をしていきたい"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "現在、酒田観光戦略推進協議会が担う機能の一つとして、地域商社機能がございます。株式会社ひらた悠々の杜にその機能を委託して取り組んでおります"@ja.
<< kg:id_83 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "将来的には市史編さん事業も担う文化資料館（仮称）を開館するための準備を進めているところでございます。"@ja.
<< kg:id_85 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "小学校では、３年生と４年生の社会科の授業で、本市の教育委員会が編さんしました副読本「わたしたちのまち　さかた」を使用して学習をしております。"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "市内企業が比較的多い数量の出前ですとか出張販売の申込みを市内飲食店に行い、新型コロナウイルス感染症の影響で利用が落ち込んだ地元飲食店の応援を行う"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "人口減少と少子高齢化、労働者不足、地方経済の活性化など課題に対応できる新しい社会づくりが求められております。その新しい社会と言われているのがＳｏｃｉｅｔｙ5.0です。"@ja.
<< kg:id_91 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "本年の３月には、本市のデジタル変革の指針となります、デジタル変革戦略を策定しております。この戦略では、令和３年度から３年間を重点期間と位置づけまして"@ja.
<< kg:id_93 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "行政手続のオンライン化の取組ということで、105の様式をはじめ、定期船に関する手続や各種アンケートなどをオンライン化したところでございます。"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "ＲＰＡとＡＩ－ＯＣＲというものを組み合わせた実証事業を今年度５つの業務で取り組んでございます。加えまして、議事録の自動生成システムというものも12月から本格導入をさせていただいて、会議録作成業務の省力化にも取り組んでいる"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "来年度以降は、地域のデジタル変革の比重を高めてまいりたい"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "Ｗｉ－Ｆｉが使える場所が限定されており、研修室や会議室ではＷｉ－Ｆｉが届かなかったり、回線が遅かったり、時間制限があって不便だという声をお聞きしております。"@ja.
<< kg:id_99 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "５Ｇ基地局の設置を加速化していただいて、酒田市内の５Ｇカバー率をより一層高めていただきたい"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "多様化・複雑化する市民ニーズへの対応を図って、持続可能なまちづくりを進めていくためには、もう、ちょっと行政のみによる取組では限界があるのかな"@ja.
<< kg:id_102 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "行政課題の解決や、行政が担ってきた、行政が行ってきた分野に民間事業者の知恵ですとか、アイデア、それから資金、さらにはノウハウを投入していただいて、持続可能な自治体経営と地域活力を維持したい"@ja.
<< kg:id_105 prop:cause kg:id_106 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "これまで公民連携に対する市の職員の意識の温度差というものがありました。...行政側のほうで提案を受ける受付窓口が統一をされていないという現状があった...実施に至るまでの事務手続、その実施までのプロセスがなかなか不明確であった"@ja.
<< kg:id_105 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "民間事業者との連携窓口を市長公室にまずは一本化するということ、そして、事務手続を整理した、事務手続を見える化した"@ja.
<< kg:id_108 prop:cause kg:id_109 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "満足度と重要度につきまして、同じ項目で聞いたわけではないので、議員おっしゃったような分析はできなかった"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "従来から接遇研修は行っておりますけれども、最近では、ファシリテーションの研修あるいは公益文科大の地域共創コーディネーター養成プログラムへの派遣などを行っております。"@ja.
<< kg:id_112 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "今年度から人事課に人材育成主幹という職を置きまして、狭い意味での研修だけではなくて、研修も含め、先ほどの採用も含め、やりがいを持って働いていけるような制度構築に今、努めているところでございます。"@ja.
<< kg:id_114 prop:effect kg:id_115 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "職員満足度が市民満足度につながるものと私も考えております。"@ja.
<< kg:id_116 prop:cause kg:id_117 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "究極のワンストップはなかなか難しいと思います。これだけ専門性が必要とされる仕事、相談ありますので"@ja.
<< kg:id_116 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "最初の相談窓口をまず一本化して、そこから専門部署につなぐというようなイメージで考えていきたい"@ja.
<< kg:id_119 prop:cause kg:id_120 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "前回の平成28年度は、2,500人中1,027人の回答、回答率は41.1％でしたので、今回は2.7ポイント上昇いたしました。上昇した原因としては、やはりウェブで回答できるようにしたためではないかと考えております。"@ja.
}
