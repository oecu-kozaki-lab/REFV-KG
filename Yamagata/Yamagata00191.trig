kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_1 prop:content "新年度は対応に大きな変化が予測される"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域産業や市民生活は大きな影響を受けている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地域産業や市民生活は大きな影響を受けている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "市民要望への対応と財政健全化の調和が重要課題になっている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "市民要望への対応と財政健全化の調和が重要課題になっている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "影響が継続している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "これまでにない重要課題となっている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "新年度に大きな変化が予測される"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "市民が市役所に行かなくても行政手続や市政参加ができるようにする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "市民参加の機会を確保する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "市内企業との接続で人材不足解消に貢献する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "地域と協議しながら新しい学校づくりを進める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "相談支援の連携を強化する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "児童生徒が自ら支援につながれる仕組みを整える"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "市民の経済的負担を軽減する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "多様な相談を受け止めて支援につなげる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "安心して酒田で子育てができるようにする"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "給食費値上げによる負担を軽減する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "多様なニーズに即した支援につなぐ伴走型相談支援を充実する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "関係機関と今後の在り方について協議を進める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "関係機関と今後の在り方について協議を進める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "課題を踏まえて今後の在り方を検討する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "再生可能エネルギー循環都市の実現を目指す"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "エネルギー地産地消による脱炭素を推進する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "最も蓋然性が高い大規模自然災害への対応強化を主眼とする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "各組織固有の防災力及び相互の連携を強化する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "災害時の情報伝達体制を整備する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "適正管理と発生抑制に取り組む必要がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "生活環境への悪影響を防ぐ"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "空き家対策を進める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "変異ウイルスによる感染拡大も懸念されておりますが、令和５年５月の大型連休明けに、いわゆる感染症法において、季節性インフルエンザと同じ５類感染症とする方針が示されており、医療の提供体制、日常生活での感染予防や行動制限の変更など、新型コロナウイルス感染症への対応は新年度に大きな変化が予測されます。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "一方で、コロナ禍に加え、エネルギーや原材料などの価格上昇によって、地域産業や市民生活は大きな影響を受けています。"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "一方で、コロナ禍に加え、エネルギーや原材料などの価格上昇によって、地域産業や市民生活は大きな影響を受けています。"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "また、本市の財政運営においては、公債費や公共施設の維持管理経費の増加などによって厳しさが増しており、市民要望への対応と財政健全化をいかに調和させるかが、これまでにない重要課題となっています。"@ja.
<< kg:id_6 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、本市の財政運営においては、公債費や公共施設の維持管理経費の増加などによって厳しさが増しており、市民要望への対応と財政健全化をいかに調和させるかが、これまでにない重要課題となっています。"@ja.
<< kg:id_3 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "一方で、コロナ禍に加え、エネルギーや原材料などの価格上昇によって、地域産業や市民生活は大きな影響を受けています。"@ja.
<< kg:id_6 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "また、本市の財政運営においては、公債費や公共施設の維持管理経費の増加などによって厳しさが増しており、市民要望への対応と財政健全化をいかに調和させるかが、これまでにない重要課題となっています。"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "医療の提供体制、日常生活での感染予防や行動制限の変更など、新型コロナウイルス感染症への対応は新年度に大きな変化が予測されます。"@ja.
<< kg:id_12 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "市民が市役所に行かなくても行政手続や情報のやり取り、市政参加ができるオンライン市役所の実現に向け、市民と市役所が１対１の関係性でつながるコミュニケーションポータルサイト、さかたコンポのサービスを開始します。"@ja.
<< kg:id_12 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "また、市民参加の機会を確保するため、条例や計画等の策定時に市民意見を適切に聴取する手法が確保されているかなどを審査する条例・計画等の策定時における対話による市民参加の場づくり推進委員会を設置します。"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "東北公益文科大学と市内ＩＴ関連企業などと協働して、デジタル人材を育成します。また、情報技術を課題解決に役立てる能力を身につけた学生と市内企業をつなぐことで、デジタル人材不足の解消に貢献します。"@ja.
<< kg:id_17 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "また、児童生徒数の減少が進む中、酒田市立第四中学校区内の義務教育環境の在り方について協議を進めるなど、新しい学校づくりに取り組みます。"@ja.
<< kg:id_19 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "いじめや不登校などへの対応として、教育相談室・適応指導教室の教育相談専門員、小中学校のスクールカウンセラー、教育相談員、スクールソーシャルワーカーの連携を強化するとともに"@ja.
<< kg:id_19 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "ＧＩＧＡスクール端末を通じて児童生徒自らが容易にＳＯＳのサインを出せる仕組みを構築します。"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "コロナ禍において物価高騰に直面する市民の経済的負担を軽減するため、国民健康保険財政調整基金を活用し、４年連続で国民健康保険税の税率を引き下げます。"@ja.
<< kg:id_24 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "複雑化・複合化した生活課題を抱える市民の多様な相談を受け止めて支援に繋げるため、介護、障がい、子育て、生活自立支援などの関連機関が連携し、相談支援、参加支援、地域づくりに向けた支援を一体的に実施する重層的支援体制の構築に向けた準備を行います。"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "安心して酒田で子育てができるよう、子供の医療費の無償化をこれまでの中学３年生から高校３年生まで対象者を拡大します。"@ja.
<< kg:id_26 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "また、保育所や小中学校の給食費の値上げによる子育て世帯の負担を軽減するため、食材費の一部に新型コロナウイルス感染症対応地方創生臨時交付金を活用します。"@ja.
<< kg:id_29 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "国のこども家庭庁の設置に合わせ、酒田市こども家庭センターを立ち上げ、全ての妊産婦、子育て世帯に寄り添い、妊娠期から出産・子育てまで一貫した相談体制を構築し、多様なニーズに即した必要な支援につなぐ伴走型相談支援の充実を図ります。"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "また、酒田市休日診療所は、施設の老朽化や医療従事者の高齢化などの課題があることから、日本海総合病院や酒田地区医師会十全堂など、関係機関と今後の在り方について協議を進めます。"@ja.
<< kg:id_31 prop:cause kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "また、酒田市休日診療所は、施設の老朽化や医療従事者の高齢化などの課題があることから、日本海総合病院や酒田地区医師会十全堂など、関係機関と今後の在り方について協議を進めます。"@ja.
<< kg:id_31 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "また、酒田市休日診療所は、施設の老朽化や医療従事者の高齢化などの課題があることから、日本海総合病院や酒田地区医師会十全堂など、関係機関と今後の在り方について協議を進めます。"@ja.
<< kg:id_35 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "再生可能エネルギー循環都市の実現を目指し、地球温暖化対策推進法に基づく酒田市地球温暖化対策実行計画、区域施策編の策定に取り組みます。"@ja.
<< kg:id_37 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "家庭でのエネルギー地産地消による脱炭素を推進するため、新築住宅に設置する太陽光発電及び蓄電池の設備導入につながる独自の支援策を創設します。"@ja.
<< kg:id_39 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "最も蓋然性が高い大規模自然災害への対応強化を主眼として、避難する主体となる自主防災会などの地域住民、被災者を救援する防災関係機関、全般を統制する市、これら３つの機能が組織的に連携する体制を整備します。"@ja.
<< kg:id_39 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "この目的を達成するため、全市域を対象とした一斉総合防災訓練を実施し、各組織固有の防災力及び相互の連携を強化します。"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "災害時の情報伝達体制整備については、地理的条件などにより電波受信強度の弱い地域の防災ラジオの電波環境を改善するため、コミュニティＦＭ中継局を平田地域に整備します。"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "空き家等対策計画に基づき、地域住民の生活環境に悪影響を及ぼす管理不全な空き家の適正管理と発生抑制に取り組みます。"@ja.
<< kg:id_46 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "空き家等対策計画に基づき、地域住民の生活環境に悪影響を及ぼす管理不全な空き家の適正管理と発生抑制に取り組みます。"@ja.
<< kg:id_48 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "また、空き家等ネットワーク協議会と連携し、空き家の利活用を促進するほか、相続財産管理人選任申立制度の活用により、相続人が存在しない老朽危険空き家の除却に取り組みます。"@ja.
}
