kg:st_1 rdfs:label "佐藤猛議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "危機の時代の不安要素が市民生活に大きく影響していると認識"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "不安要素により財政運営も厳しさが増していると認識"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山市長"@ja.
kg:st_2 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_3 prop:content "基地港湾指定には2つ以上の洋上風力案件形成が必要と説明"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "市村浩一議員"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_4 prop:content "港湾施設の改修や建設による地域経済活性化が期待できる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "短期的には基地港湾整備や洋上風力建設による地元企業への波及効果を期待"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "建設や現地調査で交流人口が増え宿泊施設等への効果を期待"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "地域振興策により新たな産業形成が期待される"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "次世代エネルギー普及により関連産業の雇用創出を期待"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "関連産業の進展により定住人口の増加が期待される"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "持続可能な農業振興と環境負荷軽減に取り組むべきとする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "段階的に農薬と化学肥料の使用低減を進め最終的に有機農業を目指す"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "改定案の柱として担い手育成確保を継続"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "改定案の柱として複合経営の推進を継続"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "改定案の柱として販路拡大を継続"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "新たな柱として循環型農業の促進を掲げる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "国際情勢や燃油高騰などで課題は一層厳しさを増している"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "機器や機材導入を支援し漁業継続を後押しする"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "新たに漁業を始める者への初期費用支援で就業者確保を図る"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "市民と高校生によるおもてなしを今後も継続したい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "市民と高校生によるおもてなしが最大の魅力と認識"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "物価高騰分が保護者負担に転嫁されないよう支援する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "保護者負担が増えないよう据え置き対応する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "妊産婦や子育て家庭への切れ目ない相談支援体制を構築する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "家事や育児に不安を抱える家庭を訪問支援で支える"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "高齢者の重症化予防や機能低下防止のため看護師を配置する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "医療・介護・福祉政策や計画策定に助言を得て医療政策を進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "三者の体制整備が重要と指摘"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "各組織が連携し繰り返し訓練することが重要とする"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "自助・共助の力を高めるため地区防災計画策定を進める"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "地震津波に加え土砂災害対処も主眼に訓練する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "高齢者や体の不自由な方の避難要領確立を目的に支援を進める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "防災情報伝達手段の多重化と不感エリア解消を図る"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "空き家所有者の意向を確認し相談会につなげ問題解決に努める"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "制度改正情報を収集し管理不全空き家対策を講じる"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "本土と変わらない通信環境を生かし関係人口増加を目指す"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "民間提案を受け入れ課題解決につなげたい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "運賃負担軽減や輸送コスト低廉化などのメリット獲得へ要望を続ける"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "若年単身者やUIJターン就職者も応募可能にする"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "多様性を認め合う地域社会づくりを一歩前進させたい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "特に橋梁は重大事故に直結するため改修が急がれる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "点検診断補修のマネジメントサイクルで計画的に維持する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "出張申請受付で普及に努める"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "水平統合を実現し経営基盤強化を目指す"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "最終的に垂直統合でさらなる経営基盤強化を目指す"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "新しい財政需要により歳出はコロナ禍前より増加傾向"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "少子化対策などの新しい需要が予算を押し上げている"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "歳入が増加分を見込めず基金取崩しに頼る構造と説明"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "歳入確保に積極的に取り組む"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "財源確保策として活用する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "歳出面でコスト圧縮を図る"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "県内他市より高い公債費の抑制を図る"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:st_4 rdfs:label "後藤泉議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_52 prop:content "新年度から通常交流復活を期待していたが休止は残念"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:op_53 prop:content "廃止ではなく事業見直しのための休止と理解してほしい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "対象を全市に広げるなど参加機会均等化の必要がある"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "交付金圧縮の必要から見直しを図った"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "補助金が削られる受け止めから大きな反発があった"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "地域の思いを踏まえ考え方を改めた"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "市民や事業者を含めた本市全体で削減していくため策定する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "民間の力で開催を進め、市も関わる部分は関わる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "希望する市民が安心して接種できるようオール酒田で推進する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "秋から冬の接種には個別接種と集団接種の両体制が必要"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "5類移行によりインフルエンザ同様の体制へ段階的移行する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "5類移行後はインフルエンザ同様に基本的に休園しない見込み"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "少子化対策を最重要課題の一つと位置づけている"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "市のIT人材を育成し市内企業への輩出定着を図る"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "多様な働き方や収入増加、ウェルビーイング向上を目指す"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "民間企業と連携して実践的支援を行う"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "土地価格の急激な高騰がなく基金の存在意義が薄れた"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "約8億円の基金を保有し続ける財政メリットがない"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "スピード感のある企業に未分譲地情報を提供する"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "工業地域の未利用地や居抜き物件活用を促す"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "まず四中で進捗を踏まえ他地域へ啓発していく"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "多様な主体をつなぎ連携協働を支援促進する役割を担う"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "秋口の設計着手に間に合うよう早期に建設計画の合意形成を図る"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "クルーズ船のクラスごとに異なるニーズへの対応が重要"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "初のラグジュアリークラス寄港に合わせた取組を調整中"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "米粉用米作付圃場への資材散布に10a当たり5900円を交付する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "海外依存と国際情勢の影響で価格高騰している"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "穀物需要増加が価格高騰の要因"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "国際情勢が価格高騰の要因"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "耕種農家と畜産農家の連携で地域資源循環を図る"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "牛ふん尿由来液肥の活用で化学肥料低減を図る"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "堆肥活用で化学肥料使用量低減を進める"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "圃場ごとの適正施肥で肥料使用量低減に貢献する"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:st_5 rdfs:label "須田聡上下水道事業管理者"@ja.
kg:st_5 rdfs:type cls:st_66.
cls:st_66 rdfs:label "管理者"@ja.
kg:op_85 prop:content "統合で事務効率化や運営コスト削減が見込まれる"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_5.
kg:op_86 prop:content "施設統廃合で更新費用や維持管理費の低減を見込む"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_5.
kg:op_87 prop:content "県プラン試算で大きな削減効果が見込まれる"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_5.
kg:op_88 prop:content "最も古い施設は60年経過し更新時期を迎えている"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_5.
kg:op_89 prop:content "広域化に伴い受水切替で小牧浄水場を廃止予定"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_5.
kg:op_90 prop:content "廃止までは点検整備と修繕で機能維持を図る"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_5.
kg:op_91 prop:content "塩水の影響を受けない水源による供給で補完機能を高める"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "産業革命以来、急速に進んだ地球温暖化による気候変動"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "我が国では2019年より広がった新型コロナウイルス感染症"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "大国ロシアによるウクライナ侵攻、それに伴う世界的物価高騰"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "これらの不安要素は市民生活に大きな影響を与え"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "さらに本市の財政運営もまた厳しさが増しているものと認識しております"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "酒田港の基地港湾の指定に当たりましては、港湾法によりまして２つ以上の洋上風力の海域が指定されることが必要であります"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "本市としては、短期的には基地港湾の整備や洋上風力の建設に関する地元企業への経済波及効果を期待しております"@ja.
<< kg:id_11 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "建設や現地調査等で多くの交流人口が増加することで、市内宿泊施設等への波及効果も期待しているところでございます"@ja.
<< kg:id_11 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "中長期的には、洋上風力発電事業の地域振興策による新たな産業形成"@ja.
<< kg:id_11 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "水素などの次世代エネルギーが普及することで、関連産業による雇用が創出され"@ja.
<< kg:id_11 prop:effect kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本市への定住人口の増加が期待されるだろうと考えております"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "スマート農業技術等を駆使して、除草、病害虫管理等を効率的に実施することで環境に優しい農業を実現しようというものでございます"@ja.
<< kg:id_18 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "段階的に農薬、化学肥料の使用低減を行うことで、最終的に有機農業を目指すこと"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:text-txt_contents "米消費の減少やそれに伴う価格の低迷"@ja.
<< kg:id_21 prop:cause kg:id_23 >>
    prop:text-txt_contents "米消費の減少やそれに伴う価格の低迷"@ja.
<< kg:id_21 prop:effect kg:id_24 >>
    prop:text-txt_contents "価格の低迷は農業者の高齢化や後継者不足につながっています"@ja.
<< kg:id_21 prop:effect kg:id_25 >>
    prop:text-txt_contents "価格の低迷は農業者の高齢化や後継者不足につながっています"@ja.
<< kg:id_26 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "担い手の育成と確保が１つ目"@ja.
<< kg:id_26 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "２つ目として複合経営の推進"@ja.
<< kg:id_26 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "３つ目として販路・消費の拡大"@ja.
<< kg:id_26 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "今回新たに柱立てするものとしては、それに加えて持続可能な循環型農業の促進というものを４番目の取り組むべき施策の柱に掲げた"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:text-txt_contents "国際情勢や燃油高騰、後継者不足の課題は一層厳しさを増しております"@ja.
<< kg:id_31 prop:cause kg:id_33 >>
    prop:text-txt_contents "国際情勢や燃油高騰、後継者不足の課題は一層厳しさを増しております"@ja.
<< kg:id_31 prop:cause kg:id_25 >>
    prop:text-txt_contents "国際情勢や燃油高騰、後継者不足の課題は一層厳しさを増しております"@ja.
<< kg:id_31 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "国際情勢や燃油高騰、後継者不足の課題は一層厳しさを増しております"@ja.
<< kg:id_31 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "水産業成長産業化支援事業を県と連携して実施しております。この事業は、漁業効率の向上や新たな漁法への挑戦などに必要な機器や機材の導入・整備を支援する事業"@ja.
<< kg:id_31 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "新規就業者確保・育成総合対策支援事業を当初予算に計上したところでございます"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:text-txt_contents "お出迎えやお見送りのにぎやかし"@ja.
<< kg:id_36 prop:contermeasure kg:id_38 >>
    prop:text-txt_contents "外国語対応の観光案内所の設置"@ja.
<< kg:id_36 prop:contermeasure kg:id_39 >>
    prop:text-txt_contents "物産展"@ja.
<< kg:id_36 prop:contermeasure kg:id_40 >>
    prop:text-txt_contents "酒田大獅子の設置"@ja.
<< kg:id_36 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "高校生によるボランティアガイド"@ja.
<< kg:id_36 prop:effect kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "コロナ禍前の寄港の際に非常に評価が高かったのが、この市民と高校生によるおもてなしということでございました"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:text-txt_contents "食材費の物価高騰分が転嫁されないよう"@ja.
<< kg:id_43 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "法人立保育所、認定こども園、認定外保育所に対し支援をするものでございます"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:text-txt_contents "食材価格の高騰によりまして給食の質や献立の維持が非常に困難な状況"@ja.
<< kg:id_46 prop:effect kg:id_48 >>
    prop:text-txt_contents "給食の質や献立の維持が非常に困難な状況"@ja.
<< kg:id_46 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "25円の増額改定分に新型コロナウイルス感染症対応地方創生臨時交付金を充てて、保護者負担が増えないように据置きという形で対応"@ja.
<< kg:id_50 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "令和５年度に開設をしますこども家庭センターでは、これまでの母子保健分野の子育て世代包括支援センターと児童福祉分野の子ども家庭総合支援拠点のそれぞれの機能を統合して、全ての妊産婦や子育て家庭に対して切れ目のない相談支援体制を構築"@ja.
<< kg:id_50 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "子育て世帯訪問支援事業を新たに実施いたします"@ja.
<< kg:id_50 prop:contermeasure kg:id_53 >>
    prop:text-txt_contents "妊娠届を提出した妊婦に対し５万円を"@ja.
<< kg:id_50 prop:contermeasure kg:id_54 >>
    prop:text-txt_contents "子育て応援給付金として出生児１人につき５万円を養育者に給付"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "健康課に新たに看護師を配置し事業を実施するものでございます。ハイリスク者等に対しては訪問相談や助言、医療機関への受診勧奨等を行います"@ja.
<< kg:id_57 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "令和５年４月から特別職の非常勤職員として地域医療政策顧問を酒田市としては置くことにしております"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "地域住民、防災関係機関、それから酒田市、そのそれぞれが連携して、災害時に協力して対応する体制づくりが大変重要"@ja.
<< kg:id_59 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "地区防災計画の策定を進めることで、その地区の自助・共助の力を高めること"@ja.
<< kg:id_59 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "酒田市の総合防災訓練につきましては、令和４年度に引き続き全市一斉の訓練として10月29日に行う予定"@ja.
<< kg:id_59 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "地域の自主防災会と消防団による避難行動要支援者の避難支援要領や個別避難計画の策定が必要になるため、市として支援を進めていきたい"@ja.
<< kg:id_64 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "平田地域へ３つの中継局を新たに整備をすることで、今申し上げました地区を含めた３総合支所管内における防災ラジオの不感エリアが解消される"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:text-txt_contents "空き家等の件数は人口減少、少子高齢化、核家族化により増加しております"@ja.
<< kg:id_66 prop:cause kg:id_68 >>
    prop:text-txt_contents "空き家等の件数は人口減少、少子高齢化、核家族化により増加しております"@ja.
<< kg:id_66 prop:cause kg:id_69 >>
    prop:text-txt_contents "空き家等の件数は人口減少、少子高齢化、核家族化により増加しております"@ja.
<< kg:id_66 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "空き家等ネットワーク協議会が主催をしております空き家等無料相談会につなげて問題解決に努めているところでございます"@ja.
<< kg:id_66 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "引き続き情報収集に努め、管理不全空き家の認定と解消に向けた対策を講じていきたい"@ja.
<< kg:id_72 prop:cause kg:id_73 >>
    prop:text-txt_contents "生産年齢の低下とともに人口減少が進み"@ja.
<< kg:id_72 prop:effect kg:id_74 >>
    prop:text-txt_contents "生産年齢の低下とともに人口減少が進み"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "テレワークやワーケーションといった働き方を県内外に発信・提案し飛島への関係人口の増加を目指していきたい"@ja.
<< kg:id_75 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "引き続き飛島の課題解決につなげていきたい"@ja.
<< kg:id_75 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "特定有人国境離島地域にこの飛島を追加指定するよう、引き続き県と連携をして関係各所に要望活動を続けてまいりたい"@ja.
<< kg:id_79 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "同居する親族を不要とするもので、市内に居住する若年単身者が応募できるほか、ＵＩＪターン就職をする市外の若年単身者についても応募を可能とする"@ja.
<< kg:id_79 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "性的マイノリティに対するパートナーシップ制度の対象者も入居できるように併せて改正"@ja.
<< kg:id_82 prop:effect kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "特に橋梁については重大な事故に直結することから、その改修が急がれています"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "酒田市橋梁長寿命化修繕計画に基づいて、点検、診断、補修のマネジメントサイクルを実施"@ja.
<< kg:id_86 prop:contermeasure kg:id_87 >>
    prop:text-txt_contents "マイナンバーカードの休日窓口の開催"@ja.
<< kg:id_86 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "企業・団体に加え来庁困難者への出張申請受付の実施"@ja.
<< kg:id_89 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "鶴岡市・酒田市・庄内町の２市１町で企業団を設立の上、水平統合を実現し"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "最終的には庄内広域水道用水供給事業との垂直統合を図ることでさらなる経営基盤強化を目指す"@ja.
<< kg:id_92 prop:cause kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "デジタル社会への積極的な取組や少子化対策などの新しい財政需要によりまして、歳出予算はコロナ禍前と比べても増加傾向"@ja.
<< kg:id_92 prop:cause kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "少子化対策などの新しい財政需要によりまして"@ja.
<< kg:id_92 prop:effect kg:id_95 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "基金の取崩しに頼った予算編成となっております"@ja.
<< kg:id_92 prop:contermeasure kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "市税収納率の向上"@ja.
<< kg:id_92 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "ふるさと納税制度の活用"@ja.
<< kg:id_92 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "公共施設の維持管理コストの圧縮を図ること"@ja.
<< kg:id_92 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "県内他市に比べて高い水準にあります公債費の抑制を図るため"@ja.
<< kg:id_100 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "令和５年度の青少年交流推進事業については、こういった課題などをしっかり整理した上で令和６年度につなげていきたい"@ja.
<< kg:id_100 prop:cause kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "相手都市との児童数の不均衡が生じている地区もありまして"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "市の財政状況が大変厳しくなる中で、ひとづくり・まちづくり総合交付金についても少し圧縮する必要があり"@ja.
<< kg:id_103 prop:effect kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "あたかも補助金が削られるという受け止めをされてしまったものですから、大変皆さんからは反発が出た"@ja.
<< kg:id_103 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "令和６年度以降は、令和５年度と同様の額で積算としたい"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "新たに本市の区域全体を対象とする地球温暖化対策実行計画・区域施策編を策定する"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "市の補助金がない中でも開催をしたい意向だということで伺っておりますので、規模を縮小し、繰越金等を有効に活用するなどの工夫をして、５月５日の開催に向けて準備を進めている"@ja.
<< kg:id_111 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "国からは４月以降も国負担によるワクチン接種は継続実施する方針"@ja.
<< kg:id_111 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "秋から冬の接種は、これまでと同様に個別接種と集団接種の両方の体制が必要になると認識しております"@ja.
<< kg:id_111 prop:effect kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "幅広い医療機関で新型コロナウイルス感染症の診療に対応する体制へと段階的に移行していく"@ja.
<< kg:id_111 prop:effect kg:id_115 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "基本的に保育所は休園しないことになると思われます"@ja.
<< kg:id_116 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "少子化対策を最重要課題の一つと位置づけて、これまでも、結婚・妊娠・出産・子育てまで切れ目のない支援を行ってまいりました"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "構成企業が講師となり、東北公益文科大学において寄附講座を実施する"@ja.
<< kg:id_120 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "ＮＴＴ東日本酒田本町ビル１階に新たな拠点として、リボンステーションという名称の拠点を開設"@ja.
<< kg:id_120 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "民間企業と連携して、ＯＪＴを通じた教育研修、伴走支援を行っていく"@ja.
<< kg:id_123 prop:cause kg:id_124 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "近年は土地価格の急激な高騰もなく、土地を先行取得するというメリットもなくなりまして、基金の存在意義が薄れてきた"@ja.
<< kg:id_123 prop:cause kg:id_125 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "約８億円の活用見込みのない基金を保有し続けることは財政面でのメリットがなく"@ja.
<< kg:id_126 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "まずは酒田臨海工業団地などの未分譲地などの情報提供をしていく所存"@ja.
<< kg:id_126 prop:contermeasure kg:id_128 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "本市の工業地域にあります未利用地、それから民間工場跡の居抜き物件の活用が促されるよう情報収集とその情報の提供"@ja.
<< kg:id_129 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "第四中学校区をモデル地区として、まずは市長部局に地域プロデューサーを配置して"@ja.
<< kg:id_129 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "地域プロデューサーは、多様な地域内の主体をつないで、各種団体等の連携・協働を支援・促進する役割を担う人材"@ja.
<< kg:id_132 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "なるべく早い段階で、しっかりとした建設の計画について、事業者側と、それから入るテナント企業、そういったところも含めた形で合意形成を図ってまいりたい"@ja.
<< kg:id_134 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "各クラスの乗船客のニーズに合った対応が重要だと考えております"@ja.
<< kg:id_134 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "初のラグジュアリークラスの寄港に合わせ、令和５年度から、酒田ＤＭＯの活動の一環として、山形が誇る山形県産工芸品を御覧いただく展示即売会を開催"@ja.
<< kg:id_137 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "米粉用米を作付した上で、作付圃場にケイ酸質肥料等を散布する場合に、10アール当たり5,900円を交付する"@ja.
<< kg:id_139 prop:cause kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "化学肥料については、その主要な原料を海外に依存しており"@ja.
<< kg:id_139 prop:cause kg:id_141 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "穀物需要の増加や国際情勢の影響等から、近年は価格が高騰している"@ja.
<< kg:id_139 prop:cause kg:id_142 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "穀物需要の増加や国際情勢の影響等から、近年は価格が高騰している"@ja.
<< kg:id_143 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "耕種農家と畜産農家が連携することで、地域資源の循環を図る耕畜連携の取組を推進しております"@ja.
<< kg:id_143 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "牛のふん尿から生産する液肥を活用し、水田へ施用する実証実験"@ja.
<< kg:id_143 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "堆肥散布組織の活動への支援"@ja.
<< kg:id_143 prop:contermeasure kg:id_147 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "ドローンで圃場を空撮して、その画像から生育状況を解析するセンシングや土壌分析に対しても令和４年度より支援"@ja.
<< kg:id_148 prop:contermeasure kg:id_149 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "メリットといたしましては、組織統合による事務の効率化や運営コストの削減"@ja.
<< kg:id_148 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "施設の統廃合による更新費用や維持管理費の低減"@ja.
<< kg:id_148 prop:effect kg:id_151 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "令和37年度までの期間で272億7,000万円の削減効果が見込まれている"@ja.
<< kg:id_152 prop:cause kg:id_153 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "最も古いもので既に60年が経過し、更新時期を迎えております"@ja.
<< kg:id_152 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "朝日浄水場からの受水に切り替えることによりまして、小牧浄水場の廃止を予定しております"@ja.
<< kg:id_152 prop:contermeasure kg:id_155 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "当面は、計画的な点検整備や修繕を施すことによって、施設機能の維持を図ってまいりたい"@ja.
<< kg:id_156 prop:contermeasure kg:id_157 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "水道事業が塩水の影響を受けない水源のみで供給が可能になれば、工業用水事業にとっても、緊急避難的な水道利用が可能"@ja.
}
