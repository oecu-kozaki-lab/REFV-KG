kg:op_58 prop:speaker kg:st_3.
kg:op_59 prop:content "機能在り方と売却方針を確認したい"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_6.
kg:op_60 prop:content "廃止や売却ありきではなく利活用を含め検討すると説明する"@ja.
