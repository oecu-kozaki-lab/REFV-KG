    prop:text-txt_contents "酒田市は現在様々な課題に直面しています。例えば、あらゆる分野における担い手不足"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "酒田市は現在様々な課題に直面しています。例えば、あらゆる分野における担い手不足、空き家の増加"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "小売店の閉鎖によるいわゆる買物弱者の問題"@ja.
<< kg:id_5 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "小売店の閉鎖によるいわゆる買物弱者の問題"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "法人立保育所等の経営難"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "学校の統廃合など、多くの課題があります"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "その中で伝統的な性別役割分担意識をなくしていくことが唯一の道"@ja.
<< kg:id_10 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "本市が直面している人口減少、これを何とか緩やかにしていく道があると思うのです"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "共に子育て、共に家事の意識がないと、若い人が酒田から出ていきますよ"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "依然として家事・育児等のケア労働に女性のほうが長時間を費やしている状況にあります"@ja.
<< kg:id_12 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "家庭における家事・育児・介護等のケア労働は主に女性が担うものだという伝統的な性別役割分担意識、アンコンシャス・バイアスが依然として残っておりまして"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "出生数が減り続けている中で、市全体の保育環境を存続維持するため"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "令和４年度には定員数3,385人に対し入所している児童の数は2,950人、つまり、その差435人と、大変大きくなってきておりまして、法人立保育所等の運営に影響が生じております"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "市立保育園を閉園していくという考えに至った理由は、加速化した少子化の下で市全体の保育環境を維持するためであります"@ja.
<< kg:id_17 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "法人立保育所等が充足しております中心市街地に位置しており"@ja.
<< kg:id_17 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "かつ、建物の老朽化が進んでいる市立松陵保育園を閉園するという考えに至りました"@ja.
<< kg:id_10 prop:cause kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "人口減少をできるだけ緩やかにするためには、若い人の仕事をつくる"@ja.
<< kg:id_10 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "人口減少をできるだけ緩やかにするためには、若い人の仕事をつくる、あるいは、市民所得の向上を図るということが必要"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "公債費や物件費が多くなり、財政の硬直化が続いている"@ja.
<< kg:id_23 prop:cause kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "公債費や物件費が多くなり、財政の硬直化が続いている"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "基本的な財政構造が変わっておらず、当面、基金からの繰入れに頼らざるを得ない予算編成が続いていくものと見込んでございます"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "残念ながら、近年、山林の購入希望者はいない状況となってございます"@ja.
<< kg:id_3 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "空き家等の件数は、今後も増加することが予想されますが、その要因としては、人口減少のほか"@ja.
<< kg:id_3 prop:cause kg:id_30 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "その要因としては、人口減少のほか、相続放棄等により所有者の把握が困難であることが上げられます"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "中心市街地においても、小売店舗の相次ぐ撤退により、買物をする場所がないという状況が発生しております"@ja.
<< kg:id_31 prop:cause kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "バスがデマンドタクシーに代替されたことで、気軽に買物に行けなくなったとの感想"@ja.
<< kg:id_31 prop:cause kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "小売店舗が統合され、近くに小売店舗がなくなっているエリアが多い"@ja.
<< kg:id_31 prop:cause kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "これらのことから、買物弱者の課題としては、情報のミスマッチ、交通手段の確保などが考えられます"@ja.
<< kg:id_31 prop:cause kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "これらのことから、買物弱者の課題としては、情報のミスマッチ、交通手段の確保などが考えられます"@ja.
<< kg:id_31 prop:effect kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "気軽に買物に行けなくなったとの感想"@ja.
<< kg:id_31 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "買物弱者に関するプロジェクトチームを立ち上げ、過疎地域だけでなく、中心市街地も含めた酒田市全体の課題把握と効果的な施策の展開を行っていきたい"@ja.
<< kg:id_31 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "琢成学区コミュニティ振興会で実施しているよろずや琢成での買物代行サービス"@ja.
<< kg:id_31 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "田沢コミュニティ振興会で実施している田沢おたすけ隊での買物代行及び付添支援サービス"@ja.
<< kg:id_10 prop:effect kg:id_2 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "担い手不足などの課題解決を図り、地域活性化につなげる"@ja.
<< kg:id_10 prop:effect kg:id_3 >>
    prop:text-txt_contents "酒田市は現在様々な課題に直面しています。例えば、あらゆる分野における担い手不足、空き家の増加"@ja.
<< kg:id_10 prop:effect kg:id_5 >>
    prop:text-txt_contents "小売店の閉鎖によるいわゆる買物弱者の問題"@ja.
<< kg:id_10 prop:effect kg:id_6 >>
    prop:text-txt_contents "法人立保育所等の経営難"@ja.
<< kg:id_10 prop:effect kg:id_7 >>
    prop:text-txt_contents "学校の統廃合など、多くの課題があります"@ja.
<< kg:id_10 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "その差435人と、大変大きくなってきておりまして、法人立保育所等の運営に影響が生じております"@ja.
<< kg:id_10 prop:effect kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "それにもかかわらず、それ以上のスピードで人口が減り、少子高齢化が進んでいます"@ja.
<< kg:id_23 prop:effect kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "当面、基金からの繰入れに頼らざるを得ない予算編成が続いていくものと見込んでございます"@ja.
<< kg:id_10 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "具体施策として、市長所信表明の中でもデジタル関連企業の集積"@ja.
<< kg:id_10 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "再生可能エネルギー関連企業の集積"@ja.
<< kg:id_10 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "「外貨」を稼ぐ観光と移出・輸出の促進"@ja.
<< kg:id_10 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "地元企業・農林水産業者の「稼ぐ力」の向上"@ja.
<< kg:id_8 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "特に年代の高い層には出前講座等により、家庭における男女共同参画の意識啓発を行ってまいりました"@ja.
<< kg:id_8 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "共に子育て、共に家事の意識がないと、若い人が酒田から出ていきますよ、ということをきちんとお伝えをして"@ja.
<< kg:id_12 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "「家事シェアのススメ」というパンフレットを作成し"@ja.
<< kg:id_12 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "結婚新生活支援の補助金交付を受けた新婚家庭には家事育児参加促進講座の受講を義務づけ"@ja.
<< kg:id_17 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "保育定員の削減が必要となった場合には、市立保育園が調整弁の役割を担うということを決めております"@ja.
<< kg:id_52 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "これからの市立保育園は、民間ではなかなか担うことが困難、大変だと言われて依頼をされております障がい児保育の充実"@ja.
<< kg:id_52 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "特別保育（一時預かり・休日保育）の充実"@ja.
<< kg:id_52 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "保育園に併設される子育て支援センターによる未就園児への支援"@ja.
<< kg:id_23 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "プロジェクト３０－３０を継続することにより、毎年公債費が減少していくことになります"@ja.
<< kg:id_23 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "今後も、可能な限り積極的な売却を図り、市の財源確保に努めていきたい"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_59;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "酒田市公共施設適正化懇談会は、酒田市公共施設等総合管理計画に基づく公共施設の適正化を進めるに当たり、当該施設を利用する関係団体等の意見を聴取し、施設の在り方を検討するために設置をいたしました"@ja.
<< kg:id_28 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "Ｊクレジット制度もございますので、クレジットの売却益を得るなど、山林の活用についても検討してまいりたい"@ja.
<< kg:id_3 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "相続財産管理人選任申立ては、所有者不明の空き家等を市が利害関係人となって、財産処分を目的として申立てを行うもので"@ja.
<< kg:id_3 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "予算の増額を検討して、今後のこれらの制度の積極的な活用を考えていきたい"@ja.
<< kg:id_10 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_65;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "本市の強みは、ジュニアドクター鳥海塾で学んでいる小学校高学年からサンロクＩＴ女子のような社会人まで、デジタル技術を学んでいる若い人材がたくさんいる地域だということを積極的にアピールをして、企業誘致につなげていきたい"@ja.
<< kg:id_44 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_67;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_68;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "現在、海洋再生可能エネルギー発電設備等拠点港湾、いわゆる基地港湾の指定を目指し、山形県が酒田港港湾計画に海洋再生可能エネルギー発電設備の設置及び維持管理の拠点を形成する区域を新たに位置づけるための一部変更手続を進めておりまして"@ja.
<< kg:id_65 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_70;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "美酒美食のまち酒田として、これからＰＲしてまいります"@ja.
<< kg:id_65 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_72;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "着地型観光は、まさに酒田ＤＭＯが担っていく重要な役割の一つであると考えております"@ja.
<< kg:id_65 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_74;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "登録により、観光庁をはじめとした関係省庁による補助事業などの各種支援メニューの提供や観光地域づくりに関するアドバイス等を受けられるようになるため、そのことが酒田ＤＭＯの機能強化につながるものと考えております"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "観光物産協会ホームページ「酒田さんぽ」の外国語対応"@ja.
<< kg:id_69 prop:contermeasure kg:id_71 >>
    prop:text-txt_contents "外国語表示に対応した観光看板の整備"@ja.
<< kg:id_69 prop:contermeasure kg:id_72 >>
    prop:text-txt_contents "北庄内地域通訳案内士の認定と育成"@ja.
<< kg:id_69 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "外国クルーズ船乗船客のおもてなし"@ja.
<< kg:id_69 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "酒田ＤＭＯが台湾市場向け観光プロモーション活動を行っております"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_79;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "両沿線の美しい風景を疑似体験できる写真や動画コンテンツの配信"@ja.
<< kg:id_75 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "外国人に影響力を持つインフルエンサーに依頼して乗車体験を発信してもらう"@ja.
<< kg:id_75 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "羽越本線の観光列車「海里」を利用する観光商品の造成"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "他国の違法操業や海水の温暖化によって実に厳しい状況に置かれております"@ja.
<< kg:id_79 prop:cause kg:id_81 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "他国の違法操業や海水の温暖化によって実に厳しい状況に置かれております"@ja.
<< kg:id_79 prop:effect kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "今年の８月末現在、スルメイカの水揚げ量は対前年比で5.7％"@ja.
<< kg:id_79 prop:effect kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "水揚げ金額は対前年比で9.7％"@ja.
<< kg:id_79 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "これまでイカ釣り漁業を支援する目的でクラウドファンディングに取り組んでおり"@ja.
<< kg:id_79 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "県漁協の大型冷蔵庫と製氷工場の電気料金高騰分について、県、鶴岡市、遊佐町とともに支援するための補正予算を提案しております"@ja.
<< kg:id_79 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "水産業の成長産業化に向けたワーキングチーム会議が設置されたため、引き続き、この会議の中で支援策を検討してまいりたい"@ja.
<< kg:id_87 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_90;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "酒田市産業振興まちづくりセンターサンロクでは、市内事業者へ様々な支援を行っております"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_92;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "職場における長時間労働の是正"@ja.
<< kg:id_89 prop:cause kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "家庭内の家事・育児・介護などのケア労働を家族全員でシェアすること"@ja.
<< kg:id_89 prop:cause kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "保育・介護などのサービスを充実させること"@ja.
<< kg:id_89 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "日本一女性が働きやすいまち宣言に賛同するリーダーの会への加入促進"@ja.
<< kg:id_89 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_97;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "男性の育児休業取得に対して、市独自の奨励金制度も行っております"@ja.
<< kg:id_89 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "保育所、認定こども園、学童保育所の整備"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "障がい児あるいは医療的ケア児の保護者は、通院や通所のために仕事を休まざるを得ない"@ja.
<< kg:id_96 prop:cause kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "障がい児福祉サービスの預かり時間が短いなど、仕事と育児の両立に困難を感じている"@ja.
<< kg:id_96 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "令和５年度から試行として午前７時半から午後６時半まで延長しております"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "昨年度まで事業所の定員が不足し、待機児童がいる状況でした"@ja.
<< kg:id_100 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "放課後等デイサービス新規開設セミナーを開催したところ、今年度、４つの事業所が開所し、待機児童が解消されております"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "全国的には高齢者の労働災害が増えている状況にあります"@ja.
<< kg:id_103 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "ハローワーク酒田では生涯現役支援窓口を設置し、高年齢求職者に対して、職業生活の再設計や就労支援を行っている"@ja.
<< kg:id_103 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "エイジフレンドリーガイドライン、高年齢労働者の安全と健康確保のためのガイドラインを策定しており、本市においても市ホームページ等で周知する"@ja.
<< kg:id_103 prop:contermeasure kg:id_107 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_108;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "酒田市シルバー人材センターでは、県外の門松の生産事業者と連携した農業分野での新たな就業の場の創出やホームセンターでの品出しなど"@ja.
<< kg:id_108 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "地域にある介護施設の介護補助業務に、新たに人材を派遣する事業"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "職場の障がい者理解、それから、職場の上司や同僚に障がいの理解があることという回答を多くいただきました"@ja.
<< kg:id_110 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_112;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "事業者に対して、障がいの特性や必要な配慮などの理解を深める"@ja.
<< kg:id_110 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "障がい者雇用を促進する各種助成制度や支援制度について周知を図ってまいります"@ja.
<< kg:id_114 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "市役所でのバザーの定期的な開催"@ja.
<< kg:id_114 prop:contermeasure kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "庁内に開設しているカフェ「えーる」の利用"@ja.
<< kg:id_114 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "ふるさと納税返礼品への登録の呼びかけ"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_118;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "少子化により複式学級となる小学校が年々増加しており"@ja.
<< kg:id_118 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "６小学校１中学校を統合した義務教育学校を設立するという方針決定を行ったところであります"@ja.
<< kg:id_121 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_121;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_122;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "いち早く第四中学校区に地域プロデューサーを配置し、毎週６地区を巡回訪問することで、地域コミュニティとの連携や情報収集・共有に努めております"@ja.
<< kg:id_123 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_124;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_125;
    prop:text-txt_contents "市民アートコーディネート調査研究業務を東京藝術大学に委託し、派遣人材が実際に酒田市に居住し、地域に密着した調査・研究を始めております"@ja.
<< kg:id_125 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_126;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_127;
    prop:text-txt_contents "スマートフォンのアプリを活用した民間主催のラン＆ウオークイベントを、市民及び市内企業へ周知して実施"@ja.
<< kg:id_125 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "平成30年度からニュースポーツ大会を開催"@ja.
<< kg:id_125 prop:contermeasure kg:id_128 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_129;
    prop:text-txt_contents "令和４年度に酒田市モルック大会を初めて開催し、小学生から80代まで123名から御参加をいただきました"@ja.
<< kg:id_125 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_130;
    prop:text-txt_contents "市のホームページにウォーキングマップも掲載しております"@ja.
<< kg:id_125 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "健康診査後の健康づくりを応援するさかた健康マイレージ事業"@ja.
<< kg:id_131 prop:cause kg:id_132 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_132;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "駐車台数の確保が計画どおりにいかず、結果として、有料観覧席の席数を十分に販売できなかったことが、事業収入が予定を下回った大きな要因"@ja.
<< kg:id_131 prop:effect kg:id_133 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_134;
    prop:text-txt_contents "大会で生じた収支不足について、実行委員会負担金を増額するもの"@ja.
<< kg:id_131 prop:contermeasure kg:id_134 >>
    prop:text-txt_contents "酒田の花火への協賛を目的とした企業版ふるさと納税寄附金"@ja.
<< kg:id_131 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_135;
    prop:text-txt_contents "大会で生じた収支不足について、実行委員会負担金を増額するもの"@ja.
<< kg:id_136 prop:cause kg:id_137 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_136;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_137;
    prop:text-txt_contents "令和４年度は、国税の増収見込みなどにより、財源不足が生じないこと"@ja.
<< kg:id_136 prop:cause kg:id_138 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_138;
    prop:text-txt_contents "臨時財政対策債の総額が抑制され、その分は本来の交付税として措置されている"@ja.
<< kg:id_139 prop:cause kg:id_140 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_139;
    prop:text-txt_contents "全数把握による市町村別の感染者数の公表を終了してございます"@ja.
<< kg:id_139 prop:cause kg:id_141 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_140;
    prop:text-txt_contents "令和５年５月８日以降は、感染症法上の５類に位置づけられましたことから、季節性インフルエンザなどと同様に定点把握感染症"@ja.
<< kg:id_142 prop:effect kg:id_143 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_141;
    prop:text-txt_contents "地域の医療提供体制に影響することが懸念されます"@ja.
<< kg:id_142 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_142;
    prop:text-txt_contents "市のホームページで市民の皆様に対して、新型コロナウイルス感染症への対応について、注意喚起してまいりました"@ja.
<< kg:id_142 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_143;
    prop:text-txt_contents "保健所、医師会、病院、市町が定期的に会議を開きまして、情報の共有を実施しております"@ja.
}
