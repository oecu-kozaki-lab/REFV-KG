kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:op_62 prop:content "中心市街地でも積極活用すべきと求める"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:op_63 prop:content "一定の成果があり今後も活用を考える"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "空き家利活用促進のため制度活用を強めたい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "市役所業務のアウトソーシングも含めた連携を求める"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_4.
kg:op_66 prop:content "若いデジタル人材の存在を積極的にアピールすると述べる"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "県との連携構築が最重要と考える"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_4.
kg:op_68 prop:content "洋上風力実現に不可欠として見通しを確認する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_7.
kg:op_69 prop:content "県主導の計画変更や指定手続が進んでいると説明する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
