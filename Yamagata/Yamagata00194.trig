kg:st_6 rdfs:label "齋藤美昭議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_37 prop:content "教育環境整備や地域活性化の文脈で課題視する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_6.
