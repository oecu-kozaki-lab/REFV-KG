kg:st_1 rdfs:label "武田恵子議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "市が直面する重要課題として認識している"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "市が直面する重要課題として認識している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "買物弱者問題を生む要因として懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "小売店閉鎖が買物弱者を生むと指摘する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "市が直面する重要課題として認識している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "市が直面する重要課題として認識している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "意識改革が進まないことが改善を阻むと考える"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "本市のような地方都市の市民が意識を変えていく必要があると考える"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_2 rdfs:label "矢口明子市長"@ja.
kg:st_2 rdfs:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_9 prop:content "共に子育て共に家事の意識がないと若い人が酒田から出ていくと伝えていく考え"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "依然として女性負担が大きい状況を課題視している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "高齢層への意識改革が必要と考える"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "少子化の加速で保育環境維持が難しくなっていると説明する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "法人立保育所等の運営に影響が生じていると説明する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "急激な人口減少を踏まえ計画の見直しも必要ではないかと述べる"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "市全体の保育環境維持のため必要と説明する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "保育機能の全体最適の観点から閉園判断を説明する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "施設老朽化も閉園理由の一つと説明する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "若い人の仕事づくりが人口減少緩和に必要と考える"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "市民所得向上が人口減少対策に必要と考える"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:st_3 rdfs:label "前田茂男総務部長"@ja.
kg:st_3 rdfs:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_20 prop:content "公債費の多さが財政硬直化の要因と説明する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "物件費の多さが財政硬直化の要因と説明する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "当面は基金繰入れ依存が続くと見込む"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "現状は購入希望者待ちになっていると説明する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "空き家増加の要因の一つと認識している"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:st_4 rdfs:label "後藤仁議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_25 prop:content "所有者不明空き家への積極対応を求める"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "制度活用を積極化したい考えを示す"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:st_5 rdfs:label "市村浩一議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_27 prop:content "中心市街地の居住環境が崩れていると懸念する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "中心市街地でも買物場所がない状況が発生していると認める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "市民から気軽に買物に行けなくなったとの声があると認識している"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "買物弱者問題の大きな要因と認識している"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "情報が行き届いていないことも課題とみる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "交通手段の確保不足も課題とみる"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "市民生活への不便が生じていると認識している"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "酒田市全体の課題把握と効果的施策の展開に取り組む考え"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "地域独自の助け合い活動として重要と評価する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "地域独自の助け合い活動として重要と評価する"@ja.
