kg:st_2 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_3 prop:content "地域と行政の協働により組織機能を維持していきたい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "若い世代を取り込む工夫を自治会と協議しながら進めたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "自治会の重要性を周知し丁寧な加入促進を継続したい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "自治会は地域づくりの大切なパートナーであり活動継承支援が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地域コミュニティまちづくり協働指針に基づき地域づくりを進めたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "自治会のニーズに沿った様々な支援を行う必要がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "地域の幅広い人材を見つける支援に行政も力を果たしたい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "自治会加入の必要性を引き続き周知したい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "関係団体と連携して集合住宅居住者への加入促進を進めたい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "マニュアル作成予定はないが周知機会の拡大に努めたい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "アイデアの一つだが顔の見える関係を構築し納得して加入してもらうことも大切"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "スマートフォンを活用できる住民にとって有効"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "自治会長や役員、住民の負担軽減につながる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "住民同士で迅速に情報共有できるメリットがある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "会議を開催せずに住民の意見を集約できる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "回覧板には見守りやつながりを保つ役割もあり安易に置き換えられない"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "一部自治会で実証を開始しており課題を検証したい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "市民が選択できるため大きなメリットになる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "取り組みたい自治会には研修会開催や必要なサービス紹介を行いたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "実証自治会の課題などを積極的に知らせたい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "各自治会で導入し利用してほしい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "試験的取組の検証を踏まえて助成の在り方を研究したい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:st_3 rdfs:label "伊藤欣哉議員"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_25 prop:content "今夏の猛暑を今後へ生かす必要がある"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:st_4 rdfs:label "佐藤元教育次長"@ja.
kg:st_4 rdfs:type cls:st_2.
kg:op_26 prop:content "児童生徒の命を守ることを最優先に対応した"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "児童生徒の安全を第一に考え対応した"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "教育課程の変更に迫られる厳しい実態があった"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "複数回の通知でも大きな混乱はなかった"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "定期的なクールダウンを可能にするため導入を計画している"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "クールダウンや健康観察も含めて通知したい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:st_5 rdfs:label "久保賢太郎農林水産部長"@ja.
kg:st_5 rdfs:type cls:st_2.
kg:op_32 prop:content "持続可能な資源循環型農業を促進する必要がある"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "堆肥のペレット化など使いやすくする検討が必要"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:op_34 prop:content "段階的に有機を目指すステップが必要"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_5.
kg:op_35 prop:content "厳しい経営を強いられていることを承知している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "散布が容易にできるよう検討したい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "資源循環の仕組み構築支援を続けてきた"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "モデル事例としてPRに努めたい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "農地の集約化は喫緊の課題"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:st_6 rdfs:label "五十嵐直太郎農業委員会会長"@ja.
kg:st_6 rdfs:type cls:st_50.
cls:st_50 rdfs:label "委員会"@ja.
kg:op_40 prop:content "地域の話合いを進め地域計画策定を進める"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "果樹産地などで重点的に話合いを進めることが大事"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:st_7 rdfs:label "市村浩一議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_42 prop:content "居住誘導を促しコンパクトでにぎわいのある酒田の顔づくりが必要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_7.
kg:st_8 rdfs:label "矢口明子市長"@ja.
kg:st_8 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_43 prop:content "旧マリーン5清水屋周辺の再生が重要"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_8.
kg:op_44 prop:content "特に旧マリーン5清水屋を中心とした中町エリアをそのようにしたい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_8.
kg:op_45 prop:content "昼間人口増加をきっかけに商業施設出店と居住人口増加のサイクルを作りたい"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_8.
kg:op_46 prop:content "市民の利便性向上と集客力向上に役立つ施設を検討したい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_8.
kg:st_9 rdfs:label "中村慶輔企画部長"@ja.
kg:st_9 rdfs:type cls:st_2.
kg:op_47 prop:content "さらなる支援が必要と考え設立を位置づけた"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_9.
kg:op_48 prop:content "酒田DMOとの連携による地域活性化を期待する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_9.
kg:op_49 prop:content "繁殖抑制に取り組むことが一番重要"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "繁殖抑制が一番重要"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "不幸な猫を増やさないため行政と地域ねこの会の役割分担が必要"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "支援の必要性を認識しており方策を検討したい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "国や県に実情を伝え予算確保を要求したい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:st_10 rdfs:label "田中斉議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_54 prop:content "被害があってからでは遅く根絶に向けた動きが必要"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_10.
kg:op_55 prop:content "地域の実情をしっかり国や県に伝えることが重要"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_5.
kg:op_56 prop:content "切るだけでは砂防林を守れず抵抗性松も使いながら対応が重要"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_5.
kg:op_57 prop:content "交通事業者の運転手不足は大きな課題"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_8.
kg:op_58 prop:content "市内交通事業者に制度の情報提供をしている"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_8.
kg:op_59 prop:content "全国の新しい運行システム事例を見ながら検討したい"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_8.
kg:st_11 rdfs:label "安川智之副市長"@ja.
kg:st_11 rdfs:type cls:st_2.
kg:op_60 prop:content "洋上風力導入を契機とした関連産業創出を期待する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_11.
kg:op_61 prop:content "不安の声があることを法定協議会でしっかり伝えたい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_11.
kg:op_62 prop:content "意見は出尽くしておらずバランス良く議論することが大切"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_11.
kg:op_63 prop:content "最新の知見や先行地域の状況を共有したい"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_11.
kg:op_64 prop:content "どういった研究機関を誘致すべきか今後検討したい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_11.
kg:op_65 prop:content "基地港湾指定加速へ働きかけを行っている"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_11.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "全国的に少子化、高齢化、人口減少が加速的に進み、自治会の運営に大きな影響をもたらしてきております"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "全国的に少子化、高齢化、人口減少が加速的に進み、自治会の運営に大きな影響をもたらしてきております"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "全国的に少子化、高齢化、人口減少が加速的に進み、自治会の運営に大きな影響をもたらしてきております"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "よく言われていることは、１、自治会員が急速に高齢化している"@ja.
<< kg:id_5 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "よく言われていることは、２、役員の成り手がいない"@ja.
<< kg:id_5 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "よく言われていることは、３、新規加入者が少なく加入率が低下している"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "令和２年から令和４年まで丸３年間、コロナ禍のため、長期間にわたり、自治会活動が停滞を余儀なくされました"@ja.
<< kg:id_5 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本市におきましては、過疎化や高齢化、人口減少や個人の価値観の多様化などにより"@ja.
<< kg:id_5 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "本市におきましては、過疎化や高齢化、人口減少や個人の価値観の多様化などにより"@ja.
<< kg:id_5 prop:effect kg:id_13 >>
    prop:text-txt_contents "自治会における組織規模の縮小"@ja.
<< kg:id_5 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "担い手不足など活動の継続が困難になっていることが課題である"@ja.
<< kg:id_5 prop:effect kg:id_15 >>
    prop:text-txt_contents "担い手不足など活動の継続が困難になっていることが課題である"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "本市では、転入した方に対して、自治会への加入促進のために、市民課に届出をした際に、自治会の重要性を説明したチラシを配布しております"@ja.
<< kg:id_16 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "集合住宅の管理者や所有者の方々へ自治会加入の周知を図っていただいているところであります"@ja.
<< kg:id_16 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "自治会への加入の必要性については、市ホームページやその他の媒体を活用し、引き続き、周知の機会の拡大に努めていきたい"@ja.
<< kg:id_16 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "市ホームページからスマートフォンやパソコンを使って行う加入申込みは、アイデアの一つだと考えられます"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "電子回覧板による情報伝達の迅速性の確立・事務の簡素化"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "電子回覧板による情報伝達の迅速性の確立・事務の簡素化"@ja.
<< kg:id_21 prop:effect kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "災害時における安否確認"@ja.
<< kg:id_21 prop:effect kg:id_25 >>
    prop:text-txt_contents "行事のお知らせや出欠確認"@ja.
<< kg:id_21 prop:effect kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "意見集約などの機能が備わっている"@ja.
<< kg:id_21 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "回覧板を回さなくなることで人と会う機会がますます減り、近所付き合いの希薄化がより一層進む可能性も考えられます"@ja.
<< kg:id_21 prop:effect kg:id_28 >>
    prop:text-txt_contents "スマートフォンを使えない方に対しては、使い方のサポートなどが必要となります"@ja.
<< kg:id_21 prop:effect kg:id_29 >>
    prop:text-txt_contents "紙媒体でしか情報を受け取れない方がいる場合は、これまでどおり紙でも回覧するか、役員が直接その方に持っていくなど手間がさらに増えてしまう可能性がございます"@ja.
<< kg:id_21 prop:effect kg:id_30 >>
    prop:text-txt_contents "回覧する情報をアプリに取り込み、編集し、発信するなどの操作をする必要があるため、自治会役員の負担が増加する"@ja.
<< kg:id_21 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "本市の一部の自治会では、活用に向けた実証を開始していると伺っております"@ja.
<< kg:id_21 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "当然、回覧板が残っている限り、併用して使っていただくことになろうかと考えております"@ja.
<< kg:id_21 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "研修会の開催ですとか、必要なサービスを紹介したり、導入のための考え方を整理したり"@ja.
<< kg:id_21 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "自治会連合会の研修会などで事務局のほうとも相談しながら、そういった情報も積極的に自治会の皆様にお知らせをしていければ"@ja.
<< kg:id_35 prop:contermeasure kg:id_36 >>
    prop:text-txt_contents "現在、飛島を除く35か所のコミュニティセンターにはＷｉ－Ｆｉが設置してあり"@ja.
<< kg:id_35 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "コンセントを差し込むだけで、一定の費用負担をすればＷｉ－Ｆｉが使える機器が各携帯電話会社で提供されていることから、そういったものを各自治会で導入し"@ja.
<< kg:id_35 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "助成については、今後の課題ということで考えていきたいと思います"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "地球温暖化が世界的共通課題となって"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:text-txt_contents "地球温暖化の原因となっている二酸化炭素をはじめとする温室効果ガスは確実に増加しており"@ja.
<< kg:id_39 prop:cause kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "今夏の異常気象による猛暑の影響"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:text-txt_contents "暑い夏の体育館の授業や部活動での激しい運動が引き金になることが多い"@ja.
<< kg:id_43 prop:cause kg:id_45 >>
    prop:text-txt_contents "部活動での激しい運動が引き金になることが多い"@ja.
<< kg:id_42 prop:effect kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "部活動の中止"@ja.
<< kg:id_42 prop:effect kg:id_47 >>
    prop:text-txt_contents "運動会等の学校行事の延期"@ja.
<< kg:id_42 prop:effect kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "部活動や屋外での運動ができないなど教育課程の変更に迫られ"@ja.
<< kg:id_42 prop:contermeasure kg:id_49 >>
    prop:text-txt_contents "熱中症防止に関する注意喚起を行っております"@ja.
<< kg:id_42 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "以前の通知と変更になったポイントを整理して周知する"@ja.
<< kg:id_42 prop:contermeasure kg:id_51 >>
    prop:text-txt_contents "小学校では、プールの授業を７月中に終えるようにし"@ja.
<< kg:id_42 prop:contermeasure kg:id_52 >>
    prop:text-txt_contents "それ以降の炎天下での屋外での活動を回避する"@ja.
<< kg:id_53 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "運動中の定期的なクールダウンが可能となるよう可搬式の冷風装置を１校当たり２台、計14台の導入を計画"@ja.
<< kg:id_55 prop:contermeasure kg:id_56 >>
    prop:text-txt_contents "各学校のほうでは教室ですとか、あるいは体育館、それから特別教室のほうに暑さ指数計を置いて対応"@ja.
<< kg:id_55 prop:contermeasure kg:id_57 >>
    prop:text-txt_contents "体育館のほうでは、30分おきにチェックをしたり"@ja.
<< kg:id_55 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本市独自のマニュアルとして、新しく策定して通知したい"@ja.
<< kg:id_55 prop:contermeasure kg:id_59 >>
    prop:text-txt_contents "その始業式については、体育館では活動をせずに、エアコンの効いた教室でリモートで対応"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "環境や持続性に配慮するＳＤＧｓの取組が農産物や食品などにも広がりを見せてきている中で"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:text-txt_contents "地力が高く、土づくりに前向きに取り組む農業者が少ないこと"@ja.
<< kg:id_62 prop:cause kg:id_64 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "化学肥料を減らすために必要となる堆肥が市内であまり活用されていないこと"@ja.
<< kg:id_62 prop:cause kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "有機農業の取組面積が減少傾向であるという課題がございます"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "近年、資材価格が高騰しておりまして、農業者が厳しい経営を強いられている"@ja.
<< kg:id_60 prop:contermeasure kg:id_68 >>
    prop:text-txt_contents "コストを下げつつ、収量を確保する土づくりに係る農業者向けの研修会を開催すること"@ja.
<< kg:id_60 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "堆肥をペレット化することで、より使いやすくするための検討を行うこと"@ja.
<< kg:id_60 prop:contermeasure kg:id_70 >>
    prop:text-txt_contents "市内で堆肥がどこにどの程度あるのかを見える化する取組"@ja.
<< kg:id_60 prop:contermeasure kg:id_71 >>
    prop:text-txt_contents "農薬、化学肥料を低減しても、収量を確保できる除草や病害虫防除などの農業技術・資材の情報収集"@ja.
<< kg:id_60 prop:contermeasure kg:id_72 >>
    prop:text-txt_contents "酒田市の取組に共感する新規就農者の育成・確保"@ja.
<< kg:id_60 prop:contermeasure kg:id_73 >>
    prop:text-txt_contents "直売所、アンテナショップなどにおけるメニューなどの試作、販売促進、消費者調査"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "農業者が堆肥を購入して土づくりを行い、そこで生産される飼料を畜産業者へ販売するという資源循環の仕組みを構築するための支援を続けてきてまいりました"@ja.
<< kg:id_74 prop:contermeasure kg:id_76 >>
    prop:text-txt_contents "飼料生産組合がまとまって資材の発注を行うということで、購入コストを下げる"@ja.
<< kg:id_74 prop:contermeasure kg:id_77 >>
    prop:text-txt_contents "綿密な打合せを行うことで堆肥の効率的な配布ルートを決める"@ja.
<< kg:id_74 prop:effect kg:id_78 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "モデル事例として、ほかの地域へ周知を図りながら取組がさらに広まるように事業のＰＲに努めてまいりたい"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:text-txt_contents "堆肥を圃場まで運搬するにも費用がかかる"@ja.
<< kg:id_79 prop:cause kg:id_81 >>
    prop:text-txt_contents "堆肥をまくにもマニアスプレッダー、普通の機械ではまけませんので、そういったものがないと散布ができない"@ja.
<< kg:id_82 prop:cause kg:id_3 >>
    prop:text-txt_contents "その後、高齢化や人口減少などにより、さらに農業従事者は減少"@ja.
<< kg:id_82 prop:cause kg:id_4 >>
    prop:text-txt_contents "高齢化や人口減少などにより"@ja.
<< kg:id_82 prop:effect kg:id_83 >>
    prop:text-txt_contents "さらに農業従事者は減少"@ja.
<< kg:id_82 prop:effect kg:id_84 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "それに伴い、耕作放棄地が拡大し"@ja.
<< kg:id_85 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "本年８月から９月初めにかけて、市内16地区で第１回地区別協議会を開催したところです"@ja.
<< kg:id_85 prop:contermeasure kg:id_87 >>
    prop:text-txt_contents "第２回目の地区別協議会を今年度中に開催し"@ja.
<< kg:id_85 prop:contermeasure kg:id_88 >>
    prop:text-txt_contents "来年度においても、さらに２回の開催を予定している"@ja.
<< kg:id_85 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "サブ区域を設けまして、よりきめ細かな議論が、活発な意見交換ができるように"@ja.
<< kg:id_90 prop:cause kg:id_91 >>
    prop:text-txt_contents "大型小売店の郊外への立地、人口減少、車社会の進展など"@ja.
<< kg:id_90 prop:cause kg:id_4 >>
    prop:text-txt_contents "大型小売店の郊外への立地、人口減少、車社会の進展など"@ja.
<< kg:id_90 prop:cause kg:id_92 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "大型小売店の郊外への立地、人口減少、車社会の進展など"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:text-txt_contents "清水屋の撤退"@ja.
<< kg:id_93 prop:cause kg:id_95 >>
    prop:text-txt_contents "ト一屋の撤退"@ja.
<< kg:id_93 prop:cause kg:id_96 >>
    prop:text-txt_contents "老舗店舗の撤退などが加わり、中心市街地の衰退は加速を増すばかり"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "中町エリアは、今、車がなくては暮らせないまちになりつつあると認識しております"@ja.
<< kg:id_90 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "中町エリアを、今後は車がなくても暮らせるまちにしていきたい"@ja.
<< kg:id_90 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "まずは居住人口ではなく、昼間人口、昼間の人口の増加を目指し"@ja.
<< kg:id_90 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "公共的な機関など、市民の利便性の向上に役立ち、かつ集客力も高いような施設を中町エリアに移転、誘致することができないかを検討"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "アランマーレが令和５年３月26日にＶ２リーグで初優勝を飾り、４月４日及び９日の入替え戦に連勝し、悲願のＶ１昇格を果たした"@ja.
<< kg:id_104 prop:contermeasure kg:id_105 >>
    prop:text-txt_contents "アランマーレの応援"@ja.
<< kg:id_104 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "スポーツ団体と酒田ＤＭＯの連携によるスポーツツーリズムに係るコンテンツの開発"@ja.
<< kg:id_104 prop:contermeasure kg:id_107 >>
    prop:text-txt_contents "地元企業によるスポーツビジネスの創出"@ja.
<< kg:id_108 prop:cause kg:id_109 >>
    prop:text-txt_contents "不適切な餌やり"@ja.
<< kg:id_108 prop:cause kg:id_110 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "自然繁殖で頭数が増加することによる近隣トラブル"@ja.
<< kg:id_108 prop:effect kg:id_111 >>
    prop:text-txt_contents "民家敷地内・砂場でのふん尿"@ja.
<< kg:id_108 prop:effect kg:id_112 >>
    prop:text-txt_contents "頭数が増加することによる近隣トラブル"@ja.
<< kg:id_108 prop:contermeasure kg:id_113 >>
    prop:text-txt_contents "職員が現地に確認に出向き、周辺住民や関係者の方々への聞き取りを行い"@ja.
<< kg:id_108 prop:contermeasure kg:id_114 >>
    prop:text-txt_contents "原因者が特定されるという場合には、直接注意や指導を行っております"@ja.
<< kg:id_108 prop:contermeasure kg:id_115 >>
    prop:text-txt_contents "野良猫を忌避する方法を示したり"@ja.
<< kg:id_108 prop:contermeasure kg:id_116 >>
    prop:text-txt_contents "自治会と協力して、餌やりや糞尿に関する注意や対応方法についての回覧を作成し、周知を行っております"@ja.
<< kg:id_108 prop:contermeasure kg:id_117 >>
    prop:text-txt_contents "市ホームページにおきましても、飼い猫・野良猫のトラブルについてのページを設けて、市民の方へ周知や呼びかけを行っている"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "管理する方がいないために繁殖を抑制する手段がなく、頭数が無制限に増える"@ja.
<< kg:id_118 prop:effect kg:id_120 >>
    prop:text-txt_contents "野良猫に関するトラブルが増加する一因となっております"@ja.
<< kg:id_121 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "保護、不妊去勢手術の実施、そして、保護した場所へ返すといった、いわゆるＴＮＲ活動"@ja.
<< kg:id_121 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "野良猫等の不妊去勢手術に対する支援の方策等について検討してきたい"@ja.
<< kg:id_124 prop:cause kg:id_125 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "補助金額が要望額よりも少ない額しか配分されないという形になりまして、被害木として調査した松の約４割が残ってしまう"@ja.
<< kg:id_124 prop:cause kg:id_126 >>
    prop:text-txt_contents "今夏の高温少雨の影響で"@ja.
<< kg:id_127 prop:effect kg:id_128 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "松くい虫の被害木が強風でビニールハウスに倒れ、農業施設の被害も現実に発生しております"@ja.
<< kg:id_127 prop:effect kg:id_129 >>
    prop:text-txt_contents "国道112号の電線に倒れかかった倒木の撤去作業で半日通行止め"@ja.
<< kg:id_127 prop:contermeasure kg:id_130 >>
    prop:text-txt_contents "年明けからまた伐倒作業に入れるように、予算の確保も含めて準備を進めている"@ja.
<< kg:id_127 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "国や県に対し、補助金の予算確保を要求していく"@ja.
<< kg:id_127 prop:contermeasure kg:id_132 >>
    prop:text-txt_contents "庄内海岸林松くい虫被害対策強化プロジェクト会議というものがございまして、こちらでどういった形でできるかなという部分について議論"@ja.
<< kg:id_133 prop:contermeasure kg:id_134 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "抵抗性松の苗木については、北庄内森林組合のほうで苗木の生産行っております"@ja.
<< kg:id_135 prop:cause kg:id_136 >>
    prop:text-txt_contents "ＪＲ酒田駅前や日本海総合病院へアクセスしやすくした"@ja.
<< kg:id_135 prop:cause kg:id_137 >>
    prop:text-txt_contents "高校への通学利用を想定した経路の変更"@ja.
<< kg:id_135 prop:cause kg:id_138 >>
    prop:text-txt_contents "市内循環Ｃ線、Ｄ線の運行日の拡充"@ja.
<< kg:id_135 prop:cause kg:id_139 >>
    prop:text-txt_contents "路線廃止となった庄内交通バスの利用者がるんるんバスを利用するようになった"@ja.
<< kg:id_140 prop:cause kg:id_141 >>
    prop:text-txt_contents "運行地区の拡大によって利用者が増えた"@ja.
<< kg:id_140 prop:cause kg:id_142 >>
    prop:text-txt_contents "運行日の増加"@ja.
<< kg:id_140 prop:cause kg:id_143 >>
    prop:text-txt_contents "運行時刻の見直し"@ja.
<< kg:id_140 prop:cause kg:id_144 >>
    prop:text-txt_contents "指定乗降場所を増加させた"@ja.
<< kg:id_145 prop:effect kg:id_146 >>
    prop:text-txt_contents "利用者自身の活動時間に合っていないという運行時刻への要望が最も多く"@ja.
<< kg:id_145 prop:effect kg:id_147 >>
    prop:text-txt_contents "鉄道との接続やるんるんバスの乗換えに関するもの"@ja.
<< kg:id_148 prop:effect kg:id_149 >>
    prop:text-txt_contents "乗降場所の増設"@ja.
<< kg:id_148 prop:effect kg:id_150 >>
    prop:text-txt_contents "土曜日や日曜日の運行を求める声もありました"@ja.
<< kg:id_151 prop:cause kg:id_152 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "交通事業者から運転手不足と言われている中で"@ja.
<< kg:id_153 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "山形県は、今年度、第二種免許取得支援事業費補助金の制度を実施しており"@ja.
<< kg:id_153 prop:contermeasure kg:id_155 >>
    prop:text-txt_contents "交通事業者との意見交換などを行いながら、運転手不足への対応について、さらに何かできるのかどうか検討"@ja.
<< kg:id_153 prop:contermeasure kg:id_156 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "本市でも何か活用、導入することができないか、勉強していきたい"@ja.
<< kg:id_153 prop:contermeasure kg:id_157 >>
    prop:text-txt_contents "市議会からの提言書、アンケート調査の結果、そして、酒田商業高校跡地における民間施設の供用開始といった事情などを踏まえながら、今後改めて交通事業者と協議し、対応していきたい"@ja.
<< kg:id_158 prop:effect kg:id_159 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "洋上風力発電の導入を契機とした関連産業の創出"@ja.
<< kg:id_158 prop:effect kg:id_160 >>
    prop:text-txt_contents "多様な関連産業があることによる企業進出"@ja.
<< kg:id_158 prop:effect kg:id_161 >>
    prop:text-txt_contents "その雇用の創出"@ja.
<< kg:id_158 prop:effect kg:id_162 >>
    prop:text-txt_contents "選定事業者が行う地域貢献策も義務づけられておりますので、それによる経済波及効果も期待"@ja.
<< kg:id_158 prop:effect kg:id_163 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "洋上に風車が建設、そして、運転開始されることによる環境や景観、漁場等への影響"@ja.
<< kg:id_158 prop:effect kg:id_164 >>
    prop:text-txt_contents "環境や景観、漁場等への影響"@ja.
<< kg:id_158 prop:effect kg:id_165 >>
    prop:text-txt_contents "環境や景観、漁場等への影響"@ja.
<< kg:id_158 prop:contermeasure kg:id_166 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "それらについてバランス良くしっかり議論していくということがまずは大切"@ja.
<< kg:id_158 prop:contermeasure kg:id_167 >>
    prop:text-txt_contents "この11月１日の市広報にて、酒田市沖で今、どのような洋上風力に係る事業がどういう進捗状況、どういうフェーズにあるのかということ"@ja.
<< kg:id_158 prop:contermeasure kg:id_168 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "市民へ向けて、洋上風力発電に対する理解醸成について、今後、山形県とともに説明会など開催していきたい"@ja.
<< kg:id_158 prop:contermeasure kg:id_169 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "これから少しずつ勉強してまいりたい"@ja.
<< kg:id_170 prop:effect kg:id_171 >>
    prop:text-txt_contents "基地港湾の整備という大規模な公共事業への地元建設企業の参入"@ja.
<< kg:id_170 prop:effect kg:id_172 >>
    prop:text-txt_contents "工事期間中や、その後の風車建設時など、本地域へ多くの方がいらっしゃることによる経済波及効果"@ja.
<< kg:id_170 prop:effect kg:id_173 >>
    prop:text-txt_contents "洋上風力の運営、そして、メンテナンスを行う新たな産業の形成"@ja.
<< kg:id_170 prop:effect kg:id_174 >>
    prop:text-txt_contents "それに伴った雇用を我々としては期待"@ja.
<< kg:id_170 prop:contermeasure kg:id_175 >>
    prop:text-txt_contents "山形県が港湾計画の変更手続を進めております"@ja.
<< kg:id_170 prop:contermeasure kg:id_176 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "適時適切に国会議員への要望活動を展開するなど、働きかけはさせていただいております。先週も国土交通大臣への要望活動実施"@ja.
}
