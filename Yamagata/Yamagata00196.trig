kg:st_1 rdfs:label "遠田敏子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "周囲の理解と適切なサポートで困難を軽減できるとする"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "周囲のサポートがないと学習面で不利益が生じると懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "周囲のサポートや理解がない場合に学習についていけなくなると懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "理解不足により学校生活への適応が難しくなると懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "特別扱いがからかいにつながることを懸念する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "理解不足がいじめにつながらない環境づくりを求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "周囲の理解が重要だとする"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "適切なサポートで困難を軽減できるとする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤元教育次長"@ja.
kg:st_2 rdf:type cls:st_51.
cls:st_51 rdfs:label "教育関係者"@ja.
kg:op_9 prop:content "就学前後の早期発見と支援につなげる取組として実施している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "読み書きのつまずきを確認するため活用している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "教職員の理解を深め誰一人取り残さない学校教育を目指す"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "ＩＣＴ活用により授業中の支援を進めている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "授業中の端末操作を支援している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "専任教員が特性や困り感に寄り添い継続指導している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:st_3 rdfs:label "高橋紀幸健康福祉部長"@ja.
kg:st_3 rdf:type cls:st_120.
cls:st_120 rdfs:label "福祉関係者"@ja.
kg:op_15 prop:content "本人参加を増やす内容や環境整備が必要とする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "新規の方でも気軽に参加できる環境整備が必要とする"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "本人の希望も取り入れて進めたいとする"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "参加しやすい内容や環境整備を進める必要がある"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "本人の希望を反映した運営にしたいとする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "早期発見と保護のため見守り体制の現状を確認したいとする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "情報共有で早期発見保護できるようにしている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "市民に広く周知し見守り体制を構築したいとする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "安心して自宅で暮らせるよう連携を進める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "若年性認知症には特有の課題が多いと認識する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "特有の課題として支援策検討が必要とする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "当事者と家族の意見も聞きながら支援策を検討する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "予防可能ながんであるにもかかわらず多くの罹患者がいると問題視する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "女性の命を守るため予防と周知が重要とする"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "知らないまま苦しむ人を減らしたいと訴える"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "勧奨差し控えの影響を受けた世代への対応が必要とする"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:st_4 rdfs:label "松田俊一健康福祉部地域医療調整監"@ja.
kg:st_4 rdf:type cls:st_121.
cls:st_121 rdfs:label "医療関係者"@ja.
kg:op_31 prop:content "接種機会を逃した方への公平な機会確保としてキャッチアップ接種を行う"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "接種時期を明確に伝えることが重要とする"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "期限と自己負担化をしっかり伝える必要がある"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "令和６年度も個別通知を行い接種勧奨を実施する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "年度内完了のため接種時期を明確に伝える"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "少しでも多くの接種につながるよう周知を強化する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "最終年度であることをしっかり伝えたいとする"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "既存のノウハウを生かし検討したいとする"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "関係課と相談し実施する方向で調整したいとする"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:st_5 rdfs:label "矢口明子市長"@ja.
kg:st_5 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_40 prop:content "現時点で正確な譲与税額は不明とする"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "山林所有者の興味関心を向けるきっかけづくりとして実施する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "森林データのデジタル化高精度化を進める"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "間伐や下刈りなどへの支援を行う"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:op_44 prop:content "担い手育成確保を図る"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
kg:op_45 prop:content "地域産材の活用を進めている"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_5.
kg:op_46 prop:content "取組を断念する農業者がいることを課題とする"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_5.
kg:op_47 prop:content "制度内容だけでなく手続も丁寧に説明したいとする"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "堆肥活用戦略のための研修を実施している"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_5.
kg:op_49 prop:content "制度の有用性と手続を丁寧に説明したいとする"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_5.
kg:op_50 prop:content "観光振興に貢献できる余地があるとする"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_5.
kg:op_51 prop:content "地域でブランド化できれば農業所得向上に貢献するとする"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_5.
kg:op_52 prop:content "渡り鳥の休み場所や多様な生物の生息環境になるとする"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_5.
kg:op_53 prop:content "益虫の生息環境を提供し害虫抑制効果があるとする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:op_54 prop:content "若者から直接意見を聞く場を新たに設けたいとする"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_5.
kg:op_55 prop:content "直接若者から意見を聞く場として実施したいとする"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_5.
kg:op_56 prop:content "多忙な若者層が参加しやすい方法を取る"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_5.
kg:op_57 prop:content "若者の意見把握手法を多様化したいとする"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_5.
kg:op_58 prop:content "若い世代の主体的チャレンジが求められているとする"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:op_59 prop:content "若者のチャレンジを資金面で支える仕組みを目指す"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_5.
kg:op_60 prop:content "市民や市内企業の寄附を原資に地域課題解決の取組を助成する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_5.
kg:st_6 rdfs:label "鈴木和仁教育長"@ja.
kg:st_6 rdf:type cls:st_51.
kg:op_61 prop:content "利用者の利便性と図書館機能の両立が必要とする"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_6.
kg:op_62 prop:content "運営スキルを磨き円滑運営を図る必要がある"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_6.
kg:op_63 prop:content "事前打合せや調整が重要とする"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_6.
kg:op_64 prop:content "利用者の利便性を図りながら運営していく"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_6.
kg:op_65 prop:content "円滑な運営と図書館機能の両立を図る"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_6.
kg:st_7 rdfs:label "冨樫覚議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_66 prop:content "ＡＥＤの絶対数不足も要因ではないかと問題提起する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_7.
kg:op_67 prop:content "24時間誰でも使える体制が望ましいとする"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_7.
kg:op_68 prop:content "設置場所の周知不足が課題とする"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_7.
kg:op_69 prop:content "安全に使用するため事前受講が望ましいとする"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_4.
kg:op_70 prop:content "市民の認知度向上に取り組んでいるとする"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_4.
kg:op_71 prop:content "現時点では考えていないが専門家意見と他市町村状況を踏まえ対応を考える"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_4.
kg:op_72 prop:content "管理方法や周知など課題を踏まえ具体的対応を検討する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_4.
kg:op_73 prop:content "日中通所系サービス不足を課題と認識する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_3.
kg:op_74 prop:content "対応可能な人材育成と事業所確保が必要とする"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_3.
kg:op_75 prop:content "入所系サービスにも不足があると認識する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_3.
kg:op_76 prop:content "在宅介護に依存せざるを得ない事例があると認識する"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_3.
kg:op_77 prop:content "医療的ケアに対応できる人材育成を図る"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_3.
kg:op_78 prop:content "地域内事業所と連携して受入体制を確保する必要がある"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_3.
kg:op_79 prop:content "県への働きかけを行いたいとする"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_3.
kg:op_80 prop:content "使いづらさがあることは認識している"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_3.
kg:op_81 prop:content "病院と改善できないか協議相談したいとする"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_3.
kg:op_82 prop:content "使いづらさの改善を病院と協議したいとする"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_3.
kg:st_8 rdfs:label "伊藤欣哉議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_83 prop:content "ここ数年来でも相当厳しい状況と認識する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_8.
kg:op_84 prop:content "集荷販売数量の減少が経営に大きく響いているとみる"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_8.
kg:op_85 prop:content "副業部門としての収入も厳しい状況とする"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_8.
kg:op_86 prop:content "経営環境は悪化のスパイラルに陥っているとする"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_8.
kg:op_87 prop:content "比較的若い世代の離農も見えてきていると危機感を示す"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_8.
kg:st_9 rdfs:label "久保賢太郎農林水産部長"@ja.
kg:st_9 rdf:type cls:st_122.
cls:st_122 rdfs:label "農業関係者"@ja.
kg:op_88 prop:content "高温に負けない稲づくりとして継続支援が重要とする"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_9.
kg:op_89 prop:content "高温に負けない稲づくりを周知し取り組みを促す"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_9.
kg:op_90 prop:content "高温対策と肥料高騰対策を兼ねる取組として進めたい"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_9.
kg:op_91 prop:content "農業者共同のＢＣＰ策定と実施を支援したい"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_9.
kg:op_92 prop:content "農作物被害の未然防止の可能性を検討したい"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_9.
kg:st_10 rdfs:label "村上祐美市民部長"@ja.
kg:st_10 rdf:type cls:st_93.
cls:st_93 rdfs:label "行政担当者"@ja.
kg:op_93 prop:content "里山管理不足が生息域拡大の理由の一つとする"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_10.
kg:op_94 prop:content "里山の適正な管理が最も重要な対策とする"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_10.
kg:op_95 prop:content "春から夏に食害被害が発生している"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_10.
kg:op_96 prop:content "秋に食害被害が多発している"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_10.
kg:op_97 prop:content "農業被害も発生している"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_10.
kg:op_98 prop:content "建物被害も発生している"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_10.
kg:op_99 prop:content "目撃情報に基づきまず注意喚起を行う"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_10.
kg:op_100 prop:content "出没現場を調査し対応する"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_10.
kg:op_101 prop:content "基本対応は追い払いとする"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_10.
kg:op_102 prop:content "危害のおそれがある場合に限り捕獲する"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_10.
kg:op_103 prop:content "労力軽減と安全対策として導入し効果が出ている"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_10.
kg:op_104 prop:content "アーバンベア発生防止の基本的対策とする"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_10.
kg:op_105 prop:content "市街地侵入を防ぐ対策として進める"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_10.
kg:op_106 prop:content "積極的に取り組みたいとする"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_10.
kg:op_107 prop:content "国の動きを注視し酒田市沖導入を見据えた議論を進めたいとする"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_5.
kg:op_108 prop:content "県や国に基地港湾誘致の取組を行ってきた"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_5.
kg:op_109 prop:content "地域の理解醸成と意見の取りまとめで連携していく"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_5.
kg:op_110 prop:content "市民の理解醸成を図りつつ議論を進める"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_5.
kg:op_111 prop:content "酒田港の広大な用地は新産業形成にも有利とする"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_5.
kg:op_112 prop:content "優良なホテル案件があれば連携や支援を行いたい"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_5.
kg:op_113 prop:content "市の魅力を高め地方創生に資する案件を支援したい"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_5.
kg:op_114 prop:content "再エネ地域利用の仕組みが企業誘致につながる可能性があるとする"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_5.
kg:op_115 prop:content "優先順位を決めて洋式化を検討したい"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_5.
kg:op_116 prop:content "優先順位を決めながら整備を検討する"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_5.
kg:op_117 prop:content "老朽化状況や利用状況を踏まえ在り方を検討する"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_5.
kg:op_118 prop:content "今後検討を進める必要があるとする"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_5.
kg:op_119 prop:content "高齢者が前向きに生活するため大切な体制とする"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_5.
kg:op_120 prop:content "公共交通の利用に慣れてもらう取組として実施した"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_5.
kg:op_121 prop:content "あらゆる機会を捉えて利用促進を図る"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_5.
kg:st_11 rdfs:label "中村慶輔企画部長"@ja.
kg:st_11 rdf:type cls:st_93.
kg:op_122 prop:content "政策決定過程と説明責任を明確にするための仕組みとする"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_11.
kg:op_123 prop:content "政策立案の基本は地域や市民の意見に立脚することとする"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_11.
kg:op_124 prop:content "一定程度時間をかけて説明を尽くすべきとする"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_11.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "全体的な発達には何ら遅れはないのに、文字の読み書きに限定して困難があり、そのことにより学業不振が現れる"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "文字の読み書きに限定して困難があり、そのことにより学業不振が現れる"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "周囲のサポートや理解がない場合は、学校での勉強についていけなかったり"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "学校生活にうまく適応できなかったりすることもあるのではないでしょうか"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、このことがきっかけとなり、からかわれてしまったり"@ja.
<< kg:id_3 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "いじめの原因につながるのではないかとも懸念されます"@ja.
<< kg:id_3 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "このディスレクシアは、周りの人が理解し"@ja.
<< kg:id_3 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "適切なサポートをすることで、困難さを軽減することができる"@ja.
<< kg:id_3 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "毎年７月に行っております就学児の保護者を対象とした就学相談会であります。この相談会では、お子さんが読むこと、あるいは、書くことについて気になることなどを保護者から直接教育委員会がお話を伺い"@ja.
<< kg:id_3 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "ＬＤＩ－Ｒ（エルディーアイアール）という読み書きの困り感を測るチェックシートの活用です"@ja.
<< kg:id_3 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "市内の学校では、これまで特別支援教育に関する様々な研修を重ねてきたことで、ディスレクシアに対する教職員の理解もある程度深まってきている"@ja.
<< kg:id_3 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "ＧＩＧＡスクール端末などのＩＣＴを活用した支援があり"@ja.
<< kg:id_3 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "授業中ですと、教育支援員がこの端末の操作を補助しているケース"@ja.
<< kg:id_3 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "宮野浦小学校に通級指導教室を設置しておりまして、他校からも児童を受け入れ、ディスレクシアと思われる児童への支援も行っております"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "課題としては、認知症本人の参加が少ないこと"@ja.
<< kg:id_17 prop:cause kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "参加する方が固定している傾向にあること"@ja.
<< kg:id_17 prop:cause kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "認知症の人同士が本音を語り合う場や機会がないことも課題となっている"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "新規の方でも気軽に参加できる内容や環境の整備が必要と考えております"@ja.
<< kg:id_21 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "今後は、本人の希望も取り入れながら進めていきたい"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "認知症により、行方不明になるおそれのある方"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "平成27年度より徘徊高齢者事前登録、安心おかえり登録を行っています"@ja.
<< kg:id_26 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "令和３年６月より、徘徊高齢者等見守りシールを活用し、広域的な見守り体制の構築につながるように取り組んでおります"@ja.
<< kg:id_26 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "地域の関係機関と連携しながら、認知症高齢者等が安心して自宅で暮らせるように見守り体制を構築していきたい"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "若年性認知症への対応につきましては、就労の継続"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "経済的な問題など、特有の課題が多くある"@ja.
<< kg:id_30 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "認知症施策推進計画におきまして、認知症の方とその家族の意見も伺いながら、支援策について検討してまいりたい"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "年間で１万2,000人が罹患し"@ja.
<< kg:id_34 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "約3,500人が亡くなっているという現状"@ja.
<< kg:id_34 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "後に子宮摘出を受け、子どもを望んでも産めない体になってしまう"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "約９年間もの間、勧奨差し控えの影響を受けた対象者"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "同年６月から、全国的に接種を受けた方から副反応等の報告が相次いだため、国の方針に基づき、積極的接種勧奨が差し控えられておりました"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "１回目から３回目までの接種間隔を確保した上で、年度内に３回接種を完了するためには、６か月を要する"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "令和７年４月以降に接種される場合は全額自己負担になる"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "令和６年度につきましても、４月初旬に対象となる方へ個別通知を送付させていただきます"@ja.
<< kg:id_45 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "９月までには１回目の接種を終える必要がある"@ja.
<< kg:id_45 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "ＳＮＳや市ホームページなどを活用しまして、周知を強化してまいりたい"@ja.
<< kg:id_45 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "酒田市二十歳を祝う成人の集いの際には、リーフレットや案内、あるいは、議員からもございましたティッシュペーパーなど配布させていただいて"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "健康課のほうでは、乳がん月間にピンクリボンツリーを設置させていただいておりますので、そういったノウハウもございますので、検討させていただきたい"@ja.
<< kg:id_50 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "ライトアップにつきましても、関係課と相談させていただきまして、なるだけ実施するような方向で調整してまいりたい"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "森林面積割が50％から55％に引き上げられ、人口割が30％から25％に引き下げる方向"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "酒田市独自の意識調査アンケート事業を実施しております"@ja.
<< kg:id_55 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "航空レーザ測量・解析事業を実施しております"@ja.
<< kg:id_55 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "ほかの国庫補助事業の基準に満たない間伐や下刈り事業への支援"@ja.
<< kg:id_55 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "林業就業者への支援事業を展開している"@ja.
<< kg:id_55 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "みなと保育園の建築に地域産材を多く使用いたしました"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "中には高齢化により離農されるなどの理由により、取組を断念された方もいらっしゃいます"@ja.
<< kg:id_61 prop:cause kg:id_63 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "新たに取り組む上では、交付に係る手続が煩雑であることが課題"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "これからの堆肥活用戦略のために、と題した土づくり研修会を市内７か所で行った"@ja.
<< kg:id_64 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "市ホームページや農協などを介して、環境保全型農業直接支払交付金の周知を行ってまいりました"@ja.
<< kg:id_64 prop:effect kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "農業生産活動により形づくられた水田等の農地や周辺の集落などは、歴史的・文化的な背景を基に形成された農村景観として、観光資源となり得る"@ja.
<< kg:id_64 prop:effect kg:id_68 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "環境に配慮した農産物は、今後付加価値が上がっていくものと考えております"@ja.
<< kg:id_69 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "冬期間に水田に水を張っておく、冬期湛水"@ja.
<< kg:id_69 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "水田周囲の畦畔の雑草を５センチメートル程度の高さを残して草刈りを行う、高刈り"@ja.
<< kg:id_72 prop:cause kg:id_73 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "若者の意見を聞く場がないため、広く若者の意見を聞く場を設け"@ja.
<< kg:id_72 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "私自身が直接若者から意見を聞く場として、仮称ではありますけれども、若者カフェミーティングを実施していきたい"@ja.
<< kg:id_72 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "オンラインでの開催、また、開催日、時間帯も参加しやすい日時となるような配慮"@ja.
<< kg:id_72 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "ウェブアンケートやデジタル技術を活用した手法などでも若者の意見を把握していきたい"@ja.
<< kg:id_77 prop:cause kg:id_78 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "生産年齢人口の急激な減少に伴う担い手不足などに起因する多様で新たな地域課題"@ja.
<< kg:id_77 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "そのチャレンジを資金面で支える仕組みとして、市民の市民による市民のためのコミュニティファンドの創設を目指す"@ja.
<< kg:id_80 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "一般財団法人を設立し、その事業運営の原資として、市民や市内企業から寄附を集め、市民による地域課題の解決や地域活性化に資する取組を募り"@ja.
<< kg:id_82 prop:cause kg:id_83 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "主催事業と共催・貸館との兼ね合い"@ja.
<< kg:id_82 prop:cause kg:id_84 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "施設規模とイベント集客数の見込みのミスマッチ"@ja.
<< kg:id_82 prop:cause kg:id_85 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "来館していただいた方々への誘導など運営面での混乱なども見られるようになってきております"@ja.
<< kg:id_86 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "今後、開催イベントのスケジュール調整やイベント主催者との事前の打合せなど"@ja.
<< kg:id_86 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "イベント主催者との事前の打合せなど、利用者の利便性を図りながらも、図書館としての機能も損なうことなく、円滑に運営していく"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "ＡＥＤが近くになかったことも大きな要因である"@ja.
<< kg:id_89 prop:cause kg:id_91 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "ＡＥＤはすぐ近くにあったが、休日や夜間のため現場に持ち出せなかった"@ja.
<< kg:id_89 prop:cause kg:id_92 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "現場に居合わせた人が、ＡＥＤの設置場所を知らないケースが多かった"@ja.
<< kg:id_93 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "実際、安全にＡＥＤを使用しました応急手当を行うためには、事前に応急手当講習会を受講いただくことが望ましい"@ja.
<< kg:id_93 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "ＡＥＤによる応急手当の方法をＹｏｕＴｕｂｅで紹介するなど"@ja.
<< kg:id_93 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "現時点におきまして、本市が市内のコンビニエンスストアなど、24時間営業されている店舗にＡＥＤを設置することは考えておりませんが"@ja.
<< kg:id_93 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "本市が公共施設に設置しておりますＡＥＤを24時間、誰でも使えるようにすれば、救命率の向上につながるものと考えております"@ja.
<< kg:id_98 prop:cause kg:id_99 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "医療的ケア児の成人移行後に受け入れられる施設につきましては、日中の通所系サービスは不足している状況にあります"@ja.
<< kg:id_98 prop:cause kg:id_100 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "医療的ケアに対応可能な職員がいないという理由で受入れを断られ"@ja.
<< kg:id_98 prop:cause kg:id_101 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "施設の定員の関係から、希望してもすぐに入所できないこともあり"@ja.
<< kg:id_98 prop:effect kg:id_102 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "やむなく在宅で家族が介護している事例もございます"@ja.
<< kg:id_103 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "研修等を通して医療的ケアが必要な方に対応できる人材の育成を図り"@ja.
<< kg:id_103 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "受入可能な事業所を確保していくことが必要"@ja.
<< kg:id_103 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "庄内地域における入院療養病床の確保に向け、山形県に働きかけを行っていきたい"@ja.
<< kg:id_107 prop:cause kg:id_108 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "平日５日以内で原則延長はできず"@ja.
<< kg:id_107 prop:cause kg:id_109 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "一度利用した場合、３か月後でないと再利用できない"@ja.
<< kg:id_107 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "病院とも、今後、改善できないかというのは、協議、相談させていただければ"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "品質低下によって600円の下落"@ja.
<< kg:id_111 prop:cause kg:id_113 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "ＪＡ庄内みどりが53万俵、前年比で93％、ＪＡそでうらが１万7,500俵、前年比95％"@ja.
<< kg:id_111 prop:cause kg:id_114 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "長ネギが前年比数量で67％、ミニトマトが前年比数量73％、アスパラが前年比数量85％、里芋が前年比数量86％"@ja.
<< kg:id_111 prop:cause kg:id_115 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "引き続き、肥料、飼料、燃油高騰が続いており、経営環境は悪化のスパイラルに陥っております"@ja.
<< kg:id_111 prop:effect kg:id_116 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "離農へと拍車をかけている実態が見られます"@ja.
<< kg:id_117 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "酒田型土づくり特別対策事業として、土壌環境を改善するための土づくり資材の施用に対する支援"@ja.
<< kg:id_117 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "土づくり研修会でも、高温に負けない稲づくりをキャッチフレーズにして周知し"@ja.
<< kg:id_117 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "リン酸肥料やカリウム肥料の代替として堆肥を有効に活用していくという取組"@ja.
<< kg:id_117 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "国の園芸産地事業継続強化対策事業の活用によりまして、農業者共同で事業継続計画（ＢＣＰ）の策定やその実施を支援する"@ja.
<< kg:id_117 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "光や熱を反射したりするような資材をハウスなどに追加することで、農作物被害を未然に防ぐという取組"@ja.
<< kg:id_122 prop:cause kg:id_123 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "里山地域の過疎化が、近年進行しております"@ja.
<< kg:id_122 prop:cause kg:id_124 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "下草刈りや不用果実の摘果等の十分な管理が行き届かなくなり、熊の生息域が拡大した"@ja.
<< kg:id_125 prop:effect kg:id_126 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "春から夏にかけては、タケノコや養蜂箱に対する食害が９件"@ja.
<< kg:id_125 prop:effect kg:id_127 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "秋は、柿や栗に対する食害が32件発生"@ja.
<< kg:id_125 prop:effect kg:id_128 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "飼料作物への食害"@ja.
<< kg:id_125 prop:effect kg:id_129 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "施設、建物が一部損壊する被害も23件発生"@ja.
<< kg:id_130 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "目撃情報に基づき、まずは住民への注意喚起を行い"@ja.
<< kg:id_130 prop:countermeasure kg:id_132 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "市職員及び市鳥獣被害対策実施隊が出没現場の調査を実施"@ja.
<< kg:id_130 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "まずは爆竹等を用いた熊の追い払いの対応が基本"@ja.
<< kg:id_130 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "それでもなお熊の出没が反復し、現に人畜等に危害を加えるおそれがあると判断された場合に限って、捕獲を行う"@ja.
<< kg:id_130 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "令和５年９月から箱わなセンサーを２台導入"@ja.
<< kg:id_136 prop:countermeasure kg:id_137 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "熊を引き寄せる誘因物の除去"@ja.
<< kg:id_136 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "電気柵等の設置による侵入防止策"@ja.
<< kg:id_136 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "市広報や市ホームページ等による情報発信についても積極的に取り組んでまいりたい"@ja.
<< kg:id_140 prop:cause kg:id_141 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "再生可能エネルギーの主力電源化を徹底し、再生可能エネルギーに最優先の原則で取り組み"@ja.
<< kg:id_140 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "酒田港を基地港湾とする機能強化が図られるよう、これまで山形県及び国に対して、基地港湾を誘致する取組"@ja.
<< kg:id_140 prop:countermeasure kg:id_143 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "引き続き、地域の理解醸成と意見の取りまとめが図られるよう山形県と連携していきたい"@ja.
<< kg:id_140 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "地域住民向けの説明会を含め、洋上風力発電事業の導入に向けた議論がこれから始まります。市民の理解醸成を図りつつ"@ja.
<< kg:id_140 prop:effect kg:id_145 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "洋上風力発電事業の導入を契機とした新たな産業形成等も期待されております"@ja.
<< kg:id_140 prop:effect kg:id_146 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "洋上風車等の建設が進む地域で、急激な交流人口の増加により、宿泊施設が不足する事例がある"@ja.
<< kg:id_140 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "ホテル建設が市の魅力を高め、持続可能な経営が行われ地方創生に資するような優良な案件があれば、連携や支援を行っていきたい"@ja.
<< kg:id_140 prop:countermeasure kg:id_148 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "本地域で発電される再生可能エネルギーを地域で利用する仕組みを検討することにより、再生可能エネルギー利用を目的とした優良な企業の誘致につながる例がある"@ja.
<< kg:id_149 prop:cause kg:id_150 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "和式トイレしかない施設は９施設となっております"@ja.
<< kg:id_151 prop:countermeasure kg:id_152 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "この９施設の洋式トイレの整備につきまして、優先順位を決めながら検討していきたい"@ja.
<< kg:id_153 prop:cause kg:id_154 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "全体として老朽化が進んでおります"@ja.
<< kg:id_153 prop:countermeasure kg:id_155 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "利用料金の見直しや施設の在り方について検討を進める必要がある"@ja.
<< kg:id_156 prop:effect kg:id_157 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "高齢者がマイカーを運転できなくなったとしても、自分で買物や通院などで外出することができる体制を整えることは、高齢者が明るく前向きな気持ちで生活するためにも大切"@ja.
<< kg:id_156 prop:countermeasure kg:id_158 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "るんるんバス体験ツアーを２回実施いたしました"@ja.
<< kg:id_156 prop:countermeasure kg:id_159 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "引き続き、あらゆる機会を捉えて、公共交通の利用につながる活動を展開してまいります"@ja.
<< kg:id_160 prop:countermeasure kg:id_161 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "政策決定の過程及び説明責任を明確にするとともに、庁内における共通認識を形成することを目的"@ja.
<< kg:id_160 prop:countermeasure kg:id_162 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "政策の立案につきましては、地域や市民の意見を聴取、それに立脚することが基本"@ja.
<< kg:id_160 prop:countermeasure kg:id_163 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "市の政策として決定した後には、速やかに地域や市民からの意見を聴取するために一定程度時間をかけてその政策についての説明を尽くしてまいります"@ja.
}
