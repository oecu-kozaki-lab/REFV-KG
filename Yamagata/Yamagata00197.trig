kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "安川智之副市長"@ja.
kg:st_2 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_2 prop:content "被保険者に対してお返しをする意味で引下げを実施した"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "引下げの結果として収納状況が改善されたのではないかとみる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "基金繰入れを要するため令和6年度は据置き方向で考える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "基金残高と条例で定める基金額を踏まえ据置き方向とする"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "松田俊一健康福祉部地域医療調整監"@ja.
kg:st_3 rdf:type cls:st_2.
kg:op_6 prop:content "全ての加入者がひとしく保険給付を受けるため負担を求めるものと認識する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "国の制度として実施している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "本市独自の18歳までの均等割減免は現時点で考えていない"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "全国市長会を通じて引き続き国に要望する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "市民と行政の協働の力を高める必要がある"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "多様な声を広く聞き信頼関係を築く必要がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "市民と行政の信頼関係を築き課題を共有し優先順位を話し合う"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "市民の声を吸い上げ政策に反映する手法を積極的に活用する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "話したい若者と市長が直接意見交換し政策に反映したい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "意見を把握し市民に共有するプロセスを踏みたい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:st_4 rdfs:label "矢口明子市長"@ja.
kg:st_4 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_16 prop:content "コミ振に若い人の意見を聞いて届けてほしいと伝えていく"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "まずは若者カフェミーティングで始めてみたい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:st_5 rdfs:label "村上祐美市民部長"@ja.
kg:st_5 rdf:type cls:st_2.
kg:op_18 prop:content "現状ではリサイクルが困難な搬入物と一緒に焼却または埋立処分している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_5.
kg:op_19 prop:content "現状では再資源化に至っていない"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_5.
kg:op_20 prop:content "別の製品としての再資源化は可能と認識する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:op_21 prop:content "課題を踏まえつつ全国事例を研究し広域行政組合と連携して見極める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "全国的な取組事例を研究し実施可能性を見極めたい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "食品ロス削減は必要性が高い"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "本市も真摯に取り組むべき課題と認識する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "家庭系ごみ事業系ごみとも具体的数字を把握していない"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:op_26 prop:content "食品ロス削減月間や年末年始に啓発を推進している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "大学や高校生と協働し市民啓発に努めている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "食品ロス削減推進計画の趣旨を既存計画に位置づけ推進したい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "縦割りにならない課題志向アウトカム志向の体制を築きたい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "脱炭素の取組の一部として扱うことが考えられる"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:st_6 rdfs:label "鈴木和仁教育長"@ja.
kg:st_6 rdf:type cls:st_72.
cls:st_72 rdfs:label "教育機関"@ja.
kg:op_31 prop:content "既存の取組を三つの柱で充実させるものと認識する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_6.
kg:op_32 prop:content "校内教育支援センターやふれあい教室の機能強化が含まれる"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:op_33 prop:content "教師だけでなく養護教諭やスクールカウンセラーやスクールソーシャルワーカーの連携が重要"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "学校評価やアンケートを共有し授業改善につなげる"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "市内全小中学校で各自のペースで学習できるよう対応している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "県費配置が少なく各学校で空き時間等を使い対応している"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:st_7 rdfs:label "佐藤元教育次長"@ja.
kg:st_7 rdf:type cls:st_72.
kg:op_37 prop:content "支援を行う人員確保が最大の課題であり具体策を検討したい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_7.
kg:op_38 prop:content "大学を存続させるため公立化を急ぐべきと考える"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "県と2市3町で危機感を共有している"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "県高等教育政策・学事文書課を中心に着実に進んでいると認識する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "県と2市3町の合意形成が課題である"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:st_8 rdfs:label "中村慶輔企画部長"@ja.
kg:st_8 rdf:type cls:st_2.
kg:op_42 prop:content "今年度末に一定程度合意へ持っていければと考える"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_8.
kg:op_43 prop:content "今年度被害事例として把握している"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:op_44 prop:content "過去年度より大幅に多い状況である"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
kg:op_45 prop:content "令和5年度はハクビシン対策2件ツキノワグマ対策1件の実績がある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_5.
kg:op_46 prop:content "安全確保と見回り労力削減に一定の成果があった"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_5.
kg:op_47 prop:content "悪天候下でも有効活用できる設置対策が必要"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "現時点で変更は考えていない"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_5.
kg:op_49 prop:content "今後の出没状況に応じて期間設定を検討する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_5.
kg:op_50 prop:content "今後の被害動向を注視し必要性を研究したい"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_5.
kg:op_51 prop:content "寄港回数増加を観光誘客につなげたい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:op_52 prop:content "下船後に観光案内所や立て看板やマップで案内している"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:op_53 prop:content "市内観光への誘客に寄与したと考える"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:op_54 prop:content "短期間で劇的増加は簡単でないと分析する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_4.
kg:op_55 prop:content "まずは貨物量確保と便数維持が喫緊の課題"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_4.
kg:op_56 prop:content "利便性を少しでも高めることが重要"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:op_57 prop:content "酒田港活用とカーボンニュートラル実現の観点から取り組む"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_4.
kg:op_58 prop:content "県外港に流出していた貨物を酒田港に取り込みたい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_4.
kg:op_59 prop:content "国際物流総合展への出展が商談につながった"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_4.
kg:op_60 prop:content "市民に分かりやすいメリットをもたらすことが重要"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_4.
kg:op_61 prop:content "ＲＥ100産業団地整備による企業誘致も考えられる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_4.
kg:op_62 prop:content "平常時に電気自動車等へ蓄電し災害時活用する方法は考えられる"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:op_63 prop:content "より長期的な視点で県と連携し方向性を検討する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_4.
kg:st_9 rdfs:label "丸藤幸夫上下水道部長"@ja.
kg:st_9 rdf:type cls:st_2.
kg:op_64 prop:content "今後も減少傾向が続くと捉えている"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_9.
kg:op_65 prop:content "広域化で経営基盤強化につなげたい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_9.
kg:op_66 prop:content "安全性安定供給確保と経営基盤強化につなげたい"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_9.
kg:op_67 prop:content "施設見学や出前講座や広報で周知していく"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_9.
kg:op_68 prop:content "引き続き様々な方法で周知活動を進めたい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_9.
kg:op_69 prop:content "意識改革と社会制度改革が重要と考える"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_4.
kg:op_70 prop:content "社会情勢や国県の動向や市民意見を踏まえて見直す"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_4.
kg:op_71 prop:content "後期計画でもその解消のための取組を強化する必要がある"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_4.
kg:op_72 prop:content "決して楽観視できない状況であり後期計画に位置づける"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_4.
kg:op_73 prop:content "若い年代への学びの機会と相談窓口周知が必要"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_4.
kg:op_74 prop:content "若い年代が相談しやすい窓口を積極的に周知する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_4.
kg:op_75 prop:content "多様な人を包摂する考え方として運用したい"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_4.
kg:op_76 prop:content "偏見や差別がなくなるよう理解促進に取り組むことが重要"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_4.
kg:op_77 prop:content "当事者の相談には丁寧に対応する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_4.
kg:op_78 prop:content "対象を絞ったウェブアンケートは手法と効果の検証が必要"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_4.
kg:op_79 prop:content "周知が必要と考える"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_4.
kg:op_80 prop:content "まずは周知に努めた後に条例制定を検討する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_4.
kg:op_81 prop:content "障害者団体の意見も伺い県へ要望を検討する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_4.
kg:op_82 prop:content "各障害者団体等の意見も伺いながら進めたい"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_4.
kg:op_83 prop:content "他自治体の取組を研究したい"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_4.
kg:st_10 rdfs:label "中村良一建設部長"@ja.
kg:st_10 rdf:type cls:st_2.
kg:op_84 prop:content "得られるデータは十分でないが継続して取得分析する"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_10.
kg:op_85 prop:content "内水氾濫箇所と排水路水位の相関が確認できた"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_10.
kg:op_86 prop:content "9月6日のデータを基に対策検討を始めた"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_10.
kg:op_87 prop:content "関係課と協議し市民配信の準備を進めている"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_10.
kg:op_88 prop:content "知名度向上と観光誘客につなげたい"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_2.
kg:op_89 prop:content "ラーメンＥＸＰＯや首都圏食イベントを活用したい"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_2.
kg:op_90 prop:content "情報が古くなっているため更新ししっかりＰＲしたい"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
kg:op_91 prop:content "出番が少なくならないよう取り組みたい"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_2.
kg:op_92 prop:content "各店で利用できる特典も付け観光客から好評を得ている"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "ウェブ上でも努力してＰＲしたい"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
kg:op_94 prop:content "車両や運転手の制約で新規周遊バスは難しいが情報提供を進める"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_2.
kg:op_95 prop:content "行政が協力できる分野はしっかり対応したい"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_2.
kg:op_96 prop:content "市民に楽しんでもらい観光客を呼び寄せる1週間にしたい"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今、市民は、物価高騰等の影響で生活が苦しくなっています。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "これは、国民健康保険財政調整基金の残高が、条例で定められている額約10億円を一定程度上回っていたことから、これまで税を納付いただいた被保険者に対してお返しをするという意味で実施をしているものでございます。"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "その結果として、収納状況が改善されたのではないでしょうか。例えば、令和４年度の現年度の収納率は96.67％と、前年度比較で0.56％上昇し、滞納繰越分も含めた収納率は85.14％と、これも前年度比較で0.84％上昇しました。"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "４年連続で税率の引下げを行いました結果、基金繰入金を除いた各年度の収支が、実は令和３年度から赤字に転じておりまして、令和３年度は4,500万円の赤字、令和４年度は約３億1,000万円、今年度も赤字ございますので、基金からの繰入れを４億2,000万円程度行う予定で、現在試算をしております。"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "その結果、令和５年度末の基金残高は17億1,000万円を見込んでおり、条例で定める基金残高約10億円を踏まえて、現時点では、令和６年度の税率は据置きの方向で考えております。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "まず、国民健康保険税均等割は、医療費が世帯加入者に比例して増加する傾向であることから、年齢問わず、加入者全てに賦課をしているものでございます。"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "18歳未満の被保険者のうち、未就学児については、令和４年度から、その均等割を国による制度として、所得に応じて軽減する制度を適用させて、５割を減じております。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "その財源の確保や軽減対象者がその他の国民健康保険加入者の中から見ると、限定的であることから、一定程度の不公平感が生まれることにつながると考えているため、現時点では、本市独自に18歳までの被保険者の均等割を減免することは考えていないところであります。"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "18歳までの被保険者に係る国民健康保険税均等割を軽減する制度は、国によって拡充されるべきであると考えておりますので、全国市長会を通じて、引き続き、国に要望していきたいと考えております。"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "急激な人口減少により、担い手不足など様々な分野で生じている課題"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "ライフスタイルや価値観の多様化が進展していく中、豊かに安心して暮らせる酒田を実現するためには、協力して働く協働の力を高めていかなければならない"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "これまで以上に、市長をはじめ市役所職員全てが、市民に対して開かれた形で、多様な声、市行政にとって耳が痛いような情報も含めて、広く聞いていくという姿勢をこれまで以上に強めて、市民と行政との互いの信頼関係を築きながら、まちの課題をしっかり共有して、何を優先的に解決すべきかと優先順位もしっかり話し合いながら、課題をどう解決していくか丁寧な説明の下、しっかりと対話していく風土をつくってまいりたいと思います。"@ja.
<< kg:id_21 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "市民との対話の手法につきましては、日頃から各部署、各係にとっての対話すべき当事者、利害関係者との対話は、これまでどおり進めてまいりますし、加えまして、外部委員会や市民とのワークショップといった手法もしっかり取っていきたいと思っております。また、パブリックコメントや市民アンケートは、市の考え方をしっかり示しながら、市民の皆様の意見を聞き、それに応え、政策に反映していくという意味では、この手法も、引き続き、取っていきたいと思っております。"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "中高生から40代の方までを対象に、若者カフェミーティングといった形での実施を今年度２回考えております。具体的なテーマを設定しまして、そのテーマの当事者、提案者である話したい若者と市長が直接意見交換を行うことで、本市における課題を明確化し、市長の判断の下、市の政策にしっかり反映していければと考えております。"@ja.
<< kg:id_24 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "若者カフェミーティング以外にも、ウェブアンケートやデジタル技術を活用した手法などで意見を把握し、市民の皆様に共有をしていく、そういったプロセスを踏んでいきたいと思っております。"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "コミセン行ってもいいわけですけれども、なかなか若者に会えないんです。"@ja.
<< kg:id_24 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "まずは、若者カフェミーティングということで始めてみたいと思っているところであります。"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "ごみの収集や分別の過程で、多くのごみ袋に汚れや破損が生じるため、現状ではリサイクルが困難な搬入物と一緒に、酒田地区広域行政組合のごみ処理施設及び最終処分場にて焼却または埋立処分されている"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "現状ではリサイクルが困難な搬入物と一緒に、酒田地区広域行政組合のごみ処理施設及び最終処分場にて焼却または埋立処分されている"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "このバージン材の性質上、新たな指定ごみ袋として再生することは技術的には不可能でございますが、ペレット化などにより、別の製品として再資源化することは可能でございます。"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "県内におきまして、このような再資源化を行える技術を有する民間事業者がなく、仮に酒田地区広域行政組合の直営により実施するにしても、設備導入にかかる費用の面が懸念されます。"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "全国的な取組事例も研究しながら、酒田地区広域行政組合と連携して、指定ごみ袋を含めたプラスチックごみの削減、また再資源化に係る取組が実施できないか見極めてまいりたいと考えております。"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "この食品ロス問題は、食べ物を無駄にするだけでなく、最終的に破棄する食品の生産に使用されるエネルギーや運搬するときに大量に発生する二酸化炭素の排出、あるいは廃棄された食べ物を焼却するときに発生する二酸化炭素の排出にも大きく関わっています。"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "本市におきましても、真摯に取り組むべき課題と認識しており、第２次酒田市環境基本計画、この中では、食糧を生産するために多量のエネルギーを消費していること、また、廃棄の際にも余分な二酸化炭素を排出していることにより、食品ロスの削減に計画的に取り組むことを掲げております。"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "本市における食品ロスの現状については、詳細な実態調査は行っておらず、家庭系ごみ、事業系ごみともに具体的な数字は把握していないところでございます。"@ja.
<< kg:id_42 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "市広報やホームページでの周知のほか、外食時の食べ残しの持ち帰りを促すポスターを作成いたしました。こちらを各コミュニティ振興会へ設置するなど、10月の食品ロス削減月間や年末年始のおいしい食べ切り運動の啓発として推進しております。"@ja.
<< kg:id_42 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "東北公益文科大学食品ロス削減チームＬｉｇａとともに、本市と一緒になって公益活動団体協働提案負担金を活用して、酒田南高校食育調理コースの高校生が考案したメニューを使った食品ロス削減講習会やエコクッキング教室を実施したほか、各種イベントや本庁舎で実施するフードドライブ、また保育園、小学校への食品ロス削減の出前講座等を実施しております。"@ja.
<< kg:id_42 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "今後、改訂を予定しております酒田市環境基本計画、そして、酒田市ごみ処理基本計画に盛り込むなどの方法を検討し、食品ロス削減に対する市民や事業者の取組などを位置づけ、一体となって推進してまいりたいと考えております。"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "もう今の時代、１つの課で解決できるような問題はないと思っております。地域課題から考えれば、多くの課が協力しなければ、その課題の解決はできないと思っております。"@ja.
<< kg:id_42 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "来年度の組織改編で、ローカルＳＤＧｓ推進室を設けます。ただいまお話ありました食品ロスを減らすということは、その脱炭素の取組の一部にも捉えられますので、その室で取り組んでいくということは考えられると思っております。"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "近年の不登校児童生徒数が増加し続けていること、令和３年度の調査では、高等学校も含めますと約30万人に不登校児童生徒が上っているということ、これが過去最高であったということ...こういった状況を踏まえて、文部科学省では、令和５年３月に、誰一人取り残されない学びの保障に向けた不登校対策ということで、いわゆるＣＯＣＯＬＯプランというものを策定した"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "１つ目としては、小中高等学校を通じて、学びたいと思ったときに多様な学びにつながることができるよう、個々のニーズに応じた多様な学びの場、学びの環境を整備すること"@ja.
<< kg:id_54 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "２つ目としては、小さなＳＯＳに早期の発見、早期の対応ということで、例えば、ＧＩＧＡスクール端末を活用して、小さなＳＯＳに早期に気づくこと"@ja.
<< kg:id_54 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "３つ目としては、学校の風土を見える化して、全ての児童生徒が安心して学べる場所にすること"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "現在、市内の全ての小中学校では、いわゆる別室登校、保健室であったり相談室であったり、あるいは空き教室であったり、学校によっても、ひだまり教室と言ったり、様々な呼び方をして利用しております。そこで、各自のペースで学習できるように対応をしております。"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "この別室の充実、文部科学省で言うところの校内教育支援センターの充実を図るには、この人的な配置というのは、大きい課題になってくるものと考えております。"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "校内教育支援センターの充実のためには、議員からもありましたように、支援を行う人員の確保というのが最大の課題だと捉えております。...情報収集をこれからも続け、来年度に向けた検討を進めていきたいと考えます。"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "少子化が一層進んでいるというだけでなく、コロナ禍後に学生が都会へ向かう傾向が回復するなど、学生の確保は難しくなっており、学生が確保できない私立大学では、経営が成り立たなくなることが容易に想定されます。"@ja.
<< kg:id_64 prop:effect kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "山形県、酒田市、鶴岡市、三川町、庄内町及び遊佐町は、少子化が進行する中で、東北公益文科大学の存続そのものが危ういとの危機感を共有していることから、大学を存続させていくための手段として、公立化を急ぐべきであると考えております。"@ja.
<< kg:id_67 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "県において、大学の公立化と機能強化に関連する予算として...公立化、機能強化の検討に係る業務委託では、高校生や企業へのニーズ調査、分析を行うほか、公立化に向けた設立団体の考え方や財務シミュレーションの資料作成などを行っております。"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "法人の設立団体の在り方、財政負担の割合、法人の運営組織の在り方など公立化については、県と２市３町の合意をどのように形成していくか"@ja.
<< kg:id_67 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "年末に県と２市３町の実務担当者が集まりまして、財務シミュレーションについての説明を受ける予定としております。...年を明けて１月に、県と庄内２市３町の首長が集まる機会があるんですが、そこに、その委託調査を出している県高等教育政策・学事文書課の高等教育政策主幹からおいでいただいて、首長に直接説明するという場を設ける予定にしております。"@ja.
<< kg:id_72 prop:effect kg:id_73 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "今年度の熊やイノシシによる被害の事例としては、熊では、牛舎や作業小屋の外壁や防護柵の破損、ビニールハウス等の破損などがあり、イノシシでは、圃場内を走り回ったり、田んぼのあぜが破壊されたとの報告を受けております。"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "令和５年度については、12月15日時点で201件の目撃情報が寄せられております。"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "本市では、農地への電気柵設置に対する支援として、有害鳥獣被害対策推進事業を平成25年度より県と市の協調補助で実施しております。...令和５年度は、現時点で３件であり、その内訳は、ハクビシン対策が２件、ツキノワグマ対策が１件となっております。"@ja.
<< kg:id_78 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "箱わなセンサーの稼働実績としましては、12月15日時点で、熊の捕獲のため７回設置したうち、５回はセンサーが作動し捕獲しました...見回り時の鳥獣被害対策実施隊員の安全確保と見回りの労力削減の観点から、一定の成果が得られております"@ja.
<< kg:id_80 prop:effect kg:id_81 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "設置方法に不備があると、強風や豪雨の影響でカメラの向きが変わり、正常に捕獲された鳥獣を撮影できないといった課題も挙がっております。"@ja.
<< kg:id_82 prop:cause kg:id_83 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "長期間箱わなを設置することで、被害を及ぼした個体以外のツキノワグマを誘引してしまう可能性があり、人身被害も助長してしまうために、設置期間は原則として15日以内とし、短期間で撤去することが望ましい"@ja.
<< kg:id_84 prop:cause kg:id_85 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "本市におけるイノシシの出没状況が周辺自治体と比較して非常に少ないため、30日の捕獲期間としております。"@ja.
<< kg:id_76 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "本市における専門員の配置についてですけれども、今後の鳥獣被害の動向を注視しながら、全国でも配置しているところは増えておりますので、その必要性については今後研究をしてまいりたいと考えております。"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "令和６年度の寄港予定としては、外国クルーズ船が７回、国内クルーズ船が１回で、合計８回を予定しております。"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "どのように市街地へ行けばよいか、あるいは酒田の見どころはどこかなどの情報が船内で行き渡っていないため、下船後に観光案内所や立て看板などで案内をしております。"@ja.
<< kg:id_91 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "ふ頭において和太鼓演奏、酒田舞娘、ミスポート酒田、庄内地域のゆるキャラ、羽黒山の山伏が出迎えて歓迎ムードを盛り上げた上で、キッチンカーや庄内地域の工芸品、着物などを展示販売する物産展を行う...まちなかのシャトルバスのバス停を起点とした観光施設や飲食店の情報を記載したまち歩きマップを作成し...11月は、シャトルバスの利用者特典として、芋煮、日本酒、つや姫おにぎりの振る舞いを行った"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "主な輸出先である中国市場の情勢変化や新型コロナウイルス感染症の影響等により、令和４年には、平成29年比で約51％減の１万3,763ＴＥＵまで減少しております。"@ja.
<< kg:id_93 prop:effect kg:id_95 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "今年10月には船社が国際定期コンテナ航路の最適配船を検討する中で、酒田港は週３便から週２便に減便され、現在も貨物量の減少傾向が続いていることから、まずはいかにしてコンテナ取扱量を確保し、国際コンテナ定期航路の便数を維持するかが喫緊の課題となっております。"@ja.
<< kg:id_96 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "まずは、足元のコンテナ貨物利用促進助成制度やサービスを県と連携して充実させることにより、利便性を少しでも高めることが重要であると考えております。"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "その対応策として、陸上輸送から鉄道や船舶による輸送に切り替えていくモーダルシフトが注目されております。"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "今年度より国・県・市・酒田商工会議所が連携して、国内の貨物を海上ルートで基幹港、これは神戸港ですが、そこに集める内航フィーダー航路の酒田港への誘致に取り組んでおります。"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "平成５年に“プロスパーポートさかた”ポートセールス協議会を立ち上げ、その中のコンテナ航路部会において、官民一体となってコンテナ貨物の増加に取り組んでまいりました。...東京ビッグサイトで開催された国際物流総合展に出展し、全国に向けて酒田港のＰＲを行いました。"@ja.
<< kg:id_104 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "多様な再生可能エネルギー発電所が立地する地域としての魅力を生かした優良企業の誘致や産業集積、それから研究機関の進出、そして、市民が再生可能エネルギーを利用できる仕組みづくりなど、市民に分かりやすいメリットをもたらす地域振興策を洋上風力発電事業者に求めていくことが重要だと考えております。"@ja.
<< kg:id_106 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "洋上風力発電の電力の一部を、地域新電力会社を経由して、市内の事業者に供給することは可能だと認識しております。"@ja.
<< kg:id_108 prop:cause kg:id_109 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "台風や地震等の災害で電力系統が寸断した場合、発電した電力が流せなくなる場合も想定されます。停電時に洋上風力発電の電力を避難所等に供給することは、技術的に難しいと考えております。"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "現時点で港周辺で経済活動を行う主要企業の潜在ニーズは不透明であり、非常にリスクが大きい設備投資となることから、供給拠点の整備について具体的な議論には至っておりません。"@ja.
<< kg:id_112 prop:cause kg:id_113 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "人口減少や節水機器の普及に伴う水需要の減少は、本市において大変大きな課題であると捉えております。"@ja.
<< kg:id_112 prop:effect kg:id_114 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "有収水量の減少は、給水収益に直結することから、今後の水道事業では、老朽管の更新や施設整備への影響が懸念されます。"@ja.
<< kg:id_115 prop:countermeasure kg:id_116 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "酒田市、鶴岡市、庄内町の２市１町では、水道事業の広域化によって、将来にわたる水道の安全性、安定供給の確保、さらには、経営基盤の強化につなげていきたいと考えております。"@ja.
<< kg:id_117 prop:cause kg:id_118 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "下水道の仕組みや役割について、ふだんなかなか意識していただけない現状にあると捉えております。"@ja.
<< kg:id_119 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "上下水道部では、広く市民に認識していただくための機会として、施設見学や出前講座を行っております。...酒田市上下水道広報「みんなの水さかた」や...マンホールカード酒田市版を作成しております。"@ja.
<< kg:id_121 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "属性に捉われず、属性による色眼鏡で見ることなく、個人として尊重されるまちをつくっていくこと、そのための意識の改革、社会制度の改革、大変重要なことだと考えております。"@ja.
<< kg:id_123 prop:countermeasure kg:id_124 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "性別役割分担意識などアンコンシャス・バイアス（無意識の思い込み）の解消...相談・サポート体制の充実、性の多様性に関する理解促進といった点が指摘をされております。"@ja.
<< kg:id_125 prop:cause kg:id_126 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "職場や家庭など様々な場面で、まだ根底には性別役割分担意識が残っていると考えられまして、後期計画においてもその解消のための取組を強化していく必要があると考えております。"@ja.
<< kg:id_127 prop:effect kg:id_128 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "ＤＶ被害に遭った割合が前回調査の2.6％から今回調査では5.8％と増加しておりまして、決して楽観視はできない状況にあると認識しております。こうした状況を踏まえ、引き続き、ウィズ講座やパネル展示等による意識啓発や暴力を許さない機運醸成に努めるとともに、相談窓口の周知を行ってまいります。"@ja.
<< kg:id_129 prop:effect kg:id_130 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "令和５年度に実施した高校では、例えば、身体的暴力や物を投げるなどの行為を自分がされたことがあると答えた高校生も少なからずいました。"@ja.
<< kg:id_129 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "講座を通じて、ＤＶには身体的暴力以外にも性暴力、精神的暴力、デジタル暴力等も含まれることやお互いを大切にする関係について学びの機会を提供するとともに、信頼できる大人や相談機関に相談することの重要性を周知しております。...ＳＮＳやメールによる国の相談窓口、ＤＶ相談プラス"@ja.
<< kg:id_132 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "今後も、基本的にはこの名称を継続したいと考えておりますけれども...男女平等という言葉ではなくて、できる限りジェンダー平等という用語を使ってまいりたいと考えております。"@ja.
<< kg:id_134 prop:cause kg:id_135 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "声を上げにくい理由の一つとして、性的マイノリティに対する市民の理解が十分に進んでいないことが大きいと考えられる"@ja.
<< kg:id_136 prop:countermeasure kg:id_137 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "偏見や差別がなくなるよう、ウィズ講座等で、引き続き、理解促進に取り組んでいくことが重要だと考えております。"@ja.
<< kg:id_138 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "現時点では、性的マイノリティの当事者・支援者の団体を通じた実態把握に努めていきたいと考えております。"@ja.
<< kg:id_140 prop:effect kg:id_141 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "「アウティング」につきましては、73％の方が「言葉も意味も知らない」と答えておりまして、アウティングについての周知が必要だと考えております。"@ja.
<< kg:id_140 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "市民向け、そして高校生・専門学校生向けのウィズ講座、市職員向けの研修において、アウティングは厳禁であることについても周知を図っているところであります。"@ja.
<< kg:id_143 prop:cause kg:id_144 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "本県では、手帳カバーの色、形状等の統一をすることは現在未定であり、市独自にカバーの色、形状等を変更することは混乱を招くので、望ましくないとの見解でありました。"@ja.
<< kg:id_145 prop:countermeasure kg:id_146 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "本市としては、各障害者団体等の意見も伺いながら、統一したカバーへの変更について、県へ要望していくことを検討していきたいと思います。"@ja.
<< kg:id_147 prop:cause kg:id_148 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "各公共交通機関との調整、システム等の構築、財政的な負担等の多くの課題があると捉えておりまして、費用対効果も含めて、まずほかの自治体の取組について研究してまいりたいと考えております。"@ja.
<< kg:id_149 prop:cause kg:id_150 >>
    prop:text-txt_contents "本市では、大雨の際の道路冠水被害の把握は、市民からの情報や市職員の巡回などで行っておりました。"@ja.
<< kg:id_151 prop:countermeasure kg:id_152 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "今回検知しました水位監視システムにつきましては、浸水センサーが検知すると同時に職員にメールが通知され、職員が現場へ赴き道路冠水状況を確認しております。"@ja.
<< kg:id_153 prop:effect kg:id_154 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "９月６日の降雨時に、道路冠水を検知した浸水センサーの場所は、全13か所のうち富士見町二丁目、東栄町、東中の口町、亀ケ崎四丁目、錦町一丁目の５か所でございました。そのうち東栄町につきましては、15センチメートルを超える道路冠水も検知した状況でございます。"@ja.
<< kg:id_155 prop:countermeasure kg:id_156 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "県道周辺に集まった雨水を若浜排水区と本溝排水区から切り離して直接新井田川へ導く新たな排水ルートについて検討を始めたところでございます。"@ja.
<< kg:id_157 prop:countermeasure kg:id_158 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "本市では、現在、水位監視システムから得られる道路冠水情報を令和６年度中に市民へメール配信できるよう検討を進めております。なお、対象者につきましては、今年４月から開始しましたウェブサービスさかたコンポ利用者へメール配信できるよう関係課と協議しているところでございます。"@ja.
<< kg:id_159 prop:effect kg:id_160 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "日本ご当地ラーメン総選挙での日本一の効果も相まって本市に観光客を呼ぶことができる重要な観光資源であると再認識をしたところでございます。"@ja.
<< kg:id_161 prop:countermeasure kg:id_162 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "イベント等のＰＲをもっと強力に進めていくことです。皆さんおなじみになりました酒田のラーメンＥＸＰＯをはじめとした市内での関連イベント、この開催に対する支援と協力を、引き続き、行っていくことを検討していきたいと思っております。...首都圏などで開催される食の見本市のようなイベントに酒田のラーメンを考える会ですとか、そのほか食関係の団体の皆さんに出ていただく"@ja.
<< kg:id_161 prop:countermeasure kg:id_163 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "酒田のラーメンを考える会が作成しておりますラーメン店マップ、こちらは観光客の皆様から好評を博しておりますが、作成から少し時間がたっており、情報が古くなっておりますので、考える会の皆さんと協力しながら更新をして、しっかりＰＲを行っていきたいと思っています。"@ja.
<< kg:id_161 prop:countermeasure kg:id_164 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "本市公認マスコットキャラクターもしぇのん、あののん、こちらも出番が少なくならないようにいろんなラーメン関連のイベントにもしっかり派遣していきたいと。または、印刷物へキャラクターのイラストをしっかり出していく"@ja.
<< kg:id_165 prop:countermeasure kg:id_166 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "レストランや食堂などを紹介する食さんぽですとか、お酒やディナーを楽しむことができるお店を紹介しております夜さんぽ、こういったマップをつくって、観光案内所や観光施設などに配置をしております。"@ja.
<< kg:id_167 prop:countermeasure kg:id_168 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "しっかりサイトで検索いただくと、上位に表示が出るよう、そういったＳＥＯ対策を組んでしっかりＰＲできるように、ウェブ上でも努力をしていきたいと思っております。"@ja.
<< kg:id_169 prop:countermeasure kg:id_170 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "酒田駅大学線、公益大を回って美術館、土門・記念館を通っていく便...酒田市美術館や土門・記念館で約１時間ほど過ごした後に、酒田駅に戻ることができる運行体系を取っております。...るんるんバスまち歩きマップといったチラシの作成も検討"@ja.
<< kg:id_171 prop:countermeasure kg:id_172 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "議員御提案のような地元孟宗竹を使ったメンマなど、さらにもう一歩地元の食材の使用を進めていく、そのために、例えば、こういう食材があればいいのにということ、供給へのマッチングについては、行政が協力できる分野はしっかりとやってきたいと思っております。"@ja.
<< kg:id_173 prop:countermeasure kg:id_174 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "この日本一に輝いた日、10月９日を酒田のラーメンの日としようと、その日を中心とした１週間をラーメンウィークとすることを発表いたしました。"@ja.
}
