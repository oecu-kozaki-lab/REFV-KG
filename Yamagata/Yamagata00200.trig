kg:st_1 rdfs:label "齋藤直議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "市民の不安が大きく信頼回復が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "那須欣男危機管理監"@ja.
kg:st_2 rdfs:type cls:st_47.
cls:st_47 rdfs:label "行政職"@ja.
kg:op_2 prop:content "極めて遺憾で市民の信頼を裏切る行為と受け止める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "市民に不安と心配と迷惑をかけたことを深くわびる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "団員減少で消防団の存続に不安がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "団員減少で消防団の存続に不安がある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地域防災力維持のため成り手を増やす環境づくりが必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "消防団への理解を深める必要がある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地域住民に活動を理解してもらう取組が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "最も効果的な広報活動は口コミと認識している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "平日昼間帯の消防力補完が大きな課題"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "知識や技術や経験があり即戦力として期待している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "訓練機会が以前より減少していることは否めない"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "団員の意見を集約し実効性の高い訓練を模索する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "過度な訓練負担が退団につながっている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "技術の維持と向上をどう図るかが課題"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "後輩団員や後世への技術継承が課題"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "発表の機会が必要との意見も踏まえ復活も含め検討する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "事故時の証拠や危険運転抑止に有効と考える"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:st_3 rdfs:label "令和５年７月から８月にかけてのアンケート回答者"@ja.
kg:st_3 rdfs:type cls:st_22.
cls:st_22 rdfs:label "利用者"@ja.
kg:op_19 prop:content "運行時刻の変更を求める声が多い"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "鉄道接続や乗換え改善を求める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:st_4 rdfs:label "中村慶輔企画部長"@ja.
kg:st_4 rdfs:type cls:st_47.
kg:op_21 prop:content "いろは蔵パーク供用開始に合わせ新しい路線を示したい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "来年度に向けて早急に運行事業者と協議する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "今後さらに不足し住民生活に影響することを懸念する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "住民生活に影響が出るものと懸念する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "現在の運行継続への影響はないが拡充時の確保は困難"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "運転手不足への対応を研究していきたい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "費用面も含めて慎重に見ている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "本市では導入は難しい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "国の実証実験の課題検証を注視する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:st_5 rdfs:label "本間義紀地域創生部長"@ja.
kg:st_5 rdfs:type cls:st_47.
kg:op_30 prop:content "市場拡大が寄附増の要因と分析する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "主力返礼品の米需要が高かった"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:op_32 prop:content "他自治体よりお得感が増したことも要因"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "貴重な自主財源となっている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:op_34 prop:content "寄附者とのつながりも財産と捉える"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_5.
kg:op_35 prop:content "返礼品増加が地域活性化に寄与している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "共感を得られる事業の発信強化が必要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "事業のブラッシュアップと発信強化を進める"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "新規寄附企業の獲得につながった"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "米市場の変動リスクが非常に大きい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "主要返礼品確保策が必要"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "4月以降の寄附受入額が前年の8割程度まで減少"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "関係機関と相談し組み立てていきたい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "返礼品の種類内容数量の充実が急務"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:st_6 rdfs:label "齋藤美昭議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_44 prop:content "活動の確保と生徒第一の改革が必要"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "教員負担軽減と地域移行の両立が必要"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "指導者確保と育成が重要"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:st_7 rdfs:label "堀賀泉教育次長"@ja.
kg:st_7 rdfs:type cls:st_64.
cls:st_64 rdfs:label "教育職"@ja.
kg:op_47 prop:content "指導者や指導助手や事務運営に携わる人材を募集した"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_7.
kg:op_48 prop:content "指導者の質向上のため令和6年度は2回計画している"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_7.
kg:st_8 rdfs:label "令和５年12月実施の部活動改革に向けた実態調査の保護者"@ja.
kg:st_8 rdfs:type cls:st_69.
cls:st_69 rdfs:label "保護者"@ja.
kg:op_49 prop:content "移動手段がデメリットとして不安"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_8.
kg:op_50 prop:content "会費負担への不安がある"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_8.
kg:op_51 prop:content "各部活動種目ごとに複数配置するには大きく不足している"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "民間の力も借りながら財源確保を検討する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_7.
kg:st_9 rdfs:label "市原栄子議員"@ja.
kg:st_9 rdfs:type cls:st_16.
kg:op_53 prop:content "子どもの意思が反映されない懸念がある"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_9.
kg:op_54 prop:content "裁判所が適切に判断できず共同親権になるおそれがある"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_9.
kg:op_55 prop:content "双方合意が必要になり混乱や支障が懸念される"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_9.
kg:op_56 prop:content "独り親家庭から不安の声が上がっている"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_9.
kg:st_10 rdfs:label "高橋紀幸健康福祉部長"@ja.
kg:st_10 rdfs:type cls:st_47.
kg:op_57 prop:content "法改正の目的や内容を周知し適切な相談対応に努める"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_10.
kg:op_58 prop:content "相談者に寄り添った丁寧な対応を行う"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_10.
kg:op_59 prop:content "高齢者の独り暮らし増加で終活相談の必要性が高まる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_9.
kg:op_60 prop:content "どこに相談すればよいか分からないという声がある"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_9.
kg:op_61 prop:content "死後の手続を誰に頼むか不安が大きい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_9.
kg:op_62 prop:content "公的な相談窓口の必要性がある"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_9.
kg:op_63 prop:content "横断的支援の必要性が大きな障害"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_9.
kg:op_64 prop:content "現在の体制で丁寧に対応しつつ今後の取組を検討する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_10.
kg:op_65 prop:content "包括的支援を実現するため福祉総合相談窓口を設置した"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_10.
kg:op_66 prop:content "各機関のつなぎや調整を行い包括的に支援する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_10.
kg:op_67 prop:content "責任を持って案内する総合的窓口が必要"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_9.
kg:op_68 prop:content "どこでも声をかけやすい窓口環境づくりが必要"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_10.
kg:op_69 prop:content "分かりやすい分類と見出しが必要"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_9.
kg:op_70 prop:content "目的のものを探しやすくなるよう見直す"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_10.
kg:op_71 prop:content "相談したい市民を混乱させるため改善が必要"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_9.
kg:op_72 prop:content "リンク切れページの解消に努める"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_10.
kg:st_11 rdfs:label "遠田敏子議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_73 prop:content "本市独自の個性を生かした少子化対策が重要"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_11.
kg:op_74 prop:content "若い女性の流出を防ぐことが重要"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_10.
kg:op_75 prop:content "良質な雇用の創出が必要"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_10.
kg:op_76 prop:content "アンコンシャス・バイアスの除去が必要"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_10.
kg:op_77 prop:content "産後ケアの充実が必要"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_11.
kg:op_78 prop:content "産後うつや虐待防止のため支援体制確保が必要"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_11.
kg:op_79 prop:content "頼れる家族がいない産婦への支援が必要"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_11.
kg:op_80 prop:content "産後ケア事業の整備が必要"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_11.
kg:op_81 prop:content "最悪の場合に至る前の支援が重要"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_11.
kg:op_82 prop:content "外出が大変との声を受けアウトリーチ型を検討する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_10.
kg:op_83 prop:content "上の子がいて宿泊利用が難しい方のため検討する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_10.
kg:op_84 prop:content "搾乳利用も一目で分かる掲示が必要"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_11.
kg:st_12 rdfs:label "低出生体重児 リトルベビー のママ"@ja.
kg:st_12 rdfs:type cls:st_22.
kg:op_85 prop:content "搾乳だけでの利用にためらいがある"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_12.
kg:op_86 prop:content "利用者が気兼ねなく入室できるよう表示を行う"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_10.
kg:op_87 prop:content "早期発見と就学前支援のため実施の必要性と有効性を認識する"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_10.
kg:op_88 prop:content "関係機関の意見を聞きながら準備でき次第実施したい"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_10.
kg:op_89 prop:content "就学につなぐため切れ目のない支援体制を整える"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_10.
kg:op_90 prop:content "現在の健診回数等の調整なしでは確保が難しい"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_10.
kg:op_91 prop:content "従事回数増によりこれまでの業務との調整が必要"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_10.
kg:op_92 prop:content "時間外夜間も含め助言と情報共有を受けられる体制"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "行政職員としての雇用は考えていないが講師活用はできる"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
kg:op_94 prop:content "若い女性の流出防止と切れ目ない支援が重要"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_10.
kg:op_95 prop:content "結婚出産子育てを望む人が安心して暮らせる具体策が必要"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_10.
kg:op_96 prop:content "幼児期の発達段階を理解し育ちと学びの連続性を共有する機会"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_10.
kg:op_97 prop:content "子どもの育ちと学びに関わる課題を共有し実践に生かす"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_10.
kg:st_13 rdfs:label "佐藤弘議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_98 prop:content "教育委員会の機能強化のために必要だったはずだ"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_13.
kg:op_99 prop:content "現場実態や教育行政を考えると1人体制は理解に苦しむ"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_13.
kg:st_14 rdfs:label "矢口明子市長"@ja.
kg:st_14 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_100 prop:content "人員増と組織対応により1名体制でも職務を果たせる"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_14.
kg:op_101 prop:content "教育行政への大きな影響はないと考える"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_14.
kg:st_15 rdfs:label "松本国博議員"@ja.
kg:st_15 rdfs:type cls:st_16.
kg:op_102 prop:content "庄内は陸の孤島のような状態で物流や観光の妨げになっている"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_15.
kg:op_103 prop:content "交通が不便な地域住民や企業に不利に働く"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_15.
kg:op_104 prop:content "接続する交通インフラ整備は待ったなし"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_15.
kg:st_16 rdfs:label "安川智之副市長"@ja.
kg:st_16 rdfs:type cls:st_47.
kg:op_105 prop:content "事業化と予算獲得のため継続して要望する"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_16.
kg:op_106 prop:content "官民一丸で建設促進の機運醸成を続ける"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_16.
kg:op_107 prop:content "全線開通が実現するまで尽力する"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_16.
kg:op_108 prop:content "地元企業の参入可能性がある"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_16.
kg:op_109 prop:content "令和6年度は地元企業4社が受注している"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_16.
kg:op_110 prop:content "なるべく地元に仕事が落ちるよう対応したい"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_5.
kg:op_111 prop:content "今後の洋上風力も見据え組織対応を人事担当部局に要望する"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_5.
kg:op_112 prop:content "多様な産業に対応する用地が不足しているのではないか"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_15.
kg:op_113 prop:content "立地機会を損なわないよう民間物件利活用に注力する"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_16.
kg:op_114 prop:content "市または県として対応手法を整理する必要がある"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_16.
kg:op_115 prop:content "有効な制度であり活用可能性を検討する"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_16.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "このたびの度重なる不審火に市民は不安な日々を送っており"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "第一分団副分団長が放火の疑いで逮捕された 報道に耳を疑った 市民を裏切る行為には極めて残念 本市の非常勤特別職である消防団員が放火という重大な犯罪に関与した疑いで逮捕された 市民の信頼を裏切る行為であります"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市民の皆様には、毎日大変不安な思いをさせ、多大な御心配と御迷惑をおかけしたことを深くおわびいたします"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "全国の消防団員数は、少子化、人口減少などの影響で減少傾向であり"@ja.
<< kg:id_6 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "全国の消防団員数は、少子化、人口減少などの影響で減少傾向であり"@ja.
<< kg:id_6 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "今後、地域を守る消防団の存続が不安と感じています"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "背景には常備消防と消防団と混同されるケースがあり"@ja.
<< kg:id_10 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "消防団の活動が地域住民に理解されていない現状とも言われています"@ja.
<< kg:id_10 prop:contermeasure kg:id_13 >>
    prop:text-txt_contents "新入団員の確保策として、市広報や市ホームページへの掲載"@ja.
<< kg:id_10 prop:contermeasure kg:id_14 >>
    prop:text-txt_contents "ハーバーラジオの活用"@ja.
<< kg:id_10 prop:contermeasure kg:id_15 >>
    prop:text-txt_contents "消防団ＰＲイベントなどを実施しております"@ja.
<< kg:id_10 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "実際、最も効果的な広報活動は口コミであり、各分団や班で対象者に対して直接勧誘し、入団していただいているケースがほとんどであります"@ja.
<< kg:id_10 prop:contermeasure kg:id_17 >>
    prop:text-txt_contents "地域コミュニティ組織、コミ振や自治会などや消防団活動協力事業所への入団の呼びかけを行っている"@ja.
<< kg:id_10 prop:contermeasure kg:id_18 >>
    prop:text-txt_contents "消防団活動協力事業所への入団の呼びかけを行っているところでございます"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "多くの消防団員は、自分の住んでいる地域の外への勤務者が多く、特に平日の日中、これは昼間帯でございますが、消火活動や災害に迅速対応できる団員の確保が困難な状況にあります"@ja.
<< kg:id_19 prop:contermeasure kg:id_21 >>
    prop:text-txt_contents "平日昼間帯の消防力を補完するために消防団活動協力員や機能別ОＢ団の配置を進めてきたところであります"@ja.
<< kg:id_19 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "平日昼間帯の消防力を補完するために消防団活動協力員や機能別ОＢ団の配置を進めてきたところであります 後輩団員の指導や、現場では即戦力として期待している"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "コロナ禍により活動の制限や自粛を余儀なくされ 日頃の訓練機会が以前よりも減少していることは否めません"@ja.
<< kg:id_23 prop:cause kg:id_25 >>
    prop:text-txt_contents "さらに全国的な団員の負担軽減を求める風潮や消防操法大会の廃止などを受けて"@ja.
<< kg:id_23 prop:cause kg:id_26 >>
    prop:text-txt_contents "消防操法大会の廃止などを受けて"@ja.
<< kg:id_23 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "今後、団員の意見を集約しながら技術向上や練度を高めるための訓練の機会を増やすように努めていく所存でございます"@ja.
<< kg:id_26 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "消防操法大会に向けた早朝や夜遅くまでの過度な訓練が負担となり"@ja.
<< kg:id_26 prop:effect kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "一定の年齢になると退団につながっている状況があり"@ja.
<< kg:id_26 prop:effect kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "操法大会の廃止に伴い技術の維持と向上をどう図っていくかが大きな課題となっております"@ja.
<< kg:id_26 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "今後、消防操法大会の復活も含めて、消防団員からの意見集約を図りながら検討していく所存でございます"@ja.
<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:text-txt_contents "今年度から新規購入する車両につきましては、ドライブレコーダーを設置していく予定でございます"@ja.
<< kg:id_32 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "既存の車両には今後計画的に整備していきたいと考えているところでございます"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "利用したい時間にバスが走っていないことから、運行時刻の変更をしてほしいとの要望が多く"@ja.
<< kg:id_35 prop:cause kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "この中には、鉄道との接続やるんるんバスの乗換えに関するものもございました"@ja.
<< kg:id_35 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "現在、路線やダイヤの見直し作業を行っております"@ja.
<< kg:id_35 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "羽越本線下り18時26分と19時30分に酒田駅に到着する高校生などにつきましては、増便して対応する方法が考えられますが、来年度に向けて早急に運行事業者と協議させていただきたい"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "2024年の働き方改革によって残業規制と退職者の増加が重なり、運転手不足となり"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "残業規制と退職者の増加が重なり、運転手不足となり廃止・減便となっている地域もある"@ja.
<< kg:id_40 prop:effect kg:id_43 >>
    prop:text-txt_contents "運転手不足となり廃止・減便となっている地域もある"@ja.
<< kg:id_40 prop:effect kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "運行日の拡充や増便等について市が交通事業者にお願いする場合、直ちにドライバーを確保することは困難な状況"@ja.
<< kg:id_40 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "引き続き、交通事業者との意見交換などを行いながら、運転手不足に本市としてどのような対応ができるかなどを研究してまいりたい"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "利便性に対する導入費用などを比較検討してございますが、本市においては、導入に至っておりません"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "高齢者の利用が多い本市のるんるんバスにおいては、導入は難しいものと考えております"@ja.
<< kg:id_48 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "本市におきましては情報収集に努めてまいりたいと考えているところでございます"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "令和５年度のふるさと納税による寄附金が増えました要因は、ふるさと納税の市場規模が拡大していること"@ja.
<< kg:id_51 prop:cause kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本市の主力返礼品でございます米の需要が高かったことではないかなと分析をしております"@ja.
<< kg:id_51 prop:cause kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "本市では 10月の制度改正による寄附金額の引上げはやらなくてもよかった そのため、寄附者側から見れば、総体的に他の自治体と比べて、お得感が増したことも本市の寄附金額が伸びている要因"@ja.
<< kg:id_51 prop:effect kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "市の財政に好影響を与えております"@ja.
<< kg:id_51 prop:effect kg:id_56 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "19万件を超える御寄附をいただくようになりまして、その寄附者とのつながりも本市にとって貴重な財産と捉えてございます"@ja.
<< kg:id_51 prop:effect kg:id_57 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "地場産品を取り扱う返礼品の数も年々増加しておりまして、地域経済への直接的な効果も含めて本地域の活性化に寄与してきた"@ja.
<< kg:id_58 prop:cause kg:id_59 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "現状を申し上げますと、人気のある返礼品が選べないと寄附が集まりにくいという傾向があると捉えてございます"@ja.
<< kg:id_58 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "多くの共感を得られるような取組、特徴的な事業を分かりやすく発信する仕組み ガバメントクラウドファンディングとして寄附を募る事業のブラッシュアップを関係課と連携して検討"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "令和５年度から、ぜひ本市に企業版ふるさと納税を、という営業活動の業務を酒田ＤＭＯに委託することによりまして、これまで本市に寄附実績のない企業からの新規寄附へつながってございます"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "主力返礼品であります米に頼った構成になっております 主力返礼品の米が約７割を占めてございます"@ja.
<< kg:id_63 prop:effect kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "米市場に何らかの問題が発生した場合のリスクが非常に大きい現状にございます"@ja.
<< kg:id_63 prop:effect kg:id_66 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "令和５年産米の在庫がかなり厳しい状況になっておりますので、今年の４月以降、ポータルサイトでの募集を終了している そのことも影響しまして ４月と５月の寄附金受入額は対前年度比で８割程度までに減少"@ja.
<< kg:id_63 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "主要返礼品である米などの農産物をきちんと確保する方策が必要と思っております"@ja.
<< kg:id_63 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "天候に左右されない返礼品の主力化、そういった充実が急務と考えております"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "この課題の背景には、少子化の進行や教員の働き方改革があり"@ja.
<< kg:id_69 prop:cause kg:id_71 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "この課題の背景には、少子化の進行や教員の働き方改革があり"@ja.
<< kg:id_69 prop:cause kg:id_72 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "競技経験のない教職員が顧問となって指導せざるを得ないミスマッチの改善などが大きな課題"@ja.
<< kg:id_69 prop:contermeasure kg:id_73 >>
    prop:text-txt_contents "令和５年７月より総合型地域スポーツクラブと連携し、第一中学校、第四中学校、東部中学校において休日の部活動の地域移行を開始"@ja.
<< kg:id_69 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "本市独自のスポーツサポーターバンクを設立し、指導者、指導助手、事務運営に携わる方をサポーターとして募集しました"@ja.
<< kg:id_69 prop:contermeasure kg:id_75 >>
    prop:text-txt_contents "令和６年度からは文化部も含めたスポーツ文化サポーターバンクを立ち上げ"@ja.
<< kg:id_69 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "指導者の質の向上を図るため サポーターセミナーを令和６年度は２回計画しております"@ja.
<< kg:id_69 prop:effect kg:id_77 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "活動場所への移動手段や会費の在り方について保護者の不安がある 活動場所への移動手段や活動費用の増加をデメリットとして回答"@ja.
<< kg:id_69 prop:effect kg:id_78 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "活動場所への移動手段や活動費用の増加をデメリットとして回答しています"@ja.
<< kg:id_69 prop:cause kg:id_79 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "各中学校の各部活動、種目ごとに複数の指導者を配置するには50人から60人の指導者が不足しています"@ja.
<< kg:id_69 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "企業応援制度を本市でもできないか検討しております 今後、寄附金、スポンサー制度、企業版ふるさと納税などが活用できないか"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "今回の改正の中に、子どもの意見表明が明記されていないこと"@ja.
<< kg:id_81 prop:cause kg:id_83 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "精神的、経済的なＤＶや物的証拠がない場合は、裁判所が適切に判断できず、共同親権になるおそれがある"@ja.
<< kg:id_81 prop:effect kg:id_84 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "離婚後も子どもの進学や医療、転居などには双方の親権者の合意が必要になるため、合意が得られなければ、子どもの進学時の意見の食い違いなどの混乱や、手術や輸血などの適切な医療が受けられなくなる可能性がある"@ja.
<< kg:id_81 prop:effect kg:id_85 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "共同親権により所得制限を受ける可能性も言われています 独り親家庭からも不安の声が上がっています"@ja.
<< kg:id_81 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "これらに携わる職員につきましては、法改正の目的や内容について周知を図るとともに、研修等により適切な相談対応に努めてまいります"@ja.
<< kg:id_81 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "適切な情報提供や関係機関へのつなぎなど、相談者に寄り添った、丁寧な対応を行っていきたい"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "高齢化が進む中で、独り暮らしの市民から、このままでは家族やご近所に迷惑をかけてしまうのではないかという不安"@ja.
<< kg:id_88 prop:cause kg:id_90 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "独り暮らしの高齢者世帯数は増加傾向にあり どこに相談すればよいかよく分からない"@ja.
<< kg:id_88 prop:cause kg:id_91 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "その中でも親戚とのつながりのない方も増えつつあるのではないでしょうか"@ja.
<< kg:id_88 prop:cause kg:id_92 >>
    prop:text-txt_contents "本人が終活について認識して、準備するのが重要なことでありますが、情報が少ないことや"@ja.
<< kg:id_88 prop:cause kg:id_93 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "お墓や葬儀など、民間業者と生前に契約していてもトラブルになるということもあります"@ja.
<< kg:id_88 prop:cause kg:id_94 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "死後の事務手続を誰にお願いすればいいのか、多岐にわたる横断的支援などの必要性が大きな障害"@ja.
<< kg:id_88 prop:contermeasure kg:id_95 >>
    prop:text-txt_contents "令和２年度に「人生会議ノート～エンディングノート～」を作成し、高齢者支援課窓口などで配布"@ja.
<< kg:id_88 prop:contermeasure kg:id_96 >>
    prop:text-txt_contents "出前講座に「人生会議～自分らしい人生を選択する～」というメニューを上げ"@ja.
<< kg:id_88 prop:contermeasure kg:id_97 >>
    prop:text-txt_contents "在宅ケア講演会を年１回開催しており、終末期の在宅療養などをテーマに、市民向けの普及啓発も実施"@ja.
<< kg:id_88 prop:contermeasure kg:id_98 >>
    prop:text-txt_contents "終活にも活用できる社会資源として、遺品や空き家整理ができる事業者や身元保証の情報などを掲載"@ja.
<< kg:id_88 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "福岡市の事例をはじめとして、自治体が行う終活支援について今後も幅広く情報収集に努め、どのような取組が可能か検討"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "ひきこもり、8050問題、ヤングケアラーなど、既存の福祉分野ごとの支援の枠組みだけでは解決が困難な複雑、複合化した相談"@ja.
<< kg:id_100 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "今年度より地域福祉課に福祉総合相談窓口を開設しました"@ja.
<< kg:id_103 prop:effect kg:id_104 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "市民にとってはどの窓口が適切であるのか難しい選択となっている"@ja.
<< kg:id_103 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "市民相談室が多分その一番大きな要になるのかなと、あとは、市役所の１階にあります総合案内がそういう役割をしている"@ja.
<< kg:id_106 prop:cause kg:id_107 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "様々な分野のパンフレット・チラシが置かれることになり、雑然とした配置となってしまった"@ja.
<< kg:id_106 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "内容に応じた分別を行い、見出しをつけるなどして、市役所に来たお客様が目的のものを探しやすくなるよう、見直しを図ってまいりたい"@ja.
<< kg:id_109 prop:cause kg:id_110 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "本市ホームページの相談窓口一覧のページから、令和６年４月に開設しました福祉総合相談窓口と基幹相談支援センターのページのリンクが切れておりました"@ja.
<< kg:id_109 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "現在は正しいリンクに修正しているところであります 今後も随時チェックを行い、リンク切れページの解消に努めていきたい"@ja.
<< kg:id_8 prop:cause kg:id_112 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "若年女性人口の減少が続く限り、出生数は低下し続け、総人口の減少に歯止めがかからない"@ja.
<< kg:id_8 prop:cause kg:id_113 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "地方都市における人口減少の大きな原因は、若い人、特に男性よりも女性のほうが多く都会に出ていくこと"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "女性がやりがいを持って働ける仕事が地方都市では見つけにくい"@ja.
<< kg:id_113 prop:cause kg:id_115 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "地方都市では、結婚して子どもを設けるものだというような無意識の先入観、伝統的な性別役割分担意識があるため"@ja.
<< kg:id_8 prop:contermeasure kg:id_116 >>
    prop:text-txt_contents "平成29年10月１日に日本一女性が働きやすいまちを目指す宣言を行い"@ja.
<< kg:id_8 prop:contermeasure kg:id_117 >>
    prop:text-txt_contents "良質な雇用の創出や所得の向上"@ja.
<< kg:id_8 prop:contermeasure kg:id_118 >>
    prop:text-txt_contents "性別に係る無意識の思い込み、いわゆるアンコンシャス・バイアスの除去"@ja.
<< kg:id_8 prop:contermeasure kg:id_119 >>
    prop:text-txt_contents "家事シェアなどを進めることで"@ja.
<< kg:id_120 prop:cause kg:id_121 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "近年、産後間もない産婦の授乳関連の不安が増加傾向にあり"@ja.
<< kg:id_120 prop:cause kg:id_122 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "育児に伴う精神的な不調を訴える方も増加"@ja.
<< kg:id_120 prop:cause kg:id_123 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "核家族化、頼れる家族の不在"@ja.
<< kg:id_120 prop:cause kg:id_124 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "核家族化、頼れる家族の不在"@ja.
<< kg:id_120 prop:cause kg:id_125 >>
    prop:text-txt_contents "若年妊娠"@ja.
<< kg:id_120 prop:cause kg:id_126 >>
    prop:text-txt_contents "精神的疾患既往"@ja.
<< kg:id_120 prop:cause kg:id_127 >>
    prop:text-txt_contents "または、合併などがその背景にある"@ja.
<< kg:id_120 prop:effect kg:id_128 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "このような状態から懸念されるのが産後鬱でございます"@ja.
<< kg:id_120 prop:effect kg:id_129 >>
    prop:text-txt_contents "最悪の場合、自死、児童虐待、養育不全に陥ってしまう"@ja.
<< kg:id_120 prop:effect kg:id_130 >>
    prop:text-txt_contents "最悪の場合、自死、児童虐待、養育不全に陥ってしまう"@ja.
<< kg:id_120 prop:effect kg:id_131 >>
    prop:text-txt_contents "最悪の場合、自死、児童虐待、養育不全に陥ってしまう"@ja.
<< kg:id_120 prop:contermeasure kg:id_132 >>
    prop:text-txt_contents "出産後４か月未満の母子が利用できる宿泊型、いわゆるショートステイ型の産後ケア事業を実施"@ja.
<< kg:id_120 prop:contermeasure kg:id_133 >>
    prop:text-txt_contents "令和６年度から国の補助事業を活用し、利用者負担金の軽減を図っております"@ja.
<< kg:id_120 prop:contermeasure kg:id_134 >>
    prop:text-txt_contents "家族等から十分な家事、育児の援助が得られない者としていたものを、産後ケアを必要とする者と要件を緩和し"@ja.
<< kg:id_120 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "外出することが大変だとの声も伺っているところです 訪問型、いわゆるアウトリーチ型産後ケア事業の実施も検討していきたい"@ja.
<< kg:id_120 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "産後ケアの宿泊型を利用したいが、上の子がいるために宿泊して利用することは難しい方もおられることから、日中のみ利用する通所型、いわゆるデイサービス型産後ケア事業の実施についても、現在、検討している"@ja.
<< kg:id_137 prop:cause kg:id_138 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "搾乳のピクトグラムにつきましては、現状では搾乳器のイラストがほとんどで、少し分かりにくいイメージ"@ja.
<< kg:id_137 prop:effect kg:id_139 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "低出生体重児（リトルベビー）のママの声です 搾乳して届けることがございますが、授乳室に自分一人で入室することにためらいがある"@ja.
<< kg:id_137 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "利用される方が気兼ねなく入室できるよう、搾乳にも利用できる旨の表示は行いたい"@ja.
<< kg:id_137 prop:contermeasure kg:id_141 >>
    prop:text-txt_contents "お母さん１人での搾乳でも御利用いただけますというシールを付記するように指示がありましたので、早速対応"@ja.
<< kg:id_142 prop:effect kg:id_143 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "３歳児健康診査受診後は、教育委員会で実施している就学時健康診断まで数年ほど間が空いてしまう"@ja.
<< kg:id_142 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "市民健康センターでの集団健康診査を月２回、年24回の実施が可能か、関係機関の意見を聞きながら、今後、検討してまいりたい"@ja.
<< kg:id_142 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "関係機関の連携による切れ目のない支援を継続し、お子さんの特性に応じた成長を促すためのフォローアップ体制を整備"@ja.
<< kg:id_142 prop:cause kg:id_146 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "さらに24回、延べ48名の従事が必要となるため、現在実施している乳幼児健康診査の回数等の調整をしなければ小児科医師の確保は困難"@ja.
<< kg:id_142 prop:cause kg:id_147 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "心理専門職は 従事回数が増えることにより、これまでの業務等との調整が必要になる"@ja.
<< kg:id_148 prop:contermeasure kg:id_149 >>
    prop:text-txt_contents "県と山形地方気象台の共催による気象防災ワークショップが令和５年度から開催されており、本市からも担当職員３名が参加"@ja.
<< kg:id_148 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "山形地方気象台と市長等とは、時間外や夜間、昼夜を問わず、気象情報やその対応の助言、情報共有のためのホットラインが構築されております"@ja.
<< kg:id_148 prop:contermeasure kg:id_151 >>
    prop:text-txt_contents "山形地方気象台長とは２度、直接面会の上、地域の気象防災に関する共通認識や顕著現象時におけるホットラインの実効性を高めるための意見交換"@ja.
<< kg:id_152 prop:contermeasure kg:id_153 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "気象防災アドバイザーは 行政側の気象庁退職者等の実務経験者であることから、その経験を基にした市民向けの講習会や研修会、ワークショップの講師などとして活用できるのではないか"@ja.
<< kg:id_154 prop:effect kg:id_155 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "若い世代人口の社会減、晩婚化及びコロナ禍の影響により、本市の婚姻数や出生数は減少傾向にあります"@ja.
<< kg:id_154 prop:effect kg:id_156 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "婚姻数は396件から308件に、出生数は552人から431人にまで減りました"@ja.
<< kg:id_157 prop:contermeasure kg:id_158 >>
    prop:text-txt_contents "１つ、結婚支援の各種事業"@ja.
<< kg:id_157 prop:contermeasure kg:id_159 >>
    prop:text-txt_contents "２つ、産前産後サポート事業"@ja.
<< kg:id_157 prop:contermeasure kg:id_160 >>
    prop:text-txt_contents "３つ、産後ケア事業"@ja.
<< kg:id_157 prop:contermeasure kg:id_161 >>
    prop:text-txt_contents "４つ、乳幼児訪問や健診事業"@ja.
<< kg:id_157 prop:contermeasure kg:id_162 >>
    prop:text-txt_contents "５つ、出産子育て応援給付金や児童手当支給などの経済的支援"@ja.
<< kg:id_157 prop:contermeasure kg:id_163 >>
    prop:text-txt_contents "６つ、病児病後児保育や休日等保育などの保育サービス"@ja.
<< kg:id_157 prop:contermeasure kg:id_164 >>
    prop:text-txt_contents "７つ、ひとり親家庭等に対する学習支援"@ja.
<< kg:id_157 prop:contermeasure kg:id_165 >>
    prop:text-txt_contents "８つ、子育て短期支援などの家庭支援事業"@ja.
<< kg:id_157 prop:contermeasure kg:id_166 >>
    prop:text-txt_contents "こども家庭センターを拠点とした虐待防止のための相談及び要保護児童対策地域協議会の運営"@ja.
<< kg:id_167 prop:contermeasure kg:id_168 >>
    prop:text-txt_contents "各園で小学校への接続プログラムを進めております"@ja.
<< kg:id_167 prop:contermeasure kg:id_169 >>
    prop:text-txt_contents "各校で教育課程や指導を工夫しているところです"@ja.
<< kg:id_167 prop:contermeasure kg:id_170 >>
    prop:text-txt_contents "保育所児童保育要録として、認定こども園では認定こども園こども要録としてまとめ、各小学校へ持参しております"@ja.
<< kg:id_167 prop:contermeasure kg:id_171 >>
    prop:text-txt_contents "各園へ出向き入学前の児童の様子を参観するなど"@ja.
<< kg:id_172 prop:contermeasure kg:id_173 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "保育園や認定こども園と小学校を20グループに分け、グループ内で相互に職場体験しており、幼児期の子どもの発達段階を理解し、育ちと学びが連続することの重要性を共有する機会"@ja.
<< kg:id_172 prop:contermeasure kg:id_174 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "幼保小指導者研修会は、子どもの育ちと学びに関わる課題を共有して、それぞれの実践に生かす目的で実施"@ja.
<< kg:id_175 prop:contermeasure kg:id_176 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "教育委員会の機能強化のため、教育部長を教育次長（部長級）に改め、新たに教育職の教育次長を配置し、２名体制とした"@ja.
<< kg:id_175 prop:effect kg:id_177 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "教育次長（教育職）が減っても教育行政や教育委員会事務局の業務は減りません"@ja.
<< kg:id_178 prop:contermeasure kg:id_179 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "この５年間で教育研修センター主事や部活動改革総括コーディネーターの配置、そして、今年度からはスクールソーシャルワーカーの資格を持つ新規職員の配置など、教育委員会の人員を増員して"@ja.
<< kg:id_178 prop:contermeasure kg:id_180 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "今後も教育委員会内のそれぞれの課において、各担当者が引き続き業務に当たるため、教育行政への大きな影響はない"@ja.
<< kg:id_181 prop:cause kg:id_182 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "まさに庄内は陸の孤島のような状態にあります"@ja.
<< kg:id_182 prop:effect kg:id_183 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "交通が不便な地域住民や企業には流通コストが加算されるおそれもあります"@ja.
<< kg:id_182 prop:effect kg:id_184 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "何より酒田港の利用発展を阻害する要因であることは、誰もが認識するところでしょう"@ja.
<< kg:id_182 prop:contermeasure kg:id_185 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "政府与党、国土交通省、財務省等に対しての要望活動"@ja.
<< kg:id_182 prop:contermeasure kg:id_186 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "日沿道建設促進大会、あとは庄内総合支庁が主催しております高速道路整備促進セミナーなどを通じて、建設促進に対する機運醸成の活動"@ja.
<< kg:id_182 prop:contermeasure kg:id_187 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "庄内２市３町をはじめ、地元経済界など官民の関係者が一丸となって要望活動、機運醸成活動にこれまで以上に尽力してまいりたい"@ja.
<< kg:id_188 prop:effect kg:id_189 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "国土交通省が令和６年度から令和９年度までの４か年で、計122億円の岸壁整備などの事業が予定されております"@ja.
<< kg:id_188 prop:effect kg:id_190 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "山形県の事業では、令和５年度から令和８年度までの４か年で、護岸整備事業など合計112億円規模の事業が予定されております"@ja.
<< kg:id_188 prop:contermeasure kg:id_191 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "なるべく落札できるような工事を見つけて、私どもも情報を収集していきたい"@ja.
<< kg:id_188 prop:contermeasure kg:id_192 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "商工港湾課内に港湾エネルギー推進係ということで、課長補佐を筆頭に５名の職員で対応しております その体制は維持しつつも 今後 その都度、きちんとした対応ができるよう、組織体制も臨んでいけるよう、人事担当部局に要望"@ja.
<< kg:id_193 prop:cause kg:id_194 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "本市における山形県、そして、本市が分譲しておる工業用地について残っているものは、酒田臨海工業団地の一部のみでございます"@ja.
<< kg:id_193 prop:contermeasure kg:id_195 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "民間物件の利活用にもっと注力をしていこうと思います。空き物件や遊休資産の情報収集を強化していきたい"@ja.
<< kg:id_193 prop:contermeasure kg:id_196 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "ハザードリスクがないこと、特別高圧の電気や工業用水が利用できる環境があることなどを求められる そういったことを加味しながら、工業用地の必要性や造成など、これは今後市として、もしくは県としてかもしれませんが、対応の手法をいま一歩、我々としては整理していかなきゃいけない"@ja.
<< kg:id_193 prop:contermeasure kg:id_197 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "これは有効な制度だと思っておりますので、活用の可能性はしっかり検討してまいりたい"@ja.
}
