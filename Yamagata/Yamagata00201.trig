kg:st_1 rdfs:label "武田恵子議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "紙面での継続的なアピールが必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "意識向上につながっていると認識する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "女性活躍推進懇話会や市民ワークショップ参加者"@ja.
kg:st_2 rdfs:type cls:st_74.
cls:st_74 rdfs:label "参加者"@ja.
kg:op_3 prop:content "家庭での家事シェア推進が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "村上祐美市民部長"@ja.
kg:st_3 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_4 prop:content "関心のない人にも自分事として認識してもらうことが課題"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "市民が主体的に参加し自ら考える仕掛けとして実施する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "家族で考える新たな取組として広く参加を促す"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "各種機会を捉えて周知し活用を促進する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "一般事業主行動計画の策定が課題"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "企業に寄り添ったきめ細かな対応を行う"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "仕事面で地方都市に魅力的な就業機会が不足している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "無意識の先入観に縛られず自分らしく生きたいと考え都会へ流出している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "若い人や女性が能力を発揮できる仕事づくりに重点的に取り組む"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "地元とのつながりを保ち戻りやすい環境づくりが必要"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "全ての分野の根底にある意識の解消が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:st_4 rdfs:label "本間義紀地域創生部長"@ja.
kg:st_4 rdfs:type cls:st_2.
kg:op_15 prop:content "地元で能力を生かした新しい働き方の実現につながる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "能力を使って事業を起こす支援として評価する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "固定的役割分担意識が阻害要因になっている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "より一層の意識改革と啓発が必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "理想の家事シェアを話し合うきっかけにしたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "父親の実体験共有を通じて意識変容につなげる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:st_5 rdfs:label "安藤浩夫議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_21 prop:content "コロナ禍で学校に行かない経験が不登校増加の背景にある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "在宅学習環境の整備も背景にある"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "保護者の学校復帰への認識変化が背景にある"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "教育現場の余裕のなさが認識のずれを生んでいるのではないか"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "現場では学校復帰を前提にした対応が残っているのではないか"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:st_6 rdfs:label "赤坂宜紀教育長"@ja.
kg:st_6 rdfs:type cls:st_72.
cls:st_72 rdfs:label "教育機関"@ja.
kg:op_26 prop:content "家庭と十分に話し合い個々に合った支援を行う"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "本人と保護者の気持ちに寄り添った支援を続ける"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "快適で効果的な相談活動の場所確保が課題"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:op_29 prop:content "今後も整備検討を続ける"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_6.
kg:op_30 prop:content "ふれあい教室だけでなく民間施設との連携が必要"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_6.
kg:op_31 prop:content "地域防災の担い手不足が課題"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:op_32 prop:content "地域を守る人材の確保が難しくなっている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "将来の地域の防災リーダー育成に重要"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "防災減災を分かりやすく学ぶ機会を提供する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:st_7 rdfs:label "那須欣男危機管理監"@ja.
kg:st_7 rdfs:type cls:st_2.
kg:op_35 prop:content "子どもが役立っている実感を持てることが関心を高める第一歩"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_7.
kg:st_8 rdfs:label "矢口明子市長"@ja.
kg:st_8 rdfs:type cls:st_2.
kg:op_36 prop:content "現状の発電方式のままでは将来の休廃止は避けられない"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_8.
kg:op_37 prop:content "地域経済と雇用への影響が大きいため支援が必要"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_8.
kg:st_9 rdfs:label "後藤仁議員"@ja.
kg:st_9 rdfs:type cls:st_16.
kg:op_38 prop:content "要望は時期を得たものだ"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_9.
kg:op_39 prop:content "状況に応じて必要があれば支援を考える"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "本市ならではの魅力を巡るツアー造成が必要"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_8.
kg:op_41 prop:content "出羽遊心館での文化体験を活用した国際交流が有効"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "酒田ならではの体験になり得る"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_8.
kg:op_43 prop:content "もう少しスピード感を持って植え替えしてほしい"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_9.
kg:op_44 prop:content "地域ボランティアに大きな負担がかかっている"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_9.
kg:st_10 rdfs:label "菅原泰寛建設部長"@ja.
kg:st_10 rdfs:type cls:st_2.
kg:op_45 prop:content "雑草除去に効果があることを確認した"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_10.
kg:op_46 prop:content "一生懸命やっている地域を後押しする施策も必要"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_9.
kg:st_11 rdfs:label "佐藤喜紀議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_47 prop:content "将来にわたり学生を安定的に確保し大学経営を継続できるか危機感がある"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_11.
kg:op_48 prop:content "県と全市町が一体となって運営すべき"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_8.
kg:op_49 prop:content "機能強化としてしっかり取り組むべき"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_11.
kg:st_12 rdfs:label "冨樫覚議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_50 prop:content "どこに避難したらよいか分からない人もいる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_12.
kg:st_13 rdfs:label "高橋紀幸健康福祉部長"@ja.
kg:st_13 rdfs:type cls:st_2.
kg:op_51 prop:content "危険地域から進め全市に広げる"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_13.
kg:op_52 prop:content "未登録者にも適切な支援が届くようにしたい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_13.
kg:op_53 prop:content "現時点では課題がある"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_13.
kg:op_54 prop:content "受入れには事前把握が必要"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_13.
kg:op_55 prop:content "意向や地域の実情を踏まえて検討する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_13.
kg:op_56 prop:content "要援護者の状態に配慮した適切な移動手段確保を検討する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_13.
kg:op_57 prop:content "特に電源が必要な児童の避難先確保を進めている"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_13.
kg:op_58 prop:content "実践的な訓練で個別避難計画の実効性向上を目指す"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_13.
kg:st_14 rdfs:label "後藤啓議員"@ja.
kg:st_14 rdfs:type cls:st_16.
kg:op_59 prop:content "Uターン希望者でも希望する就業先がない"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_14.
kg:st_15 rdfs:label "安川智之副市長"@ja.
kg:st_15 rdfs:type cls:st_2.
kg:op_60 prop:content "地元企業との協業やベンチャー企業誘致の場として活用する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_15.
kg:op_61 prop:content "デジタル変革の取組が知名度向上と企業立地に効果を持った"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_15.
kg:op_62 prop:content "トップ同士のつながりが新たな投資にもつながる"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:op_63 prop:content "企業が着目する本市の強みとしてPRしている"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_15.
kg:op_64 prop:content "ライフスタイルに合わせた働き方がしやすい仕事として重視する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_15.
kg:st_16 rdfs:label "サンロクIT女子参加女性"@ja.
kg:st_16 rdfs:type cls:st_74.
kg:op_65 prop:content "賃金よりライフスタイルに合わせた働き方を重視している"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_16.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "このように、新たな取組の実施や活動の着実な進展が、広報による周知、啓発の内容やボリュームの充実につながっていると考えております"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:text-txt_contents "このように、新たな取組の実施や活動の着実な進展が、広報による周知、啓発の内容やボリュームの充実につながっていると考えております"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "これらの取組を通じて、講座の参加者アンケートなどからは、男女共同参画に関する意識を高めることにつながっていることが伺えます"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "家庭における男女共同参画や家事シェア推進についての意見を多数頂戴いたしました 例えば、家事を見える化し、家族全員で役割分担をお互いに話し合ったりするなど、性別に関わりなく働きやすく暮らしやすい町にしていくためには、市民一人一人が性別による固定的役割分担意識などのアンコンシャス・バイアスにとらわれずに生きられるよう、気づきや見直しを促すことが必須である"@ja.
<< kg:id_3 prop:cause kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "講座に参加する方だけではなく、男女共同参画を日頃意識していない方や関心のない方からも、いかに自分事として認識していただくかが課題の一つと考えております"@ja.
<< kg:id_3 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "今年度は各講座による学習機会のほかに、新たな取組として「これアンコン！経験談募集！」や、８月に実施予定の家事シェアチェック宣言の取組など、これまでの学習スタイルではなく、市民が主体的に参加して、自らが考えることができるような仕掛けを実施してまいります"@ja.
<< kg:id_3 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "今年度は各講座による学習機会のほかに、新たな取組として「これアンコン！経験談募集！」や、８月に実施予定の家事シェアチェック宣言の取組など、これまでの学習スタイルではなく、市民が主体的に参加して、自らが考えることができるような仕掛けを実施してまいります"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:text-txt_contents "令和５年度の実績についてですが、11社に対し、計330万円を交付いたしました。こちらは、当初想定しておりました数を上回る申請となったため、補正予算をお願いし対応したところでございます"@ja.
<< kg:id_11 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "女性が働きやすい職場づくりに取り組む事業所への奨励金についてのお尋ねがございました この奨励金には３つのメニューがございます"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "しかしながら、その指標としております、えるぼし認定につなげるための一般事業主行動計画の策定が課題となっております"@ja.
<< kg:id_14 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "市としては、昨年度に引き続き、山形労働局を講師としたセミナーを開催するなど、えるぼし認定制度の基礎知識について周知するとともに、職員が市内企業を訪問し、一般事業主行動計画の策定の助言を行うなど、各事業主に寄り添ったきめ細やかな対応を行っていきたい"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "若い女性の社会減の主な理由としては、２つあると分析しております。１つは、仕事に対する考え方として、大学などの高等教育機関へ進学する女性が増える中で、女性がやりがいを持って働ける仕事が地方都市では見つけにくいということ"@ja.
<< kg:id_17 prop:cause kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "２つ目としては、伝統的な性別役割分担意識があるということ、例えば地方都市では、女性も男性も結婚して子どもをもうけるものだというような無意識の先入観、いわゆるアンコンシャス・バイアスが強く、それに縛られることなく、自分らしく生きたいと考え、都会へ流出している"@ja.
<< kg:id_17 prop:effect kg:id_20 >>
    prop:text-txt_contents "地方都市における人口減少の原因は、若い人、特に男性よりも女性の方が多く都会に出ていくことにより、地方都市における若い女性の結婚が減り、その結果、その地域で生まれる子どもの数が減っていることである"@ja.
<< kg:id_21 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本市では、１、魅力的な仕事の創出と人材育成、２、ＵＩＪターンの受皿づくり、３、アンコンシャス・バイアスの解消といった３つの点について重点的に取り組んでいるところでございます"@ja.
<< kg:id_21 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "本市では、１、魅力的な仕事の創出と人材育成、２、ＵＩＪターンの受皿づくり、３、アンコンシャス・バイアスの解消といった３つの点について重点的に取り組んでいるところでございます"@ja.
<< kg:id_21 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "本市では、１、魅力的な仕事の創出と人材育成、２、ＵＩＪターンの受皿づくり、３、アンコンシャス・バイアスの解消といった３つの点について重点的に取り組んでいるところでございます"@ja.
<< kg:id_21 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "若い人や女性が就きたい、能力を発揮できるようなＩＴ企業の誘致や、東北公益文科大学でのＩＴ教育、そしてサンロクＩＴ女子への支援など、ＩＴ分野へ注力しております"@ja.
<< kg:id_21 prop:contermeasure kg:id_26 >>
    prop:text-txt_contents "若い人や女性が就きたい、能力を発揮できるようなＩＴ企業の誘致や、東北公益文科大学でのＩＴ教育、そしてサンロクＩＴ女子への支援など、ＩＴ分野へ注力しております"@ja.
<< kg:id_21 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "若い人や女性が就きたい、能力を発揮できるようなＩＴ企業の誘致や、東北公益文科大学でのＩＴ教育、そしてサンロクＩＴ女子への支援など、ＩＴ分野へ注力しております"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "男女共同参画社会の実現を阻害している要因の一つとして、性別による固定的役割分担意識などのアンコンシャス・バイアスがある"@ja.
<< kg:id_24 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "内在するアンコンシャス・バイアスへの気づきを促すとともに、それらの解消に向けて、家庭や職場、地域や学校などのあらゆる分野において、より一層の意識改革、啓発が必要であると考えております"@ja.
<< kg:id_24 prop:contermeasure kg:id_31 >>
    prop:text-txt_contents "応募作品を広報やホームページ等で発信し、無意識の偏見や思い込みに対する気づきを促してまいります"@ja.
<< kg:id_24 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "さらに、関連事業として、８月を家事シェア推進月間に設定いたします"@ja.
<< kg:id_24 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "10月にはウィズ講座「家事育児パパ交流セミナー」を開催し、実際に家事や育児をされている父親の方々から、楽しさや意義、苦労などをお話しいただく予定でございます"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "これは、新型コロナウイルスの流行による休校や在宅学習で、学校に行かずに過ごす機会が増えたことの影響"@ja.
<< kg:id_34 prop:cause kg:id_36 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "ⅠＣＴの利用により在宅で勉強ができる体制が整ったこと"@ja.
<< kg:id_34 prop:cause kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "2017年に不登校児童生徒に学習の場の支援、提供を掲げたいわゆる教育機会確保法により、無理して学校に行かなくてもよいのではないかと思う保護者らが増加したなどが背景にある"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "学校の人手不足の中での外国語の導入や、ⅠＣＴの導入などにより、カリキュラムの過密化が教育現場の余裕をなくして、子どもの心情や実情を把握していないのではないか"@ja.
<< kg:id_38 prop:cause kg:id_40 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "現場を預かる教員としては、不登校生をなるべく出したくないとの思いがあり、登校を促す考えから抜け切れていないのではないか"@ja.
<< kg:id_41 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "個々の児童生徒に合った支援を行っていけるように、その家庭と支援の在り方を十分に話し合い、丁寧な対応に今後も努めてまいります"@ja.
<< kg:id_41 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "スクールカウンセラーやスクールソーシャルワーカーなども活用しながら、不登校児童生徒本人及びその保護者の気持ちに寄り添った支援を引き続き行っていく所存です"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "近年、通級児童生徒の人数が増加傾向にあり、より快適で、かつ効果的に相談活動ができる場所の確保が課題である"@ja.
<< kg:id_46 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "施設の整備につきましては、昨年度から検討しておりますが、今後も検討を続けていきたい"@ja.
<< kg:id_48 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "今後は公的な教育支援センター、本市ではふれあい教室と呼んでおりますが、このふれあい教室だけでなく、フリースクール等の民間施設との連携が必要であると考えております"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "人口減少により、自主防災組織の高齢化や担い手不足などによる組織の弱体化"@ja.
<< kg:id_50 prop:cause kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "平日の昼の人口が少ない、消防団員の減少などの課題も多くあります"@ja.
<< kg:id_50 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "小中学生という早いうちから防災・減災に関心を持つということは、将来、地域の防災リーダーとしての活躍も見据え、非常に重要なこととして捉えております"@ja.
<< kg:id_50 prop:contermeasure kg:id_54 >>
    prop:text-txt_contents "学校側からの要望を受けて、小学校高学年及び中学生向けの出前講座をこれまでも行っております"@ja.
<< kg:id_50 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "東北大学減災教育「結」プロジェクトによる出前授業実施の協力を得て、防災・減災に関して分かりやすく子どもたちに学んでもらう機会を提供していく予定"@ja.
<< kg:id_50 prop:contermeasure kg:id_56 >>
    prop:text-txt_contents "令和５年度から令和７年度は、県のモデル事業として、毎年市内６校の小中学校に防災アドバイザーを派遣しております"@ja.
<< kg:id_50 prop:contermeasure kg:id_57 >>
    prop:text-txt_contents "令和４年度から、電子版「酒田防災ハンドブック」を作成し、小中学生の持つ１人１台端末に入れることで、いつでも防災学習を行うことができる環境を整えております"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "生徒たちがどのように動いていくかというところについては、率先避難者という考え方を推進して取り組んでいるところでございます"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "酒田共同火力発電所の１号機、２号機につきましては、非効率な石炭火力発電に整理されている発電効率が38％以下の亜臨界圧方式に該当しており、現状の発電方式のままでは将来の休廃止は避けられないものと認識"@ja.
<< kg:id_60 prop:effect kg:id_62 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "本市としては、発電所の休廃止は地域の経済と雇用に大きく影響を及ぼすため"@ja.
<< kg:id_60 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "国などに対して非効率な石炭火力発電所が立地する地域がカーボンニュートラル社会に移行するための支援制度の新設を要望しているところであります"@ja.
<< kg:id_60 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "この活動を継続するとともに、関係各所との情報共有、意見交換も継続してまいります"@ja.
<< kg:id_65 prop:cause kg:id_66 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "酒田港に寄港するクルーズ船のオプショナルツアーでは、市内の美術館や山居倉庫を巡るコースも設定されておりますが、鳥海山や羽黒山、最上川舟下りなど、酒田市外へのコースが多い現状にあります"@ja.
<< kg:id_67 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "クルーズ船寄港の経済効果を本市に波及させるためには、より本市の魅力をＰＲし、本市ならではの魅力を巡るオプショナルツアーの造成が必要となります"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "出羽遊心館での酒田文化体験につきましても、出羽遊心館というすばらしい建物と周辺の景観を生かした酒田ならではの体験になり得ると考えております"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:text-txt_contents "日和山公園の桜につきましては、樹齢が60年を超えていると思われる木が多くなってきており、老木化が進んでいる状況"@ja.
<< kg:id_71 prop:cause kg:id_73 >>
    prop:text-txt_contents "さらに、最近の夏の高温と少雨の影響により、桜の花のつきが悪く、花が咲かない木も確認されております"@ja.
<< kg:id_74 prop:contermeasure kg:id_75 >>
    prop:text-txt_contents "特に樹勢がなくなっている日和山公園と光ケ丘公園内の武道館前の緑地にあるシダレザクラにつきましては、年に２回の施肥作業を行っております"@ja.
<< kg:id_74 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "日和山公園は、本市を代表する桜の名所として今後も桜を維持していくために、施肥作業に加え、順次、植え替えなどにも取り組んでいく必要がある"@ja.
<< kg:id_74 prop:contermeasure kg:id_77 >>
    prop:text-txt_contents "現在、日和山公園の桜更新年次計画の策定に向けて調査を始めたところでございます"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "本当に美化ボランティアの方々から一生懸命に手取り除草をしてもらっておりまして、我々も頭の下がる思いでございます"@ja.
<< kg:id_80 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "昨年から一部管理方法を見直し、試験的に日和山公園におきまして、芝用の除草剤の散布と施肥作業を実施し、雑草、除草に効果があることを確認しております"@ja.
<< kg:id_80 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "これまでの画一的な管理方法ではなく、その公園その公園に適した管理方法を取るよう今後も研究してまいりたい"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "18歳人口は今後も減少し続け、令和５年の109万人から令和23年には79万人と、30万人減少すると見込まれています。少子化が進行する中で、将来にわたり学生を安定的に確保し、大学経営を継続できるかについて強い危機感があります"@ja.
<< kg:id_85 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "大学設立当時の趣旨を踏まえ、県と庄内地域の全ての市町が一体となって大学を運営すべきであるという基本的な考え方の下で、県と２市３町が設置者として関与していくという考えで一致をいたしました"@ja.
<< kg:id_85 prop:contermeasure kg:id_87 >>
    prop:text-txt_contents "県と既存の一部事務組合である庄内広域行政組合、この２者が共同で設立団体となる方向で検討しているところであります"@ja.
<< kg:id_85 prop:contermeasure kg:id_88 >>
    prop:text-txt_contents "大学設立時の負担割合である県55％、市町45％を基本に検討していくことを確認いたしました"@ja.
<< kg:id_89 prop:contermeasure kg:id_90 >>
    prop:text-txt_contents "県からは現在の公益学をベースにしながら、さらなる機能強化の方向性の素案として、地域に強い公益大、デジタルに強い公益大、国内外を開拓する人材を育成する公益大、この３つの方向をお示しいただきました"@ja.
<< kg:id_89 prop:contermeasure kg:id_91 >>
    prop:text-txt_contents "県からは現在の公益学をベースにしながら、さらなる機能強化の方向性の素案として、地域に強い公益大、デジタルに強い公益大、国内外を開拓する人材を育成する公益大、この３つの方向をお示しいただきました"@ja.
<< kg:id_89 prop:contermeasure kg:id_92 >>
    prop:text-txt_contents "県からは現在の公益学をベースにしながら、さらなる機能強化の方向性の素案として、地域に強い公益大、デジタルに強い公益大、国内外を開拓する人材を育成する公益大、この３つの方向をお示しいただきました"@ja.
<< kg:id_89 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "東北公益文科大学の学内におきましては、令和８年４月に国際学部国際コミュニケーション学科の設置を目指しております"@ja.
<< kg:id_94 prop:cause kg:id_95 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "身体の状況や世帯状況から避難が困難にもかかわらず、本人の意向、いわゆる手挙げ方式で作成をしました災害時要援護者台帳の登録には至っていない方がいる"@ja.
<< kg:id_96 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "必要な情報の補足につきまして、令和６年度は土砂災害の危険が高い八幡、松山、平田地域と津波・浸水、最上川洪水の危険が高い港南、亀ケ崎、松原地域について取組を進めております。令和７年度には、全市に広げていく予定"@ja.
<< kg:id_96 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "これらの未登録の方々に適切な支援が届くよう個別避難計画の作成を促すことを考えております"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "施設側の受入れ可能数に限りがあること"@ja.
<< kg:id_99 prop:cause kg:id_101 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "施設側であらかじめ要援護者の心身の状況を十分に把握しておく必要があることなどから、現時点では課題があるものと認識しております"@ja.
<< kg:id_102 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "今後の個別避難計画の作成に当たりましては、要援護者の意向や地域の実情なども踏まえた上で、必要に応じ、福祉避難所に直接避難するような調整につきましても検討してまいりたい"@ja.
<< kg:id_104 prop:contermeasure kg:id_105 >>
    prop:text-txt_contents "指定避難所の福祉避難スペースにつきましては、酒田市避難所運営マニュアルに空間配置の注意点として、文章と共に図で説明するなど、周知を図っているところです"@ja.
<< kg:id_106 prop:contermeasure kg:id_107 >>
    prop:text-txt_contents "介助者による移送が困難な場合は、施設が保有している車両等の活用を要請することとしています"@ja.
<< kg:id_106 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "要援護者の状態に配慮した適切な移動手段の確保、交通事業者との連携につきましても検討してまいりたい"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "在宅の医療的ケア児のうち、特にケアに電源を必要とする児童につきましては、個別避難計画を作成し、日本海総合病院に避難することができるよう協議を進めているところです"@ja.
<< kg:id_111 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "令和６年度の総合防災訓練では、避難行動要支援者の避難支援のため、各自主防災組織と消防団の連携による避難行動要支援者の避難訓練を予定しております"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "酒田に帰ってきたいのだが希望に合った働く場がないという声を聞きます"@ja.
<< kg:id_115 prop:contermeasure kg:id_116 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "渋谷キューズでございますけれども、これは渋谷にその名前のとおりございます施設で、いわゆるＩＴ系のベンチャー企業ですとか、国内の大手企業が会員となっている施設でございまして、日々新しいビジネスや協業が生まれている場所でございます"@ja.
<< kg:id_115 prop:contermeasure kg:id_117 >>
    prop:text-txt_contents "ベンチャーや大手企業との協業を狙いながら、地元の中小企業の業容の拡大をそのコラボレーションの中に見つけ出していくということが一つ"@ja.
<< kg:id_115 prop:contermeasure kg:id_118 >>
    prop:text-txt_contents "そこにいるベンチャー企業を本市に呼び込んで、新しいビジネスを酒田で起こしてもらおうということ"@ja.
<< kg:id_115 prop:contermeasure kg:id_119 >>
    prop:text-txt_contents "ベンチャー企業や大手企業、または東京に住む酒田の出身者、そういった方が集まれるような場所、関係人口をもっと強固にしていこう"@ja.
<< kg:id_115 prop:effect kg:id_120 >>
    prop:text-txt_contents "立地を検討されている企業が本市を訪れてくださっている件数は、延べで令和３年度では87件、令和４年度は64件、令和５年度は70件となっており、多くの企業から本市に関心を持っていただいております"@ja.
<< kg:id_121 prop:cause kg:id_122 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "本市のデジタル変革の取組が注目されたこと、これは効果としてあると思っております"@ja.
<< kg:id_115 prop:contermeasure kg:id_123 >>
    prop:text-txt_contents "賃借型立地企業定着促進助成金、これは情報サービス業を対象とした手厚い優遇制度でございます"@ja.
<< kg:id_115 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "これまでトップセールスを継続して行ってきているのも結果に結びついている"@ja.
<< kg:id_115 prop:contermeasure kg:id_125 >>
    prop:text-txt_contents "製造業や情報サービス業などの専門性を有した人材を輩出している地域ですと、これは繰り返し伝えています"@ja.
<< kg:id_115 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "日本一女性が働きやすいまちの実現を目指す取組を行っていることです。これは企業の皆様が一度は必ず着目される部分でございます。このあたりも、本市の強みとしてＰＲしております"@ja.
<< kg:id_127 prop:contermeasure kg:id_128 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "地方にいながら都会の仕事に従事することができる側面を持つ情報サービス業、いわゆるＩＴ企業の誘致に着目して"@ja.
<< kg:id_127 prop:cause kg:id_129 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "一番上位は、ライフスタイルに合わせた働き方ができることであると84％の女性が答えています"@ja.
}
