    prop:text-txt_contents "児童手当の制度改正に伴う扶助費の増額"@ja.
<< kg:id_151 prop:cause kg:id_154 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "大雨災害による家屋解体に係る経費の計上が主なものであります。"@ja.
<< kg:id_154 prop:effect kg:id_155 >>
    prop:text-txt_contents "大雨災害による家屋解体に係る経費の計上"@ja.
<< kg:id_156 prop:countermeasure kg:id_157 >>
    prop:text-txt_contents "衛生費では、全壊家屋の公費解体に係る経費"@ja.
<< kg:id_158 prop:countermeasure kg:id_159 >>
    prop:text-txt_contents "大規模半壊、中規模半壊及び半壊家屋の解体撤去に係る給付金を計上しております。"@ja.
<< kg:id_160 prop:countermeasure kg:id_159 >>
    prop:text-txt_contents "大規模半壊、中規模半壊及び半壊家屋の解体撤去に係る給付金を計上しております。"@ja.
<< kg:id_161 prop:countermeasure kg:id_159 >>
    prop:text-txt_contents "大規模半壊、中規模半壊及び半壊家屋の解体撤去に係る給付金を計上しております。"@ja.
<< kg:id_162 prop:cause kg:id_163 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "農林水産業費では、ツキノワグマの出没増加により、鳥獣被害対策実施隊の活動報酬を増額しております。"@ja.
<< kg:id_162 prop:countermeasure kg:id_163 >>
