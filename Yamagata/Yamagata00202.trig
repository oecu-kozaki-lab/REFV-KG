kg:op_8 prop:content "施設の在り方について意見を述べた"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_6.
kg:st_7 rdfs:label "矢口明子市長"@ja.
kg:st_7 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_9 prop:content "補正の主因の一つと説明した"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_7.
kg:op_10 prop:content "扶助費増額の要因と説明した"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_7.
kg:op_11 prop:content "家屋解体経費計上の要因と説明した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_7.
kg:op_12 prop:content "出没増加により活動報酬を増額したと説明した"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_7.
kg:op_13 prop:content "土木費増額の要因と説明した"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_7.
kg:op_14 prop:content "消防費増額の要因と説明した"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_7.
kg:op_15 prop:content "定期航路事業特別会計補正の理由と説明した"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_7.
kg:op_16 prop:content "補正の主因と説明した"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_7.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "オンライン市役所の窓口さかたコンポのサービスを開始し、市民が市役所に行かなくても可能な行政手続を増やすなど、市民サービス向上に努めました。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "道路などの破損箇所を市民が写真で報告できる機能を持つ、まちレポートを追加し、迅速な修繕などの対応に努めました。"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "若者の声を市政に反映するため、市長・若者カフェミーティングを開催し、参加者から様々な意見を頂戴いたしました。"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "計画などの策定時における市民参加方法の確認などを行う酒田市市民参加推進委員会を設置し、酒田市男女共同参画推進計画後期計画の策定過程においてワークショップを実施するなど、市民参加の機会確保に努めました。"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "東北公益文科大学の知見を活かし、ＩＴ技術を活用して地域で活躍する人材を育成するため、各種講座の開催や市内ＩＴ関連企業との連携事業を行いました。"@ja.
<< kg:id_9 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "東北公益文科大学の知見を活かし、ＩＴ技術を活用して地域で活躍する人材を育成するため、各種講座の開催や市内ＩＴ関連企業との連携事業を行いました。"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:text-txt_contents "卒業生の本市定住を促進するため、24名に対して奨学金の返還支援を行いました。"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:text-txt_contents "スクール・コミュニティ構想を推進するため、新たに地域プロデューサー１名を配置し、地域コミュニティ組織、小中学校などとの連携・協働を促し、中学校区をエリアとする地域づくりに取り組みました。"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "酒田市立第四中学校区内の義務教育環境の在り方について地域と協議を重ね、新しい学校づくりについて検討を進めました。"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:text-txt_contents "酒田市小中一貫教育ビジョンに掲げる、まなびの樹の根の力を育成するため、多様な考えを理解し、相互に協力しながら新たな価値を見いだす力をつける演劇ワークショップを教職員の研修を兼ねて、小学校１校で実施しました。"@ja.
<< kg:id_20 prop:countermeasure kg:id_21 >>
    prop:text-txt_contents "いじめや不登校などへの対応として、小中学校と教育相談室・教育支援センターの教育相談専門員、スクールカウンセラー、教育相談員、スクールソーシャルワーカーの連携を強化するなど、児童生徒一人一人のニーズに応じた指導に取り組みました。"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:text-txt_contents "小中学校に学習支援ソフトＣＢＴ　ｆｏｒ　ｓｃｈｏｏｌを導入し、児童生徒一人一人にとって個別最適な学びを推進するとともに、学習習慣の定着を図りました。"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:text-txt_contents "児童生徒がいつでも自身のＧＩＧＡスクール端末からＳＯＳを発信できる仕組みをつくり、令和５年７月に運用を開始しました。"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:text-txt_contents "学校施設では、特別教室にエアコンを整備したほか、熱中症対策として、中学校体育館に可搬式冷風機を２台ずつ整備しました。"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:text-txt_contents "史跡山居倉庫については、保存と活用に向けて公有化を進め、令和６年１月に土地の一部と倉庫10棟などの建物を購入しました。"@ja.
<< kg:id_30 prop:countermeasure kg:id_31 >>
    prop:text-txt_contents "酒田の歴史や文化を未来に伝える酒田市文化資料館光丘文庫のオープンに向け、酒田市総合文化センター内の改修工事を実施しました。"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:text-txt_contents "酒田市産業振興まちづくりセンターサンロクは、事業者間のプロジェクト組成や創業、事業承継、ＤＸ、サンロクＩＴ女子などの事業者コミュニティの活動支援を通じて、新たなビジネス創出や競争力強化に取り組みました。"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:text-txt_contents "情報サービス業などを対象とした賃借型立地企業定着促進助成金を通じた支援により、デジタル関連企業２社が立地したほか、用地取得や設備投資に対する支援を通じて、16社の競争力強化及び新規雇用を促進しました。"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:text-txt_contents "物価高騰の影響を受けた市民や事業者を支援するため"@ja.
<< kg:id_36 prop:countermeasure kg:id_38 >>
    prop:text-txt_contents "物価高騰の影響を受けた市民や事業者を支援するため、キャッシュレス決済ポイント還元キャンペーンを令和６年１月に実施し、約15億8,400万円の需要を創出しました。"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:text-txt_contents "キャッシュレス決済ポイント還元キャンペーンを令和６年１月に実施し、約15億8,400万円の需要を創出しました。"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:text-txt_contents "山形県とともに、酒田市沖における洋上風力発電事業の導入に向けた取組を進め"@ja.
<< kg:id_41 prop:effect kg:id_43 >>
    prop:text-txt_contents "国から海洋再生可能エネルギー発電設備整備促進区域指定ガイドラインに基づく有望な区域に整理されました。"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:text-txt_contents "若年層の地元就職を図るため、市内事業者による求人サイトの活用を支援しました。"@ja.
<< kg:id_44 prop:countermeasure kg:id_46 >>
    prop:text-txt_contents "企業訪問バスツアーの実施や高校生が個別訪問可能な企業のリスト化に取り組み、地元企業の事業内容などの周知に努めました。"@ja.
<< kg:id_44 prop:countermeasure kg:id_47 >>
    prop:text-txt_contents "企業訪問バスツアーの実施や高校生が個別訪問可能な企業のリスト化に取り組み、地元企業の事業内容などの周知に努めました。"@ja.
<< kg:id_48 prop:countermeasure kg:id_49 >>
    prop:text-txt_contents "日本一女性が働きやすいまちの実現に向けて、奨励金の交付や啓発セミナーの開催などを通じ"@ja.
<< kg:id_48 prop:countermeasure kg:id_50 >>
    prop:text-txt_contents "日本一女性が働きやすいまちの実現に向けて、奨励金の交付や啓発セミナーの開催などを通じ"@ja.
<< kg:id_48 prop:countermeasure kg:id_51 >>
    prop:text-txt_contents "女性活躍推進法に基づく一般事業主行動計画の新規策定及び女性が働きやすい職場づくりを支援しました。"@ja.
<< kg:id_48 prop:countermeasure kg:id_52 >>
    prop:text-txt_contents "女性活躍推進法に基づく一般事業主行動計画の新規策定及び女性が働きやすい職場づくりを支援しました。"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:text-txt_contents "行政、関係団体、民間で組織する酒田市スマートオーガニック検討会を令和５年５月に設立し、環境負荷の低減を図りながら、生産力向上と持続可能な農業の実現を目指し"@ja.
<< kg:id_53 prop:countermeasure kg:id_55 >>
    prop:text-txt_contents "地域内の資源循環の仕組みを構築するために、耕畜連携体制の強化に向けた支援を行い"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:text-txt_contents "対前年度比で33％増となる203ヘクタールに対して、もみ殻を活用した堆肥散布が行われた"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:text-txt_contents "拡大する松枯れに対し、松くい虫の防除や伐倒駆除を行いました。"@ja.
<< kg:id_57 prop:countermeasure kg:id_59 >>
    prop:text-txt_contents "拡大する松枯れに対し、松くい虫の防除や伐倒駆除を行いました。"@ja.
<< kg:id_57 prop:countermeasure kg:id_60 >>
    prop:text-txt_contents "拡大する松枯れに対し、松くい虫の防除や伐倒駆除を行いました。"@ja.
<< kg:id_61 prop:countermeasure kg:id_62 >>
    prop:text-txt_contents "水産資源を確保するため、種苗放流を行ったほか"@ja.
<< kg:id_63 prop:countermeasure kg:id_64 >>
    prop:text-txt_contents "水揚量・水揚金額の向上と効率的な漁業操業を支援するため、水産業成長産業化事業費補助金を交付しました。"@ja.
<< kg:id_65 prop:countermeasure kg:id_66 >>
    prop:text-txt_contents "生涯活躍のまち構想に基づき、官民連携により整備を進めたＴＯＣＨｉＴＯ（とちと）が令和５年６月に完成し"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:text-txt_contents "移住お試し住宅の１戸を除く17戸全てに移住者が入居しました。"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:text-txt_contents "若者や子育て世代に本市への移住をアピールするため、移住ポータルサイトａｔ　ｓａｋａｔａやＳＮＳ広告による情報発信を行った"@ja.
<< kg:id_68 prop:countermeasure kg:id_70 >>
    prop:text-txt_contents "全国の生活クラブ会員41万人に向けて、本市への移住に関する情報発信を行いました。"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:text-txt_contents "一般財団法人酒田ＤＭＯは、本市の自然環境や文化などの地域資源を活用したアドベンチャーツーリズムを推進するとともに"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:text-txt_contents "インバウンド誘客や地域産品販路拡大のための台湾プロモーションなどを実施しました。"@ja.
<< kg:id_75 prop:effect kg:id_76 >>
    prop:text-txt_contents "ＡＮＡ庄内－羽田線の令和５年１月から12月の搭乗者数は、期間増便により前年を10万人上回る33万5,000人となりました。"@ja.
<< kg:id_77 prop:effect kg:id_78 >>
    prop:text-txt_contents "クルーズ船寄港時には、古湊埠頭や中町での歓迎イベント、観光案内所設置などによるおもてなしを通じて、市内のにぎわい創出と地域経済の活性化につなげました。"@ja.
<< kg:id_77 prop:countermeasure kg:id_79 >>
    prop:text-txt_contents "クルーズ船寄港時には、古湊埠頭や中町での歓迎イベント"@ja.
<< kg:id_77 prop:countermeasure kg:id_80 >>
    prop:text-txt_contents "観光案内所設置などによるおもてなし"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:text-txt_contents "市民の経済的負担を軽減するため、国民健康保険財政調整基金を活用し、４年連続で国民健康保険税の税率を引き下げました。"@ja.
<< kg:id_81 prop:countermeasure kg:id_83 >>
    prop:text-txt_contents "令和６年度から令和８年度までの介護保険料を第８期に引き続き、引き下げました。"@ja.
<< kg:id_84 prop:countermeasure kg:id_85 >>
    prop:text-txt_contents "複雑かつ多様な困り事の相談を適切な支援につなげるため、介護、障がい、子育て、生活自立支援などの支援機関が連携して、包括的に支援する体制づくりを進めました。"@ja.
<< kg:id_84 prop:countermeasure kg:id_86 >>
    prop:text-txt_contents "福祉総合相談窓口の設置に取り組みました。"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:text-txt_contents "全ての市民が性別に関わりなく個人として尊重され、個性と能力を十分に発揮できる社会の実現に向けた取組を一層推進するため、酒田市男女共同参画推進計画の後期計画を策定しました。"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:text-txt_contents "全ての市民が性の在り方に関係なく、人生のパートナーと共に安心して暮らせるようパートナーシップ宣誓制度を令和５年４月から開始しました。"@ja.
<< kg:id_91 prop:countermeasure kg:id_92 >>
    prop:text-txt_contents "子育て世帯の負担軽減のため、子どもの医療費の無償化を高校３年生まで拡大した"@ja.
<< kg:id_93 prop:countermeasure kg:id_94 >>
    prop:text-txt_contents "学校給食の食材費高騰に対応するため、新型コロナウイルス感染症対応地方創生臨時交付金を活用し、給食費の保護者負担額を据え置きました。"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:text-txt_contents "酒田市こども家庭センターを設置し、妊娠期から出産・子育てまで一貫した相談支援体制を構築し、多様なニーズに即した支援を行いました。"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:text-txt_contents "妊産婦に対して、出産育児関連用品の購入や子育て支援サービスの利用負担を軽減する出産・子育て応援交付金を給付しました。"@ja.
<< kg:id_99 prop:countermeasure kg:id_100 >>
    prop:text-txt_contents "市民の結婚の希望をかなえるため、酒田市結婚サポートセンターによる相談・仲介支援を行った"@ja.
<< kg:id_99 prop:countermeasure kg:id_101 >>
    prop:text-txt_contents "ＡＩマッチングシステムを導入した、やまがたハッピーサポートセンターの登録料を助成しました。"@ja.
<< kg:id_99 prop:countermeasure kg:id_102 >>
    prop:text-txt_contents "結婚に伴う新生活に係る住宅費用などに対して支援しました。"@ja.
<< kg:id_103 prop:countermeasure kg:id_104 >>
    prop:text-txt_contents "生涯にわたる歯科疾病を予防するため、高校生を対象に口腔ケア向上の啓発などを行った"@ja.
<< kg:id_105 prop:countermeasure kg:id_106 >>
    prop:text-txt_contents "妊産婦とそのパートナーを対象に保健指導などを行い、生まれてくる子どもの口腔機能の発育についての意識啓発を図りました。"@ja.
<< kg:id_107 prop:countermeasure kg:id_108 >>
    prop:text-txt_contents "令和５年度の酒田看護専門学校の入学者は32名であり、市独自の授業料減免を実施した"@ja.
<< kg:id_107 prop:countermeasure kg:id_109 >>
    prop:text-txt_contents "市外からの入学者に対して住居費の支援を行いました。"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:text-txt_contents "家庭でのエネルギー地産地消による脱炭素を推進するため、オンサイトＰＰＡ方式による新築住宅などへの太陽光発電設備及び蓄電池の設置に対する支援制度を創設しました。"@ja.
<< kg:id_112 prop:countermeasure kg:id_113 >>
    prop:text-txt_contents "防災ラジオによる防災情報の伝達を全市域に展開するため、平田地域にコミュニティＦＭ中継局を整備した"@ja.
<< kg:id_112 prop:countermeasure kg:id_114 >>
    prop:text-txt_contents "緊急災害情報などを複数メディアに一斉配信可能な防災行政無線操作卓の更新を行い、迅速な情報伝達に努めました。"@ja.
<< kg:id_115 prop:countermeasure kg:id_116 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "防災や避難所運営に女性が積極的に参画できるようにするため、女性防災リーダー育成講座を開催したほか、履修者へのフォローアップ研修会にはコミュニティ振興会の役員も参加して、男女一緒に考える地区防災計画、スムーズな避難所運営についてのワークショップを行いました。"@ja.
<< kg:id_117 prop:countermeasure kg:id_118 >>
    prop:text-txt_contents "空き家等ネットワーク協議会と連携し、12件の空き家を利活用につなげました。"@ja.
<< kg:id_118 prop:effect kg:id_119 >>
    prop:text-txt_contents "空き家等ネットワーク協議会と連携し、12件の空き家を利活用につなげました。"@ja.
<< kg:id_120 prop:countermeasure kg:id_121 >>
    prop:text-txt_contents "令和４年８月に実施したるんるんバス及びデマンドタクシーの改編から約１年が経過したことから、公共交通に関するアンケート調査を実施しました。"@ja.
<< kg:id_120 prop:countermeasure kg:id_122 >>
    prop:text-txt_contents "るんるんバス体験乗車ツアーや地域住民への説明会を行い、地域公共交通の利用促進に努めました。"@ja.
<< kg:id_120 prop:countermeasure kg:id_123 >>
    prop:text-txt_contents "るんるんバス体験乗車ツアーや地域住民への説明会を行い、地域公共交通の利用促進に努めました。"@ja.
<< kg:id_124 prop:countermeasure kg:id_125 >>
    prop:text-txt_contents "定期船とびしまは、令和５年７月から８月まで、子ども無料キャンペーンを行った"@ja.
<< kg:id_124 prop:countermeasure kg:id_126 >>
    prop:text-txt_contents "漫画作品「しあわせ鳥見んぐ」とのコラボ企画により、令和６年度版飛島さんぽガイドマップを制作した"@ja.
<< kg:id_126 prop:effect kg:id_127 >>
    prop:text-txt_contents "令和６年度版飛島さんぽガイドマップを制作したところ多くの反響を呼び、新たな利用客層の増加につながりました。"@ja.
<< kg:id_128 prop:countermeasure kg:id_129 >>
    prop:text-txt_contents "とびしまマリンプラザの管理運営に指定管理者制度を導入し、合同会社とびしまが小規模店舗や食堂カフェを運営することとなり、島民や観光客へのサービス向上に努めました。"@ja.
<< kg:id_130 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "飛島の特定有人国境離島地域への追加指定に向け、令和６年３月に、山形県知事と酒田市長が連名で内閣府特命担当大臣に要望書を提出しました。"@ja.
<< kg:id_132 prop:countermeasure kg:id_133 >>
    prop:text-txt_contents "ＪＲ酒田駅を利用する高校生などの利便性を高めるため、駅前に合計400台分の駐輪場などを整備し、酒田駅前広場の整備が完了しました。"@ja.
<< kg:id_134 prop:countermeasure kg:id_135 >>
    prop:text-txt_contents "酒田商業高校跡地については、いろは蔵パーク株式会社と事業用定期借地権設定に関する覚書を締結し、令和７年３月の供用開始に向けた整備がスタートしました。"@ja.
<< kg:id_136 prop:countermeasure kg:id_137 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "庄内地域における広域水道企業団の設立に向けて、令和６年３月に本市と鶴岡市、庄内町による２回目の庄内広域水道事業統合準備協議会を開催しました。"@ja.
<< kg:id_138 prop:countermeasure kg:id_139 >>
    prop:text-txt_contents "文書管理システムを導入し、業務の効率化及び庁舎内スペースの有効活用を図った"@ja.
<< kg:id_140 prop:countermeasure kg:id_141 >>
    prop:text-txt_contents "地方公共団体情報システム標準化基本方針に基づき、自治体情報システムの標準化に向けた準備を進めました。"@ja.
<< kg:id_142 prop:countermeasure kg:id_143 >>
    prop:text-txt_contents "ふるさと納税による寄附金のほか、公共施設などのネーミングライツや未利用財産の売払い、風力発電事業の売電収益などによる歳入確保に取り組みました。"@ja.
<< kg:id_142 prop:countermeasure kg:id_144 >>
