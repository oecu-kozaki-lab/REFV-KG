kg:st_1 rdfs:label "武田恵子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "具体的な改善策の継続内容を明確にすべきと求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "矢口明子市長"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_2 prop:content "経常収支の改善には経常収入増加か経常支出削減しかなく公債費削減が重要と認識する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "これまでも事業見直しを進めてきたと説明する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "市債発行額抑制により財政健全化を目指す"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "大雨災害前は令和９年度に一定程度の健全化を見込んでいた"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "災害復旧に伴う市債発行額と公債費増加が不明で見通し困難とする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "土地建物とも売却実績がなく財源確保できなかったと説明する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "貸付けも含め有効活用に引き続き努める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "現状では十分な管理ができていないと認める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "管理改善に向け引き続き検討する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "売電収入を新たな財源として活用している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "ネーミングライツ制度化で財源確保に取り組む"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "公益ホールから水と毛布の要請があったと説明する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "使用状況調査を踏まえ補充を行い年度内に完了した"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "24時間対応可能な津波避難ビルへ新たに備蓄を配備する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "今回の災害を踏まえ当初予算での予備費増額が必要と感じる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "県内他市の状況も踏まえ5000万円程度が適切と考える"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_3 rdfs:label "田中斉議員"@ja.
kg:st_3 rdf:type cls:st_16.
kg:op_18 prop:content "猛暑と少雨が被害拡大の要因と指摘する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "夏の少雨と高温で被害が過去最大になったと認める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "切り残しが被害拡大を招いたと指摘する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "補助不足で被害量に対して伐倒量が追いついていないと説明する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "倒木のおそれがある枯松対策として新規事業を立ち上げた"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "6月までに伐倒できる制度予算確保と新対策を国県に要望する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "海水温上昇が全国的な資源減少要因と説明する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "違法操業増加も資源減少要因と説明する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "全国的にイカが取れない現状を懸念する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "自然回復を期待するしかない厳しい状況と説明する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "庄内沖で試験操業を行い新たな漁獲対象を探る"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "多様なイカ類の活イカ提供や活出荷でブランド化を進めたい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "二次交通が脆弱で観光に支障があると指摘する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "タクシーをつかまえにくい状況が早く帰ろうという行動につながる可能性があると認識する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "行政で直接改善は難しく観光需要拡大で改善を図る考えを示す"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "河川敷の浸水で何度も中止になっていると指摘する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "開催日前後の浸水が複数回あり課題と認識する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "シャトルバス確保が難しい課題があると説明する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "準備時期から開催当日まで猛暑日が続くことも課題とする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "持続可能な花火大会に向け実行委員会で十分に議論する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "海岸部の範囲や避難方法が伝わらず混乱を招くと指摘する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "避難場所確認の周知が重要とする"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "非常用持出袋の準備を推奨している"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "広報や出前講座で継続周知し防災訓練でも携行を行動基準にする"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "多様な手段で災害情報や避難情報を発信する態勢を整えた"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "県立高校に備蓄品が全く置かれていないのは自治会負担を増やすと指摘する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "一部高校は敷地内保管が難しく代替保管していると説明する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "県教育局への使用許可申請や代替保管で対応を進める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "一般事業主行動計画策定支援やえるぼし認定促進を進める"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "家事シェアの推進を重要施策として進める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "サンロクIT女子プロジェクトで多様な働き方と所得増加を図る"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "男女の給与収入格差が改善したと評価する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "市外にいる若者にも本市の変化を伝える必要があるとする"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "若い人に選ばれる企業になるため企業側の意識変革が必要とする"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "企業向け奨励金や見学ツアーで後押ししたい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "若年層の雇用機会拡大を図る"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "受講者の継続活動やIT企業就職など成果が出ていると評価する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "本市で暮らしながら県外IT企業で働く事例が出ている"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "登録者増に伴い業務獲得と体制強化が課題とする"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "成果品の質確保のため伴走支援が必要とする"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "若い女性から給与の高い県外企業へ転出した声を把握している"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "高校や若者の声として把握している"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "地元での職業生活への不安要因と捉える"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "戻らない要因の改善に向け包括的に取り組む"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:st_4 rdfs:label "TOCHiTO居住者"@ja.
kg:st_4 rdf:type cls:st_125.
cls:st_125 rdfs:label "居住者"@ja.
kg:op_62 prop:content "本格移住前に試せる低廉なシェアハウスがほしい"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:op_63 prop:content "地域活動や農家支援を通じてつながりを持ちたい"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_4.
kg:op_64 prop:content "移住相談では都市部のアパートや空き家を望む声が多いと捉える"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "民間事業者の整備を情報発信面で支援したい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "移住者同士や地域住民との交流機会を創出している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "住まいや仕事の相談に個別に寄り添って移住につなげたい"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "移住要望に沿った効果的な情報発信を進める"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "出張移住相談の場として今後も積極参加する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "任期後の定住実績が高く制度をさらに推進したい"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "解体撤去を検討する被災家屋が広範囲にあると認識する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "国の補助制度を活用し市が事業主体となって支援する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "半壊でも解体を検討している声を踏まえ市独自支援を提案した"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "企業向け支援制度の周知を進めている"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "法定雇用率引上げに対応し企業向けセミナーを開催予定とする"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "工賃向上に向け開催回数を増やしている"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "売上増加を踏まえ参画事業者拡大に取り組む"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "物品調達を通じて福祉的就労を支援する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "文書運搬や封入業務を集約して雇用創出した"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "新たに10名雇用し法定雇用率を達成した"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "市役所として法定雇用率を達成した"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:st_5 rdfs:label "斎藤周議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_82 prop:content "公立化しなくても学生は集まるのではないかと疑問を呈する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_5.
kg:op_83 prop:content "国公立志向と学費低下により志願者増が期待できると説明する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "教育研究活動や消費などによる経済波及効果があると説明する"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "市への効果は約79％と分析している"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "令和6年10月を目途に準備委員会を設置し必要事項を審議検討する"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:op_87 prop:content "令和8年4月の公立化を目指し事前協議と認可申請を進める"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_2.
kg:op_88 prop:content "積立基金を来年度の税率据置き財源に活用できないか求める"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_5.
kg:op_89 prop:content "償還財源に予定しており令和7年度財源活用は難しいとする"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_2.
kg:op_90 prop:content "維持管理経費を踏まえ統一基準が必要だったとする"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
kg:op_91 prop:content "市民全体で維持する方法も考えるべきと主張する"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_5.
kg:op_92 prop:content "利用者と非利用者の負担公平性を図るためと説明する"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "見直し方針に基づき令和7年4月に再見直しする"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
kg:op_94 prop:content "前回は周知不足もあったため今回はきめ細かく周知する"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_2.
kg:op_95 prop:content "公共施設適正化懇談会で意見を聴取し利用増加策を進める"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_2.
kg:op_96 prop:content "新たな利用を創出する設備対応を進める"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_2.
kg:op_97 prop:content "維持管理費が下がれば使用料も下がる可能性がある"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_2.
kg:op_98 prop:content "利用者が増えれば使用料は下がり減れば上がる仕組みと説明する"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_2.
kg:op_99 prop:content "維持管理費低下と稼働率向上により引下げとなった"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "財政硬直化から脱却するためには、経常的な収入を増やすか、経常的な支出を減らすしかないため、これまでも事業の見直しを進めてまいりましたが、特に経常経費で占める割合が高くなっている公債費を減らすため"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "これまでも事業の見直しを進めてまいりました"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "令和５年度からはプロジェクト３０－３０を掲げ、市債発行額を抑制することによる財政の健全化を目指しております"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "中期財政計画上では、今後もこれを継続していけば、令和９年度には一定程度の財政の健全化が達成できると見込んでおりました"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "今般の大雨災害復旧に対する市債発行額が幾らになるのか、その結果公債費がどこまで増えるのか想定できておらず、現段階では見通しが難しい状況です"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "令和５年度は土地建物ともゼロ件で、財源の確保はできませんでした"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "貸付けも含めて、未利用財産の有効活用に引き続き努めてまいりたいと思います"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "市有林が災害時に流木などの危険木とならないようにするには、日頃から樹木及びその周辺の手入れが非常に大切でありますが、現状では十分にできていない状況であります"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "引き続き、何ができるか検討してまいりたいと考えております"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "これまで風力発電事業での売電収入の活用"@ja.
<< kg:id_15 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "令和５年度に制度化しましたネーミングライツ料などで財源確保に取り組んでおります"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "指定緊急避難場所である東北公益文科大学公益ホールから、津波警報発令が長引く可能性があり、暖を取りたいので、水と毛布を配備してほしいという要請"@ja.
<< kg:id_18 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "その結果を踏まえまして、一部予備費を充用し、食料と水の補充を行いました"@ja.
<< kg:id_18 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "津波避難ビルのうち24時間対応可能な６か所につきましては、備蓄ゼリーと水、それから暖を取るためのアルミシートの購入費を今年度の６月補正予算で計上し、お認めいただいておりまして、11月末までに配備する予定"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "今回の災害を振り返りますと、当初予算での予備費の計上をもっと増やす必要性を感じております"@ja.
<< kg:id_22 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "今回の災害の初動にかかった経費や県内他市の状況から見ますと、5,000万円程度が適切ではないかと感じております"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "異常な高温少雨と前年の切り残しが相当あって１万4,453立方メートルに拡大し"@ja.
<< kg:id_25 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "異常な高温少雨と前年の切り残しが相当あって１万4,453立方メートルに拡大し"@ja.
<< kg:id_25 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "令和６年度も、国庫補助金の要望額に対し交付額が十分ではないため、被害量に対して伐倒量が追いついていない状況であります"@ja.
<< kg:id_25 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "令和６年度からは、倒木のおそれがある枯松について、市民生活の安全を確保するため、海岸林枯松二次被害防止緊急伐倒事業を森林環境譲与税を活用して新規に立ち上げました"@ja.
<< kg:id_25 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "まずはカミキリ虫が羽化する６月までに切ることができるよう、現行制度の予算を十分に確保するとともに、枯松の倒木や枝の落下から市民や農業者・農業施設を守るための新たな対策を講ずるように国や県に対して要望をしてまいります"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "海水温の上昇によるイカの稚魚の生育不良"@ja.
<< kg:id_31 prop:cause kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "国内漁場での外国漁船による違法操業の増加などの要因が重なり、全国的に資源量が減少しております"@ja.
<< kg:id_31 prop:effect kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "全国的に資源量が減少しております"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "山形県水産研究所では、漁業者の協力を得て、庄内沖で試験操業を実施しております"@ja.
<< kg:id_35 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "ケンサキイカを含め、ヤリイカやアオリイカなど様々なイカ類の活イカ提供や活出荷など、生きたまま活用することによる付加価値向上とブランド化を進められるように"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "夜間観光や繁華街での飲食時にタクシーをつかまえにくい状況がありまして、それが繁華街での滞在時間の短縮、つまり早く帰ろうということにつながっている可能性もあります"@ja.
<< kg:id_38 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "観光客をさらに増やすことによって、夜のタクシー営業はもうかる、稼げるという状況をつくっていくことが必要だと考えております"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "開催日前後の時期で最上川河川公園の浸水は平成30年度からの７年間で４回に及んでおります"@ja.
<< kg:id_41 prop:cause kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "８月第一土曜日という酒田の花火の日程が東北地方の主な夏祭りと重なっていることで、シャトルバスの確保が難しいという問題"@ja.
<< kg:id_41 prop:cause kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "準備時期から開催当日まで猛暑日が続いて、作業員や観客の熱中症リスクが高まっていることも課題"@ja.
<< kg:id_41 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "花火大会の開催場所や開催日の変更につきましては、今述べた項目を整理、検討いたしまして、実行委員会で十分な議論を行ってまいりたい"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "能登半島地震の際は、避難場所が分からないといった問合せ"@ja.
<< kg:id_46 prop:cause kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "何も持たずに避難した結果、空腹を訴える避難者が多かったです"@ja.
<< kg:id_46 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "市民の皆様に日頃から避難場所を確認しておくこと、それから個人防災グッズ、いわゆる非常用持出袋の準備を推奨しております"@ja.
<< kg:id_46 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "酒田市ホームページ、公式ＬＩＮＥ、緊急速報メール、Ｘ（旧ツイッター）、そしてフェイスブックなど多様な手段で災害情報や避難情報を発信する態勢を整えた"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "酒田西高校と酒田南高校は、敷地内に備蓄品を置くことが難しいことから、現在は旧第五中学校校舎内に保管をしております"@ja.
<< kg:id_51 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "令和５年度から学校側と協議をしております。酒田光陵高校は、学校施設内の一部を保管場所として借用するため、現在、県教育局に教育財産使用許可申請書を提出しておりまして、許可が下り次第、備蓄品を納入することにしております"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "本市では、働きやすい職場環境の整備、家庭との両立支援、女性のチャレンジ支援を三本柱とした取組"@ja.
<< kg:id_54 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "家事シェアを推進するため、「家事シェアのススメ」というパンフレットを作成し、令和３年度以降、啓発に取り組んでまいりました"@ja.
<< kg:id_54 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "女性のＩＴスキル向上による多様な働き方の推進と所得の増加を目的とするサンロクＩＴ女子プロジェクトを進めてまいりました"@ja.
<< kg:id_54 prop:effect kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "男性を100とした場合の女性の給与水準につきましては、日本一女性が働きやすいまち宣言をした平成29年度の61.5から直近の令和５年度では64.9となりまして、男女の給与収入の格差が3.4ポイント改善しております"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "本市では女性が働きやすい企業が増えているということ、それからＩＴ企業の集積が進んできているということをもっと周知していくことが必要だと考えております"@ja.
<< kg:id_59 prop:cause kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "自分たち企業が意識改革をして、若い人に選ばれる企業になる、そういう企業の意識変革が必要ではないか"@ja.
<< kg:id_59 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "今後は市内企業の見学ツアーをえるぼし認定企業に絞って行うことなどによりまして、後押ししていきたい"@ja.
<< kg:id_59 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "ＩＴ企業であったり、賃金水準の高い成長分野の製造業の新規企業立地をさらに促進したり、あるいは立地済みの優良企業の事業拡張を支援することによりまして、若年層の雇用機会の拡大に努めていきたい"@ja.
<< kg:id_64 prop:effect kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "令和５年度末時点でサンロクＩＴ女子として活動を継続している方は77名となっております"@ja.
<< kg:id_64 prop:effect kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "令和５年度までに３名の方が県外のＩＴ企業に就職して、本市で生活しながらリモート勤務を実際に行っております"@ja.
<< kg:id_64 prop:cause kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "課題としましては、サンロクＩＴ女子の登録者数が増加してきたことで、これまで以上の業務の獲得が必要になってきていること、また、多様な登録者に合った多様な業務をマッチングしていくための体制強化が必要"@ja.
<< kg:id_64 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "プロのスタッフの伴走支援などによる、さらなるＩＴスキルの向上も必要だと考えております"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "３年勤めても全く給与が上がらない、一人暮らしもしたいけれども、経済的な余裕がないので、給与の高い県外の企業に就職、転出をしたという若い女性の声があります"@ja.
<< kg:id_69 prop:cause kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "地元庄内では専門性の高い、自ら成長できるやりがいのある仕事がないと判断して、県外就職にチャレンジする生徒が増えている"@ja.
<< kg:id_69 prop:cause kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "仕事、家事、地域行事など頑張り過ぎている母親を見て、地元での職業生活に不安を感じている"@ja.
<< kg:id_69 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "企業の意識改革、それから、新しい企業の誘致、そして、ジェンダー平等の風土醸成に取り組んでいるところであります"@ja.
<< kg:id_74 prop:cause kg:id_75 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "お試し移住をするために低廉な家賃で入居できるシェアハウスがあったらいいなという声"@ja.
<< kg:id_74 prop:cause kg:id_76 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "地域の人たちとつながりを持ち様々な地域活動をしていきたいという声、特に地域の農家とつながって農家を支援していきたいという声"@ja.
<< kg:id_74 prop:effect kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "やはり便利のよい都市部でアパートや一戸建ての空き家を借りて暮らしたいという希望を持っている方が多い"@ja.
<< kg:id_74 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "シェアハウスというお声につきましては、ＴＯＣＨｉＴＯを運営している民間事業者が、新たに中町エリアに整備を進めております"@ja.
<< kg:id_74 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "本市では移住者同士のつながりをつくることを狙いとした移住者交流会を開催しております"@ja.
<< kg:id_74 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "市の移住相談員やＵＩＪターンコーディネーターが、移住希望者のニーズに寄り添った伴走型の丁寧な対応を行うことで移住に結びつけていきたい"@ja.
<< kg:id_74 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "移住に興味のある方々の会員登録者数５万人を超えるオンラインマッチングサービスがあるのですけれども、それを利用しまして、移住要望に沿った効果的な情報発信を行っていきたい"@ja.
<< kg:id_74 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "首都圏で行われている全国移住フェアなどのイベントは、本市の出張移住相談の場としての役割を果たしているということが確認できましたので、今後も積極的に参加していきたい"@ja.
<< kg:id_74 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "地域おこし協力隊につきましても、３年の任期終了後におよそ半数以上の方、本市ではこれまでの実績で62.5％の方が地域への定住をしていることから、地域おこし協力隊の制度についても、さらに力を入れて推進していきたい"@ja.
<< kg:id_84 prop:cause kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "浸水等による被害を受けた家屋が市内の広範囲にあり、被災家屋の解体撤去について検討している方もおられる"@ja.
<< kg:id_84 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "罹災証明書により全壊の判定を受けた家屋について、所有者からの申請により市が解体撤去の支援を行う"@ja.
<< kg:id_84 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "半壊でも解体を検討しているなども多く聞かれたため、それらの声を踏まえまして、市の単独事業として一律の給付金を支給する事業をこのたび提案"@ja.
<< kg:id_88 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "障がい者を雇用する企業を対象とした特定求職者雇用開発助成金などの各種助成金やジョブコーチ支援について、市内企業に周知をした"@ja.
<< kg:id_88 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "今年度は障がい者雇用に関する企業向けのセミナーも開催する予定"@ja.
<< kg:id_88 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "はっぴいバザーについては、令和６年度は開催回数を年４回から年６回に増やし、売上げを増やせるように取り組んでいる"@ja.
<< kg:id_88 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "市役所内に開設している障がい者就労支援カフェ「えーる」につきましては、令和５年度に売上げが増加いたしました。令和６年度には、参画する事業者をさらに増やせるよう取り組んでいる"@ja.
<< kg:id_88 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "酒田市障がい者就労施設等からの物品等調達方針を策定しておりまして、市役所が障がい者就労施設等から優先的に物品等の調達を行う"@ja.
<< kg:id_88 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "軽微な業務を集約することによりまして、障がい者の方が行う業務の創出を行った"@ja.
<< kg:id_88 prop:effect kg:id_95 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "障がいのある方を新たに10名、会計年度任用職員として雇用できました"@ja.
<< kg:id_88 prop:effect kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "令和５年12月１日時点で障がい者雇用率は2.67％となり、法定雇用率2.6％を達成した"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_82;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "公立化することにより入学志願者が増加する大きな理由としては、受験生や保護者の国公立大学に対するブランド意識が根強く、国公立大学への入学志向が高いこと、それから、授業料などの学費が私立大学に比べて安くなることが挙げられます"@ja.
<< kg:id_97 prop:effect kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "庄内地域への年間の経済波及効果は13億2,300万円"@ja.
<< kg:id_97 prop:effect kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "このうち本市への効果は約79％、10億4,500万円でありました"@ja.
<< kg:id_97 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "令和６年10月を目途に公立大学法人設立準備委員会（仮称）を設置して、公立大学法人の組織や定款、中期目標、中期計画、財務会計、労務給与、機能強化など、公立化等に必要な事項を審議・検討していく"@ja.
<< kg:id_97 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "公立化には総務省と文部科学省への公立大学法人設立認可申請が必要となるため、それぞれの省と事前協議を行いながら、令和７年度中に認可申請を行い、令和８年４月の公立化を目指していきます"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_88;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "令和５年度の保険給付等の実績による普通交付金の償還金が約１億7,000万円となっております。積み立てる約２億円は、その財源として予定しているために、令和７年度の財源として活用することは難しい状況"@ja.
<< kg:id_105 prop:cause kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "施設維持に係る経費をできる限りカバーするため"@ja.
<< kg:id_105 prop:cause kg:id_107 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_91;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "施設を利用する人としない人との負担の公平性を図る料金設定とするため"@ja.
<< kg:id_105 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "原則５年ごとに必要に応じ見直しを実施することとしていたため、令和７年４月に見直しをする"@ja.
<< kg:id_105 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "今回は市の広報、ホームページ、ＳＮＳなどでお知らせするとともに、各施設の利用者団体の皆様に対しては見直し内容の館内への掲示や説明を行うなど、きめ細かい周知を図ってまいります"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "利用団体の皆様の意見を聞きながら利用者を増やす取組を行っております"@ja.
<< kg:id_110 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "出羽遊心館では、ケータリング等に対応するための電子レンジの設置や各種イベントに対応するためのＷｉ－Ｆｉの設置など、今年度から新たな利用を創出するための取組を行っております"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "施設の光熱水費や施設管理委託料等が下がれば使用料も下がることが考えられます"@ja.
<< kg:id_113 prop:cause kg:id_115 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "使用料の算定には施設の稼働率も計算に入れておりまして、利用者が増加すれば使用料は下がり、利用者が減少すれば使用料は上がる"@ja.
<< kg:id_113 prop:effect kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "平田体育館について、消耗品費と修繕費がなくなったことにより維持管理費が下がりました。そして、クレーコートを利用する団体や個人が増え、稼働率が上がったため、使用料を引き下げることになっております"@ja.
}
