kg:id_100 rdf:type cls:c_11695.
cls:c_11695 rdfs:label "受信困難地区"@ja.
kg:id_101 rdfs:label "戸別受信機の再配備を検討する"@ja.
kg:id_101 rdf:type cls:c_11696.
cls:c_11696 rdfs:label "受信機配備"@ja.
kg:id_100 prop:countermeasure kg:id_101.
kg:id_102 rdfs:label "職員配置の課題"@ja.
kg:id_102 rdf:type cls:c_11697.
cls:c_11697 rdfs:label "職員配置課題"@ja.
kg:id_103 rdfs:label "若年退職者が多い"@ja.
kg:id_103 rdf:type cls:c_11698.
cls:c_11698 rdfs:label "若年退職"@ja.
kg:id_102 prop:cause kg:id_103.
kg:id_104 rdfs:label "再任用制度や定年延長で職員全体が高齢化していく"@ja.
kg:id_104 rdf:type cls:c_11699.
cls:c_11699 rdfs:label "職員高齢化"@ja.
kg:id_102 prop:effect kg:id_104.
kg:id_105 rdfs:label "学校技能労務職員の減少"@ja.
kg:id_105 rdf:type cls:c_11700.
cls:c_11700 rdfs:label "技能職員減少"@ja.
kg:id_106 rdfs:label "新しく採用された会計年度任用職員の指導が正職員の負担になる"@ja.
kg:id_106 rdf:type cls:c_11682.
kg:id_105 prop:effect kg:id_106.
kg:id_107 rdfs:label "市で研修の機会を設定し力量を上げる"@ja.
kg:id_107 rdf:type cls:c_870.
cls:c_870 rdfs:label "研修実施"@ja.
kg:id_105 prop:countermeasure kg:id_107.
kg:id_108 rdfs:label "災害時の避難所運営"@ja.
kg:id_108 rdf:type cls:c_1340.
cls:c_1340 rdfs:label "避難所運営"@ja.
kg:id_109 rdfs:label "７月25日から26日にかけて夜通しの業務となった"@ja.
kg:id_109 rdf:type cls:c_11701.
cls:c_11701 rdfs:label "長時間業務"@ja.
kg:id_108 prop:effect kg:id_109.
kg:id_110 rdfs:label "毎回違う避難所への動員で業務内容の把握に手間取った"@ja.
kg:id_110 rdf:type cls:c_4025.
cls:c_4025 rdfs:label "運営混乱"@ja.
kg:id_108 prop:effect kg:id_110.
kg:id_111 rdfs:label "今後に生かすため職員の要望や感想を把握する"@ja.
kg:id_111 rdf:type cls:c_10546.
cls:c_10546 rdfs:label "運営改善"@ja.
kg:id_108 prop:countermeasure kg:id_111.
kg:st_1 rdfs:label "後藤啓議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "冬を迎える中で復旧に向けた対応が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "来年以降の農作業の段取りができず不安が募っている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "全てを失った被災者に寄り添う支援が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "農業者も具体的な復旧時期の情報を必要としている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "農地復旧の説明会を各地で開催すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "被災者に寄り添って使えなくなった建物の解体撤去への支援を検討すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "早期の土砂・流木撤去の見通しが必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "農道や水路の復旧も含めて来年作付への影響を抑えるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "高齢者世帯では手に負えず引き続き支援施策が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "被災商店の経営継続を支援する方策が必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "地域の商店を残す方策が必要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "来年以降の作付に影響するため復旧予定を示すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "農道、水路、給水路、排水路の復旧予定の周知が必要"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "来年以降の作付に影響するため早期復旧が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "木材業者の仕事に支障があるため早急な復旧が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "林道の復旧予定と説明会が必要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "集落内水路の復旧への対応が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "生活に支障が生じているため早期復旧が必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "集落内水路の閉塞解消を急ぐべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:st_2 rdfs:label "安川智之副市長"@ja.
kg:st_2 rdf:type cls:st_40.
cls:st_40 rdfs:label "副市長"@ja.
kg:op_20 prop:content "全壊家屋等は全額公費で解体撤去する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "生活再建支援制度と併せて活用できる給付制度とした"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "倉庫や空き家など非住家の被災の程度を証明する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "非住家でも全壊同等なら全額公費の対象にする運用を行う"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "被災者の意向を伺いながら個別相談で対応する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "市が重機で入れる範囲は撤去を進めている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "今後もボランティアの協力を仰ぎ非住家部分も支援する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "県と市で保証料の一部を負担する融資制度で支援する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "被災事業者の円滑な復旧を直接支援する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "被害状況に応じて複数の制度を活用して復旧する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "国の災害査定後に市の公共事業として発注する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "被害箇所が多いが全体として３年をめどに復旧したい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "早期撤去可能な部分は別制度を活用する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "刈屋地区は10月8日に実施し八幡地域は4地区で順次説明する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "被害箇所が多いが３年をめどに復旧したい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "林業事業体と対話し優先順位を共有して早期復旧に努める"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "生活に支障が生じている水路は現状確認の上で市が対応する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "スピード感がある場合は事業活用を勧める"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "地域住民対象の説明会や個別説明をもっと周知すべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:st_3 rdfs:label "久保賢太郎農林水産部長"@ja.
kg:st_3 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_39 prop:content "申請書類や窓口、締切りなどを広く周知する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:st_4 rdfs:label "前田茂男総務部長"@ja.
kg:st_4 rdf:type cls:st_18.
kg:op_40 prop:content "被災者に寄り添い支援が行き届くよう対応する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:st_5 rdfs:label "齋藤美昭議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_41 prop:content "教員の負担軽減と部活動の質的向上が必要"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "ミスマッチ解消のため部活動指導員が重要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:st_6 rdfs:label "堀賀泉教育次長"@ja.
kg:st_6 rdf:type cls:st_48.
cls:st_48 rdfs:label "教育次長"@ja.
kg:op_43 prop:content "教員の負担軽減が図られた"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_6.
kg:op_44 prop:content "全ての中学校が高く評価している"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "大会引率の負担軽減も考え前年度より4名増員した"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "部活動改革を進める上で人材発掘が課題"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:op_47 prop:content "平日の夕方に指導できる人材発掘を進めたい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:st_7 rdfs:label "矢口明子市長"@ja.
kg:st_7 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_48 prop:content "人口減少問題に正面から向き合う方向性は変えない"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_7.
kg:op_49 prop:content "急激な人口減少が様々な問題の根本原因"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_7.
kg:op_50 prop:content "人口減少が地域課題の背景にある"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_7.
kg:op_51 prop:content "小売店の閉鎖も急激な人口減少が原因"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "待ったなしの状況で強い危機感を持っている"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_7.
kg:op_53 prop:content "加速度的に進んでおり待ったなしの状況"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "人口減少抑制には若い女性の定着が重要"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "市民所得向上につながる産業振興が必要"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "働きたい全ての市民が活躍できる環境整備が必要"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_7.
kg:op_57 prop:content "女性だけに負担を押し付けない地域づくりが必要"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_7.
kg:op_58 prop:content "気候変動がもたらす災害への対応を強化する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_7.
kg:st_8 rdfs:label "田中廣議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_59 prop:content "地域限定でも防災ラジオから積極的に放送すべき"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_8.
kg:op_60 prop:content "防災ラジオから積極的な避難情報があれば早く行動できた"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_8.
kg:st_9 rdfs:label "那須欣男危機管理監"@ja.
kg:st_9 rdf:type cls:st_56.
cls:st_56 rdfs:label "危機管理監"@ja.
kg:op_61 prop:content "防災ラジオは通常放送に割り込む仕組みのため地域限定放送はできない"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_9.
kg:op_62 prop:content "市から要請して防災情報を放送してもらった"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_9.
kg:op_63 prop:content "防災行政無線屋外子局の限界を踏まえ再配備を検討したい"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_9.
kg:op_64 prop:content "採用でカバーし切れない状況がある"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_4.
kg:op_65 prop:content "若い職員の自由な発想を生かせる職員体制でありたい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_4.
kg:op_66 prop:content "市で研修の機会を設定することが大事"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_6.
kg:op_67 prop:content "スマップなど経験豊かな先輩職員からノウハウを吸収する機会も必要"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_6.
kg:op_68 prop:content "災害発生から8月末までは災害応急業務を優先した"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_4.
kg:op_69 prop:content "反省点を踏まえ今後うまく流れるよう工夫したい"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_4.
kg:op_70 prop:content "避難所配置や体制の反省点を今後に生かす"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "７月25日の大雨の際、最上川をはじめ市内の河川、水路の増水で、多くの住宅が浸水被害に見舞われました"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "日向川、荒瀬川も過去になかったほどの増水で、農地が冠水し、流域の田んぼ、刈屋梨の畑も被災しました"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "多くの住宅が浸水被害に見舞われました"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "農地への浸水も甚大で、米の収穫もできないほどになりました"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "農地が冠水し、流域の田んぼ、刈屋梨の畑も被災しました"@ja.
<< kg:id_5 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "住宅、農地、自家用車、農機具なども被災し使い物にならなくなり、全てを失った方々には、かける言葉もありませんでした"@ja.
<< kg:id_5 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "流木、土砂で埋まった田んぼはほとんど機械が入れない"@ja.
<< kg:id_5 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "見た目は被災を免れたような田んぼでも、中に入れば細かな流木、土砂が入っており、流木を撤去しながら、コンバインを壊さないよう、手探りで刈り取りをするといった光景が見られました"@ja.
<< kg:id_5 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "住宅敷地内の倉庫、車庫、敷地内に残った土砂の撤去が進まないところもまだまだあります。特に高齢者世帯では手に負えないといった現状です"@ja.
<< kg:id_5 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "商売をしている商店も土砂流入により被災しました。ショーケースが使えなくなった、商品が流された、あるいは土砂に埋まってしまったといった被害に遭い、営業継続をあきらめる店もあります"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "商店の廃業は地域の高齢者の買物拠点の喪失になります"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "農道、水路も斜面崩壊からの土砂堆積、農道、水路の崩落で"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "農道、水路の崩落で農地、田んぼへ行けない"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "水路の土砂堆積などで被災を免れた田んぼに水が入らないなどの影響がありました"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "立木が林道をふさいだり、路面が崩落したりといった状況になっております"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "木材業者の仕事にも支障があるため、早急な復旧が求められています"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "集落内の水路、農業用水路、法定外公共物の水路も土砂で埋まり機能していない状況があります"@ja.
<< kg:id_24 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "各家庭からの生活排水路となっているものもあり、浄化槽が機能しない"@ja.
<< kg:id_24 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "水路からあふれて田んぼに流入している箇所もあります"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "全壊の罹災証明を受けました被災家屋等の解体及び撤去を全額公費で行います大雨災害公費解体事業"@ja.
<< kg:id_30 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "大規模半壊、中規模半壊、半壊の被害認定を受けた被災家屋の解体及び撤去について給付金を市の単独経費として支給いたします大雨災害被災家屋撤去支援事業"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "市がこれから独自に調査し、罹災証明とは異なる被災証明書を今後発行していく予定でございます"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "倉庫や車庫等が仮に全壊同等と認定されることによって、その被災した倉庫や車庫については、大雨災害公費解体事業、全額公費の事業の対象とすることができるという運用をしてまいりたい"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "被災者の御意向を伺う機会として事前相談も予定しておりまして、解体及び撤去を検討している方の御意向を伺いながら個別に相談して、適切な対応をしてまいりたい"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "敷地内の土砂につきましては、これまでも道路の土砂撤去の際に重機が入れる範囲で市による撤去、土砂回収を行っております"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "建物内からの土砂排出につきましては、災害ボランティアの皆様の協力を得て実施しているところでございます"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "県では、７月26日に商工業振興資金、経営安定資金第４号というものでございますが、対象となる災害に今般の大雨災害を指定したところでございます。この資金については、市町村も保証料の一部を負担する融資制度でございまして、本市も山形県とともに資金面での支援を開始しているところです"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "山形県が被災中小企業支援事業費補助金を創設し、10月９日から申請の受付を始めました。補助金の概要は、企業が所有する建物、機械設備、車両の復旧費を補助の対象とし"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "農地・土地改良施設の復旧には、国の補助を受けて市が行う公共災害復旧事業と、山形県及び本市の補助金を受けて農業者自らが行う小規模農地等災害緊急復旧事業、そして多面的機能支払交付金事業による災害復旧の３点がございます"@ja.
<< kg:id_48 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "刈屋の梨畑や八幡地域の田んぼの土砂、流木の撤去については、基本的には公共災害復旧事業による撤去を想定しているところでございます"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "八幡地域につきましても、被害箇所が多いため、刈屋同様に見通しは完全に立っているわけではございませんが、３年をめどに復旧したいと、全体としては考えております"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "比較的被害の小さい場所につきましては、小規模農地等災害緊急復旧事業や多面的機能支払交付金事業を活用いただいて、早期撤去可能な部分もある"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "刈屋地区への説明は10月８日に実施いたしました。八幡地域への説明は10月中旬から、４地区に対して順次開催する予定でございます"@ja.
<< kg:id_16 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "農道、水路の復旧につきましても、公共災害復旧事業による復旧が想定されます。こちらも３年をめどに復旧したいと考えております"@ja.
<< kg:id_21 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "公共災害復旧事業を活用して、３年をめどに復旧していくという点は変わりがございません。改めてこちらにつきましても説明会を開催しまして、林道事業体の皆様との共通認識の下、復旧する路線の順位、順序、時期等について理解いただいて、早期復旧に努めてまいりたい"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "生活に支障が生じている集落内の水路につきましては、現状を確認した上で、市が土砂撤去、閉塞の解消を行っているところでございます"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "集落内水路が農業用水路や排水路といった農業施設であった場合には、各種農業用施設の災害復旧事業も活用可能でございます"@ja.
<< kg:id_62 prop:effect kg:id_63 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "この使える支援制度をまだ申請していない方も多いようです"@ja.
<< kg:id_62 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "今後、申請に必要な書類や申請窓口、それから申請の締切りなど、そういった手続の情報を広報とか、農協、総合支所、コミュニティセンターなどにチラシを配置するとか、様々な媒体を使って支援が必要な方に対して広く周知できるようにしていきたい"@ja.
<< kg:id_65 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "10月１日から復興本部を立ち上げまして、そういった支援制度の申請漏れがないような体制をしっかり取っているところでございます"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "制度化された背景には、中学校部活動に従事する時間の増加や"@ja.
<< kg:id_67 prop:cause kg:id_69 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "競技経験のない教員が部活動を指導することによる負担などがありました"@ja.
<< kg:id_70 prop:effect kg:id_71 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "教員の時間外在校時間調査の結果で、勤務時間外の主な業務のうち部活動に係る時間数が大幅に減少しています"@ja.
<< kg:id_70 prop:effect kg:id_72 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "各中学校を対象にしたアンケート調査では、「生徒の技術力向上につながっている」"@ja.
<< kg:id_70 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "令和６年度、スポーツ・文化活動支援事業の取組状況としましては、前年度と比較し部活動指導員を４名増員し17名、内訳として運動部16名、文化部１名を16の部活動に配置しております"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "本市に平日に部活動を指導できる方がどの程度いるのか把握できておらず、指導できる人材発掘が喫緊の課題である"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "スポーツ・文化サポーターバンクへの登録の周知を行うとともに、各協会や連盟、退職教員、スポーツに親しんでいる若者、地元の大学生等への働きかけが必要だと考えています"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "地域、あるいは職場における担い手の不足"@ja.
<< kg:id_78 prop:cause kg:id_80 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "空き家の増加"@ja.
<< kg:id_78 prop:cause kg:id_81 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "保育園や学校の統合問題"@ja.
<< kg:id_78 prop:cause kg:id_82 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "小売店の閉鎖など、酒田で起きている様々な問題の原因は急激な人口減少である"@ja.
<< kg:id_78 prop:effect kg:id_83 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "令和６年８月末現在で９万4,464人、昨年の８月末は９万6,228人でございましたので、1,764人がこの１年間で減少しております"@ja.
<< kg:id_78 prop:effect kg:id_84 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "令和６年出生数は360人前後となる見込みになっております"@ja.
<< kg:id_78 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "若い女性が都会へ出ていかないように、仕事の選択肢とジェンダー平等な風土をこの酒田につくっていくこと"@ja.
<< kg:id_78 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "特に外貨を稼ぐ産業、すなわち観光や移出・輸出に力を入れていくこと"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "保育や介護のサービスを充実させること"@ja.
<< kg:id_87 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "家事を女性だけに押し付けるのではなくて家族全員で分担するという、ジェンダー平等意識を地域に醸成していくことが重要"@ja.
<< kg:id_90 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "令和７年度は、令和６年度の四つの方向性に災害からの復興や安心・安全のまちづくりを加えまして"@ja.
<< kg:id_92 prop:effect kg:id_93 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "今回のような豪雨や強風のときは、防災行政無線のスピーカーから流れてくる放送はほとんど聞き取ることができず、全く機能していなかった"@ja.
<< kg:id_94 prop:effect kg:id_95 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "何を言っているのか分からない屋外スピーカーで、大きな音で繰り返し放送されるのは、ただただ恐怖心をあおられただけであります"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "防災ラジオはＦＭハーバーラジオの通常放送に割り込んでの放送となるため、地区を選んでの放送はできません"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "酒田エフエム放送株式会社との災害時の放送要請に関する協定により、市から同社へ要請し、防災情報を通常番組の生放送中に放送してもらっております"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "防災ラジオの電波の届かない地区への戸別受信機の再配備を検討していきたい"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "若年退職者が多いという実情もございます"@ja.
<< kg:id_102 prop:effect kg:id_104 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "再任用制度、退職延長ということになると、やはり職員全体が高齢化していくことになります"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "これが全て解決するかというと、やはりそれが実際にいる正職員の負担にもなるという声も若干聞かれている"@ja.
<< kg:id_105 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "市で研修の機会を設定することが大事と思っております。いろいろな面で研修の機会を設定していくことは大事"@ja.
<< kg:id_108 prop:effect kg:id_109 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "７月25日から26日にかけては、実際夜通しの業務となったところでございます"@ja.
<< kg:id_108 prop:effect kg:id_110 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "毎回違う避難所への動員だったので、業務内容の把握に手間取った"@ja.
<< kg:id_108 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "そこら辺を十分把握して、今後に生かしていきたいと考えているところでございます"@ja.
}
