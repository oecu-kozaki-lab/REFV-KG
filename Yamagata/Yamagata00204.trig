kg:id_92 rdf:type cls:c_11688.
cls:c_11688 rdfs:label "情報発信混乱"@ja.
kg:id_93 rdfs:label "防災行政無線のスピーカーからの放送はほとんど聞き取ることができず全く機能していなかった"@ja.
kg:id_93 rdf:type cls:c_11689.
