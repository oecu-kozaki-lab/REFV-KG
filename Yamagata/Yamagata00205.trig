kg:st_1 rdfs:label "加藤鑛一議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "自衛隊体験の実施実態を問題視する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "学校教育が自衛隊の広報に利用される懸念を示す"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "本来の職場体験の目的から逸脱すると指摘する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "生徒を参加させることに慎重な検討が必要と訴える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "教育長"@ja.
kg:st_2 rdf:type cls:st_57.
cls:st_57 rdfs:label "教育行政"@ja.
kg:op_5 prop:content "自衛隊体験は有意義で職業観の育成につながると評価する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "事前事後学習を含めて生き方を考える教育効果があると述べる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "自衛隊での職場体験は見直しが必要と求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "総合的な学習として事前事後学習を重視する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "自衛隊も選択肢の一つとして各校が適切に判断しているとする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "職場体験は地域社会と連携した人間形成支援から始まったと説明する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "社会全体で子供を支える発想が導入の契機になったと述べる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "職場体験の本質は地域の教育力を生かすことだと強調する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "進路指導だけでなく地域コミュニティ形成が原点だと主張する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "地域での職場体験が学校の荒れの改善につながったと評価する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "キャリア教育だけでなく地域の教育力を軸に見直すべきと求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "制度設計自体に問題があると指摘する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "公平性に課題があるとみている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "本来優先すべき課題が後回しになると懸念する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "保育の質や制度運用に問題を残すと指摘する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "給食費実費徴収で園の負担が増えると懸念する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "実費徴収により施設間格差が広がると懸念する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:st_3 rdfs:label "健康福祉部長"@ja.
kg:st_3 rdf:type cls:st_126.
cls:st_126 rdfs:label "福祉行政"@ja.
kg:op_22 prop:content "幼稚園との公平性確保のため国が実費徴収に統一したと説明する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "無償化に伴い保育所の事務負担が増えると認める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "保護者負担と園負担を軽減するため市徴収方式を提案する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "食文化創造都市として独自制度を構築すべきと提案する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "副食費は私債権であり市の直接徴収は難しいと説明する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:st_4 rdfs:label "市民部長"@ja.
kg:st_4 rdf:type cls:st_127.
cls:st_127 rdfs:label "市行政"@ja.
kg:op_27 prop:content "空き容量不足が売電の最大の支障になっていると説明する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "長期かつ高額の負担が行政上対応困難と説明する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "国の原発優先政策が再エネ接続の障害だと批判する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "この国のルールが接続を困難にしていると指摘する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "国の制度が変わらなければ接続は極めて難しいとみる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "不確定要素が多く自治体として対応しにくいと説明する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "高効率発電重視でごみ減量化の本来目的が薄れると批判する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "売電不能なら過大施設となると問題提起する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "売電できなくても自家消費で一定の経費削減効果があると説明する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:st_5 rdfs:label "市長"@ja.
kg:st_5 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_36 prop:content "容量確保できなかった背景に職員の専門知識不足があったと認める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "コンサルタント依存も問題だったとして詳細調査の必要を述べる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "国県の指導も受けながら売電実現へ協議を続ける方針を示す"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "送配電網の有効活用制度の活用可能性を調査する考えを示す"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "自己消費や新たな送電方法も含め調査研究すると述べる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:st_6 rdfs:label "長谷川剛議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_41 prop:content "子育て支援策の強化が必要だと訴える"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:op_42 prop:content "親の貧困が子供の貧困につながっていると指摘する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_6.
kg:op_43 prop:content "就学時費用が重く少子化の一因にもなると述べる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_6.
kg:op_44 prop:content "国制度の改正の中で対応していく考えを示す"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "資格取得と就労支援を通じて自立を支えると説明する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "相談支援のため子育て推進課に1名配置していると説明する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:st_7 rdfs:label "加賀山茂議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_47 prop:content "駅前の活気低下の一因として産業移転を挙げる"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_7.
kg:op_48 prop:content "郊外型大型店の進出が駅前衰退を招いたとみる"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_7.
kg:op_49 prop:content "モータリゼーションが中心市街地の衰退を進めたと指摘する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_7.
kg:op_50 prop:content "家族形態の変化もまちの衰退要因とみる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_7.
kg:op_51 prop:content "都市の広がりが駅前空洞化につながったと捉える"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "人口減少と高齢化が駅前のにぎわい喪失を加速させたと述べる"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_7.
kg:st_8 rdfs:label "建設部長"@ja.
kg:st_8 rdf:type cls:st_128.
cls:st_128 rdfs:label "建設行政"@ja.
kg:op_53 prop:content "再開発は当初一定の効果を上げたと評価する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_8.
kg:op_54 prop:content "老朽化による不具合が生じていると説明する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_8.
kg:op_55 prop:content "今年度から2カ年で空調設備を更新すると説明する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_8.
kg:op_56 prop:content "パークビル側の改修を順次進めていると説明する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_8.
kg:op_57 prop:content "入口の分かりづらさを改善するため誘導サインを整備したと説明する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_8.
kg:op_58 prop:content "鶴岡の玄関口としてお粗末な状態だと問題提起する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_7.
kg:op_59 prop:content "イベント利用時や定期清掃の改善を検討すると答える"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_8.
kg:st_9 rdfs:label "商工観光部長"@ja.
kg:st_9 rdf:type cls:st_129.
cls:st_129 rdfs:label "商工行政"@ja.
kg:op_60 prop:content "年々利用実績が減少していると説明する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_9.
kg:op_61 prop:content "官民のイベント利用を広げるためPRを強化すると述べる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_9.
kg:op_62 prop:content "使い勝手の悪さの背景に老朽化があると認識する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_9.
kg:op_63 prop:content "多くの利用者に使いやすい価格となるよう見直しを検討する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_9.
kg:op_64 prop:content "旧ジャスコ跡地でまちなか居住を進め中心市街地活性化につなげたいとする"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_8.
kg:op_65 prop:content "アクセス性向上と交通結節点機能の強化を図ると説明する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_8.
kg:op_66 prop:content "羽越新幹線も念頭に長期の駅前整備構想が必要と認識する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_8.
kg:op_67 prop:content "子供の貧困は親の生活困窮と一体だと指摘する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_6.
kg:op_68 prop:content "現行の実費徴収と同様に園が対応する想定と説明する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_3.
kg:op_69 prop:content "出羽三山を観光戦略の柱として重視していると説明する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_9.
kg:op_70 prop:content "出羽三山をエンジンに庄内ブランド再構築を図る方針を示す"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_9.
kg:op_71 prop:content "出羽三山や即身仏へのニーズが高い欧米客を重点にしていると説明する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_9.
kg:op_72 prop:content "欧米客への訴求力が高いことが見えてきたと説明する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_9.
kg:op_73 prop:content "通信環境整備が急務として補助金を計上したと説明する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_9.
kg:op_74 prop:content "国際交流員や先進事例を生かし伝わる案内を検討すると述べる"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_9.
kg:op_75 prop:content "近年の局地的豪雨により冠水箇所の把握と対策が課題になっていると説明する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_8.
kg:op_76 prop:content "市内各所で冠水や浸水被害が発生していると説明する"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_8.
kg:op_77 prop:content "局部改良で効果が見込める箇所から順次工事を進めていると説明する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_8.
kg:op_78 prop:content "複数排水区で幹線排水路整備を進めていると説明する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_8.
kg:op_79 prop:content "関係機関連携により出水時の浸水軽減を図ると説明する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_8.
kg:op_80 prop:content "冠水常襲箇所の情報共有と注意喚起のため作成予定と説明する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_4.
kg:op_81 prop:content "自助共助による未然防止策を地域と検討すると述べる"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_4.
kg:st_10 rdfs:label "企画部長"@ja.
kg:st_10 rdf:type cls:st_130.
cls:st_130 rdfs:label "企画行政"@ja.
kg:op_82 prop:content "事業の狙いは市民参加と担い手育成にあると説明する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_10.
kg:op_83 prop:content "制度統合により分かりやすさを改善したと説明する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_10.
kg:op_84 prop:content "制度を簡素化し相談しやすくしたと説明する"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_10.
kg:op_85 prop:content "実施団体の意見も聞きながら改善していく考えを示す"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_10.
kg:st_11 rdfs:label "田中宏議員"@ja.
kg:st_11 rdf:type cls:st_16.
kg:op_86 prop:content "一般市民や事業者に成果や参加方法が伝わっていないと懸念する"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_11.
kg:op_87 prop:content "食文化を市民により身近にするため計画統合を進めていると説明する"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_10.
kg:op_88 prop:content "食関連事業にも補助制度を活用し自発的活動を促したいと述べる"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_10.
kg:op_89 prop:content "人口減少が空き家増加の背景にあると説明する"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_8.
kg:op_90 prop:content "高齢単身世帯の増加も空き家増加要因と説明する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_8.
kg:op_91 prop:content "所有者責任を基本に適正管理を促していくと説明する"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_8.
kg:op_92 prop:content "シェアハウスや学童保育などにぎわい創出につながる活用を進めている"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_8.
kg:op_93 prop:content "若者世帯や移住世帯向けに解体跡地を低額で供給していると説明する"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_8.
kg:op_94 prop:content "地下水の健全性把握のため継続観測を行っていると説明する"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_4.
kg:op_95 prop:content "事業者や市民への啓発活動を続けていると説明する"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_4.
kg:op_96 prop:content "現時点では大きな悪化は見られないと説明する"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_4.
kg:st_12 rdfs:label "上下水道部長"@ja.
kg:st_12 rdf:type cls:st_131.
cls:st_131 rdfs:label "上下水道行政"@ja.
kg:op_97 prop:content "広域水道停止時に備え1日最大1万トン取水可能な設備を維持していると説明する"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_12.
kg:op_98 prop:content "常時稼働は年間約5000万円の追加経費となり料金高騰を招くため行わない"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_12.
kg:op_99 prop:content "社会的孤立が発見の遅れの要因だったと認識する"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_3.
kg:op_100 prop:content "支援につながっていなかったことが発見遅れにつながったと説明する"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_3.
kg:op_101 prop:content "地域包括支援センター中心に関係機関で地域課題を共有していると説明する"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_3.
kg:op_102 prop:content "見守りが必要な高齢者へ民生委員が訪問する仕組みを実施していると説明する"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_3.
kg:op_103 prop:content "通報相談安否確認を支援する見守り機器を提供している"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_3.
kg:op_104 prop:content "新聞社や郵便局、運送業者などとの見守り協定を活用していると説明する"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_3.
kg:op_105 prop:content "環境調査で希少種確認を受け風車配置を見直したと説明する"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_4.
kg:op_106 prop:content "クマタカへの影響回避低減のため配置変更したと説明する"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_4.
kg:op_107 prop:content "鳥類や動物への影響回避低減の措置が講じられると説明する"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_4.
kg:op_108 prop:content "重要植物は同様の環境へ移植する計画と説明する"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_4.
kg:op_109 prop:content "地域住民の理解を深めるため説明機会を重ねてきたと説明する"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_4.
kg:op_110 prop:content "搬入路整備や木質バイオマスとの相乗効果で地域活性化が期待されると述べる"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_4.
kg:op_111 prop:content "小中高生や地域向けの学習機会として活用を検討していると説明する"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_4.
kg:op_112 prop:content "工事や運転管理業務での地元雇用が想定されると説明する"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_4.
kg:op_113 prop:content "市財政への一定の効果も見込まれると説明する"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_4.
kg:op_114 prop:content "コミュニティパワーの考えも参考に地域に便益がもたらされるあり方を研究する"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "しかし、ある保護者の家族からその体験場所の一つとして自衛隊に参加している学校があると聞きました"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "自衛隊では広報活動として総合的な学習の一環としての体験学習の案内を各学校に送付しています"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "職場体験学習が自衛隊の入隊勧誘の手段に使われては本来の目的から逸脱すると思われ"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "平和憲法をまだ十分に学んでいない生徒を自衛隊での体験学習に参加させることには考えなければならない問題が指摘されます"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "自衛隊での体験活動を通して望ましい勤労観、職業観が形成され、将来の夢や希望の実現を目指して取り組もうとする意欲や態度が育まれており"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "自己の生き方について考える機会となり、望ましい勤労観や職業観を育むことにつながるものと考えております"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "見直しが必要と思いますが、いかがでしょうか"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "総合的な学習の時間の一環として十分な事前学習に取り組んだ上で職場体験活動に臨むことが大切であり、さらに職場体験活動を通しての学びや考えを事後の学習で深めていくことにより"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "生徒一人一人の希望や課題に合わせ、体験内容と安全面を考慮した上で各校が適当であると判断しているものと捉えており"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "兵庫県の教育委員会が1995年、平成７年の阪神淡路大震災"@ja.
<< kg:id_11 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "1997年、平成９年の神戸連続児童殺傷事件を契機にして"@ja.
<< kg:id_11 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "学校、家庭、地域社会の連携を深めて、社会全体で子供たちの人間形成や社会的自立の支援を行う"@ja.
<< kg:id_11 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "子供たちを中心とした地域コミュニティの構築へと発展することを期待して"@ja.
<< kg:id_11 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "こういう学習の場を学校から地域社会に移す職場体験に取り組んでから学校が次第に安定をしてきて"@ja.
<< kg:id_11 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "もう一度この職場体験学習という意味を原点に立ち返って考えていただけないか"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "この幼児教育、保育の無償化については、財源を消費税にしていることや"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "無償化の恩恵が所得が高いほど大きくなること"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "待機児童の解消や保育士の処遇改善が後回しになること"@ja.
<< kg:id_18 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "認可外保育施設の固定化などいろいろ問題が指摘されています"@ja.
<< kg:id_18 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "給食費が保育施設の実費徴収となると、保育施設での新たな実務負担となります"@ja.
<< kg:id_18 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "実費徴収によって施設間の保護者負担や給食の質の格差が生じることも懸念されます"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "国は有識者や現場の意見をもとに検討を行った結果、保育園の保育料から副食費を除外し、幼稚園と同じ実費徴収の取り扱いとしたところでございます"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "集金事務や対象児童の把握など新たな徴収事務が発生することになると考えております"@ja.
<< kg:id_25 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "保育料と同様に自治体が親から徴収して、市町村は委託費の一部として保育園に支払うというシステムが望ましい"@ja.
<< kg:id_25 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "食育負担金として徴収すると。そして、それを食育委託料として保育所に支払うと、こういう形にすれば"@ja.
<< kg:id_25 prop:effect kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "法令上副食費は保育所と利用者の間の私債権という位置づけになり、市町村が所有するものではないことから...困難という見解を示しており"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "空き容量がなく、設備増強が必要となることから"@ja.
<< kg:id_31 prop:cause kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "工事負担金16億9,880万円、工期11年が必要とされております"@ja.
<< kg:id_31 prop:cause kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "国のエネルギー計画で石炭火力と原子力をベースロード電源として位置づけたこと"@ja.
<< kg:id_31 prop:cause kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "電力系統の増強が必要な場合は再エネ発電者が増強の費用を負担するというルールを国が定めた問題"@ja.
<< kg:id_31 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "これが変わらなければ東北電力への接続はほとんど不可能ではないか"@ja.
<< kg:id_31 prop:effect kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "長期にわたり不確定要素の多い債務が生じることから、今回のごみ焼却施設整備に伴う売電事業では行政の財政制度上対応が難しいルールになっている"@ja.
<< kg:id_31 prop:effect kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "高効率発電焼却施設では高い発電量が見込める廃プラや紙、繊維類、ゴム、皮革など、資源化されるものが燃やされて、循環型社会に逆行するのではないか"@ja.
<< kg:id_31 prop:effect kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "売電が不可能となれば、結果的に多大な建設費やランニングコストといういわば過大施設となったということになるのではないか"@ja.
<< kg:id_31 prop:effect kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "発電によりごみ焼却施設とし尿処理施設における自家消費分で年間約１億円の削減を見込まれるところであり"@ja.
<< kg:id_31 prop:cause kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "関係した職員が売電に関する専門的理解が不足をしていたということが容量を確保できなかったことにつながった"@ja.
<< kg:id_31 prop:cause kg:id_42 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "専門的な情報につきましては委託をしていましたコンサルタントに依存をしていたというところもございます"@ja.
<< kg:id_31 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "東北電力に系統連系を申し込みの上、協議を継続し、できるだけ売電ができるように取り組んでまいります"@ja.
<< kg:id_31 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "今後も日本版コネクトアンドマネージの動向に注視してまいります"@ja.
<< kg:id_31 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "議員から御提案いただきました件につきましては、なお調査、研究させていただきたい"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "県内の子供の貧困率が16％、全国平均の13.9％を2.1％上回ったことが明らかになりました"@ja.
<< kg:id_46 prop:effect kg:id_48 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "貧困世帯とされない世帯でも47％、約半数の子育て世代の方が生活が苦しいという回答"@ja.
<< kg:id_46 prop:effect kg:id_49 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "制服代、また運動着代に加えて部活動で使う道具をそろえれば10万を軽く超えると、非常に負担が重い"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "国で今後も制度の充実が図られる予定であり、国の制度の範囲の中で対応してまいりたい"@ja.
<< kg:id_50 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "ひとり親の方がより収入の高い就労に結びつけるために資格を取得する際の教育訓練講座の受講経費を助成する制度"@ja.
<< kg:id_50 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "現在本市ではひとり親家庭の総合的な相談窓口としまして子育て推進課に１名配置しております"@ja.
<< kg:id_54 prop:cause kg:id_55 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "主たる産業が郊外へと移転"@ja.
<< kg:id_54 prop:cause kg:id_56 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "大型商業施設等の進出と相まって"@ja.
<< kg:id_54 prop:cause kg:id_57 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "自動車依存型社会となり"@ja.
<< kg:id_54 prop:cause kg:id_58 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "核家族化の進展"@ja.
<< kg:id_54 prop:cause kg:id_59 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "市街地スプロール化"@ja.
<< kg:id_54 prop:cause kg:id_60 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "中心部の人口流動と減少、高齢化の加速"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "鶴岡の顔として都市機能の集積を図り、駅前地区のにぎわい創出に寄与したことは経済的な効果も含めて一定の効果があった"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "マリカ東館は、建設から約32年が経過し、各種設備については老朽化によるふぐあいも生じており"@ja.
<< kg:id_63 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "今年度から２カ年の計画で改修工事を予定しているところでございます"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "パークビル側の長寿命化対策として鉄骨補強や外壁交換などの改修工事を行っており"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "昨年度マリカ東館の駅出口と駅前通りの壁面２カ所に視認性の高い案内看板を設置しております"@ja.
<< kg:id_70 prop:cause kg:id_71 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "広場全体が老朽化はもちろんだが、まことに不衛生であり、駅前を再開発した鶴岡の玄関口にある施設としてお粗末"@ja.
<< kg:id_70 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "イベントなどでの貸し付け時や定期的な清掃作業につきましては今後適正な対応ができるよう検討してまいります"@ja.
<< kg:id_73 prop:effect kg:id_74 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "年々利用件数は減少しております"@ja.
<< kg:id_73 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "今後も官民問わずさまざまなイベントや会合に利用していただけるよう施設のＰＲなどを強化し、利用率の向上を図ってまいりたい"@ja.
<< kg:id_73 prop:cause kg:id_76 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "施設の設備や器具類の老朽化につきましても...課題となっていると認識をしております"@ja.
<< kg:id_73 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "多くの利用者に御利用いただけるような価格となるように検討をしてまいりたい"@ja.
<< kg:id_78 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "旧ジャスコ跡地におきましてまちなか居住を目的に、民間事業者による中高層集合住宅の整備"@ja.
<< kg:id_78 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "駅前ロータリーの自家用車送迎レーンの拡幅及び歩行者通路用シェルターの増築や駅北側のロータリー整備"@ja.
<< kg:id_78 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "今後20年から30年後を見据えた将来の整備構想が必要であると認識しておりまして"@ja.
<< kg:id_82 prop:cause kg:id_83 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "やはり子供の貧困は、イコール親の貧困であります"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "副食費の未納につきましても園が同様の対応をするものと考えております"@ja.
<< kg:id_86 prop:effect kg:id_87 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "首都圏から最も多く集客している本市の観光地は羽黒山という結果"@ja.
<< kg:id_88 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "出羽三山を重点とした情報発信や旅行商品化の取り組みを展開している"@ja.
<< kg:id_90 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "重点的なターゲットを欧米諸国と設定し、各種施策を展開しているところでございます"@ja.
<< kg:id_90 prop:effect kg:id_92 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "アメリカやフランスを中心に、欧米諸国の旅行者が７割を占め"@ja.
<< kg:id_90 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "観光地のＷｉ―Ｆｉ整備、環境整備が急務であると認識しておりまして、今定例会においてフリーＷｉ―Ｆｉの環境の整備を行う観光施設等への補助金250万円を補正予算案に計上"@ja.
<< kg:id_90 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "本市におきましては、国際交流員が多言語化への取り組みを行っております"@ja.
<< kg:id_95 prop:cause kg:id_96 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "平成25年７月の集中豪雨...近年多発しておりますゲリラ豪雨"@ja.
<< kg:id_95 prop:effect kg:id_97 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "市内各所で道路の冠水や家屋の浸水などの被害を受けました"@ja.
<< kg:id_95 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "既設の道路側溝の断面を拡大することによりまして、流下能力の向上が図られる"@ja.
<< kg:id_95 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "公共下水道事業として対策工事を進めているところでございます"@ja.
<< kg:id_95 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "大雨の際に迅速な開閉操作を行うことで、市街地の水路や堰の水位を下げる体制を整える"@ja.
<< kg:id_95 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "データベースを生かした箇所ごとの簡易な内水ハザードマップの作成を予定しております"@ja.
<< kg:id_95 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "土のうを常時常襲箇所の公民館やコミセンに配置し、これを降雨情報により冠水発生の前に住民、自主防災組織、消防団などの地域組織が自助、共助により設置できる仕組みづくり"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "市民のまちづくりへの参加を促進し、将来的な協働の担い手の発掘や人材を育成することを狙いとしております"@ja.
<< kg:id_103 prop:effect kg:id_105 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "対象事業や支援内容も複雑でわかりにくい面がございました"@ja.
<< kg:id_103 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "新たな制度ではコースを３つにまとめ簡素化し、相談に来る方に対して適切なコースを紹介できるよう窓口を一本化"@ja.
<< kg:id_103 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "提出書類も極力簡素になるよう努めたところでございます"@ja.
<< kg:id_108 prop:effect kg:id_109 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "一般の市民の方々、それから事業者さんなどにまだまだ浸透していないんではないかという現状を懸念しております"@ja.
<< kg:id_108 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "これまでのプランに鶴岡市食育・地産地消推進計画を包含する形でまとめ、食文化が市民にとってより身近な存在になるように工夫している"@ja.
<< kg:id_108 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "食文化や食に関する新たな魅力や価値を生み出す事業など食を含めたさまざまなテーマの事業に活用していただける内容となっております"@ja.
<< kg:id_112 prop:cause kg:id_113 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "人口減少や高齢単身世帯の増加に伴いまして"@ja.
<< kg:id_112 prop:cause kg:id_114 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "人口減少や高齢単身世帯の増加に伴いまして"@ja.
<< kg:id_115 prop:countermeasure kg:id_116 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "空き家の管理につきましては所有者等に第一義的な責任があることなど、当時者意識の啓発を図る"@ja.
<< kg:id_115 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "空き家を利用したにぎわいづくり施設への建てかえ、改修を対象とした助成も行っております"@ja.
<< kg:id_115 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "解体跡地を若者世帯や移住世帯向けに低額で供給するもの"@ja.
<< kg:id_119 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "市内３地点で地下水位の観測と、このうち鶴岡公園では地盤沈下の観測を行っております"@ja.
<< kg:id_119 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "地下水の適正利用の推進に取り組んでおります"@ja.
<< kg:id_119 prop:effect kg:id_122 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "近年は地下水位と地盤ともに大きな変動は見られない状況"@ja.
<< kg:id_123 prop:countermeasure kg:id_124 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "災害時や非常時の予備水源として...現在は計７本の深井戸から１日最大約１万トンの取水が可能な設備"@ja.
<< kg:id_123 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "仮に鶴岡浄水場を常時稼働させますと...年間約5,000万円もの経費が新たに必要となります"@ja.
<< kg:id_126 prop:cause kg:id_127 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "日ごろから御本人が御近所づき合いや町内会などとのかかわりが希薄だったことが要因の一つ"@ja.
<< kg:id_126 prop:cause kg:id_128 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "地域包括支援センターとのかかわりがなかったことから、安否確認の対象とされていなかったこと"@ja.
<< kg:id_126 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "地域ケアネットワーク会議を開催しております。この会議でそれぞれの地域における課題の共有や情報提供などを行っている"@ja.
<< kg:id_126 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "70歳以上で見守りが必要なひとり暮らしの方に安否確認を目的に民生委員が乳酸飲料を持参して訪問する愛の一声運動事業"@ja.
<< kg:id_126 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "通報及び双方向の会話ができる通信機器を設置しまして、生活や健康等に関する相談、安否確認、緊急時の対応を支援する安心見守りコールサービス"@ja.
<< kg:id_126 prop:countermeasure kg:id_132 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "住民の日常生活に異変を感じた場合は市町村に連絡をいただく仕組み"@ja.
<< kg:id_133 prop:cause kg:id_134 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "対象事業実施区域周辺に５つがいのクマタカが確認され"@ja.
<< kg:id_133 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "北側に設置予定だった４基を３基に、南側に設置予定だった３基も２基に減らすとともに、設置場所もそれぞれ極力南側に設置する"@ja.
<< kg:id_133 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "送電線の地下埋設やブレードの塗装のほか、鳥類を誘引しにくいとされる閃光灯、フラッシュ灯の採用"@ja.
<< kg:id_133 prop:countermeasure kg:id_137 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "改変区域内に生息する重要な植物であるコシノコバイモやヤマシャクヤク、ヤマトアオダモ、リンドウ、イイヌマムカゴについては、生息地と同様の環境へ移植"@ja.
<< kg:id_133 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "三瀬地区自治会を初め、周辺地域を対象とした意見交換会や説明会をこれまで７回開催し"@ja.
<< kg:id_133 prop:effect kg:id_139 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "林業の活性化が期待されます"@ja.
<< kg:id_133 prop:effect kg:id_140 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "地元の小中学生や高校生、地域の方々を対象とした環境学習の場としての利用も検討"@ja.
<< kg:id_133 prop:effect kg:id_141 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "工事終了後の運転や管理業務についても数名の地元雇用が想定されております"@ja.
<< kg:id_133 prop:effect kg:id_142 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "固定資産税の増収による一定の財政効果も期待されている"@ja.
<< kg:id_133 prop:countermeasure kg:id_143 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "地域を豊かにする再生可能エネルギーのあり方について今後調査、研究をしてまいりたい"@ja.
}
