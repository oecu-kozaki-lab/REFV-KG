kg:st_1 rdfs:label "危機管理監早坂進"@ja.
kg:st_1 rdfs:type cls:st_93.
cls:st_93 rdfs:label "行政担当者"@ja.
kg:op_1 prop:content "警戒と注意を継続する必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "雨が下降ぎみのため現時点では発令していない"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "昼頃まで雨が続く見込みのため警戒を継続する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤昌哉議員"@ja.
kg:st_2 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_4 prop:content "本来のサイエンスパーク機能に疑念を持つ声がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "農業者"@ja.
kg:st_3 rdfs:type cls:st_132.
cls:st_132 rdfs:label "農業者"@ja.
kg:op_5 prop:content "優良農地を提供したのに施設誘致政策が進まず景観も問題だと疑問視する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:st_4 rdfs:label "企画部長阿部真一"@ja.
kg:st_4 rdfs:type cls:st_93.
kg:op_6 prop:content "自然環境と調和した景観形成とイメージ向上につなげる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:op_7 prop:content "設備拡張は高付加価値産業創出と雇用効果につながる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:op_8 prop:content "本市での事業拡大に向け連携していく"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "庄内鶴岡の発展につなげる事業として進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "様々な媒体で効果的に情報発信する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "市単独でなく多くの関係者の参加で進める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "庄内藩という庄内全体の視点で連携する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "歴史文化を学ぶことで愛着と誇りを高め人材育成につなげる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:st_5 rdfs:label "教育部長石塚健"@ja.
kg:st_5 rdfs:type cls:st_93.
kg:op_14 prop:content "歴史的価値維持のため修理体制確保が課題である"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "支援しながら保存継承を図る"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_5.
kg:op_16 prop:content "市内外の多くの方に利用してもらう工夫が必要だ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:op_17 prop:content "関係課と連携して来訪者を呼び込む"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_5.
kg:op_18 prop:content "富裕度順位の低下が総合順位に影響した"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "若者就職支援や子育て環境充実などを進める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:st_6 rdfs:label "子育て世代の方々"@ja.
kg:st_6 rdfs:type cls:st_43.
cls:st_43 rdfs:label "子育て世代"@ja.
kg:op_20 prop:content "保育料や医療費や給食費の無料化は大変助かる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_6.
kg:op_21 prop:content "多子世帯の負担軽減につながっている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "対象拡大には財源確保が課題である"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "充実した制度となるよう検討を続ける"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "本市のあるべき給食の姿を見いだす"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "大規模災害時の活用について全国事例を踏まえ検討する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:st_7 rdfs:label "健康福祉部長渡邉健"@ja.
kg:st_7 rdfs:type cls:st_93.
kg:op_26 prop:content "用地確保や代替方法を検討している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_7.
kg:op_27 prop:content "教育委員会や運営主体と協議し児童の居場所確保を図る"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_7.
kg:op_28 prop:content "利便性と安全性の観点から整備を検討する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_7.
kg:op_29 prop:content "小学校区ごとの実情を勘案して施設確保を進める"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_7.
kg:st_8 rdfs:label "教育長布川敦"@ja.
kg:st_8 rdfs:type cls:st_51.
cls:st_51 rdfs:label "教育関係者"@ja.
kg:op_30 prop:content "急速なICT教育推進で教職員対応が求められる"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_8.
kg:op_31 prop:content "教職員のサポートと負担軽減に努めてきた"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_8.
kg:op_32 prop:content "基本から応用までスモールステップで研修する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_8.
kg:op_33 prop:content "業務効率化と負担軽減につなげる"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_8.
kg:op_34 prop:content "県教委とともに人員確保に努める"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_8.
kg:st_9 rdfs:label "総務部長高橋健彦"@ja.
kg:st_9 rdfs:type cls:st_93.
kg:op_35 prop:content "窓口に来なくてもサービスを受けられる仕組みを目指す"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_9.
kg:op_36 prop:content "政府計画を基本に段階的に進める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "書面や押印原則などを見直す必要がある"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "市民が不安なく恩恵を受けられることが前提だ"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:st_10 rdfs:label "建設部長村上良一"@ja.
kg:st_10 rdfs:type cls:st_93.
kg:op_39 prop:content "洪水に対する危険性が高まっている"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_10.
kg:st_11 rdfs:label "地元住民"@ja.
kg:st_11 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_40 prop:content "数時間同じ勢いの雨なら越水の危険があったと不安を抱いている"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_11.
kg:op_41 prop:content "県から重要性が高い事態として本年度内実施可能か計画見直しの回答を得た"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_10.
kg:op_42 prop:content "これまで以上に強く要望していく"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_10.
kg:st_12 rdfs:label "市民部長五十嵐浩一"@ja.
kg:st_12 rdfs:type cls:st_93.
kg:op_43 prop:content "これまでの取組が十分でなかったことが大きな原因だ"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_12.
kg:op_44 prop:content "より効果的な施策を進める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_12.
kg:op_45 prop:content "焼却ごみが一定量必要と考えている"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_12.
kg:op_46 prop:content "あくまで3Rによる減量化を第一に推進する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_12.
kg:op_47 prop:content "今後は保証人確保困難な方が増えると認識している"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_10.
kg:op_48 prop:content "経済的精神的負担軽減と条件見直しを検討する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_10.
kg:st_13 rdfs:label "荘内病院事務部長佐藤光治"@ja.
kg:st_13 rdfs:type cls:st_121.
cls:st_121 rdfs:label "医療関係者"@ja.
kg:op_49 prop:content "納入は9月末頃の見通しである"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_13.
kg:op_50 prop:content "物資の安定供給が課題である"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_13.
kg:op_51 prop:content "待合室や検査場での感染と受検者増加が懸念される"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_13.
kg:op_52 prop:content "通常診療維持と院内感染防止のため活用する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_13.
kg:op_53 prop:content "専用の検査体制を病院とは別個に設けることが望ましい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_13.
kg:st_14 rdfs:label "市長皆川治"@ja.
kg:st_14 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_54 prop:content "荘内病院の負担を踏まえ連携して唾液検査導入などに取り組む"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_14.
kg:op_55 prop:content "中止撤回の条件となる"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_12.
kg:op_56 prop:content "他地域では理解が得られず一時凍結の事例がある"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_12.
kg:op_57 prop:content "必要な措置の内容は中止撤回も含め事業者判断となる"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_12.
kg:op_58 prop:content "騒音や低周波音による影響が懸念される"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_12.
kg:op_59 prop:content "歴史文化的価値も踏まえ影響が懸念される"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_12.
kg:op_60 prop:content "治水や土砂災害への影響が懸念される"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_12.
kg:op_61 prop:content "保全すべき場所を示す観点から有効であり検討する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_12.
kg:op_62 prop:content "立地と進め方に問題があり意見提出で対応する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_14.
kg:st_15 rdfs:label "商工観光部長佐藤正胤"@ja.
kg:st_15 rdfs:type cls:st_93.
kg:op_63 prop:content "庄内地域全体の重要課題として認識している"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_15.
kg:op_64 prop:content "地元企業の情報不足という課題を踏まえて力を入れてきた"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_15.
kg:op_65 prop:content "距離の影響を受けず広く情報を伝えるため実施する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_15.
kg:op_66 prop:content "魅力や強みの伝え方やインターンシップ手法を研修している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_15.
kg:op_67 prop:content "他市事例を参考に費用対効果や不公平感に配慮して研究する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_15.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本日の大雨浸水害警報につきましては本日６時56分、それから大雨洪水につきましては５時46分に警報が発せられております"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "被害の状況でございますが、道路冠水が７地点となってございます"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "こちらにつきましては、下清水アンダーが現在も通行止めという状況でございます"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "冠水被害といたしましては、やまのこ保育園、北京田のバイオサイエンスパークのところにございますが、こちらのほうが一部冠水しております"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "土砂被害といたしましては、三瀬地区上降矢、こちらのほうは県道三瀬水沢線のところがのり面になってございますが、こちらが今現在、全面通行止めという状況でございます"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "三和の地点が９時50分現在の水位が3.06ということでなっておりまして、避難判断水位が2.8でございますので、レベル３のところを超えている状況にはございますが、現在雨が下降ぎみということもございまして、現在発令はしていない状況でございます"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "鶴岡市の対策といたしましては、本日６時30分の段階で災害警戒本部を設置しております"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "こちらのほうが一部冠水しておりますが、これも消防等の出動により対応が済んでおります"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "なお引き続き、警戒、注意に当たってまいりたいと思っております"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "スイデンテラス、キッズドーム・ソライなどが建設されるなど、本来のサイエンスパークとしての機能や施設整備について疑念を持たれる声も聞かれます"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "最近、農業者から、基盤整備した優良農地を市の発展のために提供したはずだが、施設を誘致するという政策はどうなっているのかと。いつまで、あのような耕作放棄地状態なのかという誘致への疑念と景観上の指摘をする声が寄せられています"@ja.
<< kg:id_16 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "今後、土地所有者等と具体的対応について協議を行い、今議員からも言われましたけれども、全体として自然環境と調和したサイエンスパークの景観形成とイメージ向上につなげてまいりたいと考えております"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:text-txt_contents "工事はおおむね順調に進んでおり、予定どおり2021年には商業生産が開始されるとお聞きしております"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:text-txt_contents "今後、タイから輸出される人工構造たんぱく質素材、ブリュード・プロテインは、国内に運ばれ、本市にある紡糸設備で繊維に加工される計画とのことで"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "紡糸、加工工程に関わる設備拡張や造成などは付加価値の高い産業創出につながる可能性があり、雇用の面など地域経済への波及効果なども期待できることから"@ja.
<< kg:id_8 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "引き続き、スパイバー社との情報交換を進めながら、本市での事業拡大に向け、連携してまいりたいと考えております"@ja.
<< kg:id_24 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "事業の目的としましては、郷土への愛着と誇りを高めることや交流人口の拡大を図ること、それによりまして、庄内鶴岡のさらなる発展を図ることを掲げ"@ja.
<< kg:id_24 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "現在、市の広報におきまして、各月で400年記念事業の関連記事を掲載しております...ホームページの立ち上げやＳＮＳの活用、ポスター、チラシの作成などに取り組むこととしており"@ja.
<< kg:id_24 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "この事業につきましては、市が単独で進めるものではなく、より多くの関係者の参加をいただきながら、実行委員会形式で行うこととしております"@ja.
<< kg:id_24 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "庄内の各自治体とも連携しながら事業に取り組むこととしております"@ja.
<< kg:id_24 prop:effect kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "郷土の歴史や文化を後世に伝え残し、しっかり学んでいただくことで地元への愛着や誇りを高め、若者の地元定着や人材育成にもつなげてまいりたいと考えております"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "歴史的価値を維持するために、修理の際の保存技術者や材料の確保に苦労している状況にございます"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:text-txt_contents "修理にかかる費用も高額であることから"@ja.
<< kg:id_30 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "今後も国や県の助成事業を活用いたしまして、大学などの研究機関とも連携しながら、施設の維持管理に支援し、保存・継承を図ってまいります"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "一方、地元の利用が少ない現状でありますことから"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "周辺の文化財との連携を図っていくことも必要と考えております...この酒井家入部400年事業を機に、歴史文化の学びの機会の創出や歴史的建造物の保存活用を進めまして、町並み景観の整備、さらには戦略的な観光促進を展開いたしまして、多くの来訪者を呼び込むことについて、関係課と連携し、取組を進めてまいりたい"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "富裕度では順位が上位であった指標評価である人口当たりの財政歳出額、それから持家率が今年度は除かれましたことから、順位を432位から528位へ下げており、このことが総合順位に影響しているものと分析しております"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:text-txt_contents "快適度の順位が低いことにつきましては、昨年から年間日照時間や最深積雪など気候が評価指標の一つに加えられたことが要因と分析しているところでございます"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "人口減少対策が最重点課題でございますので、これの克服を目指すためには、第２期の鶴岡市まち・ひと・しごと創生総合戦略を着実に進めていくことが住みよいまちづくりにつながるものと考えております"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "子育て世代の方々からは、保育料や医療費、学校給食費などの無料化により、経済的支援はすごく助かると評価する声が届いています"@ja.
<< kg:id_46 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "平成30年度から、第３子以降の小・中学生の給食費無償化事業を実施してまいりました"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "完全無償化するとした場合には、さらに４億7,000万円を要することとなりまして、対象者の拡大に目を向けつつも、財源の確保を課題としているところでございます"@ja.
<< kg:id_50 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "全国的にもいろいろ動きがある事業でもございますので、そういった情報を収集しながら、引き続き子育て世代の支援策として充実した制度となるよう、制度を拡充するときの課題でございます財源の確保のために、必要な方策を引き続き検討してまいりたい"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:text-txt_contents "給食センターそれぞれの築年数は、鶴岡のセンターは33年でございます。櫛引センターが25年、朝日センターが19年、藤島センターと温海センターが18年"@ja.
<< kg:id_52 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "鶴岡市学校給食の在り方検討会ということで...食育の充実、地産地消の推進の２つをテーマにいたしまして...今年度内に２回程度の開催を予定いたしまして、給食施設や機能などについての検討を加え、最終的に本市のあるべき給食の姿を見いだすこととしております"@ja.
<< kg:id_52 prop:cause kg:id_55 >>
    prop:text-txt_contents "将来的なセンター配置の在り方によりまして、鶴岡センターの改築に当たっての施設規模でありますとか、機能が変わってくるということがあると考えております"@ja.
<< kg:id_52 prop:cause kg:id_56 >>
    prop:text-txt_contents "食中毒を防止するため、調理完了から喫食まで２時間とされる時間制限なども今後検討すべきものと捉えているところでございます"@ja.
<< kg:id_52 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "大規模災害時に学校給食センターから避難所である学校等へ給食を提供できる仕組みにつきましては、いろいろ課題も多いこととは思いますが、全国的な事例や動向を踏まえながら、関係部署等と今後とも調査、検討を進めてまいりたい"@ja.
<< kg:id_58 prop:cause kg:id_59 >>
    prop:text-txt_contents "過密状態は緩和されてはございますが、施設の老朽化の問題もあり、新たな実施場所の確保を要望されているところでございます"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:text-txt_contents "現在の第三学区学童保育所の敷地は道路に接しておらず、建築基準法上、新たな建物を整備することができない場所となっているため、施設整備のための用地の確保が最大の課題"@ja.
<< kg:id_58 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "現在運営主体や教育委員会と代替の方法について検討を重ねているところでございます"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:text-txt_contents "近年登録児童数が増加しており、今年度は79名となってございます"@ja.
<< kg:id_63 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "体育館改築工事後は、引き続き教室１部屋とワークスペース、または他の余裕教室等の活用について、市教育委員会や運営主体と連携して協議し、児童の居場所の確保を図ってまいりたい"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:text-txt_contents "児童数の増加に応じて、施設数が増え、現在４施設に分散して運営されております。施設の中には老朽化した施設もあることから"@ja.
<< kg:id_66 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "利便性や児童の安全性の確保といった観点から、学校の改築に併せた学校敷地内の施設整備について検討しております"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "学校の余裕教室や市有施設等を有効に活用できる場合は施設の環境整備に対し支援することとし、また学校の余裕教室や市有施設等の利用が困難な場合は、学校改築に併せた整備を行うなど、小学校区ごとの実情を勘案しながら、施設の確保を進めたい"@ja.
<< kg:id_71 prop:effect kg:id_72 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "ＩＣＴ教育が急速に促進される中で教職員の対応も求められ、負担が増えることが予想されます"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "学校教育支援員や部活動支援員等の人的な配置を計画的に進めるとともに、ストレスチェック及び、その結果に基づく専門医との面接指導を実施する等、教職員のサポートと負担軽減、それから労働環境の改善に努めてまいりました"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "教職員を対象としたＩＣＴ機器の基本的な使用方法の研修のほか、教科ごと、学年ごとのニーズに応じた応用的な活用方法の研修を、スモールステップで計画的・継続的に行っていく予定であります"@ja.
<< kg:id_75 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "書類作成やデータ管理等、学校・教員の様々な業務を効率化し、教職員の負担軽減につながる統合型校務支援システムがありますので、その導入も検討してまいります"@ja.
<< kg:id_78 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "県教育委員会において国の第２次補正予算を活用した学習指導員並びにスクール・サポート・スタッフの追加配置を行っております。市教育委員会といたしましても各学校に早急に配置できるよう、県教育委員会とともに人員の確保に努めてまいりたい"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:text-txt_contents "現在窓口業務が抱えている市民の方の待ち時間や混雑の課題、受付動線の問題の課題"@ja.
<< kg:id_82 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "ＩＣＴ等の技術を活用し、窓口サービスのオンライン化により、市民の皆さんが窓口にいらっしゃらなくてもサービスを受けられるようなシステム"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "行政手続のオンライン化の推進、地方公共団体におけるシステム等の共同利用、いわゆる自治体クラウドの推進、ＡＩ・ＲＰＡ等による業務効率化の推進、また公共データのオープン化の推進"@ja.
<< kg:id_84 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "書面や押印の原則などデジタル化の障壁となっている制度や習慣にまで踏み込んだ業務改革が必要となります"@ja.
<< kg:id_84 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "データ漏えいやデータの目的外利用などセキュリティーの確保や個人情報の保護の徹底、そして、高齢者等などパソコンやスマートフォンの操作が不慣れな方々に対するデジタルディバイド対策も一緒に進める必要がある"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "局所的な集中豪雨の増加や河川内の経年的な堆積土と、それから支障木の増加により洪水に対する危険性が年々高まっているとして"@ja.
<< kg:id_88 prop:effect kg:id_90 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "地元の方々から今回の大雨で、もう数時間同じ勢いの雨なら越水の危険性があったと危惧の声が寄せられております"@ja.
<< kg:id_88 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "河川を管理する担当課からは、重要性が高い事態になっているということを再認識したので、本年度内に実施可能か計画を見直したいと、そういった回答をいただいておるところでございます"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "河川改良事業の実施と河床しゅんせつ並びに支障木の伐採など、適正な維持管理による大雨対策といったものをこれまで以上に強く要望してまいりたい"@ja.
<< kg:id_94 prop:cause kg:id_95 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "これまでの取組として、市広報やエコ通信などでの情報発信、ごみ分別講習会、またごみの減量や適正な分別についてガイドブックを全戸配布するなど、その啓発を重点に取り組んでまいりました。今回の結果を見ますと、この取組が十分ではなかったことが大きな原因と考えられます"@ja.
<< kg:id_94 prop:cause kg:id_96 >>
    prop:text-txt_contents "本市でも人口減少に対して世帯数が増加傾向にあることが、１人当たりの排出量の減少につながらない一つの要因と捉えております"@ja.
<< kg:id_97 prop:cause kg:id_98 >>
    prop:text-txt_contents "デジタル化の進展により、新聞や雑誌などの資源回収量が減少しているということがリサイクル率の減少に影響しているものと考えられます"@ja.
<< kg:id_99 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "ごみの減量やリサイクル率の向上を図るためには、これまで以上の３Ｒの推進、特に食品ロス削減など、ごみの排出抑制への取組や資源回収の品目、方法などの見直しも課題であると捉えております"@ja.
<< kg:id_101 prop:cause kg:id_102 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "ごみ焼却による発電量を確保するためには一定量の焼却ごみが必要と考えております"@ja.
<< kg:id_103 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "本市としてはごみ処理の優先順位をリデュース・リユース・リサイクルの３Ｒ、そしてエネルギー回収、適正な処分と位置づけ、あくまで３Ｒの取組によるごみ減量化を第一に推進し、なお焼却処分が必要なごみについては、焼却により発生するエネルギーを有効活用し、地域の電力として活用してまいります"@ja.
<< kg:id_105 prop:cause kg:id_106 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "入居世帯の高齢化、単身化は年々増加傾向にあり、身寄りがないなどの理由により、今後は現実的に保証人の確保が困難な方が増加していくということも認識しております"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:text-txt_contents "生活保護を受給されている方の場合、家賃の代理納付と緊急時の連絡先を登録していただくことにより、家賃であるとか緊急連絡対応が担保されるといった観点から、条例の例外規定に基づきまして保証人を不要としているといった事例も中にはございます"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "今後、民間保証会社による保証を充実させることによりまして、保証人を確保できない方の経済的また精神的負担の軽減を図るとともに、他自治体の取組なども参考にさせていただきながら、入居者にとって重要な役割を担っている保証人ではありますけれども、免除または猶予することができるか、保証人について必要な条件についても検討してまいりたい"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "全国的に感染が拡大しているため需要が逼迫し、納入時期は９月末頃になる見通しであります"@ja.
<< kg:id_111 prop:cause kg:id_113 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "検査用試薬キットが品薄状態であり、同じ機種を配置した庄内保健所によれば、月に10セット限定配給の状況と伺っており、物資の安定供給が課題となっております"@ja.
<< kg:id_111 prop:cause kg:id_114 >>
    prop:text-txt_contents "検査機器の拡充に伴い、検査科の遺伝子検査室の整備と検査技師の増員も課題となっており"@ja.
<< kg:id_111 prop:effect kg:id_115 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "冬の感染流行期に入った際、新型コロナとインフルエンザが混在することが予想され、待合室や検査場での感染が懸念されること、併せて、ＰＣＲ検査を受ける方が大幅に増加すると予想されますので、検査体制の強化が必要である"@ja.
<< kg:id_116 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "県との委託契約に基づき対応可能な範囲で行政検査として判定まで行うために活用することとしております...全身麻酔を伴う手術等の前にスクリーニング検査にも活用する予定であります"@ja.
<< kg:id_118 prop:effect kg:id_119 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "これまでのやり方では、とても荘内病院の発熱外来で対応できる件数ではなく、また院内感染を防止する観点から、専用の検査体制を病院とは別個に設けることが望ましいと考えております"@ja.
<< kg:id_111 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "庄内保健所、医師会、また健康福祉部と連携して、この唾液による検査の導入というものをしっかり取り組んで対応していきたい"@ja.
<< kg:id_121 prop:cause kg:id_122 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "事業を実施するにはそれぞれの認可条件を満たすことが求められ、それらの条件をクリアできない場合は中止・撤回の条件となるものと思われます"@ja.
<< kg:id_121 prop:cause kg:id_123 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "地元の理解が得られない中で環境アセスの手続を進めることはできないとして、事業者側が一時凍結を表明した事例もございます"@ja.
<< kg:id_121 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "景観に与える影響が甚大であるとされ、市の景観計画に不適合となる場合は、市では指導・助言を行いますけれども、必要な措置の内容につきましては中止や撤回も含めて事業者側の判断となるものであります"@ja.
<< kg:id_121 prop:effect kg:id_125 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "議員御指摘のとおり事業実施区域に隣接する出羽三山を訪れる方も含め、近隣住民の生活に対して影響が及ぶことが懸念されるところでございます"@ja.
<< kg:id_121 prop:effect kg:id_126 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "その背景にある歴史・文化的価値も踏まえ、これら貴重な森林資源に対する影響が懸念をされるところでございます"@ja.
<< kg:id_121 prop:effect kg:id_127 >>
    prop:text-txt_contents "熊を含め希少種以外の動植物につきましても、その生態に対する影響が懸念されるところでございます"@ja.
<< kg:id_121 prop:effect kg:id_128 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "河川上流における森林開発が、本来の森林が持つ水源涵養機能や土砂流出防止機能など、これらの低下に影響することが懸念をされます"@ja.
<< kg:id_121 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "特定の地域における風力発電事業の計画を制限する、いわゆるゾーニングにつきましては...非常に有効であると考えております。今後、先進事例を調査・研究しながら...ガイドラインの改定について検討してまいりたい"@ja.
<< kg:id_121 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "このたびの計画につきましては、立地の問題があるとともに、この事業の進め方ですね、特に地元との合意形成ということで、今、反対署名運動なども起きているというような状況がございますので、大変問題がある状況だというふうに認識をしております。いずれにいたしましても...配慮書への意見を審議会の御意見も聞きながら提出する準備を進めている段階でございます"@ja.
<< kg:id_131 prop:cause kg:id_132 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "庄内地域の高校卒業後の県内定着率が県内４地域で最も低いといった実態がございます...毎年1,000人以上の卒業生が本市を離れるといった実態が続いている"@ja.
<< kg:id_131 prop:contermeasure kg:id_133 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "市内高校や高専、山大農学部の校内における地元企業の説明会をはじめ、保護者も含めた企業見学会の開催"@ja.
<< kg:id_131 prop:contermeasure kg:id_134 >>
    prop:text-txt_contents "東京と仙台を会場にした地元企業とのマッチング支援のほか、同じ会場内でハローワーク鶴岡による就職相談やＵＩＪターンを対象にした移住相談なども行ってまいりました"@ja.
<< kg:id_131 prop:contermeasure kg:id_135 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "オンラインのメリットを活用しまして、市内企業への就職希望者に広く情報を伝えるため、動画による地元企業の紹介事業を開催するため今議会に補正予算案を上程しております"@ja.
<< kg:id_136 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "自社の魅力や強みを伝えるためのプレゼンテーションの手法や採用に結びつけるためのインターンシップの手法を研修するセミナーを開催し、地元企業の採用力の向上にも取り組んでおるところでございます"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "御提案をいただきました美馬市の事例も参考にしながら、費用対効果の検証や事業実施前後の世代との不公平感など、こうしたことにも十分配慮をしつつ、制度について研究してまいりたい"@ja.
}
