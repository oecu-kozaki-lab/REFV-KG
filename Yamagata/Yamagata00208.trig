kg:st_1 rdfs:label "商工観光部長佐藤正胤"@ja.
kg:st_1 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "利用料金制での運営は大変厳しい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "小野由夫議員"@ja.
kg:st_2 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_2 prop:content "現状のままでは継続は困難"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "利用料金制での運営は大変厳しい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_3 rdfs:label "副市長山口朗"@ja.
kg:st_3 rdfs:type cls:st_2.
kg:op_4 prop:content "施設の老朽化や設備の故障の影響が大きい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "資本金を食い潰しており立て直しは無理"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "今後の運営の在り方と方向性の見直しが必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "施設の老朽化や経営予測や財政負担を総合的に検討する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地元住民の強い要望により設置された施設なので丁寧に進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "公設民営の会社では認められず最小限の方法で存続すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "健康増進を目的とした保養施設へ切り替えることも一つの方法"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "設備の故障による影響が大きい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "利用料金制での運営が困難"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "現状のままでは経営継続は困難"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "方向性の見直しの早急な検討が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "老朽化や経営状況や財政負担を総合的に検討する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "株式会社として経営が無理なら解散し別の形で存続を図るべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "縮小してコミュニティセンター方式で存続する方法しかない"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_4 rdfs:label "朝日庁舎支所長土田浩和"@ja.
kg:st_4 rdfs:type cls:st_2.
kg:op_18 prop:content "組合は経費節減に努めているが大幅な赤字が見込まれる"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "地域住民が一体となった経営が持続できるよう支援する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "経営の継続が困難な状況にある"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:st_5 rdfs:label "石井清則議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_21 prop:content "住民が自主的に運営を続ける組合への支援をしたい思いも分かる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "地域住民が一体となった経営が持続できるよう支援する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "当面はこれまでと同様の支援を継続したい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "駅前開発計画にも影響があり真剣に考える時期"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:st_6 rdfs:label "建設部長村上良一"@ja.
kg:st_6 rdfs:type cls:st_2.
kg:op_25 prop:content "国の協力を得て早期実現を目指す"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "下流部対策も含め早期実現を目指す"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "多くの企業及び従業員に悪影響を与えた"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "10年間の予定で工事を実施している"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:op_29 prop:content "来年度から３か年で工事を実施する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_6.
kg:op_30 prop:content "事業の一層の推進に努める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_6.
kg:op_31 prop:content "強い雨が降るたびに住民は不安を抱える"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "治水能力の向上と流下能力の回復が期待される"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:op_33 prop:content "毎年状況が読めるのに何とかならないのかという声がある"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "耐えられない心境だと察せられる"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "県事業の完了を目指して進める"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "対策効果の高い場所から順次整備する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:op_37 prop:content "流下能力の改善を図る計画"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_6.
kg:st_7 rdfs:label "危機管理監早坂進"@ja.
kg:st_7 rdfs:type cls:st_2.
kg:op_38 prop:content "課題として整理している"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_7.
kg:op_39 prop:content "改善対応を進める"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_7.
kg:op_40 prop:content "分散避難の具体的整理を急ぐ"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_7.
kg:op_41 prop:content "食事の迅速な提供に対応する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_7.
kg:op_42 prop:content "避難所の居住性向上を図る"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_7.
kg:op_43 prop:content "地方創生臨時交付金等を活用して対応する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_7.
kg:op_44 prop:content "密対策として具体的な整理を急ぐ"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_7.
kg:st_8 rdfs:label "市民部長五十嵐浩一"@ja.
kg:st_8 rdfs:type cls:st_2.
kg:op_45 prop:content "市が推進しているものではない"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_8.
kg:op_46 prop:content "有形無形の文化財やストーリーに甚大な影響を及ぼす懸念がある"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_8.
kg:op_47 prop:content "出羽三山の山岳信仰と大きくかけ離れた計画"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "庁内説明会で懸念事項として伝えた"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_8.
kg:op_49 prop:content "住民への十分な説明や専門家意見聴取を要請する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_8.
kg:op_50 prop:content "市が意見を申し述べる機会がある"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_8.
kg:op_51 prop:content "フォトモンタージュも含め十分な説明が必要"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_8.
kg:op_52 prop:content "景観への影響を検討するため必要"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_8.
kg:op_53 prop:content "良好な景観を保存するため検討する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_8.
kg:op_54 prop:content "市民の混乱や地元合意形成の問題から取下げを望む"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_8.
kg:st_9 rdfs:label "健康福祉部長渡邉健"@ja.
kg:st_9 rdfs:type cls:st_2.
kg:op_55 prop:content "自治会との連携に課題が残った"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_9.
kg:op_56 prop:content "手渡すことができなかった"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_9.
kg:op_57 prop:content "安全かつ迅速な避難支援のため重層的な支援体制づくりが急務"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_9.
kg:op_58 prop:content "早急に具体策を提示したい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_9.
kg:st_10 rdfs:label "藤島庁舎支所長武田壮一"@ja.
kg:st_10 rdfs:type cls:st_2.
kg:op_59 prop:content "避難所運営に比重がかかり情報提供まで至らなかった"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_10.
kg:st_11 rdfs:label "黒井浩之議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_60 prop:content "帰宅のタイミングがつかめず困っていた"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_11.
kg:op_61 prop:content "まずラジオを配置したい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_10.
kg:op_62 prop:content "情報提供体制を強化する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_10.
kg:op_63 prop:content "避難者へ常に最新情報を提供できるようにする"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_10.
kg:op_64 prop:content "避難情報発令後に何の情報発信もないように感じた"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_11.
kg:op_65 prop:content "ＳＮＳ情報が役立ったという声があった"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_11.
kg:op_66 prop:content "避難勧告等や公共交通機関情報を発信している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_7.
kg:op_67 prop:content "今後も迅速かつ手軽な情報提供に取り組む"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_7.
kg:op_68 prop:content "まずはファクスでの情報共有から取り組む"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_7.
kg:op_69 prop:content "自治会役員は地元を走り回っていて避難所まで手が回らない"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_11.
kg:op_70 prop:content "自治会と消防団と避難所と災害対策本部をつなぐ人がいなかった"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_11.
kg:st_12 rdfs:label "消防長大川治"@ja.
kg:st_12 rdfs:type cls:st_2.
kg:op_71 prop:content "災害時の地域防災組織と消防団の連携役を担うのが現実的"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_12.
kg:op_72 prop:content "地域の防災訓練で検証し連携強化につなげる"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_12.
kg:op_73 prop:content "マンパワーの確保に努める"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_12.
kg:st_13 rdfs:label "荘内病院事務部長佐藤光治"@ja.
kg:st_13 rdfs:type cls:st_2.
kg:op_74 prop:content "４月５月の収益は大きく減収した"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_13.
kg:op_75 prop:content "実質的収支の結果に影響している"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_13.
kg:st_14 rdfs:label "草島進一議員"@ja.
kg:st_14 rdfs:type cls:st_16.
kg:op_76 prop:content "赤字体質となっているのではないか"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_14.
kg:op_77 prop:content "まずは一般診療を維持する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_13.
kg:op_78 prop:content "収支改善に全力で取り組む"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_13.
kg:op_79 prop:content "財源確保に努める"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_13.
kg:op_80 prop:content "受診控えが病床稼働率低下につながった"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_13.
kg:op_81 prop:content "100床以上空いている"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_14.
kg:op_82 prop:content "感染防止対策を強化して一般診療を維持する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_13.
kg:op_83 prop:content "制度創設には医療機関確保や体制整備の課題がある"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_9.
kg:st_15 rdfs:label "秋葉雄議員"@ja.
kg:st_15 rdfs:type cls:st_16.
kg:op_84 prop:content "地元に感染を広げない方策が必要"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_15.
kg:op_85 prop:content "庄内保健所や鶴岡地区医師会と検討を進める"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_9.
kg:op_86 prop:content "新たな技術開発にも注視しながら検討する"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_9.
kg:op_87 prop:content "産業や生態系や健康や災害への影響が懸念される"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_8.
kg:op_88 prop:content "地域に根差した再生可能エネルギーの導入により地球温暖化対策を推進する"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_8.
kg:op_89 prop:content "市民一人一人の意識や地域社会全体の意識を変えていくことが重要"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_8.
kg:op_90 prop:content "売電と公共施設供給を一体として進める"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_8.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "平成30年度に利用者数が19万人台に落ち込んだことに加え、温泉の加温に必要な灯油価格の高騰により、年間約200万円の赤字決算となっております"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "温泉の加温に必要な灯油価格の高騰により、年間約200万円の赤字決算となっております"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "昨年度においては、日本海山形県沖地震の影響から設備故障が相次ぎ休業日が増加、令和元年度の単年度収支で約800万円の赤字となっている状況でございます"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "令和元年度の単年度収支で約800万円の赤字となっている状況でございます"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "ゆぽか以外の２施設については利用客数の減少などを主な原因として利用料金制での運営が大変厳しい状況でございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "庁内横断での対応策を検討する庁内会議を立ち上げ、その会議で検討した素案について議会への説明を行いまして、第２回目以降の行財政改革推進委員会において御意見を頂戴してまいりたいと考えております"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "ぽっぽの湯、ゆ～Ｔｏｗｎともに地元住民の強い要望により設置された施設でございますので、地元住民などへの丁寧な説明を行いながら検討を進めてまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "利用料金制の廃止による公営化、健康増進施設等を目的とした保養施設への切替えなども含め、様々な選択肢を視野に指定管理者である各運営会社との協議を踏まえ、十分な検証、検討を行い"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "公設民営をコミュニティ方式の公設公営に切り替え、最小限の管理運営にて健康増進などを目的とした保養施設に切り替えることも一つの方法であり"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "平成30年度は源泉ポンプ落下事故により約３か月の休業を余儀なくされ"@ja.
<< kg:id_11 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "令和元年度は約12万人と回復を見せたものの、源泉ポンプ落下事故前と比較をいたしますと約２万人の利用者が減少し"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:text-txt_contents "平成30年度は源泉ポンプ落下事故により約３か月の休業を余儀なくされ"@ja.
<< kg:id_11 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "昨年、令和元年度単年度収支では約936万円の赤字が出ております"@ja.
<< kg:id_11 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "ぽっぽの湯と櫛引地域のくしびき温泉ゆ～Ｔｏｗｎの２施設については、利用料金制での運営が困難な状況になっております"@ja.
<< kg:id_11 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "施設の老朽化の度合いや経営状況の予測、市の財政負担の見通しなど総合的な検討を行うため、庁内横断での対応策を検討する庁内会議を立ち上げ"@ja.
<< kg:id_11 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "利用料金制の廃止による公営化、健康増進施設等を目的とした保養施設への切替えなども含め、様々な選択肢を視野に"@ja.
<< kg:id_11 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "健康増進施設等を目的とした保養施設への切替えなども含め、様々な選択肢を視野に"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "灯油価格の高騰による燃料費支出の増加に加え、光熱水費が年々増嵩している傾向があり"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:text-txt_contents "光熱水費が年々増嵩している傾向があり"@ja.
<< kg:id_16 prop:cause kg:id_19 >>
    prop:text-txt_contents "施設修繕費等が経営を圧迫し"@ja.
<< kg:id_16 prop:cause kg:id_20 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "新型コロナウイルス感染拡大防止を図るため、指定管理施設の３温泉に合わせた形で４月初旬より約１か月半の間休業し、さらには営業再開後も利用者数は回復せず、新型コロナウイルス感染症の収束が見えない中で、年間の利用者数は対前年比で約30％減少する見込みとなっております"@ja.
<< kg:id_16 prop:effect kg:id_21 >>
    prop:text-txt_contents "令和元年度単年度決算では約144万円の赤字となっております"@ja.
<< kg:id_16 prop:effect kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "年間の利用者数は対前年比で約30％減少する見込みとなっております"@ja.
<< kg:id_16 prop:effect kg:id_23 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "組合は法人、あるいは個人事業主に当たらないとして国の持続化給付金も受けることができず、経営の継続が困難な状況にあります"@ja.
<< kg:id_16 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "今後も地域住民が一体となった経営が持続できるよう、今回の補正予算で支援を行うものとしたものでございます"@ja.
<< kg:id_16 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "当面はこれまでと同様の支援を継続してまいりたいと考えております"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:text-txt_contents "駅前から東側の大道堰と交差するまでの約340メートル区間と、それから国道112号線とＪＲ羽越本線が交差する大宝寺地区の２か所で既存暗渠ですとか、側溝断面が小さいために流下能力が不足し"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "鶴岡駅駅前と国道112号アンダーに冠水被害が発生しているということが明らかになっております"@ja.
<< kg:id_26 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "平成29年度より国道112号の管理者と協議を進めておりまして、雨水排水路の詳細設計を実施し、改善に向けた準備、検討を行っております"@ja.
<< kg:id_26 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "国道112号アンダーの冠水被害の対策について調査に基づいて検討を進めていただいております"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:text-txt_contents "平成30年に都市化に伴い雨水の排水量が増加したことに対応するため、事業計画を見直しております"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "７月27日から28日の豪雨によって各企業の敷地内の浸水により、多くの企業及び従業員に悪影響を与えました"@ja.
<< kg:id_31 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "今年度から茅原第２排水区の下流となる東側から順次工事に着手し、10年間の予定で工事を実施しているところでございます"@ja.
<< kg:id_31 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "今年度、幹線排水路と青龍寺川の排水口を改修するため詳細設計を行っているところでございまして、来年度からの３か年の予定で排水路と排水口の整備工事を実施し"@ja.
<< kg:id_31 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "平成28年度に商工会議所から広範囲な調査の実施についての要望、鶴岡中央工業団地管理組合環境部会や鶴岡市企業懇談会などを通じましては、雨水対策の早期解決の要望をいただいているところでございます"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:text-txt_contents "７月27日から28日の豪雨により河川が増水し"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "藤島川沿いの藤島元町地区、柳久瀬町内会、京田川沿いの三和町内会、鷺畑町内会、千原町内会、藤島関根町内会に避難勧告が発令され"@ja.
<< kg:id_37 prop:effect kg:id_40 >>
    prop:text-txt_contents "住宅など建物の浸水、農作物の冠水など多くの被害が報告されております"@ja.
<< kg:id_37 prop:effect kg:id_41 >>
    prop:text-txt_contents "住宅など建物の浸水、農作物の冠水など多くの被害が報告されております"@ja.
<< kg:id_37 prop:contermeasure kg:id_42 >>
    prop:text-txt_contents "コンクリートブロックによる護岸の強靱化工事"@ja.
<< kg:id_37 prop:contermeasure kg:id_43 >>
    prop:text-txt_contents "川の流れを妨げる土砂が堆積している河床のしゅんせつ工事などが県の河川事業により進められております"@ja.
<< kg:id_37 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "今年度は堆積土を掘削する河床しゅんせつ、河川内の樹木伐採などを実施しております"@ja.
<< kg:id_45 prop:cause kg:id_38 >>
    prop:text-txt_contents "７月27日から28日の豪雨により河川が増水し"@ja.
<< kg:id_45 prop:effect kg:id_39 >>
    prop:text-txt_contents "京田川沿いの三和町内会、鷺畑町内会、千原町内会、藤島関根町内会に避難勧告が発令され"@ja.
<< kg:id_45 prop:effect kg:id_40 >>
    prop:text-txt_contents "住宅など建物の浸水、農作物の冠水など多くの被害が報告されております"@ja.
<< kg:id_45 prop:effect kg:id_41 >>
    prop:text-txt_contents "住宅など建物の浸水、農作物の冠水など多くの被害が報告されております"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:text-txt_contents "京田川の三和地区におきましては、河床しゅんせつ"@ja.
<< kg:id_45 prop:contermeasure kg:id_47 >>
    prop:text-txt_contents "護岸整備により川幅を拡大する河川整備事業が平成23年から令和５年までの予定で進められております"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "特に下流の長沼地区においては毎年状況が読めるのに何とかならないのかという地域の声を"@ja.
<< kg:id_48 prop:effect kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "そこに住んでいる住民にすれば、強い雨が降るたびに不安を抱える、耐えられない心境であると十分察せられます"@ja.
<< kg:id_48 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "令和５年度の完了を目指して農業地域防災・減災事業により、長沼集落から京田川までの約1.4キロの排水路の整備となっております"@ja.
<< kg:id_48 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "集落内を流れる幹線水路と道路側溝など約1.2キロで大断面の水路に交換するとともに"@ja.
<< kg:id_48 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "排水口をこれまで藤島川に排水しておりましたけれども、より低い場所を流れる京田川に付け替えるということで、流下能力の改善を図る計画としております"@ja.
<< kg:id_54 prop:cause kg:id_55 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "避難所開設初期におきまして受付が込み合ったこと"@ja.
<< kg:id_54 prop:cause kg:id_56 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "食事の提供が遅れたこと"@ja.
<< kg:id_54 prop:cause kg:id_57 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "広瀬地域活動センターをはじめ、ほかの場所でも雑魚寝などによる密状態が生じたともお聞きしております"@ja.
<< kg:id_54 prop:effect kg:id_58 >>
    prop:text-txt_contents "避難所に求められたものとして、居住性を高めるためのアルミマットの配備等がございました"@ja.
<< kg:id_54 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "食事の迅速な提供といたしましては、食料備蓄品としてのアルファ化米の配備"@ja.
<< kg:id_54 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "避難所の居住性向上につきましては折り畳みアルミマット"@ja.
<< kg:id_54 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "段ボールベッド等の手配、これらを地方創生臨時交付金等の有効資金を活用しながら対応してまいりたい"@ja.
<< kg:id_54 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "避難所の密対策といたしましては、近隣施設、それからホテル、旅館等への分散避難の具体的な整理を急いでまいりたいと存じます"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "このたびの風力発電事業につきましてはあくまでも民間事業者による民間事業者の計画であり、この計画を市が推進しているものではございません"@ja.
<< kg:id_63 prop:effect kg:id_65 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_46;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "このたびの事業想定区域に風力発電施設が建設されることになれば、既に日本遺産に認定されている有形・無形の文化財や、そのストーリーに対して甚大な影響を及ぼすのではないかという懸念を持っているところでございます"@ja.
<< kg:id_63 prop:effect kg:id_66 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "市側から事業実施想定区域が山岳信仰の重要な場所であり、日本遺産の指定を受けている出羽三山に近接すること、こういったことから市民の相当な反発が予想されるなどの懸念事項を伝えるとともに"@ja.
<< kg:id_63 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "風力発電施設の設置等に係るガイドラインに基づき、住民への十分な説明や専門家からの意見聴取などについて適切な対応を要請する"@ja.
<< kg:id_63 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "計画段階環境配慮書、次の環境影響評価方法書、そして環境影響評価準備書、この各段階において市の意見書を山形県に提出することで意見を申し述べる機会がございます"@ja.
<< kg:id_63 prop:contermeasure kg:id_69 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "事業者に対しましては引き続き地元や関係各所への丁寧な説明を求めていきたいと考えております"@ja.
<< kg:id_63 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "景観への影響を検討するためにフォトモンタージュの作成を要請したところでございます"@ja.
<< kg:id_63 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "良好な景観を保存するため、ゾーニングを含めたガイドラインの改定を検討してまいりたいと考えております"@ja.
<< kg:id_63 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "この段階で事業者からの事業の取下げを望むものではありますが"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "マリカの避難所が開設されなかったことなど、避難先に関する情報が錯綜し"@ja.
<< kg:id_73 prop:cause kg:id_75 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "自治会役員と連絡がつかず、手渡すことができなかった"@ja.
<< kg:id_73 prop:effect kg:id_76 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "鶴岡地域の市街地の１つの学区においては提供することができず、町内会との連携に課題が残りました"@ja.
<< kg:id_73 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "名簿提供の時期や提供方法など、課題の共有を図るとともに、円滑な避難支援に向けて検討を進めており、早急に具体策を提示してまいりたいと存じます"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "避難所開設・運営に比重がかかり、避難者への河川水位や雨量などの情報提供までは至っていない状況でございました"@ja.
<< kg:id_78 prop:effect kg:id_80 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "避難者への河川水位や雨量などの情報提供までは至っていない状況でございました"@ja.
<< kg:id_78 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "今後は各避難所にまずラジオを配置したいというふうに思います"@ja.
<< kg:id_78 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "避難所開設時には、配置職員を１名増員したいと考えております"@ja.
<< kg:id_78 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "河川水位や雨量などの有用な情報は、庁舎から定期的にファクスを配信して、避難所職員に伝え、避難者へは常に最新の情報を提供できるよう努めてまいりたい"@ja.
<< kg:id_84 prop:cause kg:id_85 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "災害時における市からの情報は、発生時の避難情報発令があり、その後、避難解除を出すまで何の情報発信もないように思われます"@ja.
<< kg:id_84 prop:effect kg:id_86 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "市民にとって必要な情報提供がなされていないように感じました"@ja.
<< kg:id_84 prop:contermeasure kg:id_87 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "このたびの大雨では、避難勧告等の発令や公共交通機関の情報を市ホームページと連動し、市の公式フェイスブックでも発信しております"@ja.
<< kg:id_84 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "ツイッターやインスタグラム、ＬＩＮＥなどが県や他市でも活用され、災害情報なども発信されているということから、今後も市民への迅速かつ手軽な情報につきまして取り組んでまいりたいと存じます"@ja.
<< kg:id_84 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "タブレットやパソコンの配備につきましては、施設の設備環境、それから経費負担の関係もございますので、まずは当面できるところからといたしまして、避難所となる地域活動センター等へのファクスでの情報共有、こういったことなどから取り組み始めてまいりたいと存じます"@ja.
<< kg:id_90 prop:cause kg:id_91 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "このたび痛切に感じたのは、やはり現場と避難所にマンパワーが足りないということです"@ja.
<< kg:id_90 prop:effect kg:id_92 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "自治会から自治振興会に集まってくる地区の最新情報を避難所や災害対策本部、消防団につなげる人がいない。逆に避難経路の安全確保のために道路の冠水や閉鎖の状況を自治会に伝える人がいませんでした"@ja.
<< kg:id_90 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "現在、本市消防団には大規模災害における支援活動や災害時の情報収集、伝達などの活動を行うことを任務としているＯＢ団員が各方面隊、分団に在籍しております。まさにこの消防団ＯＢが災害時の地域の防災組織と消防団の連携役を担うことが現実的であると考えております"@ja.
<< kg:id_90 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "平時から意見交換の機会を設け、それぞれが課題を整理して役割を確認するとともに、地域の防災訓練において検証し、大規模災害時の連携強化につなげたいと考えております"@ja.
<< kg:id_90 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "今後もＯＢ団員の増員を図りつつ、大規模災害時における住民への避難伝達や避難誘導を含め、方面隊、分団を超えた消防団の応援体制を確立するなど、マンパワーの確保にも努めてまいります"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "令和２年度の現状については、新型コロナ感染症の影響もあり、４月、５月の収益は大きく減収しました"@ja.
<< kg:id_96 prop:cause kg:id_98 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "近年続けての消費税率引上げに伴い、医業外費用のうち控除対象外消費税の負担が増えており、実質的収支の結果に影響していると捉えております"@ja.
<< kg:id_96 prop:effect kg:id_99 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "令和元年度決算では、万円単位で申し上げますと、２億6,071万円の純損失のうち荘内病院の純損失は２億4,866万円であります"@ja.
<< kg:id_96 prop:effect kg:id_100 >>
    prop:text-txt_contents "累積欠損金は128億9,679万2,000円となった"@ja.
<< kg:id_96 prop:contermeasure kg:id_101 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "まずは、院内の感染対策を強化して、一般患者診療の維持に努め"@ja.
<< kg:id_96 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "併せて診療報酬の加算の取得や経費の見直しに取り組む"@ja.
<< kg:id_96 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "国からのコロナ感染症専用病床に対する空床補償料なども申請し、財源の確保に努めてまいります"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:text-txt_contents "これは、インフルエンザ等の季節性感染症の患者が少なかったことや"@ja.
<< kg:id_104 prop:cause kg:id_106 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "国内で新型コロナ感染症が発生したことが受診行動に影響を与え、結果として病床稼働率の低下につながったものと捉えております"@ja.
<< kg:id_104 prop:effect kg:id_107 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "元年度稼働病床利用率が76.9％"@ja.
<< kg:id_104 prop:effect kg:id_108 >>
    prop:text-txt_contents "今年４月から７月までの入院延べ患者数は３万9,898人で、前年度同期に比べ8,962人、約18.3％の減少となっており"@ja.
<< kg:id_104 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "手術前等の患者のスクリーニング検査を行うなど、感染防止対策を強化し、一般診療を維持できるよう努めてまいりたい"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "制度創設の前提となる希望者がＰＣＲ検査を受けることができる医療機関の確保や体制、宿泊施設の借上げなどの課題があるものと認識しております"@ja.
<< kg:id_110 prop:effect kg:id_112 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "本市で同様の方策、制度を実施するに当たりましては、制度創設の前提となる希望者がＰＣＲ検査を受けることができる医療機関の確保や体制、宿泊施設の借上げなどの課題があるものと認識しております"@ja.
<< kg:id_110 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "庄内地域におけるＰＣＲ検査体制の整備や唾液による検査の導入など、検査体制の強化について、庄内保健所や鶴岡地区医師会と検討を進めているところでございまして"@ja.
<< kg:id_110 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "唾液による検査の導入など、検査体制の強化について"@ja.
<< kg:id_115 prop:cause kg:id_116 >>
    prop:text-txt_contents "地球温暖化の原因は、人間活動による温室効果ガスの増加である可能性が高いとされています"@ja.
<< kg:id_115 prop:cause kg:id_117 >>
    prop:text-txt_contents "温室効果ガス別の地球温暖化へ与える影響としては、二酸化炭素が76％を占めております"@ja.
<< kg:id_115 prop:effect kg:id_118 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "今後さらに猛暑や豪雨が増え、産業や生態系など広い分野への影響、また健康への影響や大雨による災害の発生などが懸念をされております"@ja.
<< kg:id_115 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "平成25年度策定の鶴岡市地域エネルギービジョンに基づき、地域に根差した再生可能エネルギーの導入を推進することにより、地球温暖化対策を積極的に推進することとしております"@ja.
<< kg:id_115 prop:contermeasure kg:id_120 >>
    prop:text-txt_contents "鶴岡第四中学校などへの太陽光発電設備の導入などにより、公共施設から排出される温室効果ガスの削減に努めているところであります"@ja.
<< kg:id_115 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "平成30年度には、クールチョイスに賛同し、市民の皆様に対して脱炭素社会づくりに貢献する製品の買換え、公共交通機関の利用、３Ｒの実施などを呼びかけてまいりました"@ja.
<< kg:id_115 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "新たなごみ焼却施設においては、ごみの焼却に伴い発生する廃熱を利用して発電を行うエネルギー回収型の施設整備に取り組んでおり、この電力を構内で使用するほか、余剰電力については、売電と市内小・中学校等公共施設への供給を一体として電力の地産地消事業の取組を進めております"@ja.
}
