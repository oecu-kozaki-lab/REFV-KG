kg:st_1 rdfs:label "介護事業者"@ja.
kg:st_1 rdfs:type cls:st_133.
cls:st_133 rdfs:label "介護事業者"@ja.
kg:op_1 prop:content "認定軽減で施設退去を余儀なくされるのは切実だ"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "認定軽減後に有料老人ホームを探して入所せざるを得なかった"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "本人"@ja.
kg:st_2 rdfs:type cls:st_134.
cls:st_134 rdfs:label "本人"@ja.
kg:op_3 prop:content "家族の負担金が増えることを申し訳なく思っている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "本人に見合った認定が必要で変更申請を行っている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "転倒による大きなけがを危惧している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "転倒が重度化につながるおそれがある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_3 rdfs:label "ちよさんの家世話人会"@ja.
kg:st_3 rdfs:type cls:st_135.
cls:st_135 rdfs:label "運営団体"@ja.
kg:op_7 prop:content "専門職の指導があるからこそ4年間継続できた"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "世話人会だけでは4年間の継続は不可能だったと思う"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:st_4 rdfs:label "通所されている方々"@ja.
kg:st_4 rdfs:type cls:st_22.
cls:st_22 rdfs:label "利用者"@ja.
kg:op_9 prop:content "2年ほどでつまずきがなくなった"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "夜中や明け方のこむら返りがなくなった"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "肩凝りがなくなり体が軽くなった"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "認知症の方も孤立させない介護予防を実践している"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:st_5 rdfs:label "坂本昌栄議員"@ja.
kg:st_5 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_13 prop:content "専門職支援を受けやすくするため謝金上限の引上げを検討すべきだ"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:op_14 prop:content "必要性を重視して市独自支援も視野に計画へ盛り込むべきだ"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "手挙げがなくても必要性を重視して方向性を示すべきだ"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_5.
kg:st_6 rdfs:label "家族の方"@ja.
kg:st_6 rdfs:type cls:st_136.
cls:st_136 rdfs:label "家族"@ja.
kg:op_16 prop:content "本市での施設新設を強く要望している"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_6.
kg:op_17 prop:content "市内に施設がなく通所や面会の負担が大きい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_6.
kg:op_18 prop:content "必要性を重視し市独自支援も視野に計画へ盛り込むべきだ"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_5.
kg:st_7 rdfs:label "市民"@ja.
kg:st_7 rdfs:type cls:st_42.
cls:st_42 rdfs:label "市民"@ja.
kg:op_19 prop:content "保険料は高いのにサービスは思うように受けられない"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_7.
kg:op_20 prop:content "認定が厳しく在宅サービスを受けにくい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_7.
kg:op_21 prop:content "基金を活用して保険料引下げを検討すべきだ"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:st_8 rdfs:label "鶴岡地区医師会"@ja.
kg:st_8 rdfs:type cls:st_137.
cls:st_137 rdfs:label "医師会"@ja.
kg:op_22 prop:content "当番医回数が増え負担が増加している"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_8.
kg:op_23 prop:content "医師の高齢化で継続運営の負担が重い"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_8.
kg:op_24 prop:content "開設日等の見直しを求めている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_8.
kg:op_25 prop:content "開設日や運営方法の見直しを要望している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_8.
kg:op_26 prop:content "緊急事態を想定し市独自に医療崩壊を防ぐ検討が必要だ"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "資材高騰が経営を圧迫している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "地域包括ケア推進室と荘内病院が一緒に検討すべきだ"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "私的病院も含めた全域の医療体制構築が必要だ"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "医師会も疲弊しており地域医療構想の推進が必要だ"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:st_9 rdfs:label "地元の方"@ja.
kg:st_9 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_31 prop:content "屋根の雪下ろしや帰宅困難が切実な問題だ"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_9.
kg:op_32 prop:content "冬季間の雪下ろしを何回もしなければならない"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_9.
kg:op_33 prop:content "国道から先に入れず車中泊することもある"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_9.
kg:op_34 prop:content "帰宅できず車中泊を余儀なくされている"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_9.
kg:st_10 rdfs:label "地域の検討委員会"@ja.
kg:st_10 rdfs:type cls:st_138.
cls:st_138 rdfs:label "検討組織"@ja.
kg:op_35 prop:content "住民による除排雪負担を軽減する仕組みづくりを試行している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_10.
kg:op_36 prop:content "地域だけでの除雪が難しく外部支援も必要だ"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_10.
kg:st_11 rdfs:label "山田守議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_37 prop:content "除雪機の軽油費への補助を求める声がある"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_11.
kg:st_12 rdfs:label "朝日庁舎支所長"@ja.
kg:st_12 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_38 prop:content "地域住民が当事者意識を持ち課題を共有できた"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_12.
kg:op_39 prop:content "小さな実践と成功体験の積み上げが地域の挑戦意欲を高めた"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_12.
kg:op_40 prop:content "旧大網小学校跡地への施設整備が活動の場づくりにつながった"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_12.
kg:op_41 prop:content "居住の権利と地域の暮らしを守る責務がある"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_11.
kg:op_42 prop:content "地域独自の取組が困難になっている"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_11.
kg:op_43 prop:content "広域コミュニティとしての活動を促す必要がある"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_12.
kg:op_44 prop:content "引き続き人的支援を行う"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_12.
kg:op_45 prop:content "地域の実情に応じた広域での支え合いが必要だ"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_12.
kg:op_46 prop:content "休日夜間診療所の継続運営が心配される"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_5.
kg:op_47 prop:content "今後の対応策を検討すべきだ"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:st_13 rdfs:label "長谷川剛議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_48 prop:content "治療放置を自己責任にせず社会的対策が必要だ"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_13.
kg:op_49 prop:content "将来の健康を損なう要因になる"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_13.
kg:op_50 prop:content "子供の将来に深刻な影響がある"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_13.
kg:op_51 prop:content "口腔の健康格差の背景に貧困がある"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_13.
kg:op_52 prop:content "治療の放置を親の責任に転嫁せず社会的対策を講じる必要がある"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_13.
kg:op_53 prop:content "県の貧困率から見て就学援助が十分行き渡っていない可能性がある"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_13.
kg:op_54 prop:content "保護者にとってハードルが高い場合がある"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_13.
kg:op_55 prop:content "支給基準を引き上げて利用対象を拡大すべきだ"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_13.
kg:op_56 prop:content "広域連携や委託が危機管理能力を損なわないか懸念する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_13.
kg:op_57 prop:content "委託推進や人員削減が危機管理能力を奪っていないか危惧する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_13.
kg:op_58 prop:content "技術継承と人材育成が課題だ"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_13.
kg:op_59 prop:content "技術力と事務能力の低下が懸念される"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_13.
kg:st_14 rdfs:label "学習会参加者"@ja.
kg:st_14 rdfs:type cls:st_74.
cls:st_74 rdfs:label "参加者"@ja.
kg:op_60 prop:content "環境影響評価法では歯止めにならないのではないか"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_14.
kg:st_15 rdfs:label "菅井巌議員"@ja.
kg:st_15 rdfs:type cls:st_16.
kg:op_61 prop:content "利益が地域外へ流れ地域経済循環につながりにくい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_15.
kg:op_62 prop:content "風車を回して地域経済を回す形になっていない"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_15.
kg:op_63 prop:content "将来リスクを住民に十分知らせるべきだ"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_15.
kg:op_64 prop:content "地域の自然環境に精通した専門家の話をよく聞くべきだ"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_15.
kg:op_65 prop:content "山林開発の影響を軽視すべきでない"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_15.
kg:op_66 prop:content "自治体としてより慎重な対応を取るべきだ"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_15.
kg:st_16 rdfs:label "市民部長"@ja.
kg:st_16 rdfs:type cls:st_2.
kg:op_67 prop:content "将来的なリスクも踏まえた丁寧な説明を事業者に求める"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_16.
kg:st_17 rdfs:label "健康福祉部長"@ja.
kg:st_17 rdfs:type cls:st_2.
kg:op_68 prop:content "今後はより効果的な方法で認知度を高める必要がある"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_17.
kg:op_69 prop:content "障害福祉に限らず介護や医療との連携で周知を強めたい"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_17.
kg:op_70 prop:content "地域の将来ビジョンを含めた利活用検討が必要だ"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_15.
kg:st_18 rdfs:label "教育部長"@ja.
kg:st_18 rdfs:type cls:st_2.
kg:op_71 prop:content "様々な制約がある場所であり事業者との調整が必要だ"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_18.
kg:op_72 prop:content "重要性と緊急性を踏まえ指定登録に向けた取組を進める"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_18.
kg:st_19 rdfs:label "加藤鑛一議員"@ja.
kg:st_19 rdfs:type cls:st_16.
kg:op_73 prop:content "平和都市宣言の首長として市民にメッセージを発してほしい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_19.
kg:op_74 prop:content "小規模自治体への配慮が必要で品格が問われる"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_19.
kg:op_75 prop:content "両市町が公平公正に負担し合う合理的な算定方法だ"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_16.
kg:st_20 rdfs:label "加賀山茂議員"@ja.
kg:st_20 rdfs:type cls:st_16.
kg:op_76 prop:content "若者が地域に根差し地域づくりの原動力になる将来構想が必要だ"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_20.
kg:op_77 prop:content "統合後に失った日常保障への手だてを示してほしい"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_20.
kg:op_78 prop:content "地域活動の拠点整備が急務だ"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_20.
kg:op_79 prop:content "行政として地域づくりの本気度を示してほしい"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_20.
kg:op_80 prop:content "避難所全般で大人数対応が困難になっている"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_20.
kg:st_21 rdfs:label "危機管理監"@ja.
kg:st_21 rdfs:type cls:st_2.
kg:op_81 prop:content "公民館や親戚知人宅への分散避難をお願いしている"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_21.
kg:op_82 prop:content "収容人員を超える場合は周辺避難所を拡大開設する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_21.
kg:op_83 prop:content "障害者や高齢者の避難先確保を検討している"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_21.
kg:st_22 rdfs:label "市民団体や参加者"@ja.
kg:st_22 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_84 prop:content "映画館の復活可能性を喜ばしく受け止めている"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_22.
kg:st_23 rdfs:label "映画機能付交流スペース利活用検討会"@ja.
kg:st_23 rdfs:type cls:st_138.
kg:op_85 prop:content "映画と福祉の融合やバリアフリー映画館の可能性を検討している"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_23.
kg:op_86 prop:content "福祉と文化の新たな接点が生まれることを期待している"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_17.
kg:op_87 prop:content "市社協事務局の移転で福祉と文化の融合が期待される"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_17.
kg:op_88 prop:content "市民生活の向上と地域課題の解決に貢献する計画にしたい"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_18.
kg:op_89 prop:content "文化芸術は市民生活の向上と地域活性化につながる"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_18.
kg:op_90 prop:content "多様な価値を認め合う豊かな人間関係をつくる"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_18.
kg:op_91 prop:content "新たな活力を生み活力ある地域づくりに結びつく"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_18.
kg:st_24 rdfs:label "企画部長"@ja.
kg:st_24 rdfs:type cls:st_2.
kg:op_92 prop:content "国際的な評価は市民の誇りとなる"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_24.
kg:op_93 prop:content "食文化は本市の大きな特徴として発信力がある"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_24.
kg:op_94 prop:content "新たな価値創造と発信を強める必要がある"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_24.
kg:op_95 prop:content "国内ネットワークを通じ新たな価値の創造と発信に努める"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_24.
kg:op_96 prop:content "SDGs推進には人材育成が不可欠だ"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_24.
kg:op_97 prop:content "デジタル化や未来技術で生活の質向上を目指す"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_24.
kg:op_98 prop:content "研究成果が市民の保健医療福祉の向上に寄与することが重要だ"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_24.
kg:op_99 prop:content "鶴岡にいながら高度医療を享受でき患者負担軽減が期待される"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_24.
kg:op_100 prop:content "移動手段の利便性向上で生活の質向上を図る"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_24.
kg:op_101 prop:content "自習やストリートピアノなど公共ホールの枠を超えた利用が進んでいる"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_18.
kg:op_102 prop:content "市民ニーズに合った的確な館運営につなげたい"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_18.
kg:op_103 prop:content "館の実情に即した事業企画ができるよう職員育成を進める"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_18.
kg:st_25 rdfs:label "農林水産部長"@ja.
kg:st_25 rdfs:type cls:st_2.
kg:op_104 prop:content "市民が自然に親しみ観光客も交流できる中核的な森林公園が望ましい"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_25.
kg:op_105 prop:content "本市の中核的な森林公園になることを期待している"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_25.
kg:st_26 rdfs:label "鶴岡市社会福祉協議会"@ja.
kg:st_26 rdfs:type cls:st_139.
cls:st_139 rdfs:label "福祉団体"@ja.
kg:op_106 prop:content "中心市街地振興と映画機能の一部維持を考慮して取得を検討した"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_26.
kg:st_27 rdfs:label "山王まちづくり株式会社"@ja.
kg:st_27 rdfs:type cls:st_140.
cls:st_140 rdfs:label "運営会社"@ja.
kg:op_107 prop:content "旧まちキネを新しい形で再生し商店街振興を図りたい"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_27.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "介護事業者より、介護保険の認定が軽減することにより施設退去を余儀なくされたという切実な声が届いています"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "要介護以上の方しか入所できない介護老人保健施設にはとどまれず、施設職員が期間までに有料老人ホームを探し入所となりました"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本人は、家族に負担金が増えることで申し訳ないと泣いていたそうです"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "有料老人ホームでは歩行器での自主歩行となることから、何度か転倒を繰り返しているそうです"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "転倒により骨折や頭の打撲等が起きると"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "要介護１以上の状態になりかねないと危惧しています"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "専門職の方から来ていただき、指導を受けているからこそ４年間継続しています"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "世話人会だけでは途中挫折し、４年間の継続は不可能だったと思うとの訴えです"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "通所されている方々からは、２年ほど経過した頃からつまづきがなくなった"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "夜中や明け方にこむら返りをしなくなった"@ja.
<< kg:id_12 prop:effect kg:id_15 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "肩凝りがなくなり体が軽くなったとの声が上がっています"@ja.
<< kg:id_12 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "認知症になった方でも独りぼっちにしないために、認知の状況やその日の対応などの情報を共有して受入れを行い、介護予防の実践がされています"@ja.
<< kg:id_12 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "補助金交付要件の専門職謝金（報酬）を当面上限を24回に引き上げ、さらに整合性のある見直しを検討されるべきと考えます"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "看護等職員の新規確保が難しいなどの理由で事業採算の見通しが立たない状況です"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "事業採算の見通しが立たない状況です"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "いまだその方々は酒田市の施設に入所をしており"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "家族の方は休日を利用して往復しています"@ja.
<< kg:id_21 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "必要性を重視し、本市の独自支援も視野に本市の方向性を示す意味でも、第８期介護保険事業計画に盛り込むべきと考えます"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "市民からは、介護保険料は高いのにサービスは思うように受けられない"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "認定が厳しく、在宅でサービスを受けにくいなどの声が届いています"@ja.
<< kg:id_25 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "第８期介護保険事業計画においては、介護保険給付費準備基金を組み入れ、介護保険料の引下げの見直しを検討するべきと思われます"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "医師の減少及び高齢化などもあり、休日夜間診療所での当番医となる回数が増え、負担が増加している状況でございます"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "医師の減少及び高齢化などもあり"@ja.
<< kg:id_30 prop:effect kg:id_33 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "休日夜間診療所での当番医となる回数が増え、負担が増加している状況でございます"@ja.
<< kg:id_34 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "このたび医師会より休日夜間診療所の開設日等の変更などの見直しの要望書が提出されております"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "いまだにガウンや手袋は不足状態に加え"@ja.
<< kg:id_36 prop:cause kg:id_38 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "価格の高騰による経営への負担が増加しています"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "医師、看護師不足がここ数年の課題となっていることに加え"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "医師、看護師不足がここ数年の課題となっていることに加え"@ja.
<< kg:id_39 prop:cause kg:id_32 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "医師の高齢化も本市では進んでいる"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "大網地区は全国的にも有数の豪雪地帯であり"@ja.
<< kg:id_42 prop:cause kg:id_44 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "例年ですと３メートルほどの積雪がある地域でございます"@ja.
<< kg:id_45 prop:effect kg:id_46 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "豪雪によって家に帰れなくなる人も出ていることが紹介され"@ja.
<< kg:id_45 prop:effect kg:id_47 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "ホテルやコンビニの駐車場で車中泊をしている"@ja.
<< kg:id_48 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "安全な雪下ろし講習会や他地域での除雪活動を行う三瀬スノースイーパーや朝日町の朝日雪下ろし隊等との連携を含め、住民による除排雪に係る負担軽減を図るための仕組みづくりを試行的に行っております"@ja.
<< kg:id_48 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "地域の検討委員会の中でも、安全な雪下ろし講習会やシルバー人材センターへの雪下ろしの依頼などを進められていること"@ja.
<< kg:id_51 prop:contermeasure kg:id_52 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "高齢者や要支援者世帯の玄関前除雪を近隣住民グループで行う際の除雪機の燃料費等の支援を行っております"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "地域の将来像となる地域デザインを策定する過程で地域住民が当事者意識を持ち、地域課題を共有することができた"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "小さな実践と成功体験を積み上げていくことにより、自分たちでできることを考え挑戦する気風が強まっていると感じております"@ja.
<< kg:id_53 prop:effect kg:id_56 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "旧大網小学校跡地に広域コミュニティ施設を移転新築することで、地域活動の拠点を整備することができた"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "中山間地域におきましては、人口減少や高齢化に伴う地域の担い手不足が進み"@ja.
<< kg:id_57 prop:cause kg:id_59 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "人口減少や高齢化に伴う地域の担い手不足が進み"@ja.
<< kg:id_57 prop:effect kg:id_60 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "単独の集落だけでは解決できない問題が生じており"@ja.
<< kg:id_61 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "集落支援員を配置した人的支援を引き続き行うとともに"@ja.
<< kg:id_61 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "広域コミュニティとしての活動についても議論を促しているところでございます"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "鶴岡地区医師会は会員数が減少し、高齢化が進んでいます"@ja.
<< kg:id_64 prop:effect kg:id_66 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "このような状況で休日夜間診療所の継続した運営も心配されています"@ja.
<< kg:id_67 prop:effect kg:id_68 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "かむことが困難な口腔崩壊の子供が少なからず存在する"@ja.
<< kg:id_69 prop:effect kg:id_70 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "歯の喪失は、運動・学習能力の低下を招き"@ja.
<< kg:id_69 prop:effect kg:id_71 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "歯の喪失は、運動・学習能力の低下を招き"@ja.
<< kg:id_69 prop:effect kg:id_72 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "将来の健康を損なう要因になると言われております"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "このような口腔の健康格差を生み出す構造的要因として、貧困が存在します"@ja.
<< kg:id_75 prop:effect kg:id_76 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "約７人に１人の子供が貧困状態にあるということで"@ja.
<< kg:id_77 prop:cause kg:id_78 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "就学援助は申請が必要であり、民生委員の方の聞き取りを受ける、そういったケースもあるためにハードルが高いと考える保護者もいる"@ja.
<< kg:id_79 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "本市においても支給基準を引き上げ、利用対象を拡大すべきではないかと考えます"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "人口減少による水需要の低迷により、水道料金収入は年々減少しております"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "施設の点検業務や修繕関連業務等の委託や事務の効率化に伴い、職員数は年々減少傾向にある"@ja.
<< kg:id_83 prop:cause kg:id_85 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "技術職員の退職や人事異動等により人材育成が困難になり"@ja.
<< kg:id_83 prop:cause kg:id_86 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "人事異動等により人材育成が困難になり、今後は技術力、事務能力の低下が懸念される"@ja.
<< kg:id_87 prop:cause kg:id_88 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "たとえ一定以上の影響があったとしても事業を強制的に中止させる機能はないとされ、参加者からは歯止めにはならないのではないかという疑問が出されました"@ja.
<< kg:id_87 prop:cause kg:id_89 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "現在本市で建設、計画されている風力発電事業は、外資系の県外企業であります"@ja.
<< kg:id_87 prop:effect kg:id_90 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "電力供給による利益の中心の流れは、企業本社、中央、出資者である外資系資本へ流れていきます"@ja.
<< kg:id_91 prop:effect kg:id_92 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "騒音や低周波での健康被害"@ja.
<< kg:id_91 prop:effect kg:id_93 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "山林開発と風車の設置での動植物や生態系への影響"@ja.
<< kg:id_91 prop:effect kg:id_94 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "保水能力の低下と下流域への影響"@ja.
<< kg:id_91 prop:effect kg:id_95 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "土砂災害の誘発など懸念がある"@ja.
<< kg:id_91 prop:contermeasure kg:id_96 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "年内に改正を予定しております新たなガイドラインに基づき早期の段階で事業概要を公表するとともに、事業者側には将来的なリスクも踏まえた丁寧な説明を行っていただきながら"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "近年受給者数も年々減少傾向にあり、制度周知につきましては課題と認識しているところでございます"@ja.
<< kg:id_97 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "今後はより効果的な方法により認知度が高められるよう検討するとともに、障害福祉の領域のみならず、介護や医療など関係機関との連携や情報提供に一層努めてまいりたい"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "この場所は埋蔵文化財包蔵地であるため、工事前に調査を実施する必要がある"@ja.
<< kg:id_100 prop:cause kg:id_102 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "発掘調査にかかる費用は事業者側の負担となりますことなどから、様々な制約がある場所でございます"@ja.
<< kg:id_103 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "未指定文化財として今後調査の対象としたところでございます"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_19;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "核兵器廃絶を目指す取組は新たなステージに入ります"@ja.
<< kg:id_107 prop:effect kg:id_108 >>
    prop:stateBy kg:st_19;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "仮に住民１人当たりの負担額で比較すると、三川町は鶴岡市の約２倍になると思います"@ja.
<< kg:id_107 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "施設整備に係る費用の10％を両市町が等しく負担する均等割を新たに設けた"@ja.
<< kg:id_110 prop:cause kg:id_58 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "地方、地域は人口の減少に伴い活力の衰退が顕著に感じられます"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "小学校が統合となり、最も多くの住民が活動場所として使用していた旧小学校体育館は老朽化が著しく"@ja.
<< kg:id_111 prop:effect kg:id_113 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "地区として当たり前のこととして活動してきたことが困難な状況であります"@ja.
<< kg:id_111 prop:effect kg:id_114 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "行政に対する不満が大きくなっている"@ja.
<< kg:id_115 prop:cause kg:id_116 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "コロナ禍では大人数の避難者に対応することが困難になっているものと思います"@ja.
<< kg:id_117 prop:contermeasure kg:id_118 >>
    prop:stateBy kg:st_21;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "指定避難所のほか、町内会、自治会の公民館、集会場等への避難や、親戚、知人宅への自主避難などといった分散避難をお願いしているところでございます"@ja.
<< kg:id_117 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_21;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "避難所の収容人員が超えるような場合は、周辺の指定避難所を順次拡大して開設する対応も検討しております"@ja.
<< kg:id_120 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_21;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "障害者や高齢者等の避難行動要支援者に対しましては、旅館、ホテルなどへの避難ができるような仕組みについて検討しているところでございます"@ja.
<< kg:id_122 prop:effect kg:id_123 >>
    prop:stateBy kg:st_22;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "多くの市民がまちキネ復活の可能性を喜ばしく受け止めていると認識しております"@ja.
<< kg:id_124 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_23;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "映画機能を発揮した多様な交流を促進する施設として利活用を検討し、持続的な運営を図ることを目的に"@ja.
<< kg:id_124 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "旧まちなかキネマの取得後、事務所機能を集約するとともに地域貢献の観点から、一部映画機能を残したスペースを運営主体に無償で貸し出す予定としておるところでございます"@ja.
<< kg:id_124 prop:effect kg:id_127 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "市社協事務局が旧まちキネに移転することにより、福祉と文化の新たな接点が生まれることが期待されております"@ja.
<< kg:id_128 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "芸術や文化財のほか教育や福祉、食文化、観光やまちづくりなど様々な分野を代表する方で構成いたします策定委員会を設置"@ja.
<< kg:id_130 prop:effect kg:id_131 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "文化芸術は人々の心を豊かにし"@ja.
<< kg:id_130 prop:effect kg:id_132 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "また創造性を高め"@ja.
<< kg:id_130 prop:effect kg:id_133 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "文化芸術活動が新たな活力を生み出し、それが地域活性化に寄与し、活力ある地域づくりに結びつくものと考えております"@ja.
<< kg:id_134 prop:effect kg:id_135 >>
    prop:stateBy kg:st_24;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "こうした取組が国際的に認められることは、内にあっては市民の誇りであり、郷土愛を育む原動力になります"@ja.
<< kg:id_134 prop:effect kg:id_136 >>
    prop:stateBy kg:st_24;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "外にあっては、鶴岡市の大きな特徴として本市を国内外に広く知っていただく機会となります"@ja.
<< kg:id_137 prop:effect kg:id_138 >>
    prop:stateBy kg:st_24;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "一方で創造的な取組が弱い。ＳＤＧｓとの関連性についての記載が不明瞭といった指摘を受けたところでございます"@ja.
<< kg:id_139 prop:contermeasure kg:id_140 >>
    prop:stateBy kg:st_24;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "昨年10月には、本市の発案により全国から90の自治体や団体の賛同を得て豊かな食の郷土づくり研究会を設立したところでございます"@ja.
<< kg:id_139 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_24;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "食や食文化を通じた人材教育プログラム、鶴岡型ＥＳＤの構築について検討してまいりたい"@ja.
<< kg:id_142 prop:effect kg:id_143 >>
    prop:stateBy kg:st_24;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "デジタル化や未来技術によるまちづくりを通じ市民が将来にわたって健康で安心し、生きがいの持てる豊かな地域の実現を目指すものでございます"@ja.
<< kg:id_142 prop:contermeasure kg:id_144 >>
    prop:stateBy kg:st_24;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "これに関連いたしましてこれまで行われてきたセミナーや地域健康づくり活動のほか、プロジェクトの研究成果等が将来的に市民等への積極的な情報提供などにつながることが期待されております"@ja.
<< kg:id_142 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_24;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "遠隔診療による相談治療や術後でのフォローなどが、今後、鶴岡にいながら享受でき、患者の経済的、身体的な負担軽減が期待されるところでございます"@ja.
<< kg:id_142 prop:contermeasure kg:id_146 >>
    prop:stateBy kg:st_24;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "公共施設や高齢者等の移動手段となるデマンドタクシーの予約システムの導入の検討などを進め、ＡＩ、ＩＣＴなどのデジタル化によるウエル・ビーイング・コミュニティの充実に取り組んでまいりたい"@ja.
<< kg:id_147 prop:effect kg:id_148 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "エントランスホールでは、高校生などが自習スペースとして使用したり、ストリートピアノを設置して演奏してもらうなど市民が集う場所ともなっております"@ja.
<< kg:id_147 prop:contermeasure kg:id_149 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "今後は指定管理者の事業計画等に対する評価指導機関としての（仮称）運営委員会を市で設置いたしまして、指定管理者の運営方針や各事業の内容について評価・チェックを行い"@ja.
<< kg:id_147 prop:contermeasure kg:id_150 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "定期的にタクトでの研修を行い、館の実情に即した事業の企画立案ができるよう職員の資質向上、育成につなげ"@ja.
<< kg:id_151 prop:contermeasure kg:id_152 >>
    prop:stateBy kg:st_25;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "現段階では森林公園としての整備がふさわしいものと考えているところでございます"@ja.
<< kg:id_153 prop:effect kg:id_154 >>
    prop:stateBy kg:st_25;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "森林浴やウオーキングにより自然に親しみ、チューリップ園に訪れる多くの市民や観光客の交流拠点として本市の中核的な森林公園になるものと期待しております"@ja.
<< kg:id_155 prop:cause kg:id_156 >>
    prop:stateBy kg:st_26;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "隣接する山王商店街をはじめとする中心市街地の振興、また旧まちキネ存続のため署名活動が行われている状況を考慮いたしまして、建物の保全と映画機能の一部維持を模索されていたところでございます"@ja.
<< kg:id_155 prop:contermeasure kg:id_157 >>
    prop:stateBy kg:st_27;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "山王まちづくり株式会社からは、山王商店街の魅力として旧まちキネを新しい形で再生し、市とともに商店街振興を図りたいとのお話を受けたところでございます"@ja.
}
