kg:st_1 rdfs:label "本間正芳議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "体力や運動能力の低下はコロナ禍ではやむを得ない"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "密を避けながら時間や場所を分散して体力づくりを進めるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "人や時間や場所を分散しながら体力や運動能力を培うべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "体力や運動能力の低下は仕方がない"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "密を避けながら工夫して体力づくりを進めてほしい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "泳力低下はこの状況では致し方ない"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "学校や教員は精いっぱい努力している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "泳力に関しても下がったのは致し方ない"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "学校外プールを利用したくてもバスがない"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "学校外プールを活用できるよう移動手段の確保を検討すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "年１回でも学校外プールでプロの教え方を学べないか"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "外部指導者をそろえたいが派遣が難しい団体もある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "特別支援学級の水泳教室は子どもたちにとってよい授業であり復活させてほしい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "学校と保護者の声も聞き事業の継続や復活を検討すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "バス等への配慮を教育委員会で交渉してほしい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "中核病院の発展なくしてまちの発展はないという考えに共感する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "豊富な実績と経験を生かし地域医療連携に尽力してほしい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "その考えに感銘を受け期待している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:st_2 rdfs:label "菅原一浩議員"@ja.
kg:st_2 rdfs:type cls:st_16.
kg:op_19 prop:content "観光関連は総じて厳しい状況にある"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "８月に入ってからさらに厳しさが増した感がある"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "感染状況を踏まえた適切な支援制度の構築を望む"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "全国でも数少ないミッシングリンクを抱える地域となっている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "今後とも粘り強く一体となって建設促進運動を展開したい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "調査結果は示されたが現実的には厳しい数字との印象もある"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "高速化と並行して研究分析を続けてほしい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "コロナ禍での陳情要望活動は非常に困難を伴っている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "築いてきた交渉ルートを維持し強力な要望活動を再開継続してほしい"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "特別教室の整備計画を着実に進めてほしい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "公共施設への冷房設置は今後必須である"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "改築や大規模改修に伴い設置率を高めてほしい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:st_3 rdfs:label "本間信一議員"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_31 prop:content "地域内で循環させる構想であり大変よい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "小麦は地域内自給圏構想にぴったりの作物だ"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "消費面の認知がまだであり学校給食や宣伝で理解を広げるべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "学校給食で提供し精神や本意も子どもに理解してもらうべき"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "作付しない土地が増え分担金がネックになっている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "水を使わない農地でも分担金が発生するのは理解が難しい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "コストを下げて生産者の負担軽減に努力してほしい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "繁殖部門は収益が見込める部門ではないか"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "国の事業が先行し利用は後回しになった面もある"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "累積赤字もあり改善は厳しいのではないか"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "夜に窓を開けられないほどで改善が十分でない"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "畜産の新規就農者は極端に少ないのではないか"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:st_4 rdfs:label "五十嵐一彦議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_43 prop:content "50億円達成に10年は長期過ぎるため基金の在り方を再検討すべき"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:op_44 prop:content "10年かかる公約は長過ぎる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:op_45 prop:content "各地域の特色を生かした事業は一定評価できる"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_4.
kg:op_46 prop:content "担い手不足は大きな問題であり解決策が必要"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "多様化する行政課題に対応するには人材こそが最も大事だ"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "資格取得支援は人材育成のために取り組むべき"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:op_49 prop:content "人への投資はリターンが大きく資格取得支援事業を実施すべき"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "申請から認定まで時間がかかり過ぎるとの声が多い"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "申請時に遡る利用の説明をしっかり行うべき"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:op_52 prop:content "調査時に普段以上に頑張ってしまう高齢者もいるので普段の状況を丁寧に把握すべき"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:st_5 rdfs:label "阿部寛議員"@ja.
kg:st_5 rdfs:type cls:st_16.
kg:op_53 prop:content "防災上危険なため池として廃止解体した"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:op_54 prop:content "下流部の川幅を造成せず壊すことを住民は心配していた"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_5.
kg:op_55 prop:content "住民が懸念したことが実際に起きてしまった"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_5.
kg:op_56 prop:content "今後も河川拡幅も視野に最後まで面倒を見てほしい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_5.
kg:op_57 prop:content "実りの秋を迎え販売に頭を痛める生産者が多い"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_5.
kg:op_58 prop:content "高齢者が長く農業生産できる取組が必要"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:op_59 prop:content "露地栽培で９月上旬より出荷が可能で競合産地が少ない"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_5.
kg:op_60 prop:content "水が多く必要で水田に適している"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_5.
kg:op_61 prop:content "枝豆や小菊とのリレー栽培で長期雇用や所得向上も期待できる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_5.
kg:op_62 prop:content "産地交付金の重要品目化や面積目標設定で産地化を進めるべき"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_5.
kg:op_63 prop:content "初期投資と無収入期間を補うため産地交付金を最高水準に近づけるべき"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_5.
kg:st_6 rdfs:label "佐藤昌哉議員"@ja.
kg:st_6 rdfs:type cls:st_16.
kg:op_64 prop:content "木材生産は低コストで安定供給することが課題だ"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_6.
kg:op_65 prop:content "路網整備や財源確保は重要な課題だ"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_6.
kg:op_66 prop:content "担い手確保と育成は重要課題だ"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_6.
kg:op_67 prop:content "公演中止が相次ぎ市民の鑑賞機会も失われ運営も厳しいのではないか"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_6.
kg:op_68 prop:content "本市独自のメセナ活動を推進し企業参加を促すべき"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_6.
kg:op_69 prop:content "基金を含め文化芸術活動の財源確保が必要"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_6.
kg:op_70 prop:content "市民の役割や市の責務や基本理念を示した文化振興条例が必要だ"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_6.
kg:op_71 prop:content "条例は普遍的理念を示すもので計画と両立しうる"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_6.
kg:st_7 rdfs:label "石塚慶議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_72 prop:content "本市で発電した電気を本市で使う地産地消を実践すべき"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_7.
kg:op_73 prop:content "地域の風を地域で使う形を推進すべき"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_7.
kg:op_74 prop:content "ＲＥ100を啓蒙し市内企業の対応を後押しすべき"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_7.
kg:op_75 prop:content "友好都市や都市部企業で使うなど地域との関係づくりに生かすべき"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_7.
kg:op_76 prop:content "再生可能エネルギーをふるさと納税返礼品として活用すべき"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_7.
kg:op_77 prop:content "再エネ事業主体企業へのトップセールスを進めるべき"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_7.
kg:op_78 prop:content "設置地域に財源メリットを与えられる仕組みが必要"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_7.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "体力低下の原因といたしましては、感染症拡大に伴い、昨年度の小・中学校の休校が５月まで延長となったことで、運動に親しむ機会が減少したことが考えられます"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "学校再開後も国や県からの通知を受け、体育の授業においては無理のない運動から段階的に実施せざるを得なかったこと"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "密を避けるために学年合同の学習から学級ごとの学習へと人数を分散させて実施したことによって、授業時数が減少したこと等、様々な制限の中での学習となったことも一因であると考えられます"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "元年度に比べて低下している項目数が多いことから、本市の小・中学生の体力につきましては、コロナ前よりも低下していると捉えることができます"@ja.
<< kg:id_6 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "児童・生徒の健康及び体力の維持・増進につきましては、児童・生徒の健康と安全を第一に考え、感染症対策を徹底した上で体育の授業を実施するよう指導しております"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "体力向上への取組につきましては、小学校体育連盟と連携しながら本市の体力測定の結果について分析し、対策を検討する機会を設けております"@ja.
<< kg:id_8 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "全ての小・中学校に対して自校の体力測定結果を分析し、各校の課題に応じた取組を体力向上に係る１校１取組として報告いただいております"@ja.
<< kg:id_8 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "グラウンドにサーキットトレーニングの場を設置し、体育の授業前に取り組ませる実践"@ja.
<< kg:id_8 prop:contermeasure kg:id_12 >>
    prop:text-txt_contents "校内独自の体育検定カードを作成して、日常的に運動に取り組むことができるようにするといった実践"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:text-txt_contents "更衣室は密にならないよう、複数の場所を設定したり、時間差を設けたりすること"@ja.
<< kg:id_13 prop:contermeasure kg:id_15 >>
    prop:text-txt_contents "授業中は不必要な会話や発声を行わないように指導すること"@ja.
<< kg:id_13 prop:contermeasure kg:id_16 >>
    prop:text-txt_contents "陸上でも２メートルの間隔を確保できるようプールサイドやフェンスに表示を設置すること"@ja.
<< kg:id_13 prop:contermeasure kg:id_17 >>
    prop:text-txt_contents "泳ぐ際は、時間差をつけたり、往復せずに一方通行にしたりするなどし、できるだけ児童が接触しないよう配慮すること"@ja.
<< kg:id_13 prop:contermeasure kg:id_18 >>
    prop:text-txt_contents "教師が指導する際は、フェースシールドやマウスシールド等を着用することも指導しております"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "小学校の泳力の実態については、昨年度実施していないことにより、体力と同様に泳力は低下していると考えられます"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "体力と同様に泳力は低下していると考えられます"@ja.
<< kg:id_13 prop:effect kg:id_22 >>
    prop:text-txt_contents "初めて水泳学習を行った２年生はもちろん、ほかの学年においても水泳への不安等を感じる児童がおり"@ja.
<< kg:id_13 prop:effect kg:id_23 >>
    prop:text-txt_contents "水慣れや一昨年度の学習内容の確認等に時間を取られたとのことです"@ja.
<< kg:id_13 prop:cause kg:id_24 >>
    prop:text-txt_contents "密を避けるために人数を分散させて学級単位で実施した学校については"@ja.
<< kg:id_13 prop:effect kg:id_25 >>
    prop:text-txt_contents "１週間当たりの水泳学習の時間数が減少し"@ja.
<< kg:id_13 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "継続した水泳指導を行うことが難しく、泳力の向上までは結びつけられなかった"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "移動の際のバス費用やバス内での感染症対策の徹底、そして移動時間の確保等の事情から"@ja.
<< kg:id_27 prop:cause kg:id_29 >>
    prop:text-txt_contents "バス内での感染症対策の徹底"@ja.
<< kg:id_27 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "移動時間の確保等の事情から"@ja.
<< kg:id_27 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "授業時間内に校外のプール施設を利用して水泳学習を行っている学校はございません"@ja.
<< kg:id_32 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "教育委員会より水泳の外部指導者を派遣しております"@ja.
<< kg:id_32 prop:effect kg:id_34 >>
    prop:text-txt_contents "外部指導者を派遣したことで学びの質を高め、安全で効果的な水泳指導を行うことができたと報告を受けております"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:text-txt_contents "その４か月後にコロナ感染症が世界的に拡大し、先述したとおり、翌年の水泳指導も全て中止となりました。そのため、プールの業務委託等につきましては、実質的に議論する機会がなく"@ja.
<< kg:id_35 prop:effect kg:id_37 >>
    prop:text-txt_contents "小・中学校長会とも課題の共有には至っていないというのが現状でございます"@ja.
<< kg:id_38 prop:contermeasure kg:id_39 >>
    prop:text-txt_contents "今後は、児童の水泳指導につきまして、小学校長会と情報を共有しながら外部指導者の活用をベースに検討してまいりたい"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "特別支援学級の水泳教室につきましては、コロナ禍において複数の学校の児童が交流することは望ましくないことや"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:text-txt_contents "一部の学校のみを対象としていたこと"@ja.
<< kg:id_40 prop:cause kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "実施した学校から移動時間、移動方法の確保が難しいという反省等があり、本事業は廃止といたしました"@ja.
<< kg:id_40 prop:contermeasure kg:id_44 >>
    prop:text-txt_contents "今後は、各学校において特別支援学級の子供たちが校外のプール施設を利用したほうがよいと判断するのであれば、感染症対策の面からも各学校ごとに利用すべきと考えております"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "移動手段の確保につきましては、今後学校のニーズを把握した上で、検討を行ってまいりたい"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "人口は、合併当時約14万4,000人でありましたが、その後人口は減少し、本年の７月では約12万3,000人となり、この減少傾向は今後も続くものと思われます"@ja.
<< kg:id_47 prop:cause kg:id_49 >>
    prop:text-txt_contents "さらに少子化、高齢化が進行し、団塊の世代が75歳以上の後期高齢者となる2025年に向け、地域の医療提供体制、地域包括ケアシステムの構築が今後の重要課題である"@ja.
<< kg:id_47 prop:cause kg:id_50 >>
    prop:text-txt_contents "地域の課題といたしましては、当院をはじめ、地域全体で医師不足が大きな問題となっております"@ja.
<< kg:id_47 prop:cause kg:id_51 >>
    prop:text-txt_contents "また、看護師に関しても同様に不足状態にあるところでございます"@ja.
<< kg:id_47 prop:cause kg:id_52 >>
    prop:text-txt_contents "さらに診療所医師の高齢化が進み、近年、病院から有床診療所への転換やクリニックの閉院などが散見され"@ja.
<< kg:id_47 prop:effect kg:id_53 >>
    prop:text-txt_contents "地域医療の維持が今後の大きな課題となっているところでございます"@ja.
<< kg:id_54 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "荘内病院の事業運営で大事な点は、高度・良質な医療の提供により、市民に信頼される病院であることでありまして"@ja.
<< kg:id_54 prop:contermeasure kg:id_56 >>
    prop:text-txt_contents "経営的に安定した病院にすることにより、そこで働く職員とその家族が安心して生活できるようにすることであります"@ja.
<< kg:id_57 prop:contermeasure kg:id_58 >>
    prop:text-txt_contents "これからは、山形大学、それから新潟大学等の関連大学病院以外においても、これまで私が築いてきました人的なつながりなども生かしながら、これまで以上に多方面に働きかけを行い、医師の確保に努めてまいりたい"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:text-txt_contents "昨年７月には、国立がん研究センター東病院と医療連携協定を締結いたしました"@ja.
<< kg:id_59 prop:contermeasure kg:id_61 >>
    prop:text-txt_contents "近い将来、遠隔診療によって当院で手術を行いながら、東病院の医師が向こうで手術支援をできるように、そうしたシステムを検討しているところでございます"@ja.
<< kg:id_62 prop:contermeasure kg:id_63 >>
    prop:text-txt_contents "新たな診療報酬の加算などにより、入院・外来の診療単価をアップさせ、経営の安定化を図ってまいりたい"@ja.
<< kg:id_64 prop:effect kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "地方都市において中核となる病院の発展なくしてまちの発展はないと考えております"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "昨年、春頃から本格的に新型コロナウイルス感染症が流行して以来、総じて厳しい経済環境でありますが、特に厳しい状況とされておりますのが観光に関する業態であります"@ja.
<< kg:id_68 prop:effect kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "前年より減少したと回答した施設も多く、宿泊事業者にとって厳しい状況が続いているものと認識をしております"@ja.
<< kg:id_68 prop:cause kg:id_70 >>
    prop:text-txt_contents "今年の夏は新型コロナウイルスの感染拡大の影響によるキャンセルや予約の変更が相次ぎまして"@ja.
<< kg:id_68 prop:effect kg:id_71 >>
    prop:text-txt_contents "旅行などの外出は慎重であったものと分析をしております"@ja.
<< kg:id_72 prop:contermeasure kg:id_73 >>
    prop:text-txt_contents "県民限定のやまがた夏旅と併用することや、鶴岡市民のほか、市内に所在する事業所や学校などに通勤・通学されている方の利用も可能とし、さらに日帰り利用も可能とするなど、制度の見直しを図ってまいりました"@ja.
<< kg:id_72 prop:effect kg:id_74 >>
    prop:text-txt_contents "今年６月では31件の利用であったのに対しまして、制度を見直しました後の７月は664件の利用があり、市民割の制度見直しによる効果があったものと認識"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "宿泊施設での３密の回避、換気の徹底など、継続して取り組んでいただくよう、市といたしましても注意を促します"@ja.
<< kg:id_75 prop:contermeasure kg:id_77 >>
    prop:text-txt_contents "感染状況を注視しながら利用拡大に向けた市民への周知を図ってまいりたい"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "地域の悲願でございます全線開通の達成に向けまして"@ja.
<< kg:id_80 prop:contermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "市議会の皆様をはじめ、関係機関、団体、市民の皆様の思いを一つにして、引き続き要望を続けてまいりたい"@ja.
<< kg:id_82 prop:effect kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "羽越新幹線整備により東京駅から鶴岡駅間の所要時間は２時間21分となり、現在の所要時間から72分短縮されるといった効果が見込まれております"@ja.
<< kg:id_82 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "国やＪＲなどに要望活動を継続してまいります"@ja.
<< kg:id_82 prop:contermeasure kg:id_85 >>
    prop:text-txt_contents "地域間交流の拡大やワーケーションといった新たな需要創出に取り組むことで利用促進を図る"@ja.
<< kg:id_86 prop:cause kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "昨年度は、新型コロナウイルス感染症の影響から、例年どおりの要望活動が制限されました"@ja.
<< kg:id_86 prop:effect kg:id_88 >>
    prop:text-txt_contents "今年度は国土交通省からの通知で、要望活動を文書またはオンラインで実施するように求められており、現時点では直接関係機関に訪問しての要望活動が困難な状況"@ja.
<< kg:id_89 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "オンラインまたは郵送といった手法も視野に関係機関に対しての要望活動を継続し"@ja.
<< kg:id_91 prop:effect kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "特別教室については、令和２年９月時点で小・中合わせて487室中88室の整備にとどまっており、設置率は18.1％となっております"@ja.
<< kg:id_91 prop:contermeasure kg:id_93 >>
    prop:text-txt_contents "今年度から令和５年度までの３か年計画で、国の交付金を活用しながら、使用頻度の高い特別教室について小学校77教室、中学校46教室の計123教室に設置する計画"@ja.
<< kg:id_94 prop:effect kg:id_95 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "体育館は、児童や生徒の学校利用のみならず、災害時には一般市民の避難所として利用することとなるため、体育館の高温対策が課題であると認識しております"@ja.
<< kg:id_94 prop:cause kg:id_96 >>
    prop:text-txt_contents "体育館は床面積も大きく天井も高いため、全館を冷やすには大規模な設備導入が必要となります。そのため、設置費用や電気代等の維持費も含め、相当の費用を要する"@ja.
<< kg:id_97 prop:contermeasure kg:id_98 >>
    prop:text-txt_contents "長期的な財政見通しの下に判断していく必要があり、現時点では検討段階となっております"@ja.
<< kg:id_99 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "災害時には避難所として機能することになるホールへの設置を優先的に進めておりまして、さらに会議室や研修室、またこれまで設置してこなかった調理実習室等につきましても、施設の利用状況に照らし、計画的に設置を進めてまいります"@ja.
<< kg:id_101 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "地域の農家が農畜産物を生産し、地域の加工業者がこれを加工し、地域の小売店がこの商品を販売し、地域の消費者が消費するという食料システムを構築し、地域内で完結できる循環型の経済圏の形成を目指す"@ja.
<< kg:id_101 prop:contermeasure kg:id_103 >>
    prop:text-txt_contents "具体的な取組としましては、小麦、大豆、トウモロコシなどの輪作体系の実証を行う"@ja.
<< kg:id_101 prop:contermeasure kg:id_104 >>
    prop:text-txt_contents "これらの生産物の規格外品や残渣を餌とした養豚を行い、生産された豚肉を加工したウインナーやハムなどの商品開発、販売などを行っております"@ja.
<< kg:id_105 prop:cause kg:id_106 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "取組農家からの聞き取りでは、米需要の減少であるとか、国産小麦に対する関心の高まりなどを受けまして、作付面積は今後拡大したいというような意向"@ja.
<< kg:id_105 prop:cause kg:id_107 >>
    prop:text-txt_contents "国産小麦に対する関心の高まりなどを受けまして"@ja.
<< kg:id_108 prop:cause kg:id_109 >>
    prop:text-txt_contents "庄内地域は冬季の積雪があることや"@ja.
<< kg:id_108 prop:cause kg:id_110 >>
    prop:text-txt_contents "小麦の収穫期と梅雨の時期が重なることから、小麦の作付には適さないとされてきた"@ja.
<< kg:id_111 prop:contermeasure kg:id_112 >>
    prop:text-txt_contents "大学や研究機関等からの指導も仰ぐとのことでございますので、小麦栽培の実証によりまして、課題がクリアされ、安定した生産が可能となれば、小麦栽培の拡大に向けた取組を検討"@ja.
<< kg:id_113 prop:effect kg:id_114 >>
    prop:text-txt_contents "地域に合った畑作物の輪作体系を確立するには、まだなお時間を要する状況"@ja.
<< kg:id_113 prop:effect kg:id_115 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "スマートテロワール事業に対する市民の理解も十分に浸透したとは言えない状況"@ja.
<< kg:id_113 prop:effect kg:id_116 >>
    prop:text-txt_contents "今年度の構築協議会への参加は農業者３名にとどまっておりまして、取組農家の拡大についてもこれからの課題"@ja.
<< kg:id_101 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "新商品開発に対する支援ですとか、学校給食などを通じてＰＲ活動を行うというようなことなどによりまして、市民の認知度向上でありますとか、取組者の拡大を図ってまいりたい"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "農業従事者の高齢化は当該団地でも同様でございまして、担い手となる農業者への集積は喫緊の課題"@ja.
<< kg:id_118 prop:contermeasure kg:id_120 >>
    prop:text-txt_contents "一般的には集落単位で策定しております人・農地プランを当該団地の農業者を対象といたしまして、令和元年度に策定しております"@ja.
<< kg:id_118 prop:contermeasure kg:id_121 >>
    prop:text-txt_contents "農地中間管理機構を活用した農地の流動化などが方針として盛り込まれております"@ja.
<< kg:id_118 prop:contermeasure kg:id_122 >>
    prop:text-txt_contents "受皿となる中心経営体の育成に向けまして小麦生産に係る機械導入に対して補助する計画でございまして、こうした支援を講じていくことによりまして、さらなる集積の推進と農地の有効利用を図ってまいります"@ja.
<< kg:id_123 prop:cause kg:id_124 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "ダムを含む施設管理のために、一般的な土地改良区などと同様に、団地内の農地所有者から今後も分担金を頂く必要がございます"@ja.
<< kg:id_123 prop:effect kg:id_125 >>
    prop:text-txt_contents "それが農地の売買や賃貸を進める上での受け手の負担になるといったことも事実"@ja.
<< kg:id_123 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "今後、効率的なかん水体系への見直しと、それに伴う分担金の在り方について今後十分検討してまいりたい"@ja.
<< kg:id_127 prop:cause kg:id_128 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "子牛を生産する繁殖農家の廃業等で肥育素牛となります子牛が不足し、子牛価格は高止まりの傾向にあります"@ja.
<< kg:id_129 prop:contermeasure kg:id_130 >>
    prop:text-txt_contents "畜舎等の改修・新設による経営規模の拡大につきましては事業者の要望に応じて取組を行っております"@ja.
<< kg:id_131 prop:effect kg:id_132 >>
    prop:text-txt_contents "貸付金額にしまして約2,200万円となっておりまして、金額ベースでの基金総額に対する利用率は14.8％"@ja.
<< kg:id_131 prop:cause kg:id_133 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "ＪＡ全農など民間には市有牛貸付制度と同様の牛の貸付制度であります預託牛の制度が既にあります"@ja.
<< kg:id_134 prop:contermeasure kg:id_135 >>
    prop:text-txt_contents "民間制度の利用に切替えをしていただきまして、それに伴い発生する金利手数料の負担につきましては、負担軽減策としまして、金利手数料相当額の市の補助制度を新たに導入"@ja.
<< kg:id_136 prop:effect kg:id_137 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "令和２年度の収支では、堆肥販売による歳入が約1,400万円、歳出が約1,700万円で、約300万円の歳出超過"@ja.
<< kg:id_136 prop:cause kg:id_138 >>
    prop:text-txt_contents "平成16年度の完成から年数が経過しまして、施設の大規模修繕が近年続いてきたことによる収支の悪化が要因"@ja.
<< kg:id_139 prop:contermeasure kg:id_140 >>
    prop:text-txt_contents "電力供給事業者の見直しによる電気料の引下げと堆肥原料の購入単価の引下げを実施しまして、今年度は販売用小袋の仕様の見直しなどによりまして、一層の経費削減を図っている"@ja.
<< kg:id_139 prop:contermeasure kg:id_141 >>
    prop:text-txt_contents "堆肥散布を支援する国の事業を活用しまして利用者の拡大を図っておりまして、約300万円の歳入の増"@ja.
<< kg:id_142 prop:cause kg:id_143 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "羽黒高品質堆肥製造施設につきましては、臭気問題が課題となっております"@ja.
<< kg:id_142 prop:contermeasure kg:id_144 >>
    prop:text-txt_contents "臭気対策としまして、薬剤の散布や臭気のモニターとしまして７名の方から報告をいただき、臭気の発生状況の把握に努めております"@ja.
<< kg:id_142 prop:contermeasure kg:id_145 >>
    prop:text-txt_contents "今年度は臭気の漏えいを防ぐための外壁修繕を行うほか、新たな取組としまして、消臭効果があるとされる還元化水を散布する実証実験を行いまして"@ja.
<< kg:id_142 prop:contermeasure kg:id_146 >>
    prop:text-txt_contents "臭気の発生を抑制するためには、畜ふんの水分量が低くなるように管理することが重要との御指導をいただいております。そのため、搬入農家向けの研修会を開催"@ja.
<< kg:id_147 prop:contermeasure kg:id_148 >>
    prop:text-txt_contents "当面は藤島エコ有機センターと羽黒高品質堆肥製造施設のそれぞれにおきまして、長期の健全運営を目指してまいりたいと考えております。将来的には、地域の畜産の状況、堆肥の需要の動向などを勘案しながら、堆肥センターの統合について検討"@ja.
<< kg:id_149 prop:effect kg:id_150 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "畜産の肉用牛に係る新規就農につきましては、平成23年以降の状況は親族からの経営の継承等によりまして、８名の方が就農している状況"@ja.
<< kg:id_151 prop:effect kg:id_152 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "基金残高が5.2億円、基金充当額が累計で7.3億円、起債充当額が累計で3.3億円、合わせて15.8億円"@ja.
<< kg:id_151 prop:effect kg:id_153 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "50億円に達するまでには10年程度かかるものと見込まれます"@ja.
<< kg:id_154 prop:effect kg:id_155 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "各地域において地域の特徴を生かした多様な取組が展開されております"@ja.
<< kg:id_154 prop:effect kg:id_156 >>
    prop:text-txt_contents "地域活性化や地域課題の解決はもとより、住民が地域に誇りと愛着を持って暮らしていける魅力ある地域づくりにつながっているものと評価しております"@ja.
<< kg:id_157 prop:cause kg:id_158 >>
    prop:text-txt_contents "昨年来のコロナ禍の影響により事業の中止や縮小を余儀なくされている"@ja.
<< kg:id_157 prop:effect kg:id_159 >>
    prop:text-txt_contents "期待していた効果が得られなかったり"@ja.
<< kg:id_157 prop:effect kg:id_160 >>
    prop:text-txt_contents "実施主体の地域住民に閉塞感や住民同士のコミュニケーション不足が生じているといった声"@ja.
<< kg:id_157 prop:cause kg:id_161 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "人口減少や生活スタイルの多様化により、若者世代の地域コミュニティ活動離れが進んでおり、地域の担い手を確保していくことが難しくなってきている"@ja.
<< kg:id_154 prop:contermeasure kg:id_162 >>
    prop:text-txt_contents "各地域において若者の地域参加の場づくりや、活動を通じた担い手の発掘・育成に取り組んでいる"@ja.
<< kg:id_154 prop:contermeasure kg:id_163 >>
    prop:text-txt_contents "各地域で行う未来事業計画の策定作業にもこうした若い世代の意見を取り込み、地域活動に参画しやすくなるような仕組みづくりを進めるとともに、若い世代の地域活動や将来的な担い手の育成の取組に対する支援の充実を検討"@ja.
<< kg:id_164 prop:cause kg:id_165 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "人口減少の急激な進行、近年頻発する自然災害や新型コロナウイルス感染症への対応、行政のデジタル化の推進など、行政を取り巻く状況が変化してきております"@ja.
<< kg:id_164 prop:effect kg:id_166 >>
    prop:text-txt_contents "失敗を恐れず新たな取組に対応する能力や、効率的で効果的に事業を実施し、限られた資源で最大の成果を発揮するといった能力をどう伸ばすか、ここが課題"@ja.
<< kg:id_167 prop:contermeasure kg:id_168 >>
    prop:text-txt_contents "職員意識アンケートを実施する予定です。また、本市における目指す職員像を検討するための庁内ワーキンググループを年内に立ち上げ"@ja.
<< kg:id_169 prop:effect kg:id_170 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "多くの企業が人手不足を経営上の課題と捉え、また、その対策として人材育成の取組が特に重要と考えていることが明らか"@ja.
<< kg:id_169 prop:effect kg:id_171 >>
    prop:text-txt_contents "最新７月末現在の有効求人倍率が1.76となるなど今後も人手不足の傾向が続くことが見込まれる"@ja.
<< kg:id_172 prop:contermeasure kg:id_173 >>
    prop:text-txt_contents "庄内地域産業振興センターを通じまして階層や職能などに応じた職業能力開発講座を実施する"@ja.
<< kg:id_172 prop:contermeasure kg:id_174 >>
    prop:text-txt_contents "市内中小企業が行う独自の研修などに係る費用の一部を補助しております"@ja.
<< kg:id_172 prop:contermeasure kg:id_175 >>
    prop:text-txt_contents "新規創業促進助成金、これにつきましては、新規創業者のスタートアップ支援として、創業に係る経費のうち資格取得や研修に対しての補助も実施"@ja.
<< kg:id_172 prop:contermeasure kg:id_176 >>
    prop:text-txt_contents "料理人や飲食店、宿泊業従事者の資格取得やコンクールなどへの参加に対しまして支援を行います料理人等技術向上支援補助金"@ja.
<< kg:id_172 prop:contermeasure kg:id_177 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "ほかの自治体の事例を参考にしながら研究してまいりたい"@ja.
<< kg:id_178 prop:effect kg:id_179 >>
    prop:text-txt_contents "65歳以上の第１号被保険者４万3,764人のうち認定を受けている方は8,234人で、認定率は18.8％となってございます。認定率が最も高かった平成27年の21.1％と比較いたしますと2.3ポイント低くなっております"@ja.
<< kg:id_180 prop:cause kg:id_181 >>
    prop:text-txt_contents "平成29年度から開始いたしました介護予防・日常生活支援総合事業により改善したことに加えまして、介護予防事業や給付適正化事業の推進の成果"@ja.
<< kg:id_182 prop:effect kg:id_183 >>
    prop:text-txt_contents "認定を受けておられます被保険者のうち約１割の方は介護サービスの利用が一度もなく、その分、認定調査等の事務量に影響がある"@ja.
<< kg:id_182 prop:contermeasure kg:id_184 >>
    prop:text-txt_contents "介護保険制度への理解を高め、「取りあえず申請」ですとか「念のため申請」といったような目的に合わない申請を減らすことが必要"@ja.
<< kg:id_185 prop:cause kg:id_186 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "入院したばかりのタイミングで申請があり、状態が安定するのを待つ必要がある場合"@ja.
<< kg:id_185 prop:cause kg:id_187 >>
    prop:text-txt_contents "ほかの病院に転院を予定している場合につきましては、転院後に調査を行う必要がある"@ja.
<< kg:id_185 prop:cause kg:id_188 >>
    prop:text-txt_contents "主治医意見書が提出されるまでの期間も申請から認定までの期間に大きく影響"@ja.
<< kg:id_185 prop:contermeasure kg:id_189 >>
    prop:text-txt_contents "認定までの期間短縮を図るために、長寿介護課に配置しております認定調査員を増員したことで申請から調査までの期間が短縮されてきております...早期の提出について、これについても依頼していきたい"@ja.
<< kg:id_190 prop:contermeasure kg:id_191 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "認定結果が出る前に介護サービスを利用する暫定利用も可能となっております。希望する方には、地域包括支援センターまたは居宅介護支援事業者に相談するように御案内"@ja.
<< kg:id_192 prop:contermeasure kg:id_193 >>
    prop:text-txt_contents "認定調査員及び介護認定審査会委員の資質向上と認定審査の公平を期す観点から、それぞれの研修会を毎年実施"@ja.
<< kg:id_192 prop:contermeasure kg:id_194 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "立会いをいただく御家族からもふだんの状態をお聞きするなどの対応をして公平性の確保に努めている"@ja.
<< kg:id_195 prop:cause kg:id_196 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "今後活用見込みのない防災重点ため池の決壊による人的被害のリスクを回避するため、防災・減災の観点から行う"@ja.
<< kg:id_195 prop:contermeasure kg:id_197 >>
    prop:text-txt_contents "工事着手に至るまで、地元の説明会を令和元年９月、令和２年５月、令和２年９月に開催"@ja.
<< kg:id_195 prop:effect kg:id_198 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "廃止に伴い洪水の調節機能がなくなるため、下流の水路の能力不足が懸念されるといった御質問"@ja.
<< kg:id_199 prop:cause kg:id_200 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "大雨によりせき止めていた箇所が決壊しまして下流の水路へ勢いよく流れたということで、下流の果樹園へ土砂が流入"@ja.
<< kg:id_199 prop:effect kg:id_201 >>
    prop:text-txt_contents "下流の果樹園へ土砂が流入したものでございます"@ja.
<< kg:id_199 prop:contermeasure kg:id_202 >>
    prop:text-txt_contents "果樹園の土砂撤去を行い、原形復旧させていただきました"@ja.
<< kg:id_203 prop:effect kg:id_204 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "ため池を廃止することにより、ため池が決壊するリスクにつきましては回避されますけれども、洪水の調節機能はなくなりますので、水路の越水の不安はなくならない"@ja.
<< kg:id_203 prop:contermeasure kg:id_205 >>
    prop:text-txt_contents "現在施工しております廃止工事では、排水を分散、あるいは迂回させるために、排水路の増設や集水ますの設置を追加して実施"@ja.
<< kg:id_203 prop:contermeasure kg:id_206 >>
    prop:text-txt_contents "多面的機能支払交付金制度を利用して、素掘りの水路からＵ字溝への改修であるとか、しゅんせつなどを進めていただいております"@ja.
<< kg:id_207 prop:cause kg:id_208 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "傷やくぼみなどによりまして商品性が低下した果実が多数発生していることから"@ja.
<< kg:id_207 prop:contermeasure kg:id_209 >>
    prop:text-txt_contents "農業者等が実施する加工品などの取組に対して、補助率３分の２、補助上限額30万円で支援します被災農産物６次産業化緊急支援事業"@ja.
<< kg:id_207 prop:contermeasure kg:id_210 >>
    prop:text-txt_contents "ＪＡなどが実施する被災果実の集出荷に係る取組に対しまして、補助率２分の１、補助上限額150万円で支援する被災農産物集出荷緊急支援事業"@ja.
<< kg:id_207 prop:contermeasure kg:id_211 >>
    prop:text-txt_contents "被災果実を活用した料理、スイーツ、パンなどを地元飲食店等に置いて提供する「くしびき・えくぼフルーツフェア」を実施"@ja.
<< kg:id_207 prop:contermeasure kg:id_212 >>
    prop:text-txt_contents "市及び県の庄内総合支庁で被災した生の果実を販売する職員向けの応援セールなども実施する予定"@ja.
<< kg:id_213 prop:contermeasure kg:id_214 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "１つは、機械化による労働負荷の軽減や作業の効率化でございます"@ja.
<< kg:id_213 prop:contermeasure kg:id_215 >>
    prop:text-txt_contents "こうした機械が共同利用などによりまして効率的に利用されれば、機械を持たない高齢者でも規模を縮小することなく営農が可能"@ja.
<< kg:id_213 prop:contermeasure kg:id_216 >>
    prop:text-txt_contents "分業化によりまして選別や集出荷調整など、多くの時間と手間のかかる作業をＪＡなど第三者に行ってもらうことで"@ja.
<< kg:id_213 prop:effect kg:id_217 >>
    prop:text-txt_contents "余裕が出た時間を収穫などの栽培管理に充てることができます。これによりまして、高齢者の場合は栽培面積を維持すること"@ja.
<< kg:id_218 prop:effect kg:id_219 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "６月から７月を中心とした需要がどの程度あるのか分からない部分もございますが、全国的にも生産量が少ない時期でございますので、主要産地との競合を避けて有利に流通させることが可能"@ja.
<< kg:id_218 prop:effect kg:id_220 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "リンドウは保水力の高い土壌が栽培適地ということで、御提案のとおり水田転作にも適した品目"@ja.
<< kg:id_218 prop:effect kg:id_221 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "本市においてはリンドウの極わせ品種と枝豆との複合経営の事例もございまして、既存の品目との組合せが可能であるという点も生産拡大に期待ができる"@ja.
<< kg:id_218 prop:contermeasure kg:id_222 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "産地化に向けましては、既存の生産者をモデルに成功事例を増やして生産者を組織化していくということが重要"@ja.
<< kg:id_218 prop:contermeasure kg:id_223 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "リンドウにつきましては、議員から御提案いただきましたメリットなども含めまして鶴岡市農業振興協議会の中で産地交付金への追加について検討していきたい"@ja.
<< kg:id_224 prop:cause kg:id_225 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "木材価格の低迷などの理由によりまして森林への関心が低下している"@ja.
<< kg:id_224 prop:effect kg:id_226 >>
    prop:text-txt_contents "管理が必要な状態にもかかわらず適切に管理されていない森林が多くあることが課題"@ja.
<< kg:id_224 prop:effect kg:id_227 >>
    prop:text-txt_contents "民有林の中の人工林、約２万1,000ヘクタールのうち、およそ半分の約１万1,000ヘクタールと見込まれます"@ja.
<< kg:id_224 prop:contermeasure kg:id_228 >>
    prop:text-txt_contents "市町村が仲介役となりまして、適切に管理されていない森林の所有者と森林整備を行う森林組合などの林業事業体とをつなぐ新たなシステム"@ja.
<< kg:id_224 prop:contermeasure kg:id_229 >>
    prop:text-txt_contents "森林環境譲与税を活用しまして、森林組合等の関係団体と連携しながら森林の管理や整備を進めてまいりたい"@ja.
<< kg:id_230 prop:effect kg:id_231 >>
    prop:text-txt_contents "森林経営管理制度の実施に伴いまして間伐を行う事業量の増大が見込まれます"@ja.
<< kg:id_230 prop:cause kg:id_232 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "実施主体となります林業事業体への支援の拡充と財源確保が課題"@ja.
<< kg:id_233 prop:cause kg:id_234 >>
    prop:text-txt_contents "住宅建築の減少や木材価格の低迷などによりまして皆伐が進んでいない状況"@ja.
<< kg:id_233 prop:cause kg:id_225 >>
    prop:text-txt_contents "木材価格の低迷などによりまして皆伐が進んでいない状況"@ja.
<< kg:id_235 prop:contermeasure kg:id_236 >>
    prop:text-txt_contents "鶴岡産木材を使用した住宅リフォーム工事に対する補助"@ja.
<< kg:id_235 prop:contermeasure kg:id_237 >>
    prop:text-txt_contents "木質バイオマス燃焼機器等の購入補助などの支援"@ja.
<< kg:id_238 prop:contermeasure kg:id_239 >>
    prop:text-txt_contents "林道整備は森林組合などの林業事業体からの要望などを踏まえまして、市の森林整備計画に位置づけて整備しております"@ja.
<< kg:id_238 prop:contermeasure kg:id_240 >>
    prop:text-txt_contents "林道の排水を促す横断側溝やゴム製の止水板というものを設置したり、横断側溝のしゅんせつのほか、木材の搬出コストを抑えるために、幅員が狭く大型車両の通行が困難な林道の部分的な拡幅などの改良"@ja.
<< kg:id_241 prop:cause kg:id_225 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "木材価格の低迷や森林所有者の高齢化、地元不在などによりまして"@ja.
<< kg:id_241 prop:cause kg:id_242 >>
    prop:text-txt_contents "森林所有者の高齢化、地元不在などによりまして"@ja.
<< kg:id_241 prop:cause kg:id_243 >>
    prop:text-txt_contents "森林所有者の高齢化、地元不在などによりまして、森林所有者の森林への関心が低下している"@ja.
<< kg:id_241 prop:effect kg:id_244 >>
    prop:text-txt_contents "林業経営体数が2015年から2020年までの５年間で223から88へ大幅に減少しております"@ja.
<< kg:id_245 prop:contermeasure kg:id_246 >>
    prop:text-txt_contents "国の制度であります「緑の雇用」事業を活用しまして、平成15年度から現在まで48人の新規就業の実績"@ja.
<< kg:id_245 prop:contermeasure kg:id_247 >>
    prop:text-txt_contents "未就学児や小学生を対象とした森林環境教育でありますとか、森林所有者や林家を対象としましたチェーンソー講習会などの技術力向上に向けた事業を実施しながら林業の担い手の確保・育成を図っていきたい"@ja.
<< kg:id_248 prop:effect kg:id_249 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "コロナ禍において芸術団体の運営も厳しい状況にあります"@ja.
<< kg:id_250 prop:contermeasure kg:id_251 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "本市を拠点とする多くの企業が参画し、文化芸術活動を支援する仕組みにつきましては、今後の重要な検討課題"@ja.
<< kg:id_250 prop:contermeasure kg:id_252 >>
    prop:text-txt_contents "地場産業や地域特性を生かしたメセナ活動の在り方や企業へのアプローチの仕方、活動団体にとって有意義な支援の在り方など、体制構築に向け調査・検討"@ja.
<< kg:id_253 prop:cause kg:id_254 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "基金の原資を団体や個人からの寄附などに依存していることから"@ja.
<< kg:id_253 prop:effect kg:id_255 >>
    prop:text-txt_contents "新たな積み増しが難しく、基金の減少が進みつつあり、支援事業が思うように展開できないだけでなく、基金の存続にも不安"@ja.
<< kg:id_253 prop:contermeasure kg:id_256 >>
    prop:text-txt_contents "基金の積み増しに向けた検討を進めていくことが喫緊の課題"@ja.
<< kg:id_257 prop:contermeasure kg:id_258 >>
    prop:text-txt_contents "地元企業も含めた多様な市民参加と活動財源の確保に向け、検討を進めてまいりたい"@ja.
<< kg:id_259 prop:contermeasure kg:id_260 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "今後、当面は基本計画に基づき個々の事業を推進してまいります"@ja.
<< kg:id_259 prop:contermeasure kg:id_261 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "条例制定によって文化芸術振興への市民の関心や理解が一層深まる、もしくは企業の支援活動が促されるなど、具体的な効果や意義が明らかになった時点で改めて条例制定の必要性が生じてくる"@ja.
<< kg:id_262 prop:contermeasure kg:id_263 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "残りの３分の２の余剰電力につきましては売電を行い、その電力を市内小・中学校など市有施設に供給することで電力の地産地消に取り組んでおります"@ja.
<< kg:id_262 prop:contermeasure kg:id_264 >>
    prop:text-txt_contents "小・中学校や市体育施設等に太陽光発電設備や蓄電池の設置を進めており"@ja.
<< kg:id_262 prop:contermeasure kg:id_265 >>
    prop:text-txt_contents "西郷コミセン、朝日中学校、羽黒庁舎にはペレットボイラーを設置するなど"@ja.
<< kg:id_262 prop:contermeasure kg:id_266 >>
    prop:text-txt_contents "三瀬地区において地区内で生産したまきをコミュニティセンターのまきボイラー、まきストーブに利用する取組"@ja.
<< kg:id_262 prop:contermeasure kg:id_267 >>
    prop:text-txt_contents "湯野浜温泉では源泉の余熱を利用した旅館・ホテルへの温水供給設備の整備"@ja.
<< kg:id_262 prop:contermeasure kg:id_268 >>
    prop:text-txt_contents "太陽光発電やまきストーブなどの木質バイオマスを導入する家庭や事業所に対して、平成25年度から昨年度まで374件の補助"@ja.
<< kg:id_269 prop:effect kg:id_270 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "八森山の風力発電による電力を市の公共施設や市内の企業等で利用することが可能となれば、市が目指すゼロカーボンシティに大きく貢献できる"@ja.
<< kg:id_269 prop:contermeasure kg:id_271 >>
    prop:text-txt_contents "本市においてもどのような取組ができるか、環境の分野だけではなく庁内の関係する分野と連携しながら検討を進めてまいります"@ja.
<< kg:id_272 prop:effect kg:id_273 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "サプライチェーンと呼ばれる原料調達から販売までの全工程に関係する事業者全てが再生可能エネルギー100％を達成しなければならないため、本市内の企業においても取り組むメリットが生じてくる"@ja.
<< kg:id_269 prop:contermeasure kg:id_274 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "その余剰電力が発生した場合には、友好都市、またはつながりのある自治体、関係する企業から御利用いただくということも考えられます"@ja.
<< kg:id_269 prop:effect kg:id_275 >>
    prop:text-txt_contents "このことによって関係人口、交流人口の拡大にもつながるものと考えております"@ja.
<< kg:id_276 prop:contermeasure kg:id_277 >>
    prop:text-txt_contents "本市においても環境分野だけではなく、多方面から関連する自治体や企業に積極的に働きかけを行い、有効活用する方法を検討してまいります"@ja.
<< kg:id_278 prop:contermeasure kg:id_279 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "まず活用可能な余剰電力がどれぐらい発生するのか、見込めるのか、そうした情報を集めてまいりたい...活用の可能性について調査・研究を進めてまいりたい"@ja.
<< kg:id_280 prop:contermeasure kg:id_281 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "本市で再生可能エネルギー事業を実施する事業者など関係の深い地域外企業に対して、本制度による寄附について検討していただくよう働きかけてまいります"@ja.
<< kg:id_280 prop:contermeasure kg:id_282 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "施設設置を伴う再生可能エネルギー事業について、寄附がその設置地域に還元されることも含めた地方創生事業の在り方や、この仕組みについても改めて検討してまいりたい"@ja.
}
