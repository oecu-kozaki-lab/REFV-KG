kg:st_1 rdfs:label "鶴岡市議会会派代表者"@ja.
kg:st_1 rdfs:type cls:st_89.
cls:st_89 rdfs:label "議会"@ja.
kg:op_1 prop:content "侵略に断固抗議する意思を示す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "ウクライナ政府"@ja.
kg:st_2 rdfs:type cls:st_141.
cls:st_141 rdfs:label "政府"@ja.
kg:op_2 prop:content "攻撃で2000人以上の民間人が死亡したと発表"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "鶴岡市議会"@ja.
kg:st_3 rdfs:type cls:st_89.
kg:op_3 prop:content "断じて看過できない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:st_4 rdfs:label "国連緊急特別会合"@ja.
kg:st_4 rdfs:type cls:st_142.
cls:st_142 rdfs:label "国際機関"@ja.
kg:op_4 prop:content "ロシア軍の完全撤退などを要求する決議案を可決"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_4.
kg:op_5 prop:content "即時無条件でのロシア軍の完全撤退を強く求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:st_5 rdfs:label "石井清則議員"@ja.
kg:st_5 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_6 prop:content "苦しい経営が続いていると聞いている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_5.
kg:op_7 prop:content "返済開始が経営を圧迫している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_5.
kg:st_6 rdfs:label "鶴岡市"@ja.
kg:st_6 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_8 prop:content "依然として多くの業種で厳しい状況が続いている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_6.
kg:op_9 prop:content "宿泊業で特に厳しい状況が続いている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_6.
kg:op_10 prop:content "飲食業で特に厳しい状況が続いている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_6.
kg:op_11 prop:content "地域経済への影響を心配する声がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_5.
kg:op_12 prop:content "市内企業の情報把握に努める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_6.
kg:op_13 prop:content "子供だけでなく保護者や職場へ影響が連鎖している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:op_14 prop:content "保護者や家庭や職場へ影響が連鎖している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:st_7 rdfs:label "職場からの声"@ja.
kg:st_7 rdfs:type cls:st_143.
cls:st_143 rdfs:label "職場"@ja.
kg:op_15 prop:content "休みたくても休めない状況になっている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_7.
kg:st_8 rdfs:label "国"@ja.
kg:st_8 rdfs:type cls:st_144.
cls:st_144 rdfs:label "国"@ja.
kg:op_16 prop:content "保護者に有給休暇を取得させた事業主を支援する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_8.
kg:op_17 prop:content "制度の周知を図ってきた"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_6.
kg:op_18 prop:content "関連機関と連携しさらなる周知を働きかける"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_6.
kg:op_19 prop:content "鶴岡地域郊外地や旧町村地域で増加への対応が課題"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:op_20 prop:content "空き家増加への対応が課題"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_6.
kg:op_21 prop:content "不良空き家の増加が課題"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:op_22 prop:content "不良空き家の増加が課題"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:op_23 prop:content "危険を及ぼすと判断した場合に条例に基づき対応する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_6.
kg:op_24 prop:content "郊外地や旧町村地域にも広げることができないか調査研究する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_6.
kg:op_25 prop:content "対応いただけない方には粘り強く助言を継続する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "毎年のように使用不可の期間が発生している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "重要な施設なので責任を持って対応する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "長年がたがたの状態が続いている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "補修後もさらにがたがたが増えている"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "継続的に表層改良を行い景観整備に資するよう進める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_6.
kg:op_31 prop:content "国の対応を盛り込み規程を制定した"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_6.
kg:op_32 prop:content "国のガイドラインなどを参考に作成に取り組む"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:op_33 prop:content "意識啓発を図る"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "先進事例を参考に検討していく"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "プライバシーや個人の環境にも配慮し慎重に対応している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "喫緊の課題に早期対応する必要がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:op_37 prop:content "所有者と林業事業体を結びつけ森林整備を促進する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_6.
kg:op_38 prop:content "所有者や境界が不明な森林への対応を進める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_6.
kg:op_39 prop:content "森林環境譲与税を活用して支援する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_6.
kg:op_40 prop:content "継続して取り組む"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:st_9 rdfs:label "農業経営者"@ja.
kg:st_9 rdfs:type cls:st_132.
cls:st_132 rdfs:label "農業者"@ja.
kg:op_41 prop:content "農作物被害が拡大している"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "被害拡大への対策が必要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_9.
kg:op_43 prop:content "農作物被害防止に効果的なことから実施している"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_6.
kg:op_44 prop:content "地域の要望に応えて日数を増やす"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "銃器の所持などを考慮して引き上げた"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:st_10 rdfs:label "南波純議員"@ja.
kg:st_10 rdfs:type cls:st_16.
kg:op_46 prop:content "長時間勤務の要因となっている"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_10.
kg:st_11 rdfs:label "文部科学省の方向性を紹介した南波純議員"@ja.
kg:st_11 rdfs:type cls:st_16.
kg:op_47 prop:content "教師の負担軽減を実現する内容が必要"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_11.
kg:st_12 rdfs:label "鶴岡市教育委員会"@ja.
kg:st_12 rdfs:type cls:st_31.
cls:st_31 rdfs:label "教育委員会"@ja.
kg:op_48 prop:content "令和5年度の段階的な地域移行を目指す"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_12.
kg:op_49 prop:content "総合型地域スポーツクラブへの移行を調査研究する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_12.
kg:op_50 prop:content "可能なところから地域移行を進める"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_12.
kg:op_51 prop:content "近年増加傾向にある"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:st_13 rdfs:label "鶴岡市学童保育連絡協議会"@ja.
kg:st_13 rdfs:type cls:st_145.
cls:st_145 rdfs:label "協議会"@ja.
kg:op_52 prop:content "望ましい施設の整備や指導員の労働環境整備を要望"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_13.
kg:op_53 prop:content "藤島児童クラブで受入れに懸念が生じている"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_10.
kg:op_54 prop:content "優先的に整備を検討する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_6.
kg:op_55 prop:content "職員の労働環境整備や受入れの解決策を協議する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_6.
kg:op_56 prop:content "新たな選択肢としてフリースクールの存在意義は大きい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_12.
kg:op_57 prop:content "情報収集とともに連携協力を進める"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_12.
kg:op_58 prop:content "懸命に努力していることを踏まえ出席扱いの判断を行う"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_12.
kg:st_14 rdfs:label "鶴岡市消防本部"@ja.
kg:st_14 rdfs:type cls:st_146.
cls:st_146 rdfs:label "消防"@ja.
kg:op_59 prop:content "団員減少の要因の一つ"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_14.
kg:op_60 prop:content "団員の意識が変わってきた"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_14.
kg:op_61 prop:content "班の維持が難しい地域がある"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_14.
kg:op_62 prop:content "担い手不足が現状にある"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_14.
kg:op_63 prop:content "消防団と共に取り組んでいる"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_14.
kg:op_64 prop:content "将来を見据えた班の在り方を話し合っている"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_14.
kg:op_65 prop:content "負担軽減に努めている"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_14.
kg:st_15 rdfs:label "富樫正毅議員"@ja.
kg:st_15 rdfs:type cls:st_16.
kg:op_66 prop:content "雪処理の担い手や地域防災力の減少をもたらしている"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_15.
kg:op_67 prop:content "豪雪時の深刻化を懸念"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_15.
kg:op_68 prop:content "優良事例の情報提供を行っている"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_6.
kg:op_69 prop:content "どのような除雪支援の仕組みづくりが必要か調査研究する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_6.
kg:op_70 prop:content "さらなる備えが必要"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_6.
kg:op_71 prop:content "浸水により大きな経済損失が予測される地域の整備を進める"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_6.
kg:op_72 prop:content "排水施設の整備水準や優先順位を明確化する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_6.
kg:op_73 prop:content "ハードソフト両面から雨水対策を進める"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_6.
kg:op_74 prop:content "必要な情報を1画面で効率よく収集できるよう取り組む"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_6.
kg:op_75 prop:content "気象防災業務に精通する職員の育成に努める"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_6.
kg:op_76 prop:content "どのような形で活用することが効果的か調査研究する"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_6.
kg:st_16 rdfs:label "黒井浩之議員"@ja.
kg:st_16 rdfs:type cls:st_16.
kg:op_77 prop:content "子育て支援に養育者の年収による格差を持ち込まないべき"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_16.
kg:op_78 prop:content "新たに5000万円の財源が必要となる"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_6.
kg:op_79 prop:content "随時給付の対応を行っている"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_6.
kg:op_80 prop:content "96パーセントを年内給付した"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_6.
kg:op_81 prop:content "売上げが減少した飲食店等への支援として実施してきた"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_6.
kg:op_82 prop:content "民間キャッシュレス決済サービス事業者と連携して実施してきた"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_6.
kg:op_83 prop:content "補正予算での対応を検討していく"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_6.
kg:op_84 prop:content "基本構想案の検討を進めている"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_12.
kg:op_85 prop:content "学校給食発祥の地や食文化創造都市にふさわしい施設整備に向け工夫する"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_12.
kg:st_17 rdfs:label "秋葉雄議員"@ja.
kg:st_17 rdfs:type cls:st_16.
kg:op_86 prop:content "痛ましい事案であり今後増加が心配される"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_17.
kg:op_87 prop:content "地域での見守りにつながることを重視し採用した"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_6.
kg:op_88 prop:content "平成27年度から実施している"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_6.
kg:op_89 prop:content "忘れ物の家族連絡にも活用できた"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_6.
kg:op_90 prop:content "当事業の周知と認知症の正しい理解の普及を継続する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_6.
kg:st_18 rdfs:label "菅井巌議員"@ja.
kg:st_18 rdfs:type cls:st_16.
kg:op_91 prop:content "飲食宿泊学校給食の休業休校で需要が落ち込んだ"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_18.
kg:op_92 prop:content "稲作中心の大規模農家ほど大きな影響を受けている"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_6.
kg:op_93 prop:content "販売のペースが遅れている"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_6.
kg:op_94 prop:content "飲食業向け出荷の経営体で在庫が生じている"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_6.
kg:op_95 prop:content "令和4年産の種苗費の一部に充ててもらうため支援した"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_6.
kg:op_96 prop:content "県と市を合わせて1億6385万円ほど支援した"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_6.
kg:op_97 prop:content "採算が取れず耕作されない農地が増えることが危惧される"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_6.
kg:op_98 prop:content "耕作条件が厳しい中山間地で影響が大きい"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_6.
kg:op_99 prop:content "生産現場の実態を踏まえ慎重な対応を要望する"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_6.
kg:op_100 prop:content "収入が大きく減少した"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_6.
kg:op_101 prop:content "経営を圧迫している"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_6.
kg:op_102 prop:content "今後も突発的な修繕や大規模修繕が必要となる"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_6.
kg:st_19 rdfs:label "かたくり温泉ぼんぼ管理組合"@ja.
kg:st_19 rdfs:type cls:st_147.
cls:st_147 rdfs:label "運営組織"@ja.
kg:op_103 prop:content "累積赤字の解消が見込めないため営業終了を判断"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_19.
kg:op_104 prop:content "積極的に関与していく"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_6.
kg:op_105 prop:content "若者や移住者を対象としたワーケーション活用など新たな展開も模索する"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_6.
kg:st_20 rdfs:label "ジャパン・リニューアブル・エナジー株式会社"@ja.
kg:st_20 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_106 prop:content "事業適地かどうか判断するため風況調査を行う"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_20.
kg:st_21 rdfs:label "説明会参加者"@ja.
kg:st_21 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_107 prop:content "生活環境や日本遺産や高館山や渡り鳥などへの影響を懸念"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_21.
kg:op_108 prop:content "景観や環境保全の観点から意見していく"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_6.
kg:op_109 prop:content "市民への早期公表と住民との合意形成を強く求める"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_6.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "２月24日、ロシアは世界中の平和を望む切なる願いに反し、ウクライナへの侵略を開始した。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "ウクライナ政府の発表では、攻撃により2,000人以上の民間人の命が奪われたとのことです。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "ロシア軍の侵略により多くの人々が住み慣れた地を追われ、避難を余儀なくされている。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "武力攻撃は居住地にも及び、幼い命が奪われるなど罪のない民間人にも被害が広がっている。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "また、ウクライナに拠点を持つ日本企業をはじめ、現地在留邦人についても緊迫した状況の中、安否確認の対応に追われる等厳しい状況におかれている。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "今般のロシアの行動は、欧州にとどまらず、海を挟んで対面する日本はもとより、アジアを含む国際社会の秩序の根幹を揺るがしかねないもので、断じて看過できない。"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "２日、国連ではウクライナ危機をめぐる緊急特別会合で、ロシア軍の完全撤退などを要求する決議案が141か国の賛成多数で可決されました。 よって、本市議会は、ロシアのウクライナへの侵略に対し断固抗議するとともに、即時無条件でのロシア軍の完全撤退を強く求める。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "しかし、長引くコロナ禍の影響と先が見えない状況に加え、先ほど紹介しました運営資金の返済といったものが始まり、苦しい経営が続いていると聞いております。"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "しかし、長引くコロナ禍の影響と先が見えない状況に加え、先ほど紹介しました運営資金の返済といったものが始まり、苦しい経営が続いていると聞いております。"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "この調査によりますと、「直近の１か月の売上げがコロナ以前と比較して下回っている」と回答した事業者の割合が65％となっており、特に宿泊業者では95％、飲食業者では94％となるなど、依然として多くの業種で厳しい状況が続いていると認識をしております。"@ja.
<< kg:id_9 prop:effect kg:id_13 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "この調査によりますと、「直近の１か月の売上げがコロナ以前と比較して下回っている」と回答した事業者の割合が65％となっており、特に宿泊業者では95％、飲食業者では94％となるなど、依然として多くの業種で厳しい状況が続いていると認識をしております。"@ja.
<< kg:id_9 prop:effect kg:id_14 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "この調査によりますと、「直近の１か月の売上げがコロナ以前と比較して下回っている」と回答した事業者の割合が65％となっており、特に宿泊業者では95％、飲食業者では94％となるなど、依然として多くの業種で厳しい状況が続いていると認識をしております。"@ja.
<< kg:id_9 prop:effect kg:id_15 >>
    prop:text-txt_contents "また、感染症などにより生じているマイナスの影響については、売上げ、受注の減少、注文のキャンセルなどの回答が約６割と最も多く"@ja.
<< kg:id_9 prop:effect kg:id_16 >>
    prop:text-txt_contents "次いで部品、原材料、商品の仕入れ、調達が困難、資金繰りの悪化といった結果となっております。"@ja.
<< kg:id_9 prop:effect kg:id_17 >>
    prop:text-txt_contents "次いで部品、原材料、商品の仕入れ、調達が困難、資金繰りの悪化といった結果となっております。"@ja.
<< kg:id_9 prop:effect kg:id_18 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "また、今後、倒産や廃業、閉店などの増加に加え、全国的な企業の経営難の影響も予想され、それによる地域経済への影響を心配される声も聞こえてきます。"@ja.
<< kg:id_9 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本市といたしましては、引き続き金融機関や関係機関との情報共有、アンケート調査の実施によりまして、市内企業の情報把握に努めてまいります。"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "コロナ禍の中で、感染拡大を防止するために、保育園の休園であったり、小・中学校の休校等が行われてきております。"@ja.
<< kg:id_20 prop:cause kg:id_22 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "コロナ禍の中で、感染拡大を防止するために、保育園の休園であったり、小・中学校の休校等が行われてきております。"@ja.
<< kg:id_20 prop:effect kg:id_23 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "働く場、特に小規模な職場であったり、小規模なチームで動くことが多い職場、そういったところからは、休みたくても休めないんだというような状況になっていると、そのような声も届いております。"@ja.
<< kg:id_20 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "国では、新型コロナウイルス感染症により小学校などが休校になった場合、保護者である労働者に対し、有給休暇を取得させた事業主に小学校休業等対応助成金を支給しております。"@ja.
<< kg:id_20 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "市といたしましても子育て世代の休暇取得を支援する制度として周知を図ってまいりましたが"@ja.
<< kg:id_20 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "これまでも働き方改革、働きやすい環境づくりについて企業に御協力をお願いしてまいりましたが、コロナ禍をきっかけに、こうした取組の重要性を再認識しているところでございますので、今後、国や県、鶴岡商工会議所や出羽商工会など関連機関と連携をしながら、さらなる周知を働きかけていきたいと考えております。"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "令和２年度に市が実施した空き家実態調査の結果では、令和３年３月末の空き家の件数が3,582件となっており、前回、平成29年度の調査時と比べ180件、率にして5.3％の増加となっております。"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "鶴岡地域郊外地や旧町村地域では計2,175件となっており、前回の調査時から247件、11.2％の増加となっております。"@ja.
<< kg:id_27 prop:effect kg:id_30 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "市全体で大規模な修繕が必要なＣランクが1,961件で、215件、12.3％の増加"@ja.
<< kg:id_27 prop:effect kg:id_31 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "倒壊の危険性があるＤランクについては184件で、22件、13.6％の増加となっており、Ｃ、Ｄランクに位置するいわゆる不良空き家の増加"@ja.
<< kg:id_27 prop:effect kg:id_32 >>
    prop:text-txt_contents "回答があったのは1,564件で、回答率は50.3％、1,543件は未回答となっております。"@ja.
<< kg:id_27 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "市は、空き家等が危険な状態となり、周囲に危険を及ぼすと判断した場合には、鶴岡市空家等の管理及び活用に関する条例に基づき、危険物の除去や飛散防止対策などの応急措置を行っております。"@ja.
<< kg:id_27 prop:contermeasure kg:id_34 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "現在市が実施しております中心市街地内の不良住宅を寄附していただき、市が除去、整地の上、希望者へ売却する中心市街地居住促進事業という事業がございますが、こういった取組、不良空き家除去後の土地を循環していけるような取組を郊外地や旧町村地域にも広げることができないかなど、他市町村の取組も調査・研究しながら"@ja.
<< kg:id_27 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "対応いただけない方については、今後も粘り強く適正管理に対する助言等を継続してまいります。"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "その後、令和元年に発電機の不具合が発生したため、発電機のオーバーホールを行いましたが、令和２年９月に再び故障が発生し、20日間緊急停止をしたところでございます。"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:text-txt_contents "令和２年９月に再び故障が発生し、20日間緊急停止をしたところでございます。"@ja.
<< kg:id_36 prop:contermeasure kg:id_39 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "現在、本市では、発電機の更新のため、財源として環境省の自然環境整備交付金などの活用を検討しているところでございます。 いずれにいたしましても当該施設は日本遺産でもある月山を訪れる登山者や観光客に大変重要な施設でございますので、支障が出ないよう、市で責任を持ってしっかり対応をしてまいります。"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "手向地内の道路ですが、経年劣化に加えて長年のパッチングによる補修を続けてきたことも重なって、がたがたの状態です。"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "経年劣化に加えて長年のパッチングによる補修を続けてきたことも重なって、がたがたの状態です。"@ja.
<< kg:id_40 prop:effect kg:id_43 >>
    prop:text-txt_contents "特に春の雪解け後、除雪等によって劣化した箇所、またパッチングの部分が剥がれ、穴だらけ、さらにがたがたになるというのが春の状況です。"@ja.
<< kg:id_40 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "令和４年度に表層改良工事を実施する予定としております。 工事内容といたしましては、既設舗装表面を一度削り取った後に再びアスファルト舗装をかける切削オーバーレイによるもので"@ja.
<< kg:id_45 prop:contermeasure kg:id_46 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本市では、令和元年７月に国の対応を盛り込んだ鶴岡市職員のハラスメント防止に関する規程を制定しており"@ja.
<< kg:id_45 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "ガイドラインの作成につきましては、全ての職員がお互いに尊重し合える明るい職場環境づくりがより前進するよう、国のガイドラインなどを参考に、市でも作成に取り組んでまいりたいと考えております。"@ja.
<< kg:id_45 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "引き続き全ての職員を対象とした研修の機会を設け、意識啓発を図ってまいります。"@ja.
<< kg:id_45 prop:contermeasure kg:id_49 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "先進事例を参考にしながら、専門家等を含めた構成について検討していきたいと考えております。"@ja.
<< kg:id_45 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "規程では職員課長を窓口とし、職員または関係者からの申出があった場合には、職員課の職員２名以上で相談に対応し、事実確認をした上で解決に向けた処理等を行うこととしております。"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "森林環境譲与税は、森林の手入れが不足しているなどの喫緊の課題に早期に対応するため"@ja.
<< kg:id_51 prop:contermeasure kg:id_53 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "森林経営管理制度につきましては、適切に管理されていない森林の所有者と林業事業体を市が結びつけることで森林整備を促進し、森林の荒廃を防ぐことを目的とし"@ja.
<< kg:id_51 prop:contermeasure kg:id_54 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "所有者や境界が不明な森林が多いことも課題となっておりますので、令和４年度から行う航空レーザー測量のデータを活用しまして、山林の境界の明確化も並行して行うこととしております。"@ja.
<< kg:id_51 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "林業事業体が実施する間伐や保育施業などの森林整備に対する国や県補助へのかさ上げ支援"@ja.
<< kg:id_51 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "大型トラックの走行を可能とするための林道の改良工事、また災害を防止するための横断側溝の設置など、路網の整備も継続して取り組むこととしております。"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "産業建設常任委員会が行った農業経営者との意見交換会において、猿、イノシシ、カラスによる農作物被害が拡大しているという意見が出されました。"@ja.
<< kg:id_57 prop:effect kg:id_59 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "猿、イノシシ、カラスによる農作物被害が拡大しているという意見が出されました。"@ja.
<< kg:id_57 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "猿の追い上げ業務につきましては、農作物被害の防止に効果的なことから、被害の多い鶴岡、櫛引、朝日、朝日大泉、温海の５地域で行っております。"@ja.
<< kg:id_57 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "令和４年度につきましては、日数を増やしてほしいという地域の要望に応えまして、日数を75日分で予算案に計上するとともに"@ja.
<< kg:id_57 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "令和２年度に、銃器の所持などを考慮しまして、銃所持加算1,500円を設けまして、日当と合わせて１日8,400円に引き上げております。"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "これまでの部活動は、教師による献身的な勤務の下で成り立っており、持続可能な部活動と学校の働き方改革の両方を実現するためには、特に休日の部活動における教師の負担軽減を図る必要がある。"@ja.
<< kg:id_63 prop:effect kg:id_65 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "学校の働き方改革は喫緊の課題であり... 部活動を学校単位から地域単位の取組とすることに向けた方策とスケジュールを示しています。"@ja.
<< kg:id_63 prop:contermeasure kg:id_66 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "休日に行っていた運動部活動を外部である地域のスポーツクラブに移行するもので、休日の活動は学校管理下でなくなり、教員の働き方改革につなげることや"@ja.
<< kg:id_63 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "藤島中学校をモデル推進校といたしまして、総合型地域スポーツクラブ、ふじしまスポーツクラブへの移行につきまして、今年度に引き続き調査・研究を実施いたします。"@ja.
<< kg:id_63 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "それぞれの中学校において、地域の状況等を踏まえながら、各部活動の保護者会代表、外部指導者等を集めた部活動連絡協議会、仮称でございますが、ここで検討を開始し、可能なところから休日の部活動の地域移行を進めてまいります。"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "近年、登録児童数が増加傾向にございます。令和３年度において、登録児童数が1,867人となっており、５年前の平成28年と比較いたしますと２割強増加しております。"@ja.
<< kg:id_69 prop:effect kg:id_71 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "登録児童の増加に伴い、施設が手狭になっており、新型コロナウイルス感染症の感染拡大防止が求められる中で、３密を避けつつ、工夫をしながら運営に御尽力いただいていることと認識しております。"@ja.
<< kg:id_69 prop:effect kg:id_72 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "藤島児童クラブにおいては、施設の老朽化や児童の増加に伴い、現在、入所希望を断らざるを得ない状況になっております。"@ja.
<< kg:id_69 prop:contermeasure kg:id_73 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "旧耐震基準となっております藤島児童クラブや京田学童保育所など、老朽が進んでいる施設や手狭になっている施設を優先的に整備を検討してまいります。"@ja.
<< kg:id_69 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "放課後児童クラブで働いている職員の皆様の労働環境の整備につきましても、実態や実情を把握しながら、課題解決に向けて運営主体と協議を行っていきたいと考えております。"@ja.
<< kg:id_75 prop:effect kg:id_76 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "実際に通所している児童・生徒数は、日によって違いはございますが、10名前後であり、これは本市の不登校児童・生徒数の約１割にとどまっております。"@ja.
<< kg:id_75 prop:contermeasure kg:id_77 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "今後は、教育委員会、それから学校、フリースクールとが相互に協力・補完し合いながら不登校児童・生徒を支援していくことが重要となりますので、フリースクールの情報収集とともに連携・協力を進めてまいりたいと思います。"@ja.
<< kg:id_75 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "現在、同法・同通知で示されている要件を踏まえ、フリースクールと学校・家庭との関係や支援の在り方、支援スタッフについて等、必要最低限の目安を示しつつ、判断する際の留意点や流れをまとめたガイドラインを作成しているところでございます。"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "まず団員減少の要因は、少子高齢化などによる新入団員の減少に加えまして"@ja.
<< kg:id_79 prop:cause kg:id_81 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "働き方やライフスタイルの変化により団員の意識が変わってきたことも考えられます。"@ja.
<< kg:id_79 prop:effect kg:id_82 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "団員数は、令和３年４月１日現在3,039名ですが、議員御案内のとおり全国的に団員の減少は著しく、本市の場合、５年前と比較しますと164名の減少になります。"@ja.
<< kg:id_79 prop:effect kg:id_83 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "時代の流れの中で、地域によっては担い手不足などから班の維持が難しくなっている現状にもございます。"@ja.
<< kg:id_79 prop:contermeasure kg:id_84 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "これらの課題に対応するため、消防団による組織検討委員会を立ち上げ、団員の負担軽減や組織再編について協議を続けています。"@ja.
<< kg:id_79 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "現在は、班の統合を計画的に進めているところでございます。"@ja.
<< kg:id_79 prop:contermeasure kg:id_86 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "また、負担軽減につきましては、団行事や訓練内容について、規模縮小や簡素化にも努めております。"@ja.
<< kg:id_87 prop:cause kg:id_88 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "過疎化・高齢化は、雪処理の担い手の減少、地域の支え合いの力の減少、地域防災力の減少などの状況をもたらす主要な要因となっております。"@ja.
<< kg:id_87 prop:effect kg:id_89 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "今後、豪雪が発生した場合、人的被害の増加や存続が困難な集落の増加などのおそれがあります。"@ja.
<< kg:id_87 prop:contermeasure kg:id_90 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "市内のボランティアによる除雪支援につきましては、鶴岡市社会福祉協議会内のボランティアセンターの事業をはじめ、地域コミュニティでの支え合いによる取組のほか、企業や団体等が地域貢献活動として除雪ボランティアに取り組んでいただいております。"@ja.
<< kg:id_87 prop:contermeasure kg:id_91 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "ただいま議員より御提案のございました広域的な除雪ボランティアの組織化ということも参考にさせていただきながら、どのような除雪支援の仕組みづくりが必要なのか、なお先進事例の調査・研究に努めてまいりたいと思います。"@ja.
<< kg:id_92 prop:cause kg:id_93 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "近年の気候変動に伴い、令和２年７月豪雨や、令和元年東日本台風などの大規模水害が頻発化し、水害に対するさらなる備えが必要であることから"@ja.
<< kg:id_92 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "本市では、公共下水道雨水事業により、市内９つの排水区で雨水幹線等の整備を進め、特に浸水により大きな経済損失が予測される鶴岡中央工業団地を含む排水区は、早期完了に向けた整備を進めております。"@ja.
<< kg:id_92 prop:contermeasure kg:id_95 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "今後は、過去の被害発生状況を踏まえ、浸水シミュレーションによる評価を行い、優先度の高い地域から対策を実施するなど、短期・中期・長期にわたる総合的な計画として、新たに雨水管理総合計画を策定し"@ja.
<< kg:id_92 prop:contermeasure kg:id_96 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "内水ハザードマップによる情報共有など、限られた財源の中で、ハード・ソフト両面から雨水対策を進めていきたいと考えております。"@ja.
<< kg:id_97 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "昨年８月に国立研究開発法人土木研究所　水災害・リスクマネジメント国際センター...と連携・協力協定を結び、必要な情報を１画面で効率よく収集できる災害情報共有システムの構築に取り組んでいるところでございます。"@ja.
<< kg:id_97 prop:contermeasure kg:id_99 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "引き続き気象台や気象防災アドバイザーなど、気象の専門家を招いた研修の場を設けるとともに、内閣府や消防庁、気象庁といった外部組織が実施する研修に積極的に参加するなど、気象防災業務に精通する職員の育成に努めてまいりたいと思います。"@ja.
<< kg:id_97 prop:contermeasure kg:id_100 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "先進事例の情報を収集するとともに、本市においてどのような形で気象防災アドバイザーを活用することが効果的なのか、調査・研究を進めてまいりたいと思います。"@ja.
<< kg:id_101 prop:cause kg:id_102 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "子育て支援に養育者の年収による格差を持ち込まないために、所得制限をなくし、年収960万円以上の世帯にも１人当たり10万円相当の給付を行うことを要望しております。"@ja.
<< kg:id_101 prop:effect kg:id_103 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "本市におきましては、所得制限により対象から外れた方は全体の３％、児童数500人、300世帯になるものと見込まれます。仮に所得制限を撤廃した場合につきましては、新たに5,000万円の財源が必要となります。"@ja.
<< kg:id_104 prop:contermeasure kg:id_105 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "現在は、出生届が提出されました新生児分について、児童手当の手続を踏まえ、随時給付の対応を行っているものでございます。"@ja.
<< kg:id_104 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "本市におきましては、中学生以下の児童だけでなく、高校生等につきましても、以前の児童手当の情報などを活用しながら、申請手続を要しないプッシュ型として処理し、１万6,065人の児童、全体の96％を年内給付"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "本市では、これまで市内の新型コロナウイルス感染症の影響により売上げが減少した飲食店等への支援や、地域経済の回復を図るための消費喚起策としてプレミアム付飲食券を発行した飲食業緊急支援事業"@ja.
<< kg:id_107 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "民間キャッシュレス決済サービス事業者と連携したキャッシュレス促進・消費喚起事業を実施してまいりました。"@ja.
<< kg:id_107 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "本市におけるプレミアム商品券などの発行を含めた今後の消費喚起策の実施につきましては... 補正予算での対応を検討してまいりたいと考えております。"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "庁内検討推進会議では、各センターの稼働率を高めることを基本方針に据え、適正な調理食数、喫食時間を見据えた配送体制、地産地消のさらなる推進、そして将来にわたる学校給食センターの効率的な配置などの視点から、基本構想案の検討を行っております。"@ja.
<< kg:id_111 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "令和４年度に基本構想を策定することとしております。基本構想の取りまとめや基本計画の策定に当たりましては、さらなる市民参画の下、学校給食発祥の地や食文化創造都市にふさわしい安心・安全で魅力的な施設の整備に向け、さらに工夫してまいります。"@ja.
<< kg:id_114 prop:effect kg:id_115 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "今年になってから、本市においても認知症を発症していた高齢者が徘回した後、死亡した状態で発見されるという痛ましい事案が発生をいたしました。"@ja.
<< kg:id_114 prop:contermeasure kg:id_116 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "「どこシル伝言板」はこれに組み入れる形で開始し、登録番号入りＱＲコードシールを１人につき40枚、無償で交付することとしたものでございます。"@ja.
<< kg:id_114 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "本市では、認知症施策といたしまして、認知症で行方不明になるおそれのある方の情報を警察に登録する事業「ＳＯＳ見守りネットワーク「ほっと安心」つるおか」を平成27年度から実施しております。"@ja.
<< kg:id_114 prop:effect kg:id_118 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "事業開始から１年半が経過し、令和４年１月末時点での実績は28件の登録があり、実際このシステムを活用した事例は７件ございましたが、行方不明での発見以外にも、認知症高齢者のかばんにＱＲコードを貼っていたことで、コンビニの店員がかばんの忘れ物に気づいて、ＱＲコードを活用して、認知症高齢者の御家族に知らせることができた事例などもございました。"@ja.
<< kg:id_114 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "今年度は、バスやタクシーなど交通事業者へ事業の周知を進め、ＱＲコードをつけた認知症高齢者を見守る地域の目の拡大に努めたところでございます。"@ja.
<< kg:id_120 prop:cause kg:id_121 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "一昨年から続くコロナ禍で、飲食、宿泊、学校関係の給食など、休業や休校によって米の需要が落ち込んで、その影響で米価が下落し"@ja.
<< kg:id_120 prop:effect kg:id_122 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "出荷数量の約６割を占めるはえぬきの相対取引価格の大幅な下落によりまして、生産額は減少すると見込んでおります。稲作中心の大規模農家ほど大きな影響を受けておりますが"@ja.
<< kg:id_120 prop:effect kg:id_123 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "両ＪＡの販売状況につきましては、１月末現在の販売量が昨年と比べ1,730トン減少しており、販売のペースが遅れております。"@ja.
<< kg:id_120 prop:effect kg:id_124 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "飲食業向けに出荷している経営体の中には、行き先の決まらない在庫を抱える方々もいるとお聞きしております。"@ja.
<< kg:id_120 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "市では令和４年産の種苗費の一部に充ててもらうため、主食用米生産緊急支援事業を創設しまして、概算金の下落が小さかったつや姫などを除き、2,373人に対して、先月22日に6,509万円を交付しております。"@ja.
<< kg:id_120 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "県の稲作経営緊急応援事業では、主食用米と備蓄米を対象として、2,324人に9,876万円を交付しまして、県と市を合わせまして１億6,385万円ほどの支援を行っております。"@ja.
<< kg:id_127 prop:effect kg:id_128 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "この見直しが実施されれば、現場では大変な混乱が生じるとともに、採算が取れないことから、耕作されない農地が増えることが危惧されます。"@ja.
<< kg:id_127 prop:effect kg:id_129 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "水利や圃場の高低差、形状など耕作条件が厳しい中山間地などでは輪作体系の確立が難しいのが現状であります。"@ja.
<< kg:id_127 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "市といたしましては、このような生産現場の実態を踏まえまして、慎重な対応をするよう、国に対して庄内開発協議会や市の重要事業として要望してまいりたいというふうに考えております。"@ja.
<< kg:id_131 prop:cause kg:id_132 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "利用者数は、平成29年度から３年間は約６万人で推移しておりましたが、コロナ禍の影響で令和２年度から激減し、４万人台となり、収入が大きく減少しております。"@ja.
<< kg:id_131 prop:cause kg:id_133 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "加えて、原油や物価の高騰で経営が圧迫され、累積赤字の解消が見込めないことから"@ja.
<< kg:id_131 prop:cause kg:id_134 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "施設は平成５年建築で築29年となっており、施設・設備の老朽化による修繕費がかさんでいること、加えて今年１月には、温泉源泉設備の故障により、地下200メートルにある水中揚湯ポンプが作動しなくなった"@ja.
<< kg:id_131 prop:effect kg:id_135 >>
    prop:stateBy kg:st_19;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "累積赤字の解消が見込めないことから、組合は来年度をもって営業を終了するとの判断に至ったものでございます。"@ja.
<< kg:id_131 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "市といたしましては、組合による温泉営業終了後も、これまでかたくり温泉「ぼんぼ」で実施されてきた介護予防・健康増進事業を継続できるよう、新たな担い手の育成や組織の検討に積極的に関与してまいりたいと考えております。"@ja.
<< kg:id_131 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "かたくり温泉「ぼんぼ」につきましては、温泉機能活用の可能性も見極めつつ、地域回帰の気風の高まりもありますことから、若者や移住者を対象としたワーケーションの活用など新たな展開も模索しつつ、地域の皆様をはじめ、幅広く関係各所と協議しながら、利活用の検討を進めてまいりたいと考えております。"@ja.
<< kg:id_138 prop:contermeasure kg:id_139 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "このたびの説明会は、事業を予定しておりますジャパン・リニューアブル・エナジー株式会社の主催によりまして、加茂地区近郊が風力発電事業に適しているかどうか判断をするために、今後の風況調査の実施について説明することを目的に"@ja.
<< kg:id_138 prop:effect kg:id_140 >>
    prop:stateBy kg:st_21;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "参加者からは、生活環境や日本遺産への影響、また高館山や渡り鳥など自然環境への影響について質問が出されており"@ja.
<< kg:id_138 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "本市としても事業者に対して景観への配慮、環境への影響の回避や低減を図るよう意見してまいります。"@ja.
<< kg:id_138 prop:contermeasure kg:id_142 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "風力発電施設の想定事業区域から２キロ以内の範囲に含まれる住民自治組織、住民及び周辺地権者並びに市が指定する者に対して事前に説明会を実施し、具体的な資料を提示し、合意形成を図るものとしており、市民への早期の段階での事業概要の公表や事業計画に対する住民との合意形成が図られるよう強く求めてまいります。"@ja.
}
