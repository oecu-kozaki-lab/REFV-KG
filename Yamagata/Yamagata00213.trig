kg:st_1 rdfs:label "佐藤博幸議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "特別支援教育の振興をさらに推進すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "分離ではなく共生に向かう取組が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "現状認識を踏まえ特別支援教育の改善が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "教育長 布川敦"@ja.
kg:st_2 rdfs:type cls:st_51.
cls:st_51 rdfs:label "教育関係者"@ja.
kg:op_4 prop:content "通常学級を含めた支援体制整備を進めている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "教育的ニーズに応じた適切な指導と支援が重要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "交流だけでなく相互理解を深める取組が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "学校行事や教科学習で共同活動を充実させたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "各校を訪問し早期発見早期対応の助言を行う"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "必要に応じて専門的支援へつなげている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "校内組織全体で支援する体制を整えている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "家庭地域医療福祉と連携する長期的支援に活用している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "一人一人の目標内容配慮事項を明確にしている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "通常学級の児童生徒にも教育的ニーズに応じた支援を行う"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "校内外の関係者と保護者の連絡調整機能を強化する必要がある"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "役割確認や他校との情報交換の場として年2回開催している"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "障害の状態に応じ十分な教育を受けられるよう多様な学びの場を整えている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "モデル事業で蓄積した実践事例を各校に普及している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "可能な限り同じ場で学ぶことを実践している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "教科学習でも共同実施可能なものを計画的に進めている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "教職員の役割に応じた研修機会を提供している"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "全ての教員が必要な知識技能を身につけるようにしている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "障害による困難の改善克服のための専門性向上を図っている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "学校全体の専門性確保に管理職の理解が不可欠"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "保護者の同意を得ながら進路や支援形態を決めている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "既存の取組を肉づけした推進計画の策定を検討すべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "取組をまとめた冊子を基に構築することは十分可能"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "特別支援学級の子供が楽しく取り組めるよう配慮している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "通常学級の子供も共に充実した活動を考える機会になっている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "人材不足があり研修と採用改善で対応していく"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "免許を持った担任が今後増えてくると考えている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "初めて担任する教員が困らないよう1年間の研修を受けている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "日本はインクルーシブ教育システムが確立されているとはまだいえず、まだまだ課題も多いと言えます"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "障害者権利委員会による日本の第一次審査では、特別支援教育制度を分離教育と位置づけました"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "障害のある子供を受け入れるには事実上準備不足であると受け取られていることにより、障害のある子供の通常の学校での受入れを否定しているという指摘"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "平成19年４月に学校教育法が改正されまして、それまでの特殊教育から現在の特別支援教育へと制度改正が行われました"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "従来の特殊教育の対象障害に加え、発達障害も含めて、特別支援学校や特別支援学級に限らず、通常の学級においても障害のある児童・生徒の支援が義務づけられました"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "子供一人一人の教育的ニーズを把握し、その持てる力を高め、生活や学習上の困難を改善、または克服するため、適切な指導及び必要な支援を行うもの"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "障害のある児童・生徒と障害のない児童・生徒が触れ合い、共に活動する交流及び共同学習は、両者にとって経験を深め、社会性を養い、豊かな人間性を育む"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "お互いを尊重し合う大切さを学ぶ機会となるなど、大きな意義を有するものであります"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "１つ目は、専門家チームによる巡回相談でございます。大学教授、教育相談員、指導主事が各校を訪問し、先生方の日頃の対応について、また子供たちの障害の早期発見、早期対応のための助言などを行い、支援をしております"@ja.
<< kg:id_15 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "さらに、必要に応じて個別の知能検査や医療受診につなげております"@ja.
<< kg:id_15 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "２つ目は、特別支援教育に関わる校内委員会の機能の強化でございます"@ja.
<< kg:id_15 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "個別の教育支援計画は、障害のある児童・生徒について、家庭、地域及び医療や福祉等の関係機関と連携を図り、長期的な視点で教育的支援を行うために作成する計画です"@ja.
<< kg:id_15 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "個別の指導計画は、障害のある児童・生徒一人一人について指導の目標や内容、配慮事項などを示した計画でございます"@ja.
<< kg:id_15 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "通常の学級に在籍し、専門家チームにより発達障害等の疑いがあると判断された児童・生徒につきましても計画を作成し、児童・生徒一人一人の教育的ニーズに応じた支援につなげております"@ja.
<< kg:id_15 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "各校で任命された特別支援教育コーディネーターが校内の教職員や校外の専門家、関係機関、保護者との連絡調整に当たる仕組みもさらに充実させる必要がございます"@ja.
<< kg:id_15 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "教育委員会といたしましては、特別支援教育コーディネーターが校内で特別支援教育を推進していくために具体的な役割や業務内容を確認したり、他校と情報交換したりする場である連絡会を年に２回開催しております"@ja.
<< kg:id_15 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "障害の状態に応じ十分な教育を受けられるよう、通常の学級、通級による指導、特別支援学級、特別支援学校という学びの場を提供しております"@ja.
<< kg:id_15 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "そこで蓄積された実践事例を各校に普及し、合理的配慮の提供や交流及び共同学習の実践に生かしております"@ja.
<< kg:id_15 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "具体的には、子供の障害の特性や個々の学習の状況等に応じ、学級活動や学校行事、給食、清掃等において可能な限り共に行っております"@ja.
<< kg:id_15 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "教科学習についても、児童・生徒の障害の状態を踏まえ、音楽や体育等、共同で実施することが可能なものにつきましては、保護者と相談しながら年間指導計画等に位置づけて計画的に実施しております"@ja.
<< kg:id_28 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "教育委員会といたしましては毎年８月に特別支援教育講座を開講し、さきに述べましたそれぞれの役割を担う教職員に必要な内容の研修機会を提供しております"@ja.
<< kg:id_28 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "個別の教育支援計画、個別の指導計画の作成の仕方、発達障害の理解と支援方法等を全ての教員が受講するようにしております"@ja.
<< kg:id_28 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "特別支援学級等の教育課程において特別に設けられた指導領域である自立活動の具体例と指導方法について、特別支援学級の担任が受講しております"@ja.
<< kg:id_28 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "現行の学習指導要領で求められている特別支援学級の教育課程につきましては、特別支援学級の担任はもちろんのこと、管理職に向けても開講しております"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "一人一人の保護者の方に寄り添った、そして子供さんに寄り添った様々な面談をしながら特別支援学校に行かれるか、特別支援学級で学ばれるか、または様々な通級をしたりするか、もしくは通常学級でも十分対応できるかということで保護者の同意を得ながらやっております"@ja.
<< kg:id_33 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "これらをもっと肉づけした形で推進計画をつくったらどうかなと思っているんですが この鶴岡市の特別支援教育の推進計画の策定を検討するお考えがあるかどうか 今年度も特別支援教育の推進についてということで令和４年度の取組が実はまとめられております 今 様々議員からお話がありましたけれども 本市の取組につきまして全てまとめている冊子がありますので 例えばそれを基に構築することは十分可能かと思います"@ja.
<< kg:id_12 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "具体的には、音楽での合唱、合奏、それからそれにつきまして十分な事前練習、それから合理的な配慮、特別支援学級の子供たちが慣れない環境の中で同学年の友達と一緒に楽しく活動に取り組めるようにしております"@ja.
<< kg:id_12 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "修学旅行などでも一緒に活動する場合があるわけですけれども、そういう場合は通常学級の子供たちがやはりどうすればその特別支援学級の子供さんと一緒に楽しい、そして充実した修学旅行になるかということを一緒になって考えながら活動していく"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "全ての教職員が特別支援の免許を持っているわけではございませんので、中には特別支援の免許がなくて担任をしているという学年もございます"@ja.
<< kg:id_38 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "県教委も採用枠を今度変えまして、特別支援学級担任という枠での免許を持った方の採用ということを取り組み始めました"@ja.
<< kg:id_38 prop:contermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "特別支援学級の担任を初めてするというような先生方につきましては、県のほうで特別支援担任者研修というのを１年間やっております"@ja.
}
