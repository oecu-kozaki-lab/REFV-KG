kg:id_169 rdfs:label "観光施設として民間ノウハウを生かした自由な経営の継続"@ja.
kg:id_169 rdf:type cls:c_12437.
cls:c_12437 rdfs:label "民間運営"@ja.
kg:id_168 prop:contermeasure kg:id_169.
kg:id_170 rdfs:label "コロナ禍で食堂や宴会など入浴部門以外の収入も大きく減少"@ja.
kg:id_170 rdf:type cls:c_603.
kg:id_168 prop:cause kg:id_170.
kg:id_171 rdfs:label "入浴者数増加に向けた取組と他部門の利用拡大"@ja.
kg:id_171 rdf:type cls:c_2050.
cls:c_2050 rdfs:label "利用拡大"@ja.
kg:id_168 prop:contermeasure kg:id_171.
kg:st_1 rdfs:label "本間正芳議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "国の方針はトーンを少し下げてきたと受け止める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域移行で生徒指導面の目配りが弱くなると懸念"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "教育長"@ja.
kg:st_2 rdfs:type cls:st_57.
cls:st_57 rdfs:label "教育行政"@ja.
kg:op_3 prop:content "学校と活動団体が課題や目標を共有し一体で子供を育むべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "部活動に入らず民間クラブのみを選ぶ生徒が増えると見込む"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "部活動にも民間クラブにも属さない生徒が一定数いると認識"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "学校と移行先団体の連携を図り円滑な移行を進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "費用面の支援を行い部活動改革を推進する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "運動部と文化部の指導者不足に対応する必要がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "指導者報酬の確保につながる支援を行う"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "送迎負担軽減のためバスを継続する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "今後の移動手段として路線バス活用を関係部局と検討する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "来年度以降も学校施設の開放を続ける"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "文化部で開放エリアを広げられるよう支援する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "部活動改革はスポーツや文化だけでなく中学生の生活全体に関わる"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "地域の活動資源を掘り起こし鶴岡らしい中学生像につなげる人員が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_3 rdfs:label "健康福祉部長"@ja.
kg:st_3 rdfs:type cls:st_126.
cls:st_126 rdfs:label "福祉行政"@ja.
kg:op_16 prop:content "就労につながりにくい人への準備支援として実施する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "就労に結びつきにくい背景の一つとして中退者を対象に含む"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "社会参加や就労につながりにくい人への支援が必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "社会参加機会の乏しさが就労困難につながっている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "一般就労前の準備段階として生活基盤を整える"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "就労支援ノウハウを持つ支援者を育成し農業分野と連携する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "居場所づくりから就農訓練につなげる仕組みが必要"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "訓練後は本人の適性や希望を踏まえ就労や社会参加を支援する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:st_4 rdfs:label "農林水産部長"@ja.
kg:st_4 rdfs:type cls:st_149.
cls:st_149 rdfs:label "農政"@ja.
kg:op_24 prop:content "現行プランを法定化に合わせて実効性ある計画へ高める必要がある"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "計画策定の前提となる認知不足が課題"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "認知されても必要性の共有が不十分"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "地域内合意形成に時間がかかる要因になっている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "円滑な策定には地域で必要性を共有することが重要"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "複数チームで計画策定を進める"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "国は日本の単収格差の一因に湿害を挙げている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "海外の飼料用中心の国に比べ多収品種導入が進みにくい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "現行奨励品種を基本に栽培技術の徹底を進める"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "大豆300A技術の普及で単収向上を目指す"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "畑地化と排水対策で収量と品質向上を図る"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:st_5 rdfs:label "消防長"@ja.
kg:st_5 rdfs:type cls:st_146.
cls:st_146 rdfs:label "消防"@ja.
kg:op_35 prop:content "強風下で延焼しやすい厳しい火災だった"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "地域特性として延焼拡大の危険が高かった"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "風向の複雑さで延焼速度が速かった"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "住宅4棟3世帯を含む大きな被害となった"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "複数世帯が住家被害を受けた"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "2名が救急搬送されたが退院している"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "土蔵構造への放水困難もあり長時間火災となった"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "鎮火に時間を要した課題として土蔵構造への対応があった"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "消防団と連携しさらなる延焼拡大を食い止めた"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:op_44 prop:content "今回の経験を教訓に現場経験の少ない隊員の対応力を高める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
kg:op_45 prop:content "地域特性に応じた出火防止の啓発を進める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_5.
kg:st_6 rdfs:label "危機管理監"@ja.
kg:st_6 rdfs:type cls:st_150.
cls:st_150 rdfs:label "防災行政"@ja.
kg:op_46 prop:content "住家全焼や半焼などに応じて見舞金を支給する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:op_47 prop:content "固定資産税や保育料や介護保険料や水道料などが減免対象になり得る"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "原則3か月使用料全額免除で一時入居できる"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_6.
kg:op_49 prop:content "処理可能な火災廃棄物は手数料免除を受けられる"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:st_7 rdfs:label "尾形昌彦議員"@ja.
kg:st_7 rdfs:type cls:st_16.
kg:op_50 prop:content "支援メニューを一覧で見られるようにすべき"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_7.
kg:op_51 prop:content "今回の火災を契機に支援一覧の情報提供に努める"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:op_52 prop:content "後処理や再建は罹災者自身の費用負担が生じる"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_6.
kg:op_53 prop:content "平時からの備えとして保険加入等の取組を検討する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_6.
kg:st_8 rdfs:label "市民部長"@ja.
kg:st_8 rdfs:type cls:st_151.
cls:st_151 rdfs:label "市民行政"@ja.
kg:op_54 prop:content "国際的に価値ある湿地近傍で自然環境への影響が懸念される"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_8.
kg:op_55 prop:content "鳥類への影響が強く懸念される"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_8.
kg:op_56 prop:content "絶滅危惧種の保護の必要性がある"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_8.
kg:op_57 prop:content "一定地域に複数事業が集中することの影響を懸念した"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_8.
kg:op_58 prop:content "良好な景観を形成する区域に相当すると判断した"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_8.
kg:op_59 prop:content "環境影響評価法の手続開始前に予防的措置として中止を求めた"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_8.
kg:op_60 prop:content "条件が許せば進めてほしい地域住民の思いを損ねた"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_7.
kg:op_61 prop:content "中止申入れには地域住民の思いや要望を聞く視点が欠ける"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_7.
kg:st_9 rdfs:label "市長"@ja.
kg:st_9 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_62 prop:content "今回の事案を踏まえガイドライン明記も含め検討する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_9.
kg:st_10 rdfs:label "建設部長"@ja.
kg:st_10 rdfs:type cls:st_128.
cls:st_128 rdfs:label "建設行政"@ja.
kg:op_63 prop:content "官民連携手法導入可能性調査を踏まえDBOで進める"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_10.
kg:op_64 prop:content "鼠ヶ関の地理的特性を生かす重要なコンテンツとして鮮魚取扱いを支援する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_10.
kg:st_11 rdfs:label "教育部長"@ja.
kg:st_11 rdfs:type cls:st_57.
kg:op_65 prop:content "県だけでは解体できず長年膠着していた"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_11.
kg:op_66 prop:content "住民不安の解消が急がれていた"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_11.
kg:op_67 prop:content "解体とサッカー場整備を進めるため県と市が歩み寄った"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_11.
kg:op_68 prop:content "平成29年の試算より大きく増額した要因の一つ"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_11.
kg:op_69 prop:content "不確定リスクを大きめに見込んだ積算となっている"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_11.
kg:op_70 prop:content "サッカー場整備があることで解体にも過疎債を活用できる"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_11.
kg:op_71 prop:content "現実的な解決策として住民不安の解消が期待される"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_11.
kg:st_12 rdfs:label "佐藤昌哉議員"@ja.
kg:st_12 rdfs:type cls:st_16.
kg:op_72 prop:content "全体像や基本構想や運営見通しが示されず現時点で判断が厳しい"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_12.
kg:st_13 rdfs:label "渋谷耕一議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_73 prop:content "解体費賛成で今後の建設費や運営費増大を追認する形になりかねない"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_13.
kg:op_74 prop:content "全ての小中学生が習熟度に合った学習をできるようにする"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "デジタルドリル活用で学習効果向上を期待する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "紙の教科書ではできなかった学び方が可能になる"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "読み上げやルビや色変更などで支援が可能"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "荷物負担軽減のメリットがある"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "活用の前提として通信環境整備が必要"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "適切な使用ルールの啓発が必要"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "学びの可視化共有蓄積やオンライン授業を進める"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "オンライン活用で学びの機会を確保できる"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "児童の外国語の資質能力育成のため配置を進める"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "担任やALTと連携しコミュニケーション活動を支える"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "全ての学校に配置できない期間もあった"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "人材確保のためニーズに応じた雇用を行う"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:st_14 rdfs:label "商工観光部長"@ja.
kg:st_14 rdfs:type cls:st_152.
cls:st_152 rdfs:label "観光行政"@ja.
kg:op_87 prop:content "水際対策緩和後に回復傾向だがまだコロナ前の1割程度"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_14.
kg:op_88 prop:content "宿泊施設等で人手不足対応が必要"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_14.
kg:op_89 prop:content "日本遺産や温泉地などの旅行商品化を支援する"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_14.
kg:op_90 prop:content "酒田港寄港を鶴岡への誘客につなげる"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_14.
kg:op_91 prop:content "人手不足対応として業務効率化を支援してきた"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_14.
kg:op_92 prop:content "商工団体等と連携し人材確保を支援する"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_14.
kg:op_93 prop:content "観光庁補助の活用をしやすくする支援を進める"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_14.
kg:op_94 prop:content "国県補助も活用し通信環境整備を進めてきた"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_14.
kg:op_95 prop:content "多言語での案内表示を進めている"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_14.
kg:op_96 prop:content "DEGAMと連携し受入れ態勢強化を進める"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_14.
kg:op_97 prop:content "DEGAMを中心に多言語発信を行っている"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_14.
kg:op_98 prop:content "体験を通じて商品化と情報発信を促す"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_14.
kg:op_99 prop:content "個人旅行需要の取り込みを進める"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_14.
kg:st_15 rdfs:label "佐藤博幸議員"@ja.
kg:st_15 rdfs:type cls:st_16.
kg:op_100 prop:content "第三中学校区には地域活動拠点となる体育館が未整備となっている"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_15.
kg:op_101 prop:content "競技スポーツ中心の体育館に限らず地域拠点施設として整備を検討する"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_8.
kg:op_102 prop:content "子供と地域住民が触れ合う広く利用されるエリアを目指す"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_8.
kg:op_103 prop:content "様々な関係者の意見を聞きながら必要な施設機能を検討する"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_8.
kg:op_104 prop:content "高齢者や障害者を含め近隣に避難機能を求める声が強い"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_15.
kg:op_105 prop:content "災害種別ごとの基準を踏まえハードとソフト両面で検討する"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_8.
kg:op_106 prop:content "統合前後に協議したが維持管理負担が障壁となった"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_11.
kg:op_107 prop:content "地域資源として地元と一緒に望ましい活用策を検討したい"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_11.
kg:st_16 rdfs:label "羽黒庁舎支所長"@ja.
kg:st_16 rdfs:type cls:st_153.
cls:st_153 rdfs:label "支所行政"@ja.
kg:op_108 prop:content "両施設とも老朽化が進んでいる"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_16.
kg:op_109 prop:content "処分制限期間も踏まえ地域住民の意見を聞きながら検討する"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_16.
kg:st_17 rdfs:label "上下水道部長"@ja.
kg:st_17 rdfs:type cls:st_131.
cls:st_131 rdfs:label "上下水道行政"@ja.
kg:op_110 prop:content "近接処理施設の統廃合を進めた理由である"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_17.
kg:op_111 prop:content "平成28年供用の羽黒中央地区で実施した"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_17.
kg:op_112 prop:content "施設全体の有効活用が図られるよう取り組む"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_17.
kg:op_113 prop:content "今後の安定経営に向け施設配置最適化が必要"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_17.
kg:op_114 prop:content "統廃合による配置最適化が安定経営に寄与する"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_17.
kg:op_115 prop:content "第三次基本構想に基づき段階的に統廃合を進める"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_17.
kg:st_18 rdfs:label "本間信一議員"@ja.
kg:st_18 rdfs:type cls:st_16.
kg:op_116 prop:content "利用客減少で地元管理運営組合が営業終了に至った"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_18.
kg:st_19 rdfs:label "朝日庁舎支所長"@ja.
kg:st_19 rdfs:type cls:st_153.
kg:op_117 prop:content "温泉を活用した健康増進と地域振興に資する事業を念頭に調査した"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_19.
kg:op_118 prop:content "調査結果を踏まえ課題整理し来年度進める"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_19.
kg:st_20 rdfs:label "藤島・櫛引温泉施設統括監"@ja.
kg:st_20 rdfs:type cls:st_154.
cls:st_154 rdfs:label "施設管理"@ja.
kg:op_119 prop:content "明確な判断基準を設けている"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_20.
kg:op_120 prop:content "原油価格高騰等で運営コストが増している"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_20.
kg:op_121 prop:content "市民負担増や入浴控えも懸念され慎重に判断する"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_20.
kg:op_122 prop:content "指定管理の利点を生かして役割を果たしてもらいたい"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_20.
kg:op_123 prop:content "自立経営には入浴以外の利用拡大も必要"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_20.
kg:op_124 prop:content "自立した経営を目指す上で両面の取組が必要"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_20.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "期間中の地域移行の実現が困難だとする自治体の声を踏まえ、地域の実情に応じて可能な限り早期の実現を目指すと、年度等を入れないでそのことが発表になりました"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "地域移行することで子供たちに目が届きにくくなる部分が多くなると思います"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "部活動の休日の地域移行に伴う生徒指導の方策といたしましては、地域との連携が何よりも重要であると捉えております"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今後は、部活動に所属せず民間クラブのみに所属するという選択も増えてくることが予想されます"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "部活動に所属せずに家に帰るという無所属の生徒も少なからずいる現状となっております"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "教育委員会といたしましては、スムーズな地域移行が図られるよう統括コーディネーターを中心とした地域移行の普及・促進のための連絡調整会議を開催し、学校と移行先となる団体との連携を図ってまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "また、移行先の団体への支援や経済的に困窮する世帯への支援等も実施しながら、部活動改革を推進してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "教育委員会では、体育協会加盟団体や文化芸術団体にも協力を依頼し、指導者の確保を支援していくことをお答えしております"@ja.
<< kg:id_1 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "休日における中学生の活動を実施していただく団体に対し、補助金を交付することで指導者の報酬等も確保されるよう支援してまいります"@ja.
<< kg:id_1 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "来年度も休日の部活動のために６つの中学校において学校までのスクールバスを継続して運行いたします"@ja.
<< kg:id_1 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "今後、市中心部の施設までの行き来の方法として路線バスの活用についても関係部局と検討していく予定でございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "来年度以降も休日に活動する団体に対し学校施設の開放を継続していくことや"@ja.
<< kg:id_18 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "文化部活動につきましては部活動指導員が施設管理業務を担いながら指導できる体制を整えることで開放できるエリアを拡大できるよう支援してまいります"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "これからの中学部活動は、スポーツ活動や文化活動をどうするかだけでなく、中学生の生活をどうするかというところまで刺さらなければならなくなったと思います"@ja.
<< kg:id_20 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "スポーツ課にそういうところを探す人材を派遣する、もしくは増員する、社会教育課には文化部や塾、習い事、どんなところがあるのか拾い上げるような人材を派遣する、学校教育課には先ほど統括コーディネーターの話もありましたけれども、そのほか両方をうまく動かす人員をやっぱり増員したりして"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "この事業は、中高年で就労意欲はあるものの就労できていない方をはじめ"@ja.
<< kg:id_23 prop:cause kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "高等学校の中途退学者やひきこもり状態の方、あるいは社会参加の機会を得られない方など、なかなか就労に結びつかない方を対象としております"@ja.
<< kg:id_23 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "ひきこもり状態の方、あるいは社会参加の機会を得られない方など、なかなか就労に結びつかない方を対象としております"@ja.
<< kg:id_23 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "社会参加の機会を得られない方など、なかなか就労に結びつかない方を対象としております"@ja.
<< kg:id_23 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "一般就労に向けた準備段階として一定の場所に通うことを通じ、生活習慣を見直し、また日常生活を改善しながら働く意欲を育て、一般就労へ結びつけることを目的としております"@ja.
<< kg:id_23 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "障害者等への就労支援のノウハウを持った支援者が農業法人等と連携しながら農業の知識を身につけ、福祉的農業支援員としての人材を育成する事業でございます"@ja.
<< kg:id_23 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "生活困窮者や社会参加の機会を得にくい対象者に居場所の確保から始め、農業体験や農業に関する研修を受けていただき"@ja.
<< kg:id_23 prop:effect kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "就農訓練終了後に本人の適性や希望などを踏まえて農業関連業務への就労や社会参加の促進を支援する事業でございます"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "10年後の地域農業のあるべき姿を示した現行の人・農地プランについて、地域の話合いに基づいてより実効性の高い計画にするため令和５年４月から法定化されるもので"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "そもそも人・農地プラン自体が農業者に認知されていないこと"@ja.
<< kg:id_32 prop:cause kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "認知されていた場合でも計画の必要性を共有できていないこと"@ja.
<< kg:id_32 prop:cause kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "地域内に他地域からの入作者が多い場合や圃場条件などの課題がある場合には地域内での合意形成に時間がかかること"@ja.
<< kg:id_32 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "まずは地域での話合いにおいて地域計画の必要性を地域で共有することが重要であると考えております"@ja.
<< kg:id_32 prop:contermeasure kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "農業委員会とＪＡ、市の職員から成る対策チームを複数編成し"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "国では梅雨など湿害を受けやすい気候条件に加え"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "日本の大豆は主食用が主であることから、飼料用が多い海外の主要生産国に比べて多収品種への転換が進みにくいと分析しているようでございます"@ja.
<< kg:id_42 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "適期、作付や肥培管理など、基本的な栽培方法の徹底に加えて"@ja.
<< kg:id_42 prop:contermeasure kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "県で進める湿害に効果的な新たな耕起、播種技術、大豆300Ａ技術と言うんだそうです、これの普及拡大に取り組んでまいります"@ja.
<< kg:id_42 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "レーザーレベラーの活用なども取り入れながら排水効果の高い水田の畑地化を進めてまいります"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "海上に暴風警報が発表され、最大瞬間風速が21.7メートルを観測する悪条件の中"@ja.
<< kg:id_46 prop:cause kg:id_48 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "特に風の影響を受けやすい沿岸部の木造住宅が密集する地域で発生したことに加えまして"@ja.
<< kg:id_46 prop:cause kg:id_49 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "現場周辺では当時風が巻いておりまして、延焼速度のとても速い火災であったこと"@ja.
<< kg:id_46 prop:effect kg:id_50 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "住宅、空き家、蔵等の８棟を焼損し"@ja.
<< kg:id_46 prop:effect kg:id_51 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "全焼が２世帯３名、壁などを焼損した部分焼が１世帯２名でありました"@ja.
<< kg:id_46 prop:effect kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "また、負傷者は２名で、この２名の方々は救急搬送されました"@ja.
<< kg:id_46 prop:effect kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "鎮火まで約８時間を要した火災でありました"@ja.
<< kg:id_46 prop:cause kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "土蔵の独特な構造によりまして活動隊員による放水が建物内部に届きにくく、鎮火するまで想定以上に長い時間が要したこと"@ja.
<< kg:id_46 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "早期にポンプ車を増隊し、消防団と連携しながら総勢16台の消防ポンプで火災現場を包囲するように消火態勢を取ったことでさらなる延焼の拡大を食い止めることができた"@ja.
<< kg:id_46 prop:contermeasure kg:id_56 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "特に現場経験の少ない消防隊員及び消防団員には様々な建物に対応できるよう訓練や研修を強化するとともに"@ja.
<< kg:id_46 prop:contermeasure kg:id_57 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "蔵や木造密集地など、地域の特性を踏まえた火災予防広報をさらに強化し、出火防止に努めてまいります"@ja.
<< kg:id_58 prop:contermeasure kg:id_59 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "市の支援といたしましては、災害見舞金の支給"@ja.
<< kg:id_58 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "税金や使用料の減免"@ja.
<< kg:id_58 prop:contermeasure kg:id_61 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "市営住宅の一時使用"@ja.
<< kg:id_58 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "市の廃棄物処理手数料の減免制度などがあります"@ja.
<< kg:id_63 prop:effect kg:id_64 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "今回の火災を機に火災罹災者に対する支援策を鶴岡市のホームページで調べましたが、一覧で見られるようなものはありませんでした"@ja.
<< kg:id_63 prop:contermeasure kg:id_65 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "改めて、今回の火災事案を契機に、ホームページ等での支援一覧の情報提供に努めてまいりたいと考えてございます"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "公的な支援には限界があることから、火災現場の後処理や建物の再建には罹災者自らが費用を負担しなければなりません"@ja.
<< kg:id_66 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "失火責任法の紹介や火災保険加入の推奨等について、消防とも連携をして本市としての取組を検討してまいりたい"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "国際的に価値のあるラムサール条約登録湿地が近傍しており"@ja.
<< kg:id_69 prop:cause kg:id_71 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "バードストライクや鳥の営巣、餌場などへの影響が強く懸念されること"@ja.
<< kg:id_69 prop:cause kg:id_72 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "当該事業予定地周辺には絶滅危惧種１Ｂ類のクマタカなどの猛禽類の生息・営巣地が確認されており、保護の必要性などについて助言をいただいております"@ja.
<< kg:id_69 prop:cause kg:id_73 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "現在稼働中の鶴岡八森山風力発電事業、そして既に環境影響評価手続中の三瀬矢引風力発電事業と、一定の地域に複数の風力発電事業が集中する場合には飛来ルートや餌場への移動などについて累積的な影響が懸念されること"@ja.
<< kg:id_69 prop:cause kg:id_74 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "クマタカなどの猛禽類の生息・営巣や渡り鳥への生息の影響、また自然環境・景観への影響が懸念されると考えております"@ja.
<< kg:id_69 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "予防的措置の観点も含め、３月上旬に予定されておりました環境影響評価法の手続開始前の２月１日に、事業者に対して中止を求めたものでございます"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "今回の中止申入れは調査の上で条件が許せば風力発電事業を行ってほしいと考える地域住民の夢を打ち砕くものとなりました"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "今回の申入れには圧倒的に地域住民の思い、要望に耳を傾ける、地域との対話の視点が欠けているというふうに思います"@ja.
<< kg:id_69 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "このたびの事案も踏まえまして、ラムサール条約の登録湿地につきましては、ガイドラインに明記することも含めましてしっかり検討していきたい"@ja.
<< kg:id_81 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "公共が資金調達し、民間が設計、建設、維持管理、運営を一体で行うデザイン・ビルド・オペレートで実施しております"@ja.
<< kg:id_81 prop:contermeasure kg:id_83 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "現道の駅では、来年度から鮮魚などの水産物の販売実証実験を計画中であり、市としても取組を支援しながら得られた結果を公表することで漁業関係者の参画や事業者の積極的な提案につなげていきたい"@ja.
<< kg:id_84 prop:cause kg:id_85 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "県では、建物の解体費用等を病院事業局単独で捻出することは極めて困難ということで、長年膠着状況が続いてきた"@ja.
<< kg:id_84 prop:cause kg:id_86 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "地元黄金地区住民からは、不安解消のために早期解体の要望が挙げられております"@ja.
<< kg:id_87 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "県から市への土地、建物の無償譲渡と、さらに県から解体費の２分の１の負担をしてもらうことで県と市が協議をまとめたものであります"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "この増額要因といたしましては、建設物価の高騰や"@ja.
<< kg:id_89 prop:cause kg:id_91 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "少量と見込んでいたアスベスト除去、それから基礎くい除去等を最大限に見込んだ金額で、約５億円の増額"@ja.
<< kg:id_92 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "この過疎債は、解体だけでは活用できず、解体後のサッカー場整備など、施設整備があって初めて活用できるものであります"@ja.
<< kg:id_92 prop:effect kg:id_94 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "県と市、そして不安解消を願う黄金地区にとりまして、現実的な手法であると考えております"@ja.
<< kg:id_92 prop:effect kg:id_95 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "全体事業費や運営費の見通しなど、これだけ大きなプロジェクトであれば、まずはしっかり議会や市民にきちんと示すべきではないか"@ja.
<< kg:id_92 prop:effect kg:id_96 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "今定例会で解体費用に賛成することで、今後、費用が膨らんでも、議会に認めていただいた事案と逃げられます。私たち議会は反対しづらく、結果、建設費、運営費、土木費など、多額にわたる議会の責任が問われます"@ja.
<< kg:id_97 prop:contermeasure kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "全市の小・中学生が一人一人の習熟度に合った学習ができるＡＩ機能が搭載されたデジタルドリルを使用できるよう予算を計上いたしました"@ja.
<< kg:id_97 prop:effect kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "個別最適な学びの推進や効率的な知識・技能の習得につなげるため、デジタルドリルの効果的な活用を推進してまいります"@ja.
<< kg:id_100 prop:effect kg:id_101 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "学習者用デジタル教科書を活用することで、紙の教科書ではできなかった動画や音声の視聴、図表の拡大や縮小、児童・生徒の画面の共有等が容易にできるようになります"@ja.
<< kg:id_100 prop:effect kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "音声の読み上げやルビ振り、文字の拡大、文字色や背景色の変更などが可能となり、特別な支援が必要な児童・生徒にとっても、より学びやすい環境を整えることができます"@ja.
<< kg:id_100 prop:effect kg:id_103 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "紙の教科書を持ち運ぶ必要がなくなるため、児童・生徒の負担の軽減にもつながります"@ja.
<< kg:id_100 prop:cause kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "デメリットといたしましては、安定したネット環境が必要となることが挙げられます"@ja.
<< kg:id_100 prop:effect kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "長時間使用することによって目への負担が危惧される"@ja.
<< kg:id_97 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "SKYMENU Cloudという教育系のサービスを活用し、児童・生徒の考えや学びの足跡を端末上で可視化、共有化したり、蓄積したりすることで、より深い学びの実現に役立てております"@ja.
<< kg:id_97 prop:effect kg:id_107 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "不登校児童・生徒や病気や入院等で学校に来られない児童・生徒も授業に参加することが可能となっております"@ja.
<< kg:id_108 prop:contermeasure kg:id_109 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "本市では、児童の外国語の資質・能力の育成のため、外国語サポーターを雇用して各小学校に配置しております"@ja.
<< kg:id_108 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "単語やフレーズの発音をしたり、授業の中で担任等と会話のデモンストレーションをしたりと、コミュニケーション活動のサポートを担っていただいております"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "人材が見つからなかった等の理由により、全ての学校に配置できなかった期間もございました"@ja.
<< kg:id_111 prop:contermeasure kg:id_113 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "週５回の勤務だけではなく、例外として週３回の勤務も認めるなど、その方のニーズに応じた雇用をすることで、まずは人材の確保に努めております"@ja.
<< kg:id_114 prop:cause kg:id_115 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "昨年10月に水際対策が緩和され、回復傾向にございますが、宿泊数では、この１年間で約1,600人と、コロナ前の約１万3,000人と比べて１割程度にとどまる状況でございます"@ja.
<< kg:id_116 prop:cause kg:id_117 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "宿泊施設等の観光関連事業者の働き手の確保が重要な喫緊の課題であると考えております"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "民間事業者が行う本市の日本遺産、温泉地などの旅行商品化への支援に取り組んでおります"@ja.
<< kg:id_118 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "外航クルーズ船の酒田港への寄港に当たり、鶴岡市観光地へのオプショナルツアー造成の働きかけを行っております"@ja.
<< kg:id_121 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "ＩＣＴを活用した予約システムの導入など、人手不足に対応して業務の効率化を図る事業者の取組などを支援してまいりました"@ja.
<< kg:id_121 prop:contermeasure kg:id_123 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "各店舗・事業所の魅力発信、インターンシップの実施などによりまして、働き手の確保を支援してまいります"@ja.
<< kg:id_124 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "宿泊者からのニーズの高いベッドを配置した客室への転換など、施設の改修に取り組む事業者に対しましても、観光庁の補助事業を活用しやすくなるよう"@ja.
<< kg:id_124 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "市の施設８か所に整備をいたしましたほか、出羽三山エリア等の民間施設におきましては、市及び県の補助事業の活用により、24か所に整備が行われております"@ja.
<< kg:id_124 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "手向地区や松ヶ岡開墾場周辺19か所に多言語を併記した案内看板を設置しております"@ja.
<< kg:id_124 prop:contermeasure kg:id_128 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "ＤＥＧＡＭが主催といたしまして、会員向けに多言語での接客の研修を実施しておりますほか、観光庁主催のインバウンド受入れ研修も活用するなど"@ja.
<< kg:id_129 prop:contermeasure kg:id_130 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "７つの言語に対応した本市の観光サイト等で継続的に情報発信を行っております"@ja.
<< kg:id_129 prop:contermeasure kg:id_131 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "海外の旅行関係者やメディアの方を招聘いたしまして、鶴岡の観光コンテンツを体験いただき、旅行商品化や発信の強化につなげる取組も行っております"@ja.
<< kg:id_129 prop:contermeasure kg:id_132 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "個人旅行者が本市の観光サイトや旅行会社の商品ページを通して手軽に宿泊などの予約が行えるよう、システムの導入を進める予定としております"@ja.
<< kg:id_133 prop:cause kg:id_134 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "平成24年に第二体育館、当時利用者約２万3,000人ほどおられたという施設がございましたけれども、これは老朽化により廃止したことから、鶴岡第三中学校区には、現在地域の活動拠点となる施設が未整備の状況となっております"@ja.
<< kg:id_135 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "軽スポーツもできる地域のコミュニティ活動の拠点施設として第二学区コミセンを移転改築することを検討しております"@ja.
<< kg:id_135 prop:contermeasure kg:id_137 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "中央児童館などの子育て支援施設などとも機能連携することにより、市民に広く利用されるような複合的な機能を備えたエリアとして整備を検討してまいりたい"@ja.
<< kg:id_135 prop:contermeasure kg:id_138 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "令和５年度からは、ワークショップやアンケート等を実施し、地域ニーズを把握するとともに、課題を抽出・整理し、必要な施設機能及び整備手法などの検討・整理を行ってまいります"@ja.
<< kg:id_139 prop:effect kg:id_140 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "ハザードマップでは第二学区の指定避難所となっている鶴岡南高校へは距離も遠く、避難できないとの声が多くあります"@ja.
<< kg:id_139 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "具体的方法を提示しながら住民の皆様と相談し、合意形成を図りながら進めてまいりたい"@ja.
<< kg:id_142 prop:cause kg:id_143 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "地元主体の利用に向けて、学校統合の前後に地元自治振興会の皆様と協議を行いましたが、維持管理に係る負担感から調整がつきませんでした"@ja.
<< kg:id_144 prop:contermeasure kg:id_145 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "閉校舎につきましては、地域資源として、地域の活性化や地域振興に寄与する利活用が望ましいと考えておりますので、地元の皆様から望ましい活用策を御検討いただくことが重要"@ja.
<< kg:id_146 prop:cause kg:id_147 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "いずれも二次避難所として指定されておりますが、老朽化が進み、大規模な修繕が必要な状況となっております"@ja.
<< kg:id_146 prop:contermeasure kg:id_148 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "必要とする機能をよく吟味、整理して、機能移転や統合、長寿命化なども含め、方向性を検討してまいりたい"@ja.
<< kg:id_149 prop:cause kg:id_150 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "老朽化対策と事業の効率化のため、処理施設の統廃合と管路施設の機能強化を併せて実施しております"@ja.
<< kg:id_149 prop:contermeasure kg:id_151 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "処理施設の統廃合と管路施設の機能強化を併せて実施しております"@ja.
<< kg:id_152 prop:contermeasure kg:id_153 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "地域内での利活用を最優先しつつ、条件付での売買や貸借についての検討を進め、有効活用が図られるよう取り組んでまいりたい"@ja.
<< kg:id_154 prop:cause kg:id_155 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "人口減少や使用水量の減少に伴う使用料収入の減少"@ja.
<< kg:id_154 prop:cause kg:id_156 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "さらには増加が見込まれる老朽化施設に対応するため"@ja.
<< kg:id_154 prop:contermeasure kg:id_157 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "現在10処理区ある公共下水道を８処理区に、現在23地区になっている集落排水を13地区まで、段階的に統廃合を進める計画"@ja.
<< kg:id_158 prop:cause kg:id_159 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "コロナ禍による利用客の減少などで、令和４年11月末をもって温泉営業を終了された"@ja.
<< kg:id_160 prop:contermeasure kg:id_161 >>
    prop:stateBy kg:st_19;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "引き続き地域住民、市民の健康増進、地域振興に資する温泉入浴事業を念頭に、源泉の利活用策を検討するため、対話型市場調査、いわゆるサウンディングを実施した"@ja.
<< kg:id_160 prop:contermeasure kg:id_162 >>
    prop:stateBy kg:st_19;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "来年度は、調査結果を踏まえ、市として課題整理を行いながら、新たな運営事業者の募集及び試行に向けた取組を進めてまいります"@ja.
<< kg:id_163 prop:contermeasure kg:id_164 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "この指標を３年連続して下回った場合は行政財産から普通財産への移行を検討し、５年連続した場合は施設の廃止を検討する明確な方針としたところです"@ja.
<< kg:id_165 prop:cause kg:id_166 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "原油価格高騰等の影響を受けて、燃料費や光熱水費、諸物価が値上がりしています"@ja.
<< kg:id_165 prop:contermeasure kg:id_167 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "近隣施設の動向を注視しながら、今後、継続して検討していくこととしています"@ja.
<< kg:id_168 prop:contermeasure kg:id_169 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "ゆぽかについては、今後も観光施設として民間のノウハウを取り入れた自由な経営ができる利点を生かし、指定管理の役割を果たしていただきたい"@ja.
<< kg:id_168 prop:cause kg:id_170 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "食堂や宴会など入浴部門以外の収入もコロナ禍により大きく減少しており"@ja.
<< kg:id_168 prop:contermeasure kg:id_171 >>
    prop:stateBy kg:st_20;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "入浴者数増加に向けた取組と併せて、他部門の利用拡大にも取り組んでいく必要がある"@ja.
}
