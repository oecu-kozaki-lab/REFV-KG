kg:st_1 rdfs:label "遠藤初子議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "継続に向けより多くの方が参加できる取組を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "健康福祉部長渡邉健"@ja.
kg:st_2 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_2 prop:content "活動継続の課題と認識している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "活動継続の課題と認識している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "リーダーの成り手不足や継続の大変さへの対応を求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "重要な取組として評価している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "社会参加と生きがいづくりへの支援を継続する考えを示す"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "幅広い年代に運動や学びや社会参加の機会を提供できたと評価する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "参加拡大に向けた課題と考えている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "地域の高齢者が楽しく参加できるよう利活用すべきと提言する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_3 rdfs:label "市民部長伊藤慶也"@ja.
kg:st_3 rdfs:type cls:st_2.
kg:op_10 prop:content "日常生活の様々な場面で悩みを抱えていると認識している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "婚姻関係に比べ保証や権利が少ない課題があると説明する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "制度利用をためらう方もいると認識している"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "国の法案内容を踏まえて研究していく考えを示す"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "学校での学習機会を通じて理解促進を図る"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "大人社会でも理解を深める取組を強く求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "各家庭でもきちんとした認識を持つ必要があると訴える"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "大人社会でも理解が深まることを願う"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "制度導入時にはファミリーシップ制度も一緒に進めてほしいという声を紹介する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "市も積極的に勉強会などを開催してほしいと求める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "いじめ対策もしっかり見据えて進めるよう求める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:st_4 rdfs:label "草島進一議員"@ja.
kg:st_4 rdfs:type cls:st_16.
kg:op_21 prop:content "野鳥への悪影響は十分想定できると主張する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "オジロワシのバードストライク事例から危険性を指摘する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "バッファーゾーンを明記すべきと求める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "十分な隔離距離を取るべきと紹介する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "国の指針の動向を注視しガイドライン見直しを検討する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "国の指針などの動向を注視し検討する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "地元自治会の意向を踏まえて検討する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "環境影響を回避または十分低減できない場合は計画見直しを求めている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "影響を回避または十分低減できない場合の見直しを意見している"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "環境審議会など有識者の意見も伺いながら検討する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "国県に支援を求めながら取り組む考えを示す"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "現在の取組の中で加盟を検討する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "土地改良区の考えも伺いながら市の関わり方を研究する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "認証に向けた条件確認を進める考えを示す"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "国の動向や他地域の取組を見ながら取り入れる"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "都度変更内容を整理し保育所等へ周知してきた"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "時間外勤務も行いながら対応した"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "職員体制に不足が生じた時期もあったと説明する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "現場の負担が大きかったと認識している"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "国から示された時点で必要な対応を講じる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "オンライン会議や専用アプリ活用で軽減を図る"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:st_5 rdfs:label "総務部長佐藤光治"@ja.
kg:st_5 rdfs:type cls:st_2.
kg:op_42 prop:content "子育て家庭を取り巻く諸課題に的確に対応するため必要と考える"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:st_6 rdfs:label "教育部長本間明"@ja.
kg:st_6 rdfs:type cls:st_2.
kg:op_43 prop:content "給食を食べる児童生徒にも働く職員にも理想的なセンターが必要と考える"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_6.
kg:op_44 prop:content "積極的に意見やアイデアを収集し施設づくりに生かす"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:st_7 rdfs:label "商工観光部長阿部知弘"@ja.
kg:st_7 rdfs:type cls:st_2.
kg:op_45 prop:content "事業者利用者双方にとって一定の成果があったと捉える"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_7.
kg:op_46 prop:content "課題であると捉えている"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_7.
kg:op_47 prop:content "課題であると捉えている"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_7.
kg:op_48 prop:content "国県の施策動向も注視しながら検討する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_7.
kg:op_49 prop:content "景観を阻害する要因の一つと捉えている"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "それぞれ課題を整理しながら対策を検討している"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "国の新たな方針施策を踏まえ対応する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "早い段階での活用促進と発生抑制が重要と考える"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "国の具体的施策を踏まえ情報収集し対応する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:st_8 rdfs:label "農林水産部長佐藤龍一"@ja.
kg:st_8 rdfs:type cls:st_2.
kg:op_54 prop:content "持続可能な農業を推進する上で重要な取組と考える"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_8.
kg:op_55 prop:content "利用拡大があまり進んでいない課題を説明する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_8.
kg:op_56 prop:content "事業の自立化に向けて流通体制を改めている"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_8.
kg:op_57 prop:content "鶴岡としての独自色を色濃く出すため庁内連携を進める"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_8.
kg:st_9 rdfs:label "南波純議員"@ja.
kg:st_9 rdfs:type cls:st_16.
kg:op_58 prop:content "現場の教職員の負担がかなり大きかったと指摘する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_9.
kg:op_59 prop:content "公会計化には教職員負担軽減と保護者利便性向上のメリットがあると指摘する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_9.
kg:op_60 prop:content "無償化の方向性によりシステム導入の要否が変わると説明する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_6.
kg:st_10 rdfs:label "市長皆川治"@ja.
kg:st_10 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_61 prop:content "教育委員会に対応を促すとともに市全体で進める"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_10.
kg:st_11 rdfs:label "教育長布川敦"@ja.
kg:st_11 rdfs:type cls:st_31.
cls:st_31 rdfs:label "教育委員会"@ja.
kg:op_62 prop:content "専門性や資格を有する指導者から継続的指導を受けられた"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_11.
kg:op_63 prop:content "藤島中では全顧問が働き方改革が推進されていると回答した"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_11.
kg:op_64 prop:content "課題として挙げている"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_11.
kg:op_65 prop:content "スポーツ庁の提言に沿って対応していくべきと捉えている"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_11.
kg:op_66 prop:content "各中学校で文化部の移行方法を検討している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_11.
kg:op_67 prop:content "芸術文化団体等への協力を依頼していく"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_11.
kg:op_68 prop:content "地域と共にある学校づくりが一層推進されると期待している"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_11.
kg:op_69 prop:content "ICT活用と担当職員配置を検討する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_11.
kg:op_70 prop:content "一体で推進することで魅力ある学校づくりを一層進められる"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_11.
kg:op_71 prop:content "基本計画策定の中で丁寧に検討していく"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_11.
kg:op_72 prop:content "朝暘四小では連携が困難であると説明する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_6.
kg:op_73 prop:content "櫛引西小では人員確保が課題と説明する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_6.
kg:op_74 prop:content "片方の施設しかない場合は新設に課題があると説明する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_6.
kg:op_75 prop:content "学校施設活用の課題と認識している"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_6.
kg:op_76 prop:content "地域の実情に応じた手法を検討していく"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_6.
kg:op_77 prop:content "現在のゼロ歳児支援として実施している"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "他市の事業効果を見極め本市の実情に応じた支援策を検討する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "現在実施している産後支援の一つとして示す"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "市内5か所で活動していると把握している"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "応援会員として活動に協力する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "アウトリーチ型の支援事業として実施している"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "月2回程度の訪問で生活状況を把握し支援につなげている"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "交通手段の確保は大きな課題と捉えている"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "メリットがあると認識している"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "他地域の実証実験結果も参考に調査研究する"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:op_87 prop:content "参加者が多く関心の高さがうかがえる"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_2.
kg:op_88 prop:content "今後の課題と考えている"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_2.
kg:op_89 prop:content "参加者の増加に努める考えを示す"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_2.
kg:op_90 prop:content "地域のサポーターと協力し整備に向け取り組む"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
kg:op_91 prop:content "市独自調査は想定していないが県の調査結果を踏まえる"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_2.
kg:op_92 prop:content "県が診療体制を構築している"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "市民の健康相談窓口として対応する"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "実施回数の合計では209回と目標達成をしているものの、参加延べ人数の合計では約3,000人ということで目標の７割にとどまっております"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "団体によりましては、新たな参加者が増えないこと、活動の支え手や代表者の成り手が不足していることなどの課題がございます"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "団体によりましては、新たな参加者が増えないこと、活動の支え手や代表者の成り手が不足していることなどの課題がございます"@ja.
<< kg:id_3 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "団体によりましては、新たな参加者が増えないこと、活動の支え手や代表者の成り手が不足していることなどの課題がございます"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "いきいき百歳体操につきましては、活動団体は年々増加しており、要介護認定率低下に寄与する重要な取組と評価しているところでございます"@ja.
<< kg:id_7 prop:contermeasure kg:id_9 >>
    prop:text-txt_contents "そこで、生活支援コーディネーターや介護予防支援員、関係機関等が連携し"@ja.
<< kg:id_7 prop:contermeasure kg:id_10 >>
    prop:text-txt_contents "地域の実情に応じ、いきいき百歳体操の周知や"@ja.
<< kg:id_7 prop:contermeasure kg:id_11 >>
    prop:text-txt_contents "団体代表者を集めての情報交換会の開催などにより、活動の継続に向けた支援を行っております"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "より多くの高齢者が社会参加に関心を向け、自身の生きがいづくりに取り組むことは、介護予防効果が大きく期待されるところでもございます"@ja.
<< kg:id_14 prop:contermeasure kg:id_15 >>
    prop:text-txt_contents "関係団体等とも連携し、引き続き支援をしてまいります"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:text-txt_contents "フレイルとは、年齢とともに筋力や心身の活力、社会的なつながりが弱くなった健康な状態と要介護状態の中間の状態でございます"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "40歳代から90歳代までの幅広い年代の方々から御参加いただき、コロナ禍にありましても、フレイル予防のための運動や学び、社会参加の機会を提供できたことで、フレイル予防の普及啓発が図られたものと考えております"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "課題といたしましては、さきに御答弁申し上げましたいきいき百歳体操や住民主体の通いの場でも同様でございますが、男性の参加が少ない傾向があり、この点が課題と考えております"@ja.
<< kg:id_18 prop:contermeasure kg:id_21 >>
    prop:text-txt_contents "来年度も新しい事業メニューの実施や開催回数の拡充など、フレイル予防事業の充実を図り"@ja.
<< kg:id_18 prop:contermeasure kg:id_22 >>
    prop:text-txt_contents "来年度も新しい事業メニューの実施や開催回数の拡充など、フレイル予防事業の充実を図り"@ja.
<< kg:id_23 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "再開した際には、閉館前と同様、また２つの日帰り温泉施設と同様に、健康増進、介護予防、フレイル予防事業を行い、地域の高齢者が楽しく参加できるよう利活用していただきたく提言し"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "日本では、同性同士の婚姻は法的に認められていないため、ＬＧＢＴなど性的少数者の方々はパートナーが家族として認められず、病院への付添いや住居確保が難しいなど、日常生活の様々な場面で悩みを抱えているものと認識しております"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:text-txt_contents "その宣誓を自治体が証明することで様々なサービスや社会的配慮を受けやすくする制度でございまして"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:text-txt_contents "公営住宅への入居など、様々な行政サービスが適用されたり"@ja.
<< kg:id_27 prop:effect kg:id_30 >>
    prop:text-txt_contents "携帯電話の割引や生命保険受取人の指定など民間サービスの利用が拡大したり"@ja.
<< kg:id_27 prop:effect kg:id_31 >>
    prop:text-txt_contents "病院での付添いや同意の際に、パートナーやその子供が家族同様に扱われるようになるなど、当事者の方々の困難が軽減される"@ja.
<< kg:id_27 prop:cause kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "これらの制度は、各自治体が独自に取り組んでいるものでございまして、法律上の効力が生じないため、配偶者控除の適用が受けられない、遺言書がなければ相続ができないなど、婚姻関係にある夫婦に比べ、認められる保証や権利が少ないといった課題がございます"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "制度を利用することで、周囲の人に性的少数者であることが知られ、差別や偏見につながるおそれがあるとして、制度の利用をちゅうちょする方もいると伺っております"@ja.
<< kg:id_27 prop:contermeasure kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "当事者の皆さんの実態や意見を伺いながら、今後の取組の在り方について研究してまいりたいと存じます"@ja.
<< kg:id_36 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "こうした学校での学習機会を通じて、子供のうちから多様性についての理解促進を図っていくとともに"@ja.
<< kg:id_36 prop:contermeasure kg:id_38 >>
    prop:text-txt_contents "市民の理解を促す学びの機会の提供や"@ja.
<< kg:id_36 prop:contermeasure kg:id_39 >>
    prop:text-txt_contents "職員研修等を通して、職員の理解を深め、誰もが自分らしく生きることのできる社会を目指してまいりたい"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "むしろ、大人の認識が遅れているのではないかと考えます"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "各家庭においてもきちんとした認識を持たなければ、差別やいじめは決してなくなりません"@ja.
<< kg:id_44 prop:contermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "ぜひ企業などにおいても認識を深める取組を推進し"@ja.
<< kg:id_46 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "制度を導入する際には、パートナーシップと併せて、ファミリーシップ制度も一緒に進めてほしいという声もあります"@ja.
<< kg:id_44 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "今後、多様性を認め合い、社会的認識を深めていくため、市も積極的に勉強会などを開催し、当事者の声に耳を傾けていただきたく思います"@ja.
<< kg:id_49 prop:contermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "その際には、くれぐれもアウティング...アウティングにも十分に配慮しながら、いじめ対策もしっかりと見据えて取り組んでいくことをお願いして"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "風車によるバードストライクや飛来地の変更などの影響は十分に想定できます"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "風車によるオジロワシのバードストライクは国内でも70例確認されており、猛禽類にとって特に脅威となっております"@ja.
<< kg:id_51 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "改めてラムサール条約湿地を世界遺産に準じて、５キロメートルのバッファーゾーンを含めてゾーニングで規制することをガイドライン上に明記いただきたいと思います"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "風車騒音は睡眠を妨害し、健康被害をもたらすので、風車の騒音レベルが高い場所に人家があるべきではない。十分な隔離距離を取るべきである"@ja.
<< kg:id_56 prop:effect kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "静かな環境では風車騒音が35から40デシベルを超過すると、煩わしさの程度が上がり、睡眠への影響のリスクを増加させる可能性があることが示唆されております"@ja.
<< kg:id_59 prop:contermeasure kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "国が示す指針などの動向を注視しながら、本市のガイドラインの見直しの必要性について検討してまいりたい"@ja.
<< kg:id_61 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "アンケート調査等につきましては、地元自治会の意向を伺いながら検討してまいりたい"@ja.
<< kg:id_63 prop:effect kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "騒音及び低周波音、風車の影などが学校等や周辺住民の生活環境への影響"@ja.
<< kg:id_63 prop:effect kg:id_65 >>
    prop:text-txt_contents "急傾斜地崩落危険区域における急傾斜地の崩落、それから地滑り、土石流の発生などの危険性"@ja.
<< kg:id_63 prop:effect kg:id_66 >>
    prop:text-txt_contents "県指定の三瀬葉山ニッポンユビナガコウモリや希少猛禽類のクマタカ、それからオオタカの生息への影響などが懸念される"@ja.
<< kg:id_63 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "環境影響を回避、または十分に低減できない場合には、風力発電設備の配置の再検討"@ja.
<< kg:id_63 prop:contermeasure kg:id_68 >>
    prop:text-txt_contents "事業実施想定区域及び基数の削減を含む事業計画の見直しを行うようを意見しているところです"@ja.
<< kg:id_69 prop:contermeasure kg:id_70 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "ガイドラインで定める住民説明会の対象範囲や持ち方などにつきましても、今後環境審議会など、有識者からの御意見等も伺いながら検討してまいりたい"@ja.
<< kg:id_71 prop:contermeasure kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "今後とも、国・県に対して支援を求めながら、ほとりあや本市環境フェアなど、そういった場も通じまして環境学習の充実や広報、周知活動、こういったところをより充実させてまいりたい"@ja.
<< kg:id_73 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "このネットワークへの加盟につきましては、現在取り組んでおります保全と再生、それから交流と学習、賢明な利用に取り組む等の中で検討してまいりたい"@ja.
<< kg:id_75 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "両改良区の考えを伺いながら、市として管理計画にどのような関わり方ができるのか、大崎市など他自治体の例を参考としながら研究してまいりたい"@ja.
<< kg:id_77 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "湿地の重要性について市民の皆様の意識の醸成や保全活動への参加などの状況を伺いながら、認証を受ける条件など、国からの助言を求めてまいりたい"@ja.
<< kg:id_79 prop:contermeasure kg:id_80 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "今後の国の動向や他地域の取組などを見ながら、この考え方を自然学習など今後の取組に取り入れてまいりたい"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "国の基本的対処方針の変更などに伴う事務連絡が多く発出され、その都度変更内容を整理した上で保育所等への周知を行ってまいりました"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:text-txt_contents "コロナ感染による保育料、副食費の減免事務や感染拡大時には、保育所等の臨時休業に係る相談対応など、業務量は増加してきたところでございます"@ja.
<< kg:id_83 prop:cause kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "物価や原油価格高騰対策のため、保育所等への副食費支援や光熱費補助、子育て世帯生活支援事業など、補正予算による新規事業の実施もありましたことから、時間外勤務も行いながら対応してきた"@ja.
<< kg:id_86 prop:contermeasure kg:id_87 >>
    prop:text-txt_contents "会計年度任用職員の追加の配置"@ja.
<< kg:id_86 prop:contermeasure kg:id_88 >>
    prop:text-txt_contents "今年度正職員を１名増員し、対応してきたところでございます"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:text-txt_contents "検温等、毎日の健康観察、手洗い、消毒などの基本的な感染対策や効果的な換気対策を継続して"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "市内での感染拡大時には、職員の感染に加え、家族の感染に伴う自宅待機などにより職員体制に不足が生じた時期もあり"@ja.
<< kg:id_93 prop:effect kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "職員は感染へのプレッシャーを感じるなど、メンタルを維持する大変さがあったと伺っております"@ja.
<< kg:id_89 prop:contermeasure kg:id_95 >>
    prop:text-txt_contents "職員が勤務時間外に消毒、清掃等を行った場合の超過勤務手当や非常勤職員を雇い上げした場合の賃金など、これらのかかり増し経費を補助しております"@ja.
<< kg:id_96 prop:contermeasure kg:id_97 >>
    prop:text-txt_contents "抗原検査キットの配付やコロナワクチンの優先接種などにより、職員体制を維持するための支援も行ってきた"@ja.
<< kg:id_98 prop:contermeasure kg:id_99 >>
    prop:text-txt_contents "市では、換気対策に活用いただくため、ＣＯ２モニターを全保育施設へ配付し"@ja.
<< kg:id_98 prop:contermeasure kg:id_100 >>
    prop:text-txt_contents "扇風機やサーキュレーターなどの換気対策に有効な備品などの購入費補助や非接触型の蛇口や換気扇の設置など、感染症対策として必要な改修費への支援を行い"@ja.
<< kg:id_101 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "今後、国から示された時点で必要な対応を講じてまいりますが、早急に周知を図り、保育現場が混乱しないよう丁寧に対応してまいります"@ja.
<< kg:id_103 prop:contermeasure kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "オンラインによる会議や研修への参加、それから専用アプリからの出欠席の連絡など、ＩＣＴ等を活用するということにより保育職場の業務負担を軽減が図られていくものと考えている"@ja.
<< kg:id_105 prop:contermeasure kg:id_106 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "子育て家庭を取り巻く諸課題に的確に対応していくためにも、またさらなる施策の充実も含め、この国の新たな組織体制に沿った本市の組織体制の見直しが必要と考えております"@ja.
<< kg:id_105 prop:contermeasure kg:id_107 >>
    prop:text-txt_contents "今後につきましては、子育て支援の企画立案体制の強化を図るとともに"@ja.
<< kg:id_105 prop:contermeasure kg:id_108 >>
    prop:text-txt_contents "相談支援体制の見直しを行うなど、一層の子育て施策の充実を図り"@ja.
<< kg:id_109 prop:contermeasure kg:id_110 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "職員の意見を取り入れ、施設設備に反映していくことが重要と考えております"@ja.
<< kg:id_109 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "このような意見交換の場はこれで終わることなく、継続的に行っていきたいと考えております"@ja.
<< kg:id_112 prop:effect kg:id_113 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "一定の経済効果やキャッシュレス決済の促進効果という点につきまして、事業者、利用者双方にとって一定の成果があったものと捉えております"@ja.
<< kg:id_112 prop:cause kg:id_114 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "業種間で利用状況に差が生じたこと"@ja.
<< kg:id_112 prop:cause kg:id_115 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "購入数の予測が難しい点があり、２次募集開始後に１人当たりの購入上限数の見直しを行った点、こういった点については課題である"@ja.
<< kg:id_112 prop:contermeasure kg:id_116 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "商工団体等との意見交換を行いながら、消費喚起施策の適切な手法、今後のアプリ機能の活用について、引き続き検討を行ってまいりたい"@ja.
<< kg:id_117 prop:effect kg:id_118 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "管理不十分な空き家は、防災、防犯、景観のほか、地域活性化の面からも市民生活に悪影響を及ぼす"@ja.
<< kg:id_119 prop:contermeasure kg:id_120 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "今年度、鶴岡市空き家等対策庁内推進会議を立ち上げておりまして、庁内一体となって空き家対策に取り組む体制を整え"@ja.
<< kg:id_119 prop:contermeasure kg:id_121 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "改正後においては、必要に応じ、本市空き家等対策計画を見直すなど、国が示す新たな方針、施策等を踏まえ対応してまいりたい"@ja.
<< kg:id_119 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "危険な空き家の除却のみならず、その後の跡地利用なども含め、一体的に取り組んでいくことが重要である"@ja.
<< kg:id_123 prop:contermeasure kg:id_124 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "地区のニーズ、それから現状なども確認させていただきながら、地域と一緒に取り組んでまいりたい"@ja.
<< kg:id_125 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "化学肥料の使用量を低減し、堆肥など、地域内資源を活用した土作りは、重要な取組であると考えております"@ja.
<< kg:id_127 prop:cause kg:id_128 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "散布の作業負担を軽減し、効率的に施用するためには、散布機械や作業を請け負う組織が必要なことなどから、堆肥の利用拡大があまり進んでいないことが挙げられます"@ja.
<< kg:id_125 prop:contermeasure kg:id_129 >>
    prop:text-txt_contents "令和２年度から新規に堆肥の施用を後押しするメニューが追加されたことから、藤島地域におきましては新たな堆肥の利用拡大につながっており"@ja.
<< kg:id_125 prop:contermeasure kg:id_130 >>
    prop:text-txt_contents "下水道汚泥肥料の製造施設の建て替えに合わせた鶴岡コンポストの生産拡大を検討しているところでございます"@ja.
<< kg:id_131 prop:contermeasure kg:id_132 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "事業の自立化に向けて、県内の製粉業者が生産農家から直接買い取り、製麺業者に販売する体制づくりに取り組んでおります"@ja.
<< kg:id_131 prop:contermeasure kg:id_133 >>
    prop:text-txt_contents "令和５年度はスマート・テロワール事業で生産されたものも含めた鶴岡産小麦について、学校給食での利用の拡充を検討しておりまして"@ja.
<< kg:id_131 prop:contermeasure kg:id_134 >>
    prop:text-txt_contents "本事業で生産された小麦を使った麦きりをふるさと納税返礼品に登録するなど、域内外に向けたＰＲの拡大にも取り組んでいるところでございます"@ja.
<< kg:id_135 prop:contermeasure kg:id_136 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "鶴岡としての独自色を色濃く出していくためにも、これまで以上に積極的な庁内連携を進めてまいります"@ja.
<< kg:id_137 prop:cause kg:id_138 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "給食無償化に伴い、業務量の増加、手数料の負担が発生し、全てこれを現場の教職員で負担したため、かなりの労働超過が発生しました"@ja.
<< kg:id_139 prop:effect kg:id_140 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "学校給食費を自治体の会計に組み入れることで、教職員の業務が軽減されるだけでなく、保護者もコンビニ払いなどの多様な納付方法を選択できるようになり、利便性が向上できる"@ja.
<< kg:id_139 prop:contermeasure kg:id_141 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "まずはシステムの導入時期や規格などに与える影響の大きい給食費無償化の在り方と整合を図りながら進めていく必要があると考えております"@ja.
<< kg:id_142 prop:contermeasure kg:id_143 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "教育委員会に対応を促すとともに、市全体のさらなる取組を進めてまいります"@ja.
<< kg:id_144 prop:effect kg:id_145 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "成果といたしましては、生徒への技術指導の充実と、教員の働き方改革の推進が挙げられます"@ja.
<< kg:id_144 prop:effect kg:id_146 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "働き方改革の推進につきましては、田川地区総体のありました６月の時間外の勤務時間が、藤島中学校においては、市内の中学校で３番目に短かった"@ja.
<< kg:id_144 prop:cause kg:id_147 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "課題といたしましては、地域指導者の発掘・育成を含めた人材確保の問題"@ja.
<< kg:id_144 prop:cause kg:id_148 >>
    prop:text-txt_contents "指導者への謝金額の調整"@ja.
<< kg:id_144 prop:cause kg:id_149 >>
    prop:text-txt_contents "地域指導者が救急対応やいじめ対応などについて学ぶことができる研修会の新設等が挙げられております"@ja.
<< kg:id_150 prop:contermeasure kg:id_151 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "大会運営は大会主催者である団体等の所属する職員によって行われるべきということが示されており、本市においてもそのように対応していくべきものと捉えております"@ja.
<< kg:id_150 prop:contermeasure kg:id_152 >>
    prop:text-txt_contents "競技種目によっては教員の協力が必要であるとの声もありますので、中体連と各競技種目団体が話し合いながら進めるよう助言しております"@ja.
<< kg:id_153 prop:contermeasure kg:id_154 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "文化部の多くが来年度は保護者会クラブとして休日の活動を行う予定となっております"@ja.
<< kg:id_153 prop:cause kg:id_155 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "幾つかのクラブからは指導者の確保が難しいとの意見が出されております"@ja.
<< kg:id_153 prop:cause kg:id_156 >>
    prop:text-txt_contents "楽器の輸送に係る経費やその労力"@ja.
<< kg:id_153 prop:cause kg:id_157 >>
    prop:text-txt_contents "練習場所の確保の問題等が挙げられております"@ja.
<< kg:id_158 prop:effect kg:id_159 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "各学校では地域の方の思いや考えを反映させた学校運営が行われております"@ja.
<< kg:id_158 prop:cause kg:id_160 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "課題といたしましては、事務を担当する教職員の業務負担の増加が懸念されます"@ja.
<< kg:id_158 prop:contermeasure kg:id_161 >>
    prop:text-txt_contents "会議資料等の共有やＩＣＴの活用により事務負担の軽減を図る"@ja.
<< kg:id_158 prop:contermeasure kg:id_162 >>
    prop:text-txt_contents "協議会の事務を担当する職員の配置についても今後検討をしてまいります"@ja.
<< kg:id_163 prop:effect kg:id_164 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "学校、家庭、地域が目指すべき一貫教育の狙いや方策を共有しながら、協働して一貫教育に取り組めるものと考えております"@ja.
<< kg:id_163 prop:effect kg:id_165 >>
    prop:text-txt_contents "地域の特色を生かした教育活動をより効果的かつ持続可能に行うことができ"@ja.
<< kg:id_163 prop:contermeasure kg:id_166 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "中学校区ごとに１つの学校運営協議会を設置することを想定しております"@ja.
<< kg:id_167 prop:contermeasure kg:id_168 >>
    prop:text-txt_contents "既存の小学校区ごとの協議会は、中学校区の協議会の中で小学校部会として位置づけられ"@ja.
<< kg:id_169 prop:cause kg:id_170 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "朝暘四小は、学童保育所が暘光児童館、放課後子ども教室が田川コミセンであり、両会場の距離的な問題等から連携が困難である"@ja.
<< kg:id_169 prop:cause kg:id_171 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "櫛引西小は...受入側における人員の確保が困難な状況によるものです"@ja.
<< kg:id_172 prop:cause kg:id_173 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "新設すべきニーズや立ち上げのための人員確保と体制整備などが大きな課題となります"@ja.
<< kg:id_174 prop:cause kg:id_175 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "現在は空き教室の確保が困難な状況"@ja.
<< kg:id_174 prop:cause kg:id_176 >>
    prop:text-txt_contents "使用スペースの施錠可能な区画化など学校施設の改修等が必要となる"@ja.
<< kg:id_177 prop:contermeasure kg:id_178 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "現在、自治振興会事業として実施している青少年事業をベースにして放課後子ども教室に移行するといった方法も考えられますことから、そのような手法も含めて地域と検討を続けてまいります"@ja.
<< kg:id_179 prop:contermeasure kg:id_180 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "ゼロ歳児の支援につきましては、生後２か月頃までに保健師・助産師による乳児家庭全戸訪問を行っております"@ja.
<< kg:id_179 prop:contermeasure kg:id_181 >>
    prop:text-txt_contents "気になる状況がある場合は、再度の訪問や電話連絡など継続して支援を行っております"@ja.
<< kg:id_182 prop:cause kg:id_183 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "ゼロ歳児への見守り訪問事業につきましては、人材確保などの課題もあることから"@ja.
<< kg:id_184 prop:contermeasure kg:id_185 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "現在、市で実施しております産後の支援といたしましては、ヘルパーによる家事支援型の養育支援訪問"@ja.
<< kg:id_184 prop:contermeasure kg:id_186 >>
    prop:text-txt_contents "保育士による出前保育型の養育支援訪問"@ja.
<< kg:id_184 prop:contermeasure kg:id_187 >>
    prop:text-txt_contents "助産師が妊産婦に寄り添い、訪問などで育児手技等を指導する妊産婦サポート事業"@ja.
<< kg:id_188 prop:effect kg:id_189 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "子ども食堂は、子供の居場所づくりや孤食の防止を目的とし、無料または低額で食事の提供を行うもので"@ja.
<< kg:id_190 prop:contermeasure kg:id_191 >>
    prop:text-txt_contents "子ども食堂を運営する団体への支援といたしましては、市民の方々や企業から市へ、食材等の寄附があった際の配布"@ja.
<< kg:id_190 prop:contermeasure kg:id_192 >>
    prop:text-txt_contents "県からの運営費に関する補助がございます"@ja.
<< kg:id_190 prop:contermeasure kg:id_193 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "本市も設立趣旨に賛同し、応援会員としてその活動に協力することとしております"@ja.
<< kg:id_190 prop:contermeasure kg:id_194 >>
    prop:text-txt_contents "子ども食堂の実態につきましては、新年度に調査を行う予定としておりますが、このネットワークを通じて実態の把握に努め、運営団体のサポートの在り方について検討してまいります"@ja.
<< kg:id_195 prop:contermeasure kg:id_196 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "支援を要する子供がいる家庭へ弁当を届けるという事業を実施しております"@ja.
<< kg:id_195 prop:effect kg:id_197 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "月に２回程度、家庭に弁当を届けながら生活状況を把握し、適切な支援につなげるアウトリーチ型の支援事業でございます"@ja.
<< kg:id_198 prop:cause kg:id_199 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "広大な中山間地域を、有する本市におきましては、特に高齢者、障害者等が通院する際の交通手段の確保は大きな課題と捉えております"@ja.
<< kg:id_200 prop:effect kg:id_201 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "移動診療車が出向くことで、定期的な通院を必要とする移動困難な高齢者が医療機関に行かずに受診することができるというメリットがございます"@ja.
<< kg:id_200 prop:effect kg:id_202 >>
    prop:text-txt_contents "訪問診療のための医師の移動時間が削減され、医師にとっても効率的な診療が行えることが期待されております"@ja.
<< kg:id_200 prop:cause kg:id_203 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "医師をはじめとする医療従事者の確保や、導入・運行にかかる費用などの課題もございます"@ja.
<< kg:id_204 prop:contermeasure kg:id_205 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "年６回の全市的な講演会の開催をはじめ、公民館など小単位での講話を実施しており、毎回参加者が多く、関心の高さが伺える"@ja.
<< kg:id_204 prop:contermeasure kg:id_206 >>
    prop:text-txt_contents "企業や地域内の各種団体、それから小学校・中学校の生徒を対象に実施しており、先月末現在で、延べ２万500人がサポーター養成講座を受講しております"@ja.
<< kg:id_204 prop:cause kg:id_207 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "認知症の方御本人の事業への参加が少ないことが課題であると考えております"@ja.
<< kg:id_204 prop:contermeasure kg:id_208 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "認知症地域支援推進員を中心といたしまして、認知症御本人に寄り添いながら事業を展開し、参加者の増加に努めてまいりたい"@ja.
<< kg:id_209 prop:cause kg:id_210 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "県の報告によりますと、実際に活動できる人材の確保が困難なこともあり、整備が進まない現状と聞いております"@ja.
<< kg:id_211 prop:contermeasure kg:id_212 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "実態調査につきましては県が２回実施しております"@ja.
<< kg:id_211 prop:contermeasure kg:id_213 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "コロナ後遺症の診療体制につきましては、県が構築しており、まずかかりつけ医を受診することといたしております"@ja.
<< kg:id_211 prop:contermeasure kg:id_214 >>
    prop:text-txt_contents "県では、コロナ後遺症の相談窓口といたしまして、県がコロナ後遺症コールセンターを設置し、対応している"@ja.
<< kg:id_211 prop:contermeasure kg:id_215 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "市といたしましては、健康課が窓口となりまして、市民の健康相談に随時対応いたしておりますので、コロナ後遺症に関する相談をいただいた場合には、相談に丁寧に応じるとともに、受診可能な医療機関の情報提供などに努めてまいります"@ja.
}
