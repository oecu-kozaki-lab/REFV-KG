kg:id_82 rdfs:label "体力測定とフレイルアンケートで状態確認し予防を動機づける"@ja.
kg:id_82 rdf:type cls:c_3673.
cls:c_3673 rdfs:label "状態確認"@ja.
kg:id_78 prop:contermeasure kg:id_82.
kg:id_83 rdfs:label "農業経営の悪化"@ja.
kg:id_83 rdf:type cls:c_754.
cls:c_754 rdfs:label "経営悪化"@ja.
kg:id_84 rdfs:label "肥料原料の輸入価格高騰"@ja.
kg:id_84 rdf:type cls:c_791.
cls:c_791 rdfs:label "資材高騰"@ja.
kg:id_83 prop:cause kg:id_84.
kg:id_85 rdfs:label "米価の下落"@ja.
kg:id_85 rdf:type cls:c_1178.
cls:c_1178 rdfs:label "価格下落"@ja.
kg:id_83 prop:cause kg:id_85.
kg:id_86 rdfs:label "生産資材価格の高騰と価格転嫁の困難"@ja.
kg:id_86 rdf:type cls:c_12582.
cls:c_12582 rdfs:label "価格転嫁困難"@ja.
kg:id_83 prop:cause kg:id_86.
kg:id_87 rdfs:label "農業景況が調査開始以来最低値となる"@ja.
kg:id_87 rdf:type cls:c_12583.
cls:c_12583 rdfs:label "景況悪化"@ja.
kg:id_83 prop:effect kg:id_87.
kg:id_88 rdfs:label "中山間地域で耕作放棄地化や離農につながるおそれ"@ja.
kg:id_88 rdf:type cls:c_5233.
cls:c_5233 rdfs:label "離農懸念"@ja.
kg:id_83 prop:effect kg:id_88.
kg:id_89 rdfs:label "肥料価格高騰分への国県市の支援を実施する"@ja.
kg:id_89 rdf:type cls:c_12584.
cls:c_12584 rdfs:label "価格高騰支援"@ja.
kg:id_83 prop:contermeasure kg:id_89.
