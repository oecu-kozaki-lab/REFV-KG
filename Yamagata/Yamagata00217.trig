kg:st_1 rdfs:label "11番秋葉雄議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "生産現場の声として強く要望する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "生産現場の声として強く要望する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "生産現場の声として強く要望する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "生産現場の声として強く要望する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "生産現場の声として強く要望する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "農業振興と農村振興は両輪として一体的に進めるべきと主張"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "農業振興と農村振興は一体的に進めるべきと主張"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "多様な担い手の役割は極めて大きいと要望"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "水田活用の直接支払交付金の見直しにとどまらない施策見直しを要望"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_2 rdfs:label "2番草島進一議員"@ja.
kg:st_2 rdf:type cls:st_16.
kg:op_10 prop:content "法案の早期成立を求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "自治体等の保全や利用の取組への積極的支援を求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "基本施策として重要と説明"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "基本施策として重要と説明"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "基本施策として重要と説明"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "基本施策として重要と説明"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "基本施策として重要と説明"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "基本施策として重要と説明"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "保全体制の弱体化を踏まえ法整備が必要と指摘"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "本市として大変重要な課題と考える"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:st_3 rdfs:label "21番佐藤昌哉総務常任委員長"@ja.
kg:st_3 rdf:type cls:st_36.
cls:st_36 rdfs:label "委員長"@ja.
kg:op_20 prop:content "委員会では質疑なく原案可決すべきと報告"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "委員会では質疑なく原案可決すべきと報告"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:st_4 rdfs:label "総務常任委員会委員"@ja.
kg:st_4 rdf:type cls:st_3.
cls:st_3 rdfs:label "委員"@ja.
kg:op_22 prop:content "16年での更新理由を確認した"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:st_5 rdfs:label "当局"@ja.
kg:st_5 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_23 prop:content "老朽化のため更新すると説明"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:st_6 rdfs:label "12番黒井浩之市民文教常任委員長"@ja.
kg:st_6 rdf:type cls:st_36.
kg:op_24 prop:content "これに準じ所要の改正を行うと報告"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_6.
kg:op_25 prop:content "これに準じ所要の改正を行うと報告"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_6.
kg:op_26 prop:content "改正内容として報告"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "特段の危険性が確認されなかったため見直すと報告"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "改正内容として報告"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:op_29 prop:content "火災予防上必要な改正と報告"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_6.
kg:op_30 prop:content "標識設置の見直しを報告"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_6.
kg:st_7 rdfs:label "市民文教常任委員会委員"@ja.
kg:st_7 rdf:type cls:st_3.
kg:op_31 prop:content "一般家庭への影響を確認した"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_7.
kg:op_32 prop:content "一般家庭の充電器は規制対象でなく対応不要と説明"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "集約化処理施設整備に伴う規約変更と報告"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "委託事務範囲変更が必要と報告"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "新たな集約化処理施設整備に対応する変更と報告"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "負担を求めることを可能にする変更と報告"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:st_8 rdfs:label "9番菅井巌厚生常任委員長"@ja.
kg:st_8 rdf:type cls:st_36.
kg:op_37 prop:content "摩耗に対応するため更新すると報告"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_8.
kg:op_38 prop:content "整備修繕で対応してきたが更新に至ったと報告"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:st_9 rdfs:label "厚生常任委員会委員"@ja.
kg:st_9 rdf:type cls:st_3.
kg:op_39 prop:content "前回購入時との価格差を確認した"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_9.
kg:op_40 prop:content "原材料費高騰が主な要因と説明"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "前回購入時との価格差を確認した"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "円安が主な要因と説明"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "料金転嫁の必要性を質問した"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_9.
kg:op_44 prop:content "市全体で検討が必要と認識している"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
kg:st_10 rdfs:label "11番秋葉雄産業建設常任委員長"@ja.
kg:st_10 rdf:type cls:st_36.
kg:op_45 prop:content "認定基準を満たすようになったため認定と報告"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_10.
kg:op_46 prop:content "認定基準を満たしているため認定と報告"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_10.
kg:op_47 prop:content "寄附により認定基準を満たしたため認定と報告"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_10.
kg:st_11 rdfs:label "産業建設常任委員会委員"@ja.
kg:st_11 rdf:type cls:st_3.
kg:op_48 prop:content "認定に至った経緯を確認した"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_11.
kg:op_49 prop:content "市帰属により認定基準を満たしたと説明"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_5.
kg:op_50 prop:content "認定に至った経緯を確認した"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_11.
kg:op_51 prop:content "寄附採納手続完了により認定基準を満たしたと説明"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_5.
kg:st_12 rdfs:label "総務部長森屋健一"@ja.
kg:st_12 rdf:type cls:st_2.
kg:op_52 prop:content "市道機能と市民生活の回復を図るため実施すると説明"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_12.
kg:op_53 prop:content "市道機能及び市民の日常生活の回復を図る工事と説明"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_12.
kg:op_54 prop:content "市道機能の回復が必要と説明"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_12.
kg:op_55 prop:content "市民の日常生活の回復が必要と説明"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_12.
kg:op_56 prop:content "生活環境の保全を図る必要があると説明"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_12.
kg:op_57 prop:content "公衆衛生の確保を図る必要があると説明"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_12.
kg:op_58 prop:content "中止申入れ理由の一つと説明"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:st_13 rdfs:label "4番南波純議員"@ja.
kg:st_13 rdf:type cls:st_16.
kg:op_59 prop:content "市当局の判断は極めて適切であったと評価"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_13.
kg:st_14 rdfs:label "7番長谷川剛議員"@ja.
kg:st_14 rdf:type cls:st_16.
kg:op_60 prop:content "市の中止申入れは妥当と評価"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_14.
kg:op_61 prop:content "国際的視点から妥当な判断と主張"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "中止申入れ理由の一つと説明"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_5.
kg:op_63 prop:content "鳥類への重大な影響が懸念されると主張"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_14.
kg:op_64 prop:content "渡り鳥や猛禽類への影響から認められないと主張"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "中止申入れ理由の一つと説明"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_5.
kg:op_66 prop:content "重要な自然環境保全のため事前判断が必要と説明"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_5.
kg:op_67 prop:content "予防原則による判断は賢明と主張"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_14.
kg:op_68 prop:content "予防原則に基づく判断を支持すると主張"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:st_15 rdfs:label "請願者"@ja.
kg:st_15 rdf:type cls:st_27.
cls:st_27 rdfs:label "請願者"@ja.
kg:op_69 prop:content "プラスの効果を含めて検討してきた"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_15.
kg:op_70 prop:content "地域住民の声を反映したものとは思えないと主張"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_15.
kg:op_71 prop:content "地域住民の理解や納得が得られないのは当然と主張"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
kg:st_16 rdfs:label "23番尾形昌彦議員"@ja.
kg:st_16 rdf:type cls:st_16.
kg:op_72 prop:content "地域住民の思いに蓋をした状態と主張"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_16.
kg:op_73 prop:content "調査結果で困難なら諦めざるを得ないと考える"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_15.
kg:op_74 prop:content "まずしっかり調査してほしい請願と評価"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_1.
kg:op_75 prop:content "しっかり調査をしてほしいという認識だと説明"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_16.
kg:op_76 prop:content "調査もせず事業中止になることは諦められないと主張"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_15.
kg:op_77 prop:content "中止申入れを白紙に戻すべきと主張"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_16.
kg:st_17 rdfs:label "紹介議員"@ja.
kg:st_17 rdf:type cls:st_16.
kg:op_78 prop:content "地元メリットの一例として認識している"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_17.
kg:op_79 prop:content "林道整備への期待があったと説明"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_16.
kg:op_80 prop:content "地元メリットの一例として認識している"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_17.
kg:op_81 prop:content "地元メリットの一例として認識している"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_17.
kg:op_82 prop:content "町内振興会財源や会費軽減への期待があったと説明"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_16.
kg:op_83 prop:content "事業者によるソフト面のフォローがあると認識"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_17.
kg:op_84 prop:content "環境影響評価法手続に入っても中止は可能と説明"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_17.
kg:op_85 prop:content "古くからの町並みという景観には影響しないと理解"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_17.
kg:op_86 prop:content "景観保全に対する認識が不十分で本市の立場と相入れないと反対"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_13.
kg:op_87 prop:content "まず調査を実施してほしいという請願の趣旨と説明"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_17.
kg:op_88 prop:content "鳥類への影響回避が必要で加茂計画はあり得ないと主張"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_14.
kg:op_89 prop:content "ラムサール湿地の価値を著しく損なうと主張"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_2.
kg:op_90 prop:content "懸念されることはしっかり調査して明らかにすると説明があったと紹介"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_17.
kg:op_91 prop:content "不眠症リスクや入眠妨害リスクがあると主張"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_2.
kg:op_92 prop:content "一方的説明で地元との意思疎通が十分ではなかったと指摘"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_13.
kg:op_93 prop:content "強権的で乱暴なやり方と批判されるのも当然と主張"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_1.
kg:op_94 prop:content "地域が抱える深刻な課題として理解した"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_13.
kg:op_95 prop:content "地域消滅への危惧があると説明"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_16.
kg:op_96 prop:content "地域課題として把握した"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_13.
kg:op_97 prop:content "加茂山の管理困難が検討開始の背景と説明"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_1.
kg:op_98 prop:content "今後持続的に山の整備を行えるか不安があると説明"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_16.
kg:op_99 prop:content "何か手を打たないと地域が消滅に向かうと危惧"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_16.
kg:op_100 prop:content "平均が70歳近くで持続的整備に不安があると説明"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_16.
kg:op_101 prop:content "目的地に行くまでの林道整備不足が課題と説明"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_16.
kg:op_102 prop:content "総会で財源確保への期待が語られたと説明"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_16.
kg:op_103 prop:content "風力発電事業の中で林道整備可能ではないかと希望を抱いていたと説明"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_16.
kg:op_104 prop:content "三瀬地区を参考に検討してきたと説明"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_16.
kg:op_105 prop:content "観光資源を生かした持続可能な活性化を図るべきで短期的メリットに依拠すべきでない"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_13.
kg:op_106 prop:content "3つの観光資源を活用すべきと主張"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_13.
kg:op_107 prop:content "地域の存続を真剣に模索する背景と説明"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_1.
kg:op_108 prop:content "風力発電可能性検討の背景と説明"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_1.
kg:op_109 prop:content "住民が危機感を持っていたと説明"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_1.
kg:op_110 prop:content "これまで可能性を見いだしていた住民の理解が得られないのは当然と主張"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_1.
kg:op_111 prop:content "皆川市政らしくないと批判"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_1.
kg:op_112 prop:content "風力発電ではなく国県への要望と支援策模索が必要と主張"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_14.
kg:op_113 prop:content "支援策を一緒に模索すべきと主張"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_14.
kg:op_114 prop:content "風力発電建設と地域振興は別問題と主張"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_14.
kg:op_115 prop:content "反対理由として挙げた"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_14.
kg:op_116 prop:content "600メートル以上離れていることに抵触していると指摘"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_14.
kg:op_117 prop:content "呉地正行氏の指摘として紹介"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_14.
kg:op_118 prop:content "世界的研究者の見解として中止を強く求めると紹介"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_2.
kg:op_119 prop:content "景観まちづくり市民フォーラムの指摘を紹介"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_14.
kg:op_120 prop:content "そうした電源開発には同意できないと主張"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_14.
kg:op_121 prop:content "加茂住民の半数にも満たない請願であると主張"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_2.
kg:op_122 prop:content "環境省委託調査や専門家見解から認めてはならないと主張"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_2.
kg:op_123 prop:content "呉地正行氏の見解として紹介"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_2.
kg:op_124 prop:content "渡来数減少のおそれがあると主張"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_2.
kg:op_125 prop:content "日本野鳥の会研究員の見解として絶対に阻止すべきと紹介"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_2.
kg:op_126 prop:content "予防原則として事前判断が賢明と主張"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_2.
kg:op_127 prop:content "科学的シミュレーションで39名の不眠症リスクが出ていると主張"@ja.
kg:op_127 rdf:type cls:opinion.
kg:op_127 prop:speaker kg:st_2.
kg:op_128 prop:content "科学的シミュレーションで1680名の入眠妨害リスクが出ていると主張"@ja.
kg:op_128 rdf:type cls:opinion.
kg:op_128 prop:speaker kg:st_2.
kg:op_129 prop:content "尾根開発により地盤安定や保水能力が失われ増災が生じると主張"@ja.
kg:op_129 rdf:type cls:opinion.
kg:op_129 prop:speaker kg:st_2.
kg:op_130 prop:content "市が事前協議届出書を受理しなかったのは妥当と主張"@ja.
kg:op_130 rdf:type cls:opinion.
kg:op_130 prop:speaker kg:st_2.
kg:op_131 prop:content "非があるのは不当な要求を繰り返すＪＲＥのほうと主張"@ja.
kg:op_131 rdf:type cls:opinion.
kg:op_131 prop:speaker kg:st_2.
kg:op_132 prop:content "環境省ガイドライン違反であり手抜きと主張"@ja.
kg:op_132 rdf:type cls:opinion.
kg:op_132 prop:speaker kg:st_2.
kg:op_133 prop:content "自治会への直接補助金納入はやめるべきと主張"@ja.
kg:op_133 rdf:type cls:opinion.
kg:op_133 prop:speaker kg:st_2.
kg:op_134 prop:content "早期に保護地区にしていただきたいと要望"@ja.
kg:op_134 rdf:type cls:opinion.
kg:op_134 prop:speaker kg:st_2.
