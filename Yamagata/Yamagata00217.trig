    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "食料安全保障の強化、再生産に配慮した適正な価格形成、その実現に向けた国民理解の醸成・行動変容、農業の持続的な発展に関する施策及び農村の活性化に関する施策など、多岐にわたる論点を踏まえた法整備、関連施策の拡充・再構築、万全な予算措置が必要となる"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "食料安全保障の強化、再生産に配慮した適正な価格形成、その実現に向けた国民理解の醸成・行動変容、農業の持続的な発展に関する施策及び農村の活性化に関する施策など、多岐にわたる論点を踏まえた法整備、関連施策の拡充・再構築、万全な予算措置が必要となる"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "人口減少・高齢化が深刻化する中、持続可能な農業生産には、その基盤となる農村の振興は欠かすことができず"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "持続可能な農業生産には、その基盤となる農村の振興は欠かすことができず"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "認定農業者等の担い手はもとより、「多様な担い手」が果たす役割は極めて大きいため、農村振興のみならず、農業振興の観点からも「多様な担い手」を基本法にしっかりと位置付けること"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "水田活用の直接支払交付金の見直しにとどまらず、ゲタ対策等の経営所得安定対策や、個々の農家に対する新たな直接支払制度の導入を含めた施策全般にわたる見直しを行うこと"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "地域在来品種等の種苗の保存及び利用や、地域在来農産物等・その加工品の利用の促進に関し必要な事項を定め、施策を総合的かつ効果的に推進することを目的とした「地域在来品種等の種苗の保存及び利用等の促進に関する法律案」が超党派議員により提案される見通しであります"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "都道府県、市町村に対する国の支援を講ずるものとなっています"@ja.
<< kg:id_12 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "基本施策として（１）地域在来品種等の種苗の収集及び保存並びに提供等"@ja.
<< kg:id_12 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "基本施策として（２）技術の開発及び普及"@ja.
<< kg:id_12 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "基本施策として（３）人材の育成及び確保"@ja.
<< kg:id_12 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "基本施策として（４）連携の強化"@ja.
<< kg:id_12 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "基本施策として（５）関係者の活動に対する支援"@ja.
<< kg:id_12 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "基本施策として（６）国民の理解と関心の増進を掲げています"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "予算の関係等から広島県農業ジーンバンクは今年３月末で廃止"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "山形在来作物研究会も今年３月末で解散となっています。...在来作物の保全と有効利用が課題である本市としても大変重要と考えます"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "労務単価の上昇及び物価の高騰による請負代金の変更申請を受けて、請負金額の増額変更を行うもの"@ja.
<< kg:id_25 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "労務単価の上昇及び物価の高騰による請負代金の変更申請を受けて、請負金額の増額変更を行うもの"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "一定年数の稼働による老朽化のため更新するものである"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "電気自動車等を充電する急速充電設備の規制内容等及び火災予防の観点から設置を要する喫煙所の標識の２点に関し改正されたことから、これに準じ、所要の改正を行うものであります"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "電気自動車等を充電する急速充電設備の規制内容等及び火災予防の観点から設置を要する喫煙所の標識の２点に関し改正されたことから、これに準じ、所要の改正を行うものであります"@ja.
<< kg:id_30 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "今後急速充電設備による充電の普及拡大が想定される船舶、航空機等を対象として追加する"@ja.
<< kg:id_30 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "200キロワットを超えるものに特段の危険性が確認されなかったため、この上限を廃止する"@ja.
<< kg:id_30 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "急速充電設備の定義を明確化した上で、急速充電設備の構造や管理の基準等について見直す"@ja.
<< kg:id_30 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "急速充電設備を手動で緊急に停止することができる装置を速やかに操作することができる箇所に設置しなければならない"@ja.
<< kg:id_30 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "健康増進法に規定する喫煙専用室標識が設置されている場合は、喫煙所の標識を設置しなくてもよいと改める"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_31;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "一般家庭の充電器については容量が小さいため、規制の対象にはなっておらず、対応は要しない"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "現在のし尿処理施設は...施設の老朽化が進んだため、下水道浄化センター内に下水道施設として新たに集約化処理施設を整備することとなった"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "三川町では集約化処理施設への移行後も引き続きし尿等の処理を鶴岡市に継続して委託する意向を示しているため、規約の変更を行うものです"@ja.
<< kg:id_40 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "廃棄物処理施設に下水道処理施設を加えることで、三川町からの委託事務の範囲を変更する"@ja.
<< kg:id_40 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "新たに下水道施設として整備する、し尿等の集約化処理施設整備についても三川町に負担を求めることを可能にする"@ja.
<< kg:id_45 prop:cause kg:id_46 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "くしびき温泉ゆ～Ｔｏｗｎに設備されていた揚湯ポンプの摩耗に対応するため、交換用の揚湯ポンプを更新する"@ja.
<< kg:id_45 prop:cause kg:id_47 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "可能な限り整備、修繕等をしながら対応してきたものでありますが、損傷が激しいため、このたびの更新に至ったものです"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_39;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "世界的な原材料費の高騰と為替変動により円安の状態が続いていることが主な要因で、２倍以上になっている"@ja.
<< kg:id_48 prop:cause kg:id_50 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "世界的な原材料費の高騰と為替変動により円安の状態が続いていることが主な要因で、２倍以上になっている"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_43;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "利用料金の設定については、算定基礎をどうするかについて検討する必要があると考えており、また他の類似施設との兼ね合いもあるため、市全体で検討していくことが必要であると認識している"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "海老島町５号線及び平京田27号線は、宅地開発により拡幅された路線であり、認定基準を満たすようになったことから認定する"@ja.
<< kg:id_53 prop:cause kg:id_55 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "日枝海老島６号線は、宅地開発により新たに整備された路線であり、認定基準を満たしていることから認定する"@ja.
<< kg:id_53 prop:cause kg:id_56 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "日枝宮ノ下８号線は、道路用地の寄附によって認定基準を満たすようになったことから認定する"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_48;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "海老島町５号線については、昨年、道路用地が市に帰属し"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_50;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "平京田27号線については、今年、寄附採納の手続が完了し、認定基準を満たすものと認められたことから提案した"@ja.
<< kg:id_61 prop:cause kg:id_62 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "令和４年12月31日に西目地内で発生した土砂災害により市道及び民地に堆積している土砂や倒壊家屋の瓦礫等を撤去し"@ja.
<< kg:id_61 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "市道及び民地に堆積している土砂や倒壊家屋の瓦礫等を撤去し、市道機能及び市民の日常生活の回復を図るとともに、居住地の生活環境の保全及び公衆衛生の確保を図ることを目的に実施する"@ja.
<< kg:id_64 prop:effect kg:id_65 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "市道機能及び市民の日常生活の回復を図る"@ja.
<< kg:id_64 prop:effect kg:id_66 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "市道機能及び市民の日常生活の回復を図る"@ja.
<< kg:id_64 prop:effect kg:id_67 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "居住地の生活環境の保全及び公衆衛生の確保を図る"@ja.
<< kg:id_64 prop:effect kg:id_68 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "居住地の生活環境の保全及び公衆衛生の確保を図る"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_59;
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_60;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "中止を申し入れた理由は、当該事業地がラムサール条約登録湿地の近傍であり"@ja.
<< kg:id_69 prop:cause kg:id_71 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_62;
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_63;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "クマタカなどの生息や営巣、渡り鳥の生息への影響が強く懸念されること"@ja.
<< kg:id_69 prop:cause kg:id_72 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "一定の距離に複数の風力発電事業が集中した場合の累積的な影響が懸念されること"@ja.
<< kg:id_69 prop:cause kg:id_73 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_66;
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_67;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "重要な自然環境や多様な生態系が保存されている区域については、予防的な観点から事前に判断することが必要と考えたこと"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "風力発電が地域にもたらすプラスの効果などを含めて検討してきた"@ja.
<< kg:id_69 prop:effect kg:id_76 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_70;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "この中止申入れはそうした地域住民の夢を打ち砕くものであり、地域住民の声を反映したものとは到底思えない"@ja.
<< kg:id_74 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_73;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_74;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "どこに風車を建設すればラムサール条約に影響を与えないか調査をしっかりしてほしいと考えており、調査の結果、事業の実施が困難であれば諦めざるを得ない"@ja.
<< kg:id_74 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_76;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "鶴岡市に対し、令和５年２月１日に市が行ったＪＲＥ社への風力発電事業中止の申入れを撤回するとともに、ＪＲＥ社による調査の継続を認めることを求める"@ja.
<< kg:id_74 prop:effect kg:id_79 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_78;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "鶴岡八森山風力発電事業を例にすれば、林道整備の促進のほか"@ja.
<< kg:id_74 prop:effect kg:id_80 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "地元住民の雇用"@ja.
<< kg:id_74 prop:effect kg:id_81 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_81;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "風力発電事業で使用する土地の所有者に対する賃料"@ja.
<< kg:id_74 prop:effect kg:id_82 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "ＪＲＥ社による地域振興事業への参加や再生可能エネルギーに関する授業の実施など、事業者によるソフト面でのフォローもある"@ja.
<< kg:id_74 prop:effect kg:id_83 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "環境影響評価法の手続に入ったとしても事業の中止を求められないものではないと考えている"@ja.
<< kg:id_74 prop:effect kg:id_84 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_85;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "風車の建設は日本遺産の景観に影響を与えると思っている住民はほとんどいないと思われます"@ja.
<< kg:id_74 prop:effect kg:id_85 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_87;
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_88;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "大山上池・下池付近が渡り鳥の経路になっていることが指摘されており、加茂への風車建設によって、そのような環境に重大な影響が懸念される"@ja.
<< kg:id_74 prop:effect kg:id_86 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_90;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "住民からＪＲＥ社に対する電磁波や低周波に関する質問があり、ＪＲＥ社は懸念されることについてはしっかりと調査をして明らかにしていくと回答"@ja.
<< kg:id_69 prop:effect kg:id_87 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_92;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "一方的な説明であり、地域との対話という点では不足していた...地元との丁寧なコミュニケーションという点では意思疎通が十分ではなかった"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_94;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "地域の過疎化、高齢化が深刻であること"@ja.
<< kg:id_88 prop:cause kg:id_90 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_96;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_97;
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "森林や山地の管理、維持に苦労されている"@ja.
<< kg:id_91 prop:effect kg:id_92 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "このまま何か手を打たないと地域が消滅に向かっていくのではないかという危惧があります"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "現在の育林サポーターの平均が70歳近くとなっていることなどを考えると、今後この山の整備を持続的に行っていけるのか不安があります"@ja.
<< kg:id_93 prop:cause kg:id_95 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "目的地に行くまでの林道整備が十分になされていないこと"@ja.
<< kg:id_96 prop:effect kg:id_97 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "加茂町内振興会の土地の一部を賃貸し、賃料が入れば、人口が減り行く中で町内振興会を支える財源ともなるし、現在町民から徴収している会費も不要になるのではないか"@ja.
<< kg:id_96 prop:effect kg:id_98 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "森林整備をする際、またいずれ伐採、搬出し、木材として活用する際にも林道は必須となります。それも風力発電事業の中で整備可能ではないかと希望を抱いていました"@ja.
<< kg:id_96 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "検討してきたのが三瀬地区で先行していた風力発電整備による林業振興でした"@ja.
<< kg:id_74 prop:effect kg:id_100 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "風力発電がもたらす短期的な経済的メリットに依拠するのではなく、ＳＤＧｓ未来都市の理念に基づく持続可能で国内外から評価される観光資源を生かしたモデル地域として、地域の活性化を図るべき"@ja.
<< kg:id_101 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "加茂水族館、北前船の船主集落の町並み、そして先日オープンしたばかりの渚の交番カモンマーレというほかの自治体にはない３つの貴重な観光資源を有効に活用しながらまちの活性化を図るべき"@ja.
<< kg:id_88 prop:cause kg:id_103 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "少子高齢化が進む中で、地域の存続を真剣に模索する中で"@ja.
<< kg:id_93 prop:cause kg:id_104 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "市から移管された加茂山の管理が困難となり、このままでは山は荒れ、地域に住む人がいなくなってしまうとの危機感から"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "このままでは山は荒れ、地域に住む人がいなくなってしまうとの危機感"@ja.
<< kg:id_69 prop:effect kg:id_107 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "これまでこの事業に地域存続への可能性を見いだしていた地域住民の理解や納得が得られないのは当然"@ja.
<< kg:id_69 prop:effect kg:id_108 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "皆川市政らしくない、誠に強権的で乱暴なやり方であると批判されるのも当然"@ja.
<< kg:id_109 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "市としても今後の里山の管理、保全のための方策を一緒に考え、支援の必要性を国や県へ強く要望すべき"@ja.
<< kg:id_109 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "緑環境税や活用できる補助金など、支援策を一緒に模索すべき"@ja.
<< kg:id_112 prop:effect kg:id_113 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "地域の未来を一企業に託すべきではないし、風力発電建設と地域振興は別の問題"@ja.
<< kg:id_74 prop:effect kg:id_114 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "自然破壊や景観破壊への危惧"@ja.
<< kg:id_74 prop:effect kg:id_115 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "住宅地と隣接し、市の風力発電施設の建設に関するガイドライン、600メートル以上離れていることに抵触している"@ja.
<< kg:id_74 prop:effect kg:id_116 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_117;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "ここに風力発電が行われれば重大な影響を与えるおそれがあり、池や周辺の自然資源の価値を著しく損なうことになる"@ja.
<< kg:id_117 prop:effect kg:id_118 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "風力発電施設は近年大型化が進み、景観に与える影響が大きい"@ja.
<< kg:id_119 prop:effect kg:id_120 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "生態系を含め自然環境を破壊したり、土砂災害や健康被害などが懸念される電源開発は本末転倒"@ja.
<< kg:id_121 prop:effect kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "加茂地区住民数、４月１日現在881名のうち、請願に賛成する署名393筆、率としては44.6％...加茂住民の半数も満たしていない"@ja.
<< kg:id_123 prop:effect kg:id_124 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "加茂から三瀬の尾根伝いとその周辺全体は、秋田の大潟村から新潟の福島潟や佐潟に飛ぶガン・カモ、コハクチョウの渡りルート"@ja.
<< kg:id_123 prop:effect kg:id_125 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "予定どおりに風力発電が建設された場合、上池・下池を飛び立ったハクチョウ類が...風力発電への衝突やそれを回避するための体力の消耗への影響が風力発電建設後は継続的に起きることになり"@ja.
<< kg:id_123 prop:effect kg:id_126 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "その結果、上池・下池への渡来数が減少し、ラムサール条約湿地としての基準を満たさなくなる可能性もある"@ja.
<< kg:id_127 prop:effect kg:id_128 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_125;
    prop:text-txt_contents "これを許すと全国、世界のラムサール登録湿地のあしき先例になってしまうので、世界的な視点でも絶対に阻止しなければならない"@ja.
<< kg:id_129 prop:effect kg:id_130 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "事業の進行に費用をかけるほど事業者は事業の根本的な見直しや撤退を行うことはほとんどなくなる"@ja.
<< kg:id_127 prop:effect kg:id_131 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_127;
    prop:text-txt_contents "加茂の風車計画では39名の不眠症リスク"@ja.
<< kg:id_127 prop:effect kg:id_132 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "入眠妨害1,680名というリスク"@ja.
<< kg:id_127 prop:effect kg:id_133 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_129;
    prop:text-txt_contents "尾根を開発すると、こうした地盤の安定や保水能力、水涵養機能が消失する。要は第２、第３の昨年末の西目の土砂災害のようなことを将来的に誘引するリスク"@ja.
<< kg:id_134 prop:cause kg:id_135 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_130;
    prop:text-txt_contents "その時点では住民自治会などの合意形成が行われていなかったことが分かったことから、市は受理しなかった"@ja.
<< kg:id_134 prop:effect kg:id_136 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "ＪＲＥは社の都合で受理を６月にしてほしいなどとガイドラインに反する要求をしてきた。市は、それには応じられないと拒否した"@ja.
<< kg:id_137 prop:effect kg:id_138 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_132;
    prop:text-txt_contents "現在行っている月２回の頻度の調査では、バードストライクの調査としては成り立たない"@ja.
<< kg:id_139 prop:effect kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "事業者が立地地域の自治会に直接補助金を納入し、住民自治に介入するようなやり方はやめていただくべき"@ja.
<< kg:id_141 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_134;
    prop:text-txt_contents "ラムサール湿地から５キロ圏内を早期にバッファゾーンとしてガイドライン上の保護地区にしていただきたい"@ja.
}
