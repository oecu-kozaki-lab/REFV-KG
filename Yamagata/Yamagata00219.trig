kg:st_1 rdfs:label "佐藤博幸議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "人口減少対策に危機感を持って取り組む必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "効果的な対策を講じなければ悪影響がますます顕在化すると懸念"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "人口減少に歯止めをかけるのは困難だが減少幅を緩やかにすべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "過去の経験や勘ではなく効果的な対策を選択と集中で進めるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "若者の働く場の確保を強化すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "若者"@ja.
kg:st_2 rdf:type cls:st_155.
cls:st_155 rdfs:label "若者"@ja.
kg:op_6 prop:content "市内に定住するために働く場や住まいが重要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "雇用の不安定さや低所得では将来設計が困難になる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "市行政だけでなく様々な主体と連携して進めるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "企業や関係団体が主体的に取り組む必要がある"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "市民やコミュニティ組織と連携して行政サービス維持を図るべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "人口減少を前提とした地域社会の在り方を市民と検討すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "従来の制度や施策を見直し人口減少前提で構築すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:st_3 rdfs:label "企画部長"@ja.
kg:st_3 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_13 prop:content "総合計画後期基本計画の最重点として注力する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "子育て推進課移転とこども家庭センター集約で支援体制を強化する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "対話と協働で市民目線の政策推進を図る"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "働きやすい就業制度の整備が重要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "市役所や企業が率先して取り組み若者定着につなげるべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:st_4 rdfs:label "地域住民"@ja.
kg:st_4 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_18 prop:content "地域の拠点として施設の有効活用と再開を望む"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "まちづくり公共交通医療福祉など各分野を一体的に見直す"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "大変厳しい状況と受け止めている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "従来のような幅広いサービス提供は難しくなる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "住民同士が課題を共有し自ら考え解決する方策を行政が示す必要がある"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "将来を見据え共通理解を持ってしっかり取り組む"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "人口減少対策は全市を挙げて取り組むべき課題"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "様々な施策を動員し全市を挙げて取り組む必要がある"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "食文化を生かして若者の働く場づくりを進めるべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "食材の価値向上や食に関わる就業増加につなげたい"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:st_5 rdfs:label "総務部長"@ja.
kg:st_5 rdf:type cls:st_18.
kg:op_28 prop:content "投資事業の平準化や有利な財源活用で負担抑制を図る"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "合併特例期間終了後の財政運営として想定してきたもの"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "スクラップアンドビルドや歳入確保に取り組んだが目標達成に至っていない"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "税収は総じて縮小していくと見ている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:op_32 prop:content "庁内横断的に多方面から検討や対応が必要"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:st_6 rdfs:label "農林水産部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_33 prop:content "中山間地域では担い手不足が課題になっている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "どうしても管理できない農地は山に戻すことも話し合われている"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "話し合っていくこと自体が大事"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "交付金は必要不可欠で十分な予算措置を国に働きかける"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:op_37 prop:content "地域で安心して働き暮らすため日本語習得が重要"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "多くの外国人に教室を知ってもらう周知が必要"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "ボランティアの確保と育成が課題"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "学校生活支援が中心で日本語指導は家庭や国際村講座も活用して学んでもらう"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "きめ細やかな言語対応による生活支援が必要"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "日本人と外国人双方の円滑なコミュニケーションが必要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:st_7 rdfs:label "商工観光部長"@ja.
kg:st_7 rdf:type cls:st_18.
kg:op_43 prop:content "現時点で要望はないが今後需要がある場合は活用を検討する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_7.
kg:op_44 prop:content "優秀な外国人材の獲得につながることが期待できる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_7.
kg:op_45 prop:content "出羽庄内国際村の生活相談支援充実につながる"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "今後の動向を見定め必要性に応じて検討する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_5.
kg:st_8 rdfs:label "健康福祉部長"@ja.
kg:st_8 rdf:type cls:st_18.
kg:op_47 prop:content "ニーズに対しては対応できる状況"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_8.
kg:st_9 rdfs:label "遠藤初子議員"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_48 prop:content "LINEやメールなら時間を問わず気軽に相談できる"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_9.
kg:op_49 prop:content "他市事例を参考に導入を検討したい"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_8.
kg:op_50 prop:content "利用者が探しやすいよう改善工夫を図る"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_8.
kg:op_51 prop:content "利用しづらいとの指摘を受けている"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_8.
kg:op_52 prop:content "認定登録は市民の再認識や継承意欲向上に寄与している"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "本市の食育の取組が全国に認められた"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "本市の食文化の魅力発信に大きな役割を果たしている"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "食文化継承と後継者育成を見据え継続したい"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "以前のような訪問型事業の再開は費用面から難しい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:op_57 prop:content "今後の対応について検討したい"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_3.
kg:st_10 rdfs:label "市長"@ja.
kg:st_10 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_58 prop:content "伝統的な食材や加工品を守ることは重要で勉強していきたい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_10.
kg:st_11 rdfs:label "工藤博議員"@ja.
kg:st_11 rdf:type cls:st_16.
kg:op_59 prop:content "地域全体の公平性を踏まえて総合的に対処すべき"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_11.
kg:op_60 prop:content "遊具整備の公平性をどう図るかが課題"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_11.
kg:st_12 rdfs:label "建設部長"@ja.
kg:st_12 rdf:type cls:st_18.
kg:op_61 prop:content "多くの子供が利用する公園へ重点配置する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_12.
kg:op_62 prop:content "健康福祉部を中心に他部局と連携し総合的に方針策定を進める必要がある"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_8.
kg:op_63 prop:content "緊急修繕箇所の増加で十分に対応できていない"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_12.
kg:op_64 prop:content "市の実情に合った補助制度等を研究したい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_12.
kg:op_65 prop:content "優先順位に基づき予算措置案件を限らざるを得ない"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本市の直近３年間の人口移動の状況を見てみますと、自然動態、社会動態合わせまして、令和３年度はマイナス1,565人、令和４年度はマイナス1,781人、令和５年度はマイナス1,766人となっておりました"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今後効果的な対策を講じなければ、市内経済や地域社会への悪影響がますます顕在してくると考えております"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "人口減少に歯止めをかけるのは困難な課題ですが、今後の減少幅を緩やかにしていくために、危機感を持って取り組む必要がある"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今後の人口減少対策の実施に当たっては、過去の経験や勘、延長線で考えるのではなく、課題解決に向けた効果的な対策を選択と集中により実行していくことが重要である"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "本市において、進学、就職のタイミングでの県外転出が多いことが課題であります"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "若者への調査においても、市内に定住するために働く場や住まいが重要であるとの声がある"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "結婚や子育てをしていく上で雇用が不安定であったり、所得が低かったりする状況では、将来設計が困難になります"@ja.
<< kg:id_5 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "人口減少対策は、市行政だけで進めることができるものではないことから、市内の様々な主体とも連携して、効果的な対策を推進していかなければなりません"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "育児休業の取得促進や仕事と家庭の両立などに向けた取組は、企業や関係団体などに主体的に取り組んでいただく必要があります"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "人口減少が続く中でも、地域に住む人々が変わらずに、元気に生き生きと暮らせるようにするために取り組む必要があります。市民・コミュニティ組織の力をお借りして、今後は現在の行政サービスが維持できるようにしなければならない"@ja.
<< kg:id_18 prop:cause kg:id_1 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "人口減少は地域社会の消滅につながります"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "これまでの右肩上がりの人口増加を前提とした様々な制度や仕組みは、従来の考え方や施策を見直し、危機感を共有して、人口が継続して減少するという前提に立って、構築していく必要がある"@ja.
<< kg:id_5 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "若者・子育て世代から選ばれるまちづくり、これを同アクションの１番目に掲げており、特に注力して進めてまいります"@ja.
<< kg:id_5 prop:countermeasure kg:id_22 >>
    prop:text-txt_contents "結婚に係る取組として、出会いの場となる婚活イベントの開催"@ja.
<< kg:id_5 prop:countermeasure kg:id_23 >>
    prop:text-txt_contents "つるおか婚シェルジュによる伴走型の婚活支援"@ja.
<< kg:id_5 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "７月からは子育て推進課をにこふるの２階に移転しまして、健康課や、この４月に開設しましたこども家庭センターのサービスを集約することで母子保健と児童福祉の一体的支援体制の強化、これを図ってまいります"@ja.
<< kg:id_5 prop:countermeasure kg:id_25 >>
    prop:text-txt_contents "妊娠を希望する夫婦に対しましては、体外受精など保険適用となる不妊治療について、自己負担額の一部を支援する"@ja.
<< kg:id_5 prop:countermeasure kg:id_26 >>
    prop:text-txt_contents "18歳までの医療費無償化"@ja.
<< kg:id_5 prop:countermeasure kg:id_27 >>
    prop:text-txt_contents "学校給食費の無償化に本格的に取り組み、子育て世代の負担軽減を図っている"@ja.
<< kg:id_5 prop:countermeasure kg:id_28 >>
    prop:text-txt_contents "令和６年度から新たにこども会議、これを開催し、子供・若者の意見やアイデアを市政で実現する取組を行い、子供・若者の意見表明の機会と社会参画を推進します"@ja.
<< kg:id_5 prop:countermeasure kg:id_29 >>
    prop:text-txt_contents "放課後の子供の生活や遊び場となる放課後児童クラブの整備に取り組み、子育てしやすい環境を整えてまいります"@ja.
<< kg:id_30 prop:countermeasure kg:id_31 >>
    prop:text-txt_contents "企業が行う生産性向上や新分野開拓等の取組に対し支援を行ってきました"@ja.
<< kg:id_30 prop:countermeasure kg:id_32 >>
    prop:text-txt_contents "慶應先端研の研究成果を核としたバイオ産業の集積や高等教育機関と地元企業の連携などにより、企業の事業拡大や高度化を促してまいりました"@ja.
<< kg:id_30 prop:countermeasure kg:id_33 >>
    prop:text-txt_contents "鶴岡西工業団地の隣接地に約15ヘクタールの新産業団地の整備を進めております"@ja.
<< kg:id_30 prop:countermeasure kg:id_34 >>
    prop:text-txt_contents "幅広い年代の起業意欲を高め、事業化を支援するため、鶴岡イノベーションプログラムを開催しており、こうした取組を通じて働く場の創出や地元回帰の促進を図ってまいりたい"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "計画の推進方針に対話と協働による政策の推進を掲げており、その推進に当たっては、市民・ＮＰＯ・企業など様々な主体との協働を図りながら、対話の重視と市民目線の姿勢を持って進めていく"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "若者世帯が妊娠・出産・子育てを行うため、フレックスタイム制度の導入や男性の育児休業取得制度の設置など、仕事と家庭生活の両立、いわゆるワーク・ライフ・バランスの充実に取り組む企業が増え、若者や子育て世代に対し、働きやすい職場環境が整備されること、これが重要である"@ja.
<< kg:id_5 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "市といたしましても、従業員が働きやすい就業制度の整備を行う企業が増えるよう、今後とも普及啓発に努めてまいりたい"@ja.
<< kg:id_5 prop:countermeasure kg:id_40 >>
    prop:text-txt_contents "このワーク・ライフ・バランスの充実に取り組む企業を県が認定する「やまがたスマイル企業認定制度」につきまして、市内企業に周知と普及を図っている"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:text-txt_contents "市民・地域と行政が協働で取り組んでいる事業としまして、地域住民と連携を図りながら、地域資源を生かし、課題解決に取り組む、地域まちづくり未来事業があります"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "再開に至るまで地域住民から地域の拠点として施設の有効活用と再開を望む意見がありました"@ja.
<< kg:id_43 prop:countermeasure kg:id_45 >>
    prop:text-txt_contents "民間の事業者からも聞き取りをする対話型の市場調査なども実施し、検討が進められたものです。その後、３か月間の試験営業が行われた後に公募の手続を経て、朝日地域の住民が立ち上げたＮＰＯ法人が運営主体となった"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:text-txt_contents "地域のにぎわい創出を図っていくため、地域住民とのワークショップが開催されておりまして、ここで出されたアイデアが取組の根幹になっている"@ja.
<< kg:id_19 prop:countermeasure kg:id_48 >>
    prop:text-txt_contents "今年３月には国の方針に基づき、これまでの総合戦略に新たにデジタルの要素を取り入れた鶴岡市デジタル田園都市構想総合戦略を策定しております"@ja.
<< kg:id_19 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "まちづくりや公共交通、医療や健康福祉など、各分野の施策も一体的に進めていく必要があることから、評価や検証の作業を踏まえ、人口減少社会に対応した適切な見直しを図ってまいります"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:text-txt_contents "2050年の庄内地域の人口は約16万人とされ、令和２年と比べ約10万人減少するとされております"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "本市においても、2050年には８万人を切るとされており、大変厳しい状況と受け止めている"@ja.
<< kg:id_54 prop:effect kg:id_55 >>
    prop:text-txt_contents "人口減少や少子高齢化の急速な進展により、地域社会がこれまで経験したことのない厳しい情勢になると認識しており、求められる行政サービスも大きく変化するものと考えております"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:text-txt_contents "新たな行政サービスの必要性や公共施設の維持、更新需要の高まり"@ja.
<< kg:id_56 prop:cause kg:id_58 >>
    prop:text-txt_contents "地震や気候変動に起因する災害への備え"@ja.
<< kg:id_56 prop:cause kg:id_59 >>
    prop:text-txt_contents "人口減少による収入の減少などにより"@ja.
<< kg:id_60 prop:effect kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "限りある財源の下で従来のような幅広いサービス提供は難しくなると考えられます"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:text-txt_contents "そのため市においては、事務事業の見直しや改善、効果的な施策の立案を不断の努力で取り組まなければならない"@ja.
<< kg:id_62 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "地域課題を住民同士が共有し、自ら考え、行政や様々な主体との連携・協働により住民主体で解決していく方策も行政の責任として示していく必要がある"@ja.
<< kg:id_5 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "市民や地域、企業など幅広い方々と共通理解を持ち、対話と協働によりしっかりと取り組んでまいりたい"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "2023年の合計特殊出生率が過去最低の1.20を記録しました"@ja.
<< kg:id_68 prop:effect kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "地方創生による東京一極集中に歯止めをかけようとした施策だったのですが、今の現状を見ますと、かけられなかったと言えるのではないか"@ja.
<< kg:id_70 prop:countermeasure kg:id_71 >>
    prop:text-txt_contents "食文化を生かした交流人口の拡大"@ja.
<< kg:id_70 prop:countermeasure kg:id_72 >>
    prop:text-txt_contents "３番には、食文化による地域づくりということで掲げられております"@ja.
<< kg:id_30 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "若者の働く場として食産業、食の製造産業だとか加工、こういった分野の若者の働く場づくりも私はあってもいいのでないかな"@ja.
<< kg:id_70 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "食文化の大本を考えますと１次産業的な食の大本の農林水産業、こういったところから始まるものと考えておりますので、そこの充実、ひいてはそこの就業が増えるというところから始まりまして、またただいま申し上げました食に関する料理人が働く場が増えるというところにつなげていけるような体系になればいい"@ja.
<< kg:id_75 prop:effect kg:id_76 >>
    prop:text-txt_contents "令和５年度末時点での未償還残高は約172億3,000万円となっております"@ja.
<< kg:id_75 prop:effect kg:id_77 >>
    prop:text-txt_contents "未償還残高約172億3,000万円の30％、約51億7,000万円が市の実質的な負担となっている"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "投資事業の財源となる市債の借入れが大幅に増大しますと公債費の増加要因となってまいります"@ja.
<< kg:id_78 prop:countermeasure kg:id_80 >>
    prop:text-txt_contents "将来を見据えました施設の集約化・複合化の検討でありますとか、投資的経費の年度間の平準化、さらには国・県の補助事業や有利な起債の活用など、財源確保に努めながら、将来の公債費の負担の抑制"@ja.
<< kg:id_81 prop:effect kg:id_82 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "基金総額が減少傾向で推移することにつきましては、さきに申し上げましたとおり合併特例期間終了後の財政運営として想定してきたものでございます"@ja.
<< kg:id_83 prop:countermeasure kg:id_84 >>
    prop:text-txt_contents "財源不足額は財政調整基金及び減債基金の取崩しにより補填することとなります"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "賃金上昇や物価高の影響による物件費の増要因"@ja.
<< kg:id_85 prop:cause kg:id_87 >>
    prop:text-txt_contents "ＤＸ化による事務事業の改善にはシステム導入などの初期費用がかかることなどもありまして、目標達成には至っていない"@ja.
<< kg:id_85 prop:countermeasure kg:id_88 >>
    prop:text-txt_contents "行政評価の仕組みの中で各部署における事務事業の見直しやスクラップ・アンド・ビルドを推進してまいります"@ja.
<< kg:id_89 prop:effect kg:id_90 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本市の主要な財源であります市税の減少がまず想定されます。総じて税については縮小していくだろうと見ております"@ja.
<< kg:id_89 prop:effect kg:id_91 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "人口が減少しても、公共施設やインフラの維持でありますとか、コミュニティの関連の経費など、直ちに削減が困難な経費も多くあります"@ja.
<< kg:id_92 prop:countermeasure kg:id_93 >>
    prop:text-txt_contents "190の人・農地プランがありましたが、地域計画ではこれを地域の実情に合わせて見直しまして、おおよそ70地区に統合する方向で協議の場を設定しております"@ja.
<< kg:id_94 prop:cause kg:id_95 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "やはり中山間地域での担い手不足、そういったところが課題になっております"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "どうしても管理できない農地については山に戻す"@ja.
<< kg:id_94 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "７年３月に計画をつくった後も引き続き話合いを進めて、この先の地域農業をどうしていくかというのを話し合っていくこと自体が大事"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:text-txt_contents "これはコロナ禍による米価の下落"@ja.
<< kg:id_99 prop:cause kg:id_101 >>
    prop:text-txt_contents "労働力不足による園芸作物の作付面積の減少"@ja.
<< kg:id_99 prop:cause kg:id_102 >>
    prop:text-txt_contents "果樹の霜・ひょう被害などを要因とするもの"@ja.
<< kg:id_99 prop:effect kg:id_103 >>
    prop:text-txt_contents "目標値を60億円下方修正し、340億円としております"@ja.
<< kg:id_99 prop:countermeasure kg:id_104 >>
    prop:text-txt_contents "ＳＥＡＤＳを核にした新規就農者の育成・定着の強化"@ja.
<< kg:id_99 prop:countermeasure kg:id_105 >>
    prop:text-txt_contents "地域計画策定による農地の集積・集約"@ja.
<< kg:id_99 prop:countermeasure kg:id_106 >>
    prop:text-txt_contents "園芸作物をはじめとする高収益作物の産地形成などに取り組んでまいりたい"@ja.
<< kg:id_107 prop:cause kg:id_108 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "この交付金は需要に応じた米生産を円滑に進める上で必要不可欠な支援である"@ja.
<< kg:id_107 prop:countermeasure kg:id_109 >>
    prop:text-txt_contents "十分な予算措置を行うよう国に働きかけているところでございます"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:text-txt_contents "産地交付金に頼らない産地づくりを推進する視点も重要となることから、引き続き園芸作物の収益性の向上に向けたパイプハウスや機械導入への支援を推進"@ja.
<< kg:id_112 prop:countermeasure kg:id_113 >>
    prop:text-txt_contents "期間限定で高い水準の助成を行う畑地化促進事業を講じている"@ja.
<< kg:id_114 prop:cause kg:id_115 >>
    prop:text-txt_contents "コロナ禍の収束に伴いまして、技能実習生や留学生などの外国人住民は増加を続けており"@ja.
<< kg:id_114 prop:cause kg:id_116 >>
    prop:text-txt_contents "技能実習制度の見直しなど国の外国人就労制度の改正により、今後もさらに増加していくものと見込まれます"@ja.
<< kg:id_117 prop:countermeasure kg:id_118 >>
    prop:text-txt_contents "令和６年２月に鶴岡市国際化推進プランを策定しました"@ja.
<< kg:id_117 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "外国人に分かりやすく情報を伝えることができるやさしい日本語の普及と日本語教育の充実に努める"@ja.
<< kg:id_117 prop:countermeasure kg:id_120 >>
    prop:text-txt_contents "出羽庄内国際村日本語教室を開設してきました"@ja.
<< kg:id_121 prop:effect kg:id_122 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "出羽庄内国際村の日本語教室を知らない外国人が45％いることが分かりました"@ja.
<< kg:id_121 prop:countermeasure kg:id_123 >>
    prop:text-txt_contents "多くの外国人住民に出羽庄内国際村を知っていただき、日本語を学ぶ機会を得て、この地域で安心して働き暮らせるよう、今後周知等に努めてまいりたい"@ja.
<< kg:id_124 prop:cause kg:id_125 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "受講者の増加によります日本語指導ボランティアの確保と人材育成も課題"@ja.
<< kg:id_124 prop:countermeasure kg:id_126 >>
    prop:text-txt_contents "近隣市町村や事業所等との連携を強めながら、新たなボランティアの確保に向けた取組を進めてまいりたい"@ja.
<< kg:id_127 prop:countermeasure kg:id_128 >>
    prop:text-txt_contents "教育委員会では外国人子女支援員を配置しており、日本語が話せない児童・生徒が就学している学校に派遣し、学校生活に慣れるまでマンツーマンで支援をしております"@ja.
<< kg:id_129 prop:cause kg:id_130 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "この外国人子女支援員は学校での生活支援の役割が中心でございまして、日本語指導は業務内容に入っておりません"@ja.
<< kg:id_131 prop:countermeasure kg:id_132 >>
    prop:text-txt_contents "出羽庄内国際村では生活に関する通訳・翻訳業務としまして、登録ボランティア等を無料で派遣するコミュニティ通訳事業を実施しております"@ja.
<< kg:id_131 prop:cause kg:id_133 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "現在本市に42か国の国籍の方が暮らしており、多様な言語が必要とされていることから、現在はスマートフォンの翻訳機能などを活用して対応している現状"@ja.
<< kg:id_131 prop:countermeasure kg:id_134 >>
    prop:text-txt_contents "登録ボランティアの確保に向けた取組を強化するとともに、大学や事業所等との連携を強化しまして、それぞれが協力して通訳支援ができる体制づくりに取り組んでまいりたい"@ja.
<< kg:id_135 prop:cause kg:id_136 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "増加傾向にある外国人居住者と地域住民が共に安心して暮らしていくために、地域での多文化共生の理解と意識の醸成が重要"@ja.
<< kg:id_135 prop:countermeasure kg:id_137 >>
    prop:text-txt_contents "地域の皆さんからもやさしい日本語に触れていただく研修の機会等を設けるなど、多文化共生の理解促進と意識の醸成に努めてまいりたい"@ja.
<< kg:id_138 prop:countermeasure kg:id_139 >>
    prop:text-txt_contents "市内の受入れ企業でも、空き家を活用して住居を提供している例がございます"@ja.
<< kg:id_138 prop:countermeasure kg:id_140 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "今後需要がある場合には活用を検討してまいります"@ja.
<< kg:id_141 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "海外の学生のインターンシップは優秀な外国人材の獲得につながることが期待できる"@ja.
<< kg:id_143 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "出羽庄内国際村の職員に対しまして、資格取得について働きかけを行ってまいりたい"@ja.
<< kg:id_145 prop:countermeasure kg:id_146 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "相談機能の拡充や庁内における専門部署の設置なども必要になることも十分考えられますので、今後の動向を見定めながら、必要性に応じた検討をしてまいりたい"@ja.
<< kg:id_147 prop:countermeasure kg:id_148 >>
    prop:text-txt_contents "妊婦全員に保健師が面談を行い、心配なことや相談したいことなどの聞き取りをいたしまして、状況に応じて継続した電話や面談の相談対応を行っております"@ja.
<< kg:id_147 prop:countermeasure kg:id_149 >>
    prop:text-txt_contents "妊娠７か月頃には妊婦全員に出産や産後の子育ての不安に関するアンケートを実施しておりまして、希望される方には電話や面談などの相談に応じる"@ja.
<< kg:id_150 prop:countermeasure kg:id_151 >>
    prop:text-txt_contents "出産に対する不安がある方でございますけれども、陣痛から出産に至るまでの過ごし方や沐浴や授乳、育児の具体的なイメージができるように、プレママ教室への参加を促したり"@ja.
<< kg:id_152 prop:countermeasure kg:id_153 >>
    prop:text-txt_contents "全産婦・乳児に保健師が戸別訪問を行っておりまして、育児の不安や相談の対応を行っております"@ja.
<< kg:id_152 prop:countermeasure kg:id_154 >>
    prop:text-txt_contents "産後の不安や負担を軽減し、心身の休息を図るために、助産院や病院での産後母子ケア事業を実施している"@ja.
<< kg:id_155 prop:countermeasure kg:id_156 >>
    prop:text-txt_contents "母子モの認知度を高めるために母子健康手帳の交付の際に利用の説明を行ったりしております。また、保健所、認定こども園、子育て支援センターなどでチラシを配布していただいたりなど周知に努めている"@ja.
<< kg:id_155 prop:effect kg:id_157 >>
    prop:text-txt_contents "令和４年５月末時点で登録者1,355人でございましたが、令和６年５月末時点で2,419人と増加"@ja.
<< kg:id_158 prop:countermeasure kg:id_159 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "現在本市で17か所の施設で、１施設当たり１から10名程度の受入れができるようにしております。そのためニーズに対しては対応できるというふうな状況"@ja.
<< kg:id_160 prop:cause kg:id_161 >>
    prop:text-txt_contents "感染症の流行期など申込みが集中して予約が取りづらくなる"@ja.
<< kg:id_160 prop:countermeasure kg:id_162 >>
    prop:text-txt_contents "可能な限り受け入れられるよう、受入れ時間帯を調整したり"@ja.
<< kg:id_160 prop:countermeasure kg:id_163 >>
    prop:text-txt_contents "庄内南部定住自立圏の協定により相互利用を可能としております三川町や庄内町の病児保育施設を御案内したりなどをして対応"@ja.
<< kg:id_164 prop:cause kg:id_165 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "電話だと相談できる時間が限られてしまい、仕事をしているとなかなか相談できない。また、電話での相談は勇気が必要"@ja.
<< kg:id_164 prop:countermeasure kg:id_166 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "ＬＩＮＥ・メールによる相談は時間を問わず気軽に相談できるという利点がございますので、他市の事例などを参考にしながら、ＬＩＮＥ等による相談の導入につきましては、今後検討してまいりたい"@ja.
<< kg:id_167 prop:countermeasure kg:id_168 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "市のホームページ、母子モの妊娠・子育て情報内に掲載をしておりますけれども、なお利用される方が探しやすいように、見つけやすいような改善・工夫を図っていきたい"@ja.
<< kg:id_169 prop:cause kg:id_170 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "利用に当たっては、まず市に対して事前登録をしていただいて、利用の際は施設に電話で仮予約、その後にかかりつけ医を受診して本予約をするという、今こういう手続が非常に煩雑で利用しづらいという御指摘をいただいております"@ja.
<< kg:id_169 prop:countermeasure kg:id_171 >>
    prop:text-txt_contents "病児保育利用に当たっての登録や予約をオンラインで行えるシステムの導入を今年10月に予定"@ja.
<< kg:id_172 prop:effect kg:id_173 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "100年フードの認定や国の登録無形民俗文化財登録は、マスコミにも大きく取り上げられ、市民が食文化の価値を改めて認識するとともに、関係者の誇りや継承への意欲向上にも寄与している"@ja.
<< kg:id_172 prop:effect kg:id_174 >>
    prop:text-txt_contents "登録以降、市内の産直施設等での販売が増加している"@ja.
<< kg:id_172 prop:effect kg:id_175 >>
    prop:text-txt_contents "笹巻のブランド力の向上につながっている"@ja.
<< kg:id_176 prop:effect kg:id_177 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "農林水産省主催の第８回食育活動表彰で農林水産大臣賞を受賞しましたことは大変喜ばしいことでございまして、本市で行われている食育の取組が全国に認められたもの"@ja.
<< kg:id_178 prop:countermeasure kg:id_179 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "鶴岡ふうどガイドの取組につきましては、本市を訪れる方々に食文化の魅力を紹介し、学びや体験の場を提供できるガイドとして2014年から活動されている団体"@ja.
<< kg:id_180 prop:countermeasure kg:id_181 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "昨年度から、葉の収穫から笹巻が完成するまでの一連の工程を学ぶ講座を実施しております"@ja.
<< kg:id_180 prop:countermeasure kg:id_182 >>
    prop:text-txt_contents "受講生からは、継続した講座開催の要望をいただいているところでございまして、市といたしましても、食文化の継承、後継者の育成を見据え、こうした取組を継続してまいりたい"@ja.
<< kg:id_176 prop:countermeasure kg:id_183 >>
    prop:text-txt_contents "今年度は、朝暘第四小学校や朝暘第五小学校と連携しまして年間を通じた食育事業に取り組む予定"@ja.
<< kg:id_176 prop:countermeasure kg:id_184 >>
    prop:text-txt_contents "地域の在来作物の生産や収穫を行うほか、生産者や鶴岡ふうどガイドによる講座などを組み合わせまして、食育に加え、食文化を学ぶ取組を今後進めてまいりたい"@ja.
<< kg:id_185 prop:cause kg:id_186 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "コロナ禍で中断したこともありまして、同様の事業実施の再開にはまだ至っていない状況でございます"@ja.
<< kg:id_185 prop:countermeasure kg:id_187 >>
    prop:text-txt_contents "今後はオンラインでの食文化研修など新たな連携や交流の可能性について探ってまいりたい"@ja.
<< kg:id_188 prop:countermeasure kg:id_189 >>
    prop:text-txt_contents "引き続き掘り起こした食文化体験プログラム、これを観光コンテンツとして活用しまして、ガストロミーツーリズムの推進につなげてまいりたい"@ja.
<< kg:id_190 prop:countermeasure kg:id_191 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "連携内容や協定の効果などをお聞きしながら、本市の今後の対応などについて検討してまいりたい"@ja.
<< kg:id_192 prop:countermeasure kg:id_193 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "こうした伝統的な食材ですとか、加工品など、こうしたことを守っていくということは大変重要でありますし、それを通じて自然環境ですとか、遺伝資源とか、そうしたことへの保全にもつながってくる"@ja.
<< kg:id_194 prop:cause kg:id_195 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "未就学児を対象とした子育て広場や子供の居場所である児童館などは設置されていない地域もあります"@ja.
<< kg:id_196 prop:cause kg:id_197 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "住区基幹公園や農村公園においては、壊れた遊具が撤去されず、そのままになっているもの、撤去後も更新されていないものもあり、遊具の整備がされていない場所もあります"@ja.
<< kg:id_198 prop:countermeasure kg:id_199 >>
    prop:text-txt_contents "老朽化した危険な遊具につきましては、昨年度に13公園、19基の撤去を完了いたしました"@ja.
<< kg:id_198 prop:countermeasure kg:id_200 >>
    prop:text-txt_contents "４月の定期点検で新たに３公園、４基の危険な遊具が確認されたことから、現在は使用禁止にしており、修繕や撤去などの対応を検討しております"@ja.
<< kg:id_194 prop:countermeasure kg:id_201 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "大規模・中規模な公園は町や学区を越えて多くの子供が利用することから、大型遊具等を重点的に配置"@ja.
<< kg:id_194 prop:countermeasure kg:id_202 >>
    prop:text-txt_contents "街区公園等の小規模な公園につきましては、機能維持や長寿命化を図ることを基本"@ja.
<< kg:id_194 prop:countermeasure kg:id_203 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "健康福祉部を中心といたしまして、企画部や建設部、教育委員会など他の部局とも連携して、総合的に遊び場整備の方針の策定を進めていく必要がある"@ja.
<< kg:id_204 prop:countermeasure kg:id_205 >>
    prop:text-txt_contents "民間施設の連携や学校・スポーツ施設の活用も含めた検討も必要"@ja.
<< kg:id_204 prop:countermeasure kg:id_206 >>
    prop:text-txt_contents "今年度実施するソライ実証事業の際のアンケート項目にも盛り込みまして、子供と子育て中の保護者の意見を聞くなどしながら、実態の把握と検証を行っていく"@ja.
<< kg:id_204 prop:countermeasure kg:id_207 >>
    prop:text-txt_contents "今年度秋をめどに屋内・屋外の両面から整備方針を策定し、その後、具体的な整備を検討する"@ja.
<< kg:id_208 prop:cause kg:id_209 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "補修や改修する箇所以上に舗装の劣化や施設の老朽化の進行が早く、緊急に修繕対応が必要な箇所の増加により十分に対応できていない箇所もございます"@ja.
<< kg:id_208 prop:cause kg:id_210 >>
    prop:text-txt_contents "原材料費や燃料費、労務費などの物価高騰に加え"@ja.
<< kg:id_208 prop:cause kg:id_211 >>
    prop:text-txt_contents "時間外規制等における働き方改革の影響もございまして、近年は工事価格が上昇している状況"@ja.
<< kg:id_208 prop:countermeasure kg:id_212 >>
    prop:text-txt_contents "変化する構造物の劣化度合いや通行の安全性の速やかな状況把握"@ja.
<< kg:id_208 prop:countermeasure kg:id_213 >>
    prop:text-txt_contents "できる限り効率的な発注となるよう、設計や計画段階から精査する必要がある"@ja.
<< kg:id_208 prop:countermeasure kg:id_214 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "国や県に対し、維持管理予算の実態を訴えながら、市の実情に合った補助制度等の情報収集に努め、研究してまいりたい"@ja.
<< kg:id_215 prop:cause kg:id_216 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "限られた財源の中で各部署で修繕等を望む全ての意見を予算化することは現実的には難しい"@ja.
<< kg:id_215 prop:countermeasure kg:id_217 >>
    prop:text-txt_contents "対象となる施設の老朽度や安全性の確保など緊急性、また財源確保の見通し等を総合的に勘案して優先順位を判断し、予算に計上しております"@ja.
<< kg:id_218 prop:cause kg:id_219 >>
    prop:text-txt_contents "当院には内科系の循環器科医しかいないため、心臓血管手術が必要となった場合には日本海総合病院などで手術を行っていただき"@ja.
<< kg:id_218 prop:countermeasure kg:id_220 >>
    prop:text-txt_contents "救急搬送において心電図を測定し、各病院へ伝送するシステムを運用しており、速やかな診断と治療につなげております"@ja.
<< kg:id_218 prop:countermeasure kg:id_221 >>
    prop:text-txt_contents "容体が安定した後、さらに加療・リハビリ等が必要な場合は当院で入院診療を提供しております"@ja.
<< kg:id_222 prop:countermeasure kg:id_223 >>
    prop:text-txt_contents "心不全については、将来的に誤嚥性を含む肺炎の診療と同様に鶴岡・田川３病院地域包括ケアパスでの運用を開始し、鶴岡・田川地域で役割分担しながら、診療していく体制を構築する予定"@ja.
<< kg:id_224 prop:countermeasure kg:id_225 >>
    prop:text-txt_contents "脳卒中等で手術が必要な場合は脳神経外科医が手術を行っておりますし、手術が不要な急性期的な治療は脳神経外科医のほか、神経内科医などの医師も治療に当たっております"@ja.
<< kg:id_224 prop:countermeasure kg:id_226 >>
    prop:text-txt_contents "鶴岡地区医師会中心で運用しております脳卒中連携パスに当院も参画しており"@ja.
}
