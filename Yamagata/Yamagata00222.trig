kg:st_1 rdfs:label "健康福祉部長 相澤康夫"@ja.
kg:st_1 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_1 prop:content "分野ごとの支援だけでは全体的な解決につながらず包括的支援が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "必要に応じて連携しているが分野別支援には限界がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地域福祉計画に基づき分野横断で包括ケアを推進する体制を整える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "あらゆる福祉分野の相談に乗り必要に応じて専門機関につなぐ体制を整備する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "既存機関を拠点にすることで自然な相談支援の流れを進められる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "分野横断のコーディネート機能を担う人材育成が課題"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤博幸議員"@ja.
kg:st_2 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_7 prop:content "複合化したニーズに単独機関では限界がある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "国のガイドラインを踏まえ総合的サービス提供の検討を進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "地域の実情に合った総合的な福祉サービス提供システムを検討する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "総合的サービス提供は既に一部で実施されている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "複数サービスの総合的提供は事業所の相談に応じて個別に対応する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "国の基準緩和や報酬改定の推移を見守りつつ制度設計を進める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "在宅医療介護を一体的に提供できる体制構築が必要"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:st_3 rdfs:label "病院事業管理者兼荘内病院長 三科武"@ja.
kg:st_3 rdf:type cls:st_121.
cls:st_121 rdfs:label "医療関係者"@ja.
kg:op_14 prop:content "多職種連携を通じて切れ目のない地域医療連携を構築している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "地域の大きな医療の財産になっている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "行政や医師会等の意見を聞きながら医療連携に取り組む"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "地域の医療課題を病院間で定期的に協議している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "退院患者への訪問指導など在宅での認知症ケアを進めている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "患者家族への訪問指導も含めた対応で効果が出ている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "急性期医療と後方支援を担い地域包括ケアシステムを支える"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "急性期医療の入り口と後方支援を担当し地域全体で医療提供したい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "在宅医療を進める医師会と提携し必要な役割分担を明確にする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "患者が希望する場所で診療を受けられる体制を目指す"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "地域医療の窓口がまだ明確になっていない問題意識を持っている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:st_4 rdfs:label "市民部長 佐藤茂巳"@ja.
kg:st_4 rdf:type cls:st_32.
kg:op_25 prop:content "当初想定以上の実績もあり一定の成果を上げている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:st_5 rdfs:label "農林水産部長 渡邊雅彦"@ja.
kg:st_5 rdf:type cls:st_32.
kg:op_26 prop:content "燃焼効率の向上で順調に稼働している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "低質材の安定需要先が確保され森林整備促進につながっている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "県内で発電所が増え将来の燃料確保に懸念がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "庄内の森林組合に安定供給の強化を働きかける"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "現時点では農業利用の事業化は困難"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "全国初の先導的モデル事業として進めている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "環境面で大きな効果が見込まれる"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "観光分野でのブランド化と継続的発展に向けたインフラ整備効果がある"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "生活環境と自然環境に配慮した事業計画となるよう協力する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:st_6 rdfs:label "総務部長 川畑仁"@ja.
kg:st_6 rdf:type cls:st_32.
kg:op_35 prop:content "本市の認知度向上と地場産品の魅力が寄附増加につながっている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "返礼品購入や事業実施を通じて地域経済にプラス効果がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:st_7 rdfs:label "企画部長 高橋健彦"@ja.
kg:st_7 rdf:type cls:st_32.
kg:op_37 prop:content "企業は実質負担を抑えつつ地方創生支援をアピールできる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_7.
kg:op_38 prop:content "財源確保に民間資金を導入できる制度として前向きに活用を検討する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_7.
kg:st_8 rdfs:label "建設部長 渡会悟"@ja.
kg:st_8 rdf:type cls:st_32.
kg:op_39 prop:content "一定の効果はあるが依然として道路への飛砂堆積がある"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_8.
kg:op_40 prop:content "現状では毎年の設置が継続的な対策となっている"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_8.
kg:op_41 prop:content "地元の状況を踏まえ県と連携して対応策を協議する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_8.
kg:op_42 prop:content "県の動きを注視し関係者とともに輸出促進につなげる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "市場調査や販路開拓を支援する制度を用意している"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:op_44 prop:content "輸出は課題があるが大きな魅力があり方向性を整理する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
kg:op_45 prop:content "中山間地域の農業は厳しい環境にあり大きな課題である"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_5.
kg:op_46 prop:content "荒廃農地の増加も中山間地域の大きな課題である"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_5.
kg:op_47 prop:content "鳥獣被害拡大が農業振興を難しくしている"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "高齢者でも取り組みやすく鳥獣被害に遭いにくい作物として期待する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_5.
kg:op_49 prop:content "食文化の貴重な資源として未来に残す責任がある"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_5.
kg:op_50 prop:content "朝日地域の伝統狩猟文化を生かした振興策を検討している"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_5.
kg:op_51 prop:content "食肉処理施設はマタギ文化継承に必要であり整備主体や場所を検討する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_5.
kg:st_9 rdfs:label "教育長 加藤忍"@ja.
kg:st_9 rdf:type cls:st_51.
cls:st_51 rdfs:label "教育関係者"@ja.
kg:op_52 prop:content "ドイツやモルドバとの交流を通じ事前合宿も含めて進めたい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_9.
kg:op_53 prop:content "スポーツ農業商工福祉など多分野の関係者とともに交流事業を進める"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_9.
kg:op_54 prop:content "トップアスリートとの接点は子供たちの夢や目標につながる"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_9.
kg:op_55 prop:content "誰に対しても相手の立場に立った接遇を心がける"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_6.
kg:op_56 prop:content "障害の有無にかかわらず適切に対応できる職員育成を進める"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_6.
kg:op_57 prop:content "職員が認知症への理解を深め技能を習得するよう啓発する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_6.
kg:op_58 prop:content "厳しい財政運営を踏まえ投資的経費の削減も検討が必要"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_6.
kg:op_59 prop:content "現在のままでは現実的に維持困難で適正化が必要"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_6.
kg:op_60 prop:content "利用状況や市民ニーズを把握し全体の総量を適正化する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_6.
kg:op_61 prop:content "予防保全型の修繕により安全で快適な利用環境を維持する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_6.
kg:op_62 prop:content "必要な投資を見極めながら持続的管理を進める"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_6.
kg:op_63 prop:content "大雨災害の危険性増大を踏まえ計画的対策が必要"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_8.
kg:op_64 prop:content "支障木への対応に特化した計画策定が進んでいる"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_8.
kg:op_65 prop:content "堆積土砂撤去と支障木伐採の計画的実施に期待している"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_8.
kg:op_66 prop:content "閉塞状況や背後地の重要性に応じて優先的に対策する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_8.
kg:op_67 prop:content "連携協議会を立ち上げ事業を円滑に進めている"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_7.
kg:op_68 prop:content "関係者が連携してプロジェクトを推進する体制を整えた"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_7.
kg:op_69 prop:content "推進交付金を受け先端研究産業支援センター内の整備を進める"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_7.
kg:op_70 prop:content "がんセンターの基準に基づき十分な安全確保と環境保全を図る"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_7.
kg:op_71 prop:content "研究者との関係づくりの第一歩として生活支援に努める"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_7.
kg:op_72 prop:content "市民向けセミナーや地域医療との連携が期待される"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_7.
kg:op_73 prop:content "ベンチャー創出や創薬商品化企業誘致への波及が期待される"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_7.
kg:op_74 prop:content "築後40年以上経過し老朽化による不具合が生じている"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_8.
kg:op_75 prop:content "集約化と多様化への対応から新規事業化が妥当と判断された"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_8.
kg:op_76 prop:content "敷地調査や設計業務着手に市も協力する"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_8.
kg:op_77 prop:content "災害時に本庁舎を補完する防災機能向上を図る"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_8.
kg:op_78 prop:content "官庁施設と民間施設の一体的整備によりまちの活性化が進む"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_8.
kg:op_79 prop:content "建てかえの時期は近いとみられるが全国的に老朽施設が多い"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_8.
kg:op_80 prop:content "にこふる駐車場整備や周辺環境整備のため移転を強く要望する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_8.
kg:op_81 prop:content "消費者や実需者が求める売れる米づくりを進める必要がある"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_5.
kg:op_82 prop:content "産地間競争を見据え競争力強化を図る"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_5.
kg:op_83 prop:content "稲作を基幹としつつ複合経営で経営安定を図る"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_5.
kg:op_84 prop:content "加工販売による高付加価値化を拡大したい"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_5.
kg:op_85 prop:content "県や地域協議会が主体となり需要に応じた米生産を進める"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_5.
kg:op_86 prop:content "農業者にとってわかりやすく取り組みやすい仕組みを目指す"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_5.
kg:op_87 prop:content "若年層や幼児の朝食欠食が課題となっている"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_1.
kg:op_88 prop:content "食習慣の乱れが健康問題につながっている"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_1.
kg:op_89 prop:content "全てのライフステージで食を健康づくりの重要な柱と位置づけている"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_1.
kg:op_90 prop:content "働き盛り世代の家族の食生活改善を学べる場を設けている"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_1.
kg:op_91 prop:content "乳幼児期から正しい食習慣の定着を図る"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_1.
kg:op_92 prop:content "近年降雪量が少なく利用件数は導入当初より減っている"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_4.
kg:op_93 prop:content "地域の共助という観点から大変有効である"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_4.
kg:op_94 prop:content "運用主体から課題として挙がっている"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_4.
kg:op_95 prop:content "除雪機の運搬も活用上の課題である"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_4.
kg:op_96 prop:content "地域の主体的な除雪体制づくりには人材育成が課題"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "福祉ニーズが多様化、複雑化している現状を踏まえまして"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "必要に応じて分野相互に連携をしているものの、分野ごとの支援には限界があることは否めないところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "地域福祉計画では、包括的な相談支援システムの構築に向け、地域包括ケア推進会議及び地域包括ケア推進室の設置を盛り込んだところであります"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "ワンストップの初期相談、支援体制の整備につきましても計画に盛り込んだところでありますが、これについてはワンストップであらゆる福祉分野の相談に乗り、総合的に支援するとともに、必要に応じて専門機関につなぐなどの役割を果たすこととし、中学校エリア単位に整備することを目指しております"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "既に中学校エリア単位に存在する地域包括支援センターなど、既存の機関を拠点に整備することが、これまでの相談支援の流れを自然に進めていくことができるという考え方にのっとって推進していくものでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "ワンストップの初期相談、支援体制における職員配置として、分野横断の取り組みを初め、コーディネート機能を果たしながら、いわゆるコミュニティーソーシャルワークを実践する職員の養成も課題になると考えております"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "複合化するニーズに単独の機関によるアプローチでは十分対応できないケースも存在しているとしています"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "要援護者やその世帯が抱える複合的な課題に対して、切れ目のない包括的な支援が一貫して行われるよう支援内容のマネジメントを行うこと"@ja.
<< kg:id_8 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "地域の実情に応じて分野横断的に福祉サービスを提供できることが求められるとあります"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "高齢者と障害者に対して総合的にサービスを提供する基準該当施設が５施設ございまして、直近の数値では９名の障害者の方が高齢者と一緒に生活介護サービスを受けております"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "運営する事業所から実際に複数のサービスを総合的に提供する事業の実施について相談があった場合は、個別に対応させていただきたいというふうに考えております"@ja.
<< kg:id_12 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "地元福祉関係者とも連携を図り、本市の実情に合った総合的な福祉サービス提供のシステムの検討を進めてまいりたいと考えております"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "疾病を抱えても自宅等の住みなれた生活の場で療養し、自分らしい生活を続けられるためには、地域における医療介護の関係機関が連携して、包括的かつ継続的な在宅医療、介護の提供を行うことが必要であるとし"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "庄内プロジェクトは、そのプロジェクト終了後も南庄内緩和ケア推進協議会に引き継がれまして、活動が継続されております"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "病院から診療所、そして自宅へと、切れ目のない地域医療連携の構築に大きく寄与をしております"@ja.
<< kg:id_18 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "行政、医師会、歯科医師会、薬剤師会等の代表から成ります地域医療連携推進協議会を設置し、各方面からの御意見を伺い、医療連携に取り組んでおります"@ja.
<< kg:id_18 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "平成26年度に当院が主体となりまして、庄内南部地域、鶴岡市を中心としてですが、７病院に呼びかけまして、鶴岡地区病院協議会を立ち上げ、この地域における医療をめぐる課題について定期的に会議を開催しております"@ja.
<< kg:id_18 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "県内では先駆けとなります認知症看護認定看護師の配置を行い、医師、看護師、薬剤師、ケースワーカーや臨床心理士などから成ります認知症ケアチームを立ち上げております"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "患者さんの家族への訪問指導を含め対応して、効果を上げているところでございます"@ja.
<< kg:id_18 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "当院としては後方支援病院とし、在宅、介護施設の医療の支援を主に行っているところであります"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "機能の分化をしなさいと、それから医療を病院単独で行うものではなくて、地域全体で提供できるような体制をとること"@ja.
<< kg:id_28 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "この地区の医師会が非常に在宅医療、地域医療連携を進めておりますので、医師会と提携をしまして、我々として何が本当に必要とされているか"@ja.
<< kg:id_28 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "患者さんが在宅でといいますか、希望されるところで治療を受けられるように、診療できるように"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "いわゆる地域医療を担当する部署が不明確という御指摘かと思います。これについては、私どももこれまで仕事を進めてくるに当たって、やはりまだ明確にはなっていないという問題意識としては持っております"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "多様な方面においておおむね十分な進捗が見られ、一定の成果を上げているものと評価をいたしているところでございます"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "現段階の稼働状況につきましては、計画より少ない木材を使っての計画どおりの発電量を確保しておりまして、順調に稼働していると思われます"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "木材バイオマス発電事業の導入によって、低質材においては安定した需要先が確保されまして、それに伴って森林整備が順調に進んでいると判断しております"@ja.
<< kg:id_36 prop:effect kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "県内でも９カ所の木質バイオマス発電所が稼働中もしくは計画中であるということから、燃料用木材の奪い合いが将来的にはやっぱり懸念されているところでございまして"@ja.
<< kg:id_36 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "これらの森林組合が今以上に間伐材の確保を図ることだけでなく、皆伐の本格化にも着手することで燃料用木材を安定的に供給するよう働きかけをしていきたいと思っております"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "温排水の温度が40度以下と非常に低く、施設整備と管理コストに見合う栽培品目がないことから、平成27年度時点で事業化が困難として、現在検討を休止しております"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "温泉の未利用熱を温泉街全体で活用することにより、地域全体での大規模なＣＯ２削減に結びつけようとするものでございます"@ja.
<< kg:id_43 prop:effect kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "温泉街全体で約15％のＣＯ２削減ができる予定となっております"@ja.
<< kg:id_43 prop:effect kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "先導的な環境対策を行っている温泉地という地域ブランドの創出を期待いたしますとともに、新たな配管の設置による今後の湯野浜温泉の継続的な発展に向けたインフラ整備といった面も効果の大きい事業と考えております"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "現在は評価方法の検討や現地調査等が完了しており、今後は検討結果の公表を通じて、住民や市を含めた関係機関などの意見を確認する手続が予定されております"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "11月末現在で申し込み件数３万8,294件、金額が５億1,470万円となっております"@ja.
<< kg:id_49 prop:effect kg:id_51 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "結果として市外からいただいた寄附金が地域経済の中で循環しているものと考えております"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "企業側にとりましては実質負担を抑えながら寄附をすることができまして、しかも地方創生に取り組む自治体を積極的に応援するといった社会貢献の姿勢をアピールできる"@ja.
<< kg:id_52 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "本市の地方創生の取り組みについて、首都圏での各種会合等の場でありますとか、本市に縁のある企業様への訪問など、そういったあらゆる機会を捉えまして、積極的に御相談、周知をさせていただきまして、活用に向け、前向きに検討しながら取り組んでまいりたい"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "依然として道路等への飛砂の堆積があるため、車両の通行に支障となる場合にはその都度県が撤去、清掃の業務委託により対応を行っております"@ja.
<< kg:id_55 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "毎年11月から３月までの飛砂防止柵５カ所と飛砂ポケット３カ所を海岸内に設置している現状であります"@ja.
<< kg:id_55 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "引き続き連携を図りながら、地元の皆様とともに県への具体的な要望を強めてまいりたいと存じます"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "県はヤマト運輸、全日空と提携しまして、全日空が就航しています庄内空港などからも、ただいま御説明しましたように那覇空港経由でアジア各国に農産物を届けられるようにする連携協定を今週中にも提携する"@ja.
<< kg:id_59 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "海外での市場調査や現地での商談会への出展など、海外における販路開拓のための活動経費に対しまして、特産物販売促進支援事業補助金が活用可能となっております"@ja.
<< kg:id_59 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "今年度中に農産物の輸出促進に向けた方向性をとりまとめ、輸出の促進を図ってまいりたいと考えているところでございます"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "中山間地域の農業振興につきましては、担い手不足の著しい進行や荒廃農地の増加、鳥獣被害の拡大など、厳しい環境にあります"@ja.
<< kg:id_63 prop:cause kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "担い手不足の著しい進行や荒廃農地の増加、鳥獣被害の拡大など"@ja.
<< kg:id_63 prop:cause kg:id_66 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "担い手不足の著しい進行や荒廃農地の増加、鳥獣被害の拡大など、厳しい環境にあります"@ja.
<< kg:id_63 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "山菜は高齢者でも取り組みやすく、また山菜とキノコ、ともに鳥獣被害に遭いにくいなどの山地として取り組むメリットが大きく、中山間地域の農業活性化の大きな武器になるものと期待しております"@ja.
<< kg:id_63 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "これらを中山間地域の農業振興の推進資源としてブランド化を図り、生産振興と販売促進を進めていかなければならないと考えております"@ja.
<< kg:id_63 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "朝日地域では、地域文化として伝統狩猟が行われておりまして、ジビエを活用した振興策の検討を開始しているところでございます"@ja.
<< kg:id_70 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "朝日地域のマタギ文化の継承には食肉処理施設が必要と認識しております"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "本市といたしましては、事前合宿の誘致につきましても、このホストタウン事業の一環として取り組んでまいりたいと考えております"@ja.
<< kg:id_72 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "10月に鶴岡ホストタウン推進委員会を設立しております"@ja.
<< kg:id_72 prop:effect kg:id_75 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "本市の競技スポーツの振興や選手の育成、さらには市民の機運を盛り上げるということにもつながっていくということで、非常に期待しているところでございます"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "新採職員に対し、職員に求められる基礎的素養を習得するために初任者研修を実施するとともに、庄内広域行政組合が主催する接遇研修に参加しております"@ja.
<< kg:id_76 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "庁内各課に差別解消推進員を配置するとともに、具体的な対応の留意点をまとめたサポートブックを用いて研修会を開催し、障害の有無にかかわらず、誰に対しても相手の立場に立った接遇に心がけるよう努めております"@ja.
<< kg:id_76 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "庁内のキャラバンメイトの資格を持つ職員を講師に認知症サポーター養成講座の受講を進めるなど、職員が認知症に対する理解を深め、技能を習得するよう啓発に努めてまいりたい"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "市税の増加は厳しい状況にありますし、また今年度から普通交付税の合併算定替による優遇措置の段階的減額も始まっております"@ja.
<< kg:id_80 prop:cause kg:id_82 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "現在の数、施設規模のまま維持し続けることは現実的には困難と言わざるを得ない推計が示されております"@ja.
<< kg:id_80 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "総量の適正化につきましては、必要とされる施設に対しまして維持管理、修繕、更新等を適切に行うため、公共施設の利用状況ですとか市民ニーズの変化を的確に把握し、全庁的な調整を行った上で、全体の総量の適正化を図っていくというものであります"@ja.
<< kg:id_80 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "老朽化の進行状況を定期的に把握し、問題が軽微な段階で対策を講じる予防保全型に取り組むことですとか、そういうようなことで、予期しないふぐあいの発生を防止するとともに"@ja.
<< kg:id_80 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "原則の３つ目は、計画的な投資ということでございまして、これは先日も御説明申し上げましたとおり、負担額の軽減と平準化を図るというものであります"@ja.
<< kg:id_86 prop:cause kg:id_87 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "河川における堆積土砂の掘削や支障木の伐採を中心に進めてきた経緯がございます"@ja.
<< kg:id_86 prop:cause kg:id_88 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "新たに堆積土砂の撤去による河積回復と支障木等への対応に特化した計画、河川流下能力向上計画を策定することになったものと伺っております"@ja.
<< kg:id_86 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "新たに堆積土砂の撤去による河積回復と支障木等への対応に特化した計画、河川流下能力向上計画を策定することになったものと伺っております"@ja.
<< kg:id_86 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "堆積土砂の撤去では河道の閉塞状況と背後地の重要性に応じて優先度を設けた対策を、また支障木の伐採では支障木の再生時期に合わせたサイクルとした対策での対応を基本とするといったような方針を具体化し"@ja.
<< kg:id_91 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "県と市が地方創生推進交付金を活用しながら支援する枠組みとして、９月議会で可決いただいた補正予算に基づき、推進交付金申請書、地方再生計画書を国に提出いたしたところでございます"@ja.
<< kg:id_91 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "先月には、がん研究センター、慶應義塾、県、市、庄内地域産業振興センターによる連携協議会が発足いたしまして"@ja.
<< kg:id_91 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "推進交付金の交付を受けまして、直ちに実験ラボ棟の整備に入ることといたしておるところでございます"@ja.
<< kg:id_91 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "プロジェクトには動物実験が不可欠でありますことから、既存建物を改修いたしまして、その実験施設といたしたいというものでございます"@ja.
<< kg:id_91 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "研究者に対する生活支援はがんセンターとの関係づくりの第一歩でもございますので、できる限りの支援に努めてまいる所存でございます"@ja.
<< kg:id_91 prop:effect kg:id_97 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "期待される効果という点では２つかなというふうに考えておるところでございまして、１つが市民の皆様の健康増進などの施策の推進"@ja.
<< kg:id_91 prop:effect kg:id_98 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "もう一つが新規創業、企業進出など産業振興、この２つに大別されるのかなというふうに考えておるところでございます"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "入居予定の官庁施設がいずれも築後40年以上を経過し、老朽化によるふぐあいが生じていること"@ja.
<< kg:id_99 prop:cause kg:id_101 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "国施設の業務の集約及び多様化などから、鶴岡第２地方合同庁舎の新規事業化が妥当と判断いただいたものです"@ja.
<< kg:id_99 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "これにより、予算化などの手続を経て、来年度からの事業着手が予定されることとなったものであります"@ja.
<< kg:id_99 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "市では、合同庁舎整備にあわせて災害時に市役所本庁舎の防災機能を補完する洪水ハザードマップでの最大浸水深にも対応した防災資機材庫を合同庁舎に合築することで災害対応能力の向上を図ってまいりたいと計画しております"@ja.
<< kg:id_99 prop:effect kg:id_104 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "官庁施設と民間施設の一体的な地域での整備が進められ、市民の利便性向上、中心市街地の求心力の強化、にぎわいの創出が図られているものと捉えております"@ja.
<< kg:id_105 prop:cause kg:id_106 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "鶴岡拘置支所の建物は、職員宿舎も含め、築後50年以上経過していることから、施設の老朽化による建てかえの時期も近いものと考えられます"@ja.
<< kg:id_105 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "市といたしましては、先ほど申し上げましたとおり、にこふる駐車場としての跡地の活用による利便性の向上や、都市計画道路道形黄金線整備にあわせた周辺環境整備の観点から、合同庁舎整備にあわせた拘置支所の移転を今後、先ほど申しました法務省所管部署と協議を重ね、強く要望してまいる所存であります"@ja.
<< kg:id_108 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "これまで培ってきた生産技術、知識を最大限に発揮した、高品質で良食味な米の生産"@ja.
<< kg:id_108 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "農地の面的集積や直播栽培といった低コスト生産をこれまで以上に推進し、さらなる競争力の強化につなげていきたいと考えております"@ja.
<< kg:id_108 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "稲作を基幹としつつも、枝豆やネギといったものの園芸部門、そして庄内柿やサクランボ等の果樹部門、こういったものとの複合経営の取り組みが必要だと考えております"@ja.
<< kg:id_108 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "農産物の加工、販売の取り組みにより、高付加価値化を図る６次産業化への取り組みも拡大してまいりたいと考えております"@ja.
<< kg:id_113 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "国から示される生産数量目標にかわるものとして、生産の目安の数値の提示が検討されております"@ja.
<< kg:id_113 prop:countermeasure kg:id_115 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "市としましては、30年以降も需給調整が必要であると考えておりまして、農業者への配分はこれまでの配分方法をベースに検討しているところでございます"@ja.
<< kg:id_116 prop:cause kg:id_117 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "朝食の欠食率は男性が14.3％、女性10.5％で、少なくとも10人に１人以上が朝食を食べていないことになっております"@ja.
<< kg:id_116 prop:cause kg:id_118 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "朝食の欠食などの食習慣の乱れや過食や拒食に伴う心と体の健康問題が生じている現状も指摘されております"@ja.
<< kg:id_116 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "本市におきましては、妊娠期から乳幼児期、学齢期までの食育事業や青年期、壮年期、高齢期までの疾病予防のための食生活、栄養改善事業などを実施しておりまして、全てのライフステージにおいて、食は健康な体をつくるため重要な柱と位置づけております"@ja.
<< kg:id_116 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "家族の食生活改善についても学べる親子食生活教室「親子ランチスタディ」を実施しております"@ja.
<< kg:id_116 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "各園では、年齢ごとの食育計画に基づきまして、給食は白御飯を主食とし、ゼロ歳児からの発達に応じた食形態のものを提供しております"@ja.
<< kg:id_122 prop:effect kg:id_123 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "近年降雪量が少ないことから、利用件数は25年度は約230件、26、27年度は各年度とも約330件となっております"@ja.
<< kg:id_122 prop:effect kg:id_124 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "地域内の高齢者世帯宅の玄関先から道路までの除雪作業を毎年実施している取り組みや、地域内で除雪ボランティアを組織化し、自力での除雪が困難な世帯宅や市の除雪が行き届かない危険箇所の除雪を行っている取り組み"@ja.
<< kg:id_122 prop:cause kg:id_125 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "運用主体からは、運用上の課題として、排雪場所の確保や除雪機の運搬、除雪ボランティアの育成、利用拡大に向けた町内会長等や民生児童委員との協力や情報共有などが挙げられております"@ja.
