kg:st_1 rdfs:label "佐藤博幸議員"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "本市も推進室設置を機に本格的に取り組むべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "問題はさらに深刻であり全世代型の福祉として進める必要がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "健康福祉部長齋藤功"@ja.
kg:st_2 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_3 prop:content "一体的に推進するほうが効率的かつ効果的"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "地域包括ケアの構築が強く求められている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "地域共生社会の実現まで視野に入れた対応が必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地域包括ケアシステムの構築と地域福祉の推進を一体的に進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "市社協と事業推進の両輪となって進めたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "推進室が福祉医療介護の関係者をつなぐ役割を果たすべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "推進室が関係者をつなぐ役割も果たしたい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "推進室が部署横断の調整機能に関わり教育との連携を強化する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "一体的に推進することが効率的である"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "社協との緊密な連携を継続する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "子供や障害者分野をさらに強化する必要がある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "妊娠期から早期に察知し支援することが重要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "児童虐待防止は子供の命をどう守るかという考え方だ"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "関係機関が連携し適切な保護と支援を図る"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "円滑な支援の実現を図っている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "困難ケースには個別の情報共有と支援方針確認が必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "母子保健と子育て支援の一体的連携を進める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:st_3 rdfs:label "五十嵐一彦議員"@ja.
kg:st_3 rdfs:type cls:st_16.
kg:op_20 prop:content "改札口が2カ所しかない課題が残っている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:st_4 rdfs:label "企画部次長佐藤光治"@ja.
kg:st_4 rdfs:type cls:st_2.
kg:op_21 prop:content "同一ホーム乗りかえ拡大で利便性向上が図られる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "さらなる利便性向上のため引き続き要望する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "さらなる高速化に向けて要望を継続する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:st_5 rdfs:label "建設部長増田亨"@ja.
kg:st_5 rdfs:type cls:st_2.
kg:op_24 prop:content "着々と整備が進められていくと期待している"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "引き続き要望活動を行いたい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:op_26 prop:content "地元や関係者から意見をいただきながら進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "滑走路延長が国際チャーター便や定期便運行の制約要因になっている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "明るい話題が続いている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "県の調査結果を生かして取り組む"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "関係各所と連携し利用拡大に取り組む"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:st_6 rdfs:label "教育部長石塚健"@ja.
kg:st_6 rdfs:type cls:st_2.
kg:op_31 prop:content "一層の普及促進に取り組みたい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_6.
kg:op_32 prop:content "東京オリンピックパラリンピックに向けた取り組みを進める"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:op_33 prop:content "市民にもっと興味を持っていただきたい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "より多くの方にルールや指導を伝達できるようにしたい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "地元回帰やUIターンにつながる制度にしたい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "早い段階から地元でやりたい仕事ができる理解を深めてもらう必要がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "氷見市などを参考に幅広く検討している"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "奨学金だけでなく地元回帰の意識づけも行う"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "専門的なスタッフとの連携は非常に大切で必要"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_6.
kg:op_40 prop:content "本市の実態に即した効果的な支援が実現できるよう前向きに検討する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:st_7 rdfs:label "総務部長高橋健彦"@ja.
kg:st_7 rdfs:type cls:st_2.
kg:op_41 prop:content "職員全体をカバーする防止対策を整備する必要性を感じている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_7.
kg:op_42 prop:content "働きやすい職場づくりのため整備が必要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_7.
kg:st_8 rdfs:label "市長皆川治"@ja.
kg:st_8 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_43 prop:content "できるだけ早くガイドラインを整備する必要がある"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_8.
kg:st_9 rdfs:label "阿部寛議員"@ja.
kg:st_9 rdfs:type cls:st_16.
kg:op_44 prop:content "ユニホームをつくることもできない現状がある"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_9.
kg:op_45 prop:content "今後も支援していく必要がある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:st_10 rdfs:label "農林水産部長高橋和博"@ja.
kg:st_10 rdfs:type cls:st_2.
kg:op_46 prop:content "限られた農業者で生産性を高めていく必要がある"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_10.
kg:op_47 prop:content "非主食用米や高付加価値化で対応する必要がある"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_10.
kg:op_48 prop:content "これを基本に進める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_10.
kg:op_49 prop:content "需要が堅調で高価格が期待される品種を伸ばす"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_10.
kg:op_50 prop:content "海外需要も見込みながら進める"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_10.
kg:op_51 prop:content "有望な品目である"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_10.
kg:op_52 prop:content "結果を踏まえて中山間地域での生産拡大につなげたい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_10.
kg:op_53 prop:content "農家の導入を後押ししたい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_10.
kg:op_54 prop:content "高齢農家が長く営農を続けられる支援が重要"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_10.
kg:op_55 prop:content "課題整理と意見交換を行い具体策を検討する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_10.
kg:st_11 rdfs:label "市民部長白幡俊"@ja.
kg:st_11 rdfs:type cls:st_2.
kg:op_56 prop:content "実態を把握し整理を検討する必要がある"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_11.
kg:op_57 prop:content "市街地郊外地旧町村のバランスに配慮した"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_11.
kg:op_58 prop:content "研修会やワークショップ支援を通じて取り組みを支援する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_11.
kg:op_59 prop:content "担い手不足解消に間接的につながる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_11.
kg:st_12 rdfs:label "教育長加藤忍"@ja.
kg:st_12 rdfs:type cls:st_72.
cls:st_72 rdfs:label "教育機関"@ja.
kg:op_60 prop:content "教科横断的に地域の実態に即した学習を進めたい"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_12.
kg:op_61 prop:content "地域と連携した訓練に取り組んでいる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_12.
kg:op_62 prop:content "地域との事前協議を進めていく必要がある"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_12.
kg:op_63 prop:content "参加者の意見交換を通して理解を深めスムーズな運営につなげる"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_11.
kg:op_64 prop:content "継続的な情報共有が必要"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_11.
kg:op_65 prop:content "本市でも有用であり設置に向けた調査研究に取り組む"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_12.
kg:st_13 rdfs:label "佐藤昌哉議員"@ja.
kg:st_13 rdfs:type cls:st_16.
kg:op_66 prop:content "計画的な財政執行による負担軽減が必要"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_13.
kg:op_67 prop:content "残高が10億円を下らないよう留意する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_7.
kg:op_68 prop:content "施設データの見える化で計画の実効性を高める"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_7.
kg:op_69 prop:content "担い手育成確保が重要であり活用の方向として判断した"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_8.
kg:op_70 prop:content "別の有効活用策を検討する必要があった"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_8.
kg:op_71 prop:content "県外から研修生を呼び込み本市農業の担い手育成を図る"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_10.
kg:op_72 prop:content "市単独では難しいため関係機関との連携が必要"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_10.
kg:op_73 prop:content "定住人口増加や地域活性化の効果も期待できる"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_10.
kg:op_74 prop:content "目的は共通しており連携可能性を検討したい"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_8.
kg:st_14 rdfs:label "病院事業管理者兼荘内病院長三科武"@ja.
kg:st_14 rdfs:type cls:st_118.
cls:st_118 rdfs:label "医療機関"@ja.
kg:op_75 prop:content "医師不足が診療上の課題を生んでいる"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_14.
kg:op_76 prop:content "地域完結型の医療で対応せざるを得ない"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_14.
kg:op_77 prop:content "1つの病院で完結せず地域完結型医療になる"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_14.
kg:op_78 prop:content "医師確保は病院の最重要課題として取り組む"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_14.
kg:op_79 prop:content "将来の医師確保に大きな期待を寄せている"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_14.
kg:op_80 prop:content "60歳代と70歳代で約半数となっている"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "医師会と課題を共有し対応したい"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:st_15 rdfs:label "荘内病院事務部長土屋清光"@ja.
kg:st_15 rdfs:type cls:st_118.
kg:op_82 prop:content "医師の事務負担軽減により診療や手術に時間を充てられる"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_15.
kg:op_83 prop:content "現場で慢性的な不足感がある"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "県と連携しながら看護師確保施策を進める"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "看護師育成確保のため早期の建てかえが必要"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_15.
kg:op_86 prop:content "導入拡大と省エネルギー推進に取り組んできた"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_11.
kg:op_87 prop:content "災害時の非常用電源配備を進めている"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_11.
kg:op_88 prop:content "着実に成果が上がっている"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_11.
kg:op_89 prop:content "自立分散型電源配備と防災減災地域振興につながる取り組みを検討する"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_11.
kg:op_90 prop:content "最終的な運転開始は2020年12月ごろと見込まれる"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_11.
kg:st_16 rdfs:label "小野寺佳克議員"@ja.
kg:st_16 rdfs:type cls:st_16.
kg:op_91 prop:content "環境上の課題が少ない洋上風力も研究すべき"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_16.
kg:op_92 prop:content "導入可能性や課題についての情報収集と協議を注視したい"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_11.
kg:st_17 rdfs:label "商工観光部長阿部真一"@ja.
kg:st_17 rdfs:type cls:st_2.
kg:op_93 prop:content "一定の集客効果が現れている"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_17.
kg:op_94 prop:content "現代にも受け入れられる松ヶ岡ならではの体験メニューづくりが必要"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_17.
kg:op_95 prop:content "開墾150年までの3カ年の取り組みをまとめる"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_17.
kg:op_96 prop:content "周遊観光の促進と誘客拡大につなげたい"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_17.
kg:op_97 prop:content "観光客の利便性向上を図る"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_17.
kg:st_18 rdfs:label "羽黒庁舎支所長國井儀昭"@ja.
kg:st_18 rdfs:type cls:st_2.
kg:op_98 prop:content "日本遺産を生かした地域活性化には地元の声を引き出すことが重要"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_18.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "現在本市は高齢化率が30％を超えて超高齢社会を迎えています"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "2040年には43.1％になると予測をされ、問題はさらに深刻であります"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本市では、これまで地域包括ケアと地域福祉を異なる部署で担当してまいりましたが"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "2025年問題は、社会問題として取り上げられております"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "2040年には43.1％になると予測をされ、問題はさらに深刻であります"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "新たに健康福祉部内に地域包括ケア推進室を設置し、一元化を図ることにしております"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "具体的な検討項目を設定し、定期的な協議、検討を進めていく方針を確認したところでございます"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "医師会や荘内病院が行っている事業につきまして連携強化や役割分担を進めるなど、より効果的な取り組みが期待されております"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "在宅医療と介護の連携機能がより効果的に発揮できるように、福祉、医療、介護の関係者をつなぐ役割も果たしてまいりたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "教育分野ともさらに連携を深め、両分野、さらには乳幼児期から学齢期の切れ目のない支援に大きな役割を果たせるよう対応してまいりたい"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "地域包括ケアシステムと生活上の課題を抱える個人や家庭に対する個別支援と地域支援を総合的に展開、実践するコミュニティソーシャルワークに基づく地域福祉、この両者は重なる部分が多くございます"@ja.
<< kg:id_12 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "今年度から、以前も行っておりましたけども、改めて今年度から社会福祉協議会との人事交流を行っているところでございます。これについて今後とも継続してまいりますし"@ja.
<< kg:id_12 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "議員御指摘のように、やはり高齢者中心の取り組みになっているという状況でございまして"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "妊婦や保護者の不安感やストレスをいち早く察知し"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "子供たちの安心、安全を最優先に児童虐待の未然防止、早期発見、早期対応に努めてまいりたい"@ja.
<< kg:id_16 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "関係機関が要保護児童等の適切な保護を図るために必要な情報交換を行うとともに、要保護児童等に対する支援の内容に関する協議を行っております"@ja.
<< kg:id_16 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "実務者会議は、実際に支援に携わる担当者が２カ月に１回定期的に集まりまして、毎回100人を超える要保護児童への総合的な把握と支援方針について確認し合い、円滑な支援の実現を図るための活動を行っております"@ja.
<< kg:id_16 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "困難ケースなど、ケースに直接かかわる関係者間の情報共有や支援方針の確認が必要になった場合には、個別ケースの検討会を開催しておりまして、具体的な支援の内容等について検討しております"@ja.
<< kg:id_16 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "母子保健施策と子育て支援施策の一体的な提携を目的に開設いたしました子育て世代包括支援センターにおいては、健康課母子保健係と子ども家庭支援センターが緊密に連携し、妊娠期から出産、子育て期を通しまして"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "改札口が２カ所しかないという課題も残っており"@ja.
<< kg:id_23 prop:effect kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "東京から鶴岡までの到達時間が平均で２分、最大で９分短縮されることとなりました"@ja.
<< kg:id_23 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "現在３枚ある切符の集約化や庄内地域においてもスイカなどの交通系ＩＣカードが利用できる環境整備などについて、引き続きＪＲ東日本に対し要望してまいりたい"@ja.
<< kg:id_23 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "さらなる高速化に向けて速達型の特急いなほの新設や線路の複線化などについて要望を継続する"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "林道関係者の御協力により工事用通路のめどが立ち、山側からの作業にも着手が可能となる見込みと伺っており、来年度以降工事が速やかに進められるものと思っております"@ja.
<< kg:id_28 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "今後も早期完成に向けて引き続き関係機関と協力し、要望活動を行ってまいりたい"@ja.
<< kg:id_31 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "来年度には地元を初め関係者からさまざまな御意見をいただく機会を設けながら検討を進め、管理運営に関する計画をまとめるとともに、休憩施設の規模や配置を検討し"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "2,500メートル以上の滑走路を持たないのは東北では本県のみとなっており、国際チャーター便の誘致拡大や将来的な国際定期便の運行を図る上で大きな制約要因となっております"@ja.
<< kg:id_33 prop:effect kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "庄内―羽田便の計画提供座席数が前年比で約１万5,000席の増となるなど、明るい話題が続いているところでございます"@ja.
<< kg:id_33 prop:contermeasure kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "本市といたしましてもこの調査結果を生かしながら、県や庄内開発協議会、庄内空港利用振興協議会などとともに滑走路延長に向けた効果的な取り組みを展開してまいりたい"@ja.
<< kg:id_33 prop:contermeasure kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "羽田便の年間搭乗者数40万人とＬＣＣ就航の早期実現、定着に向けて庄内空港の利用拡大に取り組んでまいりたい"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "しかしながら、まだまだ普及しているとは言えない状況にあると認識しておるところでございまして"@ja.
<< kg:id_38 prop:contermeasure kg:id_40 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "新年度にはスポーツ課内に、仮称でございますが、オリパラホストタウン推進室を設けまして、2020年東京オリンピック・パラリンピック競技大会に向けて"@ja.
<< kg:id_41 prop:contermeasure kg:id_42 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "公開試合を開催しまして、観戦した200名の市民の皆様とともに競技体験や交流対戦も行ったところでございます"@ja.
<< kg:id_41 prop:contermeasure kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "チャレンジデーを初め市民総体、福祉体育祭やつるおか大産業まつり、それぞれの会場でボッチャ体験コーナーを設けまして"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "大学等を卒業後に鶴岡に帰り就職をするなど、一定の要件を満たせば返済を免除するといったことを想定しております"@ja.
<< kg:id_44 prop:cause kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "生徒や保護者にそうした情報が十分に伝わっていないため、地元にはやりがいのある仕事がないとの思い込みから、働き口を求めて人材が流出する要因になっている"@ja.
<< kg:id_44 prop:contermeasure kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "富山県氷見市などの例を参考に大学等を卒業後に鶴岡に帰り就職をするなど、一定の要件を満たせば返済を免除するといったことを想定しております"@ja.
<< kg:id_44 prop:contermeasure kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "奨学金の給付や返済支援だけでなく、この制度を利用する学生、若者の交流事業や地元企業のインターンシップのマッチングなども含めて地元回帰、ＵＩターンにつながるプログラムになるよう"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "学校から相談される事案として考えられる主な内容は、児童生徒の問題行動やいじめ等のいわゆる子供にかかわる問題、保護者の過度の要求や言動に対する対応"@ja.
<< kg:id_49 prop:contermeasure kg:id_51 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "教育委員会といたしましては、本市の児童生徒及び家庭や地域の実態に即した効果的な支援が実現できますよう、先進事例も参考にしながら、今申し上げましたスクールロイヤー制度の導入について前向きに検討してまいりたい"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "本市職員におきましても、職務に起因して心身の不調を訴える職員が見られ"@ja.
<< kg:id_52 prop:cause kg:id_54 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "昨今のハラスメントに対する社会的な関心が高まっている状況を踏まえますと"@ja.
<< kg:id_52 prop:contermeasure kg:id_55 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "ガイドラインにつきましては今御指摘をいただきましたとおり、できるだけ早く整備をする必要があるというふうに考えております"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "女子のチームには非常に予算が少なく、総額25万ということでユニホームをつくることもできないという現状にあります"@ja.
<< kg:id_56 prop:contermeasure kg:id_58 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "女子駅伝チームにおきましては、今の御提案ありました、いろいろ負担の関係で支援を募るというようなところも含めまして、市陸上競技協会や関係機関と連携をとりながら、今後他町との負担の分担なども含めまして、支援のあり方については検討してまいりたい"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "農業従事者が高齢化し、労働不足が懸念される中、限られた農業者で産出額の拡大を図っていくためには"@ja.
<< kg:id_59 prop:cause kg:id_61 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "主食用米の作付拡大が見込めないことから、販売単価の向上を図るとともに、非主食用米として扱われます輸出用米等の生産拡大を進めて"@ja.
<< kg:id_59 prop:contermeasure kg:id_62 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "意欲ある個別の農業経営体における規模拡大や多様な農業者が参画する集落営農などにより、地域の農地の有効活用を図りながら生産性を高めていくことを基本に進めてまいります"@ja.
<< kg:id_59 prop:contermeasure kg:id_63 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "需要が堅調で高価格で販売が期待されますブランド米のつや姫や雪若丸の生産拡大に取り組んでまいります"@ja.
<< kg:id_59 prop:contermeasure kg:id_64 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "海外で需要が見込まれ、輸出用米を中心に生産コストの削減を支援しながら、その生産拡大に取り組んでまいりたい"@ja.
<< kg:id_65 prop:cause kg:id_66 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "鳥獣被害も受けにくく、中山間地域に適する品目であるとともに、大型機械を必要とせず、栽培管理も軽作業が多いことから、まさに高齢者や女性でも取り組みやすい品目"@ja.
<< kg:id_65 prop:contermeasure kg:id_67 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "来年度からＪＡや県と連携し、朝日地域において出荷作業をＪＡに委託し、業務用よりも単価の高い規格品として市場に出荷するモデルの確立に向けた実証に取り組んでいく予定"@ja.
<< kg:id_65 prop:contermeasure kg:id_68 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "来年度から市全域を対象にニラの交付単価を10アール当たり2,000円引き上げて、２万2,000円に見直しており、農家の方のニラの導入意欲の喚起とその導入を後押ししてまいりたい"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "機械作業やハウスのビニール張りなど、高齢者にとって厳しい作業を請け負うことによって、高齢の農家の方々でも生き生きと農業を営むことができるようになる"@ja.
<< kg:id_69 prop:contermeasure kg:id_71 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "農作業を請け負うサポート隊の立ち上げにつきましては、高齢者の生きがいの場をつくる意味でも意義深いものでありますが、この取り組みを広げていくためには課題を整理しながら、農業者やＪＡの皆様との意見交換を行い、具体的な推進方策を検討していく必要がある"@ja.
<< kg:id_72 prop:cause kg:id_73 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "コミュニティセンターの管理に加え、そのような依頼事項、またそれ以外にもさまざまな調査などを初め、依頼事項も増加しているものと認識をしております"@ja.
<< kg:id_72 prop:contermeasure kg:id_74 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "今回の改正によりまして、指定管理委託料については職員分と夜警員分の要員費算定を分けまして、また交付金については要員費に当たる体制整備費の中で時間外相当に当たる部分を加算として新設するなど、算定項目を細分化しながら要員費のベースアップを図っております"@ja.
<< kg:id_72 prop:contermeasure kg:id_75 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "地域ビジョンは、これまで４組織で策定しておりまして、11組織が現在取り組んでいるところでもございます"@ja.
<< kg:id_72 prop:contermeasure kg:id_76 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "地域コミュニティにとりまして外部の力をかりながら取り組んでいくことが関係人口の増加に直結し、担い手不足の解決に間接的につながるものと考えております"@ja.
<< kg:id_77 prop:contermeasure kg:id_78 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "学校における防災教育は、各学校ごとに作成しております学校安全教育全体計画、また学校防災計画のもと、各教科や特別活動などの時間に実施されております"@ja.
<< kg:id_77 prop:contermeasure kg:id_79 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "地域やＰＴＡと協働しながら一斉下校や引き渡し訓練に取り組んでいる学校もございます"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "学校が避難所になる場合、特に開設段階においては施設の解錠、開放など、実際には教職員が対応する状況が起こることが想定されるところであります"@ja.
<< kg:id_80 prop:contermeasure kg:id_82 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "自主防災組織、地域住民、学校、市が話し合いの場を持ち、参加者の意見交換を通して避難所開設についての理解を深めますとともに、スムーズな避難所運営が行われるよう開催されている"@ja.
<< kg:id_80 prop:effect kg:id_83 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "自治会や自主防災組織の役員が交代しましても、協議で培ったノウハウを継承させていくことが課題となっております"@ja.
<< kg:id_84 prop:contermeasure kg:id_85 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "教育委員会といたしましては、これまで本市の小中学校が地域と一体となりながら行われてきた特色ある教育活動を大切にしながら、コミュニティスクール設置に向けた調査研究に取り組むとともに、市長の公約においても掲げられておりますモデル校の設置についても進めたい"@ja.
<< kg:id_86 prop:cause kg:id_87 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "今後40年間に公共施設等の更新等にかかる費用は6,800.3億円と推計されております。１年当たりの平均費用は約170億円"@ja.
<< kg:id_86 prop:contermeasure kg:id_88 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "一時的に高まる投資の需要に備えるためのものとして、下限額の目安といたしまして残高が10億円を下らないように留意してまいりたい"@ja.
<< kg:id_86 prop:contermeasure kg:id_89 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "このシステムを導入することによりまして、公共施設の更新費用や施設維持費用の試算とあわせ、施設データの見える化を図ることで公共施設等総合管理計画の実効性をより高めてまいりたい"@ja.
<< kg:id_90 prop:cause kg:id_91 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "担い手の育成、確保が大変重要な課題であるという農業者、また農業団体の声を受けまして"@ja.
<< kg:id_90 prop:cause kg:id_92 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "これを旅館やホテルに利用されるということは、特に湯野浜温泉等、地域の温泉、旅館業界の皆様からそれは困るというお話がございました"@ja.
<< kg:id_90 prop:contermeasure kg:id_93 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "旧いこいの村庄内を農業人材育成の研修拠点に改修し、首都圏等からの県外から研修生を呼び込み、本市農業の担い手の育成を図ることが望ましいという結論に至った"@ja.
<< kg:id_90 prop:contermeasure kg:id_94 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "両ＪＡや山大農学部等の関係機関、団体とも検討を深め、合意形成が整いました段階の12月定例会において、協定締結を視野に入れたプロジェクトの概要をお答えした"@ja.
<< kg:id_90 prop:effect kg:id_95 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "20年間で340人の方が就農することにより、最大で年間34億円の産出額を生み出すことになると見込まれます"@ja.
<< kg:id_96 prop:contermeasure kg:id_97 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "庄内農業高校との連携につきましては、庄内農業高校の取り組みも本プロジェクトも農業の人材を育てるという点におきましては共通する目的ございますので、県の教育委員会のお考えも伺いながら連携の可能性について検討してまいりたい"@ja.
<< kg:id_98 prop:cause kg:id_99 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "常勤医師が不在の診療科は眼科や形成外科など５診療科となっております。このうち眼科は、この４月から常勤医師が確保できる見通しとなっております。また、常勤医師が１人の診療科は４診療科"@ja.
<< kg:id_98 prop:effect kg:id_100 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "常勤医師が不在の診療科では主に出張医師による外来診療や手術、短期間の入院治療などが可能ではありますが、入院が長期にわたる専門的な治療には制約が出てまいります"@ja.
<< kg:id_98 prop:effect kg:id_101 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "心臓疾患などの手術につきましては、他の医療機関を紹介することとなりまして、１つの病院で全ての医療が完結するものから地域で完結する医療での提供となります"@ja.
<< kg:id_98 prop:contermeasure kg:id_102 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "新潟大学や山形大学を初めとする関連大学に対して医師の派遣要請を行っております"@ja.
<< kg:id_98 prop:contermeasure kg:id_103 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "平成25年度から施行しております医師就学資金貸与制度では、これまで５大学の医学生11名に就学資金の貸与を行っており"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "医師会に所属する医師の年齢層は60歳代と70歳代で約半数となっている状況にある"@ja.
<< kg:id_104 prop:effect kg:id_106 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "休日夜間診療所の当番医や介護認定審査会委員、学校医、介護施設の嘱託医などの役割について定年として免除しておるところでございますが、近年こうした役割についての要請がふえていることもございまして、対応が困難となっていくことが想定されます"@ja.
<< kg:id_107 prop:contermeasure kg:id_108 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "昨年７月から外来部門担当を10名から15名に５名増員しておりまして、入院部門担当11名を合わせて総勢26名を配置しているところでございます"@ja.
<< kg:id_109 prop:effect kg:id_110 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "医療機関や介護等の事業所双方において求人を出しても応募がなかなかないなどと、そういった状況について伺っておりまして、現場での慢性的な不足感がある"@ja.
<< kg:id_109 prop:contermeasure kg:id_111 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "本市の看護師確保対策といたしましては、鶴岡市立看護専門学校の運営や鶴岡准看護学院に対する運営助成を行っております"@ja.
<< kg:id_109 prop:contermeasure kg:id_112 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "校舎の老朽化が進みまして看護師育成、確保のために早期の建てかえが必要な状況となっております"@ja.
<< kg:id_113 prop:contermeasure kg:id_114 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "平成25年度より一般家庭や市内事業者への設備導入補助金制度を実施しております"@ja.
<< kg:id_113 prop:contermeasure kg:id_115 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "学校施設等13施設で太陽光発電設備の導入及び沿岸地の避難路やコミュニティセンター、公園など134カ所に太陽光発電によりますＬＥＤ街灯を設置"@ja.
<< kg:id_113 prop:effect kg:id_116 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "平成26年４月時点の本市の数値が3,720キロワットとなっており、平成30年９月末時点では１万4,001キロワットまで増加しております"@ja.
<< kg:id_113 prop:contermeasure kg:id_117 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "新年度の情報収集、調査事業の取り組みにつきましては、小水力発電事業の可能性をさらに調査してまいります"@ja.
<< kg:id_118 prop:contermeasure kg:id_119 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "三瀬地区の八森山において取り組まれているものでございまして、その事業者からは現在環境アセスメントの最終段階である評価書が間もなく完成するとの報告を受けております"@ja.
<< kg:id_120 prop:cause kg:id_121 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "環境上の課題が少ないとされる洋上風力発電についても今後研究を深める必要がある"@ja.
<< kg:id_120 prop:contermeasure kg:id_122 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "県が主導いたしまして、山形県地域協調型洋上風力発電研究・検討会議が立ち上げられておりまして、導入の可能性や課題について情報収集と協議がなされております。市としましても注視してまいりたい"@ja.
<< kg:id_123 prop:effect kg:id_124 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "年間少なくとも約２万4,000人以上の方が松ヶ岡に訪れているものと考えております"@ja.
<< kg:id_123 prop:contermeasure kg:id_125 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "日本遺産に認められた松ヶ岡の価値を再定義するため、絹産業が生まれるまでの歴史などを踏まえつつ、現代にも受け入れられる松ヶ岡ならではの体験メニューづくりにより、松ヶ岡の未来の姿を示し、認知されるようにすべきとの方向性が示されております"@ja.
<< kg:id_123 prop:contermeasure kg:id_126 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "学びを軸とした（仮称）松ヶ岡ビレッジ構想と、それから当面開墾150年に当たる2021年までの３カ年の取り組みをまとめることとした"@ja.
<< kg:id_123 prop:contermeasure kg:id_127 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "旅行会社に対して旅行商品化の働きかけを行っております。10月と12月にＪＲ系旅行会社から松ヶ岡開墾場を訪問する旅行商品をつくっていただき"@ja.
<< kg:id_123 prop:contermeasure kg:id_128 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "ぐるっとバスの運行ルートを見直し、鶴岡駅と羽黒山間の路線バスのバス停と松ヶ岡開墾場を結ぶコースを設定したい"@ja.
<< kg:id_123 prop:contermeasure kg:id_129 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "引き続き松ヶ岡地区の方々との情報共有、意見交換を通し、意識の醸成に取り組んでまいります"@ja.
}
