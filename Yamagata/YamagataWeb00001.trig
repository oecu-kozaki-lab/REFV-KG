PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00001> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電事業"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "イヌワシの生息に重大な影響"@ja.
kg:id_2 rdf:type cls:c_13097.
cls:c_13097 rdfs:label "生息環境影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "バードストライクの発生"@ja.
kg:id_3 rdf:type cls:c_18.
cls:c_18 rdfs:label "鳥類衝突"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "事業の取り止めも含め抜本的な事業計画の見直し"@ja.
kg:id_4 rdf:type cls:c_353.
cls:c_353 rdfs:label "計画見直し"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "計画の白紙撤回"@ja.
kg:id_5 rdf:type cls:c_1291.
cls:c_1291 rdfs:label "計画撤回"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:st_1 rdfs:label "山形県知事 吉村知事"@ja.
kg:st_1 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "イヌワシの生息と生息環境保全の観点から対応を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "知事意見を尊重した対応を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "知事意見を踏まえた対応をしてほしい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "地元自治体 米沢市"@ja.
kg:st_2 rdf:type cls:st_11.
kg:op_4 prop:content "計画の白紙撤回を事業者に申し入れている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "知事意見では、バードストライクの発生などイヌワシの生息に重大な影響を及ぼすおそれがある"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "知事意見では、バードストライクの発生などイヌワシの生息に重大な影響を及ぼすおそれがある"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "「事業の取り止めも含め抜本的な事業計画の見直し」を行うよう求めていて、吉村知事はきょうの会見で知事意見を尊重するようあらためて求めた"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "この問題をめぐっては、地元自治体の米沢市が「計画の白紙撤回」を事業者に申し入れている"@ja.
}
