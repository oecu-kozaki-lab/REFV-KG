 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "作業道整備"@ja.
kg:id_1 rdf:type cls:c_13125.
cls:c_13125 rdfs:label "作業道整備"@ja.
kg:id_2 rdfs:label "市への事前の届け出未実施"@ja.
kg:id_2 rdf:type cls:c_13126.
cls:c_13126 rdfs:label "届出未実施"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "市への届け出必要"@ja.
kg:id_3 rdf:type cls:c_13127.
cls:c_13127 rdfs:label "届出必要"@ja.
kg:id_4 rdfs:label "整備によって現状が変わる面積が3000平方メートルを超える場合"@ja.
kg:id_4 rdf:type cls:c_13128.
cls:c_13128 rdfs:label "面積超過"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "届け出未実施"@ja.
kg:id_5 rdf:type cls:c_13126.
kg:id_6 rdfs:label "事業者が当初想定していた約2600平方メートルを大きく上回っていたこと"@ja.
kg:id_6 rdf:type cls:c_1985.
cls:c_1985 rdfs:label "想定超過"@ja.
kg:id_5 prop:cause kg:id_6.
kg:id_7 rdfs:label "JR東日本エネルギー開発の申請と実際の工事の差異"@ja.
kg:id_7 rdf:type cls:c_13129.
cls:c_13129 rdfs:label "申請差異"@ja.
kg:id_8 rdfs:label "法令違反の可能性"@ja.
kg:id_8 rdf:type cls:c_13130.
cls:c_13130 rdfs:label "法令違反可能性"@ja.
kg:id_7 prop:effect kg:id_8.
kg:id_9 rdfs:label "申請より大幅に広い面積の開拓"@ja.
kg:id_9 rdf:type cls:c_13128.
kg:id_7 prop:effect kg:id_9.
kg:id_10 rdfs:label "本体工事の前倒しとして造成工事を行ったのではないかという疑念"@ja.
kg:id_10 rdf:type cls:c_13131.
cls:c_13131 rdfs:label "工事前倒し疑念"@ja.
kg:id_7 prop:effect kg:id_10.
kg:id_11 rdfs:label "米沢市"@ja.
kg:id_11 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_12 rdfs:label "詳細な現地計測"@ja.
kg:id_12 rdf:type cls:c_13132.
cls:c_13132 rdfs:label "現地計測"@ja.
kg:id_11 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "事業者に想定を上回った理由書の提出を求める"@ja.
kg:id_13 rdf:type cls:c_1005.
cls:c_1005 rdfs:label "説明要求"@ja.
kg:id_11 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "法令違反が確認された場合の適切な指導"@ja.
kg:id_14 rdf:type cls:c_13133.
cls:c_13133 rdfs:label "行政指導"@ja.
kg:id_11 prop:countermeasure kg:id_14.
kg:st_1 rdfs:label "米沢市"@ja.
kg:st_1 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "法令違反が確認されれば適切に指導する方針"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "市民の指摘を受け現場確認し想定超過を確認した"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "詳細な現地計測を行い違反確認時は指導する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_2 rdf:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_4 prop:content "申請内容と実際の開拓面積にかなりの差異があると問題視する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "風況観測用作業道の申請を使い実際は本体工事を前倒しした疑いがあるとみる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "近く詳細な現地計測を行う方針"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "想定を上回った理由の説明を事業者に求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "違反確認時は適切に指導する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "この作業道の整備について、米沢市はきのう（5日）の市議会で、景観法が定める「市への事前の届け出」を受けていなかったことを明らかにした。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "本来は、整備によって現状が変わる面積が「3000平方メートルを超える」場合、届け出が必要とされている。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "しかし、市民からの指摘を受けてことし5月、市が事業者側とともに現場を見るなどした結果、事業者が当初想定していたと説明する「約2600平方メートル」を大きく上回っていることを確認したという。"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市は、事業者に想定を上回った理由書の提出を求める一方、近く詳細な現地計測を行い、法令違反が確認された場合には適切に指導するとしている。"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "JR東日本エネルギー開発が、風況観測用の作業道の申請を米沢市に出したが、実際に開拓された面積は申請よりも大幅に超えており、かなりの差異があることが明らかとなった。"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "風況観測用の作業道として申請を出して、実際には本体工事の前倒しとして造成工事を行ったのではないか、と言う疑念がわく。"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "米沢市の栗子山で進む風力発電計画をめぐり、事業者が市に必要な届け出を行わずに作業用の道路を整備していたことがわかった。市は近く詳細な現地計測を行う方針。"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "市は、事業者に想定を上回った理由書の提出を求める一方、近く詳細な現地計測を行い、法令違反が確認された場合には適切に指導するとしている。"@ja.
<< kg:id_11 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "市は、事業者に想定を上回った理由書の提出を求める一方、近く詳細な現地計測を行い、法令違反が確認された場合には適切に指導するとしている。"@ja.
}
