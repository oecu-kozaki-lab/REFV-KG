PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00010> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "（仮称）栗子山風力発電事業計画"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "全面白紙撤回の申し入れ"@ja.
kg:id_2 rdf:type cls:c_13144.
cls:c_13144 rdfs:label "計画撤回要求"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:st_1 rdfs:label "米沢市長"@ja.
kg:st_1 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "事業計画の全面白紙撤回を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "米沢市長から全面白紙撤回の申し入れが出されました。内容は、全面白紙撤回の申し入れです。"@ja.
}
