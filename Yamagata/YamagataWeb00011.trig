PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00011> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電計画"@ja.
kg:id_1 rdf:type cls:c_12240.
cls:c_12240 rdfs:label "開発計画"@ja.
kg:id_2 rdfs:label "イヌワシへの影響"@ja.
kg:id_2 rdf:type cls:c_13145.
cls:c_13145 rdfs:label "野生鳥類への影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "市民からの不信感"@ja.
kg:id_3 rdf:type cls:c_13146.
cls:c_13146 rdfs:label "市民の不信感"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "市民への説明不足"@ja.
kg:id_4 rdf:type cls:c_84.
cls:c_84 rdfs:label "説明不足"@ja.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "景観法が定める必要な届け出をせずに作業道を整備したこと"@ja.
kg:id_5 rdf:type cls:c_13147.
cls:c_13147 rdfs:label "法令手続違反"@ja.
kg:id_1 prop:cause kg:id_5.
kg:id_6 rdfs:label "米沢市"@ja.
kg:id_6 rdf:type cls:c_13148.
cls:c_13148 rdfs:label "地方自治体"@ja.
kg:id_7 rdfs:label "計画の白紙撤回を求める"@ja.
kg:id_7 rdf:type cls:c_13144.
cls:c_13144 rdfs:label "計画撤回要求"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "山形県知事"@ja.
kg:id_8 rdf:type cls:c_13149.
cls:c_13149 rdfs:label "地方自治体首長"@ja.
kg:id_9 rdfs:label "事業の取り止めも含めた抜本的な事業計画の見直しを求める"@ja.
kg:id_9 rdf:type cls:c_13150.
cls:c_13150 rdfs:label "計画見直し要求"@ja.
kg:id_8 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "JR東日本エネルギー開発"@ja.
kg:id_10 rdf:type cls:c_2246.
cls:c_2246 rdfs:label "事業者"@ja.
kg:id_11 rdfs:label "数々の意見を総合的に検討する時間を求める"@ja.
kg:id_11 rdf:type cls:c_13151.
cls:c_13151 rdfs:label "検討時間要求"@ja.
kg:id_10 prop:countermeasure kg:id_11.
kg:st_1 rdfs:label "山形県知事 吉村知事"@ja.
kg:st_1 rdf:type cls:st_159.
cls:st_159 rdfs:label "地方自治体首長"@ja.
kg:op_1 prop:content "事業取り止めを含む抜本的見直しを求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "米沢市長 近藤市長"@ja.
kg:st_2 rdf:type cls:st_159.
kg:op_2 prop:content "市民からの不信感は変わっていない"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "市民への説明が不十分だとして白紙撤回を申し入れている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "JR東日本エネルギー開発 松本義弘社長"@ja.
kg:st_3 rdf:type cls:st_160.
cls:st_160 rdfs:label "事業者代表"@ja.
kg:op_4 prop:content "計画と実際の整備に差が出たことを謝罪"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "白紙撤回を求める姿勢は変わらない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "事業の取り止めも含め抜本的な見直しを求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "意見を総合的に検討するため時間が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "米沢市の栗子山で、JR東日本エネルギー開発が高さ168メートルの大型風車を最大10基設置する計画を立て事業を進める一方、生息する国の天然記念物のイヌワシへの影響が懸念されている。 計画をめぐっては、吉村知事が意見書の中で「事業の取り止めも含め抜本的な事業計画の見直し」を行うよう求めている"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業者からの説明を受け近藤市長は、「市民からの不信感は変わっていない」として、あらためて白紙撤回を求めたという。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "米沢市の近藤市長も「市民への説明が不十分」などとして、8月に事業者側へ計画の白紙撤回を申し入れている。"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "また、景観法が定める必要な届け出をせずに「風況ポール」を設置するための作業道を整備したことについては、「結果的に計画と実際の整備に差が出たことは大変申し訳ない」と謝罪した。"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "米沢市が事業の白紙撤回を求めている風力発電計画について、きのう（11日）事業者側が市役所を訪れ、「検討する時間がほしい」と伝えた。米沢市は「白紙撤回を求める姿勢は変わらない」としている。"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "計画をめぐっては、吉村知事が意見書の中で「事業の取り止めも含め抜本的な事業計画の見直し」を行うよう求めている"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "松本社長は、9月23日までに出される経済産業省の勧告も踏まえて結論を出したいとして「検討する時間がほしい」と伝えた。 （JR東日本エネルギー開発・松本義弘社長） 「数々の意見をいただいており、その意見を総合的に検討する時間が必要。もう少し時間をいただきたいとお話しさせていただいた」"@ja.
}
