PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00029> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "学習会"@ja.
kg:id_1 rdf:type cls:c_13286.
cls:c_13286 rdfs:label "学習会"@ja.
kg:id_2 rdfs:label "周知が間に合わなかったこと"@ja.
kg:id_2 rdf:type cls:c_1098.
cls:c_1098 rdfs:label "周知不足"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "参加人数が少なかった"@ja.
kg:id_3 rdf:type cls:c_13287.
cls:c_13287 rdfs:label "少人数参加"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "高畠町議、南陽市議の参加"@ja.
kg:id_4 rdf:type cls:c_13288.
cls:c_13288 rdfs:label "議員参加"@ja.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "米沢市だけの問題ではなく広く置賜地方全体の問題として学習会が深い内容になった"@ja.
kg:id_5 rdf:type cls:c_13289.
cls:c_13289 rdfs:label "広域的学習"@ja.
kg:id_1 prop:effect kg:id_5.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "米沢市だけの問題ではなく置賜地方全体の問題として学ぶ機会になったと評価"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "米沢市だけの問題ではなく置賜地方全体の問題として学ぶ機会になったと評価"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "周知が間に合わず、参加人数は少なかった"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "周知が間に合わず、参加人数は少なかった"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "高畠町議、南陽市議の参加により、米沢市だけの問題ではなく、広く置賜地方全体の問題として、ディープな内容の学習会となりました"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "高畠町議、南陽市議の参加により、米沢市だけの問題ではなく、広く置賜地方全体の問題として、ディープな内容の学習会となりました"@ja.
}
