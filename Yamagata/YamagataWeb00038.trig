PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00038> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電"@ja.
kg:id_1 rdf:type cls:c_999.
cls:c_999 rdfs:label "風力発電"@ja.
kg:id_2 rdfs:label "多くのものが失われる"@ja.
kg:id_2 rdf:type cls:c_13325.
cls:c_13325 rdfs:label "損失"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "人間を含むすべての生き物と植物が被害を受ける"@ja.
kg:id_3 rdf:type cls:c_6293.
cls:c_6293 rdfs:label "生物被害"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "住民への説明"@ja.
kg:id_4 rdf:type cls:c_87.
cls:c_87 rdfs:label "住民説明"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "20年の風力発電のために失われるものが多すぎる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "人間を含むすべての生き物や植物への被害を懸念している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "説明の検討中解除もされず住民説明がないことを問題視している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "たった２０年の風力発電の為に、失われるのものが多すぎる。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "そして、人間を含むすべての生き物、植物が被害を受ける。"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "住民への説明の検討中が解除されず説明なし。"@ja.
}
