PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00039> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "勉強会の開催"@ja.
kg:id_2 rdf:type cls:c_10627.
cls:c_10627 rdfs:label "勉強会開催"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "住民説明会の開催要請"@ja.
kg:id_3 rdf:type cls:c_13326.
cls:c_13326 rdfs:label "説明会要求"@ja.
kg:id_1 prop:countermeasure kg:id_3.
kg:id_4 rdfs:label "米沢の子供の未来への影響"@ja.
kg:id_4 rdf:type cls:c_13327.
cls:c_13327 rdfs:label "子供の将来"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "豊かな自然への影響"@ja.
kg:id_5 rdf:type cls:c_211.
cls:c_211 rdfs:label "自然環境"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "地域や市民との関係悪化"@ja.
kg:id_6 rdf:type cls:c_2411.
cls:c_2411 rdfs:label "関係悪化"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "事業者が説明会要請に応じないこと"@ja.
kg:id_7 rdf:type cls:c_13154.
cls:c_13154 rdfs:label "説明拒否"@ja.
kg:id_1 prop:cause kg:id_7.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "事業資料を基に様々な角度から読み解き考察するため勉強会を開く"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "我々（当会）"@ja.
kg:st_2 rdf:type cls:st_73.
kg:op_2 prop:content "市議会議員と米沢市と山形県を通じて住民説明会の開催を要請した"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "この事業について考える必要がある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "自然への影響がある可能性を踏まえて事業を考えるべきだ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "事業者には地域や市民に寄り添い良い関係を築く姿勢がない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "説明会要請に応じず検討を長引かせている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "そこで、独自に勉強会を開くことにしました。「JR東日本エネルギー開発（株）」が配布、公表している資料を元に、勉強会をします。様々な角度から資料を読み解き考察します。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "昨年１１月に、事業者である「JR東日本エネルギー開発（株）」に、市民に向けた説明会を要請しました。我々（当会）から、市議会議員、米沢市、山形県を通じ、住民説明会を開くよう要請した"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "勉強会にぜひ参加して、この事業について考えてみませんか。米沢の子供の未来と豊かな自然を考える会"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "米沢の子供の未来と豊かな自然を考える会"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "地域や市民に寄り添い、良い関係を築いていこうとする気は皆無のようです。"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "昨年１１月に、事業者である「JR東日本エネルギー開発（株）」に、市民に向けた説明会を要請しました。 我々（当会）から、市議会議員、米沢市、山形県を通じ、住民説明会を開くよう要請したものの、応じる気配はなく、永遠の検討中のまま既に４か月過ぎました。"@ja.
}
