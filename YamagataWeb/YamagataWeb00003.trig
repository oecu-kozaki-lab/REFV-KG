kg:st_1 rdfs:label "地元住民らで組織する市民団体"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "イヌワシ衝突のおそれを理由に計画に反対"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "健康被害の懸念を理由に計画に反対"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "傍聴した近隣住民"@ja.
kg:st_2 rdfs:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_3 prop:content "心配が審査会で十分明らかになっていないと懸念"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "会の有識者メンバー"@ja.
kg:st_3 rdfs:type cls:st_13.
cls:st_13 rdfs:label "有識者"@ja.
kg:op_4 prop:content "鳥や動物への影響に対しより踏み込んだ対策が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "県環境影響評価審査会 横山潤会長"@ja.
kg:st_4 rdfs:type cls:st_101.
cls:st_101 rdfs:label "審査会"@ja.
kg:op_5 prop:content "希少な生物が多い地域であり保全対策を重視すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:st_5 rdfs:label "専門家"@ja.
kg:st_5 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_6 prop:content "低周波音調査は少なく四季を通じて回数を増やすべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_5.
kg:st_6 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_6 rdfs:type cls:st_73.
kg:op_7 prop:content "住民が最も心配する点なのに調査が不十分"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_6.
kg:op_8 prop:content "鳥や動物への影響に対しより踏み込んだ対策が必要"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:st_7 rdfs:label "出席した企業の担当者"@ja.
kg:st_7 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_9 prop:content "指摘を踏まえて対策を検討したい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_7.
kg:op_10 prop:content "市民との意見交換を十分に行うよう求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "地元と事業者が意見をすり合わせて進めることが重要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "広く米沢市民を対象とした説明会を開催したい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_7.
kg:op_13 prop:content "審議会向けのアピール目的の説明会設定ではないかと疑問視"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_6.
kg:op_14 prop:content "希少生物に対する保全対策をしっかり行うべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
kg:op_15 prop:content "意見をすり合わせた上で開発するか中断するか決めることが大事"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "低周波音調査は四季を通じて回数を増やすべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:op_17 prop:content "意見への謝意のみで調査増加の明言がない"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_7.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "地元住民らで組織する市民団体は周辺に生息する国の天然記念物のイヌワシが風車に衝突する恐れや近隣住民への健康被害などを理由に、計画への反対を訴えています。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "地元住民らで組織する市民団体は周辺に生息する国の天然記念物のイヌワシが風車に衝突する恐れや近隣住民への健康被害などを理由に、計画への反対を訴えています。 傍聴した近隣住民「みんなが考えている心配がどうなのかが今回の審査会では十分クリアになっていない。懸念は懸念と言い続ける」"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "会の有識者メンバーは鳥や動物への影響に対し、より踏み込んだ対策が必要、住民と十分な意見交換をすべきーなどと指摘しました。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "希少な生物が多い地域でもあるので、それに対する保全対策をしっかりやってくださいということが基本。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "低周波音の調査が、秋に2回しかされていない。住民が1番心配しているところなので、もっと四季を通じて回数を調査するように。との指摘に、"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:text-txt_contents "事業を行う企業が提出した環境への影響や対策に対する審査会が10日、山形市で開かれました。"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "会の有識者メンバーは鳥や動物への影響に対し、より踏み込んだ対策が必要、住民と十分な意見交換をすべきーなどと指摘しました。出席した企業の担当者は、対策については、指摘を踏まえて検討したい"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "会の有識者メンバーからは市民との意見交換を十分に行うよう求める意見が出されました。 地元の方と事業者が同じ方向を向いて進んでいけるようにお互いの意見をしっかりとすり合わせて開発を行うなら行うし、計画を中断するなら中断するということを決めていくことが大事"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "出席した企業の担当者は、対策については、指摘を踏まえて検討したい、広く米沢市民を対象とした説明会を開催したいーなどと応じました。 また、JR東日本エネルギー開発は8月4日と5日に米沢市で住民説明会を開く予定です。"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "希少な生物が多い地域でもあるので、それに対する保全対策をしっかりやってくださいということが基本。"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "地元の方と事業者が同じ方向を向いて進んでいけるようにお互いの意見をしっかりとすり合わせて開発を行うなら行うし、計画を中断するなら中断するということを決めていくことが大事"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "低周波音の調査が、秋に2回しかされていない。住民が1番心配しているところなので、もっと四季を通じて回数を調査するように。との指摘に、 「ご意見ありがとうございます。」 だけ。たった一言で終わりました。回数を増やすとも、調査するとも言わない。"@ja.
}
