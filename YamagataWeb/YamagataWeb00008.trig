kg:id_8 rdf:type cls:c_13135.
kg:id_6 prop:effect kg:id_8.
kg:id_9 rdfs:label "米沢市長から計画の白紙撤回を申し入れられた"@ja.
kg:id_9 rdf:type cls:c_13134.
kg:id_6 prop:effect kg:id_9.
kg:id_10 rdfs:label "地元自治体から強い反対の声が上がった"@ja.
kg:id_10 rdf:type cls:c_1290.
cls:c_1290 rdfs:label "反対意見"@ja.
kg:id_6 prop:effect kg:id_10.
kg:id_11 rdfs:label "来年7月まで月1回のペースで追加の生息調査を実施する"@ja.
kg:id_11 rdf:type cls:c_13136.
cls:c_13136 rdfs:label "生息調査"@ja.
kg:id_6 prop:contermeasure kg:id_11.
