kg:id_12 rdf:type cls:c_87.
cls:c_87 rdfs:label "住民説明"@ja.
kg:id_6 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "専門家に対し引き続きアドバイスを求める"@ja.
kg:id_13 rdf:type cls:c_3781.
cls:c_3781 rdfs:label "専門家助言"@ja.
kg:id_6 prop:contermeasure kg:id_13.
kg:id_14 rdfs:label "白紙撤回の申し入れに対する回答を速やかに行うよう求める"@ja.
kg:id_14 rdf:type cls:c_13137.
cls:c_13137 rdfs:label "回答要求"@ja.
kg:id_6 prop:contermeasure kg:id_14.
kg:st_1 rdfs:label "JR東日本エネルギー開発の担当者"@ja.
kg:st_1 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "現時点で撤退せず事業継続の考えを示す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "環境保護団体など"@ja.
kg:st_2 rdfs:type cls:st_158.
cls:st_158 rdfs:label "環境団体"@ja.
kg:op_2 prop:content "不適切な生息調査を理由に中止を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "米沢市の近藤市長"@ja.
kg:st_3 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_3 prop:content "住民の不安や不信感を理由に白紙撤回を申し入れる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:st_4 rdfs:label "山形県と米沢市"@ja.
kg:st_4 rdfs:type cls:st_11.
kg:op_4 prop:content "事業の中止や見直しを求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_4.
kg:st_5 rdfs:label "吉村知事"@ja.
kg:st_5 rdfs:type cls:st_11.
kg:op_5 prop:content "中止も含めた抜本的な見直しを要求する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_5.
kg:op_6 prop:content "計画の白紙撤回を申し入れる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:st_6 rdfs:label "新庄市の専門家"@ja.
kg:st_6 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_7 prop:content "地元自治体の強い反対により継続は困難ではないかと指摘する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_6.
kg:st_7 rdfs:label "JR東日本エネルギー開発"@ja.
kg:st_7 rdfs:type cls:st_1.
kg:op_8 prop:content "追加の生息調査を継続して進める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_7.
kg:op_9 prop:content "地元住民への説明を徹底し信頼を得たい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_7.
kg:op_10 prop:content "専門家の助言を受けながら対応を進めたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_7.
kg:st_8 rdfs:label "米沢市"@ja.
kg:st_8 rdfs:type cls:st_11.
kg:op_11 prop:content "白紙撤回要請への回答を早急に行うよう求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_8.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "JR東日本エネルギー開発の担当者は「八方ふさがりという感覚は持っておらず、現時点で撤退は考えていない」と述べ、事業を継続する考えを示したという。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業者側が行ったイヌワシの生息調査は「極めて不適切」だとして環境保護団体などが中止を求め"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "米沢市の近藤市長も、住民の間に広がる不安や不信感などを理由に「計画の白紙撤回」を申し入れた。"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "米沢市の栗子山で進む風力発電事業をめぐって、県と米沢市が、中止や見直しを求めた"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "吉村知事も8月に「中止も含めた計画の抜本的な見直し」を要求。"@ja.
<< kg:id_6 prop:effect kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "米沢市の近藤市長も、住民の間に広がる不安や不信感などを理由に「計画の白紙撤回」を申し入れた。"@ja.
<< kg:id_6 prop:effect kg:id_10 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "新庄市の専門家は、「地元自治体から強い反対の声が上がった以上、事業を継続するのは困難ではないか」と詰め寄った"@ja.
<< kg:id_6 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "「来年7月まで月1回のペースで追加の生息調査を実施する計画を立て、先月から進めている。"@ja.
<< kg:id_6 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "地元住民への説明も今後しっかり行い、信頼を得ていきたい」などと述べ"@ja.
<< kg:id_6 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "専門家に対し引き続きアドバイスを求めたという。"@ja.
<< kg:id_6 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "米沢市は、JR東日本エネルギー開発の松本義弘社長に対し、白紙撤回の申し入れに対する回答を速やかに行うよう求めている。"@ja.
}
