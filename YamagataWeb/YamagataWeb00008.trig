kg:id_3 prop:cause kg:id_5.
kg:id_6 rdfs:label "（仮称）栗子山風力発電事業"@ja.
kg:id_6 rdf:type cls:c_552.
kg:id_7 rdfs:label "県と米沢市から中止や見直しを求められた"@ja.
kg:id_7 rdf:type cls:c_13135.
cls:c_13135 rdfs:label "事業見直し要求"@ja.
