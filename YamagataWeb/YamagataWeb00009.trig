kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "事業は一部の人だけに共有されて始まり問題があったとみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "JR東日本エネルギー開発"@ja.
kg:st_2 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_2 prop:content "採算がとれないため断念したと説明"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "真摯に対応する精査の結果スケジュール遅延を見込んだ"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "追加対応によりコスト増が見込まれるため事業継続は困難と判断"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "米沢市 近藤洋介市長"@ja.
kg:st_3 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_5 prop:content "勧告を受けた素早い決定で適切だったと評価"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:st_4 rdfs:label "日本イヌワシ研究会メンバーで猛きん類専門家 今井正"@ja.
kg:st_4 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_6 prop:content "地元住民の反対活動により栗子山のイヌワシを守れたと受け止める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:op_7 prop:content "住民の理解を得られなかったことを重く受け止める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "知事や市長の厳しい指摘と地元住民の粘り強い反対活動が成果につながったと評価"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "追加調査に対応すると年単位の遅延が見込まれると説明"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "追加調査対応でコスト増が見込まれると説明"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "地元との合意形成に甘さがあったと批判"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "市民への説明が不十分だったとして白紙撤回を求めた"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:st_5 rdfs:label "山形県 吉村知事"@ja.
kg:st_5 rdfs:type cls:st_11.
kg:op_13 prop:content "中止を含めた計画の見直しを求めた"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:op_14 prop:content "市民への説明が不十分として計画の白紙撤回を申し入れた"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "最後まで住民無視だったと批判"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "JR東日本エネルギー開発による（仮称）栗子山風力発電事業は、昨年９月末のイヌワシの改ざん問題で事業が停止しました。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "JR東日本エネルギー開発は27日、米沢市の栗子山で計画していた風力発電事業を断念すると発表した。国の勧告を受け「採算がとれない」との判断。"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "今回の事業断念はこの勧告を踏まえたもので、「真摯に対応すべく精査を行ってきたが、スケジュールの大幅な遅延とコストの増大が見込まれる」として、事業の採算がとれなくなったことを理由に挙げている。"@ja.
<< kg:id_3 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今回の事業断念はこの勧告を踏まえたもので、「真摯に対応すべく精査を行ってきたが、スケジュールの大幅な遅延とコストの増大が見込まれる」として、事業の採算がとれなくなったことを理由に挙げている。"@ja.
<< kg:id_3 prop:cause kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、経済産業大臣は9月19日付けで、事業者が提出した環境影響評価の準備書に対する「勧告」を行い、複数の専門家などで構成する協議会を新たに設置し、地元住民に対し協議内容の公表と説明を十分行うよう求めていた。今回の事業断念はこの勧告を踏まえたもので"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:text-txt_contents "JR東日本エネルギー開発による（仮称）栗子山風力発電事業は、昨年９月末のイヌワシの改ざん問題で事業が停止しました。"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "この事業は、米沢市の栗子山に大型風車を最大10基建設する計画で、計画地近くに生息する国の天然記念物のイヌワシへの影響が懸念されていた。"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "山形新聞の取材に同社は「住民の理解を得られなかったことを重く受け止める。追加調査に対応すると、年単位でのスケジュール遅延やコスト増が見込まれ、事業が成り立たずに中止を決定した」とした。"@ja.
<< kg:id_8 prop:effect kg:id_12 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "知事や米沢市長が事業のあり方を厳しく指摘し、何より地元住民の粘り強い反対活動の成果。"@ja.
<< kg:id_8 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "追加調査に対応すると、年単位でのスケジュール遅延やコスト増が見込まれ、事業が成り立たずに中止を決定した"@ja.
<< kg:id_8 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "追加調査に対応すると、年単位でのスケジュール遅延やコスト増が見込まれ、事業が成り立たずに中止を決定した"@ja.
<< kg:id_8 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "地元との合意形成に甘さ"@ja.
<< kg:id_8 prop:contermeasure kg:id_16 >>
    prop:text-txt_contents "複数の専門家などで構成する協議会を新たに設置し"@ja.
<< kg:id_8 prop:contermeasure kg:id_17 >>
    prop:text-txt_contents "地元住民に対し協議内容の公表と説明を十分行うよう求めていた。"@ja.
<< kg:id_8 prop:contermeasure kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "地元住民に対し協議内容の公表と説明を十分行うよう求めていた。"@ja.
<< kg:id_8 prop:contermeasure kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "これまでに吉村知事が意見書で「中止を含めた計画の見直し」を求め"@ja.
<< kg:id_8 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "米沢市の近藤市長も「市民への説明が不十分」などとして、計画の白紙撤回を申し入れていた。"@ja.
<< kg:id_8 prop:contermeasure kg:id_21 >>
    prop:text-txt_contents "今月19日付の大臣勧告は、住民への丁寧な説明や工事計画の見直し、イヌワシに関する追加調査などを求めた。"@ja.
<< kg:id_8 prop:contermeasure kg:id_22 >>
    prop:text-txt_contents "今月19日付の大臣勧告は、住民への丁寧な説明や工事計画の見直し、イヌワシに関する追加調査などを求めた。"@ja.
<< kg:id_8 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "今月19日付の大臣勧告は、住民への丁寧な説明や工事計画の見直し、イヌワシに関する追加調査などを求めた。"@ja.
<< kg:id_8 prop:contermeasure kg:id_24 >>
    prop:text-txt_contents "同社は事業廃止に向けた手続きを行う。"@ja.
}
