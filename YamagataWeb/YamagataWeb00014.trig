PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00014> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "再生可能エネルギーゾーニングマップ"@ja.
kg:id_1 rdf:type cls:c_13158.
cls:c_13158 rdfs:label "地図"@ja.
kg:id_2 rdfs:label "再生可能エネルギーの導入が可能なエリアや環境保全を優先するエリアを地図に設定"@ja.
kg:id_2 rdf:type cls:c_13159.
cls:c_13159 rdfs:label "区域設定"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "再エネ施設建設"@ja.
kg:id_3 rdf:type cls:c_310.
cls:c_310 rdfs:label "施設建設"@ja.
kg:id_4 rdfs:label "土砂災害防止や水源の涵養に関わる保安林への影響"@ja.
kg:id_4 rdf:type cls:c_13160.
cls:c_13160 rdfs:label "保安林"@ja.
kg:id_3 prop:effect kg:id_4.
kg:id_5 rdfs:label "農業振興地域への影響"@ja.
kg:id_5 rdf:type cls:c_13161.
cls:c_13161 rdfs:label "農業地域"@ja.
kg:id_3 prop:effect kg:id_5.
kg:id_6 rdfs:label "再エネゾーニングマップ"@ja.
kg:id_6 rdf:type cls:c_13158.
kg:id_7 rdfs:label "野鳥、昆虫、植物のみを調査し哺乳類も魚類も調査していないこと"@ja.
kg:id_7 rdf:type cls:c_124.
cls:c_124 rdfs:label "調査不足"@ja.
kg:id_6 prop:cause kg:id_7.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "説明会にみんなで行くよう呼びかける"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "保安林を調整エリアとすることに疑問を示す"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "食料自給率向上が必要なのに農業振興地域を調整エリアとすることに疑問を示す"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "生態系保全の調査が不十分だと懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "再生可能エネルギーゾーニングマップとは・・法令や自然環境、社会環境などの情報に基づいて、再生可能エネルギーの導入が可能なエリアや環境保全を優先するエリアなどを地図に設定したものです。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "土砂災害防止や水源の涵養の役割のある「保安林」が、「調整エリア」(所定の手続きで再エネ施設建設可能)なのは、どう思われますか？"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "食料自給率を上げないといけないのに「農業振興地域」も「調整エリアです」"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "生態系の保全と言いつつ、調査したのは野鳥、昆虫、植物のみ。哺乳類も魚類調査していません。"@ja.
}
