 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電事業"@ja.
kg:id_1 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "自然環境や動植物の生態系への影響"@ja.
kg:id_2 rdf:type cls:c_211.
cls:c_211 rdfs:label "自然環境"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "イヌワシなど絶滅危惧種の生息域の保全への影響"@ja.
kg:id_3 rdf:type cls:c_13162.
cls:c_13162 rdfs:label "生息域保全"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "地盤土壌等の保全と安全性への影響"@ja.
kg:id_4 rdf:type cls:c_13163.
cls:c_13163 rdfs:label "安全性"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "超低周波音の人身体等への影響"@ja.
kg:id_5 rdf:type cls:c_13164.
cls:c_13164 rdfs:label "人体影響"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "景観の保全への影響"@ja.
kg:id_6 rdf:type cls:c_583.
cls:c_583 rdfs:label "景観保全"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "米沢市"@ja.
kg:id_7 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_8 rdfs:label "広報よねざわを活用した米沢市民への周知徹底"@ja.
kg:id_8 rdf:type cls:c_5094.
cls:c_5094 rdfs:label "周知徹底"@ja.
kg:id_7 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "計画の白紙撤回"@ja.
kg:id_9 rdf:type cls:c_1291.
cls:c_1291 rdfs:label "計画撤回"@ja.
kg:id_1 prop:contermeasure kg:id_9.
kg:id_10 rdfs:label "このまち"@ja.
kg:id_10 rdf:type cls:c_13165.
cls:c_13165 rdfs:label "地域"@ja.
kg:id_11 rdfs:label "このまちに合った他の再生可能エネルギー事業の道を探る"@ja.
kg:id_11 rdf:type cls:c_4057.
cls:c_4057 rdfs:label "再エネ事業"@ja.
kg:id_10 prop:contermeasure kg:id_11.
kg:st_1 rdfs:label "佐野洋平"@ja.
kg:st_1 rdfs:type cls:st_161.
cls:st_161 rdfs:label "個人"@ja.
kg:op_1 prop:content "自然環境や生態系への悪影響がないと言い切れないため反対"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "絶滅危惧種の生息域への悪影響がないと言い切れないため反対"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地盤土壌や安全性への悪影響がないと言い切れないため反対"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "超低周波音の人体への悪影響がないと言い切れないため反対"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "景観への悪影響がないと言い切れないため反対"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "米沢市民に対して事業の周知徹底に努めてほしい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市民団体"@ja.
kg:st_2 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_7 prop:content "計画の白紙撤回を求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "このまちに合った他の再生可能エネルギー事業を探るべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "この栗子山風力発電事業に対して、自然環境や動植物の生態系への影響"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "特にイヌワシなど絶滅危惧種の生息域の保全"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "地盤土壌等の保全と安全性"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "超低周波音の人身体等への影響"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "景観の保全"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "米沢市には、栗子山風力発電事業について、米沢市民に対して広報よねざわを活用するなどして、周知徹底に努めてほしい"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "計画の白紙撤回を・・・栗子山の風力発電計画への反対署名を市民団体が米沢市に提出"@ja.
<< kg:id_10 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "したがってこのまちに合った他の再生可能エネルギー事業の道を探るべきです"@ja.
}
