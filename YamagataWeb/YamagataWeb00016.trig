kg:id_18 rdfs:label "米沢市の生死を決める米沢市のグランドデザインが計画される"@ja.
kg:id_18 rdf:type cls:c_6625.
cls:c_6625 rdfs:label "都市計画"@ja.
kg:id_13 prop:effect kg:id_18.
kg:st_1 rdfs:label "佐野洋平"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "予算額20億1,228千円の必達を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "予算額20億1,228千円の必達を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "プロ事業者の力を借りて目標達成を図るべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "プロ事業者の力を借りる意味がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "市民は事実を知り判断すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "悔いのない恥ずかしくない判断をしたい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "具体的メリットが示されていない点を重く見る"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_2 rdfs:label "開発事業者"@ja.
kg:st_2 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_8 prop:content "選定理由は風況が良いこと"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "選定理由は規制がないこと"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "米沢市のパートナーとしてプロ事業者を選定した"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "市民には一層の関心と監督を求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "米沢市の生死を決めるグランドデザインになる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "市民には一層の関心と監督をお願いしたい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "この本年度予算は、歳入を見込んでの予算組ですので、かわら版No.37に記載の通り、未達成の場合には“予算に穴があく”わけです。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "したがって、このままの推移だと予算に穴があき、財源不足となります。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "「寄付件数は前年同月比30％増、寄付額は前年同時期並」とのことです。したがって、このままの推移だと予算に穴があき、財源不足となります。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "米沢市は、先日6月27日、米沢市ふるさと納税事務支援業務委託公募型プロポーザルを実施し、その結果ふるさと納税事業の支援委託先をシフトプラス株式会社（本社大阪府大阪市）に決定しています。"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "その結果ふるさと納税事業の支援委託先をシフトプラス株式会社（本社大阪府大阪市）に決定しています。想定上限委託料は9405万円です。この意味は、言わばプロ事業者の力を借りるわけです。"@ja.
<< kg:id_7 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、市民全体に向けた説明会を、主催：JR東日本エネルギー開発株式会社・協力：米沢市市民環境部環境課で実施します。"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "これは米沢の未来にとってとても重要な事です。"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "なお、開発事業者の米沢市議会で実施された説明会の内容では、栗子山風力発電事業による米沢市に対する具体的なメリットは提示されておりません。"@ja.
<< kg:id_7 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "栗子山であるこだわりはなく、選定理由は、「風況が良く、規制がないから」とのことでした。"@ja.
<< kg:id_7 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "栗子山であるこだわりはなく、選定理由は、「風況が良く、規制がないから」とのことでした。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:text-txt_contents "これは、現在の米沢市まちづくり総合計画が、令和7年度をもって計画期間の満了を迎えるため、令和8年度以降の長期的・計画的な視野に立った持続可能な新たなまちづくりの指針となる次期総合計画を策定する必要があるため"@ja.
<< kg:id_13 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "業務委託先は、株式会社ジャパンインターナショナル総合研究所（本社京都府京都市）です。"@ja.
<< kg:id_13 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "令和8年度以降の長期的・計画的な視野に立った持続可能な新たなまちづくりの指針となる次期総合計画を策定する必要があるため"@ja.
<< kg:id_13 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "令和８年度以降は、期間は計画上10年間、当該総合計画に基づき米沢市のまりづくりが実施されます。"@ja.
<< kg:id_13 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "米沢市の生死を決める、米沢市のグランドデザインが、これから来年度にわたり計画されます。米沢市民の皆様には、一層の関心と監督をお願いしたいと思います。"@ja.
}
