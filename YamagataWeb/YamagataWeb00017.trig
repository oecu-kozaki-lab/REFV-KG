kg:id_1 rdfs:label "栗子山風力発電事業"@ja.
kg:id_1 rdf:type cls:c_6284.
cls:c_6284 rdfs:label "開発事業"@ja.
kg:id_2 rdfs:label "全面白紙撤回の申し入れ"@ja.
kg:id_2 rdf:type cls:c_13173.
cls:c_13173 rdfs:label "撤回要請"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "局面の大きな変化"@ja.
kg:id_3 rdf:type cls:c_13174.
cls:c_13174 rdfs:label "状況変化"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "米沢市民への事業内容の周知不足"@ja.
kg:id_4 rdf:type cls:c_1098.
cls:c_1098 rdfs:label "周知不足"@ja.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "情報の見える化と内容理解と重み付け化の不足"@ja.
kg:id_5 rdf:type cls:c_84.
cls:c_84 rdfs:label "説明不足"@ja.
kg:id_1 prop:cause kg:id_5.
kg:id_6 rdfs:label "山形県と米沢市と米沢市議会と米沢市民の興味や関心や課題意識の惹起"@ja.
kg:id_6 rdf:type cls:c_13175.
cls:c_13175 rdfs:label "関心喚起"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "事業者による全体説明会の開催"@ja.
kg:id_7 rdf:type cls:c_94.
cls:c_94 rdfs:label "説明会開催"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "米沢市民の知る権利と情報共有の拡大"@ja.
kg:id_8 rdf:type cls:c_156.
cls:c_156 rdfs:label "情報共有"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "情報の見える化"@ja.
kg:id_9 rdf:type cls:c_11.
cls:c_11 rdfs:label "情報公開"@ja.
kg:id_1 prop:contermeasure kg:id_9.
kg:id_10 rdfs:label "内容の理解の促進"@ja.
kg:id_10 rdf:type cls:c_4449.
cls:c_4449 rdfs:label "理解促進"@ja.
kg:id_1 prop:contermeasure kg:id_10.
kg:id_11 rdfs:label "何が大事なのかの重み付け化"@ja.
kg:id_11 rdf:type cls:c_13176.
cls:c_13176 rdfs:label "重要度整理"@ja.
kg:id_1 prop:contermeasure kg:id_11.
kg:id_12 rdfs:label "説明責任を果たすこと"@ja.
kg:id_12 rdf:type cls:c_6354.
cls:c_6354 rdfs:label "説明責任"@ja.
kg:id_1 prop:contermeasure kg:id_12.
kg:id_13 rdfs:label "正しい手続きと正しい内容を満たす判断"@ja.
kg:id_13 rdf:type cls:c_13177.
cls:c_13177 rdfs:label "適正判断"@ja.
kg:id_1 prop:contermeasure kg:id_13.
kg:st_1 rdfs:label "佐野洋平"@ja.
kg:st_1 rdfs:type cls:st_161.
cls:st_161 rdfs:label "個人"@ja.
kg:op_1 prop:content "全面白紙撤回の申し入れでこの案件の局面は大きく変わった"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "全面白紙撤回の申し入れでこの案件の局面は大きく変わった"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "なぜいまだに米沢市民に十分に事業内容が周知されていないのかが課題だ"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "情報の見える化だけでなく内容理解と重み付け化が必要だ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "市民有志の署名活動や勉強会が関係者の興味や関心や課題意識を高めた"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "市民有志の活動が事業者による全体説明会の開催につながった"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "市民有志の活動は市民の知る権利と情報共有の拡大に大きく寄与した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "情報の見える化をしっかり発信するべきだ"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "内容の理解が進むよう発信するべきだ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "何が大事なのかを重み付けして示すべきだ"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "説明責任を果たすことが重要だ"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "正しい判断には正しい手続きと正しい内容が大切だ"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "令和6年8月30日に米沢市長から事業者に対して事業の全面白紙撤回の申し入れが行われました"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "米沢市長の（仮称）栗子山風力発電事業計画の全面白紙撤回を申し入れにより、この案件に関する局面は大きく変わったと言っていいと思います"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "一言でいえば、なぜ、いまだに米沢市民に十分に事業内容が周知されていないのか？"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "つまり、情報の見える化はもちろん、それだけでなく内容の理解（わかる化）、そして何が大事なのか（重み付け化）することで説明責任（※アカウンタビリティ）が果たされるということです"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "米沢市民の有志の方々による署名活動や勉強会などが、山形県、米沢市、米沢市議会、米沢市民の興味や関心や課題意識を惹起し"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "米沢市民の有志の方々による署名活動や勉強会などが、事業者による全体説明会の開催など"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "広く米沢市民の知る権利と情報共有の拡大に大きく寄与されたことと思います"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "情報の見える化はもちろん"@ja.
<< kg:id_1 prop:contermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "それだけでなく内容の理解（わかる化）"@ja.
<< kg:id_1 prop:contermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "そして何が大事なのか（重み付け化）"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "説明責任（※アカウンタビリティ）が果たされるということです"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "行政課題を結論づけ判断する場合、手続きの正統性と内容の正当性、この２つを満たすことが、近現代の法治国家の大きな準則（ルール）です。正しい判断には、正しい手続きと正しい内容が大切なのです"@ja.
}
