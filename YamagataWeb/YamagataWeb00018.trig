cls:c_2176 rdfs:label "事業中止"@ja.
kg:id_1 prop:contermeasure kg:id_33.
kg:st_1 rdfs:label "山形県知事"@ja.
kg:st_1 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "谷筋の大規模盛土による土石流発生を懸念し事業見直しを求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地すべり地形の存在から本工事に伴う地すべり発生を懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "土砂災害の懸念があるとして必要な調査対策を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "イヌワシ保全上の重大な懸念から事業取りやめを含む見直しを求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市民環境部長"@ja.
kg:st_2 rdfs:type cls:st_11.
kg:op_5 prop:content "希少猛禽類など生物多様性の関係で非常に重要な環境面の大きな課題と認識する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "日本イヌワシ研究会"@ja.
kg:st_3 rdfs:type cls:st_162.
cls:st_162 rdfs:label "研究団体"@ja.
kg:op_6 prop:content "計画地の尾根一帯はイヌワシの重要な狩場であり中止を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "対象区域近傍で営巣している蓋然性が高く重大な懸念がある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "計画地周辺には複数のイヌワシ営巣地が存在すると指摘する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:st_4 rdfs:label "米沢市長"@ja.
kg:st_4 rdfs:type cls:st_11.
kg:op_9 prop:content "本市の自然や環境への不可逆的な影響を懸念し進めるべきでないと判断する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "自然や景観との調和が図れず全面撤回を求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:st_5 rdfs:label "建設部長"@ja.
kg:st_5 rdfs:type cls:st_11.
kg:op_11 prop:content "現在の内容ではスカイラインに突出している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_5.
kg:op_12 prop:content "精神文化との調和も含め総合的に問題があると判断する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "市民や専門家の懸念が解決されないままでは後戻りできない恐れがある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "作業道開発により生態系が失われたと指摘する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "作業道開発によりイヌワシの採食地と狩場が失われたと指摘する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "大規模盛土が土石流発生の要因になると懸念する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "地すべり地形の存在が工事時の地すべり発生要因になると指摘する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "重要な狩場となる尾根一帯の開発が生物多様性への悪影響を招く"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "作業道開発が生態系とイヌワシの狩場喪失の原因となった"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "事業者は懸念に誠実かつ丁寧に説明しておらず住民理解を得られていない"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "説明会は本市の意向に沿わず回答にも誠意が感じられなかった"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "本市や住民との協力関係を構築する意欲が欠けていると受け止める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "協力関係を構築する意欲が欠けていると捉える"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "無届けでの行為の着手案件の可能性があり適切に指導したい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "イヌワシ保全や災害懸念から事業取りやめを含む見直しを求める"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "必要性や不可逆性などを総合的に検討し全面白紙撤回を求める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "住民理解のため事業者は説明責任を果たすべきだ"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "住民理解が得られていないため早期の追加説明会開催を求める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "追加説明会の開催を事業者に求めた"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "説明の透明性確保のため会議録公開を求める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "準備書会議録の公開を求めた"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "地域貢献の具体策を提示するよう求める"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "本市への裨益地域貢献を具体的に示すよう要請した"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:st_6 rdfs:label "産業部長"@ja.
kg:st_6 rdfs:type cls:st_11.
kg:op_34 prop:content "伐採跡確認を受け是正指導し県への計画書提出を求めた"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "3,000㎡を超えた経緯について理由書提出を求める"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "非常に遺憾であり景観法に基づいて是正行政指導していきたい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "生物多様性の評価は専門家や県や国の判断を踏まえて進めたい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "自然再興の観点も含め今後の制度や対応を検討したい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:st_7 rdfs:label "市長"@ja.
kg:st_7 rdfs:type cls:st_11.
kg:op_39 prop:content "再エネ特措法で事業者に情報公開させることが重要だ"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_7.
kg:op_40 prop:content "市が当事者性を持つため強制力を持つ措置を研究する必要がある"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_7.
kg:op_41 prop:content "イヌワシの重要な狩場保全のため事業中止を求める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "令和6年（2024年）8月26日の山形県知事意見では、谷筋の大規模盛土の土砂崩壊による土石流の発生"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "対象事業実施区域内に地すべり地形が存在することから、本工事に伴う地すべりの発生"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "土砂災害の懸念"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "対象事業実施区域内は、絶滅が危惧される二ホンイヌワシの飛翔が多数確認され、重要な採食地・狩場になっており"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "対象事業実施区域近傍で営巣している蓋然性が高い"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本市の自然や環境景観安全性、さらには本市への地域益など総合的に熟慮検討した結果、本市としては本事業をこのまま進めるべきではない"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本市の自然や環境、景観、精神文化との調和"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本市の自然や環境、景観、精神文化との調和"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "市民や専門家からの懸念や指摘リスクが完全に解決されない場合に起きてからでは後戻りできない状況に陥る恐れのある不可逆性"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "栗子山の山稜・尾根の一部は、すでに作業道として開発され、生態系とイヌワシの採食地・狩場は失われました"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "栗子山の山稜・尾根の一部は、すでに作業道として開発され、生態系とイヌワシの採食地・狩場は失われました"@ja.
<< kg:id_1 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "谷筋の大規模盛土の土砂崩壊による土石流の発生"@ja.
<< kg:id_1 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "対象事業実施区域内に地すべり地形が存在することから、本工事に伴う地すべりの発生"@ja.
<< kg:id_1 prop:cause kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "風力発電機を設置する計画の尾根一帯は、強風と多雪によって形成された土地的極相である草原性の自然植生が広がっており、イヌワシの重要な狩場となっています"@ja.
<< kg:id_1 prop:cause kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "栗子山の山稜・尾根の一部は、すでに作業道として開発され、生態系とイヌワシの採食地・狩場は失われました"@ja.
<< kg:id_1 prop:cause kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "住民からの事業計画に対する様々な意見や事業への懸念に対し誠実かつ丁寧に説明してきたとは言えず住民の理解が得られたとは言い難い"@ja.
<< kg:id_1 prop:cause kg:id_18 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "同事業者には本市や住民との協力関係を構築する意欲がかけていると受け止めております"@ja.
<< kg:id_1 prop:cause kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "事業者から出来型計測の結果が示され作業道の面積が3,000㎡を超えているとの報告を受けた"@ja.
<< kg:id_1 prop:contermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "事業の取止めも含め、抜本的な事業計画の見直しを求められています"@ja.
<< kg:id_1 prop:contermeasure kg:id_21 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "米沢市長は、当該事業の必要性や不可逆性、本市の自然や環境、景観、精神文化との調和、本市への地域裨益などを総合的に熟慮・検討した結果として、当該事業の全面白紙撤回を求めました"@ja.
<< kg:id_1 prop:contermeasure kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "事業者として説明責任を果たすよう求めてまいりました"@ja.
<< kg:id_1 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "翌8月6日に事業者に対して早期に追加説明会を開催すること"@ja.
<< kg:id_1 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "準備書会議録の公開を文書で"@ja.
<< kg:id_1 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "本市への地域貢献内容の提案を具体的な地域貢献の内容を具体的に提案するよう求めてまいりました"@ja.
<< kg:id_1 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "小規模林地開発計画書を県へ提出するよう事業者に対して是正指導を実施し、本年7月30日に提出されたことを確認しております"@ja.
<< kg:id_1 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "事業者に対し3,000㎡を超えた経緯について理由書の提出を求めております"@ja.
<< kg:id_1 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "今後は、理由書を求め、景観法に基づいて是正行政指導をしていきたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "専門家、県、国に頼らざるをえない。皆様から頂いたご懸念などをしっかりと伝えながら専門家による判断を仰ぎつつこの事業について評価をしてまいりたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "本市としてネーチャーポジティブ（自然再興）と合わせて今後検討してまいりたい"@ja.
<< kg:id_1 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "再エネ特措法で事業者に情報公開させることが重要である"@ja.
<< kg:id_1 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "市においてもある程度強制力を持つ何かの措置は研究しなければいけない"@ja.
<< kg:id_1 prop:contermeasure kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "日本イヌワシ研究会「（仮称）栗子山風力発電事業の中止を求める要望書」"@ja.
}
