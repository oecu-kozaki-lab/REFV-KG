kg:st_1 rdfs:label "米沢市議会議員 佐野洋平"@ja.
kg:st_1 rdfs:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "市民有志の活動が白紙撤回のきっかけになった"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "報道が活動の認知を広げ白紙撤回につながった"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "市民と議員の巻き込みが事業断念の要素になった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "市民全体への説明会も事業断念の総合要素に含まれる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "市長の全面白紙撤回申し入れが事業断念を後押しした"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "当会会長"@ja.
kg:st_2 rdfs:type cls:st_163.
cls:st_163 rdfs:label "団体代表"@ja.
kg:op_6 prop:content "イヌワシなどの保全対策が不十分で計画中断も必要とした"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "県知事意見などの厳しい判断が相次いだ"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "環境大臣意見などの厳しい判断が相次いだ"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "経済産業大臣勧告などの厳しい判断が相次いだ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "市議会の請願採択も事業断念の要素になった"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "調査の不適切さは重大なマイナス要素だった"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "市や市民への不適切で不誠実な対応が信頼を損ねた"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "事業は最終的に白紙撤回となった"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_3 rdfs:label "JR東日本エネルギー開発株式会社"@ja.
kg:st_3 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_14 prop:content "事業の取り止めを米沢市に申し出た"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "活動の認知が市民と議員を巻き込んだ"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_4 rdfs:label "米沢市民の有志6名 米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_4 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_16 prop:content "市民全体への説明会の実施を求めた"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "問題意識を持ち啓蒙活動を展開した"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "現地調査を行い実態把握を進めた"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "事業者や自治体への聞き取りを行った"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "反対活動を継続して展開した"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "反対署名を集めて提出した"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "署名を市や県や国に提出した"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "市議会で意見交換を行った"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "市議会に請願を提出した"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "計画の白紙撤回を求める署名を提出した"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "市民全体への説明会開催を求めた"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:st_5 rdfs:label "米沢市"@ja.
kg:st_5 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_27 prop:content "準備書に対する意見を公表した"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "事業説明会後に依頼文を送付し公表した"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:st_6 rdfs:label "米沢市長"@ja.
kg:st_6 rdfs:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_29 prop:content "事業計画の全面白紙撤回を申し入れた"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_6.
kg:op_30 prop:content "イヌワシなどの保全対策は不十分だと指摘した"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "中断するなら中断すべきだと述べた"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
