kg:id_6 rdf:type cls:c_13229.
cls:c_13229 rdfs:label "通学路懸念"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "南原の美しい景観が損なわれる"@ja.
kg:id_7 rdf:type cls:c_839.
cls:c_839 rdfs:label "景観悪化"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "事業の中止を求める署名活動"@ja.
kg:id_8 rdf:type cls:c_13123.
cls:c_13123 rdfs:label "署名活動"@ja.
kg:id_1 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "吉村山形県知事と近藤米沢市長への署名提出"@ja.
kg:id_9 rdf:type cls:c_13230.
cls:c_13230 rdfs:label "要請行為"@ja.
kg:id_1 prop:contermeasure kg:id_9.
kg:st_1 rdfs:label "南原有志の会"@ja.
kg:st_1 rdfs:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "地元住民が計画中止を求めている"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_2 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_2 prop:content "美しい南原地区に太陽光発電施設は不要と考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "景観への悪影響を懸念している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "観光への悪影響を懸念している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "災害リスクを懸念している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "通学路への悪影響を懸念している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "南原の景色を未来に残したい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "知事と市長に署名を提出して中止を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "県知事と市長への働きかけを進めている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "米沢市の南部、南原•笹野地区に建設面積21,703㎡もの大規模な太陽光発電事業が計画されています。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "景観、観光、災害、通学路に対する懸念から、事業の中止を求め"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "景観、観光、災害、通学路に対する懸念から、事業の中止を求め"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "景観、観光、災害、通学路に対する懸念から、事業の中止を求め"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "景観、観光、災害、通学路に対する懸念から、事業の中止を求め"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "そんな美しい南原地区に無味乾燥な太陽光発電施設はいりません！"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業の中止を求め、吉村山形県知事、近藤米沢市長に署名を提出する署名活動を始めました。"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "事業の中止を求め、吉村山形県知事、近藤米沢市長に署名を提出する署名活動を始めました。"@ja.
