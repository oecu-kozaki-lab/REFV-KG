kg:id_1 rdfs:label "太陽光発電事業"@ja.
kg:id_1 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "南原・笹野地区での大規模な建設計画"@ja.
kg:id_2 rdf:type cls:c_8845.
cls:c_8845 rdfs:label "建設計画"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "景観への懸念"@ja.
kg:id_3 rdf:type cls:c_6445.
cls:c_6445 rdfs:label "景観懸念"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "観光への懸念"@ja.
kg:id_4 rdf:type cls:c_13228.
cls:c_13228 rdfs:label "観光懸念"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "災害への懸念"@ja.
kg:id_5 rdf:type cls:c_1001.
cls:c_1001 rdfs:label "災害懸念"@ja.
kg:id_1 prop:effect kg:id_5.
