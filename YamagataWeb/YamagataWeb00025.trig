PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00025> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "（仮称）栗子山風力発電事業"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "森林が失われる"@ja.
kg:id_2 rdf:type cls:c_13255.
cls:c_13255 rdfs:label "森林喪失"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "火災時の消火と鎮火作業が困難になる"@ja.
kg:id_3 rdf:type cls:c_12373.
cls:c_12373 rdfs:label "消火困難"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "事業から撤退する"@ja.
kg:id_4 rdf:type cls:c_7911.
cls:c_7911 rdfs:label "事業撤退"@ja.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "白紙撤回"@ja.
kg:id_5 rdf:type cls:c_1291.
cls:c_1291 rdfs:label "計画撤回"@ja.
kg:id_1 prop:contermeasure kg:id_5.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "森林再生が必要な焼失事例と比べても森林喪失は重い"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "尾根の強風下で風車群が消火の妨げになり危険だと懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "JR東日本エネルギー開発社長"@ja.
kg:st_2 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_3 prop:content "地域に喜んでもらえる事業の形を検討したい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "地域にとって最も望ましいのは事業撤退だと求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "山形県に事業の白紙撤回を求めている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "風力発電所建設の為に失われる森林は最低でも３１ヘクタール。片や５０ヘクタールの焼失で森林再生の為のプロジェクトが組まれる。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "栗子の尾根の風況が良いということは風が強い。標高１０００ｍの尾根。一個燃えたら、その脇には風車群がある。消火には邪魔で、鎮火作業は困難であることは明らかです。"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "「どのような形であれば地域に喜んでもらえる事業にできるかを検討していきたい。」地域に喜んでもらえる事業とは、「事業から撤退します。」と公言していただくことが、一番の喜びです。そのように決断ください。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "山形県に（仮称）栗子山風力発電事業白紙撤回を求める署名簿提出"@ja.
}
