kg:st_1 rdfs:label "米沢市 近藤洋介市長"@ja.
kg:st_1 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "市民への説明と情報公開の姿勢が不十分で信頼関係を築く意思が欠けると批判"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "不十分な説明の繰り返しが不信感を生んだと指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "猛きん類の専門家や日本イヌワシ研究会"@ja.
kg:st_2 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_3 prop:content "事業者側の生息調査は極めて不適切であり中止を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "県環境影響評価審査会"@ja.
kg:st_3 rdfs:type cls:st_7.
cls:st_7 rdfs:label "審査機関"@ja.
kg:op_4 prop:content "希少生物の保全対策に不十分な点が多いと指摘"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "住民説明会を通じて理解を得る対応が十分でなかったと説明"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "環境問題を懸念する住民の不安を払拭するのは難しいと説明"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_4 rdfs:label "山形県 吉村知事"@ja.
kg:st_4 rdfs:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_7 prop:content "イヌワシ生息の可能性があるため抜本的な見直しを求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:st_5 rdfs:label "JR東日本エネルギー開発"@ja.
kg:st_5 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_8 prop:content "地域に不安が広がっている現状を重く受け止める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_5.
kg:op_9 prop:content "環境問題への懸念から住民不安の払拭が難しいとみる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "事業者は米沢市と市民との協力関係や信頼関係を築く意思に欠けると指摘"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "計画見直しではなく白紙撤回を求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "不適切な生息調査を理由に事業中止を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "事業の取り止めも含めた抜本的見直しを求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "希少生物保全対策の不十分さの改善が必要と示す"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:st_6 rdfs:label "環境省"@ja.
kg:st_6 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_15 prop:content "イヌワシの環境保全措置を適切に実施するよう求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:op_16 prop:content "地域の理解を得られるよう引き続き取り組むとする"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "米沢市の近藤市長は市や市民への説明が足りていないなどとして、計画の白紙撤回を求めたことを明らかにしました。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "その理由として近藤市長が一番に挙げたのは、「不十分な説明」が繰り返されたことで生じた“不信感”だった。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "猛きん類の専門家や日本イヌワシ研究会などは「事業者側が行った生息調査は極めて不適切」として中止を求め"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "県環境影響評価審査会も7月、「希少生物の保全対策について不十分な点が多い」と指摘していた。"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "白紙撤回を求めた理由について、近藤市長は、住民説明会を通じて住民の理解を得るよう求めたが十分な対応がなかったこと"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "環境問題を懸念する住民の不安を払拭するのが難しいと説明したうえで"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "県が、知事の意見として、建設予定地周辺にイヌワシが生息している可能性があるため、事業計画の抜本的な見直しを求めた"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "地域のみなさまに不安が広がっている現状を重く受け止め、引き続き理解いただけるよう取り組んでいく"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "環境問題を懸念する住民の不安を払拭するのが難しい"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "米沢市・米沢市民との協力関係・信頼関係を構築する意思に欠けていると考えざるを得ない"@ja.
<< kg:id_1 prop:contermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "近藤市長が事業者に対し「計画の白紙撤回」を申し入れた"@ja.
<< kg:id_1 prop:contermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "猛きん類の専門家や日本イヌワシ研究会などは「事業者側が行った生息調査は極めて不適切」として中止を求め"@ja.
<< kg:id_1 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "吉村知事は8月26日、「事業の取り止めも含め抜本的な事業計画の見直し」を行うよう求めていた。"@ja.
<< kg:id_1 prop:contermeasure kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "県環境影響評価審査会も7月、「希少生物の保全対策について不十分な点が多い」と指摘していた。"@ja.
<< kg:id_1 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "環境省も、30日、イヌワシの環境保全措置の検討を適切に実施するよう求める環境大臣意見を経済産業大臣に提出しています。"@ja.
<< kg:id_1 prop:contermeasure kg:id_17 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "地域のみなさまに不安が広がっている現状を重く受け止め、引き続き理解いただけるよう取り組んでいく"@ja.
}
