kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "出発点の事業地選定が間違っていたとみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "毎日新聞記事で引用された近藤洋介米沢市長"@ja.
kg:st_2 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_2 prop:content "今回の計画は相当無理があった"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "地すべり地帯を選んだため工事も維持も困難になるとみる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_3 rdfs:label "専門家"@ja.
kg:st_3 rdfs:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_4 prop:content "地盤調査を十分に実施し適切な施工計画を策定すべきと指摘"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "最初に地質調査していれば事業地として無理と判断できたはずだと批判"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "公表後4年以上たっても地質調査がされず不十分だったと批判"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_4 rdfs:label "JR東日本エネルギー開発"@ja.
kg:st_4 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_7 prop:content "遅延とコスト増で事業性が成り立たないと説明"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:op_8 prop:content "調査が圧倒的に足りず中止か十分な調査実施が必要と指摘"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "専門家の意見を聞く耳を持たないように見えたと不信感を示す"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_5 rdfs:label "山形県"@ja.
kg:st_5 rdfs:type cls:st_11.
kg:op_10 prop:content "造成地の崩壊や地滑りの懸念から中止を含む抜本的見直しを求めた"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:st_6 rdfs:label "近藤洋介米沢市長"@ja.
kg:st_6 rdfs:type cls:st_11.
kg:op_11 prop:content "協力関係を構築する意欲が欠けているとして全面白紙撤退を申し入れた"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_6.
kg:op_12 prop:content "地盤と豪雪条件から工事困難は明らかだとみる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "完成後の維持も極めて困難になると指摘"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "耐震性に関する説明ができていないと問題視"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "イヌワシやクマタカなどへの衝突事故の懸念が拭えないと指摘"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "造成地崩壊や地滑りの懸念があると判断"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:st_7 rdfs:label "経済産業省"@ja.
kg:st_7 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_17 prop:content "水環境への影響を避けるため建設に厳しい基準を求めた"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_7.
kg:op_18 prop:content "冬季のメンテナンスは雪崩や遭難の危険があり無謀だと批判"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "作業道の凍結リスクも想定されていないと指摘"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "命を懸けたメンテナンスを強いる計画だと批判"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:st_8 rdfs:label "高橋ひろみ共同代表"@ja.
kg:st_8 rdfs:type cls:st_164.
cls:st_164 rdfs:label "住民代表"@ja.
kg:op_21 prop:content "対応が不誠実で不信感しか募らなかった"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_8.
kg:op_22 prop:content "市や住民との協力関係を構築する意欲が欠けていると批判"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:op_23 prop:content "安定した地盤上への建設のため十分な地盤調査と施工計画策定が不可欠と指摘"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "この地で進めるなら徹底した地質調査が必要だったと主張"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "調査不足のままなら中止も選択すべきと指摘"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "継続するなら十分な調査実施が必要と指摘"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "造成地崩壊や地滑りの懸念から中止を含む抜本見直しを求めた"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "事業計画の全面白紙撤退を申し入れた"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:op_29 prop:content "全面白紙撤回を受け入れたことは速やかで賢明な判断だったと評価"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_6.
kg:op_30 prop:content "イヌワシなど鳥類への対応として専門家協議会の設置を求めた"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_7.
kg:op_31 prop:content "鳥類衝突の実態把握のため稼働後調査を求めた"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_7.
kg:op_32 prop:content "土砂や濁流の流出による水環境影響を避けるため厳しい基準を設けた"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_7.
kg:op_33 prop:content "犠牲者が出る前に撤退したことは賢明と評価"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今回の計画は相当無理があった。...本当にこの地が事業地として適地であったのか、と言う出発点が間違っていたと思われます。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "国道周辺は風化してもろく、全体が地すべり地帯となっている。...風化してもろい地滑り地帯の標高1000mの豪雪地帯をわざわざ事業地として選んだわけです。"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "大型の風力発電機は安定した地盤上に建設されることが不可欠であることから、地盤調査を十分に実施して適切な施工計画を策定すること。...しかし、調査をまったくやらなかった。"@ja.
<< kg:id_3 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "どんな土で形成されているのか、現地調査はせず、公表から4年以上たって撤退を表明するまで、結局は調査されなかった。昨年９月９日の住民説明会の資料の地質のところは空白。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "JR東日本エネルギー開発は事業撤退の理由について「スケジュールの大幅な遅延とコストの増大が見込まれ、事業性が成り立たない」とコメントした。"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "専門家の意見に、圧倒的に調査が足りていない、中止するなら中止する、やるなら調査をちゃんとやる事、と強い言葉で指摘され、...撤退を決めました。"@ja.
<< kg:id_7 prop:cause kg:id_10 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "県はこのほか、造成地の崩壊や地滑りなどの懸念もあるとして、事業の中止を含めた抜本的な見直しを求める...近藤洋介市長は...事業計画の全面白紙撤退を事業者に申し入れた。"@ja.
<< kg:id_3 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "そのため、工事も、完成後の維持も、相当に困難を極めることは明らかです。"@ja.
<< kg:id_3 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "そのため、工事も、完成後の維持も、相当に困難を極めることは明らかです。"@ja.
<< kg:id_3 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "そして、震度いくつまで耐えられるのか、と言う質問に回答できなかった。"@ja.
<< kg:id_3 prop:effect kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "計画地の周辺には絶滅のおそれがある猛禽類、イヌワシやクマタカなどの生息地があり、風車への衝突事故（バードストライク）の懸念が拭えないと指摘されていた。"@ja.
<< kg:id_3 prop:effect kg:id_15 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "県はこのほか、造成地の崩壊や地滑りなどの懸念もあるとして、事業の中止を含めた抜本的な見直しを求める準備書への意見を8月26日付で経産相に提出した。"@ja.
<< kg:id_3 prop:effect kg:id_16 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "また土砂や濁流の流出による水環境への影響を避けるため、建設に関する厳しい基準を設けた。"@ja.
<< kg:id_3 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "雪崩が起こる、埋まる、遭難の危険がある、という事を想定できない。"@ja.
<< kg:id_3 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "作業道の凍結も想定されていない。"@ja.
<< kg:id_3 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "命を懸けてメンテナンスせよ、というに等しい。"@ja.
<< kg:id_3 prop:effect kg:id_20 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "高橋ひろみ共同代表は「対応が不誠実で不信感しか募らなかった」と反対姿勢を鮮明にした。"@ja.
<< kg:id_3 prop:effect kg:id_21 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "近藤洋介市長は...「市や住民との協力関係を構築する意欲が欠けている」と批判。"@ja.
<< kg:id_22 prop:contermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "大型の風力発電機は安定した地盤上に建設されることが不可欠であることから、地盤調査を十分に実施して適切な施工計画を策定すること。"@ja.
<< kg:id_3 prop:contermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "徹底的に地質を調べ、どんな方法であれば事業が可能であるのか徹底的に調査することは可能だったはずです。"@ja.
<< kg:id_3 prop:contermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "圧倒的に調査が足りていない、中止するなら中止する、やるなら調査をちゃんとやる事"@ja.
<< kg:id_3 prop:contermeasure kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "圧倒的に調査が足りていない、中止するなら中止する、やるなら調査をちゃんとやる事"@ja.
<< kg:id_3 prop:contermeasure kg:id_27 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "県はこのほか、造成地の崩壊や地滑りなどの懸念もあるとして、事業の中止を含めた抜本的な見直しを求める準備書への意見を8月26日付で経産相に提出した。"@ja.
<< kg:id_3 prop:contermeasure kg:id_28 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "事業計画の全面白紙撤退を事業者に申し入れた。...市が求めてきた全面白紙撤回を受け入れたものであり、速やかで賢明な判断だった"@ja.
<< kg:id_3 prop:contermeasure kg:id_29 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "経産省は9月19日付で事業者に対する勧告を発表。イヌワシなど鳥類に関する複数の専門家から構成される協議会の設置...を求めた。"@ja.
<< kg:id_3 prop:contermeasure kg:id_30 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "経産省は9月19日付で事業者に対する勧告を発表。...稼働後のバードストライク調査などを求めた。"@ja.
<< kg:id_3 prop:contermeasure kg:id_31 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "また土砂や濁流の流出による水環境への影響を避けるため、建設に関する厳しい基準を設けた。"@ja.
<< kg:id_3 prop:contermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "犠牲者が出る前に撤退したことは賢明である、と思います。"@ja.
}
