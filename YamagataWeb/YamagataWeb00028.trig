kg:id_6 rdf:type cls:c_13281.
cls:c_13281 rdfs:label "繁殖妨害"@ja.
kg:id_3 prop:effect kg:id_6.
kg:id_7 rdfs:label "超低周波音"@ja.
kg:id_7 rdf:type cls:c_13282.
cls:c_13282 rdfs:label "超低周波音"@ja.
