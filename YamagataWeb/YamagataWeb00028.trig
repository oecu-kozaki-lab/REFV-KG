kg:id_8 rdf:type cls:c_535.
cls:c_535 rdfs:label "風力発電施設"@ja.
kg:id_7 prop:cause kg:id_8.
kg:id_9 rdfs:label "板谷地区のいちご風力発電の4基の風車"@ja.
kg:id_9 rdf:type cls:c_535.
kg:id_7 prop:cause kg:id_9.
kg:id_10 rdfs:label "置賜盆地に到達する"@ja.
kg:id_10 rdf:type cls:c_13283.
cls:c_13283 rdfs:label "地域到達"@ja.
kg:id_7 prop:effect kg:id_10.
kg:id_11 rdfs:label "これまでになかった体調不良"@ja.
kg:id_11 rdf:type cls:c_8641.
cls:c_8641 rdfs:label "体調不良"@ja.
kg:id_7 prop:effect kg:id_11.
kg:id_12 rdfs:label "これからの時期から9月末まで被害が出る"@ja.
kg:id_12 rdf:type cls:c_1322.
cls:c_1322 rdfs:label "健康被害"@ja.
kg:id_7 prop:effect kg:id_12.
kg:id_13 rdfs:label "超低周波音による被害"@ja.
kg:id_13 rdf:type cls:c_1322.
kg:id_14 rdfs:label "風向きと自身の体調を気にかける"@ja.
kg:id_14 rdf:type cls:c_13284.
cls:c_13284 rdfs:label "体調確認"@ja.
kg:id_13 prop:contermeasure kg:id_14.
kg:id_15 rdfs:label "栗子山風力発電施設の建設計画"@ja.
kg:id_15 rdf:type cls:c_8845.
cls:c_8845 rdfs:label "建設計画"@ja.
kg:id_16 rdfs:label "風力発電の学習会を開催する"@ja.
kg:id_16 rdf:type cls:c_13285.
cls:c_13285 rdfs:label "学習会開催"@ja.
kg:id_15 prop:contermeasure kg:id_16.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "風況ポールの仮設道は本工事に向けた事前工事だとみている"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "希少猛禽類の狩場が失われると懸念している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "イヌワシとクマタカが追い払われていると訴えている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "鳥類の子育て期への悪影響を問題視している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "吾妻高原風力発電所の風車が超低周波音の発生源になっているとみている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "板谷地区の風車も超低周波音の要因になっているとみている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "南風により超低周波音が置賜盆地まで届くと訴えている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "住民に体調不良が生じている可能性を示している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "今後9月末まで超低周波音被害が発生すると予測している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "住民に風向きと体調の確認を呼びかけている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "計画を知ってもらうため学習会への参加を呼びかけている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "JR東日本エネルギー開発による、風況ポールの仮設道と称して、風力発電のための本工事に向けての事前工事が既に始まっています。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "イヌワシ、クマタカの狩場を奪い、追い払い行為を始めています。"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "イヌワシ、クマタカの狩場を奪い、追い払い行為を始めています。"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "大事な子育ての時期を邪魔する行為です。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "福島県側の吾妻高原風力発電所に９基の風車が、昨年５月１日から営業を開始しました。"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "板谷地区には４基のいちご風力発電の風車があります。合計１３基が現在稼働しています。"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "南風に乗って超低周波音は置賜盆地に到達します。"@ja.
<< kg:id_7 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "昨年の６月末～９月末まで、これまでになかった体調不良で辛かったという方もいると思います。"@ja.
<< kg:id_7 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これからの時期から９月末まで、超低周波音による被害が出ることになります。"@ja.
<< kg:id_13 prop:contermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "これからは、風向きと御自身の体調を気にかけてみてください。"@ja.
<< kg:id_15 prop:contermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "第6回、第7回、第8回、第9回、第10回、風力発電の学習会を開催します。 風力発電の勉強会を下記の日程で行います。お気軽に参加してみてください。"@ja.
}
