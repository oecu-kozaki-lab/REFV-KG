kg:id_4 rdf:type cls:c_1291.
cls:c_1291 rdfs:label "計画撤回"@ja.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "中止を含めた事業見直し"@ja.
kg:id_5 rdf:type cls:c_834.
