kg:id_8 rdf:type cls:c_432.
cls:c_432 rdfs:label "環境保全"@ja.
kg:id_1 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "事業計画の根幹部分への厳しい指摘"@ja.
kg:id_9 rdf:type cls:c_13305.
cls:c_13305 rdfs:label "計画指摘"@ja.
kg:id_1 prop:effect kg:id_9.
kg:st_1 rdfs:label "地元住民らで作る市民団体"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "イヌワシの風車衝突の懸念から計画に反対"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "低周波音による健康被害を懸念し計画に反対"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_2 rdfs:type cls:st_73.
kg:op_3 prop:content "事業の白紙撤回に向けて活動を継続する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "米沢市"@ja.
kg:st_3 rdfs:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_4 prop:content "地域に寄り添う姿勢が感じられないとして全面白紙撤回を申し出"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "近藤洋介米沢市長"@ja.
kg:st_4 rdfs:type cls:st_11.
kg:op_5 prop:content "国の勧告と市の申し入れを踏まえ適切な判断を期待"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:st_5 rdfs:label "山形県知事"@ja.
kg:st_5 rdfs:type cls:st_11.
kg:op_6 prop:content "中止を含めた事業見直しを求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_5.
kg:st_6 rdfs:label "経済産業省"@ja.
kg:st_6 rdfs:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_7 prop:content "事業者に工事計画の見直しを勧告"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_6.
kg:op_8 prop:content "イヌワシや風力発電の影響を調べる協議会設置を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_6.
kg:st_7 rdfs:label "JR東日本エネルギー開発"@ja.
kg:st_7 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_9 prop:content "専門家や地域住民の意見を踏まえ環境保全に努め理解を得るよう取り組む"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_7.
kg:op_10 prop:content "勧告は事業計画の根幹部分に対し厳しい内容と受け止める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "地元住民らで作る市民団体は、国の天然記念物・イヌワシの風車への衝突や"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "風車の低周波音による住民の健康被害への懸念などを理由に計画への反対を訴えています"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "市長の全面白紙撤回の申し入れこれからも事業の白紙撤回に向けて活動を継続してまいります米沢市は「事業の進め方に地域に寄り添う姿勢が感じられない」として事業者に対して計画の全面白紙撤回を申し出ています今回の勧告および本市からの全面白紙撤回の申し入れを踏まえた適切な判断を下すことを期待したい"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "県知事による中止を含めた事業見直し"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "国が事業者に対し、工事計画の見直しなどを求める勧告を行いました経済産業省は9月19日、事業者に対し、計画の見直しなどを求める勧告を行いました"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "勧告では、イヌワシの生息状況や風力発電による影響について調べる専門家などによる協議会の設置などを求めています"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これまで専門家や地域住民の意見を踏まえた環境保全に努め、誠実に対応してきた。引き続きご理解いただけるよう取り組んでいく"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "近藤洋介米沢市長「勧告は事業計画の根幹部分に対し厳しい内容。"@ja.
}
