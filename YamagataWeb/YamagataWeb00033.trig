PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00033> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風車による破壊"@ja.
kg:id_1 rdf:type cls:c_13226.
cls:c_13226 rdfs:label "環境破壊"@ja.
kg:id_2 rdfs:label "栗子山風力発電事業の撤退"@ja.
kg:id_2 rdf:type cls:c_7911.
cls:c_7911 rdfs:label "事業撤退"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "多くの方の署名と皆様の協力"@ja.
kg:id_3 rdf:type cls:c_13306.
cls:c_13306 rdfs:label "市民協力"@ja.
kg:id_2 prop:cause kg:id_3.
kg:id_4 rdfs:label "再エネ事業の問題"@ja.
kg:id_4 rdf:type cls:c_13307.
cls:c_13307 rdfs:label "制度問題"@ja.
kg:id_5 rdfs:label "地元の自治体に権限が与えられておらず地権者と事業者との契約と必要書類さえ揃えれば自治体でも事業を止められない欠陥システム"@ja.
kg:id_5 rdf:type cls:c_13308.
cls:c_13308 rdfs:label "制度欠陥"@ja.
kg:id_4 prop:cause kg:id_5.
kg:id_6 rdfs:label "欠陥システム"@ja.
kg:id_6 rdf:type cls:c_13308.
kg:id_7 rdfs:label "全国で泣き寝入りをしなければならない人達が多くいる"@ja.
kg:id_7 rdf:type cls:c_13309.
cls:c_13309 rdfs:label "住民被害"@ja.
kg:id_6 prop:effect kg:id_7.
kg:id_8 rdfs:label "このような事態"@ja.
kg:id_8 rdf:type cls:c_13310.
cls:c_13310 rdfs:label "問題事態"@ja.
kg:id_9 rdfs:label "法整備"@ja.
kg:id_9 rdf:type cls:c_13311.
cls:c_13311 rdfs:label "法整備"@ja.
kg:id_8 prop:contermeasure kg:id_9.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "事業撤退により風車による破壊を食い止められたことに感謝する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "多くの協力がこの結果につながったと感謝している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "自治体に権限がなく事業を止められない制度に問題があると考える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "欠陥システムにより各地で住民が泣き寝入りしていると懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "同様の事態を防ぐため法整備が急務だと考える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "お陰様で、事業者は事業撤退することになり、風車による破壊を食い止めることが出来ました。"@ja.
<< kg:id_2 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "多くの方の署名を頂き、ご心配頂きました。皆様の協力があったからこそ、このような結果を迎えられたこと、御礼を申し上げます。"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "再エネ事業は、地元の自治体に権限が与えられておらず、地権者と事業者との契約と、必要な書類さえ揃えれば、自治体であっても事業を止めることが出来ないシステムに問題があります。"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "欠陥システムにより、全国で泣き寝入りをしなければならない人達が多くいます。"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "このような事態にならない為の法整備が急務と考えます。"@ja.
}
