PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00034> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風車病"@ja.
kg:id_1 rdf:type cls:c_1322.
cls:c_1322 rdfs:label "健康被害"@ja.
kg:id_2 rdfs:label "風力発電の超低周波音"@ja.
kg:id_2 rdf:type cls:c_239.
cls:c_239 rdfs:label "低周波音"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "地元の方々の体調不良"@ja.
kg:id_3 rdf:type cls:c_8641.
cls:c_8641 rdfs:label "体調不良"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "由利本荘市沖洋上風力発電事業計画"@ja.
kg:id_4 rdf:type cls:c_390.
cls:c_390 rdfs:label "発電計画"@ja.
kg:id_5 rdfs:label "中止要望書の提出"@ja.
kg:id_5 rdf:type cls:c_13312.
cls:c_13312 rdfs:label "中止要望"@ja.
kg:id_4 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "事業者へ要望書を提出"@ja.
kg:id_6 rdf:type cls:c_8905.
cls:c_8905 rdfs:label "要望書提出"@ja.
kg:id_4 prop:contermeasure kg:id_6.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "風車病の恐ろしさを伝え情報拡散を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "風力だめーじサポートの会"@ja.
kg:st_2 rdfs:type cls:st_73.
kg:op_2 prop:content "超低周波音で地元住民が実際に体調不良になったことを伝える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "地元住民の体調不良の実態を訴える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "由利本荘・にかほの風力発電を考える会"@ja.
kg:st_3 rdfs:type cls:st_73.
kg:op_4 prop:content "事業者に対して計画中止を要望する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "AKITAあきた風力発電に反対する県民の会"@ja.
kg:st_4 rdfs:type cls:st_73.
kg:op_5 prop:content "事業者に対して計画中止を要望する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:op_6 prop:content "事業者に対して計画中止を要望する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_5 rdfs:label "地元の団体の方々"@ja.
kg:st_5 rdfs:type cls:st_73.
kg:op_7 prop:content "地元の現状を知ってもらうため要望書を提出する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "「風車病」の恐ろしさ。風力発電の超低周波音により、実際に体調不良となった地元の方々の、生の声をお聞きください。動画作成「風力だめーじサポートの会」"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "風力発電の超低周波音により、実際に体調不良となった地元の方々の、生の声をお聞きください。"@ja.
<< kg:id_4 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "由利本荘・にかほの風力発電を考える会 AKITAあきた風力発電に反対する県民の会 風力だめーじサポートの会 「由利本荘市沖洋上風力発電事業計画」の中止要望書"@ja.
<< kg:id_4 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地元の団体の方々が、事業者へ要望書を提出します。ぜひお読みいただき、地元の現状をお知りください。"@ja.
}
