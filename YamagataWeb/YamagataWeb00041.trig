PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00041> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山大型風力発電施設の建設計画"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "栗子山に建つことによりどんな事が起こる"@ja.
kg:id_2 rdf:type cls:c_278.
cls:c_278 rdfs:label "影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "風力発電の勉強会を開催"@ja.
kg:id_3 rdf:type cls:c_10627.
cls:c_10627 rdfs:label "勉強会開催"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:id_4 rdfs:label "米沢市議と意見交換を行う"@ja.
kg:id_4 rdf:type cls:c_648.
cls:c_648 rdfs:label "意見交換"@ja.
kg:id_1 prop:contermeasure kg:id_4.
kg:id_5 rdfs:label "福島県庁担当部署と意見交換を行う"@ja.
kg:id_5 rdf:type cls:c_648.
kg:id_1 prop:contermeasure kg:id_5.
kg:id_6 rdfs:label "勉強会を3回4回と開催予定"@ja.
kg:id_6 rdf:type cls:c_10627.
kg:id_1 prop:contermeasure kg:id_6.
kg:id_7 rdfs:label "一緒に活動してくれる仲間を募集"@ja.
kg:id_7 rdf:type cls:c_13340.
cls:c_13340 rdfs:label "参加募集"@ja.
kg:id_1 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "米沢市民が建設計画をまだまだ知らないこと"@ja.
kg:id_8 rdf:type cls:c_13341.
cls:c_13341 rdfs:label "計画認知不足"@ja.
kg:id_1 prop:cause kg:id_8.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "良い面も悪い面もまず知ることが重要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "市民の理解を深めたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "関係者との意見交換を進めている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "行政担当部署との意見交換を進めている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "少しでも多くの方の理解が深まることを望む"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "勉強会の場で参加を呼びかけている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "まずは計画を知ることから始めるべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "栗子山に建つことによりどんな事が起こるのか、現状の進行状況を踏まえて勉強会を行います。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "第2回風力発電の勉強会を4月26日金曜日、松川コミュニティセンターで開催します。"@ja.
<< kg:id_1 prop:contermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "３月２８日木曜日、米沢市議２４人中２０人の出席のもと、米沢市庁舎において意見交換を行いました。"@ja.
<< kg:id_1 prop:contermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "４月１２日金曜日、福島県庁を訪問し、担当部署と意見交換を行いました。"@ja.
<< kg:id_1 prop:contermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "３回、４回と開催予定です。少しでも多くの方の理解が深まれば、と思います。"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "一緒に活動してくれる仲間を募集してます。勉強会の時に申し出て頂けたらと思います。"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "まだまだ米沢市民は、栗子山に大型風力発電施設の建設計画があることを知りません。良きも悪きも、まずは知る事から始めましょう。"@ja.
}
