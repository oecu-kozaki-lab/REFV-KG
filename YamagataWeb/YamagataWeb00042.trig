PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00042> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "JR東日本エネルギー開発による風況ポールの設置と称する森林伐採"@ja.
kg:id_2 rdf:type cls:c_13215.
cls:c_13215 rdfs:label "森林伐採"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "イヌワシ、クマタカの生息を無視した前倒しの食料の狩場の剥奪"@ja.
kg:id_3 rdf:type cls:c_13342.
cls:c_13342 rdfs:label "生息地剥奪"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "生息状況の観測期間中にもかかわらない開発の進行"@ja.
kg:id_4 rdf:type cls:c_13343.
cls:c_13343 rdfs:label "開発進行"@ja.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "イヌワシ、クマタカを追い払うこと"@ja.
kg:id_5 rdf:type cls:c_13344.
cls:c_13344 rdfs:label "鳥類排除"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "高畠町、川西町、南陽市、飯豊町、長井市、白鷹町、置賜盆地内、及び、栗子峠を利用される全ての方への影響"@ja.
kg:id_6 rdf:type cls:c_71.
cls:c_71 rdfs:label "広域影響"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "JR東日本エネルギー開発が提供した資料を元に学習会を行う"@ja.
kg:id_7 rdf:type cls:c_13285.
cls:c_13285 rdfs:label "学習会開催"@ja.
kg:id_1 prop:contermeasure kg:id_7.
kg:id_8 rdfs:label "多くの方に参加いただけるように日程を複数設ける"@ja.
kg:id_8 rdf:type cls:c_13345.
cls:c_13345 rdfs:label "参加機会拡大"@ja.
kg:id_1 prop:contermeasure kg:id_8.
kg:id_9 rdfs:label "米沢市が置かれている現状を確認する"@ja.
kg:id_9 rdf:type cls:c_13346.
cls:c_13346 rdfs:label "現状確認"@ja.
kg:id_1 prop:contermeasure kg:id_9.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "森林伐採が既に始まっている現状の確認を呼びかける"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "希少鳥類の生息を無視して狩場を奪っていると批判する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "観測期間中でも開発を進めている姿勢を問題視する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "希少鳥類が追い払われる影響を懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "影響が米沢市以外の広い地域と利用者全体に及ぶと訴える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "現状把握のため学習会への参加を呼びかける"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "参加しやすいよう複数日程を設定している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "米沢市の現状を確認する必要があると訴える"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "JR東日本エネルギー開発による、風況ポールの設置と称する森林伐採が既に始まっています。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "イヌワシ、クマタカの生息を無視し、それらを追い払うように前倒しで食料の狩場を奪っております。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "３月末までは生息状況の観測期間であるにも関わらずお構いなしです。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "イヌワシ、クマタカの生息を無視し、それらを追い払うように前倒しで食料の狩場を奪っております。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "影響は高畠町、川西町、南陽市、飯豊町、長井市、白鷹町、置賜盆地内、及び、栗子峠を利用される全ての方に及びます"@ja.
<< kg:id_1 prop:contermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "現状がどうなっているのか、JR東日本エネルギー開発が提供した資料を元に学習会を行います。"@ja.
<< kg:id_1 prop:contermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "多くの方に参加いただけるように、日程を複数設けました。"@ja.
<< kg:id_1 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "米沢市が置かれている現状を、是非確認してみてください。"@ja.
}
