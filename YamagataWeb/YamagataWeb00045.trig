PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00045> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "体調不良"@ja.
kg:id_1 rdf:type cls:c_1322.
cls:c_1322 rdfs:label "健康被害"@ja.
kg:id_2 rdfs:label "風車からの超低周波音"@ja.
kg:id_2 rdf:type cls:c_239.
cls:c_239 rdfs:label "低周波音"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "風力発電事業"@ja.
kg:id_3 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_3 prop:effect kg:id_1.
kg:id_4 rdfs:label "頭痛"@ja.
kg:id_4 rdf:type cls:c_1322.
kg:id_2 prop:effect kg:id_4.
kg:id_5 rdfs:label "めまい"@ja.
kg:id_5 rdf:type cls:c_1322.
kg:id_2 prop:effect kg:id_5.
kg:id_6 rdfs:label "睡眠障害"@ja.
kg:id_6 rdf:type cls:c_1322.
kg:id_2 prop:effect kg:id_6.
kg:id_7 rdfs:label "風車病"@ja.
kg:id_7 rdf:type cls:c_1322.
kg:id_3 prop:effect kg:id_7.
kg:id_8 rdfs:label "栗子山風力発電事業"@ja.
kg:id_8 rdf:type cls:c_170.
kg:id_9 rdfs:label "山間部である四万十を参考にする"@ja.
kg:id_9 rdf:type cls:c_13359.
cls:c_13359 rdfs:label "対策"@ja.
kg:id_8 prop:contermeasure kg:id_9.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "超低周波音で体調不良は実際に起こると主張"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "風力発電事業により健康影響が出ると懸念"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "置賜地方まで広げると多くの人が体調不良を訴える可能性があると見る"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "超低周波音が頭痛を引き起こすおそれがあると訴える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "超低周波音がめまいを引き起こすおそれがあると訴える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "超低周波音が睡眠障害を引き起こすおそれがあると訴える"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "風車病という健康被害が存在すると主張"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "山間部の事例として四万十を参考にすべきとする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "風車からの超低周波で頭痛、めまい、睡眠障害のおそれ！"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "全員が同じように影響を受けるものではない事は確かだけど、影響を受ける人は３０％いる。米沢市の人口を少なく見て7万人とすれば、2万１千人に影響が出る。"@ja.
<< kg:id_3 prop:effect kg:id_1 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "置賜地方に広げれば、４万人超くらいは体調不良を訴えることになる。"@ja.
<< kg:id_2 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "風車からの超低周波で頭痛、めまい、睡眠障害のおそれ！"@ja.
<< kg:id_2 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "風車からの超低周波で頭痛、めまい、睡眠障害のおそれ！"@ja.
<< kg:id_2 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "風車からの超低周波で頭痛、めまい、睡眠障害のおそれ！"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "ちゃんと風車病と言う名前があるのだから、あるんです。世界中で苦しんでいる人がいる。"@ja.
<< kg:id_8 prop:contermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "栗子山風力発電事業は山間部なので、山間部である四万十が参考になりそうです。"@ja.
}
