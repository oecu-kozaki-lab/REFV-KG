PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00047> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:contermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "風力発電学習会を開催"@ja.
kg:id_2 rdf:type cls:c_13285.
cls:c_13285 rdfs:label "学習会開催"@ja.
kg:id_1 prop:contermeasure kg:id_2.
kg:id_3 rdfs:label "説明会を開催"@ja.
kg:id_3 rdf:type cls:c_94.
cls:c_94 rdfs:label "説明会開催"@ja.
kg:id_1 prop:contermeasure kg:id_3.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdfs:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "説明会前に資料を元に学び理解を深めてほしい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "JR東日本エネルギー開発"@ja.
kg:st_2 rdfs:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_2 prop:content "（仮称）栗子山風力発電の説明を行う"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
<< kg:id_1 prop:contermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "７月２８日、３０日、８月３日、風力発電学習会を開催します。JR東日本エネルギー開発が何を言っているのか、事業者により提供された資料を元に学習会を行います。是非参加されて、栗子山風力発電について、理解を深めていただきたいと思います。"@ja.
<< kg:id_1 prop:contermeasure kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "８月４日、５日とJR東日本エネルギー開発による（仮称）栗子山風力発電の説明会が米沢市市民文化会館で行われます。"@ja.
}
