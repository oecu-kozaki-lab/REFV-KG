@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prop: <https://kozaki-lab.jp/REFV-KG/prop/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cls:  <https://kozaki-lab.jp/REFV-KG/class/> .
@prefix kg:   <https://kozaki-lab.jp/REFV-KG/data/> .

cls:Document
    rdf:type rdfs:Class ;
    rdfs:label "文書"@ja .

cls:Prefecture
    rdf:type rdfs:Class ;
    rdfs:label "都道府県"@ja .

cls:DocumentType
    rdf:type rdfs:Class ;
    rdfs:label "資料種別"@ja .

prop:prefecture
    rdf:type rdf:Property ;
    rdfs:label "都道府県"@ja ;
    rdfs:domain cls:Document ;
    rdfs:range cls:Prefecture .

prop:documentType
    rdf:type rdf:Property ;
    rdfs:label "資料種別"@ja ;
    rdfs:domain cls:Document ;
    rdfs:range cls:DocumentType .

prop:inputFileName
    rdf:type rdf:Property ;
    rdfs:label "入力ファイル名"@ja ;
    rdfs:domain cls:Document ;
    rdfs:range rdfs:Literal .

prop:sourceFolderPath
    rdf:type rdf:Property ;
    rdfs:label "保存されていたフォルダ名"@ja ;
    rdfs:domain cls:Document ;
    rdfs:range rdfs:Literal .

kg:prefecture_Yamagata
    rdf:type cls:Prefecture ;
    rdfs:label "山形"@ja .

kg:prefecture_Akita
    rdf:type cls:Prefecture ;
    rdfs:label "秋田"@ja .

kg:prefecture_Shimane
    rdf:type cls:Prefecture ;
    rdfs:label "島根"@ja .

kg:prefecture_Hokkaido
    rdf:type cls:Prefecture ;
    rdfs:label "北海道"@ja .

kg:documentType_CouncilMinutes
    rdf:type cls:DocumentType ;
    rdfs:label "議会会議録"@ja .

kg:documentType_ReviewBoardMaterial
    rdf:type cls:DocumentType ;
    rdfs:label "審査会資料"@ja .

kg:documentType_AdministrativeMaterial
    rdf:type cls:DocumentType ;
    rdfs:label "行政資料"@ja .

kg:documentType_NewsReport
    rdf:type cls:DocumentType ;
    rdfs:label "報道"@ja .

kg:documentType_WebArticle
    rdf:type cls:DocumentType ;
    rdfs:label "Web記事"@ja .

kg:documentType_EnvironmentalAssessmentMaterial
    rdf:type cls:DocumentType ;
    rdfs:label "環境アセス資料"@ja .

kg:documentType_BusinessMaterial
    rdf:type cls:DocumentType ;
    rdfs:label "事業者資料"@ja .

kg:documentType_CitizenGroupMaterial
    rdf:type cls:DocumentType ;
    rdfs:label "市民・住民団体資料"@ja .

kg:documentType_Publication
    rdf:type cls:DocumentType ;
    rdfs:label "広報・刊行物"@ja .

kg:documentType_Other
    rdf:type cls:DocumentType ;
    rdfs:label "その他"@ja .

