kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "環境影響評価は新たな事情に応じて見直すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "先行事例が少ないため最新知見と専門家助言を踏まえて評価すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "専門家助言と最新知見を反映して適切に評価すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "事業計画が未確定なため準備書で具体化すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "準備書で事業計画と環境配慮の検討結果を詳細に示すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地域住民や地元自治体に丁寧に説明し理解を得るべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "周辺の既設・計画中風力発電所との複合影響を考慮すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "他事業の情報を収集して複合影響を評価すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "近隣の福祉施設や住居を踏まえ調査地点を見直すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "生活環境影響を把握するため調査地点を追加・見直すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "陸上ヤードでの事前組立を踏まえ騒音振動を評価すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "24時間工事の可能性があるため騒音振動影響を精査すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "建設機械の騒音振動は生活環境に影響するおそれがある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "工事内容を明確化した上で騒音振動を適切に評価すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "基礎設置による海底土砂の巻き上げを考慮すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "海底ケーブル敷設による水の濁りも評価対象にすべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "底質や流向流速を把握し調査地点を見直して水の濁りを評価すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "小友沼が重要な渡来地であるため鳥類影響を詳細に把握すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "事業区域周辺は渡り鳥の主要な経路となる可能性がある"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "専門家助言を踏まえ鳥類の飛翔経路と高度を詳細に調べるべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "事業実施に伴う遊泳動物や卵稚仔への影響を評価すべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "対象魚種を定め生息状況を把握して海域動物影響を評価すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "洋上風力発電に伴う水中音の影響を評価へ反映すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "最新知見を集積して水中音影響の評価に反映すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "沿岸約13kmにわたる計画のため景観影響を丁寧に評価すべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "眺望点設定では地域住民や地元自治体などの意見を踏まえるべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "景観評価では眺望方向や水平視野時間帯も考慮すべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "規模や配置の検討経緯と結果を説明し住民や自治体の意見を十分考慮すべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、これらについて必要に応じて見直しを行う等、適切に対応すること。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本事業は、沖合約1km～4km、南北約13kmの海域に最大45基（総出力最大18万kW）の風力発電所を設置する国内で先行事例の少ない洋上風力発電事業であることから、専門家の助言や国内外における最新の知見・事例等を踏まえ、適切に調査、予測及び評価すること。"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本事業は、沖合約1km～4km、南北約13kmの海域に最大45基（総出力最大18万kW）の風力発電所を設置する国内で先行事例の少ない洋上風力発電事業であることから、専門家の助言や国内外における最新の知見・事例等を踏まえ、適切に調査、予測及び評価すること。"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "設置する風力発電機の配置のほか、工事の規模や方法等が確定していないことから、準備書においては、事業計画を可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を詳細に記載すること。"@ja.
<< kg:id_6 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "設置する風力発電機の配置のほか、工事の規模や方法等が確定していないことから、準備書においては、事業計画を可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を詳細に記載すること。"@ja.
<< kg:id_6 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "また、これらについて、地域住民や地元自治体等に広く周知するとともに丁寧な説明を行い、理解を得るよう努めること。"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "対象事業実施区域周辺には既設及び計画中の風力発電所が存在することから、これら他事業の諸元等の情報入手に努め、複合的な影響が懸念される項目について、適切に調査、予測及び評価すること。"@ja.
<< kg:id_10 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
