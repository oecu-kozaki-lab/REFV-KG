kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "景観影響を低減できる配置等を検討し方法書に具体記載するよう求める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "船舶交通の安全確保について漁業関係者と十分協議するよう求める"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "レジャーボート等による水域利用の実態も把握し安全性確保を求める"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "水域利用の安全性を損なわない位置機種選定と安全対策を求める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "潮流変化に伴う漁獲や回遊魚ルートへの影響を懸念する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "回遊魚ルートの変化が地元漁業者の漁獲に影響すると懸念する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "漁獲への影響を想定し十分な説明と了承取得を求める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "潮流や漁獲影響をシミュレーションし漁業関係者の了承を得るよう求める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "建設後の音が住民生活に影響することを懸念する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "現地調査を確実に実施し住民の暮らしへ影響しないよう配慮を求める"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "観光スポットの眺望変化が生活や地域事業に影響すると懸念する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "景観変化が地元住民の生活へ影響すると懸念する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "観光関連団体や地域団体の事業への影響を懸念する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "地元住民や関係団体の理解を得ながら進めるよう求める"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "現段階では国内において洋上風力発電所の先行事例が少ないことから、専門家の助言や国内外における最新の知見・事例等を踏まえ、事業の実施に伴う環境影響を可能な限り回避又は低減するよう配慮すること。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "候補海域から北側の海域に拡張しているため、設置する風力発電機の一部は、県立自然公園や環境の保全について配慮が必要な福祉施設、住居等と距離が近くなる可能性がある。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "設置する風力発電機の一部は、県立自然公園や環境の保全について配慮が必要な福祉施設、住居等と距離が近くなる可能性がある。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "設置する風力発電機の一部は、県立自然公園や環境の保全について配慮が必要な福祉施設、住居等と距離が近くなる可能性がある。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "設置する風力発電機の一部は、県立自然公園や環境の保全について配慮が必要な福祉施設、住居等と距離が近くなる可能性がある。"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業計画について地域住民、同区域周辺の各種施設利用者及び関係船舶沿岸等に丁寧な説明を行い、理解を得られるよう努めること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "今後の事業計画の検討に当たっては、地域住民等や専門家からの情報収集に努め、影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価した上で、事業の位置・規模及び配置・構造の決定に反映すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価した上で、事業の位置・規模及び配置・構造の決定に反映すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "なお、位置・規模等の決定に当たっては、候補海域を設定した際に考慮した自然公園の存在等にも配慮すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "設置する風力発電機の位置・規模等が複数案設定されていることから、方法書においては事業の位置・規模等を可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を記載すること。"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "事業実施想定区域周辺の既設及び計画中の風力発電所との複合的な環境影響を勘案し、可能な限りこれら他事業の諸元等の情報入手に努め、適切に調査、予測及び評価すること。"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "事業実施想定区域周辺には、環境の保全について配慮が必要な福祉施設や多数の住居が存在していることから、これらと風力発電機との距離を適切に確保する等、事業の実施による影響を回避又は低減するよう検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "事業実施想定区域周辺には、環境の保全について配慮が必要な福祉施設や多数の住居が存在していることから、これらと風力発電機との距離を適切に確保する等、事業の実施による影響を回避又は低減するよう検討すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "これらと風力発電機との距離を適切に確保する等、事業の実施による影響を回避又は低減するよう検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "事業実施想定区域の南東に位置する小友沼は、国際的に重要なガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地であるため、事業実施想定区域周辺は主要な渡り経路である可能性があるほか、ハチクマやノスリ等の猛禽類の渡りが確認されている。"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "事業実施想定区域周辺は主要な渡り経路である可能性があるほか、ハチクマやノスリ等の猛禽類の渡りが確認されている。"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "加えて、同区域周辺には既設及び計画中の風力発電所が多数存在することから、これら鳥類への影響が懸念される。"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "今後の現地調査の結果や専門家の助言、最新の知見・事例等を踏まえ、事業の実施に伴う影響を回避又は低減するよう検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "事業の実施に伴い、事業実施想定区域及びその周辺に生息する魚等の遊泳動物やその卵・稚仔等に及ぼす影響について、専門家の助言や国内外における最新の知見・事例等を踏まえ、可能な限り生息状況を適切に把握した上で、調査、予測及び評価すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "可能な限り生息状況を適切に把握した上で、調査、予測及び評価すること。"@ja.
<< kg:id_1 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "事業実施想定区域の周辺には、秋田県立自然公園条例に基づき指定された八森岩館県立自然公園等が存在しており、鹿の浦展望台等の主要な眺望点が複数存在することから、風力発電機の存在により、これら眺望点からの眺望景観への影響が懸念される。"@ja.
<< kg:id_1 prop:effect kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "鹿の浦展望台等の主要な眺望点が複数存在することから、風力発電機の存在により、これら眺望点からの眺望景観への影響が懸念される。"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "このため、事業の位置・規模等の決定に当たっては、地域住民等及び専門家への事業計画の周知や意見の聴取に努めるとともに"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "今後の現地調査の結果や候補海域を設定した際に考慮した自然公園の存在等を勘案し、事業の実施に伴う影響を回避又は低減するよう検討すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "地域住民等からの情報収集に努め、風力発電機の可視領域を考慮して適切な調査地点を選定すること。"@ja.
<< kg:id_1 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "事業実施想定区域は共同漁業権が設定されている海域であり、特に秋田県の県魚であるハタハタをはじめ、タラ類、ヒラメ、カレイ類等を対象とした漁が盛んである。これら魚類及び周辺漁場への影響についての確認を十分に行い、必要な調査、予測及び評価について検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "海生生物への影響は未解明な部分が多いため、諸外国の事例も踏まえつつ可能な限り最新の知見を活用し、その回避又は低減を図ること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "また、周辺漁業関係者と十分な協議を行いながら進めること。"@ja.
<< kg:id_1 prop:effect kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "計画段階においては、事業実施想定区域上空における改変空域の容積比率を算出し、検討を行うことが、方法書以降の手続きにおいて、特に渡り鳥の経路に対する既設風車・計画中風車との複合影響からゆる影響を考慮し"@ja.
<< kg:id_1 prop:effect kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "風車の大きさ、形、色、配置等については、供用時に見る人に対して圧迫感や威圧感を感じさせる等の景観への影響が懸念される"@ja.
<< kg:id_1 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "当該影響について十分な低減が図られるよう配置等について十分検討し、その結果を方法書に具体的に記載すること。"@ja.
<< kg:id_1 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "事業実施想定区域周辺の船舶交通の安全について、周辺漁業関係者に十分な協議を行うとともに"@ja.
<< kg:id_1 prop:effect kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "それ以外の船舶の航行、例えばプレジャーボート等による水域利用の実態についても把握し、風車の設置と運用により従前の水域利用の安全性が損なわれることのないよう"@ja.
<< kg:id_1 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "風車の位置や機種の選定、タワー周辺の安全対策について検討すること。"@ja.
<< kg:id_1 prop:effect kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "洋上風力の風車が建設されることで、潮流に影響が出ることが想定される。"@ja.
<< kg:id_1 prop:effect kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "潮流の変化に伴い、八峰町沖の回遊魚ルートが変わることで"@ja.
<< kg:id_1 prop:effect kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "地元漁業者の漁獲にも影響が出ることが想定されるため"@ja.
<< kg:id_1 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "十分にシミュレーションした上で漁業関係者等への説明を実施し、了承を得ていただきたい。"@ja.
<< kg:id_1 prop:effect kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "洋上風力の風車を建設する際や建設後に発する音などが、住民の安心・安全な暮らしに影響を与えることが懸念される。"@ja.
<< kg:id_1 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "今後は現地調査等を確実に実施し、住民の暮らしに影響を与えることがないよう考慮していただきたい。"@ja.
<< kg:id_1 prop:effect kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "洋上風力の風車が建設されることで、町の観光スポットとなっている鹿の浦展望所などからの眺望が変わってくる。"@ja.
<< kg:id_1 prop:effect kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "鹿の浦展望所等からの眺望が変わることから、地元住民の生活や、観光協会、ネイチャー協会などの各団体等が実施する事業に影響が出ることが想定される"@ja.
<< kg:id_1 prop:effect kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "観光協会、ネイチャー協会などの各団体等が実施する事業に影響が出ることが想定される"@ja.
<< kg:id_1 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "十分に理解を得ながら事業を進めていただきたい。"@ja.
}
