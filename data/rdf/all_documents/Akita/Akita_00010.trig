PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Akita/00010> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "新仁賀保風力発電事業（仮称）準備書"@ja.
kg:id_1 rdf:type cls:c_13533.
cls:c_13533 rdfs:label "文書"@ja.
kg:id_2 rdfs:label "記載内容を修正し正確でわかりやすい評価書を作成する"@ja.
kg:id_2 rdf:type cls:c_13652.
cls:c_13652 rdfs:label "文書修正"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "新仁賀保風力発電事業（仮称）"@ja.
kg:id_3 rdf:type cls:c_1.
cls:c_1 rdfs:label "事業"@ja.
kg:id_4 rdfs:label "環境保全措置の確実な履行のため責任の所在を明確にし工事施工業者等への指導に努める"@ja.
kg:id_4 rdf:type cls:c_13653.
cls:c_13653 rdfs:label "責任明確化"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "最新の知見や技術等を可能な範囲で導入し環境影響の低減に努める"@ja.
kg:id_5 rdf:type cls:c_429.
cls:c_429 rdfs:label "影響低減"@ja.
kg:id_3 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "工事中及び供用後の環境保全上の問題"@ja.
kg:id_6 rdf:type cls:c_533.
cls:c_533 rdfs:label "環境問題"@ja.
kg:id_7 rdfs:label "速やかに調査し関係機関と協議の上で適切な措置を講じる"@ja.
kg:id_7 rdf:type cls:c_13548.
cls:c_13548 rdfs:label "調査対応"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "騒音及び超低周波音"@ja.
kg:id_8 rdf:type cls:c_108.
cls:c_108 rdfs:label "騒音"@ja.
kg:id_9 rdfs:label "新設風力発電機の寄与"@ja.
kg:id_9 rdf:type cls:c_7409.
cls:c_7409 rdfs:label "発電設備"@ja.
kg:id_8 prop:cause kg:id_9.
kg:id_10 rdfs:label "現地調査結果と既設風力発電機の寄与の関係を精査し適切に予測及び評価する"@ja.
kg:id_10 rdf:type cls:c_316.
cls:c_316 rdfs:label "予測評価"@ja.
kg:id_8 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "騒音の予測に不確実性が大きい"@ja.
kg:id_11 rdf:type cls:c_8267.
cls:c_8267 rdfs:label "不確実性"@ja.
kg:id_8 prop:effect kg:id_11.
kg:id_12 rdfs:label "環境監視に加え供用後に事後調査を実施する"@ja.
kg:id_12 rdf:type cls:c_17.
cls:c_17 rdfs:label "事後調査"@ja.
kg:id_8 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "施設の稼働"@ja.
kg:id_13 rdf:type cls:c_563.
cls:c_563 rdfs:label "施設稼働"@ja.
kg:id_14 rdfs:label "周辺住民から苦情が発生する"@ja.
kg:id_14 rdf:type cls:c_13549.
cls:c_13549 rdfs:label "住民苦情"@ja.
kg:id_13 prop:effect kg:id_14.
kg:id_15 rdfs:label "施設の稼働に伴う周辺住民からの苦情"@ja.
kg:id_15 rdf:type cls:c_13549.
kg:id_16 rdfs:label "速やかに原因を調査し適切な措置を講じる"@ja.
kg:id_16 rdf:type cls:c_13548.
kg:id_15 prop:countermeasure kg:id_16.
kg:id_17 rdfs:label "沈砂池からの濁水の流入"@ja.
kg:id_17 rdf:type cls:c_564.
cls:c_564 rdfs:label "濁水流入"@ja.
kg:id_18 rdfs:label "動植物の生息生育環境が悪化する"@ja.
kg:id_18 rdf:type cls:c_8483.
cls:c_8483 rdfs:label "生息環境悪化"@ja.
kg:id_17 prop:effect kg:id_18.
kg:id_19 rdfs:label "動物及び植物"@ja.
kg:id_19 rdf:type cls:c_13654.
cls:c_13654 rdfs:label "生物"@ja.
kg:id_20 rdfs:label "十分な面積の沈砂池を適切に配置する"@ja.
kg:id_20 rdf:type cls:c_13655.
cls:c_13655 rdfs:label "沈砂池配置"@ja.
kg:id_19 prop:countermeasure kg:id_20.
kg:id_21 rdfs:label "事業の実施に伴う地下水への影響"@ja.
kg:id_21 rdf:type cls:c_7961.
cls:c_7961 rdfs:label "地下水影響"@ja.
kg:id_22 rdfs:label "事業特性や地域特性を踏まえて検討し地下水脈を断ち切らないよう十分に配慮する"@ja.
kg:id_22 rdf:type cls:c_13656.
cls:c_13656 rdfs:label "地下水保全"@ja.
kg:id_21 prop:countermeasure kg:id_22.
kg:id_23 rdfs:label "既設風力発電機の撤去工事"@ja.
kg:id_23 rdf:type cls:c_13657.
cls:c_13657 rdfs:label "撤去工事"@ja.
kg:id_24 rdfs:label "騒音等の環境影響が生じるおそれがある"@ja.
kg:id_24 rdf:type cls:c_348.
cls:c_348 rdfs:label "環境影響"@ja.
kg:id_23 prop:effect kg:id_24.
kg:id_25 rdfs:label "騒音等の環境影響を可能な限り回避低減し必要に応じて適切な環境保全措置を講じる"@ja.
kg:id_25 rdf:type cls:c_429.
kg:id_23 prop:countermeasure kg:id_25.
kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "準備書の記載の不正確さを是正すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "環境保全措置の実施責任を明確化すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "新しい知見と技術で環境影響をさらに低減すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "予測できない問題が生じた場合は迅速に調査と対応を行うべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "新設風力発電機の寄与を含めて予測評価すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "騒音予測は既設設備との関係を精査して適切に評価すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "騒音影響は不確実性が大きいため事後確認が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "供用後の騒音と超低周波音は事後調査で確認すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "住民苦情の発生を想定して対応準備を行うべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "住民苦情には迅速に原因調査と対策を行うべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "濁水流入で重要な生態環境が悪化しないよう配慮すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "重要な群落保全のため沈砂池を適切に配置すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "地下水脈を損なわないよう事業計画を検討すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "撤去工事でも環境影響の発生を想定すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "撤去工事では環境影響の回避低減と保全措置を徹底すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "準備書全般にわたり正確性を欠く記載が多く見られることから、内容を精査した上で記載内容を修正し、正確かつわかりやすい評価書を作成すること。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業の実施に当たっては、環境保全措置の確実な履行を確保するため、責任の所在を明確にするとともに、工事施工業者等への指導に努めること。"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "また、最新の知見や技術等を可能な範囲で導入することにより、一層の環境影響の低減に努めること。"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講じること。"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "一部の予測地点について建替風力発電機の寄与が既設風力発電機の寄与を上回ることはないとして、建替風力発電機の寄与を合成した予測となっていない。"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "このため、現地調査結果と既設風力発電機の寄与の関係性について精査し、適切に予測及び評価すること。"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "発電所の稼働による騒音及び超低周波音については、騒音源の騒音放射特性、伝搬過程における気象条件や地形の影響等、不確実性が大きい要因があることから"@ja.
<< kg:id_8 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "等の環境監視に加え、新設風力発電機及び建替風力発電機の供用後に事後調査を実施すること。"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "なお、施設の稼働に伴い周辺住民から苦情が発生した場合は"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "速やかにその原因を調査し、適切な措置を講じること。"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "濁水の流入により動植物の生息・生育環境が悪化することのないよう配慮すること。"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "事業実施区域内には新田現の湿原植生等の重要な群落が確認されていることから、十分な面積の沈砂池を適切に配置を適切に講じ"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "事業の実施に伴う地下水への影響について、事業特性や地域特性を踏まえて検討し、地下水脈を断ち切らないよう十分に配慮すること。"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "建替風力発電機の供用後に実施する既設風力発電機の撤去工事においては、騒音等の環境影響を可能な限り回避・低減するよう配慮するとともに、環境影響が生じるおそれが想定される場合には"@ja.
<< kg:id_23 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "騒音等の環境影響を可能な限り回避・低減するよう配慮するとともに、環境影響が生じるおそれが想定される場合には、適切な環境保全措置を講じること。"@ja.
}
