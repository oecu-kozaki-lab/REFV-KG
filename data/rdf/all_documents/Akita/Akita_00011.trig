PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Akita/00011> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電設備の稼働"@ja.
kg:id_1 rdf:type cls:c_13658.
cls:c_13658 rdfs:label "発電設備の稼働"@ja.
kg:id_2 rdfs:label "騒音及び超低周波音"@ja.
kg:id_2 rdf:type cls:c_108.
cls:c_108 rdfs:label "騒音"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "バードストライク"@ja.
kg:id_3 rdf:type cls:c_13353.
cls:c_13353 rdfs:label "鳥類被害"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "環境保全上の問題"@ja.
kg:id_4 rdf:type cls:c_533.
cls:c_533 rdfs:label "環境問題"@ja.
kg:id_5 rdfs:label "速やかな調査と関係機関との協議の上で適切な措置を講じること"@ja.
kg:id_5 rdf:type cls:c_13548.
cls:c_13548 rdfs:label "調査対応"@ja.
kg:id_4 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "風力発電設備の稼働に伴う影響"@ja.
kg:id_6 rdf:type cls:c_348.
cls:c_348 rdfs:label "環境影響"@ja.
kg:id_7 rdfs:label "専門家等の意見を聴いた上でバードストライク調査を適切に実施すること"@ja.
kg:id_7 rdf:type cls:c_2827.
cls:c_2827 rdfs:label "影響調査"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "騒音パワーレベルの出典や測定方法等を評価書に記載すること"@ja.
kg:id_8 rdf:type cls:c_460.
cls:c_460 rdfs:label "評価書記載"@ja.
kg:id_2 prop:countermeasure kg:id_8.
kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "騒音パワーレベルの出典や測定方法を評価書に記載すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "専門家等の意見を踏まえ影響を十分把握できる調査を適切に実施すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "工事中及び供用後に予測し得ない問題が生じた場合は迅速対応すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "バードストライク調査は影響を十分把握できる内容にすべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "評価書への記載により騒音評価の妥当性を明確にすべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "騒音及び超低周波音 設置する風力発電設備の騒音パワーレベルについて、出典や測定方法等を評価書に記載すること。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "動物 事後調査としてバードストライクに関する調査を実施することとしているが、風力発電設備の稼働に伴う影響を十分に把握できる調査となるよう、専門家等の意見を聴いた上で適切に実施すること。"@ja.
<< kg:id_4 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講じること。"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事後調査としてバードストライクに関する調査を実施することとしているが、風力発電設備の稼働に伴う影響を十分に把握できる調査となるよう、専門家等の意見を聴いた上で適切に実施すること。"@ja.
<< kg:id_2 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "騒音及び超低周波音 設置する風力発電設備の騒音パワーレベルについて、出典や測定方法等を評価書に記載すること。"@ja.
}
