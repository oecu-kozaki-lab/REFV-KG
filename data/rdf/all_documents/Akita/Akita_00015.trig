    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "設置する風力発電機の配置等のほか、工事の規模や方法等が確定していないことから、準備書においては、これらを可能な限り明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を詳細に記載すること。"@ja.
}
