PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Akita/00020> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "環境保全上の問題"@ja.
kg:id_1 rdf:type cls:c_533.
cls:c_533 rdfs:label "環境問題"@ja.
kg:id_2 rdfs:label "速やかに調査を行い関係機関と協議の上適切な措置を講じる"@ja.
kg:id_2 rdf:type cls:c_13548.
cls:c_13548 rdfs:label "調査対応"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "騒音及び超低周波音"@ja.
kg:id_3 rdf:type cls:c_108.
cls:c_108 rdfs:label "騒音"@ja.
kg:id_4 rdfs:label "発電所の稼働"@ja.
kg:id_4 rdf:type cls:c_567.
cls:c_567 rdfs:label "発電施設"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "気象条件や地形の影響により伝搬過程の不確実性が大きい"@ja.
kg:id_5 rdf:type cls:c_8267.
cls:c_8267 rdfs:label "不確実性"@ja.
kg:id_3 prop:effect kg:id_5.
kg:id_6 rdfs:label "事後調査を実施する"@ja.
kg:id_6 rdf:type cls:c_17.
cls:c_17 rdfs:label "事後調査"@ja.
kg:id_3 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "騒音"@ja.
kg:id_7 rdf:type cls:c_108.
kg:id_8 rdfs:label "風力発電機"@ja.
kg:id_8 rdf:type cls:c_7409.
cls:c_7409 rdfs:label "発電設備"@ja.
kg:id_7 prop:cause kg:id_8.
kg:id_9 rdfs:label "周波数特性データの測定条件や50Hz以下のデータの有無及び風速別の周波数特性データの有無を確認する"@ja.
kg:id_9 rdf:type cls:c_13714.
cls:c_13714 rdfs:label "データ確認"@ja.
kg:id_7 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "動物"@ja.
kg:id_10 rdf:type cls:c_112.
cls:c_112 rdfs:label "動物"@ja.
kg:id_11 rdfs:label "ミサゴの生息環境に関する事後調査を実施し専門家等の意見を聞いた上で調査の頻度等を決定する"@ja.
kg:id_11 rdf:type cls:c_17.
kg:id_10 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "工事中及び供用後の営業活動や利用状況の変化"@ja.
kg:id_12 rdf:type cls:c_13715.
cls:c_13715 rdfs:label "利用変化"@ja.
kg:id_10 prop:effect kg:id_12.
kg:id_13 rdfs:label "バードストライク"@ja.
kg:id_13 rdf:type cls:c_18.
cls:c_18 rdfs:label "鳥類衝突"@ja.
kg:id_14 rdfs:label "専門家等の意見を聞いた上でできるだけ頻度の高い調査を実施し風力発電機の稼働に伴う影響を十分に把握できる調査とする"@ja.
kg:id_14 rdf:type cls:c_17.
kg:id_13 prop:countermeasure kg:id_14.
kg:id_15 rdfs:label "風力発電機の稼働に伴う影響"@ja.
kg:id_15 rdf:type cls:c_13716.
cls:c_13716 rdfs:label "稼働影響"@ja.
kg:id_10 prop:effect kg:id_15.
kg:st_1 rdfs:label "秋田県"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "予測し得ない問題が生じた場合は速やかに調査し適切に対応すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "騒音源や伝搬条件の不確実性が大きいため事後調査が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "騒音及び超低周波音は事後調査を行うべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "騒音評価のため周波数特性データの条件や不足データを確認すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "工事中及び供用後の営業活動や利用状況の変化を確実に把握できるよう調査頻度を決めるべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "バードストライク調査は高頻度で実施し稼働影響を十分把握すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講じること。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "発電所の稼働による騒音及び超低周波音については"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "騒音源の騒音放射特性、伝搬過程における気象条件や地形の影響など不確実性が大きい要因があることから、事後調査を実施すること。"@ja.
<< kg:id_3 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "発電所の稼働による騒音及び超低周波音については、騒音源の騒音放射特性、伝搬過程における気象条件や地形の影響など不確実性が大きい要因があることから、事後調査を実施すること。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "風力発電機から発生する騒音の周波数特性データ"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "風力発電機から発生する騒音の周波数特性データの測定条件や５０Ｈｚ以下のデータの有無、風速別の周波数特性データの有無を確認すること。"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "事後調査としてミサゴの生息環境に関する調査を実施することとしているが、工事中及び供用後の営業活動や利用状況の変化を確実に把握できるよう、専門家等の意見を聞いた上で調査の頻度等を決定すること。"@ja.
<< kg:id_10 prop:effect kg:id_12 >>
    prop:text-txt_contents "工事中及び供用後の営業活動や利用状況の変化を確実に把握できるよう"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "環境監視としてバードストライクの調査を実施することとしているが、専門家等の意見を聞いた上で、できるだけ頻度の高い調査を実施する等、風力発電機の稼働に伴う影響を十分に把握できる調査とすること。"@ja.
<< kg:id_10 prop:effect kg:id_15 >>
    prop:text-txt_contents "風力発電機の稼働に伴う影響を十分に把握できる調査とすること。"@ja.
}
