kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "秋季に加え夏季の調査実施も検討すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域特性を踏まえ夏季調査を追加すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "海底の底質や流向流速を把握して適切に予測評価すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "必要に応じて調査地点の追加や見直しを行うべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "調査地点を追加見直しして適切に予測評価すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "専門家の助言を踏まえ魚種を選定し生息状況を把握して予測評価すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "対象魚種を具体化して調査すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "現地調査範囲を防波堤方向に延長して生育状況を把握すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "海草藻類の生育状況を適切に把握すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "可視領域を考慮して調査地点を追加すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "生活環境からの景観を適切に調査予測評価すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:st_2 rdfs:label "秋田市長"@ja.
kg:st_2 rdf:type cls:st_33.
kg:op_12 prop:content "対象事業実施区域内の動物植物の生息環境や生態系全体へ影響が及ばないよう配慮すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "希少種を踏まえ生態系全体への影響回避に配慮すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "生息環境と生態系全体への十分な配慮が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "工事騒音を評価項目として選定する必要性を検討すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "工事騒音を適切に調査予測評価すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "設置後の影響を調査し現況と比較しながら専門家の意見も踏まえ評価すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "低周波音を含め最新知見で評価すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "工事振動を評価項目として選定する必要性を検討すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "工事振動を適切に調査予測評価すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "周辺影響を最小限にとどめるよう配慮して調査予測評価すべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "周辺への影響を最小限に抑えるべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "濁水の周辺影響を抑える対応が必要"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "施設の稼働に伴う騒音及び超低周波音の調査時期について、夏季において窓の開放時間が長い地域特性を考慮し、秋季の調査に加え、夏季においても調査の実施を検討すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "施設の稼働に伴う騒音及び超低周波音の調査時期について、夏季において窓の開放時間が長い地域特性を考慮し、秋季の調査に加え、夏季においても調査の実施を検討すること。"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "風力発電機基礎の設置や海底ケーブルの敷設に伴い海底土砂の巻き上げ等が発生するおそれがあることから、対象事業実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握した上で、工事中の水の濁りの影響について、必要に応じて調査地点の追加や見直しを検討する等、適切に予測及び評価すること。"@ja.
<< kg:id_4 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "対象事業実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握した上で、工事中の水の濁りの影響について、必要に応じて調査地点の追加や見直しを検討する等、適切に予測及び評価すること。"@ja.
<< kg:id_4 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "対象事業実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握した上で、工事中の水の濁りの影響について、必要に応じて調査地点の追加や見直しを検討する等、適切に予測及び評価すること。"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業の実施に伴う魚類等の遊泳動物やその卵・稚仔等の海域に生息する動物への影響について、専門家等の助言を踏まえ、ハタハタ、サケ、サクラマス及びアユ等の魚種を予測対象種として選定し、可能な限り生息状況を把握した上で、適切に予測及び評価すること。"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "専門家等の助言を踏まえ、ハタハタ、サケ、サクラマス及びアユ等の魚種を予測対象種として選定し、可能な限り生息状況を把握した上で、適切に予測及び評価すること。"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業の実施に伴う海域に生育する植物への影響について、必要に応じて現地調査の測線を防波堤の方向に延長する等、海草藻類の生育状況を適切に把握すること。"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "必要に応じて現地調査の測線を防波堤の方向に延長する等、海草藻類の生育状況を適切に把握すること。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "対象事業実施区域周辺の日常的な生活環境からの景観について、眺望点からの風力発電機の可視領域を考慮し、必要に応じて調査地点を追加する等、適切に調査、予測及び評価すること。"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "眺望点からの風力発電機の可視領域を考慮し、必要に応じて調査地点を追加する等、適切に調査、予測及び評価すること。"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "建設予定地の南西側にある土崎港地区付近の調査では、植物に関しては、イソスミレ「セソミスミレ（県ＥＮ）」、エゾウキヤガラ（県ＶＵ）、ハタガヤ（県ＶＵ）などの希少種の生息が確認されている。... 建設予定地付近の陸上の状況とほぼ同じと考えられることから、環境影響調査の実施に当たっては、対象事業実施区域内の動物、植物の生息環境や生態系全体へ影響を与えないよう、十分に配慮すること。"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "対象事業実施区域内の動物、植物の生息環境や生態系全体へ影響を与えないよう、十分に配慮すること。"@ja.
<< kg:id_17 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "環境影響調査の実施に当たっては、対象事業実施区域内の動物、植物の生息環境や生態系全体へ影響を与えないよう、十分に配慮すること。"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "工事の実施に当たり、基礎杭等の打設を行うことから、工事の実施の際の騒音に関する項目を評価項目として選定する必要がないか検討し、適切に調査、予測および評価を行うこと。"@ja.
<< kg:id_21 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "工事の実施の際の騒音に関する項目を評価項目として選定する必要がないか検討し、適切に調査、予測および評価を行うこと。"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "風力発電設備については、他の設備と比較し、騒音レベルが低くても非常に不快に感じる人が多いとされていることから、風車設置後の影響について適切に調査、予測および評価を行うこと。特に低周波音については、環境基準等が設定されていないことから、生活する上での心理的影響、人の感覚閾値等や建物等への物的影響について、国内外の最新の科学的知見等を踏まえて調査を行い、現況と風車設置後の予測値を比較検討すること。また、評価に当たっては、専門家の意見を十分に聴取すること。"@ja.
<< kg:id_24 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "風車設置後の影響について適切に調査、予測および評価を行うこと。特に低周波音については、環境基準等が設定されていないことから、生活する上での心理的影響、人の感覚閾値等や建物等への物的影響について、国内外の最新の科学的知見等を踏まえて調査を行い、現況と風車設置後の予測値を比較検討すること。また、評価に当たっては、専門家の意見を十分に聴取すること。"@ja.
<< kg:id_27 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "工事の実施に当たり、基礎杭等の打設を行うことから、工事の実施の際の振動に関する項目を評価項目として選定する必要がないか検討し、適切に調査、予測および評価を行うこと。"@ja.
