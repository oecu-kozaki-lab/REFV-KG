    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "騒音源の騒音放射特性"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "伝搬過程における気象条件や地形の影響など不確実性が大きい要因がある"@ja.
<< kg:id_9 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "伝搬過程における気象条件や地形の影響など不確実性が大きい要因がある"@ja.
<< kg:id_9 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "事後調査を実施すること。"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "超低周波音については、予測に用いた風力発電機の諸元の測定条件等を精査し、諸元としての妥当性を確認すること。"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
