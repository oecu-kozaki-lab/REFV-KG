kg:st_1 rdfs:label "秋田県知事"@ja.
kg:st_1 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "必要に応じて見直しを行い適切に対応すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "専門家助言や最新知見を踏まえて適切に調査予測評価すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "環境影響評価の客観性と妥当性の確保に努めるべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "準備書で事業計画を明確にし地域住民等へ丁寧に説明すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "地域住民や地元自治体等に広く周知し理解を得て意見を事業へ反映すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "配置や工事方法を明確に示し適切に調査予測評価すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "準備書で具体的に示すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "他事業の情報入手に努め累積影響を適切に調査予測評価すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "他事業者から求められた場合は本事業の情報提供に努めるべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "地域住民の生活環境に十分配慮し影響が生じた場合は適切に対応すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "生活環境への十分な配慮が必要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "環境影響評価項目としての選定の有無によらず対応すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "工事計画は地域住民等の意見を踏まえるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "騒音特性を踏まえて適切に調査予測評価すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "工事の具体的工程や作業時間を明確にして評価すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "モノパイル打設等の騒音影響を詳細に評価すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "必要に応じて調査地点の追加や見直しを検討すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "近接施設の位置を踏まえた評価が必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "配慮が特に必要な施設を踏まえて対応すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "港湾周辺環境への影響を必要に応じて調査予測評価すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "騒音影響の程度を踏まえた評価が必要"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "準備書で詳細を明確にすべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "海底の底質や流向流速を把握して適切に予測評価すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "必要に応じて調査回数や地点の追加を検討すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "実施区域と周辺海域の状況把握が必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "鳥類の飛翔経路や高度等を詳細に把握すべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "累積的影響を考慮して評価すべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "専門家助言を踏まえ調査手法の見直しも含め評価すべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "必要に応じて調査期間延長や地点回数追加を検討すべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "鳥類への影響を適切に予測評価すべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "累積的影響を踏まえた詳細把握が必要"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "予測対象種等の生息状況を可能な限り把握すべき"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "専門家助言等を踏まえ適切な調査手法で評価すべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "魚類の産卵場生育場回遊経路への配慮が必要"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "最新知見や事例の集積に努め調査予測評価へ反映すべき"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "十分に解明されていないため知見の収集が必要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "主要な眺望点の設定では地域住民等の意見を踏まえるべき"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "眺望方向や水平視野時間帯季節的変化等も考慮して評価すべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "主要な眺望点だけでなく生活の場からの変化も考慮すべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "景観変化を多面的に評価すべき"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "環境影響評価を行う過程において、環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、これらについて必要に応じて見直しを行うなど、適切に対応すること。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本事業は、沖合約１km～４kmの海域に最大30基（総出力最大35.6万kW）の風力発電所を設置する国内で先行事例の少ない洋上風力発電事業であることから、専門家等の助言や国内外における最新の知見・事例等を踏まえ、適切に調査、予測及び評価を行うこと。"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本事業は、沖合約１km～４kmの海域に最大30基（総出力最大35.6万kW）の風力発電所を設置する国内で先行事例の少ない洋上風力発電事業であることから、専門家等の助言や国内外における最新の知見・事例等を踏まえ、適切に調査、予測及び評価を行うこと。なお、意見聴取に当たっては環境要素ごとに複数の専門家に対して行うなど、環境影響評価の客観性及び妥当性の確保に努めること。"@ja.
<< kg:id_3 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "設置する風力発電機の機種や配置のほか、工事の規模や方法等が確定していないことから、準備書においては事業計画を明確にし、具体的な環境の保全の配慮に係る検討の経緯及びその内容を詳細に記載すること。"@ja.
<< kg:id_3 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "準備書においては事業計画を明確にし、具体的な環境の保全の配慮に係る検討の経緯及びその内容を詳細に記載すること。また、これらについて、地域住民や地元自治体等（以下「地域住民等」という。）に広く周知するとともに、丁寧な説明を行い、理解を得るよう努め、述べられた意見を可能な限り事業に反映すること。"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業者が設置する海底ケーブルの敷設ルート及び陸揚げ地点が示されておらず、環境影響評価の実施の有無も明らかでないことから、準備書においては、これらの配置や工事の方法を明確に示すとともに、海底ケーブルの敷設及び陸揚げ地点の改変に伴う環境影響について、適切に調査、予測及び評価を行い、その結果を記載すること。"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "準備書においては、これらの配置や工事の方法を明確に示すとともに、海底ケーブルの敷設及び陸揚げ地点の改変に伴う環境影響について、適切に調査、予測及び評価を行い、その結果を記載すること。"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "対象事業実施区域（以下「実施区域」という。）周辺には既設及び計画中の風力発電所が存在することから、これら他事業の諸元等の情報入手に努め、累積的な影響が懸念される項目について、適切に調査、予測及び評価を行うこと。"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これら他事業の諸元等の情報入手に努め、累積的な影響が懸念される項目について、適切に調査、予測及び評価を行うこと。また、実施区域周辺に風力発電所の設置を計画している事業者等から、累積的な影響の予測及び評価を行うために、本事業に係る風力発電機の配置や諸元等の情報を求められた場合は、情報提供に努めること。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "県内の一部地域では風力発電所の設置が原因とみられる電波障害が発生していることから、本事業の実施に当たっては、環境影響評価項目としての選定の有無によらず、地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること。"@ja.
<< kg:id_14 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "県内の一部地域では風力発電所の設置が原因とみられる電波障害が発生していることから、本事業の実施に当たっては、環境影響評価項目としての選定の有無によらず、地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること。"@ja.
<< kg:id_14 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本事業の実施に当たっては、環境影響評価項目としての選定の有無によらず、地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "本事業では、早朝・日没後及び休日にも工事を実施する可能性があり、特にモノパイルの打設工事については著しい騒音が発生する可能性があることから、建設機械の稼働に伴う騒音による生活環境への影響が懸念される。"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "本事業では、早朝・日没後及び休日にも工事を実施する可能性があり、特にモノパイルの打設工事については著しい騒音が発生する可能性があることから、建設機械の稼働に伴う騒音による生活環境への影響が懸念される。"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "建設機械の稼働に伴う騒音による生活環境への影響が懸念される。"@ja.
<< kg:id_18 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "このため、工事計画の検討に当たっては、地域住民等の意見を踏まえるとともに、準備書においては、工事の具体的な工程や作業時間等の詳細を明確にし、発生する騒音の特性を踏まえた上で、モノパイル打設等の建設機械の稼働に伴う騒音による生活環境への影響について、適切に調査、予測及び評価を行うこと。"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "施設の稼働に伴う騒音に係る調査地点について、実施区域により近接した学校、病院その他の環境保全についての配慮が特に必要な施設が存在することから、当該施設の位置を踏まえ、必要に応じて調査地点の追加や見直しを検討するなどにより、施設の稼働に伴う騒音による生活環境への影響について、適切に調査、予測及び評価を行うこと。"@ja.
<< kg:id_23 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "施設の稼働に伴う騒音による生活環境への影響について、適切に調査、予測及び評価を行うこと。"@ja.
<< kg:id_23 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "当該施設の位置を踏まえ、必要に応じて調査地点の追加や見直しを検討するなどにより、施設の稼働に伴う騒音による生活環境への影響について、適切に調査、予測及び評価を行うこと。"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "能代港又は秋田港において、工事用資材等の搬出入に加え、風力発電設備の組立てや洗堀防止に用いるフィルターユニットの製作等を計画していることから、準備書においては、工事等の具体的な工程や使用する建設機械等の詳細を明確にし、工事の実施に伴う騒音の影響の程度を踏まえた上で、当該港湾周辺における環境への影響について、必要に応じて調査、予測及び評価を行うこと。"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "工事の実施に伴う騒音の影響の程度を踏まえた上で、当該港湾周辺における環境への影響について、必要に応じて調査、予測及び評価を行うこと。"@ja.
<< kg:id_26 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "準備書においては、工事等の具体的な工程や使用する建設機械等の詳細を明確にし、工事の実施に伴う騒音の影響の程度を踏まえた上で、当該港湾周辺における環境への影響について、必要に応じて調査、予測及び評価を行うこと。"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻上げ等が発生するおそれがあることから、工事の実施に伴う水の濁りへの影響について、必要に応じて調査回数や調査地点の追加を検討するなどにより、実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握し、適切に予測及び評価を行うこと。"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "工事の実施に伴う水の濁りへの影響について、必要に応じて調査回数や調査地点の追加を検討するなどにより、実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握し、適切に予測及び評価を行うこと。"@ja.
<< kg:id_30 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "工事の実施に伴う水の濁りへの影響について、必要に応じて調査回数や調査地点の追加を検討するなどにより、実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握し、適切に予測及び評価を行うこと。"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "実施区域は、ガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地である小友沼の北西に位置しており、渡りの時期等における主要な移動経路となっている可能性がある"@ja.
<< kg:id_34 prop:cause kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "加えて、当該区域周辺には既設及び計画中の風力発電所が多数存在することから、本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される。"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_1;
