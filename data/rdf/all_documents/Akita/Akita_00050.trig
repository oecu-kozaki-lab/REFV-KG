kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "コウモリ類の生息状況把握と影響回避又は低減を求める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "主要な眺望点からの景観影響に配慮すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "眺望景観への影響が懸念される"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "地域住民等の意見と情報を踏まえ景観影響への配慮を求める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本事業の実施による環境影響を可能な限り回避又は低減するよう配慮すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "専門家の助言や国内外における最新の知見・事例等を踏まえ、本事業の実施による環境影響を可能な限り回避又は低減するよう配慮すること。また、意見聴取は複数の専門家に対して行うなど、環境影響評価の客観性及び妥当性の確保に努めること"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本事業の実施に当たっては、地域住民や地元自治体等（以下「地域住民等」という。）に丁寧な説明を行い、理解を得るよう努めること"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今後の事業計画の検討に当たっては、地域住民等からの情報収集に努め、影響を受けるおそれのある環境要素について、影響の程度を必要に応じて調査及び予測し、その結果を総合的に評価して事業の「位置・規模」及び「配置・構造」の決定に反映すること"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "方法書においては、事業の位置・規模や風力発電機の配置、工事計画等を明確にし、具体的な環境の保全の配慮に係る検討内容やその結果を記載すること"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業実施想定区域周辺には、既設及び計画中の風力発電所が多数存在することから、他事業者との情報共有に努め、本事業の実施による累積的な影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業実施想定区域周辺には、既設及び計画中の風力発電所が多数存在することから、他事業者との情報共有に努め、本事業の実施による累積的な影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "想定区域は、ガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地である八郎潟干拓地の南西に位置しており、渡りの時期等における主要な移動経路となっている可能性がある"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "このため、事業の位置・規模等の決定に当たっては、今後の現地調査の結果や専門家の助言を踏まえ、本事業の実施による鳥類への影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "想定区域及びその周辺の海域は、県の魚であるハタハタ等の産卵場及び稚魚の生育場並びに溯河性魚類であるサクラマス等の重要な回遊経路となっている可能性があることから、本事業の実施によるこれら海生生物への影響が懸念される"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "本事業の実施によるこれら海生生物への影響が懸念される"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "このため、専門家の助言や国内外における最新の知見・事例等を踏まえ、可能な限り生息状況を適切に把握した上で、本事業の実施による海生生物への影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "想定区域周辺には秋田県指定の天然記念物である「男鹿のコウモリ生息地」が存在し、想定区域及びその周辺をコウモリ類が飛翔している可能性があることから、施設の稼働によるバットストライク等の発生が懸念される"@ja.
<< kg:id_20 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "施設の稼働によるバットストライク等の発生が懸念される"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "本事業の実施によるコウモリ類への影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "このため、専門家の助言や国内外における最新の知見・事例等を踏まえ、可能な限り生息状況を適切に把握した上で、本事業の実施によるコウモリ類への影響を回避又は低減するよう配慮すること"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "想定区域周辺には主要な眺望点である「出戸浜海水浴場」や「飯島サンセットパーク」等が存在することから、本事業の実施によるこれら眺望点からの眺望景観への影響が懸念される"@ja.
<< kg:id_1 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "本事業の実施によるこれら眺望点からの眺望景観への影響が懸念される"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "このため、事業の位置・規模等の決定に当たっては、地域住民等からの意見を踏まえ、本事業の実施による景観への影響を回避又は低減するよう配慮するとともに、主要な眺望点の設定に当たっては、地域住民等からの情報収集に努め、日常的な生活環境の場からの景観についても十分に配慮すること"@ja.
}
