<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "県内の一部地域では風力発電所の設置が原因とみられる電波障害が発生している"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "建設機械の稼働に伴う騒音による生活環境への影響が懸念される"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "特にモノパイルの打設工事については著しい騒音が発生する可能性がある"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻き上げ等が発生するおそれがあることから、工事の実施に伴う水の濁りへの影響について"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻き上げ等が発生するおそれがあることから、工事の実施に伴う水の濁りへの影響について"@ja.
<< kg:id_10 prop:cause kg:id_8 >>
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻き上げ等が発生するおそれがある"@ja.
<< kg:id_10 prop:cause kg:id_9 >>
    prop:text-txt_contents "風力発電機の基礎施工や海底ケーブルの敷設に伴い、海底土砂の巻き上げ等が発生するおそれがある"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される"@ja.
<< kg:id_13 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "本事業の実施によるこれら鳥類の移動経路の遮断・阻害やバードストライクの発生について、累積的な影響が懸念される"@ja.
<< kg:id_14 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "本事業の実施によるこれら海生生物への影響が懸念される"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:text-txt_contents "洋上風力発電事業の実施に伴う水中音が海域に生息する動物に及ぼす影響については十分に解明されていない"@ja.
<< kg:id_3 prop:effect kg:id_17 >>
    prop:text-txt_contents "地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること"@ja.
<< kg:id_18 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "モノパイル打設等の建設機械の稼働に伴う騒音による生活環境への影響を適切に調査、予測及び評価すること"@ja.
<< kg:id_19 prop:effect kg:id_7 >>
    prop:text-txt_contents "工事の実施に伴う水の濁りへの影響について"@ja.
<< kg:id_12 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本事業の実施による鳥類への影響について、専門家等の助言を踏まえて"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "本事業の実施による魚等の遊泳動物やその卵・稚仔等の海生生物への影響について"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:text-txt_contents "水中音が海域に生息する動物に及ぼす影響については十分に解明されていない"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "日常生活の場からの景観の変化が想定されることから、景観への影響については"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:text-txt_contents "実施区域周辺には、人と自然との触れ合いの活動の場である「釜谷浜海水浴場」等が存在することから、人と自然との触れ合いの活動の場への影響について"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:text-txt_contents "環境影響評価の項目及び手法の選定等に係る事項に新たな事情が生じた場合は、これらについて必要に応じて見直しを行う等、適切に対応すること"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "専門家等の助言や国内外における最新の知見・事例等を踏まえ、適切に調査、予測及び評価すること"@ja.
<< kg:id_27 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "意見聴取は環境要素ごとに複数の専門家に対して行うなど、環境影響評価の客観性及び妥当性の確保に努めること"@ja.
<< kg:id_29 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "準備書においては事業計画を明確にし、具体的な環境の保全の配慮に係る検討の経緯及びその内容を詳細に記載すること"@ja.
<< kg:id_29 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "地域住民や地元自治体等に広く周知するとともに丁寧な説明を行い、理解を得るよう努め、述べられた意見を可能な限り事業に反映すること"@ja.
<< kg:id_29 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "これら他事業の諸元等の情報入手に努め、累積的な影響が懸念される項目について、適切に調査、予測及び評価すること"@ja.
<< kg:id_29 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "実施区域周辺に風力発電所の設置を計画している事業者等から、累積的な影響を予測及び評価するために、本事業に係る風力発電機の配置や諸元等の情報を求められた場合は、情報提供に努めること"@ja.
<< kg:id_29 prop:countermeasure kg:id_36 >>
    prop:text-txt_contents "地域住民の生活環境に十分配慮するとともに、影響が生じた場合は、関係法令等に従って適切に対応すること"@ja.
<< kg:id_18 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "工事計画の検討に当たっては、地域住民等の意見を踏まえること"@ja.
<< kg:id_18 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "準備書においては工事の具体的な工程や作業時間等の詳細を明確にし"@ja.
<< kg:id_18 prop:countermeasure kg:id_39 >>
    prop:text-txt_contents "モノパイル打設等の建設機械の稼働に伴う騒音による生活環境への影響を適切に調査、予測及び評価すること"@ja.
<< kg:id_18 prop:countermeasure kg:id_40 >>
    prop:text-txt_contents "調査地点に追加し、本事業の実施による環境への影響を適切に調査、予測及び評価すること"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:text-txt_contents "準備書においては工事等の具体的な工程や使用する建設機械等の詳細を明確にし、工事の実施の伴う騒音の影響の程度を踏まえた上で、能代港周辺における環境への影響について、必要に応じて調査、予測及び評価すること"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:text-txt_contents "必要に応じて調査地点の追加や見直しを検討する"@ja.
<< kg:id_43 prop:countermeasure kg:id_45 >>
    prop:text-txt_contents "実施区域及びその周辺における海底の底質の状況や流向・流速を可能な限り把握し、適切に予測及び評価すること"@ja.
<< kg:id_20 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "専門家等の助言を踏まえて、調査地点や回数を追加するなど、調査手法の見直しを検討する"@ja.
<< kg:id_20 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "実施区域及びその周辺の上空を通過する鳥類の飛翔経路や高度等を詳細に把握し、適切に予測及び評価すること"@ja.
<< kg:id_14 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "専門家等の助言等を踏まえ、適切な調査手法により予測対象種等の生息状況を可能な限り把握し、予測及び評価すること"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:text-txt_contents "国内外の最新の知見や事例等の集積に努め、水中音の影響に係る調査、予測及び評価に適切に反映すること"@ja.
<< kg:id_23 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "主要な眺望点の設定に当たっては、地域住民等の意見を踏まえ、必要に応じて調査地点を追加すること"@ja.
<< kg:id_23 prop:countermeasure kg:id_52 >>
    prop:text-txt_contents "景観への影響については、眺望方向や水平視野、時間帯、季節的変化等も考慮し、適切に調査、予測及び評価すること"@ja.
<< kg:id_25 prop:countermeasure kg:id_53 >>
    prop:text-txt_contents "人と自然との触れ合いの活動の状況を適切に把握した上で、必要に応じて、人と自然との触れ合いの活動の場への影響について、適切に予測及び評価すること"@ja.
