kg:st_1 rdfs:label "事業者"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "稼働制限等で影響は実行可能な範囲で低減できると評価"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "南北方向配置と1.5km程度の離隔で鳥類影響の低減に努めた"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "複数の専門家等"@ja.
kg:st_2 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_3 prop:content "助言を踏まえて配置を再検討すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "専門家等"@ja.
kg:st_3 rdf:type cls:st_37.
kg:op_4 prop:content "重大な影響が認められた場合は助言に基づき追加措置を講ずるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "重大な影響が認められた場合は助言に基づき追加措置を講ずるべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:st_4 rdfs:label "地域住民"@ja.
kg:st_4 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_6 prop:content "景観の変化を踏まえた対応が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:op_7 prop:content "景観評価地点の追加が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:st_5 rdfs:label "地域住民等"@ja.
kg:st_5 rdf:type cls:st_5.
kg:op_8 prop:content "問い合わせに対して丁寧な説明を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_5.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講ずること。なお、対象事業実施区域の周辺には多数の住居が存在することから、工事中及び供用後に地域住民から苦情が発生した場合は、適切に対応すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:text-txt_contents "現段階で予測し得ない環境保全上の問題が工事中及び供用後に生じた場合は、速やかに調査を行い、関係機関と協議の上、適切な措置を講ずること。"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:text-txt_contents "対象事業実施区域の周辺には多数の住居が存在することから、工事中及び供用後に地域住民から苦情が発生した場合は、適切に対応すること。"@ja.
<< kg:id_4 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "工事中及び供用後に地域住民から苦情が発生した場合は、適切に対応すること。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "今後、事業内容を変更する必要が生じ、当該変更が本準備書の環境影響評価結果に影響を与える可能性がある場合には"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "改めて予測及び評価を行うとともに、適切な環境保全措置を講ずること。"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "変更した内容について、地域住民や地元自治体等に広く周知するとともに、丁寧な説明を行い、本事業に対する理解を得るよう努めること。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "実施区域周辺に存在する複数の他事業者による風力発電所のうち、一部の風力発電所との累積的な影響が予測及び評価されていないことから"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "これら他事業の諸元等の情報入手に努め、累積的な影響が懸念される項目について、適切に予測及び評価し、その結果を評価書に記載すること。"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:text-txt_contents "県内の一部地域では風力発電機の設置が原因と考えられる電波障害が発生している"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:text-txt_contents "本事業の実施に当たっては環境影響評価項目としての選定の有無によらず、地域住民の生活環境に十分配慮するとともに"@ja.
<< kg:id_15 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "影響が生じた場合は、関係法令等に従って適切に対応すること。"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:text-txt_contents "本事業は、県内で設置事例のない大型の4,200kWの風力発電機を、静穏な地域の近隣に設置する計画であることから"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:text-txt_contents "施設の稼働に伴う騒音に含まれる振幅変調音や純音性成分等により、地域住民のわずらわしさ（アノイアンス）の程度が上がる可能性がある。"@ja.
<< kg:id_19 prop:countermeasure kg:id_22 >>
    prop:text-txt_contents "施設の稼働に伴う騒音について、環境監視や地域住民へのヒアリング等を実施することにより、生活環境への影響の把握に努めること。"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:text-txt_contents "本事業は、一部の風力発電機を遮蔽物の少ない田園地帯に設置する計画となっており"@ja.
<< kg:id_23 prop:effect kg:id_25 >>
    prop:text-txt_contents "事業者が風車の影による影響の重大性を判断するために参考とした指針値を大幅に超過すると予測された住居等が多数存在することから、施設の稼働に伴う風車の影による生活環境への重大な影響が懸念される。"@ja.
<< kg:id_23 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業者は、日射センサーを用いた弾力的な稼働制限等の環境保全措置を講ずることにより、施設の稼働に伴う風車の影による影響は実行可能な範囲内で低減が図られていると評価している"@ja.
<< kg:id_23 prop:countermeasure kg:id_27 >>
    prop:text-txt_contents "評価書においては、稼働制限を行う時期や時間帯等を具体的に示すとともに、当該環境保全措置の効果について可能な限り定量的に予測及び評価を行い、その結果を記載すること。"@ja.
<< kg:id_23 prop:countermeasure kg:id_28 >>
    prop:text-txt_contents "当該結果を踏まえ、風車の影による生活環境への影響を回避又は十分に低減できない場合は、風力発電機の設置の取りやめを含む配置の再検討を行うこと。"@ja.
<< kg:id_23 prop:countermeasure kg:id_29 >>
    prop:text-txt_contents "施設の稼働に伴う風車の影による影響について、適切に事後調査を実施し、生活環境への重大な影響が認められた場合は、追加的な環境保全措置を講ずること。"@ja.
<< kg:id_23 prop:countermeasure kg:id_30 >>
    prop:text-txt_contents "追加的な環境保全措置の検討に当たっては、稼働制限等による風車の影の発生抑制を優先し、遮光カーテンやブラインドの設置を優先しないこと。"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:text-txt_contents "実施区域は、ガン・カモ・ハクチョウ類等の渡り鳥の集団飛来地として国際的に重要な小友沼の北方に位置し、これら渡り鳥の主要な移動経路となっている可能性があるほか、当該区域の一部は採餌場として高頻度の利用が確認されるなど、渡り鳥にとって注目すべき生息地となっている。"@ja.
<< kg:id_31 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業者は、主に南北方向に渡りを行う鳥類に配慮し、可能な限り風力発電機を同方向に設置するとともに、風力発電機を東西方向に設置する比八田・荒巻エリアについては、風力発電機間の離隔を1.5km程度確保することにより、本事業の実施による鳥類への影響の低減に努めたとしている"@ja.
<< kg:id_31 prop:effect kg:id_34 >>
    prop:text-txt_contents "比八田・荒巻エリア内には既設の風力発電機もあることから、これら風力発電機が障壁となり、移動経路の遮断・阻害等による渡り鳥への重大な影響が懸念される。"@ja.
<< kg:id_31 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "比八田・荒巻エリアの風力発電機について、改めて複数の専門家等の意見を聴取し、その助言を踏まえ、風力発電機の設置の取りやめを含む配置の再検討を行い、その検討の経緯を評価書に記載すること。"@ja.
<< kg:id_31 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "施設の稼働後のバードストライクや渡り鳥の生息状況に係る事後調査を適切に実施し、渡り鳥への重大な影響が認められた場合は、専門家等からの助言を踏まえ、追加的な環境保全措置を講ずること。"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:text-txt_contents "実施区域及びその周辺では、ミサゴ及びハチクマの営巣及び高頻度な飛翔が確認されているほか、オジロワシの生息が確認されていることから、本事業の実施によるこれら希少猛禽類への重大な影響が懸念される。"@ja.
<< kg:id_37 prop:cause kg:id_39 >>
    prop:text-txt_contents "既設の他事業者による風力発電所と併せ、海岸線南北約7kmに渡り連続して風力発電機が設置されることとなるため"@ja.
<< kg:id_37 prop:effect kg:id_40 >>
    prop:text-txt_contents "当該区域周辺で営巣が確認されているミサゴのバードストライク等の重大な影響が懸念される。"@ja.
<< kg:id_37 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "施設の稼働後のバードストライクや希少猛禽類の生息状況に係る事後調査を適切に実施し、希少猛禽類への重大な影響が認められた場合は、専門家等からの助言を踏まえ、追加的な環境保全措置を講ずること。"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "実施区域周辺には多数の住居等が存在し、主要な眺望点に加え、日常的な生活環境の場からの景観の変化を伴うことから、地域住民の意見を踏まえ、必要に応じて予測及び評価地点を追加するとともに"@ja.
<< kg:id_42 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地域住民の意見を踏まえ、必要に応じて予測及び評価地点を追加するとともに"@ja.
<< kg:id_42 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "本事業の実施による景観への影響について、地域住民等から問い合わせがあった場合等は、丁寧に説明を行い、理解を得るよう努めること。"@ja.
}
