kg:id_41 rdf:type cls:c_17.
kg:id_37 prop:countermeasure kg:id_41.
kg:id_42 rdfs:label "景観への影響"@ja.
kg:id_42 rdf:type cls:c_224.
cls:c_224 rdfs:label "景観影響"@ja.
kg:id_43 rdfs:label "実施区域周辺に多数の住居等が存在し主要な眺望点に加え日常的な生活環境の場からの景観の変化を伴う"@ja.
kg:id_43 rdf:type cls:c_13593.
kg:id_42 prop:cause kg:id_43.
