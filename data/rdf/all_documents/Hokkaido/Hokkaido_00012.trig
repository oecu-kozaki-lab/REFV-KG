kg:st_1 rdfs:label "石山英雄町長"@ja.
kg:st_1 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "持続できる町を作る必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "持続できる町を作るため方策を模索している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "松前事務所の布目海大氏"@ja.
kg:st_2 rdf:type cls:st_192.
cls:st_192 rdfs:label "事業担当者"@ja.
kg:op_3 prop:content "蓄電池の容量が大きく不足しない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "戦略事業ユニット インフラ・インダストリー事業本部インフラ事業企画部の中原靖雄統括部長"@ja.
kg:st_3 rdf:type cls:st_193.
cls:st_193 rdfs:label "事業責任者"@ja.
kg:op_4 prop:content "松前町には風という自然資源がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "松前商工会青年部の佐藤光部長"@ja.
kg:st_4 rdf:type cls:st_194.
cls:st_194 rdfs:label "地域団体代表"@ja.
kg:op_5 prop:content "風力発電の電力を祭りで使いたいと提案した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:st_5 rdfs:label "ビールを販売していた町民"@ja.
kg:st_5 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_6 prop:content "町中で多くの子供を見かけてうれしい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_5.
kg:st_6 rdfs:label "生まれも育ちも松前町の佐藤光部長"@ja.
kg:st_6 rdf:type cls:st_194.
kg:op_7 prop:content "ここまで地元に協力的な企業は初めてで町の未来が明るくなった"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_6.
kg:op_8 prop:content "地域の活性化につなげたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "漁業振興につながらないと漁師の理解を得られない"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "新たな産業と雇用の創出につなげたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "全国各地の生産者に高く売れる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:st_7 rdfs:label "東急不動産松前事務所の山中慎司所長"@ja.
kg:st_7 rdf:type cls:st_192.
kg:op_12 prop:content "地元で電力を消費し町外にお金が流出しにくい環境を作るのがよい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_7.
kg:op_13 prop:content "持続できる町を作るため方策を模索している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "地元で電力を消費し町外にお金が流出しにくい環境を作りたい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_7.
kg:op_15 prop:content "風力発電の電力を祭りで使いたいと提案した"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "地理的条件の悪さで誘致が実現しなかった"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "新たな産業と雇用の創出につなげたい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "人口減少のスピードを遅らせることを重視して手伝いたい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_7.
kg:op_19 prop:content "地域の行事参加やノウハウを町づくりに生かしたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "北海道最南端の町は、国内の多くの過疎地と同様に人口の高齢化と減少という課題に直面している"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "近年は主力産業である漁業の衰退が人口減少に拍車をかけている"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:text-txt_contents "地球温暖化の影響でスルメイカの漁獲量は4年間で8割減少し"@ja.
<< kg:id_4 prop:cause kg:id_6 >>
    prop:text-txt_contents "マグロの漁獲量は漁業規制の影響で同4割減った"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "観光業も新型コロナウイルスの影響でふるわない"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "発電量が足りない時には蓄電池で調整して安定的に電力を供給できるのが特徴だ"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "松前町がある北海道の日本海沿いの地域は、冬には秒速10メートルを超す強い季節風が吹き、風力発電に適している"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:text-txt_contents "これまでの傾向が続けば2045年には同町の人口は2000人を下回る見通しだ"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:text-txt_contents "漁業収入が減った町民が町外に出稼ぎするケースが増え"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:text-txt_contents "就職するために札幌市や函館市、あるいは首都圏などに移住する若者が多いという"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "照明の電力はすべて、リエネ松前町風力発電所から車で運んだ小型の蓄電池でまかなった。電灯の下で親子連れなどの地域住民が、地元企業や東急不動産が提供した景品が当たるゲームなどを楽しんだ"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "昨年のサマーフェスト以降、町内の様々なイベントに電力を供給し、町民の間で東急不動産の知名度は高まった"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "償却資産として多数の風車がある同町には固定資産税が入ってくる"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "洋上風力にも固定資産税がかかるので財政面で大きな効果が期待できる"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:text-txt_contents "建設工事に伴う地元経済への波及効果も見込める"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:text-txt_contents "風力発電は遠隔で監視・制御が可能で、工事が終われば地元に新たな雇用は生まれない"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "研修後も同町で就農する場合は牛舎を賃貸するなど支援することで、町内の定住者を増やす狙いだ"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "松前の風車の下で生まれ育った肉牛は全国各地の生産者に高く売れる」と、新たな産業と雇用の創出につなげる考えだ"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "地域マイクログリッドのように地元で電力を消費してもらい、町外にお金が流出しにくい環境を作るのがいいと考えている"@ja.
<< kg:id_13 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "そんな町が「風車と牛」を地域再生の起爆剤にしようとしている"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:text-txt_contents "大型風車を追加設置するための環境アセスメントを進めている"@ja.
<< kg:id_37 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "風力で発電した電力を地元に供給する「地域マイクログリッド」を同町の一部地域で22年度中に導入する予定だ"@ja.
<< kg:id_37 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "昨年のサマーフェスト以降、町内の様々なイベントに電力を供給し"@ja.
<< kg:id_13 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "前町長の時代から町外企業の誘致活動を続けてきた"@ja.
<< kg:id_13 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "国の地方交付税交付金を活用して町営の「肉牛改良センター」を設けて研修生を募っている"@ja.
<< kg:id_13 prop:countermeasure kg:id_43 >>
    prop:text-txt_contents "研修後も同町で就農する場合は牛舎を賃貸するなど支援することで、町内の定住者を増やす狙いだ"@ja.
<< kg:id_13 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "松前町は22年3月、まちづくり計画策定に関する協定書を東急不動産と締結した"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:text-txt_contents "再生可能エネルギーで発電した電力を本州に送るため、新しい海底送電線の整備計画の策定に入る方針を決めた"@ja.
<< kg:id_13 prop:countermeasure kg:id_47 >>
    prop:text-txt_contents "市街地は景観を守るため風力発電の設置を規制している"@ja.
}
