kg:st_1 rdf:type cls:st_190.
cls:st_190 rdfs:label "行政と企業"@ja.
kg:op_1 prop:content "町民生活の質を維持・向上させる生活満足度の高いまちを目指す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "課題解決のため民間企業の知見を取り入れる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "生活満足度の高いまちを目指した計画作成に着手"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "持続可能であり続け町の変革と再びジャンプするためのビジョンをまとめた"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "東急不動産"@ja.
kg:st_2 rdf:type cls:st_53.
cls:st_53 rdfs:label "企業"@ja.
kg:op_5 prop:content "非常時に風力発電所の電力を活用できるシステムを検討"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "再生可能エネルギーに関する出前授業を実施"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "本ビジョンの推進について協力していく"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地域貢献活動を本ビジョンと連動した体系的な取り組みにする予定"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "絶対的な人口減少の中にあっても"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "松前町は2045年の人口が約2,000人未満（2023年3月1日現在 6,183人 出展：松前町公式HP）と予測されるなど人口減への取り組みが課題"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "絶対的な人口減少の中にあっても町民生活の質を維持・向上させる「生活満足度の高いまち」であることを目指した"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "2022年4月に課題解決に民間企業の知見を取り入れることを目的に協定を締結"@ja.
<< kg:id_6 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "共同で町の将来計画である「松前町スマート・シュリンクSXビジョン」を作成しました"@ja.
<< kg:id_6 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "持続可能であり続け、町の変革と再びジャンプするために力をためる「スマート・シュリンク（賢く縮む）」の考えを取り入れた本ビジョンを取りまとめました"@ja.
<< kg:id_6 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "再生可能エネルギー資源を活用した脱炭素への取り組み"@ja.
<< kg:id_6 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "畜産など新たな産業も加えて産業の維持と活性化を目指す計画"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "東急不動産は非常時に風力発電所の電力を活用できるシステムの検討"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "再生可能エネルギーに関する小中学校での出前授業など地域への貢献活動を実施しています"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:text-txt_contents "今年度からスタートする「松前町総合計画 後期計画」に反映されます"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "松前町と東急不動産は、本ビジョンの推進について協力していくことで合意し、実施に向けて動き出してまいります"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "東急不動産が続けてきた地域貢献活動を本ビジョンと連動した体系的な取り組みとする予定です"@ja.
}
