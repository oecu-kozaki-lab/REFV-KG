prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "（仮称）古平・余市ウィンドファーム事業"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "環境影響の調査"@ja.
kg:id_2 rdf:type cls:c_14525.
cls:c_14525 rdfs:label "環境影響調査"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "環境影響の予測"@ja.
kg:id_3 rdf:type cls:c_395.
cls:c_395 rdfs:label "環境影響予測"@ja.
kg:id_1 prop:countermeasure kg:id_3.
kg:id_4 rdfs:label "評価方法等をまとめた環境影響評価方法書の提出"@ja.
kg:id_4 rdf:type cls:c_14526.
cls:c_14526 rdfs:label "評価書提出"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "北海道知事に意見を求める"@ja.
kg:id_5 rdf:type cls:c_99.
cls:c_99 rdfs:label "意見聴取"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "方法書等の公表"@ja.
kg:id_6 rdf:type cls:c_11.
cls:c_11 rdfs:label "情報公開"@ja.
kg:id_1 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "地域の皆さまや関係行政機関からの意見を賜る"@ja.
kg:id_7 rdf:type cls:c_99.
kg:id_1 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "再生可能エネルギーの普及・拡大"@ja.
kg:id_8 rdf:type cls:c_14527.
cls:c_14527 rdfs:label "再生可能エネルギー普及"@ja.
kg:id_9 rdfs:label "ゼロカーボン社会の実現に貢献"@ja.
kg:id_9 rdf:type cls:c_14528.
cls:c_14528 rdfs:label "脱炭素社会"@ja.
kg:id_8 prop:effect kg:id_9.
kg:st_1 rdfs:label "関西電力株式会社"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "環境保全に十分配慮して事業開発を検討する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "環境保全に十分配慮して事業開発を検討する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地域の皆さまや関係行政機関の意見を受けて事業開発を進める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域の皆さまや関係行政機関の意見を受けて事業開発を進める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "方法書を関係行政機関とホームページで公表する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "環境保全に十分配慮した事業開発の検討を進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "2040年までに国内で新規開発500万kW、累計開発900万kW規模を目標に取り組む"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "当該事業に関して本日、環境影響評価法に基づき、環境影響の調査、予測および評価方法等をまとめた環境影響評価方法書等を経済産業大臣へ提出を行い、北海道知事に意見を求めました。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "当該事業に関して本日、環境影響評価法に基づき、環境影響の調査、予測および評価方法等をまとめた環境影響評価方法書等を経済産業大臣へ提出を行い、北海道知事に意見を求めました。"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "当該事業に関して本日、環境影響評価法に基づき、環境影響の調査、予測および評価方法等をまとめた環境影響評価方法書等を経済産業大臣へ提出を行い、北海道知事に意見を求めました。"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "当社は、環境影響評価法等に基づき、「（仮称）古平・仁木・余市ウィンドファーム事業に係る計画段階環境配慮書※」等を２０２２年５月３０日に経済産業大臣に提出し、北海道知事に意見を求めました。"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "方法書等は、本年１１月２２日から１２月２２日まで、関係行政機関および当社ホームページで公表します。"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "当社は引き続き、地域の皆さまや関係行政機関からのご意見を賜り、環境保全に十分配慮した事業開発の検討を進めてまいります。"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "当社グループは、２０４０年までに国内で新規開発５００万ｋＷ、累計開発９００万ｋＷ規模を目標に再生可能エネルギーの普及・拡大に取り組み、ゼロカーボン社会の実現に貢献してまいります。"@ja.
}
