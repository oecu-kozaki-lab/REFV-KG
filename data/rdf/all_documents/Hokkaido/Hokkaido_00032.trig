PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00032> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "ソバの種まき"@ja.
kg:id_1 rdf:type cls:c_14604.
cls:c_14604 rdfs:label "農作業"@ja.
kg:id_2 rdfs:label "風が強い環境でも育つソバを町の特産品にしようとしたこと"@ja.
kg:id_2 rdf:type cls:c_14605.
cls:c_14605 rdfs:label "特産品化"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "松前高が授業「松前学」の一環で昨年に続き企画したこと"@ja.
kg:id_3 rdf:type cls:c_7024.
cls:c_7024 rdfs:label "教育活動"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "秋ごろに5キロの収穫を見込む"@ja.
kg:id_4 rdf:type cls:c_14606.
cls:c_14606 rdfs:label "収穫"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "今後はそばを使った新メニューを考える予定"@ja.
kg:id_5 rdf:type cls:c_7228.
cls:c_7228 rdfs:label "商品開発"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:st_1 rdfs:label "松前高3年 平沼恵多さん・熊谷琥太郎さん"@ja.
kg:st_1 rdf:type cls:st_201.
cls:st_201 rdfs:label "生徒"@ja.
kg:op_1 prop:content "マグロを厚く切って天ぷらにするなど付け合わせを考えて町の特産品を作りたい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "風が強い環境でも育つソバを町の特産品にしようと、同高が授業「松前学」の一環で昨年に続き企画した。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "風が強い環境でも育つソバを町の特産品にしようと、同高が授業「松前学」の一環で昨年に続き企画した。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "秋ごろに5キロの収穫を見込む。"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今後はそばを使った新メニューを考える予定。3年の平沼恵多さん（17）と熊谷琥太郎さん（17）は「マグロを厚く切って天ぷらにするなど、付け合わせを考えて町の特産品を作りたい」と話した。"@ja.
}
