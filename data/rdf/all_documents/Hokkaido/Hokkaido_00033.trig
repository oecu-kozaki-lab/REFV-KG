PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00033> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電事業の見学"@ja.
kg:id_1 rdf:type cls:c_14607.
cls:c_14607 rdfs:label "見学活動"@ja.
kg:id_2 rdfs:label "再生可能エネルギーについて学ぶ学習の一環"@ja.
kg:id_2 rdf:type cls:c_14608.
cls:c_14608 rdfs:label "エネルギー学習"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "児童が風車が発電する仕組みを学ぶ"@ja.
kg:id_3 rdf:type cls:c_14609.
cls:c_14609 rdfs:label "発電の理解"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "児童が積極的に質問する"@ja.
kg:id_4 rdf:type cls:c_14610.
cls:c_14610 rdfs:label "質問行為"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "児童が変電施設や管理施設なども見学する"@ja.
kg:id_5 rdf:type cls:c_4947.
cls:c_4947 rdfs:label "施設見学"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "児童が風車の部品の名前を初めて知る"@ja.
kg:id_6 rdf:type cls:c_14611.
cls:c_14611 rdfs:label "部品の理解"@ja.
kg:id_1 prop:effect kg:id_6.
kg:st_1 rdfs:label "小平朝陽さん（10）"@ja.
kg:st_1 rdf:type cls:st_202.
cls:st_202 rdfs:label "児童"@ja.
kg:op_1 prop:content "いつも見ている風車の部品名を初めて知り驚いた"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "同小が行う再生可能エネルギーについて学ぶ学習の一環で、9日に行われた。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "児童は札前地区にある大型風車前で、同社の社員から風車が発電する仕組みを学び"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "「風車の上までどうやって登るの？」などと積極的に質問していた。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "その後、建石地区の変電施設や管理施設なども見学した。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "小平朝陽さん（10）は「いつも見ている風車の、いろいろな部品の名前を初めて知った」と驚いた様子だった。"@ja.
}
