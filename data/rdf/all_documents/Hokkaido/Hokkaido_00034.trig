kg:st_2 rdfs:label "TENOHA松前のプロジェクトメンバー"@ja.
kg:st_2 rdf:type cls:st_1.
kg:op_2 prop:content "町の住民のひとりという視点で地域の魅力や課題を捉えたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "ここから地域の課題を解決していく拠点にする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_3 rdfs:label "町内の中高校生、役場職員"@ja.
kg:st_3 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_4 prop:content "サイネージ導入に協力する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "サイネージ導入に協力する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "サイネージ導入に協力する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "今後イベントを企画して松前町の魅力発信を行う予定"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_4 rdfs:label "一般社団法人北海道まつまえ観光物産協会"@ja.
kg:st_4 rdf:type cls:st_109.
cls:st_109 rdfs:label "観光団体"@ja.
kg:op_8 prop:content "町内物産品のPR催事やガイドツアー案内所として活用する"@ja.
kg:op_8 rdf:type cls:opinion.
