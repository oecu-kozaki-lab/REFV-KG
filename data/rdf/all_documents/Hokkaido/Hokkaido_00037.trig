 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "松前再エネ電力"@ja.
kg:id_1 rdf:type cls:c_14634.
cls:c_14634 rdfs:label "電力会社"@ja.
kg:id_2 rdfs:label "町内への電力供給"@ja.
kg:id_2 rdf:type cls:c_12161.
cls:c_12161 rdfs:label "電力供給"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "東急不動産"@ja.
kg:id_3 rdf:type cls:c_14635.
cls:c_14635 rdfs:label "不動産会社"@ja.
kg:id_4 rdfs:label "地域新電力会社の設立"@ja.
kg:id_4 rdf:type cls:c_14636.
cls:c_14636 rdfs:label "電力会社設立"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "町内の風力発電事業"@ja.
kg:id_5 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_1 prop:cause kg:id_5.
kg:id_6 rdfs:label "町内の電気料金の低下"@ja.
kg:id_6 rdf:type cls:c_14637.
cls:c_14637 rdfs:label "電気料金低下"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "企業進出の増加"@ja.
kg:id_7 rdf:type cls:c_14638.
cls:c_14638 rdfs:label "企業進出増加"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "起業の増加"@ja.
kg:id_8 rdf:type cls:c_14639.
cls:c_14639 rdfs:label "起業増加"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "洋上風況調査や営農型発電の検討"@ja.
kg:id_9 rdf:type cls:c_14640.
cls:c_14640 rdfs:label "発電事業検討"@ja.
kg:id_1 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "公共施設や公共交通機関向けの電力供給"@ja.
kg:id_10 rdf:type cls:c_14641.
cls:c_14641 rdfs:label "公共向け電力供給"@ja.
kg:id_1 prop:countermeasure kg:id_10.
kg:st_1 rdfs:label "松前町長"@ja.
kg:st_1 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "電気料金が安くなれば企業進出や起業増加につながると期待"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "電気料金が安くなると見込む"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "電気料金低下で企業進出が増えると期待"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "電気料金低下で起業が増えると期待"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "町と、町内で陸上風力発電事業を行う東急不動産、電気を供給する地域新電力会社を町内に設立する方向で調整している。発電事業は、松前再エネ電力が設立後、東急不動産が出資して設立する特別目的会社（SPC）する特別目的会社（SPC）が担う。全町内の使用量に相当する2基分の電力をいったんエネから購入し、町内の一般家庭や役場、企業などに供給する。町長は「電気料金が安くなれば、企業進出や起業が増えるだろう」と述べた"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "町と、町内で陸上風力発電事業を行う東急不動産、電気を供給する地域新電力会社を町内に設立する方向で調整している"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "町と、町内で陸上風力発電事業を行う東急不動産、電気を供給する地域新電力会社を町内に設立する方向で調整している"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "既存の電力会社よりも1〜3割安い料金での販売を目指している。町長は「電気料金が安くなれば、企業進出や起業が増えるだろう」と述べた"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "町長は「電気料金が安くなれば、企業進出や起業が増えるだろう」と述べた"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "町長は「電気料金が安くなれば、企業進出や起業が増えるだろう」と述べた"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "会社では、洋上風況調査などを担い、また、ソーラーパネルの下で農作物を育てる営農型発電の事業化も見込む。また、「リエネ」の取次店として電力を町との公共施設や公共交通機関向けに供給し、収益を得る"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "また、「リエネ」の取次店として電力を町との公共施設や公共交通機関向けに供給し、収益を得る"@ja.
}
