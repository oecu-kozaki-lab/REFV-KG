kg:op_1 prop:content "歓迎の意向を示す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "上ノ国町長 工藤昇"@ja.
kg:st_2 rdf:type cls:st_11.
kg:op_2 prop:content "風力産業による新たな段階に入るとみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "せたな町長 高橋貞光"@ja.
kg:st_3 rdf:type cls:st_11.
kg:op_3 prop:content "計画前進を大いに歓迎する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "将来を見据える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "風力関連事業を新たな産業に位置づける構え"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "風力関連事業を新たな産業に位置づける構え"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_4 rdfs:label "乙部町"@ja.
kg:st_4 rdf:type cls:st_11.
kg:op_7 prop:content "健康被害への懸念が払拭されないため離脱した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:st_5 rdfs:label "松前町長 若佐智弘"@ja.
kg:st_5 rdf:type cls:st_11.
kg:op_8 prop:content "雇用創出や再エネ電力供給などの夢が広がると期待する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_5.
kg:op_9 prop:content "順調に進んでほしいと期待する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_5.
kg:st_6 rdfs:label "松前さくら漁協組合長 吉田直樹"@ja.
kg:st_6 rdf:type cls:st_205.
cls:st_205 rdfs:label "漁業者"@ja.
kg:op_10 prop:content "漁獲低迷の中で増産につなげたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_6.
kg:op_11 prop:content "基金活用で養殖ナマコ増産につなげたい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_6.
kg:st_7 rdfs:label "発電事業者の担当"@ja.
kg:st_7 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_12 prop:content "規模が大きく魅力のある海域だと評価する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_7.
kg:op_13 prop:content "漁業者の同意があり非常に魅力的なので実施したい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_7.
kg:st_8 rdfs:label "多くの住民"@ja.
kg:st_8 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_14 prop:content "風車の設置場所に関心を寄せている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_8.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "経済産業省と国土交通省が、松前沖と檜山沖を8月にも再エネ海域利用法に基づく「促進区域」に指定する案を公告したことで、沿岸の自治体などからは歓迎の意向が示された。道内初の大型洋上風力発電所がいよいよ現実味を帯び"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "道内初の大型洋上風力発電所がいよいよ現実味を帯び、今後は事業者の選定手続きが主な焦点となりそうだ。"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "今後は事業者の選定手続きが主な焦点となりそうだ。"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "檜山沖の洋上風力が実現すれば巨額投資が予想され"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "稼働後も多くの業務がある。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "漁業が先細りする中、風力関連事業を新たな「産業」に位置づける構えだ。"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "乙部町は「沿岸近くでの巨大風車稼働で騒音や低周波などによる健康被害への懸念が払拭されない」との理由で、21年1月に同協議会を離脱。"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:text-txt_contents "23年5月には同法に基づく「有望区域」に格上げされ、対象海域から乙部町沖が外れた。"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:text-txt_contents "水深20メートル以下の海域やフェリー航路周辺で風車を建てないことなどを固めていき"@ja.
<< kg:id_15 prop:countermeasure kg:id_17 >>
    prop:text-txt_contents "水深20メートル以下の海域やフェリー航路周辺で風車を建てないことなどを固めていき"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:text-txt_contents "同年10月に松前さくら漁協が理事会で誘致に同意し"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:text-txt_contents "町も誘致方針を決めた。"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "松前町の若佐智弘町長は「雇用創出や再エネ電力供給などの夢が広がる。"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "松前町の若佐智弘町長は「雇用創出や再エネ電力供給などの夢が広がる。本州では課題が出ているが、ここでは順調に進んでほしい」"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "松前さくら漁協の吉田直樹組合長は「イカやマグロの漁獲が伸びない中"@ja.
<< kg:id_24 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "事業者が積み立てる基金を活用し、養殖ナマコ増産につなげたい"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "檜山沖は想定最大出力が国内最大規模となる114万キロワットで"@ja.
<< kg:id_27 prop:cause kg:id_29 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "発電事業者の担当は「規模が大きく、漁業者の同意が得られている檜山沖は非常に魅力のある海域。ぜひここでやりたい」"@ja.
<< kg:id_27 prop:countermeasure kg:id_30 >>
    prop:text-txt_contents "国が事業者に代わって行う事前の「セントラル方式」の海底地盤調査なども終えており"@ja.
<< kg:id_27 prop:effect kg:id_31 >>
    prop:text-txt_contents "今後データが事業者側に提供される方向だ。"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:text-txt_contents "実際に風力発電を行う事業者が決まるのは、入札などを経て来年以降となる見通し。"@ja.
<< kg:id_32 prop:effect kg:id_34 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "これまで事業者が開いた住民説明会で多くの住民が関心を寄せた「風車の設置場所」が判明するのは、さらに先となりそうだ。"@ja.
}
