 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "洋上風力発電事業"@ja.
kg:id_1 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "松前沖と檜山沖を促進区域に指定"@ja.
kg:id_2 rdf:type cls:c_9861.
cls:c_9861 rdfs:label "区域指定"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "発電事業者を公募"@ja.
kg:id_3 rdf:type cls:c_14722.
cls:c_14722 rdfs:label "事業者公募"@ja.
kg:id_1 prop:countermeasure kg:id_3.
kg:id_4 rdfs:label "選ばれた事業者は最長30年間区域を占用できる"@ja.
kg:id_4 rdf:type cls:c_14723.
cls:c_14723 rdfs:label "区域占用"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "檜山沖の想定出力は国内最大の114万キロワット"@ja.
kg:id_5 rdf:type cls:c_14724.
cls:c_14724 rdfs:label "発電能力"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "風車の基礎を海底に固定する着床式を整備"@ja.
kg:id_6 rdf:type cls:c_7409.
cls:c_7409 rdfs:label "発電設備"@ja.
kg:id_1 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "洋上風力発電事業の進展"@ja.
kg:id_7 rdf:type cls:c_14725.
cls:c_14725 rdfs:label "事業進展"@ja.
kg:id_8 rdfs:label "物価高などを背景にした建設コストの高騰"@ja.
kg:id_8 rdf:type cls:c_6442.
cls:c_6442 rdfs:label "建設費高騰"@ja.
kg:id_7 prop:cause kg:id_8.
kg:id_9 rdfs:label "物価変動を一定程度売電価格に反映できるよう公募ルールを見直し"@ja.
kg:id_9 rdf:type cls:c_14726.
cls:c_14726 rdfs:label "公募規則見直し"@ja.
kg:id_1 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "公募ルール見直しに時間を要する可能性がある"@ja.
kg:id_10 rdf:type cls:c_14727.
cls:c_14727 rdfs:label "手続き遅延"@ja.
kg:id_1 prop:effect kg:id_10.
kg:id_11 rdfs:label "松前町の洋上風力発電事業"@ja.
kg:id_11 rdf:type cls:c_552.
kg:id_12 rdfs:label "町の将来がかかっている"@ja.
kg:id_12 rdf:type cls:c_10915.
cls:c_10915 rdfs:label "地域将来"@ja.
kg:id_11 prop:effect kg:id_12.
kg:id_13 rdfs:label "発電事業者が風車の建設時期など決められた条件を守る"@ja.
kg:id_13 rdf:type cls:c_14728.
cls:c_14728 rdfs:label "条件順守"@ja.
kg:id_1 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "建設や維持管理など関連産業の裾野が広い"@ja.
kg:id_14 rdf:type cls:c_14729.
cls:c_14729 rdfs:label "関連産業"@ja.
kg:id_1 prop:effect kg:id_14.
kg:id_15 rdfs:label "大きな投資が町のあり方も変える"@ja.
kg:id_15 rdf:type cls:c_14730.
cls:c_14730 rdfs:label "地域機会"@ja.
kg:id_1 prop:effect kg:id_15.
kg:id_16 rdfs:label "促進区域指定"@ja.
kg:id_16 rdf:type cls:c_9861.
kg:id_17 rdfs:label "漁業者などとの調整に時間がかかっている"@ja.
kg:id_17 rdf:type cls:c_14731.
cls:c_14731 rdfs:label "利害調整"@ja.
kg:id_16 prop:cause kg:id_17.
kg:id_18 rdfs:label "洋上風力発電の開発"@ja.
kg:id_18 rdf:type cls:c_14732.
cls:c_14732 rdfs:label "発電開発"@ja.
kg:id_19 rdfs:label "地元の理解が前提"@ja.
kg:id_19 rdf:type cls:c_14733.
cls:c_14733 rdfs:label "地域理解"@ja.
kg:id_18 prop:cause kg:id_19.
kg:id_20 rdfs:label "岩宇・南後志地区沖の洋上風力発電事業"@ja.
kg:id_20 rdf:type cls:c_552.
kg:id_21 rdfs:label "漁業や環境への影響調査の検討を進める"@ja.
kg:id_21 rdf:type cls:c_2827.
cls:c_2827 rdfs:label "影響調査"@ja.
kg:id_20 prop:countermeasure kg:id_21.
kg:st_1 rdfs:label "両区域の関係者"@ja.
kg:st_1 rdf:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_1 prop:content "事業の着実な進展を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "渡島管内松前町の若佐智弘町長"@ja.
kg:st_2 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_2 prop:content "時間がかかっても確実に進めてほしい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "松前さくら漁協（同町）の吉田直樹組合長"@ja.
kg:st_3 rdf:type cls:st_206.
cls:st_206 rdfs:label "漁業団体"@ja.
kg:op_3 prop:content "促進区域指定後が本当のスタートであり条件順守を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:st_4 rdfs:label "檜山管内上ノ国町の工藤昇町長"@ja.
kg:st_4 rdf:type cls:st_33.
kg:op_4 prop:content "管内全体にとってチャンスだ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_4.
kg:st_5 rdfs:label "道GX推進課"@ja.
kg:st_5 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_5 prop:content "地域との共存を図りながら導入を進めたい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_5.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "経済産業省と国土交通省は25日、洋上風力発電事業が可能になる「促進区域」に、道内で初めて松前沖と檜山沖を指定する案を公表した。法定手続きを経て早ければ8月にも指定となる見込みで、発電事業者の公募は来春にも行われる可能性がある。両区域の関係者からは事業の着実な進展を求める声が上がった。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:text-txt_contents "国は指定後、発電事業を行う事業者を公募する。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "選ばれた事業者は最長30年間、区域を占用できる。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "檜山沖は約3万2159ヘクタール、想定出力は国内最大の114万キロワットで、北海道電力泊原発3号機（91万2千キロワット）を上回る。"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "両区域とも風車の基礎を海底に固定する「着床式」を整備する。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "一方、物価高などを背景にした建設コストの高騰が事業進展への大きな課題で"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "経産省は物価変動を一定程度、売電価格に反映できるようにするなど公募ルールの見直しを検討している。"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:text-txt_contents "松前沖、檜山沖の公募は新ルールで行われる見通しだが、論点が多く見直しに時間を要する可能性もある。"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "渡島管内松前町の若佐智弘町長は「洋上風力発電は町の将来がかかっている事業。時間がかかったとしても確実に進めてもらいたい」と期待する。"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "松前さくら漁協（同町）の吉田直樹組合長は「促進区域に指定されてからが本当のスタート。発電事業者には風車の建設時期など決められた条件を守ってもらいたい」とした。"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:text-txt_contents "洋上風力発電の設備は部品が数万点に上り、建設や維持管理など関連産業の裾野が広い。"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "檜山管内上ノ国町の工藤昇町長は「大きな投資が町のあり方も変えることになる。管内全体にとってチャンスだ」と強調した。"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:text-txt_contents "石狩市沖と島牧沖は法定協が立ち上がっておらず、促進区域指定のめどが立っていない。漁業者などとの調整に時間がかかっていることが理由という。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "道は「洋上風力発電の開発は地元の理解が前提。地域との共存を図りながら導入を進めたい」（GX推進課）としている。"@ja.
<< kg:id_20 prop:countermeasure kg:id_21 >>
    prop:text-txt_contents "後志管内の岩宇・南後志地区沖は自治体や漁業関係者らによる法定協議会がすでに2回開かれ、漁業や環境への影響調査の検討が進む。"@ja.
}
