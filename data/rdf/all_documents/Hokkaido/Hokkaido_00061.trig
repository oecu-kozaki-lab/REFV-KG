PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00061> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原周辺で相次ぐ大規模太陽光発電所建設"@ja.
kg:id_1 rdf:type cls:c_14564.
cls:c_14564 rdfs:label "太陽光発電所建設"@ja.
kg:id_2 rdfs:label "釧路湿原周辺で太陽光発電所建設が相次いでいること"@ja.
kg:id_2 rdf:type cls:c_14564.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "野生生物保護の観点で対応策の検討が必要になる"@ja.
kg:id_3 rdf:type cls:c_14798.
cls:c_14798 rdfs:label "対応策の検討"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "湿原全体の保全を考える必要がある"@ja.
kg:id_4 rdf:type cls:c_14799.
cls:c_14799 rdfs:label "湿原保全"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "法改正による規制強化"@ja.
kg:id_5 rdf:type cls:c_14800.
cls:c_14800 rdfs:label "規制強化"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "太陽光発電所建設を市の許可制とする条例施行"@ja.
kg:id_6 rdf:type cls:c_14801.
cls:c_14801 rdfs:label "許可制条例"@ja.
kg:id_1 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "建設を規制できる区域の設定"@ja.
kg:id_7 rdf:type cls:c_14802.
cls:c_14802 rdfs:label "規制区域設定"@ja.
kg:id_1 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "太陽光パネルの廃棄費用の積み立て"@ja.
kg:id_8 rdf:type cls:c_14803.
cls:c_14803 rdfs:label "廃棄費用積立"@ja.
kg:id_1 prop:countermeasure kg:id_8.
kg:st_1 rdfs:label "環境省野生生物課の川越久史課長"@ja.
kg:st_1 rdf:type cls:st_93.
cls:st_93 rdfs:label "行政担当者"@ja.
kg:op_1 prop:content "湿原全体をどのように保全していくか考えたい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "湿原全体の保全をしっかり考えたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市の鶴間秀典市長"@ja.
kg:st_2 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_3 prop:content "自然を守れる法整備をできるだけ早く望む"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "市の許可制とする条例施行を目指すと説明"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "国に法整備による対応を求めた"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "国に法整備による対応を求めた"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "釧路湿原周辺で大規模太陽光発電所（メガソーラー）建設が相次いでいることを受け"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "川越課長は湿原周辺の太陽光発電所建設に関し、野生生物保護の観点で対応策を検討するため道東を訪問"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "湿原全体をどのように保全していくかしっかりと考えたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "釧路市の鶴間秀典市長は1日、環境省野生生物課の川越久史課長と市役所で意見交換し、法改正による規制強化を求めた"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "太陽光発電所建設を市の許可制とする条例施行を目指していることを鶴間市長が説明した"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "国に対し、建設を規制できる区域の設定や太陽光パネルの廃棄費用の積み立てに関し、法整備による対応を求めた"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "国に対し、建設を規制できる区域の設定や太陽光パネルの廃棄費用の積み立てに関し、法整備による対応を求めた"@ja.
}
