PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00064> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原周辺メガソーラー建設"@ja.
kg:id_1 rdf:type cls:c_6284.
cls:c_6284 rdfs:label "開発事業"@ja.
kg:id_2 rdfs:label "事業者が森林法で義務づけられた書類の提出を約4カ月遅らせたこと"@ja.
kg:id_2 rdf:type cls:c_14827.
cls:c_14827 rdfs:label "書類提出遅延"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "事業者が提出書類の日付を期限の4月30日と記したこと"@ja.
kg:id_3 rdf:type cls:c_14828.
cls:c_14828 rdfs:label "虚偽記載"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "市が実際の日付と異なることに気づきながら書類を受理したこと"@ja.
kg:id_4 rdf:type cls:c_14829.
cls:c_14829 rdfs:label "書類受理"@ja.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "市担当職員が事業者に届け出と整合性が合うような形でと伝えたこと"@ja.
kg:id_5 rdf:type cls:c_14830.
cls:c_14830 rdfs:label "指示"@ja.
kg:id_1 prop:cause kg:id_5.
kg:id_6 rdfs:label "提出書類の日付偽装を市が黙認したと受け取られること"@ja.
kg:id_6 rdf:type cls:c_14831.
cls:c_14831 rdfs:label "黙認"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "報告の遅れが木村氏に伝わらなかったこと"@ja.
kg:id_7 rdf:type cls:c_84.
cls:c_84 rdfs:label "説明不足"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "後から整合性を取れば良いという悪しき前例になりかねないこと"@ja.
kg:id_8 rdf:type cls:c_14832.
cls:c_14832 rdfs:label "悪しき前例"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "釧路市"@ja.
kg:id_9 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_10 rdfs:label "事業者に報告書の提出を求めたこと"@ja.
kg:id_10 rdf:type cls:c_14833.
cls:c_14833 rdfs:label "提出要求"@ja.
kg:id_9 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "4月30日付と記された報告書をそのまま受理したこと"@ja.
kg:id_11 rdf:type cls:c_14829.
kg:id_9 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "釧路市産業振興部"@ja.
kg:id_12 rdf:type cls:c_4902.
cls:c_4902 rdfs:label "行政組織"@ja.
kg:id_13 rdfs:label "説明が言葉足らずだったと釈明したこと"@ja.
kg:id_13 rdf:type cls:c_14834.
cls:c_14834 rdfs:label "釈明"@ja.
kg:id_12 prop:countermeasure kg:id_13.
kg:st_1 rdfs:label "釧路市議 木村隼人氏"@ja.
kg:st_1 rdf:type cls:st_97.
cls:st_97 rdfs:label "地方議員"@ja.
kg:op_1 prop:content "伐採後の無報告は森林法違反だと指摘"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "虚偽報告も森林法違反だと指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "重大な問題だと指摘"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "早坂正俊 釧路市産業振興部長"@ja.
kg:st_2 rdf:type cls:st_93.
cls:st_93 rdfs:label "行政担当者"@ja.
kg:op_4 prop:content "面積や伐採方法などを記した届け出と合うようにという意図だったと説明"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "重大な問題だと指摘"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_3 rdfs:label "釧路市産業振興部"@ja.
kg:st_3 rdf:type cls:st_211.
cls:st_211 rdfs:label "行政組織"@ja.
kg:op_6 prop:content "説明が言葉足らずだったと釈明"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "後から整合性を取れば良いというのは悪しき前例になりかねないと懸念"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_4 rdfs:label "釧路市産業振興部 担当職員"@ja.
kg:st_4 rdf:type cls:st_93.
kg:op_8 prop:content "提出期限という届け出との整合性をとった結果と捉えた"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "報告の遅れを隠そうとした意図はなかったと説明"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業者が森林法で義務づけられた書類を提出したのは8月25日と期限より約4カ月遅かった"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "期限の4月30日と記していたことがわかった"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市は実際の日付と異なることに気づいていたが、書類を受理した。市議は「重大な問題」と指摘する"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "25日に担当職員が同社に提出を求めた際、「届け出と整合性が合うような形で」と伝えた結果、同日に提出日が4月30日と記された報告書が提出された"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "市、事業者提出書類の偽装黙認"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "8月26日に担当職員が木村氏に「4月30日付の報告書を受理した」と伝えたが、提出が約4カ月遅れたことは伝えなかった"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "後から整合性を取れば良いというのは、あしき前例になりかねない"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "25日に担当職員が同社に提出を求めた"@ja.
<< kg:id_9 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "担当職員は「4月30日が提出期限という届け出との整合性をとった結果」と捉えて日付の修正を求めず、そのまま受理したという"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "同部は「説明が言葉足らずだった」と釈明。報告の遅れを隠そうとしたとの意図はなかったとしている"@ja.
}
