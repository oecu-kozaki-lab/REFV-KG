kg:id_6 rdf:type cls:c_348.
cls:c_348 rdfs:label "環境影響"@ja.
kg:id_5 prop:cause kg:id_6.
kg:id_7 rdfs:label "厚田区で風車を建てる計画が目白押しであること"@ja.
kg:id_7 rdf:type cls:c_88.
kg:id_8 rdfs:label "厚田区の大半が環境保全エリアに指定されているにもかかわらず計画が進んでいること"@ja.
kg:id_8 rdf:type cls:c_8302.
cls:c_8302 rdfs:label "保全区域"@ja.
kg:id_7 prop:cause kg:id_8.
kg:id_9 rdfs:label "石狩には自然を守る場所しかないという判断"@ja.
kg:id_9 rdf:type cls:c_14885.
cls:c_14885 rdfs:label "保全判断"@ja.
kg:id_10 rdfs:label "希少な渡り鳥アカモズの繁殖地である石狩浜をはじめ市内に多様な自然があること"@ja.
kg:id_10 rdf:type cls:c_211.
cls:c_211 rdfs:label "自然環境"@ja.
kg:id_9 prop:cause kg:id_10.
kg:id_11 rdfs:label "石狩市沖の一般海域の洋上風力発電整備検討"@ja.
kg:id_11 rdf:type cls:c_14886.
cls:c_14886 rdfs:label "洋上風力検討"@ja.
kg:id_12 rdfs:label "国が有望な区域に選定したこと"@ja.
kg:id_12 rdf:type cls:c_13297.
cls:c_13297 rdfs:label "区域選定"@ja.
kg:id_11 prop:cause kg:id_12.
kg:id_13 rdfs:label "石狩市沖の洋上風力発電計画"@ja.
kg:id_13 rdf:type cls:c_14887.
cls:c_14887 rdfs:label "洋上風力計画"@ja.
kg:id_14 rdfs:label "11ある事業想定区域がそれぞれゾーニングの環境保全エリアに重なる"@ja.
kg:id_14 rdf:type cls:c_8302.
kg:id_13 prop:effect kg:id_14.
kg:id_15 rdfs:label "条例ではなく情報提供的な意味合いにとどまる"@ja.
kg:id_15 rdf:type cls:c_176.
cls:c_176 rdfs:label "情報提供"@ja.
kg:id_3 prop:effect kg:id_15.
kg:id_16 rdfs:label "風力発電計画"@ja.
kg:id_16 rdf:type cls:c_88.
kg:id_17 rdfs:label "環境への配慮を求める"@ja.
kg:id_17 rdf:type cls:c_103.
cls:c_103 rdfs:label "環境配慮"@ja.
kg:id_16 prop:countermeasure kg:id_17.
kg:id_18 rdfs:label "洋上風力発電の実現"@ja.
kg:id_18 rdf:type cls:c_14888.
cls:c_14888 rdfs:label "洋上風力実現"@ja.
kg:id_19 rdfs:label "有望区域から促進区域に格上げし法定協議会を開いて関係者の同意を得る"@ja.
kg:id_19 rdf:type cls:c_14889.
cls:c_14889 rdfs:label "関係者同意"@ja.
kg:id_18 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "石狩湾漁協が洋上風力発電の可能性に注目すること"@ja.
kg:id_20 rdf:type cls:c_14890.
cls:c_14890 rdfs:label "可能性注目"@ja.
kg:id_21 rdfs:label "気候変動の影響で主力のサケの漁獲量が海水温上昇により減少していること"@ja.
kg:id_21 rdf:type cls:c_14891.
cls:c_14891 rdfs:label "漁業悪化"@ja.
kg:id_20 prop:cause kg:id_21.
kg:id_22 rdfs:label "気候変動"@ja.
kg:id_22 rdf:type cls:c_618.
cls:c_618 rdfs:label "気候変動"@ja.
kg:id_23 rdfs:label "主力のサケの漁獲量の減少"@ja.
kg:id_23 rdf:type cls:c_4260.
cls:c_4260 rdfs:label "漁獲減少"@ja.
kg:id_22 prop:effect kg:id_23.
kg:id_24 rdfs:label "風力発電を設置しないこと"@ja.
kg:id_24 rdf:type cls:c_14892.
cls:c_14892 rdfs:label "非設置"@ja.
kg:id_25 rdfs:label "気候変動が深刻化し鳥類の多くが絶滅の危機に瀕する"@ja.
kg:id_25 rdf:type cls:c_14893.
cls:c_14893 rdfs:label "絶滅危機"@ja.
kg:id_24 prop:effect kg:id_25.
kg:id_26 rdfs:label "鳥類への影響の最小化と気候変動対策"@ja.
kg:id_26 rdf:type cls:c_14894.
cls:c_14894 rdfs:label "影響最小化"@ja.
kg:id_27 rdfs:label "ゾーニングを活かす制度を設け可能なエリアに風車を配置する"@ja.
kg:id_27 rdf:type cls:c_14895.
cls:c_14895 rdfs:label "区域活用"@ja.
kg:id_26 prop:countermeasure kg:id_27.
kg:id_28 rdfs:label "風力発電の地域と環境への有効活用"@ja.
kg:id_28 rdf:type cls:c_5566.
cls:c_5566 rdfs:label "有効活用"@ja.
kg:id_29 rdfs:label "制度的社会的な枠組みを地域の納得のいく形で作る"@ja.
kg:id_29 rdf:type cls:c_14896.
cls:c_14896 rdfs:label "制度枠組み"@ja.
kg:id_28 prop:countermeasure kg:id_29.
kg:st_1 rdfs:label "石狩市の神代知花子市議"@ja.
kg:st_1 rdf:type cls:st_97.
cls:st_97 rdfs:label "地方議員"@ja.
kg:op_1 prop:content "チュウヒへの影響を懸念する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "石狩浜定期観察の会の安田秀子代表"@ja.
kg:st_2 rdf:type cls:st_148.
cls:st_148 rdfs:label "自然保護団体"@ja.
kg:op_2 prop:content "ゾーニングが形骸化していると嘆く"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "自然を守る場所しかないためこれ以上風車を建てるべきではないと主張する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "石狩市の加藤龍幸市長"@ja.
kg:st_3 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_4 prop:content "ゾーニングは検討委が示したひとつの判断だと説明する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "風力発電なら何でもよいわけではなく環境配慮を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:st_4 rdfs:label "事業者の1社である大手商社"@ja.
kg:st_4 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_6 prop:content "自然環境に配慮すべき区域があれば配慮しながら検討を進めたい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:op_7 prop:content "年内に法定協議会を開きたいと期待する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:st_5 rdfs:label "石狩湾漁協の新明正英専務理事"@ja.
kg:st_5 rdf:type cls:st_206.
cls:st_206 rdfs:label "漁業団体"@ja.
kg:op_8 prop:content "漁業悪化に備える選択肢として可能性を見ているが判断は慎重だ"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_5.
kg:st_6 rdfs:label "高橋真樹（ノンフィクションライター）"@ja.
kg:st_6 rdf:type cls:st_215.
cls:st_215 rdfs:label "著述家"@ja.
kg:op_9 prop:content "風車を設置しないことによる鳥類被害も考えるべきだと指摘する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_6.
kg:op_10 prop:content "ゾーニングを活かせば鳥類への影響を抑えつつ風力発電を活用できると述べる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_6.
kg:op_11 prop:content "地域が納得できる制度と社会的枠組みづくりが必要だと述べる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_6.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "近くで絶滅危惧種のチュウヒの生息が確認されており、影響が心配です"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "石狩市は2019年、市内を色分けする「ゾーニング」を決めた。住民と事業者の紛争を避けるためだ。規制が厳しい「環境保全」から、条件付きで認める「調整」「導入可能」、そして積極的に導入を進める「事業性」まで、四つのエリアの概念を定めた"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "しかし、環境や景観への影響などを考慮した結果、導入可能と事業性の両エリアは適地を指定できなかった"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "一方、厚田区の大半は環境保全エリアに指定されたが、風車を建てる計画が目白押しだ。「ゾーニングがお飾りになっている」と嘆く"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "希少な渡り鳥であるアカモズの繁殖地である石狩浜をはじめ市内には多様な自然がある。安田さんは「ゾーニングの結果は、自然を守る場所しか石狩にはないことを示した。これ以上風車を建てるべきではない」と強調する"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:text-txt_contents "国は23年5月、石狩市沖の「一般海域」を洋上風力発電の整備に向けて検討を進める「有望な区域」に選定"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:text-txt_contents "だが市によると、11ある事業想定区域がそれぞれゾーニングの環境保全エリアに重なる"@ja.
<< kg:id_3 prop:effect kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "石狩市の加藤龍幸市長(69)は「ゾーニングは条例ではなく、情報提供的な意味合い。検討委が示したひとつの判断だ」と説明"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "その上で、「風力発電ならば何でもいいわけではない。環境への配慮は求めていく」と語る。事業者の1社である大手商社は「自然環境に配慮すべき区域があれば配慮しながら検討を進めたい」という"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "洋上風力が実現するためには、有望区域から「促進区域」に格上げされる必要がある。その前提として、海域に漁業権を持つ漁協や自治体などでつくる法定協議会を開き、関係者の同意を得なければならない。加藤市長は「年内に開ければ」と期待する"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "ただ、気候変動の影響は肌で感じる。主力のサケの漁獲量は、海水温の上昇で減少が続いている。ニシンは好調だが、「もし漁業がダメになったときに備えておきたい」との思いがある"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:text-txt_contents "主力のサケの漁獲量は、海水温の上昇で減少が続いている"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "風車を設置しないことで、どれだけ多くの鳥が死んでいくかにいては話題にされません。気候変動の影響はますます深刻化し、このまま化石燃料に頼っていては、鳥類の多くが絶滅の危機に瀕してしまいます"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "記事にあるゾーニングを活かす制度を設け、可能なエリアに風車を配置することができれば、鳥類への影響を最小限にしつつ、気候変動対策の電源とすることは十分に可能です"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "必要なものは、制度的、社会的な枠組みを、地域の納得のいく形で作ることではないでしょうか"@ja.
}
