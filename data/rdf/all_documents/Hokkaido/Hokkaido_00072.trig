kg:id_3 rdfs:label "石狩市のゾーニング"@ja.
kg:id_3 rdf:type cls:c_14882.
cls:c_14882 rdfs:label "区域区分"@ja.
kg:id_4 rdfs:label "住民と事業者の紛争回避のため市内を四つのエリアに色分けする"@ja.
kg:id_4 rdf:type cls:c_14883.
cls:c_14883 rdfs:label "紛争回避"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "石狩市で導入可能と事業性の両エリアに適地を指定できなかったこと"@ja.
kg:id_5 rdf:type cls:c_14884.
cls:c_14884 rdfs:label "適地未指定"@ja.
