PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00074> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "メガソーラー建設工事"@ja.
kg:id_1 rdf:type cls:c_7151.
cls:c_7151 rdfs:label "建設工事"@ja.
kg:id_2 rdfs:label "申請より多い0.8ヘクタールの森林伐採"@ja.
kg:id_2 rdf:type cls:c_13215.
cls:c_13215 rdfs:label "森林伐採"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "0.5ヘクタール以上の伐採許可を申請せず着工"@ja.
kg:id_3 rdf:type cls:c_14917.
cls:c_14917 rdfs:label "無許可着工"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "工事の一時中断"@ja.
kg:id_4 rdf:type cls:c_14918.
cls:c_14918 rdfs:label "工事中断"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "申請より多く伐採した0.5ヘクタール区域での植林"@ja.
kg:id_5 rdf:type cls:c_14819.
cls:c_14819 rdfs:label "植林"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "11月にも工事再開"@ja.
kg:id_6 rdf:type cls:c_14919.
cls:c_14919 rdfs:label "工事再開"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "申請より多く伐採した0.5ヘクタール区域への植林"@ja.
kg:id_7 rdf:type cls:c_14819.
kg:id_1 prop:countermeasure kg:id_7.
kg:id_1 prop:countermeasure kg:id_4.
kg:st_1 rdfs:label "北海道"@ja.
kg:st_1 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_1 prop:content "一部工事の中止を勧告"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "一部工事の中止を勧告"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "日本エコロジー（大阪市）"@ja.
kg:st_2 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_3 prop:content "工事中断期間は1カ月～1カ月半程度と説明"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "関係者"@ja.
kg:st_3 rdf:type cls:st_30.
cls:st_30 rdfs:label "関係者"@ja.
kg:op_4 prop:content "植林は10～11月ごろを見込む"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "植林後に工事を再開し計画は継続"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "植林は10～11月ごろを見込む"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "一部工事の中止を勧告"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "同社は開発面積を0.3ヘクタールとし、許可を申請せずに着工したが、北海道と釧路市が0.8ヘクタールの伐採を確認。道が2日、一部工事を中止するよう勧告した。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "森林法は0.5ヘクタール以上の伐採について都道府県知事の許可を必要としている。同社は開発面積を0.3ヘクタールとし、許可を申請せずに着工した"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "日本エコロジー（大阪市）が、工事を一時中断していることが17日分かった。道によると、工事中断は11日からで、同社は期間を1カ月～1カ月半程度と説明している。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "申請より多く森林を伐採していた0.5ヘクタールの区域に植林し、11月にも工事を再開する方向だ。関係者によると、申請より多く伐採した0.5ヘクタールの区域での植林は10～11月ごろを見込む。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "申請より多く森林を伐採していた0.5ヘクタールの区域に植林し、11月にも工事を再開する方向だ。工事はその後再開し、計画自体は継続する方針という。"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "申請より多く森林を伐採していた0.5ヘクタールの区域に植林し、11月にも工事を再開する方向だ。"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "道が2日、一部工事を中止するよう勧告した。道によると、工事中断は11日からで"@ja.
}
