kg:st_2 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_3 prop:content "適切な時期に調査しており再調査要求はおかしい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "調査期間について、市が求める2年より短い1年で終えたり"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "キタサンショウウオの調査実績のない本州の企業に委託したりしていたことが判明した"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "工事による影響を評価できないと判断した"@ja.
<< kg:id_4 prop:effect kg:id_6 >>
    prop:text-txt_contents "市の天然記念物の保存に影響を及ぼす行為をしようとするとき"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "森林法違反が発覚した北斗では、国の特別天然記念物タンチョウ、天然記念物オジロワシに関する影響の懸念を市が同社に伝えている"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "森林法違反が発覚した北斗では、国の特別天然記念物タンチョウ、天然記念物オジロワシに関する影響の懸念を市が同社に伝えている"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:text-txt_contents "国の天然記念物オジロワシの営巣が確認されたなどとして、9月末までに市に計画の廃止届を出した"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "近く再調査を求める方針を固めた"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:text-txt_contents "近く再調査を求める方針を固めた"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:text-txt_contents "違反すれば許可の取り消しや工事の停止を命じられると定める"@ja.
<< kg:id_14 prop:countermeasure kg:id_17 >>
    prop:text-txt_contents "違反すれば許可の取り消しや工事の停止を命じられると定める"@ja.
<< kg:id_12 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "北海道への申請より多く伐採した区域への植林を終えたら工事を再開する方針だ"@ja.
<< kg:id_12 prop:countermeasure kg:id_19 >>
    prop:text-txt_contents "9月末までに市に計画の廃止届を出した"@ja.
