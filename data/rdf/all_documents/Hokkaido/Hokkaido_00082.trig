<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00082> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原周辺のメガソーラー建設"@ja.
kg:id_1 rdf:type cls:c_14564.
cls:c_14564 rdfs:label "太陽光発電所建設"@ja.
kg:id_2 rdfs:label "日本エコロジーによる市内14カ所での建設計画"@ja.
kg:id_2 rdf:type cls:c_8845.
cls:c_8845 rdfs:label "建設計画"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "北斗地区の工事中断"@ja.
kg:id_3 rdf:type cls:c_14918.
cls:c_14918 rdfs:label "工事中断"@ja.
kg:id_4 rdfs:label "森林法違反"@ja.
kg:id_4 rdf:type cls:c_979.
cls:c_979 rdfs:label "法令違反"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "タンチョウなど希少生物への影響"@ja.
kg:id_5 rdf:type cls:c_14965.
cls:c_14965 rdfs:label "希少生物への影響"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "計画継続の可否判断に時間を要する"@ja.
kg:id_6 rdf:type cls:c_14966.
cls:c_14966 rdfs:label "可否判断の遅延"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "釧路市"@ja.
kg:id_7 rdf:type cls:c_909.
cls:c_909 rdfs:label "自治体"@ja.
kg:id_8 rdfs:label "希少生物に関する環境調査の評価を進め今後も協議を継続する"@ja.
kg:id_8 rdf:type cls:c_14967.
cls:c_14967 rdfs:label "調査評価と協議継続"@ja.
kg:id_7 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "文化財保護法などに基づき天然記念物への影響評価を適切に行う"@ja.
kg:id_9 rdf:type cls:c_228.
cls:c_228 rdfs:label "影響評価"@ja.
kg:id_7 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "日本エコロジー"@ja.
kg:id_10 rdf:type cls:c_2246.
cls:c_2246 rdfs:label "事業者"@ja.
kg:id_11 rdfs:label "希少生物への影響調査を行い説明責任を果たす"@ja.
kg:id_11 rdf:type cls:c_14968.
cls:c_14968 rdfs:label "影響調査と説明"@ja.
kg:id_10 prop:countermeasure kg:id_11.
kg:st_1 rdfs:label "日本エコロジー松井政憲社長"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "速やかに工事を進めたい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "影響は軽微と説明し工事再開を望む"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市立博物館秋葉薫館長"@ja.
kg:st_2 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_3 prop:content "希少生物への影響調査は不十分で事業者と認識が違う"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "影響は軽微で自然との調和に近づいている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_3 rdfs:label "釧路市"@ja.
kg:st_3 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_5 prop:content "天然記念物への影響評価を適切に行う責務があり精査に時間がかかる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "調査を精査中で今後も協議を継続する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "審査を中立公正な立場で評価していく"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "自然との調和に近づいており説明責任をしっかり果たす"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "釧路湿原国立公園周辺で大規模太陽光発電所（メガソーラー）の建設を計画する日本エコロジー（大阪市）"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "森林法違反により工事を中断している北斗"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "国の特別天然記念物タンチョウなどの影響調査を行った結果、影響は軽微との説明を重ねて主張"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "同社が提出した北斗地区などの希少生物に関する環境調査の評価に時間がかかると伝え、今後も協議を継続することを確認した"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "市は同社が提出した北斗地区などの希少生物に関する環境調査の評価に時間がかかると伝え、今後も協議を継続することを確認した"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "市は文化財保護法などに基づき天然記念物に対する影響評価を適切に行う責務があるため、同社の調査を精査中"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "国の特別天然記念物タンチョウなどの影響調査を行った結果、影響は軽微との説明を重ねて主張"@ja.
}
