kg:st_1 rdfs:label "登山家 野口健さん"@ja.
kg:st_1 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_1 prop:content "映像のインパクトが大きく全国で問題を訴えたい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "全国どこでも同じ問題を抱えており訴えていきたい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "猛禽類医学研究所代表 齊藤慶輔さん"@ja.
kg:st_2 rdf:type cls:st_37.
kg:op_3 prop:content "自然生態系への影響を最小にする順序が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "全国ニュースになり問題が広く共有された"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "これまで少なかった全国ニュース化が起きた"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "自然生態系への影響を最小にする検討が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "文化庁"@ja.
kg:st_3 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_7 prop:content "天然記念物への影響を十分確認せず工事を進めるべきでない"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "文化財保護法に抵触する可能性があると事業者に伝えるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "罰則が科される可能性がある"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "原状回復を命じられる可能性がある"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:st_4 rdfs:label "北海道"@ja.
kg:st_4 rdf:type cls:st_2.
kg:op_11 prop:content "林地開発許可が必要な面積を超えていたため中止を勧告した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "必要な届け出がされていなかったため提出を求めた"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "届け出を求めるとともに土壌調査を求めている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:st_5 rdfs:label "釧路市 鶴間秀典市長"@ja.
kg:st_5 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_14 prop:content "抑制区域や禁止区域の設定や非FIT規制が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "国に解決策を訴えた"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_5.
kg:op_16 prop:content "屋根の上や人の手が入った場所から導入すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "開発可否は科学的根拠に基づき判断すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "生物の基礎データ取得を先に行うべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:st_6 rdfs:label "釧路自然保護協会 会長 神田房行さん"@ja.
kg:st_6 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_19 prop:content "クラウドファンディングへの協力を求める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:op_20 prop:content "保全のため土地買い取りを進めたい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_6.
kg:st_7 rdfs:label "阿部文部科学相"@ja.
kg:st_7 rdf:type cls:st_2.
kg:op_21 prop:content "天然記念物が失われたり傷ついたりしないよう指導してほしい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_7.
kg:op_22 prop:content "抑制区域と禁止区域を自治体が設定できるようにしてほしい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "非FIT事業も規制対象にすべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "非FIT事業者にも廃棄費用積み立てなどの仕組みが必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "造成工事中の現場を撮影した動画投稿が発端となり、著名人によるSNS発信によりメガソーラー開発への批判が全国に広がった"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "著名人によるSNS発信によりメガソーラー開発への批判が全国に広がった"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "8月に投稿した映像には工事現場の隣でエサをついばむタンチョウの親子も写り、希少野生生物が生活する湿原での開発の是非を問う形になった"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "太陽光発電施設は建築基準法上の建物ではないため設置が可能で"@ja.
<< kg:id_5 prop:cause kg:id_7 >>
    prop:text-txt_contents "高さ8mを超える工作物を設ける際に届け出が必要になる釧路市景観条例もスルーできる"@ja.
<< kg:id_5 prop:cause kg:id_8 >>
    prop:text-txt_contents "釧路湿原は土地が平坦で"@ja.
<< kg:id_5 prop:cause kg:id_9 >>
    prop:text-txt_contents "積雪量が比較的少なく"@ja.
<< kg:id_5 prop:cause kg:id_10 >>
    prop:text-txt_contents "日照時間が長いという“好条件”もあった"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:text-txt_contents "地元の環境団体などが活動を重ねた結果、新条例成立"@ja.
<< kg:id_11 prop:cause kg:id_13 >>
    prop:text-txt_contents "市民活動が2年前から盛り上がり、市に対策を求める声が高まった"@ja.
<< kg:id_11 prop:cause kg:id_14 >>
    prop:text-txt_contents "2024年10月の市長選でメガソーラーの抑制に積極的な現市長が当選"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:text-txt_contents "「非FIT」の増加は、売電価格が下がったうえ"@ja.
<< kg:id_15 prop:cause kg:id_17 >>
    prop:text-txt_contents "規制が強まってFIT事業の“うま味”が少なくなったからか"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "著名人によるSNS発信によりメガソーラー開発への批判が全国に広がった"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "つるの剛士さんが来てくれて、全国ニュースになった"@ja.
<< kg:id_18 prop:effect kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "希少野生生物が生活する湿原での開発の是非を問う形になった"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:text-txt_contents "条例施行で、事業者にとっては「協力」が「義務」に変わり"@ja.
<< kg:id_22 prop:effect kg:id_24 >>
    prop:text-txt_contents "生息調査の方法や時期も詳しく定められ"@ja.
<< kg:id_22 prop:effect kg:id_25 >>
    prop:text-txt_contents "厳しい条件が課されることになる"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業者の調査報告が不十分で開発による影響の度合いを評価できないケースがある"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "天然記念物に及ぼす影響を十分に確認せずに工事を進めた場合、文化財保護法に抵触し"@ja.
<< kg:id_28 prop:effect kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "罰則が科されたり"@ja.
<< kg:id_28 prop:effect kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "原状回復を命じられたりする可能性がある"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "森林開発面積が0.86haに及ぶことがわかり、林地開発許可が必要な面積0.5haを超えていたため、工事の中止を勧告した"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "必要な届け出をしていなかった。道の求めに応じて、9月17日、届け出が出された"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "道は届け出を求めるとともに同社に対し、土壌の調査を行うよう求めている"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "釧路市からの要望を受け、国で法制度見直しが始まった"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "鶴間秀典・釧路市長が国に解決策を訴え、政府や国会が法制度の検討に入った"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:text-txt_contents "2025年6月には「ノーモアメガソーラー宣言」を出した"@ja.
<< kg:id_42 prop:countermeasure kg:id_44 >>
    prop:text-txt_contents "9月には「釧路市自然と太陽光発電施設の調和に関する条例」が成立、10月に施行された"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:text-txt_contents "事業者は市長に申請し、事業計画を提出して許可を受けなければならない"@ja.
<< kg:id_45 prop:countermeasure kg:id_47 >>
    prop:text-txt_contents "特定保全種が生息する可能性が高い区域を特別保全区域に指定"@ja.
<< kg:id_45 prop:countermeasure kg:id_48 >>
    prop:text-txt_contents "事業区域に含まれる場合、事業者は生息調査の実施や保全計画の作成を求められる"@ja.
<< kg:id_45 prop:countermeasure kg:id_49 >>
    prop:text-txt_contents "勧告や命令に従わない場合は事業者の氏名、住所、経緯などを公表する"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "ゾーニングをして太陽光パネルをたてても大丈夫な場所から、例えば屋根の上とか、人の手の入り込んだ場所から順番に導入"@ja.
<< kg:id_50 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "こういうことならやってもいいかもしれない、と科学的根拠をもとにしっかり検討する"@ja.
<< kg:id_50 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "そこにいる生物についてきちんと基礎データをとることから始めなければいけません"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "希少生物の生息データ収集、土地の買い取りを進めるためのクラウドファンディング"@ja.
<< kg:id_54 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "希少生物の生息データ収集、土地の買い取りを進めるためのクラウドファンディング"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "「天然記念物が失われたり傷ついたりすることがないよう、市教委で適切に指導してほしい」と述べた"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:text-txt_contents "工事の中止を勧告した"@ja.
<< kg:id_59 prop:countermeasure kg:id_61 >>
    prop:text-txt_contents "道の求めに応じて、9月17日、届け出が出された"@ja.
<< kg:id_59 prop:countermeasure kg:id_62 >>
    prop:text-txt_contents "道は届け出を求めるとともに同社に対し、土壌の調査を行うよう求めている"@ja.
<< kg:id_42 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "抑制区域、禁止区域についても自治体で設定できるよう法律で定めてほしい"@ja.
<< kg:id_42 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "FIT法の適用を受けない「非FIT」の事業も規制の対象となるよう、法律を整備してほしい"@ja.
<< kg:id_42 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "「非FIT」の事業者についても設け、きちんと廃棄がされるようにしてほしい"@ja.
<< kg:id_40 prop:countermeasure kg:id_66 >>
    prop:text-txt_contents "環境省が希少な野生動植物を保全するための「種の保存法」の在り方をめぐる検討に入る"@ja.
<< kg:id_40 prop:countermeasure kg:id_67 >>
    prop:text-txt_contents "関係省庁連絡会議がスタートして検討が始まった"@ja.
}
