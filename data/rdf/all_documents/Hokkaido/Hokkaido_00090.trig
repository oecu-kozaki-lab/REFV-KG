PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00090> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路湿原などの自然環境保全"@ja.
kg:id_1 rdf:type cls:c_15029.
cls:c_15029 rdfs:label "自然環境保全"@ja.
kg:id_2 rdfs:label "ふるさと納税の募集開始"@ja.
kg:id_2 rdf:type cls:c_15030.
cls:c_15030 rdfs:label "資金募集"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "自然環境の保全"@ja.
kg:id_3 rdf:type cls:c_15029.
kg:id_4 rdfs:label "寄付金の使い道の指定項目に追加"@ja.
kg:id_4 rdf:type cls:c_15031.
cls:c_15031 rdfs:label "指定項目追加"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "タンチョウの保護"@ja.
kg:id_5 rdf:type cls:c_14651.
cls:c_14651 rdfs:label "生物保護"@ja.
kg:id_3 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "キタサンショウウオの保護"@ja.
kg:id_6 rdf:type cls:c_14651.
kg:id_3 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "環境教育を提供する施設の充実"@ja.
kg:id_7 rdf:type cls:c_5549.
cls:c_5549 rdfs:label "施設充実"@ja.
kg:id_3 prop:countermeasure kg:id_7.
kg:st_1 rdfs:label "釧路市マーケティング戦略室担当者"@ja.
kg:st_1 rdf:type cls:st_60.
cls:st_60 rdfs:label "自治体職員"@ja.
kg:op_1 prop:content "環境保全のために支援を呼びかける"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "釧路市は31日、釧路湿原などの自然環境保全を目的としたふるさと納税の募集を開始した。市マーケティング戦略室担当者は「環境保全のためにご支援いただきたい」としている。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "寄付金の使い道の指定項目に「自然環境の保全に活用」を加え"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:text-txt_contents "タンチョウやキタサンショウウオなどの希少生物の保護"@ja.
<< kg:id_3 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "タンチョウやキタサンショウウオなどの希少生物の保護"@ja.
<< kg:id_3 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "環境教育を提供する施設の充実などに充てる"@ja.
}
