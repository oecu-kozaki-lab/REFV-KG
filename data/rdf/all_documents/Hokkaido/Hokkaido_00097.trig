PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00097> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "メガソーラー建設"@ja.
kg:id_1 rdf:type cls:c_14564.
cls:c_14564 rdfs:label "太陽光発電所建設"@ja.
kg:id_2 rdfs:label "日本エコロジーが釧路湿原国立公園周辺で複数の大規模太陽光発電所の建設を計画していること"@ja.
kg:id_2 rdf:type cls:c_12240.
cls:c_12240 rdfs:label "開発計画"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "市の再調査要請に日本エコロジーが応じなかったこと"@ja.
kg:id_3 rdf:type cls:c_15067.
cls:c_15067 rdfs:label "再調査拒否"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "キタサンショウウオの生息地に影響するおそれ"@ja.
kg:id_4 rdf:type cls:c_15068.
cls:c_15068 rdfs:label "生息地への影響"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "敷地内の樹木が伐採される"@ja.
kg:id_5 rdf:type cls:c_11898.
cls:c_11898 rdfs:label "樹木伐採"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "オジロワシの止まり木が伐採される"@ja.
kg:id_6 rdf:type cls:c_11898.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "希少生物への影響が軽微かどうか判断できない"@ja.
kg:id_7 rdf:type cls:c_15069.
cls:c_15069 rdfs:label "影響不明"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "キタサンショウウオの生息再調査を行う"@ja.
kg:id_8 rdf:type cls:c_14932.
cls:c_14932 rdfs:label "再調査"@ja.
kg:id_1 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "市のガイドラインに沿って適切な調査を実施する"@ja.
kg:id_9 rdf:type cls:c_192.
cls:c_192 rdfs:label "環境調査"@ja.
kg:id_1 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "メガソーラー建設を規制する条例を定める"@ja.
kg:id_10 rdf:type cls:c_14797.
cls:c_14797 rdfs:label "建設規制"@ja.
kg:id_1 prop:countermeasure kg:id_10.
kg:st_1 rdfs:label "日本エコロジー 松井政憲社長"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "着工直前の再調査要請は不適切と批判"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "釧路市教育委員会"@ja.
kg:st_2 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_2 prop:content "生息調査が不十分で再調査が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "猛禽類医学研究所（釧路市） 斉藤慶輔代表"@ja.
kg:st_3 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_3 prop:content "現地は希少な野生生物の生息地だ"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:st_4 rdfs:label "釧路市 市幹部"@ja.
kg:st_4 rdf:type cls:st_6.
kg:op_4 prop:content "再調査要請中の着工は遺憾"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_4.
kg:op_5 prop:content "調査時期が短く再調査を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_5 rdfs:label "日本エコロジー"@ja.
kg:st_5 rdf:type cls:st_1.
kg:op_6 prop:content "既に適切な調査を実施していると主張"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "釧路湿原国立公園周辺で複数の大規模太陽光発電所（メガソーラー）の建設を計画する日本エコロジー（大阪市）は22日、釧路市昭和でメガソーラーの建設工事を始めた。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "同社は「市のガイドラインに沿って適切な調査を実施している」とし、再調査に応じない考えをあらためて示した。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "予定地は絶滅危惧種で釧路市の天然記念物キタサンショウウオの生息適地などとして、市教育委員会は生息調査が不十分として再調査を求めていた。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "同日午前、作業員2人が敷地内の樹木の伐採を始めた。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "伐採された木の中には国の天然記念物オジロワシの止まり木もあるという。斉藤代表は「現地は希少な野生生物の生息地だ」と話す。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "市幹部は「日本エコロジーの調査では希少生物への影響が軽微かどうか判断できない。再調査を求めている中で着工したことは誠に遺憾だ」と話した。"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "市教委が調査時期の短さなどを理由に今年11月、再調査を求めていた。"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "同社は「市のガイドラインに沿って適切な調査を実施している」とし、再調査に応じない考えをあらためて示した。"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "市はメガソーラーの建設を規制する条例を定めたが、適用は来年1月以降に着工する事業のため、現行の制度では罰則対象となっていない。"@ja.
}
