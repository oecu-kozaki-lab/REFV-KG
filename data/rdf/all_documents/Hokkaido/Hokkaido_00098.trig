kg:st_1 rdfs:label "北大・REERCセンター長 宮下和士"@ja.
kg:st_1 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_1 prop:content "再生可能エネルギー導入には地域理解を得る制度設計が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域と調和する再エネ導入の仕組みづくりが必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "登山家 野口健"@ja.
kg:st_2 rdf:type cls:st_13.
cls:st_13 rdfs:label "有識者"@ja.
kg:op_3 prop:content "環境保護のため規制強化が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "自然環境を守るため開発への規制を強めるべきだ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "三方よしの制度設計を進めるべきだ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地域利益と事業性を両立する制度設計が重要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "住民対話を重ねる仕組みは参考になる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地域との調和を重視して再エネを進めるべきだ"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "山林開発による災害リスクを懸念する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "自然破壊を防ぐため厳格な規制が必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "再生可能エネルギーの柱として期待されてきた太陽光発電に続いて洋上風力発電が広がる。地域変容を伴う大規模太陽光発電施設（メガソーラー）の建設が各地で課題化したことや、海域を開発区域にし対話を重ねて導入してきた英国では、NSSという住民対話制度が広がる。政府はメガソーラー規制を強化する方針パッケージを策定し、太陽光発電を控めとした地域課題と対峙しつつ、再エネをどう育てていくかを考えたい"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "地域変容を伴う大規模太陽光発電施設（メガソーラー）の建設が各地で課題化した"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "政府はメガソーラー規制を強化する方針パッケージを策定"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "2000年代後半ごろには経済産業省の固定価格買取制度を契機に大規模太陽光発電施設が全国各地で整備され、森林を開発する大規模太陽光発電で土砂災害や環境破壊への懸念が高まる"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "森林を開発する大規模太陽光発電で土砂災害や環境破壊への懸念が高まる"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:text-txt_contents "2000年代後半ごろには経済産業省の固定価格買取制度を契機に大規模太陽光発電施設が全国各地で整備され"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "国は一定の地域で再生可能エネルギー設備の設置を規制する制度を創設"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:text-txt_contents "環境省は太陽光発電の環境配慮ガイドラインを改定"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:text-txt_contents "北海道が全国2位のポテンシャルを持つ洋上風力発電の適地"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "洋上風力発電が広がる。海域を開発区域にし対話を重ねて導入してきた英国では、NSSという住民対話制度が広がる"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "海域を開発区域にし対話を重ねて導入してきた英国では、NSSという住民対話制度が広がる"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "太陽光発電を始めとした地域課題と対峙しつつ、再エネをどう育てていくかを考えたい"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:text-txt_contents "森林を開発する大規模太陽光発電"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "森林を開発する大規模太陽光発電で土砂災害や環境破壊への懸念が高まる"@ja.
<< kg:id_25 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "森林を開発する大規模太陽光発電で土砂災害や環境破壊への懸念が高まる"@ja.
