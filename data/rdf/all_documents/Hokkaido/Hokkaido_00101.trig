PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00101> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "国有地への無断侵入"@ja.
kg:id_1 rdf:type cls:c_15085.
cls:c_15085 rdfs:label "土地への無断立入"@ja.
kg:id_2 rdfs:label "除雪作業で車両を通行させるための板設置"@ja.
kg:id_2 rdf:type cls:c_15086.
cls:c_15086 rdfs:label "作業準備"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "自生する植物が刈られ車両が通行した形跡の確認"@ja.
kg:id_3 rdf:type cls:c_15087.
cls:c_15087 rdfs:label "植生への影響"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "板の撤去"@ja.
kg:id_4 rdf:type cls:c_15088.
cls:c_15088 rdfs:label "原状回復"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "立ち入りを禁止する看板や柵の設置"@ja.
kg:id_5 rdf:type cls:c_15089.
cls:c_15089 rdfs:label "侵入防止策"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:st_1 rdfs:label "日本エコロジー"@ja.
kg:st_1 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_1 prop:content "板を撤去して違反のないよう作業したい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "違反のないよう作業したい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "北海道財務局広報室"@ja.
kg:st_2 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_3 prop:content "事実が確認された場合は法令にのっとり適切に対処する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "昨年12月、除雪作業を行った際に車両を通行させるために国有地に板を敷くなどした"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "現地を調べた釧路財務事務所の職員が、自生する植物が刈られ車両が通行した形跡を確認"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "「板を撤去して違反のないよう作業したい」とした"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "今月2日に立ち入りを禁止する看板や柵を設置した。「事実が確認された場合は法令にのっとり適切に対処する」（広報室）としている"@ja.
}
