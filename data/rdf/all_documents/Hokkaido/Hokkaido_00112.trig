kg:st_1 rdfs:label "１番 麿直之議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "関係人口の創出が見込めず庁内議論も不十分として反対"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "イベントが少なく代替案も乏しいため関係人口創出に不十分と指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "イベント減少を補う代替案が乏しいと指摘"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "実績あるイベントを実施しない点を問題視"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "イベント未実施により関係人口の減少を懸念"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "Withコロナ期に蓄えたノウハウを活用せずフェアを開催しないと指摘"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "広告事業など新しい取組に対する受皿不足を問題視"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "商工費でより効果的な予算配分が可能と主張"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "町側の十分な議論が必要と主張"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_2 rdfs:label "４番 佐藤秀教議員"@ja.
kg:st_2 rdf:type cls:st_16.
kg:op_10 prop:content "財政が依存構造にあり懸念要因と指摘"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "依存財源が財政上の大きな懸念要因と指摘"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "ふるさと納税の成果を自主財源として評価"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "脱炭素社会に向けた取組を評価"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "帯状疱疹予防の補助制度新設を評価"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "健康保持増進に向けた各種取組を評価"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "子育て支援センター供用開始に向けた事業推進を評価"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "子ども子育て支援事業計画に沿った取組を評価"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "長年の懸案である道路整備の推進を評価"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:st_3 rdfs:label "佐藤聖一郎町長"@ja.
kg:st_3 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_19 prop:content "少子化の進行が想定より早いと危機感を示す"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "出生数の大幅減少に危機感を示す"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "道内の出生数も過去最少であると指摘"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "人口急減と超高齢化が経済社会と社会構造に深刻な影響を与えると懸念"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "人口動態の不均衡がさらに強まると懸念"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "ウクライナ情勢が生活や産業へ深刻な影響を与えていると指摘"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "原油や原材料価格の高騰が生活を直撃していると指摘"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "価格転嫁が難しい事業者ほど影響が大きいと指摘"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "中小企業や一次産業、運送業への影響が深刻と指摘"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "電気代上昇が家計と産業の大きな負担になっていると指摘"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "電気代上昇で先行き不透明な状況にあると指摘"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "北海道が積極姿勢を示し課題解決先進地として実践力を高めるべきと主張"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "北海道は自立した地域を目指すべきと主張"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:st_4 rdfs:label "仁木町の風力発電を考える会 代表 瀬川裕人氏"@ja.
kg:st_4 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_32 prop:content "ウィンドファーム事業の建設に反対"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "低周波音などの人体影響を懸念"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "自然生態系への影響を懸念"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "土砂災害や水質悪化のおそれを懸念"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "建設計画地が社会福祉施設に近いことを問題視"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "多数の署名が集まり住民意思を無視できない状況と訴える"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "請願書提出に向け反対署名活動を継続する意向"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今回の予算では関係人口の創出が見込めるとは感じられず、それに対して十分な議論が庁内で重ねられていないと感じましたので、反対いたします。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "Afterコロナ期においてようやくイベントが実施できるようになったにもかかわらず、イベント自体が少なく、それにかわる効果的な代替案が乏しい点。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "イベント自体が少なく、それにかわる効果的な代替案が乏しい点。"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "これまでの実績のあるイベントを実施せず"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "関係人口の減少が見込まれる点。"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "Withコロナ期で、ノウハウ実績を蓄えたフェアなどの開催をしない点。"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "広告事業など新しい取組に対する集客の受皿がない点"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "商工費の中で広範囲においてまだまだ関係人口創出へ向けた効果的な予算取りができると感じ"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "それに対して町側で十分な議論がなされていないと感じたため反対いたします。"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "本町の財政状況は、近年徐々に回復の兆しが見えているものの、未だ地方交付税や国庫支出金などに依存している状況にあり"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "財政状況の大きな懸念要因となっている"@ja.
<< kg:id_11 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "一方でふるさと納税が２年続けて４億円以上の成果を上げたことは評価できるものであり、自主財源の乏しい本町にとっては貴重な財源となっております。"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "脱炭素社会の実現に向けた取組"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "帯状疱疹予防に向けた補助制度の新設"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "町民の健康保持・増進に向けた各種取組"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "子育て世代が期待する仁木町すこやか子育て支援センターの令和６年３月の供用開始に向けた事業推進"@ja.
<< kg:id_21 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "第２期仁木町子ども・子育て支援事業計画に沿った各種子育て支援の取組"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "長年懸案となっていた町道仁小前線の令和６年度工事着工に向けた道路整備事業の推進"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "2017年に公表されました将来推計人口より11年早く少子化が進んでいる中"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "全国の出生数が初めて80万人を割り込み"@ja.
<< kg:id_28 prop:effect kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "道内でも過去最少を更新するなど"@ja.
<< kg:id_26 prop:effect kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "人口急減・超高齢化が将来我々の経済社会にどのような影響を及ぼし、社会構造を乱すのか"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "人口動態のアンバランスは一段と強まっていくものと懸念されております。"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "ウクライナ情勢や様々な要因によります原油・原材料価格の高騰は、国民の生活を直撃するとともに"@ja.
<< kg:id_34 prop:cause kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "原油・原材料価格の高騰は、国民の生活を直撃するとともに"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "十分な価格転嫁を行うことが難しい下請事業者を初めとする中小企業や、漁業農林業、運送業を初めとする各種の産業に深刻な影響をもたらしております。"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "下請事業者を初めとする中小企業や、漁業農林業、運送業を初めとする各種の産業に深刻な影響をもたらしております。"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "特に電気代の値上がりは、各家庭や企業・産業に大きな負担を与え"@ja.
<< kg:id_40 prop:effect kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "先行きが見通せない状況にあります。"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "課題解決先進地として、今こそ北海道が積極的な姿勢を示し、実践力を高めていく立場にあるものと考えているところであります。"@ja.
<< kg:id_43 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "北海道が他に依存しない、自立した地域を目指していくためにも"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "「（仮称）古平・仁木・余市ウィンドファーム事業」の建設に反対いたします。"@ja.
<< kg:id_46 prop:cause kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "理由１．低周波音などによる人体への影響。"@ja.
<< kg:id_46 prop:cause kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "２．自然生態系への影響。"@ja.
<< kg:id_46 prop:cause kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "３．土砂災害・水質悪化の恐れ。"@ja.
<< kg:id_46 prop:cause kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "４．建設計画地が社会福祉施設に近接すること。"@ja.
<< kg:id_46 prop:effect kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "道内外とネット署名を合わせれば、約１万5000筆の署名が集まり、住民の意思を無視できない状況になりました。"@ja.
<< kg:id_46 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "請願書提出に向け、風車反対署名活動を継続していきたいと思います。"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:text-txt_contents "意見案第１号『普天間基地周辺の子どもたちを取り巻く空・水・土の安全の保障を求める意見書』"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:text-txt_contents "意見案第２号『ＬＧＢＴＱに関する差別を解消し、人権を守る法整備を求める意見書』"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:text-txt_contents "意見案第３号『子どものために保育士配置基準の引き上げによる保育士増員を求める意見書』"@ja.
}
