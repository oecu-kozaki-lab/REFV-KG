    prop:text-txt_contents "鳥獣被害対策については、昨年、町内で発生したヒグマによる人身被害を踏まえ"@ja.
<< kg:id_33 prop:cause kg:id_35 >>
    prop:text-txt_contents "また、農作物の被害防止のため"@ja.
<< kg:id_33 prop:countermeasure kg:id_36 >>
    prop:text-txt_contents "新たに農地や家庭菜園に設置する電気柵の購入に対する補助を行う"@ja.
<< kg:id_33 prop:countermeasure kg:id_37 >>
    prop:text-txt_contents "引き続き啓発活動や見回り"@ja.
<< kg:id_33 prop:countermeasure kg:id_38 >>
    prop:text-txt_contents "有害鳥獣の駆除など、被害防止対策を強化してまいります"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:text-txt_contents "新型コロナウイルス感染症及び原油価格、物価高騰への対応については"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:text-txt_contents "原油価格、物価高騰への対応については"@ja.
<< kg:id_39 prop:cause kg:id_42 >>
