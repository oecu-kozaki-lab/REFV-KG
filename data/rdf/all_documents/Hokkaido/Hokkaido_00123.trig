<< kg:id_19 prop:cause kg:id_20 >>
    prop:text-txt_contents "水産加工業については、原材料や燃油価格の高騰、更には電気料金の引き上げなどにより"@ja.
<< kg:id_19 prop:cause kg:id_21 >>
