kg:st_1 rdfs:label "６番近江武君"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "支援事業に大いに期待する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長石山英雄君"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_2 prop:content "新規漁業就業者への支援と奨励金交付を目的に実施する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "水産課長渡辺孝行君"@ja.
kg:st_3 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_3 prop:content "就業フェアのマッチング後の研修や住居費を補完する事業と説明"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "就業後の継続支援と町の全面的なバックアップが必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "肉牛改良センターとのバランスも考慮し支援体制を整えたい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_4 rdfs:label "１１番堺繁光君"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_6 prop:content "シカ被害も大きく処分施設の広域整備を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:op_7 prop:content "福島町の焼却施設への将来的参画を協議している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "ハンターの作業軽減とシカ皮の活用を検討すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "毛皮活用は実現可能ならハンターと検討する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "ハンター育成にも力を入れてほしい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "ハンターの高齢化は切実で育成に意を持って対応したい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:st_5 rdfs:label "９番梶谷康介君"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_12 prop:content "町内再エネを町内全域で消費する構想の実現性を懸念"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_5.
kg:op_13 prop:content "脱炭素先行区域指定を受け財源確保につなげたい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:st_6 rdfs:label "５番福原英夫君"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_14 prop:content "洋上風力を最大の好機としてまちづくりに生かすべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_6.
kg:op_15 prop:content "安い電力販売雇用創出若者定着交流人口増加を目指す"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "生きがいと社会参加につながる高齢者施策を期待する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:st_7 rdfs:label "７番工藤松子君"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_17 prop:content "医師４人体制で午後診療継続は負担が大きいのではないか"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_7.
kg:op_18 prop:content "医師に負担はかかるが現場の意思を尊重して午後診療を継続する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "経営強化プランの内容を開示し協力の方向を示してほしい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_7.
kg:op_20 prop:content "強化プラン策定後に議会と町民へ開示しパブリックコメントを受ける"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "建設改良積立だけでなく料金負担軽減の視点も必要"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:st_8 rdfs:label "３番沼山雄平君"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_22 prop:content "マイナンバーカード保有の利便性を町民に示すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_8.
kg:op_23 prop:content "保険証免許証子育て介護分野への活用も含めて周知したい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "書かない行政窓口の導入を検討すべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_8.
kg:op_25 prop:content "書かない行政窓口の時代は来ると考え職員と検討したい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "ＤＸやＧＸの意味を町民に分かる形で説明すべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "計画ができ次第町民と議会に理解の機会をつくりたい"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:st_9 rdfs:label "１０番斉藤勝君"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_28 prop:content "高齢者施設や独居高齢者など申請困難者への対応が必要"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_9.
kg:op_29 prop:content "高齢者施設や寝たきり障がいのある方を重点に申請体制を整える"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "ハイヤー補助だけでなく利用促進と交通弱者支援の両立策が必要"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_8.
kg:op_31 prop:content "地域格差を考慮しつつ利用促進策を検討したい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "住民の足確保のため何度でも会議を重ねるべき"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_7.
kg:op_33 prop:content "町民の足は守るという基本姿勢で公共交通計画をまとめたい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:st_10 rdfs:label "２番飯田幸仁君"@ja.
kg:st_10 rdf:type cls:st_16.
kg:op_34 prop:content "白神松浦間の危険回避を優先し戦略的に国へ訴えるべき"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_10.
kg:op_35 prop:content "本線国道２２８号線の通行止め回避に向け防災事業を要請している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "東急不動産頼みでなく町独自のテレワーク誘致策も必要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "テレワーク機能は町から東急不動産に依頼し実現を図った"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "町民所得向上につながる施策を明確にすべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "所得向上を願って毎年予算編成している"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "入学奨励金と給食無償提供は保護者に寄り添った支援策と評価する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_8.
kg:st_11 rdfs:label "教育長宮島武司君"@ja.
kg:st_11 rdf:type cls:st_31.
cls:st_31 rdfs:label "教育委員会"@ja.
kg:op_41 prop:content "地元進学率維持のため高校と振興会の要望を受け無償提供を決めた"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_11.
kg:op_42 prop:content "子どもが活躍できる場面を増やし新しい目で見られる経験が必要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_7.
kg:op_43 prop:content "オンライン授業や別室対応など一人一人に応じて支援している"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_11.
