kg:st_1 rdfs:label "８番梶谷康介君"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "町の財産である以上は維持管理を考える必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "町の財産である以上は維持管理を考える必要がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "政策財政課長五十嵐愛之君"@ja.
kg:st_2 rdf:type cls:st_95.
cls:st_95 rdfs:label "課長"@ja.
kg:op_3 prop:content "寄附額引上げでお得感が下がり寄附が減少した可能性がある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "テレビで取り上げられた特定返礼品の在庫不足でリピーター確保ができなかった可能性がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "６番福原英夫君"@ja.
kg:st_3 rdf:type cls:st_16.
kg:op_5 prop:content "ふるさと応援基金を定住移住と子育て支援に重点活用して頑張ってほしい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "セイコーマートからの企業版ふるさと納税を松城バス待合所のデジタル表示に活用する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "町の財産となった以上は指定管理の経緯と維持管理の説明が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "組合員が負担した分担金の領収書や扱いを明確にすべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_4 rdfs:label "町民課長岩城広紀君"@ja.
kg:st_4 rdf:type cls:st_95.
kg:op_9 prop:content "指定管理者制度を活用し小島地区の方に維持管理を担ってもらう"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "領収書の発行は共聴組合と協議して検討する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:st_5 rdfs:label "保健福祉課長堀川昭彦君"@ja.
kg:st_5 rdf:type cls:st_95.
kg:op_11 prop:content "認定子ども園では幼稚園部門と保育部門で計１０数名減少している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_5.
kg:op_12 prop:content "人口減少の中で清部保育所と認定保育園の今後の運営を考える必要がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "今後の課題は財源面と人材確保であり日々考えながら取り組んでいる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:st_6 rdfs:label "町長石山英雄君"@ja.
kg:st_6 rdf:type cls:st_96.
cls:st_96 rdfs:label "町長"@ja.
kg:op_14 prop:content "町立松前病院の改築は喫緊の課題であり財政推計と病院経営を分析したうえで町に相応しい病院を丁寧に説明して建設に向かってほしい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_6.
kg:st_7 rdfs:label "病院事務局長白川義則君"@ja.
kg:st_7 rdf:type cls:st_229.
cls:st_229 rdfs:label "事務局長"@ja.
kg:op_15 prop:content "施設設備の老朽化や医師確保など課題が多く安定的な運営基盤の回復が最重要課題"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_7.
kg:st_8 rdfs:label "建設水道課長横山義和君"@ja.
kg:st_8 rdf:type cls:st_95.
kg:op_16 prop:content "今後とも安全安心な水の供給のため老朽施設の更新など適切に対応していく"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_8.
kg:op_17 prop:content "ホクレンからの企業版ふるさと納税を肉牛改良センター建設工事に充当する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "企業版ふるさと納税を町営住宅の建設長寿命化工事に充当している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "難視聴対策として公平な情報提供のため町が実施主体となって整備した"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "指定管理者制度を活用し小島地区の方に今までどおり維持管理してもらう"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "分担金は共聴組合を通じて町に納める形にしている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "確定申告等に必要であれば共聴組合と協議して発行を検討する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "高所得層の保険料上限を引き上げ低所得者の負担軽減を図る設計である"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "第１段階は実質減額となるよう設計している"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "全体の３分の１程度の第１段階は事実上減額となるようにしている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:op_26 prop:content "物価高騰などの社会情勢を踏まえ一旦立ち止まり町に相応しい病院を丁寧に説明して建設に向かってほしい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "洋上風力発電や再生可能エネルギーの取り組みは地域経済活性化につながる"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "デジタル時代に遅れず持続可能な松前町の将来像が見えてきた"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "１０節行政情報システム修繕料で、７１万８千円の追加計上は、パソコン等の機器故障による修理増加によるものです。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "昨年１２月２２日の閣議決定で、物価高騰対応重点支援地方創生臨時交付金に、新たに低所得者支援及び定額減税を補足する給付の実施が追加されたことに伴う、定額減税実施対応及び定額減税補足給付金の給付のためのシステム改修業務委託料"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "１８節町村会会費及び負担金で、１００万円の追加計上は、渡島町村会として各町１００万円を負担し、令和６年能登半島地震による災害被災地見舞金を送るものです。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "２５節寄附金で、５０万円の追加計上は、当町が平成５年に発生した北海道南西沖地震において、石川県珠洲市より見舞金をいただいており、令和６年能登半島地震により被災された同市へ見舞金を送るものです。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "修繕の応急処置を行ったところ、雨漏りが改善されたことから全面改修を見送ったことによるものです。"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "１４節エム・エッチソーイング屋根改修工事請負費で、３千２０１万７千円の減額は、修繕の応急処置を行ったところ、雨漏りが改善されたことから全面改修を見送ったことによるものです。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "２４節減債基金積立金で、１千３８１万５千円の追加計上は、令和５年度普通交付税の再算定により追加交付された臨時財政対策債償還基金費分１千３８３万円は、基金に積み立て、令和５年度借り入れの臨時財政対策債償還費に充てることとされております。"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "ふるさと松前応援寄附受入事業で、１千３９１万４千円の減額は、歳入でも計上しております、ふるさと松前応援寄附金の寄附見込みが５００万程度減少することに伴う関連経費の減額"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "現在建設中の東急不動産松前事務所の一部に松城バス待合所を移設する予定であり、待合所においてバス時刻の表示や地域情報の発信などを行うデジタルサイネージ機能を構築するためのものです。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "１４節小島地区テレビ共同受信施設整備工事請負費で、２千６４０万７円の減額は、入札減による減額です。"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:text-txt_contents "地域生活バス運行事業補助金で、４０万１千円の追加計上は、大漁くんバス運行に係る国の補助金の基礎単価が下がり、減額となるため、その不足分の町補助金の追加。"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:text-txt_contents "地域エネルギー会社設立準備負担金１３２万円の減額は、予定より設立調整に時間を要することから、年度内支出が不用になったことによるものです。"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:text-txt_contents "戸籍附表システム改修業務委託料で、２６７万３千円の追加計上は、戸籍附表システムにおいて、ふりがな仮登録及び旧氏記載対応のためのシステム改修業務委託料"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:text-txt_contents "新型コロナウイルス感染症緊急経済対策住民税非課税世帯等に対する物価高騰等対策給付金８９１万円の減額は、対象世帯数の実績確定によるものです。"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:text-txt_contents "障害者自立支援給付費合計で、１千５９２万１千円の減額は、対象者の減少及び決算見込みによる減額。"@ja.
<< kg:id_26 prop:cause kg:id_30 >>
    prop:text-txt_contents "福祉灯油等助成費で５５万５千円の減額は、対象世帯数の実績確定によるものです。"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:text-txt_contents "２７節国民健康保険特別会計に対する操出金３８７万２千円の減額は、主に保険基盤安定化分と財政安定化支援にかかる操出金の減額によるものです。"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:text-txt_contents "介護保険特別会計に対する操出金９９８万１千円の減額は、主に事務費負担分の減額。"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:text-txt_contents "後期高齢者医療特別会計に対する操出金３００万６千円の減額は、保険基盤安定化分の減額によるものです。"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:text-txt_contents "保育所バス運行業務委託料１４４万５千円の減額は、土曜日の運行業務委託を函館バス株式会社と契約しておりますが、職員の退職等により運行が困難となり、直営で運行を行うこととなったための減額。"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:text-txt_contents "職員の退職等により運行が困難となり、直営で運行を行うこととなったための減額。"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:text-txt_contents "医療的ケア児保育支援看護師派遣等業務委託料１２０万円の減額は、対象家庭と協議の結果、今年度については事業の実施を希望しないこととなったことによるものです。"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_11;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "函館大谷短期大学附属松前認定子ども園運営費補助金で、１５７万８千円の減額は、入園者の減少による減額。"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:text-txt_contents "函館大谷短期大学附属松前認定子ども園通園バス運営費補助金で５４万９千円の追加計上は、置き去り防止装置設置によるものです。"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:text-txt_contents "児童手当３歳未満非被用者分１２万円の追加計上は、対象児童の増加によるものです。"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:text-txt_contents "８節元気づくりシステム旅費で８０万２千円の減額は、当初町外で予定していた研修を町内で実施したことによるものです。"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:text-txt_contents "１２節委託料で、２千７３２万２千円の減額は、接種回数等の減少見込みによるもの"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:text-txt_contents "合併処理浄化槽設置補助金で、１１７万円の減額は、設置件数の減少見込みによるものです。"@ja.
<< kg:id_54 prop:cause kg:id_55 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "１８節病院事業会計に対する補助金で、２千２５８万２千円の減額は、特別交付税及び建設改良費に対する一般会計負担分の決算確定によるものです。"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:text-txt_contents "渡島廃棄物処理広域連合負担金で、２００万円の減額は、渡島廃棄物処理広域連合の補正に係る松前町負担金の補正分の減額。"@ja.
<< kg:id_58 prop:cause kg:id_59 >>
    prop:text-txt_contents "渡島西部広域事務組合負担金(衛生部門)で、７９万２千円の追加は、渡島西部広域事務組合の補正に係る松前町負担金の補正分の計上によるものです。"@ja.
<< kg:id_60 prop:cause kg:id_61 >>
    prop:text-txt_contents "一般廃棄物収集運搬委託料で２０３万円の減額は、契約額の確定による減額です。"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "水道事業会計に対する補助金で、２９３万６千円の減額は、主に建設改良費に対する一般会計負担分の決算確定によるものです。"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:text-txt_contents "農畜産物被害防止電気柵購入補助金で８４万１千円の減額は、当初想定人数より購入補助希望が少なく、補助金の実績による年度末までの決算見込みによる減額です。"@ja.
<< kg:id_18 prop:cause kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "肉牛改良センター住宅建設工事請負費で、２３６万円の減額は、入札減による減額です。"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:text-txt_contents "新規漁業就業支援事業補助金２５５万円の減額は、当初想定人数より対象者が少なく、補助金の実績による年度末までの決算見込みによる減額です。"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:text-txt_contents "松前商工会補助金で６５万４千円の減額は、各事業の中止等による対象経費の減額による年度末までの決算見込み。"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:text-txt_contents "新型コロナウイルス感染症緊急経済対策消費循環型クーポン券発行事業補助金で、３７０万１千円の減額は、町民１人あたり１万円分のクーポン券を発行するもので、発行枚数は１２万１千２８０枚でありましたが、利用枚数は、１１万５千６０４枚、９５．３２％であり、差額分等の減額です。"@ja.
<< kg:id_18 prop:cause kg:id_73 >>
    prop:text-txt_contents "２号井温泉ポンプ入替工事請負費で１０５万８千円の減額は、入札減によるものです。"@ja.
<< kg:id_74 prop:cause kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "町営住宅建設工事請負費４千４３５万２千円の減額は、設計内容の変更及び入札減による減額。"@ja.
<< kg:id_76 prop:cause kg:id_77 >>
    prop:text-txt_contents "町営住宅解体工事請負費１千６８０万８千円の追加は、建石地区の住宅２棟を解体撤去するもので、令和６年度建設を予定する建石地区町営住宅建設に係る解体工事です。"@ja.
<< kg:id_58 prop:cause kg:id_78 >>
    prop:text-txt_contents "渡島西部広域事務組合負担金(消防部門)６３５万５千円の減額は、渡島西部広域事務組合の補正に係る松前町負担金の補正分の計上によるものです。"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:text-txt_contents "２０節奨学資金貸付金２４０万円の減額は、貸し付けがなかったことによるものです。"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:text-txt_contents "学校管理スクールバス運行業務委託料２６５万９千円の減額は、令和６年１月より直営で運行していることによるものです。"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:text-txt_contents "史跡保存管理修繕料８４万１千円の追加計上は、史跡内の木柵が強風により倒壊したことからその修繕によるものです。"@ja.
<< kg:id_85 prop:effect kg:id_86 >>
    prop:text-txt_contents "史跡保存管理修繕料８４万１千円の追加計上は、史跡内の木柵が強風により倒壊したことからその修繕によるものです。"@ja.
<< kg:id_87 prop:cause kg:id_88 >>
    prop:text-txt_contents "史跡松前氏城跡福山城跡保存整備石垣三次元レーザー計測及びカルテ作成業務委託料８４５万９千円の減額は、国庫補助内示が減額されたことに伴う事業内容の変更及び入札減によるものです。"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:text-txt_contents "渡島西部四町スポーツ合宿誘致推進事業負担金の１０万円の減額及び渡島西部四町スポーツ合宿誘致推進事業補助金４５万円の減額は、実績がなかったことによる減額です。"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:text-txt_contents "長期債償還利子２１５万１千円の追加計上は、利率見直し方式で借り入れしている長期債の利率見直しで、利率が上昇したことに伴う追加計上"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:text-txt_contents "一時借入金利子８７万９千円の減額は、当初予定していた一時借入金の実績が見込みより減少したことによるものです。"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "町が実施主体となって、小島地区の整備をしようということで、町の方に施設を譲渡するような形で、町が実施主体として整備をすることになりました。"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "維持管理につきましては、指定管理者制度を活用して、小島地区の方に指定管理者になっていただいて、維持管理を今までどおりしていただくということで協議した結果、そういう形になっております。"@ja.
<< kg:id_99 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "組合を通じて町の方に分担金を納めていただく形になっております。"@ja.
<< kg:id_101 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "確定申告等に使うということであれば、その辺、この通知が、１３日付けの通知が領収書代わりにならないということであれば、こちらの方でも共聴組合とも協議して、発行の部分を検討してまいりたい"@ja.
<< kg:id_103 prop:countermeasure kg:id_104 >>
    prop:text-txt_contents "国民健康保険事業基金から同額を繰り入れ致そうとするものであります。"@ja.
<< kg:id_105 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "各所得額に応じた各階層区分が９段階から１３段階に細分化されたことによるものです。端的な言い方をすると、保険料の上限額が引き上げになることとなります。"@ja.
<< kg:id_105 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "第１段階から第４段階は、所得の低い方々に対する軽減率となっており、下線部分が改正になるところであります。括弧内の数値については、政令による標準負担率で、その上が更に公費負担を投入して軽減しようとする率となっており、最終的な負担率は上段の方となります。"@ja.
<< kg:id_105 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "松前町では、この基準保険料を２００円増額し、５千４００円として令和６年度から８年度まで運営していこうと考えてございます。"@ja.
<< kg:id_109 prop:countermeasure kg:id_110 >>
    prop:text-txt_contents "地方自治法の一部を改正する法律により、地方自治法の規定を引用している条項に繰り下げがあったため、関係する条例を一部改正しようとするもの"@ja.
<< kg:id_111 prop:countermeasure kg:id_112 >>
    prop:text-txt_contents "関連する法律の改正に伴い、関係省令が令和６年１月１７日に交付されたことから、関連する条例を改正しようとするものであります。"@ja.
<< kg:id_113 prop:countermeasure kg:id_114 >>
    prop:text-txt_contents "行政手続における特定の個人を識別するための番号の利用等に関する法律等の一部を改正する法律により、行政手続における特定の個人を識別するための番号の利用等に関する法律に規定されている別表第２が削られたため、条例を一部改正しようとするものであります。"@ja.
<< kg:id_115 prop:countermeasure kg:id_116 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "町立松前病院の改築は喫緊の課題でありまして、特別委員会や検討委員会で議論してきたことは、決して無駄にはならないというふうに思っております。物価高騰など、社会情勢の大きな変化により、一旦立ち止まる決断をさせていただきました。少し時間はかかりますが、松前町の財政推計、病院の経営を分析したうえで、町民の皆さんに町に相応しい病院を丁寧に説明して、建設に向かってほしい"@ja.
<< kg:id_117 prop:effect kg:id_118 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "再生可能エネルギーの取り組みは、地域経済の活性化のカンフル剤となると思っております。"@ja.
<< kg:id_119 prop:effect kg:id_120 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "松前町ＤＸ推進計画、松前町脱炭素ロードマップなども策定され、持続可能な松前町の将来像、進む方向が見えてきたように思います。"@ja.
}
