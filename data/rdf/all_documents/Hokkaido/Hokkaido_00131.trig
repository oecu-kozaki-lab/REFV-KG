<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "国内最大の湿地を有する釧路湿原国立公園の周辺地域において、近年、太陽光発電施設が急増しており"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "近年、太陽光発電施設が急増しており、釧路市等の地元自治体においてメガソーラーを規制する動きが始まっていた"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "国立公園と釧路市市街地の間の市街化調整区域において大阪を本社とする事業者が実施するメガソーラー案件２件【昭和地区、北斗地区】について、釧路市や地元専門家との軋轢が顕在化"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "【北斗地区】について、地元専門家がSNSを通じて工事の様子等を動画で発信したことで、著名人らが賛同する動きに発展"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "事業地にオジロワシの巣が含まれることが判明し、事業者が事業中止【昭和地区】"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:text-txt_contents "大阪を本社とする事業者が実施するメガソーラー案件２件【昭和地区、北斗地区】について、釧路市や地元専門家との軋轢が顕在化"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:text-txt_contents "地元専門家がSNSを通じて工事の様子等を動画で発信したことで、著名人らが賛同する動きに発展"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:text-txt_contents "「釧路市自然と共生する太陽光発電施設の設置に関するガイドライン」を策定"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "釧路市が「ノーモアメガソーラー宣言」を宣言"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "釧路市が「釧路市自然と太陽光発電施設の調和に関する条例案」についてパブリックコメント実施"@ja.
<< kg:id_17 prop:countermeasure kg:id_21 >>
    prop:text-txt_contents "釧路市から文化庁に対して文化財保護法※に関する照会"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:text-txt_contents "浅尾環境大臣が現地への職員派遣を指示"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:text-txt_contents "環境省野生生物課長が釧路市長等と順次面会し意見交換"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:text-txt_contents "北海道庁が森林法違反として一部区域の工事の中止を勧告"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:text-txt_contents "９月定例市議会で全会一致で条例可決（10月１日施行）"@ja.
<< kg:id_30 prop:countermeasure kg:id_31 >>
    prop:text-txt_contents "第１回関係省庁連絡会議開催"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:text-txt_contents "令和７年6月から工事を開始"@ja.
<< kg:id_32 prop:effect kg:id_34 >>
    prop:text-txt_contents "自然公園法：国立公園区域外"@ja.
<< kg:id_32 prop:effect kg:id_35 >>
