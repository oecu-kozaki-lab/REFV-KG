 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "釧路地域のメガソーラー問題"@ja.
kg:id_1 rdf:type cls:c_14563.
cls:c_14563 rdfs:label "開発問題"@ja.
kg:id_2 rdfs:label "各種法令について必要な対策がとられているかの精査・検討"@ja.
kg:id_2 rdf:type cls:c_6444.
cls:c_6444 rdfs:label "対策検討"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "今後に向けた必要な対応の検討"@ja.
kg:id_3 rdf:type cls:c_6558.
cls:c_6558 rdfs:label "対応検討"@ja.
kg:id_1 prop:countermeasure kg:id_3.
kg:id_4 rdfs:label "文化財保護法に基づく対応"@ja.
kg:id_4 rdf:type cls:c_13835.
cls:c_13835 rdfs:label "法令対応"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "森林法に基づく対応"@ja.
kg:id_5 rdf:type cls:c_13835.
kg:id_1 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "太陽光発電事業"@ja.
kg:id_6 rdf:type cls:c_552.
cls:c_552 rdfs:label "発電事業"@ja.
kg:id_7 rdfs:label "地域共生上の課題"@ja.
kg:id_7 rdf:type cls:c_1358.
cls:c_1358 rdfs:label "地域課題"@ja.
kg:id_6 prop:effect kg:id_7.
kg:id_8 rdfs:label "各自治体における再エネ規制条例の策定"@ja.
kg:id_8 rdf:type cls:c_2591.
cls:c_2591 rdfs:label "条例整備"@ja.
kg:id_6 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "再エネ特措法における規律強化の取組"@ja.
kg:id_9 rdf:type cls:c_16097.
cls:c_16097 rdfs:label "規律強化"@ja.
kg:id_6 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "関係法令における規律強化など必要な対応の検討"@ja.
kg:id_10 rdf:type cls:c_6558.
kg:id_6 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "関係法令の対応"@ja.
kg:id_11 rdf:type cls:c_13835.
kg:id_12 rdfs:label "関係省庁で協力して検討"@ja.
kg:id_12 rdf:type cls:c_16099.
cls:c_16099 rdfs:label "省庁連携"@ja.
kg:id_11 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "釧路メガソーラーへの対応"@ja.
kg:id_13 rdf:type cls:c_16100.
cls:c_16100 rdfs:label "開発対応"@ja.
kg:id_14 rdfs:label "全国的な対応と分けて整理"@ja.
kg:id_14 rdf:type cls:c_16101.
cls:c_16101 rdfs:label "整理必要"@ja.
kg:id_13 prop:countermeasure kg:id_14.
kg:st_1 rdfs:label "環境省"@ja.
kg:st_1 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_1 prop:content "各種法令に基づく対策状況の精査と検討を求める"@ja.
