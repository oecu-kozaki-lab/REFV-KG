kg:st_1 rdfs:label "近江武議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "原料不足で加工業者が十分に稼働できず危機的状況にあると懸念"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "原料確保が十分でないため加工場の稼働が制限されていると指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "高値の原料で赤字覚悟の操業となっていると訴える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長石山英雄君"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "今年の漁次第で加工業界がどうなるか大変危惧している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "加工場が稼働できない事業所もあり深刻な事態と認識"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "500人規模の従業員の生活が成り立たなくなると懸念"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "水産加工業は松前の経済を支える大事な産業で影響は極めて大きいと認識"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "松前から加工業の灯を消すことはできないと危機感を示す"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "持続可能な環境づくりが必要だと考える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "加工業がなくならないよう行政として支援したい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "加工業がなくなれば松前の経済と家庭生活に甚大な打撃が出ると警告"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "福島町と連携して原料安定確保のための体制を整えた"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "国に現状を訴え支援を要請する判断をした"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "国内漁獲が低迷した場合の唯一の手段として輸入原料確保を求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "イカ資源確保のため違法操業対策を強化すべきと求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "水産加工業の経営改善と安定化を支援していく考えを示す"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "隣町の制度も参考に外国人実習生受け入れ支援を進めるべきと主張"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "福島町の評判の良い制度を検証し松前町の支援策に生かしたい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "職員と知恵を出しながら持続可能な環境づくりに取り組むべきと考える"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "町と漁協と業界が連携して原料確保のため外来船誘致を進めるべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "大幅な遅れで関係者に心配をかけたと事業者の思いを代弁"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "工事により町民に心配をかけるためトラブル回避が必要と認識"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "住民理解のもとで慎重に事業を進めるべきとする"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "安全な事業着手と情報共有を事業者に求めている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:st_3 rdfs:label "町民"@ja.
kg:st_3 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_25 prop:content "地域の安心安全のため情報公開を求める"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "地域住民の理解のもとで慎重に進める方針に変わりはない"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "対象者に対して丁寧に説明し適切に対応すべきとする"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "再発防止のため事務処理の適正化を徹底すると表明"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "突然の廃止は非常に残念であると受け止めている"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "利用者が引き続き適切な医療を受けられるよう対応すると表明"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:st_4 rdfs:label "沼山雄平議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_31 prop:content "生活道路まで含めたきめ細かい送迎体制が必要と指摘"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "閉院で送迎拡充を望む声がさらに高まっていると指摘"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "高齢者が安心して通院できない状況を早急に改善すべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "高齢者の身体的負担が大きく冬季は特に深刻と訴える"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "現状を受け止め安全確保を前提に改善を進めたい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "高齢化の進展を踏まえ小型車両での送迎も検討せざるを得ない"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "病院長や関係機関と協議し前向きに改善を進めたい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "病院送迎だけでなく地域全体の足の確保として検討すべき課題と認識"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:st_5 rdfs:label "梶谷康介議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_39 prop:content "漁船漁業だけでは松前の漁業は成り立たず作り育てる漁業が必要と主張"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "漁業環境は大変厳しいとの共通認識を示す"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "組合員数も減少し厳しい経営環境にあると認識"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "漁船漁業と並行して増養殖や中間育成を進めるべきと主張"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "漁港利用で生産を上げる方向に国も北海道も重きを置いていると認識"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "船の集約や漁港集約は今後進めていかなければならないと考える"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "静浦と赤神なら集約化の可能性があるとの認識を示す"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "本来の漁港機能に影響がないようルールを確立すべきとする"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "関係者を含めたプロジェクトチームをつくり計画を進めるべきと提案"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "漁港整備計画を見える形で作っていきたいと表明"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "昨年のイカ漁は３０年ぶりの不漁となり、加工原料不足や価格の高騰により経営は厳しい状況に追い込まれており"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "加工原料不足や価格の高騰により経営は厳しい状況に追い込まれており"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "加工原料不足や価格の高騰により経営は厳しい状況に追い込まれており"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "特に今春以降は昨年の不漁等の影響が継続化し、加工原料の確保に苦慮しております"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "今後の加工場稼働の目処すら立たない事業所も多く"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "地域で最大の雇用の場である加工場従業員の雇用不安など"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地域経済にとっても影響が大きく深刻な状況に直面しております"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "国内生産のスルメ加工が消滅の危機に陥る可能性があること"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "事業所の廃業、倒産による地域経済の疲弊など"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "事業所の廃業、倒産による地域経済の疲弊など"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "事業所の廃業、倒産による地域経済の疲弊など、大きな危機感を抱かざるを得ない状況"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "松前町と福島町の水産加工場の全社（２５社）による「松前町・福島町スルメ加工業連絡協議会」を５月２６日に立ち上げ"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "６月６日には国に対し、松前町、福島町、松前町議会、福島町議会、松前商工会、福島町商工会及び松前町・福島町スルメ加工業連絡協議会の７団体等の連名により、「スルメ加工原料の安定確保に関する要望書」を提出"@ja.
<< kg:id_1 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "松前町、福島町のスルメ加工業者の輸入が可能となる、消化義務のない輸入枠の新設等の運用を図っていただくよう要望します"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "国内イカ漁場における外国船籍漁船の違法操業対策を強化していただくよう要望します"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "松前町でも昨年から商工事業者経営改善等の支援補助金の制度を作りまして、昨年度から実施しているところでありまして、水産加工業の経営改善及び経営の安定化に支援してまいります"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "外国人研修生の受け入れを行っている事業所も町内にありますけども、そのことについても執行方針に述べさせていただいた"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "福島町の実態を検証させていただきたいというふうに思っております"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "松前から水産加工の灯を消さないような状況をつくっていきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "業界と町と漁協とね、タイアップした外国船の誘致だってね、やる必要があるんですよ"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:text-txt_contents "国の補助制度の廃止やＦＩＴ制度（固定価格買収制度）の導入、環境影響評価法の適用"@ja.
<< kg:id_22 prop:cause kg:id_24 >>
    prop:text-txt_contents "国の補助制度の廃止やＦＩＴ制度（固定価格買収制度）の導入"@ja.
<< kg:id_22 prop:cause kg:id_25 >>
    prop:text-txt_contents "環境影響評価法（通称：環境アセスメント法）の適用"@ja.
<< kg:id_22 prop:cause kg:id_26 >>
    prop:text-txt_contents "日本製風車からドイツ製風車への機種変更や設置基数の変更等が検討されておりました"@ja.
<< kg:id_22 prop:cause kg:id_27 >>
    prop:text-txt_contents "設置基数の変更等が検討されておりました"@ja.
<< kg:id_22 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "当初の事業計画からの大幅な遅れにより、地権者はじめ関係者の方々に対し、ご心配をおかけしましたこと"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "今後２年間にわたり設置関連工事により町民の皆様に対しご心配をおかけすることとなり"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "本年６月８日と９日に再度事業概要の周知及び建設工事に関する地域説明会を実施"@ja.
<< kg:id_29 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "町民とのトラブルがないように事業者に申し入れしているところであります"@ja.
<< kg:id_33 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "町民より伊藤議長と私宛てに風力発電施設建設における情報公開及び地域の安心、安全に対する要望書が提出"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "速やかな情報公開と、地域の方々に不安を与えないように最善を尽くす"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:text-txt_contents "昨年３月から多くの個人や法人から町内設置に関わる問い合わせがきております"@ja.
<< kg:id_36 prop:countermeasure kg:id_38 >>
    prop:text-txt_contents "当町では本年４月に松前町小型風力発電施設設置に関わるガイドラインを制定し"@ja.
<< kg:id_36 prop:countermeasure kg:id_39 >>
    prop:text-txt_contents "本ガイドラインは、小型風車の建設に伴う環境保全や景観形成の観点から事業者が自主的に遵守する事項を定めております"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:text-txt_contents "厚生労働省から後期高齢者医療保険料について、後期高齢者医療広域連合に提供した標準システムの設定に誤りがあり"@ja.
<< kg:id_40 prop:effect kg:id_42 >>
    prop:text-txt_contents "後期高齢者医療保険料については、返還金が生じる方が７件で１４万２千１００円"@ja.
<< kg:id_40 prop:effect kg:id_43 >>
    prop:text-txt_contents "国民健康保険税については、追加徴収となる方が４件で１０万２千７００円"@ja.
<< kg:id_40 prop:effect kg:id_44 >>
    prop:text-txt_contents "減額更正となる方が１２件で３０万４００円"@ja.
<< kg:id_40 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "個別訪問によるお詫びと内容説明を行い"@ja.
<< kg:id_40 prop:countermeasure kg:id_46 >>
    prop:text-txt_contents "返還金が生じる方に対しては、速やかに還付の手続きを行うこととしております"@ja.
<< kg:id_40 prop:countermeasure kg:id_47 >>
    prop:text-txt_contents "北海道後期高齢者医療広域連合と連携しながら適正賦課に努めてまいります"@ja.
<< kg:id_40 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "法令等の理解の徹底及びチェック体制の強化を図り、適切な事務処理に努めてまいります"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "多くの町民が利用し、地域医療の一翼を担っていただいてきただけに、町としては、今回の突然の廃止については非常に残念"@ja.
<< kg:id_49 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "今後は、これらの利用者が引き続き適切な医療を受けられるよう、町立松前病院等での診療について、適宜対応するとともに"@ja.
<< kg:id_49 prop:countermeasure kg:id_52 >>
    prop:text-txt_contents "引き続き情報収集に努めてまいります"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "現状では、患者送迎のあり方が必ずしも満足のいくものではないようであります"@ja.
<< kg:id_53 prop:cause kg:id_55 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "松前記念クリニックの閉院という状況を受け、益々患者送迎の拡充ときめ細かい送迎サービスの向上を望む声が高まってきております"@ja.
<< kg:id_53 prop:effect kg:id_56 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "不安を口にする高齢者も多数いるようです"@ja.
<< kg:id_53 prop:effect kg:id_57 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "自宅から下町の送迎バス乗降場所まで、距離にして３５０メートル、坂道を下り、手押し車で身体を支えながら歩いてきていました"@ja.
<< kg:id_53 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "今までは病院と致しましては、まず安全の確保を第一に対応させていただいたところであります"@ja.
<< kg:id_53 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "バスの小型化も検討していかざるを得ない状況が来るだろう"@ja.
<< kg:id_53 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "病院長とも前向きに検討して、協議して、その方向性を決めていきたい"@ja.
<< kg:id_53 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "町内には公共交通機関もあります、官と民の力を合わせて、町を挙げて検討していくべき大きな課題"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "流れものを相手にする、この漁船漁業においては、これは自然、或いはいろんな条件が伴って"@ja.
<< kg:id_62 prop:effect kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "平成元年の松前中央漁協合併時においての漁業生産額は、４１億ありました...平成２８年度におきましては、１２億を超える、少し超える程度の生産額"@ja.
<< kg:id_62 prop:effect kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "平成元年の...組合員も１千９人...平成２８年度におきましては...２９８人の組合員"@ja.
<< kg:id_62 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "作り育てる漁業も振興していかなければならないと。そのためには、松前に存在する１３という漁港を生かしていかなければいけない"@ja.
<< kg:id_62 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "漁港の利用、静穏域の利用は皆様方と、組合員の皆様方といろんな知恵を借りながらやっていければ"@ja.
<< kg:id_62 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "正しく漁港の集約化はこれからしていかなければならない"@ja.
<< kg:id_62 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "小島地区の静浦と赤神地区なら可能だというふうな認識をしております"@ja.
<< kg:id_62 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "きちんとしたルールを作っていってですね、今の利用、漁港利用の本質に関わる部分の影響がないような状況を確立"@ja.
<< kg:id_62 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "進めるための漁港利用をね、利活用進めるためのね、プロジェクトチームみたいなのつくる必要あるんでないかな"@ja.
<< kg:id_62 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "形の見えるような漁港の整備計画づくりをしてまいりたい"@ja.
}
