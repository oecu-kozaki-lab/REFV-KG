PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Hokkaido/00150> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "（仮称）松前北部風力発電事業"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "事後調査報告書の送付"@ja.
kg:id_2 rdf:type cls:c_16337.
cls:c_16337 rdfs:label "報告書送付"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "知事意見の実施"@ja.
kg:id_3 rdf:type cls:c_16338.
cls:c_16338 rdfs:label "意見実施"@ja.
kg:id_1 prop:countermeasure kg:id_3.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "事後調査報告書 図書の送付を受けた日 令和5年11月7日"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:text-txt_contents "知事意見 平成24年8月17日 知事意見はこちら"@ja.
