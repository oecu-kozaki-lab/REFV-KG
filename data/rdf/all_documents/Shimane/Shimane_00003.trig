kg:id_10 rdf:type cls:c_14089.
cls:c_14089 rdfs:label "放流増加"@ja.
kg:id_8 prop:effect kg:id_10.
kg:id_11 rdfs:label "濁水"@ja.
kg:id_11 rdf:type cls:c_470.
cls:c_470 rdfs:label "濁水"@ja.
kg:id_12 rdfs:label "濾過膜閉塞により緩速濾過池が機能不能となり水道水を供給できなくなる"@ja.
kg:id_12 rdf:type cls:c_2096.
cls:c_2096 rdfs:label "断水"@ja.
kg:id_11 prop:effect kg:id_12.
kg:id_13 rdfs:label "梅雨末期の集中豪雨や台風による豪雨"@ja.
kg:id_13 rdf:type cls:c_1842.
cls:c_1842 rdfs:label "豪雨"@ja.
kg:id_14 rdfs:label "山腹崩壊を確認している"@ja.
kg:id_14 rdf:type cls:c_14019.
cls:c_14019 rdfs:label "山腹崩壊"@ja.
kg:id_13 prop:effect kg:id_14.
kg:id_15 rdfs:label "脆弱な砂質土"@ja.
kg:id_15 rdf:type cls:c_14090.
cls:c_14090 rdfs:label "砂質土"@ja.
kg:id_16 rdfs:label "降雨により地中の含水比が上昇すると固結状態が解放され浅層崩壊が発生する"@ja.
kg:id_16 rdf:type cls:c_14091.
cls:c_14091 rdfs:label "浅層崩壊"@ja.
kg:id_15 prop:cause kg:id_16.
kg:id_17 rdfs:label "開発区域でしゃき土が露呈すること"@ja.
kg:id_17 rdf:type cls:c_14092.
cls:c_14092 rdfs:label "土壌露出"@ja.
kg:id_18 rdfs:label "建設中の土砂災害や山腹崩壊による土石流"@ja.
kg:id_18 rdf:type cls:c_832.
cls:c_832 rdfs:label "土砂災害"@ja.
kg:id_17 prop:effect kg:id_18.
kg:id_19 rdfs:label "下流域の治水対策を計画する"@ja.
kg:id_19 rdf:type cls:c_9748.
cls:c_9748 rdfs:label "治水対策"@ja.
kg:id_8 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "開発行為による負荷流量"@ja.
kg:id_20 rdf:type cls:c_14093.
cls:c_14093 rdfs:label "負荷流量"@ja.
kg:id_21 rdfs:label "下流の治水ダムへの上乗せに対する対策を取る"@ja.
kg:id_21 rdf:type cls:c_14094.
cls:c_14094 rdfs:label "放流対策"@ja.
