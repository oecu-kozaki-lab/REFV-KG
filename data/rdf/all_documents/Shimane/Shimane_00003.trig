kg:id_23 rdfs:label "風力発電施設の設計"@ja.
kg:id_23 rdf:type cls:c_6874.
cls:c_6874 rdfs:label "施設設計"@ja.
kg:id_24 rdfs:label "線状降水帯を考慮した降雨強度で設計する"@ja.
kg:id_24 rdf:type cls:c_14095.
cls:c_14095 rdfs:label "豪雨対応"@ja.
kg:id_23 prop:countermeasure kg:id_24.
kg:id_25 rdfs:label "具体的な対策をすることが必要"@ja.
kg:id_25 rdf:type cls:c_14096.
cls:c_14096 rdfs:label "災害対策"@ja.
