  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "方法書説明会"@ja.
kg:id_1 rdf:type cls:c_3027.
cls:c_3027 rdfs:label "説明会"@ja.
kg:id_2 rdfs:label "方法書段階のため調査してみないとわからないとする不明瞭な答えが多かったこと"@ja.
kg:id_2 rdf:type cls:c_14084.
cls:c_14084 rdfs:label "不明瞭回答"@ja.
kg:id_1 prop:cause kg:id_2.
