kg:id_3 rdf:type cls:c_14085.
cls:c_14085 rdfs:label "不安の声"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "住民との話し合いが平行線のままで終わった"@ja.
kg:id_4 rdf:type cls:c_14086.
cls:c_14086 rdfs:label "対話不成立"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "地域の住民や関係者から当会に多くの意見や質問が寄せられた"@ja.
kg:id_5 rdf:type cls:c_92.
cls:c_92 rdfs:label "意見提出"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "風力発電施設の整備"@ja.
kg:id_6 rdf:type cls:c_1935.
cls:c_1935 rdfs:label "施設整備"@ja.
kg:id_7 rdfs:label "地形が改変する"@ja.
kg:id_7 rdf:type cls:c_127.
cls:c_127 rdfs:label "地形改変"@ja.
kg:id_6 prop:effect kg:id_7.
kg:id_8 rdfs:label "開発行為"@ja.
kg:id_8 rdf:type cls:c_14087.
cls:c_14087 rdfs:label "開発行為"@ja.
kg:id_9 rdfs:label "負荷流量により既存の市管理河川の流下能力を越える懸念"@ja.
kg:id_9 rdf:type cls:c_14088.
cls:c_14088 rdfs:label "治水懸念"@ja.
kg:id_8 prop:effect kg:id_9.
