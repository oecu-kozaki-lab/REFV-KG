kg:id_1 prop:effect kg:id_57.
kg:st_1 rdfs:label "日向山・大出日山の風力発電を考える会"@ja.
kg:st_1 rdf:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "脱炭素に資する一方で進め方次第では環境破壊につながると懸念"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "事業の進め方によっては環境破壊につながる可能性があると指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "既存法令や規制では十分対応できず住民トラブルが増えていると懸念"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "既存法令や規制では十分対応できず自然環境破壊の事例が増えていると懸念"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "地域住民"@ja.
kg:st_2 rdf:type cls:st_167.
cls:st_167 rdfs:label "地域住民"@ja.
kg:op_5 prop:content "計画に対して強い不安と危機感を抱いている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "事業では大規模な森林伐採が行われ保全方針と相反すると指摘"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "水源涵養林を切り拓くことは周辺地域だけでなく河口市街地にも影響すると懸念"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "水源地の山を切り拓くことで水の流れが変化すると懸念"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "森林伐採や搬入道工事による土砂流出を懸念"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "土砂流出や除草剤散布、洗浄剤流出による水質汚染を懸念"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "水質汚染が農業従事者の生活や農業に被害を及ぼすと懸念"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "地域の魅力である安全な食が脅かされると懸念"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "山々の尾根を切り開くことで保水力が低下すると懸念"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "水への拘りを持つ生産者の製品にも影響が出ると懸念"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:st_3 rdfs:label "国交省都道府県土地分類基本調査"@ja.
kg:st_3 rdf:type cls:st_174.
cls:st_174 rdfs:label "行政資料"@ja.
kg:op_15 prop:content "開発には地質特性を十分研究して進める必要があると注意喚起"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "雲南まさ土は雨期に山腹崩壊を起こしやすいと指摘"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "地質特性により人家に被害を及ぼしてきたと指摘"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:st_4 rdfs:label "地域住民の多く"@ja.
kg:st_4 rdf:type cls:st_167.
kg:op_18 prop:content "まさ土の山に巨大建造物を建てることを危険だと感じている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "大規模な土壌改良や岩盤補強が別の問題を引き起こす可能性を懸念"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "巨大で近代的な建造物が歴史的空間の景観に深刻な影響を及ぼすと懸念"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "比婆山の聖域に景観や騒音の影響が及ぶことは到底許容できないと主張"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "重要な歴史的空間への影響に加え町の観光事業全体への悪影響を懸念"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "歴史的景観を守るため住民合意と十分な配慮対策が必要不可欠と主張"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "山岳信仰と修験道の聖地に大きな景観・環境破壊をもたらすと懸念"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "事業推進は人々の敬虔な想いと聖地への冒涜に当たると主張"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "景観破壊が加速度的に進みふるさとの風景が失われる可能性を懸念"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "山岳信仰の観点から計画撤回が妥当と考える"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "森林開発と水の流れの変化が希少生物や野生動物の生態系に影響すると懸念"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "建設予定の山に生育する貴重な植物が工事で伐採される恐れを指摘"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "植生自然度の高い場所であり豊かな植生の破壊を懸念"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "レッドリスト掲載植物をどのように保全するか説明を求める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:st_5 rdfs:label "多くのUIターン者"@ja.
kg:st_5 rdf:type cls:st_170.
cls:st_170 rdfs:label "移住者"@ja.
kg:op_32 prop:content "事業が実現する場合は安来市を離れるつもりである"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "今後移住を考える人が安来市を選ばない理由になると懸念"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "移住政策で築いた地域の絆に大きな損害が生じると懸念"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "風車の景観が不動産の景観価値を下げる可能性があると指摘"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:st_6 rdfs:label "東伊豆町や高知県の被害者"@ja.
kg:st_6 rdf:type cls:st_175.
cls:st_175 rdfs:label "被害住民"@ja.
kg:op_36 prop:content "不動産が売れないという被害の声が上がっている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:op_37 prop:content "不動産価値に影響がある場合は補償制度と事前合意が必要と主張"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:st_7 rdfs:label "東比田地区や赤屋地区の地域民"@ja.
kg:st_7 rdf:type cls:st_167.
kg:op_38 prop:content "十分な説明を受けている人はほとんどおらず騒音や低周波の影響や風車の大きさもよく知らされていない"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_7.
kg:op_39 prop:content "影響の及ぶ地域住民に一軒ずつ訪問しデメリットも説明する対応を求める"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:st_8 rdfs:label "多くの地域住民"@ja.
kg:st_8 rdf:type cls:st_167.
kg:op_40 prop:content "納得できないまま事業を進めず配慮書段階の説明会を再度開催するよう求めた"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_8.
kg:op_41 prop:content "方法書の延期を求めた"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_8.
kg:op_42 prop:content "説明会で意見を聞くと言いながら実際は逆の対応をしているため不信感を抱いている"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "適切な説明を果たさない場合は事業中断と撤退が必要不可欠と考える"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "風力発電所が防空レーダーの検知能力に影響する可能性があり対策説明を求める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "地域住民の安全のため具体的対策と分かりやすい説明を求める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "国内外で風車騒音による睡眠障害などの健康被害が報告されていると指摘"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:st_9 rdfs:label "環境省"@ja.
kg:st_9 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_47 prop:content "参照値以下でも低周波音を許容できない可能性が約10％残るとしている"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_9.
kg:op_48 prop:content "人的被害の可能性がある以上リスクを過小評価すべきでないと主張"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "住居移転補償を前提とするなら具体的補償条件の説明が必要と主張"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "住民との問題の主因は不平等な契約内容にあると指摘"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "事業終了後の原状回復や事故への適切な対応が求められない不平等な内容を懸念"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:st_10 rdfs:label "日本環境保法律家連盟の弁護士ら"@ja.
kg:st_10 rdf:type cls:st_176.
cls:st_176 rdfs:label "法律専門家"@ja.
kg:op_52 prop:content "全国的にも他に見たことがない不利益な契約と指摘"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_10.
kg:st_11 rdfs:label "弁護士"@ja.
kg:st_11 rdf:type cls:st_176.
kg:op_53 prop:content "事業会社の資本金が少額で20年後の撤去費用を町が負担する不安が残ると指摘"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_11.
kg:op_54 prop:content "契約が違法として住民監査請求を行っている"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:st_12 rdfs:label "私たち地域住民"@ja.
kg:st_12 rdf:type cls:st_167.
kg:op_55 prop:content "加美町と同様に本体と切り離された合同会社により不利な条件を押し付けられることを懸念"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_12.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "世界各国は、脱炭素社会を実現するために再生可能エネルギーに転換しようとしています。その中でも、風力発電は脱炭素を実現する手段として注目されています"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "風力発電は脱炭素を実現する手段として注目されていますが、進め方によっては環境破壊につながる可能性もございます"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "国内各地において、年々増加を続ける太陽光や風力発電施設に対し、既存の法令や規制では十分に対応できていないことが明らかになりつつあり、住民とのトラブルや自然環境の破壊などの事例が増えています"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "国内各地において、年々増加を続ける太陽光や風力発電施設に対し、既存の法令や規制では十分に対応できていないことが明らかになりつつあり、住民とのトラブルや自然環境の破壊などの事例が増えています"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "現在、地域住民はこの計画に対して強い不安と危機感を抱いており、平和なこの地域における最も深刻な問題となっています"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "貴社が行う事業においては大規模な森林伐採が行われ、これらの方針とは相反するものですが"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業想定区域には、特に水源涵養林という看板が多くあり、ここを切り拓くことは、周辺地域だけでなく河口の市街地にも多大な影響を及ぼす可能性があります"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "水源地の山を切り拓くことによって水の流れが変化したり"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "土砂が頻繁に流出して水質が汚染されてしまう恐れがあります。大規模な森林伐採や搬入道の工事によって土砂が流出し水質汚染が懸念されます"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "土砂が頻繁に流出して水質が汚染されてしまう恐れがあります。大規模な森林伐採や搬入道の工事によって土砂が流出し水質汚染が懸念されます。また建設に伴う除草剤の散布や洗浄剤の流出等も懸念されます"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "水質の汚染が地域の暮らしを支える生活の根本である農業へ被害を及ぼすと、農業従事者の生活に支障が出ることはもちろん"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "地域全体としての大きな魅力のひとつである「安全な食」が脅かされます"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "「緑のダム」である山々の尾根を切り開く事は、山の保水力の低下にもつながります"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "農業従事者だけでなく、水への拘りを持った生産者の製品にも影響が考えられます"@ja.
<< kg:id_1 prop:cause kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "この地域一帯の地質は花崗岩の風化した、いわゆる雲南まさ土であり、水によって崩壊しやすい特性は、カンナ流しによるタタラ製鉄を盛んにし、農地や宅地の造成を容易ならしめる等、開発に利点は多いが反面、雨期には、しばしば山腹崩壊を起し、人家に被害をおよぼしてきた"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "雨期には、しばしば山腹崩壊を起し"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "人家に被害をおよぼしてきた"@ja.
<< kg:id_1 prop:effect kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "尾根沿いを切り開いて雨水に晒し、数百トンものコンクリートや数十トンもの鋼線を掘削して埋め込み、その上にさらに数百トンの風車を建てれば、深層型崩落の危険性はさらに高くなるのではないかと不安に感じます"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "そういった行いが思いもよらない別の問題も引き起こす可能性もあります"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "そのような場所に地上４０階建てビル相当の巨大且つ近代的な建造物が何基も立ち並ぶ事は、歴史的空間の景観に対する深刻な影響を及ぼすことになります"@ja.
<< kg:id_1 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "その御神体である聖域に、景観や騒音の影響が及ぶことは古来よりこの山を守り続けてきたご先祖と多くの日本国民にとって到底許容できるものではありません"@ja.
<< kg:id_1 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "これらの重要な歴史的空間への影響以外にも町の観光事業全体への悪影響を及ぼす懸念がある計画であることは明らかです"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "歴史的な景観を守るためにも、建設計画には住民の合意と相当な配慮と対策が必要不可欠です"@ja.
<< kg:id_1 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "今回の事業が展開した場合，山岳信仰や修験道の聖地に対して大きな景観・環境の破壊が齎されます"@ja.
<< kg:id_1 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "今回の事業を推し進めることは人々の敬虔な想いと聖地に対する冒涜です"@ja.
<< kg:id_1 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "慣れ親しんできた山川大河、美しい森、田園風景の景観破壊が加速度的に進み「ふるさとの風景」が失われていく可能性があります"@ja.
<< kg:id_1 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "以上山岳信仰の観点から風力発電事業計画の撤回が妥当と考えます"@ja.
<< kg:id_1 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "この事業による森林の開発によって周辺の自然環境や水の流れが変わり、これらの希少生物やその他の野生動物の生態系に影響を及ぼすことが懸念されます"@ja.
<< kg:id_1 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "建設予定の山には貴重な植物が生育しており、工事の際に伐採される恐れがあります"@ja.
<< kg:id_1 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "建設予定地は植生自然度 10、8、7に当たる場所に位置します。地域の豊かな植生の破壊に意を介さない計画ではないかと思われます"@ja.
<< kg:id_1 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "それらについてどのように保全していくのか、貴社のお考えについてお聞かせ下さい"@ja.
<< kg:id_1 prop:effect kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "すでに多くの UI ターン者が、この事業が実現する場合は安来市を離れるつもりであることを示しており"@ja.
<< kg:id_1 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "今後移住を考えている人たちにとっても、安来市を選ばない理由となるでしょう"@ja.
<< kg:id_1 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "地域住民と行政が移住政策で築き上げてきた地域の絆に大きな損害があることは、深刻な問題です"@ja.
<< kg:id_1 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "このような風車の景観は、不動産の景観価値を下げる可能性があります"@ja.
<< kg:id_1 prop:effect kg:id_37 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "風車の運転中に発生する騒音や振動は、周辺の不動産価値にも影響を与える可能性が高いと言えます。現に、東伊豆町や高知県でも不動産が売れないという被害者の声が上がっています"@ja.
<< kg:id_1 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "風力発電施設の建設が不動産価値に影響がある場合には、事前に適切な補償制度や地域住民との事前の合意が必要なはずです"@ja.
<< kg:id_1 prop:effect kg:id_39 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "貴社から十分な説明を受けている人は殆ど存在せず、騒音・低周波の影響が発生する可能性や風車の大きさについてすら無知に等しい状況でした"@ja.
<< kg:id_1 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "貴社は少なくとも影響の及ぶとされる地域住民に対しては一軒ずつ訪問し、デメリットについても適切に説明する対応を求めます"@ja.
<< kg:id_1 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "多くの地域住民が納得できないままの状態で事業を押し進めず、配慮書段階での説明会を再度開催するよう求めました"@ja.
<< kg:id_1 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "加えて方法書の延期を求めました"@ja.
<< kg:id_1 prop:effect kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "貴社は説明会で市民の意見に耳を傾けると言いながら、実際には真逆の対応をしているため、地域住民から不信感を抱かれています"@ja.
<< kg:id_1 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "もし貴社が地域住民に対して適切な説明を果たさない場合、事業を中断し、撤退することは必要不可欠と考えられます"@ja.
<< kg:id_1 prop:effect kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "レーダーサイトの約 100Km 圏内にある風力発電所が敵機検知能力に影響を与える可能性があることは、既に一般的に知れ渡っている事実です"@ja.
<< kg:id_1 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "当建設地においては具体的にどのような対策を施すのか、地域住民の安全にかかわる問題ですので、住民が安心できるようにわかりやすくしっかりした説明を求めます"@ja.
<< kg:id_1 prop:effect kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "これまで国内外で、3,000kW 以下の風車でも 2〜3km の隔離距離で風車騒音による睡眠障害などの健康被害が発生していることが報告されています"@ja.
<< kg:id_1 prop:effect kg:id_48 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "低周波音に関する感覚については個人差が大きく、参照値以下でも低周波音を許容できない可能性が 10％程度残されているとしています"@ja.
<< kg:id_1 prop:effect kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "人的被害の可能性がある以上、リスクヘッジの観点から過小評価することは適切ではありません"@ja.
<< kg:id_1 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "住居移転の補償を前提とした計画であれば、地域住民へ具体的な補償条件についての説明も行っていただく必要があります"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "問題の主な原因は、町有地貸付に締結した地上権設定契約の内容にあります"@ja.
<< kg:id_51 prop:effect kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "地域住民は事業終了後の原状回復や風力発電による事故に対する適切な対応が求められないと不平等な内容を懸念しています"@ja.
<< kg:id_51 prop:effect kg:id_54 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "日本環境保法律家連盟の弁護士らはこの契約をチェックし、全国的にも他ではこういった事例は見たことがない不利益なものとして指摘しています"@ja.
<< kg:id_51 prop:effect kg:id_55 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "この会社が 20 年後に風車を撤去するとなったときに、果たしてきちんと撤去できるのか？風車を撤去にかかる費用は１基あたり１億円以上かかるが、町が負担することになる不安も残る"@ja.
<< kg:id_51 prop:effect kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "そのため、地域住民は契約が違法だとして住民監査請求を行っています"@ja.
<< kg:id_1 prop:effect kg:id_57 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "私たち地域住民はこのような不利な条件を押し付けられることを懸念しています"@ja.
}
