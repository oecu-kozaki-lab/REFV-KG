PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00015> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "向山風力発電事業"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "赤屋地区が建設予定地の日向山風力発電に最も近い地区であること"@ja.
kg:id_2 rdf:type cls:c_13092.
cls:c_13092 rdfs:label "立地条件"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "反対の声が多い"@ja.
kg:id_3 rdf:type cls:c_14166.
cls:c_14166 rdfs:label "住民の反対"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "環境破壊を助長する"@ja.
kg:id_4 rdf:type cls:c_13226.
cls:c_13226 rdfs:label "環境破壊"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "周辺の自治区でも反対に回る"@ja.
kg:id_5 rdf:type cls:c_14166.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "住民の意思を尊重して早急に撤退する"@ja.
kg:id_6 rdf:type cls:c_12177.
cls:c_12177 rdfs:label "撤退要求"@ja.
kg:id_1 prop:countermeasure kg:id_6.
kg:st_1 rdfs:label "説明会参加住民"@ja.
kg:st_1 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "住民の同意が不可欠"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "ここだけには立てないでほしい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "筆者"@ja.
kg:st_2 rdf:type cls:st_178.
cls:st_178 rdfs:label "筆者"@ja.
kg:op_3 prop:content "強引に建設に踏み切れば環境アセスは再エネビジネスを促進し環境破壊を助長する悪法同然"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "風力発電の情報が伝われば皆反対に回る"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "住民の意思を尊重して早急に撤退してほしい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "赤屋地区は建設予定地の日向山風力発電に最も近い地区になりますので、反対する方や意識の高い方が多い場所です。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "説明会場ではやはり反対の声が多く、「住民の同意が不可欠」や「ここだけには立てないでほしい！」という切なる声もありました。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "これでも強引に風力発電の建設に踏み切るようであれば、環境アセスとは、やはり再エネビジネスを促進し環境破壊を助長するための悪法といっても過言ではありませんね。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "そしてこれから周辺の自治区でも風力発電の情報が伝われば皆反対に回るのは目に見えています。"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "住民の意思を尊重して早急に撤退していただきたいものです。"@ja.
}
