PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00019> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "住民の不満"@ja.
kg:id_1 rdf:type cls:c_14173.
cls:c_14173 rdfs:label "住民の不満"@ja.
kg:id_2 rdfs:label "日向山風力発電事業の方法書説明会の開催"@ja.
kg:id_2 rdf:type cls:c_3027.
cls:c_3027 rdfs:label "説明会"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "説明会にならず"@ja.
kg:id_3 rdf:type cls:c_14174.
cls:c_14174 rdfs:label "説明会の混乱"@ja.
kg:id_4 rdfs:label "住民の不信感と不満の声"@ja.
kg:id_4 rdf:type cls:c_14173.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "日向山風力発電事業の方法書説明会"@ja.
kg:id_5 rdf:type cls:c_3027.
kg:id_6 rdfs:label "後日あらためて開催することになった"@ja.
kg:id_6 rdf:type cls:c_14175.
cls:c_14175 rdfs:label "再開催"@ja.
kg:id_5 prop:effect kg:id_6.
kg:id_7 rdfs:label "住民の不満が爆発した"@ja.
kg:id_7 rdf:type cls:c_14173.
kg:id_5 prop:effect kg:id_7.
kg:id_8 rdfs:label "住民の不信感と不満の声が上がった"@ja.
kg:id_8 rdf:type cls:c_14173.
kg:id_5 prop:effect kg:id_8.
kg:id_9 rdfs:label "後日あらためて開催する"@ja.
kg:id_9 rdf:type cls:c_14175.
kg:id_5 prop:countermeasure kg:id_9.
kg:st_1 rdfs:label "住民"@ja.
kg:st_1 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "事業者への不信感と不満を示す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "説明会の進行に強い不満を持つ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "不満が強く噴出した"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "事業者への不信感を表明した"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "4月15日土曜日、井尻交流センターにて、日向山風力発電事業の方法書説明会がジャパン・リニューアブル・エナジー社にて開催されました。参加者は30名以上が集まり、序盤から住民の不信感と不満の声が上がり"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "序盤から住民の不信感と不満の声が上がり、説明会にならず"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:text-txt_contents "説明会にならず、後日あらためてという事に"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "事業者説明会：井尻交流センターにて住民の不満が爆発しました"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "参加者は30名以上が集まり、序盤から住民の不信感と不満の声が上がり"@ja.
<< kg:id_5 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "説明会にならず、後日あらためてという事に"@ja.
}
