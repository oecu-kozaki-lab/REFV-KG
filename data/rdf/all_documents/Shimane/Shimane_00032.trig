PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Shimane/00032> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "鳥取県西部風力発電計画"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "土砂災害危険域だらけの山々と小学校や民家が近くにある場所への大型風車建設計画"@ja.
kg:id_2 rdf:type cls:c_14258.
cls:c_14258 rdfs:label "危険地域での風車建設"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "崩れやすい山々の尾根を切り開いて150m級の風車を数十基建設すること"@ja.
kg:id_3 rdf:type cls:c_14259.
cls:c_14259 rdfs:label "脆弱地形での風車建設"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "住民の不安"@ja.
kg:id_4 rdf:type cls:c_250.
cls:c_250 rdfs:label "住民の不安"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "山々の崩壊や道路への土砂流出"@ja.
kg:id_5 rdf:type cls:c_832.
cls:c_832 rdfs:label "土砂災害"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "土砂が民家まで押し寄せる懸念"@ja.
kg:id_6 rdf:type cls:c_14260.
cls:c_14260 rdfs:label "住宅地への土砂被害"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "事業終了後もしばらく残る土砂災害の懸念"@ja.
kg:id_7 rdf:type cls:c_832.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "事業終了後の出来事が補償されない可能性"@ja.
kg:id_8 rdf:type cls:c_14190.
cls:c_14190 rdfs:label "補償不足"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "水源域への被害の懸念"@ja.
kg:id_9 rdf:type cls:c_14261.
cls:c_14261 rdfs:label "水源被害"@ja.
kg:id_1 prop:effect kg:id_9.
kg:id_10 rdfs:label "想定されるあらゆる事態を列挙し補償内容を明確にすること"@ja.
kg:id_10 rdf:type cls:c_14262.
cls:c_14262 rdfs:label "補償明確化"@ja.
kg:id_1 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "親会社を含め2回目3回目もきちんと補償すること"@ja.
kg:id_11 rdf:type cls:c_14263.
cls:c_14263 rdfs:label "継続補償"@ja.
kg:id_1 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "補償内容を契約にしっかり盛り込むこと"@ja.
kg:id_12 rdf:type cls:c_14264.
cls:c_14264 rdfs:label "契約明記"@ja.
kg:id_1 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "住民にきちんと説明すること"@ja.
kg:id_13 rdf:type cls:c_87.
cls:c_87 rdfs:label "住民説明"@ja.
kg:id_1 prop:countermeasure kg:id_13.
kg:st_1 rdfs:label "記事投稿者"@ja.
kg:st_1 rdf:type cls:st_179.
cls:st_179 rdfs:label "情報発信者"@ja.
kg:op_1 prop:content "リスクを顧みない計画で不安の声が上がるのは当然だとする"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "何も起きないと考えるのは無理があるとする"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "住民"@ja.
kg:st_2 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_3 prop:content "事業への不安を示す"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "風力発電地域では各所で崩壊や土砂流出が確認できると指摘する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "民家近くの風車により土砂が住宅地へ及ぶことを不安視する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "撤去後も土砂災害の懸念が残ると指摘する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "事業終了後の被害は補償されない可能性が高いと懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地域の水源域の一つであり開発は慎重であるべきとする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "補償範囲を具体化し住民に示すべきだと求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "繰り返し被害が起きても補償責任を果たす体制が必要だとする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "補償条件を契約に明記しなければならないとする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "住民の理解を得るには丁寧な説明が最低限必要だとする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "鳥取県西部の風力発電計画については、１５０ｍ４５００ｋｗあるようなバカでかい風車を土砂災害危険域だらけの山々と小学校や民家が近くにあるような場所にリスクも顧みずよう建てよう"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "カンナ流しが盛んにおこなわれていたような崩れやすい山々の、しかも尾根を切り開いて１５０ｍ級の風車を数十基も建てて「何も起きない」と考える方が無理がある"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "当然、住民からは不安の声が多くあがりました。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "これをみてもあちこちで崩れているのがわかります。道路に土砂が流れ出ている箇所がここの風力発電地域だけでもいくつか確認できます。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "出雲ではかなり民家に近い風車もあり、土砂がそのうち民家まで押し寄せないか不安に感じます。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "２０年経過後には撤去されたとしても、その後の土砂災害の懸念はしばらく残ると思います"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業終了後の出来事に補償される可能性は限りなくゼロではないかと。"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "ここの山々は地域の水源域の一つです。"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "想定されるあらゆる事態を列挙し、補償内容を明確にすること"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "２回目、３回目も親会社がきちんと補償すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "その辺りをしっかり契約に盛り込み"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "住民にきちんと説明すること、これくらいは事業者として最低限用意しないと、住民の理解は得られないでしょう。"@ja.
}
