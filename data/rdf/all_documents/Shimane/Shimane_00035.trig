<< kg:id_18 prop:cause kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "特に，山地部を自然環境保全ゾーンと位置づけるなど森林の豊かな自然を守ることを重視している"@ja.
