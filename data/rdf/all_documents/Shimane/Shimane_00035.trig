kg:st_1 rdfs:label "馬場・田頭"@ja.
kg:st_1 rdf:type cls:st_105.
cls:st_105 rdfs:label "研究者"@ja.
kg:op_1 prop:content "サイレントマジョリティが多く反対の少数意見が多数意見と誤認されることを懸念"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市民団体A"@ja.
kg:st_2 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_2 prop:content "健康被害への不安から騒音問題を重視"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "景観への悪影響を問題視"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "論点が土砂災害まで拡大した"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "自然環境や生態系保全を重視して反対"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "説明不足が不信感と要求水準上昇につながった"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "著者ら"@ja.
kg:st_3 rdf:type cls:st_105.
kg:op_7 prop:content "反対運動は論点拡大と説明不足で要求水準が上がる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:st_4 rdfs:label "市民団体A書き込み"@ja.
kg:st_4 rdf:type cls:st_73.
kg:op_8 prop:content "一番の懸念は健康被害である"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "騒音を健康被害につながる問題として懸念"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "低周波による健康影響を懸念"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "PFASを問題の一つとして挙げる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "ビスフェノールAを問題の一つとして挙げる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "山地部を自然環境保全ゾーンとして守るべきと考える"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "重要区域での保安林解除を問題視"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "最悪の事態の想定と補償内容の提示を求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:st_5 rdfs:label "地元テレビ局報道"@ja.
kg:st_5 rdf:type cls:st_186.
cls:st_186 rdfs:label "報道機関"@ja.
kg:op_16 prop:content "イヌワシ調査への疑念報道が反対拡大の契機になった"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:op_17 prop:content "準備書公告後に反対が強まった"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:st_6 rdfs:label "事業者"@ja.
kg:st_6 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_18 prop:content "計画の取りやめを発表"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_6.
kg:st_7 rdfs:label "米沢市"@ja.
kg:st_7 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_19 prop:content "周辺地域のみならず市民全体に向けた説明会開催を求める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_7.
kg:op_20 prop:content "野生鳥獣や生態系への対応を求める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_7.
kg:op_21 prop:content "公害対策の検討と措置を求める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_7.
kg:op_22 prop:content "災害対策の検討と措置を求める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_7.
kg:op_23 prop:content "景観への対応を求める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_7.
kg:op_24 prop:content "説明が不十分で理解醸成に至っていないと判断"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_7.
kg:op_25 prop:content "追加説明会または意見交換会を要望"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_7.
kg:st_8 rdfs:label "山形県知事意見"@ja.
kg:st_8 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_26 prop:content "イヌワシ保全の見地から抜本的見直しを求める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_8.
kg:op_27 prop:content "イヌワシ保全の観点から取止めも含めて求める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_8.
kg:st_9 rdfs:label "市民団体B"@ja.
kg:st_9 rdf:type cls:st_73.
kg:op_28 prop:content "イヌワシを中心とした生態系影響を強く懸念"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_9.
kg:st_10 rdfs:label "猛きん類の専門家や日本イヌワシ研究会など"@ja.
kg:st_10 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_29 prop:content "事業者側の生息調査は極めて不適切として中止を求める"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_10.
kg:op_30 prop:content "不適切な生息調査を理由に中止を求める"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_10.
kg:st_11 rdfs:label "市民団体B書き込み"@ja.
kg:st_11 rdf:type cls:st_73.
kg:op_31 prop:content "説明会要請に応じない姿勢が不信感を高めた"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_11.
kg:op_32 prop:content "事業者の検討中という対応が不信感につながった"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:st_12 rdfs:label "全国的な環境NGO"@ja.
kg:st_12 rdf:type cls:st_158.
cls:st_158 rdfs:label "環境団体"@ja.
kg:op_33 prop:content "自然環境保全の観点から立地選定の見直しを求める"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_12.
kg:op_34 prop:content "生物多様性保全上重要な地域での事業を懸念"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_12.
kg:op_35 prop:content "土砂流出など事業実施による影響にも触れている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_12.
kg:st_13 rdfs:label "全国的な環境NGO書き込み"@ja.
kg:st_13 rdf:type cls:st_158.
kg:op_36 prop:content "生物多様性保全上重要な自然環境のため立地選定から見直すべき"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_13.
kg:op_37 prop:content "計画段階での配慮書が重要である"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_12.
kg:op_38 prop:content "地域住民との合意形成を重視"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_12.
kg:op_39 prop:content "ウェブサイトや資料配付や勉強会開催は基本的な活動である"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "行政担当者への直接ロビイングも積極的に行っている"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "議員への直接ロビイングも積極的に行っている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "接触したパイプを活かして意見書を提出している"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "集めた署名を提出して影響力を高めている"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "地球温暖化対策として，化石燃料に代わる再生可能エネルギーの導入が急務となっており"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "再エネ導入に伴う災害リスクの増加や景観，生態系への影響など，再エネを設置する地域との対立も増加している"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:text-txt_contents "再エネ導入に伴う災害リスクの増加や景観，生態系への影響など，再エネを設置する地域との対立も増加している"@ja.
<< kg:id_3 prop:cause kg:id_6 >>
    prop:text-txt_contents "再エネ導入に伴う災害リスクの増加や景観，生態系への影響など，再エネを設置する地域との対立も増加している"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "再エネ建設には，建設する地域との合意形成が不可欠であり"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "そのため，環境紛争の発端は，施設建設に反対する一部の声がマジョリティの意見として捉えられることも懸念される"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
