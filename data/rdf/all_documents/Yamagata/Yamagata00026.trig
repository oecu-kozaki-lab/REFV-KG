PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/Yamagata/00026> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "県営風力発電事業（仮称）環境影響評価方法書"@ja.
kg:id_1 rdf:type cls:c_346.
cls:c_346 rdfs:label "環境影響評価書"@ja.
kg:id_2 rdfs:label "山形県環境影響評価審査会の意見"@ja.
kg:id_2 rdf:type cls:c_347.
cls:c_347 rdfs:label "審査会意見"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "酒田市十里塚風力発電事業(仮称）に係る環境影響評価方法書"@ja.
kg:id_3 rdf:type cls:c_346.
kg:id_3 prop:countermeasure kg:id_2.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "「県営風力発電事業（仮称）環境影響評価方法書」に対する山形県環境影響評価審査会の意見について"@ja.
<< kg:id_3 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "「酒田市十里塚風力発電事業(仮称）に係る環境影響評価方法書」に対する山形県環境影響評価審査会の意見について"@ja.
}
