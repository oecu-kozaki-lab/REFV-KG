kg:op_1 prop:content "隣接する酒田市の事業との累積影響を踏まえて評価すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "隣接する酒田市の事業との累積影響を踏まえて評価すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "隣接する酒田市の事業との累積影響を踏まえて評価すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "冬季も含めて風の影響を検討すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "油脂類の飛散や流出を防ぐ具体的対策を示すべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "夜間の静穏時を含めて民家への影響を予測評価すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "仮設工事用道路による影響も評価項目に加えるべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "渡り鳥や繁殖生態を把握し影響があれば保全措置や工事時期を検討すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "ブレードの着色など衝突防止対策を検討すべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "濁水流入を防ぐ必要な対策を具体的に示すべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "危急度の高い植物群落への影響を調査予測評価すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "影響が予測される場合は保全措置を検討すべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "敷設期間を考慮して動植物への影響を予測評価すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "酒田市の施設を踏まえて景観資源と眺望点を選定すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "大きな影響が予想される場合は既設道路利用も検討すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "周辺地区での交通事故防止対策を徹底すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "砂丘地の改変をできる限り低減すべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "砂丘地の改変をできる限り低減すべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "砂丘地の改変をできる限り低減すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "海浜植物への影響をできる限り低減すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "海浜植物への影響をできる限り低減すべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "海浜植物への影響をできる限り低減すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "地域住民への丁寧で誠意ある対応を求める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "高度な知見が必要な場合は専門家の意見を聴くべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "隣接事業の影響を踏まえた環境影響評価を行うべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "累積影響が少ないとするなら理由を具体的に示すべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "予測は定量的手法で行うべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "自然公園指定区域である点に配慮すべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "支持基盤層に関する資料を明記すべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "参考文献が不十分なため追加資料の収集調査が必要"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "油脂類の飛散流出防止策を十分に講じるべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "講じる対策を具体的に明示すべき"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "風の強い冬季を含めて検討すべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "改変区域が分かる横断図を提示すべき"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "周辺景観への配慮が必要"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "酒田市施設との色彩調和に配慮すべき"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "隣接施設の影響を含めて予測すべき"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "強風時を含む時期設定で予測すべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "現況からの増加分も評価すべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "夜間静穏時の民家影響も評価すべき"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "気象特性を踏まえ季節ごとに十分な調査時間を設けるべき"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "仮設道路の影響も評価対象に含めるべき"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "渡り鳥や繁殖生態の把握を十分に行うべき"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "野生鳥類への影響があれば工事時期見直しを含む保全措置を検討すべき"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "着色等による野鳥衝突防止策を検討すべき"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "猛禽類調査は環境省の指針を参考にすべき"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "営巣確認時に対応できる柔軟な調査計画が必要"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "濁水の海域流入防止策を講じるべき"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "濁水対策を具体的に示すべき"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "植生調査は哺乳類鳥類の調査区域まで広げるべき"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "重要植物群落として影響を調査予測評価すべき"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "準備書で重要な植物群落として明記すべき"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "貴重種の生育生息状況を適切に把握すべき"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "影響が見込まれる場合は保全措置を講じるべき"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "移行帯を含む植生調査が必要"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "鋼板敷設期間を踏まえて動植物影響を評価すべき"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "影響が大きい場所は植生図で把握できるようにすべき"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "隣接事業を踏まえ景観資源と眺望点を適切に設定すべき"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "自然歴史文化を含む多面的な景観把握が必要"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "地元住民に親しまれた景観の保全にも配慮すべき"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "大きな影響が見込まれる場合は既設道路活用を検討すべき"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:op_62 prop:content "周辺地区の事故防止対策を徹底すべき"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "交通事故防止対策を準備書に明記すべき"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:op_64 prop:content "環境省の手引きや参考事例を活用すべき"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "砂丘地改変と海浜植物への影響の最小化を求める"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_1.
kg:op_66 prop:content "改変区域は原状の植生への復旧を基本とすべき"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_1.
kg:op_67 prop:content "復旧時は在来種による緑化に配慮すべき"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "工事中並びに供用時における騒音及び超低周波音、景観、動植物等への影響が累積的なものとなるおそれがある"@ja.
<< kg:id_3 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "工事中並びに供用時における騒音及び超低周波音、景観、動植物等への影響が累積的なものとなるおそれがある"@ja.
<< kg:id_4 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "工事中並びに供用時における騒音及び超低周波音、景観、動植物等への影響が累積的なものとなるおそれがある"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "風力発電施設の設置による砂丘地の地形への風の影響について、風の強い冬季の影響も含め、検討すること"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "資材搬出入用トラックの油脂類が仮設道路周辺及び海域等へ飛散、流出しないよう十分な対策を講じること"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "夜間の静穏時における最寄りの民家等への影響についても予測、評価を行うこと"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "仮設工事用道路の設置に伴う影響についても評価項目として選定すること"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業実施に伴う野生鳥類の生息及び生息環境への影響が認められる場合には、工事の実施時期の検討も含め、適切な環境保全措置を検討すること"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "風車ブレ－ドの着色等、ブレードと野鳥の衝突防止対策について検討すること"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "工事中の濁水が海域に流入し海域の動植物に影響がないよう必要な対策を講じるとともに、その対策について具体的に示すこと"@ja.
<< kg:id_13 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "庄内砂丘ハマニンニク－コウボウムギ群落が確認されていることから、事業実施による影響について調査、予測及び評価を行うこと"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "貴重な動植物も確認されていることから、それらの生育、生息状況を適切に把握し、影響が予測される場合は保全措置を検討すること"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "鋼板の敷設期間を考慮した動植物への影響の予測及び評価を行うこと"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "景観については、酒田市による風力発電施設を踏まえて適切な景観資源及び眺望点を選定し、予測及び評価を行うこと"@ja.
<< kg:id_11 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "仮設工事用道路の設置により、庄内砂丘の地形や海浜植物帯に生育、生息する動植物等への大きな影響が予想される場合は、既設の森林管理用道路の利用の可能性についても検討すること"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "工事用車両の走行が集中する事業実施区域周辺地区での交通事故防止対策を徹底すること"@ja.
<< kg:id_5 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "風力発電施設の設置、仮設工事用道路の敷設及び送電線の埋設等による砂丘地の改変及び海浜植物への影響をできる限り低減するよう努めること"@ja.
<< kg:id_30 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "風力発電施設の設置、仮設工事用道路の敷設及び送電線の埋設等による砂丘地の改変及び海浜植物への影響をできる限り低減するよう努めること"@ja.
<< kg:id_31 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "風力発電施設の設置、仮設工事用道路の敷設及び送電線の埋設等による砂丘地の改変及び海浜植物への影響をできる限り低減するよう努めること"@ja.
<< kg:id_5 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "風力発電施設の設置、仮設工事用道路の敷設及び送電線の埋設等による砂丘地の改変及び海浜植物への影響をできる限り低減するよう努めること"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "風力発電施設の設置、仮設工事用道路の敷設及び送電線の埋設等による砂丘地の改変及び海浜植物への影響をできる限り低減するよう努めること"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "風力発電施設の設置、仮設工事用道路の敷設及び送電線の埋設等による砂丘地の改変及び海浜植物への影響をできる限り低減するよう努めること"@ja.
<< kg:id_33 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "環境影響評価の手続きを進めるにあたっては、地域住民に対し丁寧な説明を行うなど誠意ある対応を行うこと"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "調査、予測及び評価を進めるなかで、より高度な知見が必要となった場合には、専門の学識経験者等からの意見を聴くこと"@ja.
<< kg:id_33 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "酒田市が設置する風力発電施設の影響を踏まえた環境影響評価を実施すること"@ja.
<< kg:id_33 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "累積的な影響のおそれが少ないと判断した場合は、その理由について具体的に記載すること"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "環境影響の予測にあたっては、できる限り定量的な手法を用いること"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "影響の予測、評価にあたっては、事業実施区域が庄内海浜県立自然公園に指定されていることに留意すること"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "構造物を安定させる地下部の支持基盤層に関する資料を準備書に記載すること"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "動植物の既往調査については参考とした文献が不十分であることから、あらためて必要な資料を収集し調査すること"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "資材搬出入用トラックの油脂類が仮設道路周辺及び海域等へ飛散、流出しないよう十分な対策を講じること"@ja.
<< kg:id_46 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "また、その対策について具体的に示すこと"@ja.
<< kg:id_5 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "風力発電施設の設置による砂丘地の地形への風の影響について、風の強い冬季の影響も含め、検討すること"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "風力発電施設及び仮設工事用道路等の設置に伴う改変区域を示す横断図を資料として提示すること"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "風力発電施設の色彩の計画にあたっては、周辺の景観に配慮するとともに"@ja.
<< kg:id_52 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "酒田市の風力発電施設の色彩との調和にも配慮すること"@ja.
<< kg:id_9 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "施設の稼働に伴う騒音及び超低周波音の予測は、隣接する酒田市の風力発電施設からの影響を含めて"@ja.
<< kg:id_9 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "すべての風力発電施設が定格出力となる強風時を含めた予測対象時期を選定すること"@ja.
<< kg:id_9 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "現況騒音レベルからの増加分についても予測及び評価を行う"@ja.
<< kg:id_9 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "夜間の静穏時における最寄りの民家等への影響についても予測、評価を行うこと"@ja.
<< kg:id_9 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "現地の風や気温等の気象特性を考慮し、適切な影響予測及び評価ができるよう、季節ごとに１週間程度の調査時間を設定すること"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "仮設工事用道路の設置に伴う影響についても評価項目として選定すること"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "渡り鳥の飛翔行動、繁殖生態等を十分把握するとともに"@ja.
<< kg:id_13 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "工事の実施時期の検討も含め、適切な環境保全措置を検討すること"@ja.
<< kg:id_15 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "風車ブレ－ドの着色等、ブレードと野鳥の衝突防止対策について検討すること"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "猛禽類の調査にあたっては「猛禽類保護の進め方（改定版）（環境省 平成24年12月）」を参考とすること"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "必要に応じて調査期間の延長や調査回数の追加等ができるよう柔軟な調査計画とすること"@ja.
<< kg:id_17 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "工事中の濁水が海域に流入し海域の動植物に影響がないよう必要な対策を講じること"@ja.
<< kg:id_17 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "その対策について具体的に示すこと"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "植生調査については、哺乳類・鳥類の調査区域まで含めること"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "庄内砂丘ハマニンニク－コウボウムギ群落が確認されていることから、事業実施による影響について調査、予測及び評価を行うこと"@ja.
<< kg:id_73 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "準備書の中で「重要な植物群落」として記載すること"@ja.
<< kg:id_20 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "それらの生育、生息状況を適切に把握し"@ja.
<< kg:id_20 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "影響が予測される場合は保全措置を検討すること"@ja.
<< kg:id_71 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "植生調査にあたっては、クロマツ群落や海浜植物帯の草本群落のほか、移行帯である植物群落についても調査を行うこと"@ja.
<< kg:id_79 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "鋼板の敷設期間を考慮した動植物への影響の予測及び評価を行うこと"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "植物群落への大きな影響が予想される場所については、植物群落の分布が適切に把握できる植生図を作成すること"@ja.
<< kg:id_3 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "景観については、酒田市による風力発電施設を踏まえて適切な景観資源及び眺望点を選定し、予測及び評価を行うこと"@ja.
<< kg:id_3 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "自然、歴史、文化等の多様な側面から地域の景観特性を的確に把握することが必要であり"@ja.
<< kg:id_85 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "景観資源については、自然景観とともに、地元の人が慣れ親しんだ景観の保全にも十分配慮して、予測及び評価を行うこと"@ja.
<< kg:id_11 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "既設の森林管理用道路の利用の可能性についても検討すること"@ja.
<< kg:id_27 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "工事用車両の走行が集中する事業実施区域周辺地区での交通事故防止対策を徹底すること"@ja.
<< kg:id_27 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "なお、その対策について準備書に記載すること"@ja.
<< kg:id_90 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "調査、予測及び評価にあたっては、「鳥類等に関する風力発電施設立地適正化のための手引き」及び「国立・国定公園内における風力発電施設の審査に関する技術的ガイドライン」のほか、環境省から示されている各種調査報告書や参考事例等も参考とすること"@ja.
<< kg:id_92 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "事業計画の策定にあたっては、風力発電施設の設置、仮設工事用道路の敷設及び送電線の埋設等による砂丘地の改変及び海浜植物への影響をできる限り低減するよう努めること"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "改変した区域については、改変前の植生に復旧することを基本とし"@ja.
<< kg:id_94 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "その際、在来種による緑化に配慮すること"@ja.
}
