kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "社会生活や地域経済はいまだ大きな影響を受け続けていると認識する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "基本的な感染防止対策の徹底を引き続き求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "追加接種と子供への接種準備を着実に進める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "本市でも感染拡大が進んでいると述べる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "感染拡大を受け庄内地方全域に重点措置が適用されたと説明する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "コロナ禍で様々な活動が制約を受けていると述べる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "農林水産業を取り巻く環境は厳しいと認識する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "水揚げ量減少が農林水産業の厳しさを強めているとみる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "財政運営は一層厳しさを増していると述べる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "人口減少下でコロナ禍からの脱却へ果敢な挑戦が必要とする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "市政情報共有のため市民マイページを開発する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "地域課題をデジタル技術と協働で解決につなげる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "公益活動団体の提案を受け協働事業として進める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "公益活動団体提案を受け協働事業で進める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "子育て不安に寄り添う支援を協働事業で進める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "民間事業者提案の具体化に取り組む"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "大学連携でデジタル人材育成を進める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "今後は18歳以下人口減少で学生確保が一段と厳しくなるとみる"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "大学存続のため早期公立化に取り組む"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "児童生徒指導上の課題は複雑化していると認識する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "課題に迅速かつ適切に対応するため相談体制を整える"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "相談体制を充実し安心して学校生活を過ごせる環境を整える"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "一人一人のニーズに応じた指導体制を維持する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "端末を効果的に活用できる環境整備を進める"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "令和6年度完成を目指し給食室整備を進める"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "国史跡の山居倉庫を次世代に継承するため保存活用を進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "多様な活動と学習の場を提供し交流とにぎわいを生む"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "子供の体力向上のため連携事業に取り組む"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "関係団体の意見を聞きながら整備の在り方を検討する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "中小企業者と小規模事業者の資金繰りを支援する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "引き続き小規模事業者の支援に努める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "企業立地と事業拡大を促し雇用創出を図る"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "サテライトオフィス設置事業者の誘致に努める"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "関係機関と連携し酒田港の利用促進と荷主増加を図る"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "再生可能エネルギー導入で地域経済の好循環を目指す"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "国や県や地元企業と連携して進める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "若者と市内企業をつなぐ取組を進める"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "必要人材確保とUIJターン就職を後押しする"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "米価はコロナ禍の影響で下落基調にあると説明する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "主食用米からの作付転換が必要とみる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "飼料作物供給と堆肥液肥活用による循環型農業を進める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "農地管理体制が弱体化していると認識する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "豪雨災害多発で施設管理費が増えていると述べる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "老朽化が著しいことを課題認識として示す"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "促進協議会の活動展開と土地改良事業推進に力を入れる"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "適切でない森林管理の改善を図る"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "森林資源把握と境界明確化で取組を加速させる"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "戦略会議を中心にブランド化を進める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "全国発信と大都市圏への販路拡大につなげる"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "経営基盤強化のため整備支援を継続する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "相談者の状況に応じた施策を展開する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "参加意欲の高い人材の移住を促進する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "本市の特色を生かした戦略的観光振興を進める"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "秋田市との交流をさらに促進する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "山形県と連携して受入れ再開の準備を進める"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "航空需要が落ち込んだ厳しい状況が続くと認識する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "観光事業者と連携し利用拡大に努める"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "65歳未満人口減少で高齢化率が上昇していると述べる"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "担い手不足が大きな課題と認識する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "多様な主体が参画する地域づくりと共生社会の実現を進める"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "市民の経済的負担軽減のため3年連続で税率を引き下げる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:op_62 prop:content "結婚希望をかなえる支援を行う"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "安心して不妊治療を受けられるよう助成を継続する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:op_64 prop:content "無償化対象外の保育料負担軽減を図る"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "独自対策として利用者負担を軽減する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_1.
kg:op_66 prop:content "保育ニーズが高まっていると認識する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_1.
kg:op_67 prop:content "ニーズに対応できる体制整備のため保育人材確保に努める"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "推進体制を強化する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_1.
kg:op_69 prop:content "希望する全ての方が安心して接種できる体制を整える"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_1.
kg:op_70 prop:content "看護人材確保に努める"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_1.
kg:op_71 prop:content "本人や家族や医療機関が活用できる仕組みを検討する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
kg:op_72 prop:content "地域と行政で基本理念を共有し協働を進める"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_1.
kg:op_73 prop:content "令和5年度中の移転を目指して改修を進める"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_1.
kg:op_74 prop:content "減少しているが依然として多いと認識する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_1.
kg:op_75 prop:content "循環型社会実現のため分別と減量の施策を展開する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_1.
kg:op_76 prop:content "市民と民間事業者が主体となる活動に育てる"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_1.
kg:op_77 prop:content "災害時の情報伝達手段を引き続き普及する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_1.
kg:op_78 prop:content "防災情報の迅速提供と早期避難行動を促す"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_1.
kg:op_79 prop:content "女性の視点を取り入れて共助体制を強化する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_1.
kg:op_80 prop:content "資機材整備と研修で地域防災力を高める"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_1.
kg:op_81 prop:content "放置された管理不全空き家等は危険と認識する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_1.
kg:op_82 prop:content "利活用促進と危険老朽空き家の解消を進める"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_1.
kg:op_83 prop:content "ミライニ開業に合わせ公共交通を充実させる"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_1.
kg:op_84 prop:content "利便性向上と感染防止を図る"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_1.
kg:op_85 prop:content "高速通信基盤を生かして利便性と情報収集力を高める"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_1.
kg:op_86 prop:content "実証調査を踏まえ課題解決に取り組む"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_1.
kg:op_87 prop:content "飛島の拠点施設に新機能を持たせる"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_1.
kg:op_88 prop:content "新たなまちの姿を創出する"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_1.
kg:op_89 prop:content "令和6年度オープンを目指す"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_1.
kg:op_90 prop:content "再生事業が進むよう支援する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_1.
kg:op_91 prop:content "将来の地域づくりに欠かせないインフラとして早期整備を求める"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_1.
kg:op_92 prop:content "鉄道事業者の経営環境は非常に厳しいと認識する"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_1.
kg:op_93 prop:content "通学や通勤利用者が使いやすいダイヤ確保を要望する"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_1.
kg:op_94 prop:content "浸水被害解消のため計画的更新を進める"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_1.
kg:op_95 prop:content "山形県に粘り強く要望する"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_1.
kg:op_96 prop:content "経営の効率化に努める"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_1.
kg:op_97 prop:content "ウェブで完結する手続を目標にデジタル変革を進める"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_1.
kg:op_98 prop:content "普及と利用拡大に努める"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_1.
kg:op_99 prop:content "労働生産性向上のため導入を進める"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_1.
kg:op_100 prop:content "必要な人材の育成確保と人的資源の有効活用を図る"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_1.
kg:op_101 prop:content "ペーパーレス化を推進する"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_1.
kg:op_102 prop:content "財政構造上予算編成は極めて厳しいと認識する"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_1.
kg:op_103 prop:content "基金依存の財政運営には限界があると述べる"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_1.
kg:op_104 prop:content "将来的な行政サービス維持に向け選択を行った"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_1.
kg:op_105 prop:content "財政状況を踏まえイベント予算を抑制した"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_1.
kg:op_106 prop:content "繰越金の状況を踏まえ負担金を一部削減した"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_1.
kg:op_107 prop:content "事業統合で効率化を進める"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_1.
kg:op_108 prop:content "寄附金獲得などの積極的取組を強化する"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_1.
kg:op_109 prop:content "未利用財産売却で歳入確保に取り組む"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_1.
kg:op_110 prop:content "売電収益も歳入確保策として重視する"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_1.
kg:op_111 prop:content "今後の財政運営に資する財政基盤確立に努める"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "私たちの社会生活や地域経済はいまだ大きな影響を受け続けています。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "市民の皆様には、手洗いや手指消毒、不織布マスクの着用、密閉・密集・密接の３密を避けるなど基本的な感染防止対策の徹底を引き続きお願いいたします。"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "ワクチン接種に関しては、３回目の接種に加え、５歳から11歳までの子供たちへのワクチン接種に向けた準備も着々と進めています。"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "世界的に猛威を振るう新型コロナウイルス感染症は、本年に入り本市においても感染拡大が進み"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "本年に入り本市においても感染拡大が進み、１月27日からは庄内地方全域にまん延防止等重点措置が適用されました。"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "さて、コロナ禍で様々な活動が制約を受ける中"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "一方で、米価下落や水揚げ量の減少といった農林水産業を取り巻く厳しい環境"@ja.
<< kg:id_12 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "一方で、米価下落や水揚げ量の減少といった農林水産業を取り巻く厳しい環境"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "さらに、公共施設の維持管理費用の増嵩など、本市の財政運営は一層厳しさを増しています。"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "人口減少が進む中、コロナ禍からの脱却を目指して果敢なチャレンジが求められる令和４年度となります。"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "分かりやすく正確な情報を迅速に発信するツールとして、酒田市デジタル変革戦略に基づき、ウェブ上で市民一人一人の属性に合わせた情報のやり取りを可能とする市民マイページの開発を行う"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "多様化する地域課題を解決するため、市民のワークショップで抽出した地域課題を、デジタル技術を活用して産官学民の協働により解決につなげる酒田リビングラボの取組を進めます。"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "公益活動団体から提案を受けたフードロス削減、障がい者アート普及、子育ての不安を持つ人に寄り添う支援の３つの行政課題については、新たな市民協働・公益活動推進制度の協働事業として取り組みます。"@ja.
<< kg:id_23 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "公益活動団体から提案を受けたフードロス削減、障がい者アート普及、子育ての不安を持つ人に寄り添う支援の３つの行政課題については、新たな市民協働・公益活動推進制度の協働事業として取り組みます。"@ja.
<< kg:id_24 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "公益活動団体から提案を受けたフードロス削減、障がい者アート普及、子育ての不安を持つ人に寄り添う支援の３つの行政課題については、新たな市民協働・公益活動推進制度の協働事業として取り組みます。"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "令和４年度は、市民サービスの質の向上に向け、民間事業者が提案する内容の具体化に取り組みます。"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地域で活躍するデジタル人材を育成するため、東北公益文科大学と連携し、データサイエンス、ビッグデータ解析などに関する履修証明プログラムに支援します。"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "今後、18歳以下の人口が減少していく中で、学生の確保が一段と厳しくなることが予想されています。"@ja.
<< kg:id_31 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "大学が存続していくためにも、設置者である山形県と庄内２市３町が連携して早期の公立化に向けて取り組みます。"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "いじめや不登校などをはじめとする児童生徒指導上の課題は、ますます複雑化しています。"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "専門家への相談体制を整えるなど、課題に迅速かつ適切に対応していきます。"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "教育相談、不登校児童生徒への支援については、適応指導教室及び教育相談室に教育相談専門員を、小中学校にスクールカウンセラー及び教育相談員を配置することにより、体制の充実を図ります。"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "さらに、教育支援員50名体制を維持し、特別な支援を必要とする児童生徒一人一人のニーズに応じた指導体制に努めます。"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "児童生徒一人一人に整備したＧＩＧＡスクール端末を効果的に活用するため、より個別最適化された学習を行うことができる学習ソフトや協働学習支援ツールを導入します。"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "老朽化が著しい酒田市学校給食共同調理場については廃止を見据え、令和６年度の完成を目指して南平田小学校へ新たに給食室を整備します。"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "令和３年３月に国史跡に指定された山居倉庫を次世代に継承するため、山居倉庫保存活用計画を策定するとともに、史跡等指定地の公有化を目指します。"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "令和４年５月５日に新しい中央図書館が開館し、８月１日に酒田駅前交流拠点施設ミライニがグランドオープンします。市民の多様な活動及び学習の場を提供し、交流の促進とにぎわいの創出を図ります。"@ja.
<< kg:id_48 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "子供の体力向上を図るため、東北公益文科大学や酒田市スポーツ少年団と連携し、スポーツチャレンジ支援事業に取り組みます。"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "今後どのような整備の在り方が考えられるかなど、関係団体や施設を利用する競技団体などで構成する（仮称）酒田市体育施設整備懇談会を立ち上げ、意見を伺うことにしています。"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "山形県商工業振興資金融資制度の地域経済変動対策資金の利子及び保証料を補給し、コロナ禍の影響を受けた中小企業者及び小規模事業者の資金繰りを支援します。"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "また、本市独自の元気な小規模事業者持続化特別助成金の支給など、引き続き小規模事業者の支援に努めます。"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "企業の新規立地及び事業拡大を促進するため、用地取得助成金の適用要件を拡充するとともに、設備投資促進助成金、賃借型立地企業定着促進助成金などを支給し、新たな雇用を創出します。"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "また、シェアオフィスを整備する民間事業者を支援し、情報通信関連業種などのサテライトオフィスを設置する事業者の誘致に努めます。"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "重要港湾酒田港の機能強化を進め、一層の利用促進を図るため、港湾整備に係る費用の一部を負担するとともに、本市と山形県など関係機関で組織するプロスパーポートさかたポートセールス協議会において、助成制度の拡充や新規航路の誘致に向けた検討に取り組み、荷主の増加を図ります。"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "2050年カーボンニュートラルの実現に貢献するため、再生可能エネルギーの導入により地域経済の好循環を実現する再生可能エネルギー循環都市の形成を目指します。"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "併せて、洋上風力発電事業の拠点となる基地港湾の指定と、次世代エネルギーの導入を見据えた酒田港カーボンニュートラルポートの形成に向けて、国・山形県、地元企業と連携して進めます。"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "若者の早期離職防止及び地元定着促進のため、市内高等学校の生徒及び山形県立産業技術短期大学校庄内校の学生などを対象とした市内企業見学ツアーを実施し、酒田で働きたい若者と人材を確保したい市内企業をつなぎます。"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "さらに、市内企業が必要な人材を確保できるよう、地元の民間就職情報サイトを活用して採用する場合の費用を支援するとともに、酒田市無料職業紹介所のマッチング支援により本市へのＵＩＪターン就職を促進します。"@ja.
<< kg:id_70 prop:cause kg:id_71 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "基幹作物である米については、コロナ禍の影響により米価は下落基調にあるため"@ja.
<< kg:id_70 prop:effect kg:id_72 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "米価は下落基調にあるため、主食用米から一層の作付転換が求められています。"@ja.
<< kg:id_70 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "耕種農家が、今年新たに稼働する大規模畜産農家へ飼料作物を供給するとともに、畜産農家の堆肥や液肥を活用する耕畜連携の仕組みを新たに構築し、土づくりを行いながら地域で資源が循環する持続可能な農業を推進します。"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "農村の高齢化や混住化によって地域の農地管理体制が弱体化し"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "加えて近年の気象変動による豪雨災害の多発化で土地改良施設管理費も増大傾向にあります。"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "とりわけ最上川下流右岸地区の農業水利施設の老朽化が著しいことから"@ja.
<< kg:id_80 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "新たに設立した最上川下流右岸地区土地改良事業促進協議会の活動を展開するほか、土地改良事業の推進に力を入れていきます。"@ja.
<< kg:id_82 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "森林経営管理制度に基づき、本市が森林所有者と林業経営者をつなぐことにより、経営や管理が適切に行われていない森林の活用を図ります。"@ja.
<< kg:id_84 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "森林環境譲与税を活用し、山形県と庄内の２市２町が立木密度分布図など森林資源の状況を多面的に把握できる航空レーザ測量に共同で取り組みます。測量成果に基づき、森林境界の明確化を図り、林業の成長産業化と森林の適切な管理に向けた取組を加速させます。"@ja.
<< kg:id_86 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "いかのまち酒田戦略会議を中心として、活イカのブランド化に取り組むなど、いかのまち酒田の知名度向上を図ります。"@ja.
<< kg:id_88 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "イカ釣り船団出航式において、著名な料理人などを招いた交流事業の実施により、本市農林水産物を全国に発信し、大都市圏への販路拡大につなげます。"@ja.
<< kg:id_90 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "新規漁業就業者の確保及び漁業者の育成のため、引き続き漁船や機材の整備について支援し、経営基盤の強化を図ります。"@ja.
<< kg:id_92 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "子育て世代などをターゲットに、暮らし体験、移住相談、移住費用への補助、移住後のフォローアップ、ウェブサイト上でのディスプレー広告を活用した情報発信など、移住を検討する相談者の状況に応じた施策を展開します。"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "消防署跡地において公民連携による移住者向け住宅と地域交流拠点の整備を進め、まちづくり活動などに参加意欲の高い人材の移住を促進します。"@ja.
<< kg:id_96 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "観光振興については、（仮称）酒田ＤＭＯを設立し、酒田市中長期観光戦略に掲げる本市の特色を生かしたプロモーション、今後の回復が期待されるインバウンドや教育旅行の誘致、鳥海山・飛島ジオパークや北前船日本遺産など自然資源や歴史・文化資源を絡めた体験型観光の推進など、コロナ禍後の交流人口の拡大と稼ぐ観光地域づくりに向けた戦略的な取組を進めます。"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "都市間交流については、秋田市との交流をさらに促進するため、子育て世代の親子が秋田市大森山動物園を無料で楽しめる連携事業に取り組みます。"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "令和４年度は、受入れ再開に向けて、国の感染症予防対策ガイドラインに沿った受入れ態勢の構築と、山形県と連携しておもてなしの準備を進めます。"@ja.
<< kg:id_8 prop:effect kg:id_102 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "庄内空港については、令和３年の年間搭乗者数が約10万3,000人となり、開港した平成３年を除き過去最少を記録するなど、コロナ禍により航空需要が落ち込んだ状態が続く厳しい状況となっています。"@ja.
<< kg:id_103 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "路線の維持・拡充に向けて、庄内空港利用振興協議会を中心に、観光事業者と連携して庄内空港の利用拡大に努めます。"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "65歳未満の人口は年間で1,000人以上も減少していることから、高齢化率は令和３年12月末時点で36.5％に上昇しており"@ja.
<< kg:id_106 prop:effect kg:id_107 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "高齢化率は令和３年12月末時点で36.5％に上昇しており、地域福祉活動を支える担い手不足が大きな課題となっています。"@ja.
<< kg:id_108 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "制度や分野ごとの縦割りや、支え手、受け手という関係を超えて地域住民や地域の多様な主体が参画する地域づくりを進めるため、令和３年度末に第４期酒田市地域福祉計画を策定します。"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "コロナ禍における市民の経済的負担を軽減するため、国民健康保険財政調整基金を活用し、３年連続で国民健康保険税の税率を引き下げます。"@ja.
<< kg:id_112 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "結婚の希望をかなえるため、酒田市結婚サポートセンターによる相談対応、仲介及び婚活イベントの実施に加えて、結婚に伴う新生活に係る費用を助成します。"@ja.
<< kg:id_114 prop:countermeasure kg:id_115 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "子供を希望する夫婦が安心して不妊治療を受けることができるよう、医療保険の適用範囲を見定め、継続して助成を行います。"@ja.
<< kg:id_116 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "保育料についても、引き続き山形県と連携し、国の幼児教育・保育の無償化の対象とならない２歳児以下の保育料の負担軽減を図ります。"@ja.
<< kg:id_118 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "併せて、本市独自の対策として、はまなし学園の利用者負担の軽減を行います。"@ja.
<< kg:id_120 prop:effect kg:id_121 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "子供の数は減少していますが、共働き世帯や出産後の就労を希望する保護者は増加しており、保育所などに入所する２歳児以下の割合が高くなっています。"@ja.
<< kg:id_122 prop:countermeasure kg:id_123 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "増加するニーズへ対応できる体制を整えるため、引き続き保育人材の確保に努めます。"@ja.
<< kg:id_124 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "健康福祉部福祉課を福祉企画課へ名称変更し、新たに総合政策係を設置するなど、子供や若者に関する施策を含めた健康福祉政策の推進体制を強化します。"@ja.
<< kg:id_126 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "新型コロナウイルスワクチンの接種については、３回目の接種を実施するとともに、これから１回目、２回目の接種を受ける方も並行して対応します。"@ja.
<< kg:id_128 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "酒田看護専門学校については、新たな支援措置などを通して看護人材の確保に努めます。"@ja.
<< kg:id_130 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "生活習慣の改善に対する意識改革や、自ら健康的な活動に取り組む行動変容を促すため、健康診断結果や活動量、体重などの情報を電子記録として本人や家族が把握し、医療機関でも有効に活用できる仕組み、パーソナルヘルスレコード（ＰＨＲ）の導入に向けて検討を進めます。"@ja.
<< kg:id_132 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "令和４年度は、市民部まちづくり推進課の地域づくり支援体制を強化し、（仮称）地域コミュニティまちづくり協働指針の策定に取り組み、地域コミュニティづくりの基本理念などを地域と行政とで共有します。"@ja.
<< kg:id_134 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "老朽化した内郷コミュニティセンターについては、旧内郷小学校への移転に向けて施設の改修を進め、令和５年度中の移転を目指します。"@ja.
<< kg:id_136 prop:effect kg:id_137 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "市民１人１日当たりの家庭系ごみ排出量は、ごみ減量化の普及啓発により年々減少していますが、依然、山形県内13市の中で最も多い状況にあります。"@ja.
<< kg:id_136 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "循環型社会の実現のため、紙類資源の適正な分別や事業系ごみの減量について、酒田市公式ＬＩＮＥによるごみ分類検索や周知・啓発など、デジタル変革によるペーパーレス化の進展に合わせた施策を展開します。"@ja.
<< kg:id_139 prop:countermeasure kg:id_140 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "花と緑のまちづくりについては、市民の意識醸成に向けた講習会を再開するとともに、協力企業などと連携してフラワーバスケットの設置や剪定ボランティアの育成に取り組み、市民と民間事業者が主体となって進める活動に育てます。"@ja.
<< kg:id_141 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "災害時の情報伝達については、引き続き防災ラジオを低価格な有償貸与方式で頒布を進めます。"@ja.
<< kg:id_141 prop:countermeasure kg:id_143 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "また、防災行政無線操作卓を更新し、ホームページやＳＮＳとの情報連携を図り、防災情報の迅速な提供と災害時の要配慮者などの早期避難行動を促します。"@ja.
<< kg:id_144 prop:countermeasure kg:id_145 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "さらに、女性を対象とした防災講座を開催し、女性の視点を取り入れ、地域の共助体制を強化します。"@ja.
<< kg:id_146 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "消防本部・消防署敷地内への防災倉庫の建設や移動式エアコンなど各種防災資機材の導入を進めるとともに、これらを活用した避難所運営に関する研修を開催するなど、地域防災力の向上を図ります。"@ja.
<< kg:id_148 prop:effect kg:id_149 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "そのまま放置すれば危険となるおそれのある管理不全な空き家や空き地については"@ja.
<< kg:id_150 prop:countermeasure kg:id_151 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "自治会と連携した活動や、所有者への助言・指導により一定程度増加を抑制できています。酒田市空き家等対策計画に基づき、空き家等ネットワーク協議会と連携し、空き家の利活用の促進、危険老朽空き家などの解消・適正管理など、総合的かつ計画的に空き家対策を進めます。"@ja.
<< kg:id_152 prop:countermeasure kg:id_153 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "令和４年８月１日の酒田駅前交流拠点施設ミライニのグランドオープンに合わせて、るんるんバスなどの路線を全面的に改編します。同時に、浜中、黒森、十坂、八幡、平田の５つの地域等をデマンドタクシーの運行エリアに追加することにより、公共交通の充実を図ります。"@ja.
<< kg:id_154 prop:countermeasure kg:id_155 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "定期船とびしまについては、安全運航に努めるとともに、キャッシュレス決済を拡充し、利便性向上と新型コロナウイルス感染症の感染防止を図ります。"@ja.
<< kg:id_156 prop:countermeasure kg:id_157 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "飛島については、令和３年度に敷設した海底光ファイバケーブルの高速通信基盤を生かし、島内に公衆無線ＬＡＮのアクセスポイントを設置し、観光客の利便性や災害時などの情報収集力の向上を図ります。"@ja.
<< kg:id_158 prop:countermeasure kg:id_159 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "スマートアイランド事業の実証調査を踏まえ、情報通信技術やｅモビリティなどの新技術を導入し、労働力不足や買物弱者対策などの課題解決に取り組みます。"@ja.
<< kg:id_160 prop:countermeasure kg:id_161 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "さらに、飛島の拠点施設として改修したとびしまマリンプラザでは、新たな機能として小規模店舗及び食堂・カフェを運営し、島民の日常生活の利便性向上と観光産業の振興を図ります。"@ja.
<< kg:id_162 prop:countermeasure kg:id_163 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "ＪＲ酒田駅前広場についても、利便性の高い空間として整備し、新たなまちの姿を創出します。"@ja.
<< kg:id_164 prop:countermeasure kg:id_165 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "酒田商業高等学校跡地については、活用する民間事業者を決定し、魅力とにぎわいを創出する施設として、令和６年度のオープンを目指します。"@ja.
<< kg:id_166 prop:countermeasure kg:id_167 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "旧清水屋エリアを核とした中心市街地再生協議会において、民間主導で再生の方向性が検討されていることから、再生事業が進むよう支援をします。"@ja.
<< kg:id_168 prop:countermeasure kg:id_169 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "日本海沿岸東北自動車道、地域高規格道路新庄酒田道路の早期整備について、地域を挙げて国・山形県に働きかけます。"@ja.
<< kg:id_170 prop:effect kg:id_171 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "新型コロナウイルス感染症拡大の影響により、鉄道事業者を取り巻く経営環境は非常に厳しい状況となっています。"@ja.
<< kg:id_172 prop:countermeasure kg:id_173 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "通学や通勤で利用されている方が利用しやすいダイヤの確保などについて、鉄道事業者に要望していきます。"@ja.
<< kg:id_174 prop:countermeasure kg:id_175 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "市街地で頻発する浸水被害の解消を図るため、道路施設の改修を行います。また、老朽化した京田ポンプ場の受電設備を更新するとともに、家際雨水ポンプ場の電気設備の大規模改修に着手するなど、計画的な更新を行います。"@ja.
<< kg:id_176 prop:countermeasure kg:id_177 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "水道事業については、庄内地方でのライフラインの安定した経営を確保するため、山形県庄内広域水道用水供給事業と、本市、鶴岡市及び庄内町が運営する末端給水事業との垂直・水平統合の実現を山形県に粘り強く要望します。"@ja.
<< kg:id_178 prop:countermeasure kg:id_179 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "下水道事業については、令和２年度に90％に到達した水洗化率のさらなる向上や経費節減など経営の効率化に努めます。"@ja.
<< kg:id_180 prop:countermeasure kg:id_181 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "行政のデジタル変革を進め、「ウェブで完結、酒田市の手続」を目標に行政手続のオンライン化を進めます。"@ja.
<< kg:id_182 prop:countermeasure kg:id_183 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "マイナンバーカードについては、休日申請窓口の開設や、企業・団体への出張による申請受付を行い、その普及に努めるとともに、健康保険証利用や電子証明書利用の周知に努め、利用拡大を図ります。"@ja.
<< kg:id_184 prop:countermeasure kg:id_185 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "市職員の労働生産性の向上を図るため、スマートワークの導入を推進します。"@ja.
<< kg:id_25 prop:countermeasure kg:id_186 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "必要な人材の育成・確保を目的とした人事制度の見直しに取り組み、限られた人的資源を有効に活用して市民サービスの質の向上を図ります。"@ja.
<< kg:id_187 prop:countermeasure kg:id_188 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "また、文書管理システムの導入によりペーパーレス化を推進するとともに、業務効率化及び庁舎内スペースの有効活用を図ります。"@ja.
<< kg:id_189 prop:cause kg:id_190 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "本市の財政は、恒常的に歳出の水準が歳入の水準を上回る構造となっており、予算編成は毎年度極めて厳しい状況にあります。"@ja.
<< kg:id_191 prop:effect kg:id_192 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "このような基金の取崩しに依存した財政運営は限界を迎えつつあります。"@ja.
<< kg:id_193 prop:countermeasure kg:id_194 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "令和４年度の予算編成については、実施すべき行政サービスの将来的な維持に向け、事業や経費の取捨選択を行いました。"@ja.
<< kg:id_193 prop:countermeasure kg:id_195 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "また、本市が実施するイベントについては必要最低限の予算とし"@ja.
<< kg:id_193 prop:countermeasure kg:id_196 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "各団体への負担金についても繰越金の状況を踏まえて一部削減を実施しています。"@ja.
<< kg:id_193 prop:countermeasure kg:id_197 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "さらに、負担金や補助金のみの事業であったものは他事業への統合を実施しています。"@ja.
<< kg:id_198 prop:countermeasure kg:id_199 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "地域創生部交流観光課のふるさと納税担当を係に位置づけ、新たにふるさと納税係を設置し、ふるさと納税による寄附金獲得などの積極的な取組を強化します。"@ja.
<< kg:id_198 prop:countermeasure kg:id_200 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "さらに、未利用財産の売払いや風力発電事業の売電収益など、歳入確保にも精力的に取り組みます。"@ja.
<< kg:id_198 prop:countermeasure kg:id_201 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "さらに、未利用財産の売払いや風力発電事業の売電収益など、歳入確保にも精力的に取り組みます。"@ja.
<< kg:id_202 prop:countermeasure kg:id_203 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "将来の公共施設の維持に向けた財源確保のための新たな基金を設けるなど、今後の財政運営に資する財政基盤の確立に努めます。"@ja.
}
