<< kg:id_186 prop:cause kg:id_187 >>
    prop:text-txt_contents "今回の補正は、主に歳入の増加や決算見込み等により生じた財源の基金への積立て"@ja.
<< kg:id_186 prop:cause kg:id_188 >>
