<< kg:id_174 prop:cause kg:id_175 >>
    prop:text-txt_contents "庄内砂丘地区農村地域防災減災事業及び備畑地区経営体育成基盤整備事業が完了したことに伴い"@ja.
<< kg:id_174 prop:cause kg:id_176 >>
