kg:st_1 rdfs:label "多くの専門家"@ja.
kg:st_1 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_1 prop:content "若い人特に女性の流出が人口減少の原因と指摘"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "若年流出により地域の婚姻数が減ると指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "出生数減少が人口減少の要因と指摘"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "矢口明子市長"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "全ての市民が働ける環境整備で生産年齢人口減少を補うべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "人口減少下でも安心して暮らせる仕組みづくりが必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "人口減少下でも市民の幸せを実現する市政を目指す"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "人口減少を緩やかにするため市民所得向上を重点化"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "若者が就きたい仕事をつくり人口減少抑制を図る"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "外貨獲得で地域経済を強化し人口減少対策につなげる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "ローカルSDGsの推進を重点化する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "産業基盤インフラ整備で人口減少対策を進める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "全ての市民が働ける環境整備を進める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "多様な市民が活躍できる支援を行う"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "保育介護制度を充実し就労継続を支える"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "ジェンダー平等意識の啓発を進める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "機械化とデジタル変革で人手不足を補う"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "移住定住と関係人口の増加に取り組む"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "人口減少下でも豊かに安心して暮らせるまちを目指す"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "多様な当事者の意見を施策に反映する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "若者カフェミーティングで若者の声を市政に反映する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "大学存続のため早期公立化を進める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "猛暑時の登下校安全のためスクールバスを運行する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "特別教室へのエアコン設置を進める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "支援充実のためスクールソーシャルワーカーを増員する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "教育と福祉の連携を強化し子ども支援を充実させる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "屋内スケート施設の本市設置を県に要望する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "県要望実現まで仮設リンク設置の調査を進める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "若い世代や民間事業者を資金面で支えるコミュニティファンドを創設する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "IT企業集積と地元就職促進のため助成を拡充する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "多様な人材雇用と業務改善のセミナーを開く"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "働きやすい職場づくりに取り組む企業を支援する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "若手農業者支援で人材の呼び込みと定着を図る"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "オーガニックビレッジ宣言で持続可能な農業を進める"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "交付金を活用し循環型農業の環境整備を進める"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "高温と少雨が松くい虫被害増大の要因"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "倒木被害が農業施設で頻発している"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "伐倒駆除と薬剤防除で被害拡大を防ぐ"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "県外漁船誘致でスルメイカ水揚げ量確保を図る"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "子育て世代向けに移住情報発信を強化する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "移住後の暮らしをイメージできるツアーを行う"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "本市出身者との関係を深め関係人口を広げる"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "酒田DMO中心に戦略的プロモーションで誘客を進める"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "教育旅行誘致で観光消費額増加を図る"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "鉄道も活用しインバウンド向け発信とツアー造成を進める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "複雑化した相談に対応する福祉総合相談窓口を設置する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "障がい者への総合的専門的相談支援のためセンターを設置する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "孤独孤立は様々な要因で引き起こされる"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "ひきこもり当事者や家族を支える団体活動を支援する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "民生委員児童委員確保のため活動費を引き上げる"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "地域包括支援センターの体制強化を進める"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "基金活用で介護保険料基準月額を引き下げる"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "家事シェアと省力化でケア労働負担の軽減を図る"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "共生社会課を新設し相互理解の増進を図る"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "メタバース婚活で独身男女に出会いの機会を提供する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "訪問支援事業の活用を促し家事育児支援を強化する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "物価高騰下でも給食費の保護者負担を据え置く"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "ひとり親家庭や低所得世帯の利用負担を軽減する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "経済状況で進学を諦めないよう受験費用を支援する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "模擬試験費用支援で進路機会を確保する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "有識者会議を設置し自殺対策施策を強化する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "医療介護連携DXを支援し必要なサービス体制を構築する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "看護学生支援を継続し市内就業を促進する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "民間サービス情報を整理し買物弱者に分かりやすく発信する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "温暖化対策実行計画を策定し取組を促進する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "ローカルSDGs推進室を新設し取組を促す"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "地域猫活動への助成で猫の繁殖抑制と生活環境改善を図る"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "避難者対応を検証し配置や備蓄を見直す"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "複数メディアへ一斉配信できるシステムで災害対応を強化する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "待遇改善で消防団員数を確保し防災体制を維持する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "管理不全な空き家は生活環境と財産に悪影響を及ぼす"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "財産管理人制度活用で老朽危険空き家の解消を進める"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "旧耐震空き家解体と新築支援で耐震化を促進する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "条例制定と窓口設置で犯罪被害者支援を行う"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "高齢化で大型獣類捕獲従事者が減少している"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "箱わなセンサー拡充で従事者負担を軽減する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "狩猟免許取得助成で免許保持者を増やす"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "利用実態把握のため高校生などへ調査を行う"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "交通政策顧問を配置し公共交通の維持拡充を図る"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "利用者ニーズを踏まえ船舶更新調査を始める"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "大雪で飛島地区に倒木が発生した"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "道路や避難路の安全確保のため倒木除去を行う"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "高速道路の早期開通を国と県に働きかける"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "新庄酒田道路の事業化を働きかける"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "駅東広場整備と駐輪場更新で利便性を高める"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "観光バス駐車場整備でいろは蔵パークへの誘客につなげる"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "公共機関集約を含めたまちづくりを官民連携で進める"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:op_87 prop:content "さかたコンポの機能拡充でオンライン市役所を進める"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_2.
kg:op_88 prop:content "水道広域化企業団の設立と事業開始を目指す"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_2.
kg:op_89 prop:content "垂直統合の早期実現へ県と協議を進める"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_2.
kg:op_90 prop:content "下水道施設係新設で統廃合を進める"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
kg:op_91 prop:content "老朽化で補修を要する道路橋が急増している"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_2.
kg:op_92 prop:content "跨線橋の補修を進める"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_2.
kg:op_93 prop:content "公共住宅長寿命化計画更新で維持管理費を縮減平準化する"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_2.
kg:op_94 prop:content "公園の松くい虫被害拡大防止のため伐倒駆除を継続する"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_2.
kg:op_95 prop:content "市民と職員双方に優しい窓口を実現するため窓口改革を進める"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_2.
kg:op_96 prop:content "コンビニ交付手数料引下げで利便性を高める"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_2.
kg:op_97 prop:content "市民意見を踏まえて公共施設再編に取り組む"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_2.
kg:op_98 prop:content "人事制度改革室を新設し制度全般の改革を進める"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_2.
kg:op_99 prop:content "事業見直しやデジタル化で総人件費抑制に努める"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_2.
kg:op_100 prop:content "統計係設置でデータに基づく政策立案を強化する"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_2.
kg:op_101 prop:content "ふるさと納税や広告収入未利用財産売却で歳入確保を図る"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "このような急激な人口減少の原因は、若い人、特に男性よりも女性のほうが多く都会に出て行くことにより"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "地方都市、つまりその地域における婚姻数が減り"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "生まれる子どもの数が減っていることであると多くの専門家から指摘されています"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "第二に、生産年齢人口の減少を補うために、働きたいと考える全ての市民が働くことのできる環境を整備することです"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "人口が減少したとしても安心して地域コミュニティで暮らせる仕組みを整えることに取り組みます"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "第四に、人口減少下においても、市民の幸せ（ウェルビーイング）を実現する酒田市にすることです"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "第一に、人口減少を緩やかにするために、市民所得の向上を図ることです"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "具体的には、産業を振興し、若い人が就きたいと思うような仕事を創出すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "観光や移輸出など外貨を獲得すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "ローカルＳＤＧｓに資すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "産業の基盤となるインフラを整備することなどに取り組みます"@ja.
<< kg:id_5 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "第二に、生産年齢人口の減少を補うために、働きたいと考える全ての市民が働くことのできる環境を整備することです"@ja.
<< kg:id_5 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "男性だけでなく女性も、高齢者も、障がいのある方も、外国籍の方も、社会で活躍できるよう支援すること"@ja.
<< kg:id_5 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "仕事と家庭の両立を可能にする保育・介護などの制度を充実させ"@ja.
<< kg:id_5 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "ジェンダー平等意識を啓発すること"@ja.
<< kg:id_5 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "機械にできる仕事は機械に任せ、人間は人間にしかできない仕事に専念するためのデジタル変革を進めること"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "移住者・定住者や関係人口を増やすことなどに取り組みます"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "第三に、人口が減少したとしても、豊かに安心して暮らせるまちを創ることです"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "若者・女性・障がい者などの意見を施策に反映すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "若者の意見を市長が直接聴く場として、若者カフェミーティングを開催し、施策に若者の意見を反映していきます"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "東北公益文科大学を存続させるため、設立団体である山形県、庄内２市３町が協力し、早期の公立化に向けた取組を進めます"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "夏の猛暑下における登下校時の安全確保のためスクールバスを運行するとともに"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "小中学校の特別教室へのエアコン設置を計画的に進めます"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "スクールソーシャルワーカーを１名増員し、家庭環境などに問題を抱える子どもに対し適切な支援が行き届くよう"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "教育、福祉部門の連携を強化します"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "屋内スケート施設については、山形県に対して、本市への設置を粘り強く要望します"@ja.
<< kg:id_32 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "山形県への要望が実現するまでの間、暫定的に利用できる仮設リンクを低コストで設置する施設の調査を進めます"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "地域課題の解決などに取り組む若い世代や民間事業者を資金面でサポートするコミュニティファンドを創設します"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "地元就職を促進するため、情報サービス業などの賃借型立地を誘導する助成金を拡充するとともに"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "地元企業の人材確保と労働生産性の向上等を図るため、若者、高齢者、障がい者、外国人の雇用や業務改善などに関する企業向けセミナーを開催します"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "誰もが働きやすい職場づくりに取り組む市内企業に対して、酒田市一般事業主行動計画策定奨励金を支給するなどの支援を引き続き行います"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "本市への人材の呼び込みと定着を図るため、経営開始資金などを助成します"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "オーガニックビレッジ宣言を行うとともに"@ja.
<< kg:id_45 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "みどりの食料システム戦略推進交付金を活用し、持続可能な循環型農業の実現に向けた環境整備を行います"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "夏季の高温や少雨の影響により松くい虫被害が増大し"@ja.
<< kg:id_48 prop:effect kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "ビニールハウスなど農業施設への倒木被害が頻発していることから"@ja.
<< kg:id_48 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "伐倒駆除及び薬剤防除により被害の拡大を防止します"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "県外漁船の誘致によるスルメイカの安定的な水揚げ量確保をはじめ"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "子育て世代をターゲットとして、移住に関する情報発信を強化するとともに"@ja.
<< kg:id_54 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "子育て世帯が本市での暮らしをイメージできるようなツアー事業を実施します"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "本市出身者等とつながりを持ち、その関係性を深めることにより、まちづくりに参画できる戦略・仕組みをつくります"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "一般財団法人酒田ＤＭＯが観光地域づくりの中心となり、マーケティングに基づく戦略的なプロモーションや地域資源を活用した観光プログラムによる誘客"@ja.
<< kg:id_59 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "国内外からの教育旅行の誘致など、観光消費額を増加させる取組を進めます"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "インバウンド向けの情報発信、プロモーション及びツアー造成等に取り組み、鉄道を活用したインバウンド誘客を推進します"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "福祉総合相談窓口は、相談内容の複雑化や複合化に対応するため、包括的な支援体制の充実を図るものです"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "基幹相談支援センターは、障がい者への総合的・専門的な相談支援の実施や障がい者の権利擁護・虐待の防止、相談機関との連携強化などを担います"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "様々な要因によって引き起こされる社会的な孤独や孤立"@ja.
<< kg:id_68 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "ひきこもりの状態にある方やその家族からの相談や居場所づくりに取り組む団体の活動を支援します"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "民生委員・児童委員の充足を図るため、１人当たりの活動費を引き上げます"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "高齢者が住み慣れた地域で安心して生活を継続できるよう、日常生活圏域を単位とした地域包括支援センターの体制や機能の強化に向けて、地域や事業者との話合いを進めます"@ja.
<< kg:id_75 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "介護給付費準備基金を活用して、第８期に続き、２期連続で基準月額を引き下げます"@ja.
<< kg:id_77 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "家事シェア及び家事の省力化につながる取組を行い、家庭における家事・育児などのケア労働の負担軽減を図ります"@ja.
<< kg:id_79 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "市民部に新たに設置する共生社会課で一体的に担うことにより、国籍や性別などの属性にとらわれず相互理解の増進を図り、多様性と人権を尊重する共生社会づくりを推進します"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "結婚を望む独身男女に出会いの機会を提供するため、婚活スタイルの一つとして注目されているインターネット上の仮想空間であるメタバース内で、自分の分身であるアバターを使って話しながら婚活するメタバース婚活を、山形県、庄内２市３町が連携して実施します"@ja.
<< kg:id_83 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "家事や子育てに対して不安や負担を抱えた家庭、また、妊産婦やヤングケアラー等がいる家庭を訪問し、家事や育児の支援を行う子育て世帯訪問支援事業の利用を勧めるなど支援を強化します"@ja.
<< kg:id_85 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "子育て世帯の負担を軽減するため、物価高騰対応重点支援地方創生臨時交付金を活用し、小中学校の給食費に係る保護者負担額を据え置きます"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "ファミリー・サポート・センターでは、ひとり親家庭や低所得世帯などの料金負担を軽減します"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "家庭の経済状況により大学等への進学を諦めることなく、子どもが将来の目標に向かって進めるよう、低所得世帯などを対象とした大学等の受験費用の支援"@ja.
<< kg:id_91 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "新たに中学３年生と高校３年生の模擬試験費用の支援を行います"@ja.
<< kg:id_93 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "自殺対策に関する施策をより効果的に推進するため、有識者会議を新たに設置し、その意見を施策に反映します"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "将来にわたり市民が必要な医療・介護サービスを受けられる体制を構築するため、日本海総合病院が行う医療・介護連携ＤＸ事業を支援します"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "地域医療を支える看護人材を育成するため、酒田看護専門学校の学生への支援を引き続き実施し、市内での就業を促進します"@ja.
<< kg:id_99 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "買物弱者に対する支援については、宅配などの民間事業者のサービスを整理して、分かりやすい形で情報発信します"@ja.
<< kg:id_101 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "酒田市地球温暖化対策実行計画、区域施策編を策定するとともに"@ja.
<< kg:id_101 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "企画調整課にローカルＳＤＧｓ推進室を新設し、地球温暖化防止と地域循環共生圏形成に資する取組を促します"@ja.
<< kg:id_104 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "飼い主のいない猫に不妊去勢手術を施し、元の場所に戻す活動を行う団体に対して助成を行い、猫の繁殖を抑制しながら、生活環境の改善を図ります"@ja.
<< kg:id_106 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "令和６年能登半島地震の際の本市の一連の避難者対応について検証し、避難所連絡員等の配置や防災備蓄品の整備等について見直します"@ja.
<< kg:id_108 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "緊急災害情報を複数メディアへ一斉配信できる防災情報一斉配信システムを導入し、迅速な情報伝達と効率化を図り、災害時の体制を強化します"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "消防団員の待遇を改善することにより、適正な消防団員数を確保し、防災体制の維持に努めます"@ja.
<< kg:id_112 prop:effect kg:id_113 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "地域住民の生活環境・財産に悪影響を及ぼす管理不全な空き家"@ja.
<< kg:id_112 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "財産管理人制度などの活用により、相続人が存在しない老朽危険空き家等の解消に努めます"@ja.
<< kg:id_115 prop:countermeasure kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "昭和56年以前に建てられた空き家の解体と住宅の新築を支援することにより、住宅の耐震化を促進します"@ja.
<< kg:id_117 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "犯罪被害者等支援条例を制定し、窓口をまちづくり推進課に設置し、犯罪被害に遭われた方の相談等の支援を行います"@ja.
<< kg:id_119 prop:cause kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "熊などの大型獣類捕獲業務の従事者については、高齢化により減少傾向にあるため"@ja.
<< kg:id_119 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "箱わなセンサーの拡充による負担軽減に加え"@ja.
<< kg:id_119 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "狩猟免許取得などへの助成を行い、免許保持者を増やすことにより、有害鳥獣の捕獲体制を強化します"@ja.
<< kg:id_123 prop:countermeasure kg:id_124 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "地域公共交通の維持、拡充を図るため、高校生などを対象にアンケート調査を実施するとともに"@ja.
<< kg:id_123 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "公共交通について識見を有する交通政策顧問を配置します"@ja.
<< kg:id_126 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "定期船とびしまについては、利用者のニーズを踏まえ、船舶の更新に向けた調査を開始します"@ja.
<< kg:id_128 prop:cause kg:id_129 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "令和５年12月の大雪により発生した飛島地区の倒木"@ja.
<< kg:id_128 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "飛島地区の倒木を除去し、道路や遊歩道、避難路などの安全を確保します"@ja.
<< kg:id_131 prop:countermeasure kg:id_132 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "日本海沿岸東北自動車道の遊佐象潟道路及び朝日温海道路の早期開通...国及び山形県に働きかけます"@ja.
<< kg:id_131 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "みちのくウエストラインを構成する新庄酒田道路の高屋～草薙間と立川～余目間の事業化に向けて、国及び山形県に働きかけます"@ja.
<< kg:id_134 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "駅東広場の整備を行い、駐輪場の更新など、駅周辺の利便性の向上を図ります"@ja.
<< kg:id_136 prop:countermeasure kg:id_137 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "観光バス駐車場を整備し、誘客につなげます"@ja.
<< kg:id_138 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "公共機関などの集約を含めたまちづくりの方向性を官民連携してデザインしていきます"@ja.
<< kg:id_140 prop:countermeasure kg:id_141 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "さかたコンポについては、道路水位情報の自動配信などの機能を拡充し、利用者の増加を図ります"@ja.
<< kg:id_142 prop:countermeasure kg:id_143 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "本市、鶴岡市及び庄内町が運営する末端給水事業による企業団の令和７年度設立、令和８年度事業開始を目指し、作業を進めます"@ja.
<< kg:id_142 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "山形県庄内広域水道用水供給事業との垂直統合の早期実現に向けて、県との協議を進めます"@ja.
<< kg:id_145 prop:countermeasure kg:id_146 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "工務課下水道施設係を新設し、酒田市下水道事業経営戦略に基づき、施設の統廃合による経費削減と管理の効率化に取り組みます"@ja.
<< kg:id_147 prop:effect kg:id_148 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "老朽化により補修を必要とする道路橋が急速に増加している中で"@ja.
<< kg:id_147 prop:countermeasure kg:id_149 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "東泉跨線橋及び浜田跨線橋の補修を進めます"@ja.
<< kg:id_150 prop:countermeasure kg:id_151 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "酒田市公共住宅長寿命化計画を更新し、安全で快適な市営住宅などの安定的な確保や建物等の維持管理費の縮減と平準化を図ります"@ja.
<< kg:id_152 prop:countermeasure kg:id_153 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "光ケ丘公園などの松くい虫被害に対し伐倒駆除を継続し、被害の拡大防止を図ります"@ja.
<< kg:id_154 prop:countermeasure kg:id_155 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "総務省のモデル事業として窓口業務の改革に取り組み、利用する市民、事務を行う職員、双方にとって優しい市役所の窓口を実現します"@ja.
<< kg:id_156 prop:countermeasure kg:id_157 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "市民の利便性向上などを図るため、コンビニ交付サービスを利用し、住民票など５種類の証明書を取得する場合の手数料を100円引き下げます"@ja.
<< kg:id_158 prop:countermeasure kg:id_159 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "公共施設適正化懇談会を引き続き開催し、市民の意見を取り入れた上で、公共施設適正化実施方針に基づき、公共施設の再編に取り組みます"@ja.
<< kg:id_160 prop:countermeasure kg:id_161 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "人事課に新設する人事制度改革室は、採用試験、人材育成、人事配置、人事評価などの見直しや地域貢献に資する副業制度の創設など、人事制度全般に係る改革に取り組みます"@ja.
<< kg:id_162 prop:countermeasure kg:id_163 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "事業の見直し、任用形態の多様化、業務のデジタル化などにより、総人件費の抑制に努めます"@ja.
<< kg:id_164 prop:countermeasure kg:id_165 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "企画調整課に統計係を置き、データを活用した合理的根拠に基づく課題抽出、政策立案の機能を強化します"@ja.
<< kg:id_166 prop:countermeasure kg:id_167 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "個人版及び企業版のふるさと納税、ネーミングライツを含む新たな広告収入、未利用財産の売払いなどにより、歳入確保に努めます"@ja.
<< kg:id_168 prop:countermeasure kg:id_169 >>
    prop:text-txt_contents "所期の目的を達成したため、白崎資金調整基金を廃止するものであり"@ja.
<< kg:id_170 prop:cause kg:id_171 >>
    prop:text-txt_contents "所期の目的を達成したため、白崎資金調整基金を廃止するものであり"@ja.
<< kg:id_172 prop:cause kg:id_173 >>
