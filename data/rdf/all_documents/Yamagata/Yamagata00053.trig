cls:c_2135 rdfs:label "地図分かりにくさ"@ja.
kg:id_93 rdfs:label "自治体ごとに配色が異なり広域移動時に混乱すること"@ja.
kg:id_93 rdf:type cls:c_2136.
cls:c_2136 rdfs:label "表示不統一"@ja.
