<< kg:id_139 prop:effect kg:id_140 >>
    prop:text-txt_contents "新型コロナウイルス感染症拡大に伴う移動需要の大幅な減少など"@ja.
<< kg:id_140 prop:effect kg:id_141 >>
    prop:text-txt_contents "鉄道事業者を取り巻く経営環境は大変厳しい状況となっています。"@ja.
<< kg:id_141 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "羽越本線及び陸羽西線の沿線自治体と連携して、運行ダイヤの維持などを鉄道事業者に要望してまいります。"@ja.
<< kg:id_143 prop:effect kg:id_144 >>
    prop:text-txt_contents "豪雨による道路の冠水、家屋の浸水など、市民生活に不安を与える水害が発生しています。"@ja.
<< kg:id_143 prop:effect kg:id_145 >>
