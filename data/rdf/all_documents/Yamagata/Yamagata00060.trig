kg:id_180 rdfs:label "整理作業員の増員と各高校への周知"@ja.
kg:id_180 rdf:type cls:c_2896.
cls:c_2896 rdfs:label "整理体制強化"@ja.
kg:id_178 prop:countermeasure kg:id_180.
kg:id_181 rdfs:label "酒田駅前駐輪場"@ja.
kg:id_181 rdf:type cls:c_2897.
cls:c_2897 rdfs:label "駐輪場"@ja.
kg:id_182 rdfs:label "雨や雪への対策が十分でない"@ja.
kg:id_182 rdf:type cls:c_2898.
cls:c_2898 rdfs:label "雨雪対策不足"@ja.
kg:id_181 prop:cause kg:id_182.
kg:id_183 rdfs:label "駅前広場改修に合わせた屋根付駐輪場整備"@ja.
kg:id_183 rdf:type cls:c_2899.
cls:c_2899 rdfs:label "屋根整備"@ja.
kg:id_181 prop:countermeasure kg:id_183.
kg:st_1 rdfs:label "市原栄子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "カードを持たないと公的サービスを受けにくくなり実質的強要につながると危惧する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "公的サービス利用のため取得が事実上必要になることを懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "多くの情報を1枚に集約することは悪用リスクを高めると懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "標準化の押しつけは地方自治の多様性を失わせサービス低下を招くと懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "統一標準化は住民福祉の増進に逆行するおそれがあると指摘する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "住民自治団体自治の侵害につながると考える"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "情報共有のしやすさの反面で情報抑制にもなりかねないと懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_2 rdfs:label "宮崎和幸企画部長"@ja.
kg:st_2 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_8 prop:content "機能活用により独自施策を継続しつつ標準化に対応する考えを示す"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "誰一人取り残さない視点で対面とデジタルの併用を進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "利便性向上の一方で情報漏えいリスクが高まると問題提起する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "情報は集積されるほど利用価値が高まり攻撃対象になりやすいと指摘する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "一度漏れた情報は回収できず被害が深刻化すると懸念する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "個人情報漏えいはプライバシー侵害を拡大させると懸念する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "調査機関への照会保証がなく監視社会化を危惧する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "本人が知らないうちのプロファイリングやスコアリングを懸念する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "忘れられる権利や自己情報コントロール権を保障する法整備が必要と考える"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "高齢者や関係者への周知不足が受給の少なさにつながっているとみる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "申請の煩雑さが申請断念につながると指摘する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:st_3 rdfs:label "菊池裕基健康福祉部長"@ja.
kg:st_3 rdf:type cls:st_32.
kg:op_19 prop:content "より効果的な周知方法として通知時の同封を検討する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "関係機関との連携を深め申請につなげたいと述べる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "現状の住宅は高齢単身者が安全安心に暮らすには不向きと指摘する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "現行住宅では独居高齢者の居住継続が難しいと訴える"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "空きのある住宅を高齢単身者向けに転換すべきと提案する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "保証人要件は高齢者や身寄りのない人にとって高いハードルだと指摘する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "保証人確保困難が住宅セーフティーネット利用を妨げていると訴える"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:st_4 rdfs:label "藤井昌道建設部長"@ja.
kg:st_4 rdf:type cls:st_32.
kg:op_26 prop:content "高齢入居者の負担軽減のため要件緩和を行う"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "見守り体制はあるが頻度が不足していると指摘する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "見守り不足は孤独死や緊急時対応の遅れにつながると懸念する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "デジタル変革の中で市営住宅で可能な見守り対策を検討する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "少しの段差でも高齢者には大きな負担で閉じこもりを招くと指摘する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:st_5 rdfs:label "阿部秀徳議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_31 prop:content "高齢者全員分の見通しが立たず接種体制が見えにくいと問題視する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:st_6 rdfs:label "白畑真由美健康福祉部子ども・家庭支援調整監"@ja.
kg:st_6 rdf:type cls:st_32.
kg:op_32 prop:content "クラスター時の地域医療への影響を踏まえ高齢者施設入所者を優先する方針を示す"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:op_33 prop:content "副作用副反応への不安があり安心できる情報提供が必要と考える"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:op_34 prop:content "重症副反応事例も踏まえた丁寧な周知を求める"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_5.
kg:op_35 prop:content "接種しない人への風評差別を懸念する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "ホームページやLINEやツイッターや広報で差別防止を呼びかける"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:op_37 prop:content "石炭火力の縮小を踏まえ港湾機能維持の新たな柱が必要と考える"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "利用割合が低い県内内陸部や県外港利用企業への働きかけを強める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "2030年を見据えると基地港湾指定を急ぐ必要があると考える"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "着床式で沿岸近くに建てる場合は環境景観負荷が大きいと懸念する"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "効率化が周辺部切捨てにならないよう丁寧な説明が必要と考える"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:st_7 rdfs:label "矢口明子副市長"@ja.
kg:st_7 rdf:type cls:st_32.
kg:op_42 prop:content "持続可能性と利便性向上を一体的に実現するため改編する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_7.
kg:op_43 prop:content "通学通勤対応も含め運行日増便や時刻前倒しを行う"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_7.
kg:op_44 prop:content "観光路線だけでなく公共交通として存続させる強い姿勢を求める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
kg:op_45 prop:content "デスティネーションキャンペーンや臨時列車運行を生かし観光利用を増やす"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_7.
kg:st_8 rdfs:label "齋藤美昭議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_46 prop:content "ウィズコロナに対応した計画見直しや立て直しが必要と考える"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_8.
kg:st_9 rdfs:label "本間優子教育次長"@ja.
kg:st_9 rdf:type cls:st_32.
kg:op_47 prop:content "助成制度を活用しながら計画的に改修を進める方針を示す"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_9.
kg:op_48 prop:content "大会中止や練習停止がスポーツ界に大きな打撃を与えたと受け止める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_8.
kg:op_49 prop:content "子どもの発表機会が失われた影響は大きいと考える"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_8.
kg:st_10 rdfs:label "安藤浩夫議員"@ja.
kg:st_10 rdf:type cls:st_16.
kg:op_50 prop:content "役員や担い手不足により防災や支え合い活動に支障が出ていると指摘する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_10.
kg:op_51 prop:content "地域機能の維持が難しくなっていると問題意識を示す"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_10.
kg:st_11 rdfs:label "丸山至市長"@ja.
kg:st_11 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_52 prop:content "地域のことをよく知り実行を支える人材として将来の地域リーダーを期待する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_11.
kg:op_53 prop:content "外部視点で地域の価値を見いだし活性化につなげる効果を評価する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_11.
kg:op_54 prop:content "対面相談重視ではコロナ禍で相談機会が減るため新たな対応が必要とみる"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_10.
kg:st_12 rdfs:label "大沼康浩地域創生部長"@ja.
kg:st_12 rdf:type cls:st_32.
kg:op_55 prop:content "常設窓口は置かないが県やふるさと回帰支援センター主催相談会を活用する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_12.
kg:op_56 prop:content "リモートワークしながら酒田で暮らすライフスタイルを後押しする"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_12.
kg:op_57 prop:content "酒田の資源を丁寧に伝え若者向けツアーの内容も工夫する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_12.
kg:op_58 prop:content "受入れ見守りの雰囲気づくりが定住の第一歩になると考える"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_10.
kg:op_59 prop:content "地域が移住者をスムーズに受け入れられるよう市としてつなぐ役割を果たす"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_12.
kg:st_13 rdfs:label "佐藤伸二議員"@ja.
kg:st_13 rdf:type cls:st_16.
kg:op_60 prop:content "社会的要因で人口減少が進み地域振興策が一層必要とみる"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_13.
kg:st_14 rdfs:label "大谷謙治市民部長"@ja.
kg:st_14 rdf:type cls:st_32.
kg:op_61 prop:content "新たな過疎計画でも基本方向は変わらないと説明する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_14.
kg:op_62 prop:content "移住者が地域への刺激となり人口流出の歯止めになることを期待する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_14.
kg:op_63 prop:content "竹林整備は通行支障や有害獣対策にも重要だと考える"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_13.
kg:op_64 prop:content "熊の出没抑制にも竹林整備とタケノコ活用が有効とみる"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_13.
kg:op_65 prop:content "子どもの記憶に残る景観づくりや観光資源化にもつながると提案する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_13.
kg:st_15 rdfs:label "後藤仁議員"@ja.
kg:st_15 rdf:type cls:st_16.
kg:op_66 prop:content "コロナ禍でやむを得ない財政出動だが一抹の不安があると述べる"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_15.
kg:st_16 rdfs:label "田中愛久総務部長"@ja.
kg:st_16 rdf:type cls:st_32.
kg:op_67 prop:content "一定程度の蓄えが安定的財政運営に必要と説明する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_16.
kg:op_68 prop:content "基金を早期投入したPayPay施策は地域経済に大きな効果があったと評価する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_15.
kg:st_17 rdfs:label "竹越攻征農林水産部長"@ja.
kg:st_17 rdf:type cls:st_32.
kg:op_69 prop:content "若者や移住者のニーズに合った一滴の目薬のような施策を重ねる考えを示す"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_17.
kg:op_70 prop:content "貧困が次世代に連鎖しない教育環境を酒田で担保してほしいと求める"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_15.
kg:st_18 rdfs:label "村上幸太郎教育長"@ja.
kg:st_18 rdf:type cls:st_51.
cls:st_51 rdfs:label "教育関係者"@ja.
kg:op_71 prop:content "背景を含めて子どもを理解し寄り添う学校づくりが必要と考える"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_18.
kg:op_72 prop:content "日本海を震源とする大地震から海に面した酒田の子どもを守ることを重視する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_18.
kg:op_73 prop:content "子どもが育つ学級づくりを支える仕組みとして有効と考える"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_18.
kg:op_74 prop:content "暗記型だけでなく考える力伝える力を育てる学力向上を進める"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_18.
kg:op_75 prop:content "生徒指導と学力向上を9年間の義務教育全体で進める必要があると考える"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_18.
kg:op_76 prop:content "小さくなった学校から順番でなく市全体を俯瞰して検討すべき時期に来ている"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_18.
kg:op_77 prop:content "地域住民は甚大な被害を受け浸水対策強化を強く求めている"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_15.
kg:op_78 prop:content "当事者は雨のたび眠れない不安を抱えており対策を急ぐべきと訴える"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_15.
kg:op_79 prop:content "市民の安心につながる支援策の第一歩として検討する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_4.
kg:op_80 prop:content "以前は駐輪場の景観が良くない時期があったと指摘する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_15.
kg:op_81 prop:content "景観を損なわないようきれいに整頓される体制を整える"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "高校生のためにも屋根付き駐輪場が必要と考える"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_15.
kg:op_83 prop:content "景観や動線や利便性を考慮し国補助も活用して整備を進めたい"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今後運転免許証や各種免許、国家資格、自治体検診などの健康管理サービスなど、多くのサービスとの連携を進めるとしています"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "マイナンバーカードを持たないと公的なサービスを含めた様々なサービスが受けられない状況をつくり出し、実質的にカード取得を強要することになるではないかと危惧するものであります"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "多くの情報が１枚のカードでできることは、逆に他者から悪用される危険もはらんでいるのではないでしょうか"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "マイナンバーカードの取得申請や交付時において、カードの管理方法などを記しました案内チラシをお配りをさせていただきながら、カードの取扱いには、本当に十分に注意していただくことをお伝えしているところでございます。万が一カードを紛失した場合には、カードをいつでも無効化できるフリーダイヤルの番号も併せてお知らせしているところでございます"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "自治体クラウドによって、システムに行政の仕事内容を合わせることが目的となり、自治体独自のサービスが抑制されてしまうのではないかと危惧するものです"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "このような自治体への統一・標準化の押しつけは、サービス低下を引き起こし、地方自治の多様性をなくし、自治体の自主性を失わせるものではないでしょうか"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "地方自治の多様性をなくし、自治体の自主性を失わせるものではないでしょうか。これは、住民の福祉の増進を図ることを基本とした地方自治体の住民自治・団体自治を侵害するものであります"@ja.
<< kg:id_7 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "システムの統一で情報共有がしやすくなるとも言っていますが、実際には、情報抑制にもなりかねません"@ja.
<< kg:id_7 prop:effect kg:id_12 >>
    prop:text-txt_contents "システムの標準化には、そういった業務を共通化することによって職員の事務負担の削減、システム調達費用の低減、プログラムの安定化、法改正への短時間での対応、さらには複数自治体での共同利用による運営経費の低減などのメリットがございます"@ja.
<< kg:id_7 prop:effect kg:id_13 >>
    prop:text-txt_contents "システムの標準化には、そういった業務を共通化することによって職員の事務負担の削減、システム調達費用の低減、プログラムの安定化、法改正への短時間での対応、さらには複数自治体での共同利用による運営経費の低減などのメリットがございます"@ja.
<< kg:id_7 prop:effect kg:id_14 >>
    prop:text-txt_contents "窓口の待ち時間短縮や手続に係る作業量の減少などによりまして、市民にとっても様々なメリットが生じるものと思っているところでございます"@ja.
<< kg:id_7 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "こういった機能を活用するなどして、独自施策の展開も継続しながら、システムの標準化、効率化等を図ってまいりたいと考えてございます"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本市としては、対面により高い成果を得られるものにつきましては、対面のまま残し、それからオンラインを望む方に対しましては、デジタル技術を活用した対面を行う併用型、これを一つの酒田モデルといたしまして、一人一人のニーズに合った行政サービスを提供してまいりたい"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "議員御指摘のとおり、社会のデジタル化が進み利便性が向上する一方で、個人情報漏えいの危険性が高まっているのではないかといったことが懸念されております"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "情報は集積されるほど利用価値が高まり、攻撃されやすくなると言われています"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "一度漏れた情報は流通・売買され、取り返しがつきません"@ja.
<< kg:id_22 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "プライバシー侵害のおそれが高まることになるのです"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "これらの個人データが調査機関へ照会されない保証はなく、監視社会へ導く危険性もあります"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "本人の知らないところでやり取りされ、プロファイリングやスコアリングされ、本人に不利益な使い方をされる懸念もあります"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "だからこそ、個人情報保護のルールを強化する必要があるのではないでしょうか"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "この制度は高齢で介護認定を受けていても、また障害者手帳を持っていなくても受けられる制度であるということがあまり知られていないという状況です"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:text-txt_contents "所得制限もあり、手続も煩雑であることから途中で諦めてしまう"@ja.
<< kg:id_30 prop:cause kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "手続も煩雑であることから途中で諦めてしまう、このような事例が全国で出ていると言われています"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "例えば、要介護認定の通知の際に特別障害者手当の該当要件のお知らせ、チラシなどを同封するなど、より効果的な方法を検討してまいりたい"@ja.
<< kg:id_34 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "介護保険課、あるいは医療関係、これも福祉と一緒になって関係機関と連携して周知に努めてまいりたいと思いますし、ありましたケアマネジャーにつきましても、我々のほうで連絡協議会等を開催しておりますので、そういった機会を捉えまして、改めて御利用いただくような制度の周知に努めていきたい"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "多くが古いメゾネット、昔は長屋タイプと言っておりましたが、こういったタイプであり、２階建てで、１階はダイニングキッチンと風呂場、寝室は２階というふうな間取りになっています。風呂場も旧式であり、バリアフリーという概念からは程遠い"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "このタイプでは、高齢者が１人で安全に安心して暮らしていくには無理がある"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "１階などのバリアフリー化を進めて単身高齢者向けへ変更し、入居を進めていくべきではないかと考えます"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "本市では入居に当たり、酒田市在住の連帯保証人を２人立てることになっています。この酒田市在住２人、このハードルが高い"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "保証人が見つからずに、居住を諦めたというお話も聞いています"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "令和３年度からは県営住宅と同様に原則２名とした上で、60歳以上の方などの入居者につきましては、やむを得ない場合には連帯保証人が１名でも可とする取扱いにしていきたい"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "自治会や社会福祉協議会などでも見守りを行っておりますが、毎日というわけにはいかないのが現状です"@ja.
<< kg:id_47 prop:effect kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "高齢化が進む中で、孤独死の問題が言われています。...病気や事故のことなど考えれば、見守りについては高齢者だけが必要なものではないと考えます"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "遠隔監視機能を有するシステムも一部実用化されてきておりますので、今後はデジタル変革の推進の中で、市営住宅においてどのようなことができるのか、検討を行っていきたい"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "少しの階段でも高齢者にとっては大変な苦労となります。このことで高齢者が閉じ籠もりになり、さらに体が弱っていく"@ja.
<< kg:id_54 prop:cause kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本市には、県を通じて４月12日の週に１箱、これは約1,000回、500人分に当たります。その後、４月26日の週に同じく１箱ということで、計２箱、約2,000回、1,000人分のワクチンが配分される予定であります。しかし、本市の高齢者に想定している接種者の約3.8％程度の量であり、本格的な接種を開始することはできないものと考えております"@ja.
<< kg:id_54 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "万が一クラスターが発生した場合に、地域医療体制への影響が大きい高齢者施設の入所者を優先して接種する方向で施設等と調整をしているところでございます"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "ワクチン接種後に注射した部分の痛み、疲労感、頭痛などが見られることがあります"@ja.
<< kg:id_57 prop:effect kg:id_59 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "ごくまれに重いアレルギーなどの重症の副反応が起きることがあるとされております"@ja.
<< kg:id_57 prop:countermeasure kg:id_60 >>
    prop:text-txt_contents "接種する前には、医師による予診を行うほか、接種後15分から30分程度の経過観察を実施することとされております"@ja.
<< kg:id_57 prop:countermeasure kg:id_61 >>
    prop:text-txt_contents "集団接種会場では、予診を担当する医師の中から副反応発生時の救急措置や医療機関への搬送など、医学的判断を行う責任者を定め、適切な対応ができる体制を構築しているところでございます"@ja.
<< kg:id_57 prop:effect kg:id_62 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "接種をされていない方が差別的な扱いを受けることはあってはならないものと考えているところです"@ja.
<< kg:id_57 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "接種をされない方が誹謗中傷などを受けることのないよう、市ホームページや酒田市ＬＩＮＥ公式アカウント、ツイッター、市広報など、その時点で最も有効な方法を活用し、分かりやすい広報により市民の皆様に呼びかけてまいりたい"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "酒田共同火力発電所の燃料となります石炭の輸入が減少したもので、全国的に天然ガス火力発電及び再生可能エネルギーによる電力供給が増加した一方で、石炭火力発電による電力供給が減少し、酒田共同火力発電所の稼働率も低下したため"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:text-txt_contents "輸出におけるその他日用品が2,912ＴＥＵの減少となっており、全体減少量3,450ＴＥＵのうち約84％を占めていることから、同貨物の減少の影響が大きいものと見てございます"@ja.
<< kg:id_66 prop:cause kg:id_68 >>
    prop:text-txt_contents "新型コロナウイルス感染症の影響によりまして、全世界的にコンテナの動きが悪くなったため、コンテナ不足により海上運賃が高騰している"@ja.
<< kg:id_69 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "“プロスパーポートさかた”ポートセールス協議会において、オンラインを活用したセミナーなど工夫して取り組んでまいります"@ja.
<< kg:id_69 prop:countermeasure kg:id_71 >>
    prop:text-txt_contents "中国との貿易に意欲のある企業を募って商談会を開催をし、酒田港の利用拡大につなげていきたい"@ja.
<< kg:id_69 prop:countermeasure kg:id_72 >>
    prop:text-txt_contents "一昨年より国内ＲＯＲＯ船の誘致に取り組んでおりました"@ja.
<< kg:id_73 prop:cause kg:id_74 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "基地港湾指定には、２つ以上の洋上風力発電事業者の港湾利用が見込まれることが要件の一つとされている"@ja.
<< kg:id_73 prop:cause kg:id_75 >>
    prop:text-txt_contents "その後、国から促進区域に指定をされまして、国が洋上風力発電事業者の公募を開始いたします。公募により選定されました事業者は、環境影響評価、環境アセスメント...これらの手続を経て工事に着手をするということになります。そのため、発電所の運転開始までは、今後、約10年以上かかると見込まれる"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "洋上風力発電の導入による景観や環境への影響について議論されてきてございます"@ja.
<< kg:id_76 prop:countermeasure kg:id_78 >>
    prop:text-txt_contents "山形県が具体的なイメージとして合成写真、フォトモンタージュと一般的に言われておりますけれども、これを作成し、公表する予定"@ja.
<< kg:id_76 prop:countermeasure kg:id_79 >>
    prop:text-txt_contents "鳥海山からの伏流水への影響について、調査や予測及び評価を実施することが盛り込まれているほか、サケなどの漁業対象魚種について、事業開始前から事業終了に伴う設備撤去及びその後の一定期間を通した継続的な漁業影響調査、モニタリング"@ja.
<< kg:id_80 prop:cause kg:id_81 >>
    prop:text-txt_contents "各路線が部分的に重複していることによる運行効率の低下が生じております"@ja.
<< kg:id_80 prop:cause kg:id_82 >>
    prop:text-txt_contents "運賃体系は民間事業者が距離制、市営バスが定額制で料金差が生じており、これも利用者にとって分かりにくいものとなっております"@ja.
<< kg:id_80 prop:cause kg:id_83 >>
    prop:text-txt_contents "バス停まで歩くことやバス停で待つことがつらいという高齢者を中心にデマンドタクシーの運行エリアとしての拡大を求める声があります"@ja.
<< kg:id_80 prop:cause kg:id_84 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "公共交通全体では、バス運転手の人件費増加などを背景に運行経費が増加しており、将来的には運転手不足も懸念されております"@ja.
<< kg:id_80 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "市街地エリアはるんるんバスの全面的な改編を行い、酒田駅前、中町周辺、日本海総合病院の３拠点は必ず経由するようにし、分かりやすく、かつ効率的な路線体系に変更する"@ja.
<< kg:id_80 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "郊外と総合支所エリアは、基本的にはデマンドタクシーの運行エリアとし、通学や通勤にも利用できるよう運行日を週３日から平日５日間にし、さらに朝１便の運行時刻を早めて、指定乗降場所を増やすなどの拡充を図ります"@ja.
<< kg:id_87 prop:cause kg:id_88 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "少子化などの影響に伴い、陸羽西線における通学や通勤目的の生活利用者の増加は、今後なかなか見込めないところであります"@ja.
<< kg:id_87 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "陸羽西線の利用者数増加のためには、観光利用による利用促進を図っていくことが重要である"@ja.
<< kg:id_90 prop:cause kg:id_91 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "残念ながら、各基本目標にある数値目標につきましては、新型コロナの影響により令和２年度は把握できない状況になっている"@ja.
<< kg:id_92 prop:cause kg:id_93 >>
    prop:text-txt_contents "人口減少による利用者の減少、施設の再編計画の必要性や維持管理費、耐震補強工事等の改修費用の確保などの課題"@ja.
<< kg:id_92 prop:effect kg:id_94 >>
    prop:text-txt_contents "うち体育施設は約189億円と試算しております。このうち、市全体では約860億円、うち体育施設では約37億円が財源不足となる"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "ｔｏｔｏ助成をはじめ、様々な助成や起債を活用しながら計画的な改修を行うものとしております"@ja.
<< kg:id_97 prop:cause kg:id_98 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "新型コロナウイルス感染症の拡大防止のため、体育施設は令和２年４月８日から５月10日までの間、休館をいたしました"@ja.
<< kg:id_97 prop:effect kg:id_99 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "予定されていたスポーツ少年団をはじめ、中体連、高体連の大会が中止になるなど、本市のスポーツ振興に本当に大きな影響を与えた"@ja.
<< kg:id_97 prop:countermeasure kg:id_100 >>
    prop:text-txt_contents "最終学年となる小学６年生、中学３年生、高校３年生を対象に、スポーツ少年団本部、そして体育協会をはじめ各競技団体の御協力の下、...代替大会の開催など、発表の場をつくっていただきました"@ja.
<< kg:id_101 prop:countermeasure kg:id_102 >>
    prop:text-txt_contents "休館解除後は、各施設において手洗いや換気の実施、ソーシャルディスタンスの確保、プレー時以外でのマスクの着用、手指消毒用のアルコールを設置するなど"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "役員の成り手不足、地域の行事や各種事業の担い手不足などにより防災活動や支え合い活動に支障が出てきている地域もあり"@ja.
<< kg:id_103 prop:effect kg:id_105 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "防災活動や支え合い活動に支障が出てきている地域もあり"@ja.
<< kg:id_106 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "地域計画実行の過程において地域のことをよく知り、地域と一体となって実行サポートする人材が必要なことから、それを担う存在として集落支援員を...配置をし、地域づくりの取組を支援しようとするもの"@ja.
<< kg:id_106 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "外部から来た人材ならではの視点や考え方によって、地区の価値を見いだして活性化につなげることがその狙いの一つであります"@ja.
<< kg:id_109 prop:cause kg:id_110 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "その減少の理由は、首都圏での移住相談会などが相次いで中止になった影響によるものでございます"@ja.
<< kg:id_111 prop:effect kg:id_112 >>
    prop:text-txt_contents "今年度は２月末時点で78人と、昨年度の相談人数59人を上回っている状況であり、コロナ禍における移住ニーズの高まりを認識しているところでございます"@ja.
<< kg:id_113 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "今年度のオンラインによる相談受付は11人であり、この方々は全て県やふるさと回帰支援センター主催によるオンライン移住相談会における相談者"@ja.
<< kg:id_113 prop:countermeasure kg:id_115 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "補助の対象となる中古住宅等の改修経費としてインターネット環境の導入経費を追加いたします。リモートワークをしながら酒田で暮らすというライフスタイルを後押しする狙い"@ja.
<< kg:id_113 prop:countermeasure kg:id_116 >>
    prop:text-txt_contents "移住お試し住宅のインターネット環境整備であり、リモートワークをしながらの酒田での暮らしをお試し住宅の利用期間中に体験していただくため"@ja.
<< kg:id_117 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "移住相談窓口では、対応の中で移住者の方、一人一人に応じた志向やニーズを丁寧に酌み取りながら、酒田の持つ資源をお伝えし、また、若者世代を対象とした移住ツアーの中でも酒田らしい体験ができるようなコンテンツを検討してまいります"@ja.
<< kg:id_119 prop:cause kg:id_120 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "何よりもお住まいになる地域、御近所の方のサポートが重要であり、移住者の方にとってありがたいことである"@ja.
<< kg:id_119 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "コミュニティ振興会の方や地域おこし協力隊、集落支援員の方、そういった方々の御協力を賜るように御紹介をし、おつなぎするなどの地域が移住者をスムーズに受け入れることができるような施策については、市としてもできることを行ってまいります"@ja.
<< kg:id_122 prop:cause kg:id_123 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "総じて、現在言われている少子高齢化や１次産業の衰退等による社会的要因によるものと思われています"@ja.
<< kg:id_122 prop:effect kg:id_124 >>
    prop:text-txt_contents "３地域は若年層の流出、マンパワーの低下など多くの課題を抱えている"@ja.
<< kg:id_125 prop:countermeasure kg:id_126 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "３地域の持つ魅力や特色を明確にして、個性あふれ活力ある地域社会の実現に努めることとした"@ja.
<< kg:id_127 prop:effect kg:id_128 >>
    prop:text-txt_contents "平成28年３月末と令和２年３月末の18歳から39歳までの人口を比較しますと、八幡地域は26.7％の減"@ja.
<< kg:id_129 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "地域おこし協力隊員の御縁から、大沢地区でございますが、親子３人で移住してきた家族がいらっしゃる...株式会社良品計画の社員の方も...日向地区に住居を構えている"@ja.
<< kg:id_129 prop:countermeasure kg:id_131 >>
    prop:text-txt_contents "日向里かふぇといったコミュニティビジネスの立ち上げや、株式会社良品計画の初の試みとなる移動販売も試験的に実施するなど"@ja.
<< kg:id_132 prop:countermeasure kg:id_133 >>
    prop:text-txt_contents "松山歴史公園周辺地区は、景観形成重点地域として指定をされており、当該地区における建築物の新築や増改築において景観を維持する部材を用いた場合には、一定の助成金額を受けられる地区"@ja.
<< kg:id_132 prop:countermeasure kg:id_134 >>
    prop:text-txt_contents "城址館を新設したところでございます。...まつやま大手門くらふとフェアを開催しておりまして、上堰から總光寺までを巡る城下町散策ということも実施"@ja.
<< kg:id_135 prop:countermeasure kg:id_136 >>
    prop:text-txt_contents "在来作物である平田赤ねぎや庄内柿の加工品...ふれあい商工会主催により食を中心とした事業、わがままマルシェを立ち上げるなど"@ja.
<< kg:id_137 prop:countermeasure kg:id_138 >>
    prop:text-txt_contents "東京都田園調布学園中等部の生徒をファームステイとして、平成15年度から受入れをしております"@ja.
<< kg:id_139 prop:countermeasure kg:id_140 >>
    prop:text-txt_contents "引き続き、景観助成制度を利用した町並みの保存を行っていくとともに、散策を楽しめる空間としての環境整備を考えてまいりたい"@ja.
<< kg:id_141 prop:countermeasure kg:id_142 >>
    prop:text-txt_contents "新しい計画の中では、景観や自然を満喫できる世代ごとのイベントや開放感あふれる眺海の森野外ステージの活用など、景観を意識した取組を進めていきたい"@ja.
<< kg:id_143 prop:cause kg:id_144 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "全国的には、やはり竹林の乱立で里山の荒廃につながる事例も多く報告されており、荒れた竹林は地域にとっても大きな課題の一つ"@ja.
<< kg:id_143 prop:effect kg:id_145 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "議員御指摘のとおり、タケノコの熊による食害は大きな問題となっており"@ja.
<< kg:id_143 prop:countermeasure kg:id_146 >>
    prop:text-txt_contents "ホワイト・グリーン・鳥海という団体が令和２年度から県事業を活用して、里山の遊休資源の活用を目的としたモウソウチクを使ったメンマ、それから、どんごえ、どんごいとも言いますけれども、イタドリです。などの塩蔵などの加工品を試作"@ja.
<< kg:id_143 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "地域おこし協力隊員が令和３年度にモウソウチクを活用した竹あかりなどの試作に取り組む計画"@ja.
<< kg:id_148 prop:cause kg:id_149 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "国の財政状況は歳出が膨張を続け、税収が横ばいのままであるため、その差が開き続け、財政の維持可能性の元となります国の経済規模、ＧＤＰに対しまして債務残高が２倍を超えており、主要先進国の中でも最も悪い水準"@ja.
<< kg:id_150 prop:countermeasure kg:id_151 >>
    prop:stateBy kg:st_16;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "酒田市におきまして、財政調整基金の積立て目的は、１つとしては、合併算定替え終了に伴います財源不足に備えること、２つ目といたしまして、公共施設等の老朽化対策に使うこと、３つ目といたしまして、人口減少による税収減対策に使うこと、４番目といたしましては、豪雪や災害への対応"@ja.
<< kg:id_150 prop:effect kg:id_152 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "ＰａｙＰａｙを国の補助金が来る前に財政調整基金を投入して早めに動き始めたと、それによって地元経済が26億円の消費が生まれた"@ja.
<< kg:id_153 prop:countermeasure kg:id_154 >>
    prop:stateBy kg:st_17;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "新規就業者へ定着、強化していく、例えば農業でありますと、もっけ田農学校でありますとか、それから土づくりというのをやっていきます"@ja.
<< kg:id_155 prop:cause kg:id_156 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "今は経済の格差だけでなくて、文化的な格差、それから志水先生が言うのはつながり格差といって、何か孤立しがちな環境で育った子供と多くの人が出入りしたり、あるいは親がいろんな人とつながっている家庭で育った子供の違い"@ja.
<< kg:id_155 prop:countermeasure kg:id_157 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "丸ごと抱えたときに一人も見捨てないというような形で子供たちに寄り添うことによって、結果的には子供の心が落ち着き、学ぶ力がついてくる"@ja.
<< kg:id_158 prop:countermeasure kg:id_159 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "第１期後期計画に、防災教育と安全教育の推進を新たに位置づけるとともに、子どもの命を守る安全教育推進会議を立ち上げ"@ja.
<< kg:id_158 prop:countermeasure kg:id_160 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "学級の状態を見える化できる、データ化できるＱＵアンケートを事業化しました"@ja.
<< kg:id_158 prop:countermeasure kg:id_161 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "この発想から生まれたのが単元研究という希望校への委嘱研究でございます。これは、新しい学力観による指導と評価の一体化を目指すもの"@ja.
<< kg:id_158 prop:countermeasure kg:id_162 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "今述べました生徒指導の充実と学力向上の２つの課題は、小学校、中学校が別々に取り組むのではなくて、９年間の義務教育全体の中で進める必要がございます"@ja.
<< kg:id_163 prop:cause kg:id_164 >>
    prop:text-txt_contents "人口減少に伴って子供たちが少なくなったことによる学校の小規模化"@ja.
<< kg:id_163 prop:countermeasure kg:id_165 >>
    prop:stateBy kg:st_18;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "少子化の波を受けながらもよい教育環境の学校をつくるために、例えば小中一貫教育校、あるいは義務教育学校の設立も視野に入れるなど、学区の在り方まで俯瞰的に見直しを検討することが必要"@ja.
<< kg:id_166 prop:cause kg:id_167 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "午前４時50分からの１時間降水量が76.5ミリ、平成30年８月５日の71.5ミリを超え、観測史上２番目の記録"@ja.
<< kg:id_166 prop:effect kg:id_168 >>
    prop:text-txt_contents "東栄町、若浜町、栄町、富士見町、新橋、御成町などでは、床上浸水が４件"@ja.
<< kg:id_166 prop:effect kg:id_169 >>
    prop:text-txt_contents "東栄町、若浜町、栄町、富士見町、新橋、御成町などでは、床下浸水が22件"@ja.
<< kg:id_166 prop:effect kg:id_170 >>
    prop:text-txt_contents "東栄町、若浜町、栄町、富士見町、新橋、御成町などでは、車庫内への浸水１件"@ja.
<< kg:id_171 prop:cause kg:id_172 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "富士見町地区などで地盤沈下が進んだ場所において、計画時間雨量50.4ミリを超えない雨でも道路冠水や住宅浸水が発生している状況"@ja.
<< kg:id_171 prop:countermeasure kg:id_173 >>
    prop:text-txt_contents "令和３年度には国の緊急自然災害防止対策事業を活用し、富士見町地区や京田地区等において老朽化したポンプ施設の更新"@ja.
<< kg:id_171 prop:countermeasure kg:id_174 >>
    prop:text-txt_contents "錦町地区や豊里地区においては、浸水解消に向けたポンプ能力の増強等を予定"@ja.
<< kg:id_171 prop:countermeasure kg:id_175 >>
    prop:text-txt_contents "ボックスカルバートを改修することによってそのボトルネックを解消し、流れる断面積を大きくするということで、札谷地排水路の流下能力を向上させ、富士見町地区の浸水被害を軽減していきたい"@ja.
<< kg:id_176 prop:countermeasure kg:id_177 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "今後につきましては、この止水シートをモデル的に導入して、それから希望する市民がいらっしゃれば貸出しを行って、実際どの程度、効果が発揮されるかの試験検証を行いながら、市民の方々のお気持ちを少しでも安心させられるような支援策の第一歩として、これから検討していきたい"@ja.
<< kg:id_178 prop:cause kg:id_179 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "以前、自転車の整理作業がうまくいかなく、駐輪場の景観がいかがなものかと思ったときもありました"@ja.
<< kg:id_178 prop:countermeasure kg:id_180 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "駐輪場の適切な利用につきましては、各高校のほうにもいろいろお願い、周知を図っているんですけれども、令和３年度につきましては、まちづくり推進課において整理作業員の増員"@ja.
<< kg:id_181 prop:cause kg:id_182 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "駐輪場の現状につきましては、やはり雨とか雪とか天候に対しての対策が十分でないというような課題整理"@ja.
<< kg:id_181 prop:countermeasure kg:id_183 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "今後、この駅前広場の改修をする際には、屋根付駐輪場の整備にもぜひ取り組んでいきたい"@ja.
}
