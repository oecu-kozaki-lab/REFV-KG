kg:st_1 rdfs:label "松本国博議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "米価下落で担い手が生活できず今後の担い手確保は厳しい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "米価下落で担い手が生活できず今後の担い手確保は厳しい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "農林水産部長"@ja.
kg:st_2 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_3 prop:content "若い世代が就農しなかったことが就業人口減少につながった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "先行き不安が就農をためらわせた"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "親が就農を勧められず世代交代が進まなかった"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "農地集積の進展も就業人口減少の一因である"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "65歳以上の農業就業者増加が高齢化率上昇の要因である"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "世代交代が進まず高齢化が進行している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "法人化推進により非農家出身の雇用就農者が増えた"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "農業法人の増加が雇用就農を増やした"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "農業を経営として見る意識の広がりも一因である"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "50歳未満が少なく5年後10年後の担い手不足が見えている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "単価は厳しく農家所得の減少が見込まれる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "本市の生産額や経済にも大きな影響を及ぼす"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "米価下落で農業が立ち行かなくなることを懸念している"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "このままでは担い手が生活できず来年作ろうとも思わなくなる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "担い手や後継者の育成に大きな意義がある"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_3 rdfs:label "丸山至市長"@ja.
kg:st_3 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_18 prop:content "配分量不足のため集団接種中止や個別接種の限定が生じた"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "ワクチン不足で予定日程の一部中止を余儀なくされた"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "ワクチン不足で個別接種対象を限定した"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "妊婦と新しい命を守るため優先接種を判断した"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "受験や就職活動に臨む生徒学生の不安軽減が必要である"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "妊婦や家族に安心して出産を迎えてほしい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "受験や就職活動に臨む生徒学生の不安軽減のため優先接種を実施する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "店舗利用特典は接種していない人への差別になり得る"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "ワクチン接種差別はあってはならず適時適切に周知する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "全国で企業破綻が累計2000件に達している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "企業は借入増加と資金繰りで消耗している"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "企業は資金繰りに追われている"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "本市では人との交流や飲食がなお制限されている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "認証基準が経営上の負担となり取組をためらう声がある"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "座席を減らす必要があり採算面の懸念がある"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "採算が合わないとの理由で取組をためらう声がある"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "安全安心をアピールする手段として積極的活用を周知したい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "地方移住志向の高まりを好機として捉えている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "移住者がまちづくりに参加する仕組みづくりも行う"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "各種媒体で本市のテレワーク環境を積極的にPRしている"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "移住定住促進のため住環境整備への支援を開始した"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "より効果的な情報発信に向け工夫していく"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:st_4 rdfs:label "副市長"@ja.
kg:st_4 rdf:type cls:st_40.
cls:st_40 rdfs:label "副市長"@ja.
kg:op_40 prop:content "認知症高齢者の家族からの相談にその都度対応している"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "国制度改正に基づきエアコン給付を実施している"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:st_5 rdfs:label "市原栄子議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_42 prop:content "今年の豪雪でカーポートや屋根などに被害が出た"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "通常起こり得ない大きな被害には補助もあり得るため国県へ働きかけたい"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:op_44 prop:content "急激な降雨で排水施設の能力を超えると内水氾濫が生じる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:op_45 prop:content "河川水位上昇で排水不能となる場合に内水氾濫が起きる"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_4.
kg:op_46 prop:content "直近5年間で床下浸水190戸の住家被害が生じた"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "直近5年間で床上浸水3戸の住家被害が生じた"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "被害状況把握と支援要望の聞き取りを行った"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:op_49 prop:content "被害発生後に回覧で必要情報を提供した"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "市の重要事業と位置づけ県に整備を要望している"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "実現可能な手法を検討していきたい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:op_52 prop:content "経済的困窮などで生理用品を用意できない方への支援である"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:op_53 prop:content "家庭の事情なども支援対象となる"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:op_54 prop:content "県内でもいち早い取組であり感謝し敬意を表する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_5.
kg:op_55 prop:content "各施設の実情に応じてチラシやカードを設置し周知している"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_4.
kg:op_56 prop:content "複数媒体で事業周知を図っている"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:op_57 prop:content "必要な方が負担感なく受け取れるよう配慮している"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_4.
kg:st_6 rdfs:label "市民部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_58 prop:content "運転に不安を感じる方の自主返納を促進している"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_6.
kg:st_7 rdfs:label "冨樫覚議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_59 prop:content "5,000円1回では少なく複数回や複数年の支援が必要だ"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_7.
kg:st_8 rdfs:label "企画部長"@ja.
kg:st_8 rdf:type cls:st_18.
kg:op_60 prop:content "自家用車普及とともに地域公共交通の利用者数は大幅に減っている"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_8.
kg:op_61 prop:content "運転手確保や燃料費増加で経費が年々増加している"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_8.
kg:op_62 prop:content "燃料費増加も経費増加の要因である"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_8.
kg:op_63 prop:content "アクセス性を高め分かりやすく利用しやすいバス路線に再編する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_8.
kg:op_64 prop:content "利用者の利便性向上と持続可能な地域公共交通の確立を目指す"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_8.
kg:st_9 rdfs:label "教育長"@ja.
kg:st_9 rdf:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_65 prop:content "年度当初調査に加え年間を通じて危険箇所を集約している"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_9.
kg:op_66 prop:content "関係機関で危険箇所情報を共有し対策を検討している"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_9.
kg:op_67 prop:content "学校PTA自治会交通安全協会見守り隊も参加して見回り対策を検討している"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_9.
kg:op_68 prop:content "見守り活動は通学路の安全確保に大きく寄与している"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_9.
kg:op_69 prop:content "見守り活動者の存在が運転者への抑止となる"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_9.
kg:op_70 prop:content "半数以上の小中学校で作成し各家庭配布や掲示で注意喚起している"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_9.
kg:op_71 prop:content "速度超過による危険箇所では地域実情に合わせた規制を実施している"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_9.
kg:op_72 prop:content "生活リズムの崩れが身体的不調につながっている"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_9.
kg:op_73 prop:content "精神的な不安が体調不良に結びついている"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_9.
kg:op_74 prop:content "個別指導などを通して悩みや不安の解消に努めている"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_9.
kg:op_75 prop:content "基本的対応を徹底することが何より重要である"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_9.
kg:op_76 prop:content "変異株対応として学校に再度指示依頼している"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_9.
kg:op_77 prop:content "本市は学校全体を原則臨時休業とする運用である"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_9.
kg:op_78 prop:content "通常授業の補助ツールとして無理なく運用できている"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_9.
kg:op_79 prop:content "学びの保障として遠隔授業を取り入れ着実に運用されている"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_9.
kg:st_10 rdfs:label "齋藤直議員"@ja.
kg:st_10 rdf:type cls:st_16.
kg:op_80 prop:content "ランドセルの重さや猛暑などを踏まえ基準緩和も検討すべきだ"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_10.
kg:op_81 prop:content "感染拡大の影響でワークショップを中止せざるを得なかった"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_3.
kg:op_82 prop:content "重要な施策の一つとして引き続き検討を深めたい"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_3.
kg:st_11 rdfs:label "健康福祉部地域医療調整監"@ja.
kg:st_11 rdf:type cls:st_41.
cls:st_41 rdfs:label "調整監"@ja.
kg:op_83 prop:content "時短要請がないため協力金は支給されない"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_11.
kg:op_84 prop:content "県外客を断ったことで売上減少が生じた店舗がある"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_11.
kg:op_85 prop:content "同じテナントの感染で他店舗も営業自粛した"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_11.
kg:op_86 prop:content "営業再開後も来客が戻らない店舗がある"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_11.
kg:op_87 prop:content "多くの対面型事業者はマイナスの影響を受けている"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_11.
kg:op_88 prop:content "分野によっては感染拡大以前の水準以上に回復している"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_11.
kg:op_89 prop:content "酒田港を基地港湾とカーボンニュートラルポートにしていく勉強会を立ち上げた"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_3.
kg:op_90 prop:content "国県沿岸自治体地元企業で検討会を立ち上げた"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_3.
kg:op_91 prop:content "洋上風力発電を通じてカーボンニュートラルに向けた動きを進める"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_3.
kg:op_92 prop:content "リプレースを含め望ましい在り方について必要な声を上げる"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_3.
kg:st_12 rdfs:label "地域創生部産業振興調整監"@ja.
kg:st_12 rdf:type cls:st_41.
kg:op_93 prop:content "事業計画策定や資金調達販路拡大など総合的に支援している"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_12.
kg:op_94 prop:content "初期投資等の負担軽減が起業促進につながっている"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_12.
kg:op_95 prop:content "課題は潜在的な創業希望者の掘り起こしである"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_12.
kg:op_96 prop:content "今年度から案件掘り起こしのため相談対応を始めている"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_12.
kg:op_97 prop:content "金融機関と連携し必要なサポート人材を確保している"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_12.
kg:op_98 prop:content "県外のUIJターン希望者に創業相談やコワーキング利用情報を発信している"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_12.
kg:op_99 prop:content "酒田で創業できて実際に活動している事例発信が有効である"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_12.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "これは、農産物の需要の減少や価格の低迷により、農業で生計を立てることに難しさを感じた若い世代が就農してこなかったと思われます"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "これは、農産物の需要の減少や価格の低迷により、農業で生計を立てることに難しさを感じた若い世代が就農してこなかったと思われます"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "農業で生計を立てることに難しさを感じた若い世代が就農してこなかったと思われます"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "こうした中で、稲作経営の先行きに不安を抱えて就農をためらったり"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、親が子に就農を勧められず、自ら現役で農業を続けることになったり、世代交代できなかったと推測しております"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "一方で、認定農業者、それから、農業法人の担い手への農地の集積率が増加していることで、農業就業者人口が減少したことも要因の一つでございます"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本市の農業就業人口は毎年減少している一方で、65歳以上の農業就農者は増加しております。これが高齢化率を上げている要因になってございます"@ja.
<< kg:id_8 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "高齢農家世帯では世代交代が行われず、高齢化が進んでいる現状でございます"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "酒田市農業の方向性にもありますように、農業経営体の法人化を推進してきました。これにより、農業法人の増加に伴って、非農家出身の雇用就農者が増加しております"@ja.
<< kg:id_11 prop:cause kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "これにより、農業法人の増加に伴って、非農家出身の雇用就農者が増加しております"@ja.
<< kg:id_11 prop:cause kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "最近では、経営目線で農業に取り組む農業法人も増加しております。農業がビジネスと捉えられるようになったことも一因であると考えております"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本市の農業就業人口は毎年減少している一方で、65歳以上の農業就農者は増加しております。これが高齢化率を上げている要因になってございます"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "単価については大変厳しい状況であるということで、農家所得の減少が見込まれる"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "議員御発言のとおり、本市の経済にも相当大きな影響を及ぼすものと受け止めてございます"@ja.
<< kg:id_16 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "このような米価が下落したことによって、そういった目的にある安定供給ができないだとか、農業が立ち行かなくなるといったことがないように"@ja.
<< kg:id_16 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "このような米価が下落したことによって、そういった目的にある安定供給ができないだとか、農業が立ち行かなくなるといったことがないように"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "このたび、担い手等の育成のために準備を進めてきました酒田もっけ田農学校がいよいよ来月、10月６日に開講する予定でございます。担い手や後継者の育成等において、大きな意義があると考えております"@ja.
<< kg:id_21 prop:countermeasure kg:id_23 >>
    prop:text-txt_contents "次に、農業次世代人材投資事業の実績でございますけれども、平成28年度から令和２年度までで15人が交付対象でありまして、全員が認定新規就農者として各地域で就農しております"@ja.
<< kg:id_21 prop:countermeasure kg:id_24 >>
    prop:text-txt_contents "また、さかたで独立就農支援事業の実績でございますけれども、令和元年度と令和２年度の２か年で４人、うち３人が農業次世代人材投資事業の交付も受けております"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "しかしながら、本市に配分されるワクチン量が不十分なために、８月から集団接種は、予定した日程を一部中止をしたり、それから、個別接種については、65歳以上の高齢者及び基礎疾患のある方などに限定をして接種をしてきたという状況にございます"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "本市に配分されるワクチン量が不十分なために、８月から集団接種は、予定した日程を一部中止をしたり"@ja.
<< kg:id_25 prop:effect kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "個別接種については、65歳以上の高齢者及び基礎疾患のある方などに限定をして接種をしてきたという状況にございます"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "本市では、妊娠後期に感染すると重症化のリスクが高まるとされている妊婦とその配偶者やパートナー"@ja.
<< kg:id_29 prop:effect kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "受験や就職活動に臨む生徒、学生の健康上の不安を少しでも軽減できるようにという思いから判断をさせていただいたところでございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "本市では、妊娠後期に感染すると重症化のリスクが高まるとされている妊婦とその配偶者やパートナー、それから、受験や就職活動などを控えている中学３年生や高校３年生に相当する方を対象に優先接種を実施をするということで、今、手続を進めております"@ja.
<< kg:id_21 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "受験や就職活動などを控えている中学３年生や高校３年生に相当する方を対象に優先接種を実施をするということで、今、手続を進めております"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "接種をしていない方からは差別と受け取られてしまう場合もあろうかと思います"@ja.
<< kg:id_21 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "市としては、ワクチン接種差別はあってはならないものと捉えているところでございまして、今後も国からの情報提供に注視しながら、ワクチン接種差別を生まないよう広報や各種通知等を活用し、適時適切に周知を図っていきたいと考えているところでございます"@ja.
<< kg:id_29 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "８月31日までのコロナ関連による全国の企業破綻が累計2,000件に達し"@ja.
<< kg:id_29 prop:effect kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "企業の借入金は膨らみ続け、長期借入金は過去最多となり、企業体力の消耗、資金繰りに追われている現実です"@ja.
<< kg:id_29 prop:effect kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "企業体力の消耗、資金繰りに追われている現実です"@ja.
<< kg:id_29 prop:effect kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "本市においても、いまだ人との交流や飲食が制限されております"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "認証基準をクリアするために座席の間隔を１メートル以上空けなきゃいけない"@ja.
<< kg:id_41 prop:cause kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "それを確保するためには座席数を減らさなければならない"@ja.
<< kg:id_41 prop:cause kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "それでは採算が合わないといった理由から、取組をためらうとの声も聞こえてまいります"@ja.
<< kg:id_21 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "安全・安心をアピールするための手段として、この制度の積極的な活用については、機会を捉えて、本市としてもやはり周知を図っていく必要があると考えておりまして、引き続き取り組んでまいりたいと思っております"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "議員おっしゃるとおり、長引くコロナ禍によりまして、若者を中心に地方への移住志向がより高まっているものと認識をしております"@ja.
<< kg:id_21 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "消防本署の跡地を活用した移住者向け住宅と地域交流拠点を整備運営する予定事業者を今年の４月に選定をいたしました"@ja.
<< kg:id_21 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "テレワーク推進のために雑誌やウェブサイトなど各種媒体において、積極的に本市のテレワーク環境をＰＲしてきた"@ja.
<< kg:id_21 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "今年度からは移住者向け住宅改修補助金の対象経費にインターネット環境の整備費用を追加するなどの支援も開始をしたところでございました"@ja.
<< kg:id_21 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "新たに市のホームページにおいて、企業や個人の移転・移住に関する情報を一元的に紹介するページを設けたところでございます"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "地域包括支援センターや民生委員へは、むしろ認知症高齢者の離れている家族から、設置されているエアコンが適切に使用されているか確認してほしいというような相談が寄せられておりまして、その都度、これは対応しております"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "生活保護受給世帯については、保護開始から初めての夏を迎える世帯に対してはエアコンを給付することができるようになりまして"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "しかし、今年の豪雪による家屋などへの被害が出ております"@ja.
<< kg:id_56 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "被害の程度によって、国や県への働きかけをしていきたいと考えております"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "内水氾濫による被害は、台風や線状降水帯などの急激な降雨に対して、排水施設の能力を超えたり"@ja.
<< kg:id_59 prop:cause kg:id_61 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "河川の水位が上昇し雨水を排水できない場合に生じるものであります"@ja.
<< kg:id_59 prop:effect kg:id_62 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "床下浸水が190戸"@ja.
<< kg:id_59 prop:effect kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "床上浸水が３戸の住家被害が生じました"@ja.
<< kg:id_21 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "市の職員が戸別訪問調査を行い、被害状況の把握に加えて、支援の要望などの聞き取りを行いました"@ja.
<< kg:id_21 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "家屋周辺の消毒を実施することや、浸水により発生したごみ処分などの案内について、被害発生から３日後には隣組の回覧を行い、情報提供を行いました"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "主要地方道酒田松山線の冠水対策を酒田市の重要事業と位置づけ、今年の５月に山形県に対し整備を要望したところであります"@ja.
<< kg:id_66 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "ポンプ場や雨水貯留槽の建設に取り組むためには課題も多い状況でありますが、実現可能な手法について、ぜひ検討していきたいと考えております"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "生理用品サポート事業は、新型コロナウイルス感染症拡大の影響による経済的な困窮のほか、家庭の事情など何らかの理由で生理用品を用意することが難しい方へ支援をするもので"@ja.
<< kg:id_69 prop:cause kg:id_71 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "家庭の事情など何らかの理由で生理用品を用意することが難しい方へ支援をするもので"@ja.
<< kg:id_21 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "この事業は７月から行われており、県内でもいち早い取組がされていることに感謝し、敬意を表するものです"@ja.
<< kg:id_21 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "市役所や交流ひろば及び健康センターなどの公共施設で、各施設の実情に応じてチラシ及び受け取り希望カードを設置して、掲示をしております"@ja.
<< kg:id_21 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "また、広報紙やホームページ、酒田ＦＭハーバーラジオなどを活用したＰＲも行っております"@ja.
<< kg:id_21 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "必要な方が負担感なく受け取ることができるよう受け取り希望カードなどの提示による受け取りや、女性職員が対応するなど十分に配慮して行っております"@ja.
<< kg:id_76 prop:cause kg:id_77 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "本市の免許返納に対する支援制度は、加齢等に伴う身体機能の低下などにより運転に不安を感じる方の自主返納を促進し"@ja.
<< kg:id_21 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "免許返納時１回限りとして5,000円相当のタクシー券またはバス回数券の交付"@ja.
<< kg:id_21 prop:countermeasure kg:id_79 >>
    prop:text-txt_contents "運転経歴証明書の交付手数料1,100円の助成"@ja.
<< kg:id_21 prop:countermeasure kg:id_80 >>
    prop:text-txt_contents "運転経歴証明書の提示によります酒田市乗合バスとデマンドタクシーの運賃の100円割引"@ja.
<< kg:id_81 prop:cause kg:id_82 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "鉄道、バス、タクシーなどの地域公共交通でございますけれども、自家用車の普及とともに利用者数、大分激減してございます"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "運転手の確保ですとか運行に係る燃料費、これらの増加によりまして年々経費が増加している"@ja.
<< kg:id_83 prop:cause kg:id_85 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "運転手の確保ですとか運行に係る燃料費、これらの増加によりまして年々経費が増加している"@ja.
<< kg:id_21 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "令和４年度に向けまして地域公共交通を改編することとしているところでございます。この改正によりましてアクセス性を高めるとともに、分かりやすく利用しやすいバス路線に再編をするという予定となってございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "デマンドタクシーの運行内容も充実を図っていくことで、より利用者の利便性が向上し、地域公共交通が持続可能なものとなるような、そういったふうに確立できるものとして考えてございます"@ja.
<< kg:id_88 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "学校やＰＴＡ、地域の方々などからも気づいたところを報告いただきまして、教育委員会で集約をしている"@ja.
<< kg:id_88 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "国、県、市の道路管理者や酒田警察署、市の担当課などによる通学路安全推進会議を開催しまして、その集約した情報を共有するとともに、危険箇所ごとに対策を検討し"@ja.
<< kg:id_88 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "現地確認が必要な箇所については合同で点検を実施しているところでございます。この合同点検には、学校やＰＴＡ、自治会や交通安全協会、見守り隊なども参加して"@ja.
<< kg:id_92 prop:effect kg:id_93 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "登校時における交通事故の未然防止に大きく寄与していると考えております"@ja.
<< kg:id_92 prop:effect kg:id_94 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "見守り活動をしている方々を運転者の立場で発見すると、抑止が効くといいますか、スピードにも注意したり"@ja.
<< kg:id_21 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "通学路安全マップの作成状況ですが、主に学校ごとに作成しておりまして、本市では半数以上の小中学校で作成しているところでございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "速度超過による危険箇所の場合は、その都度、関係機関やその地域の方々などと協議の上、ゾーン30に限らず、地域の実情に合わせた規制を実施しているところでございます"@ja.
<< kg:id_97 prop:cause kg:id_98 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "いつもと同じ時間に起きていないと答える児童・生徒も多く、生活のリズムの崩れが身体的な不調にも結びついているのではないかと考えているところです"@ja.
<< kg:id_97 prop:cause kg:id_99 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "コロナに感染するのではないか心配だとか、コロナのことで学校に行くのが不安になるですとか、そういう精神的な不安を訴える児童・生徒もおりまして、そういう精神的な要素が体調不良に結びついていると考えております"@ja.
<< kg:id_21 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "各学校では担任の先生、それから養護教諭の先生を中心といたしまして、児童・生徒の丁寧な見取りをしていただいております。必要に応じてスクールカウンセラーからの助言等もいただき、個別指導などを通して、悩みや不安をできる限り解消できるよう努めているところでございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "保健所からの指導を受けまして、コロナ感染防止対応チェックリスト、これに沿って活動することを基本としております"@ja.
<< kg:id_21 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "不織布マスクの着用、30分に１回以上の換気、給食では黙食の徹底"@ja.
<< kg:id_21 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "本市としては、関係者に陽性者が判明したその時点で原則臨時休業としております"@ja.
<< kg:id_21 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "各学校で通常の授業の中の補助ツールとして上手に取り入れていただいておるかなと思っております"@ja.
<< kg:id_21 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "臨時休業した学校では、学びの保障ということで、遠隔授業を取り入れた学校もございました"@ja.
<< kg:id_21 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "本市のスクールバスの運行基準は、通年基準として、小学校はおおむね４キロ以上、中学校で６キロ以上、また、冬期間では小学校・中学校３キロ以上とのことであります"@ja.
<< kg:id_107 prop:cause kg:id_108 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "令和２年度に市民からの意見を聞くための市民ワークショップの開催、これを予定していたところでございました。しかしながら、新型コロナウイルス感染拡大の影響によりまして、なかなか市民の皆さんから集まっていただくということもできない、さらには様々な制約もあって中止せざるを得なかった"@ja.
<< kg:id_21 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "雨天時、それからこの地域特有の条件として、冬の間、親子で遊ぶことができる屋内型の児童遊戯施設の整備につきましては、引き続き重要な施策の一つとしては捉えているところであります"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "県が実施しました特別集中期間では、事業者には県外出張の半減とテレワークの導入などについて協力を要請しておりますが、時短要請はしていないため、協力金は支給されないものでございます"@ja.
<< kg:id_29 prop:effect kg:id_112 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "感染防止対策のために県外のお客様をお断りしたために売上げが減少した店舗"@ja.
<< kg:id_29 prop:effect kg:id_113 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "テナント形式の店舗従業員の方が新型コロナに感染したことにより、当面の間、同じテナントに入っている店舗も営業を自粛した"@ja.
<< kg:id_29 prop:effect kg:id_114 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "営業再開後も来客がないなどの状況があると伺っております"@ja.
<< kg:id_29 prop:effect kg:id_115 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "飲食業、宿泊業、タクシー業、旅行業など多くの事業者はマイナスの影響を受けている"@ja.
<< kg:id_29 prop:effect kg:id_116 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "感染拡大に伴います巣籠もり需要が高まっている分野の製造業や小売業は、コロナ感染拡大期以前の水準以上の回復になっている事業者がございました"@ja.
<< kg:id_21 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "６月３日に酒田市と山形県とで酒田港基地港湾等カーボンニュートラルポート連携会議という会議を立ち上げて、酒田港を洋上風力発電の基地港湾等を目指し、かつカーボンニュートラルポートにしていこうというそういう勉強会を立ち上げているところでございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "昨日９月14日には酒田港のカーボンニュートラルポート検討会という、これは国と県と沿岸自治体、酒田、遊佐、それから地元の企業、それで構成する検討会をも立ち上げたところでございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "山形県等と酒田市沖での洋上風力発電の導入の検討に向けた協議を今、山形県との間で開始しているところでございます"@ja.
<< kg:id_120 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "引き続き、酒田共同火力発電及び東北電力との意見交換は継続していきたいと考えますし、国のエネルギー政策の状況を注視しながら、東北電力に対しましても、リプレースを含めて、酒田共同火力発電の望ましい在り方について、立地している自治体として必要な声は上げていきたいと考えているところでございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "酒田市産業振興まちづくりセンターサンロクの中に、創業に関するワンストップ相談窓口を設けております。創業・事業承継支援員が創業希望者の事業計画の策定ですとか資金調達、販路の拡大などの相談対応"@ja.
<< kg:id_21 prop:countermeasure kg:id_123 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "上限100万円、対象経費の２分の１の補助になりますけれども、酒田市開業支援補助金を整備しておりまして、これが実に有効に働いていると、起業の促進につながっていると思っております"@ja.
<< kg:id_21 prop:countermeasure kg:id_124 >>
    prop:text-txt_contents "新規開業者が金融機関から新規開業に伴う融資を受ける際に、信用保証協会に対して保証料というものを支払う必要がありますけれども、それを市が一部負担することによって"@ja.
<< kg:id_125 prop:cause kg:id_126 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "我々としてまだ課題だなと思っているのは、潜在的な創業希望者の掘り起こしだろうと思っています"@ja.
<< kg:id_21 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "そういったところで、サンロクとしてはそういう時期の御相談をキャリアカウンセリングのような形で面談、御相談を受けてということを今年度から始めているところでございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_128 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "酒田金融協会会員の金融機関から創業・事業承継支援員を派遣いただいていまして、必要なサポートをしているというところでございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "県外の方の酒田へのＵＩＪターンの促進を目的としました酒田市移住ポータルサイト「ａｔ　ｓａｋａｔａ」にサンロクについて掲載をしております"@ja.
<< kg:id_21 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "サンロクのフェイスブックを通じて多くの創業事例を紹介させていただいております"@ja.
}
