kg:st_1 rdfs:label "佐藤弘議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "財政運営の厳しさが増している要因として維持管理費の増加を問題視"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "財政健全化には歳出改革努力の継続が必要と指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "財政の厳しさが市民に十分伝わっていないと懸念"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_4 prop:content "持続可能な財政基盤の確立を前提に事業を精査すると説明"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "事業の拡充継続統合を検証結果に基づき判断すると説明"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "公共施設改修は優先順位を見極めて判断すると説明"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "タブレット配付により印刷コスト削減を進めると説明"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "DX化により需用費や旅費を削減すると説明"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "事務費節減のため事業集約を進めたと説明"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:st_3 rdfs:label "竹越攻征総務部長"@ja.
kg:st_3 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_10 prop:content "多様な性や生き方を包摂する取組として位置づける"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "性の多様性を含む理解促進に予算措置したと説明"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "生理用品を特別視せず共生社会実現の一環として進めたい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:st_4 rdfs:label "市原栄子議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_13 prop:content "交付税総額の減少が今後も続くことを危惧"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "想定内の減少幅で直ちに大きな影響はないと説明"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "自主財源増は望ましいが収支不均衡は課題と説明"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "コロナ禍で停滞する市民生活や活動に寄り添う市政運営が必要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "中長期にわたり市内事業者を支援していく考えを示す"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "国や県の制度活用を最優先に周知徹底すると説明"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "時短要請に協力した飲食店等へ申請支援を行う"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "農林水産業の状況を見ながら支援を検討すると説明"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "水産業の状況を見ながら支援を検討すると説明"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "市民生活を支えるには経済正常化が必要と説明"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "デジタルを使いたくない市民にもサービス格差を生じさせない"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "使えないが使ってみたい市民を増やす支援を進める"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "使えない使いたくない市民にもアナログ対応を続ける"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "市民に直結した事務サービスまで民間提案対象となることを危惧"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "窓口業務の提案も総合的に判断すると説明"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "具体的施策と目標の明確化を求める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "実証結果を踏まえ課題整理しながら取り組む"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "休止状態のまま進めるのか断念するのか市民が注視している"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "従来想定した施設運営が難しく再検討が必要と説明"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "必要性は認めつつ財政面から直ちに整備できないと説明"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "必要ないのではなく中長期的視点で在り方を検討すると説明"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:st_5 rdfs:label "白畑真由美健康福祉部長"@ja.
kg:st_5 rdf:type cls:st_18.
kg:op_34 prop:content "必要な受診抑制を避けるため丁寧な周知が必要と説明"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_5.
kg:op_35 prop:content "負担増加への配慮措置が講じられると説明"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:st_6 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_36 prop:content "近隣施設と同程度にしてほしいという指定管理者の相談があった"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_6.
kg:op_37 prop:content "サービス向上につながると説明"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_6.
kg:op_38 prop:content "高額プランだけでなく市民向けのお得なプラン提供を継続する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_6.
kg:st_7 rdfs:label "鈴木和仁教育長"@ja.
kg:st_7 rdf:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_39 prop:content "９年間を俯瞰して地域との連携を強める必要があると説明"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_7.
kg:op_40 prop:content "小中の９年間の軸で発達段階に応じた取組を整理したい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_7.
kg:op_41 prop:content "取組を先導しつなぐ人材が必要と説明"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_7.
kg:op_42 prop:content "将来を見据えると早期の公立化が必要と考える"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:st_8 rdfs:label "佐藤猛議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_43 prop:content "学生によりよい環境を整えるため公立化は避けて通れないと強調"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_8.
kg:op_44 prop:content "企業家庭地域の意識改革と環境整備が重要と説明"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "企業側の意識啓発と行動変容を促す取組を進める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "女性の多様な働き方支援を強化する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "不漁要因として国の見解も踏まえ認識している"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "資源量低下が不漁につながっていると説明"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "イカ不漁の中で持続可能な水産業への支援が必要と指摘"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_8.
kg:op_50 prop:content "漁業効率向上や新たな漁法への挑戦を後押しする"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "漁業研修開始の初期投資や生活基盤支援で若者確保を図る"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "多世代移住者が地域活性化にも寄与する事業として進める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "移住者が地域に自然に溶け込む好事例を生み出したい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "移住先として本市を選んでもらう機会を増やしたい"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "高い訴求力を生かして他自治体との差別化を図る"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:st_9 rdfs:label "池田博夫議員"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_56 prop:content "コロナ禍でイベントを振り返る機会ができた今後の方向性を問う"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_9.
kg:op_57 prop:content "当面は変化に対応しながら模索する必要がある"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "新しいイベント運営手法を取り入れて開催を進めたい"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "コロナ禍継続時の観光振興策として継続する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "今後の一つの方向性として進める"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "高速道路整備の遅れは産業移住観光に大きなマイナスだと指摘"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_9.
kg:op_62 prop:content "早期全線開通は庄内地域の重大な使命として要望を続ける"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "人口減少の主要因として自然減を認識"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "社会減も人口減少の主要因として認識"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "女性の転出超過が婚姻件数や出生数の減少につながる負の連鎖を生んでいると説明"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "良質な雇用創出と女性活躍支援を令和４年度の重点政策に位置づける"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "総合戦略見直しの中で人口減少抑制につながる新たな施策を盛り込む"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "維持することが決まった施設の大規模改修等に充当するため創設した"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "財政面利用状況市民要望などを踏まえ納得性ある判断が必要と説明"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "財政負担を最小限に抑えるため基金を使う"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "学校地域家庭と連携した支援体制が重要と説明"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_7.
kg:op_72 prop:content "多角的に支援できる体制で一人一人に寄り添う"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_7.
kg:op_73 prop:content "知ることが支援の前提として重要と説明"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_7.
kg:op_74 prop:content "文化芸術を身近に体験できる環境整備を進める"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_7.
kg:op_75 prop:content "鑑賞機会の拡大を図り共生社会の実現に取り組む"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_7.
kg:op_76 prop:content "命や道徳的な考えを助長する取組として授業を行っている"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_7.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "公共施設の維持管理費用の増嵩など、本市の財政運営は一層厳しさを増しています"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "恒常的に歳出の水準が歳入水準を上回る構造となっており、予算編成は毎年度極めて厳しい状況にある"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "基金の取崩しに依存した財政運営は限界を迎えつつあります"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "実施すべき行政サービスの将来的な維持に向け、事業や経費の取捨選択を行いました"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "行政評価の結果や事業目的、達成度、効果測定、そして改善が図られているかを一つ一つ丁寧に検証することを指示し、結果として、事業の拡充や継続、統合という形で事業の取捨選択がなされた"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "公共施設等の改修については緊急性と優先性を考慮しながら予算措置の可否を判断いたしました"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "議員や職員へのタブレット配付に伴いまして、例えば印刷物がかなり節約される、コストが節減されるという意味で、予算書等をデータ化して紙による資料作成経費を削減する"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "職員向けの事務経費についてはＤＸ化によるペーパーレスの推進、オンライン会議の実施等による需用費や旅費の削減、各種計画、概要、パンフレット、会報等の電子媒体を有効活用することによる印刷製本費の削減を行った"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "複数の事業を統合することによりまして、限られた予算を有効に活用できるような取組にも力を入れた"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "予算編成の中では大きく２つ、具体例として申し上げますと、男女共同参画社会の実現という事業ございます"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "男性向けには人間力で仕事やプライベートも楽になるというような講座を行っていて、酒田東高校との共催で、性の多様性、ＬＧＢＴでありますとか、最近ですとＳＯＧＩと、好きになる性でありますとか、心の性というのがありますけれども、こうした講座やっておりますけれども、こうしたことに予算措置をさせていただいた"@ja.
<< kg:id_11 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "もう一点が、副市長を中心に御指導いただいておりますけれども、生理用品サポート事業"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "令和４年度予算では臨時財政対策債を含めた地方交付税が昨年度よりも３億2,800万円の減額となっております"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "近年、普通交付税と臨時財政対策債の合計額は130億円前後ということで、平成27年度の160億円台に比べますと、歳入の予算、決算ともに減少傾向にございます"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "近年、本市では市税収入等の増を要因として、基準財政収入額が増加傾向にあって、普通交付税が減少をしてきている"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "コロナ禍の中で停滞している市民生活や活動に寄り添っていく市政運営が必要だと考えています"@ja.
<< kg:id_21 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "長引く新型コロナウイルス感染症の影響によって融資を受けられた中小企業・小規模事業者、約560件に対する利子補給と保証料補給"@ja.
<< kg:id_21 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "事業復活支援金について、２月10日に市内事業者約810件、飲食業、宿泊業、交通事業者、酒の小売業、旅行業が主なものですが、そこに申請方法などを郵送で通知を出して、個別に周知を図った"@ja.
<< kg:id_21 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "２月25日に市内飲食店約470件に申請方法などを記載した案内と申請書を個別に郵送した"@ja.
<< kg:id_21 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "これまで実施した新型コロナウイルス関連農業打撃克服対策事業における水稲種子への支援"@ja.
<< kg:id_21 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "新型コロナウイルス関連水産業打撃克服対策事業における魚箱等への支援策"@ja.
<< kg:id_21 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "経済活動を速やかに正常化させ、経済の好循環を加速、拡大させる取組を展開する必要がある"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "デジタルを使いたくないという方々に対しては、デジタル活用による効率化によって生じた、我々、余力部分ですけれども、余力部分をそういう方々に振り向けて、これまで以上に丁寧に、市民サービスの面では差が生じないように対応してまいりたい"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "昨年10月に協定を締結しております第一生命保険株式会社からスマホ教室の開催の提案を受けております"@ja.
<< kg:id_29 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "使えない、使いたくない市民に対しては、先ほども申し上げましたけれども、市民サービスをしっかり差がなく受けられるように、そこはもうアナログでと申しましょうか、マンパワーを駆使して市民サービスを提供するような体制をしっかり組んでいきたい"@ja.
<< kg:id_33 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "あらゆる行政分野における事務事業及び本市が有する全ての公有財産を提案の対象としております"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "１つは、市民サービスの向上または本市歳出の抑制もしくは歳入の確保につながるものであること、２つ目として、提案者が確実に実施できるものであること、３つ目として、本市に新たな財政支出または維持経費の増加を伴わないものであること"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "令和２年12月から地方共同法人地方公共団体情報システム機構という組織が提供する自治体テレワーク推進実証実験に参加をしている"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "集中して作業ができて仕事がはかどった、内部業務システムやネットワークが使えるためほとんど支障がなく大変便利だった、一方で、出勤しなければできない仕事もあって連続でのテレワーク勤務は難しいと感じた"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "令和４年度ということを考えたときに、新型コロナウイルス感染症対策ですとか地域経済の立て直しをまず優先して取り組んでいくべきと考えた"@ja.
<< kg:id_39 prop:cause kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "感染症対策を講じる必要がある現状では、屋内児童遊戯施設の目的の１つである子育て世代の交流促進が非常に困難な状況"@ja.
<< kg:id_39 prop:cause kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "市単独での屋内児童遊戯施設の整備、これは財政的にも大変厳しい現状にある"@ja.
<< kg:id_39 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "公民連携によります施設整備ですとか、あるいは令和５年度に発足するこども家庭庁の動向、こういったことをやることによって、ひょっとしたら有利な財源が国から来るということも想定できますし、そういった意味では、その有利な財源の利用も今後視野に入れながら、中長期的な視点で屋内児童遊戯施設の在り方については引き続き検討していきたい"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "本市の被保険者約１万9,000名に対し、窓口負担割合が１割から２割になる方は約2,200名、11.6％と見込んでいる"@ja.
<< kg:id_44 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "制度施行後３年間、令和７年９月30日までは１か月の外来における医療費の負担増加額を3,000円までに抑える措置を講じる"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "第三セクターが運営する近隣の類似施設と比較いたしまして半額以下の使用料の上限設定となっておりましたので、近隣施設と同程度にしてほしいという旨、指定管理者から相談を受けていた"@ja.
<< kg:id_47 prop:effect kg:id_49 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "宿泊使用料の上限を上げることによりまして、これまでは料理などでしか差別化できなかった宿泊プランが、指定管理者の創意工夫、アイデアを盛り込んだ多様なプランや、曜日やシーズンに対応した細やかな料金設定ができるようになり、サービスの向上につながる"@ja.
<< kg:id_47 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "現在、鳥海山荘では市民向けに、自宅送迎付湯治プラン、１泊３食で6,850円、これが３泊以上になりますとさらに500円の値引きというようなプランを実施するなど、市民向けの特別なプランを準備している"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "小中一貫教育がスタートいたします。その際、まなびの樹の根っこの部分について力を入れていこうと議論していく中で、これはどうしても地域との関わり、地域との連携・協働による学びは必要不可欠であるということで光が当たってまいりました"@ja.
<< kg:id_51 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "小中の９年間というスパンで、少し俯瞰をして見て捉えることが必要だろうということになってまいりました"@ja.
<< kg:id_51 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "俯瞰してそれぞれの取組を先導していくといいますか、つないでいくといいますか、そういった役割を果たす人材も地域には必要になってくるだろうと思っておりまして、今のところ地域プロデューサーというような名称で、各中学校区にそういった人材を配置することなども検討している"@ja.
<< kg:id_55 prop:cause kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "少子化や人口減少によりまして、地方や地方大学を取り巻く環境が厳しくなる中、本市としてはしっかりと将来を見据えた上で、地方創生や持続可能なまちづくりを推進する必要がございます"@ja.
<< kg:id_55 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "東北公益文科大学につきましては、安定的に学生を確保して、人材供給における重要な拠点としてこれからも存続させていく必要がありまして、早期に公立化を行うべきだと考えております"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "本市では３つの柱、１つは職場における女性活躍、２つ目は家庭との両立支援、そして３つ目が女性のチャレンジ支援"@ja.
<< kg:id_58 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "地域女性活躍推進交付金を活用した経営者向けセミナーの開催"@ja.
<< kg:id_58 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "よろずＩＴ女子マネジャー１名をこのサンロク内に配置をしまして、女性のデジタル人材の育成とデジタルスキルを生かした市内外の企業の仕事獲得を支援していきたい"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "不漁の要因としては、国では地球規模の気候変動や潮流の変化などによる影響"@ja.
<< kg:id_62 prop:cause kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "外国船の違法操業による資源量の低下"@ja.
<< kg:id_62 prop:effect kg:id_65 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "酒田港における今年度の船凍イカの水揚げ量は、過去最低だった令和元年度よりもさらに量が減って、79トン少ない795トンとなっている"@ja.
<< kg:id_62 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "魚群探知機など漁業効率の向上や新たな漁法への挑戦などに必要な機器や機材の導入・整備を支援する"@ja.
<< kg:id_62 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "新たに本市での漁業研修を開始するための初期投資費用や研修期間中の生活基盤の支援などを行う新規就業者確保・育成総合対策支援事業"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "山居倉庫向かいの市有地であります消防署跡地を無償で貸して、民間事業者の資金力とノウハウで施設、この施設というのは移住者向け住宅と地域交流拠点の２つを指しますけれども、その整備運営を行う公民連携の仕組みで事業を推進する"@ja.
<< kg:id_68 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "事業者グループや、これまで連携してきた生活クラブ事業連合生活協同組合連合会をはじめとして、東北公益文科大学、地元コミュニティなどと運営委員会を構成しまして、事業の推進について協議していく予定"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "令和４年度は新たにウェブサイト等に表示されるインターネット広告を展開して移住ポータルサイトに誘導することで、移住先として本市を選んでいただける機会を増やしていきたい"@ja.
<< kg:id_71 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "昨年12月に本市に移住をしたＡＮＡ株式会社に所属する現役キャビンアテンダント５名の方がいらっしゃるわけですけれども、この方々と連携をして、ＳＮＳを活用した情報発信や移住ポータルサイトをはじめとした各種媒体への出演などを予定している"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "大きな観光イベントについてはほぼ実施することができなかった"@ja.
<< kg:id_74 prop:effect kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "露天商の皆さんが廃業するといったことで、これまでと異なる環境になってしまっていると思っております。したがいまして、コロナ前のにぎやかな酒田の名物の祭りの雰囲気から、ひょっとしたら様相ががらっと変わるということも予想される"@ja.
<< kg:id_74 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "スタッフ・出店者等の事前体調管理、参加者の当日体調管理と連絡先情報の収集、それから距離を保った会場設定、動線の確保、ウイズコロナ下での感染症予防対策、そういったノウハウを蓄積することができた"@ja.
<< kg:id_74 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "コロナ禍が続く中では、鳥海山・飛島ジオパークや北前船寄港地の日本遺産を活用したマイクロツーリズムを中心とした少人数での体験型コンテンツの提供"@ja.
<< kg:id_74 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "国の史跡に指定された山居倉庫の活用と酒田商業高校跡地を核とした町歩きへの誘導も、今後の一つの方向性である"@ja.
<< kg:id_80 prop:effect kg:id_81 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "産業や観光交流面をはじめとして、国土強靭化の観点や安定的で確実な物流機能、あるいは救急医療体制を確保するためといった面でも大きな効果が期待される"@ja.
<< kg:id_80 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "地元選出の国会議員をはじめ県議会議員、市議会議員、そして県や沿線自治体、各関係機関、関係団体と連携して、令和４年度においても積極的な要望活動を展開していきたい"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "本市における人口減少の要因といたしましては、出生数が死亡数を下回る自然減"@ja.
<< kg:id_83 prop:cause kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "転入数が転出数を下回る社会減"@ja.
<< kg:id_83 prop:cause kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "魅力ある就業環境が整っていないことによる若い世代の女性の転出超過、それに伴う婚姻件数や出生数の減少といった負の連鎖が人口減少の素因"@ja.
<< kg:id_83 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "良質な雇用を創出するための企業立地支援、情報通信関連業種などのサテライトオフィスの誘致、女性に対するＩＴスキル向上と仕事獲得の支援、そして女性が働きやすい就業環境づくり"@ja.
<< kg:id_83 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "結婚の支援、不妊治療の助成、保育所の充実や保育料の負担軽減など、出生数の増加につながる取組や移住支援、新規農林水産業就業者の確保、消防署跡地における移住者向け住宅と地域交流拠点の整備など、転入の増加につながる取組も新たな施策としてつなげていきたい"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "公共施設等整備基金は、公共施設等の改修等、整備に係る費用に充当するために創設をさせていただきました"@ja.
<< kg:id_89 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "市民の理解をいただきながらでありますが、選択と集中によって維持することが決まった施設の大規模改修等を行っていきたい"@ja.
<< kg:id_89 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "改修等をすることになった施設については、国庫補助金や有利な事業債などを充当した後の一般財源、この部分について頭金程度の額に対して基金を充当するとか、財政負担を最小限に抑えるために基金を使う"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "近年、児童生徒を取り巻く環境につきましては年々複雑化・多様化してきております"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "各中学校区に校内の相談業務を担うスクールカウンセラーと教育相談員を配置しております。また、特別支援教育巡回相談員、家庭訪問相談員、スクールソーシャルワーカーも配置している"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "今後特に教職員がヤングケアラーについて知ることや子供自身がヤングケアラーについて知ること、これがやはり、引き続きこの周知を図ることが大事だと捉えております。その上で、細やかな連携支援を行ってまいりたい"@ja.
<< kg:id_99 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "小学校21校と特別支援学校にアーティストが直接、またはコロナの関係で一部リモートというのもありましたが、訪問いたしまして、ピアノやバイオリン、ダンスで子供たちと交流するというアウトリーチ事業を行った"@ja.
<< kg:id_99 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "令和４年度につきましては、声楽、サックス、チェロとアウトリーチ事業を拡充するとともに、文化芸術の鑑賞機会の拡大を図るために、支所地域でのコンサートも計画している"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "道徳、教科として今、実際に授業されております。ヒーローは殴ってもいいのに、僕たちはたたいちゃいけないのか、あなたはどう思うかみたいな、もう小学校の低学年でもこんなことをやっておりました"@ja.
}
