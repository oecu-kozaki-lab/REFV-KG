kg:st_1 rdfs:label "江口暢子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "防災・減災のまちづくりは市民の命と財産を守る上で重要と再認識"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "日本防災士会会長 室崎益輝先生"@ja.
kg:st_2 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_2 prop:content "被災者の希望を反映し地域コミュニティを維持した対応を評価"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "共助が発揮された災害対応だった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "酒田大火の災害対応から学ぶことが多い"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "酒田大火を知らない世代が増え風化を懸念"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_3 rdfs:label "本市出身の歌手 白崎映美さん"@ja.
kg:st_3 rdf:type cls:st_62.
cls:st_62 rdfs:label "歌手"@ja.
kg:op_6 prop:content "支援を受けた経験が今度は自分が応援する原動力"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "事前周知を強化し防災意識向上につなげるべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_4 rdfs:label "那須欣男総務部危機管理監"@ja.
kg:st_4 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_8 prop:content "LINEやSNSを活用した情報発信を検討する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "後世の市民に防災のバトンを渡す場所であってほしい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_5 rdfs:label "池田里枝教育次長"@ja.
kg:st_5 rdf:type cls:st_32.
kg:op_10 prop:content "大火資料の常設展示を継続する方向で準備する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "観光客は土地勘や情報が乏しく災害弱者になり得る"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "スピード感を持って進めるべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "観光客だけでなく観光事業者の不安払拭のため有効"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "早急な配備が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:st_6 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_6 rdf:type cls:st_32.
kg:op_15 prop:content "品不足だが速やかな配備を進めたい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:op_16 prop:content "車中避難のリスク周知を強化すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "特別事情のある避難者には声がけや代替策検討が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "職員協働で共通認識を持つBCPにすべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:st_7 rdfs:label "斎藤周議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_19 prop:content "過剰受診を理由に無料化を抑制すべきではなく早期発見早期治療の視点が必要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_7.
kg:op_20 prop:content "通勤時間短縮は家事子育て参加や余暇充実につながる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_7.
kg:op_21 prop:content "テレワークに適したインフラ整備が全国2位評価につながった"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:st_8 rdfs:label "齋藤一志教育次長"@ja.
kg:st_8 rdf:type cls:st_32.
kg:op_22 prop:content "持続可能な部活動に向け丁寧な議論が必要"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_8.
kg:st_9 rdfs:label "安藤浩夫議員"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_23 prop:content "市民満足度とのバランスを見た適正配置が重要"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_9.
kg:st_10 rdfs:label "竹越攻征総務部長"@ja.
kg:st_10 rdf:type cls:st_32.
kg:op_24 prop:content "削減ありきでなくニュートラルな議論が必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_10.
kg:op_25 prop:content "役職定年後も生かせる新しいポスト設計が鍵"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_10.
kg:op_26 prop:content "攻めの経営への転換が業績拡大につながっている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_9.
kg:op_27 prop:content "コーディネーター力の養成が経営安定の重要課題"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_9.
kg:st_11 rdfs:label "宮崎和幸企画部長"@ja.
kg:st_11 rdf:type cls:st_32.
kg:op_28 prop:content "近隣市町村とともに大きな課題として議論が必要"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_11.
kg:st_12 rdfs:label "本間義紀企画部デジタル変革調整監"@ja.
kg:st_12 rdf:type cls:st_32.
kg:op_29 prop:content "健康寿命延伸につながるよう詳細検討を進めたい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_12.
kg:st_13 rdfs:label "丸山市長"@ja.
kg:st_13 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_30 prop:content "撤退が決まってからでは遅く地域にとって重い事案"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_13.
kg:op_31 prop:content "発電事業者立地により電気代金収支は黒字と評価"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_13.
kg:st_14 rdfs:label "大壁洋平議員"@ja.
kg:st_14 rdf:type cls:st_16.
kg:op_32 prop:content "地産地消に加え地産他消の視点が必要"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_14.
kg:op_33 prop:content "酒田天然ガスとの公民連携で前進の道を模索する余地がある"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_13.
kg:op_34 prop:content "CO2削減だけで議論するのは適切でない"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_13.
kg:op_35 prop:content "製品性能や費用対効果や農業者意向を見て判断する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_13.
kg:op_36 prop:content "山形県の事例も参考に少し勉強していく必要がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_13.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本市で震度５弱、夜間の長い揺れと余震に不安な夜を迎えた方々が多かったことと思います。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "昭和51年10月29日の午後５時40分頃出火した炎は、西からの強風によって商店街から住宅地へと拡大しました。"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:text-txt_contents "この大火では当時の消防長がお亡くなりになりました"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:text-txt_contents "当時1,023世帯の3,300人が罹災して避難生活を余儀なくされました。"@ja.
<< kg:id_3 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "仮設住宅は被災者の強い希望を反映して、被災地に近い中央公民館グラウンドなど６か所に建設されている。"@ja.
<< kg:id_3 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "そのため、地域コミュニティが破壊されずに、被災者の助け合いや復興の相談がスムーズにできている。災害に最も重要とされる共助が酒田大火では発揮されたのだということです。"@ja.
<< kg:id_3 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "この災害対応から学ぶことが多く、酒田大火から40年後に起きた糸魚川大火でも復興の参考にしたと伺っております。"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "しかしながら、45年が経過し、市民の中にも職員の中にも酒田大火を知らない世代が増えてきました。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "全国の多くの方から支援をいただいたことが現在の活動の原動力になって、今度は自分が応援するのだとおっしゃっています。また、東日本大震災で避難してきた方々を酒田で受入れした際に、酒田大火でお世話になった恩返しがしたいとボランティアに動いた多くの市民がいた"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:text-txt_contents "１つは消防力の強化であります。"@ja.
<< kg:id_3 prop:cause kg:id_16 >>
    prop:text-txt_contents "酒田大火では台風並みの暴風の中"@ja.
<< kg:id_3 prop:effect kg:id_17 >>
    prop:text-txt_contents "消防隊の放水は霧と化し"@ja.
<< kg:id_3 prop:effect kg:id_18 >>
    prop:text-txt_contents "急激に燃え広がる火災範囲に対応する消防隊数が不足するなど"@ja.
<< kg:id_3 prop:effect kg:id_19 >>
    prop:text-txt_contents "当時の想定を大幅に上回る災害に十分な消防力を発揮することができなかった。"@ja.
<< kg:id_20 prop:countermeasure kg:id_21 >>
    prop:text-txt_contents "この教訓を受けて、消防組織においては消防職員の増員と"@ja.
<< kg:id_20 prop:countermeasure kg:id_22 >>
    prop:text-txt_contents "消防車両や各資機材の増強を図ってまいりました。"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:text-txt_contents "強風時の火災防御戦術の見直しを行い、従来の風下防御隊形から炎を挟み込んで迎え撃つ挟撃防御の隊形及び大口径ノズルを使用した大量放水戦術へと防御の態勢の強化を図りました。"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:text-txt_contents "大規模な災害が発生した場合に迅速な消防力の増強と協力が図られるように山形県内各市町村と広域応援協定が整備されました。"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:text-txt_contents "今でも風の強い日は、消防車両が警鐘を鳴らしながら巡回する防火広報を行い、出火防止の呼びかけを行っております。"@ja.
<< kg:id_14 prop:countermeasure kg:id_29 >>
    prop:text-txt_contents "２つ目に、大火の教訓を踏まえ、燃えにくいまちづくり・災害に強いまちづくりに努めてまいりました。"@ja.
<< kg:id_30 prop:countermeasure kg:id_31 >>
    prop:text-txt_contents "具体的には、幅広い道路網や公園・緑地等の整備"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:text-txt_contents "商店街では延焼拡大の原因となったアーケード方式から、国内初となるセットバック方式が採用され、防火・防災対策を強化するとともに"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:text-txt_contents "消防水利の増設が行われました。"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:text-txt_contents "３つ目は、自主防災組織の対応力の強化であります。各地区に結成されている自主防災組織においては、発災対応型の防災訓練を通して地域の防災力の向上が図られております。"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "毎年、防火の誓いを新たにすべく、大火発生時間の10月29日午後５時50分に市役所屋上の防災行政無線によりサイレンを鳴らしております。"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:text-txt_contents "各小学校の避難訓練時や社会科の授業"@ja.
<< kg:id_40 prop:countermeasure kg:id_42 >>
    prop:text-txt_contents "教育委員会で新たに作成した電子版防災ハンドブックなどにより酒田大火を取り上げ"@ja.
<< kg:id_40 prop:countermeasure kg:id_43 >>
    prop:text-txt_contents "新消防本部においては、酒田大火の写真パネルを常設し、小学生などの見学者に対し当時の災害状況の説明を行っております。"@ja.
<< kg:id_40 prop:countermeasure kg:id_44 >>
    prop:text-txt_contents "酒田市資料館においても酒田大火に関する資料の常設展示を行っております。"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "酒田大火については、大火から45年以上が過ぎ、大火の記憶を風化させず真の防災意識を高めるように、文化資料館（仮称）でも引き続き常設展示として来館者に紹介していきたいと考えております。"@ja.
<< kg:id_47 prop:effect kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "指定管理者が作成した災害実態と活動状況の把握、関係機関との連携を定めた危機管理規程はあるものの、観光客の避難・誘導のためのマニュアルとはなっていないのが事実であります。"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:text-txt_contents "風水害、地震、津波、それぞれの災害別の避難場所などの情報を交流観光課が提供して、災害対応マニュアルとなるよう改定を支援・指導しているところでございます。"@ja.
<< kg:id_51 prop:countermeasure kg:id_52 >>
    prop:text-txt_contents "酒田花火ショー開催時には、津波発生を想定した避難ルートについて複数回アナウンスし、安全確認を行う"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:text-txt_contents "外国人観光客に対しまして、災害情報を提供するため、英語、中国語のみとなりますが、避難指示の有無などの災害情報を記載したファクスを観光施設に送信し、掲示してもらう仕組みを整えております。"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:text-txt_contents "災害時に被害状況などを一斉に共有するといった連携体制がないこと"@ja.
<< kg:id_55 prop:effect kg:id_57 >>
    prop:text-txt_contents "災害情報の多言語対応などが挙げられております。"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:text-txt_contents "飛島に渡る観光客が避難場所を確認し、自主的に避難できるよう、危機管理課が災害避難の周知動画を作成しており、この動画に英語の字幕をつけて、定期船とびしまで今後上映する予定であります。"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:text-txt_contents "クルーズ船寄港時に、避難場所を示す看板を乗客向けに多言語で掲示するといった取組を行ってきました。"@ja.
<< kg:id_49 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "観光施設や観光事業者との災害情報の共有・連携体制を構築するため、議員御指摘の観光防災マニュアルの策定は大変有効なものと考えております。今後、観光庁が示している自治体・観光関連事業者等における観光危機管理推進のための手引書を基に、策定に向けて準備を進めていく"@ja.
<< kg:id_63 prop:effect kg:id_64 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "観光施設に防災ラジオというのは配備されているのでしょうか。現在、対応はしておりません。"@ja.
<< kg:id_65 prop:effect kg:id_66 >>
    prop:text-txt_contents "車中避難については、道路損壊や家屋倒壊で避難所まで到達できない場合があること。"@ja.
<< kg:id_65 prop:effect kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "避難所までの道のりで交通渋滞を起こし、緊急車両の妨げになること。"@ja.
<< kg:id_65 prop:effect kg:id_68 >>
    prop:text-txt_contents "避難所での駐車スペースが限られること。"@ja.
<< kg:id_65 prop:effect kg:id_69 >>
    prop:text-txt_contents "車内の長時間滞在によるエコノミー症候群の発症危険があること。"@ja.
<< kg:id_65 prop:effect kg:id_70 >>
    prop:text-txt_contents "食料等の物資が配達されない可能性がある"@ja.
<< kg:id_65 prop:countermeasure kg:id_71 >>
    prop:text-txt_contents "様々な弊害があるため、車中避難の推奨はしておりません。"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "病気など他の避難者と同じ避難所で過ごすことができない等、特別な事情がありやむを得ず車中避難をする方については、一定の配慮が必要であると考えております。"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:text-txt_contents "新型コロナウイルス感染症に関する業務継続計画は、全庁的な項目については令和２年６月に策定をしております。"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:text-txt_contents "各所属の部課長が実態に合わせて、詳細な業務継続要領を作成しているところでございます。"@ja.
<< kg:id_78 prop:countermeasure kg:id_79 >>
    prop:text-txt_contents "年間を通した優先すべき業務の順位づけ"@ja.
<< kg:id_78 prop:countermeasure kg:id_80 >>
    prop:text-txt_contents "職員欠員時における業務の分担"@ja.
<< kg:id_78 prop:countermeasure kg:id_81 >>
    prop:text-txt_contents "密を避けるための分散勤務方法などが記され"@ja.
<< kg:id_74 prop:cause kg:id_82 >>
    prop:text-txt_contents "新型インフルエンザに感染することで休暇を取得する職員の想定は大体５％でありますが、感染した家族の看護などの理由を含めると最大40％に達すると示されております。"@ja.
<< kg:id_83 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "業務継続計画の現状に即した修正が必要であると考えており"@ja.
<< kg:id_83 prop:countermeasure kg:id_85 >>
    prop:text-txt_contents "内容としては、業務の優先順位の見直し"@ja.
<< kg:id_83 prop:countermeasure kg:id_86 >>
    prop:text-txt_contents "所属の垣根を越えた業務継続のための代替要員の確保"@ja.
<< kg:id_83 prop:countermeasure kg:id_87 >>
    prop:text-txt_contents "感染予防対策の再確認など、できるだけ対策を積み上げ確実に実行できるようにしていく所存"@ja.
<< kg:id_88 prop:countermeasure kg:id_89 >>
    prop:text-txt_contents "庁舎内分散については推奨しないと、基本的に実施しない"@ja.
<< kg:id_88 prop:countermeasure kg:id_90 >>
    prop:text-txt_contents "自宅で勤務をするということは全然やりますよと、あとリモート会議はやりますよ"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:text-txt_contents "主な未収事由につきましては、低収入または収入が不安定である"@ja.
<< kg:id_91 prop:cause kg:id_93 >>
    prop:text-txt_contents "自営業が不振であるといった経済的な事由"@ja.
<< kg:id_91 prop:cause kg:id_94 >>
    prop:text-txt_contents "これにはコロナ禍による経済低迷の要因も含まれます。"@ja.
<< kg:id_91 prop:cause kg:id_95 >>
    prop:text-txt_contents "納付意識の欠如でありますとか"@ja.
<< kg:id_91 prop:cause kg:id_96 >>
    prop:text-txt_contents "保護者の金銭管理意識の欠如といったものがある"@ja.
<< kg:id_97 prop:effect kg:id_98 >>
    prop:text-txt_contents "無料化の対象を18歳まで拡大するには新たに約6,400万円の財源が必要"@ja.
<< kg:id_99 prop:effect kg:id_100 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "過剰な受診の増加による保険者等の財政への影響も懸念される"@ja.
<< kg:id_101 prop:cause kg:id_102 >>
    prop:text-txt_contents "新型コロナウイルス感染症による環境の変化で、企業が地方に本社機能を移転するメリットが大きくなり、デメリットが小さくなった"@ja.
<< kg:id_101 prop:effect kg:id_103 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "この地方移転は、従業員のワーク・ライフ・バランスの改善にも寄与しています。"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:text-txt_contents "新型コロナウイルス感染症拡大により、都市圏の企業を中心にテレワークの導入が進み"@ja.
<< kg:id_106 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "官民挙げて観光施設や拠点施設などへＷｉ－Ｆｉ整備、民間のコワーキングスペース及びシェアオフィスや、酒田市産業振興まちづくりセンターサンロクといったテレワークに適したインフラ整備を進めてきた"@ja.
<< kg:id_106 prop:countermeasure kg:id_108 >>
    prop:text-txt_contents "立地後も立地企業との情報を密にしまして、市内企業との関係性も高めながら立地企業の着実な成長を支えていきたい"@ja.
<< kg:id_109 prop:cause kg:id_110 >>
    prop:text-txt_contents "中学校で特に大きな要因は部活動指導でございます。"@ja.
<< kg:id_109 prop:cause kg:id_111 >>
    prop:text-txt_contents "長時間勤務につながるもう一つの要因として、勤務時間外の保護者の方々との連絡、保護者対応が挙げられます。"@ja.
<< kg:id_109 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "現在、休日の部活動における地域への移行を踏まえながら部活動の在り方について検討を行っているところです"@ja.
<< kg:id_109 prop:countermeasure kg:id_113 >>
    prop:text-txt_contents "部活動指導員、現在、各校315時間の予算措置を行っているわけですが、県に対しても予算措置の拡充を求めております"@ja.
<< kg:id_114 prop:effect kg:id_115 >>
    prop:text-txt_contents "なかなか生活リズムをつくれずに乱れから学校が不登校気味になってしまうというような生徒も一定程度おります"@ja.
<< kg:id_116 prop:countermeasure kg:id_117 >>
    prop:text-txt_contents "ＰＴＡの懇談会であるとか研修会によっても積極的に周知を図っていくことを確認しております。整備が進んでいるオンラインを活用した懇談の場を設定するなど"@ja.
<< kg:id_118 prop:countermeasure kg:id_119 >>
    prop:text-txt_contents "安全管理においては、学校防災マニュアルの整備と改善が大きな柱でございます。"@ja.
<< kg:id_118 prop:countermeasure kg:id_120 >>
    prop:text-txt_contents "山形大学の村山良之教授と鶴岡工業高等専門学校の澤祥教授に防災アドバイザーを御委嘱しまして、各校のマニュアルについて御助言を得ながら整備と改善に努めております。"@ja.
<< kg:id_121 prop:countermeasure kg:id_122 >>
    prop:text-txt_contents "今年度、電子版酒田防災ハンドブックを作成いたしました。"@ja.
<< kg:id_123 prop:countermeasure kg:id_124 >>
    prop:text-txt_contents "安全・安心メールを管理職職員の個人端末からも発信できるようにしたり"@ja.
<< kg:id_123 prop:countermeasure kg:id_125 >>
    prop:text-txt_contents "災害発生時に地域の誰から情報を得るのかといった具体的な防災マニュアルの改善を図った"@ja.
<< kg:id_123 prop:countermeasure kg:id_126 >>
    prop:text-txt_contents "下校途中に災害が発生したらどうする？などと問いかけて、子供自身が主体的に判断し行動できるように指導するなど、自分の命を自分で守っていく力を育てていく"@ja.
<< kg:id_127 prop:effect kg:id_128 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "定員適正化により常勤職員数が減少している一方で、行政需要は多様化、複雑化しており、それに対応すべく１人当たりの業務量は増加し"@ja.
<< kg:id_129 prop:cause kg:id_130 >>
    prop:text-txt_contents "人口減少に伴い税収の伸び悩みや地方交付税の減少が考えられ"@ja.
<< kg:id_131 prop:countermeasure kg:id_132 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "課ごと、部ごとに積み上げ算をしていって、じゃ市役所全体では何人になるのか、こういった定量的な分析をした上で、業務量に応じた職員数の増減を検討する視点も必要"@ja.
<< kg:id_133 prop:countermeasure kg:id_134 >>
    prop:text-txt_contents "現行60歳の定年を令和５年度から令和13年度にかけて段階的に引き上げて65歳とする"@ja.
<< kg:id_133 prop:countermeasure kg:id_135 >>
    prop:text-txt_contents "60歳を超える職員につきましては、60歳時点の７割水準とすることが当面の措置"@ja.
<< kg:id_133 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "管理職につく職員は原則として60歳で非管理職へ異動させる"@ja.
<< kg:id_137 prop:effect kg:id_138 >>
    prop:text-txt_contents "請負受託事業がメインでございまして…この形態での売上というのは年々減少傾向となっておりました。"@ja.
<< kg:id_139 prop:countermeasure kg:id_140 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "派遣型と言われます、シルバー人材センターの会員を発注者の事業所に派遣する形態、これを取り入れてまいりました。さらに…派遣先は介護事業所のようなものはどうかというアドバイス"@ja.
<< kg:id_141 prop:countermeasure kg:id_142 >>
    prop:text-txt_contents "学童保育所に派遣するといった形も取り入れておりまして"@ja.
<< kg:id_143 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "シルバー人材センター職員のコーディネート力の増強ということでございます。"@ja.
<< kg:id_143 prop:countermeasure kg:id_145 >>
    prop:text-txt_contents "４時間・４時間に分けてお二人の会員に仕事をシェアしてもらったり、あるいは自分は２時間がいいということであれば、残りの６時間をどなたかとマッチングしたり"@ja.
<< kg:id_146 prop:effect kg:id_147 >>
    prop:text-txt_contents "最終処分場の埋立残容量が少なくなっている状況でございます。"@ja.
<< kg:id_146 prop:countermeasure kg:id_148 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "最終処分場の今後の在り方につきましては…庄内町、遊佐町とともに大きな課題として検討していく必要"@ja.
<< kg:id_149 prop:countermeasure kg:id_150 >>
    prop:text-txt_contents "ごみ処理施設の延命化のためには、紙類資源の適切な分別ですとか廃プラスチックのリサイクルを含めて、ごみの排出量の削減に努めることも課題"@ja.
<< kg:id_151 prop:effect kg:id_152 >>
    prop:text-txt_contents "これからまた大規模改修ですとか機器の更新なんかでお金もいっぱいかかってきます。"@ja.
<< kg:id_151 prop:countermeasure kg:id_153 >>
    prop:text-txt_contents "やはり利用率をどう上げるか…やはり庄内のブランドとしてもっとブランド力を高めて全国にいいものを出していけば"@ja.
<< kg:id_154 prop:cause kg:id_155 >>
    prop:text-txt_contents "やはり自治体で同じことをやっていては、効率が悪いというのは当然"@ja.
<< kg:id_154 prop:countermeasure kg:id_156 >>
    prop:text-txt_contents "中心市が主体となって１か所に集めてやるですとか、そういった効率的なことをやっていくのは当たり前"@ja.
<< kg:id_157 prop:effect kg:id_158 >>
    prop:text-txt_contents "時間や場所を選ばずにサービスを受けられること"@ja.
<< kg:id_159 prop:countermeasure kg:id_160 >>
    prop:text-txt_contents "人口減少が進む中、より多くの利用者を確保するためには、市町村が連携し、広域で取り組むことが重要"@ja.
<< kg:id_161 prop:countermeasure kg:id_162 >>
    prop:text-txt_contents "本市のＰＨＲサービスと、それからちょうかいネットが有する電子カルテなどのデータとの連携"@ja.
<< kg:id_161 prop:countermeasure kg:id_163 >>
    prop:text-txt_contents "酒田市のＰＨＲとしても、マイナポータルの連携というものも考えております。"@ja.
<< kg:id_161 prop:countermeasure kg:id_164 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "体重の増減が激しいとか、いろいろな異常値が出た場合にスマホのほうに…注意機能を出すことで、健康な方向に市民を誘導してまいりたい、行動変容を起こしていきたい"@ja.
<< kg:id_165 prop:cause kg:id_166 >>
    prop:text-txt_contents "ＣＯ２を多く排出する非効率的な石炭火力発電所を休廃止する政府の方針"@ja.
<< kg:id_167 prop:effect kg:id_168 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "酒田共同火力発電所の存廃が注目されている状況です。丸山市長も休廃止は酒田市の雇用と経済に甚大なる影響を与える"@ja.
<< kg:id_169 prop:countermeasure kg:id_170 >>
    prop:text-txt_contents "親会社であります東北電力株式会社ですとか、あるいは経済産業省も含めて、今後どうなるんだということで、もしそれに代わる事業展開等がないのかということで、直接私も出向いて御相談をし、アドバイスも頂戴をしてきた"@ja.
<< kg:id_169 prop:countermeasure kg:id_171 >>
    prop:text-txt_contents "県知事にもお話をさせていただきましたし、一緒に地元として、特に酒田港を有する地元として、県と一緒にその存続に向けた動きを取らせていただいた"@ja.
<< kg:id_172 prop:effect kg:id_173 >>
    prop:text-txt_contents "他県の発電所の発電量を増やしたり、あるいは他の地域から電力を融通するといった形で供給するだろう"@ja.
<< kg:id_174 prop:countermeasure kg:id_175 >>
    prop:text-txt_contents "平成７年に…太陽の家という施設で太陽光発電を導入"@ja.
<< kg:id_174 prop:countermeasure kg:id_176 >>
    prop:text-txt_contents "平成12年には上田コミュニティ防災センターでも太陽光発電を取り入れています"@ja.
<< kg:id_174 prop:countermeasure kg:id_177 >>
    prop:text-txt_contents "東北公益文科大学の屋根にも太陽光発電システムが搭載"@ja.
<< kg:id_174 prop:countermeasure kg:id_178 >>
    prop:text-txt_contents "平成14年からごみ焼却の余熱を利用して発電に取り組んでおりまして、現在も自家消費を除く余剰電力を売電"@ja.
<< kg:id_179 prop:countermeasure kg:id_180 >>
    prop:text-txt_contents "平成16年に風力発電施設建設ガイドラインを酒田市としては策定"@ja.
<< kg:id_174 prop:countermeasure kg:id_181 >>
    prop:text-txt_contents "昨年４月からは…十里塚風力発電所の運転を開始"@ja.
<< kg:id_174 prop:countermeasure kg:id_182 >>
    prop:text-txt_contents "昨年９月からは、市のクリーンセンターにおいて、下水道汚泥の分解過程で発生する消化ガスを利用して発電"@ja.
<< kg:id_174 prop:countermeasure kg:id_183 >>
    prop:text-txt_contents "木質ペレットなどを燃料とする50メガワットのバイオマス発電所が稼働"@ja.
<< kg:id_174 prop:countermeasure kg:id_184 >>
    prop:text-txt_contents "酒田北港地区では約28メガワットの太陽光発電所も稼働中"@ja.
<< kg:id_174 prop:countermeasure kg:id_185 >>
    prop:text-txt_contents "花王株式会社では、酒田工場にグループ最大規模となる自家消費型の太陽光発電設備を設置"@ja.
<< kg:id_174 prop:countermeasure kg:id_186 >>
    prop:text-txt_contents "八幡地区では…小水力発電所が平成30年より稼働"@ja.
<< kg:id_174 prop:countermeasure kg:id_187 >>
    prop:text-txt_contents "畜産系バイオマス、牛のふん尿ですね、これを利用したバイオガス発電設備を併設して"@ja.
<< kg:id_188 prop:effect kg:id_189 >>
    prop:text-txt_contents "本市ではエネルギー代金の支払いによりまして、約69億円を域外に流出しているという分析結果"@ja.
<< kg:id_190 prop:effect kg:id_191 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "本市は逆に約56億円が流入をしているまちでございます。これは、本市には酒田共同火力発電株式会社を初めとした発電事業者…が多く立地しているため"@ja.
<< kg:id_192 prop:countermeasure kg:id_193 >>
    prop:text-txt_contents "我々の持っている公共施設の電気料金を削減する"@ja.
<< kg:id_192 prop:countermeasure kg:id_194 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "エネルギーの地産地消"@ja.
<< kg:id_192 prop:countermeasure kg:id_195 >>
    prop:text-txt_contents "地域経済の循環、地元でお金を回す"@ja.
<< kg:id_192 prop:countermeasure kg:id_196 >>
    prop:text-txt_contents "地域の低炭素化。この４つの行政課題に取り組む上で"@ja.
<< kg:id_192 prop:effect kg:id_197 >>
    prop:text-txt_contents "需給バランスが逼迫をして、電力の市場価格が高騰したことから破綻した新電力会社があった"@ja.
<< kg:id_192 prop:effect kg:id_198 >>
    prop:text-txt_contents "ロシアのウクライナ侵攻の影響を受けまして、世界的に原油ですとか液化天然ガスの相場が高騰し続けております。そういう環境の中でいきますと、新電力会社の電力調達コスト、これがさらに経営を圧迫"@ja.
<< kg:id_192 prop:countermeasure kg:id_199 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "洋上風力発電など、この大型の再生可能エネルギーが地域に導入されるタイミングで、酒田市内に本社機能を置くことを前提にした民間事業者主体の新電力会社設立については検討する余地がある"@ja.
<< kg:id_200 prop:effect kg:id_201 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "短期、中期的にはやはり産業を維持するという面で非常に大きな課題がある"@ja.
<< kg:id_202 prop:countermeasure kg:id_203 >>
    prop:text-txt_contents "本市では、今、地球温暖化対策の推進に関する法律に定めます地球温暖化対策実行計画の区域施策編という計画の策定に向けて、今検討を進めているところ"@ja.
<< kg:id_204 prop:countermeasure kg:id_205 >>
    prop:text-txt_contents "酒田港において、本市と国土交通省、山形県及び地元企業が連結をして、酒田港カーボンニュートラルポート形成方針の素案をまとめた"@ja.
<< kg:id_204 prop:countermeasure kg:id_206 >>
    prop:text-txt_contents "来年度はカーボンニュートラルポート形成計画という形の計画書の策定に向けて"@ja.
<< kg:id_207 prop:countermeasure kg:id_208 >>
    prop:text-txt_contents "炭素貯留効果の高い有機農業を実施していた場合は、10アール当たり１万4,000円の交付金"@ja.
<< kg:id_209 prop:countermeasure kg:id_210 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "バイオ炭、木骨ハウス、生分解性鮮度保持包装、これらについて…将来的にはこういった取組は大切"@ja.
<< kg:id_211 prop:countermeasure kg:id_212 >>
    prop:text-txt_contents "農業経営の改善がやはり期待される…本市としても、そうした取組に係る情報収集を十分に行って"@ja.
<< kg:id_211 prop:effect kg:id_213 >>
    prop:text-txt_contents "固定価格が年々下がってきておりまして、安定的な収益性の確保がやはり困難になってきている"@ja.
<< kg:id_214 prop:countermeasure kg:id_215 >>
    prop:text-txt_contents "ハウスの加湿器を化石燃料から木質バイオマスやヒートポンプに切り替えて二酸化炭素を削減し、クレジットとして売却"@ja.
<< kg:id_214 prop:effect kg:id_216 >>
    prop:text-txt_contents "市が国から地域版クレジットの認証機関として承認を受けるには、専門的な知識を持つ人材の確保ですとか、運営経費などの課題"@ja.
<< kg:id_214 prop:countermeasure kg:id_217 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "市によるクレジットの取りまとめということで…プログラム型と呼ばれている…山形県のやまがた太陽と森林の会の例も参考にしながら、少し勉強していく必要がある"@ja.
}
