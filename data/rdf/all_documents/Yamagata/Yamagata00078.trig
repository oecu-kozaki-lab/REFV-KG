<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本案は、企業立地の促進を図るため、用地取得助成金の適用期限等を延長すること及び交付要件を変更することなど、所要の改正を行うものであり"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "用地取得助成金の適用期限等を延長すること"@ja.
<< kg:id_23 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
