    prop:text-txt_contents "交付要件を変更すること"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "建築物のエネルギー消費性能の向上に関する法律及び都市の低炭素化の促進に関する法律に規定する認定基準の一部改正に伴い"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "認定申請手数料を定めるなど、所要の改正を行うものであり"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地方公営企業法及び地方公営企業法施行令の規定に基づき、上下水道事業に管理者を置かないものとするため"@ja.
<< kg:id_31 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "上下水道事業に管理者を置かないものとするため、関係条例を整備するものであり"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "市の行政組織の変更に伴い、文化及び文化財の保護に関する事務を市長部局で管理し執行するため"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_4;
