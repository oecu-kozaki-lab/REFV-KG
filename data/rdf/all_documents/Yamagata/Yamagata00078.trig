kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_1 prop:content "医療提供体制や感染予防、行動制限の変更など大きな変化を見込む"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "価格上昇で地域産業と市民生活が大きな影響を受けていると認識"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "市民要望への対応と財政健全化の調和が重要課題だとする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "財政の厳しさが増しており対応の調和が必要と述べる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "武田恵子予算特別委員会委員長"@ja.
kg:st_2 rdf:type cls:st_36.
cls:st_36 rdfs:label "委員長"@ja.
kg:op_5 prop:content "市指定管理施設の安定運営のため減収補填を行う補正を妥当とした"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "電気料金上昇の影響を受ける農業用水利施設の管理者支援を妥当とした"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "観光物産施設の減収補填のため委託料増額を妥当とした"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "落雷による故障対応の修繕費計上を妥当とした"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "故障した防災行政無線の修繕費計上を妥当とした"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "指定管理施設への委託料増額を妥当とした"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "後年度負担軽減のため繰上償還を実施する補正を妥当とした"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:st_3 rdfs:label "安藤浩夫建設経済常任委員会委員長"@ja.
kg:st_3 rdf:type cls:st_36.
kg:op_12 prop:content "企業立地促進のための改正を妥当と認めた"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "用地取得助成金の期限延長を含む改正を妥当と認めた"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "交付要件の変更を含む改正を妥当と認めた"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "法改正に伴う認定申請手数料設定を妥当と認めた"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "認定申請手数料を定める改正を妥当と認めた"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "法令に基づく条例整備を妥当と認めた"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "管理者を置かないことに伴う関係条例整備を妥当と認めた"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:st_4 rdfs:label "齋藤美昭総務常任委員会委員長"@ja.
kg:st_4 rdf:type cls:st_36.
kg:op_19 prop:content "行政組織変更に伴う条例制定を妥当と認めた"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "文化及び文化財の保護事務を市長部局で管理執行する条例制定を妥当と認めた"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "行政組織変更に伴う改正を妥当と認めた"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "資料の保存と活用を一元的に所掌する改正を妥当と認めた"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "一元的所掌のため機能統合を行う改正を妥当と認めた"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "寒波による除雪費不足への専決処分を妥当と認めた"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "除雪費不足への専決対応を承認すべきとした"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "事業費調整等を主因とする補正を妥当と認めた"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "基金廃止に伴う補正を妥当と認めた"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "市債繰上償還を含む補正を妥当と認めた"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "大学と企業の協働でデジタル人材育成と不足解消を進める"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "児童生徒数減少を踏まえ新しい学校づくりに取り組む"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "義務教育環境の在り方を協議し新しい学校づくりを進める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "相談体制と関係職の連携を強化して対応する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "端末を活用して児童生徒がSOSを出しやすい仕組みを整える"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "中小企業の経営安定化と地域経済活性化のため支援を継続する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "採用支援や見学ツアーなどで人手不足解消と定着を図る"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "見学ツアー等で若者の地元定着を図る"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "資源循環を進める仕組みづくりを進める"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "高齢化で農地管理体制が弱まる中で省力化事業を進める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "弱体化する農地管理体制に対応して省力化事業を進める"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "基金を活用し4年連続で国民健康保険税率を引き下げる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "安心して子育てできるよう医療費無償化の対象を拡大する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "給食費値上げ負担を軽減するため交付金を活用する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "妊娠期から出産・子育てまで一貫した相談体制を構築する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "結婚希望をかなえるため相談と仲介支援を行う"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "重症化予防のため個別相談と指導を強化する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "老朽化や人材高齢化の課題から今後の在り方を協議する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "老朽化や医療従事者高齢化を課題として在り方協議を進める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "関係機関と休日診療所の今後の在り方を協議する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "地域医療人材確保のため授業料減免を行う"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "転入学生への家賃助成で人材確保を図る"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "市内就業と定着促進のため卒業支援金を支給する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "多様な主体をつなぎ地域運営を支援する役割を配置する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "再生可能エネルギー循環都市実現に向け実行計画策定を進める"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "家庭のエネルギー地産地消を進めるため独自支援を創設する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "地域住民と防災関係機関、市が連携する体制強化を進める"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "災害時の情報伝達体制強化のため中継局を整備する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "管理不全空き家への適正管理と発生抑制に取り組む"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "空き家対策計画に基づき適正管理と発生抑制を進める"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "体験試乗会などにより公共交通の利用増加を図る"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "子供無料キャンペーンなどで乗船者増加を図る"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "民間事業者と連携して離島課題の解決につなげる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:op_62 prop:content "地域に活力を生み出すため高速道路整備を働きかける"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "高校生などの利便性向上のため屋根付き駐輪場を整備する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:op_64 prop:content "入居要件見直しで若年単身者やUIJターン就職予定者も対象にする"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "国の総合戦略実現に向け総合戦略を改訂しデジタル実装を進める"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_1.
kg:op_66 prop:content "マイナンバーカード交付申請しやすいよう出張窓口等を継続する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_1.
kg:op_67 prop:content "質の高い行政サービスを維持しつつ職員数と総人件費の縮減を進める"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "市民意見を踏まえて公共施設適正化を進める"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_1.
kg:op_69 prop:content "投資的経費増は主要事業の進捗に伴うものと説明する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_1.
kg:op_70 prop:content "投資的経費増は保育所整備事業などの進捗に伴うものと説明する"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_1.
kg:op_71 prop:content "投資的経費増は学校長寿命化事業などの進捗に伴うものと説明する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
kg:op_72 prop:content "投資的経費増は国体記念体育館改修事業などの進捗に伴うものと説明する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_1.
kg:op_73 prop:content "義務的経費の減は退職手当減などによると説明する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_1.
kg:op_74 prop:content "扶助費減は少子化の影響等によると説明する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_1.
kg:op_75 prop:content "公債費増は松山小学校改修等に伴う償還開始によると説明する"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_1.
kg:op_76 prop:content "物件費減はシステム関連委託料の減などによると説明する"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_1.
kg:op_77 prop:content "物件費減はデジタル変革事業の委託料減などによると説明する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_1.
kg:op_78 prop:content "補助費等減は農業支援交付金事業の減などによると説明する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_1.
kg:op_79 prop:content "補助費等減は下水道事業運営負担金の減などによると説明する"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_1.
kg:op_80 prop:content "貸付金減は地域総合整備資金貸付金の減によると説明する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_1.
kg:op_81 prop:content "所期の目的を達成したため土地開発基金を廃止する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_1.
kg:op_82 prop:content "目的達成により基金廃止を行う"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_1.
kg:op_83 prop:content "子育て支援のため特別休暇を拡充する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_1.
kg:op_84 prop:content "放課後児童支援員等の配置に関する特例を定める"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_1.
kg:op_85 prop:content "法令改正に伴い支給額改正を行う"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_1.
kg:op_86 prop:content "被保険者の負担軽減を図るため税額改定を行う"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_1.
kg:op_87 prop:content "被保険者負担軽減を目的に税改定を行う"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_1.
kg:op_88 prop:content "無電柱化推進計画策定に伴い徴収方法を定める"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_1.
kg:op_89 prop:content "無電柱化推進に伴う占用料徴収方法を定める"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_1.
kg:op_90 prop:content "市営住宅の入居要件と承継要件を緩和する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_1.
kg:op_91 prop:content "市営住宅の目的外使用期間を見直す"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "医療の提供体制、日常生活での感染予防や行動制限の変更など、新型コロナウイルス感染症への対応は新年度に大きな変化が予測されます。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "コロナ禍に加え、エネルギーや原材料などの価格上昇によって、地域産業や市民生活は大きな影響を受けています。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本市の財政運営においては、公債費や公共施設の維持管理経費の増加などによって厳しさが増しており、市民要望への対応と財政健全化をいかに調和させるかが、これまでにない重要課題となっています。"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "本市の財政運営においては、公債費や公共施設の維持管理経費の増加などによって厳しさが増しており、市民要望への対応と財政健全化をいかに調和させるかが、これまでにない重要課題となっています。"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "新型コロナウイルス感染症及び電気料金の値上げの影響を受けた市指定管理施設の安定運営を図るため、減収に対する補填を行うものであります。"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "電気料金の値上げの影響を受ける農業用水利施設を管理する土地改良区に対して支援する経費の増額"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "市観光物産施設の修繕費及び新型コロナウイルス感染症の影響による減収を補填するため、施設管理委託料の増額"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "落雷により故障した同報系防災行政無線屋外子局施設の修繕費の計上"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
