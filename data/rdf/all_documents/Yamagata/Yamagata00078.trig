<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "今回の補正は、決算見込みによる事業費の調整、基金の廃止に伴うもの及び市債の繰上償還の実施が主なものであります。"@ja.
<< kg:id_44 prop:cause kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "今回の補正は、決算見込みによる事業費の調整、基金の廃止に伴うもの及び市債の繰上償還の実施が主なものであります。"@ja.
<< kg:id_44 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "今回の補正は、決算見込みによる事業費の調整、基金の廃止に伴うもの及び市債の繰上償還の実施が主なものであります。"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "東北公益文科大学と市内ＩＴ関連企業などと協働して、デジタル人材を育成します。また、情報技術を課題解決に役立てる能力を身につけた学生と市内企業をつなぐことで、デジタル人材不足の解消に貢献します。"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "児童生徒数の減少が進む中、酒田市立第四中学校区内の義務教育環境の在り方について協議を進めるなど、新しい学校づくりに取り組みます。"@ja.
<< kg:id_49 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "児童生徒数の減少が進む中、酒田市立第四中学校区内の義務教育環境の在り方について協議を進めるなど、新しい学校づくりに取り組みます。"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "いじめや不登校などへの対応として、教育相談室・適応指導教室の教育相談専門員、小中学校のスクールカウンセラー、教育相談員、スクールソーシャルワーカーの連携を強化するとともに"@ja.
<< kg:id_52 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "ＧＩＧＡスクール端末を通じて児童生徒自らが容易にＳＯＳのサインを出せる仕組みを構築します。"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "コロナ禍の影響を受けた中小企業者などの経営の安定化及び地域経済の活性化を図るため、引き続き山形県商工業振興資金融資制度の地域経済変動対策資金の利子及び保証料の補給を行います。"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "市内企業の人手不足の解消や、若者の早期離職防止及び地元定着のため、引き続き地元の民間就職情報サイトを活用して採用する場合の費用を支援するとともに"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "高等学校の生徒などを対象とした市内企業見学ツアー"@ja.
<< kg:id_61 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "持続可能な循環型農業の実現に向け、市内の大規模酪農事業所から生産される消化液を液肥として水田で施用する仕組みを構築するとともに"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "農業者の高齢化などにより、地域の農地管理体制が弱体化する中"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "農作業の省力化を図る土地改良事業を推進するとともに"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "コロナ禍において物価高騰に直面する市民の経済的負担を軽減するため、国民健康保険財政調整基金を活用し、４年連続で国民健康保険税の税率を引き下げます。"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "安心して酒田で子育てができるよう、子供の医療費の無償化をこれまでの中学３年生から高校３年生まで対象者を拡大します。"@ja.
<< kg:id_70 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "保育所や小中学校の給食費の値上げによる子育て世帯の負担を軽減するため、食材費の一部に新型コロナウイルス感染症対応地方創生臨時交付金を活用します。"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "酒田市こども家庭センターを立ち上げ、全ての妊産婦、子育て世帯に寄り添い、妊娠期から出産・子育てまで一貫した相談体制を構築し、多様なニーズに即した必要な支援につなぐ伴走型相談支援の充実を図ります。"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "結婚を望む市民の希望をかなえるため、酒田市結婚サポートセンターによる相談・仲介支援を行います。"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "新たに看護師を健康課に配置することにより、後期高齢者に対する生活習慣病などの重症化予防の個別相談・指導などを強化します。"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "酒田市休日診療所は、施設の老朽化や医療従事者の高齢化などの課題があることから"@ja.
<< kg:id_78 prop:cause kg:id_80 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "酒田市休日診療所は、施設の老朽化や医療従事者の高齢化などの課題があることから"@ja.
<< kg:id_78 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "日本海総合病院や酒田地区医師会十全堂など、関係機関と今後の在り方について協議を進めます。"@ja.
<< kg:id_82 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "地域医療を支える人材を確保するため、酒田看護専門学校の学生に対して、一定の条件により授業料を減免するとともに"@ja.
<< kg:id_82 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "市外から転入した学生に対して賃貸住宅の家賃を助成し"@ja.
<< kg:id_82 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "卒業後に市内医療機関に就職する場合には卒業支援金を支給し、市内での就業と定着を促進します。"@ja.
<< kg:id_86 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "地域コミュニティ組織、行政、学校、企業など、各種団体の連携・協働を促し、様々な業務が円滑に進むよう支援する役割を担う地域プロデューサーを市長部局に配置します。"@ja.
<< kg:id_88 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "再生可能エネルギー循環都市の実現を目指し、地球温暖化対策推進法に基づく酒田市地球温暖化対策実行計画、区域施策編の策定に取り組みます。"@ja.
<< kg:id_90 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "家庭でのエネルギー地産地消による脱炭素を推進するため、新築住宅に設置する太陽光発電及び蓄電池の設備導入につながる独自の支援策を創設します。"@ja.
<< kg:id_92 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "最も蓋然性が高い大規模自然災害への対応強化を主眼として、避難する主体となる自主防災会などの地域住民、被災者を救援する防災関係機関、全般を統制する市、これら３つの機能が組織的に連携する体制を整備します。この目的を達成するため、全市域を対象とした一斉総合防災訓練を実施し"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "地理的条件などにより電波受信強度の弱い地域の防災ラジオの電波環境を改善するため、コミュニティＦＭ中継局を平田地域に整備します。"@ja.
<< kg:id_96 prop:effect kg:id_97 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "地域住民の生活環境に悪影響を及ぼす管理不全な空き家"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "空き家等対策計画に基づき、地域住民の生活環境に悪影響を及ぼす管理不全な空き家の適正管理と発生抑制に取り組みます。"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "るんるんバスや予約制乗合タクシーについては、体験試乗会の実施や地域コミュニティ組織への情報提供などを行うことにより、利用者の増加に取り組みます。"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "定期船とびしまについては、子供無料キャンペーンなどを実施することにより、乗船者の増加に取り組みます。"@ja.
<< kg:id_104 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "民間事業者と連携した飛島スマートアイランドプロジェクトに引き続き取り組み、離島が抱える課題の解決につなげていきます。"@ja.
<< kg:id_106 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "地域に活力を生み出す高速交通ネットワークを形成するため、日本海沿岸東北自動車道の遊佐象潟道路の早期開通と新庄酒田道路の高屋草薙間と狩川廻館間の事業化に向けて、国及び山形県に働きかけます。"@ja.
<< kg:id_108 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "ＪＲ酒田駅前広場の整備に併せて、屋根つきの駐輪場を整備し、高校生など、利用者の利便性を高めます。"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "市営住宅については、同居親族要件を見直し、住宅に困窮する若年単身者も入居可能とするほか、ＵＩＪターン就職を予定する若者単身者も入居対象とします。"@ja.
<< kg:id_112 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "デジタル田園都市国家構想総合戦略の実現に向け、第２期酒田市まち・ひと・しごと創生総合戦略を改訂し、デジタル実装を通じた課題解決の取組を一層推進します。"@ja.
<< kg:id_114 prop:countermeasure kg:id_115 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "平日に市役所へ行けない方が交付申請しやすいように、引き続き出張窓口や休日窓口を開設します。"@ja.
<< kg:id_116 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "事業の見直し、多様な任用形態、業務のデジタル化などにより、職員数及び総人件費の縮減に取り組みます。"@ja.
<< kg:id_118 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "公共施設適正化懇談会（仮称）を設け、社会教育、スポーツ、交流観光を目的とする施設の在り方などについての市民意見を聴取した上で、公共施設の適正化を進めます。"@ja.
<< kg:id_120 prop:cause kg:id_121 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "投資的経費は、前年度比33.9％の増となっております。これは、山居倉庫公有化事業、法人立保育所等施設整備事業、学校長寿命化事業、国体記念体育館改修事業などの事業進捗に伴うものであります。"@ja.
<< kg:id_120 prop:cause kg:id_122 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "投資的経費は、前年度比33.9％の増となっております。これは、山居倉庫公有化事業、法人立保育所等施設整備事業、学校長寿命化事業、国体記念体育館改修事業などの事業進捗に伴うものであります。"@ja.
<< kg:id_120 prop:cause kg:id_123 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "投資的経費は、前年度比33.9％の増となっております。これは、山居倉庫公有化事業、法人立保育所等施設整備事業、学校長寿命化事業、国体記念体育館改修事業などの事業進捗に伴うものであります。"@ja.
<< kg:id_120 prop:cause kg:id_124 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "投資的経費は、前年度比33.9％の増となっております。これは、山居倉庫公有化事業、法人立保育所等施設整備事業、学校長寿命化事業、国体記念体育館改修事業などの事業進捗に伴うものであります。"@ja.
<< kg:id_125 prop:cause kg:id_126 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "これは、定年引上げに伴う退職手当の減等により人件費が前年度比5.7％の減"@ja.
<< kg:id_127 prop:cause kg:id_128 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "少子化の影響等により児童手当扶助費や保育所入所扶助費などの扶助費が前年度比2.1％の減"@ja.
<< kg:id_129 prop:cause kg:id_130 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "公債費については、松山小学校改修等に伴う市債の元金償還開始等により前年度比0.9％の増"@ja.
<< kg:id_131 prop:cause kg:id_132 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "物件費がイントラネット設備等整備事業におけるシステム関連委託料やデジタル変革事業における業務委託料などの減により2.6％の減"@ja.
<< kg:id_131 prop:cause kg:id_133 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "物件費がイントラネット設備等整備事業におけるシステム関連委託料やデジタル変革事業における業務委託料などの減により2.6％の減"@ja.
<< kg:id_134 prop:cause kg:id_135 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "強い農業づくり総合支援交付金事業や下水道事業運営負担金の減などにより補助費等が前年度比1.9％の減"@ja.
<< kg:id_134 prop:cause kg:id_136 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "強い農業づくり総合支援交付金事業や下水道事業運営負担金の減などにより補助費等が前年度比1.9％の減"@ja.
<< kg:id_137 prop:cause kg:id_138 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "貸付金については地域総合整備資金貸付金の減などにより30.5％の減"@ja.
<< kg:id_139 prop:countermeasure kg:id_140 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "議第28号については、所期の目的を達成したため、土地開発基金を廃止するものであります。"@ja.
<< kg:id_141 prop:cause kg:id_142 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "所期の目的を達成したため、土地開発基金を廃止するものであります。"@ja.
<< kg:id_143 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "議第29号については、子育てに係る特別休暇の拡充のため、所要の改正を行うものであります。"@ja.
<< kg:id_145 prop:countermeasure kg:id_146 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "議第30号については、放課後児童支援員等の配置の特例を定めるため、所要の改正を行うものであります。"@ja.
<< kg:id_147 prop:cause kg:id_148 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "議第31号については、健康保険法施行令の一部改正に伴い、出産育児一時金の支給額について、所要の改正を行うものであります。"@ja.
<< kg:id_149 prop:countermeasure kg:id_150 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "議第32号については、国民健康保険税について、被保険者の負担軽減を図るため、基礎課税額及び後期高齢者支援金等課税額の各割額を改定することについて、所要の改正を行うものであります。"@ja.
<< kg:id_151 prop:cause kg:id_152 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "被保険者の負担軽減を図るため、基礎課税額及び後期高齢者支援金等課税額の各割額を改定することについて"@ja.
<< kg:id_153 prop:cause kg:id_154 >>
    prop:stateBy kg:st_1;
