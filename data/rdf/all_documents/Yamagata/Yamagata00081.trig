kg:st_1 rdfs:label "矢口明子市長"@ja.
kg:st_1 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "人口減少をできるだけ緩やかにするため若い人の仕事づくりと市民所得向上が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "所有者不明空き家の解消と利活用促進のため制度の積極活用を考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "中心市街地も含め買物弱者対策を庁内横断で進める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "武田恵子議員"@ja.
kg:st_2 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_4 prop:content "市立保育施設廃止は若い世代の希望にそぐわなくなるおそれがある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "急激な人口減少に合わせ事業や公共施設の見直しを速やかに進める必要がある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "親世代や祖父母世代が共に子育て共に家事を歓迎する空気が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "高齢層の意識改革を繰り返し進める必要がある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "共に子育て共に家事の意識がないと若い人が酒田から出ていくと伝えていく"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "市長交代への期待感を活力に変え人口減少の負のスパイラルからの脱却策が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "少子化の下で市全体の保育環境維持のため調整が必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "法人立保育所等の運営に影響が生じているため市立保育園が調整弁を担う"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "人口減少と少子高齢化の進行が速く庁内全体での速やかな見直しが必要"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:st_3 rdfs:label "齋藤美昭議員"@ja.
kg:st_3 rdf:type cls:st_16.
kg:op_13 prop:content "教育環境整備で担い手不足などの課題解決と地域活性化につなげるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "人口減少を抑制しつつ減少後も豊かに安心して暮らせるまちに創り変えることが使命"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "若者に人気があり所得水準も高く人口減少対策として重要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_4 rdfs:label "後藤仁議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_16 prop:content "市役所業務のデジタル処理をIT企業へもっとアウトソーシングすべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:st_5 rdfs:label "佐藤猛議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_17 prop:content "誘致実績を踏まえ今後の戦略と地元企業支援も必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_5.
kg:op_18 prop:content "県との関係構築と基地港湾整備の推進が重要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "洋上風力発電と基地港湾指定の見通しが重要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_5.
kg:op_20 prop:content "酒田の食を強みに外貨を酒田市に落とす施策が必要"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:st_6 rdfs:label "市村浩一議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_21 prop:content "酒田DMOの組織強化と戦略強化で着地型観光を確立すべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:op_22 prop:content "米粉製造と輸出まで見据えた展開を検討すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "農産物や日本酒花卉の海外輸出を積極的に進めるべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "若い人が就きたい仕事を増やし少しずつ成果を積み重ねたい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "サンロクを中心に事業拡大と事業承継支援が必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_5.
kg:op_26 prop:content "年代の高い層に出前講座等で地道に意識啓発を続ける"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "市民の前で男女共同参画を語り続けてほしい"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "高齢の方の意識改革が必要であり講話などで繰り返し伝える"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "市民意識改革も含む社会構造的な問題であり具体施策が必要"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "失職や家庭崩壊を招かない環境整備が必要"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "市立保育施設を廃止していく考え方は若い世代の希望にそぐわなくなるおそれがある"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "人口が減っても安心して働き子どもを預けられる環境整備を進める"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "少子化の下で市全体の保育環境維持のための判断"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "既に決めたことでも急激な人口減少に合わせ見直しや計画組み替えが必要"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "中心市街地で法人立保育所が充足し建物老朽化も進んでいるため閉園に至った"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "市立保育園は民間が担いにくい役割を担うべき"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "一時預かりや休日保育の充実を担っていく"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "未就園児支援を市立保育園の役割として担う"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "予算を増額して所有者不明空き家に積極的に活用すべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "予算増額を検討し制度の積極活用を考える"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "中心市街地に住むための環境が崩れてきている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:op_42 prop:content "中心市街地でも買物をする場所がない状況が発生している"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "市民から気軽に買物に行けなくなったとの感想がある"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "近くに小売店舗がなくなっているエリアが多いことが話題になっている"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "配達サービスやデマンドタクシーの情報が市民に行き届いていない"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "課題把握の上で効果的施策を検討する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "中心市街地の買物難民も酒田市全体の課題である"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "買物目線では帰りの便が見つけにくい問題がある"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "過疎地域だけでなく中心市街地も含めた全市的課題として把握する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "具体的なイメージを示すべき"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_5.
kg:op_51 prop:content "地域独自の助け合い活動は重要であり人員確保や体制整備も含め検討する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "地域独自の有償ボランティア活動を重要と考える"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "のるんるんバスとデマンドタクシーを買物目線で見直すべき"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:op_54 prop:content "バス路線はまだ便利になったとは思えず見直しが必要"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_6.
kg:op_55 prop:content "庄内交通と連携して利便性向上を図るべき"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_6.
kg:op_56 prop:content "地域の心配を受け義務教育学校設立方針を決定した"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "中1ギャップ解消や異年齢交流など多くのメリットがある"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "今後のモデルケースとして現状を注視している"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:op_59 prop:content "地域コミュニティとの連携や情報収集共有を進め不安軽減につなげる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "中心市街地に住むための環境が崩れている"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_6.
kg:op_61 prop:content "利便性を損なう結果となっている"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:op_62 prop:content "立地適正化計画見直しの中で対応を考える"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "中心市街地の役割分担を踏まえ計画推進を早めるべき"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_6.
kg:op_64 prop:content "多くの観光客が訪れる稼ぐ観光施設になってほしい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "市民や民間事業者の意見を聞き必要な都市機能を検討する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_1.
kg:op_66 prop:content "登録DMOとなった今こそ組織強化と戦略強化と人材育成が必要"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_6.
kg:op_67 prop:content "民間派遣職員や直接雇用職員の増員など組織強化が必要"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "酒田の食は全国に誇れる強みであり外貨獲得につなげるべき"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_4.
kg:op_69 prop:content "酒田のラーメンや酒田フレンチ日本酒を押し出す"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_1.
kg:op_70 prop:content "羽越本線や陸羽西線を観光資源として外国人誘客にどう生かすか具体化が必要"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_5.
kg:op_71 prop:content "写真動画やインフルエンサー発信で沿線風景の魅力を伝える"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
kg:op_72 prop:content "目標を立てたインバウンド施策が必要"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_6.
kg:op_73 prop:content "受入態勢整備の重要な取組である"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_1.
kg:op_74 prop:content "局所的なにぎわいにとどめず経済効果を広げたい"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_1.
kg:st_7 rdfs:label "前田茂男総務部長"@ja.
kg:st_7 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_75 prop:content "財政の硬直化が続き基金繰入れに頼らざるを得ない"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_7.
kg:op_76 prop:content "基本的な財政構造が変わっていない"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_7.
kg:op_77 prop:content "5年間でなくより長い期間で進める考え方も検討すべき"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_4.
kg:op_78 prop:content "令和9年度のおおむね収支均衡を見込み現時点で延期は考えていない"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_1.
kg:op_79 prop:content "機能や在り方と売却の方向性を明確にすべき"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_3.
kg:op_80 prop:content "廃止売却ありきでなく利活用と利用者増加の案を示して意見聴取する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_1.
kg:op_81 prop:content "土地建物は売却したほうがいいものや売却できるものがないか見直すべき"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "可能な限り積極的な売却で財源確保に努める"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_7.
kg:op_83 prop:content "山林売却が進まない中でクレジット売却益も検討する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_7.
kg:op_84 prop:content "赤字になることが明らかでも実施し補填を求めるのは市民理解を得られない"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_3.
kg:st_8 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_8 rdf:type cls:st_32.
kg:op_85 prop:content "有料観覧席を十分販売できなかった大きな要因"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_8.
kg:op_86 prop:content "結果的に今回の赤字につながり非常に反省すべき"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_8.
kg:op_87 prop:content "事業資金確保と安全対策を目的に実施した"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_8.
kg:op_88 prop:content "来場者の混雑分散など雑踏対策の新たな取組"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_8.
kg:op_89 prop:content "遠方からの来場者が確実に駐車できる仕組みを考えた"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_8.
kg:st_9 rdfs:label "松田俊一健康福祉部地域医療調整監"@ja.
kg:st_9 rdf:type cls:st_32.
kg:op_90 prop:content "負担軽減のため全数把握による市町村別公表を終了した"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_9.
kg:op_91 prop:content "高齢者や基礎疾患を有する方の重症化が医療体制に影響しうる"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_9.
kg:op_92 prop:content "5類移行後も関係機関で情報共有を続ける"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_9.
kg:op_93 prop:content "引き続き市民への注意喚起と予防啓発に努める"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_9.
kg:op_94 prop:content "業務見直しと効率化に一定の効果があった"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_1.
kg:op_95 prop:content "市民手続オンライン化のため活用を進めてきた"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_1.
kg:op_96 prop:content "文章生成や会議録要約などで業務効率化の効果が出始めている"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_1.
kg:op_97 prop:content "高齢求職者の再設計と就労支援を進める"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_1.
kg:op_98 prop:content "高齢者が安全安心に働ける職場づくりの啓発が重要"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_1.
kg:op_99 prop:content "介護施設の人手不足解消と高齢者自身の満足度向上につながっている"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_1.
kg:op_100 prop:content "障がい特性や必要な配慮の理解を深め雇用率向上を目指す"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_1.
kg:op_101 prop:content "一般就労が困難な場合は就労移行支援や就労継続支援で能力向上を支える"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_1.
kg:op_102 prop:content "バザー開催やカフェ利用や返礼品登録呼びかけで支援する"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "酒田市は現在様々な課題に直面しています。例えば、あらゆる分野における担い手不足"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "酒田市は現在様々な課題に直面しています。例えば、空き家の増加"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "酒田市は現在様々な課題に直面しています。例えば、小売店の閉鎖によるいわゆる買物弱者の問題"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "酒田市は現在様々な課題に直面しています。例えば、法人立保育所等の経営難"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "酒田市は現在様々な課題に直面しています。例えば、学校の統廃合"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "伝統的な性別役割分担意識をなくしていくことが唯一の道"@ja.
<< kg:id_8 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "なぜ、若い女性は、地方都市から都会へ出ていくのでしょうか"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "人口減少の負のスパイラルから少しでも脱却できるようにする具体的な施策が求められている"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "本市の出生数は、平成29年に615人だったものが...令和４年は458人、令和５年の見込みとしては約440人...その結果、保育所等の定員数に対する入所者数は...令和４年度には87.15％まで急激に低下しております"@ja.
<< kg:id_10 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "令和４年度には定員数3,385人に対し入所している児童の数は2,950人、つまり、その差435人と、大変大きくなってきておりまして、法人立保育所等の運営に影響が生じております"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "それ以上のスピードで人口が減り、少子高齢化が進んでいます。若い人が住みたいと思うまちにするために、事業や公共施設等縮小しなければならないものと残さなければならないものの庁内全体での速やかな見直しが必要"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "小中一貫教育の推進により、担い手不足などの課題解決を図り、地域活性化につなげる"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "様々な課題の根本原因である人口減少をできる限り抑制しながら、人口が減少したとしても豊かに安心して暮らせることができるまちに酒田市を創り変えていく"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "人口減少をできるだけ緩やかにするためには、若い人の仕事をつくる、あるいは、市民所得の向上を図るということが必要...特に効果がある取組として、デジタル関連企業の集積を挙げたいと思います"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "具体施策として、市長所信表明の中でも...再生可能エネルギー関連企業の集積"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "具体施策として、市長所信表明の中でも...「外貨」を稼ぐ観光"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "具体施策として、市長所信表明の中でも...移出・輸出の促進"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "具体施策として、市長所信表明の中でも...地元企業・農林水産業者の「稼ぐ力」の向上"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "特に年代の高い層には出前講座等により、家庭における男女共同参画の意識啓発を行ってまいりました"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "女性が働きやすいまちを目指すというのはどういう意味なのかと、高齢の方の意識改革必要ですよ、ということを繰り返しお話ししていきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "働きたいと考える全ての市民が働くことのできる環境の整備"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "今後も、人口が減っても、安心して働き、子どもを預けられる保育環境の整備や質の向上に務めていきたい"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "人口減少の進展に伴い、保育定員の削減が必要となった場合には、市立保育園が調整弁の役割を担う"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "法人立保育所等が充足しております中心市街地に位置しており、かつ、建物の老朽化が進んでいる市立松陵保育園を閉園するという考えに至りました"@ja.
<< kg:id_25 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "これからの市立保育園は、民間ではなかなか担うことが困難...障がい児保育の充実"@ja.
<< kg:id_25 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "特別保育（一時預かり・休日保育）の充実"@ja.
<< kg:id_25 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "保育園に併設される子育て支援センターによる未就園児への支援などを役割として担っていきたい"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "酒田市では、所有者不明の空き家等の解消を目的として相続財産管理人選任申立てを活用して問題を解決してまいりました"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "中心市街地においても、小売店舗の相次ぐ撤退により、買物をする場所がないという状況が発生しております"@ja.
<< kg:id_34 prop:cause kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "バスがデマンドタクシーに代替されたことで、気軽に買物に行けなくなったとの感想"@ja.
<< kg:id_34 prop:cause kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "小売店舗が統合され、近くに小売店舗がなくなっているエリアが多い"@ja.
<< kg:id_34 prop:cause kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "その情報が市民に行き届いていないことやうまく活用されていないことが想定されます。また、デマンドタクシーも実際の利用者からは不満が少ない、つまり情報が行き届いていないことが想定されます"@ja.
<< kg:id_34 prop:cause kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "買物弱者の課題としては、情報のミスマッチ、交通手段の確保などが考えられます"@ja.
<< kg:id_34 prop:effect kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "中心市街地の住民でも車に乗らない人は買物が大変だと聞いています"@ja.
<< kg:id_34 prop:effect kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "買物目線で考えた場合には、やはり帰りの便がなかなか見つけにくい、不便であるという問題がある"@ja.
<< kg:id_34 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "買物弱者に関するプロジェクトチームを立ち上げ、過疎地域だけでなく、中心市街地も含めた酒田市全体の課題把握と効果的な施策の展開を行っていきたい"@ja.
<< kg:id_34 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "琢成学区コミュニティ振興会で実施しているよろずや琢成での買物代行サービス"@ja.
<< kg:id_34 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "田沢コミュニティ振興会で実施している田沢おたすけ隊での買物代行及び付添支援サービス"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "今後は、市議会からの提言書、アンケート調査の結果、酒田商業高校跡地における民間施設の供用開始といった事情などを踏まえ、交通事業者とも協議をしながら、運行内容の変更について検討していきたい"@ja.
<< kg:id_45 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "るんるんバスの運行内容につきましては、これまで同様に庄内交通株式会社と協議をしながら検討を重ねていきたい"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "少子化により複式学級となる小学校が年々増加しており"@ja.
<< kg:id_48 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "６小学校１中学校を統合した義務教育学校を設立するという方針決定を行ったところであります"@ja.
<< kg:id_48 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "いち早く第四中学校区に地域プロデューサーを配置し、毎週６地区を巡回訪問することで、地域コミュニティとの連携や情報収集・共有に努めております"@ja.
<< kg:id_52 prop:cause kg:id_53 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_60;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "マリーン５清水屋やト一屋中町店など一部の商業施設が、コロナ禍や施設の老朽化等の影響もあり閉店となり、地域住民の利便性を損なう結果となっております"@ja.
<< kg:id_52 prop:cause kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "マリーン５清水屋やト一屋中町店など一部の商業施設が...閉店となり"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "現在、山形県は、庄内圏域北部都市計画区域マスタープランの見直し作業を行っておりますので、その後に酒田市立地適正化計画についても見直しをしたい"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "酒田商業高校跡地につきましては、商業機能に加えて、物産機能が導入される見込み"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "中町２丁目地区につきましては、市民の皆様が集う場所として整備されることが望ましい"@ja.
<< kg:id_61 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_66;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "酒田ＤＭＯは、現在市からの派遣職員２人を含む職員６人体制で運営されておりますけれども、今後さらに民間からの派遣職員の増員、あるいは直接雇用職員の増員など、組織を強化する必要がある"@ja.
<< kg:id_61 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_68;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "文化庁100年フードに認定された酒田のラーメン、それから酒田フレンチ、日本酒も含めた食に関するコンテンツを押し出して、美酒美食のまち酒田として、これからＰＲしてまいります"@ja.
<< kg:id_61 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_70;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "鉄道に乗ること自体を目的とする観光客に対し、羽越本線や陸羽西線の風景の美しさを知ってもらい、実際に乗ってみたいと思ってもらえるような情報発信が重要"@ja.
<< kg:id_65 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "観光物産協会ホームページ「酒田さんぽ」の外国語対応、それから、外国語表示に対応した観光看板の整備"@ja.
<< kg:id_65 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "北庄内地域通訳案内士の認定と育成"@ja.
<< kg:id_65 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "外国クルーズ船乗船客のおもてなしなどに取り組んでまいりました"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "公債費や物件費が多くなり、財政の硬直化が続いている"@ja.
<< kg:id_69 prop:cause kg:id_71 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "基本的な財政構造が変わっておらず、当面、基金からの繰入れに頼らざるを得ない予算編成が続いていく"@ja.
<< kg:id_69 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_77;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "プロジェクト３０－３０を継続することにより、毎年公債費が減少していくことになります...令和９年度には収支均衡が図られる"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "酒田市公共施設適正化懇談会は...施設の在り方を検討するために設置をいたしました"@ja.
<< kg:id_73 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "公共施設のうち、行政目的を終え普通財産となった施設については、酒田市未利用財産利活用基本方針に基づき、積極的な売却に努めている"@ja.
<< kg:id_73 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "森林の吸収したＣＯ２などの温室効果ガスの吸収量などをクレジット化するという、国が認証するＪクレジット制度もございますので、クレジットの売却益を得るなど、山林の活用についても検討してまいりたい"@ja.
<< kg:id_77 prop:cause kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_84;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "駐車台数の確保が計画どおりにいかず、結果として、有料観覧席の席数を十分に販売できなかったことが、事業収入が予定を下回った大きな要因"@ja.
<< kg:id_77 prop:cause kg:id_79 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "観客の利便、チケット購入者を優先した形になったことが、結果的には...今回の赤字につながった"@ja.
<< kg:id_80 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "今年度は競技大会に加えて、有料観覧席の席数と範囲を大幅に増やしました"@ja.
<< kg:id_80 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "有料と無料の観覧エリアを分けまして、来場者の混雑を分散させるなど、雑踏対策の新たな取組も行った"@ja.
<< kg:id_80 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "有料観覧席の種類別に指定駐車場を設けるなどすることによって、遠方からお越しのお客様も確実に駐車ができる仕組み"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "全国的な新型コロナウイルス感染症の感染拡大に伴いまして、保健所の職員や医療従事者の負担軽減を図るため、令和４年９月14日の公表分をもって、全数把握による市町村別の感染者数の公表を終了"@ja.
<< kg:id_84 prop:effect kg:id_86 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "高齢者や基礎疾患を有する方につきましては、感染により重症化することもあり、地域の医療提供体制に影響することが懸念されます"@ja.
<< kg:id_84 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "新型コロナウイルス感染症が５類に位置づけられた後も、保健所、医師会、病院、市町が定期的に会議を開きまして、情報の共有を実施しております"@ja.
<< kg:id_84 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "引き続き、市民の皆様に対する感染予防の啓発に努めてまいります"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "人がパソコン上で日常的に行っている作業を、人が実行するのと同じ形で自動化するＲＰＡ"@ja.
<< kg:id_89 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "市民手続をオンライン化するツールであるｋｉｎｔｏｎｅなどを活用することにより、デジタル化を進めてきた"@ja.
<< kg:id_89 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "本年７月からはＣｈａｔＧＰＴをはじめとする対話型生成ＡＩを職員が活用できる環境を整えておりまして、文章の生成、会議録の要約、プログラミングなどに活用しております"@ja.
<< kg:id_93 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "ハローワーク酒田では生涯現役支援窓口を設置し、高年齢求職者に対して、職業生活の再設計や就労支援を行っている"@ja.
<< kg:id_93 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "国は、令和２年３月にエイジフレンドリーガイドライン...を策定しており、本市においても市ホームページ等で周知する"@ja.
<< kg:id_93 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "地域にある介護施設の介護補助業務に、新たに人材を派遣する事業"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "事業者に対して、障がいの特性や必要な配慮などの理解を深めるとともに、障がい者雇用を促進する各種助成制度や支援制度について周知"@ja.
<< kg:id_97 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "就労移行支援や就労継続支援などを通じて、職業知識や能力の向上への支援が行われます"@ja.
<< kg:id_97 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "本市の課題として、福祉的就労における工賃向上、工賃が低いという問題がありますので、市役所でのバザーの定期的な開催、庁内に開設しているカフェ「えーる」の利用、そして、販路の拡大、ふるさと納税返礼品への登録の呼びかけ"@ja.
}
