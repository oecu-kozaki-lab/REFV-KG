kg:st_1 rdfs:label "阿部寿一市長"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "制度概要だけでなく詳細の早期提示を国に強く求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "梶原宗明議員"@ja.
kg:st_2 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_2 prop:content "最低限計画ができるような情報提供を求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "農協や市役所が制度を支えると強く伝え不安解消を図る"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域組織が農家に関与しにくくなる点に疑問を示す"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "現場では来年に向けて動き始めており判断材料の不足を懸念する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "基幹作物の米で混乱が起きないよう市が全力で取り組む"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "制度導入が円滑になるよう地域説明を急ぐべきと考える"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "申請手続や事業運営も含めて相談対応体制を整えるべきとする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "作付や種子確保の時期に間に合うよう国へ早期提示を求める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "地域の懸念を庄内全体でまとめて国会議員に伝える段取りとする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "一般市民や消費者へのアピールの重要性を指摘する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "認知度が低いのは事実であり本格的な体制づくりが必要とする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "地産地消の段階から消費拡大を進める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "学校給食での活用を通じて消費拡大を図る"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "高機能な製粉機の導入で利用環境を整える"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_3 rdfs:label "相蘇清太郎農林水産部長"@ja.
kg:st_3 rdf:type cls:st_2.
kg:op_16 prop:content "市民や消費者の共通理解が得られるよう食べ方の工夫を進める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "酒田への関心を高めるよう戦略的に事業を進める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "国を挙げた普及策が必要と認識する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "地域からも国全体の取り組みを求めるべきとする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "山林所有者の把握が難しくなっていると指摘する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "山林で地籍がわからなくなっている現状を認識している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "所有山林を把握しているのは高齢者が中心だと懸念する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "地籍調査の必要性を理解し今後の計画的実施を検討する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:st_4 rdfs:label "石川翼久教育長"@ja.
kg:st_4 rdf:type cls:st_72.
cls:st_72 rdfs:label "教育機関"@ja.
kg:op_24 prop:content "最初は違和感があるが交流で解消したいとする"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "本市で初めてに近い異なる環境同士の統合に不安を示す"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "お互いに認め合える一体感づくりを進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "生徒同士の交流を深め一体感をつくる"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "可能な限り同じ条件で統合を迎えられるよう配慮する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "通学の安全確保を第一に考える"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "国道横断への不安に対し交通安全指導を重視する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "周辺交通事情について意見が出ており安全配慮を検討する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "今後のデータを踏まえ生徒の安全対策を検討する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "平成24年度以降の活用として内部で検討を重ねている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:st_5 rdfs:label "阿部ひとみ議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_34 prop:content "安心して出産できる施設が限られていると指摘する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_5.
kg:op_35 prop:content "出産を担う医療機関の減少に懸念を示す"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "産科医療施設の充実を要望する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "体力的にきつい産科医療の厳しさを指摘する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "訴訟リスクが産科医志望減少につながるとみる"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "男性が産科医を目指しにくい現実があると指摘する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:st_6 rdfs:label "阿部直善健康福祉部長"@ja.
kg:st_6 rdf:type cls:st_2.
kg:op_40 prop:content "正常分娩への助産師活用の流れを踏まえ助産師外来を始めている"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_6.
kg:op_41 prop:content "市として直接誘致はしていないが派遣体制を求めている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:op_42 prop:content "特色ある施設整備として病室整備が進められている"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_6.
kg:op_43 prop:content "個室を8室増やし17室にする計画と説明する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_6.
kg:op_44 prop:content "増改築工事の中で周産期医療も実施予定とする"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "最近はネグレクトや心理的虐待が多いと説明する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_6.
kg:op_46 prop:content "身体的虐待だけでなく心理的虐待が増えているとみる"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_6.
kg:op_47 prop:content "虐待ケースの背景に経済的困窮が多いと説明する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "虐待認定や近いケースを継続的に追跡している"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_6.
kg:op_49 prop:content "関係機関が参画し情報交換を行っている"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_6.
kg:op_50 prop:content "個別事例ごとに直接担当者や民生委員らで対応を協議する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_6.
kg:op_51 prop:content "現在支援中の1世帯は虐待世帯への派遣であると説明する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:op_52 prop:content "知っていても受けない理由の分析が必要とする"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "周知不足への対策が必要とする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "事業所ごとの啓発活動をきめ細かく進める必要がある"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "健康さかた21計画策定前の市民アンケートに観点を盛り込む"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "申し込み方法の改善で受診率は変わると認識する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "広報媒体や地域活動を使って積極的に周知する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "行政のみならず医師会の協力も大事とする"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "事業として一定の成果を上げたと評価する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "利用実態を踏まえ条件の見直しや緩和を検討する"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "次期段階で見直しを検討したい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:op_62 prop:content "大変効果のある事業と認識する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "可能な限り交流事業を利用できるよう調整する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:st_7 rdfs:label "石堂栄一総務部長"@ja.
kg:st_7 rdf:type cls:st_2.
kg:op_64 prop:content "事故内容を分析するとほとんどがうっかりミスだとする"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_7.
kg:op_65 prop:content "事故は多いと認識し危機感を持つ"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_7.
kg:op_66 prop:content "研修の積み重ねで意識改革を図る"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_7.
kg:op_67 prop:content "安全活動を積み重ねている"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_7.
kg:op_68 prop:content "飲酒運転防止を含め安全管理を進める"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_7.
kg:op_69 prop:content "できることは何でもやる気持ちで安全管理に努める"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_7.
kg:op_70 prop:content "雇用情勢は厳しい現実にあると認識する"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_1.
kg:op_71 prop:content "考えられる雇用創出策はすべて実施し充実させる方針を示す"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
kg:op_72 prop:content "現場の意見を踏まえて効果的な対策を講じる"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_1.
kg:op_73 prop:content "既立地企業に雇用維持拡大を継続的に働きかける"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_1.
kg:op_74 prop:content "一定の成果はあるが本格的対応も必要とする"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_1.
kg:st_8 rdfs:label "高橋正和議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_75 prop:content "入所したくてもできない人への支援が必要と訴える"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_8.
kg:op_76 prop:content "介護者が安心して在宅介護できる支援策が必要とする"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_8.
kg:op_77 prop:content "介護離職の現実を踏まえた支援を求める"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_8.
kg:op_78 prop:content "一人で悩まず相談してほしいと呼びかける"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_6.
kg:op_79 prop:content "急な大雪にも対応できる連携が必要とする"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_8.
kg:st_9 rdfs:label "伊藤一幸建設部長"@ja.
kg:st_9 rdf:type cls:st_2.
kg:op_80 prop:content "実情に少しでも近づけるよう昨年見直した"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_9.
kg:op_81 prop:content "平地に比べ除雪作業が非常に困難と認識する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_9.
kg:op_82 prop:content "市民生活に影響が出ないよう判断して対応する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_9.
kg:op_83 prop:content "問題があったからではなく有利な起債を選択した結果と説明する"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_1.
kg:op_84 prop:content "過疎債と辺地債は今後も有利な方を活用する方針を示す"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_1.
kg:st_10 rdfs:label "後藤仁議員"@ja.
kg:st_10 rdf:type cls:st_16.
kg:op_85 prop:content "区長が自治会長のみになった場合の距離感を心配する"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_10.
kg:op_86 prop:content "市街地と中山間地で支援の濃淡があってよいと考える"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_1.
kg:op_87 prop:content "行政の下部機関的役割と自主活動を区分けすべきとする"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_1.
kg:op_88 prop:content "新規就農者を一農家の後継者ではなく地域農業の後継者とみるべきと訴える"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_10.
kg:op_89 prop:content "完全な所得補償ではないが一定の支援はしているとする"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_1.
kg:op_90 prop:content "ワンフロア機能のような体制で支援している"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_3.
kg:op_91 prop:content "提案を貴重と受け止め課題整理の上で検討する"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_3.
kg:op_92 prop:content "市民に指定管理者制度の実態が徹底していないと指摘する"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_10.
kg:st_11 rdfs:label "阿部雅治総務部行政調整監兼総務課長"@ja.
kg:st_11 rdf:type cls:st_2.
kg:op_93 prop:content "市民への周知を工夫していきたいとする"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_11.
kg:op_94 prop:content "国保財政の健全運営上引き下げは難しいとする"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_1.
kg:op_95 prop:content "基金繰入れを行ってもなお財政は厳しいと説明する"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_1.
kg:op_96 prop:content "基金繰入れの現状では国保税引き下げは難しいとする"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_1.
kg:op_97 prop:content "厳しい経済環境での一律減額は課題があると考える"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_1.
kg:op_98 prop:content "引き続き廃止を求めていく"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_1.
kg:op_99 prop:content "低所得者層の負担軽減につながる見直しには対応したい"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_1.
kg:op_100 prop:content "納税者との公平性を保ちつつ対応している"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_1.
kg:op_101 prop:content "面談して交付する現在の方法を維持したい"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_1.
kg:op_102 prop:content "生活実態の把握と納税相談のため面談交付を維持する"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_1.
kg:op_103 prop:content "病気の時は申し出るようよりしっかり周知する"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_1.
kg:op_104 prop:content "独自軽減措置を実施する状況ではないと判断する"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_6.
kg:st_12 rdfs:label "丸山至健康福祉部地域医療調整監兼健康課長"@ja.
kg:st_12 rdf:type cls:st_2.
kg:op_105 prop:content "命を守ることを最優先に考えた上で助成は今やるべきでないと判断する"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_12.
kg:op_106 prop:content "新型と季節性双方のワクチン接種を周知している"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_6.
kg:op_107 prop:content "小中学生は任意接種であり市助成は考えていない"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_6.
kg:st_13 rdfs:label "加藤裕教育部長兼学区改編推進室長"@ja.
kg:st_13 rdf:type cls:st_72.
kg:op_108 prop:content "県立高校の方針により別室受験で対応する"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_13.
kg:op_109 prop:content "県の判断理由には合理性があると考える"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_13.
kg:op_110 prop:content "地域に出向き実情を共有しながら進めている"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_7.
kg:op_111 prop:content "近く関係者へ配付し説明する予定とする"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_6.
kg:op_112 prop:content "説明をしながら配付する予定とする"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_6.
kg:op_113 prop:content "日頃の確認とつながりの維持を図る"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_6.
kg:op_114 prop:content "自治会と協力しつながりを維持したい"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_6.
kg:op_115 prop:content "独自作成も含め検討する"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_6.
kg:op_116 prop:content "相当規模の災害を想定するため課題整理が必要とする"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_7.
kg:op_117 prop:content "今後選定していく段階にあるとする"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_7.
kg:st_14 rdfs:label "船越重幸選挙管理委員会委員長"@ja.
kg:st_14 rdf:type cls:st_50.
cls:st_50 rdfs:label "委員会"@ja.
kg:op_118 prop:content "市役所投票所の場所やスペースに課題意識を持っていた"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_14.
kg:op_119 prop:content "込み合うことは想定していたがピーク時待ち時間が生じた"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_14.
kg:st_15 rdfs:label "市原栄子議員"@ja.
kg:st_15 rdf:type cls:st_16.
kg:op_120 prop:content "投票に来た市民が投票せず帰ることがないよう改善を求める"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_15.
kg:op_121 prop:content "問い合わせに応じ八幡総合支所や平田総合支所を案内した"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_14.
kg:op_122 prop:content "混雑緩和策を講じたがなお課題が残った"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_14.
kg:op_123 prop:content "集中しないよう手だてを講じスムーズな実施を目指す"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_14.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "農業者がこの新しい制度に対して、情報不足が原因で不安を持っていること、これは事実だろう"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "国からの情報が余りに乏しく、計画を立てるにも農家個々が判断できにくい状況"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "農業者がこの新しい制度に対して、情報不足が原因で不安を持っていること"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "このことにより、今までのように地方の行政機関であるとか農協、各地域の生産組織が、個々の農家に余り関与できなくなった"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "計画を立てるにも農家個々が判断できにくい状況"@ja.
<< kg:id_5 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "制度が出てきて、いや、課題があって大混乱になりましたということだけにはならないように"@ja.
<< kg:id_5 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地域の水田協でありますとか農協と連携をとりながら、地域に出向いて制度の説明をしなければならない"@ja.
<< kg:id_5 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "地域の皆さんからの御疑問に対し、機動的に答えられるような体制を、しっかり農協、市役所で組んでおく必要がある"@ja.
<< kg:id_5 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "早期に制度概要だけではなくて、詳細も含めて示していただきたいと、このことについては強く訴えている"@ja.
<< kg:id_5 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "庄内の市町村全体、そして庄内の農業団体と全体として意見をまとめて、こういうことについて懸念がありますので、ぜひ善処方お願いしますということは声を出していかなければならない"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "現段階で注目はされているものの、私から見れば認知度は決して高いものではない"@ja.
<< kg:id_14 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "まだまだ認知度が低いというのは、これは事実だろうと思っています"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "小学校での米粉調理実習授業"@ja.
<< kg:id_17 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "米粉パンによる給食の事業"@ja.
<< kg:id_17 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "ＪＡ庄内みどりに、また新型の製粉機を導入をすることに支援をさせていただきました"@ja.
<< kg:id_17 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "レシピをつくったり、それからいろんな料理との組み合わせがわかるような食べ方、消費の仕方、工夫の仕方がわかるようにしていく"@ja.
<< kg:id_17 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "外の地域にもアピールをして、酒田に関心を持ってもらうというような形で事業を戦略的に実施をしていく"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "製粉業者のほうなどで大々的に米粉を小麦の代替物もしくは混合物として大きく取り入れるというふうにならなければ、これが大きな需要として出てくるということはない"@ja.
<< kg:id_23 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "国を挙げて米粉は普及させていくんだということにならない限りは、大きな需要にならない"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "特に山林は明確な境界がわかりづらいということ、面積が細かく筆数が多い"@ja.
<< kg:id_26 prop:cause kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "お年寄りから代がわりをして、特に山林においては地籍がわからない、わかりにくい、わからなくなってきている"@ja.
<< kg:id_26 prop:effect kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "今の跡継ぎの若い人でも、自分の持ち山をわかる人はごく少数になってきている"@ja.
<< kg:id_26 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "今後、平田地域の完了後の計画的な実施に向けて検討していく必要がある"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "酒田二中と平田中学校にはそれぞれの歴史と伝統、そして違う環境、そういう中での統合"@ja.
<< kg:id_31 prop:cause kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "生徒数の予測も269人と133人であること、こういった周辺環境や生徒数の異なる中学校の統合"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "統合前からお互いの交流事業から部活動での交流、いろんな行事を一緒にやったり"@ja.
<< kg:id_34 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "修学旅行の行く先も日程も同じにして、同行動をとる"@ja.
<< kg:id_34 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "来年度から制服、運動着、運動靴、かばんも同じにします"@ja.
<< kg:id_34 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "生徒の通学の安全を確保するということを第１義としてスクールバス対応を考えておりますので、原則バス乗車に"@ja.
<< kg:id_34 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "交通ルールを児童・生徒たちがしっかり守って、自分の身を自分でもまず守るという、そういう意識も持たせるような指導"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "狭い道路の中でスクールバスがちゃんと通行できるのか、転回ができるのか、またそこに送迎の車が入ったらどうするかというような不安"@ja.
<< kg:id_40 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "交通量などもこれから見通しが立った時点で、生徒の安全配慮を検討していきたい"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "東平田小学校、中平田小学校、北平田小学校の統合という形で活用をしていきたい"@ja.
<< kg:id_45 prop:cause kg:id_46 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "市立酒田病院と日本海病院が１つになったことで、施設が集約化され"@ja.
<< kg:id_45 prop:cause kg:id_47 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "産婦人科が分娩を扱わず婦人科のみに転向したり、病院を閉めてしまったり"@ja.
<< kg:id_45 prop:effect kg:id_48 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "安心して出産できる施設が限られている状況"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "労働条件の厳しさ、医療訴訟のリスクにより、産科医を志す人材が減少している"@ja.
<< kg:id_49 prop:cause kg:id_51 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "医療訴訟のリスクにより、産科医を志す人材が減少している"@ja.
<< kg:id_49 prop:cause kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "男性産科医を妊婦が嫌ったり、男子医学生の立会いが嫌われるために、男性が産科医を目指さなくなる現実"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "日本海総合病院におきましても、昨年度からでございますが、妊娠36週以上の妊婦を対象に助産師が妊婦検診を行う助産師外来"@ja.
<< kg:id_53 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "全国市長会等々におきまして、医師不足地域へ派遣体制をとってもらうようなそういうお願いをしている"@ja.
<< kg:id_53 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "陣痛室、分娩室、回復室が一体となった病室を２部屋整備"@ja.
<< kg:id_53 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "産科病棟の個室を８室ふやして17室にする計画"@ja.
<< kg:id_53 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "現在増改築工事を行っているわけですが、その中で周産期医療も実施する予定"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "やはり養育放棄といいますか、これは養育者の能力の問題も、あるいは疾病の問題もある"@ja.
<< kg:id_59 prop:cause kg:id_61 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "それから心理的虐待、こういったケースが多くなっております"@ja.
<< kg:id_59 prop:cause kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "虐待ケースのほとんどが、背景には経済的な困窮ということも抱えている"@ja.
<< kg:id_59 prop:effect kg:id_63 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "虐待と認定した、あるいはそれに近いケースとして、引き続きフォローしているのが子供の人数にして43人、世帯数にして29世帯"@ja.
<< kg:id_59 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "要保護児童対策地域協議会ということで、児童福祉、保健医療、教育、警察、人権擁護関係機関等々から参画をしていただいて"@ja.
<< kg:id_59 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "ケース検討会議というものを開きまして、対応をとっている"@ja.
<< kg:id_59 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "これは先ほど申し上げましたいわゆる虐待世帯としてフォローしている世帯に対して派遣をしております"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "市町村でがん検診ができることについて知っているが受診しないと答えた人が46％"@ja.
<< kg:id_67 prop:cause kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "そういうことをやっていることを知らないとお答えになった人が15％ほど"@ja.
<< kg:id_67 prop:cause kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "社会保険加入の被扶養者の検診受診者が少ないことも一つ大きな原因だろう"@ja.
<< kg:id_67 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "来年度、市民の皆さんを対象にアンケート調査を実施する予定でありますので、この中で今の議員から御指摘いただいた観点も盛り込んだ調査"@ja.
<< kg:id_67 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "よりわかりやすい受診申し込み方法、気軽に申し込みできるような方法に変えていく努力"@ja.
<< kg:id_67 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "市の広報とかＦＭコミュニティ放送ハーバーラジオとか、そういうような市のかかわる広報媒体を中心に、積極的にＰＲ"@ja.
<< kg:id_67 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "がん検診の受診率アップについては、行政のみならず地区医師会の協力も大事"@ja.
<< kg:id_75 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "対象者全員に検診手帳と無料のクーポン券をダイレクトメールで送付し、周知をしました"@ja.
<< kg:id_77 prop:effect kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "平成19年度と平成20年度は２名、平成21年度は対象者がいらっしゃらない"@ja.
<< kg:id_77 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "次期の段階でこの条件でありますとか、利用実態を含めて条件などは少し見直しして、緩和できる部分については緩和"@ja.
<< kg:id_80 prop:effect kg:id_81 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "ともに悩みを打ち明け合うというようなところでも大変効果のある事業"@ja.
<< kg:id_80 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "曜日調整などもできますので、そういうようなことを御理解をいただいて、デイサービス事業所などと曜日変更をしながら"@ja.
<< kg:id_83 prop:cause kg:id_84 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "事故の内容を分析をしてみますと、うっかりミスがほとんど"@ja.
<< kg:id_83 prop:effect kg:id_85 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "毎回といっていいほど議会のほうに報告をし、そして御承認をいただいてきた"@ja.
<< kg:id_83 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "自動車学校の教習所の指導員による技能の研修"@ja.
<< kg:id_83 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "安全運転チャレンジ100"@ja.
<< kg:id_83 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "ハンドルキーパー運動"@ja.
<< kg:id_83 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "飲酒検知器については、平成19年度から各職場のほうに設置をし、運転前にやはり所属長が事前にチェック"@ja.
<< kg:id_90 prop:cause kg:id_91 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "直近の10月でも0.4ということでありまして、やはり雇用情勢は厳しい"@ja.
<< kg:id_90 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "国や県のこれらの雇用関係の事業などを積極的に取り入れ、実施すると同時に、市や商工会議所などでも雇用創出に係る事業"@ja.
<< kg:id_90 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "職員が市内の製造業48社を訪問して、業況等の聞き取りなどを行わせていただいております"@ja.
<< kg:id_90 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "誘致企業との定期的な懇談会も実施をし、雇用の拡大などについて商工会議所ともどもお願い"@ja.
<< kg:id_90 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "緊急雇用創出事業などのこういう事業を実施する"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "施設介護していただきたいという申し込み者が750人以上おられる"@ja.
<< kg:id_96 prop:effect kg:id_98 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "在宅介護で職を失って仕事が見つからない"@ja.
<< kg:id_96 prop:effect kg:id_99 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "仕事についている方々でも退職を余儀なくされている"@ja.
<< kg:id_96 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "１人で悩まずに市なり地域包括支援センターなりにぜひ相談をしていただきたい"@ja.
<< kg:id_101 prop:cause kg:id_102 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "多かった年、少なかった年、また急に何回も出動しなければならないほど降るときもあるし、朝方、日中、夜、予測できない状況"@ja.
<< kg:id_101 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "昨年に待機料等の費用の見直しを行っております"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "中山間地域、確かに平地と比べると非常に降雪量も多く"@ja.
<< kg:id_104 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "パトロールも十分に強化をしていく必要がある"@ja.
<< kg:id_107 prop:cause kg:id_108 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "合併特例債のほうが機動的であったので合併特例債を使ってきた"@ja.
<< kg:id_107 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "より有利なほうを有効に活用していくという観点で、過疎債、辺地債については活用"@ja.
<< kg:id_110 prop:effect kg:id_111 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "行政と新しい自治会とのスタンスをお答え願いたい"@ja.
<< kg:id_110 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "地域特性に応じた支援というのは、自治会に対する支援というのは、今後ともあっていい"@ja.
<< kg:id_110 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "行政の連絡役として御活動いただくときには一定の経費負担は市役所もしましょう"@ja.
<< kg:id_114 prop:cause kg:id_115 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "認定農業者の平均年齢は54.6歳。50歳、60歳以上のパーセンテージは75.7％"@ja.
<< kg:id_114 prop:countermeasure kg:id_116 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "ニューファーマー育成支援事業ということで、技術支援について一定の経費負担"@ja.
<< kg:id_114 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "市の農政部門、農業委員会、またＪＡ組織、県の農業技術の普及の担当部門と一体的にといいますか、ワンフロアの機能を持たせるような体制"@ja.
<< kg:id_114 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "さらに事例もいろいろ研究をさせていただいて検討をしてまいりたい"@ja.
<< kg:id_119 prop:cause kg:id_120 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "まだこの施行以来、市民のほうに徹底していない"@ja.
<< kg:id_119 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "指定の経過あるいは基準、それから指定管理者になったときの事業計画とかも、もっと市民にお知らせする工夫"@ja.
<< kg:id_122 prop:cause kg:id_123 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "国保税収・収納率の低下"@ja.
<< kg:id_122 prop:cause kg:id_124 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "医療費の増加傾向にあること"@ja.
<< kg:id_122 prop:effect kg:id_125 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "平成20年度は１億5,000万円ほど基金から繰り入れを行っている"@ja.
<< kg:id_126 prop:cause kg:id_127 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "ペナルティー的に減額される"@ja.
<< kg:id_126 prop:countermeasure kg:id_128 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "引き続き市長会などを通じて廃止を求めていきたい"@ja.
<< kg:id_129 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "低所得者層の負担軽減につながるような見直しがなされるというふうにも伺っておりますので、本市としてもそういう国の動きに合わせて見直し、対応をしたい"@ja.
<< kg:id_131 prop:effect kg:id_132 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "12月１日現在でありますが、資格証明書の該当世帯は17世帯"@ja.
<< kg:id_133 prop:effect kg:id_134 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "短期被保険者証の該当世帯は1,873世帯"@ja.
<< kg:id_133 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "送付ではなく直接お会いをしながら交付をさせていただくただいまの方法を維持したい"@ja.
<< kg:id_133 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "何か誤解をしている部分があるんじゃないかというお話もありましたので、そのことについては丁寧な周知に努めていく"@ja.
<< kg:id_137 prop:cause kg:id_138 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "医療現場の混雑の実体、また前の前倒し接種者などが全部終わらないうち、また次の前倒し接種者が来る"@ja.
<< kg:id_137 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "命を守ることを最優先に考えてインフルエンザのワクチン接種に対する助成については、今やるべきではない"@ja.
<< kg:id_140 prop:countermeasure kg:id_141 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "市の広報、それからコミュニティーＦＭ放送、さらには小児科医院などを通じて周知徹底を図っている"@ja.
<< kg:id_140 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "小中学校の児童・生徒につきましては、いわゆる任意接種ということでございますので、市による助成措置は考えていない"@ja.
<< kg:id_143 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "別室で受験していただくという方法については配慮してまいりたい"@ja.
<< kg:id_145 prop:cause kg:id_146 >>
    prop:stateBy kg:st_6;
    prop:text-txt_contents "追加試験問題をまた新たに作成をするということが、経費的にも、あるいは時間的にも大変難しい"@ja.
<< kg:id_145 prop:cause kg:id_147 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "試験問題の公平性をいかにして確保するか、こんなことも理由としては上げられている"@ja.
<< kg:id_148 prop:countermeasure kg:id_149 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "災害の種別に応じて避難路は変わるんだと、避難場所も恐らく変わるんだということも含めて情報を共有しながら"@ja.
<< kg:id_150 prop:effect kg:id_151 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "要援護者については12月現在で1,062名でございました。それに対する支援していただける方が1,425名"@ja.
<< kg:id_150 prop:countermeasure kg:id_152 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "各コミュニティ振興会、それから自治会長、それから民生委員とこういった方々に名簿と台帳の写しを手渡しながら"@ja.
<< kg:id_150 prop:countermeasure kg:id_153 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "支援者の方にも配付をいたします。これを使って日ごろから要援護者の方の状況だとか避難場所を支援者の方からは確認していただきたい"@ja.
<< kg:id_150 prop:countermeasure kg:id_154 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "要援護者とその支援者による避難誘導訓練、こういったことも実施していただくようなそういう要請"@ja.
<< kg:id_150 prop:countermeasure kg:id_155 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "現在ある市民防災ガイドブックの改訂時に盛り込む方法だとか、あるいは独自に作成をして配付をする"@ja.
<< kg:id_156 prop:cause kg:id_157 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "場所をどこにするのか、それからその指定した設備が整っているのか、それからその体制、だれがそういった中でその設営も含めてやっていくのか"@ja.
<< kg:id_156 prop:countermeasure kg:id_158 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "早期に場所の選定も含めて進めてまいりたい"@ja.
<< kg:id_159 prop:cause kg:id_160 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "酒田市役所の期日前投票所は５階にあり、しかも込み合った場合にはスペース的に狭い"@ja.
<< kg:id_159 prop:cause kg:id_161 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "今回は市議会議員及び市長選挙における期日前投票は６日間"@ja.
<< kg:id_159 prop:effect kg:id_162 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "ピーク時には30分ぐらいの待ち時間"@ja.
<< kg:id_159 prop:countermeasure kg:id_163 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "上田、本楯地区の人からの問い合わせには八幡総合支所に、東平田、中平田地区の人からの問い合わせには平田総合支所に案内"@ja.
<< kg:id_159 prop:countermeasure kg:id_164 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "新たに職員による誘導を図ったり、本人確認を行うパソコンも増設をして対応"@ja.
<< kg:id_159 prop:countermeasure kg:id_165 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "広報などを通じて投票期間の中での平準化を図ること、待ち時間を表示して一日の中での平準化を図る"@ja.
}
