kg:st_1 rdfs:label "市原栄子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "景気低迷の大きな要因だとみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "景気低迷の大きな要因だとみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "異常な構造が地域経済を厳しいものにしているとみる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "経済に持ち直しの動きがあっても厳しさは続くとみる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "最低賃金を時給1,000円以上へ引き上げる必要があると主張"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "阿部寿一市長"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_6 prop:content "一気に1,000円へ引き上げるのは難しいとみる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "最低賃金引き上げは企業経営との両立が必要と述べる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:st_3 rdfs:label "小野直樹商工観光部長"@ja.
kg:st_3 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_8 prop:content "一定の効果があったと評価"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "一定の効果があったと評価"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "最終年度に全額活用して雇用創出を図る考え"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "基金終了後の継続就労につなげたい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "利用しづらいのではないかと懸念"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "窓口を広げるべきと求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "決して使いにくい制度ではないとみる"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "幅広く有効活用してもらうよう努める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "全世代が安心して暮らせるまちづくりに福祉施策が重要と主張"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "より福祉の充実による市民生活の応援が必要と主張"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "福岡高裁判決を尊重し復活すべきと主張"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "国の制度の中で見直し対応すべきと述べる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "個々の自治体ではなく国の制度で対応すべきと述べる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "子育て世代の負担増につながると懸念"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "税の負担増は納税額以外にも影響すると指摘"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "3歳未満への7,000円上乗せは負担増回避のつじつま合わせではないかとみる"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "国民に約束した額を国の責任で確保すべきと述べる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "金銭給付だけでなく福祉制度や保育環境の整備を進めたい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "子ども手当だけで十分とは考えていない"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "子ども手当だけでなく総合的施策を進めたい"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "市民負担を将来にわたって大きくするのではないかと危惧"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "予算が組めない事態や赤字再建団体転落がないよう運営すると述べる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "償還ピークと交付税減少時期が重なるのではないかと懸念"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "償還で予算が組めない事態を避けるよう運営すると述べる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "少子高齢化で負担は年々増えると指摘"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "今回の市民負担増に影響していると指摘"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "一般会計からの繰り入れも必要だったと主張"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "市民負担増をなくすため必要と主張"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:st_4 rdfs:label "阿部直善健康福祉部長"@ja.
kg:st_4 rdf:type cls:st_18.
kg:op_36 prop:content "他保険加入者との公平性から妥当でないと述べる"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "大幅にふやすのは公平性の観点で問題があると述べる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "妥当ではないと考える"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:st_5 rdfs:label "後藤孝也議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_39 prop:content "日本全体の先行き不透明感が閉塞感を生んでいるとみる"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "閉塞感を生み出す要因と指摘"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "閉塞感を生み出す要因と指摘"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "閉塞感を生み出す要因と指摘"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "市民が将来像を共有すれば希望と安心感を持てると主張"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:st_6 rdfs:label "石堂栄一総務部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_44 prop:content "総合計画中期見直しの中で示し方を検討したいと述べる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_6.
kg:op_45 prop:content "使いやすさが増し効果を最大化したいと述べる"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "大きなセールスポイントになるとみる"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "2便化の効果を最大化したい"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "船のリサイクルなども含め集積を図る努力を続けたい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "高速道路無料化やおくりびと効果で増えているとみる"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "今後の大きな課題だと認識"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "大きなイベントと観光PRを結びつけたい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "国土交通省と連携し構想具体化を進めたい"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:st_7 rdfs:label "石川翼久教育長"@ja.
kg:st_7 rdf:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_53 prop:content "適正規模適正配置に努めていく考え"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "計画的かつ積極的に取り組む"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "バレイショ、ニンジン、タマネギをJAと連携して実験したい"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:st_8 rdfs:label "前田茂実農林水産部長"@ja.
kg:st_8 rdf:type cls:st_18.
kg:op_56 prop:content "世界的食糧不足に対応する第一歩と位置づける"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_8.
kg:op_57 prop:content "今後さらに割合が増える可能性もあるとみる"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "面積がどうなるか全く予断を許さないと認識"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "技術面の不安解消や参入障壁の是正を図る"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "大変大きなニュースであり努力していきたい"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "米輸出港指定をきっかけに新たに取り組むべきと述べる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "支援策を本格的に議論する場が必要と認識"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "漁業者支援策が必要と認識"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "売ることや加工まで取り組む必要があると述べる"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "港や魚市場のにぎわいづくりを市として支援したい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "重点プロジェクトや緊急課題に機動的に対処させたい"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "ネットワーク会議で各分野の役割を議論してきた"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "人工乾燥施設整備はそのネック是正のためと説明"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "循環システムづくりの成果の一つと位置づける"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "延べ17人の雇用を確保してきたと説明"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "内閣官房の新規就業支援モデル事業の議論も注視したい"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:st_9 rdfs:label "後藤仁議員"@ja.
kg:st_9 rdf:type cls:st_16.
kg:op_72 prop:content "何も手を打たなければ3会計予算は毎年10億円単位で増えると危惧"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_9.
kg:op_73 prop:content "元気で暮らせる仕組みづくりとともに重要と述べる"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "がん検診の充実を重要課題として取り組んでいる"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "予防や早期発見と並ぶ重要要素と述べる"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "公費助成を順次充実してきたと説明"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "公費助成を順次充実してきたと説明"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "公費助成を順次充実してきたと説明"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "この地域の大きな課題と認識"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "ここ何年間かしっかり取り組みたい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "設計と建設を分ける従来方式よりスピードアップしたい"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "現在の景気の低迷の大きな要因は、民間賃金が減り、国民の購買力が落ち込んでいることも要因に挙げられています"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "現在の景気の低迷の大きな要因は、民間賃金が減り、国民の購買力が落ち込んでいることも要因に挙げられています"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "他の東北５県と比べても山形県の雇用報酬は低く抑えられている状況であります。この異常な構造が、市長の所信表明で言われた経済に持ち直しの動きがあると言われているものの、地域経済を取り巻く環境は引き続き厳しいものにさせているものと考えます"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "地域経済を取り巻く環境は引き続き厳しいものにさせているものと考えます"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "労働者の最低賃金などが低いために地域経済の活性化ができないのではないか、最低賃金を上げるべきではないか"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "その企業経営が成り立たなくなるようであれば、それは雇用自体も失われるということになるわけであります"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "両基金事業による雇用が、有効求人倍率が低い中で地域における継続的な雇用機会の創出や、失業者の雇用の下支えをし、大変雇用者にも喜ばれるというようなことで一定の効果があったものと考えておるところでございます"@ja.
<< kg:id_10 prop:effect kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "両基金事業による雇用が、有効求人倍率が低い中で地域における継続的な雇用機会の創出や、失業者の雇用の下支えをし、大変雇用者にも喜ばれるというようなことで一定の効果があったものと考えておるところでございます"@ja.
<< kg:id_10 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "新年度におきましても、この基金をすべて、新年度、平成23年が最終年度ということになりますので、すべて使い切るように積極的に活用し、事業を行い、より一層の雇用創出を図りたいと考えておるところでございます"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "雇用者をそのまま正社員にした場合、30万円の一時金の支給制度もありますので、これも基金終了後の継続的な就労につながるように、活用をするようにもこれは努めていきたいと思っておるところでございます"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "県の要綱では耐震補強等の４項目の縛りがあり、利用しづらいのではという声も出ております"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "利用しづらいのではという声も出ております"@ja.
<< kg:id_16 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "このようなさまざまな政策的な住宅建設誘導の施策が充実していることを市民の皆さんや建設関係の業界の皆様にしっかりとＰＲをして、より幅広く有効に活用していただくような努力をしていきたいと思っております"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "人口の減少が言われる中で、市民が家族として全世代が安心して暮らしていけるまちづくりのために、福祉や子育て支援、暮らしを守るという施策が大変重要であり、必要であると考えます"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "より福祉の充実による市民生活の応援が必要であると考えます"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "昨年６月の福岡高裁で正当な理由のない保護基準の不利益変更に当たり違法という判決が出ています"@ja.
<< kg:id_24 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "老齢加算の問題についても、個々の自治体で対応するというよりは、国の制度の中でしっかりと見直しなり対応なりをしていただきたいものだというふうに思っております"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "年少扶養控除廃止等により、所得税がことし１月から、住民税も来年６月から増税になります"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "税の負担増は、直接払う納税額だけではなく保育料、医療費などに連動して影響が出てきます"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "３歳未満に限って7,000円の上乗せをするのは、年少扶養控除の廃止に伴う増税と差し引きで負担増にならないようにするつじつま合わせではないかと思うものであります"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "ぜひ、国民に約束した額などはしっかりと国の責任において確保していただきたいものだというふうに思っているところであります"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "妊婦健診の拡充を初め、幼児のための福祉制度の充実とか保育環境の整備など、さまざまな形での政策を充実していきたい"@ja.
<< kg:id_34 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "妊婦健診の拡充を初め、幼児のための福祉制度の充実とか保育環境の整備など、さまざまな形での政策を充実していきたい"@ja.
<< kg:id_34 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "妊婦健診の拡充を初め、幼児のための福祉制度の充実とか保育環境の整備など、さまざまな形での政策を充実していきたい"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "市民負担を将来にわたって大きくしてしまうのではないかと危惧するものでもあります"@ja.
<< kg:id_38 prop:effect kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "合併特例債の償還のピークと、合併による交付税の特例がなくなり交付税が減ってしまう時期とが重なるのではないでしょうか"@ja.
<< kg:id_38 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "私たち自身も常に中長期的な財政展望を持ちながら合併特例債の発行可能額をどう取り扱っていくのか、また今年度の事業展開に当たっては合併特例債などをどのように取り入れていくのかということを十分議論しながらやっているつもりでございます"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "介護納付金は、介護保険の利用状況や介護報酬などによって影響を受けるという構造の中、少子高齢化が進めばその負担は年々ふえていくことは否めません"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "今回は特に労働条件の悪いと言われている介護職の賃金改善による負担増も影響をしています"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "国保会計だけの努力では限界があることも確かです"@ja.
<< kg:id_48 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "今回の市民負担増をなくすためにも、市の一般会計からの繰り入れも必要だったと考えます"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "法定外の一般会計の繰り入れということでは、大幅にふやすというようなことは他の被保険者との関係からいっても公平性という観点で問題がある"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "今、日本全体が景気の低迷、少子化、高齢化、そして人口減少社会の到来など、先行き不透明なことによる将来への不安が閉塞感を生み出していると考えるのであります"@ja.
<< kg:id_54 prop:effect kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "今、日本全体が景気の低迷、少子化、高齢化、そして人口減少社会の到来など、先行き不透明なことによる将来への不安が閉塞感を生み出していると考えるのであります"@ja.
<< kg:id_55 prop:effect kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "今、日本全体が景気の低迷、少子化、高齢化、そして人口減少社会の到来など、先行き不透明なことによる将来への不安が閉塞感を生み出していると考えるのであります"@ja.
<< kg:id_56 prop:effect kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "今、日本全体が景気の低迷、少子化、高齢化、そして人口減少社会の到来など、先行き不透明なことによる将来への不安が閉塞感を生み出していると考えるのであります"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "まちづくりのビジョンを市民に明確に示して、堂々と今後の事業を展開すべきときだと思うところであります"@ja.
<< kg:id_59 prop:effect kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "コンテナが２便化したことは当然のことながら輸出入の機会が拡大したこと"@ja.
<< kg:id_59 prop:effect kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "釜山からの最初の我が国の寄港地が酒田港ということで、２日で到着するということでありますから、輸入におけるリードタイムの短縮が大きなセールスポイントになろうかと思います"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "こういうところをしっかりセールスポイントにしながら、ポートセールスを強化していって２便化の効果を最大にしていきたい"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "ぜひリサイクル関係の企業については、先ほど船のリサイクル、船の解体の御提案などもありましたけれども、もちろんそういうことも含めてリサイクル関係の集積を図るよう、さらに努力はしていきたい"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "交流人口は観光振興、そしてまた、高速道路の無料化、おくりびと効果などによってかなりの形で交流人口がふえてきていることは間違いないことだろうと思っております"@ja.
<< kg:id_66 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "今後はさらに情報発信をすることはもちろんでありますが、リピーターの確保ということも大きな課題ではないかなというふうに思っております"@ja.
<< kg:id_66 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "リピーターの確保のためには食とか体験イベント、そういうものも多く取り入れた観光メニューを提示していかなければならない"@ja.
<< kg:id_70 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "道の駅というものの構想の具体化に向けていろいろな検討は進めていきたいと思っております"@ja.
<< kg:id_72 prop:effect kg:id_73 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "教育人口統計によれば、今後も一層の学校の小規模化が進むということが予測されます"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "今後も計画的かつ積極的に耐震化に取り組んでいきたいと考えており、平成27年度の完了を目標に進めております"@ja.
<< kg:id_76 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "今考えているのは土地利用型の作物、新たなものとしてバレイショ、ニンジン、タマネギというような形で、カレーライスの具材となるような作物であり、しかも市場での需要も一定程度見込めるものについて、ＪＡと連携しながら、とりあえずことしは実験、実証してみたいというようなプロジェクトであります"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "生産調整面積が酒田市内で33.6％ということになりまして、やはりこの傾向、米余りの状況の中、またさらにこの割合がふえる可能性も持っているわけであります"@ja.
<< kg:id_80 prop:effect kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "特にＴＰＰというような話になってきた場合に、この面積がどのようになるのかというのは本当に全く予断を許さないというような状況"@ja.
<< kg:id_82 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "市としてはニューファーマー育成支援事業ということで、新たに農業に取り組む者、農業をやっているけれども新たな分野に挑戦したい人に対して支援をしている"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "米の中国への輸出港として酒田港が候補に上げられたということは大変大きなニュースだというふうに思います"@ja.
<< kg:id_86 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "米もまずメーンにしますが、それ以外の農産物もあわせて、中国初め日本海対岸諸国などへ売ると、売っていくという努力に新たに取り組む大事な年ではないか"@ja.
<< kg:id_88 prop:effect kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "やはり魚価の低迷、燃油初め石油製品の高騰によりまして、この沿岸の中小零細と言っていいと思いますが、漁業者が大変苦労している実態にある"@ja.
<< kg:id_90 prop:effect kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "魚価の低迷、燃油初め石油製品の高騰によりまして、この沿岸の中小零細と言っていいと思いますが、漁業者が大変苦労している実態にある"@ja.
<< kg:id_91 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "さらに売ることや加工することまで取り組む、漁業分野における６次産業化と言ってもいいと思いますが、そういう取り組みもやはりいろいろな水産加工の皆さん、食品業者などと連携してやっていかなければならない"@ja.
<< kg:id_93 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "魚市場祭りなどというような取り組みをやったりというような取り組みもあるわけでありますので、何とかこの港、魚市場のにぎわいづくりについて、市としても支援をしていきたい"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "政策推進課というものが身軽になった上でこういう重点プロジェクト、緊急に出てくるような地域課題、こういうものに対処していくことが非常に大事"@ja.
<< kg:id_97 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "よく言われることですが川上から川下までの循環をつくらければならないということで、その循環システムをつくるためのネットワーク、こういう会議を設けながら、それぞれの分野で何ができるのかということを議論してきたところであります"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "いわゆる乾燥材を必要なだけストックする、ストックすることができないとすれば要望に応じて直ちに乾燥材にする施設というものの不足が言われていた"@ja.
<< kg:id_99 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "そのネックを是正するためということで、この木材人工乾燥施設"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "森林組合では平成15年から林野庁の緑の雇用事業を活用して、延べ17人の雇用を確保している"@ja.
<< kg:id_102 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "この動きも注視しながら、林業分野における新規参入についてもバックアップをしていきたい"@ja.
<< kg:id_105 prop:effect kg:id_106 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "私はこの３会計の予算額は何も手を打たない場合、毎年確実に10億円単位でふえていくんではないかと危惧する１人でございます"@ja.
<< kg:id_107 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "市民が安心して地域社会に住み続けられるためには、まず一つ元気で地域で暮らしていけるような仕組みづくり、それから疾病の予防、それから疾病の早期発見、早期治療、この３つが重要"@ja.
<< kg:id_107 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "疾病の早期発見としてはがん検診の充実というようなことをかなり本市としては重要な政策課題として挙げて取り組んできている"@ja.
<< kg:id_107 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "市民が安心して地域社会に住み続けられるためには、まず一つ元気で地域で暮らしていけるような仕組みづくり、それから疾病の予防、それから疾病の早期発見、早期治療、この３つが重要"@ja.
<< kg:id_111 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "疾病予防については肺炎球菌ワクチンや子宮頸がんワクチンとか、インフルエンザワクチンへの助成など、このような公費助成を順次充実してきております"@ja.
<< kg:id_111 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "疾病予防については肺炎球菌ワクチンや子宮頸がんワクチンとか、インフルエンザワクチンへの助成など、このような公費助成を順次充実してきております"@ja.
<< kg:id_111 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "疾病予防については肺炎球菌ワクチンや子宮頸がんワクチンとか、インフルエンザワクチンへの助成など、このような公費助成を順次充実してきております"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "やはり冬場の健康づくりに課題を抱えているのがこの地域であることは間違いない"@ja.
<< kg:id_115 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "冬場の運動不足対策に対応するために、軽スポーツの普及、これをまず１つ大きなテーマとして取り上げて、ここ何年間かしっかり取り組んでみたい"@ja.
<< kg:id_118 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "なるべく前倒し、前倒しで事業をやるというようなことを実はことしの予算でもかなり試みているところであります"@ja.
}
