kg:id_138 rdfs:label "県を窓口にした1市2町での具体的協議"@ja.
kg:id_138 rdf:type cls:c_4116.
cls:c_4116 rdfs:label "広域協議"@ja.
kg:id_137 prop:countermeasure kg:id_138.
kg:st_1 rdfs:label "市原栄子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "暮らしと経済を破たんに導くと懸念する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "酒田市も大きな影響を受けると指摘する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "社会保障充実にならず切り捨てにつながると批判する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "経済と財政を共倒れにすると批判する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "暮らしと経済を破たんに導くと批判する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "阿部寿一市長"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_6 prop:content "新たな財源確保が必要だとする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "社会保障維持のため見直しは不可避とする"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "新たな財源確保の一つの道筋とする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "人口減少と税収伸び悩みに対応する必要があるとする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "毎年の償還額を踏まえた起債が必要とする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "最小限の費用で最大の効果を出す施設管理が必要とする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "将来の維持管理コスト軽減のため導入が必要とする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "活用期間が短い中で重点課題と位置づける"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "追い風を生かして強く働きかけるべきとする"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "引き続き力を入れる課題とする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "重点課題として力を入れるべきとする"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "東日本大震災を受けて十分力を入れるべきとする"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "町なかへの呼び込みと交流促進に必要とする"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "交流を重ねる工夫として必要とする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "市単独で要件は外せず改善要望を続けるとする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "地域特性を生かした検討を進めるべきとする"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "調査結果を踏まえ導入施策を検討したいとする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "制度上やむを得ない面があるとする"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "値上げ抑制のため活用したと説明する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "活用可能財源を全て使い値上げ抑制を図ったとする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "そのままでは負担が大きすぎると認識する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "最大限の抑制策で上昇率を抑えたと説明する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "働く加入者を支えるため繰り入れで値上げ回避すべきと求める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:st_3 rdfs:label "大石薫健康福祉部長"@ja.
kg:st_3 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_29 prop:content "公平性の観点から妥当ではないとする"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "負担増は避けがたいと説明する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "給付費上昇が保険料増の要因と説明する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "第1号被保険者に大きな負担をお願いすることになるとする"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "収入の少ない方の軽減策として講じる"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "保険料引き下げに活用したと説明する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:st_4 rdfs:label "地域説明会参加の市民"@ja.
kg:st_4 rdf:type cls:st_42.
cls:st_42 rdfs:label "市民"@ja.
kg:op_35 prop:content "高齢者増加による将来保険料を不安視する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "各市町村へ交付するよう要望した事実があると説明する"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:st_5 rdfs:label "富樫幸宏議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_37 prop:content "広域処理が進まない現状を憂慮する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "過度な警戒が支援を妨げているとみる"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "受け入れをためらう理由の一つと指摘する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "本市が役割を果たせるなら支援すべきとする"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "役立てることがないか声かけしていると説明する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "防災上の観点が大きく働いたとみる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "今が大事なチャンスであり強く訴えるべきとする"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "ここを改善しなければならないとする"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "コンテナ貨物利用拡大へ助成を行うとする"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "ターゲットを明確化して取り組むとする"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "内陸荷主確保のため必要とする"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "酒田港の特色をさらに伸ばしたいとする"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "実績づくりが重要で新年度しっかり取り組むとする"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "他地区より多い傾向があると分析する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "生活習慣病対策が必要とみる"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "早期発見早期治療につながるとする"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "受診率向上策として進めたいとする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "生活習慣改善のため大切とする"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "地域の実情に応じて配置したいとする"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "積極的に拡充しながら進めたいとする"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "心の健康も重要とする"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "本市の人的ネットワークを生かすとする"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "企業へ直接アプローチするとする"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "感触のある企業へきめ細かくフォローするとする"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "誘致企業の業況や要望を把握しているとする"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "理解を得ながら進める必要があるとする"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "担い手確保と合理化の観点から進めたいとする"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "園芸導入時のリスクと労働負担の軽減を図る"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "農家の収穫に大きな支障が生じていると認識する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "今年も市が一部応援したいとする"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "本格化直前で足踏みしたことを残念とする"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "具体的手順を踏んで進めるとする"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "ロット確保後は酒田港輸出に向かいたいとする"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "ニーズとシーズの掘り起こしを図るとする"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "観光分野も加えて連携を進めたいとする"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:st_6 rdfs:label "加藤裕総務部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_72 prop:content "津波被害想定見直しも盛り込んで作成するとする"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_6.
kg:op_73 prop:content "起こり得る災害を網羅した内容にしたいとする"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_6.
kg:st_7 rdfs:label "伊藤一幸建設部長"@ja.
kg:st_7 rdf:type cls:st_18.
kg:op_74 prop:content "多様なニーズに対応できる施設が望ましいとする"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_7.
kg:op_75 prop:content "酒田になぜ必要かを明確にし国の理解を得る必要があるとする"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_7.
kg:st_8 rdfs:label "石川翼久教育長"@ja.
kg:st_8 rdf:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_76 prop:content "交通事故や渋滞が懸念されるとする"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_8.
kg:op_77 prop:content "通学時の集中を避けるため必要とする"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_8.
kg:op_78 prop:content "混雑緩和のため配慮しているとする"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_8.
kg:op_79 prop:content "ルール徹底で解消に努めるとする"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_8.
kg:op_80 prop:content "高校生支援策として継続する"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_8.
kg:op_81 prop:content "来年度も継続する予定とする"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_8.
kg:op_82 prop:content "単なる執務空間ではなく市民の場とすべきとする"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "面的な広がりを持つまちづくりにつなげたいとする"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "中心部のまとまった公共用地として生かしたいとする"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_2.
kg:op_85 prop:content "広く意見を伺い具体案を練るべきとする"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:op_86 prop:content "結果を踏まえ事業化可否を詰めるべきとする"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_2.
kg:op_87 prop:content "具体化すれば補正も辞さない考えを示す"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_2.
kg:op_88 prop:content "にぎわいづくりや集客につながる施設を検討したいとする"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_2.
kg:op_89 prop:content "予算編成前段階で意見聴取を十分行うべきとする"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_2.
kg:op_90 prop:content "法律施行前から先行的に進めたいとする"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
kg:op_91 prop:content "災害時の迅速的確な意思決定に必要とする"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_2.
kg:op_92 prop:content "見直し結果に応じ再検討が必要とする"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_6.
kg:op_93 prop:content "県の見直し結果を受けて再検討するとする"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_6.
kg:op_94 prop:content "災害発生当初は自治会単位の対応が重要とする"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_6.
kg:st_9 rdfs:label "斎藤孝夫市民部環境衛生調整監"@ja.
kg:st_9 rdf:type cls:st_41.
cls:st_41 rdfs:label "調整監"@ja.
kg:op_95 prop:content "広域処理の枠組みで受け入れを検討するとする"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_9.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "消費税増税は市民生活への影響とともに、市の事業を執行する際にも発生してまいります"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "消費税増税は市民生活への影響とともに、市の事業を執行する際にも発生してまいります。そう考えたとき、市民とともに酒田市も消費税増税の大きな影響を受けると言わざるを得ません"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "残りの４％分は既存の社会保障財源と入れかわるだけであり、一体改革は社会保障を大幅に切り捨て"@ja.
<< kg:id_4 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "一体改革は社会保障を大幅に切り捨て、経済と財政を共倒れにします"@ja.
<< kg:id_4 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "暮らしと経済を破たんに導くものではないでしょうか"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "国債の発行額が税収を上回っているというのが今の現状"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "社会保障もかつては胴上げ型というようなことで複数、かなり多くの人で高齢者を支えてきたのが、いつのまにか騎馬戦型になり、間もなく肩車型になる"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "やはり消費税というものに一定の財源を求めていかざるを得ない状況にある"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これからやっていかなければならないことは、人口減少社会、そしてまた、税収も大幅な伸びが期待できない中での交付税の削減になりますので、定員の適正化"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "毎年毎年の償還額を見たような形での起債をいかに起こしていくか"@ja.
<< kg:id_14 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "維持管理についても可能な限りメンテナンスフリーみたいな形で、最小限の費用で最大の効果を出すような施設管理のあり方"@ja.
<< kg:id_14 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "維持管理費についてはアセットマネジメント的な考え方を早期に導入することで、将来にわたって維持管理コストが市民に重くのしかかることのないように"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "合併特例債をどうやって、もう活用期間が短くなってきているわけでありますが、それをいかに十分活用するかということが１つの重点"@ja.
<< kg:id_19 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "日本海沿岸東北自動車道などの社会資本整備について、今を追い風にしながらさらに関係方面に強く働きかけていく"@ja.
<< kg:id_19 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "さらに引き続きの課題でありますけれども、経済雇用対策"@ja.
<< kg:id_19 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "少子高齢化対策に力を入れるということ"@ja.
<< kg:id_19 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "東日本大震災を受けた災害対策、防災対策の充実ということも十分力を入れていかなければならない"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "例えば商品のギャラリー機能でありますとか"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "農商工連携の施設整備、仕組みづくり"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "その業界の皆さんの意見も踏まえながら、さらなる改善を働きかけていく"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "その中でも風力とかバイオマスの利用可能性が高い"@ja.
<< kg:id_30 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "新エネルギービジョンの中で、しっかりこのような調査結果なども踏まえて、地域特性を生かした可能性の検討をしていかなければならない"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "高齢化の進展などに伴いまして、この保険料を見直すたびに高くなる"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "余剰金の８億7,000万円"@ja.
<< kg:id_33 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "県の後期高齢者医療財政安定化基金について、国の定めた上限である保険料賦課総額の３％程度を残して15億6,000万円を投入"@ja.
<< kg:id_33 prop:effect kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "事務的な試算によりますと14.76％の保険料の引き上げが必要"@ja.
<< kg:id_33 prop:effect kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "結果的に上昇率を4.11％に抑えた"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "一般会計から繰り出しを行い値上げを回避する、こういった形で対策をとられるべき"@ja.
<< kg:id_39 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "一般会計からの法定外繰り入れにつきましては、公平性という観点では妥当ではない"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "高齢者の増加"@ja.
<< kg:id_42 prop:cause kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "介護サービス利用者の増加に伴い、介護サービス給付費が上昇している"@ja.
<< kg:id_42 prop:effect kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "第４段階の基準月額で5,200円と算定しているところでございます。第４期と比較して838円、19.2％の増"@ja.
<< kg:id_42 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "特例第３段階、これは基準額に対して65％の保険料とするものですけれども、こうしたものを新設"@ja.
<< kg:id_42 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "山形県の財政安定化基金を取り崩して介護保険料の引き下げに活用する"@ja.
<< kg:id_42 prop:effect kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "今後の高齢者の増加に伴う介護サービス給付費の増加から、その将来の保険料について不安の声が一部聞かれました"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "平成23年11月24日の市長会で、山形県分の取り崩しについて、各市町村に交付するようにできないかという要望をしたという事実はございます"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "みずから処理に名乗りを上げる自治体は数少なく、広域処理は遅々として進んでいない"@ja.
<< kg:id_51 prop:cause kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "これは原発事故による放射性物質を警戒したり"@ja.
<< kg:id_51 prop:cause kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "塩分を含んだ瓦れきによる焼却炉の破損を危惧したり"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "困っている地域の皆さんのために、本市が役割を果たせるのであればやはり果たしていかなければならない"@ja.
<< kg:id_55 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "関係の深い地域などについては個々に呼びかけをしてもいいというふうに思っておりまして、そういう意味ではどういうふうにお考えですか、私たちのほうで役立つことがありませんかということをお話している"@ja.
<< kg:id_58 prop:cause kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "東日本大震災において、三陸自動車道、仙台東部道路などが津波防災上重要な役割を果たし、防災、その後の復興において高規格の道路がいかに大事かということが明らかになった"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "環日本海時代を踏まえれば港相互の連携、もしくは太平洋側との連携をつくるような道路整備、あわせて訴えていく必要がある"@ja.
<< kg:id_62 prop:cause kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "県内の企業の酒田港利用率が決定的に低いというところがあるわけでありまして、現在で利用率は14％"@ja.
<< kg:id_62 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "利用拡大助成ということで、新たにコンテナ貨物の利用をふやしていただけるような人に対しての助成"@ja.
<< kg:id_62 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "ポートセールスのターゲットを明確化した戦略的なポートセールス"@ja.
<< kg:id_62 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "内陸地域の荷主の確保のために内陸地域でのオフドックコンテナヤード効果検証事業"@ja.
<< kg:id_62 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "さらにリサイクル貨物の集積、輸出入をふやしていきたい"@ja.
<< kg:id_62 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "新年度はこういう、新規需要米にもなるわけでありますので、こういう米の輸出ということについても、農協ほか関係機関と連携をとりながらしっかり頑張っていきたい"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "がんにかかる医療費が若干高いというような、他地区と比べると多い"@ja.
<< kg:id_69 prop:cause kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "生活習慣病についても他に比べても少し高い"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "受診率を上げることによって医療費の軽減というか、早期発見、早期治療によって救える命が救えたり"@ja.
<< kg:id_72 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "がん検診の無料クーポン券事業の対象の拡大"@ja.
<< kg:id_72 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "コミセン単位の健康事業の取り組みが大切"@ja.
<< kg:id_72 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "地域の実情に応じて簡便な器具を配置したり"@ja.
<< kg:id_72 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "運動指導、健康指導をする職員を派遣したりということについては、積極的にこれからも拡充しながらやっていきたい"@ja.
<< kg:id_72 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "精神科医師による心の健康相談の充実"@ja.
<< kg:id_79 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "本市の人的ネットワークを生かそうということで、ビジネス大使ネットワーク"@ja.
<< kg:id_79 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "１万社へのダイレクトメールの発送"@ja.
<< kg:id_79 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "少しでもいい感触を持っているところには職員が手分けして訪問をする、また、一歩進められそうなときには私自身も訪問をする"@ja.
<< kg:id_83 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "責任者の皆さんにお集まりいただいて、年２回、商工会議所ともども意見交換会をしております"@ja.
<< kg:id_85 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "十分な、地元に入り丁寧な説明をしながらこの計画の策定をしていかなければならない"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "集落営農組織の法人化も図っていきたい"@ja.
<< kg:id_87 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "育苗センター的なものをつくっていけば、そのリスク、労働力の負担も軽減しながら園芸に取り組む人をふやしていける"@ja.
<< kg:id_90 prop:cause kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "今回の豪雪被害の中でなかなか除雪まで手が回らないということから、農家自身が収穫に大きな支障が生じている"@ja.
<< kg:id_90 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "農協が主体となって除雪をした場合、その経費の一部について市が応援をするというようなことをことしもやりたい"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "東日本大震災が発生し、年間20万ｔの中国への輸出の合意がまだ具体化に至っていない"@ja.
<< kg:id_95 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "３月中に幾ら、どの程度出荷するのかということを確定し、圃場を特定した上で、６月末まで農政局のほうへ輸出米の数量を申請する予定"@ja.
<< kg:id_95 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "後々は酒田港からの輸出ということで向かっていきたい"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "６次産業化、農商工連携マッチング交流会ということで、市内の農業者でありますとか、農業団体、商工業団体等の皆さんとの交流会を行い、そのニーズ、シーズの掘り起こし"@ja.
<< kg:id_98 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "観光分野からも参加していただき、酒田アグリビジネス推進ネットワークというものを立ち上げて"@ja.
<< kg:id_101 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "来年度、平成24年度中の作成、発行を目指す"@ja.
<< kg:id_101 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "地震、それから津波、また台風、大雨、さらには土砂災害といったような風水害、それから雪の害、さらには火山噴火なども想定"@ja.
<< kg:id_104 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "国道７号と日沿道がほぼ並行して走ることになりますので、この施設を整備するとすれば、双方から利用できるような整備をする"@ja.
<< kg:id_104 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "地元の経済界、それから農業、商業、観光関係者などからも御支援をいただきながら、国のほうから御理解をもらう努力をしてまいりたい"@ja.
<< kg:id_107 prop:cause kg:id_108 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "あの周辺には小中高生含めて2,200人の子供たちが集中するところであります。懸念されるように、交通事故や渋滞"@ja.
<< kg:id_107 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "高校と小中学校の始業時間にタイムラグを設けて混雑しないように分散"@ja.
<< kg:id_107 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "通学ルートについても重ならないように"@ja.
<< kg:id_107 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "保護者の送迎車、それが乗降場が光ケ丘野球場の駐車場と２カ所"@ja.
<< kg:id_112 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "技能検定試験などがあるわけですが、訓練に必要な消耗品の購入の支援"@ja.
<< kg:id_112 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "就職活動を支援するセミナーの実施など、酒田市としても来年度も継続していく"@ja.
<< kg:id_115 prop:countermeasure kg:id_116 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "希望ホールなどとの連携のもとに交流の場、もしくはにぎわい創出の場というかスペース、そういうものをしっかり位置づけていかなければならない"@ja.
<< kg:id_115 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "中心市街地と観光施設を結ぶ、もしくは中継するというような機能を持たせていくことによって、単体としての市役所でなくて、面的な広がりを持たせたまちづくり"@ja.
<< kg:id_118 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "観光でありますとか、本市の歴史や文化などの土地柄を勉強していただいたり、もしくは市民の皆さんが汗を流したり憩いのスペースとして市民交流を深めたりというような形での複合施設として整備すべき"@ja.
<< kg:id_118 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "広く意見を伺い、具体的な構想を練るためのたたき台というか、骨格となるべき案をつくるべく、新年度予算で構想策定委員会の予算を計上"@ja.
<< kg:id_121 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "調査結果が出次第、関係の皆さんと意見交換をし"@ja.
<< kg:id_121 prop:countermeasure kg:id_123 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "補正予算でも組みながら事業化に前進をする"@ja.
<< kg:id_124 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "にぎわいづくりやその施設への集客につながるような公共的な施設が整備できないか、前向きに検討したい"@ja.
<< kg:id_126 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "支所の担当などを中心に、地域の皆さんの意見を聞き、事業の取捨選択をするという作業はこの予算編成の前段階で十分やっていただくよう"@ja.
<< kg:id_128 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "社会実験としていち早くその取り組みを進めてみたい"@ja.
<< kg:id_130 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "通信映像機器でありますとか、防災無線などを一定程度備えた会議室を設置し、いざ災害のときには迅速かつ的確な意思決定ができるような施設設備"@ja.
<< kg:id_132 prop:cause kg:id_133 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "この最新の津波浸水予測図につきましては、今後、県からこの詳細について示されるという予定"@ja.
<< kg:id_132 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "現行の津波ハザードマップ、あるいは防災行政無線、標高表示板等の整備の再検討が必要になる"@ja.
<< kg:id_135 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "自治会単位で避難誘導等の、あるいは安否確認などが重要になるといったようにとらえておりまして、自主防災会単位、自治会単位でのこの訓練の取り組みについて、あらゆる機会をとらえて働きかけてまいりたい"@ja.
<< kg:id_137 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "県に広域処理の窓口となっていただき、構成１市２町で具体的な受け入れについて協議をしてまいりたい"@ja.
}
