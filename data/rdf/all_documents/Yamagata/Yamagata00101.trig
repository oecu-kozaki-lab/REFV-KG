kg:st_1 rdfs:label "阿部寿一市長"@ja.
kg:st_1 rdf:type cls:st_76.
cls:st_76 rdfs:label "行政責任者"@ja.
kg:op_1 prop:content "効率的で健全な財政運営に努める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "行政サービスの維持向上に努めつつ改革プランを推進する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "行政サービスの維持向上に努めつつ改革プランを推進する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域経済への対策と景気雇用対策に積極対応した"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "加藤裕監査委員"@ja.
kg:st_2 rdf:type cls:st_77.
cls:st_77 rdfs:label "監査担当者"@ja.
kg:op_5 prop:content "財政の硬直化が懸念される"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "固定的経費の高止まりと財政硬直化を懸念"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "固定的経費の高止まりと財政硬直化を懸念"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "固定的経費の高止まりと財政硬直化を懸念"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "財源確保と財政基盤の安定化が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "事務事業見直しと基金積み立ての継続が必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "一方で有収水量は減少している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "今後90％を下回らないよう望む"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "新たな水運用システム構築と施設管理効率化が急務"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "配水能力の見直しに取り組むことが急務"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
