<< kg:id_83 prop:effect kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "今後の人口減少、少子高齢化の進展等を考えますと、扶助費、繰出金の増加、施設の維持補修費など固定的な経費が高どまりし、財政の硬直化を招くことが懸念されます"@ja.
<< kg:id_83 prop:effect kg:id_84 >>
    prop:stateBy kg:st_2;
