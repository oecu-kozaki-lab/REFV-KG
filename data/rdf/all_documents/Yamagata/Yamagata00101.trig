<< kg:id_77 prop:effect kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "東日本大震災に伴う被災地・避難者支援や影響を受けた本市地域経済への対策など、積極的に景気雇用対策にも対応してまいりました"@ja.
<< kg:id_79 prop:effect kg:id_80 >>
    prop:text-txt_contents "災害復旧費は、昨年６月から８月の大雨災害による復旧事業費の増加により490.7％の増となっております"@ja.
<< kg:id_81 prop:effect kg:id_82 >>
