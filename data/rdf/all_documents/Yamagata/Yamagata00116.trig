kg:st_1 rdfs:label "丸山市長"@ja.
kg:st_1 rdf:type cls:st_33.
cls:st_33 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "人口減少抑制に向けた総合対策に積極的に取り組むべきとする"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "国"@ja.
kg:st_2 rdf:type cls:st_6.
cls:st_6 rdfs:label "行政機関"@ja.
kg:op_2 prop:content "一極集中を是正し地方創生に取り組むべきとする"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "若い世代の結婚や子育ての希望の実現が必要とする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "人口減少抑制策の成否は将来人口に大きく影響するとみる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "人口減少抑制策の成否は本市の発展に大きく影響するとみる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地方人口ビジョンを策定し総合対策を進めるべきとする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "総合戦略を策定し人口減少抑制に取り組むべきとする"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "人口減少を抑制するには産業都市と交流都市としての活力再生が必要とする"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "市民参加によるまちづくりが必要とする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "国際的視野や知識を持つ人財育成が急務とする"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "高等教育機関と連携し地域社会や地域産業を担う人財を育成すべきとする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "大学の知見を生かし地域課題に向き合うべきとする"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "大学の知見を生かし雇用創出に向き合うべきとする"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "大学の知見を生かし中山間地域の活性化に取り組むべきとする"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "大学の知見とネットワークを生かし連携強化を図るべきとする"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "光丘文庫の保存公開を検討すべきとする"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "文化財書籍等の適切な保存公開を進めるべきとする"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "各産業の連携により地域経済力を強化すべきとする"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "産業連携で地域経済力を強化すべきとする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "人口減少を抑制し将来発展するため雇用基盤を強固にすべきとする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "地元への経済波及効果を意識して地域企業を育成すべきとする"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "企業の事業拡大を支援すべきとする"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "企業の海外展開を支援すべきとする"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "港湾都市としての優位性を踏まえ企業誘致に積極的に取り組むべきとする"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "関係機関と連携し新たな産業創出を進めるべきとする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "起業者育成によって産業力を強化すべきとする"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "米価下落に対応する取り組みを強化すべきとする"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "農業所得達成に向け経営の効率化を進めるべきとする"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "農地の集約化を推進すべきとする"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "複合経営を進めるべきとする"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "園芸作物の生産拡大を図るべきとする"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "高付加価値化のため六次産業化を推進すべきとする"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "高付加価値化のため農商工連携を推進すべきとする"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "高付加価値化のためグリーンツーリズムを推進すべきとする"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "地元産材の地産地消に向け循環型林業を構築すべきとする"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "間伐材活用のため新たな販路開拓を進めるべきとする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "庄内地域全体でブランド化を推進すべきとする"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "加工による高付加価値化を図るべきとする"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "雇用拡大につながる加工施設の誘致に取り組むべきとする"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "中長期の観光戦略を策定し誘客拡大を図るべきとする"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "中心市街地観光では回遊性向上が必要とする"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "山居倉庫と連携した観光客誘導施設を整備すべきとする"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "外国人を含む観光客を増やすためクルーズ船誘致に取り組むべきとする"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "広域連携を強化し魅力的な観光ルートを整備すべきとする"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "新たな地域の魅力創造のためジオパーク構想を推進すべきとする"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "高速交通網は地域経済発展に不可欠で整備促進が必要とする"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "庄内延伸は人口減少抑制に大きな効果をもたらすとみる"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "庄内延伸は本地域の発展につながるとみる"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "庄内延伸は山形県全体の発展につながるとみる"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "前市長が取り組んだ延伸プロジェクトを前進させるべきとする"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "県境未接続は物流や観光に大きなマイナスとする"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "沿線自治体と連携し国に早期完成を働きかけるべきとする"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "新庄酒田地域高規格道路の未着手区間整備を強力に働きかけるべきとする"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "コンテナヤード不足への対応整備が必要とする"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "コンテナヤード整備を進めるべきとする"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "高砂１号岸壁等の早期整備を国や県に働きかけるべきとする"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "県と一体となりポートセールスを展開すべきとする"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "駅周辺をにぎわいの拠点として整備すべきとする"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "対話型市場調査を踏まえ民間活力を活用すべきとする"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "中心市街地全体で回遊性を高め相乗効果を生むべきとする"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "地域福祉や防災などの担い手として地域コミュニティ強化が必要とする"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:op_62 prop:content "地域が自由に選択し実行できる仕組みづくりが必要とする"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_1.
kg:op_63 prop:content "地域内ネットワーク形成により集落生活圏を維持すべきとする"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:op_64 prop:content "飛島では漁業と観光の振興策に継続して取り組むべきとする"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "新たな資源と魅力を発掘するためジオパーク構想を推進すべきとする"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_1.
kg:op_66 prop:content "新たな資源と魅力の発掘は交流人口増加につながるとする"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_1.
kg:op_67 prop:content "移住相談総合窓口を設置し移住定住を増やすべきとする"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "各種支援制度を活用して移住定住者を増やすべきとする"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_1.
kg:op_69 prop:content "若者が地元に就職できるよう雇用基盤を強化すべきとする"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_1.
kg:op_70 prop:content "若者定着のため地元企業の魅力発信が必要とする"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_1.
kg:op_71 prop:content "若者定着のため郷土愛の醸成が必要とする"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
kg:op_72 prop:content "日本版CCRC構想は関係機関との連携を含め検討すべきとする"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_1.
kg:op_73 prop:content "教訓を生かし減災対策と即応体制の強化が必要とする"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_1.
kg:op_74 prop:content "複合災害で多くの命が失われた教訓を重視する"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_1.
kg:op_75 prop:content "豪雨災害への備えとして減災と即応体制強化が必要とする"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_1.
kg:op_76 prop:content "豪雨で大きな被害が発生したことを踏まえ備えを強化すべきとする"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_1.
kg:op_77 prop:content "気候変動等で従来想定外の災害が起き得るとする"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_1.
kg:op_78 prop:content "被害を最小限にする減災対策を推進すべきとする"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_1.
kg:op_79 prop:content "即応体制の充実強化が必要とする"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_1.
kg:op_80 prop:content "津波浸水想定区域内の消防本署等を移転改築すべきとする"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_1.
kg:op_81 prop:content "防災拠点として総合防災センターを整備すべきとする"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_1.
kg:op_82 prop:content "災害時の各世帯各事業所への情報伝達手段を充実すべきとする"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_1.
kg:op_83 prop:content "妊娠から子育てまで切れ目のない支援が必要とする"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_1.
kg:op_84 prop:content "安心して子供を産み育てられる環境づくりが必要とする"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_1.
kg:op_85 prop:content "多子世帯支援として同時入所要件を緩和すべきとする"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_1.
kg:op_86 prop:content "日本版ネウボラ機能を果たす支援センターを設置すべきとする"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_1.
kg:op_87 prop:content "妊娠期から子育て期まで一貫した相談支援体制を強化すべきとする"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_1.
kg:op_88 prop:content "加齢による身体機能の衰えを運動で補う事業を展開すべきとする"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_1.
kg:op_89 prop:content "健康増進施設を整備し中心市街地のにぎわい創出にもつなげるべきとする"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_1.
kg:op_90 prop:content "がん死亡率改善のため検診事業を拡充すべきとする"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_1.
kg:op_91 prop:content "住みなれた地域で安心して生活できるよう生活支援に取り組むべきとする"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_1.
kg:op_92 prop:content "認知症対策に引き続き取り組むべきとする"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_1.
kg:op_93 prop:content "地域包括ケアを推進すべきとする"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_1.
kg:op_94 prop:content "新しい介護予防日常生活支援事業を推進すべきとする"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_1.
kg:op_95 prop:content "新たなサービス提供体制を整備すべきとする"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_1.
kg:op_96 prop:content "障がい者福祉計画に基づき各種福祉サービスを推進すべきとする"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_1.
kg:op_97 prop:content "高齢者や障がい者に限らず地域で支え合うことが重要とする"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_1.
kg:op_98 prop:content "地球環境に優しい再生可能エネルギーの普及促進を図るべきとする"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_1.
kg:op_99 prop:content "自然環境の保護を進めるべきとする"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_1.
kg:op_100 prop:content "環境影響評価に基づき影響回避低減を図るべきとする"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_1.
kg:op_101 prop:content "市民と話し合いながら有料化も含め方向性を検討すべきとする"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_1.
kg:op_102 prop:content "重点施策実施には不断の行財政改革が必要とする"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_1.
kg:op_103 prop:content "交付税削減を踏まえ行財政改革が必要とする"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_1.
kg:op_104 prop:content "重点施策実施のため聖域なく行財政改革を断行すべきとする"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_1.
kg:op_105 prop:content "現状サービスのまま全施設維持は不可能とする"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_1.
kg:op_106 prop:content "アセットマネジメントに基づく施設管理を進めるべきとする"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_1.
kg:op_107 prop:content "施設の統廃合による再配置を進めるべきとする"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_1.
kg:op_108 prop:content "多様な市民の提言や意見交換の仕組みをつくるべきとする"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_1.
kg:st_3 rdfs:label "加藤監査委員"@ja.
kg:st_3 rdf:type cls:st_44.
cls:st_44 rdfs:label "監査機関"@ja.
kg:op_109 prop:content "原因究明と適正なシステム処理及び相互チェック体制の構築が必要とする"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_3.
kg:op_110 prop:content "決算の適正を期すため原因究明が必要とする"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_3.
kg:op_111 prop:content "適正なシステム処理が必要とする"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_3.
kg:op_112 prop:content "相互チェック体制を構築すべきとする"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_3.
kg:op_113 prop:content "滞納整理事務の改善と的確な債権管理が必要とする"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_3.
kg:op_114 prop:content "時効中断措置を適切にとるべきとする"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_3.
kg:op_115 prop:content "的確な債権管理のため担当職員の専門性向上が必要とする"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_3.
kg:op_116 prop:content "規則どおりの管理に努めるべきとする"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_3.
kg:op_117 prop:content "物品現在高調書を含め規則どおりの管理に努めるべきとする"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_3.
kg:op_118 prop:content "少額基金や長期間不変の基金は見直すべきとする"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_3.
kg:op_119 prop:content "基金利子だけでなく基金取り崩し活用も検討すべきとする"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_3.
kg:op_120 prop:content "外部評価の導入に向けた検討が必要とする"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_3.
kg:op_121 prop:content "何らかの形で外部評価を導入すべきとする"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_3.
kg:op_122 prop:content "人口減少に見合ったコスト意識で行政サービスと公共施設を管理すべきとする"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_3.
kg:op_123 prop:content "コストとストック把握のため新地方公会計を活用すべきとする"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_3.
kg:op_124 prop:content "全職員に意義を周知徹底すべきとする"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_3.
kg:op_125 prop:content "料金回収率100％回復を目標に経営努力を続けるべきとする"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_3.
kg:op_126 prop:content "業務状況の減少傾向を踏まえ経営改善が必要とする"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_3.
kg:op_127 prop:content "給水栓数減少を踏まえ経営改善が必要とする"@ja.
kg:op_127 rdf:type cls:opinion.
kg:op_127 prop:speaker kg:st_3.
kg:op_128 prop:content "配水量減少を踏まえ施設規模見直しが必要とする"@ja.
kg:op_128 rdf:type cls:opinion.
kg:op_128 prop:speaker kg:st_3.
kg:op_129 prop:content "有収水量減少を踏まえ経営改善が必要とする"@ja.
kg:op_129 rdf:type cls:opinion.
kg:op_129 prop:speaker kg:st_3.
kg:op_130 prop:content "不明水量が異常に多い地区などを重点的に調査すべきとする"@ja.
kg:op_130 rdf:type cls:opinion.
kg:op_130 prop:speaker kg:st_3.
kg:op_131 prop:content "無効水量対策として重点調査が必要とする"@ja.
kg:op_131 rdf:type cls:opinion.
kg:op_131 prop:speaker kg:st_3.
kg:op_132 prop:content "配水能力削減に向け施設規模の検討を急ぐべきとする"@ja.
kg:op_132 rdf:type cls:opinion.
kg:op_132 prop:speaker kg:st_3.
kg:op_133 prop:content "施設規模の検討を急ぐべきとする"@ja.
kg:op_133 rdf:type cls:opinion.
kg:op_133 prop:speaker kg:st_3.
kg:op_134 prop:content "料金回収率100％回復を目標にすべきとする"@ja.
kg:op_134 rdf:type cls:opinion.
kg:op_134 prop:speaker kg:st_3.
kg:op_135 prop:content "引き続き100％回復を目標に経営努力を求める"@ja.
kg:op_135 rdf:type cls:opinion.
kg:op_135 prop:speaker kg:st_3.
kg:op_136 prop:content "安全で良質な水の安定供給のため老朽施設設備を更新すべきとする"@ja.
kg:op_136 rdf:type cls:opinion.
kg:op_136 prop:speaker kg:st_3.
kg:op_137 prop:content "病院事業は体制強化し適正な決算対応が必要とする"@ja.
kg:op_137 rdf:type cls:opinion.
kg:op_137 prop:speaker kg:st_3.
kg:op_138 prop:content "病床利用率減少を踏まえ経営改善が必要とする"@ja.
kg:op_138 rdf:type cls:opinion.
kg:op_138 prop:speaker kg:st_3.
kg:op_139 prop:content "新会計基準の正しい理解と適正処理が必要とする"@ja.
kg:op_139 rdf:type cls:opinion.
kg:op_139 prop:speaker kg:st_3.
kg:op_140 prop:content "外部委託などで台帳整備を進めるべきとする"@ja.
kg:op_140 rdf:type cls:opinion.
kg:op_140 prop:speaker kg:st_3.
kg:op_141 prop:content "次年度決算の正確性確保のため外部委託などの対策を講ずべきとする"@ja.
kg:op_141 rdf:type cls:opinion.
kg:op_141 prop:speaker kg:st_3.
kg:op_142 prop:content "コンプライアンス遵守のため内部統制強化が必要とする"@ja.
kg:op_142 rdf:type cls:opinion.
kg:op_142 prop:speaker kg:st_3.
kg:op_143 prop:content "病院任せにしない内部統制強化が必要とする"@ja.
kg:op_143 rdf:type cls:opinion.
kg:op_143 prop:speaker kg:st_3.
kg:op_144 prop:content "コンプライアンス遵守を徹底するため内部統制を強化すべきとする"@ja.
kg:op_144 rdf:type cls:opinion.
kg:op_144 prop:speaker kg:st_3.
kg:op_145 prop:content "正しい手続で適正な決算に向け病院事務局の体制強化を図るべきとする"@ja.
kg:op_145 rdf:type cls:opinion.
kg:op_145 prop:speaker kg:st_3.
kg:st_4 rdfs:label "田中廣酒田駅周辺検討特別委員会委員長"@ja.
kg:st_4 rdf:type cls:st_87.
cls:st_87 rdfs:label "議会委員長"@ja.
kg:op_146 prop:content "駅周辺整備は白紙から検討し直す必要があったとする"@ja.
kg:op_146 rdf:type cls:opinion.
kg:op_146 prop:speaker kg:st_4.
kg:op_147 prop:content "頓挫を受け駅周辺のあるべき姿を白紙から検討したとする"@ja.
kg:op_147 rdf:type cls:opinion.
kg:op_147 prop:speaker kg:st_4.
kg:op_148 prop:content "当局とともに白紙から検討を重ねるべきとした"@ja.
kg:op_148 rdf:type cls:opinion.
kg:op_148 prop:speaker kg:st_4.
kg:op_149 prop:content "今後の駅周辺整備の指針としてグランドデザイン策定が必要とする"@ja.
kg:op_149 rdf:type cls:opinion.
kg:op_149 prop:speaker kg:st_4.
kg:op_150 prop:content "短期整備として旧ジャスコ跡地整備を進めるべきとする"@ja.
kg:op_150 rdf:type cls:opinion.
kg:op_150 prop:speaker kg:st_4.
kg:op_151 prop:content "手戻りの生じない部分の駅前広場整備を進めるべきとする"@ja.
kg:op_151 rdf:type cls:opinion.
kg:op_151 prop:speaker kg:st_4.
kg:op_152 prop:content "回遊ルート形成が必要とする"@ja.
kg:op_152 rdf:type cls:opinion.
kg:op_152 prop:speaker kg:st_4.
kg:op_153 prop:content "実現可能性の高い事業内容検討のため対話型市場調査を実施すべきとする"@ja.
kg:op_153 rdf:type cls:opinion.
kg:op_153 prop:speaker kg:st_4.
kg:op_154 prop:content "市場調査結果を踏まえ事業者提案公募を実施すべきとする"@ja.
kg:op_154 rdf:type cls:opinion.
kg:op_154 prop:speaker kg:st_4.
kg:op_155 prop:content "駅周辺整備は市民生活と中心市街地活性化に重要とする"@ja.
kg:op_155 rdf:type cls:opinion.
kg:op_155 prop:speaker kg:st_4.
kg:op_156 prop:content "駅周辺整備は新たな魅力と都市機能を生み出すとする"@ja.
kg:op_156 rdf:type cls:opinion.
kg:op_156 prop:speaker kg:st_4.
kg:op_157 prop:content "駅周辺整備は人口減少社会に対応する重要な鍵とする"@ja.
kg:op_157 rdf:type cls:opinion.
kg:op_157 prop:speaker kg:st_4.
kg:st_5 rdfs:label "荒生令悦議会活性化検討特別委員会委員長"@ja.
kg:st_5 rdf:type cls:st_87.
kg:op_158 prop:content "市民にもわかりやすい一般質問方法として選択制導入が適当とする"@ja.
kg:op_158 rdf:type cls:opinion.
kg:op_158 prop:speaker kg:st_5.
kg:op_159 prop:content "決算審査では分科会方式を継続すべきとする"@ja.
kg:op_159 rdf:type cls:opinion.
kg:op_159 prop:speaker kg:st_5.
kg:op_160 prop:content "決算審査で重点的に検討するテーマ設定が必要とする"@ja.
kg:op_160 rdf:type cls:opinion.
kg:op_160 prop:speaker kg:st_5.
kg:op_161 prop:content "委員長報告は新年度予算に反映できる提案型とすべきとする"@ja.
kg:op_161 rdf:type cls:opinion.
kg:op_161 prop:speaker kg:st_5.
kg:op_162 prop:content "今後も継続的に調査検討する場を設けるべきとする"@ja.
kg:op_162 rdf:type cls:opinion.
kg:op_162 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "誰もが経験したことのない急激な少子高齢化は、全国の自治体に人口減少対策にどう取り組むのかという大きな課題を突きつけております。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "国は東京への一極集中の是正、それと若い世代の結婚や子育ての希望の実現、これによって人口減少を克服するために、地方創生を旗印に、まち・ひと・しごと創生に取り組んでいます。"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "国は東京への一極集中の是正、それと若い世代の結婚や子育ての希望の実現、これによって人口減少を克服するために、地方創生を旗印に、まち・ひと・しごと創生に取り組んでいます。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "その成否は将来的な本市の人口、本市の発展に大きな影響を与えるものと考えています。"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "その成否は将来的な本市の人口、本市の発展に大きな影響を与えるものと考えています。"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "本市においても、地方人口ビジョン、酒田市まち・ひと・しごと創生総合戦略の策定を進めながら人口減少抑制に向けた総合対策に積極的に取り組んでおります。"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本市においても、地方人口ビジョン、酒田市まち・ひと・しごと創生総合戦略の策定を進めながら人口減少抑制に向けた総合対策に積極的に取り組んでおります。"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "人口減少を抑制する確かな道を切り開くためには、まずは本市の産業都市、そして交流都市としての活力を再生しなければなりません。"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "そのためには、かつて自由都市として繁栄した歴史を踏まえ、全ての市民がまちづくりに関心を持ち、政策形成に参画し行動することにより、にぎわいあふれる酒田、夢あふれる酒田を実現する必要があります。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "国境を越えた社会・経済活動が日常化する中、国際的な視野や知識を持ったグローバルな人財を育成することが急務となっています。"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "高等教育機関と連携しながら、地域社会や地域産業を担う人財の育成にも積極的に取り組み、人財を生かしたにぎわいあふれるまちづくりを進めてまいります。"@ja.
<< kg:id_15 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "現在、文部科学省から地（知）の拠点整備事業の認定を受け、人口減少、雇用の場の創出、中山間地域の活性化など、本地域の課題に正面から向き合い取り組んでおります。"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "現在、文部科学省から地（知）の拠点整備事業の認定を受け、人口減少、雇用の場の創出、中山間地域の活性化など、本地域の課題に正面から向き合い取り組んでおります。"@ja.
<< kg:id_15 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "現在、文部科学省から地（知）の拠点整備事業の認定を受け、人口減少、雇用の場の創出、中山間地域の活性化など、本地域の課題に正面から向き合い取り組んでおります。"@ja.
<< kg:id_15 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "東北公益文科大学の知見とネットワークを生かしながら、さらなる連携の強化を図り、市と大学が一体となった大学まちづくりを推進していきます。"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "特に老朽化が課題となっている光丘文庫には、山形県指定文化財となっている書籍等が多く収蔵されていることから、書籍等の適切な保存や公開が図られるよう検討を進めていきます。"@ja.
<< kg:id_19 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "書籍等の適切な保存や公開が図られるよう検討を進めていきます。"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "本市がまちのにぎわいを創出し飛躍的に発展していくためには、商工業、農林水産業等の各産業の連携により地域経済力を強化する必要があります。"@ja.
<< kg:id_22 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "商工業、農林水産業等の各産業の連携により地域経済力を強化する必要があります。"@ja.
<< kg:id_25 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "人口減少を抑制し、市が将来的に発展していくためには、雇用基盤をさらに強固なものにしていく必要があります。"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "地域企業の育成に関しては、地元への経済波及効果を意識した施策展開に努めるとともに、各企業等の事業拡大や海外展開を支援してまいります。"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "各企業等の事業拡大や海外展開を支援してまいります。"@ja.
<< kg:id_25 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "各企業等の事業拡大や海外展開を支援してまいります。"@ja.
<< kg:id_25 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "港湾都市としての高い優位性を踏まえ、あらゆる人的パイプと組織を活用しながら、企業誘致にも積極的に取り組んでいきます。"@ja.
<< kg:id_30 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "山形県、東北公益文科大学、民間事業者と連携をし、新たな産業の創出に向けた取り組みや起業者の育成に向けた取り組みによって、本市の産業力の強化を図ります。"@ja.
<< kg:id_30 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "新たな産業の創出に向けた取り組みや起業者の育成に向けた取り組みによって、本市の産業力の強化を図ります。"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "夢がありもうかる農業を目指して、米価下落に対応する取り組みを強化しながら"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "１人年間400万円の農業所得の達成に向けて、経営の効率化、農地の集約化を推進するとともに、複合経営や園芸作物の生産拡大を図ります。"@ja.
<< kg:id_33 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "経営の効率化、農地の集約化を推進するとともに"@ja.
<< kg:id_33 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "複合経営や園芸作物の生産拡大を図ります。"@ja.
<< kg:id_33 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "複合経営や園芸作物の生産拡大を図ります。"@ja.
<< kg:id_33 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "農産物の高付加価値化を図るため、産学官のネットワークを最大限活用しながら魅力ある商品開発、販路開拓を促進するなど、農業の六次産業化、農商工連携及びグリーンツーリズムを推進していきます。"@ja.
<< kg:id_33 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "農業の六次産業化、農商工連携及びグリーンツーリズムを推進していきます。"@ja.
<< kg:id_33 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "農業の六次産業化、農商工連携及びグリーンツーリズムを推進していきます。"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "森林組合や森林所有者と連携しながら、豊富な地元産材の地産地消に向けた循環型林業の構築"@ja.
<< kg:id_42 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "間伐材を有効に活用するための新たな販路を開拓する取り組みを進め、元気な林家の育成に努めていきます。"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "漁業については、庄内地域全体でのブランド化を推進し"@ja.
<< kg:id_45 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "加工により高付加価値化を図り"@ja.
<< kg:id_45 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "雇用拡大につながるよう加工施設の誘致にも取り組みます。"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "観光振興に関しては、中長期の観光戦略を策定し、酒田の魅力を共有しながら、官民を挙げて観光誘客の拡大を図っていきます。"@ja.
<< kg:id_49 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "山居倉庫を中心に、港湾区域との連携も図りながら回遊性を高める取り組みを進めます。"@ja.
<< kg:id_49 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "隣接する旧商業高校跡地については、山居倉庫と連携し、まちなかへ観光客を誘導する機能をあわせ持つ施設を整備する方向で基本構想を策定していきます。"@ja.
<< kg:id_49 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "外国人を含む観光客をふやしていくために、国内外のクルーズ船誘致に取り組むとともに"@ja.
<< kg:id_49 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "近隣市町村や県境を越えた広域連携を強化し、魅力的な観光ルート整備に取り組んでいきます。"@ja.
<< kg:id_49 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "新たな地域の魅力を創造するため、広域連携により鳥海山・飛島ジオパーク構想を推進していきます。"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "高速交通網は、産業振興、観光振興、農林水産業振興など本地域の経済的な発展に不可欠な社会基盤であります。"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "山形新幹線庄内延伸は、人口減少抑制に大きな効果をもたらし"@ja.
<< kg:id_58 prop:effect kg:id_60 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "本地域の発展だけでなく山形県全体の飛躍的発展につながるものであります。"@ja.
<< kg:id_58 prop:effect kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "本地域の発展だけでなく山形県全体の飛躍的発展につながるものであります。"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "本間前市長がまさに命を賭して取り組んだ山形新幹線庄内延伸プロジェクトを着実に前進させていきます。"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "県境間が未接続である限り、物流や観光の面で大きなマイナス効果となっていることは否めません。"@ja.
<< kg:id_64 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "一刻も早い開通のために、沿線自治体と連携しながら、我々の声をしっかりと国に届け、早期完成を目指します。"@ja.
<< kg:id_67 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "未着手区間の早期整備着手を国に強力に働きかけていきます。"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "コンテナヤードの不足に対応する整備や今後の港湾機能の強化を図る高砂１号岸壁等の早期整備について"@ja.
<< kg:id_69 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "コンテナヤードの不足に対応する整備"@ja.
<< kg:id_69 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "高砂１号岸壁等の早期整備について、国や県に対して強く働きかけていきます。"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "山形県と一体となって県内外の企業に積極的なポートセールス活動を展開し、さらなる酒田港の利用拡大に努めていきます。"@ja.
<< kg:id_75 prop:cause kg:id_76 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "駅及びその周辺をにぎわいの拠点として整備し、そのにぎわいを中心市街地全体に波及させることが必要です。"@ja.
<< kg:id_75 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "現在実施している対話型市場調査を踏まえて、民間活力を最大限活用した駅周辺整備を具体化してまいります。"@ja.
<< kg:id_75 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "駅前を含む拠点エリア間の回遊性の向上を図り、相乗効果によるにぎわい創出を進めていきます。"@ja.
<< kg:id_79 prop:effect kg:id_80 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "地域における課題が複雑化する中、地域福祉、防災対策、社会教育など、多様な分野の担い手となる地域コミュニティの重要性が大きく高まっています。"@ja.
<< kg:id_79 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "地域に合った取り組みを地域コミュニティみずからが自由に選択し実行できる仕組みづくりとして、「ひとづくり・まちづくり交付金（仮称）」でありますが、その制度の創設に取り組みます。"@ja.
<< kg:id_82 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "地域の中でのネットワーク形成により集落生活圏を維持する「小さな拠点」の形成"@ja.
<< kg:id_84 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "離島である飛島地区については、漁業と観光の振興策に継続して取り組むとともに"@ja.
<< kg:id_84 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "鳥海山・飛島ジオパーク構想を推進することにより、新たな資源と魅力を発掘し、交流人口の増加を図っていきます。"@ja.
<< kg:id_84 prop:effect kg:id_86 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "新たな資源と魅力を発掘し、交流人口の増加を図っていきます。"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "本年度から国の地方創生の流れの中、新たに移住相談総合窓口を設置するとともに"@ja.
<< kg:id_87 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "移住に向けた各種支援制度をスタートさせました。本市の魅力をしっかりと伝え、移住定住者をふやしていきます。"@ja.
<< kg:id_90 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "特に、若者が地元に就職できるよう雇用基盤の強化とあわせ"@ja.
<< kg:id_90 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "地元企業の魅力発信、郷土愛の醸成など総合的な取り組みを展開していきます。"@ja.
<< kg:id_90 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "地元企業の魅力発信、郷土愛の醸成など総合的な取り組みを展開していきます。"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "「生涯活躍のまち（日本版ＣＣＲＣ構想）」に関する取り組みについては、本市が有する医療機関や高等教育機関との連携も含めながら検討を進めてまいります。"@ja.
<< kg:id_96 prop:cause kg:id_97 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "東日本大震災では、地震と津波による複合災害により多くの尊い命が失われました。"@ja.
<< kg:id_96 prop:effect kg:id_98 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "東日本大震災では、地震と津波による複合災害により多くの尊い命が失われました。"@ja.
<< kg:id_99 prop:cause kg:id_100 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "本年９月にも東日本の広い範囲で豪雨に見舞われ、河川の決壊等により大きな被害が発生いたしました。"@ja.
<< kg:id_99 prop:effect kg:id_101 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "河川の決壊等により大きな被害が発生いたしました。"@ja.
<< kg:id_102 prop:cause kg:id_103 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "近年の気候変動等によって従来では考えられないような災害が、いつ、どこで起きるかわからない状況にあります。"@ja.
<< kg:id_102 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "被害を最小限に食い止める減災対策や災害時に即応できる体制の充実強化を推進することにより"@ja.
<< kg:id_102 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "災害時に即応できる体制の充実強化を推進することにより"@ja.
<< kg:id_102 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "津波浸水想定区域内にある消防本署等を移転改築するほか"@ja.
<< kg:id_102 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "防災拠点として酒田市総合防災センター、仮称でありますが、その整備を進め、防災体制の強化を図ります。"@ja.
<< kg:id_108 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "コミュニティＦＭ放送と連携し、各世帯、各事業所への情報伝達手段の充実についても検討をしてまいります。"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "急激な少子化の進行などにより、子供とその親を取り巻く環境が大きく変化しています。"@ja.
<< kg:id_110 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "妊娠から出産、子育てまで切れ目のない支援をしていくことによって、安心して子供を産み育てられる環境づくりに努めてまいります。"@ja.
<< kg:id_113 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "この同時入所要件の緩和を進めてまいります。"@ja.
<< kg:id_115 prop:countermeasure kg:id_116 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "日本版ネウボラの機能を果たす子育て世代包括支援センター、仮称でありますが、これを設置することにより、妊娠期から子育て期までの一貫した母親の総合相談支援体制の強化を図ります。"@ja.
<< kg:id_115 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "妊娠期から子育て期までの一貫した母親の総合相談支援体制の強化を図ります。"@ja.
<< kg:id_118 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "加齢による身体機能の衰えなどを運動でカバーするため、多様な健康づくり事業を展開するとともに"@ja.
<< kg:id_118 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "中心市街地のにぎわい創出にもつながる健康増進施設、中町にぎわいプラザ、仮称でありますが、これを整備してまいります。"@ja.
<< kg:id_121 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "本市のがん死亡率の高い現状を改善するために、がん検診事業の拡充にも取り組んでまいります。"@ja.
<< kg:id_123 prop:countermeasure kg:id_124 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "高齢者への生活支援や認知症対策等の課題に引き続き取り組むとともに"@ja.
<< kg:id_123 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "認知症対策等の課題に引き続き取り組むとともに"@ja.
<< kg:id_123 prop:countermeasure kg:id_126 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "地域包括ケアや介護保険法改正に伴う新しい介護予防・日常生活支援事業を推進し"@ja.
<< kg:id_123 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "新しい介護予防・日常生活支援事業を推進し、新たなサービス提供体制を整備いたします。"@ja.
<< kg:id_123 prop:countermeasure kg:id_128 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "新たなサービス提供体制を整備いたします。"@ja.
<< kg:id_129 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "障がい者福祉計画に基づき、各種福祉サービスを推進し"@ja.
<< kg:id_131 prop:countermeasure kg:id_132 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "これからは地域での支え合いが重要です。健康で生きがいを持って暮らすことができるよう、みんなで支えるまちづくりを進めてまいります。"@ja.
<< kg:id_133 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "地球環境に優しい再生可能エネルギーの普及促進を図るとともに、自然環境の保護を進めていきます。"@ja.
<< kg:id_133 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "自然環境の保護を進めていきます。"@ja.
<< kg:id_136 prop:countermeasure kg:id_137 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "環境影響評価に基づき、環境への影響を回避もしくは最大限低減しながら事業を実施し"@ja.
<< kg:id_138 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "廃棄物の減少対策については、市民の皆様と話し合いをしながら、有料化も含めた将来的な方向性を検討していきます。"@ja.
<< kg:id_140 prop:cause kg:id_141 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "有利な財源である合併特例債の発行残高が減少するとともに"@ja.
<< kg:id_140 prop:cause kg:id_142 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "普通交付税の合併算定替の期間が終了し、普通交付税が段階的に削減されていくことになります。"@ja.
<< kg:id_140 prop:countermeasure kg:id_143 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "多様な行政ニーズに対応し、これまで申し上げてきた施策を重点的に実施していくためには、聖域なく不断の行財政改革を断行しなければなりません。"@ja.
<< kg:id_144 prop:cause kg:id_145 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "今後改築期を迎える多数の公の施設があり、これら全てを現状のサービスのまま維持していくことは不可能です。"@ja.
<< kg:id_144 prop:countermeasure kg:id_146 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "アセットマネジメントに基づく施設管理を進めるとともに"@ja.
<< kg:id_144 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "施設の統廃合による再配置も進めていかなければなりません。"@ja.
<< kg:id_148 prop:countermeasure kg:id_149 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "若者、女性、子育て世代、産業人など、さまざまな人たちから提言を受けたり意見交換できる新たな仕組みをつくり、市民の思いが施策に反映しやすい環境を整えながら"@ja.
<< kg:id_150 prop:cause kg:id_151 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "生活保護返還金、介護保険料、後期高齢者医療保険料について、市税と同様、２つのシステムの数値に不一致が認められました。"@ja.
<< kg:id_150 prop:countermeasure kg:id_152 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "決算の適正を期すため、原因究明と適正なシステム処理及び相互のチェック体制の構築に努めなければなりません。"@ja.
<< kg:id_150 prop:countermeasure kg:id_153 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "原因究明と適正なシステム処理及び相互のチェック体制の構築に努めなければなりません。"@ja.
<< kg:id_150 prop:countermeasure kg:id_154 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "相互のチェック体制の構築に努めなければなりません。"@ja.
<< kg:id_155 prop:cause kg:id_156 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "税外収入の滞納整理事務については、滞納者との接触度合いが希薄であり"@ja.
<< kg:id_155 prop:cause kg:id_157 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "債務承認等の時効中断措置をとっていなかったため、時効が完成し不納欠損となったものも見受けられました。"@ja.
<< kg:id_155 prop:countermeasure kg:id_158 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "的確な債権管理を行うため、担当職員の専門性を高める人材育成が必要です。"@ja.
<< kg:id_159 prop:cause kg:id_160 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "公有財産に解体済みの旧東平田小学校が含まれている誤りがありましたが、規則上必要な決裁のないまま解体を行ったことが一因となっています。"@ja.
<< kg:id_159 prop:countermeasure kg:id_161 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "管理に適正を欠くため、規則どおりの管理に努めていただくよう要請します。"@ja.
<< kg:id_162 prop:cause kg:id_163 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "当年度においても、10年以上増減なしが12基金あるなど、見直しが進んでいないと思われます。"@ja.
<< kg:id_162 prop:countermeasure kg:id_164 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "基金利子の事業充当だけでなく、基金を取り崩し事業充当する検討を求めます。"@ja.
<< kg:id_165 prop:cause kg:id_166 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "現在の事務事業評価は、事業担当課の自己評価のみであり、評価結果の信頼度が十分に高いものとは言えません。"@ja.
<< kg:id_165 prop:countermeasure kg:id_167 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "何らかの形で外部評価の導入に向けた検討が必要と思われます。"@ja.
<< kg:id_168 prop:cause kg:id_3 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "人口減少は避けられない所与のものとして、肝心なのは行財政運営の持続可能性であります。そのために必要なのは、人口減少に見合ったコスト意識を持って、適切に行政サービスと公共施設の維持管理を図ること"@ja.
<< kg:id_168 prop:countermeasure kg:id_169 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "適切な維持管理には、コスト、ストックを把握しやすい新地方公会計の財務書類が欠かせないという認識を持つことです。"@ja.
<< kg:id_168 prop:countermeasure kg:id_170 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "公共施設アセットマネジメントと新地方公会計の意義を改めて全職員に周知徹底されることを望むものであります。"@ja.
<< kg:id_171 prop:cause kg:id_172 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_125;
    prop:text-txt_contents "収益の柱となる給水収益は、前年度比で5,445万1,000円減少し、今年度に入っても底打ちの兆しは見られません。"@ja.
<< kg:id_171 prop:cause kg:id_173 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "給水人口、給水栓数とも前年度より減少しており"@ja.
<< kg:id_171 prop:cause kg:id_174 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_127;
    prop:text-txt_contents "給水人口、給水栓数とも前年度より減少しており"@ja.
<< kg:id_171 prop:cause kg:id_175 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "年間総配水量、有収水量についても減少しています。"@ja.
<< kg:id_171 prop:cause kg:id_176 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_129;
    prop:text-txt_contents "年間総配水量、有収水量についても減少しています。"@ja.
<< kg:id_177 prop:cause kg:id_178 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_130;
    prop:text-txt_contents "料金収入にならない無効水量については、１億円を超える減収となるため"@ja.
<< kg:id_177 prop:countermeasure kg:id_179 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "不明水量が異常に多い地区などを重点的に調査するなどの取り組みが必要と思われます。"@ja.
<< kg:id_180 prop:cause kg:id_181 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_132;
    prop:text-txt_contents "当年度の施設利用率は44.7％となっていますが、類似団体平均から見れば低い稼働率となっており"@ja.
<< kg:id_180 prop:countermeasure kg:id_182 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "配水能力の削減に向けた施設規模の検討を急ぐべきであります。"@ja.
<< kg:id_183 prop:effect kg:id_184 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_134;
    prop:text-txt_contents "料金回収率は97.06％と前年度より好転しており、100％を下回っているものの"@ja.
<< kg:id_183 prop:countermeasure kg:id_185 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_135;
    prop:text-txt_contents "引き続き100％回復を目標とした経営努力を求めます。"@ja.
<< kg:id_186 prop:countermeasure kg:id_187 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_136;
    prop:text-txt_contents "老朽化の進んだ施設、設備を計画的に更新されるよう望むものであります。"@ja.
<< kg:id_188 prop:cause kg:id_189 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_137;
    prop:text-txt_contents "入院外来患者数、病床利用率ともに前年度より減少しました。"@ja.
<< kg:id_188 prop:cause kg:id_190 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_138;
    prop:text-txt_contents "入院外来患者数、病床利用率ともに前年度より減少しました。"@ja.
<< kg:id_188 prop:cause kg:id_191 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_139;
    prop:text-txt_contents "この主な要因は、建物の耐用年数の誤りなどによる償却不足分を特別損失に計上したことによるものです。"@ja.
<< kg:id_192 prop:cause kg:id_193 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_140;
    prop:text-txt_contents "これらの処理誤りは固定資産台帳の不備に起因するものもありますが"@ja.
<< kg:id_192 prop:countermeasure kg:id_194 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_141;
    prop:text-txt_contents "このままの状態では次年度の決算についても正確を期しがたいため、外部に委託するなどの対策を望みます。"@ja.
<< kg:id_195 prop:cause kg:id_196 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_142;
    prop:text-txt_contents "毎年度５月末日までに市長に提出しなければなりませんが、毎年１カ月以上のおくれが常態化しています。"@ja.
<< kg:id_195 prop:cause kg:id_197 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_143;
    prop:text-txt_contents "上半期の経理、業務状況の報告もなされていません。"@ja.
<< kg:id_195 prop:countermeasure kg:id_198 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_144;
    prop:text-txt_contents "コンプライアンス遵守を徹底するために病院任せにしない内部統制の強化が必要であります。"@ja.
<< kg:id_195 prop:countermeasure kg:id_199 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_145;
    prop:text-txt_contents "今後、病院事務局の体制強化を図り、正しい手続で適正な決算に向けた対応を強く要望いたします。"@ja.
<< kg:id_200 prop:cause kg:id_201 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_146;
    prop:text-txt_contents "建設費の高騰などにより、平成25年12月に、旧ジャスコ跡地の開発については市に事業の中止申請が提出され、事実上、頓挫したところであります。"@ja.
<< kg:id_200 prop:effect kg:id_202 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_147;
    prop:text-txt_contents "旧ジャスコ跡地の開発については市に事業の中止申請が提出され、事実上、頓挫したところであります。"@ja.
<< kg:id_200 prop:countermeasure kg:id_203 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_148;
    prop:text-txt_contents "どのような整備手法が最適か具体的な案の検討に向けて、当局とともに白紙からの検討を重ねてまいりました。"@ja.
<< kg:id_204 prop:countermeasure kg:id_205 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_149;
    prop:text-txt_contents "平成26年12月には、今後の駅周辺整備を進める上で指針となる酒田駅周辺地区グランドデザインを策定し"@ja.
<< kg:id_204 prop:countermeasure kg:id_206 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_150;
    prop:text-txt_contents "短期の整備では、旧ジャスコ跡地"@ja.
<< kg:id_204 prop:countermeasure kg:id_207 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_151;
    prop:text-txt_contents "手戻りの生じない部分の駅前広場"@ja.
<< kg:id_204 prop:countermeasure kg:id_208 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_152;
    prop:text-txt_contents "観光資源・中心市街地への回遊ルートの形成が挙げられ"@ja.
<< kg:id_204 prop:countermeasure kg:id_209 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_153;
    prop:text-txt_contents "より効果的で実現の可能性が高い事業内容を検討するため、事業主体となる意向のある民間事業者を対象に、対話型市場調査を実施したところであります。"@ja.
<< kg:id_204 prop:countermeasure kg:id_210 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_154;
    prop:text-txt_contents "本市が作成する整備計画方針案を事業要件として事業者提案公募を実施し"@ja.
<< kg:id_211 prop:effect kg:id_212 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_155;
    prop:text-txt_contents "駅周辺整備は、本地域の大きな拠点として、市民生活や中心市街地の活性化においても重要であり"@ja.
<< kg:id_211 prop:effect kg:id_213 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_156;
    prop:text-txt_contents "酒田のまちの新たな魅力や都市機能を生み出し"@ja.
<< kg:id_211 prop:effect kg:id_214 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_157;
    prop:text-txt_contents "人口減少社会に立ち向かう今後のまちづくりの重要な鍵となるものであります。"@ja.
<< kg:id_215 prop:countermeasure kg:id_216 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_158;
    prop:text-txt_contents "１回目は演壇で行い、２回目以降の質問については、一括方式と一問一答方式の選択制とすることで一致いたしました。"@ja.
<< kg:id_215 prop:countermeasure kg:id_217 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_159;
    prop:text-txt_contents "各常任委員会を単位とする分科会方式を継続し"@ja.
<< kg:id_215 prop:countermeasure kg:id_218 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_160;
    prop:text-txt_contents "新たに各分科会において重点的に検討するテーマを設定することで一致いたしました。"@ja.
<< kg:id_215 prop:countermeasure kg:id_219 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_161;
    prop:text-txt_contents "委員長報告は、決算審査に加えて、新年度予算に反映できるような提案型の報告といたします。"@ja.
<< kg:id_215 prop:countermeasure kg:id_220 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_162;
    prop:text-txt_contents "今後もさらなる議会活性化に向けた協議の場を設置し、継続的に調査検討していくことを望むものであります。"@ja.
}
