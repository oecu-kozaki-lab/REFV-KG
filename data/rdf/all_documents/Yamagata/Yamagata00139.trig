kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_2 prop:content "建設事業への助成が増えており制度見直しが必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "申請額が予算を大きく上回った"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "予算枠の中で次年度対応可能な集落は翌年度に回した"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "破損の程度から翌年度対応が難しい集落を優先して支援"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "課題に対応できるよう制度設計を改善したい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "地域生活課長"@ja.
kg:st_3 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_7 prop:content "法制度や合併の経過から組織としての役割を終えたと説明"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "解散後は町が河川管理事業を引き継ぐ方向で調整"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "河川敷の草刈りは町の発注で実施したい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "事業のほか水防区域も遊佐町が引き継ぐ方向で調整"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "流下能力の保持に向け重点的な除去が必要と指摘"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "流下能力の保持に向け支障木除去が必要と指摘"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "地元意見を踏まえて県へ要望活動を続ける"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "近くに処分地がないと運搬経費や処分費がかさむ"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "破砕機は効果的であり県に購入を働きかけたい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "開校に伴いスクールバス利用児童が増えるため安全確保が必要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "登下校時の見守り活動の在り方を検討している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "放課後の居場所づくりとして在り方を検討している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "放課後の居場所づくりとして在り方を検討している"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "関係機関が連携して通学路の安全確保に取り組んでいる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "関係機関が集まり危険箇所を把握し合同点検している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "通学路以外も含め危険箇所の確認が必要"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "県の課題として医療人材不足がある"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "地域医療体制に不安要素が見られる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:st_4 rdfs:label "健康福祉課長"@ja.
kg:st_4 rdf:type cls:st_32.
kg:op_25 prop:content "患者数減少で医療機関の財政が厳しい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "医療従事者の人材確保育成を支援している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "地域医療の安定を図るため支援を実施している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "地域医療の安定に向け新たな支援を検討したい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "子どもの育ちや教育に影響が及ぶ状態と説明"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "関係機関で具体的な支援方法を協議する体制がある"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "教職員には独自資料で周知している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "確認された場合は必要なサービスにつなげる"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "可能性のある児童生徒を継続的に見守る"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "長期化や高齢事例では本人の変化を促すことが難しい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "健康支援係を窓口に相談会を実施している"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "相談会休止時も訪問支援を行っている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "若者の居場所支援として開設した"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "地域を知る民生児童委員の存在が重要と考える"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "9060問題に対応するためケアマネ研修も必要"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "複数機関の連携による継続支援が必要"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "高齢化により通院支援の必要性が高まっている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "自分で通院できない人や家族送迎ができない人を支援している"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "自力通院や家族送迎の非課税世帯に交通費助成を行っている"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "冬期間の通院困難者に対応するため運行日を補完する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "通院支援継続のため病院と調整し検討する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "人口減少の背景に転出超過がある"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "少子化が急速な人口減少の要因"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "コロナ禍で出張や受入れが難しく計画どおりに進まなかった"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:st_5 rdfs:label "企画課長"@ja.
kg:st_5 rdf:type cls:st_32.
kg:op_49 prop:content "宣言緩和後に移住の動きが活発化した"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_5.
kg:op_50 prop:content "空き家の管理見通しが立たず手放す決断が増えた"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_5.
kg:op_51 prop:content "舞鶴地内で分譲販売を進めている"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "民間による賃貸住宅整備を進めている"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_2.
kg:op_53 prop:content "利用者が望む形でリフォームや起業準備を可能にした"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "コロナ禍でも移住情報を発信できるよう工夫している"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "職員ワーキンググループと若者移住者の意見を踏まえて策定している"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "ウィズコロナアフターコロナを考慮した施策にしたい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "町民の温かさを生かした対応を強めたい"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "経済産業省が公表しております資料には、コロナ禍での影響として木材、木製品の国内価格が今年９月時点で前年末比47％上昇しているとの記載がありました。本町の主要施策のうち移住、定住の促進、町民参画連携の推進などについてウッドショックの影響が懸念されるのではと考えるところであります"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "近年のきらきら遊佐マイタウン事業への申請状況を見ますと、台風などの暴風や大雪、暴風雪による集落公民館の屋根、外装の損傷や経年による内装の劣化、下水道への接続、エアコンの設置など、集落公民館の改修に関する申請が大変増えてきております"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "台風などの暴風や大雪、暴風雪による集落公民館の屋根、外装の損傷"@ja.
<< kg:id_5 prop:cause kg:id_7 >>
    prop:text-txt_contents "台風などの暴風や大雪、暴風雪による集落公民館の屋根、外装の損傷"@ja.
<< kg:id_5 prop:cause kg:id_8 >>
    prop:text-txt_contents "台風などの暴風や大雪、暴風雪による集落公民館の屋根、外装の損傷"@ja.
<< kg:id_5 prop:cause kg:id_9 >>
    prop:text-txt_contents "経年による内装の劣化"@ja.
<< kg:id_5 prop:cause kg:id_10 >>
    prop:text-txt_contents "下水道への接続"@ja.
<< kg:id_5 prop:cause kg:id_11 >>
    prop:text-txt_contents "エアコンの設置"@ja.
<< kg:id_3 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "令和３年度の申請は、全てきらきら遊佐マイタウン事業の申込み、集落公民館に関するもので、12件の申請があったところでありました。予算額200万円に対して、申請額合計が412万円で、212万円ほど予算を超過した状況となりました"@ja.
<< kg:id_3 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "その結果、集落の区長さんに確認を行いながら、次年度に実施することが可能な６集落については次年度で対応することとし"@ja.
<< kg:id_3 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "破損の程度の事情により次年度対応が厳しいという６集落については令和３年度で助成を行い、集落公民館の修繕等へ支援をしたところであります"@ja.
<< kg:id_3 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "次年度の事業実施に当たっては、これらの課題に対応できるよう、予算の確保と要綱の見直しを行い、制度設計を改善していきたいと考えております"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "歴史的に見ましても、特に１町５か村が合併して現在の遊佐町が誕生したこと、それから土地改良法の制定、水防法の制定、改正及び河川法の制定、改正等の経過を見ますと、遊佐町における水害予防組織としての役割を終えたものとも言えるとも言えます"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "解散後は、水防区域と併せ、草刈りなどの河川管理事業についても町が引き継ぐことで調整を行ってございます"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "毎年６月に実施しております河川敷の草刈りについては、月光川水害予防組合の発注でこれまで実施されてきましたが、令和４年度からは町の発注で実施したいと考えております"@ja.
<< kg:id_19 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "また、事業のほか、水防区域も遊佐町が引き継ぐことで調整を行っております"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "河積阻害の大きな要因となる河道の堆積土砂や河川支障木の除去に重点を置いて取り組むなど、河川が有する流下能力を常に発揮できるようにする必要がある"@ja.
<< kg:id_22 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "河積阻害の大きな要因となる河道の堆積土砂や河川支障木の除去に重点を置いて取り組むなど、河川が有する流下能力を常に発揮できるようにする必要がある"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "今後につきましても、地元の方々のご意見をいただきながら、県に要望活動を行っていきたいというふうに考えてございます"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "現場の近くにストックヤードがありますと、残土の運搬経費、そして支障木の処分費、大幅に軽減されまして"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "破砕機の購入につきましては、遊佐町のみならず他市町村でも使用可能の機械でございますので、県へ粉砕機の有効性について情報提供させていただき、ぜひ県のほうから購入していただくように、この有効性について十分ご理解いただくように県の担当者のほうに情報提供をさせていただきたいと思ってございます"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "統合新小学校の開校に伴い、スクールバスによる登下校をする子供さんたちが増えることになります"@ja.
<< kg:id_31 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "その中でも、登下校時の見守り活動である見守り隊に関することや、放課後の居場所づくりとして放課後児童クラブ、放課後子ども教室について新校開校に向けてその在り方が検討されているところであります"@ja.
<< kg:id_31 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "放課後の居場所づくりとして放課後児童クラブ、放課後子ども教室について新校開校に向けてその在り方が検討されているところであります"@ja.
<< kg:id_31 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "放課後の居場所づくりとして放課後児童クラブ、放課後子ども教室について新校開校に向けてその在り方が検討されているところであります"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "平成28年度に教育委員会、地域生活課及び総務課が事務局となり、遊佐町通学路安全推進会議が設置されております"@ja.
<< kg:id_36 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "その関係機関が集まり、町内の学校ごとの通学路の危険箇所を把握し、協議して、危険箇所である現地に赴いて合同点検を実施しております"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "これから統合新小学校の開校に向けて、通学路だけでなく、放課後児童クラブや放課後子ども教室、そのほかの塾や習い事なども含めてその施設までの経路及びそこから帰宅するまでの経路についても改めて危険箇所を確認し、関係機関による合同点検を検討していく必要があると考えております"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "県の課題といたしましては、急性期病床の過剰、回復期病床の不足、後期高齢者人口の増加に伴う在宅医療需要の増加に対し受入れ態勢の不十分であること、医師、歯科医師、薬剤師、看護職員等の人材の不足等が挙げられております"@ja.
<< kg:id_41 prop:cause kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "令和元年度に開業医１か所が閉院するなど、地域の医療体制に不安の要素が見られるのも事実であります"@ja.
<< kg:id_41 prop:cause kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "町の人口減少による患者数の減少等により、医療機関の財政が厳しい現状にある"@ja.
<< kg:id_41 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "町では、地域医療を支援する上で医療従事者の人材確保、育成を重要課題として位置づけ、平成25年度より地域医療安定化対策支援事業、看護師等奨学金貸付事業を実施し、町内医療機関で働く看護師等を支援しております"@ja.
<< kg:id_41 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "平成25年度より地域医療安定化対策支援事業、看護師等奨学金貸付事業を実施し、町内医療機関で働く看護師等を支援しております"@ja.
<< kg:id_41 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "これらの地域医療の安定を図るため、支援等について今後検討していきたいと考えております"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:text-txt_contents "ヤングケアラーとは、年齢や成長の度合いに見合わない重い責任や負担を抱え、本来大人が担うような家族、いわゆる障がい者、病気、精神疾患のある保護者や家族の介護など"@ja.
<< kg:id_48 prop:cause kg:id_50 >>
    prop:text-txt_contents "年下の兄弟の世話をすることなど"@ja.
<< kg:id_48 prop:effect kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "自らの育ちや教育に影響が及ぼされるであろう18歳未満の子供"@ja.
<< kg:id_48 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "遊佐町では、平成18年度から要保護児童対策地域協議会を設置し、児童虐待など要保護児童等の支援内容について協議を行ってきております。構成機関は、教育、福祉、医療、警察、児童相談所などの多くの関係機関で構成されており、ヤングケアラーの概念について共通認識を図るとともに、遊佐町でそうした子供が確認された場合には、具体的な支援方法について協議を行う組織となっております"@ja.
<< kg:id_48 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "遊佐町の小中学校の教職員向けには、令和３年５月に児童虐待の理解と対応についての資料を町教育委員会が独自で作成、配布し、その中でヤングケアラーについて周知しておりました"@ja.
<< kg:id_48 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "ヤングケアラーに該当する子供が確認された場合は、子供の権利侵害や家庭の状況に関するアセスメントを行い、必要に応じて家事援助サービスや介護サービスにつなげるなど、多様な機関と連携しながら支援をしてまいります"@ja.
<< kg:id_48 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "今後も、ヤングケアラーになる可能性がある児童生徒については、各関係機関やスクールソーシャルワーカーが家庭と学校に直接関わり合いながら、見守りと支援を行ってまいりたいと考えております"@ja.
<< kg:id_56 prop:cause kg:id_57 >>
    prop:text-txt_contents "ひきこもりとは、様々な要因の結果として社会参加を回避し、原則的には６か月以上にわたっておおむね家庭にとどまり続けている状態をいい"@ja.
<< kg:id_56 prop:effect kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "ひきこもりの原因や背景は多岐にわたり、多種多様な問題を抱えている場合が多く、特にひきこもりの期間が長い場合や高齢者の事例では、本人の変化を促すことが難しく、長期にわたる継続的な支援が重要となります"@ja.
<< kg:id_56 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "平成29年度より健康福祉課健康支援係を窓口としてひきこもり相談会を実施しており、今年度は年10回を予定しています"@ja.
<< kg:id_56 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "新型コロナ感染症の影響で、令和２年度は相談会を２回休止いたしましたが、必要に応じて自宅へ訪問して支援も行っております"@ja.
<< kg:id_56 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "令和３年６月から若者居場所支援として総合福祉センターでフリースペースひなたを開設しております"@ja.
<< kg:id_56 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "町ではひきこもりの問題に悩む人の早期の相談につなげるため、地域を知る民生児童委員の存在が重要であると考え、毎年定例会でひきこもりをテーマに研修会を開催しております"@ja.
<< kg:id_56 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "また、90代の親と60代の子供による9060問題に対応するために、「ひきこもりの子どもと親の介護」ということで、今後ケアマネジャーにも研修の機会をつくっていきたいと考えております"@ja.
<< kg:id_56 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "ひきこもり者、家族に対する支援は一機関で完結できるものではなく、複数の機関が連携を図りながら継続的に関わっていかなければなりません"@ja.
<< kg:id_65 prop:effect kg:id_66 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "このように通院患者や家族の高齢化により自力で通院が困難になっていることが挙げられますので、これらを何とか支援していきたいと思っております"@ja.
<< kg:id_65 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "町は、これまで透析患者の通院支援として、独り暮らしで自分の力で通院できない方や家族による送迎もできない方を対象に町有バスで送迎を行ったり"@ja.
<< kg:id_65 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "自力で通院や家族の送迎により通院されている方で非課税世帯の方へ交通費助成を行ってまいりました"@ja.
<< kg:id_65 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "冬期間の火、木、土曜日の運行について民間のタクシー会社へ町が委託し、町有バスと民間タクシーを利用した月曜日から土曜日の週６日の運行を行う予定としております"@ja.
<< kg:id_65 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "来年度以降の運行については、引き続き病院側と協議をしながら、透析患者の通院について検討していきたいと考えております"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "我が町では、転出の超過、そして特に少子化による人口減少が急速に進行する中で、何とかこれに歯止めをかけたいという思いで"@ja.
<< kg:id_71 prop:cause kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "特に少子化による人口減少が急速に進行する中で"@ja.
<< kg:id_71 prop:effect kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "何と何と昨年からコロナウイルス感染症の拡大という形で、まずは都会に出張できないと。会議はウェブが最低限、以外はできないという形の中、それからこっちにお試し住宅に来てもらえるにしても、なかなかそれについても感染症が怖いから受け入れ難いという形の状態が続いておりました。計画どおりには全く進まないという状況でありました"@ja.
<< kg:id_75 prop:cause kg:id_76 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "宣言が緩和された10月以降、その移住の動きが活発化してきた、移住の相談、移動もできるようになりましたし、実際にいらしていただける"@ja.
<< kg:id_77 prop:cause kg:id_78 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "コロナ禍で、実家を所有して年数回帰郷して管理するといった方がコロナ禍でなかなか帰郷が難しくなってきてきておりまして、どうしても今後の管理について見通しがだんだんつかなくなる状況でその空き家を手放す決断をされた方も多くなってきたのかなということで、実際にその空き家所有の方からの相談も多くなってきている状況にあります"@ja.
<< kg:id_71 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "昨年度造成が完成した舞鶴地内の若者定住住宅につきましては、今年度９区画の若者世帯の分譲販売"@ja.
<< kg:id_71 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "４区画の賃貸住宅建設運営事業への貸付募集を行い、６区画の分譲、２事業者に２区画、計４区画の貸付けが決定し"@ja.
<< kg:id_71 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "事業を従来の町借り上げ方式から空き家を10年間賃貸住宅して活用する場合のリフォーム費用補助と空き家を活用した起業する場合のリフォーム費用の設備投資費用の補助を行う補助方式に変更し、利用者の望む形でのリフォームや起業準備を可能にすることで、さらに空き家を利活用いただけるよう事業の見直しを行っております"@ja.
<< kg:id_71 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "独自にインターネットを使用した移住セミナーも行っていますが、８月に開催した第１回セミナーでは、移住者の体験談等を発信しながら、フリートークで移住施策や本町での生活について情報発信して、好評をいただきました"@ja.
<< kg:id_71 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "現在、庁内関係各課の職員から成るワーキンググループにての第３次遊佐町定住促進計画の策定作業を進めておりますので、また地域で頑張っておられる若者の移住者の方からお集まりをいただき、それぞれの立場から移住、定住施策を含む町施策にご意見をいただきながら、計画策定の参考にさせていただいております"@ja.
<< kg:id_71 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "第３次定住促進計画に基づく今後の移住、定住施策においては、移住、定住希望者のニーズを捉え、状況に対応しながらこれまでの施策をブラッシュアップしていくほか、ウィズコロナ、アフターコロナを考慮し、リモートの取組など新しい視点、手法を取り入れた従来の方法にとらわれない施策内容を検討していきたいと考えております"@ja.
<< kg:id_71 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "庁舎内各部署、集落支援員、ＮＰＯ法人いなか暮らし遊佐応援団等の団体組織がさらに連携しながら、これまで以上にマンパワーを重視して移住、定住希望者に対応してまいりたいと考えております"@ja.
}
