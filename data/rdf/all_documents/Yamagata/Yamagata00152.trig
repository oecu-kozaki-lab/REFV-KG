kg:st_1 rdfs:label "那須正幸議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "今後も町民のために安心安全のための対応を続けてほしい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "地域生活課長 畠中良一"@ja.
kg:st_2 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_2 prop:content "地元のリスク管理のため集落とも協定を結べるよう明文化が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "遊佐町長 時田博機"@ja.
kg:st_3 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_3 prop:content "地域の声を協定や契約に反映させるため条例改定が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "地元集落との協定の根拠が不明だったため明文化が必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "協定に基づき事業者が騒音対策を行い苦情は解消した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "協定に基づく対応で事業者が速やかに騒音装置を設置した"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "協定根拠がないため早急な条例整備が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "町民の声が届きにくいため地域の声を協定に反映させたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "地域の求めがあれば地域の声を協定に反映させたい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:st_4 rdfs:label "教育委員会教育課長 髙橋善之"@ja.
kg:st_4 rdf:type cls:st_32.
kg:op_10 prop:content "新型コロナ対応の地方創生臨時交付金を活用した整備である"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "スクールバス更新増車は密対策が目的"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:st_5 rdfs:label "佐藤光保議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_12 prop:content "学校統合を前提にした取得であり反対する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_5.
kg:op_13 prop:content "統合時には現状より多い台数が必要であり当然使用する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "スクールバス通学では児童が地域環境になじみにくい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "工事を進めながら掘削した結果岩盤が見つかり増工となった"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:st_6 rdfs:label "齋藤武議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_16 prop:content "前年も同様の増工があり設計段階で想定すべきだった"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_6.
kg:st_7 rdfs:label "阿部満吉議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_17 prop:content "昨年同様の追加補正であり積算の甘さがある"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_7.
kg:op_18 prop:content "岩盤取壊しと運搬費の増加により増工となった"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "工事費増額が繰り返され議会のチェック機能向上が必要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_7.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "現条例の協定の締結につきましては事業者と町長の２者との締結となってございます、現条例では。開発地となります地元のリスク管理のためということで、集落とも協定を結べるようにということで改正を今回お願いするものでございます。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "地元集落との協定の根拠についてこれまで不明だったということで、なかったということで、今回明文化するための条例改正をお願いするものでございます。"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "稼働直後、騒音が発生して地元の方々から苦情をいただきました。"@ja.
<< kg:id_5 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "その協定に基づきまして、事業者さんのほうからすぐに騒音装置設置していただきまして、対応をさせていただいたところでございます。"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業者と地元との協定根拠がなかったということが分かりまして、まず早速この条例につきまして整備をする必要があろうということで"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "迷惑施設等、何とか声は届けたいのだけれども、なかなかそこが届かないという町民の皆さんから声が寄せられておりました。"@ja.
<< kg:id_10 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "地域から求めがあった場合においてはやっぱり地域の声もしっかり協定、契約に反映させるようにしたいという形で今回改定を議案として出させていただいているところであります"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "本件で取得するスクールバス中型２台につきましては、新型コロナウイルス感染症対応地方創生臨時交付金を財源とした事業によるものでございまして"@ja.
<< kg:id_13 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "スクールバスの更新、増車による密対策を目的とした購入整備であります。"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "予定しております統合時に使用するバスの台数は、現状の台数よりも多い台数でございますので、当然使うことになるということでございます。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "ＧＬマイナス５メーター付近より岩盤が発生しております。"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "この岩盤についての取壊し、大型ブレーカーによる岩盤の破砕取壊し、そしてこの岩盤取壊しの岩の掘削運搬に係る経費が増したということで、このような形で増工となったものでございます。"@ja.
