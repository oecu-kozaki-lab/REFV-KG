cls:c_8936 rdfs:label "管理基金"@ja.
kg:id_103 rdfs:label "令和3年度で1億7000万円以上を確保したい"@ja.
kg:id_103 rdf:type cls:c_8937.
cls:c_8937 rdfs:label "基金確保"@ja.
kg:id_102 prop:effect kg:id_103.
kg:st_1 rdfs:label "遊佐町副町長"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "行政"@ja.
kg:op_1 prop:content "困難に直面した世帯への速やかな生活支援が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "困難に直面した世帯への速やかな生活支援を実施"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "1月と2月の利用実績は思うように伸びなかった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "重点措置の影響で利用が低調だった"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "解除後は利用件数が大幅に増加した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "概ね予定件数で終了した"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "終了後も継続した事業所支援が必要と判断した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "継続した支援のため独自キャンペーンを実施した"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "支援策は概ね想定どおり利用された"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "キャッシュレス決済導入による経済支援に大きな効果があった"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "被害縮小のため全量駆除を予定している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "今後の被害縮小のため薬剤散布を実施する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "引き続き駆除作業に取り組む"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "国の担当者から直接話を聴ける貴重な機会となった"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "説明会は理解を深める機会になった"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_2 rdfs:label "請願紹介議員菅原和幸議員"@ja.
kg:st_2 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_16 prop:content "決定を受け農業団体などから要望書提出が相次いだ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "見直し決定が各地の要望行動につながった"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "需要減少で飼料用米や加工用米への転換が呼びかけられた"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "需要減少に対応して転換が求められた"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "高収益作物を継続生産する水田が交付対象外になる懸念がある"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "交付対象外となれば農業経費や農地集積に影響が出る恐れがある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "意見書提出は町の農業生産や農地整備事業に一定の効果がある"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:st_3 rdfs:label "菅原和幸議員"@ja.
kg:st_3 rdf:type cls:st_16.
kg:op_23 prop:content "各課が連携し町のインフラ整備計画案を策定すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:st_4 rdfs:label "遊佐町長"@ja.
kg:st_4 rdf:type cls:st_2.
kg:op_24 prop:content "町も一部を整備する構想を持って県に要望した"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "保存活用計画を踏まえ具体的整備内容を検討する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "自動車利用を想定した環境整備が必要"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "史跡へのアクセスを容易にする表示整備が必要"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "拠点とした道路網整備が望まれる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "整備推進のため将来構想と戦略が必要"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "働く場と働き手の確保が課題"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "人材流出や各現場での人手不足は深刻"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "商店数の大幅減少が続いている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "産業の将来は働く場と働き手の確保にかかっている"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "有効求人倍率の高さからも人手不足は深刻"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "町民の働き場確保のため支援施策を実施してきた"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "企業誘致を継続し新しい産業にも力を注ぐ"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_4.
kg:op_37 prop:content "将来の担い手を確保するため町独自事業を活用した"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "若い世代に遊佐で働いてもらう仕組みづくりを進める"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:st_5 rdfs:label "那須正幸議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_39 prop:content "このままではジオパークがゴミパークに変化しつつある"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "毎年町が清掃作業を実施している"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "地域の大きなボランティアの協力を得ている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:op_42 prop:content "予算不足で十分な対応が難しい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:op_43 prop:content "子どもたちの気持ちが確かなものだった"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:op_44 prop:content "危険が伴うため春まで待って回収作業を行った"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:op_45 prop:content "回収後も再び不法投棄が続いている"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_4.
kg:op_46 prop:content "引き続き県に強く要望し対応に努める"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "毎日の学校給食にも大きな影響があるのではないか"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "物価高騰が食生活に大きな影響を及ぼしている"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_5.
kg:op_49 prop:content "学校給食にも影響が懸念される"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_5.
kg:st_6 rdfs:label "教育委員会教育課長"@ja.
kg:st_6 rdf:type cls:st_57.
cls:st_57 rdfs:label "教育行政"@ja.
kg:op_50 prop:content "今後も影響が生まれないか注視していく"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_6.
kg:op_51 prop:content "現場では栄養価基準を満たす献立作成を行っている"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_6.
kg:op_52 prop:content "今のところ大きな憂慮はない"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_6.
kg:op_53 prop:content "必要に応じて給食会計への補助を含め対応を検討する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:op_54 prop:content "家庭への生活支援として給食費助成を検討している"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_4.
kg:st_7 rdfs:label "松永裕美議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_55 prop:content "町県国が連携した息の長い支援が必要"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "先進事例を参考に計画策定に取り組みたい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:op_57 prop:content "犯罪や非行防止、再犯防止の周知を保護司会と連携して行っている"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_4.
kg:op_58 prop:content "運動期間中に各所で広報活動をしてきた"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_4.
kg:op_59 prop:content "地域ぐるみでの取組を進めてきた"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_4.
kg:op_60 prop:content "今から様々な工夫をして前向きに取り組むべき"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_7.
kg:op_61 prop:content "成り手不足も含め保護司会と連携して取り組みたい"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_4.
kg:op_62 prop:content "受皿不足に備え今から力を注ぐべき"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_7.
kg:op_63 prop:content "宿泊や食事提供で収入を得る仕組みづくりが大切"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_7.
kg:op_64 prop:content "定年後も自分のペースで働ける素材が遊佐町にはある"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_7.
kg:op_65 prop:content "地域の意向を認識しつつ一つの方向性として検討したい"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_4.
kg:op_66 prop:content "農家民泊による可能性の認識は高くない"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_4.
kg:op_67 prop:content "こちらからのアクション不足も否めない"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_4.
kg:op_68 prop:content "行政上の大きな課題と認識している"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_4.
kg:op_69 prop:content "長期的視点での管理が必要"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_4.
kg:op_70 prop:content "利用需要の変化を踏まえた管理が必要"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_4.
kg:op_71 prop:content "全体状況を把握し計画的に管理することが目的"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_4.
kg:op_72 prop:content "更新や保全、除却等の事業に対応するため基金を創設した"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_4.
kg:op_73 prop:content "庁舎等建設基金も繰り入れて確保を進めている"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "地方自治法（昭和２２年法律第６７号）第１０１条第１項の規定により、第５５７回遊佐町議会定例会を令和４年６月７日遊佐町役場に招集する"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "新型コロナウイルス感染症の影響が長期化する中で、様々な困難に直面した世帯に速やかに生活・暮らしの支援を行うため"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "住民税非課税世帯等に対して１世帯あたり10万円を給付する臨時特別給付金事業を実施しています"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "庄内地区がまん延防止等重点措置の対象地域となったことから、１月、２月の利用実績は思うように伸びなかった"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "庄内地区がまん延防止等重点措置の対象地域となったことから、１月、２月の利用実績は思うように伸びなかった"@ja.
<< kg:id_6 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "解除後には県の冬割キャンペーンとの相乗効果もあり、利用件数が大幅に増加した"@ja.
<< kg:id_6 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "解除後には県の冬割キャンペーンとの相乗効果もあり、利用件数が大幅に増加したことで概ね予定件数での終了となりました"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "県の春旅キャンペーンの４月28日での終了を受け、事業所への継続した支援が必要と判断し"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "４月29日から５月29日の期間で「遊佐町春旅応援！泊まってお得キャンペーン！」を実施しました"@ja.
<< kg:id_11 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "こちらも概ね予定件数での終了となりました"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "付与額が前回を上回り、中小事業者のキャッシュレス決済導入による経済支援に大きな効果がありました"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "県と共に全量駆除を予定しており"@ja.
<< kg:id_17 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "今後の被害縮小のため、１回目の薬剤散布を６月８日と９日に実施する予定です。２回目の薬剤散布は７月上旬に予定しており"@ja.
<< kg:id_17 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "引き続き伐倒・破砕処理等の作業に取り組んでいきます"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "５月28日に山形県と共同で、遊佐町沖における洋上風力発電についての住民説明会を開催し、町内外から105人の参加がありました"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "国の事業担当者からの話を直接聴ける貴重な機会となりました"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "請願に関する事項については、昨年12月に政府が決定したことを受けまして、本年に入り、農業団体などから県内の首長、市町村長などに相次いで要望書が提出されております"@ja.
<< kg:id_24 prop:effect kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "本年に入り、農業団体などから県内の首長、市町村長などに相次いで要望書が提出されております"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "米の国内消費量は、全国レベルで年間10万トンずつ減っている状況にあり、令和３年産米では38都道府県で飼料用米や加工用米の転換が呼びかけられました"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "米の国内消費量は、全国レベルで年間10万トンずつ減っている状況にあり、令和３年産米では38都道府県で飼料用米や加工用米の転換が呼びかけられました"@ja.
<< kg:id_24 prop:effect kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "見直しにより、令和４年度以降５年間水稲作付しない水田は、その翌年度から交付対象から外されることも想定されます"@ja.
<< kg:id_24 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "仮に交付対象外となった場合、土地改良区賦課金のように、作付状況に関係なく、納付義務のある経費や農業委員会も関連します農地集積等への影響も少なからず懸念されるものと考えます"@ja.
<< kg:id_24 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "請願に基づき意見書を提出することは、本町の水稲を中心とする農業生産物の現状及び実施中の農地整備事業等に一定の効果があるものと考えます"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "県道371号、いわゆる菅里直世下野沢線については、まさに遊佐パーキングエリアタウン、小山崎遺跡、丸池様や牛渡川のアクセス道として期待される道路であり"@ja.
<< kg:id_34 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "来年度に中間見直しが予定されている県の道路行政の方針を示す山形県道路中期計画2028に位置づけていただくよう、要望書を提出したところであります"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "具体的な整備内容について、史跡小山崎遺跡整備計画策定委員会を今年度立ち上げ、２か年かけて協議し、検討していくこととしております"@ja.
<< kg:id_37 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "訪れる方は自動車を利用するため、駐車場スペースの確保などについて検討するとし"@ja.
<< kg:id_37 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "史跡へのアクセスを容易にするため、案内標識の設置、観光施設や文化施設への相互誘導のための表示などが必要とされております"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "日沿道を使って本町を訪れた観光客が遊佐鳥海インターチェンジからパーキングエリアタウンに立ち寄り、そこから本町の有する魅力ある資源へ広がっていく。このような交通の流れを実現するためにも、パーキングエリアタウンを拠点とした道路網の整備が望まれるものと認識しております"@ja.
<< kg:id_34 prop:effect kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "小山崎遺跡並びに遊佐パーキングエリアタウンの整備を進めるに当たり、それらを結ぶ道路は完全な状況にはないと考えます"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "これらの基礎的なデータは、農林漁業の後継者問題、建築や製造業の人手不足、個人商店の廃業、工場の機械化による雇用減少といった課題があることを示しております"@ja.
<< kg:id_44 prop:cause kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "これらの基礎的なデータは、農林漁業の後継者問題、建築や製造業の人手不足、個人商店の廃業、工場の機械化による雇用減少といった課題があることを示しております"@ja.
<< kg:id_44 prop:cause kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "これらの基礎的なデータは、農林漁業の後継者問題、建築や製造業の人手不足、個人商店の廃業、工場の機械化による雇用減少といった課題があることを示しております"@ja.
<< kg:id_44 prop:cause kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "これらの基礎的なデータは、農林漁業の後継者問題、建築や製造業の人手不足、個人商店の廃業、工場の機械化による雇用減少といった課題があることを示しております"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "県外への人材流出や産業の各現場での人手不足は深刻なものとなっております"@ja.
<< kg:id_51 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "企業立地に際し、固定資産税相当額を５年間助成する企業奨励条例と、用地取得に助成する企業立地促進条例を軸に、企業誘致を実施してまいりました"@ja.
<< kg:id_51 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "用地取得に助成する企業立地促進条例を軸に、企業誘致を実施してまいりました"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "町独自のチャレンジファーム事業を活用して新規就農者の研修から経営確立を支援してまいりました"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "企業誘致や農業の担い手支援等に努めながら、若い世代に遊佐で働いてもらうための仕組みづくりを教育、福祉、定住の施策と併せて取り組んでまいります"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "実際に十六羅漢や釜磯海岸に行き、現地を見てみると、映像などのイメージとは少し程遠く、観光などで訪れる人たちにとっては幻滅するほどごみや漂流木などが流れ着いております"@ja.
<< kg:id_58 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "毎年海水浴場の開設に合わせて町が清掃作業をしております"@ja.
<< kg:id_58 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "春の一斉清掃時には地域の皆さんの大きなボランティアもいただいております"@ja.
<< kg:id_58 prop:effect kg:id_62 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "海水浴場以外の区域については、莫大な費用となることから、なかなか手をつけれないという状況が続いております"@ja.
<< kg:id_58 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "去る６月３日に、海ごみ問題について主に活動しているＮＰＯ法人のパートナーシップオフィスと共に連携して海岸清掃を実施していただいております"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "先日、県と合同により、一部ですが、回収作業を実施いたしました"@ja.
<< kg:id_64 prop:effect kg:id_66 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "回収作業後も当該箇所では不法投棄が行われている模様であります"@ja.
<< kg:id_58 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "町としても、今後も引き続き県に強く要望していくとともに、清掃もしながら海岸清掃、不法投棄の対応に努めてまいりたいと考えます"@ja.
<< kg:id_68 prop:cause kg:id_69 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "今年に入り、食料品の値上げと石油価格の値上がりがする中"@ja.
<< kg:id_68 prop:cause kg:id_70 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "追い打ちをかけるようにロシアのウクライナ侵攻や円安で物価高騰により、私たちの食生活に大きな影響を及ぼしています"@ja.
<< kg:id_68 prop:cause kg:id_71 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "円安で物価高騰により、私たちの食生活に大きな影響を及ぼしています"@ja.
<< kg:id_72 prop:effect kg:id_73 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "各校から４月分の学校給食実施報告書を５月の中旬頃に報告いただいておりますが、現段階では給食単価内に収まっているという状況ではございました"@ja.
<< kg:id_72 prop:effect kg:id_74 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "給食の量が足りなかったり、栄養価の不足はないということでございます"@ja.
<< kg:id_72 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "山形県の地産地消推進補助金を活用しておりますので、今のところそこまでの憂慮はないとのことでした"@ja.
<< kg:id_72 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "本町においても、今後の物価上昇の推移を見ながら対応を検討していきます"@ja.
<< kg:id_72 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "各家庭への生活支援対策の一環として給食費に対する助成も現在検討しているところであります"@ja.
<< kg:id_78 prop:cause kg:id_79 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "刑法犯により検挙された者に占める再犯者の割合は全体の約半数に上っており、安全、安心な社会の実現には再犯防止が必要不可欠である"@ja.
<< kg:id_78 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "そういった先進事例を参考にしながら、来年度中の計画策定に向けて取り組んでいきたいと考えております"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "毎年７月に社会を明るくする運動を酒田飽海地区保護司会と一緒になって実施し、犯罪や非行防止、再犯防止について、関係機関への呼びかけ、広報での活動の周知などを行っております"@ja.
<< kg:id_81 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "運動期間中に各小中学校や各地区まちづくりセンター、エルパや遊佐駅、吹浦駅でのリーフレットや文具、ティッシュなどを配布して運動の周知を行ってきた"@ja.
<< kg:id_81 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "各地区持ち回りで明るい遊佐をつくる町民集会も開催し、地域ぐるみでの取組を進めてきたところであります"@ja.
<< kg:id_85 prop:effect kg:id_86 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "保護司の活動も、なかなか十分に認知されているとは言えない現状ではございます。現在酒田飽海地区管内では、保護司定数78名に対して73名と定数割れしている状況でございます"@ja.
<< kg:id_85 prop:effect kg:id_87 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "こうした社会を明るくする運動や再犯防止に関する取組に関しては、コロナ禍により接触型の活動が制限されている部分もありますが"@ja.
<< kg:id_88 prop:cause kg:id_89 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "予定どおり令和８年にＰＡＴが開通し、我が町の交流人口が増加し、受皿として現在稼働している民間の宿泊施設、もしくは第三セクターの宿泊施設だけでは不足するようなことになった場合、遊佐町をフルに生かした民泊、それも農家民泊、農泊に今から力を注ぐべきと考えます"@ja.
<< kg:id_88 prop:effect kg:id_90 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "やる気があって、やってみたいとパワーのある町民の方に、１か月１組でも２組でも宿泊や食事、ランチを提供していただいて、収入を得るような所得向上の仕組みづくりが大切だと考えます"@ja.
<< kg:id_88 prop:effect kg:id_91 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "生きがいづくりは、町民の健康増進にも関与していると臆測されます"@ja.
<< kg:id_88 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "グリーンツーリズムを学びながら農家民泊について認識を深めるという養成講座のご提案につきましては、地域の意向を認識しつつ、一つの方向性として検討していきたいと考えております"@ja.
<< kg:id_88 prop:effect kg:id_93 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "それ以前も農家の受入先の確保が難しく、一般家庭の方からも協力をいただきながら宿泊体験という形で行ってきました"@ja.
<< kg:id_88 prop:effect kg:id_94 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "受入先の確保に苦慮しているなど、こちらからのアクション不足も否めませんが、地域での農家民泊による可能性についての認識はそんなに高くないものと判断されます"@ja.
<< kg:id_95 prop:cause kg:id_96 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "公共施設の維持管理につきましては、行政上の大きな課題と認識をしておりますし、そしてそれらの老朽化については、議員が懸念されておるとおりで、本町だけでなくて、全国ほとんどの自治体で課題となっております"@ja.
<< kg:id_95 prop:cause kg:id_97 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "背景としては、過去に建設された公共施設等がこれから大量に更新時期を迎える一方で、財政はこれまで以上により厳しい状況にあること"@ja.
<< kg:id_95 prop:cause kg:id_98 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "人口減少等により今後の公共施設等の利用需要が変化していくことが挙げられると考えています"@ja.
<< kg:id_99 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "公共施設等の全体の状況を把握し、長期的な視点を持って、更新、統廃合、長寿命化、場合によっては除却などを計画的に行うことを目的に、公共施設等総合管理計画を策定したところであります"@ja.
<< kg:id_99 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "昨年度に公共施設等総合管理基金を創設し、今後の公共施設の更新や保全、除却等の事業に対応してまいりたいと考えております"@ja.
<< kg:id_102 prop:effect kg:id_103 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "公共施設等総合管理基金につきましては、令和３年度で終了した庁舎等建設基金も繰り入れて、まだ決算までは至っていない状況でありますが、単年度で１億7,000万円以上を何とか確保したい"@ja.
}
