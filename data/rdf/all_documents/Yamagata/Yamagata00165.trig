kg:st_1 rdfs:label "学校給食無償化を目指す山形県民の会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "経済悪化で生活が大変な中、無償化が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤光保議員"@ja.
kg:st_2 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_2 prop:content "年間5万円から6万円の負担軽減のため無償化が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "無償化で保護者負担が大きく軽減される"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "無償化は子育て支援と少子化対策の一つ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "同じ県内でも無料と有料で大きな格差がある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "時田町長"@ja.
kg:st_3 rdf:type cls:st_11.
cls:st_11 rdfs:label "自治体"@ja.
kg:op_6 prop:content "値上げせず補助で保護者負担軽減を図る"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "設定単価内で困難でも値上げせず補填したい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "財政事情で無償化できない自治体が多い"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "新たな多額の財源が必要で町単独実施は難しい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "小学校改築の返済負担があり踏み切れない"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "山形県町村会で国に無償化の制度化を要望している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "国県町で分担する制度を求めている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:st_4 rdfs:label "町民"@ja.
kg:st_4 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_13 prop:content "漁業に影響が出ないか心配"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "町や自分の生活にメリットがあるならよい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
kg:op_15 prop:content "騒音や低周波の心配がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "湧水に関する懸念がアンケートに出ている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "景観に関する懸念がアンケートに出ている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "地域活性化への取組に大いに期待している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "国の施策に協力する立場で対応する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "暮らしを守りつつ懸念やリスクの低減を求めていく"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "世界共通の目標として具体策を検討している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "現状排出量を踏まえ施策が必要"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "現状と課題を分析する見える化事業を行った"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "2050年を見据えた施策と目標を示す"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "議会で宣言を行いたい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:st_5 rdfs:label "太田地域生活課長"@ja.
kg:st_5 rdf:type cls:st_11.
kg:op_26 prop:content "多様な可能性を探り計画に反映したい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "農地や公共施設の活用可能性を探っていく"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:st_6 rdfs:label "佐藤俊太郎議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_28 prop:content "設置場所等を明示すれば防犯効果がさらに高まる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:op_29 prop:content "犯罪防止と施設の適正管理を目的に設置してきた"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "必要性と管理状況を踏まえ設置していく"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "プライバシー侵害や情報漏えいに配慮が必要"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "防犯と人権保護のバランスが必要"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "最近の犯罪多発は規範意識の低下の表れだ"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "ネット上の情報氾濫が治安悪化や規範意識低下につながる"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "人間関係の希薄化が治安悪化につながる"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:st_7 rdfs:label "土門教育長"@ja.
kg:st_7 rdf:type cls:st_72.
cls:st_72 rdfs:label "教育機関"@ja.
kg:op_36 prop:content "学校で継続して発達支持的生徒指導を充実させたい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_7.
kg:op_37 prop:content "授業を通じて規範意識を育む"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_7.
kg:op_38 prop:content "社会教育分野でも青少年健全育成に取り組んでいる"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_7.
kg:op_39 prop:content "愛情を感じられる環境づくりで健全育成を図る"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_7.
