    prop:text-txt_contents "新型コロナウイルス感染症による経済の悪化により県民の生活が大変な中"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "学校給食は義務教育に係る保護者負担の中で年間５万円から６万円と最も高額であることから、無償化することで保護者の負担は大きく軽減されます"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "無償化することで保護者の負担は大きく軽減されます"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "県内では、この間、半数以上の自治体で子育て支援策や少子化対策の一つとして学校給食の無償化や一部助成が実施されてきました"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "同じ県内の公立小中学校に通いながら、片や無料、片や子供１人に５から６万円の負担と大きな格差が生じています"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "食材単価の上昇分に対しての補助ということで、学校給食費高騰対策負担金として予算計上させていただいております"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "設定単価内での提供が困難な状況となった場合においても給食費の値上げは行わず、その値上げ相当分を補填することで保護者の負担軽減を図っていきたい"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "しかし、財政的な理由で実施したくてもできないといった自治体も多く"@ja.
<< kg:id_10 prop:cause kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "給食費を公費負担としたときには、現在の生徒数を換算しますと4,000万円超の予算が新たに必要とされております"@ja.
<< kg:id_10 prop:cause kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "小学校改築のための当初の借入金38.5億円のうち、これから返済していかなければならない元利トータルで８億5,400万円ほどまだ残っております"@ja.
<< kg:id_10 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "山形県町村会において、給食費の無償化につきましては国に制度化を要望しております"@ja.
<< kg:id_10 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "半額、２分の１を国家で負担していただけませんかと、そして４分の１を県から負担していただけませんかと、残りの４分の１についてはそれぞれの自治体が負担しますよ"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "一番多かったところでは漁業に影響が出ないか心配"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "町や自分の生活に何らかのメリットがあるならよい"@ja.
<< kg:id_16 prop:effect kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "騒音や低周波の心配がないか心配"@ja.
<< kg:id_16 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "そのほかに湧水に関するものが114"@ja.
<< kg:id_16 prop:effect kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "景観に関するものが77"@ja.
<< kg:id_16 prop:effect kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "発電事業に伴う産業、雇用の活性化をはじめとする地域活性化に関する取組にも大いに期待をしております"@ja.
<< kg:id_16 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "町は法定協議会の一員として事業完了まで協力する立場にあります"@ja.
<< kg:id_16 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "様々な懸念や不安、リスクの回避、低減も併せて引き続き意見していきたい"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "2050年カーボンニュートラルは、日本のみならず世界の目標となっております"@ja.
<< kg:id_25 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "町内で排出される二酸化炭素、いわゆるＣＯ２は８万トンで、農業由来の排出量、これらはメタンになりますが、ＣＯ２換算では１万3,000トンという結果"@ja.
<< kg:id_25 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "昨年度ゼロカーボンに向けた現況調査、いわゆる見える化事業を実施し、町の現状、課題の分析を行いました"@ja.
<< kg:id_25 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "今年度はエネルギー基本計画を策定し、2050年カーボンニュートラルを見据えた町の取り組むべき施策や目標を示していく所存"@ja.
<< kg:id_25 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "今議会でゼロカーボンシティーに向けた宣言を行っていきたい"@ja.
<< kg:id_31 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "エネルギーの地産地消が可能な体制の構築ですとか、今おっしゃられた蓄電池、また住宅への整備支援、ＥＶ車の導入促進"@ja.
<< kg:id_31 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "農地や公共施設を活用した太陽光や地熱の利用など、様々な可能性を探っていきたい"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "当該防犯カメラで撮影された者のプライバシーの保護を図り、もつて町内における街頭犯罪を減少させ、安全で安心な暮らしやすい環境づくりに寄与することを目的とする"@ja.
<< kg:id_34 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "公共施設や道路、公園、学校など不特定多数の利用者が見込まれる施設において犯罪の防止、また施設の適正な管理を目的に設置をしてきております"@ja.
<< kg:id_34 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "防犯目的の必要性及び各施設の管理状況において、必要に応じて設置していくこととなると考えております"@ja.
<< kg:id_34 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "撮影範囲を必要最小限にするように努めることなども必要と考えております"@ja.
<< kg:id_34 prop:cause kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "プライバシーの侵害や個人情報の漏えいに配慮する必要がある"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "強盗事案や偽電話詐欺等の犯罪報道が後を絶ちません"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "偽の情報を含め、様々な情報がインターネット上で氾濫し、それが容易に手に入るようになったから"@ja.
<< kg:id_40 prop:cause kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "人と人とのつながりが希薄となったから、治安悪化につながっているのではないか"@ja.
<< kg:id_40 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "今後も継続して発達支持的生徒指導が小中学校でより充実したものとなっていくよう教育委員会でも適宜指導、助言し、規範意識の高揚に努めてまいりたい"@ja.
<< kg:id_40 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "発達支持的生徒指導の４機能というのがございます。１つ目が自己存在感、２つ目が共感的人間関係、３つ目が自己決定の場、４つ目が安心、安全な風土という４つの機能を授業に取り入れる"@ja.
<< kg:id_40 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "町内の夜間夏季巡回指導、年末街頭指導、列車指導、遊佐中学校、遊佐高等学校での挨拶運動等を行っております"@ja.
<< kg:id_40 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "家庭教育、学校教育、社会教育の連携によりまして、さらなる青少年の健全育成に努めてまいりたい"@ja.
}
