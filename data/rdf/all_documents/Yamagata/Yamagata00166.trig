kg:st_1 rdfs:label "遊佐町議会議員 佐藤光保"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "町民の負担増になるため引上げ案に反対"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "確実に町民の負担増となる内容だと指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "税率引上げで被保険者全体の支払額が増えると確認"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "遊佐町議会議員 齋藤武"@ja.
kg:st_2 rdf:type cls:st_16.
kg:op_4 prop:content "ゴールデンウイークの定義や行政用語としての適切性を確認"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "利用者や受付スタッフが混乱しない運用を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "遊佐町議会議員 佐藤俊太郎"@ja.
kg:st_3 rdf:type cls:st_16.
kg:op_6 prop:content "1,650円を3,300円に改める根拠を質問"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "貸しテント料金であり持込みテントには発生しないことを確認"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:st_4 rdfs:label "遊佐町議会議員 阿部満吉"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_8 prop:content "他市町では追加予算はなかなかあり得ないとして工事完了を求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "この日程と金額で完成することを期待"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:st_5 rdfs:label "遊佐町議会議員 髙橋冠治"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_10 prop:content "もっと早く宣言できなかったのかと質問"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "宣言をどう町民に伝え実際の排出削減に生かすかが重要と指摘"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:st_6 rdfs:label "遊佐町議会議員 菅原和幸"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_12 prop:content "宣言後は地域特性を生かした特色ある取組を迅速に進めるべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_6.
kg:st_7 rdfs:label "鳥海山麓臂曲地区岩石採取に係る調査特別委員会"@ja.
kg:st_7 rdf:type cls:st_50.
cls:st_50 rdfs:label "委員会"@ja.
kg:op_13 prop:content "健全な水循環保全のため継続的な科学的調査研究を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_7.
kg:op_14 prop:content "地下水と湧水を公共水として扱い予防原則を重視すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_7.
kg:op_15 prop:content "新たな知見の蓄積が予防原則の補強につながると提言"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_7.
kg:op_16 prop:content "関係省庁へ法改正を求める意見書を提出"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_7.
kg:op_17 prop:content "条例の合憲判断は画期的で予防原則を認めた意義が大きい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_7.
kg:st_8 rdfs:label "遊佐町沖洋上風力発電事業計画に係る調査等特別委員会"@ja.
kg:st_8 rdf:type cls:st_50.
kg:op_18 prop:content "再生可能エネルギー活用は進めるべきだが合意事項の尊重が不可欠"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_8.
kg:op_19 prop:content "推進にあたり合意事項を守ることが重要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_8.
kg:st_9 rdfs:label "酒田市議会建設経済常任委員会"@ja.
kg:st_9 rdf:type cls:st_50.
kg:op_20 prop:content "基地港湾指定に伴う港湾整備と経済波及効果に強い期待を示す"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_9.
kg:st_10 rdfs:label "遊佐沖洋上風力発電を考える会"@ja.
kg:st_10 rdf:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_21 prop:content "離岸距離や景観や超低周波や進め方に疑問を持つ"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_10.
kg:op_22 prop:content "景観影響を認めた上で双方の議論を始めるべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_8.
kg:op_23 prop:content "町長に政策提言の趣旨に即した対応を強く求める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_8.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今回国民健康保険税の所得割の税率、それから均等割額、世帯の平等割を引き上げたことによって"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "令和４年度が16万901円、それから５年度が17万2,649円ということで、年額で１万1,748円ほどの引上げ"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "令和４年度については２億6,471万4,434円、令和５年度については２億8,708万6,466円ということで、年額で2,237万2,032円の増"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "国保事業の健全化という観点で今回この引上げをした"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "現状の別表第１の備考中に「ゴールデンウイークの期間、」というのを加えて"@ja.
<< kg:id_6 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "指定管理者は町長の承認を得て別に定める期間を繁忙期として定めることができる"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "他市町村の同規模キャンプ場の同程度のテントの使用料と比較いたしますと、かなり現状では低い単価設定となっている"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:text-txt_contents "テントの設置ですとか撤去ですとか清掃など、そういった労務に対する費用を賄える額ではなくなっている"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:text-txt_contents "現在は、施設管理者によりますサービスによるところが大きくなっております。この状態を維持することは、施設管理者側でも不可能である"@ja.
<< kg:id_9 prop:effect kg:id_13 >>
    prop:text-txt_contents "これを維持した結果、利用者へのサービス低下にもつながるおそれがある"@ja.
<< kg:id_9 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "現状では1,650円の規定ではございますが、3,300円という規定に変更させていただきたい"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "この広畑橋は大分工期も、予算も追加予算あったり、大変だったと思います"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これまで約５億8,000万円ほど工事費かけている"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "そういう補助金の活用も今視野に入れて検討している"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:text-txt_contents "今年度のエネルギー基本計画の改定の中で地産地消、エネルギー協議会というものも今設立というところで動き出し始めているという状況。さらには先日の法定協議会で意見の取りまとめが終わりました遊佐町沖の洋上風力発電事業も進んでいる"@ja.
<< kg:id_18 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本議会で議決をいただいた後、町民の皆様にも宣言をしたという当然周知をさせていただきます"@ja.
<< kg:id_18 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "今後再生可能エネルギーの設備の導入促進、例えばバイオ炭の話もございますし、そういうところも含めてですけれども、あと省エネの推進、また温室効果ガス吸収源対策というような大きなくくりの観点の中から、エネルギー基本計画の中にそれを示していきたい"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "自然環境の保全と水資源涵養機能を保全するために、採石事業が及ぼす影響についての調査研究"@ja.
<< kg:id_23 prop:effect kg:id_25 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "健全な水循環を保全することは、住民の生活、農業・漁業をはじめとする産業育成に欠かせない"@ja.
<< kg:id_23 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "継続的に科学的な調査をすることにより新たな知見が得られれば、予防原則の補強にもつながる可能性がある"@ja.
<< kg:id_23 prop:countermeasure kg:id_27 >>
    prop:text-txt_contents "さらなる調査研究が確実に進むよう、町は十分に配慮されたい"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "採石法・森林法等関係法令に、健全な水循環の保全等を含む環境保全の視点を明確に取り入れ、時代に即した改正を行うこと"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:text-txt_contents "採石後、跡地の緑化が確実に行われることが、望ましい景観の回復や災害防止などの観点から重要である"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:text-txt_contents "認可された採石計画に「緑化は杉で」とあるため、杉が用いられている"@ja.
<< kg:id_30 prop:effect kg:id_33 >>
    prop:text-txt_contents "現場はある程度自然植生により、雑草や灌木が生えだしているが、県としては自然植生を緑化ととらえることは通常ない"@ja.
<< kg:id_30 prop:countermeasure kg:id_34 >>
    prop:text-txt_contents "「緑化計画」なので人工的な植栽等により計画を履行すべきと考えている"@ja.
<< kg:id_30 prop:countermeasure kg:id_35 >>
    prop:text-txt_contents "当該事業者に対しては、今後も必要な指導を行っていく"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "最高裁は、昭和47年11月22日の大法廷判決の趣旨に照らし町の条例は憲法第22条第１項（営業の自由）に反しないため合憲と判示し、提訴から約５年に及ぶ裁判闘争は決着し、町の実質的勝訴が確定した"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:text-txt_contents "当該採石事業者の訴えは令和５年３月23日の東京高裁の判決で棄却されている。この判決に対する不服申し立て期日までに、当該採石事業者から不服申し立てはなく、判決内容が確定した"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "温室効果ガスの削減の必要性は衆目のほぼ一致するところであり、東日本大震災の教訓を踏まえ、再生可能エネルギーの利活用は大いに図られるべき"@ja.
<< kg:id_40 prop:effect kg:id_42 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "当該事業の推進にあたっては、議論を積み重ね、町民、特に漁業関係者等との合意事項が尊重され、履行されることが重要"@ja.
<< kg:id_40 prop:effect kg:id_43 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "経済界からは当該事業の経済的効果に強い期待が寄せられており、町民にとって幅広いメリットも期待されるところである"@ja.
<< kg:id_40 prop:effect kg:id_44 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "当該事業の町民議論の中で、離岸距離や景観への影響について関心が高い"@ja.
<< kg:id_40 prop:effect kg:id_45 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "確かに風車完成後、程度は別にせよ景観への影響は排除できない"@ja.
<< kg:id_40 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "町長は法定協議会における町民を代表する唯一の構成員として、町民の思いを的確に伝えられたい"@ja.
<< kg:id_40 prop:countermeasure kg:id_47 >>
    prop:text-txt_contents "議会として当該事業に係る議論の場は引き続き確保すべきである"@ja.
<< kg:id_40 prop:countermeasure kg:id_48 >>
    prop:text-txt_contents "調査等が不十分な事項は適宜追完する必要もある"@ja.
}
