    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "浜中、黒森、十坂、八幡、平田の５つの地域等をデマンドタクシーの運行エリアに追加することにより、公共交通の充実を図ります"@ja.
<< kg:id_130 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "キャッシュレス決済を拡充し、利便性向上と新型コロナウイルス感染症の感染防止を図ります"@ja.
<< kg:id_64 prop:effect kg:id_132 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "令和２年度、令和３年度と酒田港へのクルーズ船の寄港はありませんでした"@ja.
<< kg:id_133 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "令和４年度は、受入れ再開に向けて、国の感染症予防対策ガイドラインに沿った受入れ態勢の構築"@ja.
<< kg:id_133 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "山形県と連携しておもてなしの準備を進めます"@ja.
<< kg:id_136 prop:cause kg:id_59 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "コロナ禍により航空需要が落ち込んだ状態が続く厳しい状況となっています"@ja.
<< kg:id_136 prop:effect kg:id_137 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "コロナ禍により航空需要が落ち込んだ状態が続く厳しい状況となっています"@ja.
<< kg:id_136 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "路線の維持・拡充に向けて、庄内空港利用振興協議会を中心に、観光事業者と連携して庄内空港の利用拡大に努めます"@ja.
<< kg:id_139 prop:effect kg:id_140 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "市街地で頻発する浸水被害の解消を図るため"@ja.
<< kg:id_139 prop:countermeasure kg:id_141 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "市街地で頻発する浸水被害の解消を図るため、道路施設の改修を行います"@ja.
<< kg:id_142 prop:effect kg:id_143 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "老朽化した京田ポンプ場の受電設備を更新します"@ja.
<< kg:id_142 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "老朽化した京田ポンプ場の受電設備を更新するとともに"@ja.
<< kg:id_145 prop:countermeasure kg:id_146 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "家際雨水ポンプ場の電気設備の大規模改修に着手するなど、計画的な更新を行います"@ja.
<< kg:id_147 prop:effect kg:id_148 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "本市の財政は、恒常的に歳出の水準が歳入の水準を上回る構造となっており、予算編成は毎年度極めて厳しい状況にあります"@ja.
<< kg:id_147 prop:effect kg:id_149 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "このような基金の取崩しに依存した財政運営は限界を迎えつつあります"@ja.
<< kg:id_147 prop:countermeasure kg:id_150 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "令和４年度の予算編成については、実施すべき行政サービスの将来的な維持に向け、事業や経費の取捨選択を行いました"@ja.
<< kg:id_147 prop:countermeasure kg:id_151 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "本市が実施するイベントについては必要最低限の予算とし"@ja.
<< kg:id_147 prop:countermeasure kg:id_152 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "各団体への負担金についても繰越金の状況を踏まえて一部削減を実施しています"@ja.
<< kg:id_147 prop:countermeasure kg:id_153 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "負担金や補助金のみの事業であったものは他事業への統合を実施しています"@ja.
<< kg:id_147 prop:countermeasure kg:id_154 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "新たにふるさと納税係を設置し、ふるさと納税による寄附金獲得などの積極的な取組を強化します"@ja.
<< kg:id_147 prop:countermeasure kg:id_155 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "未利用財産の売払いや風力発電事業の売電収益など、歳入確保にも精力的に取り組みます"@ja.
<< kg:id_147 prop:countermeasure kg:id_156 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "未利用財産の売払いや風力発電事業の売電収益など、歳入確保にも精力的に取り組みます"@ja.
<< kg:id_147 prop:countermeasure kg:id_157 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "将来の公共施設の維持に向けた財源確保のための新たな基金を設けるなど、今後の財政運営に資する財政基盤の確立に努めます"@ja.
}
