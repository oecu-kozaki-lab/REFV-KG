kg:st_1 rdfs:label "佐藤弘議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "財政運営が一層厳しさを増している要因として挙げる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "丸山至市長"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "市長"@ja.
kg:op_2 prop:content "財源不足による収支不均衡は引き続き大きな課題とする"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "竹越攻征総務部長"@ja.
kg:st_3 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_3 prop:content "必要な市民サービスとのバランスを取りながら基金依存を圧縮したい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "自主財源の増加は望ましいが収支不均衡は課題とする"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "給与所得が個人市民税総額を押し上げている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "米価の下落は税収の減少に直結すると認識する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "農業は基幹産業であり米価下落は税収減少に直結するとみる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:st_4 rdfs:label "池田博夫議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_8 prop:content "市の将来に影を落とす事象として懸念する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "人口減少の要因の一つとして捉える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "人口減少の要因の一つとして捉える"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "魅力ある就業環境が整っていないことが背景にあるとする"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "人口減少の負の連鎖を生む要因とみる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "教育施策の重点変化の背景として捉える"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_5 rdfs:label "鈴木和仁教育長"@ja.
kg:st_5 rdf:type cls:st_19.
cls:st_19 rdfs:label "教育長"@ja.
kg:op_14 prop:content "避けて通れない課題として議論を進める必要があるとする"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "孤独感や孤立感を持つ子供の増加につながると懸念する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "子供を取り巻く社会環境の変化を懸念する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "課題解決に向けて新年度事業で取り組む"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "液肥の利活用を進める必要があるとする"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "耕畜連携推進事業で解決につなげたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "国が挙げる不漁要因として認識する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "国が挙げる不漁要因として認識する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "国が挙げる不漁要因として認識する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "水揚げ量減少に拍車をかけているとする"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "適切に管理されていない森林が増加していると危惧する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "林業の成長産業化には収益性向上が不可欠とする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "持続可能な財政基盤の確立を前提にした"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "市民目線で内容を明らかにすべきと求める"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "行政評価などを踏まえた結果と説明する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "コスト節減につながるとする"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "職員向け事務経費の削減に効果があるとする"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "限られた予算の有効活用につながるとする"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "社会包摂の具体例として位置づける"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "最終的にはトイレットペーパーと同じような位置づけを目指す"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:st_6 rdfs:label "白畑真由美健康福祉部長"@ja.
kg:st_6 rdf:type cls:st_18.
kg:op_34 prop:content "被保険者に丁寧な説明を行いたい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_6.
kg:op_35 prop:content "必要な受診が抑制されないよう配慮措置があると説明する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_6.
kg:op_36 prop:content "根の力を育てることが確かな学力につながるとする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "小中一貫教育の9年で育みたい人間像とする"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "本市の強みを生かした形で進めたい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "地域プロデューサーを中心に将来的に実現したい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "制度活用を最優先とする"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "今後もしっかり支援していきたい"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "これまでの支援実績も踏まえ検討する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "市民と市のコミュニケーション窓口として整備する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "市民サービス面で差が生じないようにしたい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "企業団体の協力も得て使える市民を増やしたい"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:op_46 prop:content "市民サービス向上や歳出抑制等につながる提案を総合判断する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "実証を継続し課題整理を進める"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "必要性の認識は変わらないが当面は感染症対策等を優先する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "変革への挑戦をテーマに徹底的見直しを行った"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_2.
kg:op_50 prop:content "健全な財政基盤確立のため歳入確保を図る"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:op_51 prop:content "維持することが決まった施設の大規模改修等に充てたい"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_2.
kg:op_52 prop:content "地域との連携協働の理解を深めながら進める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_5.
kg:op_53 prop:content "子供や保護者に負担や混乱がないよう進めたい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:st_7 rdfs:label "齋藤一志教育次長"@ja.
kg:st_7 rdf:type cls:st_48.
cls:st_48 rdfs:label "教育次長"@ja.
kg:op_54 prop:content "名称は変わっても必要性は変わらない"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "多角的に支援できる体制を整え一人一人に寄り添う"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_5.
kg:op_56 prop:content "知ることと情報共有が大事とする"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_5.
kg:op_57 prop:content "全ての市民がひとしく文化芸術を創造享受できるようにする"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_5.
kg:op_58 prop:content "子供たちと芸術家双方に学びの機会を生む"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:op_59 prop:content "3つの柱で事業を進める"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "企業側の意識啓発と行動変容を促す"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "女性のデジタル人材育成と仕事獲得を支援する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "田んぼや畑への堆肥散布を推進したい"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
kg:op_63 prop:content "水田等での利用可能性を検証する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "もみ殻の利活用を一層進めたい"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "森林所有者と林業経営者をつなぎ適切な管理と成長産業化を図る"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_2.
kg:op_66 prop:content "森林境界の明確化や防災面の効果も期待する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "漁業者からの評価も高く継続したい"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_2.
kg:op_68 prop:content "漁業効率向上や新たな漁法への挑戦を支援する"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_2.
kg:op_69 prop:content "若者等の新規就業を確保したい"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "多世代の移住者が地域活性化にも寄与する事業として進める"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_2.
kg:op_71 prop:content "本市を選ぶ機会を増やしたい"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "高い訴求力で他自治体との差別化を図る"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_2.
kg:op_73 prop:content "コロナ禍が続く場合の方向性として継続したい"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_2.
kg:op_74 prop:content "コロナ収束時のインバウンド回復を見据える"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "新しい観光体制として進める"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "全線開通は庄内地域の悲願で重大な使命とする"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_2.
kg:op_77 prop:content "こども家庭庁設置を見据え体制強化を図った"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "人的物的両面から地域の防災力向上を図る"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_2.
kg:op_79 prop:content "女性が地域防災や共助体制で積極的役割を担うことを促進したい"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "中心市街地全体の活性化につなげたい"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_2.
kg:op_81 prop:content "総合計画への位置づけも視野に協議を進める"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "分かりやすく効率的な路線体系に変更する"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_2.
kg:op_83 prop:content "バス停まで歩く負担や待ち時間の負担軽減を図る"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "公共施設の維持管理費用の増嵩など、本市の財政運営は一層厳しさを増しています"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "恒常的に歳出の水準が歳入の水準を上回る構造となっていることから"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "結果としまして、歳出改革しておりますけれども、やはりどうしても間に合わない部分、これは財政調整基金等々使わせていただいております"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "近年、本市では市税収入等の増を要因として、基準財政収入額が増加傾向にあって、普通交付税が減少をしてきている"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "全体の８割強を占める給与所得は、緩やかではあるものの増加傾向が続いておりまして、コロナ禍においても個人市民税の総額を押し上げる形となっている"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "いわゆるこれは米価の下落などを勘案して積算をしているところでございます"@ja.
<< kg:id_13 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "農業は本市の基幹産業であるために、やはり米価の下落は税収の減少に直結するものと認識を持っているところであります"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "新型コロナウイルス感染症の長期化に伴う地域経済の衰退"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本市における人口減少の要因といたしましては、出生数が死亡数を下回る自然減"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "転入数が転出数を下回る社会減が挙げられます"@ja.
<< kg:id_16 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "特に、魅力ある就業環境が整っていないことによる若い世代の女性の転出超過"@ja.
<< kg:id_20 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "若い世代の女性の転出超過、それに伴う婚姻件数や出生数の減少といった負の連鎖"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "いじめや不登校などをはじめとする生徒指導上の課題はますます複雑化しています"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "現に、１つの小学校から２つの中学校へ分かれて進んでいくという学区がございます。泉小学校、浜田小学校がそこに該当いたします"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "学校の先生も授業以外の業務が忙しく、なかなか子供たちに目が行き届かない状況にあるのではないでしょうか"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "現代では、同級生や同年代の子供が減っている上に、核家族化と両親の共稼ぎが進み、親にも精神的な余裕がなくなり"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "家畜排せつ物から生産される堆肥は近年受入れ先がなく、畜産農家は保管場所の確保や処分に多額の費用をかけている"@ja.
<< kg:id_29 prop:cause kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "発電後の残渣から大量の液肥が発生いたします"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "大量に発生したもみ殻の保管場所が確保できずに多額の費用をかけた"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "不漁の要因としては、国では地球規模の気候変動や潮流の変化などによる影響"@ja.
<< kg:id_34 prop:cause kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "不漁の要因としては、国では地球規模の気候変動や潮流の変化などによる影響"@ja.
<< kg:id_34 prop:cause kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "外国船の違法操業による資源量の低下"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "不漁のあおりを受けて廃業する中型イカ釣り船もございまして、本市の水揚げ量の減少に拍車がかかっている"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "自身が所有する森林の場所も分からない所有者が増加しておりまして、それに伴い、適切に管理されていない森林が増加している"@ja.
<< kg:id_42 prop:cause kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "森林整備に必要な間伐等を実施するための補助金なしでは、現状では森林経営が成り立たない状況"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "基金の取崩しに依存した財政運営は限界を迎えつつあります"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "実施すべき行政サービスの将来的な維持に向け、事業や経費の取捨選択を行いました"@ja.
<< kg:id_48 prop:effect kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "結果として、事業の拡充や継続、統合という形で事業の取捨選択がなされた"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "議員や職員へのタブレット配付に伴いまして、例えば印刷物がかなり節約される、コストが節減されるという意味で、予算書等をデータ化して紙による資料作成経費を削減"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "ＤＸ化によるペーパーレスの推進、オンライン会議の実施等による需用費や旅費の削減、各種計画、概要、パンフレット、会報等の電子媒体を有効活用することによる印刷製本費の削減"@ja.
<< kg:id_54 prop:effect kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "複数の事業を統合することによりまして、限られた予算を有効に活用できるような取組にも力を入れた"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "予算編成の中では大きく２つ、具体例として申し上げますと、男女共同参画社会の実現という事業ございます"@ja.
<< kg:id_56 prop:effect kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "もう一点が、副市長を中心に御指導いただいておりますけれども、生理用品サポート事業"@ja.
<< kg:id_59 prop:effect kg:id_60 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "本市の被保険者約１万9,000名に対し、窓口負担割合が１割から２割になる方は約2,200名、11.6％と見込んでいる"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "制度施行後３年間、令和７年９月30日までは１か月の外来における医療費の負担増加額を3,000円までに抑える措置"@ja.
<< kg:id_63 prop:effect kg:id_64 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "この根の力を高めることによりまして、いわゆる見える学力も伸びていくものと確信しております"@ja.
<< kg:id_65 prop:effect kg:id_66 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "自ら学び考え、時代の変化に対応し、多様性を認め支え合い、公益の心でこれからの社会を担っていくような人"@ja.
<< kg:id_67 prop:effect kg:id_68 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "本市ではスクール・コミュニティを実現するという表現にした"@ja.
<< kg:id_69 prop:effect kg:id_70 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "地域プロデューサーを中心に話合いをしていただいて、そこで話合いをした結果を学校に持ち寄り、市の教育委員会のほうに届けていただくとか、あるいは市の担当部局のほうに上げていただく"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "国や県制度の周知を徹底した上で制度の活用をしっかりと図っていくことが最優先"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "約560件に対する利子補給と保証料補給"@ja.
<< kg:id_75 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "農林水産業に対しましても、これまで実施した新型コロナウイルス関連農業打撃克服対策事業における水稲種子への支援ですとか、同じく新型コロナウイルス関連水産業打撃克服対策事業における魚箱等への支援策などにつきましても、それぞれの業界の状況を見ながら検討していきたい"@ja.
<< kg:id_77 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "市民と市のコミュニケーション窓口となるポータルサイト、これを市民マイページと呼んでいるわけでありますが、こういったものを開発してまいります"@ja.
<< kg:id_79 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "デジタル活用による効率化によって生じた、我々、余力部分ですけれども、余力部分をそういう方々に振り向けて、これまで以上に丁寧に、市民サービスの面では差が生じないように対応してまいりたい"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "第一生命保険株式会社からスマホ教室の開催の提案を受けておりまして"@ja.
<< kg:id_83 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "あらゆる行政分野における事務事業及び本市が有する全ての公有財産を提案の対象としております"@ja.
<< kg:id_85 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "令和４年度もテレワークについては当該事業を中心として実証を行っていきたい"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "公民連携によります施設整備ですとか、あるいは令和５年度に発足するこども家庭庁の動向、こういったことをやることによって、ひょっとしたら有利な財源が国から来るということも想定できますし、そういった意味では、その有利な財源の利用も今後視野に入れながら、中長期的な視点で屋内児童遊戯施設の在り方については引き続き検討していきたい"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "事業効果や優先性を踏まえた実施事業の取捨選択を行う"@ja.
<< kg:id_89 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "ふるさと納税寄附金や遊休資産の売却などによる歳入の積極的な確保を図る"@ja.
<< kg:id_92 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "公共施設等整備基金は、公共施設等の改修等、整備に係る費用に充当するために創設"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "このことについて各地域に説明をすることがまずもって大事なことだろうと思っています"@ja.
<< kg:id_96 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "これから地域の方々ときちんと話をしていかなければならない"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "令和４年度につきましては、教育活動充実事業ということで、ほぼ同様な事業、同様な内容について実施していく"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "スクールカウンセラーと教育相談員を配置しております...スクールソーシャルワーカーも配置している"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "今後特に教職員がヤングケアラーについて知ることや子供自身がヤングケアラーについて知ること、これがやはり、引き続きこの周知を図ることが大事だと捉えております"@ja.
<< kg:id_104 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "全ての市民がひとしく文化芸術を創造・享受できるよう、文化芸術を身近に体験できる文化的環境の整備に努めている"@ja.
<< kg:id_104 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "小学校21校と特別支援学校にアーティストが直接、またはコロナの関係で一部リモートというのもありましたが、訪問いたしまして"@ja.
<< kg:id_107 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "本市では３つの柱、１つは職場における女性活躍、２つ目は家庭との両立支援、そして３つ目が女性のチャレンジ支援"@ja.
<< kg:id_107 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "地域女性活躍推進交付金を活用した経営者向けセミナーの開催"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "よろずＩＴ女子マネジャー１名をこのサンロク内に配置をしまして、女性のデジタル人材の育成とデジタルスキルを生かした市内外の企業の仕事獲得を支援していきたい"@ja.
<< kg:id_112 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "堆肥については散布活動を推進させるための方策として、堆肥散布組織などを対象に散布経費を支援する"@ja.
<< kg:id_112 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "液肥の成分分析を実施した上で、牛の餌となる飼料作物の栽培圃場で散布時期、散布量などを変えて作物の栽培を行い、生育効果の検証をする予定"@ja.
<< kg:id_112 prop:countermeasure kg:id_115 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "重量の割にかさばるもみ殻を圧縮・梱包するための機械の導入を検討しておりまして、本市では耕畜連携推進事業において、国の補助事業を活用してこの機械の導入に支援"@ja.
<< kg:id_116 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "森林経営管理制度は、市町村が森林の経営管理の委託を受け、森林所有者と林業経営者をつなぐことにより、林業の成長産業化と森林資源の適切な管理の両立が期待される"@ja.
<< kg:id_116 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "来年度は山形県と庄内の２市２町の共同実施によりまして、航空レーザー測量に取り組む予定"@ja.
<< kg:id_119 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "収納段ボール箱購入補助や県漁協に設置する仮設風呂・シャワー施設、またレンタカー補助など乗組員の生活環境支援を行ってまいりました"@ja.
<< kg:id_119 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "魚群探知機など漁業効率の向上や新たな漁法への挑戦などに必要な機器や機材の導入・整備を支援する"@ja.
<< kg:id_119 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "本市での漁業研修を開始するための初期投資費用や研修期間中の生活基盤の支援などを行う新規就業者確保・育成総合対策支援事業"@ja.
<< kg:id_123 prop:countermeasure kg:id_124 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "消防署跡地を無償で貸して、民間事業者の資金力とノウハウで施設、この施設というのは移住者向け住宅と地域交流拠点の２つを指しますけれども、その整備運営を行う公民連携の仕組みで事業を推進"@ja.
<< kg:id_125 prop:countermeasure kg:id_126 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "令和４年度は新たにウェブサイト等に表示されるインターネット広告を展開して移住ポータルサイトに誘導する"@ja.
<< kg:id_125 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "ＡＮＡ株式会社に所属する現役キャビンアテンダント５名の方がいらっしゃるわけですけれども、この方々と連携をして、ＳＮＳを活用した情報発信"@ja.
<< kg:id_128 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "鳥海山・飛島ジオパークや北前船寄港地の日本遺産を活用したマイクロツーリズムを中心とした少人数での体験型コンテンツの提供"@ja.
<< kg:id_128 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "収束した場合は、一気にインバウンド等が戻ることも考えられますので、そのときのために海外からの教育旅行の誘致活動をしっかりと進めていきたい"@ja.
<< kg:id_128 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "既存の酒田観光戦略推進協議会と、それから新たに立ち上げる（仮称）酒田ＤＭＯが役割分担しながら協働して進めていきたい"@ja.
<< kg:id_132 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "地元選出の国会議員をはじめ県議会議員、市議会議員、そして県や沿線自治体、各関係機関、関係団体と連携して、令和４年度においても積極的な要望活動を展開していきたい"@ja.
<< kg:id_134 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "福祉課を福祉企画課という形で名称を変え、組織も変えて、その中に新たに総合政策係を設置し、市として健康福祉部内の体制強化、機構改革を行った"@ja.
<< kg:id_136 prop:countermeasure kg:id_137 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "防災拠点となる消防本部敷地への防災備蓄倉庫の建設を行い、油圧ショベルや発電機、大型テントなどの資機材の配備を進める"@ja.
<< kg:id_136 prop:countermeasure kg:id_138 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "女性防災リーダー育成講座については、令和４年度も実施をいたしまして、女性が地域の防災、共助体制に積極的な役割を担うことを促進していきたい"@ja.
<< kg:id_139 prop:countermeasure kg:id_140 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "山居倉庫と連携したにぎわいの拠点として、また市民の生活利便性が向上する日常生活の拠点として活用"@ja.
<< kg:id_141 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "民間主導による再整備事業が前進するよう、現在策定を進めている総合計画にもできれば位置づけてまいりたい"@ja.
<< kg:id_143 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "市街地エリアはるんるんバスの全面的な改編を行い、酒田駅前、中町周辺、日本海総合病院の３拠点は必ず経由し、市内循環線は行き先が交錯しないように工夫するなど、分かりやすく効率的な路線体系に変更する"@ja.
<< kg:id_143 prop:countermeasure kg:id_145 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "デマンドタクシーの運行エリアを拡充することとしております。さらに、通学や通勤にも利用できるように運行日を週３日から平日にし"@ja.
}
