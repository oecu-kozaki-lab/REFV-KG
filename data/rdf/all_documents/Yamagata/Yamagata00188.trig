kg:st_14 rdf:type cls:st_16.
kg:op_141 prop:content "自動車業界では大きな雇用影響が出ると危機感を示す"@ja.
kg:op_141 rdf:type cls:opinion.
kg:op_141 prop:speaker kg:st_14.
kg:op_142 prop:content "国際競争力低下への強い危機感を示す"@ja.
kg:op_142 rdf:type cls:opinion.
kg:op_142 prop:speaker kg:st_14.
kg:op_143 prop:content "製造時の電力起源CO2まで問われる時代だと指摘する"@ja.
