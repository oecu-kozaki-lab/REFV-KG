kg:st_15 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_145 prop:content "地域にとって重い事案であり関係者に訴えてきたと述べる"@ja.
kg:op_145 rdf:type cls:opinion.
kg:op_145 prop:speaker kg:st_15.
kg:op_146 prop:content "代替事業展開も含め直接相談しアドバイスを受けてきたと述べる"@ja.
kg:op_146 rdf:type cls:opinion.
kg:op_146 prop:speaker kg:st_15.
kg:op_147 prop:content "県知事にも話し地元として県と一緒に動いたと述べる"@ja.
kg:op_147 rdf:type cls:opinion.
kg:op_147 prop:speaker kg:st_15.
kg:op_148 prop:content "廃止なら東北電力グループが他電源で補うだろうと述べる"@ja.
kg:op_148 rdf:type cls:opinion.
kg:op_148 prop:speaker kg:st_15.
kg:op_149 prop:content "酒田市は全国でもいち早く再生可能エネルギー導入に取り組んできたと説明する"@ja.
kg:op_149 rdf:type cls:opinion.
kg:op_149 prop:speaker kg:st_15.
kg:op_150 prop:content "早期から各施設で導入してきたと説明する"@ja.
kg:op_150 rdf:type cls:opinion.
kg:op_150 prop:speaker kg:st_15.
kg:op_151 prop:content "酒田地区広域行政組合で余熱利用発電と売電に取り組んでいると説明する"@ja.
kg:op_151 rdf:type cls:opinion.
kg:op_151 prop:speaker kg:st_15.
kg:op_152 prop:content "乱開発抑止と環境景観との調和を図ってきたと説明する"@ja.
kg:op_152 rdf:type cls:opinion.
kg:op_152 prop:speaker kg:st_15.
kg:op_153 prop:content "市直営で風力発電所を運転開始したと説明する"@ja.
kg:op_153 rdf:type cls:opinion.
kg:op_153 prop:speaker kg:st_15.
kg:op_154 prop:content "クリーンセンターで消化ガス発電と売電を行っていると説明する"@ja.
kg:op_154 rdf:type cls:opinion.
kg:op_154 prop:speaker kg:st_15.
kg:op_155 prop:content "酒田港を活用したバイオマス発電が稼働していると説明する"@ja.
kg:op_155 rdf:type cls:opinion.
kg:op_155 prop:speaker kg:st_15.
kg:op_156 prop:content "約28メガワットの太陽光発電所が稼働中と説明する"@ja.
kg:op_156 rdf:type cls:opinion.
kg:op_156 prop:speaker kg:st_15.
kg:op_157 prop:content "企業の自家消費型太陽光導入も進んでいると説明する"@ja.
kg:op_157 rdf:type cls:opinion.
kg:op_157 prop:speaker kg:st_15.
kg:op_158 prop:content "八幡地区で小水力発電も稼働していると説明する"@ja.
kg:op_158 rdf:type cls:opinion.
kg:op_158 prop:speaker kg:st_15.
kg:op_159 prop:content "鳥海高原デーリィファームで自家消費型の設備が建設中と説明する"@ja.
kg:op_159 rdf:type cls:opinion.
kg:op_159 prop:speaker kg:st_15.
kg:op_160 prop:content "エネルギー分野で地域外流出があると指摘する"@ja.
kg:op_160 rdf:type cls:opinion.
kg:op_160 prop:speaker kg:st_14.
kg:op_161 prop:content "電気収支は黒字であり数字は一概に悪くないと説明する"@ja.
kg:op_161 rdf:type cls:opinion.
kg:op_161 prop:speaker kg:st_15.
kg:op_162 prop:content "発電事業者立地により電気代金収支は黒字だと説明する"@ja.
kg:op_162 rdf:type cls:opinion.
kg:op_162 prop:speaker kg:st_15.
kg:op_163 prop:content "酒田天然ガス株式会社などと連携し前に進む道を模索する余地があると述べる"@ja.
kg:op_163 rdf:type cls:opinion.
kg:op_163 prop:speaker kg:st_15.
kg:op_164 prop:content "官民連携で進めるべきと求める"@ja.
kg:op_164 rdf:type cls:opinion.
kg:op_164 prop:speaker kg:st_14.
kg:op_165 prop:content "企業活動として安定的長期的な顧客確保が大前提と説明する"@ja.
kg:op_165 rdf:type cls:opinion.
kg:op_165 prop:speaker kg:st_15.
kg:op_166 prop:content "新電力は市場価格高騰時に破綻リスクがあると説明する"@ja.
kg:op_166 rdf:type cls:opinion.
kg:op_166 prop:speaker kg:st_15.
kg:op_167 prop:content "短中期では産業維持との両立が非常に大きな課題だと述べる"@ja.
kg:op_167 rdf:type cls:opinion.
kg:op_167 prop:speaker kg:st_15.
kg:op_168 prop:content "CO2削減だけで議論するのは適切でないと述べる"@ja.
kg:op_168 rdf:type cls:opinion.
kg:op_168 prop:speaker kg:st_15.
kg:op_169 prop:content "達成目標と実施措置内容を定める計画を策定中と説明する"@ja.
kg:op_169 rdf:type cls:opinion.
kg:op_169 prop:speaker kg:st_15.
kg:op_170 prop:content "国県地元企業と連携して酒田港で検討を進めていると説明する"@ja.
kg:op_170 rdf:type cls:opinion.
kg:op_170 prop:speaker kg:st_15.
kg:op_171 prop:content "環境負荷軽減や地球温暖化防止に効果の高い農業活動を支援していると説明する"@ja.
kg:op_171 rdf:type cls:opinion.
kg:op_171 prop:speaker kg:st_15.
kg:op_172 prop:content "炭素貯留効果の高い有機農業に交付金支援していると説明する"@ja.
kg:op_172 rdf:type cls:opinion.
kg:op_172 prop:speaker kg:st_15.
kg:op_173 prop:content "将来的に大切な取組であり製品性能や費用対効果を見て推進判断すると述べる"@ja.
kg:op_173 rdf:type cls:opinion.
kg:op_173 prop:speaker kg:st_15.
kg:op_174 prop:content "将来的に大切な取組であり情報を勘案して判断すると述べる"@ja.
kg:op_174 rdf:type cls:opinion.
kg:op_174 prop:speaker kg:st_15.
kg:op_175 prop:content "将来的に大切な取組であり農業者意向も踏まえて判断すると述べる"@ja.
kg:op_175 rdf:type cls:opinion.
kg:op_175 prop:speaker kg:st_15.
kg:op_176 prop:content "農業経営改善が期待されると理解する"@ja.
kg:op_176 rdf:type cls:opinion.
kg:op_176 prop:speaker kg:st_15.
kg:op_177 prop:content "継続営農と収量要件があると説明する"@ja.
kg:op_177 rdf:type cls:opinion.
kg:op_177 prop:speaker kg:st_15.
kg:op_178 prop:content "年々価格が下がり安定的収益確保が困難になっていると説明する"@ja.
kg:op_178 rdf:type cls:opinion.
kg:op_178 prop:speaker kg:st_15.
kg:op_179 prop:content "設備構造上の問題も課題だと説明する"@ja.
kg:op_179 rdf:type cls:opinion.
kg:op_179 prop:speaker kg:st_15.
kg:op_180 prop:content "経営主体が分かれる場合の課題を指摘する"@ja.
kg:op_180 rdf:type cls:opinion.
kg:op_180 prop:speaker kg:st_15.
kg:op_181 prop:content "地域版認証機関は難しいがプログラム型は理屈上可能で勉強が必要と述べる"@ja.
kg:op_181 rdf:type cls:opinion.
kg:op_181 prop:speaker kg:st_15.
kg:op_182 prop:content "市が認証機関になるのは難しいと判断する"@ja.
kg:op_182 rdf:type cls:opinion.
kg:op_182 prop:speaker kg:st_15.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "昨夜午後11時36分、福島県沖を震源地とし、宮城県、福島県で震度６強の地震があり"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "津波注意報が発令されました"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "お亡くなりになられた方もあると今朝の報道で耳にしており、お悔やみ申し上げます"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "本市で震度５弱"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "夜間の長い揺れと余震に不安な夜を迎えた方々が多かったことと思います"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "行政、関係の皆様には、夜間の配備、安全確認等をいただきましたこと、感謝申し上げます"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "行政、関係の皆様には、夜間の配備、安全確認等をいただきましたこと、感謝申し上げます"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "私は大丈夫という正常性バイアスによって"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "昭和51年10月29日の午後５時40分頃出火した炎は、西からの強風によって商店街から住宅地へと拡大しました"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:text-txt_contents "商店街から住宅地へと拡大しました"@ja.
<< kg:id_12 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "この大火では当時の消防長がお亡くなりになりました"@ja.
<< kg:id_12 prop:effect kg:id_16 >>
    prop:text-txt_contents "当時1,023世帯の3,300人が罹災して"@ja.
<< kg:id_12 prop:effect kg:id_17 >>
    prop:text-txt_contents "避難生活を余儀なくされました"@ja.
<< kg:id_12 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "地域のコミュニティ力が家財の持ち出し、飛び火の制御、迅速な避難などに発揮された"@ja.
<< kg:id_12 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "地域のコミュニティ力が家財の持ち出し、飛び火の制御、迅速な避難などに発揮された"@ja.
<< kg:id_12 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "地域のコミュニティ力が家財の持ち出し、飛び火の制御、迅速な避難などに発揮された"@ja.
<< kg:id_12 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "仮設住宅は被災者の強い希望を反映して、被災地に近い中央公民館グラウンドなど６か所に建設されている"@ja.
<< kg:id_12 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "そのため、地域コミュニティが破壊されずに"@ja.
<< kg:id_12 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "被災者の助け合いや復興の相談がスムーズにできている"@ja.
<< kg:id_12 prop:effect kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "災害に最も重要とされる共助が酒田大火では発揮された"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "しかしながら、45年が経過し、市民の中にも職員の中にも酒田大火を知らない世代が増えてきました"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "市民の中にも職員の中にも酒田大火を知らない世代が増えてきました"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "御自身が酒田大火で被災した際に、全国の多くの方から支援をいただいたことが現在の活動の原動力になって、今度は自分が応援するのだとおっしゃっています"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "酒田大火でお世話になった恩返しがしたいとボランティアに動いた多くの市民がいた"@ja.
<< kg:id_12 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "この教訓を受けて、消防組織においては消防職員の増員"@ja.
<< kg:id_12 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "消防車両や各資機材の増強を図ってまいりました"@ja.
<< kg:id_12 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "強風時の火災防御戦術の見直しを行い"@ja.
<< kg:id_12 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "従来の風下防御隊形から炎を挟み込んで迎え撃つ挟撃防御の隊形"@ja.
<< kg:id_12 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "大口径ノズルを使用した大量放水戦術へと防御の態勢の強化を図りました"@ja.
<< kg:id_12 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "山形県内各市町村と広域応援協定が整備されました"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "今でも風の強い日は、消防車両が警鐘を鳴らしながら巡回する防火広報を行い、出火防止の呼びかけを行っております"@ja.
<< kg:id_12 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "幅広い道路網や公園・緑地等の整備"@ja.
<< kg:id_12 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "公園・緑地等の整備"@ja.
<< kg:id_12 prop:cause kg:id_42 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "商店街では延焼拡大の原因となったアーケード方式"@ja.
<< kg:id_12 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "国内初となるセットバック方式が採用され、防火・防災対策を強化"@ja.
<< kg:id_12 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "消防水利の増設が行われました"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "自主防災組織の対応力の強化であります"@ja.
<< kg:id_45 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "発災対応型の防災訓練を通して地域の防災力の向上が図られております"@ja.
<< kg:id_48 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "毎年、防火の誓いを新たにすべく、大火発生時間の10月29日午後５時50分に市役所屋上の防災行政無線によりサイレンを鳴らしております"@ja.
<< kg:id_48 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "各小学校の避難訓練時や社会科の授業"@ja.
<< kg:id_48 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "各小学校の避難訓練時や社会科の授業"@ja.
<< kg:id_48 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "教育委員会で新たに作成した電子版防災ハンドブックなどにより酒田大火を取り上げ"@ja.
<< kg:id_48 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "新消防本部においては、酒田大火の写真パネルを常設し、小学生などの見学者に対し当時の災害状況の説明を行っております"@ja.
<< kg:id_48 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "酒田市資料館においても酒田大火に関する資料の常設展示を行っております"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "文化資料館（仮称）でも引き続き常設展示として来館者に紹介していきたい"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "観光客の避難・誘導のためのマニュアルとはなっていないのが事実であります"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "それぞれの災害別の避難場所などの情報を交流観光課が提供して"@ja.
<< kg:id_59 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "災害対応マニュアルとなるよう改定を支援・指導しているところでございます"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "酒田花火ショー開催時には、津波発生を想定した避難ルートについて複数回アナウンスし"@ja.
<< kg:id_62 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "安全確認を行うといったこともしております"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "英語、中国語のみとなりますが、避難指示の有無などの災害情報を記載したファクスを観光施設に送信し、掲示してもらう仕組みを整えております"@ja.
<< kg:id_66 prop:cause kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "災害時に被害状況などを一斉に共有するといった連携体制がないこと"@ja.
<< kg:id_66 prop:cause kg:id_68 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "災害情報の多言語対応などが挙げられております"@ja.
<< kg:id_69 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "危機管理課が災害避難の周知動画を作成しております"@ja.
<< kg:id_69 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "この動画に英語の字幕をつけて、定期船とびしまで今後上映する予定"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "クルーズ船寄港時に、避難場所を示す看板を乗客向けに多言語で掲示"@ja.
<< kg:id_59 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_56;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "観光防災マニュアルの策定は大変有効なものと考えております"@ja.
<< kg:id_59 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "観光庁が示している自治体・観光関連事業者等における観光危機管理推進のための手引書を基に、策定に向けて準備を進めていく"@ja.
<< kg:id_59 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "合同勉強会の開催等についても検討していきたい"@ja.
<< kg:id_77 prop:effect kg:id_78 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "道路損壊や家屋倒壊で避難所まで到達できない場合がある"@ja.
<< kg:id_77 prop:effect kg:id_79 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "避難所までの道のりで交通渋滞を起こし、緊急車両の妨げになること"@ja.
<< kg:id_77 prop:effect kg:id_80 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "避難所での駐車スペースが限られること"@ja.
<< kg:id_77 prop:effect kg:id_81 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "車内の長時間滞在によるエコノミー症候群の発症危険があること"@ja.
<< kg:id_77 prop:effect kg:id_82 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "食料等の物資が配達されない可能性がある"@ja.
<< kg:id_77 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "様々な弊害があるため、車中避難の推奨はしておりません"@ja.
<< kg:id_77 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "特別な事情がありやむを得ず車中避難をする方については、一定の配慮が必要である"@ja.
<< kg:id_85 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "全庁的な項目については令和２年６月に策定をしております"@ja.
<< kg:id_85 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "各所属の部課長が実態に合わせて、詳細な業務継続要領を作成しているところでございます"@ja.
<< kg:id_85 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "年間を通した優先すべき業務の順位づけ"@ja.
<< kg:id_85 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "職員欠員時における業務の分担"@ja.
<< kg:id_85 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "密を避けるための分散勤務方法などが記され"@ja.
<< kg:id_85 prop:cause kg:id_91 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "感染した家族の看護などの理由を含めると最大40％に達すると示されております"@ja.
<< kg:id_85 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "業務継続計画の現状に即した修正が必要である"@ja.
<< kg:id_85 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "業務の優先順位の見直し"@ja.
<< kg:id_85 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "所属の垣根を越えた業務継続のための代替要員の確保"@ja.
<< kg:id_85 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "感染予防対策の再確認"@ja.
<< kg:id_48 prop:cause kg:id_96 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_79;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "市民の方から、10月29日、昨年ですけれども、サイレン聞こえなかった"@ja.
<< kg:id_48 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "ＬＩＮＥとかＳＮＳを活用した情報発信を検討していきたい"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_82;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "そういった論文をひとつに収集できないだろうか"@ja.
<< kg:id_57 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_84;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "早急に対応させていただきたい"@ja.
<< kg:id_101 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_86;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "速やかに配備できるようにさせていただきたい"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "完全にこれを無償化した場合には...この歳入と同額の財源の確保が恒久的に必要"@ja.
<< kg:id_103 prop:cause kg:id_105 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "義務教育における公平性の確保ということで課題がある"@ja.
<< kg:id_106 prop:cause kg:id_107 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "低収入または収入が不安定である"@ja.
<< kg:id_106 prop:cause kg:id_108 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "低収入または収入が不安定である"@ja.
<< kg:id_106 prop:cause kg:id_109 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "自営業が不振であるといった経済的な事由"@ja.
<< kg:id_106 prop:cause kg:id_110 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "これにはコロナ禍による経済低迷の要因も含まれます"@ja.
<< kg:id_106 prop:cause kg:id_111 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "納付意識の欠如"@ja.
<< kg:id_106 prop:cause kg:id_112 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "保護者の金銭管理意識の欠如"@ja.
<< kg:id_113 prop:cause kg:id_114 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "無料化の対象を18歳まで拡大するには新たに約6,400万円の財源が必要"@ja.
<< kg:id_113 prop:cause kg:id_115 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_97;
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "過剰な受診の増加による保険者等の財政への影響も懸念される"@ja.
<< kg:id_116 prop:cause kg:id_117 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "テレワークが定着したことで、遠隔地や人口密度の低い地方・中核都市が移転の有力な候補"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "創業の地などゆかりのある地への移転が多いなど、内容に偏りが見られ、新たな土地に進出をする形での本社移転は少ない"@ja.
<< kg:id_120 prop:countermeasure kg:id_121 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "令和３年度に...情報サービス企業２社が立地"@ja.
<< kg:id_120 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "立地後も立地企業との情報を密にしまして、市内企業との関係性も高めながら立地企業の着実な成長を支えていきたい"@ja.
<< kg:id_120 prop:countermeasure kg:id_123 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "国・県を含めた企業支援制度...を活用いたしまして...最大限の支援を行ってまいりたい"@ja.
<< kg:id_124 prop:cause kg:id_125 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_104;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "中学校で特に大きな要因は部活動指導でございます"@ja.
<< kg:id_124 prop:cause kg:id_126 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "長時間勤務につながるもう一つの要因として、勤務時間外の保護者の方々との連絡、保護者対応"@ja.
<< kg:id_124 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_107;
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "休日の部活動における地域への移行を踏まえながら部活動の在り方について検討"@ja.
<< kg:id_124 prop:countermeasure kg:id_128 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "時間外の電話対応を極力なくす方向で動いております"@ja.
<< kg:id_129 prop:effect kg:id_130 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "生活リズムをつくれずに乱れから学校が不登校気味になってしまうというような生徒も一定程度おります"@ja.
<< kg:id_131 prop:countermeasure kg:id_132 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "学校防災マニュアルの整備と改善が大きな柱"@ja.
<< kg:id_131 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "防災アドバイザーを御委嘱しまして、各校のマニュアルについて御助言を得ながら整備と改善に努めております"@ja.
<< kg:id_131 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "今年度、電子版酒田防災ハンドブックを作成いたしました"@ja.
<< kg:id_131 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "毎年各校の防災マニュアルを検証して精度を高めている"@ja.
<< kg:id_131 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "安全・安心メールを管理職職員の個人端末からも発信できるようにした"@ja.
<< kg:id_131 prop:countermeasure kg:id_137 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "下校途中に災害が発生したらどうする？などと問いかけて、子供自身が主体的に判断し行動できるように指導"@ja.
<< kg:id_138 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "次期職員数適正化方針を見直すに当たりましては"@ja.
<< kg:id_138 prop:countermeasure kg:id_140 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "課ごと、部ごとに積み上げ算をしていって、じゃ市役所全体では何人になるのか"@ja.
<< kg:id_141 prop:countermeasure kg:id_142 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "現行60歳の定年を令和５年度から令和13年度にかけて段階的に引き上げて65歳とする"@ja.
<< kg:id_141 prop:countermeasure kg:id_143 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "60歳を超える職員につきましては、60歳時点の７割水準とする"@ja.
<< kg:id_141 prop:countermeasure kg:id_144 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "管理職につく職員は原則として60歳で非管理職へ異動させる"@ja.
<< kg:id_145 prop:countermeasure kg:id_146 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "派遣型と言われます、シルバー人材センターの会員を発注者の事業所に派遣する形態、これを取り入れてまいりました"@ja.
<< kg:id_145 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "派遣先は介護事業所のようなものはどうか"@ja.
<< kg:id_145 prop:countermeasure kg:id_148 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "学童保育所に派遣するといった形も取り入れて"@ja.
<< kg:id_145 prop:countermeasure kg:id_149 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_125;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "シルバー人材センター職員のコーディネート力の増強"@ja.
<< kg:id_150 prop:cause kg:id_151 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_127;
    prop:text-txt_contents "最終処分場の埋立残容量が少なくなっている状況"@ja.
<< kg:id_152 prop:cause kg:id_153 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "本市における１人１日当たりの家庭系ごみの排出量...県内13市中最も高い"@ja.
<< kg:id_154 prop:countermeasure kg:id_155 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_129;
    prop:text-txt_contents "紙類資源の適切な分別"@ja.
<< kg:id_154 prop:countermeasure kg:id_156 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_130;
    prop:text-txt_contents "廃プラスチックのリサイクルを含めて、ごみの排出量の削減に努めること"@ja.
<< kg:id_157 prop:effect kg:id_158 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "広域的に取り組むべき課題について、やはり今後ますます庄内広域行政組合の果たす役割というのは大きくなっていく"@ja.
<< kg:id_159 prop:cause kg:id_160 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_132;
    prop:text-txt_contents "やはり中心市の事務負担が大きいといった意見"@ja.
<< kg:id_161 prop:countermeasure kg:id_162 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "圏域全体のマネジメントを担うことが求められている"@ja.
<< kg:id_163 prop:countermeasure kg:id_164 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_134;
    prop:text-txt_contents "市町村が連携し、広域で取り組むことが重要な鍵"@ja.
<< kg:id_165 prop:countermeasure kg:id_166 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_135;
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_136;
    prop:text-txt_contents "本市のＰＨＲサービスと、それからちょうかいネットが有する電子カルテなどのデータとの連携"@ja.
<< kg:id_167 prop:cause kg:id_168 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_137;
    prop:text-txt_contents "完全な予約制システムを導入しなければならない...電子決済システム...電子処方箋システム"@ja.
<< kg:id_167 prop:cause kg:id_169 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_138;
    prop:text-txt_contents "触診というのの大切さ"@ja.
<< kg:id_165 prop:countermeasure kg:id_170 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_139;
    prop:text-txt_contents "酒田市のＰＨＲとしても、マイナポータルの連携というものも考えております"@ja.
<< kg:id_165 prop:countermeasure kg:id_171 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_140;
    prop:text-txt_contents "スマホのほうに、今日はちょっと体重が最近減り過ぎていますよとかという注意機能を出す"@ja.
<< kg:id_172 prop:effect kg:id_173 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_141;
    prop:text-txt_contents "自動車業界の550万人のうち70万人から100万人の雇用に影響が出ている"@ja.
<< kg:id_172 prop:effect kg:id_174 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_142;
    prop:text-txt_contents "輸出で自動車業界が稼いでいる外貨獲得15兆円が限りなくゼロになる"@ja.
<< kg:id_175 prop:cause kg:id_176 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_143;
    prop:text-txt_contents "火力発電の電力を使って生産した電気自動車は海外で売れなくなる"@ja.
<< kg:id_177 prop:cause kg:id_178 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_144;
    prop:text-txt_contents "海外で作るしかなくなる、そうなれば日本の工場を閉めることになり、部品産業を含めたたくさんの雇用が失われる"@ja.
<< kg:id_179 prop:effect kg:id_180 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_145;
    prop:text-txt_contents "休廃止は酒田市の雇用と経済に甚大なる影響を与える"@ja.
<< kg:id_179 prop:countermeasure kg:id_181 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_146;
    prop:text-txt_contents "東北電力株式会社ですとか、あるいは経済産業省も含めて...直接私も出向いて御相談をし、アドバイスも頂戴をしてきた"@ja.
<< kg:id_179 prop:countermeasure kg:id_182 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_147;
    prop:text-txt_contents "県知事にもお話をさせていただきましたし、一緒に地元として...県と一緒にその存続に向けた動きを取らせていただいた"@ja.
<< kg:id_179 prop:effect kg:id_183 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_148;
    prop:text-txt_contents "他県の発電所の発電量を増やしたり、あるいは他の地域から電力を融通するといった形で供給するだろう"@ja.
<< kg:id_184 prop:countermeasure kg:id_185 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_149;
    prop:text-txt_contents "平成７年に...太陽の家という施設で太陽光発電を取り入れました"@ja.
<< kg:id_184 prop:countermeasure kg:id_186 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_150;
    prop:text-txt_contents "平成12年には上田コミュニティ防災センターでも太陽光発電を取り入れています"@ja.
<< kg:id_184 prop:countermeasure kg:id_187 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_151;
    prop:text-txt_contents "平成14年からごみ焼却の余熱を利用して発電に取り組んでおりまして、現在も自家消費を除く余剰電力を売電しております"@ja.
<< kg:id_184 prop:countermeasure kg:id_188 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_152;
    prop:text-txt_contents "平成16年に風力発電施設建設ガイドラインを酒田市としては策定"@ja.
<< kg:id_184 prop:countermeasure kg:id_189 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_153;
    prop:text-txt_contents "昨年４月からは...十里塚風力発電所の運転を開始しております"@ja.
<< kg:id_184 prop:countermeasure kg:id_190 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_154;
    prop:text-txt_contents "下水道汚泥の分解過程で発生する消化ガスを利用して発電"@ja.
<< kg:id_184 prop:countermeasure kg:id_191 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_155;
    prop:text-txt_contents "海外から輸入する木質ペレットなどを燃料とする50メガワットのバイオマス発電所が稼働"@ja.
<< kg:id_184 prop:countermeasure kg:id_192 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_156;
    prop:text-txt_contents "酒田北港地区では約28メガワットの太陽光発電所も稼働中"@ja.
<< kg:id_184 prop:countermeasure kg:id_193 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_157;
    prop:text-txt_contents "花王株式会社では、酒田工場にグループ最大規模となる自家消費型の太陽光発電設備を設置"@ja.
<< kg:id_184 prop:countermeasure kg:id_194 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_158;
    prop:text-txt_contents "日向川土地改良区が管理・運営します小水力発電所が平成30年より稼働"@ja.
<< kg:id_184 prop:countermeasure kg:id_195 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_159;
    prop:text-txt_contents "畜産系バイオマス、牛のふん尿を利用したバイオガス発電設備を併設"@ja.
<< kg:id_196 prop:effect kg:id_197 >>
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_160;
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_161;
    prop:text-txt_contents "約69億円を域外に流出している"@ja.
<< kg:id_198 prop:effect kg:id_199 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_162;
    prop:text-txt_contents "本市は逆に約56億円が流入をしているまち"@ja.
<< kg:id_200 prop:countermeasure kg:id_201 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_163;
    prop:stateBy kg:st_14;
    prop:relatedOpinion kg:op_164;
    prop:text-txt_contents "公民連携という形でこういったところと連携をして、何か前に進む道を模索するということは可能"@ja.
<< kg:id_202 prop:cause kg:id_203 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_165;
    prop:text-txt_contents "安定的かつ長期にわたって電力の調達先や顧客を確保することが、これも大前提"@ja.
<< kg:id_202 prop:cause kg:id_204 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_166;
    prop:text-txt_contents "需給バランスが逼迫をして、電力の市場価格が高騰したことから破綻した新電力会社があった"@ja.
<< kg:id_205 prop:cause kg:id_206 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_167;
    prop:text-txt_contents "化石燃料への対応ということと、我が国の産業形成に係るエネルギー確保...これをどう両立させるかというのは非常に大きな問題"@ja.
<< kg:id_205 prop:cause kg:id_207 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_168;
    prop:text-txt_contents "ロシアによるウクライナ侵攻に伴うこの経済的な混乱の影響"@ja.
<< kg:id_208 prop:countermeasure kg:id_209 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_169;
    prop:text-txt_contents "地球温暖化対策実行計画の区域施策編という計画の策定に向けて、今検討を進めている"@ja.
<< kg:id_208 prop:countermeasure kg:id_210 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_170;
    prop:text-txt_contents "酒田港カーボンニュートラルポート形成方針の素案をまとめた"@ja.
<< kg:id_211 prop:countermeasure kg:id_212 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_171;
    prop:text-txt_contents "国の環境保全型農業直接支払交付金を活用しながら"@ja.
<< kg:id_211 prop:countermeasure kg:id_213 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_172;
    prop:text-txt_contents "炭素貯留効果の高い有機農業を実施していた場合は、10アール当たり１万4,000円の交付金"@ja.
<< kg:id_211 prop:countermeasure kg:id_214 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_173;
    prop:text-txt_contents "バイオ炭...将来的にはこういった取組は大切だと考えております"@ja.
<< kg:id_211 prop:countermeasure kg:id_215 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_174;
    prop:text-txt_contents "木骨ハウス...将来的にはこういった取組は大切だと考えております"@ja.
<< kg:id_211 prop:countermeasure kg:id_216 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_175;
    prop:text-txt_contents "生分解性鮮度保持包装...将来的にはこういった取組は大切だと考えております"@ja.
<< kg:id_217 prop:effect kg:id_218 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_176;
    prop:text-txt_contents "作物の販売収入に加えて、売電収入や電力の自家利用による農業経営の改善がやはり期待される"@ja.
<< kg:id_219 prop:cause kg:id_220 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_177;
    prop:text-txt_contents "生産される農作物の収穫量は、地域の平均的な収量からおおむね２割を下回らないというようなことが求められている"@ja.
<< kg:id_219 prop:cause kg:id_221 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_178;
    prop:text-txt_contents "固定価格が年々下がってきておりまして、安定的な収益性の確保がやはり困難"@ja.
<< kg:id_219 prop:cause kg:id_222 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_179;
    prop:text-txt_contents "資材の耐久性など設備・構造上の問題"@ja.
<< kg:id_219 prop:cause kg:id_223 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_180;
    prop:text-txt_contents "営農者と売電事業者が異なる場合など経営展望が不明確"@ja.
<< kg:id_224 prop:countermeasure kg:id_225 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_181;
    prop:text-txt_contents "地域版Ｊ－クレジットではなくて、Ｊ－クレジット制度の中でプロジェクトの一形態として"@ja.
<< kg:id_226 prop:cause kg:id_227 >>
    prop:stateBy kg:st_15;
    prop:relatedOpinion kg:op_182;
    prop:text-txt_contents "専門的な知識を持つ人材の確保ですとか、運営経費などの課題"@ja.
}
