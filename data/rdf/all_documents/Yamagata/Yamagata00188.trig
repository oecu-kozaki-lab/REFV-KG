kg:st_1 rdfs:label "江口暢子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "被災状況の把握と犠牲者への哀悼を述べる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "大きな災害への警戒を促す"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "犠牲者にお悔やみを述べる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "本市でも強い揺れがあり不安が広がったと受け止める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "多くの市民が不安な夜を過ごしたとみる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "行政と関係者の対応に感謝する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "行政と関係者の対応に感謝する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "正常性バイアスが防災意識を弱めていると懸念する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "改めて哀悼の意を示す"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_2 rdfs:label "日本防災士会会長室崎益輝先生"@ja.
kg:st_2 rdf:type cls:st_37.
cls:st_37 rdfs:label "専門家"@ja.
kg:op_10 prop:content "地域コミュニティ力が市民行動に発揮されたと評価する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "地域コミュニティ力が市民行動に発揮されたと評価する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "地域コミュニティ力が市民行動に発揮されたと評価する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "被災者の希望を反映した配置が有効だったとみる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "仮設住宅の配置が地域コミュニティ維持につながったと評価する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "共助が復興を支えたと評価する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "災害で最も重要な共助が発揮されたと評価する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "風化への強い危機感を示す"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "防災の継承が必要だと訴える"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:st_3 rdfs:label "白崎映美さん"@ja.
kg:st_3 rdf:type cls:st_117.
cls:st_117 rdfs:label "被災者"@ja.
kg:op_19 prop:content "支援への恩返しとして今度は自分が応援すると語る"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "酒田大火で受けた支援への恩返しとして共助が表れたと評価する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:st_4 rdfs:label "那須欣男総務部危機管理監"@ja.
kg:st_4 rdf:type cls:st_32.
cls:st_32 rdfs:label "行政職員"@ja.
kg:op_21 prop:content "大火の教訓を受けて消防力強化を進めてきたと説明する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "消防力の増強を進めてきたと説明する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "大火の経験から防御戦術を見直したと説明する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "従来の隊形を改め火災防御態勢を強化したと説明する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "大量放水戦術へと強化したと説明する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "大規模災害時の迅速な消防力増強のため整備したと説明する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "今でも風の強い日に出火防止を呼びかけていると説明する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "燃えにくいまちづくりを進めてきたと説明する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "災害に強いまちづくりを進めてきたと説明する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "延焼拡大の原因だったと説明する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "防火防災対策強化のため採用したと説明する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "まちづくりの中で消防水利を増設したと説明する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_4.
kg:op_33 prop:content "各地区の防災力向上を図っていると説明する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "地域の防災力向上のため訓練を実施していると説明する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "毎年防火の誓いを新たにする取組だと説明する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "事前周知を強化して防災意識向上につなげるべきと求める"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "学校教育の中で酒田大火を取り上げていると説明する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "学校教育の中で酒田大火を取り上げていると説明する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "教育委員会作成のハンドブックで学習していると説明する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "見学者に当時の災害状況を説明していると述べる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "資料館でも資料の常設展示を行っていると説明する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:op_42 prop:content "大火の記憶を風化させず防災意識を高めるため継続展示したいと述べる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:st_5 rdfs:label "池田里枝教育次長"@ja.
kg:st_5 rdf:type cls:st_32.
kg:op_43 prop:content "新文化資料館でも常設展示として整備する方向で準備すると述べる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:op_44 prop:content "危機管理規程はあるが避難誘導マニュアルにはなっていないと認める"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:op_45 prop:content "早急な改定が必要だと求める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "交流観光課が災害対応マニュアルとなるよう支援していると説明する"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "各施設の規程改定を支援指導していると説明する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_4.
kg:op_48 prop:content "イベントでも災害時対応を実施していると説明する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_4.
kg:op_49 prop:content "イベントでも安全確認を行っていると説明する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "観光施設に災害情報を掲示する仕組みを整えていると説明する"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_4.
kg:op_51 prop:content "災害時に一斉共有する連携体制がないことを課題に挙げる"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:op_52 prop:content "多言語対応が課題だと認識する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_4.
kg:op_53 prop:content "危機管理課が自主避難を促す動画を作成していると説明する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_4.
kg:op_54 prop:content "外国人にも周知できるよう上映予定だと説明する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_4.
kg:op_55 prop:content "乗客向けに多言語掲示の取組を行ってきたと説明する"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_4.
kg:op_56 prop:content "各施設対応の平準化と情報共有連携体制構築に有効だと評価する"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_4.
kg:op_57 prop:content "DMO設立の好機に策定を進めるべきと期待する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:st_6 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_6 rdf:type cls:st_32.
kg:op_58 prop:content "手引書を参考に準備を進めたいと述べる"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_6.
kg:op_59 prop:content "観光客と観光事業者の不安払拭へ策定準備を進めると述べる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_4.
kg:op_60 prop:content "観光施設や事業者との連携強化へ勉強会も検討すると述べる"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_4.
kg:op_61 prop:content "道路損壊や家屋倒壊で到達困難があると説明する"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_4.
kg:op_62 prop:content "車利用は緊急車両の妨げになると警戒する"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:op_63 prop:content "リスクの周知をもっと進めるべきと求める"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_1.
kg:op_64 prop:content "避難所での受入れにも限界があると説明する"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_4.
kg:op_65 prop:content "長時間滞在による健康リスクを指摘する"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_4.
kg:op_66 prop:content "食料等支援が届かない恐れがあると説明する"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_4.
kg:op_67 prop:content "様々な弊害があるため推奨しないと明言する"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_4.
kg:op_68 prop:content "病気などやむを得ない事情には配慮が必要と述べる"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_4.
kg:op_69 prop:content "令和2年6月に全庁的項目を策定したと説明する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_4.
kg:op_70 prop:content "各部課長が実態に合わせて詳細要領を作成していると説明する"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_4.
kg:op_71 prop:content "年間を通した優先業務を定めていると説明する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_4.
kg:op_72 prop:content "欠員時の役割分担を定めていると説明する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_4.
kg:op_73 prop:content "密を避ける勤務方法も要領に記していると説明する"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_4.
kg:op_74 prop:content "現状に即した計画修正が必要だと判断する根拠とする"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_4.
kg:op_75 prop:content "業務継続計画の修正が必要だと述べる"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_4.
kg:op_76 prop:content "対策を積み上げ確実に実行していく考えを示す"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_4.
kg:op_77 prop:content "業務継続のため部局横断で要員確保を進めると述べる"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_4.
kg:op_78 prop:content "感染予防の徹底も計画修正内容に含めると述べる"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_4.
kg:op_79 prop:content "風化しているのではないかという市民の声を受け止める"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_1.
kg:op_80 prop:content "LINEやSNSでの事前周知を検討すると答える"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_4.
kg:op_81 prop:content "確実に情報を知らせるため活用を検討する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_4.
kg:op_82 prop:content "災害復興資料や研究論文の収集を求める"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_1.
kg:op_83 prop:content "新しい館での合流を踏まえ検討すると答える"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_5.
kg:op_84 prop:content "避難誘導マニュアルの改定を早急に対応すると述べる"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_6.
kg:op_85 prop:content "期限なく継続は問題であり急ぐべきと求める"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_1.
kg:op_86 prop:content "対応すべきであり速やかに配備できるようにしたいと述べる"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_6.
kg:op_87 prop:content "早急な配備を求める"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_1.
kg:op_88 prop:content "完全無償化には恒久財源が必要で実現は難しいと説明する"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_5.
kg:op_89 prop:content "第3子のみ無償化にも公平性の課題があると説明する"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_5.
kg:op_90 prop:content "経済的事情が主な未収事由だと説明する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_5.
kg:op_91 prop:content "経済的不安定が未収事由だと説明する"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_5.
kg:op_92 prop:content "自営業不振も未収の要因だと説明する"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_5.
kg:op_93 prop:content "コロナ禍の経済低迷も要因に含むと説明する"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_5.
kg:op_94 prop:content "一部に納付意識の欠如もあると報告する"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_5.
kg:op_95 prop:content "一部に金銭管理意識の欠如もあると報告する"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_5.
kg:st_7 rdfs:label "白畑真由美健康福祉部長"@ja.
kg:st_7 rdf:type cls:st_32.
kg:op_96 prop:content "財政状況を踏まえた検討が必要と説明する"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_7.
kg:op_97 prop:content "保険者等の財政への影響を懸念する"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_7.
kg:st_8 rdfs:label "斎藤周議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_98 prop:content "無料化を過剰受診と結び付ける考えに立つべきではないと求める"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_8.
kg:op_99 prop:content "遠隔地や地方中核都市が移転候補になっていると分析を紹介する"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_6.
kg:op_100 prop:content "創業地や既存拠点への移転が多く新規進出型は少ないと説明する"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_6.
kg:op_101 prop:content "今年度の立地事例を積み重ねたいと述べる"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_6.
kg:op_102 prop:content "市内企業との関係性も高めながら成長を支えたいと述べる"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_6.
kg:op_103 prop:content "サテライトオフィス整備支援事業などを活用し最大限支援すると述べる"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_6.
kg:st_9 rdfs:label "鈴木和仁教育長"@ja.
kg:st_9 rdf:type cls:st_51.
cls:st_51 rdfs:label "教育関係者"@ja.
kg:op_104 prop:content "中学校教員の長時間勤務の特に大きな要因だと説明する"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_9.
kg:st_10 rdfs:label "齋藤一志教育次長"@ja.
kg:st_10 rdf:type cls:st_51.
kg:op_105 prop:content "2月に部活動停止で80時間超が減少し要因は部活動だと述べる"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_10.
kg:op_106 prop:content "保護者との連絡が夕方以降となり時間外勤務につながると説明する"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_9.
kg:op_107 prop:content "部活動の在り方を検討していると述べる"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_9.
kg:op_108 prop:content "大型地域スポーツクラブや体育協会と意見交換を進めていると説明する"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_10.
kg:op_109 prop:content "保護者の理解を求めながら改善を図る必要があると述べる"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_9.
kg:op_110 prop:content "家庭との連携が重要な課題だと認識する"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_9.
kg:op_111 prop:content "安全管理の大きな柱として整備改善に努めていると説明する"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_9.
kg:op_112 prop:content "専門家の助言を得ながら各校マニュアルを改善していると説明する"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_9.
kg:op_113 prop:content "1人1台端末を前提に防災教育を進める取組だと説明する"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_9.
kg:op_114 prop:content "作ることがゴールではなく常に改善が大事だと述べる"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_9.
kg:op_115 prop:content "豪雨時の経験を踏まえ改善したと説明する"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_10.
kg:op_116 prop:content "自分の命を自分で守る力を育てることが大事だと述べる"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_10.
kg:st_11 rdfs:label "竹越攻征総務部長"@ja.
kg:st_11 rdf:type cls:st_32.
kg:op_117 prop:content "削減ありきでなく業務量に応じた検討が必要と述べる"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_11.
kg:op_118 prop:content "定量的分析で必要職員数を検討する視点が必要と述べる"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_11.
kg:op_119 prop:content "令和5年度から令和13年度にかけ段階的に引き上げると説明する"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_11.
kg:op_120 prop:content "当面の措置として示されていると説明する"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_11.
kg:op_121 prop:content "役職定年制が制度設計のキーポイントだと述べる"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_11.
kg:op_122 prop:content "時代のニーズに合致し実績が大きく伸びたと説明する"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_11.
kg:op_123 prop:content "介護事業所派遣が新たな経営の柱になったと説明する"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_11.
kg:op_124 prop:content "学童保育所派遣も新たな経営の柱になったと説明する"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_11.
kg:op_125 prop:content "会員と事業者を結ぶ職員が重要な要だと評価する"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_11.
kg:op_126 prop:content "自助努力と会員事務局の頑張りを高く評価し引き続き支援すると述べる"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_7.
kg:st_12 rdfs:label "宮崎和幸企画部長"@ja.
kg:st_12 rdf:type cls:st_32.
kg:op_127 prop:content "構成市町とともに大きな課題として検討が必要と述べる"@ja.
kg:op_127 rdf:type cls:opinion.
kg:op_127 prop:speaker kg:st_12.
kg:op_128 prop:content "ごみ排出量削減が課題だと説明する"@ja.
kg:op_128 rdf:type cls:opinion.
kg:op_128 prop:speaker kg:st_12.
kg:op_129 prop:content "延命化のために必要だと説明する"@ja.
kg:op_129 rdf:type cls:opinion.
kg:op_129 prop:speaker kg:st_12.
kg:op_130 prop:content "ごみ排出量削減と延命化のため必要だと述べる"@ja.
kg:op_130 rdf:type cls:opinion.
kg:op_130 prop:speaker kg:st_12.
kg:op_131 prop:content "観光公共交通人材育成などで役割が大きくなるとみる"@ja.
kg:op_131 rdf:type cls:opinion.
kg:op_131 prop:speaker kg:st_12.
kg:op_132 prop:content "国に財政支援の拡大を引き続き求めたいと述べる"@ja.
kg:op_132 rdf:type cls:opinion.
kg:op_132 prop:speaker kg:st_12.
kg:op_133 prop:content "本市が中心市として役割を果たしていきたいと述べる"@ja.
kg:op_133 rdf:type cls:opinion.
kg:op_133 prop:speaker kg:st_12.
kg:op_134 prop:content "人口減少下では広域で取り組むことが重要な鍵になると述べる"@ja.
kg:op_134 rdf:type cls:opinion.
kg:op_134 prop:speaker kg:st_12.
kg:op_135 prop:content "詳細な協議を来年度以降行いたいと述べる"@ja.
kg:op_135 rdf:type cls:opinion.
kg:op_135 prop:speaker kg:st_12.
kg:st_13 rdfs:label "本間義紀企画部デジタル変革調整監"@ja.
kg:st_13 rdf:type cls:st_32.
kg:op_136 prop:content "電子カルテやマイナポータル連携も含めて検討していると説明する"@ja.
kg:op_136 rdf:type cls:opinion.
kg:op_136 prop:speaker kg:st_13.
kg:op_137 prop:content "実現にはまだ多くのシステム導入課題があると説明する"@ja.
kg:op_137 rdf:type cls:opinion.
kg:op_137 prop:speaker kg:st_13.
kg:op_138 prop:content "完全に自宅だけで診療処方が完結するものではないと述べる"@ja.
kg:op_138 rdf:type cls:opinion.
kg:op_138 prop:speaker kg:st_13.
kg:op_139 prop:content "酒田市のPHRでもマイナポータル連携を考えていると説明する"@ja.
kg:op_139 rdf:type cls:opinion.
kg:op_139 prop:speaker kg:st_13.
kg:op_140 prop:content "体重変化などの異常時に注意機能を出し健康行動変容につなげたいと述べる"@ja.
kg:op_140 rdf:type cls:opinion.
kg:op_140 prop:speaker kg:st_13.
