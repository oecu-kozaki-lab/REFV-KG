kg:st_1 rdfs:label "市原栄子議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "影響見込額と国の全額補填の有無を明らかにすべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "国が全額補填するか確認が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "新年度予算に光熱費高騰分を見込むべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "委託費増加をどのように予算化したか示すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "矢口明子市長"@ja.
kg:st_2 rdf:type cls:st_29.
cls:st_29 rdfs:label "首長"@ja.
kg:op_5 prop:content "人口減少を前提に施策と予算を組み立てるべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "人口減少下でも安心して暮らせるまちづくりを進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "将来必要な事業に影響しないよう見直しも必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "必要事業は実行しつつ5年間総額は抑制する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "基金残高を維持しながら必要事業を進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "市民活動費が削減された経緯を明らかにすべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "協力体制や公平性を見直した上で持続可能な事業を計上した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "多様な人材が活躍できる雇用支援が必要"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "障がい者や高齢者の就業機会拡大を支援する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "障がい者雇用を継続すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "買物弱者対策の新年度方針を示すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "配送・移動販売・移送の情報を整理して周知する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "地域の実情を把握し相談しながら施策を展開する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "若者の声を直接聴く新たな仕組みが必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "テーマ当事者の若者と意見交換し市政に反映する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "行政改革はコストカットではなく行政機能の改善"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:st_3 rdfs:label "田中廣議員"@ja.
kg:st_3 rdf:type cls:st_16.
kg:op_21 prop:content "過去2番目の規模となった要因を明らかにすべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "基金依存が残ることへの所見と基金運用の考え方を示すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "公共施設と事業の見直しは引き続き必須"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "工事期間や観光動線への影響を明らかにすべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "樹木医の助言を受け順次実施する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "制度内容と対象団体、狙いを明確にすべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "市主導で具体的な説明と周知を進めるべき"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "理解醸成を進めた上で住民説明会につなげる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "法定協議会等で具体化した段階で住民説明会を行う"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "子育て世代への情報発信内容と目標組数を明確にすべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "働くことや再就職の不安解消につなげる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "事業内容と酒田DMOとの役割分担を明確にすべき"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "何を目的にし地域理解をどう得るのか明確にすべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "繁殖を抑え頭数を減らし地域猫活動につなげる"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "長期的に頭数を減らし地域管理を進める必要がある"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "中心市街地限定の理由と公平性を説明すべき"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "防火力向上を目的に補助金を割増しする"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "交通政策顧問の役割と効果を明らかにすべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "根本的な公共交通の在り方を助言してもらう"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "農村RMOの目的と活動内容を明確にすべき"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "地域主体で農用地保全と生活支援を進める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "公共機関集約のまちづくり方向性を示すべき"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "昼間人口を増やし中心市街地をトータルでデザインする"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "公共施設解体の考え方を明確にすべき"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "あるものを生かす発想で活用を進める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_2.
kg:st_4 rdfs:label "市村浩一議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_46 prop:content "本市への設置を粘り強く求め経済効果も検証すべき"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:op_47 prop:content "庄内に他にない施設として本市整備を要望する"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_2.
kg:op_48 prop:content "完成まで時間を要するため暫定利用を検討する"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "役割分担と課題を明確にすべき"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "行政とDMOの役割は分けられている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
kg:st_5 rdfs:label "進藤晃議員"@ja.
kg:st_5 rdf:type cls:st_16.
kg:op_51 prop:content "市長1期目の予算編成の特徴と考え方を明らかにすべき"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_5.
kg:op_52 prop:content "構成メンバーや時期や目的を具体化すべき"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_5.
kg:op_53 prop:content "シビックプライドを高める広報広聴改革が必要"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_2.
kg:op_54 prop:content "市民がまちを知り関わり発信する好循環をつくる"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_2.
kg:op_55 prop:content "導入後の学習指導の変化を明らかにすべき"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_5.
kg:op_56 prop:content "規模や資金調達や選定方法を明確にすべき"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_5.
kg:op_57 prop:content "活動目的と期待効果を明確にすべき"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_5.
kg:op_58 prop:content "企業支援と人材育成を一体で進めるべき"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_5.
kg:op_59 prop:content "立地実現性の高い情報サービス業を重点支援する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "持続可能な農業施策を具体化すべき"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_5.
kg:op_61 prop:content "安定した品質と収量を確保できる土づくりと備えを進める"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "持続可能な水産業施策を示すべき"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_5.
kg:op_63 prop:content "乗組員支援や資材支援を継続する"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_2.
kg:op_64 prop:content "魚価単価向上と付加価値創出を目指す"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_2.
kg:op_65 prop:content "福祉総合相談窓口での情報共有と支援連携を明確にすべき"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_5.
kg:op_66 prop:content "令和6年度から試行し適切な支援につなげる"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_2.
kg:op_67 prop:content "設置目的と支援体制を明確にすべき"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_5.
kg:op_68 prop:content "男女共同参画の取組を強化すべき"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_5.
kg:op_69 prop:content "市民参加型で家事シェアを強力に推し進める"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_2.
kg:op_70 prop:content "新しい婚活支援の経緯と方法を明確にすべき"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_5.
kg:op_71 prop:content "内面重視で参加しやすい新しい婚活スタイルを広域で実施する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_2.
kg:op_72 prop:content "具体的な活動内容を明確にすべき"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_5.
kg:st_6 rdfs:label "佐藤弘議員"@ja.
kg:st_6 rdf:type cls:st_16.
kg:op_73 prop:content "人口減少下でのまちの姿を具体化すべき"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_6.
kg:op_74 prop:content "人口減少時代を前提に全分野で仕組みを考え直す"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_2.
kg:op_75 prop:content "ウェルビーイングの姿と進め方を明らかにすべき"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_6.
kg:op_76 prop:content "庄内全域で考える施策の考え方を明確にすべき"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_6.
kg:op_77 prop:content "本市にしかないものを大切に磨き上げる"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_2.
kg:op_78 prop:content "公立化に向けた具体的取組を進めるべき"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_6.
kg:op_79 prop:content "庄内2市3町が協力して早期公立化を進める"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_2.
kg:op_80 prop:content "全中学校区を見据えた新しい学校づくりの青写真を示すべき"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_6.
kg:op_81 prop:content "他中学校区でも義務教育学校スタイルを含め検討する"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_2.
kg:op_82 prop:content "教育福祉部門の連携強化に活用すべき"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_6.
kg:op_83 prop:content "学校や家庭への同行支援など丁寧な支援を行う"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_2.
kg:op_84 prop:content "保護者の意見を聞き実現可能な対応を急ぐべき"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_6.
kg:op_85 prop:content "ワークショップやアンケート等で保護者意見を把握する"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_2.
kg:st_7 rdfs:label "後藤泉議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_86 prop:content "人口減少を前提にした施策の矢口カラーをさらに示すべき"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_7.
kg:op_87 prop:content "日本一女性が働きやすいまちへ向けた施策を強めるべき"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_7.
kg:op_88 prop:content "女性にこれ以上頑張らせず自然体で両立できる地域にする"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_2.
kg:op_89 prop:content "寄附金頼みにならない財源確保戦略が必要"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_7.
kg:op_90 prop:content "複数の財源確保策を強化する"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "減収額は、令和５年度分課税実績を基に、調定ベースで約３億9,000万円と積算をしております。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "この減収分につきましては、地方特例交付金によって国庫より補填されます。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "減収分は全額補填されるため、市の財政への影響はないものと想定しております。"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "学校、福祉施設、図書館、文化施設など自治体の施設の光熱費高騰への対策を図るため一般行政経費を400億円計上し"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "ごみ収集、学校給食等の自治体のサービス・施設管理等の委託料の増額への対応として、新たに一般行政経費を300億円計上し"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:text-txt_contents "令和６年度予算は令和５年度当初予算と比較し、燃料費及び光熱水費で約1,500万円"@ja.
<< kg:id_5 prop:effect kg:id_9 >>
    prop:text-txt_contents "施設管理委託料で約6,390万円の増額となっております。"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "その柱として様々な政策課題の根本原因である人口減少問題に取り組む"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "人口の減少を抑制しながら、たとえ人口が減少したとしても豊かに安心して暮らせるまちをつくる"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "市債発行額は34億5,790万円となっており、２年連続での30億円超えであります"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "令和５年度から令和９年度までの５年間の発行総額は150億円以内に抑えられる見込みとなっております。"@ja.
<< kg:id_14 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "財政調整基金についても、引き続き30億円を維持できる見込みとなっております。"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "コロナ禍で実行できなかった事業等について、検証という理由で総合支所管内の事業など、市民活動への予算が大幅に削減されました。"@ja.
<< kg:id_20 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "これらのものについて、持続可能な事業として令和６年度予算に計上した"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "企業等の多くから人手不足だという声が聞こえております。"@ja.
<< kg:id_22 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "障がい者や高齢者の雇用をちゅうちょしていた企業が採用を考慮できるよう後押しするようなセミナーを実施したい"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "これらの取組により、10名の障がい者を雇用することができました。"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "地元商店やスーパーなどの撤退、廃業による買物難民の問題が顕著化しています。"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "買物支援サービスに関する情報を市ホームページに掲載することを予定しております。"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "このホームページの概要をワンペーパーにまとめたリーフレットの作成も進めております。...地域の実情を把握した上で地域と相談しながら施策の展開を行ってまいります。"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "これまでの広聴では、若者の声を聴き、市政に反映していく機会が少ないという課題があった"@ja.
<< kg:id_32 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "新たな取組として、特定のテーマを設けて、そのテーマの当事者である若い方々と私が意見を交わし、その声を市政に反映していく若者カフェミーティングを実施することといたしました。"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "行政改革は、コストカットではなくて、市民生活の向上、地域課題の解決という究極の目的を達成するために、行政が適切に機能するように日々の行政の仕組みを変えていくことだと考えております。"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "ふるさと納税寄附金歳入見込みを令和５年度当初予算の30億円から、令和６年度当初予算40億円に増加したこと"@ja.
<< kg:id_37 prop:cause kg:id_39 >>
    prop:text-txt_contents "定年延長に伴う退職手当などの人件費の増"@ja.
<< kg:id_37 prop:cause kg:id_40 >>
    prop:text-txt_contents "光熱水費や物価高騰の影響を受けた委託料、維持補修費、修繕費などの増"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "基金依存の財政体質が改善されたとは言い難く"@ja.
<< kg:id_41 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "引き続き公共施設の在り方や事業の見直しは必須になると考えております。"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "養生期間の約２年の間は、木製のバリケードの設置による立入禁止区域を設けます。"@ja.
<< kg:id_44 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "そこに対して剪定や土壌改良などを行う予定であります。"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "市民の自由な発想と意思に基づいた文化芸術活動を支援することで...アートプロジェクト活動支援補助金制度を創設いたしたいと思います。"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "市民への説明、周知が足りていないのではないかと考えております。"@ja.
<< kg:id_49 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "地球沸騰化対策の必要性と、その施策として再生可能エネルギーへの期待を啓発するセミナー、２つ目として、主力電源化の切り札として期待される洋上風力発電についての勉強会を複数回開催し"@ja.
<< kg:id_49 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "より具体的な話ができるようなったときに、洋上風力発電の住民説明会につなげていく流れを想定しております。"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "親子移住体験ツアーは...本市で暮らすイメージを持てるような機会にしたい"@ja.
<< kg:id_53 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "企業や企業人との出会いを盛り込んでおりまして...本市で働く、再就職するといった不安を解消したい"@ja.
<< kg:id_53 prop:countermeasure kg:id_56 >>
    prop:text-txt_contents "参加家族の半数、つまり５家族が子どもの小学校入学時までに移住することを事業の成果目標にしたいと思います。"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "観光施設等の課題解決に知恵を出し合うことで、本市への観光客増加や地域活性化につなげることを期待したい"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "野良猫の繁殖抑制を進めることを主目的としております。"@ja.
<< kg:id_59 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "市内全域において、ＴＮＲ活動を行う団体に補助を行うものであり、１団体75万円で２団体を予定しております。"@ja.
<< kg:id_62 prop:effect kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "必ずしも野良猫によるふんのトラブルなどがすぐに減るものではないが"@ja.
<< kg:id_64 prop:cause kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "住宅が密集しておりまして、郊外と比較して老朽化した家屋が多く存在しております。"@ja.
<< kg:id_64 prop:effect kg:id_66 >>
    prop:text-txt_contents "延焼しやすく大火につながるおそれがあります"@ja.
<< kg:id_64 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "空き家の解体を進めることで、地域の防火力の向上を図ることを目的に補助金を割増しして支援する"@ja.
<< kg:id_68 prop:effect kg:id_69 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "高校生、それから、観光客などの利便性向上は十分に達成できなかったと感じております。"@ja.
<< kg:id_68 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "東北公益文科大学学長の神田直弥氏に交通政策顧問に就任していただくことを考えております。"@ja.
<< kg:id_71 prop:cause kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "中山間地は、平野部と比べて人口減少や高齢化が著しく、買物や子育て、生活の足や祭りといった、日々暮らし続けていくための課題が大きくなっております。"@ja.
<< kg:id_71 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "農村ＲＭＯとは...協議会を設立しまして、集落機能の補完をしつつ、農用地の保全、地域資源の活用といった経済活動と併せて、生活支援等の地域コミュニティの維持を行う"@ja.
<< kg:id_74 prop:effect kg:id_75 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "中心市街地の人口は市全体の平均よりも人口減少が進んでいる状況にあります。"@ja.
<< kg:id_74 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "昼間人口を増やすための就業場所として、公共機関の集約をはじめ、デジタル関連企業等民間事業者の誘致なども進めまして、官民連携したまちづくりの検討を進め"@ja.
<< kg:id_77 prop:cause kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "施設を単に解体する場合、一般財源、もしくは交付税措置のない起債、つまり単なる借金でしか解体費に充てることができません。"@ja.
<< kg:id_77 prop:countermeasure kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "あるものを生かすという発想で進めていきたい...売却可能な施設として掲載しております。...借りたい方へ貸付けするなどしております。"@ja.
<< kg:id_80 prop:effect kg:id_81 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "スワンスケートリンクは、県内唯一の屋内スケートリンクとして"@ja.
<< kg:id_80 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "屋内スケート施設の整備については、引き続き山形県に要望していきたいと思います。"@ja.
<< kg:id_80 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "利用されていない既存の公共施設あるいは民間施設を利用した低コストの仮設スケートリンクの整備が可能かどうかを検討しているところであります。"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "行政でもＤＭＯと同じような事業を進めていては、予算も二重にかかるわけであります"@ja.
<< kg:id_84 prop:countermeasure kg:id_86 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "酒田ＤＭＯは...観光コンテンツの企画開発...プロモーション活動...一方で行政は、観光地、観光施設の整備...施設の管理・運営などを担っている"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "４つの重点的な取組に沿って予算づけをしたつもりだというのが特徴"@ja.
<< kg:id_89 prop:countermeasure kg:id_90 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "具体的なテーマを設定して意見交換を行っております。"@ja.
<< kg:id_91 prop:effect kg:id_92 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "まちづくりを「自分事」とする市民を増やすことを目標としましたが、未達成という成果になりまして"@ja.
<< kg:id_91 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "シティプロモーションの視点を取り入れたい...シビックプライドを高めるプロモーション"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "プログラミング学習ソフトＱＵＲＥＯは...基礎・基本から高校卒業レベルまでのプログラミングについて学習することができる"@ja.
<< kg:id_96 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "若い世代が主体性を持ち、地域課題解決や地域活性化の取組、市民自らやりたいことができる社会を実現することを目的としております。"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "渋谷キューズを拠点に職員を配置し、酒田市として首都圏において外貨を稼ぐための市外需要の掘り起こしを目的とする活動"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "本市の大きな課題である生産年齢人口の減少、特に若年層の流出を抑える有効な施策として位置づけている"@ja.
<< kg:id_100 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "情報サービス業の市外企業が中心市街地の賃貸物件に立地する場合...現行の３年から５か年に拡充する"@ja.
<< kg:id_103 prop:effect kg:id_104 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "昨年の猛暑等の異常気象への対応といった課題を抱えております。"@ja.
<< kg:id_103 prop:countermeasure kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "農業版ＢＣＰの作成や高温・凍霜等に対応できる附帯設備の導入等への支援を予定しております。"@ja.
<< kg:id_106 prop:effect kg:id_107 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "スルメイカの漁獲量は１月末で約335トン...昨年度比で漁獲量は42％"@ja.
<< kg:id_106 prop:countermeasure kg:id_108 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "県外のイカ釣り船の誘致に向け、乗組員の生活支援として酒田産つや姫の提供やイカを入れる箱の購入等への支援を行っており、これを令和６年度も継続していきます。"@ja.
<< kg:id_106 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "活イカの出荷・流通体制の確立を目指してまいります。"@ja.
<< kg:id_110 prop:cause kg:id_111 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "従来のように高齢者や障がいを持つ人など、分野ごとに縦割りの枠組みでは対応が難しい状況"@ja.
<< kg:id_110 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "庁内連携シート...多機関連携シートを使い、情報連携するよう...令和６年度から試行し、情報共有・連携を図って適切な支援につなげたい"@ja.
<< kg:id_113 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "専門の相談支援員を配置するセンターを開設することで、より一層の充実を図る"@ja.
<< kg:id_115 prop:effect kg:id_116 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "家事育児等の家庭内ケア労働に費やす時間は女性のほうが長くなっております。"@ja.
<< kg:id_115 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "夏休みの時期を家事シェア推進月間と設定をいたしまして、市民参加型の家事シェアチェック宣言を実施し"@ja.
<< kg:id_118 prop:cause kg:id_119 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "従来の婚活イベントでは、特に女性の参加者が少ないという課題"@ja.
<< kg:id_118 prop:countermeasure kg:id_120 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "メタバース婚活を先駆けて実施した庄内町から、従来の対面型イベントよりも参加申込者が多く、マッチング率も高かった"@ja.
<< kg:id_121 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "ローカルＳＤＧｓ推進室の目的は、地方自治体が担える気候変動への適応、循環型経済社会の構築、地域経済の活性化の３つの重なり合うプロジェクトの実施に向けた具体的な検討"@ja.
<< kg:id_123 prop:effect kg:id_124 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "人口減少したとしても、安心して地域コミュニティで暮らせる仕組みを整える"@ja.
<< kg:id_123 prop:countermeasure kg:id_125 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "21世紀の武器でありますデジタル技術を大いに活用できないだろうか、あるいは７つの中学校区をエリアとするスクール・コミュニティ"@ja.
<< kg:id_126 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "私の考える市民の幸せとは、市民一人一人が自身の望む選択をしながら人生を送ることができるということ"@ja.
<< kg:id_128 prop:cause kg:id_129 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "施設整備につきましては、人口が減少する時代、例えば５つの自治体で同じものを造っていては、もう財政がもたない。"@ja.
<< kg:id_128 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "施設の配置については「庄内全域で考える」ということを徹底する"@ja.
<< kg:id_131 prop:effect kg:id_132 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "少子化のスピードが...東北公益文科大学の存続にも影響します。"@ja.
<< kg:id_131 prop:countermeasure kg:id_133 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "早期の公立化に向けて庄内２市３町が協力して準備を進めていきたい"@ja.
<< kg:id_134 prop:effect kg:id_135 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "児童生徒数が減少の一途をたどっていることから、適正な学校規模を維持していくためにも、将来的にある程度の学校統合は避けられない"@ja.
<< kg:id_134 prop:countermeasure kg:id_136 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "他の中学校区においても義務教育学校というスタイルも選択肢の一つとして子どもたちの教育環境の在り方を考えなければならない"@ja.
<< kg:id_137 prop:cause kg:id_138 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "スクールソーシャルワーカーの人数が限られていたため、きめ細かい対応をすることが難しい状況にありました。"@ja.
<< kg:id_137 prop:countermeasure kg:id_139 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "令和６年度の増員により...より丁寧に寄り添った支援が行えるようになる"@ja.
<< kg:id_140 prop:effect kg:id_141 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "財政状況を踏まえ、市単独での建設は大変厳しい状況にあることから、新しく建設することは考えておりません。"@ja.
<< kg:id_142 prop:countermeasure kg:id_143 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "既存の施設の活用を含め、施設の在り方、整備の在り方を検討している段階であります。保護者等の意見を伺う手法としては、ワークショップやアンケートなどがあります。"@ja.
<< kg:id_12 prop:cause kg:id_144 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "人口減少ということが様々な地域課題の根底にあると位置づけまして"@ja.
<< kg:id_145 prop:cause kg:id_146 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "地方やこの地域に根強く存在している伝統的な性別役割分担意識をなくし、日本一女性が働きやすいまち"@ja.
<< kg:id_145 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "家事の分担を女性だけではなく男性も共に担う風土をこの地域に根づかせていくことですとか、あるいは長時間労働の是正"@ja.
<< kg:id_148 prop:effect kg:id_149 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "国の政策動向次第と自治体間競争などを考えると、少々リスクも伴ってくるのではないか"@ja.
<< kg:id_148 prop:countermeasure kg:id_150 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "魅力的な返礼品の開発をさらに強化し...ネーミングライツ...未利用財産の売払いにも力を入れてまいります。"@ja.
}
