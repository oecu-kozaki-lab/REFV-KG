kg:st_1 rdfs:label "佐藤博幸議員"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "議員"@ja.
kg:op_1 prop:content "2040年を見据えた戦略ビジョンの策定が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "将来の厳しい行財政運営を懸念"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "歳入減を見据えた財政運営が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "歳出増への備えが必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "将来の危機意識を持って取り組むべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "行政サービス低下を防ぐ必要がある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "財政健全化は手段だが重要な基盤"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "未来の姿と道筋を示す戦略ビジョンを策定すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "高齢化に応じた行政運営の見直しが必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "担い手確保は今後の大きな課題"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "需要と供給の変化に適応した行政運営が必要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "従来の延長ではなく一段高い行政経営に取り組むべき"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "厳しい財政状況を前提に運営すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "未来へつなぐ財政運営が求められる"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "必要な投資のため資源配分を強化すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "歳入歳出の両面から基盤を強化すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "将来世代に過度な負担を残すべきでない"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "優先度を明確にした戦略的投入が必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "これまで以上に財政マネジメントを強化すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "行政だけで解決する時代ではない"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "多様な主体との連携・協働が望ましい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:st_2 rdfs:label "企画部長 上野修"@ja.
kg:st_2 rdf:type cls:st_18.
cls:st_18 rdfs:label "部長"@ja.
kg:op_22 prop:content "2040年問題への対応が必要"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "高齢者人口ピークへの備えが必要"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "社会問題への総合的な対応が必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "限られた人員と財源の下での対応が問われる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "質の高い行政サービスを提供できる組織体制が重要"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "事務事業の効率化や見直しが喫緊の課題"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "業務効率化を急ぐ必要がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "定型業務の効率化を進めている"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "今後重要な取組である"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "長期的な視野に立った施策が必要"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "直面する課題は減らない"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "行政の業務範囲を見極める必要がある"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "業務効率化を進めるべき"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "市民サービスの在り方を見直す時期"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "丁寧に説明しながら進める必要がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "多様な主体の活躍が重要"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "連携・協働関係の構築が重要"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "地域住民が主体的に取り組む仕組みづくりが必要"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "今後も継続して推進したい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "新しい協働の在り方を創造し続ける必要がある"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "市民参画を促す仕組み整備に努める"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:st_3 rdfs:label "総務部長 森屋健一"@ja.
kg:st_3 rdf:type cls:st_18.
kg:op_43 prop:content "財政状況の動向を的確に把握し健全な財政運営を続ける必要がある"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "今後の財政負担への対応が必要"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "当面公債費が大きな財政負担となる"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "財政需要への対応を計画的に進める必要がある"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "必要な対応を検討・実施する指針として活用している"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "着実に減少傾向が続く見込み"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "将来の公債費負担の軽減に努めている"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "今後の投資事業で重要になる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "必要に応じて基金を活用する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "財政規律の保持に努める"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "歳入規模に見合った歳出構造の実現を目指す"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "歳入確保に関する取組が重要"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "新たな財源の確保に努める"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "企業誘致等により増収につなげたい"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:op_57 prop:content "法人市民税や固定資産税等の増収につなげる"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_3.
kg:op_58 prop:content "事務事業の不断の見直しを進める"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_3.
kg:op_59 prop:content "新規・拡充財源は既存事業見直しで確保する"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_3.
kg:st_4 rdfs:label "本間信一議員"@ja.
kg:st_4 rdf:type cls:st_16.
kg:op_60 prop:content "危険な暑さへの対策強化が必要"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_4.
kg:op_61 prop:content "幅広い年代への注意喚起が必要"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_4.
kg:op_62 prop:content "高齢者対策を特に強化すべき"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_4.
kg:op_63 prop:content "エアコン使用の周知が重要"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_4.
kg:op_64 prop:content "死亡防止の取組が必要"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_4.
kg:st_5 rdfs:label "健康福祉部長 佐藤繁義"@ja.
kg:st_5 rdf:type cls:st_18.
kg:op_65 prop:content "急遽の対策として涼み処を設置した"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_5.
kg:op_66 prop:content "老人クラブやサロンなどで予防啓発を行った"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_5.
kg:op_67 prop:content "ホームページで周知してきた"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_5.
kg:op_68 prop:content "アラート発表時に改めて注意喚起した"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_5.
kg:op_69 prop:content "猛暑からの避難場所として開放した"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_5.
kg:op_70 prop:content "独り暮らし高齢者へ重点的に働きかけた"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_5.
kg:op_71 prop:content "高齢者宅訪問時に注意喚起を依頼した"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_5.
kg:op_72 prop:content "直接高齢者へ予防を呼びかけた"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_5.
kg:op_73 prop:content "各地域庁舎でも周知を行った"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_5.
kg:op_74 prop:content "暑い時期の活動内容や方法に注意を促した"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_5.
kg:op_75 prop:content "熱中症対策としても有効な手段ではないか"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_4.
kg:op_76 prop:content "急病や事故時の適切な対応で不安解消を図る事業"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_5.
kg:op_77 prop:content "住み慣れた地域で安心した生活を支援する"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_5.
kg:st_6 rdfs:label "農山漁村振興課長 高橋修也"@ja.
kg:st_6 rdf:type cls:st_95.
cls:st_95 rdfs:label "課長"@ja.
kg:op_78 prop:content "地籍調査未実施地域では境界明確化が課題"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_6.
kg:op_79 prop:content "今年度から境界明確化の準備作業に当たる"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_6.
kg:op_80 prop:content "調査完了森林から整備につなげる"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_6.
kg:st_7 rdfs:label "遠藤初子議員"@ja.
kg:st_7 rdf:type cls:st_16.
kg:op_81 prop:content "里山林の管理課題への対応が必要"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_7.
kg:op_82 prop:content "管理の担い手不足が問題"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_7.
kg:op_83 prop:content "今後の在り方の検討が進んでいる"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_7.
kg:op_84 prop:content "維持管理が難しくなっていることを課題と認識"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_6.
kg:op_85 prop:content "黄金地区で林道沿いの森林整備を実施している"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_6.
kg:op_86 prop:content "里山林の管理は鳥獣被害対策としても重要"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_7.
kg:op_87 prop:content "緩衝帯整備も可能な事業を活用している"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_6.
kg:op_88 prop:content "将来にわたり維持管理される体制が必要"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_6.
kg:op_89 prop:content "里山林整備支援を検討したい"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_6.
kg:op_90 prop:content "今後の被害拡大を危惧している"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_6.
kg:op_91 prop:content "今後の被害拡大が懸念される"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_6.
kg:op_92 prop:content "捕獲駆除だけでは個体数減少に至っていない"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_6.
kg:op_93 prop:content "わなの見回り負担や猟友会の高齢化が課題"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_6.
kg:op_94 prop:content "庁内連携でパトロールや広報活動を強化した"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_6.
kg:op_95 prop:content "関係部署と連携して対応した"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_6.
kg:op_96 prop:content "特に有効な対策とされている"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_6.
kg:op_97 prop:content "総合的な実施が重要"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_6.
kg:op_98 prop:content "3つの取組を総合的に実施することが重要"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_6.
kg:op_99 prop:content "初期費用負担軽減のため制度を設けている"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_6.
kg:op_100 prop:content "積極的に活用してほしい"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_6.
kg:op_101 prop:content "有効活用の検討が必要"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_6.
kg:op_102 prop:content "加工場が少ない理由の一つ"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_6.
kg:op_103 prop:content "市場供給が進みにくい"@ja.
kg:op_103 rdf:type cls:opinion.
kg:op_103 prop:speaker kg:st_6.
kg:op_104 prop:content "市場供給の課題となっている"@ja.
kg:op_104 rdf:type cls:opinion.
kg:op_104 prop:speaker kg:st_6.
kg:op_105 prop:content "有効活用に向けて情報収集に努める"@ja.
kg:op_105 rdf:type cls:opinion.
kg:op_105 prop:speaker kg:st_6.
kg:st_8 rdfs:label "草島進一議員"@ja.
kg:st_8 rdf:type cls:st_16.
kg:op_106 prop:content "トイレ環境の悪さが利用者減少の一因ではないか"@ja.
kg:op_106 rdf:type cls:opinion.
kg:op_106 prop:speaker kg:st_8.
kg:op_107 prop:content "全面改修が必要"@ja.
kg:op_107 rdf:type cls:opinion.
kg:op_107 prop:speaker kg:st_8.
kg:op_108 prop:content "利用実態に見合った改善が必要"@ja.
kg:op_108 rdf:type cls:opinion.
kg:op_108 prop:speaker kg:st_8.
kg:op_109 prop:content "温水シャワーと更衣室を備えた施設にすべき"@ja.
kg:op_109 rdf:type cls:opinion.
kg:op_109 prop:speaker kg:st_8.
kg:st_9 rdfs:label "商工観光部長 阿部知弘"@ja.
kg:st_9 rdf:type cls:st_18.
kg:op_110 prop:content "北側トイレは早急な全面改築は難しいが洋式化が必要"@ja.
kg:op_110 rdf:type cls:opinion.
kg:op_110 prop:speaker kg:st_9.
kg:op_111 prop:content "県と連携して改修を協議したい"@ja.
kg:op_111 rdf:type cls:opinion.
kg:op_111 prop:speaker kg:st_9.
kg:st_10 rdfs:label "市民部長 伊藤慶也"@ja.
kg:st_10 rdf:type cls:st_18.
kg:op_112 prop:content "重大な事案として受け止めている"@ja.
kg:op_112 rdf:type cls:opinion.
kg:op_112 prop:speaker kg:st_10.
kg:op_113 prop:content "大変遺憾であり速やかな報告を強く求めた"@ja.
kg:op_113 rdf:type cls:opinion.
kg:op_113 prop:speaker kg:st_10.
kg:op_114 prop:content "今後は死因調査結果も含め速やかな報告を求める"@ja.
kg:op_114 rdf:type cls:opinion.
kg:op_114 prop:speaker kg:st_10.
kg:op_115 prop:content "早急な原因究明が必要"@ja.
kg:op_115 rdf:type cls:opinion.
kg:op_115 prop:speaker kg:st_10.
kg:op_116 prop:content "早急な原因究明を要望している"@ja.
kg:op_116 rdf:type cls:opinion.
kg:op_116 prop:speaker kg:st_10.
kg:op_117 prop:content "追加的な環境保全措置とともに意見していく"@ja.
kg:op_117 rdf:type cls:opinion.
kg:op_117 prop:speaker kg:st_10.
kg:op_118 prop:content "重大な影響や懸念事項には強く意見する"@ja.
kg:op_118 rdf:type cls:opinion.
kg:op_118 prop:speaker kg:st_10.
kg:op_119 prop:content "専門家の意見も伺いながら対応する"@ja.
kg:op_119 rdf:type cls:opinion.
kg:op_119 prop:speaker kg:st_10.
kg:op_120 prop:content "住民から懸念の声があった"@ja.
kg:op_120 rdf:type cls:opinion.
kg:op_120 prop:speaker kg:st_10.
kg:op_121 prop:content "住民相談時には法に基づき対応する"@ja.
kg:op_121 rdf:type cls:opinion.
kg:op_121 prop:speaker kg:st_10.
kg:op_122 prop:content "国に明確な基準値等がないため対応が難しい"@ja.
kg:op_122 rdf:type cls:opinion.
kg:op_122 prop:speaker kg:st_10.
kg:op_123 prop:content "今後の国の指針を見ながら対応する"@ja.
kg:op_123 rdf:type cls:opinion.
kg:op_123 prop:speaker kg:st_10.
kg:op_124 prop:content "国の動向を注視しながら検討したい"@ja.
kg:op_124 rdf:type cls:opinion.
kg:op_124 prop:speaker kg:st_10.
kg:op_125 prop:content "円滑な管理運営を担うことが困難となっている"@ja.
kg:op_125 rdf:type cls:opinion.
kg:op_125 prop:speaker kg:st_9.
kg:op_126 prop:content "市が管理運営を引き継ぐ"@ja.
kg:op_126 rdf:type cls:opinion.
kg:op_126 prop:speaker kg:st_9.
kg:op_127 prop:content "食文化・観光情報発信拠点としての機能充実に努める"@ja.
kg:op_127 rdf:type cls:opinion.
kg:op_127 prop:speaker kg:st_9.
kg:op_128 prop:content "運営会社及び連帯保証人に適切に請求する"@ja.
kg:op_128 rdf:type cls:opinion.
kg:op_128 prop:speaker kg:st_9.
kg:op_129 prop:content "需要見通しに甘さがあったと認識している"@ja.
kg:op_129 rdf:type cls:opinion.
kg:op_129 prop:speaker kg:st_9.
kg:op_130 prop:content "フロアの魅力を高める努力を続ける"@ja.
kg:op_130 rdf:type cls:opinion.
kg:op_130 prop:speaker kg:st_9.
kg:op_131 prop:content "これまで誘客促進に取り組んできた"@ja.
kg:op_131 rdf:type cls:opinion.
kg:op_131 prop:speaker kg:st_9.
kg:op_132 prop:content "合理的な説明が可能な範囲で経費負担を実施してきた"@ja.
kg:op_132 rdf:type cls:opinion.
kg:op_132 prop:speaker kg:st_9.
kg:op_133 prop:content "厳格に評価された結果と認識"@ja.
kg:op_133 rdf:type cls:opinion.
kg:op_133 prop:speaker kg:st_9.
kg:op_134 prop:content "コロナ前から未達だった点が評価に影響した"@ja.
kg:op_134 rdf:type cls:opinion.
kg:op_134 prop:speaker kg:st_9.
kg:op_135 prop:content "市内観光周遊ルート紹介を進めている"@ja.
kg:op_135 rdf:type cls:opinion.
kg:op_135 prop:speaker kg:st_9.
kg:op_136 prop:content "誘客促進に取り組む"@ja.
kg:op_136 rdf:type cls:opinion.
kg:op_136 prop:speaker kg:st_9.
kg:op_137 prop:content "本市への誘客促進に取り組む"@ja.
kg:op_137 rdf:type cls:opinion.
kg:op_137 prop:speaker kg:st_9.
kg:st_11 rdfs:label "農政課長 伊藤弘治"@ja.
kg:st_11 rdf:type cls:st_95.
kg:op_138 prop:content "白山以降の品種で大きな影響が出ている"@ja.
kg:op_138 rdf:type cls:opinion.
kg:op_138 prop:speaker kg:st_11.
kg:op_139 prop:content "適期に収穫し切れない事例が出た"@ja.
kg:op_139 rdf:type cls:opinion.
kg:op_139 prop:speaker kg:st_11.
kg:op_140 prop:content "品質低下が見られる"@ja.
kg:op_140 rdf:type cls:opinion.
kg:op_140 prop:speaker kg:st_11.
kg:op_141 prop:content "収量減が見込まれる"@ja.
kg:op_141 rdf:type cls:opinion.
kg:op_141 prop:speaker kg:st_11.
kg:op_142 prop:content "かん水の行き届かない圃場で影響が生じた"@ja.
kg:op_142 rdf:type cls:opinion.
kg:op_142 prop:speaker kg:st_11.
kg:op_143 prop:content "品質面での影響が出ている"@ja.
kg:op_143 rdf:type cls:opinion.
kg:op_143 prop:speaker kg:st_11.
kg:op_144 prop:content "収穫後の品質悪化が懸念される"@ja.
kg:op_144 rdf:type cls:opinion.
kg:op_144 prop:speaker kg:st_11.
kg:op_145 prop:content "最新情報を把握共有し必要な対策を検討する"@ja.
kg:op_145 rdf:type cls:opinion.
kg:op_145 prop:speaker kg:st_11.
kg:st_12 rdfs:label "建設部長 坂井正則"@ja.
kg:st_12 rdf:type cls:st_18.
kg:op_146 prop:content "子供の遊び場確保の施策の一つとして必要"@ja.
kg:op_146 rdf:type cls:opinion.
kg:op_146 prop:speaker kg:st_12.
kg:op_147 prop:content "広く意見を聞きながら進める"@ja.
kg:op_147 rdf:type cls:opinion.
kg:op_147 prop:speaker kg:st_12.
kg:op_148 prop:content "多くの市民が利用できる施設を目指し官民連携の在り方を検討する"@ja.
kg:op_148 rdf:type cls:opinion.
kg:op_148 prop:speaker kg:st_5.
kg:op_149 prop:content "地域主体の取組への支援の在り方を検討したい"@ja.
kg:op_149 rdf:type cls:opinion.
kg:op_149 prop:speaker kg:st_5.
kg:st_13 rdfs:label "中沢深雪議員"@ja.
kg:st_13 rdf:type cls:st_16.
kg:op_150 prop:content "安定した財源確保の見通しが必要"@ja.
kg:op_150 rdf:type cls:opinion.
kg:op_150 prop:speaker kg:st_13.
kg:op_151 prop:content "無償化財源の一つとして増収に取り組む"@ja.
kg:op_151 rdf:type cls:opinion.
kg:op_151 prop:speaker kg:st_3.
kg:op_152 prop:content "若手職員が子育て施策への提言や政策立案を行う"@ja.
kg:op_152 rdf:type cls:opinion.
kg:op_152 prop:speaker kg:st_2.
kg:op_153 prop:content "若者や子育て世代に選ばれるまちづくりを推進する"@ja.
kg:op_153 rdf:type cls:opinion.
kg:op_153 prop:speaker kg:st_2.
kg:op_154 prop:content "公益的機能の維持と木材生産拡大に努める"@ja.
kg:op_154 rdf:type cls:opinion.
kg:op_154 prop:speaker kg:st_6.
kg:op_155 prop:content "手入れが行き届いていない森林を所有者と林業事業体につなぐ"@ja.
kg:op_155 rdf:type cls:opinion.
kg:op_155 prop:speaker kg:st_6.
kg:op_156 prop:content "木材生産の拡大を図る"@ja.
kg:op_156 rdf:type cls:opinion.
kg:op_156 prop:speaker kg:st_6.
kg:op_157 prop:content "森林解析や境界明確化に活用する"@ja.
kg:op_157 rdf:type cls:opinion.
kg:op_157 prop:speaker kg:st_6.
kg:op_158 prop:content "担い手育成支援を進める"@ja.
kg:op_158 rdf:type cls:opinion.
kg:op_158 prop:speaker kg:st_6.
kg:op_159 prop:content "新規就業支援を行う"@ja.
kg:op_159 rdf:type cls:opinion.
kg:op_159 prop:speaker kg:st_6.
kg:op_160 prop:content "地籍調査未了地域で進める"@ja.
kg:op_160 rdf:type cls:opinion.
kg:op_160 prop:speaker kg:st_6.
