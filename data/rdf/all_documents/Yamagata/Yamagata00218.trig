    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "人口減少や少子高齢社会の急速な進行により経済が縮小し、税収等が減少する"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "人口減少や少子高齢社会の急速な進行により経済が縮小し"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "人口減少や少子高齢社会の急速な進行により経済が縮小し、税収等が減少する"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "社会保障関係費等の支出の増加が見込まれ"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "本市の行財政運営は、より厳しい状況に陥ることが懸念されます"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "財政状況の悪化は、それに伴う行政サービス等の低下につながり"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本市の行財政運営に支障を来すおそれがあります"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "2040年を見据えたグランドデザイン、未来の姿を描き、その道筋を示す戦略ビジョンを策定する必要がある"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "高齢者人口の増加は、医療・介護給付・生活支援などのニーズを高める"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "人口減少は日常生活や事業のために必要な担い手を確保することが難しくなる"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "行政サービスの需要と供給の両面において大きな変化をもたらすことが予測されます"@ja.
<< kg:id_15 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "これまでの行政運営の在り方を改めて見直し、これらの変化に適応したものへとデザインし直す必要があります"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "人口減少・少子高齢化の急速な進行により、市税収入の大幅な増加が見通せない状況"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "厳しい財政状況が見込まれる中"@ja.
<< kg:id_18 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "必要な投資を行うためには、経営資源の効果的・効率的な配分を行い"@ja.
<< kg:id_18 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "歳入歳出両面からの財政基盤強化の取組"@ja.
<< kg:id_18 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "将来世代に過度な負担を強いることのないように、市債残高の縮減"@ja.
<< kg:id_18 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "総合的な視点から政策の優先度を明らかにするとともに、戦略的な行政資源の投入を進めていけるよう"@ja.
<< kg:id_18 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "これまで以上に財政運営に対するマネジメント力を強化して、未来へつないでいくことが求められます"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "市民の課題やニーズは多様化・複雑化しており、これまでの画一的なサービスや手続重視、労働集約的な手法では、行政が全てを把握して解決することは難しくなっております"@ja.
<< kg:id_26 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "市民・企業・ＮＰＯ・地域団体等の多様な主体と一緒になって考え、共に取り組むことが望ましい"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "2040年問題とは、少子化による急速な人口減少と"@ja.
<< kg:id_29 prop:cause kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "団塊ジュニア世代が65歳以上の高齢者になることで、高齢者人口がピークを迎える2040年頃に"@ja.
<< kg:id_29 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "日本社会が直面すると予想されている様々な社会問題の総称"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "労働人口の減少が懸念される中"@ja.
<< kg:id_33 prop:effect kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "限られた人員と財源の下で市政の課題や多様化・複雑化する市民ニーズへ対応した行政サービスをいかに提供できるかが問われております"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "社会経済情勢の変化や災害の増加、行政への多岐にわたる要望等により職員の事務量は増加傾向にありまして"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "事務事業の効率化や事業の見直しが喫緊の課題となっている"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "定型業務の効率化を図るため、ＲＰＡの導入などＡＩ等のデジタル技術の活用を進めている"@ja.
<< kg:id_39 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "事務事業を効率化し、より質の高い行政サービスを提供し得る組織体制の構築、これが今後重要となっております"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "人口減少・少子高齢社会の進行に伴い、とりわけ担い手の確保・育成、これはあらゆる分野に共通する課題"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "人口減少や高齢化への対応とともに、インフラ・公共施設の更新需要などが増加する"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "職員が担うべき業務の範囲を見直し"@ja.
<< kg:id_46 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "業務の自動化・効率化を図る"@ja.
<< kg:id_46 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "市民サービスの在り方も検討する時期が来ている"@ja.
<< kg:id_46 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "行政と市民の役割分担や協働する部分を明確にするとともに、市民の皆様に丁寧に説明しながら、行政運営を進める必要がある"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "人口が減少し、高齢化が進む中におきまして、市民生活を守り、地域課題を解決していくためには、行政だけではサービス提供を行うことは難しく"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "多様化する市民ニーズに適切に対応するには、市民・ＮＰＯ・企業など多様な主体に活躍していただくとともに、互いに連携・協働する関係を築くことが重要"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "人口減少・少子高齢化・価値観の多様化などに伴い、文化の継承や災害、福祉の担い手不足など、地域の抱える課題が複雑かつ多様化している"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "地域住民同士がまずは課題を共有しまして、自ら考え、ビジョンを描き、地域と行政の連携・協働の下に、地域住民が主体的に取り組む仕組みづくりを今後も継続して推進してまいりたい"@ja.
<< kg:id_59 prop:effect kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "人口減少や少子高齢化の急速な進行という、これまでに経験したことのない社会情勢におきまして、これまでと同様な公共サービスの提供は難しくなる"@ja.
<< kg:id_59 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "多様な主体と行政との新しい協働の在り方、これを創造し続けなければならない"@ja.
<< kg:id_13 prop:effect kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "今後人口減少により、税収の大幅な増加が見込めない"@ja.
<< kg:id_63 prop:effect kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "高齢化の進展による社会保障関係経費の増加"@ja.
<< kg:id_65 prop:effect kg:id_66 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "過去の大型投資事業に係る公債費の高止まりが続く"@ja.
<< kg:id_67 prop:effect kg:id_68 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "原油価格・物価高騰や給与水準の上昇、公共施設の老朽化などにも適切に対応していく必要があります"@ja.
<< kg:id_69 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "必要な対応を検討・実施するための指針として、令和３年度から鶴岡市中期財政見通しを作成し"@ja.
<< kg:id_69 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "市債残高は着実に減少傾向が続くものと見込んでおります"@ja.
<< kg:id_69 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "基金の積立てと市債の繰上償還を行っているところであり"@ja.
<< kg:id_69 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "国・県等の補助事業の活用や過疎債・辺地債・緊急防災・減災事業債などの有利な地方債制度の活用がますます重要"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "必要に応じ、合併特例期間中から備えてきた減債基金や公共施設整備基金等の活用"@ja.
<< kg:id_73 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "中期財政見通しや公共施設等総合管理計画などによる計画的な対応"@ja.
<< kg:id_73 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "事務事業の見直し徹底などにより、歳入の規模に見合った歳出構造を実現すべく"@ja.
<< kg:id_69 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "企業版を含めたふるさと寄附金のさらなる増収を図る"@ja.
<< kg:id_69 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "その他の税外収入につきましても新たな財源の確保・創出に努めてまいります"@ja.
<< kg:id_79 prop:effect kg:id_80 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "人口減少や高齢化による就業人口の減少による市税の減少"@ja.
<< kg:id_79 prop:countermeasure kg:id_81 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "新産業団地などへの企業誘致等により産業の振興を図り、法人市民税や固定資産税のほか、雇用者の増加による個人市民税の増収にもつなげてまいります"@ja.
<< kg:id_69 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "行政評価手法による進捗管理の下、施策の優先度を見極め、予算編成時に限らず、事務事業の不断の見直しを進めてまいります"@ja.
<< kg:id_69 prop:countermeasure kg:id_83 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "新たな取組や拡充する取組のための財源につきましては、事業のスクラップ・アンド・ビルドを基本とし"@ja.
<< kg:id_84 prop:effect kg:id_85 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "熱中症で救急搬送された人数も調査開始以来、２番目に多い"@ja.
<< kg:id_84 prop:effect kg:id_86 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "小さなお子様から小・中学生、部活動中の子供たち、外で働いておられる成人や住居内で具合の悪くなる高齢者まで、幅広い年代で熱中症の症状を訴え、搬送されるケースが後を絶たない"@ja.
<< kg:id_84 prop:effect kg:id_87 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "年代別では65歳以上の高齢者が約６割を占めている"@ja.
<< kg:id_84 prop:cause kg:id_88 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "高齢者を中心にエアコンを使わず、体のしびれなどで搬送されるケースが目立つ"@ja.
<< kg:id_84 prop:effect kg:id_89 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "熱中症で死亡する数が年々増加しています"@ja.
<< kg:id_84 prop:cause kg:id_90 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "今年は例年より厳しい暑さが続いたことから、急遽の対策ということで、猛暑からの避難場所として涼み処を設置"@ja.
<< kg:id_84 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "各地域の老人クラブ、サロンや健康教室などで保健師による熱中症予防啓発"@ja.
<< kg:id_84 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "市のホームページにより注意喚起をしてまいりました"@ja.
<< kg:id_84 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "ライン、フェイスブック、子育てアプリ母子モにおいて改めて注意喚起を行っております"@ja.
<< kg:id_84 prop:countermeasure kg:id_94 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "総合保健福祉センターにこふる、荘銀タクト鶴岡、図書館及び各地区のコミュニティセンターなど公共施設46か所を開放"@ja.
<< kg:id_84 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "民生委員にお願いしまして、見守り活動で御自宅を訪問する際に、熱中症への注意を呼びかけていただく"@ja.
<< kg:id_84 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "地域包括支援センター・居宅介護支援事業所にも地域で行う介護予防講座や高齢者宅へ訪問する際に、注意喚起の働きかけをしていただくようにお願い"@ja.
<< kg:id_84 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "直接高齢者の方に熱中症予防のリーフレットをお渡しし、説明をして、御注意いただくようにお願い"@ja.
<< kg:id_84 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "各地域庁舎でもケーブルテレビや防災無線による呼びかけを行い"@ja.
<< kg:id_84 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "百歳体操をはじめとした介護予防に取り組んでいる活動団体にも運動の中止や活動時間を短縮するなど、暑い時期の活動内容や方法について注意喚起"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "安否確認や緊急時の対応を図るための通報、双方向の会話ができる通信機器"@ja.
<< kg:id_100 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "緊急通報装置のボタンを押すだけで24時間、365日のコールセンターにつながりまして"@ja.
<< kg:id_100 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "その他健康に関する相談対応、定期的な安否確認といったことも行っております"@ja.
<< kg:id_104 prop:cause kg:id_105 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "森林経営管理制度を進める上で重要となる山林の境界明確化が、地籍調査が未実施の鶴岡・温海地域で完了していないこと"@ja.
<< kg:id_104 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "航空レーザー測量の森林解析を活用し、今年度から境界明確化の準備作業に当たっていく予定"@ja.
<< kg:id_104 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "毎年１から２地区の意向調査を計画的に行いながら、調査を完了した森林から整備につなげる"@ja.
<< kg:id_108 prop:effect kg:id_109 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "近年は人口の減少や高齢化等々の問題もあり、管理が行き届かないという課題を抱えている地域もある"@ja.
<< kg:id_108 prop:cause kg:id_110 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "近年は人口の減少や高齢化等々の問題もあり"@ja.
<< kg:id_108 prop:effect kg:id_111 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "生産森林組合においては、今後の在り方について解散も含め、検討しているところもある"@ja.
<< kg:id_108 prop:effect kg:id_112 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "里山林の維持管理が難しくなってきていることは、森林保全の大きな課題と認識しております"@ja.
<< kg:id_108 prop:countermeasure kg:id_113 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "やまがた緑環境税を財源とした里山林整備事業を活用して、黄金地区、金峯周辺ですけれども、そちらの林道沿いの森林整備を平成30年度から実施"@ja.
<< kg:id_114 prop:effect kg:id_115 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "近年、鳥獣被害が増加している理由の一つとして、里山林の荒廃が挙げられる"@ja.
<< kg:id_114 prop:countermeasure kg:id_116 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "この事業は、野生動物とのすみ分けを図るための緩衝帯整備も実施することが可能"@ja.
<< kg:id_114 prop:countermeasure kg:id_117 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "整備後に効果が持続されるためには、将来にわたり維持管理されるよう、地域での管理体制の構築も必要"@ja.
<< kg:id_114 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_89;
    prop:text-txt_contents "里山林の整備に対する支援につきましては、森林環境譲与税の活用のほうも含めて検討してまいりたい"@ja.
<< kg:id_119 prop:effect kg:id_120 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "イノシシによる被害につきまして、平成28年度に羽黒・朝日・温海地域で農作物被害が確認されて以降、出没の範囲が拡大"@ja.
<< kg:id_119 prop:cause kg:id_121 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_91;
    prop:text-txt_contents "生息範囲が広がっていると認識しておりまして"@ja.
<< kg:id_119 prop:cause kg:id_122 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "イノシシの繁殖能力の高さに対しまして"@ja.
<< kg:id_119 prop:effect kg:id_123 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "わなの見回りに対する負担、また猟友会会員の高齢化などの問題があり、個体数の減少にまでは至っていない"@ja.
<< kg:id_124 prop:effect kg:id_125 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "特に今年度につきましては、市街地への出没が多く"@ja.
<< kg:id_124 prop:countermeasure kg:id_126 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "庁内の関係部署と連携をしながら、早朝あるいは夕方等々のパトロール、広報活動の強化に努めておりました"@ja.
<< kg:id_127 prop:countermeasure kg:id_128 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_96;
    prop:text-txt_contents "この中で特に有効とされているのが電気柵の設置です"@ja.
<< kg:id_127 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "野生動物を寄せつけないための放任果樹、あるいは農作物の残渣を撤去するといった環境の整備"@ja.
<< kg:id_127 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "猟友会による捕獲・駆除がありまして、この３つの取組を総合的に実施することが重要"@ja.
<< kg:id_131 prop:countermeasure kg:id_132 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "電気柵購入経費の最大２分の１を補助するという制度があります"@ja.
<< kg:id_133 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "今年度につきましては、家庭菜園など、農業者以外の自家消費用作物も対象に追加しております"@ja.
<< kg:id_135 prop:effect kg:id_136 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "捕獲後の処理が重労働であるとの意見もある"@ja.
<< kg:id_137 prop:cause kg:id_138 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "ジビエの食文化があまりないこと"@ja.
<< kg:id_137 prop:cause kg:id_139 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_103;
    prop:text-txt_contents "捕獲数量が増加傾向にあるものの、ほとんどが自家消費されていること"@ja.
<< kg:id_137 prop:cause kg:id_140 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_104;
    prop:text-txt_contents "野生動物の肉に出荷制限が設けられておりまして、ジビエとして市場に供給するためには、解体施設におきまして、放射性物質の全頭検査を行う必要がある"@ja.
<< kg:id_137 prop:countermeasure kg:id_141 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_105;
    prop:text-txt_contents "捕獲した野生動物の有効活用につきましては、県内を含めた周辺自治体の先進事例等の収集にも努めてまいりたい"@ja.
<< kg:id_142 prop:cause kg:id_143 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_106;
    prop:text-txt_contents "北側のトイレは、平成５年に市が建設し30年が経過"@ja.
<< kg:id_142 prop:effect kg:id_144 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_107;
    prop:text-txt_contents "男女とも和式の大便器しかなく、洋式は多目的トイレ１基のみ"@ja.
<< kg:id_142 prop:effect kg:id_145 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_108;
    prop:text-txt_contents "帰り際のピークにはトイレに女性が列をなしている"@ja.
<< kg:id_142 prop:effect kg:id_146 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_109;
    prop:text-txt_contents "シャワーは当初ありましたが、整備後早々に壊れ、長年使用不可"@ja.
<< kg:id_142 prop:countermeasure kg:id_147 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_110;
    prop:text-txt_contents "北側トイレについて、早急な全面改築は難しいと考えておるところでございますが、洋式化が必要と考えており、改修の検討を行ってまいります"@ja.
<< kg:id_142 prop:countermeasure kg:id_148 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_111;
    prop:text-txt_contents "県が整備いたしました南側のトイレにつきましては、今後県と改修の方向性について協議をしてまいりたい"@ja.
<< kg:id_149 prop:effect kg:id_150 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_112;
    prop:text-txt_contents "大変重大な事案と受け止めております"@ja.
<< kg:id_149 prop:cause kg:id_151 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_113;
    prop:text-txt_contents "事業者に対しまして速やかに報告がなかったことは大変遺憾"@ja.
<< kg:id_149 prop:countermeasure kg:id_152 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_114;
    prop:text-txt_contents "今後は死因調査の結果も含め、速やかに報告するよう強く意見している"@ja.
<< kg:id_149 prop:effect kg:id_153 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_115;
    prop:text-txt_contents "死因の調査が長引き、対策が講じられないと新たな衝突事案が発生する可能性も考えられます"@ja.
<< kg:id_149 prop:countermeasure kg:id_154 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_116;
    prop:text-txt_contents "早急に原因究明が行われるよう、東北地方環境事務所には要望している"@ja.
<< kg:id_155 prop:countermeasure kg:id_156 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_117;
    prop:text-txt_contents "バードストライクや天然記念物でありますコウモリ等のバットストライクの事後調査の回数や期間について、専門家の意見も伺いながらしっかりと意見してまいりたい"@ja.
<< kg:id_157 prop:effect kg:id_158 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_118;
    prop:text-txt_contents "既に配慮書の中で経済産業省や環境省より風力発電設備への衝突事故及び移動経路の阻害等による影響について指摘を受けております"@ja.
<< kg:id_157 prop:countermeasure kg:id_159 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_119;
    prop:text-txt_contents "今後のアセスの手続の中で重大な影響や懸念事項につきましては、さらに専門家などからの意見を伺い、強く意見してまいりたい"@ja.
<< kg:id_160 prop:effect kg:id_161 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_120;
    prop:text-txt_contents "将来にわたって風車騒音や健康被害、風車がもたらす精神的な負担や不安が懸念される"@ja.
<< kg:id_160 prop:countermeasure kg:id_162 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_121;
    prop:text-txt_contents "住民からの相談等を寄せられた際には、騒音規制法等に基づきまして調査を行い、基準値を超えている場合には原因者に対して法に基づき、改善を求めてまいります"@ja.
<< kg:id_163 prop:effect kg:id_164 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_122;
    prop:text-txt_contents "国においては現在のところ明確な基準値等が明示されていないということもございまして、現状といたしましては対応は難しい"@ja.
<< kg:id_163 prop:countermeasure kg:id_165 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_123;
    prop:text-txt_contents "今後の国が示す指針等にも注視しながら対応を検討してまいりたい"@ja.
<< kg:id_166 prop:countermeasure kg:id_167 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_124;
    prop:text-txt_contents "国の動向を注視しながら、風車の離隔距離を含め、本市のガイドラインの見直し等の必要性について検討してまいりたい"@ja.
<< kg:id_168 prop:cause kg:id_169 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_125;
    prop:text-txt_contents "運営会社は市への賃料等の支払いが滞るなど、本施設の円滑な管理運営を担うことが困難"@ja.
<< kg:id_168 prop:countermeasure kg:id_170 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_126;
    prop:text-txt_contents "市は運営会社との契約を終了し"@ja.
<< kg:id_168 prop:countermeasure kg:id_171 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_127;
    prop:text-txt_contents "当面施設の管理運営及びテナント入居契約を引き継ぎ、食文化・観光情報発信の拠点としての機能の充実に努めてまいります"@ja.
<< kg:id_168 prop:countermeasure kg:id_172 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_128;
    prop:text-txt_contents "未払い賃料等については、引き続き運営会社及び連帯保証人に請求し、適切に債権回収を進めてまいります"@ja.
<< kg:id_168 prop:effect kg:id_173 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_129;
    prop:text-txt_contents "行政と民間双方において商業ベースでの需要見通しの甘さがあったものと認識"@ja.
<< kg:id_168 prop:countermeasure kg:id_174 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_130;
    prop:text-txt_contents "空き区画については積極的にテナントを誘致し、フロアの魅力を高める努力を続けてまいります"@ja.
<< kg:id_175 prop:countermeasure kg:id_176 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_131;
    prop:text-txt_contents "観光案内所を開設し、これまで約８万7,000人への案内対応を行ってきたほか、つるおかお菓子フェスや国産生ハムフェスティバル等のイベント開催により"@ja.
<< kg:id_175 prop:countermeasure kg:id_177 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_132;
    prop:text-txt_contents "平成30年度より共益費の負担区分の見直しを行うなど、行政として合理的な説明が可能な範囲での経費負担"@ja.
<< kg:id_178 prop:effect kg:id_179 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_133;
    prop:text-txt_contents "総括評価において観光入込客数の項目が目標未達のため、不可の評価を受けました"@ja.
<< kg:id_178 prop:cause kg:id_180 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_134;
    prop:text-txt_contents "コロナ禍以前の平成30年度においても目標値に対し、達成率が97.5％という状況で下回った"@ja.
<< kg:id_181 prop:countermeasure kg:id_182 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_135;
    prop:text-txt_contents "３つの日本遺産の情報を一体的に伝え、各日本遺産を結ぶ市内観光周遊ルートを紹介するガイドブックの制作"@ja.
<< kg:id_181 prop:countermeasure kg:id_183 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_136;
    prop:text-txt_contents "観光プロモーションの実施などの取組を進めております"@ja.
<< kg:id_181 prop:countermeasure kg:id_184 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_137;
    prop:text-txt_contents "文化財を観光資源としてさらなる磨き上げを行い、魅力ある日本遺産ブランドの構築と本市への誘客促進に取り組んでまいります"@ja.
<< kg:id_185 prop:effect kg:id_186 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_138;
    prop:text-txt_contents "記録的な猛暑と乾燥の影響を受けて収穫適期が大幅に短くなった"@ja.
<< kg:id_185 prop:effect kg:id_187 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_139;
    prop:text-txt_contents "熟し過ぎて規格外品となったり、適期に収穫し切れなかったという事例が出ております"@ja.
<< kg:id_185 prop:effect kg:id_188 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_140;
    prop:text-txt_contents "高温により、さやの膨らんだ部分が変色する、いわゆる目玉症状や葉枯れが発生"@ja.
<< kg:id_185 prop:effect kg:id_189 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_141;
    prop:text-txt_contents "収量は前年を大きく下回るものと見込んでおります"@ja.
<< kg:id_185 prop:effect kg:id_190 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_142;
    prop:text-txt_contents "一部かん水の行き届かない圃場で稲が枯れるなどの影響が生じております"@ja.
<< kg:id_185 prop:effect kg:id_191 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_143;
    prop:text-txt_contents "高温により玄米の中心が白濁する心白が見られる"@ja.
<< kg:id_185 prop:effect kg:id_192 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_144;
    prop:text-txt_contents "胴割れの発生も懸念されております"@ja.
<< kg:id_193 prop:countermeasure kg:id_194 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_145;
    prop:text-txt_contents "第２回鶴岡市農作物高温対策本部会議を開催する予定でありまして、水稲や園芸作物等の最新の情報を把握・共有するとともに、ＪＡ、また農業技術普及課・土地改良区・農業委員会などの機関と協議しながら必要な対策を検討してまいります"@ja.
<< kg:id_195 prop:countermeasure kg:id_196 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_146;
    prop:text-txt_contents "子供の遊び場の確保の施策の一つとして、公園遊具の整備は必要と考えております"@ja.
<< kg:id_195 prop:countermeasure kg:id_197 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_147;
    prop:text-txt_contents "引き続き地元町内会や子育て世代などの声も広くお聞きしながら、遊具を含め、公園の遊び環境の整備を進めてまいりたい"@ja.
<< kg:id_195 prop:countermeasure kg:id_198 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_148;
    prop:text-txt_contents "ソライは、民間事業者ならではの発想でありますとか、フットワークということで事業展開をしておりますので、市といたしましてはその民間の力を生かしつつ、多くの市民から利用される施設を目指すべく、官民連携の在り方"@ja.
<< kg:id_199 prop:countermeasure kg:id_200 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_149;
    prop:text-txt_contents "コミュニティセンターや地域にある施設の一部を活用し、子供の遊び場や居場所をつくることは、多様な遊び場、集いの場の確保という意味でも有効"@ja.
<< kg:id_201 prop:countermeasure kg:id_202 >>
    prop:stateBy kg:st_13;
    prop:relatedOpinion kg:op_150;
    prop:text-txt_contents "ふるさと納税を財源として令和６年度以降も給食費の完全無償化を継続することを検討"@ja.
<< kg:id_201 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_151;
    prop:text-txt_contents "ふるさと寄附金につきましては、毎年度増収傾向が続いており、無償化の財源の一つとして、さらなる増収に取り組んでまいります"@ja.
<< kg:id_203 prop:countermeasure kg:id_204 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_152;
    prop:text-txt_contents "子育て施策への提言や、こどもまんなかの施策を立案していくため、20代・30代の若手職員12名が庁内横断的に結集しまして、今年７月に発足"@ja.
<< kg:id_203 prop:countermeasure kg:id_205 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_153;
    prop:text-txt_contents "今後はテーマに基づいたニーズ調査等を実施した上で、政策提言ができるよう進めていく予定"@ja.
<< kg:id_206 prop:countermeasure kg:id_207 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_154;
    prop:text-txt_contents "森林環境譲与税は、森林の有する公益的機能の維持・増進を目的に創設され、森林の整備、その促進に関する施策の財源"@ja.
<< kg:id_206 prop:countermeasure kg:id_104 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_155;
    prop:text-txt_contents "手入れが行き届いていない森林を市が仲介役となりながら、森林所有者・林業事業体をつなぐ新たな制度として創設されました森林経営管理制度の推進"@ja.
<< kg:id_206 prop:countermeasure kg:id_208 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_156;
    prop:text-txt_contents "林業事業体の間伐、再造林等の森林整備に対する支援などの木材生産の拡大の取組"@ja.
<< kg:id_206 prop:countermeasure kg:id_209 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_157;
    prop:text-txt_contents "県と共同で実施しております航空レーザー測量"@ja.
<< kg:id_206 prop:countermeasure kg:id_210 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_158;
    prop:text-txt_contents "林業事業体の体制強化につながる研修会の開催"@ja.
<< kg:id_206 prop:countermeasure kg:id_211 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_159;
    prop:text-txt_contents "新規就業の人たちの用具購入、資格取得支援などを行っていく予定です"@ja.
<< kg:id_206 prop:countermeasure kg:id_212 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_160;
    prop:text-txt_contents "森林の境界明確化の作業を、山林の地籍調査が終わっていない鶴岡・温海地域で実施していきたい"@ja.
}
