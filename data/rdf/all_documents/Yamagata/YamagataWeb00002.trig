    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "低周波音による健康被害や、風車建設に伴う水質汚濁・土砂災害への影響について住民の理解を得るよう求めている"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "説明が足りず不安は増すばかりだ」として、県民有志がきょう、計画の中止を知事に要請している"@ja.
<< kg:id_1 prop:cause kg:id_15 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "風力発電機の稼働に伴う風切り音や超低周波音が発生すること"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "低周波音の影響が生じるおそれがあり"@ja.
<< kg:id_1 prop:cause kg:id_17 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "事業地において、事業実施区域線に沿ってイヌワシの飛翔・低高度飛翔等が見評価上まり可能性が高い"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "バードストライクの発生及びその可能性が非常に高いこと"@ja.
<< kg:id_1 prop:effect kg:id_19 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "餌資源量が低下しているイヌワシにおいて採食能力低下による影響がある"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
