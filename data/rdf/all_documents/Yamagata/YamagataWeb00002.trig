    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "知事の意見については内容をよく確認し関係行政や専門家の意見をうかがいながら今後の対応を検討していく"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
