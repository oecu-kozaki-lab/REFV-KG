    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "地元の新聞等とあわせて地元での理解を深めるため、説明会を開催すること"@ja.
<< kg:id_1 prop:effect kg:id_25 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "土壌の改変に伴う土壌流出による既存河川及び沢筋の水質悪化が予想される"@ja.
<< kg:id_1 prop:effect kg:id_26 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "地下水脈について適切に調査を行い、生活系の保全及び枯の存続に努めること"@ja.
<< kg:id_1 prop:effect kg:id_27 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "騒音調査を実施し、環境基準に適合するよう適切に評価すること"@ja.
<< kg:id_1 prop:effect kg:id_28 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "造成工事については環境配慮の定めはないものの、濁質増加等による濁化が予想される"@ja.
<< kg:id_1 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "イヌワシやクマタカの繁殖を妨げるおそれがあり、工事時期について適切な調整を行うこと"@ja.
<< kg:id_1 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "事業計画の実施により重大な影響が発生するおそれがある場合には、事後的な停止を含む対応を講ずること"@ja.
}
