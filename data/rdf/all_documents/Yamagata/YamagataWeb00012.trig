PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00012> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "イヌワシの巣"@ja.
kg:id_1 rdf:type cls:c_13152.
cls:c_13152 rdfs:label "鳥類の巣"@ja.
kg:id_2 rdfs:label "改ざん問題"@ja.
kg:id_2 rdf:type cls:c_13153.
cls:c_13153 rdfs:label "改ざん問題"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "JR東日本エネルギー開発（株）"@ja.
kg:id_3 rdf:type cls:c_2246.
cls:c_2246 rdfs:label "事業者"@ja.
kg:id_4 rdfs:label "地元住人による説明会開催にも応えてくれない不誠実な対応"@ja.
kg:id_4 rdf:type cls:c_13154.
cls:c_13154 rdfs:label "説明拒否"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "この事業"@ja.
kg:id_5 rdf:type cls:c_1.
cls:c_1 rdfs:label "事業"@ja.
kg:id_6 rdfs:label "白紙撤回"@ja.
kg:id_6 rdf:type cls:c_1291.
cls:c_1291 rdfs:label "計画撤回"@ja.
kg:id_5 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "JR東日本やJR東日本エネルギー開発"@ja.
kg:id_7 rdf:type cls:c_2910.
cls:c_2910 rdfs:label "企業"@ja.
kg:id_8 rdfs:label "メールを送る"@ja.
kg:id_8 rdf:type cls:c_13155.
cls:c_13155 rdfs:label "抗議行動"@ja.
kg:id_7 prop:countermeasure kg:id_8.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "JRグループに抗議の声を上げてほしい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "説明会開催に応じないJR東日本エネルギー開発は不誠実だと批判"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "一人一人の行動で事業の白紙撤回を後押ししてほしい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "抗議のためJR東日本やJR東日本エネルギー開発にメール送信を呼びかける"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "イヌワシの巣、改ざん問題をはじめ"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "地元住人による説明会開催にも応えてくれない不誠実な会社、JR東日本エネルギー開発（株）"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "皆さん一人一人のお力が、この事業の「白紙撤回」への後押しとなります"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "親会社のJR東日本やJR東日本エネルギー開発に、是非メールを送ってください"@ja.
}
