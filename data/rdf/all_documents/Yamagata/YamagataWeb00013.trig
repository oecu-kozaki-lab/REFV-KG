PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00013> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電建設"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "米沢の子どもたちに負の影響と遺産を残す"@ja.
kg:id_2 rdf:type cls:c_6787.
cls:c_6787 rdfs:label "悪影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "自然破壊"@ja.
kg:id_3 rdf:type cls:c_13156.
cls:c_13156 rdfs:label "自然破壊"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "反対の旗を掲げて賛同者に配布する"@ja.
kg:id_4 rdf:type cls:c_13157.
cls:c_13157 rdfs:label "反対運動"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "風車を建ててはいけないという機運を高める"@ja.
kg:id_5 rdf:type cls:c_13157.
kg:id_1 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "署名用紙をダウンロードできるようにする"@ja.
kg:id_6 rdf:type cls:c_13123.
cls:c_13123 rdfs:label "署名活動"@ja.
kg:id_1 prop:countermeasure kg:id_6.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "米沢の子どもたちに負の影響と遺産を残してはいけないと訴える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "自然環境を守るため風車建設に反対する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "反対の思いを広げ機運を高めたい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域全体で風車建設反対の機運を高めたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "署名活動への参加を呼びかける"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "「米沢の子どもたちに負の影響と遺産を残してはいけない。大人の責任」"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "NO! 自然破壊"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "私たちの栗子山風車反対の思いを旗にしました。旗は、賛同者にもお配りしていきます。"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "旗が米沢中にはためき、風車を建ててはいけない！という思いに、機運を高めていきたいところです。"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "締め切り日を設けていない署名用紙のPDFをダウンロードできるようにしましたので、下記からダウンロードしてご利用ください。"@ja.
}
