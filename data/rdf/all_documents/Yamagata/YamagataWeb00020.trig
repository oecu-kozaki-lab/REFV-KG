kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "事業計画地の美しい沢が失われることを憂慮する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "森林の保水機能が失われ災害防止力が低下すると懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "土砂混じりの汚水が川へ流れ込むと懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "カエルや魚が生きられなくなると懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "他の生き物も命を奪われると懸念する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "水源汚染の重大性を考えるべきだと訴える"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "届け出をしないまま必要以上に木を切っていると批判する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "無届けで切土を行い前倒し工事を進めていると批判する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_2 rdfs:label "通りすがりのハイカー"@ja.
kg:st_2 rdf:type cls:st_161.
cls:st_161 rdfs:label "個人"@ja.
kg:op_9 prop:content "作業道が現れ道が広く改変されていて驚いた"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "切られた木が左側に追いやられている状況が記録されている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:st_3 rdfs:label "山形県の審査会"@ja.
kg:st_3 rdf:type cls:st_7.
cls:st_7 rdfs:label "審査機関"@ja.
kg:op_11 prop:content "外来種の持ち込みは不適切であると指摘した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "審査会の指摘を無視して外来種が持ち込まれたと批判する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "外来種がすでに発芽していると問題視する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_4 rdfs:label "JR東日本エネルギー開発"@ja.
kg:st_4 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_14 prop:content "倒壊原因は風と積雪だと説明する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
kg:op_15 prop:content "風況も観測できない事業者が巨大風車を建てる計画に疑問を呈する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_5 rdfs:label "専門委員の審査会"@ja.
kg:st_5 rdf:type cls:st_7.
kg:op_16 prop:content "風車建設の適地か判断するため地質調査を行うよう求める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_5.
kg:op_17 prop:content "地質調査はこれから実施すると回答する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "今後調査をして地すべり箇所を避けて進めると説明する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "調査前に避けると言う説明は実効性に欠けると批判する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業計画地に入っており、消えてしまうであろう合沢が、どれだけ美しい沢であるのか"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業が実行されると、この自然は壊され、保水力が奪われ"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "土砂の混じった汚れた水が川に流れ込みます"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "カエルさんもお魚さんも生存できなくなるでしょう"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "他の生き物も命を奪われます"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "水源が汚染されるという事はどういう事か。これまで他人事として興味を示していなかった人にも考えて欲しい"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "届け出をしないまま、必要以上に木を切り"@ja.
<< kg:id_8 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "切土をして事業の前倒しの工事を密かに始めている事業者"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "この電波塔から先が事業計画地で、道が広く改変されたところとなっており、ケーブルが敷かれています"@ja.
<< kg:id_8 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "左側に切られた木が追いやられている"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "この土嚢には外来種の種が仕込まれています。方法書の段階で、県の審査会で外来種を持ち込む事は「気持ち悪い事」と言われていたのに、無視して実行されています"@ja.
<< kg:id_13 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "お盆のころには発芽しています"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "「風況観測塔が倒壊した原因は何だったのですか？」と言う問いの答えは、「風と積雪が原因と思われます。」"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "風況観測塔の倒壊により、風況さえ観測できない状態の事業者が、巨大風車を10基建てる計画です"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "巨大な建造物を建てる場合、しっかりした土台である必要があるから、きちんと地質の調査をして、この場所が風車建設の適地かどうか、調査をするように。」「これからやります」"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "「これから調査をして、地すべりするところを避けてやります。」と言ってますが、調査もせずに避けます、というのは絵に描いた餅を追っているのではないでしょうか"@ja.
}
