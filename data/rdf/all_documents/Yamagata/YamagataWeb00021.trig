PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00021> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "巨大風車建設"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "建設の取りやめ"@ja.
kg:id_2 rdf:type cls:c_13085.
cls:c_13085 rdfs:label "計画中止"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "環境破壊"@ja.
kg:id_3 rdf:type cls:c_13226.
cls:c_13226 rdfs:label "環境破壊"@ja.
kg:id_4 rdfs:label "野生動物への被害"@ja.
kg:id_4 rdf:type cls:c_13227.
cls:c_13227 rdfs:label "野生動物被害"@ja.
kg:id_3 prop:effect kg:id_4.
kg:st_1 rdfs:label "野生動物を環境破壊から守ろうの会 風力発電の嘘 クリーンエネルギー風力発電の闇"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "今回の結果をAIで歌にした"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_2 rdf:type cls:st_73.
kg:op_2 prop:content "取り組んできたものとしてグッとくる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "野生動物を環境破壊から守る必要がある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今回のJR東日本エネルギー開発の巨大風車建設の取りやめが歌になっていました。『野生動物を環境破壊から守ろうの会 風力発電の嘘 クリーンエネルギー風力発電の闇』様が、YouTubeで今回の結果をAIで歌にしてくださっていました。短いものですが、取り組んできたものといたしまして、グッとくるものがあります。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "野生動物を環境破壊から守ろうの会"@ja.
}
