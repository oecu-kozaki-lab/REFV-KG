kg:id_41 prop:effect kg:id_52.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "開けた好条件の場所でも発電量はこの程度だと驚いた"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "太陽光発電の一年分を短時間で賄えるほど高出力だと評価"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "太陽光発電の発電効率は低いとみている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地区外の多くの人が計画を知らされていないことを問題視"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "仙台より発電条件が悪く十分な発電は見込めないとみている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "南原では仙台並みの発電量は期待できないと懸念"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "一部でも日射が欠けると発電できない仕組みだと説明"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "鳥の糞でも発電量が落ちると指摘"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "落ち葉一枚でも発電量が落ちると指摘"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "一部のパネルが陰るだけで発電量が急低下すると説明"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "部分的な日陰で出力が大きく落ちるとみている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "出力低下が瞬時に起こる不安定さを問題視"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "雲の通過で停電の恐れがあると指摘"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "太陽光の不安定さは火力発電で補われていると説明"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "風が無いと風車は止まり発電できないと説明"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "風が強すぎても風車は止まると説明"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "風力発電は停止時に出力ゼロになると指摘"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "風速が一定でないため安定供給できないとみている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "風力の不足分も火力発電で補われていると説明"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "需要増には燃料追加で安定供給していると説明"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "自然エネルギーだけでの電力供給は現実的でないと考えている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "再エネ設備の製造や輸送でも二酸化炭素が出ると問題視"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "寿命後に廃棄物化する点を問題視"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "廃棄処理の有効策が未確立だと懸念"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "現状では厄介な産業廃棄物になるとみている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "効率の良い火力発電は有効だと評価"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "再エネ拡大より高効率火力への更新を進めるべきだと提案"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "高効率火力への更新で大幅なCO2削減が可能だとみている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "発電設備の輸入より高効率火力技術の普及が有効だと提案"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "高効率火力の普及の方が温暖化抑制に役立つと考えている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "自然エネルギー導入は生き物を犠牲にしていると批判"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "自然エネルギーより火力発電の方が自然環境に良いと考えている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "2011年の津波の爪痕も記録され、入り口の守衛さんの詰所の屋根の高さまで津波は到達。"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "この太陽光発電所で発電できる電力量は、年間で出力2000kw（約700世帯分）。"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "隣にあるコンバインドサイクル発電の火力発電所は、年間で出力468000kw（約92万世帯分）。"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "太陽光発電所の一年間の発電量は、火力発電では、たった４．５時間で賄えるということ。"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "近隣住民に案内が届いたらしいが、地区外のほとんどの方はそんな計画がある事すら知らない。"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "米沢は盆地なので、仙台の太陽光発電所よりも日の出は遅く、日の入りは早い。そして、冬は雪が降る"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "冬は雪が降るので発電は松島湾に面した太陽光発電施設の年間で700世帯を賄うまで発電できるハズがない。"@ja.
<< kg:id_7 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "直列であるため、４枚のすべてにまんべんなく太陽が当たらないと豆電球は点かなかった。"@ja.
<< kg:id_7 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "鳥の糞が落ちても発電量は落ちる。"@ja.
<< kg:id_7 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "落ち葉一枚落ちても発電量は落ちる。"@ja.
<< kg:id_7 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "晴天の日に、一つの雲が流れてきて、パネルの上を通過した時、1枚だけ日陰状態になったとして、他のパネルにカンカン照りに太陽が当たっていたとしても発電量は落ち"@ja.
<< kg:id_7 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "他のパネルにカンカン照りに太陽が当たっていたとしても発電量は落ち、曇りの日と変わらなくなる。"@ja.
<< kg:id_7 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "雲がかかった瞬間、急に電力が下がる。"@ja.
<< kg:id_7 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "その瞬間に停電することを意味する。雲が通過するたびに発電量は落ち、停電に陥る。"@ja.
<< kg:id_7 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "それを停電しないように、瞬時に不足した分を火力発電で作られた電気で補われているため、停電せずにいるのです。"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "風車の場合も、風の無い時、風が強すぎる時、風車は止まる。"@ja.
<< kg:id_21 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "風車の場合も、風の無い時、風が強すぎる時、風車は止まる。"@ja.
<< kg:id_21 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "風車の場合も、風の無い時、風が強すぎる時、風車は止まる。発電量はゼロである。"@ja.
<< kg:id_21 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "風も同じ速度で吹いているわけではないので、発電は安定しない。"@ja.
<< kg:id_21 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "風車が止まった時、弱く吹いて発電量が下がった時、停電せずにいるのは、火力発電によって足りない部分が補われているからです。"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:text-txt_contents "電気の使用量が増えれば、タービンが重くなる。"@ja.
<< kg:id_27 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "その時は燃料を追加して発電量を安定させる。"@ja.
<< kg:id_30 prop:countermeasure kg:id_31 >>
    prop:text-txt_contents "これにより、急激に電力の消費量が上がっても、突然の停電を防ぐことが出来ているのでした。"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "話を聞いて、自然エネルギーだけで電力を賄う事は、夢物語。"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "二酸化炭素を排出しながら太陽光パネルや風車が外国で製造されて、二酸化炭素を排出しながら日本まで運ばれてくる。"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "年間発電量は少ないのに、寿命を迎えたら廃棄物として処分。"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "その処理方法は現時点では有効な手段はない。"@ja.
<< kg:id_38 prop:effect kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "今は厄介な産業廃棄物にしかならない。"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "二酸化炭素の排出量は、従来の石炭発電よりも６０％削減となっている。"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "日本国内の効率が悪くなった火力発電所や世界中の古くなった火力発電所を、効率の良いコンバインドサイクル発電の火力発電に変えていくだけで"@ja.
<< kg:id_45 prop:effect kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "地球規模で二酸化炭素排出量を５０％以上減らすことが出来るのではないでしょうか。"@ja.
<< kg:id_43 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "太陽光パネルや風車を輸入するよりも、この発電システムを日本からドンドン売り込んでいった方が"@ja.
<< kg:id_48 prop:effect kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "地球規模温暖化を抑えられるのではないでしょうか？"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "効率の悪く、植物や動物、生き物を犠牲にしている自然エネルギーを推し進めて導入していくよりも"@ja.
<< kg:id_41 prop:effect kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "よほど自然環境に良いと思えるのだが。"@ja.
}
