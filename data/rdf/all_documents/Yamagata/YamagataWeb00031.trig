PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00031> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電事業建設"@ja.
kg:id_1 rdf:type cls:c_170.
cls:c_170 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "白紙撤回を求める署名提出"@ja.
kg:id_2 rdf:type cls:c_838.
cls:c_838 rdfs:label "撤回要求"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "子供の未来への懸念"@ja.
kg:id_3 rdf:type cls:c_13303.
cls:c_13303 rdfs:label "将来への懸念"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "豊かな自然への懸念"@ja.
kg:id_4 rdf:type cls:c_13304.
cls:c_13304 rdfs:label "自然への懸念"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "追加分の署名提出"@ja.
kg:id_5 rdf:type cls:c_13206.
cls:c_13206 rdfs:label "署名提出"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "事業建設の白紙撤回を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "子供の未来への影響を懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "豊かな自然への影響を懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "追加署名を提出して反対の意思を示す"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "栗子山風力発電事業建設の白紙撤回を求める署名書"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "米沢の子供の未来と豊かな自然を考える会"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "米沢の子供の未来と豊かな自然を考える会"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "米沢市長に追加分の署名を提出してきました。８月２８日に、これまで提出した分に加えて、１９０５筆を加えて提出し、累計で６８００筆となりました。"@ja.
}
