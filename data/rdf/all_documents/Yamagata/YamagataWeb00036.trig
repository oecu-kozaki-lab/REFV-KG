PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00036> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "栗子山風力発電"@ja.
kg:id_1 rdf:type cls:c_999.
cls:c_999 rdfs:label "風力発電"@ja.
kg:id_2 rdfs:label "市民への説明会の開催"@ja.
kg:id_2 rdf:type cls:c_94.
cls:c_94 rdfs:label "説明会開催"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "景観への大きなインパクト"@ja.
kg:id_3 rdf:type cls:c_224.
cls:c_224 rdfs:label "景観影響"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "窪田、六郷地区から風車が見える"@ja.
kg:id_4 rdf:type cls:c_224.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "景観上問題ないように見せかけられる"@ja.
kg:id_5 rdf:type cls:c_224.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "JR東日本エネルギー開発"@ja.
kg:id_6 rdf:type cls:c_2246.
cls:c_2246 rdfs:label "事業者"@ja.
kg:id_7 rdfs:label "モンタージュを用いた説明会案内チラシの作成"@ja.
kg:id_7 rdf:type cls:c_13321.
cls:c_13321 rdfs:label "説明資料作成"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "JR東日本エネルギー開発が10基すべて見えない視点をモンタージュの立ち位置にしたこと"@ja.
kg:id_8 rdf:type cls:c_13322.
cls:c_13322 rdfs:label "視点設定"@ja.
kg:id_1 prop:cause kg:id_8.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "市民全体への説明会開催は遅すぎる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "市内近くに10基建つと景観への影響は大きい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "曇りでも見えるため可視性は高い"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "モンタージュは風車を見えにくくして景観影響を隠している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "作成されたモンタージュの見せ方に誠実さがない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "視点設定に誠実さがない"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "＜栗子山風力発電＞‟ようやく”市民への説明会が開催されることになりました。半年以上前からずっと米沢市民全体への説明会を要請していましたが、無視され続けていました。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "そのサイズの大きな風車が１０基、いちご風車の北側(左側)の山の尾根にずらりと建設計画されています。そして、位置的には、いちご風車よりも米沢市内に近い距離です。相当のインパクトがあると思います。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "窪田、六郷地区から見えるいちご風車。この撮影場所は、JR東日本エネルギー開発が出してきたモンタージュの撮影場所、道の駅米沢よりも、北西に位置しており、距離的に離れている。離れていながら曇りでもこれだけはっきり見える。栗子山風力発電の風車はこれよりも大きいものなので、もっとインパクトが出るはずである。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "しかしながら、JR東日本エネルギー開発が作ったモンタージュの風車は、ほぼ透明で見えにくい。景観上問題ない、隠したい意図がアリアリですね。"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "広報よねざわNo.1691 2024.7.1に市民説明会のチラシが折り込まれてきました。JR東日本エネルギー開発のプロが数か月かけて作成したモンタージュが載った説明会の案内チラシです。"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "モンタージュ作成の場所である道の駅米沢は、本来１０基すべて見える場所です。立ち位置を変えれば１０基見えます。何故、JR東日本エネルギー開発がこの視点での立ち位置としたのか。JR東日本エネルギー開発の誠実さの無さを感じます。"@ja.
}
