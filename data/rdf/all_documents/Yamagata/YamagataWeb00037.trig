kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "市民団体"@ja.
kg:op_1 prop:content "風力発電は環境に良いというイメージが先行しており勉強会で共に考えたい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "ＪＲ東日本エネルギー開発"@ja.
kg:st_2 rdf:type cls:st_1.
cls:st_1 rdfs:label "事業者"@ja.
kg:op_2 prop:content "周辺環境への影響や保全に関する考えを説明した"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "鳥類の衝突確率は低いと説明している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "不正告発者"@ja.
kg:st_3 rdf:type cls:st_165.
cls:st_165 rdfs:label "告発者"@ja.
kg:op_4 prop:content "自分が書いた報告書と異なる内容に改ざんされたと訴えている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "住民"@ja.
kg:st_4 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_5 prop:content "再調査継続中に工事を進めるべきではなく事業見直しを求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:op_6 prop:content "再調査継続中の工事強行に反対し事業見直しを求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_4.
kg:st_5 rdfs:label "市民団体"@ja.
kg:st_5 rdf:type cls:st_73.
kg:op_7 prop:content "計画の白紙撤回を求める署名を米沢市に提出した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_5.
kg:st_6 rdfs:label "市民グループ"@ja.
kg:st_6 rdf:type cls:st_73.
kg:op_8 prop:content "県に対しても白紙撤回を求め住民説明会開催も求めている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_6.
kg:st_7 rdfs:label "日本イヌワシ研究会"@ja.
kg:st_7 rdf:type cls:st_162.
cls:st_162 rdfs:label "研究団体"@ja.
kg:op_9 prop:content "調査は非常にレベルが低く計画中止を求めている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_7.
kg:op_10 prop:content "低周波による健康被害のおそれを問題視している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "尾根を削ることで土砂崩れの危険が高まると懸念している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "工事による水質汚濁を懸念している"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "大規模な伐採や造成により自然破壊が起きると懸念している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "樹木表土の掘削や作業道整備で生態系にも影響が及ぶとみている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "福島側からも見える規模で景観への影響が大きいと示している"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "建設ができるとどんな風になるのか一緒に考えるため勉強会を案内している"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "ＪＲ東日本エネルギー開発（東京）が米沢市の栗子山で風車を最大10基建設する風力発電事業を計画している"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "米沢市の栗子山で風力発電事業を計画するＪＲ東日本エネルギー開発（東京）は9日、周辺環境への影響や保全に関する考えをまとめ"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "米沢・栗子山「鳥類の衝突確率低い」 風力発電計画の住民説明会"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "事業を進める企業がまとめた環境影響評価準備書が、実際の調査内容とは異なる、改ざん"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "イヌワシ調査の信ぴょう性が疑われている山形・米沢市の風力発電計画について"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "再調査継続中に「工事を強行するのか」 風況ポール設置工事始まる…住民から事業見直し求める声"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "計画の白紙撤回を…栗子山の風力発電計画への反対署名を市民団体が米沢市に提出"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "市民グループが計画の白紙撤回を求める署名を県に提出した。あわせて住民説明会を開く"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "「非常にレベルの低い調査」 イヌワシ研究会が県へ風力発電計画中止の要望書提出"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "低周波で害のおそれ！"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "尾根を削って土砂崩れ！"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "尾根を削って土砂崩れ！・水質汚濁！・自然破壊！"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "尾根を削って土砂崩れ！・水質汚濁！・自然破壊！"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "樹木の土を抑える力や保水力が失われ、水質汚濁・自然破壊 生態系にも影響が!!"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "福島側から見たイメージ 風車により、どんな影響があるのか。高さは新米沢市役所庁舎の８倍超。"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "《風力発電》勉強会のご案内 風力発電施設が建設できると、どんな風になるのでしょう。私たちと一緒に考えてみませんか？"@ja.
}
