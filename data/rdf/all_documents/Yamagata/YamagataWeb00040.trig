kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "貴重な水源の大元への風車建設に懸念を示す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "40万人の水を担う水源への影響を懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "急峻な斜面への道路建設で大規模な自然改変が起きると懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "大量の樹木伐採が行われることを問題視する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "道路建設と運搬のために山が大きく削られると懸念する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "もともと地質的に脆弱な地域だと指摘する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地質の脆弱性により降雨時の通行障害が頻発すると指摘する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "崩れやすい山でブナ林を広域伐採することを危険視する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "大規模な造成が災害リスクを高めると懸念する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "森林伐採と造成で山体の不安定化が進むとみている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:st_2 rdfs:label "能登の地震でも活動した災害ボランティア参加者"@ja.
kg:st_2 rdf:type cls:st_166.
cls:st_166 rdfs:label "災害ボランティア"@ja.
kg:op_11 prop:content "災害は人の手が入った伐採地で起きていると感じている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "取り付け道路によりトンネルが左右両側から脅かされると懸念する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "土石流が発生した場合に高速道路入口への被害を懸念する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "土砂と倒木の流入でダム越水のおそれを懸念する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "加工しやすい地質は崩れやすさにつながると指摘する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "説明資料が軟弱地質を十分に扱っていないと批判する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "工事に伴う粉塵発生が懸念されている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "工事に伴う水質汚濁が懸念されている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "水は、左側は刈安川に流れ水窪ダムに流入する。水窪ダムは、水道水、農業用水、工業用水として利用されている。そんな貴重な水源の大元に巨大な風車を建てようとしている。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "右側は烏川と摺上川に流れ、摺上川ダムに流入する。摺上川ダムの水は、２市３町４０万人の水を担っている。これまで井戸を水源とする簡易水道など多数にわたっていた水源を廃止し、摺上川ダム一本に集約した。そんな貴重な水源の大元に巨大な風車を建てようとしている。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "風車を尾根のてっぺんに運ぶための取り付け道路は、西栗子トンネルの入り口の左右両側に頂上に向けて作られる。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "そんなサイズのものを頂上まで上げる取り付け道路が作られる。どれだけの樹木が伐採され、どれだけ山が削られるのか。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "そんなサイズのものを頂上まで上げる取り付け道路が作られる。どれだけの樹木が伐採され、どれだけ山が削られるのか。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "そもそも、栗子周辺は地質的に崩れやすい。"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "崩れやすいから、降雨量が増えると通行止めになる。それが頻回であるから"@ja.
<< kg:id_1 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "崩れやすい山の森のダムと言われるブナの木を広域に伐採し"@ja.
<< kg:id_1 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "山を削り道を幅広く切り開く。"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "これまで以上に崩れやすくなる事は想像に難くない。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "土砂災害が何に起因しているのか、肌で感じた情報が寄せられた。確実に樹木が伐採されたところ、人間の手が入った場所に災害か起っている、という事である。"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "栗子山風力発電事業の取り付け道路は、西栗子トンネルの入り口であることから、西栗子トンネルへの影響は左右両側から脅かされることになる。"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "土石流となって流れれば、その下に位置する高速道路の入り口への影響も無視できない。"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "そしてその先には、５０歳を迎えた水窪ダムがある。土砂とともに大量の倒木が流入した場合、越水の心配は無いのか。"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "栗子周辺の地質は、上質なゼオライトがある。良質なゼオライトで加工しやすい＝加工しやすいとは崩れやすい。"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "JR東日本エネルギー開発の住民説明会で配布された資料は空白であった。工事に関する粉塵や、水質汚濁などの記述がわずかにあった程度で、軟弱な地質についてはまったく言及されず。"@ja.
<< kg:id_1 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "工事に関する粉塵や、水質汚濁などの記述がわずかにあった程度で"@ja.
<< kg:id_1 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "工事に関する粉塵や、水質汚濁などの記述がわずかにあった程度で"@ja.
}
