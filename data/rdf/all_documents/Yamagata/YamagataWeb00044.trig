PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/YamagataWeb/00044> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "巨大な風車の建設計画"@ja.
kg:id_1 rdf:type cls:c_88.
cls:c_88 rdfs:label "風力発電計画"@ja.
kg:id_2 rdfs:label "JR東日本エネルギーによる福島県と山形県の県境の栗子山周辺での計画"@ja.
kg:id_2 rdf:type cls:c_88.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "建設計画の中断"@ja.
kg:id_3 rdf:type cls:c_13210.
cls:c_13210 rdfs:label "計画中断"@ja.
kg:id_4 rdfs:label "イヌワシの調査改ざんの発覚"@ja.
kg:id_4 rdf:type cls:c_13349.
cls:c_13349 rdfs:label "調査不正"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "風況ポールなどが建てられ次の段階に向けて進行している"@ja.
kg:id_5 rdf:type cls:c_13350.
cls:c_13350 rdfs:label "計画進行"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "危機を感じて有志の会が立ち上がった"@ja.
kg:id_6 rdf:type cls:c_13351.
cls:c_13351 rdfs:label "住民団体"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "風力発電"@ja.
kg:id_7 rdf:type cls:c_999.
cls:c_999 rdfs:label "風力発電"@ja.
kg:id_8 rdfs:label "低周波や騒音が発生する"@ja.
kg:id_8 rdf:type cls:c_13352.
cls:c_13352 rdfs:label "騒音被害"@ja.
kg:id_7 prop:effect kg:id_8.
kg:id_9 rdfs:label "バードストライクが起こる"@ja.
kg:id_9 rdf:type cls:c_13353.
cls:c_13353 rdfs:label "鳥類被害"@ja.
kg:id_7 prop:effect kg:id_9.
kg:id_10 rdfs:label "尾根を削って土砂崩れや水質汚濁が起こること"@ja.
kg:id_10 rdf:type cls:c_13226.
cls:c_13226 rdfs:label "環境破壊"@ja.
kg:id_11 rdfs:label "風車建設予定地の尾根を削ること"@ja.
kg:id_11 rdf:type cls:c_127.
cls:c_127 rdfs:label "地形改変"@ja.
kg:id_10 prop:cause kg:id_11.
kg:id_12 rdfs:label "風車建設予定地"@ja.
kg:id_12 rdf:type cls:c_13354.
cls:c_13354 rdfs:label "建設予定地"@ja.
kg:id_13 rdfs:label "国蝶森林管理署の土砂流出防止エリアに位置する"@ja.
kg:id_13 rdf:type cls:c_13355.
cls:c_13355 rdfs:label "防災区域"@ja.
kg:id_12 prop:effect kg:id_13.
kg:id_14 rdfs:label "風車建設のためブナ林など約31haが切り倒され仮設道路は約9km作業道路は約11kmに及ぶ"@ja.
kg:id_14 rdf:type cls:c_13215.
cls:c_13215 rdfs:label "森林伐採"@ja.
kg:id_12 prop:effect kg:id_14.
kg:id_15 rdfs:label "樹木の生存状況"@ja.
kg:id_15 rdf:type cls:c_13356.
cls:c_13356 rdfs:label "樹木状態"@ja.
kg:id_16 rdfs:label "仮設道が作られて水質汚濁や自然破壊につながる"@ja.
kg:id_16 rdf:type cls:c_13226.
kg:id_15 prop:effect kg:id_16.
kg:id_17 rdfs:label "火力発電の助けが必要"@ja.
kg:id_17 rdf:type cls:c_13357.
cls:c_13357 rdfs:label "補完電源"@ja.
kg:id_7 prop:countermeasure kg:id_17.
kg:id_18 rdfs:label "20年で寿命がきてもその後の処理は困難で風車の羽根は燃料やリサイクルが困難"@ja.
kg:id_18 rdf:type cls:c_13358.
cls:c_13358 rdfs:label "廃棄困難"@ja.
kg:id_7 prop:effect kg:id_18.
kg:st_1 rdfs:label "米沢の子供の未来と豊かな自然を考える会"@ja.
kg:st_1 rdf:type cls:st_106.
cls:st_106 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "計画の状況に危機を感じている"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "調査改ざんを問題視している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "中断中も計画が進んでいることに懸念を示す"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "疑問や問題点を発信していきたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "米沢住民のほとんど"@ja.
kg:st_2 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_5 prop:content "知らないうちに影響を受けることを懸念している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "鳥類への影響を懸念している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "自然破壊につながると懸念している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "大規模な森林伐採と道路造成を問題視している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "生態系への影響を懸念している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "不安定な風力発電には補完電源が必要とみている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "設備の廃棄やリサイクルに課題があると指摘している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "福島県と山形県の県境の栗子山の周辺に、JR東日本エネルギーによる巨大な風車が最大１０基の建設計画があり、既に最終段階です。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "しかし、イヌワシの調査改ざんが発覚し、中断している状態です。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "しかし、その間も風況ポールなどを建てたり、着々と次の段階に向けて進んでいます。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "この状況に危機を感じて、昨年２０２３年１１月１７日に有志で立ち上げた会です。どんな事に疑問を持ち、何を問題としているのかを発信していけたらと思います。"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "画像内記載: ①低周波や騒音"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "画像内記載: ③バードストライク"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "画像内記載: ④尾根を削って土砂崩れ・水質汚濁・自然破壊!"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:text-txt_contents "画像内記載: 風車建設予定地は国蝶森林管理署の土砂流出防止エリア"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "画像内記載: 風車建設の為、ブナ林など約31haが切り倒される! 仮設道路は約9km、作業道路は約11kmにも。"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "画像内記載: 樹木の生存状況で仮水力が失われ、水質汚濁・自然破壊 生態系にも影響。"@ja.
<< kg:id_7 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "画像内記載: ⑥ホントにエコ? “不安定”な風力発電には常に火力発電の助けが必要!"@ja.
<< kg:id_7 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "画像内記載: ⑦風力発電は20年で寿命! その後の処理は、どうなる!? 風車の羽根は、燃料材料・リサイクルは困難。"@ja.
}
