    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "地域住民の生活環境に対する影響を回避又は十分に低減するように努めること"@ja.
<< kg:id_13 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "自然景観や眺望景観に与える影響を調査し、良好な景観を阻害することのないように十分に検証すること"@ja.
<< kg:id_13 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "動植物の生息環境や生態系に与える影響を調査し"@ja.
<< kg:id_13 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "特にバードストライク等についても十分に検証すること"@ja.
<< kg:id_13 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "事業終了後の発電設備の撤去及び処分の適切実施"@ja.
<< kg:id_13 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "当該設備撤去後における跡地への植林など原状回復に復するための方法等について調査・予測及び評価を行うこと"@ja.
<< kg:id_13 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "土砂災害を招くことがないよう十分に検証すること"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "風力発電施設が建設されることに対する不安をですね、真摯に私にお話ししていただいた経過がございます。 なし崩し的に検討が開始されるのではないかと心配されている町民の声もたくさんあるかと存じます"@ja.
<< kg:id_28 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "つきましては今後、知事からの求められる方法書に対する意見書におきまして、このことを記載し、北海道知事を通じて関西電力にお伝えしたい"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:text-txt_contents "事業主・関西電力株式会社による「（仮称）古平・仁木・余市ウィンドファーム事業」計画に全面反対し、白紙撤回を求め提出された当該事業に反対する陳情"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "当該事業計画から仁木町エリアが除外されたことに伴い、陳情趣旨に沿って審査し得ない事案であり、不採択とせざるを得ないと考える"@ja.
<< kg:id_31 prop:cause kg:id_34 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "元々の事業内容から仁木町が除外されたことから委員会で審議するのは難しいと考えるので、陳情には反対する"@ja.
}
