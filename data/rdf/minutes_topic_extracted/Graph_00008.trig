kg:st_1 rdfs:label "町長 石山英雄"@ja.
kg:st_1 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_1 prop:content "補償や合意形成の課題があり協議会立ち上げの時期はまだ見通せない"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "近江武議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_2 prop:content "共同漁業権の問題は大きな課題だと指摘する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "税収増が期待できる大きなメリットがある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "洋上作業に伴い船の需要や雇用が生まれるとみている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "漁場喪失に伴う補償が発生する見込みだと認識している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "補償に加えて新たな漁業振興策も期待している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "合意形成ができれば町の大きな起爆剤になると考える"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "漁協にとっても大きな機会になると認識している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "コロナで往来が止まり話が進みにくい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "漁協と本格的に話し合い合意形成を進めたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "合意形成ができれば国の認定に向けて進めたい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "透明性を確保し合意形成を重視して進めるべきだと求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "事業者と漁業者が互いに利益のある進め方を求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "地域全体の活性化につながる形で進めるべきだと求める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "漁協と連携し勉強会も含めて事業理解を深めたい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "大型風力による税収増を見込んでいる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "建設工事は町内経済に大きな効果があった"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:st_3 rdfs:label "梶谷康介議員"@ja.
kg:st_3 rdf:type cls:st_9.
kg:op_18 prop:content "発電能力と蓄電施設は停電対策の売りになると評価する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "立派な蓄電施設は松前の大きな強みだと評価する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "協定を活かして地域活性化につなげたい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "人口減少の大きな要因は産業衰退と雇用減少だと認識している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "治療薬やワクチンが整うまで不安は続くとみる"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "何もできない状態が続けば町の維持が難しくなると危惧する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "企業の在宅勤務拡大は地方移住の好機だとみている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "コロナ禍は都市から地方への移転を進める最大のチャンスだと捉える"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "働く人を松前に呼び込めば人口減少の歯止めになると考える"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "既存の移住定住施策は実質的な成果が乏しいと批判する"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "在宅勤務には生活との切り替えが難しい欠点がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "在宅勤務は家族への負担を生む面がある"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "まず人脈づくりが重要で交流を進めたい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "東急不動産との交流を通じてビジネスチャンスを広げたい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "専門家の力も借りて地域振興策を具体化したい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "拠点施設の活用方法を東急不動産や専門家と検討したい"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "廃校や空家の改修可能性を含めて検討する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "廃校や空家を活用したテレワーク拠点整備を提案する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "第2期計画に伴い社員常駐の動きがある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "コロナで事務所設置が延期されている"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "大規模停電対策としてマイクログリッド構想を進めたい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "都市とのつながりを活かし一次産業の底上げを図りたい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "企業研修やテレワークで交流人口を増やしたい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "協定を活かして新しい企業の力をまちづくりに活かしたい"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:st_4 rdfs:label "福原英夫議員"@ja.
kg:st_4 rdf:type cls:st_9.
kg:op_42 prop:content "風力関連収入は一般財源として非常に重要だと評価する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:op_43 prop:content "売電益を一般財源化できるよう国や道に働きかけるべきだと求める"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:st_5 rdfs:label "税務課長 三浦忠男"@ja.
kg:st_5 rdf:type cls:st_12.
cls:st_12 rdfs:label "行政職員"@ja.
kg:op_44 prop:content "国への働きかけや東急への要請を進め固定資産税確保につなげたい"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "今の議員ご指摘のように、現状から言わせてもらうと、協議会を立ち上げるような、タイムスケジュールを築けるような状況にはなっていない"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "洋上風力発電の建設の場合は、漁業協同組合が管理する共同漁業権が大きな課題になろうと思います"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "固定資産税、償却資産の税収増にもなりますし"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "例えば洋上で作業するようなことになりますと、船も必要となり、雇用も生まれる"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "漁場を失うことによる漁業補償等々"@ja.
<< kg:id_3 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "新たな漁業振興策も盛り込まれるというふうな情報を聞いております"@ja.
<< kg:id_3 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "合意形成されたら、大きな町の起爆剤になるんだろうな"@ja.
<< kg:id_3 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "本当に漁業協同組合にとりましても、大変大きなチャンスにもなるというふうに認識している"@ja.
<< kg:id_3 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "今回コロナの関係でちょっとストップしている、東京の方から来る人方がストップされている状況にもあります"@ja.
<< kg:id_3 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "町と致しましても利害関係のある漁業協同組合と本格的な話し合いを設けながら、お互いに合意形成されるのであれば"@ja.
<< kg:id_3 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "国の方の認定に向けて手を挙げていきたいなというふうに思っている"@ja.
<< kg:id_3 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "透明性の問題が結構クローズアップされてるんです。ですから、その辺の合議の形成の問題等がね、やっぱり重要だと思っております"@ja.
<< kg:id_3 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "発電事業者も漁業者もＷｉｎ－Ｗｉｎな関係、有効な関係でもってね、進めるような仕方"@ja.
<< kg:id_3 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "地域社会が全体的に活性化に貢献できるような進め方"@ja.
<< kg:id_3 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "漁業協同組合と勉強会も含めまして事業の理解も深めてまいりたい、漁業者にも理解していただけるような努力を続ける"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "令和２年度の固定資産税であります。大型風力の関係で、１億１千万程度を見込んでいるところでありますので、税収の増収にもなる"@ja.
<< kg:id_18 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "この工事にあたりましては、完成に至るまでに、町内には大変大きな経済の潤いをいただいた"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "ブラックアウトの心配ないでしょう"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "あの蓄電施設ってのはね、私はもうこの風力発電、全国にいろいろあるようですけれども、こんな立派な蓄電施設を持ってるの、そんなにないんですよ。だから、これも松前にとっては大きな強みだ"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "風力発電の円滑な推進と地域貢献等における町の活性化を進めるために、お互いに協力することとした内容で協定を結んでいる"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "松前の人口減少の大きな要因につきましては、産業の衰退による雇用の減少でありまして"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "早い時期に治療薬が、そしてワクチンが開発されて、発症者に対する対応が完全な形になるまでは、この不安は続くんでないかな"@ja.
<< kg:id_28 prop:effect kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "この松前町を支えていくためには大変な事態、言われてきたように消滅可能都市の道をたどっていくばかりじゃないかな"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "こういう状態の中では、いわゆる在宅の形で仕事を続ける"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "人口の地方分散、正にこういう事態を利用するって言うと変ですけど、きっかけにしてね、都市部から地方へ人を移す最大のチャンスだと"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "テレワーク活用で人口減少に歯止めをと"@ja.
<< kg:id_37 prop:effect kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "もう１件は、いわゆるテレワークという形でね、この松前で今の移住定住の制度を利用ながら、そこに居を構えて仕事をしていたと。それだって今の実態どうですか、ゼロですよ"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "仕事と生活のオンオフが切り替えなかなか難しい"@ja.
<< kg:id_39 prop:effect kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "家庭そのものが仕事場になるもんだから、本人はそりゃあ仕事するためには特別、家族のいろんな影響があって、全く問題ないとは言いませんけれども、家族に負担がかかる"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "まず率先して人脈の構築をすることが大事だというふうに思っている"@ja.
<< kg:id_42 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "東急不動産とは、お互いに人脈を大事にしていこうという話もしておりまして"@ja.
<< kg:id_42 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "株式会社スマートデザインアソシエーション、通称ＳＤＡの社長他１名が１月ですね、１月の下旬に松前においでいただきまして、松前の状況等を調査して、どのような地域振興策が適当か検討するための一時の調査に来ていただいた"@ja.
<< kg:id_42 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "東急不動産と協議しながら、専門家の意見を聞きながら、その施設の活用につきましては、調査をしてまいりたい"@ja.
<< kg:id_42 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "廃校、空家と言っても現状みますと、学校、相当古い廃校もありますし、まだ可能性のある廃校も、使える状況もありますので、改修などをいろいろ方向を検討してまいりたい"@ja.
<< kg:id_42 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "本当に松前にステーションつくりませんか"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "東急不動産では、第２期目の大型、陸上の大型風力発電を計画しているようでありまして、４名の社員が松前事務所に常駐することを考えてるようであります"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "物件もほとんど決めてたようでありますが、新型コロナウイルス感染症の拡大防止のために往来を中止している"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "大規模停電の際のマイクログリッド構想の実現に向けた取り組み"@ja.
<< kg:id_53 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "都市と地方との繋がりを強化する食材との流通強化による第１次産業の底上げ"@ja.
<< kg:id_53 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "都市圏企業による研修合宿、あるいはテレワークの実現による交流人口の増加等々"@ja.
<< kg:id_53 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "今回のこのせっかくの縁で、ご縁をいただきまして締結した協定をきちっと活かして、人口減少の中でもこの変化に対応できるまちづくりを念頭に、この新しい企業の風を取り入れて"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "やはり一般財源がない中で、相当重要な位置を占めます"@ja.
<< kg:id_58 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "どうにか売電益っていうのが、町の一般財源に組み入れられないかという交渉もやはり大事でないかな"@ja.
<< kg:id_61 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "また、国なりへの陳情と言いますか、松前に更にこの風力発電等を誘致する活動も必要でないかという趣旨かと思いますので、これは、町長等の方にもお願いしながら、また今大型風力１２基やっている東急さんの方にも、更に松前町で稼働していただけないかというような話をしていただきながら"@ja.
}
