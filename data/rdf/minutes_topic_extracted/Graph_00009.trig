kg:id_8 rdf:type cls:c_181.
cls:c_181 rdfs:label "財政健全化"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "洋上風力発電"@ja.
kg:id_9 rdf:type cls:c_175.
kg:id_10 rdfs:label "陸上より大きい発電量が期待される"@ja.
kg:id_10 rdf:type cls:c_182.
cls:c_182 rdfs:label "発電量増加"@ja.
kg:id_9 prop:effect kg:id_10.
kg:id_11 rdfs:label "松前町の産業活性化につながる大きな可能性がある"@ja.
kg:id_11 rdf:type cls:c_96.
cls:c_96 rdfs:label "産業活性化"@ja.
kg:id_9 prop:effect kg:id_11.
kg:id_12 rdfs:label "日本のエネルギー供給に貢献できる"@ja.
kg:id_12 rdf:type cls:c_183.
cls:c_183 rdfs:label "エネルギー供給"@ja.
kg:id_9 prop:effect kg:id_12.
kg:id_13 rdfs:label "固定資産税や償却資産税の増収"@ja.
kg:id_13 rdf:type cls:c_184.
cls:c_184 rdfs:label "税収増加"@ja.
kg:id_9 prop:effect kg:id_13.
kg:id_14 rdfs:label "建設時の人口交流と消費増加"@ja.
kg:id_14 rdf:type cls:c_185.
cls:c_185 rdfs:label "交流人口増加"@ja.
kg:id_9 prop:effect kg:id_14.
kg:id_15 rdfs:label "地元企業の仕事が増える"@ja.
kg:id_15 rdf:type cls:c_186.
cls:c_186 rdfs:label "仕事増加"@ja.
kg:id_9 prop:effect kg:id_15.
kg:id_16 rdfs:label "建設後のメンテナンス需要が発生する"@ja.
kg:id_16 rdf:type cls:c_187.
cls:c_187 rdfs:label "保守需要"@ja.
kg:id_9 prop:effect kg:id_16.
kg:id_17 rdfs:label "船の需要が生じる"@ja.
kg:id_17 rdf:type cls:c_188.
cls:c_188 rdfs:label "船舶需要"@ja.
kg:id_9 prop:effect kg:id_17.
kg:id_18 rdfs:label "漁業者の副業や専業の仕事が増える"@ja.
kg:id_18 rdf:type cls:c_186.
kg:id_9 prop:effect kg:id_18.
kg:id_19 rdfs:label "景観上の問題が指摘される可能性"@ja.
kg:id_19 rdf:type cls:c_189.
cls:c_189 rdfs:label "景観問題"@ja.
kg:id_9 prop:effect kg:id_19.
kg:id_20 rdfs:label "町民の健康や漁業に及ぶ環境問題の懸念"@ja.
kg:id_20 rdf:type cls:c_190.
cls:c_190 rdfs:label "環境影響"@ja.
kg:id_1 prop:effect kg:id_20.
