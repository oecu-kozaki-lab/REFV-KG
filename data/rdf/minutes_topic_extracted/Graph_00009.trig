kg:id_22 rdfs:label "推進のための協議会や期成会を立ち上げる"@ja.
kg:id_22 rdf:type cls:c_192.
cls:c_192 rdfs:label "推進組織"@ja.
kg:id_1 prop:countermeasure kg:id_22.
