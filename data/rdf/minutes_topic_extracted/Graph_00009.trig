kg:id_24 rdf:type cls:c_194.
cls:c_194 rdfs:label "区域指定"@ja.
kg:id_9 prop:countermeasure kg:id_24.
kg:id_25 rdfs:label "基礎的データの収集と利害関係人の特定・理解を進める"@ja.
kg:id_25 rdf:type cls:c_195.
cls:c_195 rdfs:label "調査調整"@ja.
kg:id_9 prop:countermeasure kg:id_25.
kg:id_26 rdfs:label "さくら漁協と早急に協議を進める"@ja.
kg:id_26 rdf:type cls:c_196.
cls:c_196 rdfs:label "利害調整"@ja.
kg:id_9 prop:countermeasure kg:id_26.
kg:id_27 rdfs:label "松前沖の洋上風力発電を積極的に推進する"@ja.
kg:id_27 rdf:type cls:c_197.
cls:c_197 rdfs:label "事業推進"@ja.
kg:id_9 prop:countermeasure kg:id_27.
kg:st_1 rdfs:label "近江武君"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "松前沖は風力発電に適しており推進すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "洋上風力は町に莫大な恩恵をもたらす"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地域経済低迷の打開策として洋上風力が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "基幹産業の不振を補う施策として必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "人口減少と交付金減少に備え早急な誘致が必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "町の活性化の起爆剤として活用すべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "財政健全化のため誘致推進を急ぐべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_2 rdfs:label "石山英雄君"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_8 prop:content "洋上風力は発電量面で有望"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "洋上風力は将来の産業活性化に有望"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "松前の風を活用すれば日本にも貢献できる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "税収増が期待できる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "建設に伴い人の往来と消費が増える"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "地域企業への仕事増加が見込める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "建設後も継続的な仕事が生まれる"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "洋上施設の維持で船も必要になる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "漁業者の新たな雇用機会になる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "景観面の懸念には留意が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "健康や漁業への影響など課題の整理が必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "早急に誘致推進を進めるべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "推進組織を早急に設ける必要がある"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "良きパートナーと連携して進めたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "促進区域指定に向け国へ意思表示すべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "指定にはデータ収集と利害関係者の理解が必要"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "まず漁協と協議し理解を得たい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "町の活性化のため積極的に推進したい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "風力発電に関する気象条件は松前沖は４．１メートルから６．０メートルとされ、局所風況マップでは、青森県日本海沖から三厩沖を通して松前海岸沖は９メートルとなっており、風力発電に適しているとしています"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "この状況は、松前町にとって多大な経済効果を伴うことになっております。小型風力５２基で８７２万８千円、大型風力１３基で１億１千２６４万６千円、合わせまして１億２千１３７万４千円。これが、令和２年度の税収の見込みだというふうに伺っております。大型風力発電１基でもって８６０万円ということになります。洋上風力の発電は大型でしょうから、仮に５０万キロワット、５０基とした場合、松前町に莫大な恩恵をもたらすことは必至です"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "コロナによって経済の落ち込み"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "基幹産業の漁業、水産加工業においては以前と明るい兆しが見えておりません"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "今後、国勢調査による人口減少が顕著になり、国の交付金も大幅に減少が予測されております"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "松前町の経済の活性化の起爆剤になりえ"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "また、松前町の財政健全化を考えた場合、洋上風力発電の誘致推進を早急に行う必要があると思います"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "洋上風力に関しましては。陸上よりも更に大きい発電量が期待されていると聞いているところであります"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "今後の松前町の産業の活性化等を考えれば、洋上風力発電は大きな可能性のある事業であるというふうな認識をしているところであります"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "無尽蔵にある風を利用した洋上風力発電は、松前のエネルギー資源として、日本にも貢献できるものであるというふうに思っているところであります"@ja.
<< kg:id_9 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "議員ご指摘のように固定資産税、償却資産税ありますね、増収はもとより"@ja.
<< kg:id_9 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "建設時のこの建設に関わる人口の交流、更には消費の増加"@ja.
<< kg:id_9 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "更には地元企業への仕事も増えることになります"@ja.
<< kg:id_9 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "建設後は必ずメンテナンスが発生致しまして"@ja.
<< kg:id_9 prop:effect kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "洋上でありますので船も必要となります"@ja.
<< kg:id_9 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "漁業者の副業、更には専業としての仕事が確実に増えるというふうに思っているところであります"@ja.
<< kg:id_9 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "一方では景観的には問題は指摘されるかもしれません"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "町民の健康や漁業に及ぼす環境、漁業の滅失などクリアしなければならない点が、問題が多くあると思います"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "洋上風力発電の誘致推進を早急に行う必要があると思います"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "早急に洋上風力発電推進のための協議会なり、期成会なり立ち上げる必要があると思います"@ja.
<< kg:id_9 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "東急不動産という良きパートナーを今いただいておりますので、東急不動産と連携をとりながら、これからの洋上風力のあり方についても積極的に取り組んでまいりたい"@ja.
<< kg:id_9 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "松前町と致しましても、洋上風力にかかる促進区域の指定がなされるように、国に手を挙げていきたいというふうに考えております"@ja.
<< kg:id_9 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "促進区域の指定にかかる情報提供という形で実施されて、基礎的データの収集や利害関係人の特定とその理解が必要となり"@ja.
<< kg:id_9 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "さくら漁協と早急に協議を進めまして、まずは、促進区域の指定に向けた情報提供に理解が得れるような説明をしてまいりたい"@ja.
<< kg:id_9 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "松前町と致しましては、将来を見込み、日本のエネルギー供給に対応するために、そして町の活性化のためにも松前沖の洋上風力発電を積極的に推進していきたい"@ja.
}
