kg:st_1 rdfs:label "三浦昭雄君"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "設置や稼働による水産物資源への影響を踏まえ協議会設置を急ぐべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "漁場環境保全のため町独自の協議会設置を急ぐべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長 石山英雄君"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_3 prop:content "既に協議会を設立し発足している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "推進協議会は調査や影響を協議する場ではなく協調策の情報共有の場と認識してほしい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "水産資源への影響は別途法定協議会で専門家を交えて話し合う考え"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "勇谷鷹宇君"@ja.
kg:st_3 rdf:type cls:st_9.
kg:op_6 prop:content "人口減少と少子高齢化が進む中で将来を見据えた取組が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "高齢化が進み人口減少に歯止めがかからないことを懸念"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "高齢者増加と人材不足で行政サービスが十分に届かなくなる不安がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "人口比で行政側の人員が減り対応しきれない部分が出ると不安視"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "将来の暮らしや行政効率のため具体的議論を進めるべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "コンパクトシティ構想を計画と合わせて根付かせたい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "特殊通行規制区間の解消に向け早期完成を目指す"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "越波などによる通行止め多発の解消が必要"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "住民や交通に影響が出ており早期完成が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "住民の安心安全確保のため規制区間を解消したい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "福島町と連携して予算確保と早期完成を積極的に要望する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:st_4 rdfs:label "斉藤勝君"@ja.
kg:st_4 rdf:type cls:st_9.
kg:op_17 prop:content "十年ではなく七年程度で進めるようスピード感を求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "再生可能エネルギーの波及効果で人口減少に資する対策を図りたい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "再エネを活用して企業誘致を進め人口減少対策につなげたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "雇用の場を確保して人口減少対策を進めたい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "町長と職員が積極的に町民へ啓蒙してほしい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "町民が参加しやすい情報提供をしながら進めたい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "東急不動産との協定内容の説明を求める"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "風力発電の円滑な推進と地域活性化に関する協定を締結した"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "洋上風力発電に関わる設置、稼働による水産物資源への影響"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "洋上風力発電に関わる設置、稼働による水産物資源への影響、漁場環境の保全など、町独自の協議会の設置を急ぐべきではないでしょうか"@ja.
<< kg:id_4 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "先般、８月の２１日に、松前町脱炭素再生可能エネルギー推進協議会を設立、発足しているところであります"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "この協議会につきましては、町の推進協議会になりまして、洋上風力発電の調査や影響などを協議する場ではなく、あくまでも漁協が考える協調策などを情報共有し、各団体にも理解を深めてもらうっていう場所である"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "洋上風力の設置、稼働による水産資源への影響等につきましては、これは別途法定、これは法定協議会の場で、これは専門家も入りながら話し合われる"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "全国的に人口減、人口減少、少子化、高齢化に歯止めがかからない今、当町でもこれは例外ではありません"@ja.
<< kg:id_8 prop:cause kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "全国的に人口減、人口減少、少子化、高齢化に歯止めがかからない今、当町でもこれは例外ではありません"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "高齢者が多くなるという点で行政のサービス、これがなかなか行き届かない、人材不足"@ja.
<< kg:id_8 prop:effect kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "行政の方の人も増えない、逆に減ってるのかっていう、人口比でいくと多分減っていくんだと思うんです。そうするとやりきれない部分も出てきやしないかと、ちょっと不安がある"@ja.
<< kg:id_4 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "住み続けたいまちづくりに繋がると、私は考えているコンパクトシティ実現に向けた考えです コンパクトシティに向けた取り組みも含めまして、いろいろな政策を検討していかなければならない"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "これまでにも落石や越波などにより通行止めが多発し、様々な影響を受けていたところであります"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "これまでにも落石や越波などにより通行止めが多発し、様々な影響を受けていたところであります"@ja.
<< kg:id_14 prop:effect kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "通行止めが多発し、様々な影響を受けていたところであります"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "まずもって、特殊通行規制区間を解消し、住民の安心安全を確保し、緊急輸送、交通に影響を及ぼすことのないよう、早期の完成に向け"@ja.
<< kg:id_18 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "早期の完成に向け、福島町と協力しながら関係機関への要望を、積極的にやっていきたい もう１０年じゃなくて７年で、スピード感をもってやれ"@ja.
<< kg:id_8 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "移住定住、更には企業誘致、更には新しい雇用の場の確保などで人口減少に資する対策を図れるように努力していきたい"@ja.
<< kg:id_8 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "移住定住、更には企業誘致、更には新しい雇用の場の確保などで人口減少に資する対策を図れるように努力していきたい"@ja.
<< kg:id_8 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "移住定住、更には企業誘致、更には新しい雇用の場の確保などで人口減少に資する対策を図れるように努力していきたい"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "町民ができる脱炭素とは何かというふうな、ゴミの減量化などなどであります 町長から進んで、職員が積極的になって町民に啓蒙していくように努力してほしい"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "東急不動産と協定を結んでおります 令和元年の１２月にリエネ松前風力発電所を所有する東京の大手企業と風力発電の円滑な推進と、地域活性化などに関する協定を締結したところでございます"@ja.
}
