kg:st_1 rdfs:label "町長若佐智弘君"@ja.
kg:st_1 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_1 prop:content "配電事業ライセンスは厳しく技術的にも問題がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "安い電気の供給には早くても３年以上かかる場合がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "取り組み継続が必要で様々な障害がある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "発電事業者の予定変更もあり得るため時期は変わり得る"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "漁業者"@ja.
kg:st_2 rdf:type cls:st_18.
cls:st_18 rdfs:label "生産者"@ja.
kg:op_5 prop:content "人件費負担が重く家業として成り立ちにくい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "核家族化で従来の家内労働型の漁業経営は難しくなっている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "前年を上回る結果となった"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "見送りでも構想は継続し実現に向け取り組む"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "関連企業との連携や新規連携先開拓で構想実現を進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "町民に安い電気を届けたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "好機を逃さず新しい雇用の場の創造に繋げたい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "町民の理解と不安解消に努めながら進める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "地域電力会社を今年度中に立ち上げる方向性を見いだしたい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "町民の理解と不安解消に努めながら進める"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "第６回があれば手を挙げたい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "関連企業と情報共有しながら継続して取り組む"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "今年度中の立ち上げ方向を明確にしたい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "会社設立後に新たな陸上風力や太陽光発電等を設置していく"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "情報を常に把握し一日でも早く町民に実感してもらいたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "共同養殖など新たな動きを進めたい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "現状で何ができるかを漁協と継続的に探求する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "環境が整い次第第６回があれば応募したい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "当初は町と協力企業１社で始める想定である"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "将来的には民間へ移行し新しい産業と雇用を根付かせたい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "交付金がない場合の採算性を様々な角度から精査している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "小水力を含め様々な可能性を調査し結果を踏まえて進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "町内の産業団体等と内容理解と協議を重ねている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "この要因としては、新型コロナウイルス感染症の法律上の位置づけが「５類感染症」に移行されてから初の大型連休を迎えたことに加えて"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "昨年よりまつり期間が１日長かったこと"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "期間を通して天候に恵まれ"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:text-txt_contents "桜の見頃が大型連休後半まで楽しめたことで"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:text-txt_contents "「にっぽん丸」のクルーズツアーは、風の影響で寄港は叶いませんでした"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:text-txt_contents "これまでに７３ヶ所が採択され、残りわずか２７ヶ所程度と狭き門である"@ja.
<< kg:id_8 prop:cause kg:id_10 >>
    prop:text-txt_contents "まだ１自治体も採択されていない都道府県が１１都県あることから、環境省としては積極的にこれらの空白県に先行地域を設けたいとの意向もあります"@ja.
<< kg:id_8 prop:cause kg:id_11 >>
    prop:text-txt_contents "環境省の提案審査は、全国の自治体に横展開を促し、脱炭素ドミノを起こすため、事業の先進性、モデル性を最重要視する基準強化がなされたところであります"@ja.
<< kg:id_8 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "日本でまだ例のない「配電事業ライセンス」の取得を提案に盛り込むべく、関係機関及び関係省庁と協議し、助言を受けながら検討してまいりましたが、事業の採算性や技術的課題をクリアできず、実現性が非常に困難であるとの判断に至りました"@ja.
<< kg:id_8 prop:cause kg:id_13 >>
    prop:text-txt_contents "提案書提出期限までに事業構築の精度と確実性が募集水準を満たすことは難しいと判断し、第５回脱炭素先行地域計画提案の応募を見送ることとし"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "そういう地域電力会社を立ち上げてから、また自分達、その会社自体で新たな陸上風力、太陽光発電等を設置していくことになりますので、早くても３年か、もっとかかる場合もあります"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "その取り組みを継続してやっていかなければ、様々な障害もありますし"@ja.
<< kg:id_14 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "それぞれつくった再エネの発電事業者も、場合によっては当初の予定と変わることもあります"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "正直漁業者１千万、今の家族構成を見ますと１千万水揚げしても、やはり賃金、人を雇わなきゃなんない、それで５００万６００万賃金を要するのであれば、その事業は自分のところで家業として、一つとして成り立つかというと難しい問題があるというのが、これが漁業者の意見でございました"@ja.
<< kg:id_18 prop:cause kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "今やはり核家族化が進みまして、こういう取り組みもなかなか難しいものがあります"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "さくらまつり期間中の入込数については、前年比１８．２％増の９万１千人となり、前年を上回る結果となりました"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:text-txt_contents "松前公園に新たな名所として「伊達花桃通り」が誕生しました"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:text-txt_contents "松前神楽・郷土芸能公開公演をはじめ、海上自衛隊大湊音楽隊による新町発足７０周年記念コンサート、藩屋敷こどもイベント、さくらスタンプラリーなど催しが行われ、賑わいを見せていました"@ja.
<< kg:id_8 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "この見送りによって、再生可能エネルギーの地産地消を目指す「ＲＥ１００まつまえ構想」が途絶えるわけではなく"@ja.
<< kg:id_8 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これまでどおり関連企業との連携や新しい連携先の開拓などの創意工夫により、構想の実現に向けて取り組みを進めてまいります"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:text-txt_contents "既に松前沖の法定協議会が２回開催され、道内五つの有望な区域の中で協議が最も進んでいる状況にあり"@ja.
<< kg:id_29 prop:effect kg:id_31 >>
    prop:text-txt_contents "いち早い指定に向けた明るい兆しも見えてきております"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "町民の皆様に安価な電気を供給するとともに"@ja.
<< kg:id_32 prop:effect kg:id_34 >>
    prop:text-txt_contents "企業誘致や産業の経営基盤の安定化を図り"@ja.
<< kg:id_32 prop:effect kg:id_35 >>
    prop:text-txt_contents "電気料金の地域内循環を進めてまいります"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "この好機を逃すことなく、新しい雇用の場となる産業の創造"@ja.
<< kg:id_36 prop:effect kg:id_38 >>
    prop:text-txt_contents "既存産業の維持活性化に繋げるとともに"@ja.
<< kg:id_36 prop:effect kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "町民の皆様のご理解並びに不安の解消に努めながら"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:text-txt_contents "町民の皆様と一緒に脱炭素化を推進する取り組みとして、省エネ機器の購入支援をスタートしております"@ja.
<< kg:id_32 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "今後は、再エネ電気を発電、売電する地域エネルギー会社を設立し"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:text-txt_contents "地域内で再エネ電気を循環させる「ＲＥ１００まつまえ」を実現させ"@ja.
<< kg:id_36 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "洋上風力発電事業の促進区域指定に向け協議を進めておりますが、町民の皆様のご理解並びに不安の解消に努めながら"@ja.
<< kg:id_8 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "機会があれば次回以降も応募の可能性について検討をしてまいります"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "これまでどおり関連企業との連携や新しい連携先の開拓などの創意工夫により、構想の実現に向けて取り組みを進めてまいります"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:text-txt_contents "引き続き、当町の脱炭素化社会の実現と再生可能エネルギーの推進に注力してまいります"@ja.
<< kg:id_51 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地域電力会社を今年度中に何とか立ち上げる方向性をしっかりと見い出していきたいというふうに考えております"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "その会社自体で新たな陸上風力、太陽光発電等を設置していくことになります"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "常にそういう情報は常に手に入れて、そして、一日でも早く町民に実感していただけるような形をとりたいと思っております"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "また最近は漁業者が共同で養殖コンブに取り組むとか、そういう新たな動きも出てございます"@ja.
<< kg:id_57 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "残った若い漁業者、そしてある程度の年齢になってもそういう漁業者が一緒になって取り組んでいける、そういう増養殖に対して、私ども、松前さくら漁業協同組合と共に探求してまいりたいと"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "環境が整い次第、第６回があればそれに対して手を挙げていきたい"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "この地域電力会社は、当初は松前町と協力企業１社でのスタートと考えて今想定しております"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "将来的には町内事業者から出資を募り、町の関与を徐々に減らしながら民間へ移行し、新しい産業と雇用を地域に根付かしていきたいと考えております"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:text-txt_contents "本年１月に脱炭素推進課を新たに設置し、６月１日付の人事異動によりまして１名増員し、４名体制として脱炭素、再エネ政策を積極的に進めているところでございます"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "交付金のない場合の採択されないという場合を想定しての、今採算性について、様々な先ほど言ったものについての内容を精査しております"@ja.
<< kg:id_68 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "小水力発電に関しても調査をさせていただいておるところでございますし、様々な可能性のあるものにとにかくチャレンジしながら、これに取り組んでいきたい"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:text-txt_contents "町広報の方にも町民向けに、既に１１回目の、６月号で１１回目となる情報掲載をしております"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "松前町脱炭素再生可能エネルギー推進協議会というものをつくっております。これに関しましては町内の産業団体、そして商工、観光、金融機関、そして建設、建築、管工事、このような協会、そしてまた北電の電力のネットワーク、また町、当然町も入りまして、こういうところで何度もこういうものについての内容の理解と協議を進めております"@ja.
}
