kg:st_1 rdfs:label "佐野洋平議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "事業内容の理解不足があり情報公開と分かる化が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "市民の間に情報格差があり前提事実の共有が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "山形県知事"@ja.
kg:st_2 rdf:type cls:st_26.
cls:st_26 rdfs:label "知事"@ja.
kg:op_3 prop:content "土砂災害の懸念から抜本的見直しを求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "事業の取りやめも含めた見直しが必要"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "工事に伴う地滑り発生の懸念が大きい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "土砂災害の懸念がある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "造成地の崩壊や土砂流出を懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "イヌワシ保全の観点から重大な懸念がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "重要な採食地であり計画見直しが必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "事業の取りやめも含めた見直しを求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "イヌワシ保全や土砂災害懸念から抜本的見直しが必要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:st_3 rdfs:label "米沢市長"@ja.
kg:st_3 rdf:type cls:st_27.
cls:st_27 rdfs:label "市長"@ja.
kg:op_12 prop:content "必要性や不可逆性や自然環境や景観との調和を総合的に検討し全面白紙撤回を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "気候変動対策と生物多様性保全を両立させるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "一方の問題解決のために他方を犠牲にすることは望ましくない"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "市民に十分理解されていないため情報公開が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "説明責任を果たすため見える化が必要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "市民理解を進めるため分かる化が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "何が重要かを明確にして説明責任を果たすべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "住民理解が得られたとは言い難い"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "地域との共生には住民理解が欠かせない"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:st_4 rdfs:label "米沢市"@ja.
kg:st_4 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_21 prop:content "市民の理解が必要不可欠であり説明責任を果たすよう求めた"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "反映されない場合は事業計画を是認しない可能性がある"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "説明会の回答は極めて不十分だった"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "住民理解のため追加説明会を求めた"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "資料公開を文書で求めた"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "説明内容の透明化のため公開を求めた"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "地域裨益を具体的に示すよう求めた"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "事業者の回答は市の期待と大きく異なっていた"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "事業の根幹に関わる重大な懸念として重く受け止める"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "県知事意見書は極めて厳しい内容だ"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "様々な懸念があり重く受け止める必要がある"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "不可逆性を踏まえこのまま進めるべきではない"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "自然への影響を踏まえ事業を進めるべきではない"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "環境への影響を踏まえ事業を進めるべきではない"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "景観への影響を総合的に考慮した"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "安全性の観点からも事業を進めるべきではない"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "地域裨益も含め総合判断した"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "市民や専門家の懸念を踏まえ全面撤回を申し入れた"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "計画見直しがあっても不安払拭は極めて難しい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:st_5 rdfs:label "米沢市市民環境部長"@ja.
kg:st_5 rdf:type cls:st_28.
cls:st_28 rdfs:label "部長"@ja.
kg:op_40 prop:content "本市の意向に沿う説明会ではなかった"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:st_6 rdfs:label "米沢市産業部長"@ja.
kg:st_6 rdf:type cls:st_28.
kg:op_41 prop:content "是正指導を実施し計画書提出を確認した"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_6.
kg:op_42 prop:content "市と県で協議し是正指導した"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_6.
kg:st_7 rdfs:label "米沢市建設部長"@ja.
kg:st_7 rdf:type cls:st_28.
kg:op_43 prop:content "出来形計測結果の提出を求めた"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_7.
kg:op_44 prop:content "確定した場合は法律に照らして適切に指導する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_7.
kg:op_45 prop:content "風力発電は周囲の景観に大きな影響を与える可能性がある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_7.
kg:op_46 prop:content "生物多様性と生態系を保持してきた場所の重みを理解すべき"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "このそごは事業者の信頼性を失わせている"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "営巣地認識のそごは重大である"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "主要な餌場ではないとする事業者見解と大きく異なる"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "今後のまちづくりの環境基準の準則にしていく必要がある"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "脱炭素先行地域をはじめ環境政策に迅速な調査が必要"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "再エネ規制の動きも見ながら対応を検討する"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_5.
kg:op_53 prop:content "示された内容であればスカイラインから突出している"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "景観計画の実効性がないものになってしまう"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "情報公開に加え強制力を持つ措置は研究しなければならない"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "当事者性を持つためにも情報公開が第一歩だ"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
