    prop:text-txt_contents "対象事業が周辺の自然環境、地域生活環境などに与える影響について"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "谷筋の大規模盛土の土砂崩壊による土石流の発生"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "谷筋の大規模盛土の土砂崩壊による土石流の発生"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "対象事業実施区域内に地滑り地形が存在することから"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "本工事に伴う地滑りの発生など土砂災害の懸念"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本工事に伴う地滑りの発生など土砂災害の懸念"@ja.
<< kg:id_1 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "対象事業実施区域内は絶滅が危惧されるニホンイヌワシの飛翔が多数確認され"@ja.
<< kg:id_1 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "重要な採食地、餌場になっており"@ja.
<< kg:id_1 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "事業対象区域近傍では営巣している蓋然性が高いとして"@ja.
<< kg:id_1 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "事業の取りやめも含め抜本的な事業の見直しを求められています"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "米沢市長は当該事業の必要性や不可逆性、本市の自然や環境、景観、精神文化との調和、本市への地域裨益など総合的に熟慮・検討した結果として、当該事業の全面白紙撤回を求めました"@ja.
<< kg:id_1 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "再生可能エネルギーの不適切な導入を指導することを含め、生物多様性の損失を阻止し"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "生物多様性の損失を阻止し"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "情報公開、情報の見える化はもちろん"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "情報公開、情報の見える化はもちろん"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "内容の理解、分かる化"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "何が大切で重要なのか重みづけ化することで、説明責任、アカウンタビリティーを果たす必要がある"@ja.
<< kg:id_1 prop:cause kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "住民からの事業計画に対する様々な意見や事業への懸念に対し、誠実かつ丁寧に説明してきたとは言えず"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "住民の理解が得られたとは言い難いと認識しております"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "市民の理解が必要不可欠であり、事業者として説明責任を果たすよう求めてまいりました"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "住民の意見を真摯に受け止め、事業計画に適切に反映されない場合は、事業計画を是認しない可能性がある"@ja.
<< kg:id_1 prop:effect kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "極めて不十分な回答が多く、本市民の理解が得られたとは言い難い"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "早期に追加説明会を開催すること"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "準備書、会議録の公開を文書で"@ja.
<< kg:id_1 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "準備書、会議録の公開を文書で"@ja.
<< kg:id_1 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "本市への地域貢献の内容を具体的に提案するよう口頭で求めてまいりました"@ja.
<< kg:id_1 prop:cause kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "同事業者には、本市や住民との協力関係を構築する意欲が欠けていると受け止めております"@ja.
<< kg:id_1 prop:cause kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "特に、イヌワシの保全については"@ja.
<< kg:id_1 prop:cause kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "造成地の崩壊及び土砂流出"@ja.
<< kg:id_1 prop:cause kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "地滑り等、様々な懸念"@ja.
<< kg:id_1 prop:effect kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "起きてからでは後戻りできない状況に陥るおそれがある不可逆性"@ja.
<< kg:id_1 prop:effect kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "本市の自然や環境、景観、安全性"@ja.
<< kg:id_1 prop:effect kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "本市の自然や環境、景観、安全性"@ja.
<< kg:id_1 prop:effect kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "本市の自然や環境、景観、安全性"@ja.
<< kg:id_1 prop:effect kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "本市の自然や環境、景観、安全性"@ja.
<< kg:id_1 prop:effect kg:id_38 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "さらには本市への地域裨益など総合的に熟慮、検討した結果"@ja.
<< kg:id_1 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "８月29日に同社本社を訪問、松本義弘社長と面談し、全面撤回を求める申入れをした"@ja.
<< kg:id_1 prop:effect kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "多くの市民の不安を払拭するのは極めて難しい"@ja.
<< kg:id_1 prop:effect kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "質問や意見に対する回答は誠意が感じられず、住民の理解を得られたものではなかった"@ja.
<< kg:id_1 prop:cause kg:id_42 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "現場確認では一部に直径の大きな木の伐採跡が見受けられました"@ja.
<< kg:id_1 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "小規模林地開発計画書を県へ提出するよう事業者に対して是正指導を実施し"@ja.
<< kg:id_1 prop:cause kg:id_44 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "結果として届出対象基準の3,000平方メートルを超える疑義が生じた"@ja.
<< kg:id_1 prop:effect kg:id_45 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "無届けでの行為の着手案件として確定した場合には"@ja.
<< kg:id_1 prop:effect kg:id_46 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "特に山間部など自然環境が豊かな地域では、その美しい景観が損なわれる懸念がある"@ja.
<< kg:id_1 prop:effect kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "動物の重要種、要するに今言った絶滅が危惧されるような重要種が、哺乳類17種、鳥類78種、爬虫類７種、両生類10種、昆虫類110種、魚類17種、底生動物９種、陸産貝類７種、そして植物種73科214種"@ja.
<< kg:id_1 prop:cause kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "事業者と山形県知事意見では、イヌワシに関する大きな理解のそごがありました"@ja.
<< kg:id_1 prop:cause kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "山形県知事意見書では、総合的に判断すると、準備書に記載している10キロメートル離れた営巣地のペアのほかに、事業実施区域近傍でイヌワシが営巣している蓋然性が高いとしています"@ja.
<< kg:id_1 prop:cause kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "山形県は、餌資源量指数が高く、イヌワシにとって貴重な採食地となっている可能性が高いとしています"@ja.
<< kg:id_1 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "ネイチャーポジティブをしっかり受け止めて研究し、今後のまちづくりの環境基準の準則にしていく必要がある"@ja.
<< kg:id_1 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "米沢市の今後の環境の在り方について迅速に御調査なさってお調べいただきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "ネイチャーポジティブと併せまして、今後検討してまいりたい"@ja.
<< kg:id_1 prop:effect kg:id_54 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "現在見せていただいている内容であれば、スカイラインから突出しているものという捉え方をしている"@ja.
<< kg:id_1 prop:effect kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "これは勧告なわけですから、強行された場合、止められないわけです"@ja.
<< kg:id_1 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "市においても、ある程度強制力を持った力を持つ何かの措置は研究しなければいけない"@ja.
<< kg:id_1 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "当事者性を持つためにも、やはりきちんと事業者に入り口で情報公開させるということが重要"@ja.
}
