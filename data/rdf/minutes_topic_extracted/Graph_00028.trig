PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00028> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "酒田市沖の洋上風力発電事業"@ja.
kg:id_1 rdf:type cls:c_798.
cls:c_798 rdfs:label "洋上風力事業"@ja.
kg:id_2 rdfs:label "山形県と連携して地域の意見の取りまとめに注力"@ja.
kg:id_2 rdf:type cls:c_817.
cls:c_817 rdfs:label "意見集約"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "遊佐町沖の洋上風力発電事業"@ja.
kg:id_3 rdf:type cls:c_798.
kg:id_4 rdfs:label "酒田港の基地港湾の指定を見据えた港湾施設整備の推進を国や山形県に働きかける"@ja.
kg:id_4 rdf:type cls:c_125.
cls:c_125 rdfs:label "港湾整備"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "風力発電事業特別会計予算"@ja.
kg:id_5 rdf:type cls:c_818.
cls:c_818 rdfs:label "予算"@ja.
kg:id_6 rdfs:label "総額を４億3,359万7,000円とする"@ja.
kg:id_6 rdf:type cls:c_819.
cls:c_819 rdfs:label "予算総額"@ja.
kg:id_5 prop:countermeasure kg:id_6.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "酒田市沖の洋上風力発電事業については、海洋再生可能エネルギー発電設備の整備に係る海域の利用の促進に関する法律に基づく法定協議会において、山形県と連携して、地域の意見の取りまとめに注力していきます"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "また、遊佐町沖の洋上風力発電事業の拠点となる酒田港の基地港湾の指定を見据えた港湾施設整備の推進を国や山形県に働きかけます"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "議第23号については、風力発電事業特別会計予算の総額を４億3,359万7,000円とするものであります"@ja.
}
