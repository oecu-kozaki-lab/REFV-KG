PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00032> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電事業"@ja.
kg:id_1 rdf:type cls:c_218.
cls:c_218 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "発電所建設工事の発注"@ja.
kg:id_2 rdf:type cls:c_85.
cls:c_85 rdfs:label "建設工事"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "風力発電管理施設の建設"@ja.
kg:id_3 rdf:type cls:c_919.
cls:c_919 rdfs:label "管理施設"@ja.
kg:id_1 prop:countermeasure kg:id_3.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "令和３年初頭の運転開始に向けて、発電所建設工事を発注するとともに"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:text-txt_contents "維持管理の拠点となる風力発電管理施設を建設しました"@ja.
}
