kg:id_1 rdfs:label "酒田市風力発電事業発電所建設工事"@ja.
kg:id_1 rdf:type cls:c_938.
cls:c_938 rdfs:label "発電所建設"@ja.
kg:id_2 rdfs:label "遠隔出力制御装置の整備を行う必要が生じたこと"@ja.
kg:id_2 rdf:type cls:c_939.
cls:c_939 rdfs:label "設備整備必要"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "令和元年度風力発電事業特別会計予算"@ja.
kg:id_3 rdf:type cls:c_940.
cls:c_940 rdfs:label "事業予算"@ja.
kg:id_4 rdfs:label "風力発電施設整備事業費（本体施設整備）ほか１件、合計５億2,557万6,000円を令和２年度に逓次繰越し"@ja.
kg:id_4 rdf:type cls:c_941.
cls:c_941 rdfs:label "予算繰越"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "風力発電事業特別会計予算"@ja.
kg:id_5 rdf:type cls:c_940.
kg:id_6 rdfs:label "226万1,000円増額"@ja.
kg:id_6 rdf:type cls:c_942.
cls:c_942 rdfs:label "予算増額"@ja.
kg:id_5 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "遠隔出力制御装置の設置"@ja.
kg:id_7 rdf:type cls:c_319.
cls:c_319 rdfs:label "設備設置"@ja.
kg:id_8 rdfs:label "風力発電施設管理事業費及び風力発電施設整備事業費を増額"@ja.
kg:id_8 rdf:type cls:c_943.
cls:c_943 rdfs:label "事業費増額"@ja.
kg:id_7 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "繰入金及び市債を増額"@ja.
kg:id_9 rdf:type cls:c_944.
cls:c_944 rdfs:label "財源増額"@ja.
kg:id_7 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "地方債補正として風力発電事業費の限度額を変更"@ja.
kg:id_10 rdf:type cls:c_945.
cls:c_945 rdfs:label "起債条件変更"@ja.
kg:id_7 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "請負金額を変更"@ja.
kg:id_11 rdf:type cls:c_946.
cls:c_946 rdfs:label "請負額変更"@ja.
kg:id_1 prop:effect kg:id_11.
kg:id_12 rdfs:label "工期を変更"@ja.
kg:id_12 rdf:type cls:c_947.
cls:c_947 rdfs:label "工期変更"@ja.
kg:id_1 prop:effect kg:id_12.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "遠隔出力制御装置の整備を行う必要が生じたことにより"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "令和元年度風力発電事業特別会計予算において継続費を設定しておりました風力発電施設整備事業費（本体施設整備）ほか１件、合計５億2,557万6,000円を令和２年度に逓次繰越ししたものであります"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "議第56号については、風力発電事業特別会計予算を226万1,000円増額し、予算総額を14億5,856万1,000円とするものあります"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "このたびの補正は、遠隔出力制御装置の設置に伴うもので、歳出では、風力発電施設管理事業費及び風力発電施設整備事業費を"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "歳入では、繰入金及び市債をそれぞれ増額し"@ja.
<< kg:id_7 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "また、地方債補正として風力発電事業費の限度額を変更しております"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:text-txt_contents "請負金額及び工期を変更するため"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:text-txt_contents "請負金額及び工期を変更するため"@ja.
