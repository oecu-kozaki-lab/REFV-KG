  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "ゼロカーボンシティ宣言をしないこと"@ja.
kg:id_1 rdf:type cls:c_967.
cls:c_967 rdfs:label "宣言不実施"@ja.
kg:id_2 rdfs:label "酒田共同火力発電株式会社の石炭火力発電所が稼働し山形県消費電力の約半分を供給していること"@ja.
kg:id_2 rdf:type cls:c_968.
cls:c_968 rdfs:label "石炭火力発電"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "発電事業が受発注取引、良質な雇用の確保、地方税収、酒田港の貨物取引など地域経済を牽引していること"@ja.
kg:id_3 rdf:type cls:c_969.
cls:c_969 rdfs:label "地域経済への貢献"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "クールチョイス宣言"@ja.
kg:id_4 rdf:type cls:c_970.
cls:c_970 rdfs:label "環境宣言"@ja.
kg:id_5 rdfs:label "家庭部門のCO2排出量が年々減少傾向にあること"@ja.
kg:id_5 rdf:type cls:c_971.
cls:c_971 rdfs:label "CO2排出量の減少"@ja.
kg:id_4 prop:effect kg:id_5.
kg:id_6 rdfs:label "産業部門のCO2排出量も減少傾向にあること"@ja.
kg:id_6 rdf:type cls:c_971.
kg:id_4 prop:effect kg:id_6.
kg:id_7 rdfs:label "省エネや節電への取組の減少"@ja.
kg:id_7 rdf:type cls:c_972.
cls:c_972 rdfs:label "省エネ取組の減少"@ja.
kg:id_8 rdfs:label "昨今のコロナ禍による影響"@ja.
kg:id_8 rdf:type cls:c_973.
cls:c_973 rdfs:label "感染症流行の影響"@ja.
kg:id_7 prop:cause kg:id_8.
kg:id_9 rdfs:label "市民や事業者の意識が減少傾向、悪化傾向にあること"@ja.
kg:id_9 rdf:type cls:c_974.
cls:c_974 rdfs:label "意識の低下"@ja.
kg:id_7 prop:effect kg:id_9.
kg:id_10 rdfs:label "クールチョイス"@ja.
kg:id_10 rdf:type cls:c_975.
cls:c_975 rdfs:label "環境行動"@ja.
kg:id_11 rdfs:label "市民や事業者向けにさらに周知を進めて浸透を図ること"@ja.
kg:id_11 rdf:type cls:c_976.
cls:c_976 rdfs:label "周知活動"@ja.
kg:id_10 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "温室効果ガス削減"@ja.
kg:id_12 rdf:type cls:c_977.
cls:c_977 rdfs:label "温室効果ガス削減"@ja.
kg:id_13 rdfs:label "市直営の風力発電事業に取り組み運転を開始すること"@ja.
kg:id_13 rdf:type cls:c_674.
cls:c_674 rdfs:label "風力発電導入"@ja.
kg:id_12 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "洋上風力発電の導入に向けた要望や協議を重ねること"@ja.
kg:id_14 rdf:type cls:c_674.
kg:id_12 prop:countermeasure kg:id_14.
kg:id_15 rdfs:label "再エネ循環都市宣言につなげること"@ja.
kg:id_15 rdf:type cls:c_970.
kg:id_12 prop:countermeasure kg:id_15.
kg:id_16 rdfs:label "CO2排出量削減"@ja.
kg:id_16 rdf:type cls:c_978.
cls:c_978 rdfs:label "CO2排出量削減"@ja.
kg:id_17 rdfs:label "消灯やクールビズやウオームビズによる電気使用量の削減"@ja.
kg:id_17 rdf:type cls:c_979.
cls:c_979 rdfs:label "省エネ行動"@ja.
kg:id_16 prop:countermeasure kg:id_17.
kg:id_18 rdfs:label "照明のLED導入による削減"@ja.
kg:id_18 rdf:type cls:c_980.
cls:c_980 rdfs:label "設備更新"@ja.
kg:id_16 prop:countermeasure kg:id_18.
kg:id_19 rdfs:label "低燃費車の導入やエコドライブやエコ通勤デーの推進"@ja.
kg:id_19 rdf:type cls:c_981.
cls:c_981 rdfs:label "交通行動の改善"@ja.
kg:id_16 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "ごみの減量やリサイクルやグリーン購入の推進"@ja.
kg:id_20 rdf:type cls:c_982.
cls:c_982 rdfs:label "資源循環"@ja.
kg:id_16 prop:countermeasure kg:id_20.
kg:id_21 rdfs:label "J-クレジット制度"@ja.
kg:id_21 rdf:type cls:c_983.
cls:c_983 rdfs:label "排出量取引制度"@ja.
kg:id_22 rdfs:label "広報やホームページなど各種媒体により市民や市内企業への周知を進めること"@ja.
kg:id_22 rdf:type cls:c_976.
kg:id_21 prop:countermeasure kg:id_22.
kg:id_23 rdfs:label "地球温暖化対策"@ja.
kg:id_23 rdf:type cls:c_984.
cls:c_984 rdfs:label "地球温暖化対策"@ja.
kg:id_24 rdfs:label "市全体を包含する区域施策編の策定を検討すること"@ja.
kg:id_24 rdf:type cls:c_118.
cls:c_118 rdfs:label "計画策定"@ja.
kg:id_23 prop:countermeasure kg:id_24.
kg:st_1 rdfs:label "後藤泉議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "酒田共同火力発電がある以上ゼロカーボンシティ宣言をしない判断は納得できる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "酒田共同火力発電が地域に与える影響を踏まえると宣言しない判断は理解できる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "矢口明子副市長"@ja.
kg:st_2 rdf:type cls:st_40.
cls:st_40 rdfs:label "行政"@ja.
kg:op_3 prop:content "コロナ禍の影響でクールチョイスによるCO2削減への意識が高まりにくい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "市民の認知度が十分向上していない可能性がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "一般市民にも行き渡るようPRをさらに進めてほしい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "脱炭素政策を進める姿勢を県や全国や市民に発信すべきだ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "クレジット化できるものは売買して市の役に立つ資金として活用できるよう検討してほしい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "市民向けにも温暖化対策の基本となる指針的な計画を早急に作成してほしい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "そのため、当該発電所が稼働している現状においては、ゼロカーボンシティ宣言は考えていないところでございます。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "また、発電事業を通じた波及効果として、受発注取引、それから良質な雇用の確保、地方税収、酒田港の貨物取引など極めて大きく、地域経済を牽引する中核企業の一つであります。そのため、当該発電所が稼働している現状においては、ゼロカーボンシティ宣言は考えていないところでございます。"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "クールチョイス宣言後の本市でのＣＯ２排出量は、家庭部門で年々減少傾向にあります。"@ja.
<< kg:id_4 prop:effect kg:id_6 >>
    prop:text-txt_contents "また、産業部門においても同様の傾向が見られます。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "昨今のコロナ禍による影響もありまして、クールチョイスによるＣＯ２排出量の削減に対する意識が高まりにくいということはあります"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "市民や事業者の意識としては、残念ながら省エネや節電への取組については減少傾向、悪化傾向にあったということでございます。"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "市民や事業者向けにさらに周知を進めることで、クールチョイスの浸透を図っていきたいと考えております。"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:text-txt_contents "具体的には、環境に十分配慮しながら市直営の風力発電事業に取り組み、今年４月から運転を開始しております。"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "山形県をはじめとする関係機関と洋上風力発電の導入に向けた要望や協議を重ね、今年度から酒田市沖での洋上風力発電に向けた検討が進められているところでございます。"@ja.
<< kg:id_12 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "そして再生可能エネルギーを地産地消する本市独自の宣言であります再エネ循環都市宣言、これは８月２日のカーボンニュートラルシンポジウムの際、登壇者の加藤俊治先生が御提案されていたものでございますが、そういった宣言につなげていきたいと考えております。"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:text-txt_contents "消灯、明かりを消すことやクールビズ、ウオームビズなどによる電気使用量の削減"@ja.
<< kg:id_16 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "それから照明のＬＥＤ導入による削減"@ja.
<< kg:id_16 prop:countermeasure kg:id_19 >>
    prop:text-txt_contents "低燃費車の導入やエコドライブ、エコ通勤デーの推進"@ja.
<< kg:id_16 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "ごみの減量やリサイクルの推進、グリーン購入などを積極的に進めており、ＣＯ２排出量削減に努めているところです。"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本市としても温室効果ガス削減に向けた取組としてＪ－クレジット制度の趣旨には賛同できることから、まずはＪ－クレジット制度について広報やホームページなど各種媒体により市民や市内企業への周知を進めたいと考えております。"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "来年以降、この区域施策編の策定を市として検討してまいりたいと、この中でＣＯ２削減について推進するということをしっかり見せていきたいなと考えているところでございます。"@ja.
}
