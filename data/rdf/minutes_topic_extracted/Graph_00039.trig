kg:id_85 rdfs:label "コロナ禍による観光地への影響"@ja.
kg:id_85 rdf:type cls:c_1058.
cls:c_1058 rdfs:label "観光への影響"@ja.
kg:id_86 rdfs:label "全国の観光地がにぎわいを失い酒田市でも全てのイベントが中止となった"@ja.
kg:id_86 rdf:type cls:c_1059.
cls:c_1059 rdfs:label "イベント中止"@ja.
kg:id_85 prop:effect kg:id_86.
kg:id_87 rdfs:label "クルーズ船寄港への影響"@ja.
kg:id_87 rdf:type cls:c_1060.
cls:c_1060 rdfs:label "寄港への影響"@ja.
kg:id_88 rdfs:label "昨年全てキャンセルとなった"@ja.
kg:id_88 rdf:type cls:c_1061.
cls:c_1061 rdfs:label "寄港中止"@ja.
kg:id_87 prop:effect kg:id_88.
kg:id_89 rdfs:label "在宅での居宅訪問型児童発達支援"@ja.
kg:id_89 rdf:type cls:c_1062.
cls:c_1062 rdfs:label "在宅支援"@ja.
kg:id_90 rdfs:label "感染リスクの低下と家族の負担軽減につながる"@ja.
kg:id_90 rdf:type cls:c_1063.
