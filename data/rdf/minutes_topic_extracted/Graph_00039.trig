kg:id_91 rdfs:label "人口構造の変化"@ja.
kg:id_91 rdf:type cls:c_1064.
cls:c_1064 rdfs:label "人口構造変化"@ja.
kg:id_92 rdfs:label "医療と介護の連携の必要性がこれまで以上に高まっている"@ja.
kg:id_92 rdf:type cls:c_1065.
