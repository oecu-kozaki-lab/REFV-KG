kg:id_91 prop:effect kg:id_92.
kg:st_1 rdfs:label "質問者"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "質問者"@ja.
kg:op_1 prop:content "港湾整備と企業集積が進み地域活性化につながると期待する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "洋上風力発電と港湾利活用は地域活性化に資するとみている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "環境変化への対応と挑戦を成長発展の好機と捉える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "酒田市長"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_4 prop:content "厳しい財源不足を想定し全事業を一件査定した"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "経常的支出のある事業の廃止などで財源確保に努めた"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "大学は地域活性化に大きく寄与している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "専門技術習得により即戦力人材が地域に貢献している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "産業界や自治体と連携した実践的なプログラムが必要だ"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "多様な年齢層とニーズに対応できる教育体制が必要だ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "コロナ禍のオンライン手続が市民サービスの在り方を見直す契機になった"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "いつでもどこでも利用可能な手続への需要は高い"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "新しい生活様式に合わせ非対面サービスを進める必要がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "地域運営の実効性を高める対策が必要だ"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "あらゆる関係者が協働する治水対策が必要だ"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "流域治水プロジェクトを計画的に推進すべきだ"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "中長期的な市街地浸水対策が必要だ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "将来にわたる計画的整備が必要だ"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "国体記念体育館は優先的な改修が必要だ"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "消費拡大とブランド戦略の強化が必要だ"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "港湾機能強化により貨物増加が期待できる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "新航路開設は港を物流拠点として活用する好機だ"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "薫蒸上屋の活用で輸出拡大が見込める"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "友好都市30周年に合わせ商談会を開き利用拡大につなげたい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "コロナ下でもオンライン活用で港湾振興を進める"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "通年薫蒸を可能にする機能強化を県へ要望する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "組織強化と県との連携で早期導入と指定を進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "県に対し早期導入と基地港湾指定への関与強化を要望した"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "大人の学び場として受講料補助を実施する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "デジタル化で取り残さないため人的支援を充てる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "人に優しいデジタル変革のため利用環境を整える"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "重点分野を明確化して予算編成を行った"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "真に必要な経費に絞り込むため全事業を精査した"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "コロナ対応に合わせて必要事業を取捨選択して再開する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "中期財政計画の目標値を意識して財政運営を行う"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "女性活躍推進法に基づく計画策定を促進する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "事業所の実情に応じた働きやすい職場づくりを後押しする"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "中小規模事業所の取組を独自制度で促進する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "自己啓発やデジタル人材育成で女性の多様な働き方を支援する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:st_3 rdfs:label "健康福祉部長"@ja.
kg:st_3 rdf:type cls:st_41.
cls:st_41 rdfs:label "部局長"@ja.
kg:op_39 prop:content "専門的な副反応相談は県が対応し市と役割分担する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:st_4 rdfs:label "地域創生部長"@ja.
kg:st_4 rdf:type cls:st_41.
kg:op_40 prop:content "キャッシュレス施策は幅広い業種の消費喚起に効果的だった"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "幅広い分野での活用が市のデジタル変革を着実に進める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "港湾整備や関連産業立地 雇用増加など広い経済波及が見込まれる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "洋上風力は産業と雇用を底上げする"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "食材PRと情報発信の面で有効だった"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "元のにぎわい回復は難しく体制強化が必要だ"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "失った寄港を取り戻すには受入れ体制整備と連携が必要だ"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "在宅支援は感染対策と家族支援の両面で有効だ"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "給付と負担のバランスを取り制度の持続可能性を確保すべきだ"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "遊佐町沖、酒田市沖それぞれが国の促進区域に指定され、同時に酒田港が拠点港湾となれば、港湾及び周辺整備も進められ"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "港湾及び周辺整備も進められ資機材や企業の集積地として利活用が進み、地域の活性化にもつながるものと思われます"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "コロナ禍による環境の変化に対応し、立ち向かい挑戦することが成長発展の好機であると思われます"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "コロナ禍による市税の減収、それから普通交付税の合併算定替えの終了等、厳しい財源不足を想定をして"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "令和元年度の時点で97.0％でございまして、限りなく100に近づきつつあるために、経常的な支出のある事業の廃止など経済・社会の再生に取り組むための財源を確保するように努めた"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "東北公益文科大学は、産学官連携による様々な施策によって地域活性化に大きく寄与しています"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "山形県立産業技術短期大学校庄内校は、専門的な技術の習得から即戦力として地域に貢献し100％の就職率を誇っています"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "労働者のニーズと雇用者のニーズ、それから高等教育機関が提供する学び、これが一致しない場合は、社会人の学び直しに低い効果しか及ぼさないおそれがある"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "様々な年齢や経験を持つ学生が相互に刺激を与えながら切磋琢磨するキャンパスを実現するためには、多様な年齢層の多様なニーズを持った学生に教育できる体制が必要であって、高等教育機関におけるリカレント教育の重要性が増している"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "設置に当たって、その大きなきっかけとなったのは、実はコロナ禍で国が行った特別定額給付金のオンライン手続でございました"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "このキャンペーンに応募された2,407人のうち、市役所が開いていない時間帯の応募者が76.1％を占めていることからも、いつでもどこでも利用可能なオンライン手続のニーズは高い"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "コロナ禍における新しい生活様式の一つとして、市役所に来ることなくサービスを受けられるようにしなければならない"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "地域の暮らしやコミュニティを守ることは喫緊の課題であり、人口減少により維持困難になることは誰もが危惧しているところです。しかし、対策となると特効薬もなく苦慮していますが、令和３年度施策として地域計画を策定し、実効性を高めるとしています"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "国は、近年の水害の甚大な被害により、2020年以降、水害対策の政策を新しい流域治水へと大きく転換し"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "山形県においては、昨年７月の豪雨により最上川で甚大な被害が発生したことから、最上川流域治水協議会を設置し"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "記録的な大雨から道路の冠水や家屋の浸水など、内水氾濫が発生しています。状況からして排水能力が追いつかないほどの雨が短時間に集中して降ったものと思われます"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "文化・体育施設の老朽化や財政の状況から安全な施設の維持管理が困難になることが想定されます"@ja.
<< kg:id_35 prop:cause kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "特に国体記念体育館は雨漏りがひどく大規模な改修工事が必要となっています"@ja.
<< kg:id_37 prop:cause kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "コロナ禍の影響により会合や外食の自粛の影響から消費が伸び悩んだとされています"@ja.
<< kg:id_39 prop:cause kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "酒田北港は機能強化が図られ、２基のガントリークレーンのほか、高砂２号岸壁の延伸整備も完了し、1,000トンＴＥＵクラスのコンテナ船２隻の同時着岸が可能となったことから、今後さらなる取扱貨物量の増加が期待されます"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "中国京唐港との新たな航路が開設されたことから日本酒の輸出につながった"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "酒田港の薫蒸上屋を活用した米の輸出も期待されており"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "中国との貿易に意欲のある企業を募って商談会を開催し、酒田港の利用拡大につなげていきたい"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "来年度は、新型コロナウイルスの状況を勘案しながら、プロスパーポートさかたポートセールス協議会において、オンラインを活用したセミナーなど工夫して取り組んでいきたい"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "精米の薫蒸が通年可能となるよう薫蒸上屋の機能強化などを山形県に要望してまいりたい"@ja.
<< kg:id_51 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "港湾振興室という部署が今あるんですけれども、ここを港湾・エネルギー振興係に改めまして、その機能と体制を強化するとともに、山形県と一体となって酒田市沖洋上風力発電の導入及び基地港湾の早期指定に向けた取組を進めていきたい"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "酒田市沖における洋上風力発電の早期導入に向けた一般海域の促進区域指定に係る取組の強化、それから酒田港を海洋再生可能エネルギー発電施設等拠点港湾、この基地港湾の指定に向けた検討について港湾管理者であります山形県の積極的な関与を要望をした"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "本市におきましては、社会人の多様なニーズに応じた様々な分野の学習機会を提供し、各種資格の取得と結びつけるなど、本市企業等と連携して社会人の職業キャリア形成及び自己啓発を支援するため、大人の学び場として東北公益文科大学で実施する履修証明プログラムや山形県立産業技術短期大学校庄内校で実施する社会人向け公開講座の受講料などの一部に対して１人当たり3,000円を下限として、対象費用の２分の１を補助する事業を実施する"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "デジタル弱者と呼ばれる方々も存在するわけでございまして、こういった方々に対しましては、行政のデジタル変革で効率化されたことによる余力を、マンパワーとしての余力を振り向けるなどして、きめ細かな対応をする"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "例えば、音声で操作できるですとか、キーボードとかマウスを操作する必要がない使いやすい機器ですとか、方法によるサービスの提供、さらには市民向けスマートフォン活用セミナーの開催など、市民全体のデジタル活用力を向上させる施策の検討を進めて"@ja.
<< kg:id_61 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "重点化する取組を１つは新たな日常への転換を見据えた経済・社会の再生、２つ目は日本一女性が働きやすいまちの実現、そして、３つ目が市民に優しいデジタル変革の推進、これを３本の柱と決めて力を入れる分野を明確に示した"@ja.
<< kg:id_61 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "事業目的達成のために真に必要な経費を絞り込むために全ての事業について一件査定を行ったところでございます"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "コロナ禍により凍結、縮小した事業は必要なものを取捨選択の上、再開する必要があることを全庁に訴えております"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "令和３年度も引き続き財政指標を意識した財政運営を目指すとともに、中期財政計画に掲げた目標値を目指し、税収増を意識した施策の展開、それから成果を重視した事務事業の見直し、さらには市債発行額の抑制や繰上償還などによる市債残高の縮減、そしてコロナ禍による中止事業等の中から新たな日常においても実施する事業の取捨選択を行った上で、財政調整基金、それから市債管理基金の財源確保に努めながら市政運営に取り組んでまいりたい"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "女性活躍推進法に基づく一般事業主行動計画の策定の促進がございます"@ja.
<< kg:id_68 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "それぞれの事業所に合った働きやすい職場づくりへの相談対応に社会保険労務士を市が派遣する仕組みを講じてまいりたい"@ja.
<< kg:id_68 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "常時雇用する労働者の数が100人以下の事業所でございますけれども、この事業者が計画を策定した場合には奨励金等を独自に交付する制度を創設する"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "サンロクでは、好きなことや得意なことを生かして働いている女性の話を聞いて自己啓発を促す、おいしいサンロク女子会ですとか、あるいはデジタルスキルを身につけて、場所や時間に捉われずに自分のライフスタイルに合わせて副業やフリーランスなどの働き方を選択できるよろずＩＴ女子の育成を行うなど、酒田で生き生きと働きたい女性を支援している"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "市町村で対応が困難な医学的知見が必要となる専門的な相談窓口は県で担いますよといったことが示されて"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "飲食、小売のみならず、サービス業であるとか住宅設備の事業者、こういった幅広く落ち込んだ個人消費を喚起するには非常に効果的であった"@ja.
<< kg:id_78 prop:effect kg:id_79 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "幅広い分野においてデジタル技術の活用が進んで多くの利用者の利便性が向上することで、徐々に新たな価値が創造されて、本市のデジタル変革が着実に推進するものと確信をしております"@ja.
<< kg:id_80 prop:effect kg:id_81 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "基地港湾としての港湾整備、それから発電設備などの施工、施工後の運転・保守による直接的な経済効果のほかに、建設資材や原材料の生産及び取引の増加、関連産業の立地による第１次的な経済波及効果、それから、それらの雇用者の所得の増加や消費需要の喚起による第２次的な経済波及効果、これなどによりまして、この地域の活性化につながるものと考えております"@ja.
<< kg:id_80 prop:effect kg:id_82 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "この地域の産業あるいは雇用、さらには市民所得の向上にもつながるものと考えております"@ja.
<< kg:id_83 prop:effect kg:id_84 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "酒田産食材による酒田フェアの開催は評判もよく、食材の品質の高さをアピールするとともに、その後の「分とく山」総料理長を招いての取組は、本市の情報発信にもつながった"@ja.
<< kg:id_85 prop:effect kg:id_86 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "新型コロナウイルスの影響を受け、全国の観光地はにぎわいを失っています。本市においても、昨年、酒田まつりや甚句流し、花火ショーなど全てのイベントが中止となっています"@ja.
<< kg:id_87 prop:effect kg:id_88 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "最高のおもてなしの港として称賛されたクルーズ船の寄港は、昨年全てキャンセルとなっています"@ja.
<< kg:id_89 prop:effect kg:id_90 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "対象児が在宅でも支援を受けることができれば、感染リスクも低くなるほか、家族の負担軽減にもつながることと思われます"@ja.
<< kg:id_91 prop:effect kg:id_92 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "人口構造が変化していく中、医療と介護の連携の必要性はこれまで以上に高まってきており"@ja.
}
