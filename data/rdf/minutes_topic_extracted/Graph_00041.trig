kg:st_1 rdfs:label "阿部秀徳議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "酒田港の取扱貨物量をどう維持するかが大きな課題と懸念する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "酒田港の取扱貨物量をどう維持するかが大きな課題と懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "酒田共同火力発電所の存続問題も含め国や県と連携して取り組むべきと求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "宮崎和幸企画部長"@ja.
kg:st_2 rdf:type cls:st_28.
cls:st_28 rdfs:label "部長"@ja.
kg:op_4 prop:content "新たな荷主開拓と酒田港からの輸出拡大は恒常的な課題と認識する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "大規模プロジェクト推進には基地港湾が不可欠と説明する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "2030年まで時間がなく取組を急ぐべきと求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "13年以上かかる見込みを踏まえ市を挙げて国県も巻き込んだ取組が必要と求める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "着床式は環境や景観への負荷が非常に大きいと懸念する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "設置から撤去補修までのコストは膨大になると懸念する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "沿岸近くの着床式は環境や景観への負荷が非常に大きいと指摘する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "より多くの荷主企業を掘り起こす必要があると述べる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "輸出拡大を恒常的課題として取り組む考えを示す"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "新年度はオンライン活用など工夫して取り組む考えを示す"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "サブ港湾確保の視点やトライアル助成をPRして利用を促す方針を示す"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "商談会開催で酒田港の利用拡大につなげたい考えを示す"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "視察再開に向け相手方と協議していく考えを示す"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "住民説明会での不安を踏まえ合成写真を公表予定と説明する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "環境景観に十分配慮した導入を事業者へ求める考えを示す"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "基地港湾指定は国県との連携と市を挙げた取組が必要と求める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "2030年まで時間がないため市を挙げて国県も巻き込んだ取組を求める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "その大きな要因でございますが、酒田共同火力発電所の燃料となります石炭の輸入が減少したもので"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "全国的に天然ガス火力発電及び再生可能エネルギーによる電力供給が増加した一方で、石炭火力発電による電力供給が減少し"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "酒田共同火力発電所の稼働率も低下したためとお聞きしているところでございます"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "コンテナ貨物量が減少した要因は、輸出におけるその他日用品が2,912ＴＥＵの減少となっており、全体減少量3,450ＴＥＵのうち約84％を占めていることから、同貨物の減少の影響が大きいものと見てございます"@ja.
<< kg:id_5 prop:cause kg:id_7 >>
    prop:text-txt_contents "経済情報誌等によりますと、中国における紙おむつ市場の競争激化の影響があるとも報道されております"@ja.
<< kg:id_5 prop:cause kg:id_8 >>
    prop:text-txt_contents "新型コロナウイルス感染症の影響によりまして、全世界的にコンテナの動きが悪くなったため"@ja.
<< kg:id_5 prop:cause kg:id_9 >>
    prop:text-txt_contents "コンテナ不足により海上運賃が高騰していると報道されてございます"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:text-txt_contents "昨年10月頃からは、寒波や太陽光発電の出力低下、天然ガスの供給不足などから全国的に電力供給が逼迫しまして"@ja.
<< kg:id_10 prop:cause kg:id_12 >>
    prop:text-txt_contents "昨年10月頃からは、寒波や太陽光発電の出力低下、天然ガスの供給不足などから全国的に電力供給が逼迫しまして"@ja.
<< kg:id_10 prop:cause kg:id_13 >>
    prop:text-txt_contents "昨年10月頃からは、寒波や太陽光発電の出力低下、天然ガスの供給不足などから全国的に電力供給が逼迫しまして"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "酒田港は、大口の荷主企業の動向により貨物量が左右されやすいことから、新たな荷主開拓と酒田港からの輸出拡大は恒常的な課題でございまして"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:text-txt_contents "中でも昨年は11年ぶりに300万トンを割る、大きく減少しております"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "大規模な洋上風力発電プロジェクトを推進するためには、洋上風力発電施設の建設、メンテナンスの拠点となる基地港湾が不可欠でございます"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:text-txt_contents "建設時には長大で重量物である資機材、ブレードですとか、タワーですとか、そういったものですけれども、こういったものの資機材を大量に保管して、組立て、海上輸送を行う"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:text-txt_contents "運転開始後にはメンテナンスに必要なアクセス船ですとか、作業船等の高頻度での発着というものが見込まれます"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:text-txt_contents "国が基地港湾を指定することによりまして、国及び港湾管理者である山形県、これは当該基地港湾の特定の埠頭を事業者に対しまして、最大30年間安定的に貸し付けることが可能となります"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "そのため、発電所の運転開始までは、今後、約10年以上かかると見込まれるものでございます"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "酒田市沖は、遊佐町沖から３年ほど遅れてございますので、令和３年度から酒田沿岸域の検討部会での検討が開始されるということから、運転開始までは今後13年以上はかかるものと見込まれます"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "洋上風力発電の導入による景観や環境への影響について議論されてきてございます"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "洋上風力発電に関しては、その設置から撤去、また補修、このランニングコスト、これは膨大なものになると思われます"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "沿岸近くに着床式で建てる計画だと伺っております。この場合、環境や景観に対する負荷というものは非常に大きいものと思われます"@ja.
<< kg:id_14 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "新たな荷主開拓と酒田港からの輸出拡大は恒常的な課題でございまして、より多くの荷主企業を掘り起こしていかなければならないと考えております"@ja.
<< kg:id_14 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "新たな荷主開拓と酒田港からの輸出拡大は恒常的な課題でございまして"@ja.
<< kg:id_14 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "新年度は、新型コロナウイルスの状況を勘案しながらということになりますけれども、“プロスパーポートさかた”ポートセールス協議会において、オンラインを活用したセミナーなど工夫して取り組んでまいります"@ja.
<< kg:id_14 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "酒田港の利用割合が低い県内の内陸部や、県外の港湾を利用している企業には、メインとなる利用港湾とは別にサブの利用港湾の確保の視点や、トライアル助成などをＰＲしながら利用を促してまいりたいと考えてございます"@ja.
<< kg:id_14 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "中国との貿易に意欲のある企業を募って商談会を開催をし、酒田港の利用拡大につなげていきたいというように考えてございます"@ja.
<< kg:id_14 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "一昨年より国内ＲＯＲＯ船の誘致に取り組んでおりましたけれども、新型コロナウイルスの影響を受け、船会社による酒田港の視察が保留状態にあるため、再開に向けて相手方と協議していきたいと考えてございます"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:text-txt_contents "その中でも港湾管理者である山形県が港湾法第３条の３第１項で定める港湾計画というものを変更する必要がございます"@ja.
<< kg:id_41 prop:countermeasure kg:id_43 >>
    prop:text-txt_contents "基地港湾指定には、２つ以上の洋上風力発電事業者の港湾利用が見込まれることが要件の一つとされていることから、遊佐町沖、それから酒田市沖が海洋再生可能エネルギー発電設備の整備に係る海域の利用の促進に関する法律に基づく促進区域、これに指定される必要がございます"@ja.
<< kg:id_41 prop:countermeasure kg:id_44 >>
    prop:text-txt_contents "今後、遊佐町沖が国から有望な区域に選定をされ、国が法定協議会を設置をいたします。促進区域の指定に向けて、県、町市、漁業関係者などとともに、必要な協議をここで行ってまいります"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:text-txt_contents "公募により選定されました事業者は、環境影響評価、環境アセスメントと一般的に言われておりますけれども、これらの手続を経て工事に着手をするということになります"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地区別の住民説明会などでの景観に関する不安や心配する意見を踏まえまして、山形県が具体的なイメージとして合成写真、フォトモンタージュと一般的に言われておりますけれども、これを作成し、公表する予定と伺っております"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:text-txt_contents "山形県知事の意見といたしまして、鳥海山からの伏流水への影響について、調査や予測及び評価を実施することが盛り込まれている"@ja.
<< kg:id_49 prop:countermeasure kg:id_51 >>
    prop:text-txt_contents "サケなどの漁業対象魚種について、事業開始前から事業終了に伴う設備撤去及びその後の一定期間を通した継続的な漁業影響調査、モニタリング、こういったものの実施を事業者に求めていくこととしているところでございます"@ja.
<< kg:id_29 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "本市としては、環境・景観に十分配慮した上で、洋上風力発電の導入を事業者へ求めていく考えでございます"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "この基地港湾の指定に関しても、酒田共同火力存続の問題に関しても、国や県との連携、そして市を挙げてまさに取り組むべき課題であろうと思います"@ja.
<< kg:id_53 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "この課題に市を挙げて国・県も巻き込んだ形での取組というものを、これも取り組んでいただきたいということを意見として申し述べさせていただきたいと思います"@ja.
}
