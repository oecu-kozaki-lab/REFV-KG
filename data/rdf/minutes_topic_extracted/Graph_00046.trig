kg:st_1 rdfs:label "後藤仁議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "1年間待たず一部でも今年度から市民還元すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "地域創生部長佐々木好信"@ja.
kg:st_2 rdf:type cls:st_40.
cls:st_40 rdfs:label "行政"@ja.
kg:op_2 prop:content "自然条件や災害リスクがあり慌てず還元の在り方を考えるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "風況変動があるため収益見通しは慎重に見るべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "自然災害リスクがあるため拙速な還元は避けるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "供用開始後は順調なスタートを切っている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "長期的には一定の売電収入と収益を見込んでいる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "スピード感ある還元は市民理解と宣伝効果につながる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "今年度から還元すれば今後の洋上風力への市民理解を高められる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "収益は基金に積み立て広く市民還元できる事業に活用する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "市民周知は広報で丁寧に進める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "同時期建設のため改修時期も集中する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "老朽化対策が後手に回っている懸念がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "改修の平準化は難しいため基金で集中的に対応すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "排水設備の老朽化が施設悪化を招いている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "補修しても原因箇所が分からず改善しにくい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "ロッカールームの雨漏りは早急な対応が必要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "大雨時の浸水が継続している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "利用環境が悪化している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "施設全体の老朽化が進んでいる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:st_3 rdfs:label "公認審判員で活躍している方"@ja.
kg:st_3 rdf:type cls:st_45.
cls:st_45 rdfs:label "利用者"@ja.
kg:op_20 prop:content "外野芝の雑草混在は競技上危険"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "排水不良がグラウンド状態悪化につながっている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:st_4 rdfs:label "高野連"@ja.
kg:st_4 rdf:type cls:st_46.
cls:st_46 rdfs:label "競技団体"@ja.
kg:op_22 prop:content "休養場所が不足し大会開催に二の足を踏んでいる"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "市の野球競技を支える重要施設として早急な改善が必要"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:st_5 rdfs:label "地元の人"@ja.
kg:st_5 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_24 prop:content "今年は孟宗竹不良で熊が人家近くまで来ている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "熊と人のすみ分けには餌場をつくらないことが重要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "近年は人家近くでの出没が増え住民不安が強まっている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:st_6 rdfs:label "熊出没を相談した住民"@ja.
kg:st_6 rdf:type cls:st_5.
kg:op_27 prop:content "乳児が散歩する地域に熊が出るのは看過できない"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_6.
kg:op_28 prop:content "毎年のことだが孟宗竹被害が出ている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "未収穫柿の除去は具体的な餌場対策として有効"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "熊対策用の緩衝帯を事業化して整備すべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "地域の草刈り負担を踏まえ緩衝帯整備を事業化すべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "煙や火の臭いを使った境界対策も検討すべき"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:st_7 rdfs:label "阿部秀徳議員"@ja.
kg:st_7 rdf:type cls:st_9.
kg:op_33 prop:content "カーボンニュートラルは新しい成長戦略として捉えるべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_7.
kg:st_8 rdfs:label "副市長矢口明子"@ja.
kg:st_8 rdf:type cls:st_40.
kg:op_34 prop:content "市内企業には水素分野で実用化が期待される技術がある"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_8.
kg:op_35 prop:content "市内には水素利活用の基礎となる産業連携がある"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_8.
kg:op_36 prop:content "基地港湾指定は大きな経済波及効果を期待できる"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_8.
kg:op_37 prop:content "洋上風力は雇用創出にもつながる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_8.
kg:op_38 prop:content "税収増加も期待される"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_8.
kg:op_39 prop:content "酒田沖でも同等以上の波及効果が期待できる"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_8.
kg:op_40 prop:content "酒田港はインフラ面で優位性がある"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "広大な未利用地は他港にない優位性である"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_2.
kg:op_42 prop:content "県と連携して基地港湾指定を進める"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_8.
kg:op_43 prop:content "港湾を軸に企業立地と地域振興を一体で進める"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_8.
kg:op_44 prop:content "グリーンイノベーション基金などを活用して企業の取組を支援する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_8.
kg:op_45 prop:content "生涯活躍のまちは地方創生に資する取組である"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_8.
kg:op_46 prop:content "高齢者中心から全世代型へ見直して進める"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_8.
kg:op_47 prop:content "移住コミュニティと地域の接続を重視している"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_8.
kg:op_48 prop:content "先進事例ではごちゃまぜ型の多世代交流が有効である"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_8.
kg:op_49 prop:content "事業継続には入居者確保と循環が鍵になる"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_8.
kg:op_50 prop:content "基本協定締結に向け計画を磨き上げる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_8.
kg:op_51 prop:content "建物も書籍も高い文化的価値があると認識している"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_7.
kg:op_52 prop:content "老朽化で休館となり建物の今後が懸念される"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_7.
kg:op_53 prop:content "建物の劣化進行を心配している"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "デジタルアーカイブは資料活用の面で効果がある"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "専門調査と保存活用計画の策定を早く進めるべき"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "時間がかかるなら応急措置も検討すべき"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_7.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "運転初年度であることから予測の不確実性の程度が大きいということで、現時点では算出ができないという状況でございます。"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "６月から９月までは季節風の風況が悪いということから、発電量が大幅に低下するだろうと見込んでございます。"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "この風力発電事業につきましては、様々な自然の状況によって変化があったり、あるいは落雷とか、そういう自然の災害を受ける可能性が含まれている事業でございます。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "４月、５月の２か月間の実績でございますけれども、売電量で約334万キロワットアワー、収入で8,130万円となってございます。対予算では予算額の約３億2,800万円に対しまして24.8％となっておりまして、順調な滑り出しができたというところでございます。"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "固定価格買取制度、ＦＩＴの制度が適用される20年間で、売電収入を約65億3,000万円、収益を約４億2,000万円と想定しているところでございます。"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "私はこういう市民還元だとかというものは、話題性だとかスピード感というのもひとつ大事だと思うんです。"@ja.
<< kg:id_6 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今後の洋上風力、カーボンニュートラルへの市民の理解を高めていく事業になるので"@ja.
<< kg:id_6 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "事業の収益につきましては、風力発電事業地域未来創造基金、こちらのほうに積立てをして、広く市民に還元できるようにと地域振興事業等に充てることとしております。"@ja.
<< kg:id_6 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "広報などでしっかりと情報提供させていただきながら、事業の経過、今後の展開などについて説明をさせていただければと思っているところでございます。"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "建設年度が同時期に集中し、施設を維持する中で修繕や維持管理など追いつかない状況ではないでしょうか。"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "施設を維持する中で修繕や維持管理など追いつかない状況ではないでしょうか。"@ja.
<< kg:id_12 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "老朽化による施設改修は時期が集中してしまう。これは自然の成り行きだと思います。この施設改修を平準化するのは、私は難しいため財政調整基金を活用し、早急に集中的に対応していくべきと考えます"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "非常に暗渠がもう老朽化していまして"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "その雨漏りは今始まった話じゃないんだと。何とか直そうと思って、市のほうからもやっていただいているけれども、なかなかその浸透がどこからか分からない"@ja.
<< kg:id_16 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "光ケ丘野球場のロッカールームには青いバケツが三、四個置かれ、雨漏りがしている箇所が多数見られる。"@ja.
<< kg:id_16 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "施設全体の排水も不十分で、事務室には、昨年はここまで、一昨年の豪雨ではここまで浸水したという浸水の跡が明確に残っております。"@ja.
<< kg:id_16 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "建物の中もカビ臭い状況にあります。"@ja.
<< kg:id_16 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "グラウンドの土や野外照明施設の劣化"@ja.
<< kg:id_16 prop:effect kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "外野の芝に雑草が非常に混在して、しっかり刈り取っているときは影響ないんだけれども、雑草ですので、油断をすると、芝と雑草の伸びが違いますので、非常に野球をしていて危ない"@ja.
<< kg:id_16 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "大雨降るとみんな事務室だとかに水が入ってくる。そのことによって、常にダイヤモンドに砂をまくので、非常にダイヤモンド、内野ですね。内野のゾーンも砂漠化し始めている"@ja.
<< kg:id_16 prop:effect kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "高野連としては、なかなか光ケ丘野球場で大会のスケジュールを入れるのに二の足を踏んでいる状況もあるんです"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "光ケ丘野球場は本市の野球競技のためには絶対的に必要な施設と考えます"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "今年の場合は、孟宗竹が不良なんだそうです。不良ですので、より近い民家近くまで熊が孟宗竹を食べに来ている"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "熊と住民、人間がすみ分けるには、餌場をつくらないことだと聞きました。"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "近年は熊が人家近く、30メートルから50メートル以内に熊が現れているという情報も多く、地元住民の不安感、危機感が強まっている"@ja.
<< kg:id_30 prop:effect kg:id_33 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "うちには乳児がいるんだと。そして、地域を散歩すると。そんな地域でいいのかと"@ja.
<< kg:id_30 prop:effect kg:id_34 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "裏山すぐ、その家も30メートルぐらいと言っていましたけれども、孟宗竹を今年も47本ほど食べられた"@ja.
<< kg:id_30 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "内藤小容子さんが収穫されない柿の除去をして、餌場をなくし"@ja.
<< kg:id_30 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "緩衝帯をつくる、餌場をなくすというそういう答え、答弁がありました。"@ja.
<< kg:id_30 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "ただきれいにするんじゃなくて、熊対策用としての緩衝帯を事業化して、それをつくっていく。私はそんな施策もあっていいのかなと思います。"@ja.
<< kg:id_30 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "トーチカ的なものを山と人里の間に何か所かつくりまして、そこで火をおこす。...煙、火の臭いを察知させて、熊からここからは人里だよねというような対策というものは考えられないものでしょうか。"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "2050年カーボンニュートラルに伴うグリーン成長戦略は従来の発想を転換し、温暖化への対応を経済成長の機会と捉える時代の新しい成長戦略であります。"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "吸蔵合金に吸収させた形で貯蔵すると、通常のガス状の場合に比べて約1000分の１にまで体積を圧縮できるため、効率的に大量貯蔵が可能となります。"@ja.
<< kg:id_43 prop:effect kg:id_44 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "小規模ながらも水素サプライチェーンが構成されている状況であります。"@ja.
<< kg:id_45 prop:effect kg:id_46 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "経済波及効果は約186億円"@ja.
<< kg:id_45 prop:effect kg:id_47 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "雇用創出効果は1,586人"@ja.
<< kg:id_45 prop:effect kg:id_48 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "税収増大効果は県税、市町村税を合わせて約２億4,800万円"@ja.
<< kg:id_45 prop:effect kg:id_49 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "仮に酒田沖の事業も進めば、その効果は遊佐沖と同等以上と考えられます。"@ja.
<< kg:id_50 prop:cause kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "酒田港、臨港道路、送電線などのインフラもできてございますし、高速道路、インターチェンジも近接している"@ja.
<< kg:id_50 prop:cause kg:id_52 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "港湾区域内の広大な未利用地、これもございます。"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "山形県と連携して、酒田港の基地港湾指定を目指してまいります。"@ja.
<< kg:id_53 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "酒田港におけるカーボンニュートラルポート形成に向けまして、洋上風力発電の基地港湾、それからカーボンニュートラルポート、これらを見据えた企業の立地、...企業の特性に沿った臨海部の土地利用、...発電事業運営期間における地域振興、これらについて検討を行うことにしております。"@ja.
<< kg:id_53 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "市としましては、こうした基金等の活用を企業に促していくことによりまして、企業の脱炭素化に向けた取組を後押ししていきたいと考えております。"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "地域の実情や特性に応じたまちづくり施策として取り組むことで、地域が活性化することが期待されております"@ja.
<< kg:id_57 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "新たな生涯活躍のまちは、対象を全世代に拡大し、都市部からの人の流れをつくり、誰もが居場所と役割を持ち、活躍できるコミュニティづくりを推進する施策の一つとして位置づけられました。"@ja.
<< kg:id_57 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "移住者が地域活動に主体的に参加するなど、当該拠点を通じて地域と交流し、スムーズに地域に溶け込み活躍することにより、町が活性化していく取組を目指すことにしております。"@ja.
<< kg:id_57 prop:effect kg:id_61 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "多世代で多様な人材が交流し活躍する「ごちゃまぜ」と称されるコミュニティづくりや、地域コミュニティとの関係性を重視した取組が成功の要素と捉えております。"@ja.
<< kg:id_57 prop:effect kg:id_62 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "課題は、しっかりとこの事業をＰＲし、いかに早期に入居移住者を確保し、その後も安定的に入居者が循環していく事業にしていくことができるかということであります。"@ja.
<< kg:id_57 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "今後、事業予定者とは市の構想と事業者の提案をすり合わせる協議を行い、事業計画のブラッシュアップを行い、基本協定締結を目指してまいります。"@ja.
<< kg:id_64 prop:effect kg:id_65 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "建物や書籍、資料は文化財として相当価値があるのではないかと考えます"@ja.
<< kg:id_64 prop:effect kg:id_66 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "老朽化に伴い、平成29年、2017年に蔵書を移転して休館。"@ja.
<< kg:id_64 prop:effect kg:id_67 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "建物は平成29年に閉館したままで、劣化の進行も懸念されております。"@ja.
<< kg:id_64 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "蔵書はデジタルアーカイブを進めてネットで検索できるようにしました"@ja.
<< kg:id_64 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "専門家の詳細な調査を行った上で、保存活用計画の策定が必要であり"@ja.
<< kg:id_64 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "まずはちょっと劣化を防ぐ上で、応急的な処置も必要なのかなと思った次第でございました。"@ja.
}
