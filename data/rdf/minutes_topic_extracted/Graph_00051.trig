kg:st_1 rdfs:label "市長"@ja.
kg:st_1 rdf:type cls:st_40.
cls:st_40 rdfs:label "行政"@ja.
kg:op_1 prop:content "令和４年度以降も順次予算化・事業化したい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "実現に向けて順次予算化・事業化したい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "多くの人に住みたいと思われるまちづくりに取り組みたい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "酒田港は大きな可能性を持つと考える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "次世代エネルギーを含め地域全体の産業振興につながると期待する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "さらに深めた議論ができるよう関係者調整を進める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "現時点では見通しが立っていない"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "2つ以上の利用見込みの形成が最大のハードルと理解している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_2 rdfs:label "発言者"@ja.
kg:st_2 rdf:type cls:st_17.
cls:st_17 rdfs:label "発言者"@ja.
kg:op_9 prop:content "港が活性化しなければ酒田の大きな進捗はない"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:st_3 rdfs:label "酒田商工会議所100周年記念誌の当時会頭・平田牧場の新田会長"@ja.
kg:st_3 rdf:type cls:st_13.
cls:st_13 rdfs:label "経済団体"@ja.
kg:op_10 prop:content "歴史と文化を大切にした地域は今後も繁栄すると信じる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "ぜひ実現に向けて進めてほしい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "酒田港は用地があっても使えない課題がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "まずは国の予算要求の動向を見据えるために、令和３年７月に政府において閣議了解された概算要求基準、これは令和４年度の概算要求に当たっての基本的な方針ということになりますが、これをまず参考とするとともに"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "山形県の動向や本市をめぐる様々な情勢、環境を踏まえながら、本市の予算編成に当たっての基本方針を定めたところでございます"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:text-txt_contents "令和４年度は３年度の柱を一定程度引き継ぎながら、まずはコロナ禍からの経済的な脱却を基本として、経済が復活することを前提に"@ja.
<< kg:id_4 prop:cause kg:id_6 >>
    prop:text-txt_contents "まずはコロナ禍からの経済的な脱却を基本として、経済が復活することを前提に"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "この構想を踏まえて酒田港をカーボンニュートラルポートとし"@ja.
<< kg:id_7 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "例えば洋上風力発電における基地港湾の指定を受ける、基地港湾化ですとか"@ja.
<< kg:id_7 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "カーボンニュートラルポートを見据えた企業誘致"@ja.
<< kg:id_7 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "さらには誘致する企業の特性に沿った、港周辺の部分にあたる臨海部の土地利用"@ja.
<< kg:id_7 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "それから再生可能エネルギー導入を後押しするような取組を行うこととしているところでございます"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "コロナ時代に求められるあらゆる角度からの改善・見直しを推し進めるとともに"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:text-txt_contents "誰一人として取り残さない、誰もが尊重し合える共生社会の実現"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "昨年度来からのデジタル化の推進によりまして、時代の変革に対応した本市独自の手法を取り入れながら"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "多くの方に酒田で暮らしたい、住み続けたいと思っていただけるまちづくりに取り組みたい"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:text-txt_contents "第６次エネルギー基本計画に基づく再生可能エネルギーの導入目標、これは2030年度36％から38％、現状は18％しかないということでございますが、この導入目標の達成を見据えて、洋上風力発電を促進するための拠点となる基地港湾の最適配置や規模等を検討しておりまして"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:text-txt_contents "これは2030年度36％から38％、現状は18％しかないということでございますが"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:text-txt_contents "2030年までに北海道・東北地方において２から３の港の基地港湾としての追加整備"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:text-txt_contents "トータルすると2040年までに最大８港が整備されるとの方向性が示されたところでございます"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:text-txt_contents "酒田港は現在、造成中の30ヘクタール以上の広大な土地がありまして"@ja.
<< kg:id_28 prop:cause kg:id_30 >>
    prop:text-txt_contents "大型化が進む風車部材の組立てには適しております"@ja.
<< kg:id_28 prop:cause kg:id_31 >>
    prop:text-txt_contents "遊佐町沖や、今後の動きになりますが、酒田市沖での洋上風力発電に当たっては最寄りの港として位置しているわけでございます"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "そういうことから大きなポテンシャルを持っていると考えております"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:text-txt_contents "現状、バイオマス発電だったり陸上部分にも風車がありますので、そういう意味ではエネルギー供給拠点としての機能も有している"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "発電施設の建設だけでなく、水素あるいはアンモニアなどの次世代エネルギーを含めて、関連産業の立地による地域全体の産業振興につながるものという期待がされると考えております"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:text-txt_contents "１つは基地港湾やカーボンニュートラルポートを見据えた県外からの企業誘致"@ja.
<< kg:id_38 prop:countermeasure kg:id_40 >>
    prop:text-txt_contents "２つ目は誘致する企業の特性に沿った臨海部の土地利用"@ja.
<< kg:id_38 prop:countermeasure kg:id_41 >>
    prop:text-txt_contents "３つ目は洋上風力発電施設の建設後、発電事業運営期間における地域振興策などについて、行政機関を中心に協議をしているところでございます"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:text-txt_contents "水素・アンモニアの次世代エネルギーの利活用等脱炭素化に配慮した港湾機能の高度化について"@ja.
<< kg:id_42 prop:countermeasure kg:id_44 >>
    prop:text-txt_contents "酒田港において地域企業を中心とした脱炭素社会の実現に向けた検討を進めてきているところでございます"@ja.
<< kg:id_42 prop:countermeasure kg:id_45 >>
    prop:text-txt_contents "現時点における温室効果ガスの排出量を推計し、短期、中期、長期に取り組むべき課題などを示して"@ja.
<< kg:id_42 prop:countermeasure kg:id_46 >>
    prop:text-txt_contents "酒田港のカーボンニュートラルポート形成方針の素案などが整備されたところでございます"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "令和４年度は、今年度検討した内容をさらに深めた議論ができないか、現在関係者の中で調整を進めているところでございます"@ja.
<< kg:id_49 prop:cause kg:id_50 >>
    prop:text-txt_contents "酒田港が基地港湾に指定されるためには、例えば遊佐町沖と酒田市沖といった２つの海域で事業者の利用見込みが必要となります"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:text-txt_contents "海域の先行利用者となっております漁業者との共存共栄など、山形県が取り組む洋上風力の検討においては慎重な議論が求められる"@ja.
<< kg:id_51 prop:effect kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "見通しが現時点では立っておらず"@ja.
<< kg:id_51 prop:effect kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "課題として、４つ目の２つ以上の者の利用見込みの形成が基地港湾指定にとっては一番大きな、今ハードルになっていると理解をしております"@ja.
<< kg:id_55 prop:cause kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "港が活性化しない限りは、この酒田のこれからの大きな進捗もないんだと思います"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "歴史と文化を大切にした地域は、これからも必ず繁栄することを信じてやまない"@ja.
<< kg:id_7 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "このカーボンニュートラル社会の実現への貢献、ぜひ実現に向けてやっていただきたいと思います"@ja.
<< kg:id_60 prop:effect kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "そのときに酒田港を見させてよかったんですが、場所はあるんですが使えないんです"@ja.
}
