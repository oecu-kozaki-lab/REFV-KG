kg:id_1 rdfs:label "酒田市風力発電事業特別会計補正予算"@ja.
kg:id_1 rdf:type cls:c_922.
cls:c_922 rdfs:label "補正予算"@ja.
kg:id_2 rdfs:label "前年度繰越金の確定"@ja.
kg:id_2 rdf:type cls:c_1478.
cls:c_1478 rdfs:label "繰越金確定"@ja.
kg:id_1 prop:cause kg:id_2.
