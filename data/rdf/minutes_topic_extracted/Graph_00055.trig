kg:id_9 rdfs:label "諸収入の増額"@ja.
kg:id_9 rdf:type cls:c_1481.
cls:c_1481 rdfs:label "収入増額"@ja.
kg:id_1 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "遊佐沖、酒田沖への洋上風力発電の導入"@ja.
kg:id_10 rdf:type cls:c_1031.
cls:c_1031 rdfs:label "洋上風力導入"@ja.
kg:id_11 rdfs:label "酒田港の発展には欠かせない"@ja.
kg:id_11 rdf:type cls:c_1487.
cls:c_1487 rdfs:label "港湾発展"@ja.
kg:id_10 prop:effect kg:id_11.
kg:id_12 rdfs:label "早期の基地港湾指定に向け全力で取り組む"@ja.
kg:id_12 rdf:type cls:c_1488.
cls:c_1488 rdfs:label "港湾指定要請"@ja.
kg:id_10 prop:countermeasure kg:id_12.
kg:st_1 rdfs:label "発言者"@ja.
kg:st_1 rdf:type cls:st_17.
cls:st_17 rdfs:label "発言者"@ja.
kg:op_1 prop:content "酒田港の発展に不可欠なため早期の基地港湾指定を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "今回の補正は、前年度繰越金の確定並びに風力発電建設工事に伴う消費税及び地方消費税の還付金などを計上するもの"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "今回の補正は、前年度繰越金の確定並びに風力発電建設工事に伴う消費税及び地方消費税の還付金などを計上するもの"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "本案は、１億9,202万8,000円増額し、予算総額を６億2,733万6,000円とするものであります"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "本案は、１億9,202万8,000円増額し、予算総額を６億2,733万6,000円とするものであります"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "歳出では主に基金積立金、一般会計繰出金を、歳入では繰越金及び諸収入をそれぞれ増額するもの"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "歳出では主に基金積立金、一般会計繰出金を、歳入では繰越金及び諸収入をそれぞれ増額するもの"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "歳出では主に基金積立金、一般会計繰出金を、歳入では繰越金及び諸収入をそれぞれ増額するもの"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "歳出では主に基金積立金、一般会計繰出金を、歳入では繰越金及び諸収入をそれぞれ増額するもの"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:text-txt_contents "遊佐沖、酒田沖への洋上風力発電の導入は、酒田市の重要要望であり、酒田港の発展には欠かせないものと思われます"@ja.
<< kg:id_10 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "早期の基地港湾指定に向け、全力で取り組んでいただきたいと思います"@ja.
}
