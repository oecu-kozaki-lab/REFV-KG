kg:id_7 rdf:type cls:c_1485.
cls:c_1485 rdfs:label "繰出金増額"@ja.
kg:id_1 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "繰越金の増額"@ja.
kg:id_8 rdf:type cls:c_1486.
cls:c_1486 rdfs:label "繰越金増額"@ja.
