kg:st_1 rdfs:label "議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "地域の特性に即した振興策を早めに検討すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "漁業支援、地域産業振興、雇用創出、住民生活支援につながるメリットを重視すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地域の産業振興や雇用創出につながる取組を期待する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地産地消の電力活用を進めるべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "新産業創出により地域振興に大きく貢献できる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地産地消ができれば災害に強いまちづくりに役立つ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地産地消電力は企業誘致で有利な条件になり得る"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "企業が地産地消の電力を使えれば企業誘致を進めやすい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "再生可能エネルギーで賄える団地があれば望ましい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "再エネ電力を使える団地は企業誘致の魅力になる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "次世代エネルギー拠点の整備も重要である"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "夢のある話で将来的なまちづくりに活用したい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "地産地消の電力活用策として検討してほしい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "市民に分かりやすいメリットをもたらす地域振興策を洋上風力発電事業者に求めていくことが重要だと考えております。"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "多様な再生可能エネルギー発電所が立地する地域としての魅力を生かした優良企業の誘致や産業集積"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "研究機関の進出"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "市民が再生可能エネルギーを利用できる仕組みづくり"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "地域協調型洋上風力発電研究・検討会議酒田沿岸域検討部会や法定協議会で議論を重ねてまいります。"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "本市での洋上風力発電においては、新しい産業が生み出される可能性"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "地産地消として電力を優先的に使用できるのであれば、災害に強いまちづくりや企業誘致においても、大きく貢献できるものと思われます。"@ja.
<< kg:id_7 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地産地消として電力を優先的に使用できるのであれば、災害に強いまちづくりや企業誘致においても、大きく貢献できるものと思われます。"@ja.
<< kg:id_7 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "洋上風力発電の電力の一部を、地域新電力会社を経由して、市内の事業者に供給することは可能だと認識しております。"@ja.
<< kg:id_7 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "ＲＥ100産業団地、これは企業の事業活動で使用する電力を洋上風力発電等で発電した再生可能エネルギー100％の電気で賄うことを魅力とした産業団地のことでございますが、それを整備することで、新たな産業や企業誘致をすることも考えられます。"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "それを整備することで、新たな産業や企業誘致をすることも考えられます。"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:text-txt_contents "台風や地震等の災害で電力系統が寸断した場合"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:text-txt_contents "発電した電力が流せなくなる場合も想定されます。"@ja.
<< kg:id_7 prop:effect kg:id_18 >>
    prop:text-txt_contents "停電時に洋上風力発電の電力を避難所等に供給することは、技術的に難しいと考えております。"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "平常時に電気自動車等に蓄電をしておき、災害時に避難所等に配備する方法などは考えられると思います。"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "洋上風力発電の先を見据えて水素や燃料アンモニアの受入れ、供給拠点の可能性について検討していくことは必要であります。"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:text-txt_contents "現時点で港周辺で経済活動を行う主要企業の潜在ニーズは不透明であり、非常にリスクが大きい設備投資となることから、供給拠点の整備について具体的な議論には至っておりません。"@ja.
<< kg:id_25 prop:cause kg:id_24 >>
    prop:text-txt_contents "非常にリスクが大きい設備投資となることから、供給拠点の整備について具体的な議論には至っておりません。"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:text-txt_contents "酒田市内に水素ステーションを設置する場合には、民間、もしくは官民での共同出資となると考えられます"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:text-txt_contents "採算に見合った需要量の確保、かかり増し経費の製品単価への転嫁などにも課題があります。"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:text-txt_contents "水素等の拠点整備となると、インフラ整備の投資規模が非常に大きくなり"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:text-txt_contents "インフラ整備の投資規模が非常に大きくなり、洋上風力発電事業の地域振興策に組み込むのは困難だと考えられる"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:text-txt_contents "より長期的な視点で県と連携して、酒田港港湾脱炭素化推進計画への位置づけや、方向性を検討していきたいと考えております。"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "水素などの次世代エネルギーは将来の産業振興を考えると魅力的ではあるものの"@ja.
<< kg:id_34 prop:effect kg:id_36 >>
    prop:text-txt_contents "導入に向けた課題も多い"@ja.
<< kg:id_37 prop:effect kg:id_38 >>
    prop:text-txt_contents "広い土地が必要であったり"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:text-txt_contents "天候に左右されるなど、様々な課題があります。"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:text-txt_contents "次世代のエネルギーとして再生可能エネルギーが注目される"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:text-txt_contents "ＣＯ２を排出しないカーボンニュートラル燃料として水素エネルギーや燃料アンモニアが期待されています。"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "ふるさと納税の返礼品として電力もやっているというところもあったので、ぜひその辺は地産地消の電力というところを考えていただきたいと思っております。"@ja.
}
