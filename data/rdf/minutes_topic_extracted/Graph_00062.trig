kg:st_1 rdfs:label "大壁洋平議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "メリットとデメリットを慎重に評価しながら進める必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "今後のまちづくりにどう生かすかを見極めるべきだ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "市民が不安に思っており適切な説明が必要だ"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "市民への適切な説明が必要だ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "漁礁づくりや海洋生態系への影響研究ができる研究機関の誘致を検討すべきだ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地元に還元する取組として独自課税の可能性を検討すべきだ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_2 rdfs:label "安川智之副市長"@ja.
kg:st_2 rdf:type cls:st_40.
cls:st_40 rdfs:label "行政"@ja.
kg:op_7 prop:content "導入を契機に関連産業の創出が期待できる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "多様な再生可能エネルギー関連産業を背景に企業進出が考えられる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "雇用創出が見込まれる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "選定事業者の地域貢献策による経済波及効果を期待している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "環境への影響が想定され不安の声も承知している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "景観への影響が想定される"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "漁場への影響が想定される"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "メリットとデメリットを関係者でしっかり議論することが大切だ"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "漁業者や周辺住民など幅広い関係者の意見を聞くべきだ"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "理解醸成に向け情報発信と説明会が必要だ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "地域にメリットがある形を市として提案していくべきだ"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_3 rdfs:label "住民代表"@ja.
kg:st_3 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_18 prop:content "未来の子どもたちへの責任を果たすため賛成だ"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:st_4 rdfs:label "経済界"@ja.
kg:st_4 rdf:type cls:st_13.
cls:st_13 rdfs:label "経済団体"@ja.
kg:op_19 prop:content "酒田港を最大限活用してほしい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:st_5 rdfs:label "漁業者"@ja.
kg:st_5 rdf:type cls:st_14.
cls:st_14 rdfs:label "漁業者"@ja.
kg:op_20 prop:content "漁法の変更を迫られるのは大変だ"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:st_6 rdfs:label "関係者"@ja.
kg:st_6 rdf:type cls:st_52.
cls:st_52 rdfs:label "関係者"@ja.
kg:op_21 prop:content "景観への懸念がある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_6.
kg:op_22 prop:content "市広報で進捗状況や国が進める理由を知らせたい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "市民への理解醸成のため県と説明会を開きたい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "事実を的確に示しイメージだけで賛否が決まらないようにすべきだ"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "多様な議論をバランス良く重ねられる環境づくりが必要だ"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "現段階では未検討だが先進地を見ながら学んでいきたい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "課税は目的や方向性を定め丁寧な議論が必要で現時点では検討していない"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "地元建設企業の参入が期待できる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "多くの来訪者による経済波及効果を期待している"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "新たな産業形成が図られる"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "雇用創出を期待している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:st_7 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_7 rdf:type cls:st_40.
kg:op_32 prop:content "基地港湾指定には複数案件が必要で酒田市沖も前提になっている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_7.
kg:st_8 rdfs:label "意見交換を行った団体の皆様"@ja.
kg:st_8 rdf:type cls:st_53.
cls:st_53 rdfs:label "関係団体"@ja.
kg:op_33 prop:content "洋上風力発電事業における健康被害を懸念している"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_8.
kg:op_34 prop:content "基地港湾の指定が多過ぎるのではないかと懸念している"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_8.
kg:op_35 prop:content "被害があれば事業者が補償する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_7.
kg:op_36 prop:content "広報の二次元コードから意見を出せる仕組みにしている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_7.
kg:op_37 prop:content "説明会では質疑応答の時間もしっかり確保したい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_7.
kg:op_38 prop:content "市民の猛反対があれば市長の意見に反映される"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_7.
kg:st_9 rdfs:label "安藤浩夫建設経済常任委員会委員長"@ja.
kg:st_9 rdf:type cls:st_54.
cls:st_54 rdfs:label "議会"@ja.
kg:op_39 prop:content "機運醸成のため積極的な周知が必要だ"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_9.
kg:op_40 prop:content "先行地域では大きな経済波及効果が試算されている"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_9.
kg:op_41 prop:content "先行地域では大きな雇用創出が試算されている"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_9.
kg:op_42 prop:content "発電事業者による協調策や振興策の効果も期待される"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_9.
kg:st_10 rdfs:label "酒田市議会建設経済常任委員会"@ja.
kg:st_10 rdf:type cls:st_54.
kg:op_43 prop:content "法定協議会の計画的開催を見据え理解醸成と合意形成を進めるべきだ"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_10.
kg:op_44 prop:content "市広報などを活用した分かりやすい周知が必要だ"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_10.
kg:op_45 prop:content "産学民が連携した推進体制づくりを進めるべきだ"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_10.
kg:op_46 prop:content "酒田市沖の促進区域指定を早めるべきだ"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_10.
kg:op_47 prop:content "酒田港の基地港湾指定を早期に進めるべきだ"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_10.
kg:op_48 prop:content "基地港湾整備と合わせて周辺産業形成を進めるべきだ"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_10.
kg:op_49 prop:content "地産地消電力を生かした企業誘致を進めるべきだ"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_10.
kg:op_50 prop:content "地元企業の参画と地元雇用創出を進めるべきだ"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_10.
kg:op_51 prop:content "海域先行利用者や地域住民を支援する連携策が必要だ"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_10.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "再生可能エネルギーは、開発と地域との関わりにおいて、安全性や地域の自然環境、景観に対する懸念から、事業者と地元住民との間でトラブルが発生する可能性がある"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "安全性や地域の自然環境、景観に対する懸念から、事業者と地元住民との間でトラブルが発生する可能性がある"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "山形県沖の洋上風力の騒音が、健康被害のリスクを増加させる可能性があると評価していると環境省から答弁もあり、不安と思っている市民もいます"@ja.
<< kg:id_4 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "市民に対して、メリット・デメリット、流れについて適切な説明が必要と考えます"@ja.
<< kg:id_4 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "洋上風力発電を利用した漁礁づくりや海洋生態系への影響に関する研究などできるのではないかと考えます。このような研究機関を誘致するお考えがあるか"@ja.
<< kg:id_4 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "再エネ事業者に対する新税の導入を検討することを表明しました。この新税は、自然を活用して収益を上げている企業が、その設置している地域ではなく、本社がある地域に税金を納めるものとして、都道府県間の財政の均等調整を図る狙いがあります。地元に還元する良い取組と感じ、（７）として、本市もこのような独自の課税が可能か"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本市独自に考えておりますメリットといたしましては、洋上風力発電の導入を契機とした関連産業の創出"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "本地域へのそういった多様な関連産業があることによる企業進出"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "そして、その雇用の創出などが考えられると思っております"@ja.
<< kg:id_9 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "選定事業者が行う地域貢献策も義務づけられておりますので、それによる経済波及効果も期待をしているところであります"@ja.
<< kg:id_9 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "洋上に風車が建設、そして、運転開始されることによる環境や景観、漁場等への影響が想定をされておりますし、それらに関して、不安に思っていらっしゃる市民の方の声も我々としても承知をしております"@ja.
<< kg:id_9 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "洋上に風車が建設、そして、運転開始されることによる環境や景観、漁場等への影響が想定をされております"@ja.
<< kg:id_9 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "洋上に風車が建設、そして、運転開始されることによる環境や景観、漁場等への影響が想定をされております"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "それらをしっかり意見を出していただいて、それらについてバランス良くしっかり議論していくということがまずは大切だと理解をしています"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "漁業者はもちろんのこと、周辺住民の皆さんなど幅広い利害関係者の皆様からの意見聴取"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "市民の皆様に向けた情報の発信、または説明会などの実施"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "あるべき経済効果ですとか、地域振興策をこのようにあってほしいと本市としても提案をしていくことが大切だと考えております"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "住民代表の方から、この取組は地球温暖化抑止に資するものであり、未来の子どもたちへの責任をしっかりと果たしていこうという考えであるので賛成であるという意見がございました"@ja.
<< kg:id_1 prop:effect kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "経済界のほうからは、この山形県において、酒田港が唯一最大の商業・工業港であるということでありますので、最大限活用をされてほしいという御意見ございました"@ja.
<< kg:id_1 prop:effect kg:id_23 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "漁業者の方から、やはり漁法の変更を迫られてしまうので、それは大変であるという御意見をいただきました"@ja.
<< kg:id_1 prop:effect kg:id_24 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "そのほか景観への懸念、こういったことが代表的には挙げられたと理解をしております"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "この11月１日の市広報にて、酒田市沖で今、どのような洋上風力に係る事業がどういう進捗状況、どういうフェーズにあるのかということ、なぜ、それを国が進めようとしているのかということなどについて、まず、市広報でしっかりとお知らせしてまいりたいと思っております"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "市民へ向けて、洋上風力発電に対する理解醸成について、今後、山形県とともに説明会など開催していきたいと考えております"@ja.
<< kg:id_1 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "今ある最新の科学的知見や現実に進行している各地の状況などの事実を的確に、適正にお示しをした上で、イメージだけで賛成、もしくは反対という世論が形成されることがないように"@ja.
<< kg:id_1 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "多様な議論をバランス良く、そして、建設的に議論を重ねていけるような環境をつくっていかなければならないと考えております"@ja.
<< kg:id_1 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "現段階といたしましては、どういった研究機関を誘致すべきか、誘致した効果などもまだまだ検討できておりませんので、これから少しずつ勉強してまいりたいと思っております"@ja.
<< kg:id_1 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "現時点では、法定外税の創設、特にこの洋上風力に関しては、検討はしていないというところであります"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "基地港湾の整備という大規模な公共事業への地元建設企業の参入"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "基地港湾の工事期間中や、その後の風車建設時など、本地域へ多くの方がいらっしゃることによる経済波及効果"@ja.
<< kg:id_31 prop:effect kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "この基地港湾が整備され、発電事業者が決まってくれば、洋上風力の運営、そして、メンテナンスを行う新たな産業の形成が図られます"@ja.
<< kg:id_31 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "それに伴った雇用を我々としては期待をしているところであります"@ja.
<< kg:id_31 prop:cause kg:id_35 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "基地港湾に指定になるということには、利用すべき洋上風力の案件が２件以上なければできない"@ja.
<< kg:id_1 prop:effect kg:id_36 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "やはり洋上風力発電事業における健康被害だとか"@ja.
<< kg:id_31 prop:effect kg:id_37 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "そもそも基地港湾という指定も多過ぎるのではないかとか、そういった御意見をいただいているところでございます"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "そこで風力事業を実施する事業者がその補償をしていくということで間違いございません"@ja.
<< kg:id_1 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "二次元コードで、その広報の二次元コードを読み取って、そこで意見を発することができるようなそのような仕組みになっております"@ja.
<< kg:id_1 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "恐らくその中で、質疑応答というところはあろうかとは思いますけれども、その時間などもしっかりと取れるようなそんな説明会にさせていただければと思います"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "当然、市民の皆様から猛反対という状況になれば、市長としての意見というものは、そのような意見を反映するという状況になるのではないかと思っております"@ja.
<< kg:id_1 prop:effect kg:id_44 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "本市では、洋上風力発電事業について市民の認知度は高いとは言えず、機運醸成を図るため積極的に周知を行う必要があります"@ja.
<< kg:id_1 prop:effect kg:id_45 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "秋田県は、秋田県沖４海域の洋上風力発電事業を契機とした20年間の運転期間における経済波及効果を約3,600億円"@ja.
<< kg:id_1 prop:effect kg:id_46 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "雇用数を約３万5,000人と試算しています"@ja.
<< kg:id_1 prop:effect kg:id_47 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "発電事業者による漁業協調策、地域振興策での経済波及効果も期待されています"@ja.
<< kg:id_1 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "酒田市沖法定協議会の計画的な開催を見据えた海域先行利用者及び地域住民の理解醸成、合意形成の推進"@ja.
<< kg:id_1 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "洋上風力発電事業の導入を見据えた検討状況を本地域住民に市広報などを活用してわかりやすく周知し"@ja.
<< kg:id_1 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "産学民が連携した推進体制づくりの検討をすること"@ja.
<< kg:id_51 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "酒田市沖が早期に促進区域に指定されること"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "酒田港が早期に基地港湾に指定されるよう山形県を通じて国へ働きかけること"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "基地港湾の整備を見据えた酒田港周辺の産業形成について、山形県との協議を推進すること"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "本地域で発電した電力の地産地消による企業誘致"@ja.
<< kg:id_57 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "地元企業の参画、地元雇用創出を見据えた取組"@ja.
<< kg:id_57 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "海域先行利用者や地域住民を支援する協調策、振興策における産学官金（金融）の連携"@ja.
}
