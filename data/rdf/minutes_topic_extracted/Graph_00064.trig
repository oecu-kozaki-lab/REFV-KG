<https://kozaki-lab.jp/REFV-KG/docs/00064> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "酒田市沖洋上風力発電事業"@ja.
kg:id_1 rdf:type cls:c_798.
cls:c_798 rdfs:label "洋上風力事業"@ja.
kg:id_2 rdfs:label "国から再エネ海域利用法に基づいて有望区域に指定"@ja.
kg:id_2 rdf:type cls:c_1787.
cls:c_1787 rdfs:label "有望区域指定"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "地域経済が活性化し「働きたい」がかなう"@ja.
kg:id_3 rdf:type cls:c_599.
cls:c_599 rdfs:label "地域経済活性化"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "市民への説明や周知が足りていない"@ja.
kg:id_4 rdf:type cls:c_663.
cls:c_663 rdfs:label "説明不足"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "県と連携して議論を進める"@ja.
kg:id_5 rdf:type cls:c_1788.
cls:c_1788 rdfs:label "連携協議"@ja.
kg:id_1 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "令和6年度に法定協議会で具体的な議論を行う"@ja.
kg:id_6 rdf:type cls:c_136.
cls:c_136 rdfs:label "協議実施"@ja.
kg:id_1 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "住民説明会を令和6年度に見送る"@ja.
kg:id_7 rdf:type cls:c_1789.
cls:c_1789 rdfs:label "説明会延期"@ja.
kg:id_1 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "再生可能エネルギーへの理解醸成を図る"@ja.
kg:id_8 rdf:type cls:c_1506.
cls:c_1506 rdfs:label "理解醸成"@ja.
kg:id_1 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "地球沸騰化対策と再生可能エネルギーへの期待を啓発するセミナーを開催"@ja.
kg:id_9 rdf:type cls:c_1720.
cls:c_1720 rdfs:label "啓発活動"@ja.
kg:id_1 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "洋上風力発電についての勉強会を複数回開催"@ja.
kg:id_10 rdf:type cls:c_1506.
kg:id_1 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "具体化後に住民説明会につなげる"@ja.
kg:id_11 rdf:type cls:c_54.
cls:c_54 rdfs:label "住民説明"@ja.
kg:id_1 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "酒田港基地港湾指定"@ja.
kg:id_12 rdf:type cls:c_966.
cls:c_966 rdfs:label "基地港湾指定"@ja.
kg:id_13 rdfs:label "県と連携して国に働きかける"@ja.
kg:id_13 rdf:type cls:c_1790.
cls:c_1790 rdfs:label "国への働きかけ"@ja.
kg:id_12 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "遊佐町沖の公募占用指針で条件つきで利用できる基地港湾として酒田港が明記"@ja.
kg:id_14 rdf:type cls:c_1791.
cls:c_1791 rdfs:label "利用港湾明記"@ja.
kg:id_12 prop:cause kg:id_14.
kg:id_15 rdfs:label "酒田市沖の洋上風力発電導入ありきと誤解を招く"@ja.
kg:id_15 rdf:type cls:c_1792.
cls:c_1792 rdfs:label "誤解発生"@ja.
kg:id_12 prop:effect kg:id_15.
kg:id_16 rdfs:label "議論が停滞する"@ja.
kg:id_16 rdf:type cls:c_1531.
cls:c_1531 rdfs:label "議論停滞"@ja.
kg:id_12 prop:effect kg:id_16.
kg:id_17 rdfs:label "市民に向けて丁寧な情報発信に努める"@ja.
kg:id_17 rdf:type cls:c_1056.
cls:c_1056 rdfs:label "情報発信"@ja.
kg:id_12 prop:countermeasure kg:id_17.
kg:st_1 rdfs:label "質問者"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "質問者"@ja.
kg:op_1 prop:content "県との連携が事業推進に重要と認識している"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域経済活性化につながる取組として位置づけている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "市民への説明と周知が不足していると懸念している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "県との連携が重要である"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "答弁者"@ja.
kg:st_2 rdf:type cls:st_55.
cls:st_55 rdfs:label "答弁者"@ja.
kg:op_5 prop:content "山形県主導の全体会議や酒田部会で議論を進める考えである"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "令和6年度に法定協議会で具体的な議論が展開されると考えている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "メリットとデメリットの整理や理解醸成の進捗を見て段階的に進めるべきと判断した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "再生可能エネルギーへの理解を広げた上で洋上風力発電の役割を伝える必要がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "市民向けに啓発セミナーを実施する方針である"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "洋上風力発電への理解醸成のため勉強会を複数回開催する考えである"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "法定協議会等で議論が進み具体化した段階で住民説明会を行う想定である"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "県と連携して国に働きかけることが重要と考えている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "酒田港が公募占用指針に明記されたことを指定期待の根拠としている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "基地港湾指定が洋上風力導入ありきとの誤解を生むことを懸念している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "誤解によって議論が停滞する事態を避けたいと考えている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "誤解防止のため市民へ丁寧な情報発信を行う考えである"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "酒田市沖の洋上風力発電事業においては、昨年10月、国から再エネ海域利用法に基づいて有望区域に指定されました。この事業を進める上で、県との連携は大変重要だと認識をいたしているところでございます。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "経済が活性化し「働きたい」がかなう酒田、①として、酒田市沖洋上風力発電事業及び酒田港基地港湾指定に向けた取り組みについてお伺いをいたします。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "しかし、市民への説明、周知が足りていないのではないかと考えております。"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "この事業を進める上で、県との連携は大変重要だと認識をいたしているところでございます。これまで山形県地域協調型洋上風力発電研究・検討会議、以下、全体会議と申しますけれども、これと同検討会議の酒田沿岸域検討部会、これを酒田部会と申しますが、この２つの中で議論を進めてまいりました。"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "新たに令和６年度に開催を検討する再エネ海域利用法に基づく法定協議会の中で具体的な議論が展開されていくと考えております。"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "住民説明会につきましては、県と議論を重ねる中で、洋上風力発電事業についてのメリット、デメリットをしっかり把握し、整理した上で行うほうが良いのではないか、また、本地域の理解醸成や機運の高まりの進捗を確認しながら、段階的に住民説明会へつなげていくべきではないかという判断に至りまして、開催を令和６年度に見送ることといたしました。"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "本市の役割としては、本市の再生可能エネルギーに関する理解醸成を図り、その上で洋上風力発電の果たす役割を市民にお伝えしながら、機運醸成、機運向上に向けた取組や、酒田市沖の地域振興策の案の検討を重ねていく必要があると認識しております。"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "令和６年度に実施を検討している本市独自の取組のイメージとしては、まず市民に向けて、１つ目として、地球沸騰化対策の必要性と、その施策として再生可能エネルギーへの期待を啓発するセミナー"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "２つ目として、主力電源化の切り札として期待される洋上風力発電についての勉強会を複数回開催し、本市における理解醸成に努めてまいります。"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "そして、法定協議会等で議論が進み、より具体的な話ができるようなったときに、洋上風力発電の住民説明会につなげていく流れを想定しております。"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "また、酒田港の基地港湾の指定に向けて、県と連携して国に働きかけることも重要と考えます。"@ja.
<< kg:id_12 prop:cause kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "今月１月に発電事業者の公募が開始されました遊佐町沖の公募占用指針の中で、条件つきだが利用できる基地港湾として酒田港が明記されたことから、令和６年度の基地港湾指定を期待しているところであります。"@ja.
<< kg:id_12 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "一方で、酒田港の基地港湾指定が酒田市沖の洋上風力発電導入ありきと誤解を招いて"@ja.
<< kg:id_12 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "その結果、議論が停滞することのないように"@ja.
<< kg:id_12 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "繰り返しになりますが、市民に向けて丁寧な情報発信に努めてまいりたいと思います。"@ja.
}
