kg:st_1 rdfs:label "酒田市"@ja.
kg:st_1 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_1 prop:content "さまざまな対応を考えていきたい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "これからも一つの方向性として考えていかなければならない"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "真剣に取り組んでいかなければならない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_4 prop:content "石油代替エネルギーに真剣に取り組むべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "本市においてもさまざまな対応を考えていきたい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "これからも一つの方向性として考えるべき"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "現状はリサイクルポート指定後、臨海工業団地についてはリサイクル関係企業７社、新エネルギー企業関係３社進出がありました"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "現状はリサイクルポート指定後、臨海工業団地についてはリサイクル関係企業７社、新エネルギー企業関係３社進出がありました"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "具体的に現在も話し合いを進めている企業"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "予約をいただいている企業なども一つはあります"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "京田西工業団地は昨年10月に分譲を開始いたしました"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "酒田市では、これまでもさまざまな代替エネルギーについて取り組んでまいりました"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "地域新エネルギービジョンなども策定をし、それに基づいた対応もしてございます"@ja.
<< kg:id_8 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "特に太陽光発電とか、それから風力発電などについてもしっかり取り組まさせていただいております"@ja.
<< kg:id_8 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "特に太陽光発電とか、それから風力発電などについてもしっかり取り組まさせていただいております"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "これは本格的な普及という意味では、まだまださまざまな課題があるのではないかというふうに思っております"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:text-txt_contents "この普及促進のための税制上の減額措置がなければ、これはコスト的にはかなり厳しいだろうというふうに見込まれます"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:text-txt_contents "これは技術的には可能であっても、コスト的にはかなり厳しい"@ja.
<< kg:id_15 prop:cause kg:id_18 >>
    prop:text-txt_contents "普及を促進するためには、それを給油する場合のスタンドをどういうふうに開設していくのかという課題などもあります"@ja.
<< kg:id_13 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "石油代替エネルギーというものに真剣に取り組んでいかなければならないというふうに思っておりますので、本市においてもさまざまな対応を考えていきたいというふうに思っております"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "特に風力発電についてはかなり実績も上がりつつありますので、これからも一つの方向性として考えていかなければならないものだろうと思っております"@ja.
}
