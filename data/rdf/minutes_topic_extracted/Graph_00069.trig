kg:st_1 rdfs:label "質問議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "景観面だけでなく別の観点も含めて考える必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "供給面で需要と供給のバランスを改めて考えるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "酒田市長"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_3 prop:content "エネルギー供給の不安定性を抱えているのは間違いない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "導入が難しい部分はある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "新エネと火力のバランスを行政課題として議論してほしい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "供給面を含めて再検討が必要"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "行政内で議論がないため将来的課題として扱ってほしい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "当面は自然エネルギー導入を優先し後に検討すべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "酒田市も県と連携して手を挙げ国へ提案するぐらい取り組んでほしい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "こちらから提案するつもりで国へ働きかけてほしい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "日本海側や東北でも発電の可能性を広げる技術だ"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "従来不向きとされた地域でも導入可能性が高まる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "不安定電力の増加時は余剰電力の扱いが課題になる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "余剰電力の扱い方を考える必要がある"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "産業振興と結びつけて新エネ導入を考えるべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "酒田市が新しいエネルギーをうまく回す先進モデル都市になってほしい"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "発電した電力を地域利用する発想も必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "公共施設を地域エネルギー供給拠点として活用できる"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "当面は補完的エネルギーとして導入促進を優先すべき"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "本格的に一翼を担う時期に議論すべき"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "実証実験も含めて先進事例を学びたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "酒田港をモデル港として位置づけ国にアピールすべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "全国各国から注目される港である"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "エネルギー分野の多様な資源を持つ地域だ"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "現時点では売電より補完利用が中心"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "コスト面から現時点では売電のメリットが小さい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "将来は農業分野での活用も想定できる"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "クリーンエネルギー活用を企業誘致の強みにできる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "企業への情報提供と勉強会で誤解を解くべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "障がい者雇用に関する誤解を解き拡大の道を探るべき"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "公物管理を民間に部分開放する考え方があってよい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "庁舎自体に地域支援機能を持たせる発想が必要"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "防雪さくを使えばメガソーラー並みの発電も可能という面白い発想だ"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "地域特有の公共物が大規模発電資源になり得る"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "メガソーラー導入に適した環境がある"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "太陽光事業の可能性が広がる地域条件がある"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "早期導入設備の更新が市場を生んでいる"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "太陽光発電は新しい産業創出にもつながる"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "エネルギー環境モデル港の具体策として誘致目標を掲げるべき"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "先日、十里塚地区の風力発電は県の判断、市の判断も入ったと思いますが、県の最終的な判断で建設断念ということになりましたけれども、そのときに景観面が非常に議論されたわけでありますが、また違った面での考え方も必要なのかなというふうに思いました"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "再生可能エネルギーというものは、非常に電力の出力が不安定であります"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "例えば太陽光であれば、晴れの日はばんばん発電するわけですが、雨や雪になれば発電はなかなかできないという、そういった意味では安定しない出力なわけです"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "この新エネルギーが導入量が過大になると、例えばこの地域でいえば酒田共同火力発電で発電している電力との関係で、非常に安定供給という意味では、不安定な状況に陥ってしまうという課題があるわけです"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "その供給という面で、需要と供給のバランスという面では、考えなくてはならないことなんだなというのを改めて私は考えました"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "この新エネルギーと、現にある火力発電とのバランスをどのように図っていくのか、恐らく私が見聞きしている中では、今の酒田市、あるいは山形県においても、行政の中でそういったことの議論はないのではないかなというふうに思いますので、ぜひともそういった議論を将来的な課題としていただきたいなという思いで"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "この温室効果ガスを発生しない、ゼロ・エミッション電源の比率を2020年度には50％以上にするんだと"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:text-txt_contents "しかも全量買い取り制度を導入していくんだということで、方向性が示されております"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "特に、公共産業分野における導入の拡大というものがうたわれており"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "酒田市においても学校のグリーンニューディール政策によりまして、太陽光であるとかサッシの入れかえなどさまざまな取り組みがなされている"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "いわゆるスマートシティ、スマートコミュニティという概念で、最新技術を駆使してエネルギー効率を高め、省資源化を徹底した環境配慮型のまちづくりをやるんだ"@ja.
<< kg:id_19 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "本市においても、山形県などと連携しながら、こういった新しい取り組みにぜひ手を挙げていただきたい。むしろこちらから提案するぐらいのつもりで国に対して働きかけをしていただきたい"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "特に化合物系の開発をされている企業の方からお話をお聞きしましたら、何でも、曇りの日でも効率よく発電する、そういった能力がある発電設備だそうであります"@ja.
<< kg:id_24 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "これまで日本海側、特に東北などでは太陽光発電は向かないと言われていた中でも、こういった新しい製品でどんどん発電する可能性を秘めている"@ja.
<< kg:id_5 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "例えば太陽光発電が電力の過剰供給になってしまうと、非常にあんばいが悪いわけであります"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "新エネを導入すれば当然のごとく余剰電力というものが生まれます"@ja.
<< kg:id_28 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "例えばリサイクルポートなど、新しく進出されてくる企業の皆さんの電力源としてそれを活用するであるとか、そういった産業振興と結びつけた新エネの導入というものを考えなくてはならない"@ja.
<< kg:id_19 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "ぜひともこの酒田市がこの東北で核になってそういった新しいエネルギーをうまく回していく、そういう先進的なモデル都市にぜひなっていければ"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "学校で発電した電力を学校だけで使うのではなくて、その地域でも使うということ、そういったものにも考えがいってもいいのではないか"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "既存の公共施設、あるいは社会インフラとこの太陽光発電が結びつくことによって、その地域のエネルギーを供給する拠点になるという考え方も、あってもいいのではないかな"@ja.
<< kg:id_28 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "当面は私はやはり、補完的なエネルギーではあるけれども、自然エネルギーの導入を積極的に促すということをまず力を入れるべき"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "その後に議員御指摘のようなことについても、検討する時期が来たらしっかり検討する"@ja.
<< kg:id_19 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "まずこの実証実験なども含めて、しっかりと勉強、先進事例を勉強してみたいな"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "エネルギー、環境のモデル港というような感じで酒田港を位置づけていただいて、そこに国のほうでもいろんな事業を導入してもらうというようなことなども、アピールすべきいい材料をこの地域は持っている"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "酒田というのは当然のことながら、酒田港及び酒田周辺を見てみますと、一つはリサイクルの一大拠点であること、これは間違いない"@ja.
<< kg:id_40 prop:cause kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "共同火力発電、そして風力発電、さらには今度は共同火力発電のほうでバイオマスの一部取り入れも考えようとか、そんな話もなっているし、小水力発電も今後の課題としてある"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "それ以外の公共施設については、今のところは日中の消費電力などの補完機能というような感じで考えております"@ja.
<< kg:id_44 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "現在のところ、まだまだ電力会社から供給を受けたほうがコスト的なメリットもあるということなもんですから、今のところは、そういう充電をしたり、また売電まで考えていくというようなことは考えていない"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "将来、大きな施設ができてきて、売電も視野に入れてということになった場合に、１つはさっき申し上げたような、場所にもよりますが、農事電力ということは考えられる、施設園芸などでの熱源に考えていく、光源に考えていくということは、想定はできる"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "そのときに本市に立地することはメリットですよなんていうようなことを訴えるようなところまでいけるように、考え方を持っていかなければならない"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "例えば工業団地で経営されているような企業の皆さんなどにお話を聞いても、ほとんど知らないんです"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "ぜひ、そういった情報提供をしながら、勉強会を重ねながら、障がい者の雇用の拡大の道というものを取り組んでいただきたい"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "屋根面とか壁の面を電力会社にお願いする、公物管理を民間に部分開放するという考え方があってもいいんだと思うんです"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "新しい庁舎自身が、役所の皆さんのための職場スペースをつくるんだということじゃなくて、災害時には災害対策本部になるわけですから、施設そのものが自家発電しますと。周囲何軒、あるいは周囲にこの地域のエリアは市役所の自家発電で災害対応が即座にできますというような発想だってある"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "防雪さく、これは冬の間、雪や風をさえぎるという役割で、非常にこの地域特有の公共物でありますが、民間の方で太陽光発電をやられている方の発想、夏でも折りたたんで、面的には残りますよね、そこに太陽パネルを据えませんかという話です"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "今この酒田市内にある防雪さくで、メガソーラー並みの発電ができるそうです"@ja.
<< kg:id_63 prop:cause kg:id_64 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "この地域は共同火力発電が北港にありますから、非常に送電網としてはしっかりしたものが整備されています"@ja.
<< kg:id_63 prop:effect kg:id_65 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "そういった意味では、メガソーラーを新しく据えるにしても、非常に環境としてはいい地域なんです"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "今太陽光発電の市場は中古市場だそうです。早くから導入された太陽光発電が新しいものに入れかわって、その古いものは中古市場に流れている"@ja.
<< kg:id_66 prop:effect kg:id_68 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "もう10年もすると、それがリサイクル事業につながっていくと"@ja.
<< kg:id_69 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "ぜひこのリサイクルポートの中で太陽光パネルのリサイクル工場を誘致するという目標も掲げられる"@ja.
}
