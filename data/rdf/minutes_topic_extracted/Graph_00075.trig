<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "大震災や原発事故による再生可能エネルギーへの期待、それから県エネルギー戦略の推進、県立自然公園内での風力発電の取り扱いの見直し、風力発電適地としての役割などを考慮し現在の計画に至っております"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "１つは東北電力の電気の買い取り等計画提出のタイミングの問題がございました、時期の問題がございましたので、そういった意味では判断を急がなければならなかったということもございます"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "現在の技術や採算性、東北電力の受け付け条件などを考慮して判断をさせていただいたものであります"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "現在の技術や採算性、東北電力の受け付け条件などを考慮して判断をさせていただいたものであります"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "風力発電については景観や環境問題、低周波や騒音問題などクリアしなければならない問題が多くあります"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "風力発電については景観や環境問題、低周波や騒音問題などクリアしなければならない問題が多くあります"@ja.
<< kg:id_9 prop:effect kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "風力発電については景観や環境問題、低周波や騒音問題などクリアしなければならない問題が多くあります"@ja.
<< kg:id_9 prop:effect kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "風力発電については景観や環境問題、低周波や騒音問題などクリアしなければならない問題が多くあります"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "計画段階から全く一言の情報も提供されることがなかったというのはいかにもお粗末で、せっかく築いてきた行政とのパートナーシップが壊れてしまうのではないかと大変危惧されるものであります"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "庄内海岸すべてに巨大風車が建ってしまうのは、威圧感、圧迫感で何か息が詰まりそうであります"@ja.
<< kg:id_16 prop:effect kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "庄内海岸すべてに巨大風車が建ってしまうのは、威圧感、圧迫感で何か息が詰まりそうであります"@ja.
<< kg:id_16 prop:effect kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "巨大風車が視界に入らないような歴史的な景観を持った場所も残していくことが酒田市としての使命でもあるし、重要なことではないかと思います"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "事業化に当たりましては環境や景観への影響調査を丁寧に行って"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "その内容については広報やホームページなどで広くお知らせをし"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "市民意見をいただくことになります"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "その中で騒音や低周波音についても調査をいたします"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "これを踏まえて環境審議会あるいは景観審議会の意見を集約し、判断することになります"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "さまざまな立場の人が納得した範囲で計画が進むようオープンに話し合うこと"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "市民の多様な声をすくい上げていく議論の場を設けることが必要と主張しました"@ja.
<< kg:id_1 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "必要があれば市、県との意見交換の場を持ちたいというふうに言われておりますので、話し合う姿勢を持ちながらその推移を見守っているところであります"@ja.
<< kg:id_1 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "市でも広報あるいはホームページ等を通じてお知らせをしていきたいというふうに思っております"@ja.
<< kg:id_1 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "風力発電、再生可能エネルギーの推進施策、こういったものを担当する部局、体制等につきましては今検討をしている最中でございます"@ja.
