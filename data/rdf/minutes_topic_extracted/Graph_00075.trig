kg:st_1 rdfs:label "市長"@ja.
kg:st_1 rdf:type cls:st_40.
cls:st_40 rdfs:label "行政"@ja.
kg:op_1 prop:content "再生可能エネルギー推進の観点から計画を進める判断を示す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "県のエネルギー戦略を踏まえて計画に至ったと説明する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "制度見直しも計画決定の要因と説明する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "酒田市は風力発電適地として役割を果たすべきと認識する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "総務部長"@ja.
kg:st_2 rdf:type cls:st_40.
kg:op_5 prop:content "提出時期の制約で判断を急ぐ必要があったと説明する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "風車の規模は技術や採算性を踏まえて判断したと説明する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "受け付け条件も計画判断の要因と説明する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_3 rdfs:label "議員"@ja.
kg:st_3 rdf:type cls:st_54.
cls:st_54 rdfs:label "議会"@ja.
kg:op_8 prop:content "景観面でクリアすべき課題が多いと指摘する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "環境面の懸念が大きく建設ありきは疑問とする"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "低周波音の問題を懸念する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "騒音問題を懸念する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "情報提供不足で保全活動団体との信頼関係が損なわれると危惧する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "海岸全体に巨大風車が建つと威圧感が強いと懸念する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "圧迫感により文化的景観が損なわれると懸念する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "巨大風車が視界に入らない景観を残すべきと主張する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "環境と景観への影響を丁寧に調査して進める考えを示す"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "調査内容を広く公開して市民に周知すると説明する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "市民意見を聞きながら進めると説明する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "もっと幅広く市民の意見を聞くべきと求める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "騒音と低周波音も調査対象に含めると説明する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "審議会の意見を集約して最終判断する方針を示す"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "さまざまな立場の人が納得できるよう公開の議論が必要と主張する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "市民の多様な声を反映する議論の場が必要と主張する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "必要に応じて保全団体と意見交換する姿勢を示す"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "適地調査や戦略を市でも周知していく考えを示す"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "今後の対応のため担当体制整備が必要と認識している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "大震災や原発事故による再生可能エネルギーへの期待、それから県エネルギー戦略の推進、県立自然公園内での風力発電の取り扱いの見直し、風力発電適地としての役割などを考慮し現在の計画に至っております"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
