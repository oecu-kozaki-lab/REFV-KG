kg:id_7 rdf:type cls:c_2063.
cls:c_2063 rdfs:label "施策検討"@ja.
kg:id_1 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "自然エネルギーの利活用"@ja.
kg:id_8 rdf:type cls:c_2064.
cls:c_2064 rdfs:label "自然エネルギー活用"@ja.
kg:id_9 rdfs:label "庄内地域の賦存量が非常に高いこと"@ja.
kg:id_9 rdf:type cls:c_2065.
cls:c_2065 rdfs:label "高賦存量"@ja.
kg:id_8 prop:cause kg:id_9.
kg:id_10 rdfs:label "送電方法を解決しなければ発電しても電力が運べないこと"@ja.
kg:id_10 rdf:type cls:c_2066.
cls:c_2066 rdfs:label "送電課題"@ja.
kg:id_8 prop:effect kg:id_10.
kg:id_11 rdfs:label "全体として利活用が進む方向にあること"@ja.
kg:id_11 rdf:type cls:c_2067.
cls:c_2067 rdfs:label "利用拡大"@ja.
kg:id_8 prop:effect kg:id_11.
kg:id_12 rdfs:label "国や県の動きを見据えた新しいエネルギービジョンの策定"@ja.
kg:id_12 rdf:type cls:c_118.
cls:c_118 rdfs:label "計画策定"@ja.
kg:id_8 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "新しいエネルギービジョンに基づく利活用促進"@ja.
kg:id_13 rdf:type cls:c_1098.
cls:c_1098 rdfs:label "利用促進"@ja.
kg:id_8 prop:countermeasure kg:id_13.
