kg:id_16 rdf:type cls:c_2069.
cls:c_2069 rdfs:label "有望評価"@ja.
kg:id_14 prop:cause kg:id_16.
kg:id_17 rdfs:label "再生可能エネルギー"@ja.
kg:id_17 rdf:type cls:c_216.
kg:id_18 rdfs:label "大震災を受けて国や県がエネルギー政策を見直していること"@ja.
kg:id_18 rdf:type cls:c_2070.
cls:c_2070 rdfs:label "政策見直し"@ja.
kg:id_17 prop:cause kg:id_18.
kg:id_19 rdfs:label "新年度の新エネルギービジョン見直し"@ja.
kg:id_19 rdf:type cls:c_271.
kg:id_17 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "地域の特性を生かした可能性の検討の推進"@ja.
kg:id_20 rdf:type cls:c_2062.
kg:id_17 prop:countermeasure kg:id_20.
kg:st_1 rdfs:label "質問者"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "質問者"@ja.
kg:op_1 prop:content "酒田市の再生エネルギー資源と活用方法の把握を求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市"@ja.
kg:st_2 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_2 prop:content "調査結果を踏まえて地域特性を生かした可能性を検討したい"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "詳しい調査研究が必要と考える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "調査結果なども踏まえて可能性の検討を進めたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "県の調査結果では風力とバイオマスの利用可能性が高いと認識している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "新エネルギービジョンの中で地域特性を生かした可能性を検討する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "さらなる導入施策についても検討したい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:st_3 rdfs:label "発言者"@ja.
kg:st_3 rdf:type cls:st_17.
cls:st_17 rdfs:label "発言者"@ja.
kg:op_8 prop:content "庄内地域の賦存量が高いことは理解している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "電力を運ぶ手段の確保が必要であり総合的に考えるべきだ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "自然エネルギーの利活用は今後進む方向性だとみている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "国や県の動きを見据えて新しいエネルギービジョンをつくりたい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "ビジョンに基づいて自然エネルギーの利活用促進を図りたい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "県が積極姿勢を示している中で市の取り組みを確認したい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "庄内が有望とされているため市の取り組み方を問う"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "国や県がエネルギー政策を大きく見直している動向を踏まえる必要がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "新年度に新エネルギービジョンの見直しを行う予定だ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "地域特性を生かした可能性の検討を進めたい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "新エネルギービジョンの見直し、さらなる再生可能エネルギーの導入の可能性を検討するとされております"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "これらの詳しい調査、研究も必要と考えます"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "昨年度県が調査した結果によりますと、本地域、本市のエネルギー資源の利用可能量というのはかなり高いと言われておりまして、その中でも風力とかバイオマスの利用可能性が高い"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "新エネルギービジョンの中で、しっかりこのような調査結果なども踏まえて、地域特性を生かした可能性の検討をしていかなければならない"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "さらなる再生可能エネルギー導入の施策などについても検討していきたい"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "自然エネルギーの利活用ももちろんあっていいわけであります。しかし、そしてまた賦存量が庄内地域は非常に高いということもよくわかった"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これはどうやって運ぶのかということも実は問題でありまして、これをどう解決していくのかということがないと、発電したはいいけれども電力が運べないということにもなりかねません"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "自然エネルギーというものが全体として、傾向として利活用が進むことは間違いない方向性だと思います"@ja.
<< kg:id_8 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "国や県の動きを見据えて、新しいエネルギービジョンをつくり"@ja.
<< kg:id_8 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "そのビジョンに基づいて自然エネルギーの利活用促進を図っていきたい"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "県は、再生新エネルギーに積極的に取り組む姿勢を示しております"@ja.
<< kg:id_14 prop:cause kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "県諮問機関でも庄内は有望と出ていました"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "国あるいは県、この大震災を受けまして、このエネルギー政策というものを大きく今、見直しをしている最中だということでございます"@ja.
<< kg:id_17 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "市におきましても新年度、新エネルギービジョンの見直しを行う予定になっております"@ja.
<< kg:id_17 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地域の特性を生かした可能性の検討というものを進めてまいりたい"@ja.
}
