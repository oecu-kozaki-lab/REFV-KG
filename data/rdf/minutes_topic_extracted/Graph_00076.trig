kg:id_1 rdfs:label "再生可能エネルギーの導入"@ja.
kg:id_1 rdf:type cls:c_216.
cls:c_216 rdfs:label "再生可能エネルギー"@ja.
kg:id_2 rdfs:label "新エネルギービジョンの見直し"@ja.
kg:id_2 rdf:type cls:c_271.
cls:c_271 rdfs:label "計画見直し"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "再生エネルギー資源の詳細な調査研究"@ja.
kg:id_3 rdf:type cls:c_2059.
cls:c_2059 rdfs:label "調査研究"@ja.
kg:id_1 prop:countermeasure kg:id_3.
