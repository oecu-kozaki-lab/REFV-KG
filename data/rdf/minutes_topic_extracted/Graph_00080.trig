kg:id_25 rdf:type cls:c_2193.
cls:c_2193 rdfs:label "価格低下"@ja.
kg:id_26 rdfs:label "採算悪化への懸念"@ja.
kg:id_26 rdf:type cls:c_2194.
cls:c_2194 rdfs:label "採算悪化"@ja.
