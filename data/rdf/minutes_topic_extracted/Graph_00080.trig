kg:id_19 rdf:type cls:c_2188.
cls:c_2188 rdfs:label "収益不足"@ja.
kg:id_20 rdfs:label "市民の税金を使って参入することを説明できないこと"@ja.
kg:id_20 rdf:type cls:c_2189.
cls:c_2189 rdfs:label "説明困難"@ja.
kg:id_19 prop:effect kg:id_20.
