kg:id_29 rdfs:label "環境影響評価を事前に実施して環境への影響を調査すること"@ja.
kg:id_29 rdf:type cls:c_1129.
cls:c_1129 rdfs:label "環境影響評価"@ja.
kg:id_27 prop:countermeasure kg:id_29.
kg:id_30 rdfs:label "景観への配慮を検討した上で事業実施の可否を判断すること"@ja.
kg:id_30 rdf:type cls:c_1128.
cls:c_1128 rdfs:label "景観配慮"@ja.
kg:id_27 prop:countermeasure kg:id_30.
kg:id_31 rdfs:label "市の風力発電施設設置"@ja.
kg:id_31 rdf:type cls:c_2196.
cls:c_2196 rdfs:label "施設設置"@ja.
kg:id_32 rdfs:label "十里塚の自治会や宮野浦のコミュニティ振興会へ説明すること"@ja.
kg:id_32 rdf:type cls:c_54.
cls:c_54 rdfs:label "住民説明"@ja.
kg:id_31 prop:countermeasure kg:id_32.
kg:id_33 rdfs:label "市報などを活用して市民へ適切な情報提供を行うこと"@ja.
kg:id_33 rdf:type cls:c_213.
cls:c_213 rdfs:label "情報提供"@ja.
kg:id_31 prop:countermeasure kg:id_33.
