kg:id_27 rdf:type cls:c_1088.
cls:c_1088 rdfs:label "施設建設"@ja.
kg:id_28 rdfs:label "事前に景観審議会や環境審議会へ取り組みたい旨を報告すること"@ja.
kg:id_28 rdf:type cls:c_2195.
cls:c_2195 rdfs:label "事前報告"@ja.
