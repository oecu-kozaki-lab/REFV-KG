cls:c_1157 rdfs:label "住民対話"@ja.
kg:id_22 prop:countermeasure kg:id_23.
kg:id_24 rdfs:label "地域住民にしっかり説明し意見を聞くこと"@ja.
kg:id_24 rdf:type cls:c_1157.
kg:id_1 prop:countermeasure kg:id_24.
kg:id_25 rdfs:label "事業について変更が必要であれば柔軟に検討すること"@ja.
kg:id_25 rdf:type cls:c_271.
cls:c_271 rdfs:label "計画見直し"@ja.
kg:id_1 prop:countermeasure kg:id_25.
kg:st_1 rdfs:label "質問者"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "質問者"@ja.
kg:op_1 prop:content "原発事故後の流れを受けた計画自体は認める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "庄内地域を風力発電適地とした判断の先に問題があると指摘する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市民団体"@ja.
kg:st_2 rdf:type cls:st_66.
cls:st_66 rdfs:label "市民団体"@ja.
kg:op_3 prop:content "大型風力により低周波や騒音の問題が生じることを懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "大型風力による景観や野鳥への影響を懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "市民団体は事業妨害ではなく問題点や危惧が多いため法に基づく評価を求めていると見る"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "住環境への悪影響として低周波や騒音を懸念する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "景観悪化や野鳥への影響を懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "生物多様性の豊かな地域への影響を懸念する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "市民団体の声に耳を貸さない姿勢は住民との対立を招いているように見える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "現在のやり方は市民一丸の方針に反すると批判する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "行政は結論ありきで進めると異論が出ても計画を変えなくなると批判する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "自主評価ではなく法に基づく環境影響評価を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "客観性と信頼性のため国の評価を受けるべきだと求める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_3 rdfs:label "市長"@ja.
kg:st_3 rdf:type cls:st_27.
cls:st_27 rdfs:label "市長"@ja.
kg:op_14 prop:content "法適用外でも法と同等の内容で調査し環境に配慮すると説明する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "方法書概要について地元説明会を開いていると説明する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "方法書を公表し市民説明会で意見を受けながら計画をつくる考えを示す"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "住民不安の解消に向け丁寧な対応を続けると述べる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "市民の意図を聞き取り対話を重ね柔軟に計画変更すべきだと主張する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "市民との対話を重視し住民説明と意見聴取を行う考えを示す"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "必要があれば事業変更も柔軟に検討すると述べる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "東日本大震災時の原発事故以来、脱原発と再生可能エネルギーという考え方が、全国に普及し、そしてそれを受けて、吉村知事も、卒原発を合言葉に、エネルギー戦略のもとで、県内の、それぞれの地域を生かした再生可能エネルギーを普及するための計画を発表し、庄内地域は風力発電が適正とし、十里塚地域に県と市がそれぞれ風力発電を建設するとしました"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "庄内地域は風力発電が適正とし、十里塚地域に県と市がそれぞれ風力発電を建設するとしました"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "市民団体からは、大型の風力のために低周波や騒音問題"@ja.
<< kg:id_7 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "市民団体からは、大型の風力のために低周波や騒音問題、あるいは景観や野鳥に対する影響"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "庄内海岸は生物多様性の宝庫ということもあり、３年から４年はかかりますが、法律に基づく評価を求めているのであります。私は、市民団体の方々は、決して風力発電事業を邪魔しようということからではなく、このような問題点や危惧することが多いことから、きちんと法律に基づく評価を求めているんだと思います"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "市民団体からは、大型の風力のために低周波や騒音問題"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "市民団体からは、大型の風力のために低周波や騒音問題、あるいは景観や野鳥に対する影響"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "そして庄内海岸は生物多様性の宝庫ということもあり"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "なぜこうした市民団体の声に耳を貸そうとしないのか。私から言わせれば、あえて住民と対立しようとしているように思われます"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "こうしたやり方は、市長が言う、市民一丸となって英知を結集することが全員野球オール酒田に反するのではないかと思います"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "とかく行政は、計画を決めると、丁寧に説明をすると、市民から異論が出ても、まず計画を変えようとしない"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "市民団体からは、大型の風力のために低周波や騒音問題、あるいは景観や野鳥に対する影響、そして庄内海岸は生物多様性の宝庫ということもあり、３年から４年はかかりますが、法律に基づく評価を求めているのであります"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "そうすれば、経済産業省、あるいは環境省からの評価ももらうことになります。ですから、客観的な判断という点で法アセスを受けて、経産省とか環境省のきちんと判断を受けたらどうですかという声なんです"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "そのために、環境影響評価の項目については、法に定める評価項目と同等の内容で、しっかりと調査を実施し、丁寧な説明を行いながら取り組んでいきたいというふうに思っています"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "現在、環境影響評価の具体的手法を定める方法書の概要について、地元に事前に説明会を開催しております"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "今後、方法書を広く公表するとともに市民説明会を開催し、評価項目や手法について意見をいただきながら、よりよい事業計画をつくっていくというふうに考えております"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "今後とも住民の不安が解消されるよう、丁寧な対応をしていきたいというふうに思っております"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "市民から意見が出れば、その意図とするところは何かを聞く耳を持つ、市民と膝を交えてとことん話し合い、計画を変更するところは変更するとした柔軟な考え方が行政にあってもいいと思います"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "市民との対話を重視し、そして声なき声にも耳を澄ましながら、市民目線で行政を行ってまいりたいという基本姿勢でございまして、風力発電事業についても、地域住民の皆様にしっかり説明し、意見を聞いてまいる考えであります"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "事業について変更が必要であれば、柔軟に検討してまいる考えであります"@ja.
}
