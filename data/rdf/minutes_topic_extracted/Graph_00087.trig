PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00087> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電施設の建設"@ja.
kg:id_1 rdf:type cls:c_1088.
cls:c_1088 rdfs:label "施設建設"@ja.
kg:id_2 rdfs:label "建設反対住民"@ja.
kg:id_2 rdf:type cls:c_2368.
cls:c_2368 rdfs:label "住民の反対"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "工事着工のおくれ"@ja.
kg:id_3 rdf:type cls:c_2369.
cls:c_2369 rdfs:label "着工遅延"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "予定どおり着工まで進める"@ja.
kg:id_4 rdf:type cls:c_2370.
cls:c_2370 rdfs:label "着工推進"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:st_1 rdfs:label "発言者"@ja.
kg:st_1 rdf:type cls:st_17.
cls:st_17 rdfs:label "発言者"@ja.
kg:op_1 prop:content "予定どおり着工まで進むことを期待する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "工事着工のおくれを気がかりに感じている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "予定どおり着工まで進むものと期待する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "建設反対住民のために工事着工がおくれている"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "建設反対住民のために工事着工がおくれていることが気がかりであります"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "予定どおり着工まで進むものと期待をいたします"@ja.
}
