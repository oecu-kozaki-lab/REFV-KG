PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00088> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "債務負担行為補正"@ja.
kg:id_1 rdf:type cls:c_298.
cls:c_298 rdfs:label "財政措置"@ja.
kg:id_2 rdfs:label "風力発電施設調査・測量・観測委託料など４件の廃止"@ja.
kg:id_2 rdf:type cls:c_2371.
cls:c_2371 rdfs:label "事業廃止"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "地球環境問題"@ja.
kg:id_3 rdf:type cls:c_1101.
cls:c_1101 rdfs:label "環境問題"@ja.
kg:id_4 rdfs:label "再生エネルギービジョンの策定"@ja.
kg:id_4 rdf:type cls:c_118.
cls:c_118 rdfs:label "計画策定"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "エネルギー問題"@ja.
kg:id_5 rdf:type cls:c_755.
cls:c_755 rdfs:label "エネルギー問題"@ja.
kg:id_5 prop:countermeasure kg:id_4.
kg:id_6 rdfs:label "風力発電"@ja.
kg:id_6 rdf:type cls:c_216.
cls:c_216 rdfs:label "再生可能エネルギー"@ja.
kg:id_7 rdfs:label "環境への影響に十分配慮した整備"@ja.
kg:id_7 rdf:type cls:c_2372.
cls:c_2372 rdfs:label "環境配慮整備"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "太陽光発電"@ja.
kg:id_8 rdf:type cls:c_216.
kg:id_9 rdfs:label "住宅用太陽光発電システム設置への支援継続"@ja.
kg:id_9 rdf:type cls:c_2206.
cls:c_2206 rdfs:label "設置支援"@ja.
kg:id_8 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "防災拠点となるタウンセンターなどへの蓄電池を組み合わせたシステムの設置"@ja.
kg:id_10 rdf:type cls:c_319.
cls:c_319 rdfs:label "設備設置"@ja.
kg:id_8 prop:countermeasure kg:id_10.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "債務負担行為補正につきましては、風力発電施設調査・測量・観測委託料など４件を廃止するものであります。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "地球環境問題とエネルギー問題に対応していくために、再生エネルギービジョンを昨年９月に策定いたしました。"@ja.
<< kg:id_5 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "地球環境問題とエネルギー問題に対応していくために、再生エネルギービジョンを昨年９月に策定いたしました。"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "本市が直営で取り組む十里塚地区の風力発電については、環境への影響に十分配慮した整備を行い、着実に計画を進めてまいります。"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "また、太陽光発電については、住宅用太陽光発電システム設置への支援を継続するとともに"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "国の補助金を活用して、防災拠点となるタウンセンターなどに蓄電池を組み合わせたシステムを設置いたします。"@ja.
}
