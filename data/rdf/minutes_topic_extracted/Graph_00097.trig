PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00097> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "直営風力発電事業"@ja.
kg:id_1 rdf:type cls:c_218.
cls:c_218 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "継続して取り組む"@ja.
kg:id_2 rdf:type cls:c_2475.
cls:c_2475 rdfs:label "継続実施"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "再生可能エネルギーの活用"@ja.
kg:id_3 rdf:type cls:c_1865.
cls:c_1865 rdfs:label "再生可能エネルギー活用"@ja.
kg:id_4 rdfs:label "風という本市の地域資源を生かす"@ja.
kg:id_4 rdf:type cls:c_2078.
cls:c_2078 rdfs:label "地域資源活用"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "原子力発電に頼らない社会構築への貢献"@ja.
kg:id_5 rdf:type cls:c_1304.
cls:c_1304 rdfs:label "社会貢献"@ja.
kg:id_3 prop:effect kg:id_5.
kg:id_6 rdfs:label "地域活性化"@ja.
kg:id_6 rdf:type cls:c_133.
cls:c_133 rdfs:label "地域活性化"@ja.
kg:id_3 prop:effect kg:id_6.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "直営風力発電事業に継続して取り組んでまいります"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "風という本市の地域資源を生かし"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:text-txt_contents "原子力発電に頼らない社会構築への貢献"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:text-txt_contents "地域活性化につなげていくため"@ja.
}
