kg:st_1 rdfs:label "発言者"@ja.
kg:st_1 rdf:type cls:st_17.
cls:st_17 rdfs:label "発言者"@ja.
kg:op_1 prop:content "国や県と連携して企業立地をさらに促進すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "港を中心とした産業力強化による雇用確保に期待する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "企業立地の増加で景観が変化するとの見通しを示す"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "酒田市"@ja.
kg:st_2 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_4 prop:content "社会的要請に応じて酒田港の優位性を生かし企業立地を進めたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "企業立地が進んだ際は工場夜景など施設活用も検討できる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "立地企業の協力を得て景観活用の取り組みを進めたい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "酒田市も再生可能エネルギーの数値目標を持って計画を進めるべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "酒田市も目標を持って洋上風力の企業立地促進に取り組むべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "再生エネルギー基地として研究所の整備も考えられる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "再生エネルギー基地として技術者養成機能も必要"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "再生エネルギー基地としてメンテナンス施設も必要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "発電産業とメンテナンス産業の誘致は有効だと考える"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "風力発電は年数経過に伴いメンテナンス需要が生じる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "風力発電の維持管理のため関連産業の誘致が重要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "古くなった港湾計画の改定に向けて関係機関と検討を進める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "酒田港活性化には新庄酒田道路の早期開通が重要"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "酒田港活性化には日本海沿岸自動車道の早期開通が重要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "新庄酒田道路の早期開通を強く要望していく"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "日本海沿岸自動車道の早期開通を強く要望していく"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "国や県としっかり連携をして、さらなる企業立地の促進や雇用の確保などで、港を中心とした産業力の強化は、大変に期待をするところです"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "国や県としっかり連携をして、さらなる企業立地の促進や雇用の確保などで、港を中心とした産業力の強化は、大変に期待をするところです"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "また、企業立地が多くなることによって、今までとは違った景観も出てくると思います"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "発電産業、再生可能エネルギーの港湾地区への集積と機能強化につきましては大変重要なことと考えております。国・県と連携しながら、そのような社会的な要請に応じ、酒田港の優位性を生かしつつ、さらなる企業立地に取り組んでまいりたいと考えております"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "企業立地が進んだ際には、そのような工場施設を活用した取り組みも検討し得るものと考えています"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "現在、酒田共同火力発電株式会社様から実施をしていただいております工場施設のライトアップや、サミット酒田パワー株式会社のバイオマスチップ倉庫の山居倉庫を模しました歓迎文字の表示などのように、立地企業の皆様の協力をいただきながら検討してまいりたいと考えております"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "現在の進捗率としては47万4,000kWということなんですが、これ酒田市としてもですね、ぜひ再生可能エネルギーの目標を立てて、例えば2030年までにどのぐらいの目標を立てて計画を進めていけるのか、そういうことができないものなのかなと思っております"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "来年度の山形県の重点要望のところにも、再生可能エネルギー基地として洋上風力のほうを企業立地促進するというところでありますので、その辺酒田市としても目標を持ってできないものなのか"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "今後の考え方なんですが、例えば再生エネルギー基地としての研究所とか技術者の養成所とか、またはメンテナンス施設など、そういうことも考えられるのではないのかなと思っております"@ja.
<< kg:id_15 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "今後の考え方なんですが、例えば再生エネルギー基地としての研究所とか技術者の養成所とか、またはメンテナンス施設など、そういうことも考えられるのではないのかなと思っております"@ja.
<< kg:id_15 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "今後の考え方なんですが、例えば再生エネルギー基地としての研究所とか技術者の養成所とか、またはメンテナンス施設など、そういうことも考えられるのではないのかなと思っております"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "さらなる発電産業、メンテナンス産業の誘致の関係もお尋ねがありました。これにつきましては、大変有効なものだと考えております"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "風力発電なりも年数を経過しますとやはりメンテナンスが必要だということで"@ja.
<< kg:id_21 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "風力発電なりも年数を経過しますとやはりメンテナンスが必要だということで、これらの誘致も大変重要かなと考えております"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "今現在、酒田港の臨港地区の今後の考え方、今後の将来の方向性を示します港湾計画、これがかなり古くなっておりまして、改定に向けまして県、それから国、市が関係団体と検討を始めるとなっております"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "ただ、やはり酒田港がますます元気になるには、先ほど市長が申し上げましたように、高規格道路の新庄酒田道路の早期開通、それから日本海沿岸自動車道の早期開通が重要だと思っております"@ja.
<< kg:id_26 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "ただ、やはり酒田港がますます元気になるには、先ほど市長が申し上げましたように、高規格道路の新庄酒田道路の早期開通、それから日本海沿岸自動車道の早期開通が重要だと思っております"@ja.
<< kg:id_26 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "その点につきましても強く要望していきたいと考えております"@ja.
<< kg:id_26 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "ただ、やはり酒田港がますます元気になるには、先ほど市長が申し上げましたように、高規格道路の新庄酒田道路の早期開通、それから日本海沿岸自動車道の早期開通が重要だと思っておりますので、その点につきましても強く要望していきたいと考えております"@ja.
}
