PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00101> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "酒田市風力発電事業発電所建設工事"@ja.
kg:id_1 rdf:type cls:c_85.
cls:c_85 rdfs:label "建設工事"@ja.
kg:id_2 rdfs:label "請負契約の締結"@ja.
kg:id_2 rdf:type cls:c_2534.
cls:c_2534 rdfs:label "請負契約"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:st_1 rdfs:label "総務常任委員会委員長"@ja.
kg:st_1 rdf:type cls:st_68.
cls:st_68 rdfs:label "委員長"@ja.
kg:op_1 prop:content "原案を妥当と認め可決すべきと報告"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "田中廣議長"@ja.
kg:st_2 rdf:type cls:st_69.
cls:st_69 rdfs:label "議長"@ja.
kg:op_2 prop:content "委員長報告のとおり決した"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "出席者"@ja.
kg:st_3 rdf:type cls:st_70.
cls:st_70 rdfs:label "出席者"@ja.
kg:op_3 prop:content "異議なし"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本案は、酒田市風力発電事業発電所建設工事の請負契約を締結するものであり、原案を妥当と認め可決すべきものと決定いたしました。"@ja.
}
