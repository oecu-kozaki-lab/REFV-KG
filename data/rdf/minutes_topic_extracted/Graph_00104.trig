kg:id_17 rdf:type cls:c_2584.
cls:c_2584 rdfs:label "建設懸念"@ja.
kg:id_1 prop:effect kg:id_17.
kg:id_18 rdfs:label "市民から風力発電建設ありきで予算が組まれたと受けとられること"@ja.
kg:id_18 rdf:type cls:c_2585.
cls:c_2585 rdfs:label "市民不信"@ja.
kg:id_1 prop:effect kg:id_18.
