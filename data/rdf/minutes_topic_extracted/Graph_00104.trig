kg:id_1 prop:cause kg:id_12.
kg:id_13 rdfs:label "日本海を代表する白砂青松の海岸の風致景観に著しい支障を与えるおそれ"@ja.
kg:id_13 rdf:type cls:c_50.
cls:c_50 rdfs:label "景観影響"@ja.
