kg:id_19 rdf:type cls:c_2586.
cls:c_2586 rdfs:label "騒音発生"@ja.
kg:id_1 prop:effect kg:id_19.
kg:id_20 rdfs:label "クロマツ林の松くい被害への影響"@ja.
kg:id_20 rdf:type cls:c_2587.
cls:c_2587 rdfs:label "森林影響"@ja.
kg:id_1 prop:effect kg:id_20.
kg:id_21 rdfs:label "本市での最適地を模索すること"@ja.
kg:id_21 rdf:type cls:c_2588.
cls:c_2588 rdfs:label "立地再検討"@ja.
kg:id_1 prop:countermeasure kg:id_21.
kg:id_22 rdfs:label "再生可能エネルギーの形成を再検討していくこと"@ja.
kg:id_22 rdf:type cls:c_2589.
cls:c_2589 rdfs:label "事業再検討"@ja.
kg:id_1 prop:countermeasure kg:id_22.
kg:id_23 rdfs:label "環境保全措置の確実な実行を条件として許可及び受理すること"@ja.
kg:id_23 rdf:type cls:c_2590.
cls:c_2590 rdfs:label "条件付き許可"@ja.
kg:id_1 prop:countermeasure kg:id_23.
kg:id_24 rdfs:label "説明会や現地調査の市民向け説明会を行うこと"@ja.
kg:id_24 rdf:type cls:c_210.
cls:c_210 rdfs:label "説明実施"@ja.
kg:id_1 prop:countermeasure kg:id_24.
kg:id_25 rdfs:label "事業地周辺の自治会でも説明会を行うこと"@ja.
kg:id_25 rdf:type cls:c_210.
kg:id_1 prop:countermeasure kg:id_25.
kg:id_26 rdfs:label "慎重な意見を持つ方々のシンポジウムに担当職員が出席して意見を聞くこと"@ja.
kg:id_26 rdf:type cls:c_82.
cls:c_82 rdfs:label "意見聴取"@ja.
kg:id_1 prop:countermeasure kg:id_26.
kg:id_27 rdfs:label "植生回復などについての意見をいただきながら進めること"@ja.
kg:id_27 rdf:type cls:c_719.
cls:c_719 rdfs:label "意見反映"@ja.
kg:id_1 prop:countermeasure kg:id_27.
kg:id_28 rdfs:label "自然環境と調和したよりよい事業となるよう進めること"@ja.
kg:id_28 rdf:type cls:c_1442.
cls:c_1442 rdfs:label "環境調和"@ja.
kg:id_1 prop:countermeasure kg:id_28.
kg:id_29 rdfs:label "老朽化した自治会館の改築と風力発電施設の管理棟を合築すること"@ja.
kg:id_29 rdf:type cls:c_305.
cls:c_305 rdfs:label "施設整備"@ja.
kg:id_1 prop:countermeasure kg:id_29.
kg:id_30 rdfs:label "管理棟を環境モニタリングの現場基地として活用すること"@ja.
kg:id_30 rdf:type cls:c_2591.
cls:c_2591 rdfs:label "監視拠点"@ja.
kg:id_1 prop:countermeasure kg:id_30.
kg:id_31 rdfs:label "市民等が自然エネルギーを学ぶ場として活用すること"@ja.
kg:id_31 rdf:type cls:c_2592.
cls:c_2592 rdfs:label "学習活用"@ja.
kg:id_1 prop:countermeasure kg:id_31.
kg:id_32 rdfs:label "許可がおり次第すぐに着手できるよう当初予算に計上すること"@ja.
kg:id_32 rdf:type cls:c_2593.
cls:c_2593 rdfs:label "予算計上"@ja.
kg:id_1 prop:countermeasure kg:id_32.
kg:id_33 rdfs:label "風車本体工事費を精査積算した上で補正予算として提案すること"@ja.
kg:id_33 rdf:type cls:c_2594.
cls:c_2594 rdfs:label "費用精査"@ja.
kg:id_1 prop:countermeasure kg:id_33.
kg:id_34 rdfs:label "環境影響評価書に記載された環境保全措置を確実に実行すること"@ja.
kg:id_34 rdf:type cls:c_475.
cls:c_475 rdfs:label "環境保全"@ja.
kg:id_1 prop:countermeasure kg:id_34.
kg:id_35 rdfs:label "騒音及び超低周波音の四季ごとの調査を行うこと"@ja.
kg:id_35 rdf:type cls:c_2595.
cls:c_2595 rdfs:label "騒音調査"@ja.
kg:id_1 prop:countermeasure kg:id_35.
kg:id_36 rdfs:label "クロマツ林の松くい被害の現況把握を行うこと"@ja.
kg:id_36 rdf:type cls:c_2596.
cls:c_2596 rdfs:label "現況把握"@ja.
kg:id_1 prop:countermeasure kg:id_36.
kg:id_37 rdfs:label "工事計画を検討すること"@ja.
kg:id_37 rdf:type cls:c_307.
cls:c_307 rdfs:label "計画検討"@ja.
kg:id_1 prop:countermeasure kg:id_37.
kg:id_38 rdfs:label "環境や景観に与える影響を回避低減する計画とすること"@ja.
kg:id_38 rdf:type cls:c_2597.
cls:c_2597 rdfs:label "影響低減"@ja.
kg:id_1 prop:countermeasure kg:id_38.
kg:st_1 rdfs:label "議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "風況のよさだけで最適地判断したのは問題である"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "従来認めてこなかった計画をトップダウンで変えたのは問題である"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "当初から環境アセス逃れが指摘されていた"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "砂草地に関する検討で庄内森林管理署の見解理解が不足している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "専門家意見の集約が不十分である"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地元研究者の意見聴取が欠けている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "未解決の論点が残る中で許可したのは拙速である"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "事業は突然発表され進められた"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "市民合意のないトップダウン政策である"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市長"@ja.
kg:st_2 rdf:type cls:st_27.
cls:st_27 rdfs:label "市長"@ja.
kg:op_10 prop:content "自治会館改築を急ぐ必要があった"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "本体工事費は価格変動を見極めた上で精査すべきである"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "海岸景観への重大な悪影響が懸念される"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "将来世代にリスクを残すべきではない"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_3 rdfs:label "クロマツ林文化創造ネットワークの森代表初め４名の方々"@ja.
kg:st_3 rdf:type cls:st_66.
cls:st_66 rdfs:label "市民団体"@ja.
kg:op_14 prop:content "砂草地での建設に不安がある"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "撤去費用の負担が懸念される"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "県立自然公園内での建設に懸念がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "建設ありきの予算編成と市民に受けとられるおそれがある"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "騒音と超低周波音への配慮が必要である"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "クロマツ林への影響把握が必要である"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "一歩立ちどまり市内の最適地を再検討すべきである"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "再生可能エネルギーの進め方を見直すべきである"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "環境保全措置を確実に実行することを条件に事業を進めるべきである"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "市民説明を重ねながら進めてきた"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "周辺自治会の意見も聞いてきた"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "慎重派の意見も継続的に聴取してきた"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "植生回復の意見を反映しながら進めたい"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "自然環境と調和する事業にしていくべきである"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "自治会館改築と管理棟整備を一体で進める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "管理棟を長期の環境モニタリング拠点として活用する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "施設を自然エネルギー学習の場にしたい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "許可後速やかに着手できるよう予算を先行計上した"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "本体工事費は精査後に補正予算で提案する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "環境保全措置の確実な実行を前提に事業を行うべきである"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "騒音と超低周波音は四季ごとに調査すべきである"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "クロマツ林の現況把握を行うべきである"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "環境と景観への影響を抑える工事計画の検討が必要である"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "環境と景観への影響は回避低減すべきである"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "単なる風況のよさという視点からだけで県は最適地であるとしたこと"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "トップだけで考えを変えてしまったこと"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "この事業に関しては当初から環境アセス逃れと指摘され"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "自主アセスといえども庄内森林管理署の見解を理解していないこと"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "山形大学の海岸林などの専門の先生方の意見を集約していないこと"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "地元の砂草地研究の第一人者の意見を聞いていないこと"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "たくさんの未解決な議論がまだまだあったにもかかわらず、県はゴーサインを出してしまいました"@ja.
<< kg:id_1 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "この風力発電事業は、前々市長時代に突如として発表され"@ja.
<< kg:id_1 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "市民との合意形成も何もされてこなかったトップダウンの政策であり"@ja.
<< kg:id_1 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "昨年の暴風雨により自治会館の屋根の一部が破損するなど"@ja.
<< kg:id_1 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "風車本体は外国製の機種を予定しておりまして、価格の変動が予想されるため"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "日本海を代表する白砂青松の海岸の風致景観に著しい支障を与えるおそれがある"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "20年後の将来世代にリスクを負わせないように"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "砂草地での建設に対する心配"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "風車を撤去する際の費用"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "県立自然公園内での建設"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "風力発電建設ありきで組まれたのではないかと市民から受けとられるのではないか"@ja.
<< kg:id_1 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "騒音及び超低周波音の四季ごとの調査"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "クロマツ林の松くい被害の現況把握"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "本市での最適地を模索し"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "再生可能エネルギーの形成を再検討していくべき"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "環境保全措置の確実な実行を条件として許可及び受理が妥当だ"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "この事業の説明会や環境影響評価方法書、準備書、現地調査などの市民向け説明会"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "事業地周辺の自治会でも説明会を行って多くの市民の皆さんの意見をお聞きをしてきた"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "この事業に慎重な意見を持つ方々のシンポジウム等にも、これまで担当職員が５回出席をし、意見をお聞きしてきた"@ja.
<< kg:id_1 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "改めて植生回復などについての意見をいただきながら"@ja.
<< kg:id_1 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "自然環境と調和したよりよい事業となるように鋭意進めてまいりたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "地元十里塚自治会の老朽化した自治会館の改築と風力発電施設の管理棟を合築する"@ja.
<< kg:id_1 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "20年間継続実施する環境モニタリングの現場基地として活用して"@ja.
<< kg:id_1 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "市民等が自然エネルギーを学ぶ場としての活用も考えている"@ja.
<< kg:id_1 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "許可がおり次第すぐに着手できるように、この予算のみ当初予算に計上した"@ja.
<< kg:id_1 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "必要な費用を精査、積算した上で、今後、補正予算という形で提案をしてまいりたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "環境影響評価書に記載された環境保全措置を確実に実行することを条件として"@ja.
<< kg:id_1 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "騒音及び超低周波音の四季ごとの調査"@ja.
<< kg:id_1 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "クロマツ林の松くい被害の現況把握"@ja.
<< kg:id_1 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "工事計画の検討等を行うなど"@ja.
<< kg:id_1 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "環境や景観に与える影響を回避、低減する計画となるよう丁寧に対応をしてきた"@ja.
}
