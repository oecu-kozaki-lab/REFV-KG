PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00109> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電事業特別会計予算"@ja.
kg:id_1 rdf:type cls:c_922.
cls:c_922 rdfs:label "補正予算"@ja.
kg:id_2 rdfs:label "風力発電施設の建設費の計上"@ja.
kg:id_2 rdf:type cls:c_2633.
cls:c_2633 rdfs:label "建設費計上"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "平成30年度酒田市風力発電事業特別会計補正予算（第1号）"@ja.
kg:id_3 rdf:type cls:c_922.
kg:id_4 rdfs:label "風力発電事業特別会計予算を11億7,240万円増額"@ja.
kg:id_4 rdf:type cls:c_942.
cls:c_942 rdfs:label "予算増額"@ja.
kg:id_3 prop:effect kg:id_4.
kg:id_5 rdfs:label "予算総額を12億3,932万5,000円とする"@ja.
kg:id_5 rdf:type cls:c_819.
cls:c_819 rdfs:label "予算総額"@ja.
kg:id_3 prop:effect kg:id_5.
kg:id_6 rdfs:label "風力発電事業費の増額"@ja.
kg:id_6 rdf:type cls:c_943.
cls:c_943 rdfs:label "事業費増額"@ja.
kg:id_3 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "市債の増額"@ja.
kg:id_7 rdf:type cls:c_2634.
cls:c_2634 rdfs:label "市債増額"@ja.
kg:id_3 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "継続費の設定"@ja.
kg:id_8 rdf:type cls:c_2635.
cls:c_2635 rdfs:label "費用設定"@ja.
kg:id_3 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "債務負担行為の設定"@ja.
kg:id_9 rdf:type cls:c_2635.
kg:id_3 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "地方債限度額の変更"@ja.
kg:id_10 rdf:type cls:c_2046.
cls:c_2046 rdfs:label "限度額変更"@ja.
kg:id_3 prop:countermeasure kg:id_10.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "このたびの補正は、風力発電施設の建設費の計上に伴うもので"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:text-txt_contents "風力発電事業特別会計予算を11億7,240万円増額し"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:text-txt_contents "予算総額を12億3,932万5,000円とするものであります"@ja.
<< kg:id_3 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "歳出では風力発電事業費を、それぞれ増額するとともに"@ja.
<< kg:id_3 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "歳入では市債をそれぞれ増額するとともに"@ja.
<< kg:id_3 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "継続費及び債務負担行為の設定"@ja.
<< kg:id_3 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "継続費及び債務負担行為の設定"@ja.
<< kg:id_3 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "地方債限度額の変更をするものであります"@ja.
}
