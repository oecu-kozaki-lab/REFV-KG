PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00114> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "遊佐町沖洋上風力発電事業計画に係る調査等特別委員会の設置"@ja.
kg:id_1 rdf:type cls:c_2716.
cls:c_2716 rdfs:label "特別委員会"@ja.
kg:id_2 rdfs:label "調査等特別委員会の設置"@ja.
kg:id_2 rdf:type cls:c_2717.
cls:c_2717 rdfs:label "委員会設置"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "遊佐町沖洋上風力発電事業計画に係る調査等特別委員会"@ja.
kg:id_3 rdf:type cls:c_2716.
kg:id_4 rdfs:label "委員長と副委員長の互選"@ja.
kg:id_4 rdf:type cls:c_2718.
cls:c_2718 rdfs:label "役員選出"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:st_1 rdfs:label "議長"@ja.
kg:st_1 rdf:type cls:st_73.
cls:st_73 rdfs:label "議会関係者"@ja.
kg:op_1 prop:content "質疑と討論を省略し原案どおり決定したい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "出席者多数"@ja.
kg:st_2 rdf:type cls:st_25.
cls:st_25 rdfs:label "参加者"@ja.
kg:op_2 prop:content "異議なし"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "互選結果を報告する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "日程第４、発議第13号遊佐町沖洋上風力発電事業計画に係る調査等特別委員会の設置についての件を議題といたします。お諮りいたします。本件につきましては、さきの全員協議会で協議したとおりでありますので、この際質疑、討論を省略し、原案のとおり決定したいと思いますが、これにご異議ございませんか。（「異議なし」の声多数）ご異議なしと認めます。よって、本件は原案のとおり可決されました。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "遊佐町沖洋上風力発電事業計画に係る調査等特別委員会の正副委員長互選のため、本会議を休憩いたします。遊佐町沖洋上風力発電事業計画に係る調査等特別委員会の委員長、副委員長が互選されましたので、その結果を報告いたします。遊佐町沖洋上風力発電事業に係る調査等特別委員会の委員長に齋藤武議員、同副委員長に那須正幸議員。"@ja.
}
