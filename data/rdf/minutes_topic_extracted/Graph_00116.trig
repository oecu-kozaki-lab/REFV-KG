 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "洋上風力発電"@ja.
kg:id_1 rdf:type cls:c_1093.
cls:c_1093 rdfs:label "発電設備"@ja.
kg:id_2 rdfs:label "海上で大型化が進むこと"@ja.
kg:id_2 rdf:type cls:c_2808.
cls:c_2808 rdfs:label "大型化"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "浮体式洋上風力発電"@ja.
kg:id_3 rdf:type cls:c_1093.
kg:id_4 rdfs:label "海底が水深50メートルを超えること"@ja.
kg:id_4 rdf:type cls:c_2809.
cls:c_2809 rdfs:label "海域条件"@ja.
kg:id_3 prop:cause kg:id_4.
kg:id_5 rdfs:label "風速の3乗に比例して発電量が増えること"@ja.
kg:id_5 rdf:type cls:c_2810.
cls:c_2810 rdfs:label "発電特性"@ja.
kg:id_1 prop:cause kg:id_5.
kg:id_6 rdfs:label "発電効率がすぐれる"@ja.
kg:id_6 rdf:type cls:c_776.
cls:c_776 rdfs:label "高効率"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "騒音や景観破壊が起きにくい"@ja.
kg:id_7 rdf:type cls:c_2811.
cls:c_2811 rdfs:label "低影響"@ja.
kg:id_1 prop:effect kg:id_7.
kg:id_8 rdfs:label "人に影響を及ぼす可能性は小さい"@ja.
kg:id_8 rdf:type cls:c_2811.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "超低周波音の検証が必要"@ja.
kg:id_9 rdf:type cls:c_2812.
cls:c_2812 rdfs:label "検証必要"@ja.
kg:id_1 prop:effect kg:id_9.
kg:id_10 rdfs:label "安定的で変動が陸上に比べて少ない"@ja.
kg:id_10 rdf:type cls:c_2813.
cls:c_2813 rdfs:label "安定性"@ja.
kg:id_1 prop:effect kg:id_10.
kg:id_11 rdfs:label "新たな発電供給源の再生可能エネルギーとして注目されている"@ja.
kg:id_11 rdf:type cls:c_2814.
cls:c_2814 rdfs:label "再生エネ"@ja.
kg:id_1 prop:effect kg:id_11.
kg:id_12 rdfs:label "原子力発電以上にコストがかからない可能性がある"@ja.
kg:id_12 rdf:type cls:c_2815.
cls:c_2815 rdfs:label "低コスト"@ja.
kg:id_1 prop:effect kg:id_12.
kg:id_13 rdfs:label "廃炉の必要がない"@ja.
kg:id_13 rdf:type cls:c_2816.
cls:c_2816 rdfs:label "廃炉不要"@ja.
kg:id_1 prop:effect kg:id_13.
kg:id_14 rdfs:label "建設コストが30ないし40％割高となる"@ja.
kg:id_14 rdf:type cls:c_577.
cls:c_577 rdfs:label "高コスト"@ja.
kg:id_1 prop:effect kg:id_14.
kg:id_15 rdfs:label "環境と漁業への影響が懸念される"@ja.
kg:id_15 rdf:type cls:c_2817.
cls:c_2817 rdfs:label "影響懸念"@ja.
kg:id_1 prop:effect kg:id_15.
kg:id_16 rdfs:label "海上が荒れたときには適切なメンテナンスができない場合がある"@ja.
kg:id_16 rdf:type cls:c_2215.
cls:c_2215 rdfs:label "保守困難"@ja.
kg:id_1 prop:effect kg:id_16.
kg:id_17 rdfs:label "遠隔メンテナンスや運用状況をきちんと理解し把握する"@ja.
kg:id_17 rdf:type cls:c_2818.
cls:c_2818 rdfs:label "保守管理"@ja.
kg:id_1 prop:countermeasure kg:id_17.
kg:id_18 rdfs:label "地域の住民の声を反映させ町が仲介の役割を担う"@ja.
kg:id_18 rdf:type cls:c_2819.
cls:c_2819 rdfs:label "住民反映"@ja.
kg:id_1 prop:countermeasure kg:id_18.
kg:id_19 rdfs:label "地域の合意形成に向け課題の抽出や対応策の議論を行う"@ja.
kg:id_19 rdf:type cls:c_138.
cls:c_138 rdfs:label "合意形成"@ja.
kg:id_1 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "地域や漁業関係者に事業の周知を行い理解を図る"@ja.
kg:id_20 rdf:type cls:c_976.
cls:c_976 rdfs:label "周知活動"@ja.
kg:id_1 prop:countermeasure kg:id_20.
kg:id_21 rdfs:label "町民の皆さんに浸透を図っていく"@ja.
kg:id_21 rdf:type cls:c_140.
cls:c_140 rdfs:label "理解促進"@ja.
kg:id_1 prop:countermeasure kg:id_21.
kg:id_22 rdfs:label "地域の皆さんの合意形成をまず第一に重視する"@ja.
kg:id_22 rdf:type cls:c_138.
kg:id_1 prop:countermeasure kg:id_22.
kg:st_1 rdfs:label "10番 斎藤弥志夫君"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "洋上風力発電は望ましい設備であり普及の下地ができてきた"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "風速が倍になると発電量が8倍になり有力な再生エネルギーだ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "安定的に電気を起こすことができる望ましい設備だ"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "洋上は風が安定しており本格普及が期待できる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "再生エネルギーとして非常に有力で前向きに臨むべきだ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長 時田博機君"@ja.
kg:st_2 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_6 prop:content "町に直接の許認可権はないが住民の声を届ける努力をしたい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "関係者の理解促進に資する調査研究を進めるべきだ"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "地域や漁業関係者に周知し理解を図りながら検討したい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:st_3 rdfs:label "地域生活課長 畠中良一君"@ja.
kg:st_3 rdf:type cls:st_19.
cls:st_19 rdfs:label "自治体職員"@ja.
kg:op_9 prop:content "地域の合意形成が第一であり町民への浸透がまず大事だ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "洋上風力発電を進めるなら地域の合意形成が最も重要だ"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "騒音などの問題が起こりにくい洋上では大型化が進んでおり"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "海底が水深50メートルを超える場合、設置コストや発電効率の面から浮体式のほうが適しているとされます"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "理論的には発電量は風速の３乗に比例するため、不安定な陸上風より海上風のほうがすぐれています"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "風力発電においては、風車のブレード（羽根部分）が大きいほうが発電効率がすぐれます"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "陸上から数キロメートル離れた場所にあるため、騒音や景観破壊が起きにくく"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:text-txt_contents "人に影響を及ぼす可能性は小さいが、超低周波音については検証が必要であります"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:text-txt_contents "超低周波音については検証が必要であります"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "安定的で変動が陸上に比べて少ない"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "新たな発電供給源の再生可能エネルギーとして注目されています"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:text-txt_contents "一部機関の算定では原子力発電以上にコストがかからない可能性もあるし"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:text-txt_contents "廃炉の必要もありません"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:text-txt_contents "陸上風力より建設コストは30ないし40％割高となります"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:text-txt_contents "土台に既存の生態系とは異なる生態系が生まれる可能性があって、環境と漁業への影響が懸念されます"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:text-txt_contents "海上が荒れたときには適切なメンテナンスができない場合があって"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:text-txt_contents "遠隔メンテナンスや運用状況をきちんと理解し、把握する必要があります"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "地域の住民の皆さんの声をしっかりやっぱり反映させる、その声を届ける努力を町としては仲介の役割を担っていきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "一般海域における洋上風力発電のあり方に係る地域の合意形成に向け、課題の抽出や対応策等の議論を行う"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今後も引き続き、地域や漁業関係者に事業の周知を行い、理解を図りながら、検討を行ってまいりたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "町民の皆さんに浸透を図っていくことがまず大事なのかなというふうに考えてございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "洋上風力発電を進めていくとすれば、地域の皆さんの合意形成がまず第一に重要でないかなというふうに思ってございます"@ja.
}
