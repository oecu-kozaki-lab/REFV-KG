kg:id_19 prop:effect kg:id_21.
kg:id_22 rdfs:label "岩ガキの成長"@ja.
kg:id_22 rdf:type cls:c_2993.
cls:c_2993 rdfs:label "成長"@ja.
kg:id_23 rdfs:label "当初予定より時間がかかり1年から1年半くらいかかる感じがする"@ja.
kg:id_23 rdf:type cls:c_2994.
