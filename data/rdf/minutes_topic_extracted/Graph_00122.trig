kg:id_38 rdfs:label "海上養殖"@ja.
kg:id_38 rdf:type cls:c_3005.
cls:c_3005 rdfs:label "海上養殖"@ja.
kg:id_39 rdfs:label "大いに振興すべき"@ja.
kg:id_39 rdf:type cls:c_3006.
cls:c_3006 rdfs:label "振興要望"@ja.
kg:id_38 prop:countermeasure kg:id_39.
kg:st_1 rdfs:label "阿部満吉委員"@ja.
kg:st_1 rdf:type cls:st_30.
cls:st_30 rdfs:label "委員"@ja.
kg:op_1 prop:content "漁業者が取り組むには費用負担が大き過ぎる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "水産業事業は成果が乏しいように見える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "事業内容を説明できるようにしてほしい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "産業課長 佐藤啓之君"@ja.
kg:st_2 rdf:type cls:st_40.
cls:st_40 rdfs:label "行政"@ja.
kg:op_4 prop:content "漁業では担い手不足という状況がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "海の資源不足により漁獲量減少が続いている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "流砂の浸食で岩ガキの生育環境が減っている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "県事業を活用して藻場再生を進める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "藻場造成を予定している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "増殖礁の設置も行う予定である"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "種苗導入により成長状況を実験的に検証している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "沈殿槽の泥の影響で半数程度が閉止した可能性がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "一部で成長は確認できた"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "成長した個体は四、五センチ程度まで育っている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "想定より成長に時間がかかっている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "水温や海況の違いが成長に影響している可能性がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "水温や水流など複数要因を今後検証する必要がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "継続して検証しながら取り組みたい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "設置時の漁業への影響を調査部会で検討している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "漁業者に強い反対はない"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "魚礁効果による水産資源活用への期待がある"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "地域振興策として基金設置の話がある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "影響発生時には基金を漁業振興に活用できるよう検討している"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "地域貢献基金を対策に活用したい考えである"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:st_3 rdfs:label "漁業者の方々"@ja.
kg:st_3 rdf:type cls:st_14.
cls:st_14 rdfs:label "漁業者"@ja.
kg:op_24 prop:content "固定資産税が入るなら漁業関係に使える仕組みを望む"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:st_4 rdfs:label "全国の漁業者の組合"@ja.
kg:st_4 rdf:type cls:st_77.
cls:st_77 rdfs:label "漁業団体"@ja.
kg:op_25 prop:content "海上養殖は積極的に振興すべきだとしている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "アワビにしても陸上養殖、なかなか漁業者が取り組むにはちょっとお金がかかり過ぎるような今のところの状況だと思います"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "あまり成果が見られないということで"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "この水産業に関する事業に対してちょっと批判的な目もございます"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "漁業関係については担い手の方も不足をしているという状況もございます"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "世界的に海の資源そのものが今不足しているという状況にもなっているようであります。酒田飽海管内の年間の漁獲量につきましても年々減少はしている"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "特産品の岩ガキについてもなかなか流砂の浸食によりまして藻場が、岩場が少なくなっているという状況もございます"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "そちらの藻場の再生については県の事業を利用しながら"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "滝ノ浦から女鹿のほうにかけまして藻場の造成でありますとか"@ja.
<< kg:id_12 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "岩ガキ用の増殖礁の設置を行う予定でおります"@ja.
<< kg:id_12 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "岩ガキの種苗を導入して、一応どのように成長するか実験をしている最中であります"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "その泥がちょっとかぶってしまいまして半分ぐらいちょっと閉止してしまったのではないかという状況がございました"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "約６万個ほど一応種苗導入したわけでありますけれども、5,000から6,000個の目で見えるものが成長が確認できました"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "それが最近になって見てみますと小指の爪の大きさから四、五センチ程度まで成長している"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "当初予定していた成長、10か月ほどで大きくなるかなと思ったのですが、１年から１年半くらいかかるような感じはしている"@ja.
<< kg:id_22 prop:cause kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "徳島のほうの水温とはまたこちらの釜磯の状況は違いますし"@ja.
<< kg:id_22 prop:cause kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "水温の違いでありますとか水流の違いとか要因はいろいろ考えられます"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "今後もそういった検証をしながらやっていきたいというふうには思っております"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "漁業者の皆さんと洋上風力発電施設を設置した場合どのような影響があるのかというような話で検討を進めております"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "漁業者の皆さんについては特に反対ということはございません"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "その根本の辺り、海水の中になりますが、そちら魚礁として利用して、さらに水産資源として利用できないものかということで期待をしているほうが大きい"@ja.
<< kg:id_28 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "部会のほうでも地域振興策として事業者が発電施設を設置した場合、そちらに地域貢献として基金となるようなものを設置したいという話もございました"@ja.
<< kg:id_28 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "もし何かあった場合はそれらを漁業振興策のようなものに使うようにできないかというような検討はしております"@ja.
<< kg:id_28 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "そちらのほうをそういった対策については使用していきたいというふうに考えているところでます"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "もし固定資産税が入るのであれば漁業関係に使えるような仕組みをつくってほしいというようなお話をいただきました"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "全国の漁業者の組合のほうからも海上養殖に関しては大いに振興すべしというようなこともある"@ja.
}
