kg:id_56 rdf:type cls:c_3047.
cls:c_3047 rdfs:label "環境取組"@ja.
kg:id_57 rdfs:label "持続可能な地域づくりの団体とネットワークをつなげる"@ja.
kg:id_57 rdf:type cls:c_3048.
cls:c_3048 rdfs:label "団体連携"@ja.
kg:id_56 prop:countermeasure kg:id_57.
kg:st_1 rdfs:label "町長 時田博機"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "橋の弱体化を踏まえ国道7号の機能強化が必要だとみる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "工業団地と港湾の活用のため高規格道路化が必要だと考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "橋が弱く重量物運搬に制約が生じたと説明する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "国道7号を高規格道路として整備すべきだと求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "県議と連携して国への働きかけを進めた"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "赤塚英一議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_6 prop:content "流砂で磯場が縮小し漁獲量減少につながっていると懸念する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "天候不順が漁獲量減少の一因だと説明する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "検査結果により出漁できない日が多かったと説明する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "資源回復を上回る漁獲が減少要因だと認識する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "磯焼けが資源減少の要因だとみる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "流砂堆積で漁場が失われていると説明する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "吹浦漁港の水揚げ量は大幅に減少していると示す"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "遊佐町だけでなく県全体の課題になっていると指摘する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "吹浦漁港の県内シェアも低下していると説明する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "岩ガキを求める来訪者を満足させにくい状況だとみる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "漁獲量減少が後継者不足にもつながっていると問題視する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "環境変化を把握するため測量調査を進めている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "砂の影響が少ない場所への増殖礁設置に期待している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "増殖試験礁の設置を実施済みだと説明する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "女鹿沖での整備完了と効果を期待している"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "県全体で資源管理に取り組む必要があると考える"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "漁場回復に向けた実証実験を進めている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "蓄養技術の研究も水産振興に必要だとする"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "関係機関と連携し研究開発を継続する方針を示す"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:st_3 rdfs:label "産業課長 渡会和裕"@ja.
kg:st_3 rdf:type cls:st_12.
cls:st_12 rdfs:label "行政職員"@ja.
kg:op_25 prop:content "現在の種苗では成長が想定より良くないと把握している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "徳島と遊佐町の水温差が生育差の要因ではないかとみる"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "種苗の確保自体が難しいと認識している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "単価が低く大量生産や他養殖との組合せがないと採算が厳しい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "日本海側の種苗を試す必要があると考える"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "アワビの流通と販売体制づくりを優先したい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "町単独では難しく関係者と一緒に進めるべきだと考える"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "第三セクター活用は一つの可能性だとみている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "紙の消費量が多く再資源化の取組が必要だと問題提起する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "移転時の大量廃棄を契機に再資源化を進めるべきだと考える"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:st_4 rdfs:label "地域生活課長 畠中良一"@ja.
kg:st_4 rdf:type cls:st_12.
kg:op_35 prop:content "近年の紙使用量は高止まりで横ばいだと説明する"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_4.
kg:op_36 prop:content "紙使用量を継続把握し全課で共有している"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "従来から再使用の取組を続けてきたと説明する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "廃棄文書の再資源化を進めてきた"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "新庁舎移転を機に文書システム導入で紙削減を図る"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "議会のタブレット導入でさらなる紙削減を図る"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "慢心せず資源節減と再資源化を続ける方針を示す"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "機密文書はシュレッダー処理で対応している"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_4.
kg:op_43 prop:content "両面使用済み紙は回収して有効活用している"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_4.
kg:op_44 prop:content "再使用可能な紙は各課で裏紙利用している"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_4.
kg:st_5 rdfs:label "総務課長 中川三彦"@ja.
kg:st_5 rdf:type cls:st_12.
kg:op_45 prop:content "機密性の高い文書は職員立会いで焼却処理してきた"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_5.
kg:op_46 prop:content "酒田市の再生機器を実際に見て確認したい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_4.
kg:st_6 rdfs:label "健康福祉課長 池田久"@ja.
kg:st_6 rdf:type cls:st_12.
kg:op_47 prop:content "障がい者施設への導入や障がい者雇用促進に活用できる可能性がある"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_6.
kg:op_48 prop:content "環境自治体の延長線上で新たな団体との連携を強めたい"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "実は宮海と日向川へ走る橋に関してはかなり弱ってきているという情報は、風力発電の風車を私が就任してすぐ直後に７基造るときに、どうもあの橋弱くて、いわゆる重量を分散しないと支柱等が動かせないという事態があった"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "ぜひとも鳥海南工業団地、県の工業団地ですから、そこと酒田港の活用という視点からいけばどうしてもやっぱり高規格道路、重点物流道路にしてもらわなければならない７号線であります"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "どうもあの橋弱くて、いわゆる重量を分散しないと支柱等が動かせないという事態があった"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "どうしてもやっぱり高規格道路、重点物流道路にしてもらわなければならない７号線であります"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "それら等についてはいち早く県議の先生と一緒に動いた時期ありました"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "しかし、流砂の影響で磯場が縮小し、岩ガキをはじめとする磯場の漁獲量が減少し"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "令和２年度においては大雨の日が多かったことや"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "保健所による細菌検査の結果により漁ができなかった日の数が多く"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "その主な要因として漁獲量の増大により資源回復が追いつかないことや"@ja.
<< kg:id_12 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "その主な要因として漁獲量の増大により資源回復が追いつかないことや、磯焼けや流砂堆積による磯場の漁場の消失などが挙げられます"@ja.
<< kg:id_12 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "その主な要因として漁獲量の増大により資源回復が追いつかないことや、磯焼けや流砂堆積による磯場の漁場の消失などが挙げられます"@ja.
<< kg:id_9 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "平成20年度が約105トンであり、その後平成25年度には57トンと半減し、令和２年度においては...約11トンとなっており、平成20年度の10分の１程度に減少しています"@ja.
<< kg:id_9 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "山形県全体の水揚げ量については平成20年度が265トン、平成25年度が約137トン、令和２年度においては約40トンとなっており、吹浦漁港の水揚げ量と同様に減少しております"@ja.
<< kg:id_9 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "平成20年度はおよそ40％でしたが、令和２年度ではおよそ30％になり、その割合も減少しております"@ja.
<< kg:id_9 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "遊佐町にカキを食べに来るのが楽しみと、遊佐町にわざわざ来ていただける観光客のインタビューも放映されています。しかし、流砂の影響で磯場が縮小し、岩ガキをはじめとする磯場の漁獲量が減少し"@ja.
<< kg:id_7 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "岩ガキをはじめとする磯場の漁獲量が減少し、漁業者も後継者が育たない現状となっています"@ja.
<< kg:id_12 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "砂堆積状況の測量調査を実施し"@ja.
<< kg:id_12 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "堆積の影響がなるべく受けない地点へ増殖礁を設置する事業に県、水産研究所とともに取り組んでおります"@ja.
<< kg:id_12 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "平成26年度には湯ノ田沖に増殖試験礁を設置したほか"@ja.
<< kg:id_12 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "今年度内に令和元年度から取り組んできた女鹿沖での増殖礁の整備が完了する計画になっており、その効果にも期待しているところであります"@ja.
<< kg:id_12 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "今後漁獲量の調整など資源管理についても県全体で取り組む必要があると考えております"@ja.
<< kg:id_12 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "山形県では資源管理の視点から岩ガキの漁場回復に向け、岩盤清掃の実証実験や蓄養技術開発の研究を実施しております"@ja.
<< kg:id_12 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "山形県では資源管理の視点から岩ガキの漁場回復に向け、岩盤清掃の実証実験や蓄養技術開発の研究を実施しております"@ja.
<< kg:id_7 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "我が町の水産振興のため、引き続き関係機関、民間事業者等と連携をしながら、実証実験、技術開発研究などに取り組んでまいります"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "徳島県から購入した種苗ということでありますけれども、想定よりもなかなか成長がよくないようだというような現状での把握でございます"@ja.
<< kg:id_29 prop:cause kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "やっぱり水温、徳島の水温と庄内、遊佐町の水温ではその生育の状況、非常に差があるのではないか"@ja.
<< kg:id_29 prop:cause kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "なかなか販売している業者がないというふうに聞いております"@ja.
<< kg:id_29 prop:effect kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "養殖岩ガキにつきましては、いわゆる一口サイズのものとなりまして、おおむねの単価が100円から120円で取引されておりまして、大量生産ですとかほかの養殖と組み合わせて実施しないと採算面で厳しい"@ja.
<< kg:id_29 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "日本海側で生産された種苗を試してみる必要性があるとも思っております"@ja.
<< kg:id_7 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "まずはアワビの販売ルート開拓ですとか、どういった形で皆様にお届けをするかとか、そういった部分を先に取り組みたい"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "やはり県ですとかほかの関係機関、団体、漁業者も含めてですけれども、いろいろご意見をいただきながら、一緒に進めていくような方向を探っていくしかないかなと思っております"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "一つの可能性としてはあるのかなということでこれまでも議論の中には出てきたものとなっております"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "毎年かなりの量のコピー用紙が庁舎内でも消費されています"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "今回の新庁舎の完成に伴う引っ越し作業でも、これまでの資料等の不要になった紙類の廃棄も大変多かったのではないか"@ja.
<< kg:id_40 prop:effect kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "令和元年度では203万5,000枚、そして昨年度、令和２年度で203万9,000枚ということで、ここ近年につきましてはほぼ横ばいの状況で推移している"@ja.
<< kg:id_40 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "半期ごとにエネルギー調査として毎年６月、12月のエコプラ推進会議において報告し、全課、関係施設に共有しております"@ja.
<< kg:id_40 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "裏紙、使用済み封筒の二次使用"@ja.
<< kg:id_40 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "廃棄文書の再生業者への引渡しなど、様々な取組を実施してまいりました"@ja.
<< kg:id_40 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "新庁舎移転に当たりましては、それに加え文書システムの導入"@ja.
<< kg:id_40 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "議会におけるタブレット端末の導入等、ハード面での新規導入によりさらなる事務用紙使用量の削減を図っております"@ja.
<< kg:id_40 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "今後も庁舎のエネルギー及び資源使用量の調査を継続しつつ、慢心することなく、限られた資源の節減と再資源化に注力してまいりたい"@ja.
<< kg:id_40 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "個人情報の記載された文書、そして機密性の高い文書につきましては、議員おっしゃったとおりシュレッダーにて処理を行ってございます"@ja.
<< kg:id_40 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "両面使用済みの紙につきましては、リサイクル業者より回収をして有効活用していただいてございます"@ja.
<< kg:id_40 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "裏面が使用できる紙につきましては、各課それぞれに裏紙として有効活用してございます"@ja.
<< kg:id_40 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "各課のそういった文書について一定の量を取りまとめをしながら、直接総務課の職員が車のほうに積んで焼却施設のほうに運んで、職員が炉のほうに投入をするということも行ってまいりました"@ja.
<< kg:id_40 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "酒田市にもあるということでございますので、ぜひお誘いいただいてご一緒に現地のほう、機械のほうを見るような形でお誘いいただければありがたい"@ja.
<< kg:id_40 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "ゆうとぴいなり、そこで例えばそういう装置を置いてやってもらうとかということは可能ではないかと思います。また、事業所によっては障がい者雇用ということで雇用率なんかも達成しなければいけないので、そういったものを活用して障がい者の雇用を促進して例えば達成に持っていくとかといったものもあるかと思います"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "その次の団体としっかりとネットワークつなげていきたい"@ja.
}
