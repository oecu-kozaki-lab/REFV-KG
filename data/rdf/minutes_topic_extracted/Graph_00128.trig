kg:id_11 rdfs:label "海底湧水の有無"@ja.
kg:id_11 rdf:type cls:c_3137.
cls:c_3137 rdfs:label "海底湧水"@ja.
kg:id_12 rdfs:label "科学的な質問への回答がなされていない"@ja.
kg:id_12 rdf:type cls:c_3138.
cls:c_3138 rdfs:label "回答不足"@ja.
kg:id_11 prop:effect kg:id_12.
kg:id_13 rdfs:label "環境審議会や遊佐部会の意見を県に申し上げる"@ja.
kg:id_13 rdf:type cls:c_3076.
cls:c_3076 rdfs:label "意見伝達"@ja.
kg:id_1 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "洋上風力発電事業計画"@ja.
kg:id_14 rdf:type cls:c_1966.
cls:c_1966 rdfs:label "事業計画"@ja.
kg:id_15 rdfs:label "海岸から想定エリアまでの距離が変化しない"@ja.
kg:id_15 rdf:type cls:c_3139.
cls:c_3139 rdfs:label "距離不変"@ja.
kg:id_14 prop:effect kg:id_15.
kg:id_16 rdfs:label "高さ180メートルから266メートルの風車が36基から63基建つ計画への反対意見が多い"@ja.
kg:id_16 rdf:type cls:c_2368.
cls:c_2368 rdfs:label "住民の反対"@ja.
kg:id_14 prop:effect kg:id_16.
