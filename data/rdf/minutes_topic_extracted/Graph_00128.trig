kg:id_17 rdf:type cls:c_1966.
kg:id_18 rdfs:label "騒音被害や環境悪化への懸念"@ja.
kg:id_18 rdf:type cls:c_1759.
cls:c_1759 rdfs:label "環境懸念"@ja.
kg:id_17 prop:effect kg:id_18.
kg:id_19 rdfs:label "早い段階であらゆる手を使って意見や要望を伝える"@ja.
kg:id_19 rdf:type cls:c_3140.
cls:c_3140 rdfs:label "要望伝達"@ja.
kg:id_1 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "県が風力発電の設置基準やガイドラインをつくる"@ja.
kg:id_20 rdf:type cls:c_3074.
cls:c_3074 rdfs:label "設置基準"@ja.
kg:id_1 prop:countermeasure kg:id_20.
kg:id_21 rdfs:label "県が地元住民にリスクがないようリスク管理のたたき台をつくる"@ja.
kg:id_21 rdf:type cls:c_3075.
cls:c_3075 rdfs:label "リスク管理"@ja.
kg:id_1 prop:countermeasure kg:id_21.
kg:id_22 rdfs:label "大雪や寒波"@ja.
kg:id_22 rdf:type cls:c_1606.
cls:c_1606 rdfs:label "気象災害"@ja.
kg:id_23 rdfs:label "電力需給の逼迫"@ja.
kg:id_23 rdf:type cls:c_3141.
cls:c_3141 rdfs:label "電力逼迫"@ja.
kg:id_22 prop:cause kg:id_23.
kg:id_24 rdfs:label "原油価格の上昇"@ja.
kg:id_24 rdf:type cls:c_3142.
cls:c_3142 rdfs:label "燃料高騰"@ja.
kg:id_25 rdfs:label "発電用の油が足りない"@ja.
kg:id_25 rdf:type cls:c_2079.
cls:c_2079 rdfs:label "燃料不足"@ja.
kg:id_24 prop:effect kg:id_25.
kg:id_26 rdfs:label "広く町民の意見をフラットに求めて回答する"@ja.
kg:id_26 rdf:type cls:c_3143.
cls:c_3143 rdfs:label "意見募集"@ja.
kg:id_1 prop:countermeasure kg:id_26.
kg:id_27 rdfs:label "環境審議会や遊佐部会で議論を重ねる"@ja.
kg:id_27 rdf:type cls:c_138.
cls:c_138 rdfs:label "合意形成"@ja.
kg:id_1 prop:countermeasure kg:id_27.
kg:id_28 rdfs:label "世代をつないで住み続けたいと思えなくなるおそれ"@ja.
kg:id_28 rdf:type cls:c_3144.
cls:c_3144 rdfs:label "定住不安"@ja.
kg:id_14 prop:effect kg:id_28.
kg:id_29 rdfs:label "風力発電栄えて町が滅びるおそれ"@ja.
kg:id_29 rdf:type cls:c_424.
cls:c_424 rdfs:label "地域衰退"@ja.
kg:id_14 prop:effect kg:id_29.
kg:st_1 rdfs:label "議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "町民の不安や疑問への解決がほとんど図られておらず不十分だと懸念"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "環境アセス制度以外の場面でも町長が町民の思いを代弁すべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "海底湧水への影響は町全体の水循環保全の問題として捉えるべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "臂曲採石事業とともに水循環の問題として総合対応すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "コロナで学習会や専門家招致は難しいがコロナ後も見据える必要がある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_6 prop:content "説明機会が限られる中で広報やホームページを活用して情報発信したい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "広報やホームページを活用し町民と協働して課題解決を図りたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "海底湧水の有無など科学的な質問への回答がまだなく判断材料が不足している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "行政としては環境審議会や遊佐部会の意見を県に伝えるのが本来の在り方"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "想定海域縮小案は生活者にとって重要な海岸からの距離が変わらず僅かな変化にすぎない"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "脱炭素社会には理解があっても現在の大規模な建設計画には勘弁してほしいという意見が多い"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:st_3 rdfs:label "乙部町町民"@ja.
kg:st_3 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_12 prop:content "騒音被害や環境悪化を懸念"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "要望は先手必勝で早い段階にしっかり伝えるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "県として設置基準やガイドラインをまず作るべきと申し入れている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "地元住民にリスクがないよう県がリスク管理のたたき台を作るべきと申し入れている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "電力需給逼迫や燃料高騰の中で電力確保の現実も考える必要がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "原油高で発電用燃料不足の情報もあり電気の必要性は高い"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "町長が先に良し悪しを言うより広く意見をフラットに集めるべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "議論を重ねることで意見の一致を見る方向に進む"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "現に住む人が世代をつないで住み続けたくないと感じれば迷惑施設になってしまう"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "人口減少下で風力発電だけが進み町が衰退するなら本末転倒"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "現時点で数多くの不安や疑問が町民から出されているのにもかかわらず、それらへの解決はほとんど図られていない状況が半ば固定化しています"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "環境アセス制度の中で町長は県に意見照会できることにはなっていますが、それ以外の場面でも町民の思いを代弁する必要があると考えます"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "風車の設置による海底湧水への影響に関しては、町全体の健全な水循環の保全というテーマにもつながります"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "臂曲採石事業を局所的な問題と捉えるのではなく、ともに水循環の問題だと捉えることで総合的な対応も可能になるはずです"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "昨年来、新型コロナウイルス感染症の影響で学習会の開催や専門家に来ていただくことは確かに難しくなってはいます。しかし、コロナ後を見据える必要もあります"@ja.
<< kg:id_7 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "新型コロナウイルス感染症が猛威を振るう中、説明の機会などが限られておりますので、広報やホームページなどを活用しながら情報発信を行い、町民の皆様と協働しての課題の解決を図りたいと思います"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "広報やホームページなどを活用しながら情報発信を行い、町民の皆様と協働しての課題の解決を図りたいと思います"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "海底湧水が庄内浜にあるのか等についてまだ科学的な質問への回答がなされていない現状であります"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "行政としてはこれまで行ってきた環境審議会の中での委員の皆さんの意見を、また県が行う風力発電に関しましては遊佐部会を通しての意見を県に申し上げていくのが本来の行政の在り方ではないかと、このように考えております"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "生活している人からすれば重要であろうと思われる海岸から想定エリアまでの距離は変化ありませんし、あと海岸沿いの南北方向の長さも一切変化していないわけであります"@ja.
<< kg:id_14 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "海面からの高さが180メートルから266メートルという風車が36基から63基建つという現在の計画、このような建て方はとてもではないが、勘弁してくれという意見が多い"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "理由としては、騒音被害や環境悪化を懸念する町民の意見を踏まえた結果だというような新聞報道"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "意見、要望言うのであれば、早い段階、先手必勝であらゆる手を使ってしっかり伝えるべきだというふうに思うわけです"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "山形県の課長には、県として設置基準、風力発電を遊佐沖で受けるときの設置基準、ガイドラインをまず県自身が苦労してつくってもらえませんかと、そういうことを申し上げました"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "地元の住民にリスクがないようにするには、リスク管理のたたき台、まずは県がつくるべきではないかということは既に２回ほど申入れをしております"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "この間の大雪、寒波で電力需給が逼迫をして"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "原油が今１バレル、61ドルぐらいまで上がった。なかなか発電用の油が足りないという形の情報もある"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "私は、やっぱり広く町民の意見を求めて回答していくというやり方のほうが、私から最初からいいとか悪いとかって言ってしまったら、それは誘導になるという形もあると思いますので、広く意見をフラットにいただくというのが立場ではないかと"@ja.
<< kg:id_1 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "議論すること、環境審議会等で議論していくこと、遊佐部会で議論して重ねるということが意見の一致を見る方向に進むものだと私は思っています"@ja.
<< kg:id_14 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "洋上風力発電の傍らの集落でその場所で世代をつないで住み続けたいと思うかどうかということだと思うのです。例えば自分の代は我慢するけれども、子供たちにはとてもここに住まわせ続けられないということであれば"@ja.
<< kg:id_14 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "風力発電栄えて町が滅びるということであれば、それは本末転倒だと私は思います"@ja.
}
