cls:c_3136 rdfs:label "説明機会不足"@ja.
kg:id_7 prop:effect kg:id_9.
kg:id_10 rdfs:label "広報やホームページを活用した情報発信"@ja.
kg:id_10 rdf:type cls:c_1056.
cls:c_1056 rdfs:label "情報発信"@ja.
