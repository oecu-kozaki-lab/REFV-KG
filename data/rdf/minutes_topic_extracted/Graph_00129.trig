kg:st_1 rdfs:label "菅原和幸議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "脱炭素社会への対応は世界的動向に沿うものだと認識する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "石炭火力政策の転換は県の電力事情に大きく影響するとみている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長 時田博機"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_3 prop:content "次期環境基本計画は短期目標と連動し政府の中期目標を参考にすべきと考える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "子供たちに環境学習を通じて課題解決力を育てたい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "教育委員会教育課長 菅原三恵子"@ja.
kg:st_3 rdf:type cls:st_82.
cls:st_82 rdfs:label "教育担当"@ja.
kg:op_5 prop:content "町内施設見学は地域資源を活用した生きた教材として有意義だと捉える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "施設見学は設備や活用方法への関心を高める機会になった"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "見学は地域資源の設備や活用方法への関心を高める生きた教材となった"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:st_4 rdfs:label "教育長 那須栄一"@ja.
kg:st_4 rdf:type cls:st_82.
kg:op_8 prop:content "環境に優しい素材の学習機会を子供たちに広げたい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "新素材を比較する自由研究を通じて子供たちの環境学習を進めたい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:st_5 rdfs:label "町政座談会参加者"@ja.
kg:st_5 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_10 prop:content "風向き次第で風車の騒音が大きな問題になるのではないかと懸念する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "共同火力が止まれば県内電力供給に深刻な影響が出かねないと懸念する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "発電設備だけでなく送電や買い取り体制が重要だと感じる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "再エネは発電だけでなく送電設備の整備が重要だとみている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_6 rdfs:label "地域生活課長 畠中良一"@ja.
kg:st_6 rdf:type cls:st_83.
cls:st_83 rdfs:label "行政担当"@ja.
kg:op_14 prop:content "次期環境基本計画は総合発展計画との整合を図って策定したい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_6.
kg:op_15 prop:content "町民意向調査を基礎資料にして審議会で意見を聴きながら改定を進める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_6.
kg:op_16 prop:content "再エネ導入と省エネ削減により当初目標は達成できる見込みだ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_6.
kg:op_17 prop:content "水素は将来有望なゼロカーボン型エネルギーになると考える"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:st_7 rdfs:label "岩谷産業の説明を踏まえた菅原和幸議員"@ja.
kg:st_7 rdf:type cls:st_9.
kg:op_18 prop:content "水素は有望だが扱いが難しく安全管理が課題だと認識している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_7.
kg:op_19 prop:content "県に設置基準とガイドラインの整備を求め町民のリスク回避を重視する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "町は中立的に町民のリスクを守りつつ対応する考えだ"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "木質バイオマス発電は雇用創出など地域への波及を期待している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "東日本大震災以降、再生可能エネルギーが注目されています"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "脱炭素社会に向けた動きは世界的な動きに対応するものであり"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:text-txt_contents "平成27年12月開催のＣＯＰ21でパリ協定が採択され、１年後の平成28年１月に発効"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:text-txt_contents "カーボンニュートラルへの挑戦を経済と環境の好循環につなげるための産業施策としてグリーン成長戦略を策定しております"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本県の電力事情に大きく影響すると考えられますが、石炭火力発電に対する政策の抜本的な転換"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "ゼロカーボンに向けた具体的施策は第４次山形県環境計画に盛り込み、政府と一体となり取り組むとしております"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:text-txt_contents "再生可能エネルギーの利用促進に取り組むことで循環型社会の実現を目指すとしております"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:text-txt_contents "持続可能な社会と地域の発展を目指し、各組織と連携し、再生可能エネルギーの創出を図るとしています"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:text-txt_contents "ゼロカーボンは導入される自然由来の再生可能エネルギーの活用"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:text-txt_contents "エコアクションプランに沿った省エネ活動による二酸化炭素の排出量削減"@ja.
<< kg:id_16 prop:cause kg:id_19 >>
    prop:text-txt_contents "町の総面積の50％を超える森林の二酸化炭素吸収量により達成されるものと理解をしております"@ja.
<< kg:id_20 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "第五次遊佐町環境基本計画は令和７年度までの短期目標であるエコアクションプランと連動しながら、2030年度の政府の中期目標を参考にしたものになると考えております"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:text-txt_contents "小学校社会科では、節水や節電などの資源の有効な利用について"@ja.
<< kg:id_22 prop:countermeasure kg:id_24 >>
    prop:text-txt_contents "中学校理科ではエネルギーの有効利用の大切さ等の学習を行っております"@ja.
<< kg:id_22 prop:countermeasure kg:id_25 >>
    prop:text-txt_contents "再生可能エネルギーについては、中学校の理科３年生で詳しく学習することになっております"@ja.
<< kg:id_22 prop:countermeasure kg:id_26 >>
    prop:text-txt_contents "令和元年度に遊佐町にある風力発電所を実際に訪問して、地域の教育素材として再生可能エネルギーを結びつけた研修を行っております"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今後も子供たちが環境に関する学習を通して、持続可能な社会の構築に向けて自ら課題を解決する力を育んでいきたいと考えております"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "令和元年６月７日に高瀬小学校５年生の社会科見学の一環で、町内の施設巡りとして平津小水力発電所を見学しております"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "同じく６月20日にも遊佐小学校５年生で、平津小水力発電所を児童、教員30名で見学をしておりました"@ja.
<< kg:id_29 prop:effect kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "地域資源を活用した設備そのものやそれがどのように使われているかなど、生きた教材に関心を高める機会として大変有意義だった"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "プラスチックだと永遠に残るということになっているわけですけれども"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "何年かたつと消えてなくなるという、そういうものを開発しているのだと、そういうことで今使っているプラスチックとビニール製品とこの製品を比べてどういうよさがあるのか、夏休みの自由研究にぜひ小学生の児童にやってほしい"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "ある会場では風向きで風車の音が非常に問題になるのではないかという趣旨の発言をされた方もいらっしゃいました"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "県内で使われる年間電力の約半分、これが共同火力で使っている量になると。それが禁止されればこの50％ほぼなくなる"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "やっと何億円とかけてできましたら東北電力が電気は買いませんということを言われました"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "やっぱりつくるのはいいのですが、送る施設、これがポイントのようで"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "今年度見直しの総合発展計画、第８次遊佐町振興計画、後期５か年の基本計画策定の結果を精査いたしまして、基本理念についての整合性を図った形で策定していきたい"@ja.
<< kg:id_44 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "計画の改定、環境施策の充実を図るための基礎資料として町民意向調査を実施する予定としていますので、その案について環境審議の皆さんから意見聴取をさせていただきたい"@ja.
<< kg:id_47 prop:countermeasure kg:id_48 >>
    prop:text-txt_contents "2023年度までの10か年に再生可能エネルギー導入分の45％と省エネルギーによる削減分10％と合わせて55％相当に到達することを目標としてございます"@ja.
<< kg:id_47 prop:effect kg:id_49 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "再生可能エネルギーの導入分につきましては65％、そして省エネによる削減分につきましては11％削減となっております。よって、再生可能エネルギーの導入量と省エネ実施分によります削減分との合計55％相当という当初計画の目標を達成できる見込み"@ja.
<< kg:id_50 prop:effect kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "これはゼロカーボンというとＨ２Ｏといえば水しか、排気ガスが出ませんので、将来の有望なエネルギーになると思う"@ja.
<< kg:id_50 prop:effect kg:id_52 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "燃焼しやすく、燃えた後は水しか出ない。ただし、扱いにくく、最も危険で、管理が大変な気体である"@ja.
<< kg:id_36 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "ガイドライン、設置基準をまず県としてつくってほしいですよ、町民のリスクがないようにお願いしているところであります"@ja.
<< kg:id_36 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "それら等についてはフラットな立場で、町民のリスクはしっかり守りながら"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "今木質バイオマスの発電も工業団地で始めようという東北電力関連の会社も出てきておりますので、雇用等いろんな形でつなげればいいと思っています"@ja.
}
