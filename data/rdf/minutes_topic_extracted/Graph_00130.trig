kg:st_1 rdfs:label "松永裕美議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "重要な項目であり町として取組有無を示すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "民間のスピード感と行政の丁寧さを相互活性化できる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "長期では業務負担が大きいため短期実施が望ましい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "短期間なら相互の業務支障を抑えて実施できる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "職員のやる気や自主性を尊重する制度にすべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "何歳でも参加希望者が手を挙げられる仕組みがよい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "職員にも民間にも学びがある双方有益型制度になる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "一方通行でなく官民双方に利益がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "民間側にも行政業務への理解が深まる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_2 rdfs:label "中川三彦総務課長"@ja.
kg:st_2 rdf:type cls:st_84.
cls:st_84 rdfs:label "課長"@ja.
kg:op_10 prop:content "任用制度の制約があり簡単な実施は難しい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "研修や受入れの形でどこまで可能か検討したい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "新設は一案だが人員確保の課題がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "固定概念を見直し行政と町民で議論を重ねるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "高齢化が進む中で手続一元化の必要性が高い"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "遺族が一つの窓口で相談や手続できる仕組みが必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "既存スキーム活用でコストを抑えて導入できる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "業務繁忙を防ぐため予約制が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "高齢化する町にとって不可欠な機能である"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:st_3 rdfs:label "町民"@ja.
kg:st_3 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_19 prop:content "高齢者はあちこち回る手続に大きく戸惑う"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:st_4 rdfs:label "ラインを送った町民"@ja.
kg:st_4 rdf:type cls:st_5.
kg:op_20 prop:content "家族死亡時に一つの窓口で手続と相談ができれば助かる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_4.
kg:op_21 prop:content "一元化で窓口混乱や苦情の減少が期待できる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:st_5 rdfs:label "後藤夕貴町民課長"@ja.
kg:st_5 rdf:type cls:st_84.
kg:op_22 prop:content "当町は窓口で担当者を呼ぶなど回らせない対応に努めている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "新庁舎では受付中心に職員を呼んで対応したい"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "人材活用こそ町の強みであり柔軟な組織づくりが必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "自然エネルギー政策への理解促進には勉強会が必要"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "当町は再生可能エネルギー導入量を意識的に把握している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "今後の事業増加を見据え町の方針決定が重要"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:st_6 rdfs:label "答弁者"@ja.
kg:st_6 rdf:type cls:st_55.
cls:st_55 rdfs:label "答弁者"@ja.
kg:op_28 prop:content "町民との相互理解と合意形成なしに事業推進は不可能"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_6.
kg:op_29 prop:content "時間を要しても町民要望を聞き丁寧に進めるべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_6.
kg:st_7 rdfs:label "新しく区長になった方"@ja.
kg:st_7 rdf:type cls:st_5.
kg:op_30 prop:content "何をどう考えどうすればよいのか分からず困っている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_7.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "洋上風力など、これから自然エネルギーの増大により様々な議論がなされると思いますので、この項目はとても重要なことだと思います"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "民間の方たちのスピーディーでアンテナの高いやり方と行政の実直できちんと丁寧に皆さんの意見をすくう仕事の仕方を、今活性化で行き来させたほうがよいと思います"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "長期だと相互の業務に支障が出るので、２週間から４週間の期間とする"@ja.
<< kg:id_3 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "長期だと相互の業務に支障が出るので、２週間から４週間の期間とする"@ja.
<< kg:id_3 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "職員の方のやる気やモチベーションを上げるため、やりたい方手挙げ方式とする。自主性を尊重"@ja.
<< kg:id_3 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "男性、女性枠は無論のこと、年齢制限の枠も設けないこととする。何歳になってもやりたいと思った方が手を挙げれる、そういう仕組みをする"@ja.
<< kg:id_3 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "製造業、飲食業、サービス業など多岐にわたる業種から働き、学べる場マッチングして、職員のためにもなり、また民間の方も行政職ってこんな大変だったのだと分かってもらうような仕組みづくりとする。一方通行ではなく、双方有益型で相互に実りのある交換、交流、研修制度になると考えます"@ja.
<< kg:id_3 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "一方通行ではなく、双方有益型で相互に実りのある交換、交流、研修制度になると考えます"@ja.
<< kg:id_3 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "また民間の方も行政職ってこんな大変だったのだと分かってもらうような仕組みづくりとする"@ja.
<< kg:id_3 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "地方自治体の職場については、職員については任用という制度を取ってございますので、なかなか民間の方がそういった任用に簡単にできるということではない"@ja.
<< kg:id_3 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "一方で研修という形で受入れをしている場合というのもあることは事実でありますし、職業体験ということで学生とか中学生、高校生の皆さんを受け入れているケースもございます。そういったものの関係でどこまで可能なのかということは、少し検討をさせていただければ"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "新しい再生可能エネルギーのための課を新設して、猛ダッシュでエンジンを吹かせていくのも一つのやり方かもしれませんが、それとはまた別にそちらはそちらでまた人数とか人員の体制が必要なので、なかなか難しいこともございます"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "やはりよく行政の皆様の方たちの中で考えてもらったり、これからどうしたらいいかという何回も議論を重ねていただいて、また我々町民も町にとってどの案が有益か、今までの固定概念はどこで払拭すべきか、そういうところを考えながらやっていかなくてはいけない時代になっている"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "最近一番多いご相談が高齢化に伴って、お悔やみコーナー、要は一元化です"@ja.
<< kg:id_18 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "亡くなった方が手続するときにお悔やみコーナーを設置する自治体も今増えてきておりまして"@ja.
<< kg:id_18 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "最近では市町村職員の方が無償でオープンソースライセンスを利用し、もう既にスキームができているものを使えます。要はコストがかからないで、机と椅子、そして予約制にします"@ja.
<< kg:id_18 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "予約制にしないと業務の繁忙になってしまいますので、希望される４営業日前ぐらいまで予約して、１日３組までと決め"@ja.
<< kg:id_18 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "でもこれもこれからの高齢化の遊佐町には絶対大事だなということを感じております。高齢化している遊佐町にもぜひとも必要不可欠な部署だと思いませんか"@ja.
<< kg:id_18 prop:effect kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "高齢者は免許返納しているから、あっちに行きなさい、こっちに行きなさい、これを取ってきてくださいとなってもとても戸惑います"@ja.
<< kg:id_18 prop:effect kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "実家の父が永眠してしまい、いろんな手続に翻弄される妹を見て、思ったことがあります。家族が亡くなったときの手続が１つの窓口でできて、相談もできるところがあれば助かるのになと実感しています"@ja.
<< kg:id_18 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "一元化にすることによって、これからの高齢化でパニックになる窓口受付の例えば怒号や、何もできていないではないかとかいうお客様からのクレームが減るのは必ず確実だと思います"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "当町では、できるだけそういったことがないように窓口のほうで担当者をお呼びしたりとか、そういったことをしているつもりではございます"@ja.
<< kg:id_27 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "８月下旬から新庁舎のほうに移って、新しく業務が始まりますけれども、そちらもう平屋でございますので、２階に登ってもらうとか、それからどこかから来ていただくとかということはなくて、やはり町の町民課の中の受付のところで少しは移っていただくことになるかと思いますけれども、こちらに職員を呼んで対応していく"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "先ほどの弾力性のあるレジリエンスなセクションをというのは、実は人材が宝ではないかなと私は考えて発言させていただきました。やはりトレーニングをしたり、研修会をしたり、この役場で働いている方たちが自分の力を発揮できることがこの町の強みではないかと信じております"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "町民の方たちにきちんと伝わっている、これから伝えていかなければいけない、そしてなぜ自然エネルギーがこれほどまで莫大な予算で、環境省も経産省も総務省も横連携、縦連携してやっているかということを町民の方たちからも一人一人から理解していただくためには、やはり私は勉強会だと思います"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "町内に導入されている風力、太陽光等の再生可能エネルギーによる発電量は町内の電力消費量の171％相当になっているというような結果報告をいただいております"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "ただ、ここで懸念しなくてはならないのは、やはりこれからまた様々な事業が入ってくるときに、どうやって町が方針決めて取り組んでいくかということだと思います"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "町民の皆様との相互理解、そして合意形成がなくして事業を進めることは不可能であるというふうに考えます"@ja.
<< kg:id_38 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "今後たとえ時間を要したとしても、町民の皆様の要望を聞きながら、これからも丁寧に、丁寧に取り組んでいかなければいけない"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "中には、新しく区長さんになった方が何をどう考えてどうすればいいのでしょうかと、困っていらっしゃる本当の気持ちをお伝えしてくれる方がいたり"@ja.
}
