PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00139> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "太陽パネル"@ja.
kg:id_1 rdf:type cls:c_1093.
cls:c_1093 rdfs:label "発電設備"@ja.
kg:id_2 rdfs:label "役目を終えた後に環境に負荷をかける"@ja.
kg:id_2 rdf:type cls:c_1095.
cls:c_1095 rdfs:label "環境負荷"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "風力発電"@ja.
kg:id_3 rdf:type cls:c_1093.
kg:id_4 rdfs:label "バードストライク"@ja.
kg:id_4 rdf:type cls:c_52.
cls:c_52 rdfs:label "鳥類被害"@ja.
kg:id_3 prop:effect kg:id_4.
kg:id_5 rdfs:label "低周波"@ja.
kg:id_5 rdf:type cls:c_3316.
cls:c_3316 rdfs:label "低周波被害"@ja.
kg:id_3 prop:effect kg:id_5.
kg:id_6 rdfs:label "洋上風力"@ja.
kg:id_6 rdf:type cls:c_1093.
kg:id_7 rdfs:label "景観への影響"@ja.
kg:id_7 rdf:type cls:c_50.
cls:c_50 rdfs:label "景観影響"@ja.
kg:id_6 prop:effect kg:id_7.
kg:id_8 rdfs:label "洋上風力の建設"@ja.
kg:id_8 rdf:type cls:c_1867.
cls:c_1867 rdfs:label "発電施設建設"@ja.
kg:id_9 rdfs:label "岸から近いこと"@ja.
kg:id_9 rdf:type cls:c_1497.
cls:c_1497 rdfs:label "立地条件"@ja.
kg:id_8 prop:cause kg:id_9.
kg:id_10 rdfs:label "健康被害"@ja.
kg:id_10 rdf:type cls:c_79.
cls:c_79 rdfs:label "健康被害"@ja.
kg:id_8 prop:effect kg:id_10.
kg:id_11 rdfs:label "景観と圧迫感"@ja.
kg:id_11 rdf:type cls:c_50.
kg:id_8 prop:effect kg:id_11.
kg:id_12 rdfs:label "脅威"@ja.
kg:id_12 rdf:type cls:c_3317.
cls:c_3317 rdfs:label "脅威"@ja.
kg:id_8 prop:effect kg:id_12.
kg:id_13 rdfs:label "風車の小型化"@ja.
kg:id_13 rdf:type cls:c_3318.
cls:c_3318 rdfs:label "小型化"@ja.
kg:id_6 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "海岸からの離岸距離を大きく取る"@ja.
kg:id_14 rdf:type cls:c_3319.
cls:c_3319 rdfs:label "離岸距離確保"@ja.
kg:id_6 prop:countermeasure kg:id_14.
kg:id_15 rdfs:label "洋上風力計画"@ja.
kg:id_15 rdf:type cls:c_3320.
cls:c_3320 rdfs:label "計画"@ja.
kg:id_16 rdfs:label "計画のやり直し"@ja.
kg:id_16 rdf:type cls:c_271.
cls:c_271 rdfs:label "計画見直し"@ja.
kg:id_15 prop:countermeasure kg:id_16.
kg:id_17 rdfs:label "エネルギー計画"@ja.
kg:id_17 rdf:type cls:c_3320.
kg:id_18 rdfs:label "町民の安全と生活の安全を考えた作成"@ja.
kg:id_18 rdf:type cls:c_3071.
cls:c_3071 rdfs:label "安全配慮"@ja.
kg:id_17 prop:countermeasure kg:id_18.
kg:st_1 rdfs:label "発言者個人"@ja.
kg:st_1 rdf:type cls:st_87.
cls:st_87 rdfs:label "個人"@ja.
kg:op_1 prop:content "太陽光には今後いろいろな弊害が出る可能性を懸念する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "風力発電は環境に負荷をかけている可能性があると懸念する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "風力発電は環境に負荷をかけている可能性があると懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "鳥海山を中心とした観光や景観への悪影響を懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "住民"@ja.
kg:st_2 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_5 prop:content "岸から近すぎる洋上風力建設に不安を感じる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "健康被害が心配である"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "景観の悪化と圧迫感を懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "300メーター以上のものが立つことに脅威を感じる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "計画の中で風車を小型化すべきだと考える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "海岸からの距離をより大きく取るべきだと考える"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "必要なら計画をやり直すべきだと考える"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "再生可能エネルギーの重要性を踏まえつつ町民の安全を重視した計画作成を求める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "いわゆる今の太陽パネルは役目を終えてからは環境に負荷をかけるものでしかないというような言い方もされております"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "風力発電に関しましても、当初はバードストライクであるとか低周波であるとか、いろんなことも環境に負荷をかけているのではないか"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "風力発電に関しましても、当初はバードストライクであるとか低周波であるとか、いろんなことも環境に負荷をかけているのではないか"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "最近洋上風力の中では、鳥海山を中心とした観光を叫ぶ遊佐町としても、景観にも影響があるのではないかというような言い方をしております"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "いろいろ住民の話を聞きますと、あまりにも岸から近い洋上風力の建設になりますので"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "その辺で健康被害が心配であるとか"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "やはり一番は景観と圧迫感もあるし"@ja.
<< kg:id_8 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "何せ300メーター以上のものが立つということはかなり脅威であろうと思います"@ja.
<< kg:id_6 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "少し計画の中でも、風力発電の風車の小型化であるとか"@ja.
<< kg:id_6 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "あと海岸からの離岸距離を大きく取っていただくとか"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本当にもう一回やり直し、いわゆる計画のやり直しから始めなければならないことになる"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "再生可能エネルギーの大切さは十分認識した上で、遊佐町の町民の安全、生活の安全ということも考えた上でのエネルギー計画の作成をお願いしたい"@ja.
}
