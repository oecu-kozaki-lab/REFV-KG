kg:st_1 rdfs:label "学校給食無償化を目指す山形県民の会"@ja.
kg:st_1 rdf:type cls:st_59.
cls:st_59 rdfs:label "住民団体"@ja.
kg:op_1 prop:content "保護者負担軽減のため無償化が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤光保議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_2 prop:content "学校給食費は保護者負担の中で最も高額であり無償化が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "無償化で保護者負担は大きく軽減される"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "学校給食無償化は子育て支援策や少子化対策の一つである"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "財政的理由で実施できない自治体が多い"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "同じ県内の公立小中学校でも無料と有料で大きな格差がある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "国の少子化対策にもあるとおり必要な施策である"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:st_3 rdfs:label "町長"@ja.
kg:st_3 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_8 prop:content "2050年カーボンニュートラルを見据えた施策や目標を示す"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "今議会で宣言を行いたい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:st_4 rdfs:label "町民アンケート回答者"@ja.
kg:st_4 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_10 prop:content "漁業に影響が出ないか心配"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "町や自分の生活に何らかのメリットがあるならよい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "騒音や低周波の心配がないか心配"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "湧水に関する懸念の回答があった"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "景観に関する懸念の回答があった"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "産業や雇用の活性化をはじめとする地域活性化に期待する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "国の施策に対し町は協力する立場にある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "住民の暮らしを守りつつ懸念や不安やリスクの回避低減も求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "再生エネルギーの導入は必要なので積極的に進めるべき"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "地産地消との関係ではスマートグリッドと蓄電池が必要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:st_5 rdfs:label "地域生活課長"@ja.
kg:st_5 rdf:type cls:st_67.
cls:st_67 rdfs:label "行政職"@ja.
kg:op_20 prop:content "エネルギー基本計画の中で可能な体制構築を検討する"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:op_21 prop:content "蓄電池や住宅への整備支援など様々な可能性を探る"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "EV車の導入促進も検討する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_5.
kg:op_23 prop:content "農地や公共施設を活用した太陽光や地熱利用の可能性を探る"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "地産地消型の再エネを最優先で推し進め地域経済活性化に資するべき"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "再生可能エネルギーを最大限活用し地産地消型で最優先に進めるべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "多くの町民が願う原発ゼロへ転換すべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "日本の衰退や産業競争力低下の中で洋上風力にどこまで力を入れられるか不安"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "新型コロナウイルス感染症による経済の悪化により県民の生活が大変な中、学校給食は義務教育に係る保護者負担の中で年間５万円から６万円と最も高額であることから、無償化することで保護者の負担は大きく軽減されます"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "学校給食は義務教育に係る保護者負担の中で年間５万円から６万円と最も高額であることから、無償化することで保護者の負担は大きく軽減されます"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "無償化することで保護者の負担は大きく軽減されます"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "県内では、この間、半数以上の自治体で子育て支援策や少子化対策の一つとして学校給食の無償化や一部助成が実施されてきました"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "しかし、財政的な理由で実施したくてもできないといった自治体も多く"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "同じ県内の公立小中学校に通いながら、片や無料、片や子供１人に５から６万円の負担と大きな格差が生じています"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "したがって、国の少子化対策にもあるとおり必要な施策と考えるので、町長の所感をお伺いします"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "町としてその実現に向けた具体的な施策を検討するために、昨年度ゼロカーボンに向けた現況調査、いわゆる見える化事業を実施し、町の現状、課題の分析を行いました"@ja.
<< kg:id_11 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "これらの結果を踏まえ、今年度はエネルギー基本計画を策定し、2050年カーボンニュートラルを見据えた町の取り組むべき施策や目標を示していく所存であります"@ja.
<< kg:id_11 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "なお、今議会でゼロカーボンシティーに向けた宣言を行っていきたいと考えております"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "一番多かったところでは漁業に影響が出ないか心配"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "町や自分の生活に何らかのメリットがあるならよい"@ja.
<< kg:id_15 prop:effect kg:id_18 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "騒音や低周波の心配がないか心配"@ja.
<< kg:id_15 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "私が見た限りでは、そのほかに湧水に関するものが114"@ja.
<< kg:id_15 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "景観に関するものが77"@ja.
<< kg:id_15 prop:effect kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "また、発電事業に伴う産業、雇用の活性化をはじめとする地域活性化に関する取組にも大いに期待をしております"@ja.
<< kg:id_15 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "国が進める事業でありますので、町の環境基本計画に直接的な記載はありませんが、カーボンニュートラル実現に向けた国の施策に対し、町は法定協議会の一員として事業完了まで協力する立場にあります"@ja.
<< kg:id_15 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "住民の皆さんの暮らしを守りつつ、次の世代に遊佐町を引き継いでいくために、地域活性化の取組はもちろんのこと、様々な懸念や不安、リスクの回避、低減も併せて引き続き意見していきたいと考えております"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "再生エネルギーの導入は必要なことなので、積極的に進めていくべき"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "スマートグリッドと蓄電池というのが地産地消との関係では必要になってくると思います"@ja.
<< kg:id_11 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "計画の検討としまして、エネルギーの地産地消が可能な体制の構築ですとか"@ja.
<< kg:id_11 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "今おっしゃられた蓄電池、また住宅への整備支援"@ja.
<< kg:id_11 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "ＥＶ車の導入促進"@ja.
<< kg:id_11 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "農地や公共施設を活用した太陽光や地熱の利用など、様々な可能性を探っていきたい"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "今こそ省エネと併せて地産地消型で地域経済活性化に資する再エネを最優先で推し進め"@ja.
<< kg:id_32 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "脱炭素やエネルギーの安定供給というなら再生可能エネルギーを最大限活用するべきだというふうに考えます。今こそ省エネと併せて地産地消型で地域経済活性化に資する再エネを最優先で推し進め"@ja.
<< kg:id_32 prop:effect kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "多くの町民が願う原発ゼロへと転換することを強く求めるものであります"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "こういう状態で果たしてどこまで日本が洋上風力なり、そういったものに力を入れれるのか私はちょっと不安を持っておる次第です"@ja.
}
