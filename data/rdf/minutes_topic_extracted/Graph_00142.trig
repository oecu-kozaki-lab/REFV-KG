PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00142> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "交流"@ja.
kg:id_1 rdf:type cls:c_3360.
cls:c_3360 rdfs:label "交流活動"@ja.
kg:id_2 rdfs:label "コロナ"@ja.
kg:id_2 rdf:type cls:c_511.
cls:c_511 rdfs:label "感染症"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "友好としての交流ができない"@ja.
kg:id_3 rdf:type cls:c_3361.
cls:c_3361 rdfs:label "交流停止"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "イケ・サンパークや池袋で遊佐の市を出し地域の発信をする"@ja.
kg:id_4 rdf:type cls:c_455.
cls:c_455 rdfs:label "地域発信"@ja.
kg:id_1 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "洋上風力発電事業"@ja.
kg:id_5 rdf:type cls:c_218.
cls:c_218 rdfs:label "発電事業"@ja.
kg:id_6 rdfs:label "促進区域への認定"@ja.
kg:id_6 rdf:type cls:c_3362.
cls:c_3362 rdfs:label "区域認定"@ja.
kg:id_5 prop:cause kg:id_6.
kg:id_7 rdfs:label "業者選定など事業の具体的な段取りに移る"@ja.
kg:id_7 rdf:type cls:c_3363.
cls:c_3363 rdfs:label "事業具体化"@ja.
kg:id_5 prop:effect kg:id_7.
kg:id_8 rdfs:label "市町村が前と違う対応をしなければならなくなる可能性"@ja.
kg:id_8 rdf:type cls:c_2361.
cls:c_2361 rdfs:label "行政対応"@ja.
kg:id_5 prop:effect kg:id_8.
kg:id_9 rdfs:label "説明会の開催"@ja.
kg:id_9 rdf:type cls:c_1188.
cls:c_1188 rdfs:label "説明会"@ja.
kg:id_5 prop:countermeasure kg:id_9.
kg:id_10 rdfs:label "市民ファンド"@ja.
kg:id_10 rdf:type cls:c_3364.
cls:c_3364 rdfs:label "住民基金"@ja.
kg:id_5 prop:countermeasure kg:id_10.
kg:id_11 rdfs:label "町民ファンド"@ja.
kg:id_11 rdf:type cls:c_3364.
kg:id_5 prop:countermeasure kg:id_11.
kg:st_1 rdfs:label "町長（時田博機君）"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "コロナで友好としての交流ができない状況が続いている"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域の発信や市の出展などの交流機会が失われている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "イケ・サンパークや池袋で地域発信を行う形が考えられる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "１１番（斎藤弥志夫君）"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_4 prop:content "促進区域認定により事業が具体的段階へ進むとみている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "促進区域になると業者選定などが進み事業の具体性が高まる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "促進区域になると市町村の対応が変わる可能性を懸念している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "これまで説明会が行われかなり詳しい説明があったと述べている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "市民ファンドは資本を集め事業に使う仕組みとして話が進んでいる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "町民ファンドとして地域資本を集める方向に進んでいるとみている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "いわゆる交流がなかなかコロナでできなくなっているということ、友好としての交流もできないという形がずっと続いておりました"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "いわゆる交流がなかなかコロナでできなくなっているということ、友好としての交流もできないという形がずっと続いておりました"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "イケ・サンパーク、池袋にやっぱり遊佐の市を出したり、地域の発信をするとかいろんな形が"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今遊佐町の場合も、９月中に促進区域に認定されるかどうかというふうな状況まではなっているようでございますが、促進区域になると、今度何かもう具体的な段取りに移っていくみたいでございます"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "促進区域になると、今度何かもう具体的な段取りに移っていくみたいでございます。例えば業者選定だとか、洋上風力発電の実際やる業者選定だとか、そういうふうな形で移っていくということなので、かなり事業自体に具体性が持たれてくる"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "実際促進区域になると、そこの市町村も多分前と違うような対応をしなければならなくなるのではないかと、自分なりに考えるのですけれども"@ja.
<< kg:id_5 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "これまでも例えば遊佐の場合ですと、エルパの２階で荘内銀行さんが説明会というふうなことを４回くらいですか、やってくれたような気がいたします。かなり詳しい説明もあった"@ja.
<< kg:id_5 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "この前、前回は私も参加はしていましたけれども、市民ファンドのお話でございました。町民ファンドというものかもしれませんけれども、こうなりますと実際にお金を集めると、集めたお金を事業に使っていく"@ja.
<< kg:id_5 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "市民ファンドのお話でございました。町民ファンドというものかもしれませんけれども、こうなりますと実際にお金を集めると、集めたお金を事業に使っていく"@ja.
}
