kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_1 prop:content "地域に不利な方向にならないと考えるが議論の推移を注視する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域の実態を踏まえて検討されるため不利な方向にはならないと見る"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "大変大きな衝撃として受け止めている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "世界的潮流は理解できるが地域としては厳しい事態になりかねないと危機感を持つ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "田中斉議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_5 prop:content "休廃止回避の働きかけと計画的リプレース要望を早急に行うべき"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "港湾機能維持への影響を懸念する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "高度な工業技術人材の喪失は本市の大きな損失であり雇用対策が必要"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "石炭や石炭灰が取扱貨物量の約6割を占めるため大きな影響があると認識する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_3 rdfs:label "丸山至市長・酒田市議会議長・酒田商工会議所会頭"@ja.
kg:st_3 rdf:type cls:st_52.
cls:st_52 rdfs:label "関係者"@ja.
kg:op_9 prop:content "山形県知事に基地港湾指定と港湾管理者としての積極関与を要望した"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "現時点で決定事項はなく互いに情報収集し国の動向を注視する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "国の動向を注視しつつ関係者と情報交換し対応策を検討する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "雇用問題は最重要であり関係者と連絡を密にして対応する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "場合によっては国や県への働きかけをさらに強める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "地域の実態を踏まえた検討により不利な方向にはならないと考える"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "港湾関係者の不安が強く早急な対応が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "山形県全体にとっても非常に経済的影響力のある企業である"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "港湾機能整備の継続可否を懸念する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "技術力喪失も含めた雇用対策が必要"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "市内外の雇用と取引に大きく寄与している"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "一定程度ではなく大きな影響があると考える"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:st_4 rdfs:label "東北電力樋口社長"@ja.
kg:st_4 rdf:type cls:st_21.
cls:st_21 rdfs:label "事業者"@ja.
kg:op_21 prop:content "拙速を避け安定供給や地域経済への影響を慎重に検証すべき"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "経済産業省が所管する総合資源エネルギー調査会の有識者会議において、非効率石炭火力発電のフェードアウトの仕組みとともに、再生可能エネルギーの導入を加速化するような送電線の利用ルールについても具体策が議論され始めたところでございます"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "再生可能エネルギーの導入を加速化するような送電線の利用ルールについても具体策が議論され始めたところでございます。この議論においては、地域の実態等も踏まえつつ検討を進めるとされておりまして"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "７月３日に梶山経済産業大臣が、非効率な石炭火力のフェードアウトについて2030年という具体的な年限を示したことは、大変大きな衝撃として受け止めております"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "このたびの政府の方針は、脱炭素社会を目指すという世界的な潮流は理解できるものの、地域としては大変厳しい事態になりかねない、このような危機感を持った捉え方をしております"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "本市の港湾関係者は不安を隠せない状況にありますが、万一、休廃止対象になれば、本市経済にも大きな影響が想定されます"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "昨年度の全取扱貨物量332万トンの54.3％、180万トンは火力発電の石炭輸入であり、10年後に休廃止されると、全貨物量の半分が消えてなくなります"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "万一、休廃止の対象となれば、約500名の雇用が失われるとも言われておりますが、発電技術、メンテナンス技術を含めて、高度な工業技術力を持つ人材を失うのは本市の大きな損失と思います"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "酒田共同火力発電に関係する酒田港の取扱貨物量の中で、全体の中で約６割が石炭や石炭灰が占めているという現状を考えますと、やはり一定程度、酒田共同火力発電の今後の動向というものが港の貨物取扱量にも大きな影響を及ぼすであろうと、このように考えております"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "８月27日でございますけれども、酒田港湾振興会の会長であります私と、それから副会長であります市議会議長、さらには酒田商工会議所の会頭と共々、山形県知事に対しまして、山形県の産業振興と酒田港の将来展望を見据えた緊急要望という形で、酒田共同火力発電のエネルギー分野での存続ですとか、港湾振興のための洋上風力発電の基地港湾指定、酒田港をぜひ基地港湾にしてもらうための動きについて、港湾管理者でもあります山形県の積極的な関与を要望をしてきたところでございます"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "先月の上旬、酒田共同火力発電の千葉社長と私どもの副市長が面談をいたしまして、現時点では何も決定された事項はなく、まずは互いに情報収集しながら国の動向を注視していくことを確認をしたところでございます"@ja.
<< kg:id_18 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本市といたしましては、まずは国の動向を注視しながら、今後とも酒田共同火力発電、そして東北電力、さらには山形県と情報交換を行って、地域にとって重大な事態とならないように、そして、そうするためにどのような方策が考えられるのかを今後ともしっかりと検討してまいりたいと、このように思っております"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "雇用の問題が最重要であるということは議員と全く同じ認識でございます。大量解雇などの事態にならないように、今後も酒田共同火力発電をはじめ、関係者と連絡を密にして、必要に応じた対応策を取っていきたいと思っております"@ja.
<< kg:id_21 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "場合によっては国や県への働きかけをやはりもっともっと強めていきながら、危機的な状況に陥らないような対応策について十分取り組んでまいりたいと、このように思っているところでございます"@ja.
<< kg:id_24 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "この議論においては、地域の実態等も踏まえつつ検討を進めるとされておりまして、地域にとって不利になるような方向にはならないと考えておりますけれども"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "本市の港湾関係者は不安を隠せない状況にありますが"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "万一、休廃止対象になれば、本市経済にも大きな影響が想定されます"@ja.
<< kg:id_26 prop:effect kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "昨年度の全取扱貨物量332万トンの54.3％、180万トンは火力発電の石炭輸入であり、10年後に休廃止されると、全貨物量の半分が消えてなくなります"@ja.
<< kg:id_26 prop:effect kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "万一、休廃止の対象となれば、約500名の雇用が失われるとも言われております"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:text-txt_contents "発電設備の年２回の定期点検の際は、酒田に１基当たり300人が２か月間出張してまいります。年間約1,200人が市内のホテルや飲食店を利用し、本市の消費経済にも大きく貢献しております"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:text-txt_contents "酒田共同火力発電所は、バイオマス発電所、メガソーラー、風力発電、現在取組中の洋上風力発電とともに、国内有数のエネルギー産業の集積地を形成し、その中でも最も発電単価の安いベースロード電源として、その中核を担っております"@ja.
<< kg:id_31 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "市内及び県内企業との取引についても、相当額の取引額があるとお聞きをしておりまして、酒田市はもとよりでありますが、山形県全体にとって非常に経済的影響力のある企業であると、このように認識をしております"@ja.
<< kg:id_15 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "やはり一定程度、酒田共同火力発電の今後の動向というものが港の貨物取扱量にも大きな影響を及ぼすであろうと、このように考えております"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "東北電力の樋口社長は、石炭火力は原子力に代わる電源として安定供給に貢献してきた、廃止となれば雇用や経済への影響も大きいといたしまして、拙速を避け、安定供給や地域経済への影響を慎重に検証すべきだと、このような意見も述べていらっしゃるところでございます"@ja.
}
