PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00157> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "酒田港への企業誘致"@ja.
kg:id_1 rdf:type cls:c_268.
cls:c_268 rdfs:label "企業誘致"@ja.
kg:id_2 rdfs:label "酒田港のカーボンニュートラルポート検討会の立ち上げ"@ja.
kg:id_2 rdf:type cls:c_1313.
cls:c_1313 rdfs:label "検討会"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "遊佐沖の洋上風力に関する有望区域指定"@ja.
kg:id_3 rdf:type cls:c_194.
cls:c_194 rdfs:label "区域指定"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "酒田港"@ja.
kg:id_4 rdf:type cls:c_1084.
cls:c_1084 rdfs:label "港湾"@ja.
kg:id_5 rdfs:label "洋上風力の基地港指定が今後進む可能性"@ja.
kg:id_5 rdf:type cls:c_3732.
cls:c_3732 rdfs:label "基地港指定"@ja.
kg:id_4 prop:effect kg:id_5.
kg:id_6 rdfs:label "カーボンニュートラルポートとして何ができるかを検討する"@ja.
kg:id_6 rdf:type cls:c_3733.
cls:c_3733 rdfs:label "検討行為"@ja.
kg:id_4 prop:countermeasure kg:id_6.
kg:st_1 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_1 rdf:type cls:st_23.
cls:st_23 rdfs:label "行政担当者"@ja.
kg:op_1 prop:content "カーボンニュートラルポートとしての動きとして何ができるかを考えていく"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "９月14日には、国・県、それから市、それから市内の民間事業者を併せて酒田港のカーボンニュートラルポート検討会が立ち上がりました"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "その前日の13日でございますけれども、洋上風力の関係で遊佐沖が有望な区域に指定を受けたということになります"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "そういった中で、酒田港に対しては、洋上風力の基地港指定ということも今後進んでいくのかなと思っております"@ja.
<< kg:id_4 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "まずは、カーボンニュートラルポートとしての動き、こういったことは何ができるのかということを考えていく、そこがスタートしたというところでございます"@ja.
}
