kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "発電事業は地域経済に大きな波及効果を持つ"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "発電事業は地域経済に大きな波及効果を持つ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "発電事業は地域経済に大きな波及効果を持つ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "発電事業は地域経済に大きな波及効果を持つ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "総合計画と総合戦略に基づき再生可能エネルギーの取組を進めている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "環境に十分配慮しながら市直営の風力発電事業を進めている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "関係機関と連携して洋上風力発電の導入を進めている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "山形県はゼロカーボン実現に向けた方針を示している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "県は環境計画を策定して温室効果ガス削減を進めている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "県は令和13年3月までのエネルギー政策の方針をまとめた"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "そのため、当該発電所が稼働している現状においては、ゼロカーボンシティ宣言は考えていないところでございます"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本市に立地する酒田共同火力発電株式会社、こちら石炭火力発電ですけれども、山形県で消費する発電量の約半分を供給しております"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "また、発電事業を通じた波及効果として、受発注取引、それから良質な雇用の確保、地方税収、酒田港の貨物取引など極めて大きく、地域経済を牽引する中核企業の一つであります"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "また、発電事業を通じた波及効果として、受発注取引、それから良質な雇用の確保、地方税収、酒田港の貨物取引など極めて大きく、地域経済を牽引する中核企業の一つであります"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、発電事業を通じた波及効果として、受発注取引、それから良質な雇用の確保、地方税収、酒田港の貨物取引など極めて大きく、地域経済を牽引する中核企業の一つであります"@ja.
<< kg:id_5 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "また、発電事業を通じた波及効果として、受発注取引、それから良質な雇用の確保、地方税収、酒田港の貨物取引など極めて大きく、地域経済を牽引する中核企業の一つであります"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "本市におきましては、平成30年に策定した酒田市総合計画及び令和２年に策定した第２期酒田市まち・ひと・しごと創生総合戦略に再生可能エネルギーに係る取組を掲げて、エネルギー政策を推進しております"@ja.
<< kg:id_10 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "具体的には、環境に十分配慮しながら市直営の風力発電事業に取り組み、今年４月から運転を開始しております"@ja.
<< kg:id_10 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "また、まち・ひと・しごと創生総合戦略の重点施策に基づいて、山形県をはじめとする関係機関と洋上風力発電の導入に向けた要望や協議を重ね、今年度から酒田市沖での洋上風力発電に向けた検討が進められているところでございます"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "山形県は、昨年の８月にゼロカーボンやまがた2050宣言を行い"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "今年の３月には第４次山形県環境計画を策定し、温室効果ガスの削減に取り組むとしております"@ja.
<< kg:id_14 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "同様に、３月には山形県のエネルギー戦略の後期エネルギー政策推進プログラムを策定し、令和13年３月までのエネルギー政策の方針をまとめました"@ja.
