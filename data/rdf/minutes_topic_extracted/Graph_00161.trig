cls:st_17 rdfs:label "発言者"@ja.
kg:op_2 prop:content "酒田港の新しい姿と新しい産業集積に期待する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "洋上風力発電事業の拠点となる基地港湾の指定に向け連携を進める"@ja.
kg:op_3 rdf:type cls:opinion.
