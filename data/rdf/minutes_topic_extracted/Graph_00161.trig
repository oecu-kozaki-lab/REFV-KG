    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "例えば洋上風力発電における基地港湾の指定を受ける、基地港湾化ですとか"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "カーボンニュートラルポートを見据えた企業誘致"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:text-txt_contents "誘致する企業の特性に沿った、港周辺の部分にあたる臨海部の土地利用"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "再生可能エネルギー導入を後押しするような取組を行うこととしている"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "国や県の動向を注視しながら、令和４年度ということではなくて、それ以降も含めて順次予算化・事業化をしてまいりたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "国・県、地元企業との連携を進める"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "これは2030年度36％から38％、現状は18％しかないということでございますが"@ja.
<< kg:id_9 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "この導入目標の達成を見据えて、洋上風力発電を促進するための拠点となる基地港湾の最適配置や規模等を検討しておりまして"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "2030年までに北海道・東北地方において２から３の港の基地港湾としての追加整備"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "トータルすると2040年までに最大８港が整備されるとの方向性が示された"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:text-txt_contents "酒田港は現在、造成中の30ヘクタール以上の広大な土地がありまして"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "大型化が進む風車部材の組立てには適しております"@ja.
<< kg:id_15 prop:cause kg:id_18 >>
    prop:text-txt_contents "遊佐町沖や、今後の動きになりますが、酒田市沖での洋上風力発電に当たっては最寄りの港として位置している"@ja.
<< kg:id_15 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "そういうことから大きなポテンシャルを持っていると考えております"@ja.
<< kg:id_15 prop:cause kg:id_20 >>
    prop:text-txt_contents "現状、バイオマス発電だったり陸上部分にも風車がありますので"@ja.
<< kg:id_15 prop:effect kg:id_21 >>
    prop:text-txt_contents "エネルギー供給拠点としての機能も有している"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "水素あるいはアンモニアなどの次世代エネルギーを含めて、関連産業の立地による地域全体の産業振興につながるものという期待がされる"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "１つは基地港湾やカーボンニュートラルポートを見据えた県外からの企業誘致"@ja.
<< kg:id_24 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "２つ目は誘致する企業の特性に沿った臨海部の土地利用"@ja.
<< kg:id_24 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "３つ目は洋上風力発電施設の建設後、発電事業運営期間における地域振興策"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "水素・アンモニアの次世代エネルギーの利活用等脱炭素化に配慮した港湾機能の高度化"@ja.
<< kg:id_28 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "酒田港において地域企業を中心とした脱炭素社会の実現に向けた検討を進めてきている"@ja.
<< kg:id_31 prop:countermeasure kg:id_32 >>
    prop:text-txt_contents "現時点における温室効果ガスの排出量を推計し、短期、中期、長期に取り組むべき課題などを示して"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:text-txt_contents "酒田港のカーボンニュートラルポート形成方針の素案などが整備された"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:text-txt_contents "酒田港が基地港湾に指定されるためには、例えば遊佐町沖と酒田市沖といった２つの海域で事業者の利用見込みが必要"@ja.
<< kg:id_34 prop:cause kg:id_36 >>
    prop:text-txt_contents "海域の先行利用者となっております漁業者との共存共栄など、山形県が取り組む洋上風力の検討においては慎重な議論が求められる"@ja.
<< kg:id_34 prop:effect kg:id_37 >>
    prop:text-txt_contents "見通しが現時点では立っておらず"@ja.
<< kg:id_34 prop:effect kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "課題として、４つ目の２つ以上の者の利用見込みの形成が基地港湾指定にとっては一番大きな、今ハードルになっている"@ja.
<< kg:id_15 prop:effect kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "港が活性化しない限りは、この酒田のこれからの大きな進捗もないんだと思います"@ja.
}
