kg:op_16 prop:speaker kg:st_4.
kg:st_5 rdfs:label "国"@ja.
kg:st_5 rdf:type cls:st_33.
kg:op_17 prop:content "次世代エネルギー活用を含む港湾機能の高度化を検討する"@ja.
