kg:st_1 rdfs:label "後藤仁議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "人口減少を抑える施策をこの4年間で着実に進めるべきだ"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地域維持のため経済活性化が必要だ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "洋上風力発電は待ったなしで実現する事業だ"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "地元金融機関の頭取"@ja.
kg:st_2 rdf:type cls:st_105.
cls:st_105 rdfs:label "金融機関"@ja.
kg:op_4 prop:content "洋上風力発電は1か所で3000億円の経済波及効果がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "庄内地方にとどまらず山形県全体に波及する規模で進めるべきだ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "国県市がタッグを組んで前に進めるべきだ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_3 rdfs:label "酒田市長"@ja.
kg:st_3 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_7 prop:content "地域の理解醸成と意見の取りまとめが図られるよう山形県と連携していきたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "酒田港を基地港湾とする機能強化が図られるよう取り組んできた"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "酒田港が基地港湾から外されないよう体制を整えるべきだ"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "酒田港の活用により新たな産業形成が期待される"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "遊佐町沖は2033年頃の運転開始が想定される"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "市民の理解醸成を図りながら議論を進めたい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "法定協議会の中で具体的な議論が展開される"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "現状に合わせて経済波及効果を改めて試算する必要がある"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "秋田県の事例を参考に試算の検討を進めている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "洋上風車建設が進む地域では交流人口増で宿泊施設が不足する事例がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "酒田市では以前より宿泊施設が不足し宿が取りにくい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "優良なホテル案件があれば連携や支援を行いたい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "再生可能エネルギーの地域利用は優良企業の誘致につながる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "商工港湾課を中心に関係課が連携して取り組む"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:st_4 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_4 rdf:type cls:st_28.
cls:st_28 rdfs:label "部長"@ja.
kg:op_21 prop:content "商工港湾課を核に企画部や市民部などと連携し対応する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "県と対応できる正式なセクションを設けるべきだ"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "酒田市沖の進捗が遅れると酒田港が基地港湾でなくなる懸念がある"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "令和３年、令和４年の出生数は481人、458人、今年は、予定ではぎりぎり400人になるか"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "死亡者数は1,600人前後であります"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "1,400人が４年間で減ると推定するならば、5,600人、令和10年には、人口が８万人台になるという座標軸が出てまいります"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "まず、経済が活性化しなければ地域は成り立ちません"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "洋上風力発電は、国策というか、地球温暖化を考えれば待ったなしで実現する事業だと考えます"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "その目標を達成するためには、太陽光は20倍、風力は11倍増加させないとその目標には達成しない"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:text-txt_contents "その目標を達成するためには、太陽光は20倍、風力は11倍増加させないとその目標には達成しない"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "洋上風力発電は１か所で3,000億円の経済波及効果がありますよと。この効果を山形県全体でどう動かしていくか、それを地元企業の皆さんと共に考えていきたい"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "この事業には、国・県・市この３団体がきっちりとタッグを組んで前に進まなければならない事業だと思います。 今後は、地域住民向けの説明会や初回の法定協議会などが予定されており、引き続き、地域の理解醸成と意見の取りまとめが図られるよう山形県と連携していきたい"@ja.
<< kg:id_12 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本市といたしましては、酒田港を基地港湾とする機能強化が図られるよう、これまで山形県及び国に対して、基地港湾を誘致する取組、具体的には港湾計画の変更、あるいは中央要望等を行ってまいりました。 ちょっと酒田市沖は遅れているから基地港湾は酒田港じゃなくてもいいんだよね、ということを言われないような体制をきっちりと取っていただきたい"@ja.
<< kg:id_12 prop:effect kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "さらには洋上風力発電事業の導入を契機とした新たな産業形成等も期待されております"@ja.
<< kg:id_12 prop:effect kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "その目安から遊佐町沖の風車建設時期までに酒田港が基地港湾として機能強化を図られたと想定した場合には、運転開始は2033年頃になるのではないかと思われます"@ja.
<< kg:id_12 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "2024年２月頃に開催を検討しております、地域住民向けの説明会を含め、洋上風力発電事業の導入に向けた議論がこれから始まります。市民の理解醸成を図りつつ"@ja.
<< kg:id_12 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "2024年３月に開催を検討する再エネ海域利用法に基づく法定協議会の中で具体的な議論が展開されていくものと考えております"@ja.
<< kg:id_12 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "当時想定した風車のサイズや発電規模等に対して、世界の潮流が大きく変化したため、現在の遊佐町沖や酒田市沖で想定されているものと大きくかけ離れておりまして、改めて試算する必要が生じております"@ja.
<< kg:id_12 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "山形県では遊佐町沖及び酒田市沖における洋上風力発電を導入した場合の経済波及効果の試算等について、現時点で試算方法等を公表している秋田県の事例を参考にしながら、試算の検討を進めている"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "洋上風車等の建設が進む地域で、急激な交流人口の増加により、宿泊施設が不足する事例があると聞いております"@ja.
<< kg:id_22 prop:effect kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "本市においては、以前より宿泊施設が不足しており、宿が取りにくい状況にあります"@ja.
<< kg:id_22 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "新たなホテル事業者が宿泊機能を高めることは、本市としてありがたいことだと考えております。 本市におきましては、ホテル建設が市の魅力を高め、持続可能な経営が行われ地方創生に資するような優良な案件があれば、連携や支援を行っていきたい"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "本地域で発電される再生可能エネルギーを地域で利用する仕組みを検討することにより、再生可能エネルギー利用を目的とした優良な企業の誘致につながる例があると認識しております"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "酒田市役所の体制としましては、商工港湾課を中心に関係する課が連携して取り組む、という体制をとっております。 商工港湾課では労働、人材育成、あるいは企業誘致、企業立地も含めて、洋上風力発電事業、エネルギー事業、こういったものをトータルで対応できるような組織体制になっています。 本市としても正式な室でも何でも結構でございますので、きっちり県と対応できるようなセクションをつくるべきではないか"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "ちょっと酒田市沖は遅れているから基地港湾は酒田港じゃなくてもいいんだよね、ということを言われないような体制をきっちりと取っていただきたい"@ja.
}
