PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00178> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "財政硬直化"@ja.
kg:id_2 rdfs:label "公債費の占める割合が依然として高いこと"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "公債費や公共施設の維持管理経費の増加"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "人件費の増"@ja.
kg:id_1 prop:cause kg:id_4.
kg:id_5 rdfs:label "物価高騰の影響"@ja.
kg:id_1 prop:cause kg:id_5.
kg:id_6 rdfs:label "学校やスポーツ施設の雨漏りが直せない状況"@ja.
kg:id_7 rdfs:label "財政が厳しく予算がないこと"@ja.
kg:id_6 prop:cause kg:id_7.
kg:id_8 rdfs:label "若者の地元定着が伸びないこと"@ja.
kg:id_9 rdfs:label "職種やマッチングの課題"@ja.
kg:id_8 prop:cause kg:id_9.
kg:st_1 rdfs:label "矢口明子市長"@ja.
cls:st_-1 rdfs:label "null"@ja.
kg:op_1 prop:content "公債費を減らすため市債発行額の抑制を進めるべきだとする"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "市民要望への対応と財政健全化の調和が重要課題だとする"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "前田茂男総務部長"@ja.
cls:st_-1 rdfs:label "null"@ja.
kg:op_3 prop:content "人件費上昇で中期財政計画との単純比較は難しいとする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "中期財政計画策定時と前提条件が大きく異なり見通しが難しいとする"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_3 rdfs:label "田中斉議員"@ja.
cls:st_-1 rdfs:label "null"@ja.
kg:op_5 prop:content "市民サービスを極端に低下させてはならないと懸念する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "人手不足がなかなか解消されていないとみる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本市では、公債費の占める割合が依然として高いため、県内の他市と比較しても実質公債費比率は高い水準となっております"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本市の財政運営においては、公債費や公共施設の維持管理経費の増加などにより厳しさが増しておりまして、市民要望への対応と財政健全化をいかに調和させるかが重要な課題でありました"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "人件費が人勧で大きく上がったり、物価が高騰したり、災害があったり、中期財政計画と常に比較をしていくというのが、なかなか難しいところがあります"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "今般の大雨災害や人件費の増、物価高騰の影響など中期財政計画の策定時と前提条件が大きく異なっていること"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "財政が厳しく予算がなくて、学校やスポーツ施設の雨漏りが直せないのかという苦情をいただくこともあります"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "職種やマッチングにもよるのでしょうが、残念ながら人手不足はなかなか解消されておりません"@ja.
}
