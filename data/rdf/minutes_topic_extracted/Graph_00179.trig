kg:id_54 prop:countermeasure kg:id_55.
kg:st_1 rdfs:label "市民部長 渡会悟"@ja.
kg:st_1 rdf:type cls:st_12.
cls:st_12 rdfs:label "行政職員"@ja.
kg:op_1 prop:content "接続には空き容量が必要で、ない場合は設備増強が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "需給バランス上、上位系統への連系と設備増強が高額要因"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "接続希望や取りやめで負担金が変動し確定に長期間を要する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "不確定要素の多い長期債務のため行政対応が難しい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "加藤鑛一議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_5 prop:content "資源化可能物の焼却は循環型社会に逆行するのではないか"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "売電不能なら建設費や維持費が過大な施設になった疑いがある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "自家消費で年間約1億円の経費削減を見込む"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "余剰電力も売電または活用できるよう努めるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_3 rdfs:label "市長 皆川治"@ja.
kg:st_3 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_9 prop:content "職員の専門的理解不足が容量未確保につながった"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "コンサルタント依存にも問題があった"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "施設規模拡大と国の政策との衝突が現状を招いた"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "売電事業を取り込み目的を誤ったことが現状を招いた"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "電力大企業の横暴と原発優先政策を変えなければ解決しない"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "空き容量確認にとどまり接続契約で押さえられなかったのが問題"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "大規模風力はエネルギー自給率向上と地域発展に寄与すると期待する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:st_4 rdfs:label "草島進一議員"@ja.
kg:st_4 rdf:type cls:st_9.
kg:op_16 prop:content "5基に減らせば影響回避できるとの判断なのか確認を求める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "クマタカ確認を受け北側4基を3基に南側3基を2基に減らした"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "動物への影響回避低減のため地下埋設を講じる"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "ブレード塗装で動物への影響回避低減を図る"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "鳥類誘引を抑える灯火採用で影響低減を図る"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "営巣期を避ける工事調整でクマタカ影響を低減する"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "重要植物は同様の環境へ移植して保全する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "着実な事業実施と適正維持管理のため協定を締結した"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "地域住民の理解を深め意見を聞く機会を設けてきた"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "道路整備で木材搬出が可能となり林業活性化が期待される"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "展望や休憩の場として観光利用が可能になる"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "風力と木質バイオマスの相乗効果で地域活性化が期待される"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "地域の子どもや住民の環境学習の場として活用を検討している"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "工事や運転管理で地元雇用が見込まれる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "固定資産税増収による財政効果を期待している"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "環境保全と住民理解を前提に導入を進める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "調査予測評価を通じ影響回避低減を引き続き求める"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "コミュニティパワー原則を踏まえた展開を求める"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "先進事例を参考に地域を豊かにする再エネのあり方を調査研究する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "売電に必要な空き容量がない場合には電力会社の設備増強のための工事負担金が必要とあります。本市の場合、平成30年11月22日付、第３回接続検討回答書により、空き容量がなく、設備増強が必要となる"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "工事負担金が高額となる要因としましては、電力の需給バランスにより当該地域からより上位の送配電系統に連系する必要がある場合、そのための設備増強が必要となるため"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "増強工事完了までの期間及び工事完了後３年間に新たに接続を希望する、また接続を取りやめる事業者があれば容量案分により負担金の額が変動する"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "このように売電を行うためには長期にわたり不確定要素の多い債務が生じることから、今回のごみ焼却施設整備に伴う売電事業では行政の財政制度上対応が難しいルールになっている"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "高効率発電焼却施設では、高い発電量が見込める廃プラや紙、繊維類、ゴム、皮革など資源化されるものが燃やされ、循環型社会に逆行するのではないか"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "売電が不可能となれば結果的に多大な建設費やランニングコストという過大施設になったのではないか"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "発電によりごみ焼却施設とし尿処理施設における自家消費分で年間約１億円の削減を見込まれる"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "その他余剰電力につきましても売電または活用可能となりますよう努める"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "関係した職員が売電に関する専門的理解が不足をしていたということが容量を確保できなかったことにつながった"@ja.
<< kg:id_17 prop:cause kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "専門的な情報につきましては委託をしていましたコンサルタントに依存をしていたというところもございます"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "売電まで施設規模を膨らませてしまって、そして今や国のエネルギー政策とぶつかり合って売電できなくなっている"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "交付金増加を当てにした売電事業を取り込んでしまったために、今の状況に陥っている"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "私は、問題の根本に電力大企業の横暴さと原発優先の国のエネルギー政策の貧困さがあるというふうに思うんです。これを変えないと市のごみ発電の問題は解決されない"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "空き容量を接続契約を申し込んで押さえるということが必要だったところでございますが、それができなかったということが今の問題につながっている"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "環境負荷の小さい風力発電所の稼働によるエネルギー自給率の向上と持続可能な地域社会の発展に大きく寄与するものと期待している"@ja.
<< kg:id_30 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "対象事業実施区域周辺に５つがいのクマタカが確認され、実施区域の北側に分布していることが判明したことから、北側に設置予定だった４基を３基に、南側に設置予定だった３基も２基に減らす"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "送電線の地下埋設やブレードの塗装のほか、鳥類を誘引しにくいとされる閃光灯、フラッシュ灯の採用、クマタカの営巣期に配慮した工事時期の調整など、動物への影響を回避、低減するためのさまざまな環境保全措置"@ja.
<< kg:id_32 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "送電線の地下埋設やブレードの塗装のほか、鳥類を誘引しにくいとされる閃光灯、フラッシュ灯の採用、クマタカの営巣期に配慮した工事時期の調整など、動物への影響を回避、低減するためのさまざまな環境保全措置"@ja.
<< kg:id_32 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "鳥類を誘引しにくいとされる閃光灯、フラッシュ灯の採用"@ja.
<< kg:id_32 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "クマタカの営巣期に配慮した工事時期の調整など、動物への影響を回避、低減するためのさまざまな環境保全措置"@ja.
<< kg:id_32 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "改変区域内に生息する重要な植物であるコシノコバイモやヤマシャクヤク、ヤマトアオダモ、リンドウ、イイヌマムカゴについては、生息地と同様の環境へ移植を行われます"@ja.
<< kg:id_32 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "着実な事業実施と施設等の適正な維持管理に関しましては、市と事業者の間において環境保全協定書を昨年12月に締結しております"@ja.
<< kg:id_32 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "事業者では三瀬地区自治会を初め、周辺地域を対象とした意見交換会や説明会をこれまで７回開催し、地域住民の事業に対する理解を深めるとともに、意見を伺う機会を設けてきております"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "風力発電所の搬入路兼管理用道路が整備されることによりまして、現在木材の搬出が困難となっている地域での伐採等が行われることとなり、林業の活性化が期待されます"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "搬入路の一部を展望スペースとして整備されることによりまして、日本海や鳥海山といったすばらしい眺望と風車を間近に鑑賞したり、トレッキングの際の休憩場所として利用することも可能となります"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "このたびの搬入路整備が三瀬地区における木質バイオマスの取り組みにさらなる発展をもたらし、２つの再生エネルギーの取り組みの相乗効果による地域の活性化が期待される"@ja.
<< kg:id_46 prop:effect kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "風力発電所の運転開始後には、既に酒田市の風力発電所で開催されている見学会等のイベント開催のほか、定期的に地元の小中学生や高校生、地域の方々を対象とした環境学習の場としての利用も検討されております"@ja.
<< kg:id_32 prop:effect kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "工事期間中は地元業者による工事の実施のみならず、工事終了後の運転や管理業務についても数名の地元雇用が想定されております"@ja.
<< kg:id_32 prop:effect kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "固定資産税の増収による一定の財政効果も期待されているところでございます"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "今後の風力発電開発につきましては、まずは本市のガイドラインに基づき市全体や周辺における生活環境、自然環境、さらには景観の保全に配慮するとともに、地域住民理解に努めていただくよう事業者に求めながら"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "今後風力発電事業につきましても生活環境や自然環境などの保全の観点から、環境アセスメントにおける調査や予測、評価について実行可能な範囲内で環境影響を回避または低減するよう事業者に対して引き続き意見してまいりたい"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "市といたしましても先進事例を参考にしながら、地域を豊かにする再生可能エネルギーのあり方について今後調査、研究をしてまいりたい"@ja.
}
