kg:id_31 rdf:type cls:c_1136.
cls:c_1136 rdfs:label "継続調査"@ja.
kg:id_30 prop:countermeasure kg:id_31.
kg:id_32 rdfs:label "矢引と加茂の風車計画"@ja.
kg:id_32 rdf:type cls:c_66.
kg:id_33 rdfs:label "市民と行政と事業者のリスクコミュニケーションの協議の場を設置する"@ja.
kg:id_33 rdf:type cls:c_2058.
cls:c_2058 rdfs:label "協議の場"@ja.
kg:id_32 prop:countermeasure kg:id_33.
