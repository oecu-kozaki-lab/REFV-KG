kg:id_25 rdf:type cls:c_4239.
kg:id_23 prop:effect kg:id_25.
kg:id_26 rdfs:label "風車と民家の距離600メートル"@ja.
kg:id_26 rdf:type cls:c_4240.
cls:c_4240 rdfs:label "風車距離"@ja.
kg:id_27 rdfs:label "大型風車では健康影響が出てしかるべきとの懸念"@ja.
kg:id_27 rdf:type cls:c_79.
kg:id_26 prop:effect kg:id_27.
