kg:id_28 rdf:type cls:c_4241.
cls:c_4241 rdfs:label "風車の稼働"@ja.
kg:id_29 rdfs:label "低周波音の参照値41デシベルを超過する箇所があった"@ja.
kg:id_29 rdf:type cls:c_4242.
cls:c_4242 rdfs:label "参照値超過"@ja.
kg:id_28 prop:effect kg:id_29.
