kg:id_13 rdf:type cls:c_4254.
cls:c_4254 rdfs:label "負担増加"@ja.
kg:id_1 prop:effect kg:id_13.
kg:id_14 rdfs:label "地域との混乱"@ja.
kg:id_14 rdf:type cls:c_4255.
cls:c_4255 rdfs:label "地域混乱"@ja.
kg:id_1 prop:effect kg:id_14.
