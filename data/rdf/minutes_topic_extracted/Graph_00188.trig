kg:id_15 rdf:type cls:c_4256.
cls:c_4256 rdfs:label "中止要求"@ja.
kg:id_1 prop:countermeasure kg:id_15.
kg:id_16 rdfs:label "国や県や専門家と協議し慎重に検討する"@ja.
kg:id_16 rdf:type cls:c_4257.
cls:c_4257 rdfs:label "協議検討"@ja.
kg:id_1 prop:countermeasure kg:id_16.
