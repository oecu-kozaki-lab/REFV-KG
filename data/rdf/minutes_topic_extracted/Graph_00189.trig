kg:id_45 rdf:type cls:c_4278.
cls:c_4278 rdfs:label "環境理念"@ja.
kg:id_46 rdfs:label "生物多様性と湿地の重要性を認識して取り組む"@ja.
kg:id_46 rdf:type cls:c_4279.
cls:c_4279 rdfs:label "保全取組"@ja.
kg:id_45 prop:countermeasure kg:id_46.
kg:st_1 rdfs:label "草島進一議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "風車による野鳥への悪影響は十分想定できる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "自然を愛する全国の方々"@ja.
kg:st_2 rdf:type cls:st_22.
cls:st_22 rdfs:label "市民"@ja.
kg:op_2 prop:content "市長の中止要請を大変評価している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "風車によるバードストライクが懸念される"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "飛来地の変更も十分想定できる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "猛禽類にとって特に脅威となる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "計画は完全に非常識で国際的非難を招きかねない"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "開発業者依頼の鳥類調査は決して十分ではない"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "アセスに進めば事業をおおむね認めることになりがちだ"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "説明や意見受理が省かれ方法書段階へ進むリスクがあった"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "予防原則として重要地域を事前に避けるべきだ"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "市長の中止要請は極めて妥当である"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:st_3 rdfs:label "反対署名8,000名以上の方々 地元加茂 大山を含む多くの市民 野鳥研究の関係者 自然を愛する全国の方々"@ja.
kg:st_3 rdf:type cls:st_22.
kg:op_12 prop:content "市長の中止要請を大変評価している"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "5キロのバッファーゾーンを設けガイドラインに明記すべきだ"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:st_4 rdfs:label "市民部長 伊藤慶也"@ja.
kg:st_4 rdf:type cls:st_40.
cls:st_40 rdfs:label "行政"@ja.
kg:op_14 prop:content "国を通じて専門的知見を収集しながら検討したい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
kg:op_15 prop:content "静かな環境で35から40デシベル超過時に煩わしさが増す可能性がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "睡眠への影響リスクが増加する可能性がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "風車騒音について国の動きを注視すべきだ"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "国の指針動向を注視しガイドライン見直しを検討したい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "現時点で地元自治会から睡眠障害の話は受けていない"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_4.
kg:op_20 prop:content "自治会任せでなく市として悉皆調査を行うべきだ"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "地元自治会の意向を伺いながらアンケート調査等を検討したい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "累積的影響が懸念される"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "騒音や低周波音による影響が懸念される"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "風車の影などが学校や住民生活環境に影響することが懸念される"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "急傾斜地崩落や地滑り 土石流の危険性が懸念される"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "希少種の生息への影響が懸念される"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "環境影響を回避または十分低減できない場合は配置の再検討を求めている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:op_28 prop:content "区域や基数の削減を含む計画見直しを求めている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_4.
kg:op_29 prop:content "風車規模拡大に伴う睡眠障害への累積的影響を慎重に検討したい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:op_30 prop:content "鳥類の渡りルートへの累積的影響を慎重に検討したい"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_4.
kg:op_31 prop:content "環境審議会などの有識者の意見を伺いながら検討したい"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_4.
kg:op_32 prop:content "市民全体にオープンな説明を義務づけるようガイドラインを早急に見直すべきだ"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "事業者説明は限定的で不十分だった"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "市民有志の説明要請を事業者が拒否した"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:st_5 rdfs:label "市長 皆川治"@ja.
kg:st_5 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_35 prop:content "ネーチャーポジティブへの理解を深め生物多様性と湿地の重要性を認識して取り組む"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "市長の決断はネーチャーポジティブの時代にふさわしい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "風車によるバードストライクや飛来地の変更などの影響は十分に想定できます。こうした日々の調査結果でも、風車による悪影響は十分想定できます。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "風車によるバードストライクや飛来地の変更などの影響は十分に想定できます。風車によるオジロワシのバードストライクは国内でも70例確認されており、猛禽類にとって特に脅威となっております。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "風車によるバードストライクや飛来地の変更などの影響は十分に想定できます。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "風車によるオジロワシのバードストライクは国内でも70例確認されており、猛禽類にとって特に脅威となっております。"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "６メガワットもの巨大風車をラムサール湿地２キロに建てるなどという計画は完全に非常識で、国際的に非難されかねないということはしっかりと認識すべきであります。"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "環境アセス上で開発業者が依頼する鳥類の調査は、決して十分なものではなく"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "要するにアセスに踏み込めば、事業をおおむね認めることになるというのがよくある話とお伺いしております。"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "2021年10月の法改正で、今回の計画では、配慮相談会での説明や意見受理が省かれ、いきなり方法書段階に踏み込まれるリスクもあったと思います。"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "風力発電では、環境保全上重要な地域を事前に避けるべきという予防原則がバードライフ・インターナショナルでの勧告でもあり"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "予防的措置としてこのタイミングで判断された今般の市長の中止要請は極めて妥当であると評価をいたします。現在集まっている反対署名8,000名以上の方々、地元加茂、大山を含む多くの市民をはじめ、野鳥研究の関係者、自然を愛する全国の方々が大変評価されております。"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "改めてラムサール条約湿地を世界遺産に準じて、５キロメートルのバッファーゾーンを含めてゾーニングで規制することをガイドライン上に明記いただきたいと思います。"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "本市ガイドラインにおけるラムサール条約登録湿地からのゾーニング規制につきましては、引き続き国を通じて専門的知見等、情報収集に努めながら、検討してまいりたいと考えております。"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "国の指針では、静かな環境では風車騒音が35から40デシベルを超過すると、煩わしさの程度が上がり"@ja.
<< kg:id_21 prop:effect kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "国の指針では、静かな環境では風車騒音が35から40デシベルを超過すると、煩わしさの程度が上がり、睡眠への影響のリスクを増加させる可能性があることが示唆されております。"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "本市においては、数値のみで判断するのではなく、年々風力発電施設の大型化や出力が増大している状況でございますので、国が示す指針などの動向を注視しながら、本市のガイドラインの見直しの必要性について検討してまいりたいと考えております。"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_19;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "鶴岡八森山風力発電事業における風車騒音に関する睡眠障害などにつきましては、現時点で地元自治会からはお話をいただいておりません。三瀬八森山の風車の関連については、これは自治会に尋ねていても駄目で、しっかりと市として悉皆調査をやっていただきたいと思います。"@ja.
<< kg:id_26 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "アンケート調査等につきましては、地元自治会の意向を伺いながら検討してまいりたいと考えております。"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "現在稼働している鶴岡八森山風力発電事業との累積的な影響"@ja.
<< kg:id_29 prop:effect kg:id_31 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "騒音及び低周波音"@ja.
<< kg:id_29 prop:effect kg:id_32 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "風車の影などが学校等や周辺住民の生活環境への影響"@ja.
<< kg:id_29 prop:effect kg:id_33 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "急傾斜地崩落危険区域における急傾斜地の崩落、それから地滑り、土石流の発生などの危険性"@ja.
<< kg:id_29 prop:effect kg:id_34 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "県指定の三瀬葉山ニッポンユビナガコウモリや希少猛禽類のクマタカ、それからオオタカの生息への影響などが懸念される"@ja.
<< kg:id_29 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "環境影響を回避、または十分に低減できない場合には、風力発電設備の配置の再検討"@ja.
<< kg:id_29 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "事業実施想定区域及び基数の削減を含む事業計画の見直しを行うようを意見しているところです。"@ja.
<< kg:id_37 prop:effect kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "風車規模の拡大に伴う地域住民の睡眠障害"@ja.
<< kg:id_37 prop:effect kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "鳥類の渡りルートなどに対する累積的影響につきましても、国や県の助言をいただきながら慎重に検討してまいりたいと考えております。"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_31;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "市のガイドラインの件でございますけれども、ガイドラインで定める住民説明会の対象範囲や持ち方などにつきましても、今後環境審議会など、有識者からの御意見等も伺いながら検討してまいりたいと考えております。ガイドライン上でしっかりとオープンの形で市民全体に説明しなきゃいけないということをしっかり明記するというか、ガイドラインを今すぐにでも変えていただきたい。"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "例えば加茂、大山の住民にしっかりと説明をしてきたのかというと、ごくごく限られた人たちだけにしかしていない。"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "市民有志で考える会というのをつくって、そういう企画をして、事業者を呼んで説明を請うたわけですけれども、全くそれを拒むという姿勢でありました。"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "このネーチャーポジティブ、国の次期生物多様性国家戦略の中でも盛り込まれていくということでございますので、こうした考え方についても理解を深めまして、生物多様性、またこの湿地の重要性について、しっかり認識をして取り組んでいきたいというふうに思っております。今般の市長の決断というのは、このネーチャーポジティブの時代にふさわしい判断だと私は高く評価をしております。"@ja.
}
