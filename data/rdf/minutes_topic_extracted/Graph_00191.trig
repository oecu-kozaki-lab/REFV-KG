kg:id_5 prop:cause kg:id_7.
kg:id_8 rdfs:label "三瀬地区を参考に加茂地区でも同様の事業展開ができないかとの思い"@ja.
kg:id_8 rdf:type cls:c_4295.
cls:c_4295 rdfs:label "事業期待"@ja.
kg:id_5 prop:cause kg:id_8.
