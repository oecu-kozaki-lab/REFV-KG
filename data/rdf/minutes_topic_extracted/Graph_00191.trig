kg:id_6 rdfs:label "加茂地区の少子高齢化や人口減少に伴う地域存続への危機感"@ja.
kg:id_6 rdf:type cls:c_4293.
cls:c_4293 rdfs:label "地域衰退危機"@ja.
kg:id_5 prop:cause kg:id_6.
kg:id_7 rdfs:label "加茂山の管理が困難でこのままでは山が荒れ地域に住む人がいなくなるとの危機感"@ja.
kg:id_7 rdf:type cls:c_4294.
