kg:st_1 rdfs:label "尾形昌彦議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "現時点での活用状況と進捗評価を確認したい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市民部長 佐藤茂巳"@ja.
kg:st_2 rdf:type cls:st_40.
cls:st_40 rdfs:label "行政"@ja.
kg:op_2 prop:content "民間企業による木質バイオマス発電事業が稼働し一定の成果を上げていると評価する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "おおむね順調であり今後の利用拡大の検討を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "三瀬地区で建設が始まる予定と認識している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "地域活性化につながるため引き続き支援し普及促進を図りたい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "補助制度により設置実績があり今後も支援を続けたい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "毎年多くの活用があり一層の利用促進に努めたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "当初想定以上の実績を上げている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "当初想定以上の実績を上げている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "当初想定以上の実績を上げている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "当初予定どおりではないが多様な方面で十分な進捗が見られる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "事業の意義と効果を確認したい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "地球温暖化対策の面で大きな意義がある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "全国初の試みで国も先導的なモデル事業と位置づけている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "排湯と給湯の両面でインフラ整備が進む点に期待する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "環境分野で大きな効果が見込まれる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "観光分野でのブランド創出を期待している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "湯野浜温泉街の持続可能性と観光面での効果を期待する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "熱の活用状況を確認したい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "今後の利用拡大について引き続き検討を求める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "燃料確保と森林整備の状況を確認したい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "平成25年に鶴岡市地域エネルギービジョンを策定し、その中ではスモール・スマート・サスティナブル・エネルギーネットワークシティ鶴岡を掲げております"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "実際に昨年度には民間企業による木質バイオマス発電事業が稼働しておりまして"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "大規模事業としては風力発電の計画なども進んでいるところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "小規模水力発電につきましては、地元企業や鶴岡高専の研究者が主体となりまして、地域において導入しようとする取り組みが現在も継続をしております"@ja.
<< kg:id_1 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "市におきましても、地域の活性化などにつながる小規模水力発電の普及と開発促進を図るための補助制度を設けておりまして、これにより昨年度に１カ所、今年度も１カ所に発電設備が設置をされております"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "平成25年度よりまきストーブや太陽光発電設備などを導入する際の補助制度を設けておりまして、毎年多くの御活用をいただいております"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "平成25年度から27年度にかけて、環境省のグリーン・ニューディール基金を活用した災害時の非常用電源を整備しております"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "昨年度までに学校施設など13施設での太陽光発電設備の導入"@ja.
<< kg:id_8 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "沿岸地の避難路やコミセン、公園など、134カ所に太陽光発電によるＬＥＤ外灯を設置しておりまして"@ja.
<< kg:id_1 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "昨年の10月には浄化センターで消化ガス発電事業が稼働したこともございまして"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "この事業は、温泉の未利用熱を活用し、熱交換で温水をつくり、これまで各旅館がそれぞれボイラーを使用してつくっていた温水を一括給湯方式にし、地域全体でＣＯ２削減を目指す"@ja.
<< kg:id_13 prop:cause kg:id_15 >>
    prop:text-txt_contents "湯野浜温泉の地域特性の一つでございます豊富な湯量に着目をいたしまして"@ja.
<< kg:id_13 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "これまで未利用だった温泉の熱を温泉街全体で活用することにより、地域全体での大規模なＣＯ２削減に結びつけようとするものでございます"@ja.
<< kg:id_13 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "このような温泉未利用熱の活用に、温泉街全体が一体となって取り組む事業は全国初の試みでございまして、国におきましても先導的なモデル事業として位置づけているところでございます"@ja.
<< kg:id_13 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "具体的な事業内容といたしましては、温泉からの熱回収によって温水を供給するものと"@ja.
<< kg:id_13 prop:countermeasure kg:id_19 >>
    prop:text-txt_contents "温泉水自体の供給量を増加させるものの２系統の配管を整備いたしまして"@ja.
<< kg:id_13 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "これを温泉街全体で活用する共同インフラ設備の整備を行うこととなっております"@ja.
<< kg:id_13 prop:countermeasure kg:id_21 >>
    prop:text-txt_contents "各ホテル、旅館等におきましても、省エネ設備の導入などによりましてＣＯ２排出削減を図る事業を行うこととしております"@ja.
<< kg:id_13 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "その効果といたしましては、まず環境分野では温泉街全体で約15％のＣＯ２削減ができる予定となっております"@ja.
<< kg:id_13 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "観光分野におきましては、先導的な環境対策を行っている温泉地という地域ブランドの創出を期待いたします"@ja.
<< kg:id_13 prop:effect kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "新たな配管の設置による今後の湯野浜温泉の継続的な発展に向けたインフラ整備といった面も効果の大きい事業と考えております"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:text-txt_contents "その発電量は約3,200戸分の発電供給に相当する1,995ワットで"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "当初発電時の熱を花卉栽培などに利用することも検討されていました"@ja.
<< kg:id_25 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "年間約４万トンの木質チップを予定する事業計画でありました"@ja.
}
