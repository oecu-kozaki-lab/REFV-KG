PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00004> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "（仮称）古平・仁木・余市ウィンドファーム事業"@ja.
kg:id_1 rdf:type cls:c_1.
cls:c_1 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "低周波音などによる人体への影響"@ja.
kg:id_2 rdf:type cls:c_69.
cls:c_69 rdfs:label "健康影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "自然生態系への影響"@ja.
kg:id_3 rdf:type cls:c_51.
cls:c_51 rdfs:label "生態系影響"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "土砂災害"@ja.
kg:id_4 rdf:type cls:c_53.
cls:c_53 rdfs:label "土砂災害"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "水質悪化"@ja.
kg:id_5 rdf:type cls:c_70.
cls:c_70 rdfs:label "水質悪化"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "建設計画地が社会福祉施設に近接すること"@ja.
kg:id_6 rdf:type cls:c_71.
cls:c_71 rdfs:label "施設近接"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "建設に反対する"@ja.
kg:id_7 rdf:type cls:c_72.
cls:c_72 rdfs:label "建設反対"@ja.
kg:id_1 prop:countermeasure kg:id_7.
kg:id_8 rdfs:label "風車反対署名活動を継続する"@ja.
kg:id_8 rdf:type cls:c_73.
cls:c_73 rdfs:label "反対運動"@ja.
kg:id_1 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "総務経済常任委員会に付託し閉会中の継続審査とする"@ja.
kg:id_9 rdf:type cls:c_74.
cls:c_74 rdfs:label "継続審査"@ja.
kg:id_1 prop:countermeasure kg:id_9.
kg:st_1 rdfs:label "仁木町の風力発電を考える会代表 瀬川裕人"@ja.
kg:st_1 rdf:type cls:st_7.
cls:st_7 rdfs:label "住民団体代表"@ja.
kg:op_1 prop:content "建設に反対し人体への影響について議論を尽くすよう求める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "建設に反対し自然生態系への影響について議論を尽くすよう求める"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "建設に反対し土砂災害のおそれについて議論を尽くすよう求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "建設に反対し水質悪化のおそれについて議論を尽くすよう求める"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "建設に反対し社会福祉施設への近接について議論を尽くすよう求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "事業建設への反対を表明する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "町民全体の意志として請願書提出に向け署名活動を続けたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "理由１．低周波音などによる人体への影響。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "理由２．自然生態系への影響。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "理由３．土砂災害・水質悪化の恐れ。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "理由３．土砂災害・水質悪化の恐れ。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "理由４．建設計画地が社会福祉施設に近接すること。"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "「（仮称）古平・仁木・余市ウィンドファーム事業」の建設に反対いたします。"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "これからも、仁木町民全体の意志として、請願書提出に向け、風車反対署名活動を継続していきたいと思います。"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "したがって、陳情第１号『「（仮称）古平・仁木・余市ウィンドファーム事業」に関する陳情』は総務経済常任委員会に付託し、閉会中の継続審査とすることに決定しました。"@ja.
}
