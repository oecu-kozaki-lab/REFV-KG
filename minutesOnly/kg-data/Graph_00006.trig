<https://kozaki-lab.jp/REFV-KG/docs/00006> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "（仮称）古平・仁木・余市ウィンドファーム事業"@ja.
kg:id_1 rdf:type cls:c_1.
cls:c_1 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "低周波音などによる人体への影響"@ja.
kg:id_2 rdf:type cls:c_69.
cls:c_69 rdfs:label "健康影響"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "自然生態系への影響"@ja.
kg:id_3 rdf:type cls:c_25.
cls:c_25 rdfs:label "自然環境影響"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "土砂災害の恐れ"@ja.
kg:id_4 rdf:type cls:c_84.
cls:c_84 rdfs:label "災害危険"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "水質悪化の恐れ"@ja.
kg:id_5 rdf:type cls:c_70.
cls:c_70 rdfs:label "水質悪化"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "建設計画地が社会福祉施設に近接すること"@ja.
kg:id_6 rdf:type cls:c_71.
cls:c_71 rdfs:label "施設近接"@ja.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "風車の建設工事"@ja.
kg:id_7 rdf:type cls:c_85.
cls:c_85 rdfs:label "建設工事"@ja.
kg:id_1 prop:cause kg:id_7.
kg:id_8 rdfs:label "メガ風車による原生林の減少"@ja.
kg:id_8 rdf:type cls:c_86.
cls:c_86 rdfs:label "森林減少"@ja.
kg:id_1 prop:cause kg:id_8.
kg:id_9 rdfs:label "建設計画地が地滑り地帯であること"@ja.
kg:id_9 rdf:type cls:c_87.
cls:c_87 rdfs:label "地盤危険"@ja.
kg:id_1 prop:cause kg:id_9.
kg:id_10 rdfs:label "騒音"@ja.
kg:id_10 rdf:type cls:c_88.
cls:c_88 rdfs:label "騒音"@ja.
kg:id_1 prop:cause kg:id_10.
kg:id_11 rdfs:label "町長から北海道知事に働きかける"@ja.
kg:id_11 rdf:type cls:c_89.
cls:c_89 rdfs:label "行政要請"@ja.
kg:id_1 prop:countermeasure kg:id_11.
kg:id_12 rdfs:label "風車の建設を未然に防ぐ"@ja.
kg:id_12 rdf:type cls:c_90.
cls:c_90 rdfs:label "建設防止"@ja.
kg:id_1 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "事業計画からこの地域を外す"@ja.
kg:id_13 rdf:type cls:c_36.
cls:c_36 rdfs:label "区域除外"@ja.
kg:id_1 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "前もってリスクを避ける"@ja.
kg:id_14 rdf:type cls:c_91.
cls:c_91 rdfs:label "リスク回避"@ja.
kg:id_1 prop:countermeasure kg:id_14.
kg:id_15 rdfs:label "調査結果を聞いて判断する"@ja.
kg:id_15 rdf:type cls:c_92.
cls:c_92 rdfs:label "調査判断"@ja.
kg:id_1 prop:countermeasure kg:id_15.
kg:id_16 rdfs:label "信頼できる情報を基に判断基準を明確にする"@ja.
kg:id_16 rdf:type cls:c_93.
cls:c_93 rdfs:label "判断基準"@ja.
kg:id_1 prop:countermeasure kg:id_16.
kg:st_1 rdfs:label "参考人"@ja.
kg:st_1 rdf:type cls:st_8.
cls:st_8 rdfs:label "参考人"@ja.
kg:op_1 prop:content "健康影響が予想される中で、影響を受けた場合の事業者の対応を懸念する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "委員会で意見を述べた議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_2 prop:content "科学的知見は少ないが、因果関係が未証明でも前もってリスクを避けるべきだ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "寿都や古平の知人の話を紹介した委員会で意見を述べた議員"@ja.
kg:st_3 rdf:type cls:st_9.
kg:op_3 prop:content "現時点では人体への影響はあまり感じないとの声があり、調査結果を聞いて判断したい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "民家や農地に隣接する数少ない原生林を壊さないことを原点にすべきだ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "風車建設工事が始まると土砂崩れの不安の中で生活することになるため反対する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "建設計画地は地滑り地帯で地元住民も強く反対しており、この区域は外すべきだ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "河川が多く地滑り地帯でもあり、山の上に工作物が立つことを懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "知的障がい者や児童養護施設の子どもは特に支援が必要であり、健康影響が懸念される施設近接は重大だ"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "建設工事の開始により土砂崩れへの不安が高まるため反対する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "メガ風車が原生林減少の一因であり、地域の自然を壊すべきではない"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "地質上の問題があるため、この区域は事業計画から外すべきだ"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "騒音による健康影響の事例があり、慎重にリスクを避けるべきだ"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "町議が住民の思いを町長に伝え、町長から北海道知事へ働きかけてほしい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "土砂災害が起こる前に建設を防ぐべきだ"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "調査を進める必要はなく、この地域を計画区域から外してほしい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "科学の限界を理解した上で、予防的に健康リスクを回避すべきだ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "現時点で結論は出さず、今後の調査報告を踏まえて判断したい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "良い悪いの判断はまだしておらず、事業者の調査結果が出てから判断したい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "議会として情報源を統一し、信頼できる情報に基づく明確な判断基準を持つべきだ"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "健康影響が予想される中で、影響を受けた場合、事業者としてどう考えるのでしょう。 騒音による健康影響について、風車近傍での、事例研究では頭痛・めまい・吐き気・睡眠障害等の健康影響が認められているが、健康リスクに関する科学的知見はまだまだ少ないです。 しかし、科学的な因果関係が証明されないから、症状がないということではなく、科学の限界を理解した上で、前もってリスクを避けるべきです。 寿都や古平の知人に聞いても、人体による影響は今のところそんなに感じないと言いますし、そのような周りの声も聞きません。今後、調査等をする上で、報告があるということなので、その結果を聞いて判断したいと思います。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "全国的にメガソーラーやメガ風車によって原生林が18％に減ってしまいましたが、仁木町のように民家や農地に隣接して存在する原生林は全国でも数少ないのです。この自然を壊さないことを原点とすべきではないでしょうか。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "銀山地区、銀山小学校付近は土砂災害の警戒区域となっています。風車の建設工事が始まると、地域住民は土砂崩れの不安の中で生活していくことになるでしょう。 道道を横断している河川は12箇所ほどあり、地滑り地帯、土砂災害という形の中で非常に懸念されています。また、この５年間で、銀山地域の河川は31回も整備しています。工作物が山の上に立つということに対しては懸念材料であると思います。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "提出された陳情に記載の「（仮称）古平・仁木・余市ウィンドファーム事業」に反対する理由である①低周波音などによる人体への影響②自然生態系への影響③土砂災害・水質悪化の恐れ④建設計画地が社会福祉施設に近接すること４項目について考えを述べました。"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "銀山地域には銀山学園と櫻ヶ丘学園があり、大江には大江学園があります。 銀山学園も大江学園も創設時の願いは、知的障がいを持つ皆さんの幸せの実現です。 知的障がい者の方たちは、どこへも行く場所がなく、施設は終の棲家・安住の地となっています。 また、児童養護施設の子どもは、育児放棄、虐待などを受け、銀山に来て、ようやく生きる場ができて、安心・安全・安定を感じながら生きています。 これらの子どもや障がい者施設の方たちは、最大に支援を受けなければ、生きていくことが大変な方たちという位置づけです。健康影響が予想される中で、影響を受けた場合、事業者としてどう考えるのでしょう。"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "風車の建設工事が始まると、地域住民は土砂崩れの不安の中で生活していくことになるでしょう。"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "全国的にメガソーラーやメガ風車によって原生林が18％に減ってしまいました"@ja.
<< kg:id_1 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "建設計画地は地滑り地帯という地質のこともありますし、地元住民がこれだけ反対しているので、やはりこの区域は絶対にダメです。"@ja.
<< kg:id_1 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "騒音による健康影響について、風車近傍での、事例研究では頭痛・めまい・吐き気・睡眠障害等の健康影響が認められている"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "町議の皆さんから住民の思いを町長に伝えていただき、町長から北海道知事に働きかけていただきたいです。"@ja.
<< kg:id_1 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "そういったことが起こる前から未然に防ぐために、風車の建設に反対します。"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "直ちに、調査する必要がないと思いますし、事業計画からこの地域を外してほしいと思います。"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "科学的な因果関係が証明されないから、症状がないということではなく、科学の限界を理解した上で、前もってリスクを避けるべきです。"@ja.
<< kg:id_1 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "今後、調査等をする上で、報告があるということなので、その結果を聞いて判断したいと思います。 私の判断としては、良い悪いの判断をする部分まで、まだ行っていません。事業者の方から調査結果が出てきてから判断したいと思います。"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "だからこそ、議会として信頼できる情報を基に、議員の情報元の統一を図って、判断基準を明確にしなくてはいけないと考えます。"@ja.
}
