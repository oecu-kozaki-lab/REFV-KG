kg:st_1 rdfs:label "沼山雄平君"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "町長の執行方針への記載は一定に評価する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "ひとり暮らし高齢者支援は非常に重要だと考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "マイナスカーボンだけでは町民のライフスタイルへの波及やイノベーション促進まで届いていない"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "大きな事業だからこそしっかり取り組むべきだ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "現状ではそこまで届いていないため行政が生活変容のレールを敷くべきだ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "環境庁の選定もあるため極力早い段階から取り組むべきだ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "支援には一人一人の暮らしぶりの実態把握が必要だ"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "詳しい実態把握が適切な支援につながる"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "現行の連携体制には限界があると考える"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "新たな仕組みづくりが必要だ"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町長石山英雄君"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_11 prop:content "漁業再興策につながるか見極めつつ協力支援したい"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:st_3 rdfs:label "梶谷康介君"@ja.
kg:st_3 rdf:type cls:st_9.
kg:op_12 prop:content "操業規制が松前町の漁業にどう影響するかを考える必要がある"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "漁業者は漁業への影響を懸念している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "コンブ養殖をウニ生産の餌用として活用する面白い方法になり得る"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "ウニの将来を考えるとコンブを基に育てるのが最も良い"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "持続可能な産業の発展が少しは期待できる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "企業誘致の優位性にもつなげながら推進したい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_4 rdfs:label "西川敏郎君"@ja.
kg:st_4 rdf:type cls:st_9.
kg:op_18 prop:content "豊富な電力と水資源を使う産業の企業誘致は工夫次第で可能だと期待する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_4.
kg:op_19 prop:content "今の政策を含め積極的に攻めの町政運営をしたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "町政運営の基本は町民との会話だと再確認した"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "今までどおりの事業継続にも障壁があり危機管理への配慮が必要だ"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "素晴らしい取り組みであり小中学校にも広げるべきだ"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "接種しない子どもへの同調圧力やいじめを心配している"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "企業の意見も得ながら計画を進めたい"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "昨年、松前沖が洋上風力発電に係る「国の促進区域の指定」に向けた「一定の準備段階に進んでいる区域」に整理され、残される課題の送電に係る系統確保が必要であります"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "送電線については、北海道・本州間連携設備の増強や海底ケーブル方式など、国策によるところが大きいため"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:text-txt_contents "同区域に整理される各自治体と一体となって、国などに対して早期解決を強く要望してまいります"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "再生可能エネルギーを活用したまちづくりについては、将来展望を見いだすために、「企業連携によるまちづくりビジョン」等を策定し"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:text-txt_contents "国の脱炭素社会の実現や国際的なＳＤＧｓ等への貢献を目指しながら"@ja.
<< kg:id_6 prop:effect kg:id_9 >>
    prop:text-txt_contents "産業の持続的発展を模索してまいります"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "社会は間違いなく脱炭素の方に向かっていることは確実と言えます。その意味では、今回町長の町政執行方針に掲げたっていうことは、一定の評価をしております"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "この文言の中に１人暮らしの高齢者等の割合も高くなってきており、町全体で高齢者の支援をしていく必要があり云々とあります。ひとり暮らしの高齢者支援は非常に重要なものと思っております"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "既に、松前町におきましては、ご承知のように大型の風力発電所が稼働してることから"@ja.
<< kg:id_14 prop:effect kg:id_16 >>
    prop:text-txt_contents "再生エネルギー電力の出力と言いますか、出力が二酸化炭素の発生量と比較すると、はるかに大きくて、マイナスカーボンっていうふうになってるのが実態"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "しかしながら、目に見えるような取り組みとしてはほとんどできておらず"@ja.
<< kg:id_17 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "これからきちんとした計画を策定しながら、実践を強化してまいりたい"@ja.
<< kg:id_17 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "具体的には公共施設への再エネ化"@ja.
<< kg:id_17 prop:countermeasure kg:id_21 >>
    prop:text-txt_contents "公用車のＥＶ導入等"@ja.
<< kg:id_17 prop:countermeasure kg:id_22 >>
    prop:text-txt_contents "将来地域電力組織を立ち上げて、町内への供給する電力の１００％再エネ化"@ja.
<< kg:id_17 prop:effect kg:id_23 >>
    prop:text-txt_contents "安値で安定的な電力供給ができるよう"@ja.
<< kg:id_17 prop:countermeasure kg:id_24 >>
    prop:text-txt_contents "その方向を目指してデーターセンターの誘致なども含めまして、いろんな働きかけをしていきたい"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:text-txt_contents "総合計画も、現在動いている総合計画につきましても、脱炭素の部分っていうのはあまり触れてない状況"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:text-txt_contents "後期の５ヶ年の見直しの中できちんとした位置付けを示してまいりたい"@ja.
<< kg:id_28 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "それだけでは大きな事業のイノベーションの促進や、それから町民のライフスタイルに波及するというところまでは届いていません。そういった意味では、町民の中に、自然環境に配慮した生活が求められるということのレールを敷く役目が行政だと思います"@ja.
<< kg:id_28 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "この文言によりますロードマップの作成を早い時期にとあります。これは半年先なんか、１年先なのか。政府の方の環境庁の選定は年に２回ほどあるそうです。その意味では、極力早い段階から取り組まれてはどうかな"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "支援と言ってもですね、その実態を把握する必要あるんですね。実態を把握しないで適切な支援サポートできるかと言ったら、なかなかできるものでありません"@ja.
<< kg:id_31 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "例えば、ひとり暮らしの人が買い物に困っていないか、あるいは話し相手に困っていないか、寂しい思いしていないか、あるいは３食の食事きちっととっているか、掃除はできているか、それと外に出れているか、外の空気吸っているのかとか、あるいは、孤独を感じていないかと。このような詳しい実態を把握することは、適切な支援に繋がる"@ja.
<< kg:id_34 prop:cause kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "今ある仕組みで大丈夫なのか、あるいは地域包括センターや町内会、あるいは民生委員等で連携をとる中で限界はないか。もし、限界であるならば、どういう仕組みがあるのか。私は限界があると思っています"@ja.
<< kg:id_34 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "そういった意味では、新たな仕組みづくり、地域の強力な関係の下で気づいていくべきだと思っております"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:text-txt_contents "さくら漁協では洋上風力発電と漁業協調による沿岸漁業の振興手法について、弘前大学と共同研究を立ち上げ、調査研究を進めて行くことになっております"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "町と致しましても、この共同研究には協力をしてまいりたい"@ja.
<< kg:id_39 prop:countermeasure kg:id_41 >>
    prop:text-txt_contents "具体的には、共同調査研究と致しまして、沿岸漁業の底上げや、漁港の中でどのように生産性を上げていくかなどについて共同研究する"@ja.
<< kg:id_37 prop:effect kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "結局風力発電やるとね、その周辺に操業規制がかかるわけさ"@ja.
<< kg:id_37 prop:effect kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "何基もやった場合に、その操業規制によって、松前町の漁業にどう影響が来るのかということ、漁業者が考えてるんだよね"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "コンブ養殖とウニの深浅移殖のコラボできませんか、コラボレーション。これは、あくまでもコンブを育てて水揚げを増やすという目的じゃなくって、ウニの生産、今の深浅移殖したウニの実入りが、いわゆる歩留まり良くするために、これはそのための餌用のね、コンブもやってみる、面白い方法の一つでないかな"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "村長実際このウニのね、最高の餌ってのは何ですかって。決してキャベツって言いませんよ、やっぱりコンブでしょう"@ja.
<< kg:id_48 prop:effect kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "風力発電や太陽光発電を利用した再エネ事業の活用による電気、水素関連事業のサプライチェーンに町内事業者も加わることができればですね、業務の維持や新しい事業へのシフトなど、持続可能な産業の発展も少しは期待できていく"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "再エネ１００％の町、松前町が再エネ１００％の町になるように、その方向に向かって"@ja.
<< kg:id_52 prop:effect kg:id_53 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "企業誘致に向けたアドバンテージともなりながら"@ja.
<< kg:id_52 prop:effect kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "再エネ、脱炭素の事業の推進によって、大きくは漁業、商業、建設業等の維持及び活性化にも、持続性の確保にも期待できる"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "町民の声を丁寧に聞くことが最も大事でありまして、町民との対話を忘れずに、地道に一歩ずつ前進できるようにっていうふうなことを再度確認したところであります。町政運営の基本は、町民の皆さんとの会話"@ja.
<< kg:id_57 prop:cause kg:id_58 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "このコロナの関係、あるいは今年みたいな大雪、気候変動の関係、それとまた今回ウクライナに見られるような、地学的リスクと言いますか。今までどおりの事業を継続していくためにもかなりな障壁がある"@ja.
<< kg:id_59 prop:effect kg:id_60 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "この学校と地域が一体となって課題、町の課題を共有していくということが書いてありますけども、本当にこれは素晴らしい取り組みだなあというふうに思います"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "心配されるのは、それに対する同調圧力って言いますか、そういうのでいじめが発生しないかということが、大変心配されてるところ"@ja.
<< kg:id_63 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "企業、東急不動産の職員の方にも、うちの管理職と一緒に検討委員会のような組織を立ち上げて、管理職グループ、それから係長グループというふうな形で組織をつくりまして、企業と連携して意見をいただきながら、松前版ＳＤＧｓに計画を進めて行きたい"@ja.
<< kg:id_65 prop:effect kg:id_66 >>
    prop:text-txt_contents "自治体ＤＸ等に対応した経費も交付税の方でも算定されるような状況になってきております"@ja.
<< kg:id_67 prop:countermeasure kg:id_68 >>
    prop:text-txt_contents "調査事項は企業誘致についてということで、長崎県五島市を４日間以内の予定で視察調査をするものであります"@ja.
<< kg:id_69 prop:effect kg:id_70 >>
    prop:text-txt_contents "長崎県五島市では、風力発電を活用したまちづくりと、企業誘致として洋上風力発電施設を起点とした雇用の創出や産業の誘致"@ja.
<< kg:id_69 prop:effect kg:id_71 >>
    prop:text-txt_contents "発電施設を活かした観光振興や漁業との共存や共栄など、地元への還元などについての取り組み"@ja.
}
