<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "大漁くんバスの運行"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "風力発電の推進"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "白神、松前、館浜、松城小学校の統合"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "高校生まで医療費の無料化"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:text-txt_contents "学校給食の無償化"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
