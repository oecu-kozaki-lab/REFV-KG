<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "新型コロナウイルス感染症との長期の闘い"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "折れそうで苦しい時もありました"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "国道２２８号白神防災も事業化されました。町民の安心安全、命を守る道路でございます。"@ja.
<< kg:id_28 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "町民の安心安全、命を守る道路でございます"@ja.
<< kg:id_28 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "調査も進んでおり、早期の着工、早期の完成を目指す環境が整いました"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "洋上風力発電においても、松前沖が有望な区域に指定され、促進区域昇格が目前になっております"@ja.
<< kg:id_32 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "促進区域昇格が目前になっております"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "再生可能エネルギーの取り組みは、地域経済の活性化のカンフル剤となると思っております"@ja.
<< kg:id_37 prop:effect kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "ＲＥまつまえ１００実現に、期待は膨らんでいます"@ja.
