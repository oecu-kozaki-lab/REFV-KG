kg:st_1 rdfs:label "松前町長 若佐智弘"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "2050年カーボンニュートラルを目指し推進する考え"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "総合計画に明記して総合的に進めるべきと考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "町内で廉価な再生可能エネルギー電力の供給実現に向け取り組む"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "促進区域指定や事業者選定、工事着手の早期化に配慮する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "採算に見合わず導入困難と判断"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "交付金依存ではない方策を検討する中で断念した"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "現時点では風力と太陽光中心で進める"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "小水力は補完的役割にとどまり影響は限定的との認識"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "海の環境悪化が水産資源に影響していると認識"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "生育環境への悪影響が広がっているとみている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "日本製鉄と連携して前向きに取り組む"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "ブルーカーボン効果の検証を進める考え"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "水産業の収益拡大も見据えて効果を検証する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "環境保護だけでなく地域活性化も含めて進めることが重要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "人口減少で働き手不足が進むことを重くみている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "人口減少は地域経済の縮小に直結するとの認識"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "地域内経済の循環悪化を懸念している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "産業維持と活性化で人口減少の緩和に寄与させたい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:st_2 rdfs:label "脱炭素推進課長 佐々木弘幸"@ja.
kg:st_2 rdf:type cls:st_19.
cls:st_19 rdfs:label "自治体職員"@ja.
kg:op_19 prop:content "環境リスクを考慮した対応が必要と説明"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:st_3 rdfs:label "環境大臣"@ja.
kg:st_3 rdf:type cls:st_20.
cls:st_20 rdfs:label "国"@ja.
kg:op_20 prop:content "オジロワシへの影響を踏まえ設置取りやめを求めた"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "オジロワシへの影響低減のため配置変更を求めた"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:st_4 rdfs:label "東急不動産株式会社"@ja.
kg:st_4 rdf:type cls:st_21.
cls:st_21 rdfs:label "事業者"@ja.
kg:op_22 prop:content "館浜地区に設置を変更して適切に対処すると報告"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "法に基づき説明会を再実施すると確認した"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "9月10日から11日に町内会館等で説明会を行う"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "魅力ある商品を生かし財源確保を進めたい"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "洋上風力事業者に工事着工前の地域向け出損金を求めている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_1.
kg:op_27 prop:content "来訪者の消費を地域内に取り込むことが重要"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "港の活用は地域経済への効果が大きい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "地元燃料店の利益向上につながる活用を期待"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "松前町は、地球温暖化の対策として、２０５０年のカーボン・ニュートラルを目指す「ゼロカーボンシティ宣言」を掲げ"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "総合計画には「再生可能エネルギーを活用した脱炭素のまちづくり推進」を明記し"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "再エネ電気の地産地消を目指す「ＲＥ１００まつまえ構想」"@ja.
<< kg:id_1 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "松前沖洋上風力発電の推進を大きな柱として脱炭素化社会の実現に向け、取り組みを進めております"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "結果、発電規模に比して建設費が高額となり"@ja.
<< kg:id_6 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "採算ベースに見合わないことが判明したところです"@ja.
<< kg:id_4 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "これにより、現時点での「ＲＥ１００まつまえ構想」の電源構成は、風力及び太陽光を主体として取り組むところとし"@ja.
<< kg:id_6 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "小水力発電は、電源の補完的役割を期待していたところではありますが、発電規模が小さかったため、その影響は少ないものと考えております"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "磯焼けが進行している松前町の海では、魚介類の産卵場所の減少"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "生育環境にも影響が広がっています"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "日本製鉄株式会社と共に、町内の海岸を利用した、藻場の再生と拡大の実証実験"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "コンブ養殖施設の活用による二酸化炭素吸収量の評価試験を計画しております"@ja.
<< kg:id_14 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "将来的にはブルーカーボンクレジットの取得も含め、磯焼け対策や水産業の収益拡大など、効果を検証しながら前向きに取り組んでまいります"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "地球温暖化対策としての脱炭素化の取り組みは、環境保護だけでなく、地域の活性化などの側面も含めて、総合的に進めることが重要であると考えております"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "やはり人口減少の一番大きいところは、そこで働き手がいなくなり"@ja.
<< kg:id_20 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "人口減少は即ちそこの経済活動が縮小すると"@ja.
<< kg:id_20 prop:effect kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "そして経済活動が、地域の循環が悪くなるというようなものでございます"@ja.
<< kg:id_20 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "洋上風力発電の振興策を町の施策と連携させて産業の維持と活性化を図ることで人口減少の緩和に寄与するとともに"@ja.
<< kg:id_25 prop:effect kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "オジロワシへの環境リスクを考慮致しまして"@ja.
<< kg:id_25 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "原口地区に設置を予定していた１号基について、オジロワシへの環境リスクを考慮致しまして、設置のとりやめ"@ja.
<< kg:id_25 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "配置の変更が求められた件につきましては、館浜地区に設置を変更して計画を見直したと、適切に対処するとの報告を受けております"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "風車の位置が変更になったことから、再生可能エネルギー、電気の利用の促進に関する特別措置法に基づく説明会を、再度行うことを確認しております"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "地域住民に対しまして、９月１０日から９月１１日の間において、それぞれの町内会館等で説明会を行う"@ja.
<< kg:id_32 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "ふるさと納税は、本当にその金額が増えると、私どもの思ったものに使えるいい財源となり得ますので、積極的な取り組みを今後も続けていきたい"@ja.
<< kg:id_32 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "できればその段階で、工事着工する前に地域に対する出損金も考えていただきたいという意見も、私どもは出しております"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "こちらに仕事で来た方々については、空家を活用しての、やはり地元にお金を落としてもらうということが、やはり一番大事なものだと思っております"@ja.
<< kg:id_35 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "洋上風力に関しましても、維持、管理、そして定期的な点検、これらが松前町内の松前港等を使ってできるものであれば、やはり地域の経済に資するものは大きいものがあると思います"@ja.
<< kg:id_35 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "油も地元で入れてくれることによって、やはり地域の燃料店は大きく営業利益上げて行っていただけると思いますし"@ja.
}
