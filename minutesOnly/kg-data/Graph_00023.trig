kg:id_28 rdf:type cls:c_754.
cls:c_754 rdfs:label "発電推進"@ja.
kg:id_29 rdfs:label "日本のエネルギー自給率の低さと化石燃料依存度の高さと再生可能エネルギー普及の遅れ"@ja.
kg:id_29 rdf:type cls:c_755.
cls:c_755 rdfs:label "エネルギー問題"@ja.
kg:id_28 prop:cause kg:id_29.
