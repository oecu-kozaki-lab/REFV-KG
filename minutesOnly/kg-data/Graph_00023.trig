kg:id_17 rdf:type cls:c_747.
cls:c_747 rdfs:label "再エネ活用"@ja.
kg:id_9 prop:countermeasure kg:id_17.
kg:id_18 rdfs:label "生態系・生物多様性や地質などの環境に配慮し場所や規模を設定する"@ja.
kg:id_18 rdf:type cls:c_748.
cls:c_748 rdfs:label "環境配慮"@ja.
kg:id_9 prop:countermeasure kg:id_18.
kg:id_19 rdfs:label "事業者が住民に調査・予測・評価を説明し理解を得る"@ja.
kg:id_19 rdf:type cls:c_54.
cls:c_54 rdfs:label "住民説明"@ja.
kg:id_9 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "事業計画及び対応が著しく妥当性を欠くこと"@ja.
kg:id_20 rdf:type cls:c_749.
cls:c_749 rdfs:label "計画不当"@ja.
kg:id_9 prop:cause kg:id_20.
kg:id_21 rdfs:label "大規模な土地改変による水環境・水生生物・生態系への影響懸念"@ja.
kg:id_21 rdf:type cls:c_190.
cls:c_190 rdfs:label "環境影響"@ja.
kg:id_9 prop:effect kg:id_21.
kg:id_22 rdfs:label "谷筋の大規模盛土や地滑り地形による土砂災害の懸念"@ja.
kg:id_22 rdf:type cls:c_750.
cls:c_750 rdfs:label "災害懸念"@ja.
kg:id_9 prop:effect kg:id_22.
kg:id_23 rdfs:label "本事業の取りやめも含めた抜本的な事業計画の見直し"@ja.
kg:id_23 rdf:type cls:c_271.
cls:c_271 rdfs:label "計画見直し"@ja.
kg:id_9 prop:countermeasure kg:id_23.
kg:id_24 rdfs:label "地域住民等への丁寧かつ十分な説明と修正内容の公表"@ja.
kg:id_24 rdf:type cls:c_54.
kg:id_9 prop:countermeasure kg:id_24.
kg:id_25 rdfs:label "土地の改変を最小限に抑制する"@ja.
kg:id_25 rdf:type cls:c_751.
cls:c_751 rdfs:label "土地改変抑制"@ja.
kg:id_9 prop:countermeasure kg:id_25.
kg:id_26 rdfs:label "土砂の崩落や流出による水環境・動植物への影響を回避または低減する"@ja.
kg:id_26 rdf:type cls:c_752.
cls:c_752 rdfs:label "環境影響低減"@ja.
kg:id_9 prop:countermeasure kg:id_26.
kg:id_27 rdfs:label "イヌワシなど重要鳥類への影響を回避または低減する措置を講ずる"@ja.
kg:id_27 rdf:type cls:c_753.
cls:c_753 rdfs:label "生態影響低減"@ja.
kg:id_9 prop:countermeasure kg:id_27.
