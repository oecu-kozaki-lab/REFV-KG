cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "再生可能エネルギーの導入を進める必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地球温暖化で災害等もその影響でふえている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "地球温暖化で災害等もその影響でふえている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地球温暖化で災害等もその影響でふえている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "国連報告書"@ja.
kg:st_2 rdf:type cls:st_34.
cls:st_34 rdfs:label "報告書"@ja.
kg:op_5 prop:content "世界の平均気温の上昇を２℃未満に抑えるには削減が必要と指摘する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "各国に対して環境政策の大きな強化が求められる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "積極的な自然エネルギーの活用が求められる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:st_3 rdfs:label "阿部勉企画部長"@ja.
kg:st_3 rdf:type cls:st_28.
cls:st_28 rdfs:label "部長"@ja.
kg:op_8 prop:content "安全安心で維持可能なエネルギーミックスを推進する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "水素を活用する社会環境の整備及びサプライチェーンの構築につながる取り組みを支援したい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "導入への理解を得ることが重要である"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "次世代のエネルギーとして期待している"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "商業化されれば大きく貢献する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "実証実験等の進展を注視し情報収集に努める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "遊佐町沿岸海域にとどまらず酒田・鶴岡沖の県内全ての海域へと広めるべきである"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "関連企業集積と新たな雇用が期待される"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "港湾整備や背後地、道路整備もあわせて進めるべきである"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "関連するインフラの整備について国・県に要望する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "直接的な影響を受ける漁業者の理解を最重要として県と連携する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "漁業従事者に配慮した形で進めていただきたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "発電事業者と漁業関係者が良好な関係で整備と運転を進めることが重要である"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "漁業への影響や配慮のため継続したモニタリングが必要である"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "漁業に活用してもらう取り組みが議論されている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "関連するインフラ整備についてしっかりと国・県に要望する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "地球温暖化は、産業革命以降の急速な化石燃料の消費による二酸化炭素やメタンなどの温室効果ガスの大量排出が原因とされており"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "昨年の記録的な猛暑"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "西日本豪雨"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "ことしは、台風19号やその後の東日本各地を襲った豪雨による異常気象は地球温暖化による大きな災害となっており"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:text-txt_contents "世界規模での異常気象から気候変動の加速が懸念されています"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "国連報告書によると、世界の平均気温の上昇を産業革命前に比べ２℃未満に抑えるには、2030年の時点で温室効果ガスを150億ｔ減らす必要があると指摘しています"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "各国に対して環境政策の大きな強化が求められるものと思われます"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "日本で火力発電の割合が高いのは、福島第一原発の事故の後原発の稼動がゼロとなり、火力発電で補う必要があったことが影響しています"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "太陽光発電や風力発電等の再生可能エネルギーの導入拡大をさらに進めることが重要であり、積極的な自然エネルギーの活用が求められるものと思われます"@ja.
<< kg:id_16 prop:effect kg:id_17 >>
    prop:text-txt_contents "再生可能エネルギーによる発電施設は、持続可能な低炭素社会の実現に向け、地球温暖化の原因となる二酸化炭素をほとんど排出しないすぐれたエネルギー施設として注目をされています"@ja.
<< kg:id_18 prop:effect kg:id_19 >>
    prop:text-txt_contents "酒田港メガソーラーパークは、年間発電量3,027万kW、一般家庭の約8,400世帯分に相当し、年間１万6,497ｔの二酸化炭素排出削減効果があるとされ"@ja.
<< kg:id_20 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "安全性、環境への負荷、コスト、施設運用など、電気の安定供給を図るため多様なエネルギー源を組み合わせて電源構成を最適化するエネルギーミックス"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:text-txt_contents "2050年までに温室効果ガスを80％削減するという高い目標を設定しています"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "水素エネルギーに関するセミナーの開催や先進地の視察などを通じまして、水素を活用する社会環境の整備及びサプライチェーンの構築につながる取り組みを支援していきたいと考えております"@ja.
<< kg:id_24 prop:cause kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "供給インフラの整備や需要の拡大等に時間を要しており、一般の理解が進んでいないのが現状と考えられます"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:text-txt_contents "水素は、使用時にＣＯ２を排出しないクリーンなエネルギーである"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:text-txt_contents "燃料電池と組み合わせると高いエネルギー効率を実現することができます"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:text-txt_contents "小さな体積からたくさんのエネルギーを生み出すことが可能です"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "燃焼した場合の排出するＣＯ２は、石炭や石油を燃やすよりも約30％ほど少ないことも特徴の一つであり、次世代のエネルギーとして期待されています"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "技術開発が進み商業化されれば、世界情勢に左右されることのない、日本のエネルギー面での安全保障やＣＯ２の排出削減にも大きく貢献するものと思われます"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "本市としましては、実証実験等進展を注視するなど、今後も連合の取り組みを通じ、情報収集に努めてまいります"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "促進区域の指定に向けた積極的な取り組みを行うとともに、遊佐町沿岸海域にとどまらず、酒田・鶴岡沖の県内全ての海域へと広め、再生可能エネルギーの拡大を図るべき"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "洋上風力発電事業が進むことで、関連します企業集積も図られ、新たな雇用も生まれることが期待されます"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "洋上風力発電には、部材の荷揚げ、組み立て及びメンテナンスが可能な拠点となる港が必要となります"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "今後とも、酒田沖の一般海域における洋上風力発電の促進区域指定に向けましては、直接的な影響を受けます漁業者の理解を何よりも重要と位置づけまして、県とより一層の連携を図ってまいりたい"@ja.
<< kg:id_40 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "まずは漁業権を守るんだということ、それから、漁業への不測の制約、損害が発生した際の対応をどうするのかといった取りまとめ"@ja.
<< kg:id_40 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "現行の漁業への影響及び配慮をということで、風車が建ったことで変化があるのかどうかといった、継続したモニタリングを進める"@ja.
<< kg:id_40 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "漁業に活用していただくということで、足元を漁礁として使っていただく取り組み、また、基本的には30年間の占有になるわけですが、30年以降も漁礁として守っていく"@ja.
<< kg:id_40 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "新たに港湾の整備が進むですとか、かなりの電気を送電するための送電網が整備をされるですとか、また、重機を運ぶための道路なども必要と思ってございますので、洋上風力発電事業にあわせまして、関連するインフラの整備についてもしっかりと国・県に対して要望をしてまいりたい"@ja.
}
