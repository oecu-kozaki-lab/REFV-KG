kg:st_1 rdfs:label "進藤晃議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "再生可能エネルギーの導入を進める必要がある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "国連報告書"@ja.
kg:st_2 rdf:type cls:st_34.
cls:st_34 rdfs:label "報告書"@ja.
kg:op_2 prop:content "平均気温上昇を2℃未満に抑えるには削減が必要と指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "各国に環境政策の大きな強化が求められる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "積極的な自然エネルギーの活用が求められる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "エネルギーミックスの構築による集積地になりつつある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_3 rdfs:label "阿部勉企画部長"@ja.
kg:st_3 rdf:type cls:st_28.
cls:st_28 rdfs:label "部長"@ja.
kg:op_6 prop:content "自然エネルギーを活用しエネルギーミックスを推進する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "供給インフラ整備と需要拡大に時間がかかっている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "一般の理解が進んでいないのが現状である"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "企業の水素利用理解を深めるためセミナー開催を支援したい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "先進地視察を通じて社会環境整備とサプライチェーン構築につなげたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "水素活用の社会環境整備とサプライチェーン構築を支援する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "国や県への要望を継続する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "商業化されればエネルギー安全保障に大きく貢献する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "商業化されればCO2排出削減にも大きく貢献する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "実用化の見通しが立たず地方への研究機関誘致は難しい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "実証実験の進展を注視し情報収集に努める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "関連産業への波及効果が期待される"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "地元産業によい影響を与える可能性がある"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "庄内沿岸域は洋上風力の適地である"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "関連企業集積が期待される"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "新たな雇用が生まれることが期待される"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "遊佐町沿岸にとどまらず県内全ての海域へ広めるべき"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "漁業者の理解を最重要として県と連携する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "漁業権を守ることが想定される取り組みである"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "漁業への制約や損害発生時の対応整理が必要である"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "風車設置後の変化を継続的に確認すべきである"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "漁業に活用してもらうため足元を漁礁として使う案がある"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "占用期間後も漁礁として守る案が議論されている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "港湾、送電網、道路などの整備を国県に要望する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "地球温暖化は、産業革命以降の急速な化石燃料の消費による二酸化炭素やメタンなどの温室効果ガスの大量排出が原因とされており"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "昨年の記録的な猛暑"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "西日本豪雨"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "台風19号"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:text-txt_contents "その後の東日本各地を襲った豪雨による異常気象は地球温暖化による大きな災害となっており"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "世界規模での異常気象から気候変動の加速が懸念されています"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:text-txt_contents "パリ協定において先進国のほか途上国も加わり、産業革命以後の地球の気温上昇を1.5℃に抑えることを目指すとしています"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "世界の平均気温の上昇を産業革命前に比べ２℃未満に抑えるには、2030年の時点で温室効果ガスを150億ｔ減らす必要があると指摘しています"@ja.
<< kg:id_9 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "各国に対して環境政策の大きな強化が求められるものと思われます"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:text-txt_contents "日本で火力発電の割合が高いのは、福島第一原発の事故の後原発の稼動がゼロとなり、火力発電で補う必要があったことが影響しています"@ja.
<< kg:id_12 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "太陽光発電や風力発電等の再生可能エネルギーの導入拡大をさらに進めることが重要であり、積極的な自然エネルギーの活用が求められるものと思われます"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:text-txt_contents "再生可能エネルギーによる発電施設は、持続可能な低炭素社会の実現に向け、地球温暖化の原因となる二酸化炭素をほとんど排出しないすぐれたエネルギー施設として注目をされています"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:text-txt_contents "年間１万6,497ｔの二酸化炭素排出削減効果があるとされ"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "酒田港周辺における発電施設は、安全性、環境への負荷、コスト、施設運用など、電気の安定供給を図るため多様なエネルギー源を組み合わせて電源構成を最適化するエネルギーミックスの構築による新エネルギー産業の集積地となりつつあります"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "本市においては、豊富な自然エネルギーや再生可能エネルギーがあることから、これらを活用し、安全安心で維持可能なエネルギーミックスを推進してまいります"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:text-txt_contents "水素は、使用時にＣＯ２を排出しないクリーンなエネルギーである"@ja.
<< kg:id_23 prop:effect kg:id_25 >>
    prop:text-txt_contents "燃料電池と組み合わせると高いエネルギー効率を実現することができます"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "供給インフラの整備や需要の拡大等に時間を要しており"@ja.
<< kg:id_26 prop:cause kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "一般の理解が進んでいないのが現状と考えられます"@ja.
<< kg:id_21 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "水素エネルギーに関するセミナーの開催"@ja.
<< kg:id_21 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "先進地の視察などを通じまして"@ja.
<< kg:id_21 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "水素を活用する社会環境の整備及びサプライチェーンの構築につながる取り組みを支援していきたい"@ja.
<< kg:id_21 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "水素技術の開発研究及び先進的モデルの確立に向けた実証実験の促進について、国や県に対しまして要望を継続してまいります"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:text-txt_contents "小さな体積からたくさんのエネルギーを生み出すことが可能です"@ja.
<< kg:id_33 prop:effect kg:id_35 >>
    prop:text-txt_contents "燃焼した場合の排出するＣＯ２は、石炭や石油を燃やすよりも約30％ほど少ない"@ja.
<< kg:id_33 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "商業化されれば、世界情勢に左右されることのない、日本のエネルギー面での安全保障やＣＯ２の排出削減にも大きく貢献するものと思われます"@ja.
<< kg:id_33 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "商業化されれば、世界情勢に左右されることのない、日本のエネルギー面での安全保障やＣＯ２の排出削減にも大きく貢献するものと思われます"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "実用化の見通しはいまだ立っておらず、地方への研究機関の誘致は難しいと考えているところでございます"@ja.
<< kg:id_21 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "本市としましては、実証実験等進展を注視するなど、今後も連合の取り組みを通じ、情報収集に努めてまいります"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:text-txt_contents "これまで、海域の占用に関する統一的なルールがないこと"@ja.
<< kg:id_41 prop:cause kg:id_43 >>
    prop:text-txt_contents "先行利用者との調整の枠組みが存在しないことへの課題解決に向けて成立した法律"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "関連産業への波及効果や地元産業によい影響を与える可能性もあり"@ja.
<< kg:id_44 prop:effect kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "地元産業によい影響を与える可能性もあり"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "庄内沿岸海域の風速が年平均で７ｍ以上となっており、洋上風力発電の事業化の目安とされる風速を超えていることから、庄内の沿岸域は、洋上風力の適地とされております"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "洋上風力発電事業が進むことで、関連します企業集積も図られ"@ja.
<< kg:id_49 prop:effect kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "新たな雇用も生まれることが期待されます"@ja.
<< kg:id_44 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "促進区域の指定に向けた積極的な取り組みを行うとともに、遊佐町沿岸海域にとどまらず、酒田・鶴岡沖の県内全ての海域へと広め、再生可能エネルギーの拡大を図るべき"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "酒田沖の一般海域における洋上風力発電の促進区域指定に向けましては、直接的な影響を受けます漁業者の理解を何よりも重要と位置づけまして、県とより一層の連携を図ってまいりたい"@ja.
<< kg:id_49 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "まずは漁業権を守るんだということ"@ja.
<< kg:id_49 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "漁業への不測の制約、損害が発生した際の対応をどうするのかといった取りまとめ"@ja.
<< kg:id_49 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "風車が建ったことで変化があるのかどうかといった、継続したモニタリングを進める"@ja.
<< kg:id_49 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "足元を漁礁として使っていただく取り組み"@ja.
<< kg:id_49 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "30年以降も漁礁として守っていくというような、そういった案が遊佐部会の中で議論されています"@ja.
<< kg:id_49 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "洋上風力発電事業にあわせまして、関連するインフラの整備についてもしっかりと国・県に対して要望をしてまいりたい"@ja.
}
