kg:id_25 rdf:type cls:c_913.
cls:c_913 rdfs:label "管理差"@ja.
kg:id_24 prop:cause kg:id_25.
kg:id_26 rdfs:label "公園施設の劣化や事故"@ja.
kg:id_26 rdf:type cls:c_914.
cls:c_914 rdfs:label "施設劣化"@ja.
kg:id_27 rdfs:label "健全度調査と毎月点検と専門業者による年1回点検"@ja.
kg:id_27 rdf:type cls:c_915.
