kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "温暖化で永久凍土の融解が進んでいると懸念する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "永久凍土の融解で天然ガスが放出され温暖化が加速すると危惧する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "氷の下にあった未知のウイルスの脅威を懸念する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "気候変動対策の中で世界がエネルギー転換期を迎えているとみる"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "菅総理"@ja.
kg:st_2 rdf:type cls:st_42.
cls:st_42 rdfs:label "政府"@ja.
kg:op_5 prop:content "2050年までに温室効果ガス排出ゼロを宣言した"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "経団連"@ja.
kg:st_3 rdf:type cls:st_13.
cls:st_13 rdfs:label "経済団体"@ja.
kg:op_6 prop:content "2050年カーボンニュートラルの実現を支持した"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:st_4 rdfs:label "政府"@ja.
kg:st_4 rdf:type cls:st_42.
kg:op_7 prop:content "石炭火力の比率を下げ再生可能エネルギー普及へ方針転換した"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:op_8 prop:content "火力発電所は電力不足を支えてきた重要施設だと評価する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_5 rdfs:label "丸山市長"@ja.
kg:st_5 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_9 prop:content "非効率石炭火力のフェードアウトの具体的ロードマップが示されるとみている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_5.
kg:op_10 prop:content "エネルギー転換では雇用への影響に配慮が必要だと認識する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "エネルギー問題は地域経済に大きく関わるとみている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_5.
kg:op_12 prop:content "エネルギー問題は環境とも密接に関係すると認識する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_5.
kg:op_13 prop:content "エネルギー問題は安定した気候にも関わるとみている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:op_14 prop:content "エネルギー問題は安全保障にも影響すると認識する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "新組織を設けてエネルギー問題への対応を強化する考えを示した"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_5.
kg:op_16 prop:content "合意形成のため住民や漁業関係者への丁寧な説明が進められていると述べた"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "海岸浸食など既存の環境課題を抱えた中で取組が進んでいると指摘した"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "土砂堆積など既存の環境課題を抱えた中で取組が進んでいると指摘した"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "景観への不安や心配に配慮して検討すべきと認識する"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_5.
kg:op_20 prop:content "環境への影響を丁寧に評価すべきと考えている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:op_21 prop:content "景観不安への対応として合成写真の公表予定を示した"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:st_6 rdfs:label "山形県知事"@ja.
kg:st_6 rdf:type cls:st_43.
cls:st_43 rdfs:label "都道府県"@ja.
kg:op_22 prop:content "伏流水への影響について調査と評価を求めている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:op_23 prop:content "事業開始前から終了後まで継続的なモニタリングが必要だと示した"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_5.
kg:op_24 prop:content "合意形成には事業者の丁寧な環境影響評価と負荷低減が重要と考える"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "実現すれば雇用や港湾振興、地域経済に好循環が生まれると期待する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "港湾整備や施工、運転保守による直接的な経済効果を期待している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "関連産業の立地などによる一次的な波及効果を期待している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "所得増や消費喚起による二次的な経済波及効果を見込んでいる"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "一定の財政的メリットが生まれると見込んでいる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "景観や環境に配慮し海域利用者を含む合意形成が重要と考える"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "買取価格の低下で再エネ賦課金による国民負担が軽減されるとみている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:op_32 prop:content "売電単価の低下で事業者の参入意欲が下がる懸念を示した"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "単価低下で地域振興に回る資金が不足する懸念を持つ"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:op_34 prop:content "基地港湾指定は地域に大きな波及効果をもたらすと期待する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_5.
kg:op_35 prop:content "基地港湾指定は雇用や地元業界への経済効果があるとみている"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_5.
kg:op_36 prop:content "基地港湾指定には県による港湾計画変更が必要と指摘した"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_5.
kg:op_37 prop:content "基地港湾指定に向け県の国への手挙げが必要と考えている"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_5.
kg:op_38 prop:content "市は関係者調整と地域の総意形成を先導する役割を担うべきと述べた"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_5.
kg:op_39 prop:content "漁業に全く影響が出ないことはなく何らかの影響はあると認識する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_5.
kg:op_40 prop:content "酒田沖の議論ではこれまで以上に丁寧な説明と意見交換が必要と考える"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_5.
kg:op_41 prop:content "風車基礎の魚礁効果による漁業資源増大の可能性を示した"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "工事の場面で漁業者の船を活用する例があると紹介した"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_5.
kg:op_43 prop:content "火力発電所の発電量減少は港湾物流の減少に直結すると指摘する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "火力発電所は大量の工業用水を使っており簡単に失っては困ると述べた"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "廃炉は十分な準備と見通しなしに受け入れられないと主張する"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "火力に代わる新エネルギーと洋上利用の展開が酒田の死活問題だと考える"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:op_47 prop:content "合意形成は県だけでなく酒田市が最も身近な行政として担うべきと述べた"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_1.
kg:op_48 prop:content "課題を明確に説明することが合意形成への近道だと考える"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_1.
kg:op_49 prop:content "送電の問題が事業推進の停滞要因になっていると指摘した"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "送電の課題は関係業界と早急に協議すべきと求めた"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "漁業者の高齢化が進み将来への危機感があると述べた"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "養殖は海上でも陸上でも可能性があり検討すべきと提案した"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:st_7 rdfs:label "竹越農林水産部長"@ja.
kg:st_7 rdf:type cls:st_44.
cls:st_44 rdfs:label "行政幹部"@ja.
kg:op_53 prop:content "酒田の漁師が望むのであれば養殖も検討していきたい"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_7.
kg:op_54 prop:content "振興策より先に漁業者と地域の理解を得ることが重要と述べた"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "風力に従属させず漁業者主体で将来の漁業発展につながる振興策が大事と述べた"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:st_8 rdfs:label "大沼地域創生部長"@ja.
kg:st_8 rdf:type cls:st_44.
kg:op_56 prop:content "大浜埋立地は広さはあるが地盤耐力の面で工事が必要と説明した"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_8.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "地球温暖化によってシベリアの永久凍土が溶け出して"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "天然ガスが噴き出して温暖化に拍車をかける"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "今まで氷の下で眠っていた大昔の、人類が出会ったことのない未知のウイルスの脅威も危惧されております"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "気候変動や異常気象の対策の中で、世界的なエネルギーの転換期を迎えようとしております"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "菅総理は就任後初の所信表明の中で、2050年までに温室効果ガスの排出量をゼロにする2050年カーボンニュートラルを宣言し、経団連もその実現を、その後、支持を表明しております"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "国内総発電量の32％は石炭火力ですが、政府はその比率を下げて再生可能エネルギーの普及を進める方針に転換し"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "女川原発は地元合意がなされ、安全対策工事の後、2022年に再稼働を予定しております"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "3.11以降、フル操業で電力不足を支えてきました"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:text-txt_contents "昨年７月の全国100基石炭火力廃炉の報道で対象に挙げられた、いわゆる1990年代以前の非効率発電所であります"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "非効率石炭火力のフェードアウトに向けた具体的なロードマップが示されるものと考える"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
