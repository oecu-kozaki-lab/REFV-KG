<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "鳥海山からの伏流水への影響について、調査や予測及び評価を実施することといった意見が盛り込まれている"@ja.
<< kg:id_34 prop:effect kg:id_40 >>
    prop:text-txt_contents "サケなどの漁業対象魚種について、事業開始前から事業終了に伴う設備撤去及びその後の一定期間を通した継続的な漁業影響調査"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "事業開始前から事業終了に伴う設備撤去及びその後の一定期間を通した継続的な漁業影響調査、いわゆるモニタリングの実施を事業者に求めていく"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "地域の合意形成を図るためには、景観や環境への懸念事項について、民間事業者が丁寧に環境影響評価を実施し環境負荷の低減に努めることが重要"@ja.
<< kg:id_44 prop:effect kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "実現すれば雇用や港湾振興、地域経済への好循環が生まれるものと思います"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:text-txt_contents "十里塚の陸上風力発電では、コアジサシの営巣問題等の環境配慮対策を施しました"@ja.
<< kg:id_44 prop:effect kg:id_48 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "港湾の整備あるいは発電設備などの施工、施工後の運転、保守による直接的な経済効果"@ja.
<< kg:id_44 prop:effect kg:id_49 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "建設資材や原材料の取引の増加、さらには関連産業の立地による第１次的な経済波及効果"@ja.
<< kg:id_44 prop:effect kg:id_50 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "それらの雇用者所得の増加ですとか消費需要喚起による第２次的な経済波及効果"@ja.
<< kg:id_44 prop:effect kg:id_51 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "固定資産税額の約25％程度がその自治体における収入の増、財政的なプラス面ということになりますが、収入の増となりまして、5,000キロワット風車の場合、１基当たりの収入増分としては200万円程度"@ja.
<< kg:id_44 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "本市としては、景観や環境に配慮をし、そして漁業者などの海域利用者をはじめとする地域関係者の合意形成を図ることがまずは重要"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "この大幅に減額したことによりまして、再生可能エネルギー発電促進賦課金、再エネ賦課金と言われておりますけれども、これによる国民負担の軽減が見込まれております"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "民間事業者における洋上風力発電事業への参入意欲、単価が下がるわけですから、参入意欲の低下"@ja.
<< kg:id_53 prop:effect kg:id_56 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "それに伴って地域振興策に向けられる資金不足、こういったものが逆に懸念事項として考えられる"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "建設時は大量の資機材の保管ですとか組立て、海上輸送、それから、運転開始後はメンテナンスに必要なアクセス船ですとか作業船の高頻度での発着などを通して、地域に大きな波及効果"@ja.
<< kg:id_57 prop:effect kg:id_59 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "雇用や地元業界への経済波及効果もあるだろう"@ja.
<< kg:id_57 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "県が定める酒田港の港湾計画に海洋再生可能エネルギー発電設備等の基地機能を導入する区域という形で位置づける必要があります"@ja.
<< kg:id_57 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "山形県による洋上風力発電整備に係る海洋利用の有望区域としての国への手挙げ"@ja.
<< kg:id_25 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "関係者間の調整作業が必要になってくるでしょうし、それから、地域の総意として地域の熱意をまとめながら、国に対する手続の進展を早める活動を先導すること、これが私どもの役割"@ja.
<< kg:id_34 prop:effect kg:id_63 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "建設工事期間中や稼働開始以降、漁業に全く、全然影響が出ないとはならないと考えております。何らかの影響は必ずある"@ja.
<< kg:id_34 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "国や山形県において、これまで以上に丁寧な説明や意見交換をお願いしたい"@ja.
<< kg:id_34 prop:effect kg:id_65 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "風車の、海の下部分、台座の部分に魚や貝がついていわゆる魚礁としての役割を果たすことで、漁業資源の増大効果の可能性も示唆"@ja.
<< kg:id_34 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "工事に伴って、いろんな場面で漁業者の皆さんの船が活用されるとそのような例もある"@ja.
<< kg:id_67 prop:effect kg:id_68 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "発電量が減っただけでも減るわけですから、もう港の物流が連動している部分がありまして、石炭が35万トン減ると酒田港の貨物は16％減る"@ja.
<< kg:id_67 prop:effect kg:id_69 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "１日石炭が6,000トンと日量6,000リットルの工業用水を使っておりますので、簡単になくしてもらっちゃ困る"@ja.
<< kg:id_67 prop:countermeasure kg:id_70 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "なくなるとしてもちゃんと準備段階を経て、先を見通してからでなければ、そんな簡単に廃炉は受け入れられない"@ja.
<< kg:id_71 prop:countermeasure kg:id_72 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "ぜひ火力に代わった次の新エネルギーの展開と、洋上の利用は酒田の死活問題かなと考えます"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "一番身近にある行政は酒田市ですから、酒田市が住民なり漁業者ときちんとした話合いをしていくという部分が真っ先になければ"@ja.
<< kg:id_73 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "遊佐の課題はあって、では酒田の課題は何かという部分を説明を尽くすことが、一番合意形成には近い"@ja.
<< kg:id_76 prop:effect kg:id_77 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "遊佐もそこで一旦止まっている部分あります"@ja.
<< kg:id_76 prop:countermeasure kg:id_78 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "そういったところは業界の方ときちんと話合いを早く早くつけないと"@ja.
<< kg:id_79 prop:effect kg:id_80 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "今、漁業者は超高齢化です、農家よりも高齢化していると思います。ただ、皆さんお元気で90歳ぐらいまでは船に乗ることはあるんですが、あと何年かというカウントダウンは始まってくる"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "そういった中で養殖もできないかなと。海上でやっても陸上でやっても可能性は大きいですし 養殖の話につきましても、酒田の漁師がそれを望むのであれば、我々も検討をしていきたい"@ja.
<< kg:id_83 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "まずは漁業者の理解、それから地域の皆さんの理解がしっかりあった上で、その上で振興策が出てくる"@ja.
<< kg:id_83 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "我々あくまで漁業者を主体にして、その上で酒田の漁業をしっかりと子々孫々まで発展させていけるような振興策、これが大事"@ja.
<< kg:id_86 prop:effect kg:id_87 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "地盤の耐力としては、現状では難しいと思いますので、何かしらの工事は必要となる"@ja.
}
