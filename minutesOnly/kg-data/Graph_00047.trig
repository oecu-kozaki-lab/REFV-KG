 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電施設整備事業費の本体施設整備"@ja.
kg:id_1 rdf:type cls:c_305.
cls:c_305 rdfs:label "施設整備"@ja.
kg:id_2 rdfs:label "風力発電事業特別会計予算の継続費として設定"@ja.
kg:id_2 rdf:type cls:c_1301.
cls:c_1301 rdfs:label "継続費設定"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "歳入決算額と歳出決算額の差引き額2,178万円"@ja.
kg:id_3 rdf:type cls:c_1302.
cls:c_1302 rdfs:label "決算差額"@ja.
kg:id_4 rdfs:label "全額が翌年度に繰り越すべき財源"@ja.
kg:id_4 rdf:type cls:c_1303.
cls:c_1303 rdfs:label "繰越財源"@ja.
kg:id_3 prop:effect kg:id_4.
kg:id_5 rdfs:label "風力発電施設の完成"@ja.
kg:id_5 rdf:type cls:c_591.
cls:c_591 rdfs:label "発電施設"@ja.
kg:id_6 rdfs:label "カーボンニュートラル社会実現に貢献するため"@ja.
kg:id_6 rdf:type cls:c_1304.
cls:c_1304 rdfs:label "社会貢献"@ja.
kg:id_5 prop:cause kg:id_6.
kg:id_7 rdfs:label "４月から本格的に稼働"@ja.
kg:id_7 rdf:type cls:c_1305.
cls:c_1305 rdfs:label "本格稼働"@ja.
kg:id_5 prop:effect kg:id_7.
kg:id_8 rdfs:label "風力発電事業"@ja.
kg:id_8 rdf:type cls:c_218.
cls:c_218 rdfs:label "発電事業"@ja.
kg:id_9 rdfs:label "得られる利益を広く市民に還元"@ja.
kg:id_9 rdf:type cls:c_1306.
cls:c_1306 rdfs:label "利益還元"@ja.
kg:id_8 prop:effect kg:id_9.
kg:id_10 rdfs:label "カーボンニュートラル社会実現に貢献"@ja.
kg:id_10 rdf:type cls:c_1304.
kg:id_8 prop:countermeasure kg:id_10.
kg:st_1 rdfs:label "酒田市"@ja.
kg:st_1 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_1 prop:content "事業による利益を広く市民に還元する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "事業による利益を広く市民に還元する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "風力発電事業特別会計予算の継続費として設定した風力発電施設整備事業費の本体施設整備について"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:text-txt_contents "差引き額2,178万円は、全額が翌年度に繰り越すべき財源となっております"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "カーボンニュートラル社会実現に貢献するため、令和３年３月に風力発電施設が完成し、４月から本格的に稼働しました。今後は、事業によって得られる利益を広く市民に還元してまいります"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:text-txt_contents "令和３年３月に風力発電施設が完成し、４月から本格的に稼働しました"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今後は、事業によって得られる利益を広く市民に還元してまいります"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "カーボンニュートラル社会実現に貢献するため"@ja.
