kg:id_25 rdfs:label "酒田共同火力発電株式会社と東北電力株式会社と意見交換を行う"@ja.
kg:id_25 rdf:type cls:c_1192.
cls:c_1192 rdfs:label "意見交換"@ja.
kg:id_24 prop:countermeasure kg:id_25.
