kg:id_1 prop:countermeasure kg:id_30.
kg:st_1 rdfs:label "丸山至市長"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "酒田市の在り方にとって非常に大きな課題と認識する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "国の方向性を踏まえて市の方向性も示す必要がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "今後の酒田市の在り方に大きく関わる課題だと述べる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "洋上風力発電は今後の動きに大きな影響を与える出来事と捉える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "短期的には基地港湾指定に伴う地域振興を進める考えを示す"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "港の整備を進める方向で検討している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "非効率石炭火力発電の扱いが今後の動向に大きく関わるとみる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "削減を進めるなら地域の雇用や産業転換をセットで示すべきだと求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "環境に十分配慮しながら再生可能エネルギーの取組を進める"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "市として直営の風力発電事業を進めている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "酒田港を基地港湾とカーボンニュートラルポートにするため連携会議を設置した"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "国県沿岸自治体地元企業で検討会を立ち上げた"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "山形県と導入検討の協議を開始している"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "国の各計画の方向性を踏まえて後期計画にしっかり取り入れる考えを示す"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "国主導の議論や動きを見ながら長期戦略を組み立てる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "持続可能なまちの姿を考える上で地域産業活性化と酒田港活用は外せないと述べる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "再生可能エネルギー循環都市を目指したい意向を示す"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "関係会社と意識的に機会を捉えて意見交換している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "地域が存続できる政策と一体で示すよう国に働きかけたい"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "立地自治体として望ましい在り方について必要な声を上げる考えを示す"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_2 rdf:type cls:st_19.
cls:st_19 rdfs:label "自治体職員"@ja.
kg:op_21 prop:content "若者が将来を担うため意見をいただく機会や政策を構築できる機会を大事にすべきと述べる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "LPガスの機能も活用し産業振興とあわせて可能性を探るべきと述べる"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "昨年10月に、2050年に温室効果ガスの排出を全体でゼロにするというカーボンニュートラル、これを目指すということを宣言されました"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "12月には、脱炭素を産業の成長の機会とするべく、2050年カーボンニュートラルに伴うグリーン成長戦略を国は策定したところでございます"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "実はこのカーボンニュートラルということ、これも今後の酒田市の在り方にとっては非常に大きな課題でございまして"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "この洋上風力発電という形を通してではありますけれども、カーボンニュートラルに向けた今後の動きに大きな影響を与えるそういう出来事ではなかったかと考えております"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "短期的には酒田港の洋上風力発電の基地港湾指定に伴う地域振興ですとか"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "カーボンニュートラルポートという港の整備を進めようということですとか"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "非効率石炭火力発電の今後の在り方、それから、このことは酒田共同火力発電の今後の動向に大きく関わってくるわけでございますが"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "国が石炭火力発電の着実な削減を進めていくというのであれば、同時にそれに代わる地域の雇用や産業のシフト、産業構造の変化も含めてですけれども、そういったことについて、地域が存続できる、その地域政策とセットで示されるべきでありましょう"@ja.
<< kg:id_1 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "平成30年策定の酒田市総合計画及び令和２年策定の第２期酒田市まち・ひと・しごと創生総合戦略の中で、再生可能エネルギーに係る取組を掲げて政策を推進しております"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "現在御承知のとおり、直営の風力発電事業に取り組んでおって、今年４月から運転を開始しているところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "６月３日に酒田市と山形県とで酒田港基地港湾等カーボンニュートラルポート連携会議という会議を立ち上げて、酒田港を洋上風力発電の基地港湾等を目指し、かつカーボンニュートラルポートにしていこうというそういう勉強会を立ち上げているところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "昨日９月14日には酒田港のカーボンニュートラルポート検討会という、これは国と県と沿岸自治体、酒田、遊佐、それから地元の企業、それで構成する検討会をも立ち上げたところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "山形県等と酒田市沖での洋上風力発電の導入の検討に向けた協議を今、山形県との間で開始しているところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "５年後までの中期的な戦略としては、さきに述べました国のグリーン成長戦略ですとかエネルギー基本計画、地球温暖化対策計画の方向性を踏まえた上で、今年と来年で策定をいたしますが、総合計画の後期計画の中にしっかりと取り入れて、それを中期的な戦略として取り組んでいければなとそういう思いを持っております"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "長期的な戦略といたしましては、国策として国主導で議論が進められておりますカーボンニュートラル戦略ですとか、国の様々な動き、そういったものに注意をしつつ、まずは長期的ということでございますから、次の総合計画にしっかりとその流れを反映させながら、市としての戦略も組み立てていくことになるのかなとこんな思いを持っております"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "まずは地域産業の活性化と酒田港の活用、これは外してはならない重要なポイントであると考えているところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "本市としても再生可能エネルギー循環都市を目指していきたいとこんな思いを私自身は持っております"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "私も昨年末くらいから酒田共同火力発電株式会社、そしてその親会社であります東北電力株式会社と、意識的に機会を捉えて意見交換を行わせていただいたところでございます"@ja.
<< kg:id_13 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "そういったことについて、地域が存続できる、その地域政策とセットで示されるべきでありましょうというそういう観点から、しっかりと我々の声を国に働きかけていきたいとそういう思いを持っております"@ja.
<< kg:id_27 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "東北電力に対しましても、リプレースを含めて、酒田共同火力発電の望ましい在り方について、立地している自治体として必要な声は上げていきたいと考えているところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "若い方々が将来を担うということも事実でございます。そういう意味では、どのような会議になるか分かりませんけれども、そういった御意見をいただくような機会、あるいは若者の皆さんがそういう政策を構成するような、構築できるような機会、そういったものは大事にしていかなければいけないかなと思うところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "ＬＰガスというその１つの機能を、使えるものは何でも使って、それでカーボンニュートラル社会を実現する、酒田市内にそのような事業所があって、海外にもその技術を普及しているそういった力強い企業がございますので、そういった方々とも一緒に産業振興含めてやっていけるような、可能性を探っていくというようなことになるかと思っております"@ja.
