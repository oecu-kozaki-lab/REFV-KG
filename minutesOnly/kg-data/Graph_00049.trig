PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00049> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "酒田港"@ja.
kg:id_1 rdf:type cls:c_1084.
cls:c_1084 rdfs:label "港湾"@ja.
kg:id_2 rdfs:label "酒田港のカーボンニュートラルポート検討会の立ち上がり"@ja.
kg:id_2 rdf:type cls:c_1324.
cls:c_1324 rdfs:label "検討会設置"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "遊佐沖の洋上風力に関する有望区域指定"@ja.
kg:id_3 rdf:type cls:c_194.
cls:c_194 rdfs:label "区域指定"@ja.
kg:id_1 prop:cause kg:id_3.
kg:id_4 rdfs:label "酒田港への大きな投資"@ja.
kg:id_4 rdf:type cls:c_1325.
cls:c_1325 rdfs:label "投資"@ja.
kg:id_5 rdfs:label "酒田港に対する洋上風力の基地港指定の進展"@ja.
kg:id_5 rdf:type cls:c_815.
cls:c_815 rdfs:label "港湾指定"@ja.
kg:id_4 prop:cause kg:id_5.
kg:id_6 rdfs:label "かなり大きな投資が生まれる"@ja.
kg:id_6 rdf:type cls:c_1325.
kg:id_1 prop:effect kg:id_6.
kg:id_7 rdfs:label "酒田港への投資"@ja.
kg:id_7 rdf:type cls:c_1325.
kg:id_8 rdfs:label "酒田の財政に資する固定資産税や償却資産税を含む財源が生じる"@ja.
kg:id_8 rdf:type cls:c_1326.
cls:c_1326 rdfs:label "財源"@ja.
kg:id_7 prop:effect kg:id_8.
kg:id_9 rdfs:label "振興に努める"@ja.
kg:id_9 rdf:type cls:c_1327.
cls:c_1327 rdfs:label "振興"@ja.
kg:id_1 prop:countermeasure kg:id_9.
kg:st_1 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_1 rdf:type cls:st_23.
cls:st_23 rdfs:label "行政担当者"@ja.
kg:op_1 prop:content "カーボンニュートラルポートとして何ができるかを考えることがスタートした"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "洋上風力の進展が酒田港の今後に関わるとみている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "酒田港は短期ではないが大きな投資が生まれることを期待している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "短期ではないが酒田港への大きな投資を期待している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "投資によって固定資産税や償却資産税などの財源が生じると想定している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "これらを踏まえて酒田港の振興を進める考えである"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "９月14日には、国・県、それから市、それから市内の民間事業者を併せて酒田港のカーボンニュートラルポート検討会が立ち上がりました。まずは、カーボンニュートラルポートとしての動き、こういったことは何ができるのかということを考えていく、そこがスタートした"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "その前日の13日でございますけれども、洋上風力の関係で遊佐沖が有望な区域に指定を受けた"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "そういった中で、酒田港に対しては、洋上風力の基地港指定ということも今後進んでいくのかなと思っております。そういう状況を鑑みますと、ちょっと短期的に３年、５年ですぐどうなるというようなことではないんでしょうけれども、酒田港にかなり大きな投資が生まれるのではないかということを期待しているところでございます"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "そういう状況を鑑みますと、ちょっと短期的に３年、５年ですぐどうなるというようなことではないんでしょうけれども、酒田港にかなり大きな投資が生まれるのではないかということを期待しているところでございます"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "当然、投資に基づきまして、酒田の財政に資するような固定資産税、償却資産税を含めて、そういった財源が生じてくるということも想定されております"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "こういったことを踏まえて、酒田港の振興に努めてまいりたいと考えております"@ja.
}
