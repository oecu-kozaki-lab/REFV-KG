kg:st_1 rdfs:label "山形県知事、遊佐町長及び酒田市長"@ja.
kg:st_1 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_1 prop:content "酒田港の基地港湾指定を要望"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "令和３年７月に山形県知事に対して、酒田市重要事業として、洋上風力発電事業推進のための基地港湾の指定に向けた山形県港湾計画の変更を要望いたしました。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "令和４年３月には、山形県港湾計画の変更への調査・検討が一定程度進んだことを踏まえて、山形県知事、遊佐町長及び酒田市長の３者がそろって、国土交通省港湾局長に対して、酒田港の基地港湾指定を要望しました。"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "現在、早期の酒田港の基地港湾指定が期待されているところです。"@ja.
<< kg:id_6 prop:cause kg:id_7 >>
    prop:text-txt_contents "令和３年４月１日から、酒田市十里塚風力発電所において、国の再生可能エネルギー固定価格買取制度を活用して発電事業を行い"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:text-txt_contents "得られた利益を広く市民に還元するため"@ja.
<< kg:id_9 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "風力発電事業未来創造基金への積立てを行いました。"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:text-txt_contents "商工費では、風力発電事業特別会計の前年度繰越金の確定に伴う繰入金により、風力発電事業地域未来創造基金に積立てを行っております。"@ja.
<< kg:id_11 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "商工費では、風力発電事業特別会計の前年度繰越金の確定に伴う繰入金により、風力発電事業地域未来創造基金に積立てを行っております。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:text-txt_contents "このたびの補正は、前年度繰越金の確定並びに風力発電建設工事に伴う消費税及び地方消費税の還付金などを計上するもので"@ja.
<< kg:id_13 prop:cause kg:id_15 >>
    prop:text-txt_contents "このたびの補正は、前年度繰越金の確定並びに風力発電建設工事に伴う消費税及び地方消費税の還付金などを計上するもので"@ja.
<< kg:id_13 prop:effect kg:id_16 >>
    prop:text-txt_contents "議第66号については、風力発電事業特別会計予算を１億9,202万8,000円増額し"@ja.
<< kg:id_13 prop:effect kg:id_17 >>
    prop:text-txt_contents "予算総額を６億2,733万6,000円とするものであります。"@ja.
<< kg:id_13 prop:effect kg:id_18 >>
    prop:text-txt_contents "歳出では主に基金積立金や一般会計への繰出金を増額し"@ja.
<< kg:id_13 prop:effect kg:id_19 >>
    prop:text-txt_contents "歳入では繰越金と諸収入をそれぞれ増額しております。"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:text-txt_contents "差引き額１億1,631万7,081円を令和４年度に繰り越すものであります。"@ja.
}
