kg:id_19 prop:effect kg:id_51.
kg:st_1 rdfs:label "後藤仁議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "人口減少を抑える施策をこの4年間で着実に進めるべきだ"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "人口8万人台に向かう強い危機感がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "市長の人口減少対策を4年間できっちり進めてほしい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "経済活性化がなければ地域は維持できない"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "洋上風力発電は待ったなしで実現すべき事業だ"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "矢口明子市長"@ja.
kg:st_2 rdf:type cls:st_27.
cls:st_27 rdfs:label "市長"@ja.
kg:op_6 prop:content "再生可能エネルギーの主力電源化を徹底し最大限の導入を進める方針だ"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "国の動きを注視しながら酒田市沖への導入議論を進めたい"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "基地港湾化は新たな産業形成につながると期待している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "酒田港の機能強化に向け県と国へ要望してきた"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "市民の理解醸成を図りながら導入議論を進めたい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "法定協議会の中で具体的な議論が展開されると考えている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "秋田県の事例も参考に経済波及効果の再試算を進めている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "県と連携して地域理解と意見集約を進めたい"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "商工港湾課を中心に庁内連携で対応する体制を取っている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "建設が進む地域では宿泊施設不足が起きる事例がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "地方創生に資するホテル建設には連携や支援を行いたい"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "地域で再エネを利用する仕組みが企業誘致につながる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "RE100産業団地の可能性も含め県と連携して検討したい"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "酒田市沖の遅れを理由に酒田港が外されないよう体制を整えるべきだ"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:st_3 rdfs:label "佐々木好信地域創生部長"@ja.
kg:st_3 rdf:type cls:st_28.
cls:st_28 rdfs:label "部長"@ja.
kg:op_20 prop:content "県や関係団体とともに基地港湾の要望活動を行っている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "国から前向きな反応を得ている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "令和３年、令和４年の出生数は481人、458人、今年は、予定ではぎりぎり400人になるか、死亡者数は1,600人前後であります。実増減数は、1,400人前後の減であります。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "1,400人が４年間で減ると推定するならば、5,600人、令和10年には、人口が８万人台になるという座標軸が出てまいります。"@ja.
<< kg:id_1 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "矢口市長のテーマ、人口減少を抑え一人一人の幸せを創造するという施策は、この４年間できっちりとやっていただく"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "まず、経済が活性化しなければ地域は成り立ちません。"@ja.
<< kg:id_7 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "洋上風力発電は、国策というか、地球温暖化を考えれば待ったなしで実現する事業だと考えます。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "その目標を達成するためには、太陽光は20倍、風力は11倍増加させないとその目標には達成しないという計画であります。"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "2030年という早期から再生可能エネルギーの主力電源化を徹底し、再生可能エネルギーに最優先の原則で取り組み、国民負担の抑制と地域との共生を図りながら、最大限の導入を促すとされております。"@ja.
<< kg:id_13 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "2030年に領海内の着床式洋上風力発電と浮体式洋上風力発電を合わせた10ギガワットを目標とし"@ja.
<< kg:id_13 prop:countermeasure kg:id_15 >>
    prop:text-txt_contents "2040年には、領海内の着床式洋上風力発電と領海内及び排他的経済水域の浮体式洋上風力発電を合わせて30から45ギガワットという目標を達成していくためには"@ja.
<< kg:id_13 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "世界第６位の面積を誇る我が国の排他的経済水域も視野に加速していく必要があるとされております。このような国の動きも注視しながら、酒田市沖の洋上風力発電導入を見据えた議論を進めていきたい"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "今後、風車建設等を行う拠点港湾が必要となってまいります。"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:text-txt_contents "酒田港は、遊佐町沖洋上風力発電事業の海域に近く、また、約40ヘクタール以上の広大な土地があるため"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:text-txt_contents "大型化が進む風車部材の保管や組立等への対応"@ja.
<< kg:id_19 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "さらには洋上風力発電事業の導入を契機とした新たな産業形成等も期待されております。"@ja.
<< kg:id_19 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これまで山形県及び国に対して、基地港湾を誘致する取組、具体的には港湾計画の変更、あるいは中央要望等を行ってまいりました。"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:text-txt_contents "公募の開始時期や公募占用指針に盛り込まれる基地港湾の場所、その利用開始時期がいまだ公表されておらず"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:text-txt_contents "洋上風力発電が運転を開始する時期の目安は、当該海域が促進区域に指定された年を起点として...８年から10年後に運転開始がなされると想定されております。"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:text-txt_contents "その目安から遊佐町沖の風車建設時期までに酒田港が基地港湾として機能強化を図られたと想定した場合には、運転開始は2033年頃になるのではないかと思われます。"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "2024年２月頃に開催を検討しております、地域住民向けの説明会を含め、洋上風力発電事業の導入に向けた議論がこれから始まります。"@ja.
<< kg:id_29 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "2024年３月に開催を検討する再エネ海域利用法に基づく法定協議会の中で具体的な議論が展開されていくものと考えております"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:text-txt_contents "当時想定した風車のサイズや発電規模等に対して、世界の潮流が大きく変化したため、現在の遊佐町沖や酒田市沖で想定されているものと大きくかけ離れておりまして"@ja.
<< kg:id_32 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "改めて試算する必要が生じております。そのため、山形県では...秋田県の事例を参考にしながら、試算の検討を進めていると伺っております。"@ja.
<< kg:id_35 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "引き続き、地域の理解醸成と意見の取りまとめが図られるよう山形県と連携していきたいと考えております。"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "酒田市役所の体制としましては、商工港湾課を中心に関係する課が連携して取り組む、という体制をとっております。"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "洋上風車等の建設が進む地域で、急激な交流人口の増加により、宿泊施設が不足する事例があると聞いております。"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:text-txt_contents "本市においては、以前より宿泊施設が不足しており、宿が取りにくい状況にあります。"@ja.
<< kg:id_41 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "優良な案件があれば、連携や支援を行っていきたいと考えております。"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "本地域で発電される再生可能エネルギーを地域で利用する仕組みを検討することにより、再生可能エネルギー利用を目的とした優良な企業の誘致につながる例があると認識しております。"@ja.
<< kg:id_44 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "先進地では、企業の事業活動で使用する電力を洋上風力発電等で発電した再生可能エネルギー100％の電気で賄い、環境価値を魅力としたＲＥ100産業団地を呼び水とした企業誘致が検討されております。"@ja.
<< kg:id_44 prop:cause kg:id_47 >>
    prop:text-txt_contents "工業用地の確保やインフラ整備等の課題も整理しながら"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "国から遊佐町沖はいいよと、でも、ちょっと酒田市沖は遅れているから基地港湾は酒田港じゃなくてもいいんだよね、ということを言われないような体制をきっちりと取っていただきたい"@ja.
<< kg:id_19 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "10月19日に斉藤国土交通大臣に山形県知事、山形県議会議長、酒田市議会議長、遊佐町議会議長が基地港湾の要望活動をさせていただいた"@ja.
<< kg:id_19 prop:effect kg:id_51 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "大臣のお答えといたしましては、前向きに検討いたしますとコメントをいただいております。"@ja.
}
