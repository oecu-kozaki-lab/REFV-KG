    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "産業革命以来、急速に進んだ地球温暖化による気候変動、加えて、我が国では2019年より広がった新型コロナウイルス感染症、さらには21世紀のこの時代、あり得ないと思っていた大国ロシアによるウクライナ侵攻、それに伴う世界的物価高騰、核兵器使用への現実的な恐怖、現代を総称して危機の時代と呼ぶ学者も現れております"@ja.
<< kg:id_5 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "産業革命以来、急速に進んだ地球温暖化による気候変動、加えて、我が国では2019年より広がった新型コロナウイルス感染症、さらには21世紀のこの時代、あり得ないと思っていた大国ロシアによるウクライナ侵攻、それに伴う世界的物価高騰、核兵器使用への現実的な恐怖、現代を総称して危機の時代と呼ぶ学者も現れております"@ja.
<< kg:id_5 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "産業革命以来、急速に進んだ地球温暖化による気候変動、加えて、我が国では2019年より広がった新型コロナウイルス感染症、さらには21世紀のこの時代、あり得ないと思っていた大国ロシアによるウクライナ侵攻、それに伴う世界的物価高騰、核兵器使用への現実的な恐怖、現代を総称して危機の時代と呼ぶ学者も現れております"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "これらの不安要素は市民生活に大きな影響を与え"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "さらに本市の財政運営もまた厳しさが増しているものと認識しております"@ja.
<< kg:id_11 prop:effect kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "新型コロナウイルス感染症の感染拡大によりまして社会経済活動に大きな制約を受けたところでございました"@ja.
<< kg:id_11 prop:effect kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "様々なイベントですとか、あるいは他地域との交流事業が非常に大きな影響を受けた"@ja.
<< kg:id_11 prop:effect kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "様々なイベントですとか、あるいは他地域との交流事業が非常に大きな影響を受けた"@ja.
<< kg:id_15 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "東北公益文科大学と協働してデジタル人材を育成することによって、不足するデジタル人材を地元の大学から採用することが期待できる"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "市内のＩＴ関連企業と学生が直接交流することで、ＩＴ技術の職場での活用方法について理解を深めることによって、学生の学習に対する動機づけの向上を図る"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "18歳の人口は今後急速に減少していく中で"@ja.
<< kg:id_19 prop:cause kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "地方の私立文系大学における学生確保は一段と厳しくなることが予想されておりまして、本市はそういった状況を考えると、この大学の存続そのものが危なくなる"@ja.
<< kg:id_19 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "大学を存続させていくための手段として、まずは公立化を急ぐべきであると考えている"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "文化政策課から担っていただきたいなと思っているのは、文化芸術の振興に係る市民団体による運営基盤づくり"@ja.
<< kg:id_23 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "既存の団体、それから新しいそういった団体の育成も含めて、この連携体制をしっかりと構築していく"@ja.
<< kg:id_23 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "そういった団体と行政との連携を図る必要がある"@ja.
<< kg:id_23 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "外部から専門的なスタッフを招いて配置をしながら"@ja.
<< kg:id_23 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "内部的には部長級をしっかりそこに配置をしながら、歴史や文化や芸術を重視するまちづくりというものを部局横断的に進めていきたい"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "酒田港の基地港湾の指定に当たりましては、港湾法によりまして２つ以上の洋上風力の海域が指定されることが必要"@ja.
<< kg:id_29 prop:cause kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "現時点での山形県沖の案件としては、令和３年９月に有望な区域に指定をされた遊佐町沖のみ"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "洋上風力発電事業での地元経済の波及効果といたしましては、風車建設やその建設された風車の運用"@ja.
<< kg:id_32 prop:effect kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "カーボンニュートラルポートとしてのエネルギー関連産業の集積等も見込まれます"@ja.
<< kg:id_32 prop:effect kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "海を生業とする漁業者への影響"@ja.
<< kg:id_32 prop:effect kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "景観等による周辺住民への影響"@ja.
<< kg:id_32 prop:effect kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "未知の影響も懸念されているというのが現状でございます"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "漁業者や周辺住民などの利害関係者との調整や地域振興策の検討等に協力をしていきたい"@ja.
<< kg:id_38 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "地域振興策の検討等に協力をしていきたい"@ja.
<< kg:id_41 prop:cause kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "エネルギー関連産業の集積を図るためには、企業誘致や工業用地の確保などの課題もある"@ja.
<< kg:id_41 prop:cause kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "エネルギー関連産業の集積を図るためには、企業誘致や工業用地の確保などの課題もある"@ja.
<< kg:id_41 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "関係機関とも連携して進めてまいりたい"@ja.
<< kg:id_45 prop:cause kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "コロナ禍での実質無利子・無担保融資、いわゆるゼロゼロ融資の返済も今年の夏頃に返済が本格化する見込みとあり、影響を受ける事業所にとっては先行きを見通せない状況"@ja.
<< kg:id_45 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "中小企業・小規模事業者約550件に対する利子補給と保証料補給"@ja.
<< kg:id_45 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "返済期間を延長し、１回当たりの返済額を低減させる制度を県が中心となって検討"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "幅広い業種向けに原油価格・物価高騰緊急支援補助金などの支援を実施してきた"@ja.
<< kg:id_51 prop:cause kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "数億円から十数億円の予算が必要となることから、使える交付金が約２億円ということから考えると、なかなかこれは難しい"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "基地港湾の指定に向けた課題といたしましては、山形県が主導する２つの海域の早期案件形成"@ja.
<< kg:id_53 prop:cause kg:id_55 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "基地港湾に関する港湾計画の変更の遅延、これが課題として挙げられる"@ja.
<< kg:id_53 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "海域先行利用者等に寄り添った県の組織をまたぐ横断的な取組の深化"@ja.
<< kg:id_53 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "地域の理解醸成の促進を主体的に進めてもらうことが重要"@ja.
<< kg:id_58 prop:effect kg:id_59 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "短期的には基地港湾の整備や洋上風力の建設に関する地元企業への経済波及効果を期待しております"@ja.
<< kg:id_58 prop:effect kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "建設や現地調査等で多くの交流人口が増加する"@ja.
<< kg:id_58 prop:effect kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "市内宿泊施設等への波及効果も期待している"@ja.
<< kg:id_58 prop:effect kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "洋上風力発電事業の地域振興策による新たな産業形成"@ja.
<< kg:id_58 prop:effect kg:id_63 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "再生可能エネルギーの導入拡大"@ja.
<< kg:id_58 prop:effect kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "水素などの次世代エネルギーが普及することで、関連産業による雇用が創出され"@ja.
<< kg:id_58 prop:effect kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "本市への定住人口の増加が期待される"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "この基地港湾指定は、私は、酒田にとって令和の北前船時代の到来と言っていいほど大きなチャンス"@ja.
}
