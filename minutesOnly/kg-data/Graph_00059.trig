cls:st_10 rdfs:label "研究者"@ja.
kg:op_1 prop:content "現代を危機の時代と捉える"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "現代を危機の時代と捉える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "現代を危機の時代と捉える"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "現代を危機の時代と捉える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "現代を危機の時代と捉える"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤猛議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_6 prop:content "不安要素が市民生活に大きく影響していると認識する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "本市の財政運営も厳しさが増していると認識する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:st_3 rdfs:label "丸山市長"@ja.
kg:st_3 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_8 prop:content "感染拡大により社会経済活動が大きく制約された"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "様々なイベントが大きな影響を受けた"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "他地域との交流事業が大きな影響を受けた"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "地元大学と企業の協働で不足するデジタル人材の確保を期待する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "企業との直接交流で学習への動機づけ向上を図る"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "18歳人口減少で大学存続への危機感を持つ"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "地方私立文系大学の学生確保が一段と厳しくなるとみている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "大学存続のためまず公立化を急ぐべきだ"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "市民団体の運営基盤を強化する必要がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "新たな団体も育成し連携体制を構築したい"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "団体と行政の連携を図る必要がある"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "専門スキルを補うため外部専門スタッフ配置が必要"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "部長級を配置し部局横断で進めたい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "基地港湾指定には2海域以上の指定が必要だ"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "現時点では遊佐町沖しか案件がない"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "風車建設や運用で地元経済への波及効果が見込まれる"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "カーボンニュートラルポートとして関連産業集積が見込まれる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "海を生業とする漁業者への影響が懸念される"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "景観等による周辺住民への影響が懸念される"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "未知の影響も懸念されている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "地域の意見形成へ利害関係者との調整に協力する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "地域振興策の検討に協力したい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "関連産業集積には企業誘致が課題になる"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "工業用地の確保が課題になる"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "関係機関と連携して進めたい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:st_4 rdfs:label "市村浩一議員"@ja.
kg:st_4 rdf:type cls:st_9.
kg:op_33 prop:content "返済本格化で事業所は先行きを見通せない"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_4.
kg:op_34 prop:content "中小企業・小規模事業者向けに利子補給と保証料補給を実施する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "返済期間を延長し返済額を低減させる制度を案内予定"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "幅広い業種向けに緊急支援補助金を実施してきた"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "必要額が大きく実施は難しいと判断している"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "県主導による2海域の早期案件形成が課題だ"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "港湾計画変更の遅延が課題だ"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "県には組織横断的な取組の深化を求める"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "県に主体的な地域理解醸成を求める"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "基地港湾整備や洋上風力建設で地元企業への波及を期待する"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "建設や調査で交流人口増加が期待できる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "宿泊施設などへの波及効果を期待する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "地域振興策により新たな産業形成が期待される"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "再生可能エネルギーの導入拡大が期待される"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "次世代エネルギー普及で関連産業の雇用創出が期待される"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "雇用創出により定住人口増加が期待される"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "基地港湾指定は令和の北前船時代とも言える大きなチャンスであり逃してはならない"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "産業革命以来、急速に進んだ地球温暖化による気候変動"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "大国ロシアによるウクライナ侵攻、それに伴う世界的物価高騰"@ja.
<< kg:id_5 prop:cause kg:id_1 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "産業革命以来、急速に進んだ地球温暖化による気候変動、加えて、我が国では2019年より広がった新型コロナウイルス感染症、さらには21世紀のこの時代、あり得ないと思っていた大国ロシアによるウクライナ侵攻、それに伴う世界的物価高騰、核兵器使用への現実的な恐怖、現代を総称して危機の時代と呼ぶ学者も現れております"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "産業革命以来、急速に進んだ地球温暖化による気候変動、加えて、我が国では2019年より広がった新型コロナウイルス感染症、さらには21世紀のこの時代、あり得ないと思っていた大国ロシアによるウクライナ侵攻、それに伴う世界的物価高騰、核兵器使用への現実的な恐怖、現代を総称して危機の時代と呼ぶ学者も現れております"@ja.
