kg:st_1 rdfs:label "専門家"@ja.
kg:st_1 rdf:type cls:st_24.
cls:st_24 rdfs:label "専門家"@ja.
kg:op_1 prop:content "全国でも有数の地域と評価"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "酒田市は、石炭火力に加えて、太陽光、風力、木質バイオマスなど、多様な再生可能エネルギーの電源が所在している全国でも有数の地域であると専門家に評価されてきました"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "太陽光、風力、木質チップ・ペレット、水力、バイオガスなど、地域にある自然資源を大いに生かして、企業の創業を促していきます"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "地域で発電される再生可能エネルギーを地域で利用する仕組みを検討することにより、再生可能エネルギー利用を目的とした優良企業の誘致"@ja.
<< kg:id_7 prop:cause kg:id_6 >>
    prop:text-txt_contents "地域で発電される再生可能エネルギーを地域で利用する仕組みを検討することにより、再生可能エネルギー利用を目的とした優良企業の誘致、それから、市民による再生可能エネルギー利用を進めます"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:text-txt_contents "遊佐町沖及び酒田市沖での洋上風力発電プロジェクトの進捗を踏まえ、酒田港の基地港湾指定に向けて、山形県と連携した取組を進め"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:text-txt_contents "新型コロナウイルス感染症拡大や台風の影響により、酒田港へのクルーズ船の寄港が全て中止となりました"@ja.
<< kg:id_10 prop:cause kg:id_12 >>
    prop:text-txt_contents "新型コロナウイルス感染症拡大や台風の影響により、酒田港へのクルーズ船の寄港が全て中止となりました"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:text-txt_contents "庄内－羽田線の定期便搭乗者数は、コロナ禍の影響で令和３年に約10万人まで落ち込みました"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:text-txt_contents "物価高騰の影響を受けている子育て世帯を支援するため"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:text-txt_contents "住民税非課税世帯等に対しては、新型コロナウイルス感染症拡大の影響が長期化する中での生活を支援するため"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:text-txt_contents "電力、ガス、食料品等の価格高騰による負担を軽減するため"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:text-txt_contents "コロナ禍における市民の経済的負担を軽減するため"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:text-txt_contents "令和４年度から不妊治療が医療保険適用となり、自己負担が生じることになったことから、不妊治療を受ける方の経済的負担を軽減するため"@ja.
<< kg:id_25 prop:cause kg:id_14 >>
    prop:text-txt_contents "コロナ禍の影響により、児童の派遣、受入れの相互交流が困難となった"@ja.
<< kg:id_3 prop:effect kg:id_26 >>
    prop:text-txt_contents "地域にある自然資源を大いに生かして、企業の創業を促していきます"@ja.
<< kg:id_27 prop:effect kg:id_5 >>
    prop:text-txt_contents "地域で発電される再生可能エネルギーを地域で利用する仕組みを検討することにより、再生可能エネルギー利用を目的とした優良企業の誘致"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:text-txt_contents "地域で発電される再生可能エネルギーを地域で利用する仕組みを検討することにより、再生可能エネルギー利用を目的とした優良企業の誘致、それから、市民による再生可能エネルギー利用を進めます"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:text-txt_contents "洋上風力発電プロジェクトについては、市民に分かりやすいメリットをもたらす地域貢献策を"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:text-txt_contents "酒田港の基地港湾指定に向けて、山形県と連携した取組を進め、関連する市内企業の所得向上を目指します"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:text-txt_contents "酒田産の農水産物の知名度向上と販路を拡大するため、首都圏のバイヤーと地元企業との商談を通じて、首都圏スーパーにおける酒田フェアを初めて開催いたしました"@ja.
<< kg:id_33 prop:effect kg:id_35 >>
    prop:text-txt_contents "酒田産の農水産物の知名度向上と販路を拡大するため、首都圏のバイヤーと地元企業との商談を通じて、首都圏スーパーにおける酒田フェアを初めて開催いたしました"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:text-txt_contents "移住者向け住宅として民間事業者が整備したＴＯＣＨｉＴＯ（とちと）への入居移住者を酒田市と民間事業者が連携して募集し、全18戸中、16戸の早期入居予約に至りました"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:text-txt_contents "本市の観光事業推進の中核となる一般財団法人酒田ＤＭＯを設立し、稼ぐ観光地域づくりに向けて、マーケティングに基づくプロモーション活動や観光コンテンツ開発を進めました"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:text-txt_contents "ＡＮＡ客室乗務員の５人が引き続きＡＮＡＳＨＯＮＡＩＢＬＵＥＡｍｂａｓｓａｄｏｒとして本市に居住し、庄内地域の観光プロモーションやふるさと納税のＰＲなどを行いました"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:text-txt_contents "新型コロナウイルス感染症拡大や台風の影響により、酒田港へのクルーズ船の寄港が全て中止となりました"@ja.
<< kg:id_14 prop:effect kg:id_44 >>
    prop:text-txt_contents "庄内－羽田線の定期便搭乗者数は、コロナ禍の影響で令和３年に約10万人まで落ち込みました"@ja.
<< kg:id_45 prop:effect kg:id_46 >>
    prop:text-txt_contents "これまでの増便に向けた要望活動が実を結び、令和５年３月26日から５月31日まで、そして、令和５年10月１日から令和６年３月30日までの期間を限定して、５便化されることとなりました"@ja.
<< kg:id_47 prop:effect kg:id_48 >>
    prop:text-txt_contents "物価高騰の影響を受けている子育て世帯を支援するため、本市独自の支援策として、さかた子育て応援臨時給付金を対象児童１人当たり２万円支給しました"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:text-txt_contents "住民税非課税世帯等に対しては、新型コロナウイルス感染症拡大の影響が長期化する中での生活を支援するため、１世帯当たり10万円を支給しました"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:text-txt_contents "電力、ガス、食料品等の価格高騰による負担を軽減するため、１世帯当たり５万円を支給しました"@ja.
<< kg:id_53 prop:effect kg:id_54 >>
    prop:text-txt_contents "コロナ禍における市民の経済的負担を軽減するため、国民健康保険財政調整基金を活用し、３年連続で国民健康保険税の引下げを実施しました"@ja.
<< kg:id_55 prop:effect kg:id_56 >>
    prop:text-txt_contents "不妊治療を受ける方の経済的負担を軽減するため、医療保険適用の一連の生殖補助医療、男性不妊治療、併用して実施する先進医療の自己負担分に対して、上限９万円の助成を行いました"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:text-txt_contents "無償化の拡大を継続実施することで子育て世帯の経済的負担軽減を図りました"@ja.
<< kg:id_59 prop:effect kg:id_60 >>
    prop:text-txt_contents "市民が住み慣れた地域で安心して生活できる環境の整備に寄与することを目的として、令和４年９月１日から、地域医療連携推進法人日本海ヘルスケアネットに参加をいたしました"@ja.
<< kg:id_61 prop:effect kg:id_62 >>
    prop:text-txt_contents "株式会社良品計画が、本市との連携協定に基づき、八幡、松山、平田、本楯、南遊佐及び上田の各地域において移動販売を実施し、中山間地域が抱える課題解決や地域コミュニティの活性化に取り組みました"@ja.
<< kg:id_61 prop:effect kg:id_63 >>
    prop:text-txt_contents "株式会社良品計画が、本市との連携協定に基づき、八幡、松山、平田、本楯、南遊佐及び上田の各地域において移動販売を実施し、中山間地域が抱える課題解決や地域コミュニティの活性化に取り組みました"@ja.
<< kg:id_64 prop:effect kg:id_65 >>
    prop:text-txt_contents "市民や自主防災組織、防災関係機関及び酒田市災害対策本部が組織的な連携を保持することを目的に、酒田市全域を対象とした総合防災訓練を内閣府と共催で実施しました"@ja.
<< kg:id_66 prop:effect kg:id_67 >>
    prop:text-txt_contents "海底光ファイバー敷設により島内で高速通信が可能となったため"@ja.
<< kg:id_68 prop:effect kg:id_69 >>
    prop:text-txt_contents "平成29年１月の事業着手から６年間に及んだ駅前再開発事業が終了し、酒田駅前交流拠点施設ミライニがグランドオープンしました"@ja.
<< kg:id_70 prop:effect kg:id_71 >>
    prop:text-txt_contents "水道事業においては、経営基盤の強化を図るため、酒田市、鶴岡市、庄内町を構成団体とする庄内広域水道事業統合準備協議会を令和５年３月28日に設立いたしました"@ja.
<< kg:id_29 prop:countermeasure kg:id_72 >>
    prop:text-txt_contents "洋上風力発電プロジェクトについては、市民に分かりやすいメリットをもたらす地域貢献策を、洋上風力発電事業者に対して求めてまいります"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:text-txt_contents "遊佐町沖及び酒田市沖での洋上風力発電プロジェクトの進捗を踏まえ、酒田港の基地港湾指定に向けて、山形県と連携した取組を進め"@ja.
<< kg:id_75 prop:countermeasure kg:id_76 >>
    prop:text-txt_contents "スルメイカ水揚げ量を確保するため、県外船誘致も含め、イカ釣り漁船への支援を行いました"@ja.
<< kg:id_34 prop:countermeasure kg:id_77 >>
    prop:text-txt_contents "酒田産の農水産物の知名度向上と販路を拡大するため、首都圏のバイヤーと地元企業との商談を通じて、首都圏スーパーにおける酒田フェアを初めて開催いたしました"@ja.
<< kg:id_78 prop:countermeasure kg:id_77 >>
    prop:text-txt_contents "酒田産の農水産物の知名度向上と販路を拡大するため、首都圏のバイヤーと地元企業との商談を通じて、首都圏スーパーにおける酒田フェアを初めて開催いたしました"@ja.
<< kg:id_79 prop:countermeasure kg:id_38 >>
    prop:text-txt_contents "観光振興については、本市の観光事業推進の中核となる一般財団法人酒田ＤＭＯを設立し"@ja.
<< kg:id_25 prop:countermeasure kg:id_80 >>
    prop:text-txt_contents "児童の派遣、受入れの相互交流が困難となった交流都市の東村、海津市とオンライン交流を行いました"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:text-txt_contents "令和５年度のクルーズ船寄港に向け、ポストコロナに向けたセミナーを実施した"@ja.
<< kg:id_81 prop:countermeasure kg:id_83 >>
    prop:text-txt_contents "令和５年度のクルーズ船寄港に向け、新たな観光商品を提案するワークショップや英会話研修を行いました"@ja.
<< kg:id_81 prop:countermeasure kg:id_84 >>
    prop:text-txt_contents "令和５年度のクルーズ船寄港に向け、ポストコロナに向けたセミナーを実施したほか、新たな観光商品を提案するワークショップや英会話研修を行いました"@ja.
<< kg:id_85 prop:countermeasure kg:id_86 >>
    prop:text-txt_contents "複雑化、複合化した支援ニーズに対応する重層的支援体制整備事業の実施に向けた準備を進めました"@ja.
<< kg:id_87 prop:countermeasure kg:id_88 >>
    prop:text-txt_contents "地域福祉を推進するため、コミュニティ振興会、民生・児童委員、酒田市社会福祉協議会などの関係機関と連携し"@ja.
<< kg:id_15 prop:countermeasure kg:id_89 >>
    prop:text-txt_contents "物価高騰の影響を受けている子育て世帯を支援するため、本市独自の支援策として、さかた子育て応援臨時給付金を対象児童１人当たり２万円支給しました"@ja.
<< kg:id_90 prop:countermeasure kg:id_91 >>
    prop:text-txt_contents "住民税非課税世帯等に対しては、新型コロナウイルス感染症拡大の影響が長期化する中での生活を支援するため、１世帯当たり10万円を支給しました"@ja.
<< kg:id_92 prop:countermeasure kg:id_93 >>
    prop:text-txt_contents "電力、ガス、食料品等の価格高騰による負担を軽減するため、１世帯当たり５万円を支給しました"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:text-txt_contents "コロナ禍における市民の経済的負担を軽減するため、国民健康保険財政調整基金を活用し、３年連続で国民健康保険税の引下げを実施しました"@ja.
<< kg:id_23 prop:countermeasure kg:id_96 >>
    prop:text-txt_contents "不妊治療を受ける方の経済的負担を軽減するため、医療保険適用の一連の生殖補助医療、男性不妊治療、併用して実施する先進医療の自己負担分に対して、上限９万円の助成を行いました"@ja.
<< kg:id_97 prop:countermeasure kg:id_57 >>
    prop:text-txt_contents "無償化の拡大を継続実施することで子育て世帯の経済的負担軽減を図りました"@ja.
<< kg:id_98 prop:countermeasure kg:id_99 >>
    prop:text-txt_contents "子育て世代包括支援センターぎゅっと及び子ども・家庭総合支援室を運営し、妊娠期から出産、子育て期まで、切れ目なく相談を受けた上で支援を行いました"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:text-txt_contents "令和５年度からのこども家庭庁の設置に併せて、子育て世代包括支援センターぎゅっとと子ども・家庭総合支援室を一体的に運用する体制の構築に取り組みました"@ja.
<< kg:id_102 prop:countermeasure kg:id_103 >>
    prop:text-txt_contents "酒田地区医師会十全堂、酒田地区歯科医師会、酒田地区薬剤師会及び日本海総合病院など関係機関と密接に連携を図りながら、新型コロナウイルスワクチン接種を行いました"@ja.
<< kg:id_104 prop:countermeasure kg:id_59 >>
    prop:text-txt_contents "市民が住み慣れた地域で安心して生活できる環境の整備に寄与することを目的として、令和４年９月１日から、地域医療連携推進法人日本海ヘルスケアネットに参加をいたしました"@ja.
<< kg:id_105 prop:countermeasure kg:id_106 >>
    prop:text-txt_contents "株式会社良品計画が、本市との連携協定に基づき、八幡、松山、平田、本楯、南遊佐及び上田の各地域において移動販売を実施し、中山間地域が抱える課題解決や地域コミュニティの活性化に取り組みました"@ja.
<< kg:id_107 prop:countermeasure kg:id_108 >>
    prop:text-txt_contents "廃棄物の資源化及び減量化を推進するため、分別回収の周知徹底とアルミ缶や紙類資源の回収に取り組みました"@ja.
<< kg:id_109 prop:countermeasure kg:id_110 >>
    prop:text-txt_contents "不法投棄監視員による巡回を行い、不法投棄の防止に努めました"@ja.
<< kg:id_111 prop:countermeasure kg:id_112 >>
    prop:text-txt_contents "子どもや高齢者などの交通事故を防ぐなど交通安全を推進するため、交通安全専門指導員による交通安全教室の実施や運転免許自主返納者へタクシー券を交付いたしました"@ja.
<< kg:id_111 prop:countermeasure kg:id_113 >>
    prop:text-txt_contents "子どもや高齢者などの交通事故を防ぐなど交通安全を推進するため、交通安全専門指導員による交通安全教室の実施や運転免許自主返納者へタクシー券を交付いたしました"@ja.
<< kg:id_114 prop:countermeasure kg:id_115 >>
    prop:text-txt_contents "空き家対策については、自治会と連携した取組や"@ja.
<< kg:id_114 prop:countermeasure kg:id_116 >>
    prop:text-txt_contents "不動産業者や司法書士及び建設業者等で組織する酒田市空き家等ネットワーク協議会による無料相談会を実施しました"@ja.
<< kg:id_114 prop:countermeasure kg:id_117 >>
    prop:text-txt_contents "固定資産税納税通知書に、売買、解体、相続等、内容別相談先等を記載したパンフレットを同封するなど、管理不全空き家の発生を抑制しました"@ja.
<< kg:id_118 prop:countermeasure kg:id_119 >>
    prop:text-txt_contents "市民や自主防災組織、防災関係機関及び酒田市災害対策本部が組織的な連携を保持することを目的に、酒田市全域を対象とした総合防災訓練を内閣府と共催で実施しました"@ja.
<< kg:id_120 prop:countermeasure kg:id_121 >>
    prop:text-txt_contents "防災情報及び災害情報等、多様な情報伝達手段の１つとして、コミュニティＦＭ中継局の整備を行いました"@ja.
<< kg:id_122 prop:countermeasure kg:id_123 >>
    prop:text-txt_contents "緊急災害情報等を複数のメディアに対し一斉配信可能な防災行政無線操作卓の更新に着手しました"@ja.
<< kg:id_124 prop:countermeasure kg:id_125 >>
    prop:text-txt_contents "総合防災センターの整備に向け、外構工事を行いました"@ja.
<< kg:id_126 prop:countermeasure kg:id_127 >>
    prop:text-txt_contents "持続可能な公共交通網の形成を図るため、バス路線の再編成やデマンドタクシーの運行地区拡大など、市全体の公共交通改編を令和４年８月に実施しました"@ja.
<< kg:id_126 prop:countermeasure kg:id_128 >>
    prop:text-txt_contents "持続可能な公共交通網の形成を図るため、バス路線の再編成やデマンドタクシーの運行地区拡大など、市全体の公共交通改編を令和４年８月に実施しました"@ja.
<< kg:id_129 prop:countermeasure kg:id_130 >>
    prop:text-txt_contents "運行内容の変更に伴い、地域要望に応じた方法で説明会等を実施するなど周知徹底に努めました"@ja.
<< kg:id_131 prop:countermeasure kg:id_132 >>
    prop:text-txt_contents "外部の人材からの視点やこれまでの経験を生かした活動により地域活性化を図るため、八幡、松山、平田地域に地域おこし協力隊や集落支援員を配置しました"@ja.
<< kg:id_133 prop:countermeasure kg:id_134 >>
    prop:text-txt_contents "飛島の島民の日常生活の利便性向上と観光振興を図るため、飛島マリンプラザ内に整備した小規模店舗や食堂を運営しました"@ja.
<< kg:id_135 prop:countermeasure kg:id_136 >>
    prop:text-txt_contents "観光客向けに無線ＬＡＮを整備した旅館に対して整備費用の一部を支援しました"@ja.
<< kg:id_137 prop:countermeasure kg:id_138 >>
    prop:text-txt_contents "ＪＲ酒田駅をより利便性の高い空間とするため、駅前広場の工事に着手しました"@ja.
<< kg:id_139 prop:countermeasure kg:id_140 >>
    prop:text-txt_contents "局地的な大雨の浸水対策として、京田一丁目ポンプ場の老朽化した受電設備を修繕し"@ja.
<< kg:id_139 prop:countermeasure kg:id_141 >>
    prop:text-txt_contents "冠水頻度の高い地域の道路と排水路に水位監視システムを導入しました"@ja.
<< kg:id_142 prop:countermeasure kg:id_143 >>
    prop:text-txt_contents "行政手続のオンライン化を進め、新たに47の手続をオンライン受付可能としました"@ja.
<< kg:id_144 prop:countermeasure kg:id_145 >>
    prop:text-txt_contents "マイナンバーカードの休日申請窓口の開設や"@ja.
<< kg:id_144 prop:countermeasure kg:id_146 >>
    prop:text-txt_contents "企業、コミュニティセンター等への出張による申請受付を行い、マイナンバーカードの普及に努めました"@ja.
<< kg:id_147 prop:countermeasure kg:id_148 >>
    prop:text-txt_contents "文書事務の電子化による業務の効率化及び庁舎内スペースの有効活用のため文書管理システムを導入し"@ja.
<< kg:id_149 prop:countermeasure kg:id_150 >>
    prop:text-txt_contents "ふるさと納税やガバメントクラウドファンディングによる寄附金の獲得"@ja.
<< kg:id_149 prop:countermeasure kg:id_151 >>
    prop:text-txt_contents "企業立地に伴う酒田京田西工業団地等の未利用財産の売払いや"@ja.
<< kg:id_149 prop:countermeasure kg:id_152 >>
    prop:text-txt_contents "風力発電事業の売電収益などによる歳入確保に積極的に取り組みました"@ja.
}
