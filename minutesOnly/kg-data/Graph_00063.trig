PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00063> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "酒田市沖の洋上風力発電事業"@ja.
kg:id_1 rdf:type cls:c_781.
cls:c_781 rdfs:label "洋上風力発電事業"@ja.
kg:id_2 rdfs:label "山形県と連携した地域の意見の取りまとめ"@ja.
kg:id_2 rdf:type cls:c_1785.
cls:c_1785 rdfs:label "地域意見集約"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "遊佐町沖の洋上風力発電事業"@ja.
kg:id_3 rdf:type cls:c_781.
kg:id_4 rdfs:label "酒田港の基地港湾の指定を見据えた港湾施設整備の推進を国や山形県に働きかける"@ja.
kg:id_4 rdf:type cls:c_1786.
cls:c_1786 rdfs:label "港湾施設整備推進要請"@ja.
kg:id_3 prop:countermeasure kg:id_4.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "法定協議会において、山形県と連携して、地域の意見の取りまとめに注力していきます"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "遊佐町沖の洋上風力発電事業の拠点となる酒田港の基地港湾の指定を見据えた港湾施設整備の推進を国や山形県に働きかけます"@ja.
}
