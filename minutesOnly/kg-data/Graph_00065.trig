kg:st_1 rdfs:label "松前ウインドファーム合同会社"@ja.
kg:st_1 rdf:type cls:st_21.
cls:st_21 rdfs:label "事業者"@ja.
kg:op_1 prop:content "地権者や関係者、町民に心配をかけたことを謝罪"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地権者や関係者、町民に心配をかけたことを謝罪"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "今後２年間の工事で町民に心配をかけることを謝罪"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "町民"@ja.
kg:st_2 rdf:type cls:st_56.
cls:st_56 rdfs:label "町民"@ja.
kg:op_4 prop:content "風力発電施設建設における情報公開と地域の安心安全を要望"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "当町"@ja.
kg:st_3 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_5 prop:content "地権者や関係者と情報共有し町民とのトラブル防止を事業者に求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "環境保全と景観形成の観点から事業者の自主遵守事項を定める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "小型風車建設に伴う環境保全と景観形成を重視"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "加工原料不足で経営が厳しいと認識"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "原料価格高騰で経営が厳しいと認識"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "加工業者の経営悪化を深刻視"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "今春以降も原料確保が困難と認識"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "今後の加工場稼働の見通しが立たない事業所が多いと懸念"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "地域最大の雇用の場である加工場の雇用不安を深刻視"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "地域経済への影響が大きく深刻と認識"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "この状態が続けば国内生産のスルメ加工が消滅の危機に陥ると危機感"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "事業所の廃業や倒産による地域経済の疲弊を懸念"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "事業所の廃業や倒産による地域経済の疲弊を懸念"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "地域経済の疲弊に大きな危機感"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
