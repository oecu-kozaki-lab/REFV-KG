kg:id_16 rdf:type cls:c_117.
cls:c_117 rdfs:label "自治体"@ja.
kg:id_17 rdfs:label "現時点で健康調査を実施しない"@ja.
kg:id_17 rdf:type cls:c_1944.
cls:c_1944 rdfs:label "調査未実施"@ja.
kg:id_16 prop:countermeasure kg:id_17.
kg:id_18 rdfs:label "新エネルギービジョン・風力発電施設の建設ガイドライン"@ja.
kg:id_18 rdf:type cls:c_1945.
cls:c_1945 rdfs:label "計画指針"@ja.
kg:id_19 rdfs:label "調査結果に応じた見直し"@ja.
kg:id_19 rdf:type cls:c_1946.
cls:c_1946 rdfs:label "見直し"@ja.
kg:id_18 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "風力発電施設の建設ガイドライン"@ja.
kg:id_20 rdf:type cls:c_1806.
cls:c_1806 rdfs:label "設置指針"@ja.
kg:id_21 rdfs:label "風車から住宅までの距離基準の見直し"@ja.
kg:id_21 rdf:type cls:c_1947.
cls:c_1947 rdfs:label "距離基準見直し"@ja.
kg:id_20 prop:countermeasure kg:id_21.
kg:st_1 rdfs:label "質問者"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "質問者"@ja.
kg:op_1 prop:content "早急に健康調査を実施すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "風車問題伊豆ネットワーク"@ja.
kg:st_2 rdf:type cls:st_59.
cls:st_59 rdfs:label "住民団体"@ja.
kg:op_2 prop:content "短期間に被害が大量発生する特徴があると指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "酒田市も苦情地域と同じ環境にあり健康調査が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_3 rdfs:label "環境省"@ja.
kg:st_3 rdf:type cls:st_33.
cls:st_33 rdfs:label "行政機関"@ja.
kg:op_4 prop:content "苦情者の反応と風力発電施設の稼働状況との関連を今後調査する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "市当局答弁者"@ja.
kg:st_4 rdf:type cls:st_23.
cls:st_23 rdfs:label "行政担当者"@ja.
kg:op_5 prop:content "国が被験者実験で心理的・生理的影響を研究委託すると説明"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:op_6 prop:content "高齢者や持病のある住民が多い地域に低周波音が及んでいると指摘"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "苦情を受けて豊橋市、田原市、伊方町で調査を実施"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "発生源や感じ方、苦情との関連を今後調査する方針"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "住民被害の実態を独自に調査している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "全国の風車を対象に苦情の有無を調べ苦情施設は詳細調査すると説明"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "低周波音と苦情の関連や人への影響を研究する予定と説明"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
kg:op_12 prop:content "国の動向としてガイドライン策定予定を踏まえる考え"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_4.
kg:op_13 prop:content "現時点で苦情や健康被害情報がないため直ちに健康調査は必要ない"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "健康被害が確認された場合はビジョンやガイドラインに健康問題を加えて見直すべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "国の研究成果や調査結果によっては見直しの影響を受ける可能性がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "健康影響次第では設置場所を居住地から離す必要がある"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "現行200m基準は専門的調査結果によって見直しが必要となる可能性がある"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "風力発電施設から発生する騒音・低周波音による健康調査の実施についてお尋ねいたします"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "こうした被害の大量発生が、風車による20ヘルツ以下の低周波音を含む低周波騒音健康被害の特徴である"@ja.
<< kg:id_2 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "日本では、風車騒音、低周波音による健康被害について、専門家による疫学調査は全く行われておらず"@ja.
<< kg:id_2 prop:effect kg:id_5 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "苦情者の反応と風力発電施設の稼働状況との関連などについて調査するとしています"@ja.
<< kg:id_2 prop:effect kg:id_6 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "低周波音が人に対してどんな心理的、生理的影響を与えるのかといったようなことも研究委託をする"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "居住区は高齢者がほとんどであり持病を持っている方が多い、そこに風車の低周波音が襲ってきたと指摘しています"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "環境省は風力発電施設に関して低周波音の苦情が寄せられていることから、愛知県豊橋市、田原市、愛媛県伊方町で騒音、低周波音の実態把握のため調査をしました"@ja.
<< kg:id_8 prop:countermeasure kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "今後、周波数成分の発生源は何か、それらの音の発生実態や人の感じ方など、そして苦情者の反応と風力発電施設の稼働状況との関連などについて調査するとしています"@ja.
<< kg:id_11 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "風車問題伊豆ネットワークでは、２年前から風力発電による騒音、低周波音について調査をしております"@ja.
<< kg:id_8 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "全国の風力発電施設1,500を超える風車の風力設備があるわけでございますけれども、これを対象といたしまして苦情のあるなしという現況調査、それから苦情がある場合の施設につきましては、これは詳細調査を実施したいというふうな考えを述べられているようでございます"@ja.
<< kg:id_8 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "被験者実験というものを行って、低周波音が人に対してどんな心理的、生理的影響を与えるのかといったようなことも研究委託をする"@ja.
<< kg:id_8 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "平成23年度以降におきましては低周波音対策ガイドラインといったようなものも、これも策定をするというふうな、そんな予定のようでございます"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "現時点で風力発電施設から発生する騒音あるいは低周波音、こういったものに起因する苦情、それから健康被害といったような情報は現時点でございませんので、この現状を見てみますと直ちに健康調査の実施が必要であるという認識は持っておらないところから、現時点でこの調査の実施については考えていないということでございます"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "環境省が調査をして、もし影響があるとなった場合、そういうことも想定をして検討していかなければならないのじゃないかと思うんですけれども、その辺の認識についてはどんなものでしょうか。から、もう一点、風力発電のことのお尋ねですが、これは今年度から国が調査をする、加えて研究も委託をする、この研究の成果、それから調査結果によっては本市で策定いたしました新エネルギービジョン、それから風力発電施設の建設ガイドライン、こういった内容が一定の見直しの影響を受けるということもあるだろうと思っております"@ja.
<< kg:id_20 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "場合によっては設置場所、居住地から離さなければならない、そうするとガイドラインの見直しをしなければならない とりわけ風力発電につきましては風車から住宅までの距離、現行は200ｍといったようなガイドラインの内容になっておりますけれども、こういったあたりも影響を受けるか受けないか、専門的な調査結果によってはこれは見直しが必要ということも考えられるということでございます"@ja.
}
