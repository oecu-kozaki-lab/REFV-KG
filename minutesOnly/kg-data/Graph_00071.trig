kg:id_63 prop:countermeasure kg:id_64.
kg:st_1 rdfs:label "後藤孝也議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "普通建設事業費の拡大は地元経済への好影響が期待できる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "繰り越し事業と予算により今までにない大型予算になっている"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "合併特例法や過疎法の裏づけで積極的な予算編成が可能になった"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "市税は1％増でも低水準で、本格的な景気回復には至っていない"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "予算は合併特例債などに依存している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "予算は過疎債などに依存している"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "予算は特例交付金などに依存している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "合併後は市民の不安や混乱があった"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "一体感の醸成は施策推進に大きく役立った"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "一体感の旗印は市民の心を結集させた"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "一体感の醸成はこれまでのまちづくりに有効だった"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "日本全体の景気低迷が閉塞感を生んでいる"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "少子化が閉塞感の一因になっている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "高齢化が閉塞感の一因になっている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "人口減少社会の到来が閉塞感を強めている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "将来不安が閉塞感の直接的な要因だ"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "閉塞感を脱却すれば安心と開放感につながる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "閉塞感の解消は市民の協働意識を高める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "事業展開には基本となる柱が必要だ"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "事業効果を高めるには分かりやすいまちづくりビジョンが必要だ"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "市民に希望と安心感を持って参加してもらうため明確なビジョンを示すべきだ"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "合併の総仕上げには市民が共有できる旗印が必要だ"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "経済や雇用の転換には明確なまちづくりビジョンが必要だ"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "経済と雇用の発展には市の総力結集が必要だ"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:st_2 rdfs:label "平政会"@ja.
kg:st_2 rdf:type cls:st_60.
cls:st_60 rdfs:label "政治団体"@ja.
kg:op_25 prop:content "酒田のまちづくりビジョンの柱に新エネルギーを据えるべきだ"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "酒田のまちづくりビジョンの柱にリサイクルを据えるべきだ"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "酒田はエコタウンを目指すべきだ"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "酒田港戦略と産業構造整備はエコタウン構想を軸に進めるべきだ"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "関連企業の進出で港湾物流が活発になっている"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "酒田港周辺では企業進出により物流が活発化している"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "既存の下地を前面に出しリサイクル産業立地につなげる戦略が必要だ"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "船の解体・リサイクルは国際条約の動きで可能性が広がる"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "船舶リサイクル関連企業の育成や誘致を検討すべきだ"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "航空機リサイクルにも検討する価値がある"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "リサイクル分野では市が先導役となる体制が必要だ"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_1.
kg:op_36 prop:content "酒田市は風力発電に適した地域だ"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_1.
kg:op_37 prop:content "酒田市では波力発電の実験実績がある"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_1.
kg:op_38 prop:content "酒田市は多様な新エネルギーの可能性を持つ地域だ"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
kg:op_39 prop:content "地域資源を土台に新エネルギー開発と実証の拠点化を進めるべきだ"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "投資的経費の増の中で、普通建設事業費の拡大は地元経済に与える好影響を期待するものであります。"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "中身については１月の補正による平成23年度への繰り越し事業と予算を見れば、今までにない大型の予算編成であると思っております。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "合併特例法あるいは過疎法等の裏づけにより、大胆で積極的な予算づくりができたものだと思っております。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "基礎的な財源であります市税については１％増を見込んでいるものの、まだ低水準で推移しており、本来の景気回復にはほど遠い感があります。"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "合併特例債、過疎債あるいは特例交付金などでしのいでいる予算であることは間違いないところだと思います。"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "合併特例債、過疎債あるいは特例交付金などでしのいでいる予算であることは間違いないところだと思います。"@ja.
<< kg:id_9 prop:cause kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "合併特例債、過疎債あるいは特例交付金などでしのいでいる予算であることは間違いないところだと思います。"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "合併後の市民の心の不安や、動揺と混乱の中で、市長の掲げた新酒田市の一体感の醸成、これは市民一人一人の心の中に溶け込み、これまでの各施策の推進に大きな効果を与えてきたと思っているところであります。"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "市長の掲げた新酒田市の一体感の醸成、これは市民一人一人の心の中に溶け込み、これまでの各施策の推進に大きな効果を与えてきたと思っているところであります。"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "新市の一体感の醸成という市長の掲げた旗印は、市民の心の結集という大きな効果を生み出し、これまでのまちづくりに役立ってきたものだと思っております。"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "新市の一体感の醸成という市長の掲げた旗印は、市民の心の結集という大きな効果を生み出し、これまでのまちづくりに役立ってきたものだと思っております。"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "今、日本全体が景気の低迷、少子化、高齢化、そして人口減少社会の到来など、先行き不透明なことによる将来への不安が閉塞感を生み出していると考えるのであります。"@ja.
