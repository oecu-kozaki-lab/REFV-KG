PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00072> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "新エネルギーの拠点づくり"@ja.
kg:id_1 rdf:type cls:c_1990.
cls:c_1990 rdfs:label "エネルギー拠点整備"@ja.
kg:id_2 rdfs:label "地域新エネルギービジョンの見直しの必要性"@ja.
kg:id_2 rdf:type cls:c_271.
cls:c_271 rdfs:label "計画見直し"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "電気の地産地消"@ja.
kg:id_3 rdf:type cls:c_1991.
cls:c_1991 rdfs:label "電力の地産地消"@ja.
kg:id_4 rdfs:label "太陽光発電、バイオエネルギー発電、小水力発電、火力発電の増設を積極的に推進"@ja.
kg:id_4 rdf:type cls:c_1992.
cls:c_1992 rdfs:label "発電設備増設"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "新エネルギー戦略"@ja.
kg:id_5 rdf:type cls:c_1993.
cls:c_1993 rdfs:label "エネルギー戦略"@ja.
kg:id_6 rdfs:label "東北公益文科大学の産業連関表分析などからの知見を生かして推進"@ja.
kg:id_6 rdf:type cls:c_1994.
cls:c_1994 rdfs:label "分析知見活用"@ja.
kg:id_5 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "本市の役割"@ja.
kg:id_7 rdf:type cls:c_1995.
cls:c_1995 rdfs:label "自治体の役割"@ja.
kg:id_8 rdfs:label "大きな課題"@ja.
kg:id_8 rdf:type cls:c_1996.
cls:c_1996 rdfs:label "重要課題"@ja.
kg:id_7 prop:effect kg:id_8.
kg:id_9 rdfs:label "風力、波力の可能性と火力発電所、港を有していること"@ja.
kg:id_9 rdf:type cls:c_1997.
cls:c_1997 rdfs:label "エネルギー資源立地"@ja.
kg:id_7 prop:cause kg:id_9.
kg:st_1 rdfs:label "議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "基本計画を生かした新エネルギーの拠点づくりを構築すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "今後に備えて各種発電の増設を積極的に進めることが大切"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "大学の分析知見を生かして戦略を推進すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市長"@ja.
kg:st_2 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_4 prop:content "本市が一定の役割を果たしていくことは大きな課題"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "風力や波力の可能性に加え火力発電所と港があるため本市の役割は大きい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "地域新エネルギービジョンを見直し、企業立地促進法に基づく基本計画を生かした新エネルギーの拠点づくりを構築する必要性がある"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "太陽光発電、バイオエネルギー発電、小水力発電、火力発電の増設などを積極的に推進し、今後来るであろう電気の地産地消に備えることが大切"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "東北公益文科大学で行っている産業連関表分析などからの知見も生かしながら、新エネルギー戦略を推進すべき"@ja.
<< kg:id_7 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "風力、また波力の可能性もありますし、それから火力発電所なども有する本市において、本市が港もありますし一定の役割を果たしていくということは大きな課題だと思っております"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "風力、また波力の可能性もありますし、それから火力発電所なども有する本市において、本市が港もありますし一定の役割を果たしていく"@ja.
}
