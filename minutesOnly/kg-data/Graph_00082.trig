kg:st_1 rdfs:label "質問議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "卒原発に向かいたい趣旨は理解できる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "市長"@ja.
kg:st_2 rdf:type cls:st_2.
cls:st_2 rdfs:label "自治体首長"@ja.
kg:op_2 prop:content "大震災と原発事故後に再生エネルギー中心の戦略を示した点は評価できる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "大震災と原発事故後に再生エネルギー中心の戦略をいち早く示したことは評価できる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "適地としてできる範囲で県戦略の実現に力を貸したい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "再生可能エネルギー活用の重要性を市民に伝えたい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "再生可能エネルギー活用の重要性を市民に伝えたい"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "安全な自然エネルギーを活用する再生可能エネルギーへの国民的な期待は高まっている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "天然ガスの重要性は今後増すと思う"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "新エネルギーとしてのガス供給事業の動向を注目したい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "導入にはコストや法規制、技術、負担への理解と合意が重要である"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "導入にはコストや法規制、技術、負担への理解と合意が重要である"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "導入にはコストや法規制、技術、負担への理解と合意が重要である"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "国民の理解と合意も重要である"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "課題が解決され量産化されれば安くなる可能性はある"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "メンテナンス上の課題がある"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "漁業権等をクリアすれば可能な事業ではないか"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "漁業権の調整は課題である"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "課題が解決されれば安くなる可能性はある"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "発電所の拡張を含めたリニューアル要請こそ酒田市に必要な行動だ"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "老朽化した共同火力について今後も要望を行っていきたい"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "増設について東北電力や県などに要望している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:st_3 rdfs:label "無会派議員"@ja.
kg:st_3 rdf:type cls:st_9.
kg:op_22 prop:content "最大の論点の一つは景観上の問題だ"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "最大の論点の一つは市民との合意形成の進め方にある"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "一連の事業とみなすのが常識的ではないか"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "原発1基分の発電計画は余りにも現実味がない"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "その指摘には大体似たような感じを持っている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "不確定要素が多く軽々に踏み出さず慎重に考えるべきだ"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "固定価格買取制度が確約されているのか不確定で慎重に考えるべきだ"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "再生可能エネルギーはあくまで補完エネルギーだと思う"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "酒田共同火力の重要性を強く認識している"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "国民的な期待は高まっている"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "直営で行い市民への利益還元も最大となるよう進めたい"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "事業利益は市民のために使い還元していく"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:st_4 rdfs:label "議員"@ja.
kg:st_4 rdf:type cls:st_9.
kg:op_34 prop:content "わかりにくいことは市民に不安を与えるのでわかりやすいビジョンを示すべきだ"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_4.
kg:op_35 prop:content "市民に理解しやすいビジョンを策定したい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "固定価格買取制度が有利なうちに事業化を図りたい"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "老朽化した共同火力と増設について今後も要望していきたい"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "より具体的な事業を盛り込んだ計画にしたい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_2.
kg:op_39 prop:content "専門家の意見を得ながら取りまとめたい"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_2.
kg:op_40 prop:content "適地としての特性を生かしできる範囲で貢献したい"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_2.
kg:op_41 prop:content "市民にもっと具体的にわかりやすく発信し啓発すべきだ"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_4.
kg:op_42 prop:content "市民に十分知らせ積極的な広報を進めたい"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_2.
kg:op_43 prop:content "問題が解決され量産化されれば安くなる可能性がある"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_2.
kg:op_44 prop:content "地域の自然資源による利益は市民に還元していく"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_2.
kg:op_45 prop:content "できる限りわかりやすいビジョンを提示してほしい"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_4.
kg:op_46 prop:content "わかりやすく理解しやすいビジョンを策定したい"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_2.
kg:op_47 prop:content "危機管理を持って精査して当たるべきだ"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "県が丁寧なアセスメントと事業説明を行うよう指導を受けている"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "なぜ再生可能エネルギーなのかをもっと酒田市として訴えるべきだ"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_4.
kg:op_50 prop:content "新エネルギービジョンを基本に活用の重要性を市民に伝えたい"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "東日本大震災による福島第一原発の事故を受けて、再生可能エネルギーへの転換を図って、卒原発に向かいたいとの趣旨"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "県は大震災の後、それから原発事故の後、いち早く再生エネルギーを中心に据えた戦略を示した"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "庄内地域は風力発電の適地と位置づけられ、県全体で230基の風力発電の風車建設のうち、庄内地域では120から160基の風車が主に海岸沿いの風の強い地域に建設できる"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "地球温暖化あるいは大震災の電力不足、そして福島第一原発が契機になって、エネルギーのあり方が国民的な関心事"@ja.
<< kg:id_7 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "地球温暖化あるいは大震災の電力不足、そして福島第一原発が契機になって"@ja.
<< kg:id_7 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "福島第一原発が契機になって、エネルギーのあり方が国民的な関心事になった"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "これも震災以降、環境負荷に最大限配慮する動きもあって、現行以上に天然ガスの重要性が増す"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "シェールガスについては先日の日米首脳会談でも、オバマ大統領も輸出に前向きというふうな報道もされておりまして、注目度も高まっております"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "再生可能エネルギー導入にはコストや法規制、あるいは技術の問題"@ja.
<< kg:id_15 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "再生可能エネルギー導入にはコストや法規制、あるいは技術の問題"@ja.
<< kg:id_15 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "再生可能エネルギー導入にはコストや法規制、あるいは技術の問題"@ja.
<< kg:id_15 prop:cause kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "国民がどこまで電気料等の負担ができるかという理解、合意も重要"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "洋上風力の課題につきましては、陸上風力に比較しますと約２倍のイニシャルコストがかかる"@ja.
<< kg:id_20 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "稼働後の保守、メンテナンスが大変であるということ、メンテナンス上の課題もある"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "漁業権の調整、あるいは技術的な問題、課題"@ja.
<< kg:id_23 prop:cause kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "技術的な問題、課題というふうに言われております"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "今の火力発電所は老朽化しているというふうなこともございます"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "今回の震災によってもう一基必要なのではないか"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "今回の風力発電施設建設事業の最大の論点は、１つは、かつて民間開発を認めてこなかった景観上の問題"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "もう一つは市民との合意形成の進め方にある"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "隣り合わせた場所に同じような目的で進める事業の場合は、一連の事業とみなすのが常識的ではないでしょうか"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "再生可能エネルギーによって原発１基分の発電を計画するというのは余りにも現実味のない戦略のように思えてなりません"@ja.
<< kg:id_37 prop:effect kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "庄内地域に120から160基の風車を建設するということが果たして可能なのか"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "東北電力との固定価格買取制度が将来にわたって確約されたものなのかなど、不確定要素が多い"@ja.
<< kg:id_41 prop:effect kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "再生可能エネルギーはあくまでも補完エネルギーであると私は思っております"@ja.
<< kg:id_43 prop:effect kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "酒田共同火力は県内の電力安定供給上、極めて重要な役割を担っています"@ja.
<< kg:id_45 prop:effect kg:id_46 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "安全な自然エネルギーを活用する再生可能エネルギーへの国民的な期待は高まっております"@ja.
<< kg:id_47 prop:effect kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "私どもは直営で風力発電を行うということで、市民への利益還元も最大となるよう"@ja.
<< kg:id_49 prop:effect kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "必要な経費以外の事業利益については市民の皆さんのために使っていく、還元をしていく"@ja.
<< kg:id_51 prop:effect kg:id_52 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_34;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "わかりにくいことは市民には不安を与えますので、できる限りわかりやすいビジョンを提示していただきたい"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "この固定価格買取制度が有利に働くうちに、事業化が図られるように進めていきたい"@ja.
<< kg:id_43 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "東北電力あるいは東北経済産業局、それから県のほうなどに要望も行っておりますし、今後も要望を行っていきたい"@ja.
<< kg:id_56 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "できるだけ理念的なものから一歩踏み込んで、より具体的な事業を盛り込んだ再生可能エネルギーの導入活用計画としていきたい"@ja.
<< kg:id_58 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "環境分野の専門である環境審議会委員の皆さんにも御意見をいただきながら取りまとめをしていきたい"@ja.
<< kg:id_60 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "その適地としての特性を生かしながら、できる範囲で貢献をしてまいりたい"@ja.
<< kg:id_62 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_41;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "本市の持っている再生可能エネルギーのポテンシャル等については十分市民の皆さんにお知らせ、積極的な広報を進めていきたい"@ja.
<< kg:id_64 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "こうした問題が解決をされていく、あるいは解決された上で量産化をされていくといったような条件が整えば、安くなる可能性"@ja.
<< kg:id_66 prop:countermeasure kg:id_67 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "必要な経費以外の事業利益については市民の皆さんのために使っていく、還元をしていく"@ja.
<< kg:id_68 prop:countermeasure kg:id_69 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_45;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "わかりやすい、市民の皆さんにも理解しやすいビジョンを策定していきたい"@ja.
<< kg:id_70 prop:countermeasure kg:id_71 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "丁寧なアセスメントを行うことや、事業説明をしっかりと行うようになどの指導をいただいている"@ja.
<< kg:id_72 prop:countermeasure kg:id_73 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_49;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "酒田市としても現在見直しを行っております新エネルギービジョンを基本にしながら、再生可能エネルギーの活用の重要性を市民に伝えていきたい"@ja.
}
