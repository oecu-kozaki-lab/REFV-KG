kg:st_1 rdfs:label "後藤泉議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "景観上の問題について納得のいく議論になっていないと批判"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "市民との合意形成の進め方が不十分であると指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "環境省"@ja.
kg:st_2 rdf:type cls:st_33.
cls:st_33 rdfs:label "行政機関"@ja.
kg:op_3 prop:content "環境負荷の問題があるため法対象事業への追加が必要とする"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "法対象とすることで透明性の高い環境アセスが確保されると説明"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "法対象化により住民理解の進展を見込む"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "法対象化により環境と調和した立地促進につながるとする"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "法律によらない自主アセスでは審査過程を経ない点を問題視"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "自主アセスでは住民を納得させる評価書にならないと批判"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "市民還元を重視し過ぎて冷静な検討を欠いていると懸念"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "高い買取価格のうちに急いで建設しようとしていると批判"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "拙速な建設が冷静な検討時間を失わせると懸念"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "拙速な事業推進は将来に禍根を残すと危惧"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "行政自ら法定アセスを行わず進めることは容認できないと反対"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "問題が指摘されている以上、環境省に判断を仰ぐべきと主張"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "この問題は全国の関連業者や民間事業者から注目されていると指摘"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "自治体事業として全国の模範となる進め方をすべきと求める"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "不適切な事業推進は卒原発実行の足かせになり得ると警告"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "当局はこの問題の重要性について危機意識を持つべきと求める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "法律によらない自主アセスで進めることを反対理由とする"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "本来の論点に関する議論不足を反対理由とする"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "対外的に注目される問題である点も踏まえ慎重対応を求める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "現状のまま事業を進めることに反対"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "風力発電施設整備推進事業を理由に予算案に反対"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本来の論点でありました景観上の問題と市民との合意形成の進め方についても、私は納得のいく議論とはまだまだ言えるものではないと思っております"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "本来の論点でありました景観上の問題と市民との合意形成の進め方についても、私は納得のいく議論とはまだまだ言えるものではないと思っております"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "環境省が、大規模風力発電事業では全国的に環境への負荷に関する問題が出ていることで、風力発電施設の設置を法の対象事業として追加すべきとし"@ja.
<< kg:id_6 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "法対象とすることで透明性の高い環境アセスが確保され、住民の理解が進み、環境と調和した健全な立地が促進される"@ja.
<< kg:id_6 prop:effect kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "法対象とすることで透明性の高い環境アセスが確保され、住民の理解が進み、環境と調和した健全な立地が促進される"@ja.
<< kg:id_6 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "法対象とすることで透明性の高い環境アセスが確保され、住民の理解が進み、環境と調和した健全な立地が促進される"@ja.
<< kg:id_10 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "法律によらない自主アセスでは、関係省庁の勧告や審査の過程を経ないものとなり"@ja.
<< kg:id_10 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "住民を納得させられる評価書にはなり得ないものだと思います"@ja.
<< kg:id_1 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "本市が目的の一つに挙げている事業利益を市民に還元するということに余りにもとらわれ過ぎて"@ja.
<< kg:id_1 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "１円でも高い買取価格のうちに建設してしまおうとすることが"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "１円でも高い買取価格のうちに建設してしまおうとすることが逆に冷静に検討していく時間をなくし"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "将来に禍根を残すことにならないか大変危惧されるものです"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "行政みずからが国が求めている法定アセスをやらなくてもよいと判断して進めようとすることは、一議会人としてもとても容認できるものではありません"@ja.
<< kg:id_19 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "本来ならば指摘されている問題があるのですから、判断を仰ぐべきではないでしょうか"@ja.
<< kg:id_21 prop:effect kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "山形県と酒田市の動向は、全国的にもアセスを行っている業者やこれから風力発電事業をやろうとしている民間事業者にも注目されつつある問題だと聞いています"@ja.
<< kg:id_23 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "自治体がやろうとしている事業であります。全国的に模範となるような事業展開をしていくべきと思います"@ja.
<< kg:id_1 prop:effect kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "山形県知事が全国に発信した卒原発を実行していくことへの足かせにもなりかねません"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "それくらいに重要な問題だということを当局がみずから危機意識を持って自覚していくべきです"@ja.
<< kg:id_1 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "本予算案の環境影響評価をあくまでも法律によらない自主アセスで進めようとすること"@ja.
<< kg:id_1 prop:cause kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "また、本来の論点での議論が進んでいないこと"@ja.
<< kg:id_1 prop:cause kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "さらに、対外的にも注目されている問題であることを踏まえ"@ja.
<< kg:id_1 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "風力発電施設整備推進事業をこのまま進めていくことには賛成できるものではありません"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "よって、議第23号平成25年度酒田市一般会計予算には反対いたします"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:text-txt_contents "山形新幹線庄内延伸、旧ジャスコ跡地の再開発、風力発電施設の建設、津波浸水ハザードマップ、市の道路網図、農業振興地域土地利用計画図などをホームページ上に公開する総合型ＧＩＳ"@ja.
<< kg:id_36 prop:countermeasure kg:id_37 >>
    prop:text-txt_contents "小中学校に飲料水や食料、おむつや粉ミルクを備蓄する防災強化事業"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:text-txt_contents "集落営農組織の法人化を後押しする次世代中心経営体育成支援"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:text-txt_contents "米に頼らない産地形成を目指し園芸特産化支援センターを置いて特産品目の選定・技術指導を行う"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:text-txt_contents "県漁業組合飛島支所での氷不足を解消するためプレハブ式冷凍施設への補助"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:text-txt_contents "今回、企業誘致をしていただくプレステージ・インターナショナルに対し、雇用拡大につながる事業として、オペレーター席数に応じて１席当たり30万円を交付"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:text-txt_contents "老朽化が問題になっていた駅前と大通り商店街のアーケード撤去"@ja.
<< kg:id_48 prop:countermeasure kg:id_49 >>
    prop:text-txt_contents "ＬＥＤの街路灯整備費用の支援"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:text-txt_contents "未就学児までを対象にしていた通院医療費の無料化を小学３年生まで拡大"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:text-txt_contents "年中幼児から小学４年生までを対象にした英語で発信できる子供育成事業"@ja.
<< kg:id_54 prop:countermeasure kg:id_55 >>
    prop:text-txt_contents "空き家、空き地の売買、賃貸借のネットワークを構築し、昨年７月に施行した市空き家等の適正管理に関する条例を踏まえ、空き家の抑制、利活用を進める"@ja.
}
