kg:st_1 rdfs:label "市民"@ja.
kg:st_1 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "県や市の対応に不信感と疑問を抱く"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "後藤泉議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_2 prop:content "市民一丸での事業推進にはほど遠い状況だとみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "本来の論点は市民との合意形成のあり方にあると認識する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "本来の論点は景観の問題にあると認識する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "市民の合意形成に向けた話し合いはまだ十分理解されていないとみる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "説明会参加者"@ja.
kg:st_3 rdf:type cls:st_25.
cls:st_25 rdfs:label "参加者"@ja.
kg:op_6 prop:content "住民の納得できる答えがなかなか返ってこなかったと感じる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "説明会実施の既成事実だけを重ねても不信感を強めるだけだと批判する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "市民団体やクロマツ関連団体と市が積極的に話し合うべきだと求める"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:st_4 rdfs:label "前阿部市長"@ja.
kg:st_4 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_9 prop:content "原発事故以来価値観が変わったとして計画地への建設を発表した"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:st_5 rdfs:label "景観審議会"@ja.
kg:st_5 rdf:type cls:st_64.
cls:st_64 rdfs:label "審議会"@ja.
kg:op_10 prop:content "周囲の景観との調和には課題があると答申した"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "重大な景観保全に関わるため景観審議会に諮問すべきだと求める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:st_6 rdfs:label "県の環境審議委員の方"@ja.
kg:st_6 rdf:type cls:st_30.
cls:st_30 rdfs:label "委員"@ja.
kg:op_12 prop:content "そのような区分けは県の環境審議会で議論されていないと指摘する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_6.
kg:op_13 prop:content "コアジサシの県内唯一の繁殖地がある点を問題視する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "調査で課題が出た場合は建設場所を柔軟に変更すべきだと問う"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:st_7 rdfs:label "農家の方々"@ja.
kg:st_7 rdf:type cls:st_65.
cls:st_65 rdfs:label "農家"@ja.
kg:op_15 prop:content "日向川の土砂流入と水質悪化に大きな不安を抱く"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_7.
kg:op_16 prop:content "水生昆虫が全滅したかと思うほど川の状況がひどいとみる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:st_8 rdfs:label "田んぼの方々"@ja.
kg:st_8 rdf:type cls:st_5.
kg:op_17 prop:content "油臭のするシルト質土砂の流入に困っている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_8.
kg:st_9 rdfs:label "流域住民"@ja.
kg:st_9 rdf:type cls:st_5.
kg:op_18 prop:content "早急な対応を求める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_9.
kg:op_19 prop:content "上流に堰堤を設置してほしいと求める"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_9.
kg:op_20 prop:content "アユのすめる川に早く戻してほしいと求める"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_9.
kg:op_21 prop:content "大雨時の最悪の状況を想定した対策を求める"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_9.
kg:op_22 prop:content "情報が少なく対策状況が見えないことに不安を抱く"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_7.
kg:op_23 prop:content "行政の報告や説明が多すぎて委員間協議が不足していると指摘する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "旧中央公民館の役割低下が広域的な地域づくりの弱体化につながったとみる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "人材と組織が育たなくなり新しい企画が出にくくなったとみる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "青年団等の広域的な地域づくり団体が育ちにくくなっていると指摘する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "地域づくりの議論を増やすことが支所活性化につながると考える"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "3支所で活発な地域協議会づくりに取り組んでほしいと求める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "住民不在で景観問題の議論なく風車建設が進んだと批判する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "法アセスをしないと国の審査や意見がなくなることを危惧する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "上位行政の意見がなくなり判断主体が不明になることを心配する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "景観を行政運営の柱としてきた姿勢が損なわれていると批判する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "それを見た市民からは、県や市の対応への不信感や疑問が投げかけられているのも事実ではないでしょうか"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "今回の十里塚地区への風力発電施設整備事業には異論を唱える方たちも多く、市民一丸となったオール酒田での事業推進にはほど遠い状況ではないかと思います"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "私はそのときも申し上げたとおり、本来の論点は市民との合意形成のあり方と景観の問題にあると認識しています"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "私はそのときも申し上げたとおり、本来の論点は市民との合意形成のあり方と景観の問題にあると認識しています"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "市民の合意形成に向けての話し合いとしては、まだまだ理解されていないように思います"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "住民の納得できる答えはなかなか返ってこなかったと参加した方から伺いました"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "説明会をしましたという既成の事実だけを重ねるだけで事業を進めていくことは、ますます市民の不信感を助長していくだけで何の解決にもなりません"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "市が積極的に話し合いの場を持つべきと思います"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "前阿部市長は、景観の考え方は時代で変化する、原発事故以来価値観は変わったとして、今の計画地への風力発電施設の建設を発表しました"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:text-txt_contents "そこは過去２度にわたり民間の風力発電施設建設が計画されましたが、景観上の問題から認めてこなかった場所であります"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "周囲の景観との調和には課題があると答申され、建設が認められなかったという経緯があります"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "市長は景観審議会へ諮問し、議論してもらい、答申を受けるべきだと思います"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "県の環境審議委員の方にとっても、そのようなことは県の環境審議会で議論はされていないとのことです"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:text-txt_contents "建設計画地は国の鳥獣保護区に指定されている場所です"@ja.
<< kg:id_23 prop:effect kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "今回の計画地は絶滅危惧種に指定されているコアジサシの県内唯一の繁殖地があるとされています"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "調査していく上でいろいろな課題が出てきた場合に、建設場所を柔軟に変更していくお考えはおありなのか"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:text-txt_contents "鳥海山鹿ノ俣川上流の山腹大崩壊が起こり、そこから流れ出した油まじりの粘土質の土砂は下流域の日向川を汚染し"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:text-txt_contents "そこに生息する生物はもとより"@ja.
<< kg:id_26 prop:effect kg:id_29 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "日向川の清流を水源として農用地に取水していた農家の方々にも大きな不安を与える事態となっていました"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:text-txt_contents "シルト質の土砂は日向川の川底一面を覆うように流れ"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:text-txt_contents "きれいだった玉石は灰褐色のシルトがへばりつき"@ja.
<< kg:id_30 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "水生昆虫も全滅したかというくらいの無残な川の状況でありました"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "日向川から取水している田んぼの方々からも、少し油臭のするようなシルト質の土砂が入ってくるというので、何とかならないのかといった声が多く寄せられていました"@ja.
<< kg:id_34 prop:effect kg:id_36 >>
    prop:text-txt_contents "一旦雨が降り水かさがふえてくると、また白濁した土砂で濁った川に逆戻りというような繰り返しでありました"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "集まった大勢の方々からは、早急に対応を考えるべき"@ja.
<< kg:id_37 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "上流に堰堤をつくってほしい"@ja.
<< kg:id_37 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "早くアユのすめる川に戻してほしい"@ja.
<< kg:id_37 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "大雨のときの最悪の状況を考えた対策をすべき"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "昨年以来情報も余りない状況ですので、不安がっている方たちもいるようです"@ja.
<< kg:id_44 prop:countermeasure kg:id_45 >>
    prop:text-txt_contents "雪解けの水に備えオイルフェンスの取りつけ工事だったそうです"@ja.
<< kg:id_46 prop:cause kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "行政当局の報告や説明に費やされる時間が余りにも多く、委員間での協議時間が余りないという、変わらぬ状況のようでした"@ja.
<< kg:id_48 prop:cause kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "旧中央公民館が担ってきた役割が薄らいでしまったことから"@ja.
<< kg:id_48 prop:cause kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "人材、組織が育たなくなり"@ja.
<< kg:id_48 prop:cause kg:id_51 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "かつての青年団等のまちづくりにかかわってくるような広域的な地域づくりをしていく団体が育っていくことが難しい状況になってしまったことも、原因の一つであろうかと思います"@ja.
<< kg:id_52 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "いかに地域づくりについての議論が多くされるかということが、そのまま支所の活性化につながっていくのではないかなと思っております"@ja.
<< kg:id_52 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "ぜひ活発な地域協議会になるように、今後３支所のほうで頑張ってやっていっていただきたいと思っております"@ja.
<< kg:id_55 prop:cause kg:id_56 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "市民不在で、景観問題を議論することなく風車建設に至ってしまったというふうに、何か私はそういうふうな感じを受けるんですが"@ja.
<< kg:id_57 prop:effect kg:id_58 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "法にのっとったアセスをしないと、経済産業省や環境省の審査とか、そういったものがまるっきり関係なくなるんですよね"@ja.
<< kg:id_57 prop:effect kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "山形県の上の行政のほうからの、監督官庁のほうからの意見なんかはまるっきり出なくて、どこがそういった判断をされていくのか、その辺がすごい心配なわけです"@ja.
<< kg:id_60 prop:effect kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "特に景観の概念を行政運営の柱の一つに据えるとまで書かれているんですよ。そのような景観を重視した取り組みが必要なんだということを、酒田市としては考えてきてたわけです"@ja.
}
