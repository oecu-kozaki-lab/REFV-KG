kg:op_3 prop:content "地域特性を生かし風力発電事業を継続する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "大規模停電時に備え太陽光発電設備と蓄電池を設置する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "大規模停電時に備え太陽光活用街路灯を設置する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "歳出では、事業の決算見込み等により生じた財源を、財政調整基金及び市債管理基金等に積み立てるため、基金管理事業費の増額"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "事業の内容及び工程の見直しによる風力発電施設整備推進事業費の減額"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "保育単価の改定に伴う保育所入所扶助事業費の増額"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "施設の一部解体工事に係る工事内容の変更による旧食肉処理場施設維持管理事業費の増額"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:text-txt_contents "事業費の確定に伴う高畑山村広場整備事業費の減額"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:text-txt_contents "歳入では、市民税及び固定資産税の増収などにより市税を"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:text-txt_contents "前年度の国の経済対策に関連する国庫支出金"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:text-txt_contents "土地の売り払いに係る財産収入をそれぞれ増額するものであります"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "再生可能エネルギーの活用については、本市の地域特性を生かし、地域の活性化にもつなげていくため"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "災害等による大規模停電時の市民生活の安全・安心確保のため"@ja.
<< kg:id_21 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "再生可能エネルギーの活用については、本市の地域特性を生かし、地域の活性化にもつなげていくため、風力発電事業を継続して取り組んでまいります"@ja.
<< kg:id_21 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "また、災害等による大規模停電時の市民生活の安全・安心確保のため、ひらたタウンセンター等に太陽光発電設備と蓄電池"@ja.
<< kg:id_21 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "太陽光を活用した街路灯を設置いたします"@ja.
