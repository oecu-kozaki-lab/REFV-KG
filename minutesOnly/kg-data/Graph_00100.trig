<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "市営住宅砂越粕町団地の防風フェンスが台風21号の強風で飛ばされた"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "防風フェンスが台風21号の強風で飛ばされたことによる物損事故"@ja.
<< kg:id_4 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "このたびの補正は、額の確定に伴う国・県に対する償還金の増額"@ja.
<< kg:id_4 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "国の第一次補正予算の成立を受けて"@ja.
<< kg:id_4 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "一般会計予算を７億4,935万5,000円増額し、予算総額を534億4,383万3,000円とする"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "小中学校児童・生徒の熱中症対策として、学校空調設備整備事業費を新たに計上しております"@ja.
<< kg:id_10 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "低所得世帯への生活支援として灯油等購入費助成事業費を新たに計上"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "更生医療利用者の増により自立支援医療給付事業費を"@ja.
<< kg:id_14 prop:effect kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "生活保護世帯による医療費及び介護サービス利用の増により、生活保護扶助事業費をそれぞれ増額"@ja.
