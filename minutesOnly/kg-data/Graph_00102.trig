kg:id_49 prop:countermeasure kg:id_51.
kg:st_1 rdfs:label "後藤泉議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "ビジョン作成時との状況変化が著しく新たなビジョン策定が必要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "太陽光発電などの問題発生を踏まえ新たなビジョン策定が必要"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "無秩序な開発の歯どめや立地制限に踏み込む必要がある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "送電網容量が限界に近く誘致推進には懸念がある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "阿部勉企画部長"@ja.
kg:st_2 rdf:type cls:st_28.
cls:st_28 rdfs:label "部長"@ja.
kg:op_5 prop:content "送電網に空きがあれば事業者の投資意欲はある"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "ＦＩＴ価格が下がらなければ投資意欲は維持される"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "燃料調達が全国的に困難で日本全体の問題になる懸念がある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "外国燃料依存が進み日本全体で問題化する懸念がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "原料調達が厳しく事業判断は事業者に委ねられる"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "売り手市場で長期安定調達が難しい"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "木質バイオマス発電は地元林業従事者に大きな影響を与えるため市は地元との合意を重視すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "適地がないという意見もあり見直しは難しい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "再エネへの社会的高まりが十分でないため見直しは困難"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "国レベルも含む大きな流れがなければゾーニング見直しは不可能"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "震災後の社会情勢変化でビジョンの目的は一定程度達成された"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "ＦＩＴ開始により民間導入が進みビジョンの役割は果たされた"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "ビジョンは当初の役割を果たしたため新たな策定は計画していない"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "ＦＩＴ価格次第で高まりが薄れるため計画策定には限界がある"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "ビジョンがなくなると市の再生可能エネルギー方針が市民に見えなくなる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "燃料調達難と外国依存は近く日本全体の問題になる懸念がある"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "送電網に空きがあれば発電事業者を積極的に誘致したい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "木質バイオマスを含む再生可能エネルギーの増加は推進したい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "地元林業への影響を踏まえ地元合意を含めて丁寧に対応すべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "現行ガイドラインを据え置いて運用する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "県戦略の変化も踏まえ風力発電建設ガイドラインは見直すべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "風力以外は個別法規制の中で運用していく"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "風力以外についても市のポリシーを示したガイドラインが必要"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "新たなビジョンではなく県戦略と市総合計画に基づく具体的取り組みに移る"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "未達成部分も引き継ぎ新たな再生可能エネルギービジョンを策定すべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "ここに来て一挙に多くの事業者が固定価格買い取り制度、ＦＩＴを利用して発電事業に参入してきているようです"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "本市への再生可能エネルギーの立地状況などを踏まえれば、ビジョン作成時との状況の変化は著しいものとなってきているのではないかと思います"@ja.
<< kg:id_3 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "風力発電施設だけでなく、太陽光発電などでもあちこちで問題になっているように"@ja.
<< kg:id_3 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "無秩序な開発の歯どめや立地の制限などにも踏み込んだ、新たな再生可能エネルギービジョンは早急に策定する必要があるのではないか"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "酒田港周辺においても送電網の容量は既に限界に近いだろうということであります"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "受け口側の送電網の空きがあるようであれば、現状でＦＩＴの価格が下がらない限り、投資の意欲はあるのではないか"@ja.
<< kg:id_9 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "受け口側の送電網の空きがあるようであれば、現状でＦＩＴの価格が下がらない限り、投資の意欲はあるのではないか"@ja.
<< kg:id_12 prop:cause kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "燃料調達が全国的に困難だと書いてあって"@ja.
<< kg:id_12 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "外国の燃料だけに頼らざるを得ないのではないかという状況が、近く日本全体で問題になってくるのではないかと懸念"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "実際には木材、バイオマス、原料となるほうの調達に苦慮している"@ja.
<< kg:id_15 prop:cause kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "現状では売り手市場になってしまっていて、なかなか20年間、安定した価格での購入ができない状況になっている"@ja.
<< kg:id_18 prop:cause kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "木質バイオマス発電については、地元の林業の従事者に与える影響が物すごく大きくなると思います"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "極端な意見としては、酒田市内にはもう適地はないんだというような、そういった御意見の方もいらっしゃいますので、そういった意見がある中ではちょっと見直しはできないんじゃないかという判断"@ja.
<< kg:id_20 prop:cause kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "なお一層、再エネに対しての高まりが動かない限りは"@ja.
<< kg:id_20 prop:cause kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "そういった大きな流れになってこないと、そもそもゾーニングを見直すということについては現時点では不可能ではないかな"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "平成23年東日本大震災を契機に、エネルギーの安全性という視点から再生可能エネルギーに対して期待する社会情勢"@ja.
<< kg:id_24 prop:cause kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "電気の固定買取制度が平成24年にスタートすることなどで、民間事業者による再生可能エネルギーの導入が着実に進捗したことから、本ビジョンは当初の役割を果たしたものと判断"@ja.
<< kg:id_27 prop:cause kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "本ビジョンは当初の役割を果たしたものと判断し、現時点において新たなビジョンの策定は計画しておりません"@ja.
<< kg:id_29 prop:cause kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "ＦＩＴの価格に連動してしまうということが一番大きな問題になっていますので、我々が計画を策定しても、ＦＩＴの動きで高まりは薄れてしまう可能性も十分ある"@ja.
<< kg:id_31 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "酒田市としての再生可能エネルギービジョンみたいなやつのエネルギーに対する指針というか、そういったものがなくなってしまうと、じゃ、酒田市としては再生可能エネルギーに関して何を考えているのかということがわからなくなってしまう"@ja.
<< kg:id_33 prop:effect kg:id_34 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "外国の燃料だけに頼らざるを得ないのではないかという状況が、近く日本全体で問題になってくるのではないかと懸念"@ja.
<< kg:id_35 prop:effect kg:id_36 >>
    prop:text-txt_contents "太陽光発電所と木質バイオマス発電所のほか、多数の風力発電施設が立地をしており、平成16年の風車稼働開始から現在では18基が稼働し、発電出力は合計で３万4,270kwとなっております"@ja.
<< kg:id_37 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "そういった事業者の方がいらっしゃれば積極的に誘致をしたいと思っております"@ja.
<< kg:id_39 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "木質バイオマスによる発電ということについては、そういった再生可能エネルギーがふえることについては推進したいと思っております"@ja.
<< kg:id_41 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "市としても、もうちょっと積極的というよりも、きっちりと考えて、地元とのコンセンサスも含めて、いろいろとバイオマス発電事業者に対してはやっていただきたい"@ja.
<< kg:id_43 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "風力発電施設のガイドラインにつきましては、策定当初のものが今でも生きているという考え方です"@ja.
<< kg:id_43 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "酒田市としてもきちんとした再生可能エネルギーの中でも風力発電建設ガイドラインというものは、私は絶対的に見直していくべきだと思います"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "開発に当たっての個別の法規制がございますので、この個別の法規制の中で運用されていくものと承知しております"@ja.
<< kg:id_46 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "私は風力以外についても、酒田市としてのポリシーというか、そういったものをちゃんと示したガイドラインが必要なのではないかな"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "今後は県が策定をしました山形県エネルギー戦略、この戦略に基づいた取り組みとともに、新たに策定をしました酒田市の総合計画に掲げる主な施策...具体的な取り組みが必要"@ja.
<< kg:id_49 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "そういったことも引き継いで、さらに新たな再生可能エネルギービジョンとして、何としてもぜひ計画していくべきだと思います"@ja.
}
