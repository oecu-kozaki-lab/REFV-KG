PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00103> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電事業"@ja.
kg:id_1 rdf:type cls:c_218.
cls:c_218 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "山形県立自然公園条例に基づく手続を進める"@ja.
kg:id_2 rdf:type cls:c_2572.
cls:c_2572 rdfs:label "条例手続"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "再生可能エネルギーの活用と自然環境の保全の両立を図る"@ja.
kg:id_3 rdf:type cls:c_2573.
cls:c_2573 rdfs:label "環境両立"@ja.
kg:id_1 prop:countermeasure kg:id_3.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "現在、山形県立自然公園条例に基づく手続を進めています"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:text-txt_contents "再生可能エネルギーの活用と自然環境の保全の両立が図られるよう努めていきます"@ja.
}
