 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "風力発電事業特別会計予算"@ja.
kg:id_1 rdf:type cls:c_927.
cls:c_927 rdfs:label "特別会計予算"@ja.
kg:id_2 rdfs:label "新たに計上"@ja.
kg:id_2 rdf:type cls:c_2593.
cls:c_2593 rdfs:label "予算計上"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "風力発電事業"@ja.
kg:id_3 rdf:type cls:c_2601.
cls:c_2601 rdfs:label "事業"@ja.
kg:id_4 rdfs:label "特別会計を設置"@ja.
kg:id_4 rdf:type cls:c_2602.
cls:c_2602 rdfs:label "特別会計"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "風力発電事業特別会計"@ja.
kg:id_5 rdf:type cls:c_2602.
kg:id_6 rdfs:label "風力発電事業の円滑な運営とその経理の適正を図るため"@ja.
kg:id_6 rdf:type cls:c_567.
cls:c_567 rdfs:label "事業運営"@ja.
kg:id_5 prop:cause kg:id_6.
kg:id_7 rdfs:label "酒田移住交流推進事業費"@ja.
kg:id_7 rdf:type cls:c_2157.
cls:c_2157 rdfs:label "事業費"@ja.
kg:id_8 rdfs:label "県の補助事業の活用"@ja.
kg:id_8 rdf:type cls:c_2603.
cls:c_2603 rdfs:label "補助事業"@ja.
kg:id_7 prop:cause kg:id_8.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "議第60号については、風力発電事業特別会計予算を新たに計上し、予算総額を6,692万5,000円とするものであります。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:text-txt_contents "議第62号については、風力発電事業の円滑な運営とその経理の適正を図るため、風力発電事業特別会計を設置するものであります。"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:text-txt_contents "議第62号については、風力発電事業の円滑な運営とその経理の適正を図るため、風力発電事業特別会計を設置するものであります。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:text-txt_contents "また、県の補助事業を活用して酒田移住交流推進事業費を増額しております。"@ja.
}
