PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00110> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "酒田市風力発電事業"@ja.
kg:id_1 rdf:type cls:c_1.
cls:c_1 rdfs:label "風力発電事業"@ja.
kg:id_2 rdfs:label "発電所建設着工"@ja.
kg:id_2 rdf:type cls:c_938.
cls:c_938 rdfs:label "発電所建設"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "2021年初頭の運転開始を目指す"@ja.
kg:id_3 rdf:type cls:c_926.
cls:c_926 rdfs:label "運転開始"@ja.
kg:id_1 prop:countermeasure kg:id_3.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "本市が十里塚地区で行う風力発電事業については、10月ごろからの発電所建設着工を予定し"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:text-txt_contents "2021年初頭の運転開始を目指します"@ja.
}
