PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00119> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "洋上風力発電の導入"@ja.
kg:id_1 rdf:type cls:c_218.
cls:c_218 rdfs:label "発電事業"@ja.
kg:id_2 rdfs:label "いろんな方が関心を持っていること"@ja.
kg:id_2 rdf:type cls:c_2852.
cls:c_2852 rdfs:label "関心"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "県の取組"@ja.
kg:id_3 rdf:type cls:c_2853.
cls:c_2853 rdfs:label "行政の取組"@ja.
kg:id_1 prop:countermeasure kg:id_3.
kg:id_4 rdfs:label "洋上風力発電"@ja.
kg:id_4 rdf:type cls:c_218.
kg:id_5 rdfs:label "施政方針に掲載される重要な項目であること"@ja.
kg:id_5 rdf:type cls:c_2854.
cls:c_2854 rdfs:label "重要項目"@ja.
kg:id_4 prop:effect kg:id_5.
kg:id_6 rdfs:label "洋上風力発電についての質問"@ja.
kg:id_6 rdf:type cls:c_2855.
cls:c_2855 rdfs:label "質問"@ja.
kg:id_7 rdfs:label "質問内容を変えること"@ja.
kg:id_7 rdf:type cls:c_2856.
cls:c_2856 rdfs:label "内容変更"@ja.
kg:id_6 prop:countermeasure kg:id_7.
kg:st_1 rdfs:label "質問者"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "質問者"@ja.
kg:op_1 prop:content "沖合何キロになるのかを気にしている"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "重要な項目なので施政方針に載っていると述べる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "委員長（菅原和幸君）"@ja.
kg:st_2 rdf:type cls:st_75.
cls:st_75 rdfs:label "議事進行者"@ja.
kg:op_3 prop:content "遊佐町の権限外の内容なので質問内容を変えるよう求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "町の独自予算はないが重要なので施政方針に載っているとみている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "権限外については発言を控える申合せがあるため質問内容の変更を求める"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "洋上風力についてはいろんな方が関心をお持ちですから、そういったところで聞く"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "遊佐沖における洋上風力発電の導入に向けた県の取組"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "このようにして重要な項目なので、施政方針の中に載っているわけです"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "権限外については発言を控えるというような表現もございますので、質問の内容を変えていただきたいと思います"@ja.
}
