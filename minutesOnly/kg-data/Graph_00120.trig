kg:st_1 rdfs:label "質問者"@ja.
kg:st_1 rdf:type cls:st_16.
cls:st_16 rdfs:label "質問者"@ja.
kg:op_1 prop:content "コロナを踏まえ洋上風力発電の重要性は高まる"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "財源がスムーズに出せるか心配している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "遊佐部会"@ja.
kg:st_2 rdf:type cls:st_63.
cls:st_63 rdfs:label "地域組織"@ja.
kg:op_3 prop:content "景観や騒音などの環境への影響について検討してきた"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "漁業振興等について検討してきた"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:st_3 rdfs:label "県からの情報を伝える答弁者"@ja.
kg:st_3 rdf:type cls:st_55.
cls:st_55 rdfs:label "答弁者"@ja.
kg:op_5 prop:content "有望区域の選定は当初より遅れ6月頃になる見込み"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "今後の会議開催は不透明な状況である"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:st_4 rdfs:label "答弁者"@ja.
kg:st_4 rdf:type cls:st_55.
kg:op_7 prop:content "地域の合意形成が本当に大事で重要だ"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:op_8 prop:content "事業が地域振興と産業振興につながるよう県に進めてほしい"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "町民がよかったと思える結果につながるよう進めてほしい"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "脱炭素社会の実現は待ったなしの課題だ"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "再生可能エネルギーへの移行に積極的に取り組む必要がある"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_4.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "そういう再生可能エネルギー、これの重要性がコロナによって、エネルギーもやっぱり自給自足というふうなことが望ましいということがありまして、これからその洋上風力発電の重要性が高まる"@ja.
<< kg:id_3 prop:effect kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "これは相当程度の公共投資になりますので、その財源がスムーズに出るべきところから出せるのかということが心配あります"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:text-txt_contents "洋上風力発電事業につきましては、山形県が主導で実施してございます"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "再生可能エネルギーの主力電源化によります地球温暖化対策"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "エネルギー自給率の向上、そして県内産業の振興、地域活性化を図るエネルギー戦略の下、自然エネルギーを活用した再生可能エネルギーの開発や促進、地域導入を進めてございます"@ja.
<< kg:id_10 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "県内産業の振興、地域活性化を図るエネルギー戦略の下、自然エネルギーを活用した再生可能エネルギーの開発や促進、地域導入を進めてございます"@ja.
<< kg:id_11 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "地域活性化を図るエネルギー戦略の下、自然エネルギーを活用した再生可能エネルギーの開発や促進、地域導入を進めてございます"@ja.
<< kg:id_3 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "県では、平成29年度より可能性に係ります気象調査を実施いたしまして"@ja.
<< kg:id_3 prop:countermeasure kg:id_13 >>
    prop:text-txt_contents "平成30年度から令和元年度、２か年におきまして町民説明会"@ja.
<< kg:id_3 prop:countermeasure kg:id_14 >>
    prop:text-txt_contents "そして地域部会、また全体会におきまして検討会これまで重ねてきてございます"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "洋上風力の計画の可否や景観、騒音などの環境への影響、また漁業振興等について検討を行ってきた"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "洋上風力の計画の可否や景観、騒音などの環境への影響、また漁業振興等について検討を行ってきた"@ja.
<< kg:id_18 prop:countermeasure kg:id_19 >>
    prop:text-txt_contents "今後遊佐沖が有望区域に選定されれば、法定協議会の設置がなされ"@ja.
<< kg:id_18 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "促進地域の指定に向け協議がなされていくことになると思います"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:text-txt_contents "新型コロナウイルスの影響によりまして、洋上風力発電の有望区域の選定"@ja.
<< kg:id_22 prop:effect kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "当初は５月頃ということでございましたけれども、６月頃になるのではないかなというふうにお聞きしてございます"@ja.
<< kg:id_22 prop:effect kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "法定協議会の設置が決定になった場合におきましても、今後の会議の開催は不透明な状況である"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:text-txt_contents "事業への参加希望の業者が共同で現地での風況調査、そして併せまして海域調査、この６月下旬より現地のほうで実施する"@ja.
<< kg:id_3 prop:countermeasure kg:id_27 >>
    prop:text-txt_contents "調査内容につきましては、この６月の広報お知らせ号で内容を皆様にお知らせしたい"@ja.
<< kg:id_3 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "再生可能エネルギーとして期待される洋上風力発電事業につきましては、地域の合意形成が本当に大事だと思います。重要だと思います"@ja.
<< kg:id_3 prop:effect kg:id_29 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事業が地域振興、産業振興につながりますよう"@ja.
<< kg:id_3 prop:effect kg:id_30 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "また町民の皆さんがよかったというふうな結果につながりますように"@ja.
<< kg:id_31 prop:cause kg:id_32 >>
    prop:text-txt_contents "気候変動に起因する自然災害は世界中で多発してございます"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:text-txt_contents "気候変動に起因する自然災害は世界中で多発してございます"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:text-txt_contents "日本でも毎年のように豪雨や台風など大きな自然災害が発生している状況でございます"@ja.
<< kg:id_36 prop:cause kg:id_37 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "気候変動に起因する自然災害は世界中で多発してございます。日本でも毎年のように豪雨や台風など大きな自然災害が発生している状況でございますので、脱炭素社会の実現は待ったなしの課題"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "再生可能エネルギーへの移行については積極的に取り組んでいく必要がある"@ja.
}
