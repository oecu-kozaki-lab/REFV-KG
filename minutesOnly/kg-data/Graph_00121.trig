kg:id_178 prop:countermeasure kg:id_179.
kg:id_180 rdfs:label "泊まってお得キャンペーン"@ja.
kg:id_180 rdf:type cls:c_2971.
cls:c_2971 rdfs:label "宿泊支援"@ja.
kg:id_181 rdfs:label "町内宿泊施設利用者への1人3000円助成"@ja.
kg:id_181 rdf:type cls:c_2972.
cls:c_2972 rdfs:label "宿泊助成"@ja.
kg:id_180 prop:countermeasure kg:id_181.
kg:id_182 rdfs:label "ＧｏＴｏトラベル助成金との重複利用"@ja.
kg:id_182 rdf:type cls:c_2973.
cls:c_2973 rdfs:label "併用利用"@ja.
kg:id_180 prop:countermeasure kg:id_182.
kg:id_183 rdfs:label "国保税減免"@ja.
kg:id_183 rdf:type cls:c_2974.
cls:c_2974 rdfs:label "税負担軽減"@ja.
kg:id_184 rdfs:label "コロナ禍による収入落ち込みに応じた減免"@ja.
kg:id_184 rdf:type cls:c_2975.
cls:c_2975 rdfs:label "保険減免"@ja.
kg:id_183 prop:countermeasure kg:id_184.
kg:id_185 rdfs:label "介護保険料減免"@ja.
kg:id_185 rdf:type cls:c_2974.
kg:id_185 prop:countermeasure kg:id_184.
kg:id_186 rdfs:label "コロナ禍による納税負担"@ja.
kg:id_186 rdf:type cls:c_2976.
cls:c_2976 rdfs:label "納税負担"@ja.
kg:id_187 rdfs:label "住民税や固定資産税の１年間の徴収猶予"@ja.
kg:id_187 rdf:type cls:c_2977.
cls:c_2977 rdfs:label "徴収猶予"@ja.
kg:id_186 prop:countermeasure kg:id_187.
kg:st_1 rdfs:label "日本共産党地区委員会"@ja.
kg:st_1 rdf:type cls:st_76.
cls:st_76 rdfs:label "政治組織"@ja.
kg:op_1 prop:content "町長に酒田市への保健所設置と要員配置を要望"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "佐藤光保議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_2 prop:content "コロナ危機を気候変動がもたらした危機とみる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "温暖化は人間の環境破壊によって起きている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "感染症問題は地球環境の危機でもある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "よりよい再建のため法定アセスメントが必要"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "時田町長"@ja.
kg:st_3 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_6 prop:content "県の取組背景に地球温暖化対策がある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "県の取組背景にエネルギー自給率向上がある"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "県の取組背景に県内産業振興がある"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "県の取組背景に地域経済活性化がある"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "震災経験を踏まえ安全安心なエネルギー確保を課題としている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "原発事故経験を踏まえ安全安心なエネルギー確保を課題としている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "地域に根差したエネルギー活用は町の責務"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "環境自治体を標榜する町の責務として進める"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "庄内沖の風況の良さを前提に議論が進められている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "課題抽出や対応策の議論のため検討会議を設置"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "具体的な検討のため地域部会を設置した"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "県が国に法定協議会設置を要望した"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "遊佐沖は事業化に向けた準備が進んでいる区域に位置づけられた"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "法律に基づく手順に従い事業が進められると考える"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "説明会開催を通じ理解促進を県に働きかける"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:st_4 rdfs:label "地域生活課長"@ja.
kg:st_4 rdf:type cls:st_67.
cls:st_67 rdfs:label "行政職"@ja.
kg:op_21 prop:content "大規模事業は環境への著しい影響のおそれがあるためアセス対象となる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_4.
kg:op_22 prop:content "事業者自らの環境影響検討と公表が必要"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_4.
kg:op_23 prop:content "広く町民や自治体の意見を聞く必要がある"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_4.
kg:op_24 prop:content "環境保全の観点から事業計画を改善していく制度である"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_4.
kg:op_25 prop:content "計画規模が法アセス対象基準を超えるため対象事業となる"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "配慮書、方法書、準備書、評価書の段階で手続を進める"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_4.
kg:op_27 prop:content "各段階で計画報告や縦覧とともに町民説明会を行う"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_4.
kg:st_5 rdfs:label "齋藤武議員"@ja.
kg:st_5 rdf:type cls:st_9.
kg:op_28 prop:content "風車が林立すれば町の景観をがらりと変える可能性がある"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_5.
kg:op_29 prop:content "最大高さ260メートル級の風車が数十基立てば相当な存在感になる"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "再生可能エネルギーでも環境や生活への配慮が不可欠"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_5.
kg:op_31 prop:content "地域住民の合意形成を得ながら慎重に進めるべき"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_5.
kg:op_32 prop:content "合意形成の第一歩は町民の関心を高めること"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_5.
kg:op_33 prop:content "町は関心喚起と合意形成により積極的に役割を果たすべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:op_34 prop:content "部会で環境影響や対応策の検討を行っている"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "事業の周知を図るため各地区で住民説明会を開催した"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "震災経験が安全安心なエネルギー確保の課題認識につながっている"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "原発事故経験が再生可能エネルギー導入の背景にある"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "町は地域と寄り添って議論の場をつくってきたし今後も続けるべき"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "過去の陸上風車導入時にはガイドラインを整備した"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "リスク発生時の対応のため協定書を整えた"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "過去には風車の影響でテレビ受信障害が起きた"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "協定書に基づき共同アンテナで対応した"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "コロナの時代にはそれなりの対応が必要だと痛感した"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "遊佐地区と高瀬地区で町職員も参加して確認する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "３密を避けた設営に時間がかかる課題がある"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "課題解決を図り万が一に備える"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "消費影響を緩和し地域経済維持を図るため計画した"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "地域経済維持のために商品券事業を実施した"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "経済の立て直しを優先するために計画した"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "平等性に配慮して販売条件を設定した"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:op_51 prop:content "約半数の世帯購入にとどまり周知の十分性を見直す必要がある"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "十分でないなら周知方法を全面的に考え直す"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "完売後は使い残し防止の周知を重視する"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "秋冬版も平等性を重視して販売する"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "感染拡大で雇用悪化に歯止めがかかっていない"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_2.
kg:op_56 prop:content "経済の冷え込みで休業者数が高止まりしている"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_2.
kg:op_57 prop:content "失業や解雇や雇い止めが増えている"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_2.
kg:op_58 prop:content "実現させた制度の継続と拡充が必要"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "感染拡大防止と地域支援のため創設された交付金である"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_3.
kg:op_60 prop:content "第一次交付限度額を超える規模で12事業を進めている"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_3.
kg:op_61 prop:content "９月末を期限に第二次実施計画を取りまとめている"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:op_62 prop:content "来年度以降もウィズコロナの中で独自対策を図りたい"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_3.
kg:op_63 prop:content "給食無償化は小中9年間だけでなく就学前も含めて総合的に考えるべき"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_3.
kg:op_64 prop:content "町は以前から幼稚園保育園の無料化を推進してきた"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_3.
kg:op_65 prop:content "町財政を踏まえ給食費は実費負担としてきた"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_3.
kg:op_66 prop:content "財源や自主財源の制約から一言で無償化とはいかない"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_3.
kg:op_67 prop:content "特定年齢層だけでなく広い世代を俯瞰した支援を行った"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_3.
kg:op_68 prop:content "外出自粛の影響で心身の不調や生活困窮が生じている"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_3.
kg:op_69 prop:content "保健所は相談や検査受付や連絡調整など困難な業務を担っている"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_3.
kg:op_70 prop:content "今後も感染拡大を想定し体制強化と人材育成が必要"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_3.
kg:op_71 prop:content "権限移譲により市町村の対応課題が複雑化している"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_3.
kg:op_72 prop:content "今回の教訓を踏まえ新しい生活様式を取り入れる"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_3.
kg:op_73 prop:content "より一層の体制強化に向けマンパワー確保に努める"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_3.
kg:st_6 rdfs:label "産業課長"@ja.
kg:st_6 rdf:type cls:st_67.
kg:op_74 prop:content "全国的な需要減が農家に深刻な影響を与えている"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_6.
kg:op_75 prop:content "外食需要の冷え込みが米価格低下につながっている"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_6.
kg:op_76 prop:content "在庫増加により今年産米価への影響が懸念される"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_6.
kg:op_77 prop:content "コロナに負けない主食用ブランド力強化を図る"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_6.
kg:op_78 prop:content "花卉の需要喚起策を実施する"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_6.
kg:op_79 prop:content "情勢を注視し実情に即した支援を講じたい"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_6.
kg:op_80 prop:content "ハローワークとの情報交換では町内で雇い止め等の影響は確認されていない"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_6.
kg:op_81 prop:content "具体名は把握していないが交付を受けている企業がある"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_6.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "基本計画の中で掲げている、インターチェンジから道の駅にアクセスする際の利便性を重視した接続方法の実現に向けて、７月20日に山形県県土整備部長に要望書を提出しました"@ja.
<< kg:id_1 prop:countermeasure kg:id_3 >>
    prop:text-txt_contents "これまで検討してきたことの再確認や課題の洗い出しを図るべく、８月26日に国土交通省・山形県・遊佐町による第８回目となる勉強会を行いました"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "感染症対策で保健所の役割が重要であることが明らかになりました"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "酒田市に保健所を設置し、要員を配置することを求めてはいかがでしょうか。これは、４月28日に日本共産党地区委員会でも町長に要望した中身となっております"@ja.
<< kg:id_8 prop:cause kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "気候変動がもたらしたコロナ危機とも言われます"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "温暖化は、人間が環境を破壊することから起きており"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "感染症問題と同じ地球環境の危機です"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "遊佐町沖洋上風力発電事業について、持続可能な開発目標、ＳＤＧｓにある気候変動対策の視点から客観性を伴う法定アセスメントを要すると考えます"@ja.
<< kg:id_16 prop:cause kg:id_17 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギー自給率の向上並びに県内産業の振興及び地域経済活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_16 prop:cause kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギー自給率の向上並びに県内産業の振興及び地域経済活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_16 prop:cause kg:id_19 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギー自給率の向上並びに県内産業の振興及び地域経済活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_16 prop:cause kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギー自給率の向上並びに県内産業の振興及び地域経済活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "遊佐町においても、東日本大震災や福島第一原子力発電所の事故の経験を踏まえ、安全、安心なエネルギーを確保することを課題とし"@ja.
<< kg:id_21 prop:cause kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "遊佐町においても、東日本大震災や福島第一原子力発電所の事故の経験を踏まえ、安全、安心なエネルギーを確保することを課題とし"@ja.
<< kg:id_21 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "エネルギーの地産地消によるまちづくりを基本理念とする遊佐町エネルギー基本計画を策定しており"@ja.
<< kg:id_21 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "再生可能エネルギーの導入を進める中で、地域に根差したエネルギーの活用を図っていくことは、環境自治体を標榜する遊佐町の責務でもあると認識をしております"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "庄内沖は恵まれた風況にあるなど大きな可能性があることを前提に"@ja.
<< kg:id_26 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "一般海域における洋上風力発電の在り方に係る地域の合意形成に向け、課題の抽出や対応策等の議論を行うとともに、関係者間の理解促進に資する調査研究を行うため、海域利用性や経済団体、関係行政機関などによる山形県地域協調型洋上風力発電研究・検討会議が平成30年７月に設置されております"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "さらに具体的な検討を行うための地域部会として、遊佐町の沿岸を対象とした遊佐沿岸域検討部会が同じく７月に設置され"@ja.
<< kg:id_31 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "本年２月には、山形県において法定協議会の設置について国に要望し"@ja.
<< kg:id_31 prop:effect kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "先々月遊佐沖については一定の準備が進んでいる区域として含まれたところであります"@ja.
<< kg:id_34 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "国の環境アセスメント法、法律に基づいた種々の手配書、準備書、配慮書等の手順に従い事業が進められるものと考えております"@ja.
<< kg:id_34 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "今後も引き続き地域や漁業関係者に事業の周知を行うため、事業説明会等の開催を行いながら、理解の促進を図っていただけるよう県に働きかけていきたいと考えております"@ja.
<< kg:id_37 prop:effect kg:id_38 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "土地の形状の変更や工作物の新築等の開発事業で、規模が大きく、環境に著しい影響を及ぼすおそれのあるものについて"@ja.
<< kg:id_37 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "事業者が自ら環境影響について検討し、その結果につきまして公表し"@ja.
<< kg:id_37 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "広く町民や地方公共団体の意見をお聞きしまして"@ja.
<< kg:id_37 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "環境の保全の観点から、よりよい事業計画をつくり上げていこうとする制度でございます"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:text-txt_contents "１つ目につきましては、生物の多様性の確保及び自然環境の体系保全に係る項目でございます"@ja.
<< kg:id_42 prop:countermeasure kg:id_44 >>
    prop:text-txt_contents "２つ目といたしましては、環境への負荷に係る項目でございます。例えば廃棄物等、温室効果ガス等への影響評価ということになってきます"@ja.
<< kg:id_42 prop:countermeasure kg:id_45 >>
    prop:text-txt_contents "３つ目でございますけれども、環境の自然的構成要素の良好な状態の保持に係る項目ということでございます"@ja.
<< kg:id_42 prop:countermeasure kg:id_46 >>
    prop:text-txt_contents "最後、４点目でありますけれども、人と自然との豊かな触れ合いに関わる項目で、４点、４項目につきまして調査、予測及び評価を行う"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "法アセスの対象となる風力発電による出力対象事業規模でございますけれども、１万キロワット以上、超える場合が対象となってくるということで法のほうにうたわれてございます。現在の計画段階評価の配慮書ということで、手続一部始まってございますけれども、そちらの事業規模見てみますと、総発電出力規模が43万キロワットから50万キロワットということで、１万キロを超えるということでございますので、法アセスの対象となる事業"@ja.
<< kg:id_47 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "環境アセスメントにつきましては、先ほど町長答弁にございましたけれども、配慮書、方法書、準備書、評価書ということで、段階を踏みながら作業を進めていくことになり"@ja.
<< kg:id_47 prop:effect kg:id_50 >>
    prop:text-txt_contents "環境アセスメント期間につきましては、おおむね３年から４年要しますということで言われてございます"@ja.
<< kg:id_47 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "その都度、計画の報告、縦覧を行いまして、町民の皆様の意見を聞くとともに、事業者による町民説明会を実施していくことになります"@ja.
<< kg:id_47 prop:countermeasure kg:id_52 >>
    prop:text-txt_contents "町でも環境審議会を開催しまして、町としての意見を県知事へ提出することになります"@ja.
<< kg:id_47 prop:countermeasure kg:id_53 >>
    prop:text-txt_contents "町の意見を受けまして、県のほうでも環境影響評価審査会を開催し、その意見を国のほうへ提出しまして、審査を経た後、事業者へ確定通知を発することになってきます"@ja.
<< kg:id_37 prop:effect kg:id_54 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "このように洋上風力発電の稼働は、大げさではなく、この町の景観をがらりと変える可能性があり"@ja.
<< kg:id_37 prop:effect kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "もし最大高さが260メートル程度の風車が数十基林立すれば、それだけ相当な存在感があるはずです"@ja.
<< kg:id_56 prop:effect kg:id_57 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "自然環境や生活環境を考慮せずに再生可能エネルギーを追い求めることは本末転倒であり"@ja.
<< kg:id_37 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "特に地域住民の合意形成を得ながら慎重に話を進める必要があります"@ja.
<< kg:id_37 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "その第一歩が町民に関心を持っていただくことだと思います"@ja.
<< kg:id_37 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "町は、町民の関心を高めることと、合意形成に向けて、より積極的に役割を果たすべきと考えます"@ja.
<< kg:id_37 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "これまで開催された部会においては、騒音、景観、魚類及び鳥類などの環境への影響並びに漁業関係者などの研究、検討課題の洗い出しや対応策の検討などを行い"@ja.
<< kg:id_37 prop:countermeasure kg:id_62 >>
    prop:text-txt_contents "長崎県五島市への先進地視察などを行うとともに"@ja.
<< kg:id_37 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "事業の周知を図るため、平成30年度と令和元年度の２回にわたり、蕨岡、遊佐、稲川、西遊佐、高瀬、吹浦、各地区において住民説明会を開催したところであります"@ja.
<< kg:id_37 prop:cause kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "東日本大震災や福島第一原子力発電所事故の経験を踏まえ、安全、安心なエネルギーを確保することを課題とし"@ja.
<< kg:id_37 prop:cause kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "東日本大震災や福島第一原子力発電所事故の経験を踏まえ、安全、安心なエネルギーを確保することを課題とし"@ja.
<< kg:id_37 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "町は何もこうでなければならないではなくて、常に地域の皆さんと寄り添って議論の場をつくってきたということは間違いない事実だと思いますし、それらについてはやっぱりこれからも町は続けていかなければならないものだと思っております"@ja.
<< kg:id_47 prop:countermeasure kg:id_65 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "町としてはガイドラインを持っていませんでした。そして、リスク管理、ではリスクが出たらどうしましょうやという形の協定書のたたき台も町では何ら持っていませんでした。それらをしっかり整えて、順序よく整えてきました"@ja.
<< kg:id_47 prop:countermeasure kg:id_66 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "リスク管理、ではリスクが出たらどうしましょうやという形の協定書のたたき台も町では何ら持っていませんでした。それらをしっかり整えて"@ja.
<< kg:id_47 prop:effect kg:id_67 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "試運転始まったらテレビが映らなくなったと、羽根で"@ja.
<< kg:id_47 prop:countermeasure kg:id_68 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "それも協定書に基づいて、しっかり共同アンテナという形でしていただきました"@ja.
<< kg:id_69 prop:cause kg:id_70 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "やっぱり今の時代、新しい時代、コロナの時代にはそれなりの対応が必要だなということを痛切に感じた"@ja.
<< kg:id_69 prop:countermeasure kg:id_71 >>
    prop:text-txt_contents "今年４月に国が自治体に対して避難所での感染予防のための対応を講ずるよう通知を発し"@ja.
<< kg:id_69 prop:countermeasure kg:id_72 >>
    prop:text-txt_contents "県でも山形県避難所における新型コロナウイルス感染症対策ガイドラインを作成し、５月26日に公表をされております"@ja.
<< kg:id_69 prop:countermeasure kg:id_73 >>
    prop:text-txt_contents "国が新型コロナウイルス感染症対策に配慮した避難所開設・運営訓練ガイドラインを作成し、６月８日に公表"@ja.
<< kg:id_69 prop:countermeasure kg:id_74 >>
    prop:text-txt_contents "両ガイドラインいずれも分散避難、避難所内３密の防止、避難者受入れ時避難所内での健康管理とそのための資機材確保を柱としております"@ja.
<< kg:id_69 prop:countermeasure kg:id_75 >>
    prop:text-txt_contents "両ガイドラインいずれも分散避難、避難所内３密の防止、避難者受入れ時避難所内での健康管理とそのための資機材確保を柱としております"@ja.
<< kg:id_69 prop:countermeasure kg:id_76 >>
    prop:text-txt_contents "両ガイドラインいずれも分散避難、避難所内３密の防止、避難者受入れ時避難所内での健康管理とそのための資機材確保を柱としております"@ja.
<< kg:id_69 prop:countermeasure kg:id_77 >>
    prop:text-txt_contents "本町でも避難時の新型コロナウイルス感染予防につきましては、国、県が示した対策を反映させながら、町の地域防災計画や平成25年度に策定した避難所開設運営マニュアルに基づいて対応いたしております"@ja.
<< kg:id_69 prop:countermeasure kg:id_78 >>
    prop:text-txt_contents "避難訓練につきましても、今年も10月４日午前８時より全町一斉の避難訓練を実施いたします"@ja.
<< kg:id_69 prop:countermeasure kg:id_79 >>
    prop:text-txt_contents "訓練に当たっては、参加者間の距離に配慮いただくよう、９月１日広報に合わせた回覧文書で既に呼びかけております"@ja.
<< kg:id_69 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "今年度は遊佐地区、高瀬地区において実施される予定でありますが、その際には本町担当職員も参加し、新型コロナウイルス感染予防のための避難所レイアウト、スタッフの対応、体調不良者スペースの確保等について、国、県、町の考えを示しながら、地域の参加者と一緒に確認をしたいと思っております"@ja.
<< kg:id_69 prop:countermeasure kg:id_81 >>
    prop:text-txt_contents "個別の学校、施設等の感染予防に対応した避難所開設マニュアルについては、現在策定中であります"@ja.
<< kg:id_69 prop:countermeasure kg:id_82 >>
    prop:text-txt_contents "これまで町内小学校から体調不良者の避難スペースとして活用する教室等や施設内の動線等について、聞き取りと災害対応の意見交換を実施しました"@ja.
<< kg:id_69 prop:effect kg:id_83 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "パーティション設置等の３密を避けた訓練所設営に時間がかかる等の課題も出ています"@ja.
<< kg:id_69 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "それらの課題の解決を図りながら、万が一の際、より確実な対応ができるよう準備を進めてまいります"@ja.
<< kg:id_85 prop:cause kg:id_86 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "今回の我が町のプレミアム付き商品券事業は、消費に与える影響を緩和し、地域経済の維持を図るため"@ja.
<< kg:id_85 prop:cause kg:id_87 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "今回の我が町のプレミアム付き商品券事業は、消費に与える影響を緩和し、地域経済の維持を図るため"@ja.
<< kg:id_85 prop:countermeasure kg:id_88 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "できるだけ早く商品券が使用され、町内の小規模事業者が活気を取り戻すよう、経済の立て直しを優先するために計画したものであります"@ja.
<< kg:id_85 prop:countermeasure kg:id_89 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "町民全世帯に平等に行き渡るよう、１世帯２セットまでの限定とし"@ja.
<< kg:id_85 prop:countermeasure kg:id_90 >>
    prop:text-txt_contents "高齢者が購入をしやすいよう、年金支給日の翌週の８月21日まで販売したところであります"@ja.
<< kg:id_85 prop:countermeasure kg:id_91 >>
    prop:text-txt_contents "８月24日から28日まで、１世帯２セット限定の条件を緩和し、１人２セットまでとして追加販売を行ったものであります"@ja.
<< kg:id_85 prop:countermeasure kg:id_92 >>
    prop:text-txt_contents "民生児童委員会定例会にて、事業説明と高齢者世帯の代理購入についての依頼を行い"@ja.
<< kg:id_85 prop:countermeasure kg:id_93 >>
    prop:text-txt_contents "７月上旬に各地区区長会に出向き、プレミアム付き商品券のＰＲと民生児童委員会と同じく代理購入の依頼をさせていただきました"@ja.
<< kg:id_85 prop:countermeasure kg:id_94 >>
    prop:text-txt_contents "７月15日のお知らせ号にプレミアム付き商品券の販売のお知らせとホームページの掲載、７月23日に新聞折り込みを行い...そのほか、各まちづくりセンターと利用できる事業者へのポスターの貼付などで周知を図ってまいりました"@ja.
<< kg:id_85 prop:effect kg:id_95 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "約半数の世帯購入にとどまっているため、全世帯の周知に滞りがなかったかという調査はまだ行っていませんが"@ja.
<< kg:id_85 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "これまでの周知方法を全面的に考え直さなければならないと考えております"@ja.
<< kg:id_85 prop:effect kg:id_97 >>
    prop:text-txt_contents "８月27日から販売した結果、８月28日には残りの商品券が全て完売したという状況になりました"@ja.
<< kg:id_85 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "今後は10月４日の期間終了まで使い残しがないようしっかり周知をしていきたいと考えております"@ja.
<< kg:id_85 prop:countermeasure kg:id_99 >>
    prop:text-txt_contents "11月上旬から第二弾のプレミアム付き商品券秋冬版を販売する予定であります"@ja.
<< kg:id_85 prop:countermeasure kg:id_100 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "秋冬版につきましても、町民全世帯へ平等に行き渡るよう、１世帯２セット限定から始め"@ja.
<< kg:id_101 prop:effect kg:id_102 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "新型コロナウイルスの感染拡大による雇用情勢の悪化に歯止めがかかりません"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "経済の冷え込みで休業者数は高止まりし"@ja.
<< kg:id_103 prop:cause kg:id_105 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "失業や解雇、雇い止めも増加しています"@ja.
<< kg:id_106 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "この間コロナ対策で実現させた暮らしを守る制度の継続と拡充が必要です"@ja.
<< kg:id_108 prop:countermeasure kg:id_109 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "新型コロナウイルスの感染拡大を防止するとともに、感染拡大の影響を受けている地域経済や住民生活を支援し、地方創生を図るため、地方公共団体が地域の実績に応じてきめ細やかに必要な事業を実施できるよう創設された交付金であります"@ja.
<< kg:id_108 prop:countermeasure kg:id_110 >>
    prop:text-txt_contents "国の緊急経済対策に掲げられた４つの柱としては、１つ目として、感染拡大防止策と医療提供体制の整備及び治療薬開発"@ja.
<< kg:id_108 prop:countermeasure kg:id_111 >>
    prop:text-txt_contents "２つ目として、雇用の維持と事業の継続"@ja.
<< kg:id_108 prop:countermeasure kg:id_112 >>
    prop:text-txt_contents "３つ目として、次の段階としての官民を挙げた経済活動の回復"@ja.
<< kg:id_108 prop:countermeasure kg:id_113 >>
    prop:text-txt_contents "４つ目として、強靱な経済構造の構築"@ja.
<< kg:id_114 prop:countermeasure kg:id_115 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "町では、この交付金を活用するに当たり国から示された第一次交付限度額の１億63万1,000円を超える総事業費２億1,896万6,000円に及ぶ12の事業を取りまとめ、５月に第一次実施計画書を提出し、現在事業を進めております"@ja.
<< kg:id_114 prop:countermeasure kg:id_116 >>
    prop:text-txt_contents "その後、家賃支援を含む事業の継続や雇用維持等への対応を後押しするとともに"@ja.
<< kg:id_114 prop:countermeasure kg:id_117 >>
    prop:text-txt_contents "新しい生活様式等への対応を図る観点から"@ja.
<< kg:id_114 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "町では、この追加交付金を活用するに当たり、現在９月末を期限とする第二次実施計画の策定に向け、取りまとめを行っている段階であります"@ja.
<< kg:id_119 prop:countermeasure kg:id_120 >>
    prop:text-txt_contents "社会的な環境整備、新たな暮らしのスタイルの確立、新たな付加価値を生み出す消費、投資の促進とした政策分野を柱に"@ja.
<< kg:id_119 prop:countermeasure kg:id_121 >>
    prop:text-txt_contents "社会的な環境整備、新たな暮らしのスタイルの確立、新たな付加価値を生み出す消費、投資の促進とした政策分野を柱に"@ja.
<< kg:id_119 prop:countermeasure kg:id_122 >>
    prop:text-txt_contents "社会的な環境整備、新たな暮らしのスタイルの確立、新たな付加価値を生み出す消費、投資の促進とした政策分野を柱に"@ja.
<< kg:id_123 prop:countermeasure kg:id_124 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "ウィズコロナとなる環境において、将来を見据えた新たな戦略と併せ、町独自の地域経済の活性化対策等を図っていきたいと考えております"@ja.
<< kg:id_125 prop:countermeasure kg:id_126 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "この給食の無償化について、私は小学校から中学３年生までの９年間の課題であると考えておりますが、私はその下のゼロ歳から小学校入るまでとを総合的に見て考える必要があるであろうと思っています"@ja.
<< kg:id_127 prop:countermeasure kg:id_128 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "我が町で幼稚園、保育園の無料化を初めて推進したときに、ゆざっ子エンゼルサポート事業という形で"@ja.
<< kg:id_127 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "ゼロ歳から保育園に入っている子供たちについては、給食費については実費をお願いしましょうという形で"@ja.
<< kg:id_125 prop:effect kg:id_130 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "給食の無償化というのは...ただただ一言で給食の無償化という形ではなかなかきついのかなと。来る財源がそれは豊富にある、また自主財源が豊富にある自治体ならそれは可能なのでしょうけれども"@ja.
<< kg:id_127 prop:countermeasure kg:id_131 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "今年は、全ての子供たちに、ゼロ歳から18歳まで、高校３年生まで、町独自に３万円という子育て給付金を支給したりして"@ja.
<< kg:id_101 prop:effect kg:id_132 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "外出自粛の影響で心身の体調不良や生活が困窮するなど、命と経済に大きな影響を受けております"@ja.
<< kg:id_101 prop:effect kg:id_133 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "患者が発生した管轄の保健所においては、帰国者・接触者相談センター業務やＰＣＲ検査受付業務、医療機関との連絡調整等、保健師さんを中心に非常に多くの困難な業務を担当しております"@ja.
<< kg:id_134 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "公衆衛生の拠点となる保健所におきましては、今後も感染拡大を想定しながら様々な健康危機管理に対応できる体制強化や人材育成を行っていく必要があると考えております"@ja.
<< kg:id_136 prop:countermeasure kg:id_137 >>
    prop:text-txt_contents "平成11年に保健所が二次医療圏ごとに再編され、それまでの８保健所体制が４保健所になり"@ja.
<< kg:id_138 prop:effect kg:id_139 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "市町村においては、権限移譲により健康福祉事業が細分化され、複雑化、高度化、多様化している住民ニーズや新たな健康課題に対応を求められております"@ja.
<< kg:id_4 prop:countermeasure kg:id_140 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "今回の新型コロナ感染症の教訓を踏まえ、町では感染症対策に新しい生活様式を取り入れる等新たな計画の改定や"@ja.
<< kg:id_4 prop:countermeasure kg:id_141 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "マンパワーの確保等、より一層の保健関係施設の担当者の体制強化に努めていきたい"@ja.
<< kg:id_101 prop:effect kg:id_142 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "コロナ禍の影響によります外出自粛、催事の中止等によりまして、今年の２月以降、野菜、牛肉、花卉等の需要が全国的に大きく落ち込みまして、関係する農家の皆様方には深刻な影響を与えております"@ja.
<< kg:id_143 prop:effect kg:id_144 >>
    prop:text-txt_contents "当町におきましては、ウルイ、花卉全般への影響が大きく、２月下旬から販売価格が低迷しまして"@ja.
<< kg:id_145 prop:effect kg:id_144 >>
    prop:text-txt_contents "当町におきましては、ウルイ、花卉全般への影響が大きく、２月下旬から販売価格が低迷しまして"@ja.
<< kg:id_143 prop:effect kg:id_146 >>
    prop:text-txt_contents "３月から４月にかけて、昨年度の６割程度まで単価が落ち込み"@ja.
<< kg:id_145 prop:effect kg:id_146 >>
    prop:text-txt_contents "３月から４月にかけて、昨年度の６割程度まで単価が落ち込み"@ja.
<< kg:id_143 prop:effect kg:id_147 >>
    prop:text-txt_contents "一部出荷調整を行わざるを得ない状況となっております"@ja.
<< kg:id_145 prop:effect kg:id_147 >>
    prop:text-txt_contents "一部出荷調整を行わざるを得ない状況となっております"@ja.
<< kg:id_148 prop:effect kg:id_149 >>
    prop:text-txt_contents "全国的な外出機会の減少によりまして、自家消費の需要が昨年度を上回っており"@ja.
<< kg:id_150 prop:effect kg:id_151 >>
    prop:text-txt_contents "我が町の共同開発米の生活クラブ消費量も前年対比約110％で推移"@ja.
<< kg:id_150 prop:effect kg:id_152 >>
    prop:text-txt_contents "在庫量が不足する可能性もあるため、現在は新規購入のみを制限している状況"@ja.
<< kg:id_153 prop:cause kg:id_154 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "外食、昼食需要の冷え込み等によりまして、米の現物市場のスポット取引価格については低下傾向が続いている"@ja.
<< kg:id_155 prop:cause kg:id_156 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "６月の全国民間在庫量は昨年度と比べまして約23万トン上回っているという状況でありますので、今年度産米の価格水準への影響が大変懸念をされている"@ja.
<< kg:id_157 prop:countermeasure kg:id_158 >>
    prop:text-txt_contents "国では、このような状況を受けまして、コロナ禍の影響を受けた農家を対象とする交付金等を創設し...代表的なものを申し上げますと、野菜、花卉などの次期作支援に係る高収益作物次期作支援交付金"@ja.
<< kg:id_157 prop:countermeasure kg:id_159 >>
    prop:text-txt_contents "農業機械等導入に係る経営継続補助金等がございます"@ja.
<< kg:id_160 prop:countermeasure kg:id_161 >>
    prop:text-txt_contents "県のほうでも花卉の種苗費を支援します県産花卉次期作緊急支援事業"@ja.
<< kg:id_162 prop:countermeasure kg:id_163 >>
    prop:text-txt_contents "肉用牛の収入減少の一部を補填します肉用牛経営安定対策事業等"@ja.
<< kg:id_164 prop:countermeasure kg:id_165 >>
    prop:text-txt_contents "金融機関の資金制度におきましても、無利子化、無担保、無保証化等の優遇措置が講じられている"@ja.
<< kg:id_166 prop:countermeasure kg:id_167 >>
    prop:text-txt_contents "当町におきましては、ＪＡ等を通じて農業関係者にこれらの支援内容を情報提供するとともに"@ja.
<< kg:id_166 prop:countermeasure kg:id_168 >>
    prop:text-txt_contents "県事業につきましても町も一定の負担をしながら町内農家を支援している"@ja.
<< kg:id_166 prop:countermeasure kg:id_169 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "新型コロナウイルス関連農業打撃克服対策事業として、コロナに負けない主食用ブランド力の強化に向けた積極的な土づくりに対する支援"@ja.
<< kg:id_166 prop:countermeasure kg:id_170 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_78;
    prop:text-txt_contents "花卉の需要喚起に係る公共施設への切り花の展示等を実施しようとして"@ja.
<< kg:id_171 prop:countermeasure kg:id_172 >>
    prop:text-txt_contents "教育委員会では４月の学校給食の食材提供農家への休校期間の食材廃棄に係る補助金を交付をしています"@ja.
<< kg:id_166 prop:countermeasure kg:id_173 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "これまで同様、国県等の関連施策を活用しまして、町内農業に係る情勢を注視しながら、実情に即した支援策を講じていきたい"@ja.
<< kg:id_174 prop:effect kg:id_175 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "町内においては雇い止め等の影響は今のところはないというお話であります"@ja.
<< kg:id_176 prop:countermeasure kg:id_177 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_81;
    prop:text-txt_contents "ハローワークからの情報ではそういう支援金の交付をいただいている企業もあるということは伺っております"@ja.
<< kg:id_178 prop:countermeasure kg:id_179 >>
    prop:text-txt_contents "プレミアムつき飲食券につきましては、商工会さんのほうで独自にやっている事業でございますが、3,000円で5,000円分の飲食券を購入できるというもの"@ja.
<< kg:id_180 prop:countermeasure kg:id_181 >>
    prop:text-txt_contents "町内の宿泊施設に泊まっていただいた方について、お１人3,000円を割引をするといいますか、その分町で後でお支払いをするというふうな事業"@ja.
<< kg:id_180 prop:countermeasure kg:id_182 >>
    prop:text-txt_contents "ＧｏＴｏトラベルの助成金と重複して使えるというふうにしてございます"@ja.
<< kg:id_183 prop:countermeasure kg:id_184 >>
    prop:text-txt_contents "コロナ禍に対する国保税及び介護保険の減免につきまして、制度が開始されております"@ja.
<< kg:id_185 prop:countermeasure kg:id_184 >>
    prop:text-txt_contents "コロナ禍に対する国保税及び介護保険の減免につきまして、制度が開始されております"@ja.
<< kg:id_186 prop:countermeasure kg:id_187 >>
    prop:text-txt_contents "住民税ですとか固定資産税におきましても徴収猶予という形で...申出によりまして１年間の徴収を猶予しますよという制度"@ja.
}
