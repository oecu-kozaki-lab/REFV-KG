kg:st_1 rdfs:label "遊佐町長 時田博機"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "再生可能エネルギー導入の背景に地球温暖化対策があると説明する"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "エネルギー自給率向上が導入の背景だと述べる"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "県内産業振興を背景に挙げる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "地域活性化を図る県の戦略に基づくと説明する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "豊富な自然エネルギーの活用促進が政策の前提だと述べる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "エネルギー安定確保を目指す政策に基づくと述べる"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "震災と原発事故を踏まえ安全安心なエネルギー確保が課題だと述べる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "地産地消の町づくり理念に沿うと説明する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "庄内沖の風況の良さを導入前提として示す"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:st_2 rdfs:label "日本共産党 佐藤光保"@ja.
kg:st_2 rdf:type cls:st_78.
cls:st_78 rdfs:label "政党関係者"@ja.
kg:op_10 prop:content "情報公開が不十分で町民理解と合意形成に課題があると指摘する"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "ホームページ公開だけでは住民に情報が届かないと述べる"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "停電時に地域で電気を使えることをメリットと捉える人もいると紹介する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "景観への大きな影響を懸念する"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:st_3 rdfs:label "町民"@ja.
kg:st_3 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_14 prop:content "飛島航路からの景観変化を見える形で示してほしい"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "影鳥海がどう見えるか可視化を求める"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "大型風車が集中立地した場合の低周波や騒音影響を懸念する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "町は騒音と低周波への配慮を県に求めていると述べる"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "環境への配慮を県に求めていると説明する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "鳥類への影響低減を求めていると述べる"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "海洋生物への負荷低減を求めていると述べる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "可視化資料へのクレームは住民の不安を強めると述べる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_2.
kg:op_22 prop:content "説明不足や可視化の遅れは不信につながると懸念する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "地域の景観が大きく変わると懸念する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "風車騒音は生活上の不快感や不安を生むおそれがあると述べる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:st_4 rdfs:label "湧水への影響を指摘する人"@ja.
kg:st_4 rdf:type cls:st_79.
cls:st_79 rdfs:label "指摘者"@ja.
kg:op_25 prop:content "5キロ沖でも湧水に影響する可能性があると指摘する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:op_26 prop:content "影の点滅が近距離だけでなく遠方でも感じられると懸念する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "漁業への影響を問題点として挙げる"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "風の流れの変化による稲作への影響を心配する声を紹介する"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "環境変化に伴う病害虫発生を懸念する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "松くい虫への影響も同様に心配されると述べる"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_2.
kg:op_31 prop:content "海水浴や観光の雰囲気が損なわれると懸念する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_2.
kg:op_32 prop:content "決定権限が県や国でも影響を受けるのは町民だと強調する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "説明会延期もあり町民理解が進んでいないと見る"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:op_34 prop:content "地元還元がなければ地域活性化につながらないと警戒する"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "ホームページだけでなく広報紙で町の姿勢も含めて周知すべきだと求める"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:op_36 prop:content "法定協議会の記録公開と傍聴機会確保が必要だと述べる"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_2.
kg:op_37 prop:content "住民無視の大規模開発ではなく住民参加型にすべきだと主張する"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "景観変化を動画モンタージュで示してほしい"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "環境アセス手続に沿って審議会答申を踏まえ県へ意見書を提出すると説明する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_1.
kg:op_40 prop:content "騒音と低周波への配慮を県へ意見提出していると述べる"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_1.
kg:op_41 prop:content "環境配慮を求めていると説明する"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "鳥類への影響低減を県に求めていると述べる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_1.
kg:op_43 prop:content "海洋生物負荷の低減を求めていると述べる"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_1.
kg:op_44 prop:content "機種選定では安全最優先を求めていると説明する"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_1.
kg:op_45 prop:content "今後も説明会開催を県や事業者に求める考えを示す"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_1.
kg:op_46 prop:content "住民の疑問や不安を県への意見に反映すると述べる"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_1.
kg:st_5 rdfs:label "佐藤光保の知人"@ja.
kg:st_5 rdf:type cls:st_52.
cls:st_52 rdfs:label "関係者"@ja.
kg:op_47 prop:content "町が費用を出して精度の高いフォトモンタージュを作るべきだと述べる"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_5.
kg:op_48 prop:content "動画などを使った分かりやすい説明で住民理解を確認すべきだと求める"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_2.
kg:op_49 prop:content "町として風力発電の設置基準を整えてきたと説明する"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_1.
kg:op_50 prop:content "町民にリスクが及ばないよう協定書を結ぶべきだと述べる"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "県が進めるなら設置基準とリスク管理協定を整えるべきだと求めてきた"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_1.
kg:op_52 prop:content "環境審議会の意見をそのまま県に伝えるのが責務だと述べる"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "発電計画が示された段階でCGなどによる可視化を行う考えを示す"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_1.
kg:op_54 prop:content "酒田港活用や地元企業への利益還元が必要だと述べる"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_1.
kg:op_55 prop:content "漁業者にも還元される仕組みが必要だと述べる"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_1.
kg:op_56 prop:content "酒田市と連携し港湾活用や保守事業を要望する考えを示す"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_1.
kg:op_57 prop:content "観光や海岸利用を考え設置場所を西遊佐側に限定したいと述べる"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_1.
kg:op_58 prop:content "問題点を隠さず示した上で進めるべきだと主張する"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_2.
kg:op_59 prop:content "影響の程度と不明点を分けて住民に示すべきだと述べる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_2.
kg:op_60 prop:content "住民に示した上で事業の可否や変更を判断すべきだと求める"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_2.
kg:op_61 prop:content "原発の反省を踏まえ電力会社は徹底した情報公開を行うべきだと述べる"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_2.
kg:op_62 prop:content "意思決定過程まで含めて記録を残す必要があると述べる"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_2.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組の背景には、再生可能エネルギーの主力電源化による地球温暖化対策"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組の背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギーの自給率の向上"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組の背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギーの自給率の向上並びに県内産業の振興"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "県内産業の振興及び地域活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "豊かに賦存する自然エネルギーを活用した再生可能エネルギーの開発を促進、地域導入を進め"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "エネルギーの安定確保を目指すというエネルギー政策に基づくもの"@ja.
<< kg:id_1 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "遊佐町においても東日本大震災や福島第一原子力発電所の事故の経緯を踏まえ、安全、安心なエネルギーの確保をすることを課題とし"@ja.
<< kg:id_1 prop:cause kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "エネルギーの地産地消による町づくりを基本理念とする遊佐町エネルギー基本計画を策定しており"@ja.
<< kg:id_1 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "庄内沖は恵まれた風況にあるなど、大きな可能性があることを前提に"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "町民の理解と合意を得るための情報公開は十分になされているか"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "県ホームページに議事録が公開されているとはいうものの、県民、町民はホームページを見れない人がほとんどか、相当いらっしゃいます"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "東北全域が停電になっても遊佐町が洋上風力の電気を使えるようにできるかというようなことをメリットとして捉える場合もあろう"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "沈む夕日が見られなくなることにとどまらず"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "飛島航路からの眺望、さらには影鳥海がどのようになるのか、動画によるモンタージュで示されたいという町民の声があります"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "さらには影鳥海がどのようになるのか、動画によるモンタージュで示されたいという町民の声があります"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "低周波、騒音等についてであります。２キロ離れるとそういったものはないなどという話もある"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "これまで町は山形県へ、事業規模が大きいことから、騒音及び低周波の影響"@ja.
<< kg:id_1 prop:effect kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "騒音及び低周波の影響、環境への配慮"@ja.
<< kg:id_1 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "ハクチョウ等の鳥類への影響"@ja.
<< kg:id_1 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "サケ等海洋生物への負荷低減に向けて取り組むこと"@ja.
<< kg:id_1 prop:effect kg:id_22 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "そういった人に不安を募らせることになると思います"@ja.
<< kg:id_1 prop:effect kg:id_23 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "その不安というのは不信につながっていくというふうに心配します"@ja.
<< kg:id_1 prop:effect kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "それ以外にも一変するだろうと、我々のイメージとは。そういったことを、この景観への影響が大きいと思います"@ja.
<< kg:id_1 prop:effect kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "その聞き慣れない音、そういったものはやっぱり異常な音として認識される"@ja.
<< kg:id_1 prop:effect kg:id_26 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "５キロメートル沖でもその影響を受ける可能性があると指摘する人もいます"@ja.
<< kg:id_1 prop:effect kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "あとはシャドーフリッカーというのがあります。これは、要するに影が点滅する"@ja.
<< kg:id_1 prop:effect kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "内水面を含む漁業への影響"@ja.
<< kg:id_1 prop:effect kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "稲作への影響を心配するという声も、これはそういう説明会なんかで出されます"@ja.
<< kg:id_1 prop:effect kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "すると、稲作の場合が病害虫の問題もあります"@ja.
<< kg:id_1 prop:effect kg:id_31 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "病害虫といえば松くい虫。これについても同じようなことが心配される"@ja.
<< kg:id_1 prop:effect kg:id_32 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "海水浴をはじめとする観光への影響。多分これができたら海水浴どころではないような気がする"@ja.
<< kg:id_1 prop:effect kg:id_33 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "事業の決定権限が県、それから国であっても、影響、被害を受けるのはつまるところ町民なのです"@ja.
<< kg:id_1 prop:effect kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "そういったこともあり町民の理解が進んでいないというふうに見受けます"@ja.
<< kg:id_1 prop:effect kg:id_35 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "ただ大企業だけが利益を持って東京に戻ってしまうという形の事業では地域の活性化、経済の好循環には決してつながらない"@ja.
<< kg:id_1 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "町は広報紙、広報ゆざを持ち、しかも今までのように県や事業者による説明会の単なるお知らせにとどまることなく、洋上風力発電事業に対する町の姿勢を明らかにした上で町民にきちんと知らせ、理解と合意を得ることが必要"@ja.
<< kg:id_1 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "もちろんこれから開かれる法定協議会も議事録を作成し、傍聴も認められる必要があります"@ja.
<< kg:id_1 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "住民参加、町民参加の地域を潤わせる再生可能エネルギーでなければならない"@ja.
<< kg:id_1 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "動画によるモンタージュで示されたいという町民の声があります"@ja.
<< kg:id_1 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "町環境審議会へ諮問し、これに対する答申を受け、山形県知事へ町の意見書を提出することになります"@ja.
<< kg:id_1 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "これまで町は山形県へ、事業規模が大きいことから、騒音及び低周波の影響"@ja.
<< kg:id_1 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "騒音及び低周波の影響、環境への配慮"@ja.
<< kg:id_1 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "ハクチョウ等の鳥類への影響"@ja.
<< kg:id_1 prop:countermeasure kg:id_44 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "サケ等海洋生物への負荷低減に向けて取り組むこと"@ja.
<< kg:id_1 prop:countermeasure kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "風車の機種についてはコストによる選定ではなく、安全面に最大限配慮すること等の意見を提出"@ja.
<< kg:id_1 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "今後もあらゆる機会を利用し、町民への説明会の開催を山形県や事業者に求めていきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "そこから上がってきた町民の疑問、不安が解消されるように山形県への意見に反映させていきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "そんなことを言うぐらいなら町で役場で100万円くらい出して作ったらどうかと、相当立派なものができるぞ"@ja.
<< kg:id_1 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "情報公開は無論、動画等を活用した分かりやすい説明による、県民の理解を判断した上で町長が意見を表明するということが必要"@ja.
<< kg:id_1 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "具体的にやっぱり設置基準はなかった町でありましたが、それらを整えてきました"@ja.
<< kg:id_1 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "リスク管理の協定書をしっかり結びましょう"@ja.
<< kg:id_1 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "山形県に対しましてもやっぱり設置基準とリスク管理の協定書については県がしっかり進めるのであれば作ってもらわなければ困ります"@ja.
<< kg:id_1 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "それらを細工することなく、そのまま県に課題としてこういう意見が出ておりますというふうに伝える"@ja.
<< kg:id_1 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "計画出てからしっかり整えるということはやぶさかではない"@ja.
<< kg:id_1 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "酒田港の活用、そして地元の企業等がしっかりとやっぱり利益を分けていただけるような"@ja.
<< kg:id_1 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "漁業者等にもそれらが還元できるような地域でないと"@ja.
<< kg:id_1 prop:countermeasure kg:id_57 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "酒田港を拠点としたやっぱりメンテナンス等の事業等もこれは酒田市さんと一緒に力を合わせながら要望していく"@ja.
<< kg:id_1 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "吹浦のエリアには設置はご遠慮申し上げたいと、西遊佐地区のエリアにお願いしたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_59 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "可能な限りその問題点を提示した上で事業を進めるべきではないか"@ja.
<< kg:id_1 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "ここまでは予測できて、影響はこの程度予測される、この点については適切な予測、手法がなく不明だというように、町民全体に提示する"@ja.
<< kg:id_1 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "その上で事業の可否、変更を問う"@ja.
<< kg:id_1 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "原発に関する反省から、特に徹底した情報公開がなされなければなりません"@ja.
<< kg:id_1 prop:countermeasure kg:id_63 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "結論を出す過程も含めて明確な記録を残すことが必要です"@ja.
}
