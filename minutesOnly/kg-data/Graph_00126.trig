kg:op_1 prop:content "再生可能エネルギー導入推進の背景にある"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "再生可能エネルギー導入推進の背景にある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "再生可能エネルギー導入推進の背景にある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "再生可能エネルギー導入推進の背景にある"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_2 rdfs:label "遊佐町"@ja.
kg:st_2 rdf:type cls:st_4.
kg:op_5 prop:content "東日本大震災と福島第一原発事故の経験を踏まえ必要と認識する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:st_3 rdfs:label "町長"@ja.
kg:st_3 rdf:type cls:st_80.
cls:st_80 rdfs:label "行政関係者"@ja.
kg:op_6 prop:content "大きな可能性があることを前提としている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:st_4 rdfs:label "齋藤武議員"@ja.
kg:st_4 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_7 prop:content "事業規模が大きく景観が大きく変わる可能性を懸念する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:op_8 prop:content "現段階ではほとんど解消されていないと考える"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "調査の実施を求めている"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "影響調査の実施を求めている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "負荷低減の取組を求めている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "影響調査の実施を求めている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "住民にとってリスクがないように主張していくべきだと考える"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "影響調査等の実施を求めている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "影響調査等の実施を求めている"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "タイミングを逃すと建設後に取り返しがつかなくなることを心配する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "事業の周知と理解を図るため説明会開催を県に求める"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:st_5 rdfs:label "山形県地域協調型洋上風力発電研究・検討会議"@ja.
kg:st_5 rdf:type cls:st_81.
cls:st_81 rdfs:label "検討組織"@ja.
kg:op_18 prop:content "地域の合意形成に向けて議論を行う"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_5.
kg:op_19 prop:content "理解促進のため調査研究を行う"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_5.
kg:st_6 rdfs:label "地域生活課長"@ja.
kg:st_6 rdf:type cls:st_80.
kg:op_20 prop:content "知事から意見を求められた際の手順として実施している"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_6.
kg:op_21 prop:content "今後もあらゆる機会を利用して説明会開催を求めたい"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "町民の疑問や不安が解消されるよう意見書に反映させたい"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "知事への意見書で調査実施を求めている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "知事への意見書で調査実施を求めている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "知事への意見書で実施を求めている"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_2.
kg:op_26 prop:content "知事への意見書で調査実施を求めている"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "コストによる選定ではなく安全面重視を求めている"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "知事への意見書で配慮を求めている"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "知事への意見書で調査実施を求めている"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_2.
kg:op_30 prop:content "各段階ごとに町民の意見を受けて町の意見書を提出する"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_6.
kg:op_31 prop:content "町の要請により全6地区で3回目の説明会を開催した"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_6.
kg:op_32 prop:content "本来は方法書段階の説明会だが町の要請で前倒し実施した"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_6.
kg:op_33 prop:content "何よりも地域の合意形成が重要だと考える"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_6.
kg:op_34 prop:content "県が進めるのであれば県としての設置基準を示すことが望ましい"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "計画が次の段階に進んだら県が示すのが望ましい"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "手順緩和には懸念があり法に基づく手続を守るべきだと考える"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組の背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギー自給率の向上並びに県内産業の振興及び地域活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組の背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギー自給率の向上並びに県内産業の振興及び地域活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組の背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギー自給率の向上並びに県内産業の振興及び地域活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "山形県が進める洋上風力発電導入推進の取組の背景には、再生可能エネルギーの主力電源化による地球温暖化対策とエネルギー自給率の向上並びに県内産業の振興及び地域活性化を図る県のエネルギー戦略があり"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "東日本大震災や福島第一原子力発電所事故の経験を踏まえ、安全、安心なエネルギーを確保することを課題としたエネルギーの地産地消による町づくりを基本理念とする遊佐町エネルギー基本計画を策定しており"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "庄内沖は恵まれた風況にあるなど大きな可能性があることを前提に"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "事業規模がかなり大きく、このまま進めば遊佐の沿岸の景観は大きく変容する可能性がある"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "様々な角度から出されている町民の不安や疑問は現段階ではほとんど解消されていないと考えられます"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "事業規模が大きいことから騒音及び低周波の影響について調査の実施をしていただきたい"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "サケの遡上の影響調査の実施や海洋生物への負荷低減に向けての取組の実施をお願いしたい"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "サケの遡上の影響調査の実施や海洋生物への負荷低減に向けての取組の実施をお願いしたい"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "最上川に飛来するハクチョウ等鳥類への影響調査の実施をお願いしたい"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "住んでいる地域にとって、住民にとってやっぱりリスクがないようにお願いしたい"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "比子海岸の浸食と砂堆積の影響調査等の実施をお願いしたい"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "比子海岸の浸食と砂堆積の影響調査等の実施をお願いしたい"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "そのタイミングを逃してしまうとずるずると悪い方向に行ってしまって修正利かなくなって、建ってしまってこんなはずではなかったということになるのが一番心配されます"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "事業の周知と理解を図るため、説明会の開催等を県に働きかけていくという趣旨で答弁をしています"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "一般海域における洋上風力発電の在り方に係る地域の合意形成に向け、課題の抽出や対応策等の議論を行う"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "関係者間の理解促進に資する調査研究を行うため、海域利用者や経済団体、関係行政機関などによる山形県地域協調型洋上風力発電研究・検討会議が平成30年７月に設置されております"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "町の環境審議会へ諮問し、これに対する答申を受け、山形県知事への町の意見書を提出する手段となっております"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "今後もあらゆる機会を利用して町民等への説明会の開催を山形県、事業者には求めていきたいと考えております"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "そこから上がってきた町民の疑問、不安が解消されるように山形県への意見書に反映させていきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "事業規模が大きいことから騒音及び低周波の影響について調査の実施をしていただきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "サケの遡上の影響調査の実施や海洋生物への負荷低減に向けての取組の実施をお願いしたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "サケの遡上の影響調査の実施や海洋生物への負荷低減に向けての取組の実施をお願いしたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "最上川に飛来するハクチョウ等鳥類への影響調査の実施をお願いしたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "風車の機種につきましてはコストによる選定でなく安全面に最大限配慮したものとしていただきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "景観の配慮をお願いしたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "比子海岸の浸食と砂堆積の影響調査等の実施をお願いしたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "それぞれの段階で計画図書の公告、縦覧をしまして町民の皆さんの意見をいただくとともに、その都度町のほうでも環境審議会を開催いたしまして、その答申を受け、町の意見書を県知事のほうへ提出というような形になっていきます"@ja.
<< kg:id_1 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "町からの要請によりまして、町内全地区で、６地区で３回目となります説明会を開催をさせていただきました"@ja.
<< kg:id_1 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "町の要請によりまして第１段階目の配慮書の段階におきまして説明会開催、実施をさせていただいたところであります"@ja.
<< kg:id_1 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "事業につきましては、何よりも地域の合意形成が重要であるのかなというふうに考えてございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "山形県としてやっぱり進めるのであれば県としての設置基準"@ja.
<< kg:id_1 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "リスク管理の協定書のたたき台を、やっぱり計画がしっかり次の段階、計画が設定されたら県として示していただくということが一番望ましいことだと思っています"@ja.
<< kg:id_1 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "町として、地域としてはやっぱりしっかりと決められた手順、ルールにのっとって、やっぱり影響評価に基づいた方法書、そして準備書、配慮書、評価書というような形を手順どおり進めていただきたい"@ja.
}
