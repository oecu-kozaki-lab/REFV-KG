kg:st_1 rdfs:label "地域生活課長 畠中良一君"@ja.
kg:st_1 rdf:type cls:st_12.
cls:st_12 rdfs:label "行政職員"@ja.
kg:op_1 prop:content "協定根拠が不明確だったため条例で明文化すべきと説明"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "5番 齋藤武議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_2 prop:content "改正理由が根拠明文化だけでは不十分で立法事実の検討が足りないと指摘"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:st_3 rdfs:label "2番 那須正幸君"@ja.
kg:st_3 rdf:type cls:st_9.
kg:op_3 prop:content "町民の安心安全のため今後も地元協定の対応継続を求める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_3.
kg:op_4 prop:content "地元リスク管理のため事業者と地元が協定締結できるよう追加すると説明"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_4 rdfs:label "町長 時田博機君"@ja.
kg:st_4 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_5 prop:content "地域の声を協定に反映させるため条例上の根拠を明確にしたいと述べる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:op_6 prop:content "条文案は不十分で無防備であり慎重な制度設計が必要と反対"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_5 rdfs:label "4番 佐藤光保議員"@ja.
kg:st_5 rdf:type cls:st_9.
kg:op_7 prop:content "委任規定を根拠にする説明は不十分で改正案に反対"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_5.
kg:op_8 prop:content "力関係があり当事者だけでは事業者に働きかけられない場合の町の対応を問題提起"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_5.
kg:op_9 prop:content "事案発生時は町が調整に入り協定の実効性を支えると説明"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "協定に基づき騒音発生時に迅速な対応ができた実例として説明"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "地元から苦情が寄せられたことで協定の重要性が確認できたと説明"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "協定に基づき事業者がすぐ騒音対策装置を設置したと説明"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "相談者は隣接移転に強い不安があり事業者に直接言えないと訴えていると紹介"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_5.
kg:op_14 prop:content "住民は力関係の差から事業者に話しに行けない現実があると問題提起"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "町民の声が届きにくい実情を受けて根拠明確化が必要と述べる"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "条文の位置付けや表現が不適切で無防備な規定になっていると反対"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_2.
kg:op_17 prop:content "関係住民が結ぶ協定は苦渋の防衛ラインであり制度的手当てがないと危険と反対"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "重要改正なのに環境審議会での事前審議が必要だったと反対"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:st_6 rdfs:label "教育委員会教育課長 髙橋善之君"@ja.
kg:st_6 rdf:type cls:st_12.
kg:op_19 prop:content "更新増車による密対策が購入目的と説明"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:op_20 prop:content "統合関連利用もあるとして取得に反対"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:op_21 prop:content "統合に関連する取得ではないかと追及"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "統合時には当然使うことになると説明"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:op_23 prop:content "密対策として2台取得すると説明"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_6.
kg:op_24 prop:content "歩いて環境になじむ教育を損ない学校統合を進める手段にもなるとして反対"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_5.
kg:op_25 prop:content "当初は玉石混じり土を想定したが掘削途中で岩盤が出たため増工になったと説明"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "前年も同様であり当初設計が甘いのではないかと疑問を呈する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:st_7 rdfs:label "9番 阿部満吉議員"@ja.
kg:st_7 rdf:type cls:st_9.
kg:op_27 prop:content "同様の増額が繰り返されており積算の甘さを指摘して反対"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_7.
kg:op_28 prop:content "岩盤取壊しと運搬費増で契約変更が必要になったと説明"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "工事費の増額が容易な入札方式になっていると問題視"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_7.
kg:op_30 prop:content "増額補正を繰り返すより入札方式見直しと職員のスキル向上が必要と反対"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_7.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "地元集落との協定の根拠についてこれまで不明だったということで、なかったということで、今回明文化するための条例改正をお願いするものでございます。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "開発地となります地元のリスク管理のためということで、集落とも協定を結べるようにということで改正を今回お願いするものでございます。"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "何らかの事案が発生した場合につきましては、町が調整に入ることになります。"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "稼働直後、騒音が発生して地元の方々から苦情をいただきました。"@ja.
<< kg:id_9 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "稼働直後、騒音が発生して地元の方々から苦情をいただきました。"@ja.
<< kg:id_9 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "その協定に基づきまして、事業者さんのほうからすぐに騒音装置設置していただきまして、対応をさせていただいたところでございます。"@ja.
<< kg:id_12 prop:effect kg:id_13 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "どうしてもここの隣にいる私の相談者はそういう環境に対する不安が拭い切れないと、こういうケースです。"@ja.
<< kg:id_12 prop:effect kg:id_14 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "現実の力関係がすごく差がありまして、あの人のところにこういう話をしに行くのはとてもできないというふうなケースです。"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "なかなか地元の声がやっぱり届かないのだなという思いしていましたし、実は高瀬地区でも１つ産廃の施設を造るときにも、町は一生懸命間に入って事業者との説明会、７回かな、あのときは。"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "今回上程された条例案、つまり条例改正案は、主に次の３つの理由により不適当だと考えます。まず１つは、文章表現の見地からです。"@ja.
<< kg:id_17 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "民間同士の協定は大変デリケートなものですが、今回の条例ではその辺りの手当てがなされていません。"@ja.
<< kg:id_17 prop:effect kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "やはり事前に環境審議会で検討すべきだと考えます。"@ja.
<< kg:id_17 prop:effect kg:id_21 >>
    prop:text-txt_contents "挙手少数です。よって、本件は否決されました。"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "スクールバスの更新、増車による密対策を目的とした購入整備であります。"@ja.
<< kg:id_22 prop:effect kg:id_24 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "予定しております統合時に使用するバスの台数は、現状の台数よりも多い台数でございますので、当然使うことになるということでございます。"@ja.
<< kg:id_22 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_23;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "本件で取得するスクールバス中型２台につきましては、新型コロナウイルス感染症対応地方創生臨時交付金を財源とした事業によるものでございまして、スクールバスの更新、増車による密対策を目的とした購入整備であります。"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "フーチングまでの床掘り深さ、ＧＬよりマイナス10メーターとなりますけれども、ＧＬマイナス５メーター付近より岩盤が発生しております。"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "この岩盤についての取壊し、大型ブレーカーによる岩盤の破砕取壊し、そしてこの岩盤取壊しの岩の掘削運搬に係る経費が増したということで、このような形で増工となったものでございます。"@ja.
<< kg:id_26 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "次に、議第89号橋梁長寿命化修繕計画事業広畑橋下部工工事に係る請負契約の一部変更についての件を議題といたします。"@ja.
