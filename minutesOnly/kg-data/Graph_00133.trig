kg:st_1 rdfs:label "発言者"@ja.
kg:st_1 rdf:type cls:st_17.
cls:st_17 rdfs:label "発言者"@ja.
kg:op_1 prop:content "子供たちになぜ必要かを考えてもらう機会としてワークショップがあってもよい"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "東京大学の江守客員教授"@ja.
kg:st_2 rdf:type cls:st_24.
cls:st_24 rdfs:label "専門家"@ja.
kg:op_2 prop:content "将来を担う子供たちのために二酸化炭素排出を抑える社会づくりが大人の役目"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "地球温暖化は産業革命以降の人間活動の積み重ねによる"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "地球温暖化は各地の災害の要因になっている"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "この50年で世界の平均気温が1度上がった"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "このまま進むと元に戻らない段階に至るおそれがある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "町民"@ja.
kg:st_3 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_7 prop:content "海に多くの風車が建つことを子供たちにも説明して対応すべき"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "歴史だけでなく子供たちが疑問を持つ機会としてワークショップを設けるべき"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "行政や政治が機会を設けて民間事業者を支援し参入できる状況をつくるべき"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "売れなければ収入にならず産業として成り立たない"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "収入にならないため離農が進む"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "離農により耕作放棄地が増える"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "一次産業への直接支援だけでなく中流から下流の加工と流通に力を入れるべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "アフターコロナに向けてICTを活用したスタートにすべき"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "発電だけで終わらせず水素製造や研究施設につなげて地域に還元すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "研究施設や関連事業ができれば若者の雇用が生まれる"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "若い方が地域に戻れるような環境を整えるべき"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "地球温暖化は、18世紀後半から始まった産業革命、人間の生産活動からの人間の活動が現在につながっているためであると。結果、これまでの50年間で世界の平均気温が１度アップしたと。だから二酸化炭素排出を抑える社会をつくることが将来を担う子供たちへつなぐ今の大人の役目である"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "各地区で発生している災害の要因である地球温暖化は、18世紀後半から始まった産業革命、人間の生産活動からの人間の活動が現在につながっているためである"@ja.
<< kg:id_3 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "各地区で発生している災害の要因である地球温暖化"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "結果、これまでの50年間で世界の平均気温が１度アップした"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "このまま進めると元に戻らないティッピングポイントというところに行ってしまうともう取り返しがつかない"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "町民からは、海に数多くの風車が建つことについて、子供たちにその話をして対応すべきであるというようなことがいろいろな場で申し上げられている"@ja.
<< kg:id_1 prop:countermeasure kg:id_9 >>
    prop:text-txt_contents "５月28日に山形県と共同で、遊佐町沖における洋上風力発電についての住民説明会を開催し、町内外から105人の参加がありました"@ja.
<< kg:id_1 prop:countermeasure kg:id_10 >>
    prop:text-txt_contents "環境省の担当者から、それぞれ洋上風力発電に関する政策と環境アセスメントについての説明があり"@ja.
<< kg:id_1 prop:countermeasure kg:id_11 >>
    prop:text-txt_contents "国による発電事業の導入に向けた検討のため、経済産業省の外郭団体である国立研究開発法人新エネルギー・産業技術総合開発機構（ＮＥＤＯ）による海底地盤調査"@ja.
<< kg:id_1 prop:countermeasure kg:id_12 >>
    prop:text-txt_contents "環境省による風況調査などが行われています"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "できればワークショップがあってもいいのかなと、そのように考え、質問させていただきました"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "そこに参入ができるようにするのは、やっぱり我々政治なり行政の仕事の一つかなと思っていますので、この辺はいろんな機会を設けて、民間の事業者の支援、力になる、バックアップできるような状況をつくっていただければと思っています"@ja.
<< kg:id_15 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "米の消費がピークの当時の半分となっています。この辺の売る、要は商売にならないとお金になりません"@ja.
<< kg:id_15 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "お金にならないから、先ほどの請願の話ではないですけれども、離農されて"@ja.
<< kg:id_15 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "離農されて耕作放棄地がどんどん出てくるというような形になるかと思います"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:text-txt_contents "商店がもう激減している"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:text-txt_contents "農業を含めた第一次産業が非常に減ってきている"@ja.
<< kg:id_19 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "これまでは一次産業の農家に直接の支援は関わったのですけれども、川でいえば中流から下流にかけての加工、流通、この辺に力入れるべきだと思う"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:text-txt_contents "遊佐ブランド推進協議会、コロナで事業、フードフェスタもできない、いろんな発信もなかなか来るし、池袋のファーマーズマーケットにも行けない"@ja.
<< kg:id_23 prop:effect kg:id_25 >>
    prop:text-txt_contents "コロナで事業、フードフェスタもできない"@ja.
<< kg:id_23 prop:effect kg:id_26 >>
    prop:text-txt_contents "池袋のファーマーズマーケットにも行けない"@ja.
<< kg:id_23 prop:effect kg:id_27 >>
    prop:text-txt_contents "なかなかネットでしか発信できないということになったので、非常に苦しんでいました"@ja.
<< kg:id_23 prop:countermeasure kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "今年の総会からいわゆるアフターコロナに向けたＩＣＴを活用したスタートにしようではないかという形お話をさせていただきました"@ja.
<< kg:id_29 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "電気を活用して水素つくったり、いろんな研究施設、プラント等がこの酒田港近隣にできれば、若い人が新しい技術、それらをしっかり、自分の学んだ技術を自分の生まれ育ったところ近隣でそれらを実現できるという研究施設等があることによって、また働き場が生まれることができれば、それはやっぱり地域の活性化には大いにつながる"@ja.
<< kg:id_29 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "研究施設等があることによって、また働き場が生まれることができれば、それはやっぱり地域の活性化には大いにつながる"@ja.
<< kg:id_29 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "ぜひその辺特に若い方がいろんな形で戻ってこれる状況をつくっていただければと思っています"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:text-txt_contents "福島で原発の事故があったために計画されていたところの跡地を使って水素の発電施設を造っている"@ja.
<< kg:id_33 prop:countermeasure kg:id_35 >>
    prop:text-txt_contents "そこには太陽光と併用して新しいエネルギーをつくる研究開発している"@ja.
}
