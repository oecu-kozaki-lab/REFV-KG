kg:id_26 rdf:type cls:c_216.
cls:c_216 rdfs:label "再生可能エネルギー"@ja.
kg:id_27 rdfs:label "調整弁扱いでは生かし切れない"@ja.
kg:id_27 rdf:type cls:c_3266.
kg:id_26 prop:effect kg:id_27.
kg:id_28 rdfs:label "再生可能エネルギーが生かし切れないこと"@ja.
kg:id_28 rdf:type cls:c_3266.
kg:id_29 rdfs:label "国の扱い方や事業者の使い方として調整弁扱いにされていること"@ja.
kg:id_29 rdf:type cls:c_3276.
cls:c_3276 rdfs:label "調整弁扱い"@ja.
kg:id_28 prop:cause kg:id_29.
