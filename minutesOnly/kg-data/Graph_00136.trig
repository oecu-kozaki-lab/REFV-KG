kg:id_5 rdf:type cls:c_3286.
cls:c_3286 rdfs:label "計画不明"@ja.
kg:id_3 prop:effect kg:id_5.
kg:id_6 rdfs:label "海域拡大の内容に注目して考える"@ja.
kg:id_6 rdf:type cls:c_307.
cls:c_307 rdfs:label "計画検討"@ja.
kg:id_3 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "遊佐沖洋上風力"@ja.
kg:id_7 rdf:type cls:c_1243.
kg:id_8 rdfs:label "公開質問状に誠意ある回答を出す"@ja.
kg:id_8 rdf:type cls:c_3287.
cls:c_3287 rdfs:label "回答対応"@ja.
kg:id_7 prop:countermeasure kg:id_8.
kg:id_9 rdfs:label "農業のバイオガス発電"@ja.
kg:id_9 rdf:type cls:c_3288.
cls:c_3288 rdfs:label "バイオガス発電"@ja.
kg:id_10 rdfs:label "畜産の現状と畜舎の位置により適地がない"@ja.
kg:id_10 rdf:type cls:c_2551.
cls:c_2551 rdfs:label "適地不足"@ja.
kg:id_9 prop:cause kg:id_10.
kg:id_11 rdfs:label "遊佐沖の海域設定"@ja.
kg:id_11 rdf:type cls:c_3289.
cls:c_3289 rdfs:label "海域設定"@ja.
kg:id_12 rdfs:label "海域全域が洋上風力設置海域になるとは限らない"@ja.
kg:id_12 rdf:type cls:c_3290.
cls:c_3290 rdfs:label "設置範囲"@ja.
kg:id_11 prop:effect kg:id_12.
kg:id_13 rdfs:label "地域の事情を踏まえて海域内で今後検討する"@ja.
kg:id_13 rdf:type cls:c_3291.
cls:c_3291 rdfs:label "地域考慮"@ja.
kg:id_11 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "再エネ導入拡大"@ja.
kg:id_14 rdf:type cls:c_266.
cls:c_266 rdfs:label "再エネ導入"@ja.
kg:id_15 rdfs:label "山形県の発電潜在能力の活用余地が大きく残る"@ja.
kg:id_15 rdf:type cls:c_3292.
cls:c_3292 rdfs:label "活用余地"@ja.
kg:id_14 prop:effect kg:id_15.
