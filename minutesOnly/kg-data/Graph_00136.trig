  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "洋上風力発電の利用海域拡大"@ja.
kg:id_1 rdf:type cls:c_3285.
cls:c_3285 rdfs:label "海域拡大"@ja.
kg:id_2 rdfs:label "脱炭素化の取組促進"@ja.
kg:id_2 rdf:type cls:c_487.
cls:c_487 rdfs:label "脱炭素化"@ja.
kg:id_1 prop:cause kg:id_2.
kg:id_3 rdfs:label "遊佐町の洋上風力"@ja.
kg:id_3 rdf:type cls:c_1243.
cls:c_1243 rdfs:label "洋上風力"@ja.
kg:id_4 rdfs:label "海岸線からの距離"@ja.
kg:id_4 rdf:type cls:c_1497.
cls:c_1497 rdfs:label "立地条件"@ja.
kg:id_3 prop:cause kg:id_4.
