kg:id_17 rdf:type cls:c_1312.
cls:c_1312 rdfs:label "再エネ推進"@ja.
kg:id_16 prop:countermeasure kg:id_17.
kg:id_18 rdfs:label "再生可能エネルギー推進"@ja.
kg:id_18 rdf:type cls:c_1312.
kg:id_19 rdfs:label "原発再稼働と新増設で予算配分への不安が生じる"@ja.
kg:id_19 rdf:type cls:c_3294.
cls:c_3294 rdfs:label "予算不安"@ja.
kg:id_18 prop:effect kg:id_19.
kg:id_20 rdfs:label "原発再稼働につながらない意識で進める"@ja.
kg:id_20 rdf:type cls:c_3295.
cls:c_3295 rdfs:label "推進方針"@ja.
kg:id_18 prop:countermeasure kg:id_20.
kg:id_21 rdfs:label "地域の事業者と金融機関が参画できるスキームをつくる"@ja.
kg:id_21 rdf:type cls:c_3296.
cls:c_3296 rdfs:label "参画制度"@ja.
kg:id_18 prop:countermeasure kg:id_21.
kg:id_22 rdfs:label "地域に新たな企業が張りつき金融機関も利益を出せる"@ja.
kg:id_22 rdf:type cls:c_3297.
cls:c_3297 rdfs:label "地域利益"@ja.
kg:id_18 prop:effect kg:id_22.
