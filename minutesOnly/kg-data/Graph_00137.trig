PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00137> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "再生可能エネルギーの施設の在り方"@ja.
kg:id_1 rdf:type cls:c_766.
cls:c_766 rdfs:label "再生可能エネルギー施設"@ja.
kg:id_2 rdfs:label "全国並びに町内等で論議の中心になっている"@ja.
kg:id_2 rdf:type cls:c_3301.
cls:c_3301 rdfs:label "論議の中心"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "洋上風力発電事業"@ja.
kg:id_3 rdf:type cls:c_781.
cls:c_781 rdfs:label "洋上風力発電事業"@ja.
kg:id_4 rdfs:label "若い人たちにも情報を伝える機会を設ける"@ja.
kg:id_4 rdf:type cls:c_3302.
cls:c_3302 rdfs:label "情報提供機会"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "問題点などを調査研究する"@ja.
kg:id_5 rdf:type cls:c_2059.
cls:c_2059 rdfs:label "調査研究"@ja.
kg:id_3 prop:countermeasure kg:id_5.
kg:id_6 rdfs:label "将来に責任を持てない"@ja.
kg:id_6 rdf:type cls:c_3303.
cls:c_3303 rdfs:label "将来責任の不在"@ja.
kg:id_3 prop:effect kg:id_6.
kg:id_7 rdfs:label "合意継承しなければならない"@ja.
kg:id_7 rdf:type cls:c_3304.
cls:c_3304 rdfs:label "合意継承"@ja.
kg:id_3 prop:countermeasure kg:id_7.
kg:st_1 rdfs:label "ある町民"@ja.
kg:st_1 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_1 prop:content "若い人たちにも情報を伝える機会を設けるべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "問題点などを調査研究する必要がある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "自分たちは将来に責任を持てないため慎重な対応が必要"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "合意継承しなければならない"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "最近、再生可能エネルギーの施設の在り方について、いろいろ全国並びに町内等でも論議の中心になっている"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "若い人たちにも情報を伝える機会を設けて"@ja.
<< kg:id_3 prop:countermeasure kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "問題点などを調査研究する必要があるのではないか"@ja.
<< kg:id_3 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "自分たちは将来に責任を持てない"@ja.
<< kg:id_3 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "合意継承しなければならない"@ja.
}
