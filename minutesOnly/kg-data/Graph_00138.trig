kg:id_18 rdf:type cls:c_3312.
kg:id_1 prop:countermeasure kg:id_18.
kg:id_19 rdfs:label "発電事業者と協定を結び国県を含めた万全の対応を取る"@ja.
kg:id_19 rdf:type cls:c_489.
kg:id_1 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "町として設置基準や協定書案を整え安全を守る"@ja.
kg:id_20 rdf:type cls:c_516.
cls:c_516 rdfs:label "安全確保"@ja.
kg:id_1 prop:countermeasure kg:id_20.
