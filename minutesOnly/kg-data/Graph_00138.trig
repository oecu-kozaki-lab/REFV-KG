kg:id_25 rdf:type cls:c_1157.
cls:c_1157 rdfs:label "住民対話"@ja.
kg:id_1 prop:countermeasure kg:id_25.
kg:st_1 rdfs:label "町長"@ja.
kg:st_1 rdf:type cls:st_85.
cls:st_85 rdfs:label "自治体代表"@ja.
kg:op_1 prop:content "国主導の事業として町は真摯に対応している"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "質問議員"@ja.
kg:st_2 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_2 prop:content "国の方針に乗って進めるなら町長が明確に姿勢を示すべきだ"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "町は法に基づき国の施策推進に協力する立場にある"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "ノーと言えないなら推進する立場をはっきり示すべきだ"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "国と世界の脱炭素目標に歩調を合わせて事業協議に参画している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "地域振興策や漁業振興策の案が協議会で示された"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "若者定住や特産づくりなど多様な要望が出ている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "第４回法定協議会に向けて促進区域指定のための意見取りまとめを進めている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "第４回になれば促進区域に進む局面だと認識している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "事業完了まで事業者責任を明確にする留意事項が盛り込まれると認識している"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "協議会意見が国の公募指針になると見ている"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "地域の要望や漁業影響調査などが今後の条件として整理される"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "何をもって環境負荷最小化とするのか町民と話し合う必要がある"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "町の活性化と持続可能な町づくりにつながると期待している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "地域振興は原資があってこそであり町長の姿勢が重要だ"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "経済的リスクと環境的リスクの最小化を一貫して求めている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "環境負荷を最小限化するには町民の声を直接聞く必要がある"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "町民の不安払拭が必要だと考えている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "大きな声も小さな声も真摯に受け止めるべきだ"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:op_20 prop:content "事業者決定後に地域振興計画を協議し協定や契約を結ぶ考えが示された"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_2.
kg:op_21 prop:content "事業者決定後に協定を結び万全の対応を取る必要がある"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "町長は多くの課題を示して事業者に協力を求めていた"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "第４回法定協議会に向けて意見取りまとめを進めている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "事業完了までの責任や留意事項を明文化するべきだと考えている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:op_25 prop:content "地域要望や漁業影響調査などを条件として整理するべきだ"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:op_26 prop:content "環境負荷最小化のため関係者と話すべきだ"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_2.
kg:op_27 prop:content "経済面と環境面のリスク最小化を協議会意見に盛り込む方針だ"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_1.
kg:op_28 prop:content "環境リスク最小化の具体化には町民の声の反映が必要だ"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "町民の不安払拭のため事業者と協定を結び国県を含め万全に対応する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
kg:op_30 prop:content "過去の陸上風力受入れで設置基準や協定書案を整え安全確保してきた経験を生かす"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_1.
kg:op_31 prop:content "国県は丁寧な説明や環境アセスメントや海底調査を実施している"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "町として先進地研修を実施し受入れ判断の参考にしている"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_1.
kg:op_33 prop:content "法定協議会に先立ち環境審議会に方針を諮る予定だ"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_1.
kg:op_34 prop:content "環境審議会だけでなく町民との直接対話も必要だ"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_2.
kg:op_35 prop:content "町民の大小さまざまな声を拾い協議会発言に反映すべきだ"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_2.
kg:st_3 rdfs:label "議会"@ja.
kg:st_3 rdf:type cls:st_54.
cls:st_54 rdfs:label "議会"@ja.
kg:op_36 prop:content "町長は町民を代表して町民の思いを十分反映すべきだ"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "町民との直接対話を行い不安や要望を聞くべきだ"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_2.
kg:op_38 prop:content "会議報告や環境審議会を通じて声は把握している"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "遊佐町沖洋上風力発電事業は、国が主導する一大プロジェクトであり"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "再エネ海域利用法は、関連地方公共団体は国に協力して施策を推進するように努めなければならない。何回も申し上げました再エネ海域利用法第５条に基づけば、地方公共団体は国の政策に協力するよう努めなければならないと義務が課せられている"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "町としても、2050カーボンニュートラルの2050年カーボンニュートラルの実現を目指す国の方針、そして世界の目標に歩調を合わせて、持続可能な国産エネルギーをつくり出そうとするこの事業に、いわゆる協議に参画しているところであります"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "昨年12月に第３回法定協議会が開かれました。地域振興策や漁業振興策等の案が出されました。前回の法定協議会では、もう若者の定住から特産づくり、販売、それから海岸浸食から全て要望しております"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "現在、国や県など関係者と共に、今後予定されている第４回目の法定協議会に向け、促進区域の指定のための協議会意見取りまとめの作業中であります。ここに来て第４回になれば、もう推薦区域に行くのだというような形になります"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "この意見取りまとめには、風車撤去を含めた事業完了までの期間、発電事業者が責任を持って取り組んでいくための留意事項を明記するものだと伺っております"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "国による発電事業者の公募指針になるとも伺っております"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "具体的には、地域としての要望や将来の展望、漁業影響調査の実施、風車建設における様々な配慮事項などが明記されることとなり"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "今後の本町の活性化、持続可能な町づくりの構築などにつながる施策の展開に向けて大いに期待をされているものと考えます"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "私が第１回法定協議会から一貫して述べさせていただいております経済的、環境的なリスクの最小化についても記載させていただく方向で進めております。環境的なリスクの最小化、これをやっぱり目指していかなければいけない"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "町民の様々な不安の声を払拭するために。町民の大きな声、そして小さな声も真摯に受け止め、町民の声をすくい上げていただきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "発電事業者が決定された後に、それら事業者と地域振興計画などを協議し、協定、それから契約を結ぶという発言をしておりました。今後国の公募を経て発電事業者が決定された後に、町民の様々な不安の声を払拭するために、発電事業者と協定を結び"@ja.
<< kg:id_1 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "そして、多くの課題を示し、発電事業者に協力を願っています"@ja.
<< kg:id_1 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "現在、国や県など関係者と共に、今後予定されている第４回目の法定協議会に向け、促進区域の指定のための協議会意見取りまとめの作業中であります"@ja.
<< kg:id_1 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "この意見取りまとめには、風車撤去を含めた事業完了までの期間、発電事業者が責任を持って取り組んでいくための留意事項を明記するもの"@ja.
<< kg:id_1 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "具体的には、地域としての要望や将来の展望、漁業影響調査の実施、風車建設における様々な配慮事項などが明記されることとなり"@ja.
<< kg:id_1 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_27;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "経済的、環境的なリスクの最小化についても記載させていただく方向で進めております"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "町民の様々な不安の声を払拭するために、発電事業者と協定を結び、国、県を含めた万全の対応を取っていかなければならない"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "2009年から陸上風力発電の設置受入れについて町として設置基準、いわゆるガイドラインを整え、協定書案を整え、町の安全を守るということを第一にこれらを受け入れてきた経験と経緯を大事にしながら"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "環境アセスメントは環境省が直接行っていただいた。また、海底調査についても、経産省の外郭団体のＮＥＤＯが直接実施していただいております。山形県はもう既にここ４年間、５年間ですか、毎年１回ずつ事業説明会をこれは町の要請に基づいて行ってもらっている"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "町単独としては風力先進地の秋田県能代市、秋田市、由利本荘市に見せてほしいよという遊佐部会からの声、また西遊佐区長会からの声には、やっぱり町としてできることはしっかりまずやってみようよって。国の政策だから町は関係ないではなくて、町としてできることをまず、先進地の研修やらせていただこう"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "町民の皆さんとは、第４回法定協議会に臨むに当たっても、私は環境審議会に諮ってから臨む予定でいます"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_35;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "町民の大きな声、そして小さな声も真摯に受け止め、町民の声をすくい上げていただきたい。議会からも、町へ対しての政策提言の中において、洋上風力発電事業に係る協議会では町長は遊佐町町民を代表して発言できる唯一の人であり、町民の思いを十分に反映していただきたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_37;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "今回町長、直接町民との会話、意見交換など行ってきたのかも伺い。町長は、今まで法定協議会ではお話をしています。ただ、町民との実際の会話はしてきていないと私は認識しております。町長としてまずは町民の意見を、町民の声をこれからじかに聞く気があるのか"@ja.
}
