kg:id_22 rdf:type cls:c_3314.
cls:c_3314 rdfs:label "視察研修"@ja.
kg:id_1 prop:countermeasure kg:id_22.
kg:id_23 rdfs:label "第４回法定協議会に臨む前に環境審議会に諮る"@ja.
kg:id_23 rdf:type cls:c_3315.
cls:c_3315 rdfs:label "審議諮問"@ja.
kg:id_1 prop:countermeasure kg:id_23.
kg:id_24 rdfs:label "町民の大きな声も小さな声もすくい上げて法定協議会に反映する"@ja.
kg:id_24 rdf:type cls:c_3072.
cls:c_3072 rdfs:label "住民意見反映"@ja.
kg:id_1 prop:countermeasure kg:id_24.
