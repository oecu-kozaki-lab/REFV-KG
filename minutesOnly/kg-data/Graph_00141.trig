kg:st_1 rdfs:label "髙橋冠治議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "もっと早く宣言できなかったのかと疑問を示す"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "地域生活課長 太田智光君"@ja.
kg:st_2 rdf:type cls:st_12.
cls:st_12 rdfs:label "行政職員"@ja.
kg:op_2 prop:content "宣言だけ先行しても実効性が伴わないため時期を見極めたと説明する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "計画改定のタイミングに合わせて宣言時期を設定していたと説明する"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "補助金活用を見据え宣言を前倒ししたと説明する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "地域での具体的な取組体制が整い始めたことを理由に挙げる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_2.
kg:op_6 prop:content "脱炭素関連事業が進んでいる今が宣言の好機だと説明する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:st_3 rdfs:label "齋藤武議員"@ja.
kg:st_3 rdf:type cls:st_9.
kg:op_7 prop:content "洋上風力が進む遊佐町では宣言に一般論以上の重みがあるとみる"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "補助事業採択で有利になるため今回の議会で宣言する意義があると説明する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_2.
kg:op_9 prop:content "宣言だけでは実効性が伴わない例が全国にあると指摘する"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_2.
kg:op_10 prop:content "補助金申請上の要件になるため実務上の効果があるとみる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_2.
kg:op_11 prop:content "補助制度で優位に働く可能性があると説明する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_2.
kg:op_12 prop:content "議会も同意し歩調を合わせる形になると受け止める"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "宣言自体に即時の実行力はないが意味はあると述べる"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "宣言を積み重ねることで意識啓発につながると評価する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "宣言への同意が後に別の事業の免罪符のように使われることを懸念する"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:st_4 rdfs:label "菅原和幸議員"@ja.
kg:st_4 rdf:type cls:st_9.
kg:op_16 prop:content "宣言はスタートラインであり今後の政策展開につなげるべきだと賛成する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_4.
kg:op_17 prop:content "施設改修とあわせて国補助金の活用を検討している"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_2.
kg:op_18 prop:content "宣言と一体で計画改定を進める考えを示す"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_2.
kg:op_19 prop:content "地域のエネルギー地産地消を進める体制づくりを進めている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_2.
kg:st_5 rdfs:label "斎藤弥志夫議員"@ja.
kg:st_5 rdf:type cls:st_9.
kg:op_20 prop:content "将来の電力不足対応として洋上風力は効果的で事業をまとめるべきだと考える"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_5.
kg:op_21 prop:content "宣言後は町民周知と実際の排出削減へのつなぎ方が重要だと述べる"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:st_6 rdfs:label "遊佐町沖洋上風力発電事業計画に係る調査等特別委員会"@ja.
kg:st_6 rdf:type cls:st_6.
cls:st_6 rdfs:label "委員会"@ja.
kg:op_22 prop:content "異常気象が続く中で温室効果ガス削減の必要性は広く共有されていると整理する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_6.
kg:st_7 rdfs:label "酒田市議会建設経済常任委員会"@ja.
kg:st_7 rdf:type cls:st_6.
kg:op_23 prop:content "基地港湾整備と経済波及効果に強い期待を示す"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_7.
kg:op_24 prop:content "町民にとって幅広いメリットが期待されると整理する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_6.
kg:st_8 rdfs:label "遊佐沖洋上風力発電を考える会"@ja.
kg:st_8 rdf:type cls:st_59.
cls:st_59 rdfs:label "住民団体"@ja.
kg:op_25 prop:content "離岸距離や景観への不安と疑問を示す"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_8.
kg:op_26 prop:content "風車完成後の景観影響は避けられず認めた上で議論すべきだと考える"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_6.
kg:op_27 prop:content "超低周波を含む影響に疑問を示している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_8.
kg:st_9 rdfs:label "東北電力ネットワーク株式会社"@ja.
kg:st_9 rdf:type cls:st_21.
cls:st_21 rdfs:label "事業者"@ja.
kg:op_28 prop:content "送電網整備を着実に進めていると説明した"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_9.
kg:st_10 rdfs:label "酒田共同火力発電株式会社"@ja.
kg:st_10 rdf:type cls:st_21.
kg:op_29 prop:content "再エネ導入後も火力発電の調整機能は重要になると示した"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_10.
kg:st_11 rdfs:label "赤塚英一議員"@ja.
kg:st_11 rdf:type cls:st_9.
kg:op_30 prop:content "議会で判断するための情報が十分でないと考えている"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_11.
kg:op_31 prop:content "大事業で影響範囲が広いため多面的な情報提示が必要だと主張する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_11.
kg:op_32 prop:content "長期的影響も含めて議論すべきだと訴える"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_11.
kg:op_33 prop:content "長期だけでなく足元の影響も判断材料にすべきと述べる"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_11.
kg:op_34 prop:content "賛否を判断するため良い面も悪い面も全て示してほしいと求める"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_11.
kg:op_35 prop:content "次の議会でより十分な議論ができるよう今のうちに情報提示を求めるべきと考える"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_11.
kg:op_36 prop:content "情報提示は多くの町民の判断材料になると考える"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_11.
kg:st_12 rdfs:label "阿部満吉議員"@ja.
kg:st_12 rdf:type cls:st_9.
kg:op_37 prop:content "これまでの説明会努力を否定し町に泥を塗る文面だと懸念し取り下げを求める"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_12.
kg:op_38 prop:content "公文書は誰が読んでも分かる内容でなければならず現文面は誤解を招くおそれがあると指摘する"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "重要案件なので知恵を寄せ合い全会一致を目指せる文書に練るべきと提案する"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "正式文書として読める文章に直す段取りを取るべきと求める"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_12.
kg:op_41 prop:content "表現に不備があり再度推敲してまとめたほうがよいと考える"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_5.
kg:op_42 prop:content "住民からの要望や質問に答えるためにも資料不足を解消したいと述べる"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_11.
kg:op_43 prop:content "電気代上昇の背景に電力不足があるとみて安定供給策として洋上風力を評価する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_5.
kg:op_44 prop:content "将来の電力不足に対応するためクリーンエネルギーとして洋上風力を進めるべきと考える"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_5.
kg:op_45 prop:content "洋上風力開発が進む現実の中では宣言の意味がより重いと受け止める"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "表明した自治体の中では地域として宣言はしたものの、では何を具体的に取り組めばいいのかというところで悩まれている、実際何も進んでいないという自治体も、山形県内のみならず、全国多々ある"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "本町の計画で当初の計画では今年度末、令和５年度末にカーボンニュートラル、ゼロカーボンシティ宣言をする予定を当初しておりました。といいますのは今年度、令和５年度、エネルギー基本計画の改定を行うというところがございます"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "現状の状況として地域脱炭素移行・再エネ推進交付金という国の補助金もございますが、そういう補助金の活用、今現在遊楽里、あぽん西浜等の改修計画の中で、そういう補助金の活用も今視野に入れて検討している"@ja.
<< kg:id_1 prop:cause kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "今年度のエネルギー基本計画の改定の中で地産地消、エネルギー協議会というものも今設立というところで動き出し始めているという状況"@ja.
<< kg:id_1 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "先日の法定協議会で意見の取りまとめが終わりました遊佐町沖の洋上風力発電事業も進んでいるというような、脱炭素に向けた様々な取組が進行している"@ja.
<< kg:id_1 prop:cause kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "これから環境省の補助事業の採択を受ける中で、ゼロカーボンシティ宣言というものが採択要件であったり、有利に補助を受けられるという状況がございましたので、今回この議会においての宣言ということにさせてもらった"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "表明した自治体の中では地域として宣言はしたものの、では何を具体的に取り組めばいいのかというところで悩まれている、実際何も進んでいないという自治体も、山形県内のみならず、全国多々ある"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "ゼロカーボンシティ宣言というものが採択要件であったり"@ja.
<< kg:id_8 prop:effect kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "有利に補助を受けられるという状況がございました"@ja.
<< kg:id_8 prop:effect kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "まずは議会も同意するということで歩調を合わせるということになります"@ja.
<< kg:id_8 prop:effect kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "ゼロカーボンシティが宣言されたから直ちに実行力が生じるかというとそれはない"@ja.
<< kg:id_8 prop:effect kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "教育的効果も含めれば、こういうことを少しずつ積み重ねて皆さんの意識を高めていくということが大事"@ja.
<< kg:id_8 prop:effect kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "何かの折にあのとき議会はゼロカーボンシティ宣言に同意したではないかというような話になってしまっては、これは本来のゼロカーボンシティの宣言の趣旨から外れてくる"@ja.
<< kg:id_16 prop:countermeasure kg:id_17 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "町として全力で取り組むことを決意し、全町民の名においてゼロカーボンシティを目指す"@ja.
<< kg:id_16 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "地域脱炭素移行・再エネ推進交付金という国の補助金もございますが、そういう補助金の活用、今現在遊楽里、あぽん西浜等の改修計画の中で、そういう補助金の活用も今視野に入れて検討している"@ja.
<< kg:id_16 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "今年度、令和５年度、エネルギー基本計画の改定を行う"@ja.
<< kg:id_16 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "地産地消、エネルギー協議会というものも今設立というところで動き出し始めている"@ja.
<< kg:id_16 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "遊佐町沖の洋上風力発電事業も進んでいるというような、脱炭素に向けた様々な取組が進行している"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "どういうふうに町民の皆さんにこの宣言をしたということを伝えて、そしてそれを実際の遊佐町の、本当の意味で二酸化炭素の排出を減らすというところでどういうふうに使っていくかというのがむしろ大事"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "異常気象が恒常化する昨今、温室効果ガスの削減の必要性は衆目のほぼ一致するところ"@ja.
<< kg:id_26 prop:effect kg:id_27 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_23;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "酒田市議会からは酒田港の洋上風力発電の基地港湾への指定に伴う港湾整備と、経済的波及効果に強い期待が示された。経済界からは当該事業の経済的効果に強い期待が寄せられており、町民にとって幅広いメリットも期待される"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_25;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "離岸距離や景観への影響について関心が高い。確かに風車完成後、程度は別にせよ景観への影響は排除できない。考える会のメンバーからは離岸距離、景観、超低周波、事業の進め方などを巡り疑問点が示された"@ja.
<< kg:id_26 prop:effect kg:id_29 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "考える会のメンバーからは離岸距離、景観、超低周波、事業の進め方などを巡り疑問点が示された"@ja.
<< kg:id_26 prop:effect kg:id_30 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "東北電力ネットワーク（株）から、送電網の整備を着実に進めている旨、情報を得た"@ja.
<< kg:id_26 prop:effect kg:id_31 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "酒田共同火力発電（株）からは、再生可能エネルギーの導入により、出力調整がしやすい火力発電の存在意義が相対的に重要になるであろうことが示された"@ja.
<< kg:id_32 prop:cause kg:id_33 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "当議会においてもこれまで議論を進めてきましたが、その議論の中でも適切な情報提供がされていない部分が多々あると思っています"@ja.
<< kg:id_32 prop:cause kg:id_34 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "これだけの大事業ではその影響は非常に広く、多岐にわたるものです。30年先、50年先といった長いスパンで考えなければならないことではありますが、また目の前の影響も当然考えなければなりません"@ja.
<< kg:id_26 prop:effect kg:id_35 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "30年先、50年先といった長いスパンで考えなければならない"@ja.
<< kg:id_26 prop:effect kg:id_36 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "また目の前の影響も当然考えなければなりません"@ja.
<< kg:id_26 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "できるだけ多くの偏らない情報を提示していただくことが重要だと考えます。全ての情報を出してください。いいも悪いも全てをまないたの上に上げて皆さんで議論、検討しましょうね"@ja.
<< kg:id_26 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "次期議会においては十分な議論ができるように遊佐町沖洋上風力発電事業への情報の提示を求める要望書を提案するものです"@ja.
<< kg:id_39 prop:effect kg:id_40 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "多くの町民の方々の判断材料にもなります"@ja.
<< kg:id_39 prop:effect kg:id_41 >>
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "この文面であると今まで苦労してくれた町長なり執行部側の説明会は何だったのか。それは、大変町に対して泥を塗るような意見書の提出だと思います"@ja.
<< kg:id_39 prop:effect kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "受け取った人がこれを読んで、すんなりこういうことを遊佐町議会として言っているのだということが分かることはやっぱり必要だと思う。やはりそれ以上にその文章の書き方というのは相当気を遣わないと、いろいろそれこそ文字どおり誤解を招く"@ja.
<< kg:id_39 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:stateBy kg:st_12;
    prop:relatedOpinion kg:op_40;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "やはり文書を練って、推敲して出すと。ちゃんと推敲した文章をつくり直すというお考えはないでしょうか。もう一回推敲して書いたほうがいいのではないか"@ja.
<< kg:id_39 prop:cause kg:id_44 >>
    prop:stateBy kg:st_11;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "我々議会に対してもいろんな形でいろんな要望が来ています。ご質問も皆さんのところには個別に来ているかと思いますけれども、それに対して十分私は答えられるだけの資料がなかったのが事実でございました"@ja.
<< kg:id_26 prop:cause kg:id_45 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "電気代がまた大分上がったりしているのです。何で上がるのかと、これ短絡的な考えなのですけれども、電気の量が不足しているのではないか"@ja.
<< kg:id_26 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "将来の電力不足にやっぱり対応するためにも電気の安定供給は必要だと、私はこのように考えております。できるだけクリーンエネルギーでそれを達成すべきである"@ja.
<< kg:id_26 prop:effect kg:id_47 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "遊佐町においては現実的には洋上風力発電が開発、設置が進められている中において、一般論としてのゼロカーボンシティ宣言以上の重みがあるのではないかな"@ja.
}
