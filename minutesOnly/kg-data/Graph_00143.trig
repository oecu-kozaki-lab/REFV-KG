kg:id_7 rdf:type cls:c_591.
cls:c_591 rdfs:label "発電施設"@ja.
kg:id_8 rdfs:label "固定資産税の増収"@ja.
kg:id_8 rdf:type cls:c_107.
cls:c_107 rdfs:label "税収増"@ja.
kg:id_7 prop:effect kg:id_8.
