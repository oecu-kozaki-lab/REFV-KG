kg:st_1 rdfs:label "関井美喜男議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "市民の命を守ることを前提に各種事業を執行すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "江口暢子議員"@ja.
kg:st_2 rdf:type cls:st_9.
kg:op_2 prop:content "感染拡大の抑制と経済の克服は行政の大きな課題"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "新年度も新しい生活様式を前提に事業執行すべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_3 rdfs:label "丸山至市長"@ja.
kg:st_3 rdf:type cls:st_11.
cls:st_11 rdfs:label "首長"@ja.
kg:op_4 prop:content "厳しい財源不足を想定し全ての事業を一件査定した"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "国の交付金活用を含め具体的支援策を検討する"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "経済状況やアンケートを踏まえて支援を検討する"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "市役所に来なくてもサービスを受けられる必要性に気づかされた"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:st_4 rdfs:label "進藤晃議員"@ja.
kg:st_4 rdf:type cls:st_9.
kg:op_8 prop:content "デジタル技術は新しい生活様式の実践に不可欠"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_4.
kg:op_9 prop:content "新しい生活様式の実践にデジタル技術は必要不可欠"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_4.
kg:op_10 prop:content "収束への大きな期待が寄せられている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_4.
kg:op_11 prop:content "正確で迅速な情報発信が重要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:st_5 rdfs:label "本多茂議員"@ja.
kg:st_5 rdf:type cls:st_9.
kg:op_12 prop:content "高齢者や接種を望まない人への配慮が必要"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_5.
kg:op_13 prop:content "今後も感染対策を優先すべき"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_4.
kg:op_14 prop:content "感染対策と両立して医療体制の確立が必要"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_4.
kg:op_15 prop:content "市民一丸となって知恵を出し行動すべき"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_4.
kg:op_16 prop:content "市独自の経済支援策の考え方を示すべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "知恵を出し行動していく必要がある"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_4.
kg:op_18 prop:content "医師会や病院機構と協力し市民が接種できるよう準備を進める"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "市民は接種時期や副反応に不安を抱えている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "供給が見えず接種体制や準備を確定できない"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "国の動向を注視し詳細が分かり次第体制を整える"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "できるだけ迅速に正確な情報を周知する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "相談窓口の役割分担を市民に分かりやすくすべき"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:st_6 rdfs:label "菊池裕基健康福祉部長"@ja.
kg:st_6 rdf:type cls:st_41.
cls:st_41 rdfs:label "部局長"@ja.
kg:op_24 prop:content "市と県が連携して相談や副反応対応につなげる"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_6.
kg:op_25 prop:content "高齢者等のために電話でも予約できるようにする"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "地域の援助が得られるよう検討する"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "過疎地域の高齢者の交通手段確保が心配"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_5.
kg:op_28 prop:content "どのような支援ができるか検討している"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "接種を選ばない人への差別が起きないようにすべき"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_5.
kg:op_30 prop:content "個人の意思を尊重し誹謗中傷がないよう呼びかける"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "経済対策や感染防止対策やデジタル化を総合的に検討する"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "厳しい業種に速やかに補助金を交付した"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "好評だったため再開を望む"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_5.
kg:op_34 prop:content "市民からもう一回やってほしい声がある"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_1.
kg:op_35 prop:content "効果が高かったため再度実施の方向で詰める"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "前回以上の利用も見込まれる"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "日頃から災害に備える重要性を認識すべき"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_4.
kg:op_38 prop:content "防災意識の向上と対策に取り組む必要がある"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_4.
kg:op_39 prop:content "国土強靭化による本市の対策に取り組む必要がある"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_4.
kg:op_40 prop:content "災害への日常的備えの重要性を認識すべき"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_4.
kg:op_41 prop:content "ハード面だけでなくソフト面の施策も重要"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_1.
kg:op_42 prop:content "常日頃からのネットワーク強化と訓練が非常に重要"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "住民や関係機関やボランティアが連携した訓練を継続する"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "農家は通常の被害回避対策を講じる時間もなかった"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "今まで経験したことのない被害として重く受け止めるべき"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_5.
kg:op_46 prop:content "春作業への影響や離農の懸念がある"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_5.
kg:op_47 prop:content "被害発生後すぐに国へ支援をお願いした"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "国の支援は手厚い内容だと受け止めている"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "農協と協力しながら作業を進める"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "遅れが明らかになった時点で正しい情報発信をすべき"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_1.
kg:op_51 prop:content "工程短縮につながる工夫を施工者と検討する"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_3.
kg:op_52 prop:content "事業の遅れについて市民へ情報発信すべき"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_1.
kg:op_53 prop:content "学力向上だけでなく不登校を減らすことが大きな課題"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_5.
kg:st_7 rdfs:label "村上幸太郎教育長"@ja.
kg:st_7 rdf:type cls:st_93.
cls:st_93 rdfs:label "教育長"@ja.
kg:op_54 prop:content "小中学校間で情報交換を密にし注意深く見守る"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_7.
kg:op_55 prop:content "不登校児童の情報把握と支援強化を図る"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_7.
kg:op_56 prop:content "地域と学校が目標やビジョンを共有し総がかりで子供を育てる"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_7.
kg:op_57 prop:content "学校と地域が同じ目的に向けて役割分担して活動する"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_7.
kg:op_58 prop:content "時間や場所の問題を解決し市民がデジタルでつながる社会を目指す"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_3.
kg:op_59 prop:content "感染症に強い持続可能なまちづくりにつながる"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_4.
kg:op_60 prop:content "いつでもどこでも利用可能なニーズは高い"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_3.
kg:op_61 prop:content "オンライン手続のニーズは高いと改めて感じた"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_3.
kg:op_62 prop:content "理解度に応じた個別学習や質の高い授業づくりを行う"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_3.
kg:op_63 prop:content "効率化で生まれた余力をマンパワーとして振り向ける"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_3.
kg:op_64 prop:content "誰一人取り残さない人に優しいデジタル変革を目指す"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_3.
kg:op_65 prop:content "市民全体のデジタル活用力向上を図る"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_3.
kg:op_66 prop:content "女性が能力を発揮できる働きやすい環境づくりを進める"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_3.
kg:op_67 prop:content "制度内容と支援体制を示すべき"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_4.
kg:op_68 prop:content "機運醸成と取組事業主への支援を拡充したい"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_3.
kg:op_69 prop:content "各事業所に合った働きやすい職場づくりを支援する"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_3.
kg:op_70 prop:content "働きやすい職場環境づくりへの取組を促す"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_3.
kg:op_71 prop:content "自己啓発を促し酒田で生き生きと働きたい女性を支援する"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_3.
kg:op_72 prop:content "デジタルスキルを身につけ多様な働き方を選択できるよう支援する"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_3.
kg:op_73 prop:content "リモートワーカーとして勤務する実績が出ている"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_3.
kg:op_74 prop:content "港湾や周辺整備も進み地域活性化につながる"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_4.
kg:op_75 prop:content "環境や景観や雇用の現状を踏まえ慎重で丁寧な議論が必要"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_2.
kg:op_76 prop:content "当地域への早期導入には酒田港の基地港湾指定が必要不可欠"@ja.
kg:op_76 rdf:type cls:opinion.
kg:op_76 prop:speaker kg:st_3.
kg:op_77 prop:content "直接効果と一次二次の経済波及効果が期待できる"@ja.
kg:op_77 rdf:type cls:opinion.
kg:op_77 prop:speaker kg:st_3.
kg:op_78 prop:content "港湾政策は重要であり一定の人員増も必要"@ja.
kg:op_78 rdf:type cls:opinion.
kg:op_78 prop:speaker kg:st_1.
kg:op_79 prop:content "機能と体制を強化して取り組む"@ja.
kg:op_79 rdf:type cls:opinion.
kg:op_79 prop:speaker kg:st_3.
kg:op_80 prop:content "庄内2市3町と県と大学が一緒に検討を進める必要がある"@ja.
kg:op_80 rdf:type cls:opinion.
kg:op_80 prop:speaker kg:st_3.
kg:op_81 prop:content "これまでの経過と今後の対応を明らかにすべき"@ja.
kg:op_81 rdf:type cls:opinion.
kg:op_81 prop:speaker kg:st_4.
kg:op_82 prop:content "県と市がしっかり向き合って話し合う必要がある"@ja.
kg:op_82 rdf:type cls:opinion.
kg:op_82 prop:speaker kg:st_5.
kg:op_83 prop:content "後ろ向きではなくこれからもしっかり進めていく"@ja.
kg:op_83 rdf:type cls:opinion.
kg:op_83 prop:speaker kg:st_3.
kg:op_84 prop:content "第三者に危害を与える老朽空き家への対応を進めるべき"@ja.
kg:op_84 rdf:type cls:opinion.
kg:op_84 prop:speaker kg:st_5.
kg:op_85 prop:content "所有者等に適切な管理責務がある"@ja.
kg:op_85 rdf:type cls:opinion.
kg:op_85 prop:speaker kg:st_3.
kg:op_86 prop:content "発生予防から管理不全空き家対策まで総合的計画的に進める"@ja.
kg:op_86 rdf:type cls:opinion.
kg:op_86 prop:speaker kg:st_3.
kg:op_87 prop:content "第三者への重大な損害を防ぐためやむを得ない場合に実施する"@ja.
kg:op_87 rdf:type cls:opinion.
kg:op_87 prop:speaker kg:st_3.
kg:op_88 prop:content "事業の優先順位明確化と見直しや業務改善が重要"@ja.
kg:op_88 rdf:type cls:opinion.
kg:op_88 prop:speaker kg:st_4.
kg:op_89 prop:content "市民サービス低下を連想させない説明が必要"@ja.
kg:op_89 rdf:type cls:opinion.
kg:op_89 prop:speaker kg:st_1.
kg:op_90 prop:content "歳入水準を上げつつ歳出見直しを進める考えだ"@ja.
kg:op_90 rdf:type cls:opinion.
kg:op_90 prop:speaker kg:st_3.
kg:op_91 prop:content "事務事業をゼロベースとする一件査定の考え方を伺いたい"@ja.
kg:op_91 rdf:type cls:opinion.
kg:op_91 prop:speaker kg:st_4.
kg:op_92 prop:content "真に必要な経費を絞り込むために実施した"@ja.
kg:op_92 rdf:type cls:opinion.
kg:op_92 prop:speaker kg:st_3.
kg:op_93 prop:content "成果の低い事業の廃止縮小や類似事業整理を進める"@ja.
kg:op_93 rdf:type cls:opinion.
kg:op_93 prop:speaker kg:st_3.
kg:op_94 prop:content "後年度の公債費や維持管理費の縮減を図る"@ja.
kg:op_94 rdf:type cls:opinion.
kg:op_94 prop:speaker kg:st_3.
kg:op_95 prop:content "商工業や農林水産業の振興で歳入水準を上げていく"@ja.
kg:op_95 rdf:type cls:opinion.
kg:op_95 prop:speaker kg:st_3.
kg:op_96 prop:content "好調なふるさと納税を踏まえた財源確保を図るべき"@ja.
kg:op_96 rdf:type cls:opinion.
kg:op_96 prop:speaker kg:st_4.
kg:op_97 prop:content "20億円を見込み持続可能な財政基盤確立の一つとする"@ja.
kg:op_97 rdf:type cls:opinion.
kg:op_97 prop:speaker kg:st_3.
kg:op_98 prop:content "財政運営にとって非常にプラス要因になる"@ja.
kg:op_98 rdf:type cls:opinion.
kg:op_98 prop:speaker kg:st_3.
kg:op_99 prop:content "どの程度廃止したかを明らかにすべき"@ja.
kg:op_99 rdf:type cls:opinion.
kg:op_99 prop:speaker kg:st_1.
kg:op_100 prop:content "先送り事業の今後の対応を示すべき"@ja.
kg:op_100 rdf:type cls:opinion.
kg:op_100 prop:speaker kg:st_1.
kg:op_101 prop:content "やれる事業が出た場合は補正予算で対応すべき"@ja.
kg:op_101 rdf:type cls:opinion.
kg:op_101 prop:speaker kg:st_1.
kg:op_102 prop:content "開催可能となった場合に補正予算で対応する場面はあり得る"@ja.
kg:op_102 rdf:type cls:opinion.
kg:op_102 prop:speaker kg:st_3.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "新型コロナウイルス感染症の猛威によって、社会生活や経済活動に大きな影響を及ぼし、取り巻く環境は大きく変わってしまいました"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "コロナ禍による観光業、飲食業をはじめとする地域経済への打撃は、今なお大きく、感染拡大の抑制と経済の克服は行政において大きな課題であります"@ja.
<< kg:id_4 prop:effect kg:id_5 >>
    prop:text-txt_contents "新型コロナウイルスの影響により私たちの生活は一変し"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "今年度におきましても多くの事業やイベントが中止、または延期を余儀なくされ"@ja.
<< kg:id_1 prop:effect kg:id_7 >>
    prop:text-txt_contents "年度途中で何度も予算の補正をしながら、感染予防対策や緊急的な経済対策を講じてまいりました"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "コロナ禍による市税の減収"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "庄内地域で新型コロナウイルスの感染者が増加した年末以降、お酒の席の自粛や忘新年会のキャンセルにより、飲食業と宿泊業では依然として経営が厳しい状況になっております"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "回答がありました615社のうち73.5％に当たる452社が経営に影響が生じていると回答しており、新型コロナウイルス感染症の拡大は、多くの幅広い業種に長期間にわたり影響が及んでいる"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "設置に当たって、その大きなきっかけとなったのは、実はコロナ禍で国が行った特別定額給付金のオンライン手続でございました"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "感染リスクを低減するため人との距離を一定程度保つことやマスクの着用、手指消毒、部屋の換気など、新しい生活様式が求められています"@ja.
<< kg:id_13 prop:countermeasure kg:id_15 >>
    prop:text-txt_contents "感染リスクを低減するため人との距離を一定程度保つこと"@ja.
<< kg:id_13 prop:countermeasure kg:id_16 >>
    prop:text-txt_contents "マスクの着用"@ja.
<< kg:id_13 prop:countermeasure kg:id_17 >>
    prop:text-txt_contents "手指消毒"@ja.
<< kg:id_13 prop:countermeasure kg:id_18 >>
    prop:text-txt_contents "部屋の換気"@ja.
<< kg:id_11 prop:effect kg:id_19 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "これらの実践にはデジタル技術が必要不可欠であり"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "本市においてもまもなく始まるワクチン接種に収束への大きな期待が寄せられています"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "今後も感染対策を優先しつつ"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "医療体制の確立"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_15;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "地域経済の早期回復を目指し"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "市民一丸となって知恵を出し行動していかなくてはなりません"@ja.
<< kg:id_25 prop:countermeasure kg:id_26 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "市が設ける施設で土曜日、日曜日、祝日に実施する集団接種と、かかりつけ医の診療所での個別接種、これを組み合わせて市民の皆様から接種いただけるように準備を今進めているところでございます"@ja.
<< kg:id_25 prop:effect kg:id_27 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "市民の皆様は、様々な情報が錯綜する中で、自分はいつどこでどういった順番で接種できるのだろうか、あるいは副反応は本当に大丈夫なのだろかなど、不安と期待が大きくなっている"@ja.
<< kg:id_25 prop:cause kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "国からのワクチン供給が酒田市にどの程度入ってくるのか、いつ届くのか、全く見えない状況では、接種体制や準備も確定できません"@ja.
<< kg:id_25 prop:countermeasure kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "ホームページ、あるいは広報、さらには酒田市のＬＩＮＥ公式アカウント、ツイッター、そういった媒体を駆使いたしまして、できるだけ迅速に正確な情報を周知してまいりたい"@ja.
<< kg:id_25 prop:countermeasure kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "コールセンターも３月１日に設置いたしました"@ja.
<< kg:id_25 prop:countermeasure kg:id_31 >>
    prop:text-txt_contents "65歳以上の高齢者の方に対しましては、３月下旬に郵送するための準備を今、整えている最中でございます"@ja.
<< kg:id_25 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "高齢者等でありますが、そういった方々に対しては、その予約に対してはコールセンターを設置をして、電話で予約受付ができる体制も整えているところでございます"@ja.
<< kg:id_25 prop:countermeasure kg:id_33 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "自治会や民生委員などからも協力が得られるよう検討してまいりたい"@ja.
<< kg:id_25 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_27;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "バスやタクシーの運行など、どのような支援ができるかについて検討をしているところでございます"@ja.
<< kg:id_25 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_29;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "接種をされない方が差別的な扱いを受けることはあってはならない"@ja.
<< kg:id_1 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "国の新型コロナウイルス感染症対応地方創生臨時交付金の第３次の交付限度額６億3,483万円、これを活用した経済対策・支援"@ja.
<< kg:id_1 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "飲食業、宿泊業、タクシー業・運転代行業に対する追加支援を提案し、議決後、速やかに567件の事業者に対して約１億5,900万円ほどの補助金を交付をした"@ja.
<< kg:id_38 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_33;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_34;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "さきに実施したキャッシュレス決済導入促進事業のアンケート調査、これはＰａｙＰａｙのキャンペーンですけれども"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "消費者の90.1％、事業者の82.6％が「ＰａｙＰａｙキャンペーンのほうがよかった」と、このように回答をしているところでございます"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "本市においても豪雨や暴風雪による被害が発生している"@ja.
<< kg:id_44 prop:cause kg:id_45 >>
    prop:text-txt_contents "去る２月13日には宮城・福島県沖を震源とする地震が発生し"@ja.
<< kg:id_44 prop:effect kg:id_46 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "本市でも震度４の強い揺れを観測しています"@ja.
<< kg:id_42 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "防災意識の向上と国土強靭化よる本市の対策にも取り組む必要がある"@ja.
<< kg:id_42 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "日頃から災害に備えることの重要性を認識するとともに"@ja.
<< kg:id_42 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_41;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "常日頃からの関係団体や企業、自治会、ボランティア団体などとのネットワークの強化"@ja.
<< kg:id_42 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "避難所運営訓練を中心として、関係機関と連携した実践型の訓練を開催しております"@ja.
<< kg:id_42 prop:countermeasure kg:id_51 >>
    prop:text-txt_contents "防災ガイドブックや津波ハザードマップ等を作成して全戸配布している"@ja.
<< kg:id_42 prop:countermeasure kg:id_52 >>
    prop:text-txt_contents "出前講座についても積極的に行っております"@ja.
<< kg:id_53 prop:cause kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "雪があまりに短時間に降ったために、通常はパイプハウスが潰れないようビニールを破るなどの対策を講じるわけですけれども、そうした時間もなかった"@ja.
<< kg:id_53 prop:effect kg:id_55 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "800棟を超えるパイプハウスの損壊"@ja.
<< kg:id_53 prop:effect kg:id_56 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "出荷予定の農作物の被害など、甚大かつ深刻な被害を受けた"@ja.
<< kg:id_53 prop:effect kg:id_57 >>
    prop:text-txt_contents "施設等の被害が824件で、被害額としては２億5,200万円超"@ja.
<< kg:id_53 prop:effect kg:id_58 >>
    prop:text-txt_contents "作物等の被害も158件で、4,400万円を超える被害"@ja.
<< kg:id_59 prop:countermeasure kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "被害発生後、すぐに地元選出の代議士等を通じて、国に対して、暴風雪被害の復旧支援のお願いをした"@ja.
<< kg:id_59 prop:countermeasure kg:id_61 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "農業用ハウスの導入支援などが具体的に示された"@ja.
<< kg:id_59 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "国や県の対策を最大限活用できるよう農協と協力しながら作業を進めている"@ja.
<< kg:id_59 prop:countermeasure kg:id_63 >>
    prop:text-txt_contents "ふるさと納税を活用したガバメントクラウドファンディングに取り組んでおり"@ja.
<< kg:id_59 prop:countermeasure kg:id_64 >>
    prop:text-txt_contents "出荷できなくなった農産物を市職員有志で購入するなどの取組も行っている"@ja.
<< kg:id_65 prop:cause kg:id_66 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "コロナ禍による資材の調達遅延などにより、１か月ほど遅れて昨年11月にオープン"@ja.
<< kg:id_65 prop:effect kg:id_67 >>
    prop:text-txt_contents "１か月ほど遅れて昨年11月にオープンいたしました"@ja.
<< kg:id_65 prop:cause kg:id_68 >>
    prop:text-txt_contents "年末年始の強風や大雪などの悪天候によるクレーンの稼働制限ですとか地中障害物への対応のため"@ja.
<< kg:id_65 prop:effect kg:id_69 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "全体としては計画より１か月半程度の遅れとなっております"@ja.
<< kg:id_70 prop:cause kg:id_71 >>
    prop:text-txt_contents "コロナ禍のために首都圏の厨房設計業者との調整を進めることができず"@ja.
<< kg:id_70 prop:effect kg:id_72 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "プレオープンを見送ることとなっております"@ja.
<< kg:id_70 prop:countermeasure kg:id_73 >>
    prop:text-txt_contents "10月上旬にオープンを予定している"@ja.
<< kg:id_74 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "保育園から小学校、小学校から中学校間でのきめ細かな一貫教育を推進することが重要"@ja.
<< kg:id_74 prop:effect kg:id_76 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "いわゆる中１ギャップと言われるものによって、中学生、特に入学したばかりとかですが、不登校が発生しやすい"@ja.
<< kg:id_74 prop:countermeasure kg:id_77 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "中学校の教員やスクールカウンセラーが小学校６年生の不登校の子供さんの情報を得たりするために、積極的に小学校を訪問したり"@ja.
<< kg:id_74 prop:countermeasure kg:id_78 >>
    prop:text-txt_contents "スクールカウンセラーが家庭訪問相談員と一緒に児童の家庭訪問を実施したりしている"@ja.
<< kg:id_79 prop:countermeasure kg:id_80 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "学校運営協議会のほうは、保護者や地域の方々が一定の権限を持って学校運営に参画していく、目標とかビジョンを共有する"@ja.
<< kg:id_81 prop:countermeasure kg:id_82 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "地域社会全体で未来を担う子供を支える活動、地域を創生する活動"@ja.
<< kg:id_83 prop:countermeasure kg:id_84 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "昨年10月１日にデジタル変革戦略室を設置をいたしました"@ja.
<< kg:id_83 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_59;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "オンラインによる行政手続が可能になることで、情報収集や24時間対応など"@ja.
<< kg:id_83 prop:effect kg:id_86 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "応募された2,407人のうち、市役所が開いていない時間帯の応募者が76.1％を占めている"@ja.
<< kg:id_83 prop:countermeasure kg:id_87 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "ＧＩＧＡスクールで整備するタブレット端末等を活用して、理解度に応じた個別学習や酒田市教育研修センターでの質の高い授業づくりを行う"@ja.
<< kg:id_83 prop:countermeasure kg:id_88 >>
    prop:text-txt_contents "サンロクが行う地元企業のデジタル化を図る事業"@ja.
<< kg:id_83 prop:countermeasure kg:id_89 >>
    prop:text-txt_contents "データと科学的分析により土づくりを行うデジタル農業の事業"@ja.
<< kg:id_83 prop:countermeasure kg:id_90 >>
    prop:text-txt_contents "定期船とびしまの乗船予約システムとキャッシュレス決済の導入"@ja.
<< kg:id_83 prop:countermeasure kg:id_91 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "デジタル弱者と呼ばれる方々も存在するわけでございまして、こういった方々に対しましては、行政のデジタル変革で効率化されたことによる余力を、マンパワーとしての余力を振り向ける"@ja.
<< kg:id_83 prop:countermeasure kg:id_92 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "音声で操作できるですとか、キーボードとかマウスを操作する必要がない使いやすい機器ですとか、方法によるサービスの提供"@ja.
<< kg:id_83 prop:countermeasure kg:id_93 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "市民向けスマートフォン活用セミナーの開催など、市民全体のデジタル活用力を向上させる施策"@ja.
<< kg:id_94 prop:countermeasure kg:id_95 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "女性活躍推進法に基づく一般事業主行動計画の策定の促進"@ja.
<< kg:id_94 prop:countermeasure kg:id_96 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "えるぼし認定を支援する奨励金制度を創設するとしており"@ja.
<< kg:id_94 prop:countermeasure kg:id_97 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "日本一女性が働きやすいまち宣言に賛同するリーダーの会を立ち上げました"@ja.
<< kg:id_94 prop:countermeasure kg:id_98 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "社会保険労務士を市が派遣する仕組みを講じてまいりたい"@ja.
<< kg:id_94 prop:countermeasure kg:id_99 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "100人以下の事業所でございますけれども、この事業者が計画を策定した場合には奨励金等を独自に交付する制度を創設"@ja.
<< kg:id_100 prop:countermeasure kg:id_101 >>
    prop:text-txt_contents "サンロクに常駐している女性活躍支援員が"@ja.
<< kg:id_100 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "おいしいサンロク女子会"@ja.
<< kg:id_100 prop:countermeasure kg:id_103 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "よろずＩＴ女子の育成を行う"@ja.
<< kg:id_103 prop:effect kg:id_104 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "昨年12月には、よろずＩＴ女子の中から...２名が就職をして"@ja.
<< kg:id_105 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_74;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "酒田市沖においても洋上風力発電の事業化に向けた検討を始める"@ja.
<< kg:id_105 prop:countermeasure kg:id_107 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_76;
    prop:text-txt_contents "酒田港を海洋再生可能エネルギー発電施設等拠点港湾、これはいわゆる基地港湾と言われるものですけれども、この基地港湾の指定に向けた検討"@ja.
<< kg:id_105 prop:effect kg:id_108 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_77;
    prop:text-txt_contents "この地域の活性化につながるものと考えております"@ja.
<< kg:id_105 prop:countermeasure kg:id_109 >>
    prop:text-txt_contents "新たに酒田沿岸地域検討部会を設置することが決まったところでございます"@ja.
<< kg:id_105 prop:countermeasure kg:id_110 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_78;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_79;
    prop:text-txt_contents "港湾振興室という部署が今あるんですけれども、ここを港湾・エネルギー振興係に改めまして、その機能と体制を強化"@ja.
<< kg:id_111 prop:cause kg:id_112 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_80;
    prop:text-txt_contents "東北公益文科大学を将来にわたり存続させるために"@ja.
<< kg:id_111 prop:effect kg:id_113 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_81;
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_82;
    prop:text-txt_contents "県より検討組織の設立準備について一旦停止するとの連絡があった"@ja.
<< kg:id_111 prop:countermeasure kg:id_114 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_83;
    prop:text-txt_contents "公立化の検討をやめるということでは決してなく、組織については内部で検討しているところであり決して後ろ向きではない"@ja.
<< kg:id_115 prop:cause kg:id_116 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_84;
    prop:text-txt_contents "人口減少、少子高齢化、核家族化や都市部への人口流出などにより空き家が増加し"@ja.
<< kg:id_115 prop:effect kg:id_117 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_85;
    prop:text-txt_contents "適正に管理されず、周辺へ悪影響を及ぼす事案が生じており"@ja.
<< kg:id_115 prop:countermeasure kg:id_118 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_86;
    prop:text-txt_contents "酒田市空き家等対策計画を策定をしているところでございます"@ja.
<< kg:id_115 prop:countermeasure kg:id_119 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_87;
    prop:text-txt_contents "危害が切迫した場合においては、その危害の予防や損害の拡大を防ぐために、やむを得ないと判断したときは、市が必要最小限の応急措置を実施いたします"@ja.
<< kg:id_115 prop:countermeasure kg:id_120 >>
    prop:text-txt_contents "相談体制の整備"@ja.
<< kg:id_115 prop:countermeasure kg:id_121 >>
    prop:text-txt_contents "適切な管理の促進"@ja.
<< kg:id_115 prop:countermeasure kg:id_122 >>
    prop:text-txt_contents "管理不全空き家及び特定空家等への対応"@ja.
<< kg:id_115 prop:countermeasure kg:id_123 >>
    prop:text-txt_contents "空き家の利活用などの対策を実施する"@ja.
<< kg:id_124 prop:cause kg:id_125 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_88;
    prop:text-txt_contents "人口減少や新型コロナウイルス感染症などの課題が山積する中"@ja.
<< kg:id_124 prop:effect kg:id_126 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_89;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_90;
    prop:text-txt_contents "社会保障制度の充実に伴う費用の増加などにより歳出が歳入水準を上回る構造になっておりまして"@ja.
<< kg:id_124 prop:countermeasure kg:id_127 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_91;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_92;
    prop:text-txt_contents "全ての事業について一件査定を行ったところでございます"@ja.
<< kg:id_124 prop:countermeasure kg:id_128 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_93;
    prop:text-txt_contents "所期の目的を達成した事業や成果の低い事業の廃止・縮小、類似する事業の整理等に取り組む"@ja.
<< kg:id_124 prop:countermeasure kg:id_129 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_94;
    prop:text-txt_contents "投資事業の規模を抑制するなどして、後年度の経常経費に含まれることになる公債費や維持管理費の縮減を図る"@ja.
<< kg:id_124 prop:countermeasure kg:id_130 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_95;
    prop:text-txt_contents "税収増を意識した施策の展開"@ja.
<< kg:id_124 prop:countermeasure kg:id_131 >>
    prop:text-txt_contents "市債発行額の抑制"@ja.
<< kg:id_124 prop:countermeasure kg:id_132 >>
    prop:text-txt_contents "繰上償還などによる市債残高の縮減"@ja.
<< kg:id_124 prop:countermeasure kg:id_133 >>
    prop:text-txt_contents "財政調整基金、それから市債管理基金の財源確保に努めながら市政運営に取り組んでまいりたい"@ja.
<< kg:id_124 prop:countermeasure kg:id_134 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_96;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_97;
    prop:text-txt_contents "ふるさと納税においては令和元年度以降好調であり、20億円が見込まれています"@ja.
<< kg:id_124 prop:countermeasure kg:id_135 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_98;
    prop:text-txt_contents "風力発電事業地域未来創造基金積立金、この皆増などは、財政運営にとっては非常にプラス要因"@ja.
<< kg:id_136 prop:effect kg:id_137 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_99;
    prop:text-txt_contents "廃止した事業については、令和２年度当初予算との比較では約80事業、廃止しております"@ja.
<< kg:id_136 prop:countermeasure kg:id_138 >>
    prop:text-txt_contents "新規の事業については約35事業でございます"@ja.
<< kg:id_136 prop:effect kg:id_139 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_100;
    prop:text-txt_contents "屋内型の児童遊戯施設の整備に係る市民からの意見を聞くためのワークショップは、令和２年度の開催を見送って、令和３年度も...当初予算案にはその経費を計上はしていない"@ja.
<< kg:id_136 prop:effect kg:id_140 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_101;
    prop:text-txt_contents "子どもまつり、さかた産業フェア、農林水産まつり等のイベントについても、新型コロナウイルス感染症の状況が見通せないことから、同様に当初予算案には計上を見送った"@ja.
<< kg:id_136 prop:countermeasure kg:id_141 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_102;
    prop:text-txt_contents "もし開催という形に整った場合に補正予算で対応するという場面は出てくるかと思います"@ja.
}
