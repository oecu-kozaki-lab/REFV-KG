kg:st_1 rdfs:label "後藤仁議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "1年間模様を見るのではなく今年度から還元事業を実施すべき"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "地域創生部長 佐々木好信"@ja.
kg:st_2 rdf:type cls:st_28.
cls:st_28 rdfs:label "部長"@ja.
kg:op_2 prop:content "慌てて還元するより還元の在り方をじっくり考えるべき"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "老朽化による施設改修は時期が集中し平準化は難しい"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "財政調整基金を活用し早急に集中的に対応すべき"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:st_3 rdfs:label "野球場管理の人"@ja.
kg:st_3 rdf:type cls:st_94.
cls:st_94 rdfs:label "施設管理者"@ja.
kg:op_5 prop:content "雨漏りは以前から続き直そうとしても浸透箇所が分からない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "浸水や排水不良を長く放置すべきではない"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:st_4 rdfs:label "公認審判員で活躍している方"@ja.
kg:st_4 rdf:type cls:st_95.
cls:st_95 rdfs:label "審判員"@ja.
kg:op_7 prop:content "外野の芝に雑草が混在し野球をしていて危ない"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_4.
kg:op_8 prop:content "排水不良が内野の状態悪化を招いている"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:st_5 rdfs:label "高野連"@ja.
kg:st_5 rdf:type cls:st_46.
cls:st_46 rdfs:label "競技団体"@ja.
kg:op_9 prop:content "熱中症対策上休ませる場所が足りず大会日程を入れるのに二の足を踏む"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_5.
kg:st_6 rdfs:label "地元の人"@ja.
kg:st_6 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_10 prop:content "今年は孟宗竹が不良で熊が今までより人家近くまで来ている"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_6.
kg:op_11 prop:content "住民ごとの立場に寄り添った対応マニュアルが必要"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "熊と住民がすみ分けるには餌場をつくらないことが基本"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "施設の老朽化が目立ち早急な対応が必要"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "浸水被害が繰り返され施設環境が悪化している"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:st_7 rdfs:label "小学校スポ少の父兄の女性"@ja.
kg:st_7 rdf:type cls:st_49.
cls:st_49 rdfs:label "保護者"@ja.
kg:op_15 prop:content "ベンチに入ってロッカールームの状況やカビ臭さに驚いた"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_7.
kg:op_16 prop:content "自慢だった野球場が負のイメージになることを危惧する"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "休養場所不足が大会運営上の支障になっている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_5.
kg:op_18 prop:content "施設条件から大会開催判断をためらっている"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_5.
kg:st_8 rdfs:label "熊が裏山50メートルぐらいに出たと話した住民"@ja.
kg:st_8 rdf:type cls:st_5.
kg:op_19 prop:content "乳児がいる中で熊が近くに出る地域では安心して暮らせない"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_8.
kg:st_9 rdfs:label "裏山近くの住民"@ja.
kg:st_9 rdf:type cls:st_5.
kg:op_20 prop:content "毎年のことだが孟宗竹を食べられる被害が出ている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_9.
kg:op_21 prop:content "今までと違い人家近くでの遭遇が増え対応の見直しが必要"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "収益は基金に積み立て広く市民に還元する方針"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_2.
kg:op_23 prop:content "収益が原資であることを踏まえ使途は今後決定する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_2.
kg:op_24 prop:content "市民理解のため広報でしっかり情報提供する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_2.
kg:op_25 prop:content "改修時期の集中に対し基金を活用して集中的に対応すべき"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_1.
kg:st_10 rdfs:label "地域おこし協力隊 内藤小容子さん"@ja.
kg:st_10 rdf:type cls:st_96.
cls:st_96 rdfs:label "地域協力員"@ja.
kg:op_26 prop:content "収穫されない柿を除去し餌場をなくす活動を研究している"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_10.
kg:op_27 prop:content "除去した柿を活用する方法も研究している"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_10.
kg:op_28 prop:content "熊対策用として緩衝帯を整備する施策があってよい"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_1.
kg:op_29 prop:content "もみ殻焼却などで煙や火の臭いを出し境界を示す対策を検討してほしい"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_1.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "運転初年度であることから予測の不確実性の程度が大きいということで、現時点では算出ができないという状況でございます"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:text-txt_contents "６月から９月までは季節風の風況が悪いということから、発電量が大幅に低下するだろうと見込んでございます"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "この風力発電事業につきましては、様々な自然の状況によって変化があったり、あるいは落雷とか、そういう自然の災害を受ける可能性が含まれている事業でございます"@ja.
<< kg:id_7 prop:cause kg:id_8 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "建設年度が同時期に集中し、施設を維持する中で修繕や維持管理など追いつかない状況ではないでしょうか"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "同時期に建設時期が集中していることから、老朽化による施設改修は時期が集中してしまう"@ja.
<< kg:id_11 prop:cause kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "これは、その雨漏りは今始まった話じゃないんだと。何とか直そうと思って、市のほうからもやっていただいているけれども、なかなかその浸透がどこからか分からない"@ja.
<< kg:id_13 prop:cause kg:id_14 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "施設全体の排水も不十分で、事務室には、昨年はここまで、一昨年の豪雨ではここまで浸水したという浸水の跡が明確に残っております。あと、非常に暗渠がもう老朽化していまして、先ほど言いましたとおり、大雨降るとみんな事務室だとかに水が入ってくる"@ja.
<< kg:id_15 prop:cause kg:id_16 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "外野の芝に雑草が非常に混在して、しっかり刈り取っているときは影響ないんだけれども、雑草ですので、油断をすると、芝と雑草の伸びが違いますので、非常に野球をしていて危ないと"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "そのことによって、常にダイヤモンドに砂をまくので、非常にダイヤモンド、内野ですね。内野のゾーンも砂漠化し始めている"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "高野連のほうからは、最近の高校野球も暑い中で試合をやりますので、熱中症対策が非常に重要になって、光ケ丘野球場にはクーラーが１部屋か、２部屋かな。事務室とアナウンス室だったかな。２つしか入っていないので、熱中症で２人、３人と倒れると、その人を休ませる場所もないんだと。だから、高野連としては、なかなか光ケ丘野球場で大会のスケジュールを入れるのに二の足を踏んでいる状況もある"@ja.
<< kg:id_21 prop:cause kg:id_22 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "今年の場合は、孟宗竹が不良なんだそうです。不良ですので、より近い民家近くまで熊が孟宗竹を食べに来ている"@ja.
<< kg:id_23 prop:cause kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "近年は熊が人家近く、30メートルから50メートル以内に熊が現れているという情報も多く、地元住民の不安感、危機感が強まっていると感じるところでございます"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "熊と住民、人間がすみ分けるには、餌場をつくらないことだと聞きました"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:text-txt_contents "現時点では算出ができないという状況でございます"@ja.
<< kg:id_29 prop:effect kg:id_30 >>
    prop:text-txt_contents "発電量が大幅に低下するだろうと見込んでございます"@ja.
<< kg:id_11 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "光ケ丘野球場のロッカールームには青いバケツが三、四個置かれ、雨漏りがしている箇所が多数見られる"@ja.
<< kg:id_32 prop:effect kg:id_33 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "事務室には、昨年はここまで、一昨年の豪雨ではここまで浸水したという浸水の跡が明確に残っております"@ja.
<< kg:id_34 prop:effect kg:id_35 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "建物の中もカビ臭い状況にあります"@ja.
<< kg:id_36 prop:effect kg:id_37 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "グラウンドの土や野外照明施設の劣化、外野の芝にも雑草が多くみられる"@ja.
<< kg:id_38 prop:effect kg:id_39 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "熱中症で２人、３人と倒れると、その人を休ませる場所もないんだと"@ja.
<< kg:id_40 prop:effect kg:id_41 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "高野連としては、なかなか光ケ丘野球場で大会のスケジュールを入れるのに二の足を踏んでいる状況もある"@ja.
<< kg:id_42 prop:effect kg:id_43 >>
    prop:stateBy kg:st_8;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "うちには乳児がいるんだと。そして、地域を散歩すると。そんな地域でいいのかと"@ja.
<< kg:id_42 prop:effect kg:id_44 >>
    prop:stateBy kg:st_9;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "裏山すぐ、その家も30メートルぐらいと言っていましたけれども、孟宗竹を今年も47本ほど食べられた"@ja.
<< kg:id_42 prop:effect kg:id_45 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "今までは遭遇していなかった人たちも人家近くで熊と遭遇し始めているというような状況もあると聞いておりました"@ja.
<< kg:id_46 prop:countermeasure kg:id_47 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "事業の収益につきましては、風力発電事業地域未来創造基金、こちらのほうに積立てをして、広く市民に還元できるようにと地域振興事業等に充てることとしております"@ja.
<< kg:id_46 prop:countermeasure kg:id_48 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "具体的な使途については未定でございますけれども、風力発電事業の収益が原資であるということを踏まえて、今後の予算編成の際に決定していきたい"@ja.
<< kg:id_46 prop:countermeasure kg:id_49 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "広報などでしっかりと情報提供させていただきながら、事業の経過、今後の展開などについて説明をさせていただければと思っている"@ja.
<< kg:id_50 prop:countermeasure kg:id_51 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "この施設改修を平準化するのは、私は難しいため財政調整基金を活用し、早急に集中的に対応していくべきと考えます"@ja.
<< kg:id_42 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "平田の東陽地区の地域おこし協力隊の内藤小容子さんが収穫されない柿の除去をして、餌場をなくし"@ja.
<< kg:id_42 prop:countermeasure kg:id_53 >>
    prop:stateBy kg:st_10;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "その柿を利用して渋柿をつくるという活動も昨年から研究しているようでございます"@ja.
<< kg:id_42 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "熊対策用としての緩衝帯を事業化して、それをつくっていく。私はそんな施策もあっていいのかなと思います"@ja.
<< kg:id_42 prop:countermeasure kg:id_55 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "トーチカ的なものを山と人里の間に何か所かつくりまして、そこで火をおこす。農作業のためのもみ殻をその境界線周辺で焼却するような施設をつくって、やはり煙、火の臭いを察知させて、熊からここからは人里だよねというような対策というものは考えられないものでしょうか"@ja.
}
