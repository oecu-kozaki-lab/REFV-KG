PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00156> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "洋上風力発電の導入の検討"@ja.
kg:id_1 rdf:type cls:c_175.
cls:c_175 rdfs:label "洋上風力発電"@ja.
kg:id_2 rdfs:label "山形県等と酒田市沖で協議を開始"@ja.
kg:id_2 rdf:type cls:c_3730.
cls:c_3730 rdfs:label "協議開始"@ja.
kg:id_1 prop:countermeasure kg:id_2.
kg:id_3 rdfs:label "洋上風力発電"@ja.
kg:id_3 rdf:type cls:c_175.
kg:id_4 rdfs:label "漁業者を対象とした勉強会の開催"@ja.
kg:id_4 rdf:type cls:c_240.
cls:c_240 rdfs:label "勉強会開催"@ja.
kg:id_3 prop:countermeasure kg:id_4.
kg:id_5 rdfs:label "洋上風力発電の事業化"@ja.
kg:id_5 rdf:type cls:c_175.
kg:id_6 rdfs:label "遊佐沖を有望な区域に選定"@ja.
kg:id_6 rdf:type cls:c_2860.
cls:c_2860 rdfs:label "区域選定"@ja.
kg:id_5 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "カーボンニュートラルに向けた今後の動きに大きな影響を与える"@ja.
kg:id_7 rdf:type cls:c_3731.
cls:c_3731 rdfs:label "影響"@ja.
kg:id_3 prop:effect kg:id_7.
kg:st_1 rdfs:label "話者"@ja.
kg:st_1 rdf:type cls:st_97.
cls:st_97 rdfs:label "話者"@ja.
kg:op_1 prop:content "漁業と洋上風力発電の共存や漁業振興を一緒に学んだ"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "カーボンニュートラルに向けた今後の動きに大きな影響を与える出来事だと考える"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:text-txt_contents "山形県等と酒田市沖での洋上風力発電の導入の検討に向けた協議を今、山形県との間で開始しているところでございます"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "山形県漁業協同組合の主催によります漁業者を対象とした洋上風力勉強会が開催されております。この勉強会には私も参加をいたしましたけれども、同じ海域を利用する漁業と洋上風力発電の共存ですとか、漁業の振興について一緒に勉強させていただいた"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:text-txt_contents "遊佐沖について、国土交通省と経済産業省が具体的な検討を進めるべきだという有望な区域に選定をした"@ja.
<< kg:id_3 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "この洋上風力発電という形を通してではありますけれども、カーボンニュートラルに向けた今後の動きに大きな影響を与えるそういう出来事ではなかったかと考えております"@ja.
}
