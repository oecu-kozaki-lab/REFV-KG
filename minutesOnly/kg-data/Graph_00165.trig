PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prop: <https://kozaki-lab.jp/REFV-KG/prop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cls: <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX kg: <https://kozaki-lab.jp/REFV-KG/data/>

<https://kozaki-lab.jp/REFV-KG/docs/00165> {
#共通利用するクラス・関係の定義は与えておく
cls:opinion rdfs:label "意見"@ja .
cls:stakeholder rdfs:label "ステークホルダー"@ja .
prop:text-txt_contents
 a rdf:Property ;
 rdfs:label "元テキスト"@ja .
prop:effect
 a rdf:Property ;
 rdfs:label "影響"@ja .
prop:speaker
 a rdf:Property ;
 rdfs:label "発言者"@ja .
prop:countermeasure
 a rdf:Property ;
 rdfs:label "対策"@ja .
prop:cause
 a rdf:Property ;
 rdfs:label "原因"@ja .
prop:content
 a rdf:Property ;
 rdfs:label "意見内容"@ja .
prop:opinion rdfs:label "意見"@ja .
prop:statedBy
  a rdf:Property ;
  rdfs:label "発言者"@ja ;
  rdfs:comment "当該主張・意見を述べた主体"@ja .
kg:id_1 rdfs:label "洋上風力の計画"@ja.
kg:id_1 rdf:type cls:c_3870.
cls:c_3870 rdfs:label "開発計画"@ja.
kg:id_2 rdfs:label "多額の固定資産税が見込まれる"@ja.
kg:id_2 rdf:type cls:c_184.
cls:c_184 rdfs:label "税収増加"@ja.
kg:id_1 prop:effect kg:id_2.
kg:id_3 rdfs:label "関連産業の産業集積が進む"@ja.
kg:id_3 rdf:type cls:c_873.
cls:c_873 rdfs:label "産業集積"@ja.
kg:id_1 prop:effect kg:id_3.
kg:id_4 rdfs:label "市の財政への波及効果が期待される"@ja.
kg:id_4 rdf:type cls:c_1140.
cls:c_1140 rdfs:label "財政効果"@ja.
kg:id_1 prop:effect kg:id_4.
kg:id_5 rdfs:label "地域の経済への波及効果が期待される"@ja.
kg:id_5 rdf:type cls:c_106.
cls:c_106 rdfs:label "経済効果"@ja.
kg:id_1 prop:effect kg:id_5.
kg:id_6 rdfs:label "酒田市"@ja.
kg:id_6 rdf:type cls:c_117.
cls:c_117 rdfs:label "自治体"@ja.
kg:id_7 rdfs:label "健全財政を維持するためにありとあらゆる努力をしていく"@ja.
kg:id_7 rdf:type cls:c_3871.
cls:c_3871 rdfs:label "財政維持"@ja.
kg:id_6 prop:countermeasure kg:id_7.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:text-txt_contents "風力発電施設は多額の固定資産税が見込まれる"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:text-txt_contents "関連産業の産業集積が進むことによりまして"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:text-txt_contents "市の財政や地域の経済への波及効果も期待される"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:text-txt_contents "市の財政や地域の経済への波及効果も期待される"@ja.
<< kg:id_6 prop:countermeasure kg:id_7 >>
    prop:text-txt_contents "酒田市の健全財政を維持するためにありとあらゆる努力をしていく必要がある"@ja.
}
