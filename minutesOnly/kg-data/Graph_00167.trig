kg:st_1 rdfs:label "丸山市長"@ja.
kg:st_1 rdf:type cls:st_2.
cls:st_2 rdfs:label "自治体首長"@ja.
kg:op_1 prop:content "基地港湾指定には２海域の案件形成が前提であり県主導の早期形成が重要"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "現時点で案件が一つしかなく指定に向けた条件が不足している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "国への情報提供に向けて地元との協議を着実に進めるべき"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:st_2 rdfs:label "酒田沿岸域検討部会の意見を出した地元代表者"@ja.
kg:st_2 rdf:type cls:st_103.
cls:st_103 rdfs:label "地域代表者"@ja.
kg:op_4 prop:content "早期に国へ情報提供し法定協議会でしっかり議論してほしい"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "洋上風力は建設や運用だけでなく関連産業集積の波及効果も期待できる"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "漁業や景観などへの影響に配慮しながら進める必要がある"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_1.
kg:op_7 prop:content "地域の意見形成に向けて利害関係者との調整と地域振興策の検討に協力する"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_1.
kg:op_8 prop:content "県と連携し形成計画を進め令和５年度中の策定を目指す"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "産業集積には企業誘致と工業用地確保の課題解決が必要"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "課題解決のため関係機関との連携を強めるべき"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:st_3 rdfs:label "佐藤猛議員"@ja.
kg:st_3 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_11 prop:content "本市農業でも持続可能な循環型農業に向けた具体策を示すべき"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "米需要減少が農業の担い手不足につながっている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "米価低迷が農業継続意欲を弱め担い手不足を招いている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_3.
kg:op_14 prop:content "担い手不足の解決に向け土地改良事業を進めている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_3.
kg:op_15 prop:content "米依存からの脱却も含め複合経営の推進が必要"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_3.
kg:op_16 prop:content "国内人口減少を踏まえ海外販路開拓を進めるべき"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_3.
kg:op_17 prop:content "国内だけでなく海外市場への販売戦略が必要"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_3.
kg:op_18 prop:content "需要回復により水揚げ金額は増加した"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_3.
kg:op_19 prop:content "船の減少がイカ漁獲量減少の一因になっている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_3.
kg:op_20 prop:content "国際情勢の影響でロシア海域に入漁できず漁獲量が落ち込んでいる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "国際情勢の悪化が水産業の厳しさを増している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "燃油高騰が経営を圧迫している"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "後継者不足が持続可能性を脅かしている"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_3.
kg:op_24 prop:content "いかのまち酒田として水産業を持続可能にする支援が必要"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_3.
kg:op_25 prop:content "観光は長く新型コロナの影響を受け大きく変化している"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_3.
kg:op_26 prop:content "３年ぶりのクルーズ船来航を契機に具体策を講じるべき"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_3.
kg:op_27 prop:content "航空便増便を観光振興につなげる施策が必要"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_3.
kg:op_28 prop:content "中国向け水際措置緩和を受け受入れ態勢を整えるべき"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_3.
kg:op_29 prop:content "酒田港と庄内空港の強みを生かし受入れ態勢強化が必要"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_3.
kg:op_30 prop:content "食材費高騰で保護者負担が増している"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_3.
kg:op_31 prop:content "給食費支援は子育て世代にとってありがたい施策である"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_3.
kg:op_32 prop:content "医療費無償化拡大は子育て世代への大きな支援である"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_3.
kg:op_33 prop:content "妊娠期から子育てまで切れ目ない伴走支援を充実させるべき"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_3.
kg:op_34 prop:content "健康寿命延伸には若年期からの健康意識向上と健診受診が重要"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_3.
kg:op_35 prop:content "後期高齢者増加を踏まえ生活面での助言や指導が不可欠"@ja.
kg:op_35 rdf:type cls:opinion.
kg:op_35 prop:speaker kg:st_3.
kg:op_36 prop:content "多様な災害リスクがあるため地域の自助共助が重要"@ja.
kg:op_36 rdf:type cls:opinion.
kg:op_36 prop:speaker kg:st_3.
kg:op_37 prop:content "自助共助を機能させるため訓練が何より重要"@ja.
kg:op_37 rdf:type cls:opinion.
kg:op_37 prop:speaker kg:st_3.
kg:op_38 prop:content "災害対応では住民と防災関係機関と市の連携体制整備が重要"@ja.
kg:op_38 rdf:type cls:opinion.
kg:op_38 prop:speaker kg:st_3.
kg:op_39 prop:content "人口減少が空き家増加を生んでいる"@ja.
kg:op_39 rdf:type cls:opinion.
kg:op_39 prop:speaker kg:st_3.
kg:op_40 prop:content "生産年齢人口の低下が飛島の人口減少を進めている"@ja.
kg:op_40 rdf:type cls:opinion.
kg:op_40 prop:speaker kg:st_3.
kg:op_41 prop:content "主要産業である漁業は大きく縮小している"@ja.
kg:op_41 rdf:type cls:opinion.
kg:op_41 prop:speaker kg:st_3.
kg:op_42 prop:content "釣りやバードウオッチング観光もコロナ禍の影響を受けた"@ja.
kg:op_42 rdf:type cls:opinion.
kg:op_42 prop:speaker kg:st_3.
kg:op_43 prop:content "マリンプラザは島民に希望を与え受入れ拠点として重要"@ja.
kg:op_43 rdf:type cls:opinion.
kg:op_43 prop:speaker kg:st_3.
kg:op_44 prop:content "光ファイバー網は新たな産業や生活基盤強化の可能性を広げる"@ja.
kg:op_44 rdf:type cls:opinion.
kg:op_44 prop:speaker kg:st_3.
kg:op_45 prop:content "民間連携のスマートアイランド実証を生かして振興を図るべき"@ja.
kg:op_45 rdf:type cls:opinion.
kg:op_45 prop:speaker kg:st_3.
kg:op_46 prop:content "老朽化した橋梁は重大事故防止のため改修を急ぐべき"@ja.
kg:op_46 rdf:type cls:opinion.
kg:op_46 prop:speaker kg:st_3.
kg:op_47 prop:content "水需要減少が水道事業運営の不安要素になっている"@ja.
kg:op_47 rdf:type cls:opinion.
kg:op_47 prop:speaker kg:st_3.
kg:op_48 prop:content "老朽設備の更新費用増大が大きな課題である"@ja.
kg:op_48 rdf:type cls:opinion.
kg:op_48 prop:speaker kg:st_3.
kg:op_49 prop:content "料金上昇への懸念がある"@ja.
kg:op_49 rdf:type cls:opinion.
kg:op_49 prop:speaker kg:st_3.
kg:op_50 prop:content "技術者不足が事業継続の不安要素になっている"@ja.
kg:op_50 rdf:type cls:opinion.
kg:op_50 prop:speaker kg:st_3.
kg:st_4 rdfs:label "厚生労働省"@ja.
kg:st_4 rdf:type cls:st_33.
cls:st_33 rdfs:label "行政機関"@ja.
kg:op_51 prop:content "厳しい社会環境を踏まえ多様な形態の広域連携を進めるべき"@ja.
kg:op_51 rdf:type cls:opinion.
kg:op_51 prop:speaker kg:st_4.
kg:op_52 prop:content "歳入では市税減少が見込まれている"@ja.
kg:op_52 rdf:type cls:opinion.
kg:op_52 prop:speaker kg:st_3.
kg:op_53 prop:content "地方交付税も減少している"@ja.
kg:op_53 rdf:type cls:opinion.
kg:op_53 prop:speaker kg:st_3.
kg:op_54 prop:content "市債減少はプロジェクト３０－３０に基づくものである"@ja.
kg:op_54 rdf:type cls:opinion.
kg:op_54 prop:speaker kg:st_3.
kg:op_55 prop:content "大型事業の実施により投資的経費が大幅増となっている"@ja.
kg:op_55 rdf:type cls:opinion.
kg:op_55 prop:speaker kg:st_3.
kg:op_56 prop:content "義務的経費減少は人件費や扶助費の減による"@ja.
kg:op_56 rdf:type cls:opinion.
kg:op_56 prop:speaker kg:st_3.
kg:op_57 prop:content "予算編成に関する市民への説明努力が不足していたのではないか"@ja.
kg:op_57 rdf:type cls:opinion.
kg:op_57 prop:speaker kg:st_3.
kg:op_58 prop:content "就任後の多くの期間でコロナの影響を受け社会経済活動が制約された"@ja.
kg:op_58 rdf:type cls:opinion.
kg:op_58 prop:speaker kg:st_1.
kg:op_59 prop:content "イベントや交流事業はコロナの影響を大きく受けた"@ja.
kg:op_59 rdf:type cls:opinion.
kg:op_59 prop:speaker kg:st_1.
kg:op_60 prop:content "長期のコロナ禍で地元経済は疲弊した"@ja.
kg:op_60 rdf:type cls:opinion.
kg:op_60 prop:speaker kg:st_1.
kg:op_61 prop:content "コロナ禍で疲弊した地元経済への支援を一定程度実施した"@ja.
kg:op_61 rdf:type cls:opinion.
kg:op_61 prop:speaker kg:st_1.
kg:st_5 rdfs:label "市村浩一議員"@ja.
kg:st_5 rdf:type cls:st_9.
kg:op_62 prop:content "ゼロゼロ融資返済が始まり事業所の先行きが見通せない"@ja.
kg:op_62 rdf:type cls:opinion.
kg:op_62 prop:speaker kg:st_5.
kg:op_63 prop:content "新年度も状況を見据えた継続支援が必要"@ja.
kg:op_63 rdf:type cls:opinion.
kg:op_63 prop:speaker kg:st_5.
kg:op_64 prop:content "指定に向けては県主導で２海域の案件形成を急ぐ必要がある"@ja.
kg:op_64 rdf:type cls:opinion.
kg:op_64 prop:speaker kg:st_1.
kg:op_65 prop:content "港湾計画変更の遅れも課題である"@ja.
kg:op_65 rdf:type cls:opinion.
kg:op_65 prop:speaker kg:st_1.
kg:op_66 prop:content "県には組織横断で先行利用者に寄り添う対応を求めたい"@ja.
kg:op_66 rdf:type cls:opinion.
kg:op_66 prop:speaker kg:st_1.
kg:op_67 prop:content "県が主体的に地域理解を深めることが重要"@ja.
kg:op_67 rdf:type cls:opinion.
kg:op_67 prop:speaker kg:st_1.
kg:op_68 prop:content "短期的には地元企業への経済波及効果を期待している"@ja.
kg:op_68 rdf:type cls:opinion.
kg:op_68 prop:speaker kg:st_1.
kg:op_69 prop:content "建設や調査による交流人口増で宿泊施設への効果が見込まれる"@ja.
kg:op_69 rdf:type cls:opinion.
kg:op_69 prop:speaker kg:st_1.
kg:op_70 prop:content "地域振興策により新たな産業形成が期待される"@ja.
kg:op_70 rdf:type cls:opinion.
kg:op_70 prop:speaker kg:st_1.
kg:op_71 prop:content "再生可能エネルギーの導入拡大につながる"@ja.
kg:op_71 rdf:type cls:opinion.
kg:op_71 prop:speaker kg:st_1.
kg:op_72 prop:content "次世代エネルギー普及で関連産業の雇用創出が期待される"@ja.
kg:op_72 rdf:type cls:opinion.
kg:op_72 prop:speaker kg:st_1.
kg:op_73 prop:content "雇用創出により定住人口の増加も期待される"@ja.
kg:op_73 rdf:type cls:opinion.
kg:op_73 prop:speaker kg:st_1.
kg:op_74 prop:content "引き続き県に対して必要な対応を要望していく"@ja.
kg:op_74 rdf:type cls:opinion.
kg:op_74 prop:speaker kg:st_1.
kg:op_75 prop:content "酒田にとって令和の北前船時代とも言える大きなチャンスである"@ja.
kg:op_75 rdf:type cls:opinion.
kg:op_75 prop:speaker kg:st_5.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "酒田港の基地港湾の指定に当たりましては、港湾法によりまして２つ以上の洋上風力の海域が指定されることが必要であります"@ja.
<< kg:id_3 prop:cause kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "しかしながら、現時点での山形県沖の案件としては、令和３年９月に有望な区域に指定をされた遊佐町沖のみとなっているところでございます"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "酒田市沖につきましては、基地港湾の指定に必要な２つ目の案件として国への情報提供を行うために、山形県が主催をいたします酒田沿岸域検討部会において地元の各分野の代表者との協議を進めているところでございます"@ja.
<< kg:id_5 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "直近の第３回部会では、早期に国に情報提供を行い、法定協議会の場でしっかりとした議論を進めてほしいとの意見も出されたところでございました"@ja.
<< kg:id_8 prop:effect kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "この洋上風力発電事業での地元経済の波及効果といたしましては、風車建設やその建設された風車の運用のみならず、カーボンニュートラルポートとしてのエネルギー関連産業の集積等も見込まれます"@ja.
<< kg:id_8 prop:effect kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "一方では、海を生業とする漁業者への影響ですとか、景観等による周辺住民への影響などでは、未知の影響も懸念されているというのが現状でございます"@ja.
<< kg:id_8 prop:countermeasure kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "酒田市としては地域の意見の形成に向けて、漁業者や周辺住民などの利害関係者との調整や地域振興策の検討等に協力をしていきたいと考えております"@ja.
<< kg:id_12 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "カーボンニュートラルポートにつきましては、山形県が中心となって酒田港のカーボンニュートラルポート形成計画の議論が今進められております。令和５年度中の策定を目指しております"@ja.
<< kg:id_14 prop:cause kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "エネルギー関連産業の集積を図るためには、企業誘致や工業用地の確保などの課題もあるため、関係機関とも連携して進めてまいりたいと考えております"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "エネルギー関連産業の集積を図るためには、企業誘致や工業用地の確保などの課題もあるため、関係機関とも連携して進めてまいりたいと考えております"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "本市農業にあっても、持続可能な循環型農業を目指す上からスマートオーガニックシティ、仮称ですけれども、の形成を進めるとしています"@ja.
<< kg:id_19 prop:cause kg:id_20 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "一方で、米消費の減少やそれに伴う価格の低迷は農業者の高齢化や後継者不足につながっています"@ja.
<< kg:id_19 prop:cause kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "一方で、米消費の減少やそれに伴う価格の低迷は農業者の高齢化や後継者不足につながっています"@ja.
<< kg:id_19 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "これらを少しでも解決するために、土地改良事業や複合経営の推進を図っておられるわけであります"@ja.
<< kg:id_19 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "これらを少しでも解決するために、土地改良事業や複合経営の推進を図っておられるわけであります"@ja.
<< kg:id_24 prop:cause kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "本市の良質な農産物の販売先を、人口減少の続いていくであろう国内ばかりに目を向けるのではなく、海外へも積極的に売り込んでいくべきであると思います"@ja.
<< kg:id_26 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "本市の良質な農産物の販売先を、人口減少の続いていくであろう国内ばかりに目を向けるのではなく、海外へも積極的に売り込んでいくべきであると思います"@ja.
<< kg:id_28 prop:cause kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "コロナ禍で落ち込んでいた飲食店などの需要が増えたことから、水揚げ金額は20億2,000万円、対前年比で116％でありました"@ja.
<< kg:id_30 prop:cause kg:id_31 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "船凍イカは、船の減少やロシア海域への入漁不能から漁獲量は対前年比で60％と大きく落ち込んでいます"@ja.
<< kg:id_30 prop:cause kg:id_32 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "船凍イカは、船の減少やロシア海域への入漁不能から漁獲量は対前年比で60％と大きく落ち込んでいます"@ja.
<< kg:id_33 prop:cause kg:id_34 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "国際情勢や燃油高騰、後継者不足の課題は一層厳しさを増しております"@ja.
<< kg:id_33 prop:cause kg:id_35 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "国際情勢や燃油高騰、後継者不足の課題は一層厳しさを増しております"@ja.
<< kg:id_33 prop:cause kg:id_36 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "国際情勢や燃油高騰、後継者不足の課題は一層厳しさを増しております"@ja.
<< kg:id_33 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "さらなる水産業を持続可能な産業にするための支援についてお尋ねをいたします"@ja.
<< kg:id_38 prop:cause kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "３年間余り新型コロナウイルスに翻弄されてきた観光は、ウイズコロナ、アフターコロナを迎え大きくさま変わりしようとしています"@ja.
<< kg:id_40 prop:cause kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "いよいよこの４月には３年ぶりとなるクルーズ船の来航が予定されています"@ja.
<< kg:id_40 prop:cause kg:id_42 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "今月26日からはＡＮＡ庄内・羽田線の１便増便が決定しております。これに対する具体的な施策をお知らせください"@ja.
<< kg:id_43 prop:cause kg:id_44 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "今日からは訪日観光客の中でも大きなウエートを占めていた中国からの水際措置も緩和されます"@ja.
<< kg:id_45 prop:countermeasure kg:id_46 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "コロナ禍前には国内でもトップクラスの評価を受けていたクルーズ船の寄港地として、これからの受け入れ態勢についてお尋ねを申し上げます"@ja.
<< kg:id_47 prop:cause kg:id_48 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "値上がりが続く食材費の影響から父兄の負担を軽減するため"@ja.
<< kg:id_49 prop:countermeasure kg:id_50 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "保育所や小中学校の給食費へ新型コロナウイルス感染症対応地方創生交付金を充てるとのことであります"@ja.
<< kg:id_51 prop:countermeasure kg:id_52 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "子供の医療費の無償化の対象が中学校３年生から高校３年生まで拡大されることになりました"@ja.
<< kg:id_53 prop:countermeasure kg:id_54 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "酒田市こども家庭センターがスタートいたします。妊娠期から出産・子育てまで一貫した相談体制を構築し、様々なニーズに合わせた支援につなぐ伴走型相談支援を拡充するとのことであります"@ja.
<< kg:id_55 prop:countermeasure kg:id_56 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "そのためには、若いときから健康への関心度を高め、健康診断の積極的受診が欠かせません"@ja.
<< kg:id_57 prop:countermeasure kg:id_58 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_35;
    prop:text-txt_contents "後期高齢者が急速に増えている今、日常生活への適切なアドバイス・指導も不可欠であります"@ja.
<< kg:id_59 prop:cause kg:id_60 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_36;
    prop:text-txt_contents "いつ何時、我が地域に、我が身に災害が襲ってくるか予想もつかない事態となっています。そこで必要なのが、地域の自助・共助であります"@ja.
<< kg:id_61 prop:countermeasure kg:id_62 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_37;
    prop:text-txt_contents "そのためには訓練が何よりも欠かせません"@ja.
<< kg:id_63 prop:countermeasure kg:id_64 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_38;
    prop:text-txt_contents "災害対応するに当たって、地域住民、防災関係機関、市の三者における体制整備が重要と思います"@ja.
<< kg:id_65 prop:cause kg:id_66 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_39;
    prop:text-txt_contents "急速な人口減少はまた空き家の増加を生んでいます"@ja.
<< kg:id_67 prop:cause kg:id_68 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_40;
    prop:text-txt_contents "飛島は、生産年齢の低下とともに人口減少が進み"@ja.
<< kg:id_69 prop:effect kg:id_70 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_41;
    prop:text-txt_contents "主要産業である漁業についても2016年度は対2008年度比で約半分まで落ち込んでいます"@ja.
<< kg:id_71 prop:effect kg:id_72 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_42;
    prop:text-txt_contents "釣りやバードウオッチングに特化した観光客も一定数あったものの、コロナ禍はここにも大きな影響を及ぼしています"@ja.
<< kg:id_73 prop:countermeasure kg:id_74 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_43;
    prop:text-txt_contents "昨年７月にグランドオープンしたとびしまマリンプラザは島民に希望を与え、観光客の受入れに大きな役割を果たしています"@ja.
<< kg:id_73 prop:countermeasure kg:id_75 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_44;
    prop:text-txt_contents "一昨年度に整備した光ファイバー網は、ＩＣＴやｅモビリティへの可能性を広げております"@ja.
<< kg:id_73 prop:countermeasure kg:id_76 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_45;
    prop:text-txt_contents "昨年度行われました民間事業者と連携した飛島スマートアイランドは多くの実証内容を示しています"@ja.
<< kg:id_77 prop:cause kg:id_78 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_46;
    prop:text-txt_contents "1960年代に整備された道路や橋梁は経年劣化が進み、危険な状況にあるものも少なくありません。特に橋梁については重大な事故に直結することから、その改修が急がれています"@ja.
<< kg:id_79 prop:cause kg:id_80 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_47;
    prop:text-txt_contents "今後見込まれる水需要の減少、設備の老朽化に伴う更新費用の増大、それによる供給単価の上昇懸念、さらには事業を管理するための技術者不足など多くの不安要素がかねてから指摘されてまいりました"@ja.
<< kg:id_79 prop:cause kg:id_81 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_48;
    prop:text-txt_contents "今後見込まれる水需要の減少、設備の老朽化に伴う更新費用の増大、それによる供給単価の上昇懸念、さらには事業を管理するための技術者不足など多くの不安要素がかねてから指摘されてまいりました"@ja.
<< kg:id_79 prop:cause kg:id_82 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_49;
    prop:text-txt_contents "今後見込まれる水需要の減少、設備の老朽化に伴う更新費用の増大、それによる供給単価の上昇懸念、さらには事業を管理するための技術者不足など多くの不安要素がかねてから指摘されてまいりました"@ja.
<< kg:id_79 prop:cause kg:id_83 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_50;
    prop:text-txt_contents "今後見込まれる水需要の減少、設備の老朽化に伴う更新費用の増大、それによる供給単価の上昇懸念、さらには事業を管理するための技術者不足など多くの不安要素がかねてから指摘されてまいりました"@ja.
<< kg:id_84 prop:countermeasure kg:id_85 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_51;
    prop:text-txt_contents "厚生労働省では、９年前の平成25年に公表した新水道ビジョンにおいて、水道を取り巻く厳しい社会環境などを踏まえ、連携形態にとらわれない多様な形態の広域連携を目指すよう、早くから関係者に検討を指示しています"@ja.
<< kg:id_86 prop:cause kg:id_87 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_52;
    prop:text-txt_contents "歳入については市税が2.9％、地方交付税は0.1％の減"@ja.
<< kg:id_86 prop:cause kg:id_88 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_53;
    prop:text-txt_contents "歳入については市税が2.9％、地方交付税は0.1％の減"@ja.
<< kg:id_89 prop:cause kg:id_90 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_54;
    prop:text-txt_contents "市債についてはプロジェクト「３０－３０（サーティサーティ）」の行政経営方針に基づいて27.9％の減となっています"@ja.
<< kg:id_91 prop:cause kg:id_92 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_55;
    prop:text-txt_contents "山居倉庫公有化事業や法人立保育所等の整備、学校の長寿命化事業や国体記念体育館改修事業などでは33.9％の大幅な増となっています"@ja.
<< kg:id_93 prop:cause kg:id_94 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_56;
    prop:text-txt_contents "義務的経費は2.3％で人件費や扶助費の減によるものであります"@ja.
<< kg:id_95 prop:cause kg:id_96 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_57;
    prop:text-txt_contents "市民の皆様への周知、理解、納得を図るという努力には残念ながら不足があったのではないかと考えております"@ja.
<< kg:id_97 prop:cause kg:id_98 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_58;
    prop:text-txt_contents "その期間の多くが、新型コロナウイルス感染症の感染拡大によりまして社会経済活動に大きな制約を受けたところでございました"@ja.
<< kg:id_99 prop:cause kg:id_98 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_59;
    prop:text-txt_contents "様々なイベントですとか、あるいは他地域との交流事業が非常に大きな影響を受けたなとそういう感想を持っております"@ja.
<< kg:id_100 prop:cause kg:id_101 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_60;
    prop:text-txt_contents "３年間以上にわたるコロナ禍にあって、ワクチン接種対策ですとか、あるいは非常に疲弊をした地元の経済界に対する適切な支援措置なども一定程度講じることができた"@ja.
<< kg:id_100 prop:countermeasure kg:id_102 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_61;
    prop:text-txt_contents "非常に疲弊をした地元の経済界に対する適切な支援措置なども一定程度講じることができた"@ja.
<< kg:id_103 prop:cause kg:id_104 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_62;
    prop:text-txt_contents "コロナ禍での実質無利子・無担保融資、いわゆるゼロゼロ融資の返済も今年の夏頃に返済が本格化する見込みとあり、影響を受ける事業所にとっては先行きを見通せない状況にあるといいます"@ja.
<< kg:id_105 prop:countermeasure kg:id_106 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_63;
    prop:text-txt_contents "今年度のＰａｙＰａｙ事業などのような支援策が必要になってくるのかもしれません。引き続きの支援を期待するものであります"@ja.
<< kg:id_107 prop:cause kg:id_108 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_64;
    prop:text-txt_contents "基地港湾の指定に向けた課題といたしましては、山形県が主導する２つの海域の早期案件形成"@ja.
<< kg:id_107 prop:cause kg:id_109 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_65;
    prop:text-txt_contents "基地港湾に関する港湾計画の変更の遅延、これが課題として挙げられるかと思います"@ja.
<< kg:id_110 prop:countermeasure kg:id_111 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_66;
    prop:text-txt_contents "県に求める対応といたしましては、海域先行利用者等に寄り添った県の組織をまたぐ横断的な取組の深化"@ja.
<< kg:id_110 prop:countermeasure kg:id_112 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_67;
    prop:text-txt_contents "地域の理解醸成の促進を主体的に進めてもらうことが重要だと認識をしております"@ja.
<< kg:id_113 prop:effect kg:id_114 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_68;
    prop:text-txt_contents "本市としては、短期的には基地港湾の整備や洋上風力の建設に関する地元企業への経済波及効果を期待しております"@ja.
<< kg:id_113 prop:effect kg:id_115 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_69;
    prop:text-txt_contents "建設や現地調査等で多くの交流人口が増加することで、市内宿泊施設等への波及効果も期待しているところでございます"@ja.
<< kg:id_116 prop:effect kg:id_117 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_70;
    prop:text-txt_contents "中長期的には、洋上風力発電事業の地域振興策による新たな産業形成ですとか"@ja.
<< kg:id_116 prop:effect kg:id_118 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_71;
    prop:text-txt_contents "再生可能エネルギーの導入拡大、水素などの次世代エネルギーが普及することで"@ja.
<< kg:id_116 prop:effect kg:id_119 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_72;
    prop:text-txt_contents "関連産業による雇用が創出され"@ja.
<< kg:id_116 prop:effect kg:id_120 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_73;
    prop:text-txt_contents "本市への定住人口の増加が期待されるだろうと考えております"@ja.
<< kg:id_121 prop:countermeasure kg:id_122 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_74;
    prop:text-txt_contents "したがって、引き続き県に対してこのことをしっかりと要望していきたいと考えております"@ja.
<< kg:id_1 prop:effect kg:id_123 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_75;
    prop:text-txt_contents "当市への期待としては、定住人口や経済効果が期待できるということでございます。ぜひ、本当に私も、先ほど申し上げました令和の北前船の時代が来たんじゃないかというぐらいに大切な事業だと思います"@ja.
}
