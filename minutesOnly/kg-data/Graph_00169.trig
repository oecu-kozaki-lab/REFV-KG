kg:id_15 rdf:type cls:c_3954.
cls:c_3954 rdfs:label "計画変更承認"@ja.
kg:id_13 prop:countermeasure kg:id_15.
kg:id_16 rdfs:label "令和６年度に酒田港は基地港湾に指定され整備に着手する見通し"@ja.
kg:id_16 rdf:type cls:c_125.
cls:c_125 rdfs:label "港湾整備"@ja.
kg:id_13 prop:effect kg:id_16.
