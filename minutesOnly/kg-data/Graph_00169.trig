kg:id_7 rdf:type cls:c_891.
cls:c_891 rdfs:label "企業集積"@ja.
kg:id_8 rdfs:label "風力太陽光バイオマスの３つの再生可能エネルギー発電所が隣接する酒田臨海工業団地"@ja.
kg:id_8 rdf:type cls:c_1839.
