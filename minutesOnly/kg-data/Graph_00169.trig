kg:id_13 rdf:type cls:c_966.
kg:id_14 rdfs:label "山形県が酒田港港湾計画の一部変更手続を進める"@ja.
kg:id_14 rdf:type cls:c_1147.
cls:c_1147 rdfs:label "港湾計画変更"@ja.
