kg:id_18 rdf:type cls:c_118.
cls:c_118 rdfs:label "計画策定"@ja.
kg:id_17 prop:countermeasure kg:id_18.
kg:id_19 rdfs:label "遊佐町沖の洋上風力発電"@ja.
kg:id_19 rdf:type cls:c_175.
