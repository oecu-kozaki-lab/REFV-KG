kg:id_17 rdf:type cls:c_3989.
cls:c_3989 rdfs:label "工場建設"@ja.
kg:id_18 rdfs:label "公害への不安が生じる"@ja.
kg:id_18 rdf:type cls:c_3990.
cls:c_3990 rdfs:label "公害不安"@ja.
kg:id_17 prop:effect kg:id_18.
kg:id_19 rdfs:label "再生可能エネルギー等が入ってくること"@ja.
kg:id_19 rdf:type cls:c_266.
cls:c_266 rdfs:label "再エネ導入"@ja.
kg:id_20 rdfs:label "風力や太陽光発電だけで全て賄えるのかという課題が生じる"@ja.
kg:id_20 rdf:type cls:c_3991.
