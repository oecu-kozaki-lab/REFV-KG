kg:id_1 prop:countermeasure kg:id_12.
kg:id_13 rdfs:label "新しいビジネスに取り組む人の相談を支援する"@ja.
kg:id_13 rdf:type cls:c_3587.
kg:id_1 prop:countermeasure kg:id_13.
kg:id_14 rdfs:label "民民で情報共有や連携体制を構築して進める"@ja.
kg:id_14 rdf:type cls:c_1572.
cls:c_1572 rdfs:label "連携体制"@ja.
kg:id_5 prop:countermeasure kg:id_14.
