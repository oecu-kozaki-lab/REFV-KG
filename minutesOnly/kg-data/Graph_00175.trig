kg:id_29 rdf:type cls:c_3994.
cls:c_3994 rdfs:label "政策実行"@ja.
kg:id_27 prop:effect kg:id_29.
kg:id_30 rdfs:label "基地港湾整備"@ja.
kg:id_30 rdf:type cls:c_125.
kg:id_31 rdfs:label "本市が変わる契機となる"@ja.
kg:id_31 rdf:type cls:c_413.
cls:c_413 rdfs:label "地域変化"@ja.
kg:id_30 prop:effect kg:id_31.
kg:id_32 rdfs:label "帰ってきたい、住みたい、子育てしたいというまちづくりにつながる"@ja.
kg:id_32 rdf:type cls:c_396.
cls:c_396 rdfs:label "定住促進"@ja.
kg:id_30 prop:effect kg:id_32.
kg:st_1 rdfs:label "議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "基地港湾整備は地域全体に利益をもたらす大きな事業とみている"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:st_2 rdfs:label "山形県"@ja.
kg:st_2 rdf:type cls:st_40.
cls:st_40 rdfs:label "行政"@ja.
kg:op_2 prop:content "遊佐町沖と酒田市沖の経済波及効果を調査している"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_2.
kg:op_3 prop:content "雇用者数を含む効果を分析している"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "市当局"@ja.
kg:st_3 rdf:type cls:st_40.
kg:op_4 prop:content "基地港湾整備の経済効果として国の大規模事業があると説明している"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:op_5 prop:content "県の大規模整備事業も進むと説明している"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_3.
kg:op_6 prop:content "地元企業は下請や作業分野で十分参入可能とみている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_3.
kg:op_7 prop:content "既に地元企業の受注実績が出ていると説明している"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_3.
kg:op_8 prop:content "地元企業への経済効果が具体的に表れていると説明している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "今後も地元企業の受注機会が続く見通しを示している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "事業所や仮事務所の建設場所に関する相談を行政が支援する考えである"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "洋上風力発電の機会を生かす新規事業の相談支援を行う考えである"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_3.
kg:op_12 prop:content "大手企業と地元企業の情報共有と連携が重要とみている"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_3.
kg:op_13 prop:content "地元建設業が事業に食い込み地域に資金が回るよう求めている"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "関連の薄い業種にも効果が及ぶ仕組みづくりを求めている"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "新しい工場建設時には公害への懸念があると認識している"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "再エネだけで電力需要を満たせるか現実的な課題があるとみている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "再エネ導入後も火力発電は必要と考えている"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "現実の電力供給は石炭火力への依存が大きいと指摘している"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "石炭火力を保護ではなく必要性を理解して支えるべきと述べている"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:op_20 prop:content "ものづくりには安定した電圧と電力量の供給が不可欠と考えている"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "仕事の確保が地域発展の基盤だと考えている"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_1.
kg:op_22 prop:content "産業発展が福祉や子育て施策の実行を支えるとみている"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "基地港湾整備は市を変える大きな転機になると期待している"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "基地港湾整備を定住や子育てにつながる機会にすべきと述べている"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
<< kg:id_1 prop:effect kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "基地港湾の整備自体がビッグプロジェクトであり、関係業態のみならず、地域全体に利益をもたらすと推測いたします。"@ja.
<< kg:id_1 prop:effect kg:id_3 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "その中では、遊佐町沖と酒田市沖における直接的・間接的な経済波及効果、見込まれる雇用者数等の推計、分析などが行われます。"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "その中では、遊佐町沖と酒田市沖における直接的・間接的な経済波及効果、見込まれる雇用者数等の推計、分析などが行われます。"@ja.
<< kg:id_5 prop:effect kg:id_6 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "基地港湾整備につきましては、国土交通省が令和６年度から令和９年度までの４か年で、計122億円の岸壁整備などの事業が予定されております。"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "また、山形県の事業では、令和５年度から令和８年度までの４か年で、護岸整備事業など合計112億円規模の事業が予定されております。"@ja.
<< kg:id_5 prop:effect kg:id_8 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "地元企業はその下請となって入っていくほか、台船など作業船を使用する作業ですとか、水中の潜水作業、またはクレーン作業に対しては、協力会社としての参入は十分可能であると考えています。"@ja.
<< kg:id_5 prop:effect kg:id_9 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "令和６年度は約30億円の事業費規模で護岸工事が発注されておりまして、５件の工事を地元企業４社が受注をしております。"@ja.
<< kg:id_5 prop:effect kg:id_10 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "総額は30億円のうち約19億円となっております。"@ja.
<< kg:id_5 prop:effect kg:id_11 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "さらに、令和７年度以降も整備事業の予定が見込まれておりますので、ぜひ地元企業の方には受注を果たしていただきたいなと思っております。"@ja.
<< kg:id_1 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "この機に事業所をつくろうとか、仮の事務所を建てていこうといったときの建設場所の相談ですとか"@ja.
<< kg:id_1 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "あとはこの洋上風力発電のタイミングで新しいビジネスに取り組もうという方の御相談、そういったところのサポートを行政としてはしていければと考えております。"@ja.
<< kg:id_5 prop:countermeasure kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "民民でここはしっかり情報の共有や連携体制が構築されて進んでいると考えております。"@ja.
<< kg:id_5 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "地元建設業が、どんどん食い込めて、地元にお金が落ちるような手当てをしていただきたい"@ja.
<< kg:id_5 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "お金が回った後に付随する様々な、一見関係ないような業態までも、しっかり潤えるような仕組みをつくっていただきたいなと思っています。"@ja.
<< kg:id_17 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "新しいものができる、例えば、港の砂浜に工場ができる際には、本当に公害は大丈夫なのか"@ja.
<< kg:id_19 prop:effect kg:id_20 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "果たして風力、太陽光発電で全て賄えるのかなという現実問題に突き当たったときに"@ja.
<< kg:id_19 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "やはり言われておりますけれども、火力発電も必要になっているし"@ja.
<< kg:id_22 prop:cause kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "現在、日本の３割は石炭火力に頼っていますから"@ja.
<< kg:id_22 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "その部分もしっかり、保護するわけじゃないんですけれども、しっかり理解して、これからも支えていかなければならないのかと思っております。"@ja.
<< kg:id_25 prop:cause kg:id_26 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "山形県のものづくりの電力は、一定程度の電圧だったり、電力量を供給できるものがないと困るのではないかと思っております。"@ja.
<< kg:id_27 prop:effect kg:id_28 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "やはり仕事があってこそ地域の発展であって"@ja.
<< kg:id_27 prop:effect kg:id_29 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "それに伴ってのウエルビーイングや子育て、福祉等の政策が実行していくのかなと思っております。"@ja.
<< kg:id_30 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "基地港湾整備で本市が変わった"@ja.
<< kg:id_30 prop:effect kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "ここに帰ってきたい、住みたい、子育てしたいというところにつなげていく絶好のチャンスですので"@ja.
}
