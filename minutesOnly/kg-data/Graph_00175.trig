kg:id_5 prop:effect kg:id_9.
kg:id_10 rdfs:label "地元企業受注総額は30億円のうち約19億円となっている"@ja.
kg:id_10 rdf:type cls:c_106.
kg:id_5 prop:effect kg:id_10.
kg:id_11 rdfs:label "令和7年度以降も整備事業の予定が見込まれる"@ja.
kg:id_11 rdf:type cls:c_3987.
