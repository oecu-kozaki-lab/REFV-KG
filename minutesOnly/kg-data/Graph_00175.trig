kg:id_15 rdf:type cls:c_3988.
cls:c_3988 rdfs:label "受注支援"@ja.
kg:id_5 prop:countermeasure kg:id_15.
kg:id_16 rdfs:label "付随する様々な業態まで潤う仕組みをつくる"@ja.
kg:id_16 rdf:type cls:c_300.
cls:c_300 rdfs:label "地域還元"@ja.
kg:id_5 prop:countermeasure kg:id_16.
