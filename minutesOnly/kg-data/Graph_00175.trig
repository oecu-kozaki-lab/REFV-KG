kg:id_23 rdfs:label "日本の3割が石炭火力に頼っていること"@ja.
kg:id_23 rdf:type cls:c_1237.
cls:c_1237 rdfs:label "火力依存"@ja.
kg:id_22 prop:cause kg:id_23.
