kg:id_24 rdf:type cls:c_3993.
cls:c_3993 rdfs:label "火力維持"@ja.
kg:id_22 prop:countermeasure kg:id_24.
kg:id_25 rdfs:label "山形県のものづくりの電力供給"@ja.
kg:id_25 rdf:type cls:c_94.
kg:id_26 rdfs:label "一定程度の電圧や電力量を供給できる電源が必要であること"@ja.
kg:id_26 rdf:type cls:c_756.
cls:c_756 rdfs:label "安定供給"@ja.
kg:id_25 prop:cause kg:id_26.
kg:id_27 rdfs:label "産業発展"@ja.
kg:id_27 rdf:type cls:c_258.
cls:c_258 rdfs:label "産業発展"@ja.
kg:id_28 rdfs:label "地域の発展につながる"@ja.
kg:id_28 rdf:type cls:c_1371.
cls:c_1371 rdfs:label "地域発展"@ja.
kg:id_27 prop:effect kg:id_28.
