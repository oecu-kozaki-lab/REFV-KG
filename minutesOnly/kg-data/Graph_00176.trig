kg:id_10 rdf:type cls:c_73.
cls:c_73 rdfs:label "反対運動"@ja.
kg:id_11 rdfs:label "公害問題が盛んな時代だったこと"@ja.
kg:id_11 rdf:type cls:c_3998.
cls:c_3998 rdfs:label "公害問題"@ja.
kg:id_10 prop:cause kg:id_11.
kg:id_12 rdfs:label "議場に入れない状況や隠密裏に打合せしなければならない状況があった"@ja.
kg:id_12 rdf:type cls:c_3999.
