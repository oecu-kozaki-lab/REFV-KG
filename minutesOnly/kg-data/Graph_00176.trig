cls:c_268 rdfs:label "企業誘致"@ja.
kg:id_9 rdfs:label "山形県と連携し企業と地域の両者にメリットが生じるような業種に絞って戦略的な誘致を展開する"@ja.
kg:id_9 rdf:type cls:c_191.
