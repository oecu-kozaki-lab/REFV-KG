kg:id_6 rdf:type cls:c_1192.
cls:c_1192 rdfs:label "意見交換"@ja.
kg:id_5 prop:countermeasure kg:id_6.
kg:id_7 rdfs:label "遊佐町沖を追いかける形で調査や工事が進められる"@ja.
kg:id_7 rdf:type cls:c_3997.
