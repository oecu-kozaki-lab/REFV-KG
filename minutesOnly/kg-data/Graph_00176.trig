kg:id_17 rdf:type cls:c_194.
cls:c_194 rdfs:label "区域指定"@ja.
kg:id_18 rdfs:label "合意形成を図るため住民との意見交換会を行う"@ja.
kg:id_18 rdf:type cls:c_1192.
kg:id_17 prop:countermeasure kg:id_18.
kg:id_19 rdfs:label "必要なものをそろえて取組を進める"@ja.
kg:id_19 rdf:type cls:c_4000.
cls:c_4000 rdfs:label "取組推進"@ja.
kg:id_17 prop:countermeasure kg:id_19.
kg:id_20 rdfs:label "地域の生活水準の維持"@ja.
kg:id_20 rdf:type cls:c_4001.
cls:c_4001 rdfs:label "生活水準"@ja.
kg:id_21 rdfs:label "経済を活性化しないといけないこと"@ja.
kg:id_21 rdf:type cls:c_180.
cls:c_180 rdfs:label "経済活性化"@ja.
