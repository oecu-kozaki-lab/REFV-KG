kg:id_23 rdf:type cls:c_4003.
cls:c_4003 rdfs:label "両立推進"@ja.
kg:id_22 prop:countermeasure kg:id_23.
kg:id_24 rdfs:label "市民への情報提供"@ja.
kg:id_24 rdf:type cls:c_213.
cls:c_213 rdfs:label "情報提供"@ja.
kg:id_25 rdfs:label "住民との意見交換会等で出された意見も含めて市民にきちんと伝えていく"@ja.
kg:id_25 rdf:type cls:c_4004.
cls:c_4004 rdfs:label "周知推進"@ja.
kg:id_24 prop:countermeasure kg:id_25.
kg:st_1 rdfs:label "酒田市当局"@ja.
kg:st_1 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_1 prop:content "令和10年度の供用開始に向けて工事を進める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "事業者選定直後から現地調査を開始し供用開始を想定する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:op_3 prop:content "住民意見を踏まえながら事業化に向けた調整を進める"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_1.
kg:op_4 prop:content "事業化されれば遊佐町沖に続いて調査や工事が進む見通しである"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_1.
kg:op_5 prop:content "関連産業も視野に入れて戦略的に企業誘致を進めたい"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:st_2 rdfs:label "質問者"@ja.
kg:st_2 rdf:type cls:st_16.
cls:st_16 rdfs:label "質問者"@ja.
kg:op_6 prop:content "当時は公害問題を背景に反対運動が非常に強かった"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "反対運動により議場運営や打合せに支障が出ていた"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:st_3 rdfs:label "住民との意見交換会参加者"@ja.
kg:st_3 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_8 prop:content "健康被害が生じるのではないかと懸念している"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_3.
kg:op_9 prop:content "津波などで施設が押し流される危険を心配している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_3.
kg:op_10 prop:content "地域経済への好影響を期待する意見がある"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_3.
kg:op_11 prop:content "促進区域指定に向けて合意形成を丁寧に進める"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "意見交換会の動きを踏まえて必要事項を整理し取組を進めたい"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_1.
kg:op_13 prop:content "生活水準維持のためには経済活性化が必要である"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "経済一辺倒ではなく環境との両立を図るべきである"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_1.
kg:op_15 prop:content "酒田港湾地域の今後10年について市民に的確に伝えてほしい"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "意見交換会で出た意見も含めて市民にきちんと伝えていく"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
<< kg:id_1 prop:countermeasure kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "酒田港の基地港湾整備については、国による酒田港外港地区国際物流ターミナル整備事業として、岸壁整備や航路のしゅんせつ等が予定されております。事業期間は令和６年度から９年度までの４年間で、令和10年度の供用開始に向けて工事が進められると聞いております。"@ja.
<< kg:id_3 prop:countermeasure kg:id_4 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "公表されている公募占用指針等を参考にしますと、今年12月頃の事業者選定直後から環境影響評価や漁業実態調査等の現地調査が始まり、基地港湾完成後の風車組立て等を経て、約６年後の令和12年度上半期の供用開始が想定されます。"@ja.
<< kg:id_5 prop:countermeasure kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "酒田市沖の洋上風力発電事業は、昨年10月に有望な区域に整理され、現在６月14日から住民との意見交換会を中学校区単位で行っている段階であります。"@ja.
<< kg:id_5 prop:effect kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "具体的なスケジュールの想定はございませんが、仮に事業化がなされれば、遊佐町沖を追いかける形で調査や工事が進められると考えております。"@ja.
<< kg:id_8 prop:countermeasure kg:id_9 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "企業誘致に当たっては、これまで同様に山形県と連携して臨んでいきますけれども、今後、展開される洋上風力発電事業の関連産業等の新たな展開も視野に入れながら、これからは企業と地域の両者にメリットが生じるような業種に絞るなど、戦略的な誘致を展開していきたいと思います。"@ja.
<< kg:id_10 prop:cause kg:id_11 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "1970年代というのは、まだ公害問題も盛んな時代でしたので、反対運動は非常に強烈なものがあったと聞いております。"@ja.
<< kg:id_10 prop:effect kg:id_12 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "議場に入れないというような状況もあって、もう大分前の先輩たちがまだ議員になる前、ピケを張っている人を外に出てもらう作業をしただとか、先輩の市職員の方に言わせると、打合せするときも隠密裏に動かなければならなかったというようなお話も聞いております。"@ja.
<< kg:id_13 prop:effect kg:id_14 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "その中では、やはり健康被害とか、災害時に洋上風力発電施設そのものが津波等で押し流された場合の危惧だとか、そういった意見も出されています。"@ja.
<< kg:id_13 prop:effect kg:id_15 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "その中では、やはり健康被害とか、災害時に洋上風力発電施設そのものが津波等で押し流された場合の危惧だとか、そういった意見も出されています。"@ja.
<< kg:id_13 prop:effect kg:id_16 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "それとは反対に、当然、経済的な活用、経済の好影響があるという意見も出されております。"@ja.
<< kg:id_17 prop:countermeasure kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "我々としましては、促進区域の指定をされるための合意形成というものをきちんと図るために、今、住民との意見交換会をさせていただいております。"@ja.
<< kg:id_17 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "その動きを踏まえた上で、促進区域の指定に必要なものをそろえていくという整理をし、取組を進めていきたいと思っております。"@ja.
<< kg:id_20 prop:cause kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "ここまでの生活水準をこれからも維持していくためには、やはり経済を活性化しないといけないと思います。"@ja.
<< kg:id_22 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "ただ、経済一辺倒ではないというのが今の社会かなとも思っております。環境や地球温暖化の問題もございますので、環境面と経済成長の両面をいかにバランスを取っていくかというところが、今、私どもに課せられている課題なのかなと思います。"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "経済の大切さや酒田港湾地域の今後の10年については、市民の皆さんに情報を的確に伝えてほしいなという思いがあります。 住民との意見交換会等で出された意見も含めて、市民にきちんと伝えていく取組を進めてまいりたいと思っております。"@ja.
}
