    prop:text-txt_contents "環境保全のために配慮すべき事項となる騒音や振動、低周波音、水質、動植物や生態系、景観、人と自然との触れ合いの活動の場等について文献調査等による検討結果をまとめる"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "突然の計画に対する戸惑い"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "具体的な説明が聞かれなかったことへの不満等もあり"@ja.
<< kg:id_1 prop:effect kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "反対の署名活動なども行われている状況でございまして、市民の間にも混乱が生じている"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "二酸化炭素を出さない地球温暖化防止に貢献し、クリーンエネルギーとして注目されている風力発電"@ja.
<< kg:id_20 prop:effect kg:id_22 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "二酸化炭素を出さない地球温暖化防止に貢献し、クリーンエネルギーとして注目されている風力発電"@ja.
<< kg:id_20 prop:effect kg:id_23 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "風力発電につきましてもエネルギー効率が高く"@ja.
<< kg:id_20 prop:effect kg:id_24 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "関連産業の振興も期待される"@ja.
<< kg:id_1 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "一般の方々、地方公共団体などから意見を聴取し、その意見を踏まえて環境の保全の観点からよりよい事業計画をつくり上げていくための手続"@ja.
<< kg:id_1 prop:countermeasure kg:id_26 >>
    prop:text-txt_contents "景観においては、主要な眺望点の眺望方向や主な眺望対象、眺望点の利用状況を踏まえて風力発電機の配置を検討する"@ja.
<< kg:id_1 prop:countermeasure kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "一般の方々や地域の特性をよく知る住民や専門家、地方公共団体などの意見を取り入れるよう努めることとされております"@ja.
<< kg:id_28 prop:countermeasure kg:id_29 >>
    prop:text-txt_contents "鶴岡市における風力発電施設の設置等に係るガイドラインを定め"@ja.
<< kg:id_28 prop:countermeasure kg:id_30 >>
    prop:text-txt_contents "生活環境や自然環境、景観等の保全の観点で遵守すべき事項を明らかにするとともに"@ja.
<< kg:id_28 prop:countermeasure kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "事業者と市民の相互理解の下、事業が行われるよう指導している"@ja.
<< kg:id_1 prop:countermeasure kg:id_32 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "まずは事業実施想定区域に隣接する集落の住民に対する説明会の開催を優先的に行う"@ja.
<< kg:id_1 prop:countermeasure kg:id_33 >>
    prop:text-txt_contents "今年の秋から風況調査を実施する予定"@ja.
<< kg:id_1 prop:countermeasure kg:id_34 >>
    prop:text-txt_contents "年末から年明け頃に環境影響評価方法書の縦覧が予定"@ja.
<< kg:id_1 prop:countermeasure kg:id_35 >>
    prop:text-txt_contents "その後、事業者において環境影響評価に係る調査、予測、評価が行われ"@ja.
<< kg:id_1 prop:countermeasure kg:id_36 >>
    prop:text-txt_contents "その結果が環境影響評価準備書として作成をされて"@ja.
<< kg:id_1 prop:countermeasure kg:id_37 >>
    prop:text-txt_contents "最終的に環境影響評価書にまとめ"@ja.
<< kg:id_1 prop:countermeasure kg:id_38 >>
    prop:text-txt_contents "森林法に基づく林地開発許可など、各種関係法令等に基づく許認可の手続も必要"@ja.
<< kg:id_28 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "それぞれの専門分野の審議会に御意見を伺った上で市の意見として取りまとめして県に提出をする"@ja.
<< kg:id_28 prop:countermeasure kg:id_40 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "市としては、重要な場所でもあるので、まず地域の説明会を先行していただくようにお願いした"@ja.
<< kg:id_28 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "順次開催していくように、これはお願いをしているところでございます"@ja.
<< kg:id_28 prop:countermeasure kg:id_42 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "それぞれの場面において必要な専門家の方々、市民の方々に御意見を伺いながら、市としての意見を提出してまいりたい"@ja.
<< kg:id_1 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "私としては、この段階で事業者から事業の取下げをしてほしい"@ja.
}
