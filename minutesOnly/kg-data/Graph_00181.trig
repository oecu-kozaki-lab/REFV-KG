kg:id_18 rdf:type cls:c_4074.
cls:c_4074 rdfs:label "合意形成問題"@ja.
kg:id_1 prop:effect kg:id_18.
kg:id_19 rdfs:label "環境影響評価法に基づく手続の実施"@ja.
kg:id_19 rdf:type cls:c_4075.
cls:c_4075 rdfs:label "環境評価手続"@ja.
