kg:id_8 rdf:type cls:c_4069.
cls:c_4069 rdfs:label "大規模化"@ja.
kg:id_1 prop:effect kg:id_8.
kg:id_9 rdfs:label "出羽三山の景観への重大な懸念"@ja.
kg:id_9 rdf:type cls:c_1765.
cls:c_1765 rdfs:label "景観懸念"@ja.
kg:id_1 prop:effect kg:id_9.
kg:id_10 rdfs:label "良好な景観や風致の著しい阻害"@ja.
kg:id_10 rdf:type cls:c_4070.
cls:c_4070 rdfs:label "景観阻害"@ja.
kg:id_1 prop:effect kg:id_10.
kg:id_11 rdfs:label "根子杉の景観や周囲の杉の保全への問題"@ja.
kg:id_11 rdf:type cls:c_4071.
cls:c_4071 rdfs:label "景観保全問題"@ja.
kg:id_1 prop:effect kg:id_11.
kg:id_12 rdfs:label "騒音や低周波音による近隣住民や来訪者への影響懸念"@ja.
kg:id_12 rdf:type cls:c_484.
cls:c_484 rdfs:label "生活影響"@ja.
kg:id_1 prop:effect kg:id_12.
kg:id_13 rdfs:label "ブナ林など貴重な森林資源への影響"@ja.
kg:id_13 rdf:type cls:c_2587.
cls:c_2587 rdfs:label "森林影響"@ja.
kg:id_1 prop:effect kg:id_13.
