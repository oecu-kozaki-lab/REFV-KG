kg:id_21 rdf:type cls:c_4076.
cls:c_4076 rdfs:label "是正措置"@ja.
kg:id_1 prop:countermeasure kg:id_21.
kg:id_22 rdfs:label "市による指導・助言"@ja.
kg:id_22 rdf:type cls:c_4077.
cls:c_4077 rdfs:label "行政指導"@ja.
kg:id_1 prop:countermeasure kg:id_22.
kg:id_23 rdfs:label "ガイドライン改定の検討"@ja.
kg:id_23 rdf:type cls:c_4078.
cls:c_4078 rdfs:label "指針改定"@ja.
kg:id_1 prop:countermeasure kg:id_23.
kg:id_24 rdfs:label "配慮書への意見提出"@ja.
kg:id_24 rdf:type cls:c_2889.
cls:c_2889 rdfs:label "意見提出"@ja.
kg:id_1 prop:countermeasure kg:id_24.
kg:st_1 rdfs:label "市民部長（五十嵐浩一）"@ja.
kg:st_1 rdf:type cls:st_23.
cls:st_23 rdfs:label "行政担当者"@ja.
kg:op_1 prop:content "認可条件を満たせなければ中止・撤回になり得る"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "地元理解が得られない場合は事業凍結の事例もある"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "鶴岡市長"@ja.
kg:st_2 rdf:type cls:st_2.
cls:st_2 rdfs:label "自治体首長"@ja.
kg:op_3 prop:content "出羽三山の聖地近接に重大な懸念があり事業撤回を希望"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:st_3 rdfs:label "山形県知事 吉村知事"@ja.
kg:st_3 rdf:type cls:st_2.
kg:op_4 prop:content "出羽三山の歴史と空気感に照らし計画はあり得ないと考える"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_3.
kg:st_4 rdfs:label "庄内町長 原田町長"@ja.
kg:st_4 rdf:type cls:st_2.
kg:op_5 prop:content "日本遺産の出羽三山近くでの計画は理解できない"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_4.
kg:st_5 rdfs:label "加藤鑛一議員"@ja.
kg:st_5 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_6 prop:content "必要な措置には中止・撤回も含むのか確認を求める"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_5.
kg:op_7 prop:content "文化財の根子杉に近接し景観と保全に問題が生じる可能性を懸念"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_5.
kg:op_8 prop:content "出羽三山の精神文化と低周波音のある環境は相入れない"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_5.
kg:op_9 prop:content "健康影響は未確定だが近距離・多基数ほど苦情発生割合が高く生活影響が懸念される"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "930メートルの自然ブナ林伐採は植生復活が困難で保護が大きな問題になる"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_5.
kg:op_11 prop:content "歴史・文化的価値を踏まえると貴重な森林資源への影響が懸念される"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "野生動物を山から追い出し新たな鳥獣被害を招くことを懸念"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_5.
kg:op_13 prop:content "熊を含め希少種以外の動植物の生態への影響が懸念される"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_1.
kg:op_14 prop:content "地滑り危険地域であり要注意と指摘"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_5.
kg:op_15 prop:content "保安林や急傾斜地崩壊危険区域などが存在し土砂災害への影響が懸念される"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_1.
kg:op_16 prop:content "上流の森林開発により水源涵養機能や土砂流出防止機能の低下が懸念される"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "作業道やタワー周辺開発が大雨時に水路化し下流へ流れ込むと懸念"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_5.
kg:op_18 prop:content "治水への影響が懸念される"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:st_6 rdfs:label "鶴岡市長 皆川治"@ja.
kg:st_6 rdf:type cls:st_2.
kg:op_19 prop:content "立地と進め方に問題があり地元合意形成もできていないと認識"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_6.
kg:op_20 prop:content "必要な措置の内容は中止や撤回も含め事業者判断になる"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_1.
kg:op_21 prop:content "日本遺産認定の出羽三山には設置しないことを明記すべきと提案"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_5.
kg:op_22 prop:content "ゾーニングは保全すべき場所の表明として有効であり改定を検討する"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_1.
kg:op_23 prop:content "審議会の意見も聞きながら配慮書への意見提出にしっかり対応する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_6.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:text-txt_contents "初めに事業化可能性調査として、風況データの収集や事業規模の想定などが行われます"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:text-txt_contents "その後、風況観測等の風況精査を実施し、風車の設置地点、規模の設定等基本設計、さらに実施設計を行うことになります"@ja.
<< kg:id_1 prop:cause kg:id_4 >>
    prop:text-txt_contents "それらの作業に並行いたしまして、例えば現在縦覧が行われております環境影響評価法に基づく手続など、関係法令などに基づいた許認可手続や系統連系などの検討なども実施されることになります"@ja.
<< kg:id_5 prop:cause kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "事業を実施するにはそれぞれの認可条件を満たすことが求められ、それらの条件をクリアできない場合は中止・撤回の条件となるものと思われます"@ja.
<< kg:id_5 prop:cause kg:id_7 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "地元の理解が得られない中で環境アセスの手続を進めることはできないとして、事業者側が一時凍結を表明した事例もございます"@ja.
<< kg:id_1 prop:effect kg:id_8 >>
    prop:text-txt_contents "完成すれば県内最大規模となるということです"@ja.
<< kg:id_1 prop:effect kg:id_9 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_4;
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "市長は８月21日の記者会見で、事業区域が出羽三山の山岳信仰の聖地に近く、重大な懸念を持っている。景観などに関し、事業者には丁寧に説明してほしいと述べたことが報道され、昨日の本間信一議員の質問に対する答弁でも、事業者の事業撤回を希望する旨の発言がありました。吉村知事も25日の定例記者会見で、『出羽三山は日本遺産にもなっており1,400年もの歴史がある。空気感が非常に大事だと思っており、ちょっとあり得ないと思っている』との考えを示し、庄内町の原田町長も26日、日本遺産でもある出羽三山の近くでの計画は理解できないと語ったことも報道されています"@ja.
<< kg:id_1 prop:effect kg:id_10 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "景観に与える影響が甚大で良好な景観もしくは風致を著しく阻害する場合は必要な措置を講じるとしています"@ja.
<< kg:id_1 prop:effect kg:id_11 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "計画地域北部には文化財の根子杉があり、風車から直線距離で390メートルと近く、景観や周囲の杉の保全など問題が生じる可能性があります"@ja.
<< kg:id_1 prop:effect kg:id_12 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_8;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "風力発電施設から発生する低周波音と健康への影響につきましては、いまだ明らかな関連を示す知見は確認されていないということが環境省のホームページにも掲載されておりますけれども、環境省が行った風力発電施設に係る騒音、低周波音の実態把握調査によりますと、風力発電設備からの距離が近くなるほど、また１施設当たりの風力発電設備の設置基数が多くなるほど騒音や低周波音に関する苦情等の発生割合が高くなるという報告がされております。議員御指摘のとおり事業実施区域に隣接する出羽三山を訪れる方も含め、近隣住民の生活に対して影響が及ぶことが懸念されるところでございます"@ja.
<< kg:id_1 prop:effect kg:id_13 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_10;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "標高930メートルの黒森山の自然ブナ林も実施計画地域に入っています。豪雪地のブナ林の植生復活は、この標高500メートルまでが限界と言われる中で、930メートルの標高の自然ブナ林を伐採するということは、この自然ブナ林の植生復活はできない。保護は大きな問題になると思います。現在縦覧中の計画段階環境配慮書において、ブナ林は環境省基準の植生自然度は８という『自然に近い二次林』となっておりますが、その背景にある歴史・文化的価値も踏まえ、これら貴重な森林資源に対する影響が懸念をされるところでございます"@ja.
<< kg:id_1 prop:effect kg:id_14 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_12;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "熊の生息地にもなっていると話しておりました。何度か熊を見かけたということです。さらに、熊やキツネなど野生動物を山から追い出して新たな鳥獣被害を及ぼさないか懸念されます。熊を含め希少種以外の動植物につきましても、その生態に対する影響が懸念されるところでございます"@ja.
<< kg:id_1 prop:effect kg:id_15 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_14;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "あとは、地滑りの危険性がある地域というふうにもされていますので要注意です。このたびの事業実施想定区域及びその周辺には保安林や砂防指定地、急傾斜地崩壊危険区域、地滑り防止区域、土砂災害特別警戒区域等が存在することから、治水や土砂災害に対する影響が懸念されるところでございます"@ja.
<< kg:id_1 prop:effect kg:id_16 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "河川上流における森林開発が、本来の森林が持つ水源涵養機能や土砂流出防止機能など、これらの低下に影響することが懸念をされます"@ja.
<< kg:id_1 prop:effect kg:id_17 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_17;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "タワー周辺の開発や大きなブレードを運ぶための広大な作業道は、大雨の際には水路となって下流に流れ込むと思われます。流域治水上の問題が生ずると思いますが、どうでしょうか。治水や土砂災害に対する影響が懸念されるところでございます"@ja.
<< kg:id_1 prop:effect kg:id_18 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "このたびの計画につきましては、立地の問題があるとともに、この事業の進め方ですね、特に地元との合意形成ということで、今、反対署名運動なども起きているというような状況がございますので、大変問題がある状況だというふうに認識をしております"@ja.
<< kg:id_1 prop:countermeasure kg:id_19 >>
    prop:text-txt_contents "現在縦覧が行われております環境影響評価法に基づく手続など"@ja.
<< kg:id_1 prop:countermeasure kg:id_20 >>
    prop:text-txt_contents "関係法令などに基づいた許認可手続や系統連系などの検討なども実施されることになります"@ja.
<< kg:id_1 prop:countermeasure kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "景観に与える影響が甚大であるとされ、市の景観計画に不適合となる場合は、市では指導・助言を行いますけれども、必要な措置の内容につきましては中止や撤回も含めて事業者側の判断となるものであります"@ja.
<< kg:id_1 prop:countermeasure kg:id_22 >>
    prop:text-txt_contents "市の景観計画に不適合となる場合は、市では指導・助言を行います"@ja.
<< kg:id_1 prop:countermeasure kg:id_23 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_21;
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "この地域に再び風力発電計画が浮上しないように、やっぱりきちんと今回、鶴岡市における風力発電施設の設置に係るガイドラインの見直し、改正、これを行う必要があるんじゃないか。例えば、その中に日本遺産認定の出羽三山には設置しないということをきちんと明記していくということです。議員御提案の特定の地域における風力発電事業の計画を制限する、いわゆるゾーニングにつきましては、市のガイドラインに法的強制力はございませんが、市のここは保全すべき場所という考えを表明する点では非常に有効であると考えております。今後、先進事例を調査・研究しながら、また関係のある審議会からも御意見を伺いながら、ガイドラインの改定について検討してまいりたいと考えております"@ja.
<< kg:id_1 prop:countermeasure kg:id_24 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "今、配慮書への意見を審議会の御意見も聞きながら提出する準備を進めている段階でございますので、それにしっかりと対応してまいります"@ja.
}
