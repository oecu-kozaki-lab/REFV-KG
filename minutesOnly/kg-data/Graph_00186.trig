cls:c_4214 rdfs:label "影響回避低減"@ja.
kg:id_1 prop:countermeasure kg:id_21.
kg:id_22 rdfs:label "国や県にも確認しながら検討する"@ja.
kg:id_22 rdf:type cls:c_1655.
cls:c_1655 rdfs:label "関係機関連携"@ja.
kg:id_1 prop:countermeasure kg:id_22.
