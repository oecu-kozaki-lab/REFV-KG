kg:id_18 rdf:type cls:c_4211.
cls:c_4211 rdfs:label "営巣地立地"@ja.
kg:id_1 prop:cause kg:id_18.
kg:id_19 rdfs:label "イヌワシやオオワシやオジロワシが周辺で頻繁に見られること"@ja.
kg:id_19 rdf:type cls:c_4212.
