kg:id_23 rdf:type cls:c_4215.
cls:c_4215 rdfs:label "専門家相談"@ja.
kg:id_1 prop:countermeasure kg:id_23.
kg:id_24 rdfs:label "住民説明会の動向を注視する"@ja.
kg:id_24 rdf:type cls:c_4216.
cls:c_4216 rdfs:label "説明会注視"@ja.
kg:id_1 prop:countermeasure kg:id_24.
kg:id_25 rdfs:label "ラムサール条約湿地の5キロ半径バッファゾーンをガイドラインに加える"@ja.
kg:id_25 rdf:type cls:c_4217.
cls:c_4217 rdfs:label "保全区域設定"@ja.
kg:id_1 prop:countermeasure kg:id_25.
kg:id_26 rdfs:label "開発業者に計画中止を促す"@ja.
kg:id_26 rdf:type cls:c_4218.
cls:c_4218 rdfs:label "計画中止要請"@ja.
kg:id_1 prop:countermeasure kg:id_26.
kg:id_27 rdfs:label "矢引計画段階で事業者にラムサール湿地周辺の調査を十分に行わせ資料を公開させる"@ja.
kg:id_27 rdf:type cls:c_4219.
cls:c_4219 rdfs:label "調査公開要求"@ja.
kg:id_1 prop:countermeasure kg:id_27.
kg:id_28 rdfs:label "環境審議会に環境省担当者や有識者を招く"@ja.
kg:id_28 rdf:type cls:c_4220.
cls:c_4220 rdfs:label "専門家招致"@ja.
kg:id_1 prop:countermeasure kg:id_28.
kg:id_29 rdfs:label "市民への説明会を行う"@ja.
kg:id_29 rdf:type cls:c_4221.
cls:c_4221 rdfs:label "市民説明"@ja.
kg:id_1 prop:countermeasure kg:id_29.
kg:id_30 rdfs:label "説明会や審議会を完全公開し録画や配信を可能にする"@ja.
kg:id_30 rdf:type cls:c_4222.
cls:c_4222 rdfs:label "公開開催"@ja.
kg:id_1 prop:countermeasure kg:id_30.
kg:id_31 rdfs:label "市独自の鳥類調査を行う"@ja.
kg:id_31 rdf:type cls:c_4223.
cls:c_4223 rdfs:label "独自調査"@ja.
kg:id_1 prop:countermeasure kg:id_31.
kg:id_32 rdfs:label "アセス前に予防原則に基づいてガイドラインの制限区域を設定する"@ja.
kg:id_32 rdf:type cls:c_4224.
cls:c_4224 rdfs:label "制限区域設定"@ja.
kg:id_1 prop:countermeasure kg:id_32.
kg:id_33 rdfs:label "生物多様性に十分配慮した取組を推進する"@ja.
kg:id_33 rdf:type cls:c_4225.
cls:c_4225 rdfs:label "保全配慮推進"@ja.
kg:id_1 prop:countermeasure kg:id_33.
