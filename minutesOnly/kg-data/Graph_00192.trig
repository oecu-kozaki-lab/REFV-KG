kg:id_37 rdfs:label "４メガワット級で２キロメートル、６メガ級で2.5キロメートルの離隔距離を確保する"@ja.
kg:id_37 rdf:type cls:c_4326.
kg:id_26 prop:countermeasure kg:id_37.
kg:id_38 rdfs:label "市のガイドラインに離隔距離を定める"@ja.
kg:id_38 rdf:type cls:c_2894.
cls:c_2894 rdfs:label "指針整備"@ja.
kg:id_26 prop:countermeasure kg:id_38.
