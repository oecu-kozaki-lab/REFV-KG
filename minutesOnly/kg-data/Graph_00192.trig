kg:id_39 rdf:type cls:c_122.
cls:c_122 rdfs:label "指針見直し"@ja.
kg:id_26 prop:countermeasure kg:id_39.
kg:id_40 rdfs:label "風車騒音と健康被害"@ja.
kg:id_40 rdf:type cls:c_2023.
kg:id_41 rdfs:label "新たな知見の情報収集と国の指針を注視した対応検討"@ja.
kg:id_41 rdf:type cls:c_737.
cls:c_737 rdfs:label "対応検討"@ja.
kg:id_40 prop:countermeasure kg:id_41.
kg:id_42 rdfs:label "風力発電のクマタカ死骸案件と騒音問題"@ja.
kg:id_42 rdf:type cls:c_1101.
cls:c_1101 rdfs:label "環境問題"@ja.
kg:id_43 rdfs:label "情報収集を行いながらしっかり取り組む"@ja.
kg:id_43 rdf:type cls:c_239.
cls:c_239 rdfs:label "情報収集"@ja.
kg:id_42 prop:countermeasure kg:id_43.
kg:st_1 rdfs:label "草島進一議員"@ja.
kg:st_1 rdf:type cls:st_9.
cls:st_9 rdfs:label "議員"@ja.
kg:op_1 prop:content "環境影響回避策は失敗し、風車がクマタカにヒットした最悪の結果だと受け止める"@ja.
kg:op_1 rdf:type cls:opinion.
kg:op_1 prop:speaker kg:st_1.
kg:op_2 prop:content "事業者の調査と環境保全措置の実態の限界を示す事例だと指摘する"@ja.
kg:op_2 rdf:type cls:opinion.
kg:op_2 prop:speaker kg:st_1.
kg:st_2 rdfs:label "鶴岡市市民部長伊藤慶也"@ja.
kg:st_2 rdf:type cls:st_4.
cls:st_4 rdfs:label "自治体"@ja.
kg:op_3 prop:content "絶滅危惧種の死骸発見は大変重大な事案と受け止めている"@ja.
kg:op_3 rdf:type cls:opinion.
kg:op_3 prop:speaker kg:st_2.
kg:op_4 prop:content "原因究明と対策が遅れると新たな衝突が起こり得ると懸念する"@ja.
kg:op_4 rdf:type cls:opinion.
kg:op_4 prop:speaker kg:st_2.
kg:op_5 prop:content "発見段階で報告されていれば市民の受け止めは違ったとみている"@ja.
kg:op_5 rdf:type cls:opinion.
kg:op_5 prop:speaker kg:st_1.
kg:op_6 prop:content "事業者に速やかな報告を強く求めている"@ja.
kg:op_6 rdf:type cls:opinion.
kg:op_6 prop:speaker kg:st_2.
kg:op_7 prop:content "新たな衝突防止のため早急な原因究明を求めている"@ja.
kg:op_7 rdf:type cls:opinion.
kg:op_7 prop:speaker kg:st_2.
kg:op_8 prop:content "ニッポンユビナガコウモリへの影響も推測されると懸念する"@ja.
kg:op_8 rdf:type cls:opinion.
kg:op_8 prop:speaker kg:st_1.
kg:op_9 prop:content "天然記念物のコウモリへの影響が及ぶおそれを心配している"@ja.
kg:op_9 rdf:type cls:opinion.
kg:op_9 prop:speaker kg:st_1.
kg:op_10 prop:content "現在の月2回調査では不正確であり調査回数の増加を求める"@ja.
kg:op_10 rdf:type cls:opinion.
kg:op_10 prop:speaker kg:st_1.
kg:op_11 prop:content "今回の事案を踏まえ事後調査期間の延長を要請すべきと主張する"@ja.
kg:op_11 rdf:type cls:opinion.
kg:op_11 prop:speaker kg:st_1.
kg:op_12 prop:content "重大な影響が認められた場合は追加的保全措置が必要と説明する"@ja.
kg:op_12 rdf:type cls:opinion.
kg:op_12 prop:speaker kg:st_2.
kg:op_13 prop:content "専門家の意見を聞きながら調査回数や期間について事業者に意見していく"@ja.
kg:op_13 rdf:type cls:opinion.
kg:op_13 prop:speaker kg:st_2.
kg:op_14 prop:content "国から衝突事故や移動経路阻害の影響を指摘されていると説明する"@ja.
kg:op_14 rdf:type cls:opinion.
kg:op_14 prop:speaker kg:st_2.
kg:op_15 prop:content "専門家の意見を踏まえ重大な影響や懸念事項に強く意見していく"@ja.
kg:op_15 rdf:type cls:opinion.
kg:op_15 prop:speaker kg:st_2.
kg:op_16 prop:content "ラムサール湿地近接地域では鳥類への影響回避は困難だとみている"@ja.
kg:op_16 rdf:type cls:opinion.
kg:op_16 prop:speaker kg:st_1.
kg:op_17 prop:content "累積的影響と予防原則から中止要請は妥当だと主張する"@ja.
kg:op_17 rdf:type cls:opinion.
kg:op_17 prop:speaker kg:st_1.
kg:op_18 prop:content "矢引についても予防原則に立ち中止要請すべきと主張する"@ja.
kg:op_18 rdf:type cls:opinion.
kg:op_18 prop:speaker kg:st_1.
kg:op_19 prop:content "環境影響回避策が失敗している以上、停止措置が必要と考える"@ja.
kg:op_19 rdf:type cls:opinion.
kg:op_19 prop:speaker kg:st_1.
kg:st_3 rdfs:label "加茂地区住民"@ja.
kg:st_3 rdf:type cls:st_5.
cls:st_5 rdfs:label "住民"@ja.
kg:op_20 prop:content "風力発電施設の設置で将来の騒音や健康被害を懸念している"@ja.
kg:op_20 rdf:type cls:opinion.
kg:op_20 prop:speaker kg:st_3.
kg:op_21 prop:content "風車騒音による健康被害を不安視している"@ja.
kg:op_21 rdf:type cls:opinion.
kg:op_21 prop:speaker kg:st_3.
kg:op_22 prop:content "風車が精神的負担や不安をもたらすと懸念している"@ja.
kg:op_22 rdf:type cls:opinion.
kg:op_22 prop:speaker kg:st_3.
kg:op_23 prop:content "三瀬八森山でも騒音による不眠症疑いが出てきたと指摘する"@ja.
kg:op_23 rdf:type cls:opinion.
kg:op_23 prop:speaker kg:st_1.
kg:op_24 prop:content "秋田県で睡眠障害やめまい頭痛の訴えがある事例を示し健康被害を懸念する"@ja.
kg:op_24 rdf:type cls:opinion.
kg:op_24 prop:speaker kg:st_1.
kg:st_4 rdfs:label "立憲民主党川田龍平参議院議員"@ja.
kg:st_4 rdf:type cls:st_9.
kg:op_25 prop:content "大型風車群では相当数の不眠症発生のおそれがあると問題提起する"@ja.
kg:op_25 rdf:type cls:opinion.
kg:op_25 prop:speaker kg:st_4.
kg:st_5 rdfs:label "大分看護科学大学教授影山隆之"@ja.
kg:st_5 rdf:type cls:st_24.
cls:st_24 rdfs:label "専門家"@ja.
kg:op_26 prop:content "41デシベル以上の住民に疫学的に不眠症が明らかに発生しているとする"@ja.
kg:op_26 rdf:type cls:opinion.
kg:op_26 prop:speaker kg:st_5.
kg:op_27 prop:content "住民相談があれば法に基づいて調査する方針を示す"@ja.
kg:op_27 rdf:type cls:opinion.
kg:op_27 prop:speaker kg:st_2.
kg:op_28 prop:content "基準超過なら法に基づき事業者へ改善を求める"@ja.
kg:op_28 rdf:type cls:opinion.
kg:op_28 prop:speaker kg:st_2.
kg:op_29 prop:content "健康影響防止のため十分な離隔距離が必要と指摘する"@ja.
kg:op_29 rdf:type cls:opinion.
kg:op_29 prop:speaker kg:st_4.
kg:st_6 rdfs:label "北海道大学田鎖順太助教"@ja.
kg:st_6 rdf:type cls:st_24.
kg:op_30 prop:content "風車規模に応じた離隔距離が必要との科学的見解を示す"@ja.
kg:op_30 rdf:type cls:opinion.
kg:op_30 prop:speaker kg:st_6.
kg:op_31 prop:content "大型化する風車に対応して市独自の離隔距離基準を設けるべきと求める"@ja.
kg:op_31 rdf:type cls:opinion.
kg:op_31 prop:speaker kg:st_1.
kg:op_32 prop:content "国の動向を見ながら離隔距離を含むガイドライン見直しを検討する"@ja.
kg:op_32 rdf:type cls:opinion.
kg:op_32 prop:speaker kg:st_2.
kg:op_33 prop:content "新たな知見を集め国の指針も踏まえて対応を検討する"@ja.
kg:op_33 rdf:type cls:opinion.
kg:op_33 prop:speaker kg:st_2.
kg:st_7 rdfs:label "鶴岡市長皆川治"@ja.
kg:st_7 rdf:type cls:st_4.
kg:op_34 prop:content "再エネ推進のためにも重要な問題として引き続き取り組む考えを示す"@ja.
kg:op_34 rdf:type cls:opinion.
kg:op_34 prop:speaker kg:st_7.
<< kg:id_1 prop:cause kg:id_2 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_1;
    prop:text-txt_contents "希少猛禽類であるクマタカにヒットするという最悪の結果を稼働して１年余りで実際にもたらした"@ja.
<< kg:id_1 prop:cause kg:id_3 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_2;
    prop:text-txt_contents "事業者の調査と環境保全措置の実態というのはそんなものなんだということの実例が生じたのではないでしょうか"@ja.
<< kg:id_1 prop:effect kg:id_4 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_3;
    prop:text-txt_contents "種の保存法に基づく国内希少野生動物に指定されており、議員御案内のとおり、絶滅危惧種１Ｂ類に属するクマタカでございまして、大変重大な事案と受け止めております"@ja.
<< kg:id_1 prop:effect kg:id_5 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_4;
    prop:text-txt_contents "死因の調査が長引き、対策が講じられないと新たな衝突事案が発生する可能性も考えられます"@ja.
<< kg:id_1 prop:effect kg:id_6 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_5;
    prop:text-txt_contents "このバードストライク疑い案件がしっかりと発見段階で報告されていたなら、市の説明も加茂住民はじめ市民の受け止めも違ったのではなかったかと私は思います"@ja.
<< kg:id_1 prop:countermeasure kg:id_7 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_6;
    prop:text-txt_contents "事業者に対しまして速やかに報告がなかったことは大変遺憾である旨申入れを行い、今後は死因調査の結果も含め、速やかに報告するよう強く意見しているところでございます"@ja.
<< kg:id_1 prop:countermeasure kg:id_8 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_7;
    prop:text-txt_contents "早急に原因究明が行われるよう、東北地方環境事務所には要望しているところでございます"@ja.
<< kg:id_9 prop:cause kg:id_10 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_8;
    prop:text-txt_contents "事後調査の中間報告にはコウモリの衝突事案もあったかと思います。私が心配しているのは、約１万匹が八乙女洞窟に生息する県指定文化財、天然記念物のニッポンユビナガコウモリにも影響があるように推測できることであります"@ja.
<< kg:id_9 prop:effect kg:id_11 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_9;
    prop:text-txt_contents "約１万匹が八乙女洞窟に生息する県指定文化財、天然記念物のニッポンユビナガコウモリにも影響があるように推測できる"@ja.
<< kg:id_9 prop:countermeasure kg:id_12 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_10;
    prop:text-txt_contents "現在のＪＲＥの事後調査というのは月２回しか死亡個体調査が行われておらず、これは環境省からも指摘されているのですが、正確な調査になっておりません。少なくとも事後調査、最低月４回以上、バットストライクを考慮すれば月10回以上"@ja.
<< kg:id_9 prop:countermeasure kg:id_13 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_11;
    prop:text-txt_contents "事後調査の２年という期間については、今回の事案を踏まえて、あと３年は最低でも延長を働きかけることを要請すべきと思います"@ja.
<< kg:id_14 prop:countermeasure kg:id_15 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_12;
    prop:text-txt_contents "バードストライクが確認されるなど、希少猛禽類や渡り鳥など重要な鳥類に対する重大な影響が認められた場合は、専門家などからの助言を踏まえ、稼働制限等、追加的な環境保全措置を講ずることとされております"@ja.
<< kg:id_14 prop:countermeasure kg:id_16 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_13;
    prop:text-txt_contents "バードストライクや天然記念物でありますコウモリ等のバットストライクの事後調査の回数や期間について、専門家の意見も伺いながらしっかりと意見してまいりたい"@ja.
<< kg:id_17 prop:cause kg:id_18 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_14;
    prop:text-txt_contents "既に配慮書の中で経済産業省や環境省より風力発電設備への衝突事故及び移動経路の阻害等による影響について指摘を受けております"@ja.
<< kg:id_17 prop:countermeasure kg:id_19 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_15;
    prop:text-txt_contents "今後のアセスの手続の中で重大な影響や懸念事項につきましては、さらに専門家などからの意見を伺い、強く意見してまいりたい"@ja.
<< kg:id_20 prop:effect kg:id_21 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_16;
    prop:text-txt_contents "サンクチュアリーであるラムサール湿地７キロ圏にある三瀬八森山から加茂地区は、まさに希少猛禽類や渡り鳥の密度が濃い地域であり、影響は避けられない"@ja.
<< kg:id_20 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_17;
    prop:text-txt_contents "これまでの詳細な生態調査や専門家の意見を根拠に、累積的影響と予防原則をもって判断をした、これはまず市の加茂の風車の中止要請は全く妥当だと思います"@ja.
<< kg:id_23 prop:countermeasure kg:id_22 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_18;
    prop:text-txt_contents "さらに、矢引についても中止要請すべきと私は考えます"@ja.
<< kg:id_24 prop:countermeasure kg:id_25 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_19;
    prop:text-txt_contents "まずは八森山については一定期間の停止措置"@ja.
<< kg:id_26 prop:cause kg:id_27 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_20;
    prop:text-txt_contents "加茂地区に風力発電施設が設置されますと、将来にわたって風車騒音や健康被害、風車がもたらす精神的な負担や不安が懸念されるといった御意見もございました"@ja.
<< kg:id_26 prop:effect kg:id_28 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_21;
    prop:text-txt_contents "将来にわたって風車騒音や健康被害、風車がもたらす精神的な負担や不安が懸念される"@ja.
<< kg:id_26 prop:effect kg:id_29 >>
    prop:stateBy kg:st_3;
    prop:relatedOpinion kg:op_22;
    prop:text-txt_contents "風車騒音や健康被害、風車がもたらす精神的な負担や不安が懸念される"@ja.
<< kg:id_26 prop:effect kg:id_30 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_23;
    prop:text-txt_contents "今般、三瀬八森山でも風力発電施設の騒音による不眠症の疑いが出てきたということであります"@ja.
<< kg:id_26 prop:effect kg:id_31 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_24;
    prop:text-txt_contents "風車の低周波音と健康被害については、秋田県で21例、睡眠障害やめまい・頭痛などの訴えがある"@ja.
<< kg:id_26 prop:effect kg:id_32 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_25;
    prop:text-txt_contents "北海道大学、田鎖順太助教のシミュレーションで、例えば遊佐で15メガワットを52基、２キロの離岸距離で建てると、250名の不眠症が発生するというおそれを示しまして"@ja.
<< kg:id_26 prop:effect kg:id_33 >>
    prop:stateBy kg:st_5;
    prop:relatedOpinion kg:op_26;
    prop:text-txt_contents "風車に近いところに住居を構える住民に、41デシベル以上の音圧の方々に対して、疫学的に明らかに不眠症が発生している"@ja.
<< kg:id_26 prop:countermeasure kg:id_34 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_27;
    prop:text-txt_contents "住民からの相談等を寄せられた際には、騒音規制法等に基づきまして調査を行い"@ja.
<< kg:id_26 prop:countermeasure kg:id_35 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_28;
    prop:text-txt_contents "基準値を超えている場合には原因者に対して法に基づき、改善を求めてまいります"@ja.
<< kg:id_26 prop:countermeasure kg:id_36 >>
    prop:stateBy kg:st_4;
    prop:relatedOpinion kg:op_29;
    prop:text-txt_contents "風車から民家までの離隔距離を十分取ることを指摘しております"@ja.
<< kg:id_26 prop:countermeasure kg:id_37 >>
    prop:stateBy kg:st_6;
    prop:relatedOpinion kg:op_30;
    prop:text-txt_contents "北海道大学の田鎖助教は、４メガワット級の風車であれば２キロメートル、６メガ級であれば2.5キロメートルの離隔距離が必要と科学的なデータによって見解を示されております"@ja.
<< kg:id_26 prop:countermeasure kg:id_38 >>
    prop:stateBy kg:st_1;
    prop:relatedOpinion kg:op_31;
    prop:text-txt_contents "昨今大型化する風車に対して、当市としてのガイドライン、これも風車騒音についても、しっかりと離隔距離を定めるべきと考えます"@ja.
<< kg:id_26 prop:countermeasure kg:id_39 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_32;
    prop:text-txt_contents "国の動向を注視しながら、風車の離隔距離を含め、本市のガイドラインの見直し等の必要性について検討してまいりたい"@ja.
<< kg:id_40 prop:countermeasure kg:id_41 >>
    prop:stateBy kg:st_2;
    prop:relatedOpinion kg:op_33;
    prop:text-txt_contents "そうした新たな知見等についての情報収集に努めながら、そしてまた今後国等においても検討されると言われておりますそういった指針、そういったところにも注視しながら対応を検討してまいりたい"@ja.
<< kg:id_42 prop:countermeasure kg:id_43 >>
    prop:stateBy kg:st_7;
    prop:relatedOpinion kg:op_34;
    prop:text-txt_contents "いずれも再エネを推進するためにも重要な問題でありますので、引き続き情報収集も行いながら、しっかり取り組んでまいりたいと思います"@ja.
}
