kg:id_102 prop:effect kg:id_103.
kg:id_104 rdfs:label "風車そのものを大きくする必要がない"@ja.
kg:id_104 rdf:type cls:c_3318.
cls:c_3318 rdfs:label "小型化"@ja.
kg:id_102 prop:effect kg:id_104.
kg:id_105 rdfs:label "複数設置で大型風車に匹敵する出力が得られる"@ja.
kg:id_105 rdf:type cls:c_4393.
